                    },
                    {
                        "translation_id": "7429a5e2-8472-4c0e-ad8c-e81dfd0ccd71",
                        "source_entry_id": "a9d4fb64-a2f3-3658-8d02-daf84a3efb06",
                        "target_lang_word": "Transistor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transistor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42dd6d29-0fd0-3c5b-a178-52e573e29218",
                                        "entry_id": "3d294172-fc50-38b2-94e9-5005c8e12b8d",
                                        "glosses": [
                                            "aus Halbleitern hergestelltes elektronisches Bauteil, zum Schalten oder Verstärken elektrischer Signale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dfbbde-4ba7-4a16-bf57-d34350d7387a",
                                                "sense_id": "42dd6d29-0fd0-3c5b-a178-52e573e29218",
                                                "text": "Heutige Mikrochips enthalten tausende oder Millionen von Transistoren."
                                            },
                                            {
                                                "example_id": "c351fcbc-22ec-4db2-852e-574f23a8907c",
                                                "sense_id": "42dd6d29-0fd0-3c5b-a178-52e573e29218",
                                                "text": "„Transistoren sind die Universalelemente der Mikroelektronik - je mehr davon auf derselben Fläche untergebracht werden können, desto leistungsfähiger ist ein Chip.“"
                                            },
                                            {
                                                "example_id": "4bc49345-de0e-4afc-9b17-f26499a9cfff",
                                                "sense_id": "42dd6d29-0fd0-3c5b-a178-52e573e29218",
                                                "text": "„Nach der Erfindung des Transistors im Jahr 1947 dauerte es nicht lange, bis die ersten Transistorradios auf den Markt kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0a5f1d-76b3-4e17-8c6a-8d0657eb10aa",
                        "source_entry_id": "a9d4fb64-a2f3-3658-8d02-daf84a3efb06",
                        "target_lang_word": "transistor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transistor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5df451d9-ccad-37e3-a824-ebc22bd99b05",
                                        "entry_id": "129c937d-affd-38c5-8644-6ea035594b5e",
                                        "glosses": [
                                            "A solid-state semiconductor device, with three terminals, which can be used for amplification, switching, voltage stabilization, signal modulation, and many other functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e80407-450f-438b-b4fd-654793f96277",
                                                "sense_id": "5df451d9-ccad-37e3-a824-ebc22bd99b05",
                                                "text": "Switches and transistors control the flow of electricity like valves and faucets control water. Resistors limit the flow of electricity. […] Light is transmitted from the color LED, through the fiber optic cable, to control the NPN transistor (Q2) and red LED (D1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5bb5f35-52c5-308d-b559-a0d025967840",
                                        "entry_id": "129c937d-affd-38c5-8644-6ea035594b5e",
                                        "glosses": [
                                            "A transistor radio."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf110f50-a828-4e17-8bc8-25e6c09c2666",
                                                "sense_id": "b5bb5f35-52c5-308d-b559-a0d025967840",
                                                "text": "Turn your transistor on and let the music play"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bec405d-5cf5-4618-9027-c72619e672be",
                        "source_entry_id": "a9d4fb64-a2f3-3658-8d02-daf84a3efb06",
                        "target_lang_word": "transistor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transistor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56175603-d13d-39b5-bc46-eb76d02e1b39",
                                        "entry_id": "96cc8791-f3b8-3c87-8bf7-8a06ba61cd9e",
                                        "glosses": [
                                            "Composant électronique, constitué de matériaux semiconducteurs, utilisé pour redresser, amplifier, interrompre des oscillations électriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85194037-70de-4d86-8061-605a94abd5e1",
                                                "sense_id": "56175603-d13d-39b5-bc46-eb76d02e1b39",
                                                "text": "Or c’était la station la plus militante, elle ne masquait pas ses sympathies, et c’est pourquoi le fait de répandre industriellement les postes de radio à transistors releva, de la part du gouvernement, du pur suicide."
                                            },
                                            {
                                                "example_id": "6b27ab4e-3261-4f8a-b9e2-ccb0e8ce9886",
                                                "sense_id": "56175603-d13d-39b5-bc46-eb76d02e1b39",
                                                "text": "Ainsi, pour le contrôle de moteurs à commutation électronique ([…]), une carte contient généralement un pont de transistors de puissance alimenté par une tension continue et commandé par un circuit de modulation de largeur d’impulsions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                        "entry_id": "96cc8791-f3b8-3c87-8bf7-8a06ba61cd9e",
                                        "glosses": [
                                            "Radio portative équipée de transistors et alimenté par des piles."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee4b4e5-82a3-48ee-a5a4-517fb6abe983",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "— On avait trouvé un coin tranquille, avec de l’eau tout près et des oiseaux comme s’il en pleuvait. Il est arrivé une bande de cons avec des transistors."
                                            },
                                            {
                                                "example_id": "5e1a0217-274d-465e-b69a-994a86ec568e",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "Tous ceux qui ont suivi, dans la rue ou l’oreille collée aux transistors, les journées et les nuits rouges de mai, savent parfaitement le rôle d’agents de renseignement, d’espions légaux et commodes que jouent les radioreporters."
                                            },
                                            {
                                                "example_id": "8a4e23c1-6148-448a-ad46-e07eda49c3df",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "Nous regrettons la vieille villa du comte Fede telle que je l’ai encore connue dans mon adolescence, la longue allée bordée d’une garde prétorienne de cyprès menant pas à pas au silencieux domaine des ombres, hanté en avril par le cri du coucou, en août par le crissement des cigales, mais où à mon dernier passage j’ai surtout entendu des transistors."
                                            },
                                            {
                                                "example_id": "2af18e0e-ab5e-4626-a426-593e0a732dc8",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "Je me rappelle un dessin humoristique de Roger Sam. Ça représentait un veuf qui suivait l'enterrement de sa femme en tenant à la main un transistor retransmettant France-Irlande."
                                            },
                                            {
                                                "example_id": "76d41eb0-83a2-4cd5-b4b2-e76ca8beca40",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "Le matin, comme les marins chinois, elle avale, à jeun, une cuillerée de « pétrole lampant » (huile de lampe) et se fait elle-même un café qu'elle savoure, attablée dans sa petite cuisine, une oreille collée à son transistor."
                                            },
                                            {
                                                "example_id": "56e7ae31-4ec0-48d9-aead-4683e0ec546d",
                                                "sense_id": "37d6c109-5cde-3e5e-b7b3-21c05a7d3467",
                                                "text": "Dominant le brouhaha des conversations, le cliquetis des couverts, la voix nasillarde du garçon, un transistor beuglait à s'étouffer. Une speakerine indolente annonça qu'une montre à quartz, made in Japan, allait donner l'heure à la seconde près."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
