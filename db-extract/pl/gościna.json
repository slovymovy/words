                                    },
                                    {
                                        "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                                        "entry_id": "4416a673-a085-396e-8e0b-94b34e5ef0ad",
                                        "glosses": [
                                            "Logement, généralement provisoire."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e00ab9f-deb3-4dd5-9651-e133245a418a",
                                                "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                                                "text": "Il faut leur trouver un hébergement pour la nuit."
                                            },
                                            {
                                                "example_id": "e2250c34-5b2b-4408-92d1-ea14860893f0",
                                                "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                                                "text": "L’investissement dans un hébergement de groupe est souvent important (c’est pourquoi ces structures sont très souvent à la charge de collectivités, ce qui ne signifie pas qu’elles fonctionnent mieux)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43cc711a-dfc3-4560-9b0a-4a394b55b85f",
                        "source_entry_id": "c538d989-d2d9-340a-a5f1-1549c93383cb",
                        "source_sense_id": "bf58a66b-680a-333d-a3c0-0c8455488551",
                        "target_lang_word": "bezoek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezoek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                                        "entry_id": "739dfd94-3908-3e15-8c15-1ac8729a6ae1",
                                        "glosses": [
                                            "het bezoeken, de visite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e93c25c-2531-4985-b22f-69c9356a8a9f",
                                                "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                                                "text": "'Heb je sinds ons bezoek aan de schouwburg nog een ander stuk gezien, Thea?' vraagt Jacob."
                                            },
                                            {
                                                "example_id": "e9579402-1efa-4992-9707-2855f395365e",
                                                "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                                                "text": "Zij gingen even een bezoek afleggen."
                                            },
                                            {
                                                "example_id": "e84d86d6-3707-4d09-95c1-0fe788cda9e0",
                                                "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                                                "text": "Het bezoek aan het museum was zeer de moeite waard."
                                            },
                                            {
                                                "example_id": "b6f6b5c0-5ca6-4bb8-a3f8-f89a4a53f88b",
                                                "sense_id": "53c3e19b-ca22-39a9-93e5-5ea10e30715f",
                                                "text": "Dat dit een eenmalig bezoek betrof, stond bij haar vast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd12f902-b32b-3837-bea9-67ab0b65847d",
                                        "entry_id": "739dfd94-3908-3e15-8c15-1ac8729a6ae1",
                                        "glosses": [
                                            "de personen die op visite zijn of komen, de verzamelde bezoekers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af75a99b-f1a6-43ac-835f-766f1c6591d7",
                                                "sense_id": "fd12f902-b32b-3837-bea9-67ab0b65847d",
                                                "text": "Ik kreeg zeer veel bezoek op mijn verjaardag."
                                            },
                                            {
                                                "example_id": "6acf9d12-cbcc-4898-b5ae-5cfa0ebc31be",
                                                "sense_id": "fd12f902-b32b-3837-bea9-67ab0b65847d",
                                                "text": "De museumdirecteur was heel blij met het vele bezoek dat de tentoonstelling mocht ontvangen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bezoek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "22a69e17-8f35-3653-8990-3466b8807626",
                                        "entry_id": "836839ef-74fb-3ca8-9839-85e53363c5ac",
