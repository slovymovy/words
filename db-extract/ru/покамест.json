                        ]
                    },
                    {
                        "translation_id": "ec3a7c0e-62e6-4470-9b34-d9041a5f2224",
                        "source_entry_id": "34c0b349-722a-3463-a8b9-1f62212ef5c6",
                        "source_sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                        "target_lang_word": "for the time being",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the time being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                        "entry_id": "b03ac985-242f-3b07-8068-45936b45a76d",
                                        "glosses": [
                                            "Temporarily; for now; until later; until the situation changes; in an indefinite period of time."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecedfb8-3c39-4e49-a4a9-eaaa12d5eb5b",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "I think I will ignore the problem for the time being."
                                            },
                                            {
                                                "example_id": "5a6323b0-9e1e-4155-92f8-18d1bf22eb04",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "And so, unfortunately, this great and spreading network of railways, that recently showed such promise as a major instrument in the modern development of China, must be left for the time being in the melting-pot of Armageddon."
                                            },
                                            {
                                                "example_id": "8889eef2-b73b-4e9c-a677-281a78634428",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "Neither Aracil nor his five friends have the money to pay for the costs of the demolition, which, they say, are punitively over-inflated. For the time being, their hopes rest on legal appeals, and should those fail, on a crowdfunding campaign."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76980421-1070-4498-83f1-4b2970291e2b",
                        "source_entry_id": "34c0b349-722a-3463-a8b9-1f62212ef5c6",
                        "source_sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                        "target_lang_word": "so far",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so far",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                        "entry_id": "b4d3a6c7-529e-3f51-a927-dcbfc4648e62",
                                        "glosses": [
                                            "Until now; previously; yet."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7163639b-7593-48d8-aaf2-a9446b012bbb",
                                                "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                                "text": "So far, nothing unusual has happened."
                                            },
                                            {
                                                "example_id": "47978fa6-7f74-4eb3-b588-01a9a7f36ccc",
                                                "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                                "text": "―How are your driving lessons? ―So far, pretty good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                        "entry_id": "b4d3a6c7-529e-3f51-a927-dcbfc4648e62",
                                        "glosses": [
                                            "A limited distance, literal or metaphorical."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703768d9-c383-4f42-872f-1661e895ce74",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "Don’t expect a long walk. You can only go so far in that direction."
                                            },
                                            {
                                                "example_id": "9eb1c974-e84f-40bd-89ac-d5ba41cdf1d4",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            },
                                            {
                                                "example_id": "4003e770-576c-4780-b7b9-f154e7095e34",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ef4eaac-0852-46b0-b496-c22dc0564e8f",
                        "source_entry_id": "34c0b349-722a-3463-a8b9-1f62212ef5c6",
                        "source_sense_id": "ad418be7-5f82-3613-98db-18af32af9dfc",
                        "target_lang_word": "mittlerweile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mittlerweile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                        "entry_id": "9a8b6709-0a05-33b4-b9a8-9199968cd01c",
                                        "glosses": [
                                            "in der Zwischenzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0041efe7-a94f-476b-870e-7075747c71d4",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "Mittlerweile ist es uns gelungen, das Rätsel zu lösen."
                                            },
                                            {
                                                "example_id": "8bc4e8b6-034a-4c34-8126-84d99c112621",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Mittlerweile in Rente, gab sie sich reiselustig in ihrem Trabi.“"
                                            },
                                            {
                                                "example_id": "741ab9fa-c59a-43a8-a7cb-a898686dcf2b",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Mittlerweile war es ein offenes Geheimnis, dass sie die Pest an Bord hatten.“"
                                            },
                                            {
                                                "example_id": "5019b5dd-cde6-40e2-8319-23775c54ff37",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Solche und ähnliche Erlebnisse führen - für mich mittlerweile nachvollziehbar - viele Frauen zu der todernst gemeinten Aussage, dass sie ohne ihre Wärmflasche nicht leben könnten!“"
                                            },
                                            {
                                                "example_id": "a26d34a3-6154-4799-b1ef-c2126d98bc39",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Er freut sich, dass sich endlich mal jemand für ihn interessiert, aber er will nicht mehr erzählen, weil sich mittlerweile eine neugierige Menschentraube um uns gebildet hat.“"
                                            },
                                            {
                                                "example_id": "eb4150c8-459d-4233-9cca-bb0964f25d00",
                                                "sense_id": "07444a27-5a49-3329-b1ac-d05cc2775197",
                                                "text": "„Laut Berichten der Vereinten Nationen galten in den 1970er-Jahren rund zehn Prozent der weltweiten Fischbestände als überfischt. Mittlerweile sind es rund 30 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
