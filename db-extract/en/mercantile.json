                "senses": [
                    {
                        "sense_id": "76c62f18-4f4d-3c78-9745-45c2d3270ca0",
                        "entry_id": "7b90ab4f-cdc8-3d5d-8f87-9084b35b9ff5",
                        "glosses": [
                            "Concerned with the exchange of goods for profit."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6354155d-911e-416b-ade1-7cc697514e6b",
                                "sense_id": "76c62f18-4f4d-3c78-9745-45c2d3270ca0",
                                "text": "No sign was over his door; in fact—as with old banks and mercantile houses—advertising in any shape was scorned, and it would have been felt as beneath his dignity to paint, for the benefit of strangers, the name of an establishment the trade of which came solely by connection based on personal respect."
                            }
                        ]
                    },
                    {
