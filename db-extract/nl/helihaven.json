                            {
                                "example_id": "0eadc96f-2c27-4d40-a99f-7fa50abc1634",
                                "sense_id": "1916f9b6-f7c2-30dd-b996-75e2b89721b4",
                                "text": "De totstandkoming van een kleine helihaven aan de Kolkweg in Manderveen is nog geen uitgemaakte zaak. Initiatiefnemer G. Huzink moet van de gemeente eerst een akoestisch rapport op tafel leggen."
                            },
                            {
                                "example_id": "7cac9404-a0bf-45c5-9dbd-f275eddbbaab",
                                "sense_id": "1916f9b6-f7c2-30dd-b996-75e2b89721b4",
                                "text": "Bij de verbouwing van het beroemde Maracanástadion moesten een waterpretpark, een school, een atletiekstadion en een gevangenis plaats maken voor een parkeergarage, een helihaven, een winkelcentrum en een voetbalmuseum."
                            }
                        ]
