                    {
                        "sense_id": "95916d4a-5723-34a7-b695-1c1d9b5435ff",
                        "entry_id": "acbdb95f-535d-3103-bd82-6aa9faee97e0",
                        "glosses": [
                            "Action d’attifer, de s’orner ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de841475-7f50-480c-a16e-32095574f619",
                                "sense_id": "95916d4a-5723-34a7-b695-1c1d9b5435ff",
                                "text": "N'a-t-il pas imaginé de remettre en honneur la coquetterie féminine, les attifements, la parure."
                            },
                            {
                                "example_id": "9982f966-45cd-4e6a-abfa-9c16224738be",
                                "sense_id": "95916d4a-5723-34a7-b695-1c1d9b5435ff",
                                "text": "En attendant, je vais leur montrer à faire leur paquetage et leur lit. Et je rectifierai aussi leur attifement, afin qu’ils n’aient pas l’air trop bleusaille pour passer de la porte."
                            }
                        ]
                    }
                ],
