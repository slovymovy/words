                "pos": "particle",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76eb202e-cb61-38b8-8344-52230d6c53c1",
                        "entry_id": "b244e6ec-700c-3828-8d63-61b7279a5ea8",
                        "glosses": [
                            "nawiązuje do innej wypowiedzi, rozpoczynając komentarz lub jej uzupełnienie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021d2af4-f5c9-4898-ae94-1ea60d9a5e56",
                                "sense_id": "76eb202e-cb61-38b8-8344-52230d6c53c1",
                                "text": "Po tym wstępie przystąpmy do rzeczy. Otóż pragnę gorąco ci zakomunikować, że mamy do spełnienia, to znaczy ty i ja, to znaczy ludzkość, wielką i szlachetną misję."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44a30182-3f9a-4537-a700-8c6dfc2cac34",
                        "source_entry_id": "b244e6ec-700c-3828-8d63-61b7279a5ea8",
                        "source_sense_id": "76eb202e-cb61-38b8-8344-52230d6c53c1",
                        "target_lang_word": "вот",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7d67b3-1a74-359c-b7dc-d4d64e3770eb",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется при указании на кого-либо, что-либо, находящееся или происходящее в непосредственной близости"
                                        ],
                                        "tags": [
                                            "мест. нар.",
                                            "указательное мест."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735b1a17-75e8-40a2-a90c-0f99f46e3e6d",
                                                "sense_id": "9b7d67b3-1a74-359c-b7dc-d4d64e3770eb",
                                                "text": "Вот моя деревня, вот мой дом родной."
                                            },
                                            {
                                                "example_id": "553605a5-e7df-4463-b5ab-2a6911fe953c",
                                                "sense_id": "9b7d67b3-1a74-359c-b7dc-d4d64e3770eb",
                                                "text": "Взвесьте мне вот этой ветчины, пожалуйста."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87fb958d-73f6-3509-a645-1b0342ac2d88",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется при указании на последовательность действий, на смену явлений, происходящих как бы перед глазами (может повторяться перед каждым следующим членом)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9d95e0-c777-43bd-8f02-7b3445c1dc72",
                                                "sense_id": "87fb958d-73f6-3509-a645-1b0342ac2d88",
                                                "text": "Вот он бежит, подпрыгнул и приземлился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06427bf5-1ae1-3a4b-8882-90a7bb9b73ba",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "в сочетании с «и» (вот и…) указывает на наступление, осуществление чего-либо ожидаемого или желаемого || употребляется для выражения отношения к ситуации как невозможной или нежелательной для говорящего"
                                        ],
                                        "tags": [
                                            "модальная частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f031be-3bca-41b6-8545-fba91e307014",
                                                "sense_id": "06427bf5-1ae1-3a4b-8882-90a7bb9b73ba",
                                                "text": "Но вот наступает вечер."
                                            },
                                            {
                                                "example_id": "b23f3d27-78be-4f6a-901d-de8ee2b394c9",
                                                "sense_id": "06427bf5-1ae1-3a4b-8882-90a7bb9b73ba",
                                                "text": "Вот и приплыли."
                                            },
                                            {
                                                "example_id": "bd38c103-4ded-4e6d-a530-2dd46f8cee8f",
                                                "sense_id": "06427bf5-1ae1-3a4b-8882-90a7bb9b73ba",
                                                "text": "Вот когда еще у нас будет такой удачный случай?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e584bed2-7b31-3fb5-b8cf-31d1955408fb",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется с указательными и относительными местоимениями, а также с наречиями места, времени, причины и т. п. для уточнения и усиления их значения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06068fdd-0a72-4671-a555-346111af70a1",
                                                "sense_id": "e584bed2-7b31-3fb5-b8cf-31d1955408fb",
                                                "text": "— А что? Вот я какой — в шляпе, при галстуке…"
                                            },
                                            {
                                                "example_id": "f3254199-627a-441d-a97a-4238195eac09",
                                                "sense_id": "e584bed2-7b31-3fb5-b8cf-31d1955408fb",
                                                "text": "Вот в чём вопрос."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9adbbbc-664e-3893-9e31-aba45a053638",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется при словах, являющихся обобщением, итогом, выводом из чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4e6a3d-0573-43cc-9b3b-6f68091d0d9d",
                                                "sense_id": "d9adbbbc-664e-3893-9e31-aba45a053638",
                                                "text": "Вот и всё."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23535896-f97e-31ba-b4da-af4715613d30",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется в восклицательных предложениях для усиления их эмоциональной окрашенности или выражения удивления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df37708d-d8b1-421e-97f5-4bf259098833",
                                                "sense_id": "23535896-f97e-31ba-b4da-af4715613d30",
                                                "text": "Ах вот как!"
                                            },
                                            {
                                                "example_id": "631e6903-a05b-46cc-bbe3-ebf51a16677e",
                                                "sense_id": "23535896-f97e-31ba-b4da-af4715613d30",
                                                "text": "Вот такой вот клювище!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f1aea33-28f9-3ec1-8478-72c5e39ae7bc",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется для привлечения внимания собеседника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f769ca-76ba-4dad-90b9-b8416a070255",
                                                "sense_id": "9f1aea33-28f9-3ec1-8478-72c5e39ae7bc",
                                                "text": "— Вот смотрите, — он махнул рукой через поляну. — Видите?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b86e820-7ae6-3cd5-a6c8-34943becef23",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "в сочетании с частицами: ведь, то-то, уж и т. п. образует сложные усилительные частицы, подчеркивающие эмоциональную сторону речи, усиливающие выразительность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3b9877-4b60-4368-b340-1439769ce5b8",
                                                "sense_id": "2b86e820-7ae6-3cd5-a6c8-34943becef23",
                                                "text": "Вот ведь оболтус какой!"
                                            },
                                            {
                                                "example_id": "3e2c6599-01f8-4257-a9d3-50294d0c5805",
                                                "sense_id": "2b86e820-7ae6-3cd5-a6c8-34943becef23",
                                                "text": "Вот то-то я гляжу!"
                                            },
                                            {
                                                "example_id": "5fc19c54-15f4-4fea-96d0-b52e81bf5f32",
                                                "sense_id": "2b86e820-7ae6-3cd5-a6c8-34943becef23",
                                                "text": "Вот уж по кому каторга давно тоскует!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343b52e2-69b6-35d1-8224-6c1ee8fa9c6d",
                                        "entry_id": "ef841fa4-fc98-3c36-974f-2edd3fa9ba62",
                                        "glosses": [
                                            "употребляется в значении связки"
                                        ],
                                        "tags": [
                                            "вводное слово"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd88f893-a6db-478d-8d26-ac33dd2c7c1b",
                                                "sense_id": "343b52e2-69b6-35d1-8224-6c1ee8fa9c6d",
                                                "text": "Вот скажем…"
                                            },
                                            {
                                                "example_id": "aab85639-0cb5-42df-9ea2-bf71f3835e99",
                                                "sense_id": "343b52e2-69b6-35d1-8224-6c1ee8fa9c6d",
                                                "text": "Вот однажды…"
                                            },
                                            {
                                                "example_id": "944d3dbb-59b7-4bf5-8166-d54abd452566",
                                                "sense_id": "343b52e2-69b6-35d1-8224-6c1ee8fa9c6d",
                                                "text": "Вот если…"
                                            },
                                            {
                                                "example_id": "a421fca2-acfb-442c-b007-90a67381d1a3",
                                                "sense_id": "343b52e2-69b6-35d1-8224-6c1ee8fa9c6d",
                                                "text": "Вот например…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
