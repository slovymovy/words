                        "entry_id": "81ee5b2b-2829-3217-a560-e87ebc696686",
                        "glosses": [
                            "een scheidingslijn in het oosten; de uiterste rand in het oosten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa831e4-f383-4227-8970-12940af6704b",
                                "sense_id": "10cd2eb7-9058-364e-ac71-90860ccb26ba",
                                "text": "Eind vijftiende eeuw werd hier een verdedigingsgracht gegraven die de oostgrens van de stad vormde."
                            },
                            {
                                "example_id": "4e9a6e48-675e-4aeb-921c-b5be398192b2",
                                "sense_id": "10cd2eb7-9058-364e-ac71-90860ccb26ba",
                                "text": "Op verschillende wegen in Nederland is het zaterdag ook erg druk door vakantieverkeer. Dat geldt onder meer voor de wegen richting het zuiden (de A16 en de A27) en richting de oostgrens. Ook zijn er veel mensen onderweg in Zeeland en Friesland."
                            }
                        ]
                    }
