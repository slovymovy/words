                        "examples": [
                            {
                                "example_id": "b32eec86-d7b3-4c24-b1a0-2976910ce339",
                                "sense_id": "98eeaf63-5240-33b2-87c7-23243b82ce4f",
                                "text": "Vous faites, certes, allusion à l'auto-palpation ; pensez-vous réellement que l'on puisse laisser une femme « s'auto-palper » plus de cinq ans ?"
                            },
                            {
                                "example_id": "dd466907-e066-42f9-95fa-82982162fec6",
                                "sense_id": "98eeaf63-5240-33b2-87c7-23243b82ce4f",
                                "text": "Chaque femme est encouragée à observer régulièrement ses seins, à s'auto-palper et à effectuer une mammographie annuelle."
                            },
                            {
                                "example_id": "cd5a0cc5-8bad-4689-bea4-c561621f3b9f",
                                "sense_id": "98eeaf63-5240-33b2-87c7-23243b82ce4f",
                                "text": "Il est donc absolument nécessaire de vous auto-palper régulièrement."
                            }
                        ]
                    }
