                                    {
                                        "sense_id": "7575c43f-4817-3730-a121-94aa404a0b71",
                                        "entry_id": "df1ba4d5-8fdf-39e0-9dd0-e0d25a25473a",
                                        "glosses": [
                                            "Lehre von alten Schriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f94f467-8675-4217-8937-b91310fc54bf",
                                                "sense_id": "7575c43f-4817-3730-a121-94aa404a0b71",
                                                "text": "„Die Schrift ist makelloses klassisches Griechisch und mehrere Studenten der Paläografie haben bestätigt, dass die Buchstaben in einer Kursivschrift zu Papier gebracht wurden, wie sie im 2. Jahrhundert vor Christus gebräuchlich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67c8b498-c6d9-4346-a93f-936471e92424",
                        "source_entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                        "source_sense_description": "study of old forms of writing",
                        "target_lang_word": "Paläographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                        "entry_id": "ea13ae4c-903e-34b6-976f-c88b99408ed8",
                                        "glosses": [
                                            "Lehre von alten Schriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f82b378-e39c-4d25-8fe1-4b96a4e1316d",
                                                "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                                "text": "Die Paläographie ist eine historische Hilfswissenschaft."
                                            },
                                            {
                                                "example_id": "7636cf63-aa35-4155-9aa5-d4f82e7ccaa7",
                                                "sense_id": "6e87eda7-6342-3327-be89-aaf98a47fa76",
                                                "text": "„Einmal hat man die Möglichkeit, nach diesem Modell innerhalb der Paläographie (der historischen Handschriftenkunde) systematischer – bewußter systematisch – zu arbeiten als bisher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
