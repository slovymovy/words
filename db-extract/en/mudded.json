                        "target_lang_word": "boueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Plein de boue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f95dfc-e8ac-4e66-9e66-0d3bb1dd4526",
                                                "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                                "text": "Les convois funèbres se succédaient, avec leurs escortes de sous-officiers boueux et de rosses efflanquées."
                                            },
                                            {
                                                "example_id": "af71b4c0-32b6-4873-b434-cdb314a05a08",
                                                "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                                "text": "Il contemplait les pousses des palmiers arrosées par de petit canaux d'eau boueuse."
                                            },
                                            {
                                                "example_id": "16e85463-8fc5-4226-9406-e1560a53df83",
                                                "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                                "text": "Source boueuse, source dont l’eau est mêlée de boue minérale, utilisée dans certaines stations thermales."
                                            },
                                            {
                                                "example_id": "9aeae811-7664-42dd-b5a3-277dd74497e6",
                                                "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d’habitation y sont exécrables."
                                            },
                                            {
                                                "example_id": "d8f5d911-3bde-4958-80f6-d515d3842f05",
                                                "sense_id": "cd7e0b94-4fca-36c0-92a6-d3dc0afd473b",
                                                "text": "Il regardait au bas de la falaise la Morava tenter avec peine de faire pénétrer ses eaux vertes dans les flots boueux du Danube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec71267a-f69b-39a2-98fb-dc855b2655da",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Par métaphore"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fa94ae-0fa4-4cc8-8483-9fd976bff016",
                                                "sense_id": "ec71267a-f69b-39a2-98fb-dc855b2655da",
                                                "text": "Plus rien, à partir du Charolais, ne fait souvenir de la vallée du Rhône. Des prairies grasses, un ciel boueux, des mœurs, des goûts contraires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213cae60-c57a-3ca2-a389-39383e545385",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Semblable à la boue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c21e35-ff48-4dc5-95b8-429f4051d67a",
                                                "sense_id": "213cae60-c57a-3ca2-a389-39383e545385",
                                                "text": "Une boueuse couleur marron-bordeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a22e7de-3d24-3b3b-a176-8a3a81ac4b7a",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Transformé en boue, détrempé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b417496f-11ae-496f-8154-ff4b27b6667d",
                                                "sense_id": "9a22e7de-3d24-3b3b-a176-8a3a81ac4b7a",
                                                "text": "Le sol est boueux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8efc8d6-dea7-33e6-93c2-b43119583335",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Grossier, sale, impur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51173677-069d-4642-81ed-d0760b88b998",
                                                "sense_id": "d8efc8d6-dea7-33e6-93c2-b43119583335",
                                                "text": "Un flot boueux de gros mots monta de la cour des cuisines."
                                            },
                                            {
                                                "example_id": "ba2b3ef3-f519-47c1-bb8e-7e246deac7c0",
                                                "sense_id": "d8efc8d6-dea7-33e6-93c2-b43119583335",
                                                "text": "Ce n'est qu'avec difficulté que nous parvenons à nous procurer quelques outres d'un liquide boueux épais."
                                            },
                                            {
                                                "example_id": "279a2905-2d56-4100-9636-4065738c1651",
                                                "sense_id": "d8efc8d6-dea7-33e6-93c2-b43119583335",
                                                "text": "Les tableaux accrochés au mur étaient inregardables, la peinture était merdique, boueuse et terne, et tous les visages enjoués autour de moi me faisaient penser à des oiseaux de proie, des charognards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acea1fa9-24b6-39da-b0bf-47ac3ad306f8",
                                        "entry_id": "4225ad2d-5820-3218-896e-7f2b72b28e14",
                                        "glosses": [
                                            "Dont l’encre déborde du trait."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5e18a4f-56d5-4c48-b983-65c8ce86c4ce",
                                                "sense_id": "acea1fa9-24b6-39da-b0bf-47ac3ad306f8",
                                                "text": "Écriture boueuse."
                                            },
                                            {
                                                "example_id": "8689764d-8cc6-4a57-992f-07bf6757f771",
                                                "sense_id": "acea1fa9-24b6-39da-b0bf-47ac3ad306f8",
                                                "text": "Estampe boueuse, estampe tirée sur une planche mal essuyée et où il est resté du noir entre les hachures."
                                            },
                                            {
                                                "example_id": "ddbc2bfd-96a7-49d5-91f3-db94b33ecdf1",
                                                "sense_id": "acea1fa9-24b6-39da-b0bf-47ac3ad306f8",
                                                "text": "Impression boueuse, celle dont l’encre s’écarte et tache le papier au-delà de l’empreinte du caractère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "087e12c8-da14-33f9-a098-5b8783188361",
                                        "entry_id": "8f8fabb5-bcd4-36f0-aa8c-5d79d4d0f5b9",
                                        "glosses": [
                                            "Variante de boueur, éboueur."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44834633-251b-402c-ba68-ece448d9900f",
                                                "sense_id": "087e12c8-da14-33f9-a098-5b8783188361",
                                                "text": "« Mais puisqu’on pouvait l’enterrer ! » C’était une idée d’enfant, qu’elle n’eût point la tête entaillée par la pelle du boueux ou qu’elle ne vidât pas ses entrailles sous les roues d’un camion ! Je la vis longtemps ainsi, guillotinée et éventrée, au lieu d’avoir une petite place sous la terre où j’aurais su qu’il y avait un être qui m’avait aimé, qui me léchait les mains quand elles étaient bleues et gonflées, et regardait d’un œil où je croyais voir des larmes son jeune maître qui essuyait les siennes…"
                                            },
                                            {
                                                "example_id": "3564e335-f31a-4ac7-942e-934c00afa040",
                                                "sense_id": "087e12c8-da14-33f9-a098-5b8783188361",
                                                "text": "Sous le porche, un boueux attendait l'arrivée de la voiture en songeant que, par un temps pareil, elle ne viendrait sans doute pas."
                                            },
                                            {
                                                "example_id": "0f22f70c-bfae-44b4-ab07-f359c3f198cf",
                                                "sense_id": "087e12c8-da14-33f9-a098-5b8783188361",
                                                "text": "Les boueux passent pas devant ma maison à cause de l'escalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ac56a0-c9db-3347-bc09-b749ffc1db09",
                                        "entry_id": "8f8fabb5-bcd4-36f0-aa8c-5d79d4d0f5b9",
                                        "glosses": [
                                            "Technicien des boues de forage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690a259d-285d-4a3c-86c9-f09e25eb8969",
                                                "sense_id": "84ac56a0-c9db-3347-bc09-b749ffc1db09",
                                                "text": "Sur les forages pétroliers, le boueux est la personne qui surveille et ajuste les paramètres de la boue de forage pour garantir un travail efficace des outils et une bonne sécurité du puits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
