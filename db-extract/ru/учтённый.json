                        ],
                        "form": "учтены́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f74ddcf-3d0d-3378-91e1-5086ae99f3bf",
                        "entry_id": "32a6daf9-7f08-34c4-a775-3e4ced0c7987",
                        "glosses": [
                            "страд. прич. прош. вр. от учесть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "906e2bf1-67e0-4e37-ba02-37edae79638f",
                                "sense_id": "7f74ddcf-3d0d-3378-91e1-5086ae99f3bf",
                                "text": "Подсчитаны только обыкновенные доходы и обыкновенные расходы и не учтены чрезвычайные."
                            },
                            {
                                "example_id": "b3c1170b-4ec6-4455-966b-81a58338e074",
                                "sense_id": "7f74ddcf-3d0d-3378-91e1-5086ae99f3bf",
                                "text": "Это обстоятельство должно быть учтено при разработке дизайна сада."
                            },
                            {
                                "example_id": "71d0f97f-0a54-47a6-8613-6050b72cc25a",
                                "sense_id": "7f74ddcf-3d0d-3378-91e1-5086ae99f3bf",
                                "text": "Впервые была учтена скорость реакции человека на происходящие вокруг него события."
                            },
                            {
                                "example_id": "63633a65-9498-427e-ad27-445358a8bfa7",
                                "sense_id": "7f74ddcf-3d0d-3378-91e1-5086ae99f3bf",
                                "text": "Показатель учтенной болезни наркоманией среди женщин увеличился почти в 15 раз."
                            }
                        ]
                    }
                ],
