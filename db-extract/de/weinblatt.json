                        "examples": [
                            {
                                "example_id": "d6c50605-1888-4387-ae6f-0f203cb8a0c5",
                                "sense_id": "b8446323-d8cc-30cc-a75d-f1b68c18e1e5",
                                "text": "Die herbstlichen Weinblätter sind schön anzusehen."
                            },
                            {
                                "example_id": "79c817fa-1adc-47ca-a499-2f7e6ea8ed69",
                                "sense_id": "b8446323-d8cc-30cc-a75d-f1b68c18e1e5",
                                "text": "Eingelegte Weinblätter werden zum Füllen mit Reis- oder Käsespezialitäten verwendet."
                            },
                            {
                                "example_id": "c08125bd-1c92-4ed0-a241-60bd7e02206f",
                                "sense_id": "b8446323-d8cc-30cc-a75d-f1b68c18e1e5",
                                "text": "„Oft fressen sie nur die obersten Schichten der Weinblätter ab und lassen die untere Epidermis als durchsichtiges Häutchen stehen.“"
                            }
                        ],
