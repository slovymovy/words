                ],
                "senses": [
                    {
                        "sense_id": "f322e68d-d1a2-3cf4-a968-b861bcfe6eff",
                        "entry_id": "eda34bc3-2d2b-30ac-a362-2a25823a0642",
                        "glosses": [
                            "Attraper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cba2cb31-67aa-4283-a5fc-088d70a2fdad",
                                "sense_id": "f322e68d-d1a2-3cf4-a968-b861bcfe6eff",
                                "text": "Chautard, découvert, voulut redescendre, mais arcquepincé et arc—bouté par les quatre barreaux plantés sur sa poitrine et son dos, il resta quelque temps exposé au coups de fusil de la sentinelle, sans pouvoir bouger; enfin il fit un suprême effort, tordit les barreaux et retomba dans le cachot."
                            }
                        ]
                    },
                    {
                        "sense_id": "e898a085-2bcb-3f36-b88d-b2e87e38b9a6",
                        "entry_id": "eda34bc3-2d2b-30ac-a362-2a25823a0642",
                        "glosses": [
                            "Arrêter (quelqu’un)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "310dcec4-c300-4e6f-ac3b-fae60250ccca",
                                "sense_id": "e898a085-2bcb-3f36-b88d-b2e87e38b9a6",
                                "text": "Pour tout arranger encore, nous étions samedi, jour de gala pour la Maison J’t’arcquepince."
                            },
                            {
                                "example_id": "c662fbb9-9ac4-4f06-b557-bb1d4bfb1326",
                                "sense_id": "e898a085-2bcb-3f36-b88d-b2e87e38b9a6",
                                "text": "Pour mieux rattraper le seul assassin que j’aie jamais voulu arcquepincer de toute ma carrière !"
                            }
                        ]
                    }
                ],
