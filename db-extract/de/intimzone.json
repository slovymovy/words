                        "glosses": [
                            "Bereich, der besonders privat und geschützt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d089c08-61da-4e01-bd1e-ec5c261ffde2",
                                "sense_id": "1123b74e-044e-31b3-90a1-b6dc5e3e7d05",
                                "text": "Volle Straßenbahnen widern mich an, weil dort ständig Menschen in meine Intimzone eindringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
