                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b071f504-a426-4c05-b88d-85fef7e3a8d8",
                                "sense_id": "3776af81-6dba-3967-83c1-89a626ea22ea",
                                "text": "Czy w tej cegielni ceglastobrązowe cegły są w ciągłej produkcji?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9857b33-2839-4497-9cbc-30a1e6eb8fb9",
