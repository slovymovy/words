                ],
                "translations": [
                    {
                        "translation_id": "103b327f-9d09-4fc5-8a59-966417a89df1",
                        "source_entry_id": "b0d8361b-46b8-39b4-9342-0d566d4f751b",
                        "source_sense_id": "3c49e731-c13b-3c43-a878-34ccff08ee5f",
                        "target_lang_word": "webzine",
