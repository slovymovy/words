                                        "entry_id": "173e0ec8-b1ed-3c24-aa41-c50cb929af89",
                                        "glosses": [
                                            "Mariä Lichtmess, katholischer Feiertag am 2. Februar"
                                        ],
                                        "tags": [
                                            "kurz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4ae8b7-da36-4fde-a9b4-0e34b8eae59f",
                                                "sense_id": "eed8dd5f-92d4-309f-a183-bf892567f1af",
                                                "text": "Ist’s an Lichtmess hell und rein, wird ein langer Winter sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88b0880c-09b2-43ac-ac55-ef007d0f5d9e",
                        "source_entry_id": "03455428-ce15-30a4-b899-b0ae262eb0f3",
                        "source_sense_id": "bcafdb4b-326a-3873-8566-a46c080e8e1a",
                        "target_lang_word": "Candlemas",
                        "target_lang_code": "en",
