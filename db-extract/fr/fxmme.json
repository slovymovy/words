                                "target_senses": [
                                    {
                                        "sense_id": "a3b4b11b-d0b8-3668-b846-50a99afefc36",
                                        "entry_id": "c244fc2d-785b-398e-9bcf-f579daad25df",
                                        "glosses": [
                                            "Feminist spelling of woman"
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34014f0a-46f0-4c23-b73b-77a69b9747e7",
                                                "sense_id": "a3b4b11b-d0b8-3668-b846-50a99afefc36",
                                                "text": "But it does insure that the community won't lose the land if a womon decides, for whatever reason, not to pay."
                                            },
                                            {
                                                "example_id": "c4f4dc2a-cd66-4ad8-bbf3-f9164afffb6a",
                                                "sense_id": "a3b4b11b-d0b8-3668-b846-50a99afefc36",
                                                "text": "Womon seeks womon to share 2 bdrm apt in JP."
                                            },
                                            {
                                                "example_id": "6fc021d5-d3e9-44cd-8969-fafe6436aa7b",
                                                "sense_id": "a3b4b11b-d0b8-3668-b846-50a99afefc36",
                                                "text": "I don't think she was saying that you become responsible for the racism directed at you once you identify as a black womon, only that one could not assume that any given netizen was or was not a member of a minority without self-identification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
