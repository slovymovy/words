                    "frequency": "Middle",
                    "semantic_group_id": "attirance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette région sauvage possède un véritable <w>attrait</w> pour les randonneurs en quête de calme."
                        },
                        {
                            "text": "L'<w>attrait</w> de la nouveauté pousse souvent les consommateurs à changer régulièrement d'appareil."
                        }
                    ],
                    "synonyms": [
