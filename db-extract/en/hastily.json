                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befd3f37-801a-477d-835d-f4559919fb10",
                                                "sense_id": "d3299a91-47f8-34c2-8648-ee1ad927f446",
                                                "text": "Il parcourut hâtivement l’article."
