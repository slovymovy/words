                ],
                "senses": [
                    {
                        "sense_id": "e80eb868-17f4-373e-8a18-682f014fdfd9",
                        "entry_id": "c6a9b949-1793-3192-acab-51b99aeb741b",
                        "glosses": [
                            "Agrémenter de fioritures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf45b93-651f-4b8d-b7b0-b8ecc35eca4d",
                                "sense_id": "e80eb868-17f4-373e-8a18-682f014fdfd9",
                                "text": "À cette heure, il est encore à fioriturer le même motet glapissant."
                            },
                            {
                                "example_id": "e6339acf-9b6f-4347-b1f8-90941b78e71e",
                                "sense_id": "e80eb868-17f4-373e-8a18-682f014fdfd9",
                                "text": "Au bout d’un couloir ils entrèrent un peu plus délibérément dans une grande pièce à usage de salon, moins surchargée de dorures que le hall mais assez fioriturée par des rinceaux à amours."
                            },
                            {
                                "example_id": "7f085468-c4f2-41a9-a25f-f6b05990de4f",
                                "sense_id": "e80eb868-17f4-373e-8a18-682f014fdfd9",
                                "text": "Aucune liberté n’est laissée à l’exécutant de fioriturer à son gré."
                            },
                            {
                                "example_id": "12b307ec-aa9c-40c7-a70d-fa10e9401091",
                                "sense_id": "e80eb868-17f4-373e-8a18-682f014fdfd9",
                                "text": "Il faudra combler, enquêter, fioriturer."
                            }
                        ]
                    }
                ],
