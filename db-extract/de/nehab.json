                "senses": [
                    {
                        "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                        "entry_id": "8691928b-9b23-3493-b792-bce728a71ab3",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd42ec32-a606-4da0-9a6d-7b8327329da5",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Frau Nehab ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cf7b0246-1069-44e8-b563-bb9f653a3564",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Herr Nehab wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f7854d6c-2b50-4134-99ac-ba2a817b4a23",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Die Nehabs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b733b02a-baf6-49cc-8b70-06d9825ee12b",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Der Nehab trägt nie die Schals, die die Nehab ihm strickt."
                            },
                            {
                                "example_id": "94957555-5f6c-4148-a972-c93b86155d83",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nehab kommt, geht der Herr Nehab.“"
                            },
                            {
                                "example_id": "b3836381-1eac-4596-94b5-8cb4264fbf40",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Nehab kommt und geht."
                            },
                            {
                                "example_id": "bc527499-08b4-45b2-828f-927573d3341e",
                                "sense_id": "4d42f22d-acd4-3d8b-8fd2-2a59bd286b89",
                                "text": "Nehabs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
