                "senses": [
                    {
                        "sense_id": "877b37c6-ea8b-36b7-8864-2ada79a6f7cf",
                        "entry_id": "9ab8dcde-2840-39c7-8b7d-c626b5d8e2e8",
                        "glosses": [
                            "weiblicher Schurke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fa724a-32d6-434e-8421-50040a8b65b6",
                                "sense_id": "877b37c6-ea8b-36b7-8864-2ada79a6f7cf",
                                "text": "Wenn es denn eine Schurkin in der ganzen Geschichte gab, dann war es die Schwiegertochter."
                            },
                            {
                                "example_id": "f72c5688-5c9c-4c59-a865-ece267636418",
                                "sense_id": "877b37c6-ea8b-36b7-8864-2ada79a6f7cf",
                                "text": "„Es war die Hauswirtin, die sich als Schurkin erwies.“"
                            },
                            {
                                "example_id": "ce0eeb53-b50f-460a-956e-8daf8d7aab33",
                                "sense_id": "877b37c6-ea8b-36b7-8864-2ada79a6f7cf",
                                "text": "„Während meines Berichtes nannte sie die niederträchtige Melulla immer wieder eine Schurkin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdf8ff94-8053-4e44-9853-07730139d4b9",
                        "source_entry_id": "9ab8dcde-2840-39c7-8b7d-c626b5d8e2e8",
                        "source_sense_id": "877b37c6-ea8b-36b7-8864-2ada79a6f7cf",
                        "source_sense_description": "weiblicher Schurke",
                        "target_lang_word": "rogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f23735a1-4bd2-30e4-ba6c-8913e72f6c39",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "A scoundrel, rascal or unprincipled, deceitful, and unreliable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03795e14-42bd-4fd6-bbaa-ff0f0e46a98c",
                                                "sense_id": "f23735a1-4bd2-30e4-ba6c-8913e72f6c39",
                                                "text": "And meet time it was, when yon usher, vinegar-faced rogue that he is, began to inquire what popish trangam you were wearing […]"
                                            },
                                            {
                                                "example_id": "0771be34-19bf-4754-af5f-3d60de21a1da",
                                                "sense_id": "f23735a1-4bd2-30e4-ba6c-8913e72f6c39",
                                                "text": "He had told more lies in his time, and undergone more baseness of stratagem in order to stave off a small debt, or to swindle a poor creditor, than would have sufficed to make a fortune for a braver rogue."
                                            },
                                            {
                                                "example_id": "cd982df4-0a5e-4a82-8453-1d99137936bd",
                                                "sense_id": "f23735a1-4bd2-30e4-ba6c-8913e72f6c39",
                                                "text": "“… No rogue e’er felt the halter draw, with a good opinion of the law, and perhaps my own detestation of the law arises from my having frequently broken it. […]”"
                                            },
                                            {
                                                "example_id": "ef8dc022-4330-4d39-a8bf-19973c997ced",
                                                "sense_id": "f23735a1-4bd2-30e4-ba6c-8913e72f6c39",
                                                "text": "As The Dark Knight Rises brings a close to Christopher Nolan’s staggeringly ambitious Batman trilogy, it’s worth remembering that director chose The Scarecrow as his first villain—not necessarily the most popular among the comic’s gallery of rogues, but the one who set the tone for entire series."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adcd7a59-c168-3744-a8e4-3433d1dab512",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "A mischievous scamp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261493bb-f0fc-4c95-9aa2-840752494923",
                                                "sense_id": "adcd7a59-c168-3744-a8e4-3433d1dab512",
                                                "text": "Ah, you sweet little rogue, you!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd8acf8-5c60-347f-9ffc-ab587e287a5e",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "A vagrant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ecc472c-16eb-333b-b039-388f9640558a",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "Malware that deceitfully presents itself as antispyware."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d679e174-5cce-4b78-bf44-9388d38c652a",
                                                "sense_id": "4ecc472c-16eb-333b-b039-388f9640558a",
                                                "text": "An entry in the Microsoft Malware Protection Center's Threat Research & Response Blog shows that rogue AV, also known as scareware, is ruling the malware roost, as 6 top of the 10 malicious programs removed by the MSRT (Malicious Software Removal Tool) in the US in October were 'rogues'."
                                            },
                                            {
                                                "example_id": "d23dac51-8731-43a4-a8f1-e79d4f57dc56",
                                                "sense_id": "4ecc472c-16eb-333b-b039-388f9640558a",
                                                "text": "Next, click the \"Installed on\" heading in the Windows 7 uninstaller to sort the list by date, and see if any programs have the same date and time stamps as your rogues."
                                            },
                                            {
                                                "example_id": "b7cd5267-87bc-4c0e-a563-cf5d74e056d8",
                                                "sense_id": "4ecc472c-16eb-333b-b039-388f9640558a",
                                                "text": "Now though researchers at Microsoft's Malware Protection Center are reporting a downward trend in the traffic generated by some of the most popular rogues over the past 12 months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeaba3f5-03df-30d4-b7ae-8421b00c1fbe",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "An aggressive animal separate from the herd, especially an elephant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69c372c-c325-4134-88a2-36d34fe41c20",
                                                "sense_id": "aeaba3f5-03df-30d4-b7ae-8421b00c1fbe",
                                                "text": "If he is a rogue, and there's any truth to territoriality at all, we got a good chance of spotting him between Cape Scott and South Beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3865e86f-6538-32ac-a9e0-5a684eaa35bd",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "A plant that shows some undesirable variation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e806301-4098-4a72-929b-a5983f1fd7f1",
                                                "sense_id": "3865e86f-6538-32ac-a9e0-5a684eaa35bd",
                                                "text": "2000 Carol Deppe, Breed Your Own Vegetable Varieties, Totnes: Chelsea Green Pub.\nMaintaining varieties also requires selection, however. It's usually referred to as culling or roguing. ...we examine the [plant] population and eliminate the occasional rogue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bbcaabd-52b2-3f4b-a58d-fcc55b2f403c",
                                        "entry_id": "9826e9cd-bce0-3405-85b5-54a68244ad56",
                                        "glosses": [
                                            "A character class focusing on stealthy conduct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58a3edfa-e665-3dc0-bf7c-49704ec76049",
                                        "entry_id": "7331fa4c-5bed-3b87-8ca8-f52a6173b20b",
                                        "glosses": [
                                            "Vicious and solitary."
                                        ],
                                        "tags": [
                                            "of an animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e700bd5-f6d8-4c6d-a9c7-799cc3374e5c",
                                                "sense_id": "58a3edfa-e665-3dc0-bf7c-49704ec76049",
                                                "text": "Mosquito. One lone rogue mosquito."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd907bf-044c-3a79-ae6e-92c22f5b9a97",
                                        "entry_id": "7331fa4c-5bed-3b87-8ca8-f52a6173b20b",
                                        "glosses": [
                                            "Large, destructive and unpredictable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbbf2ade-d7ac-304f-aad3-773b7fda793a",
                                        "entry_id": "7331fa4c-5bed-3b87-8ca8-f52a6173b20b",
                                        "glosses": [
                                            "Deceitful, unprincipled."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82870824-5f16-49d7-ba9d-33250252defd",
                                                "sense_id": "dbbf2ade-d7ac-304f-aad3-773b7fda793a",
                                                "text": "In the minds of Republican hard-liners, the \"Silent Majority\" of Americans who had elected the President, and even Nixon's two Democrat predecessors, China was a gigantic nuke-wielding rogue state prepared to overrun the free world at any moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a388c0-1a71-38ba-b50f-aaa1238b9c4c",
                                        "entry_id": "7331fa4c-5bed-3b87-8ca8-f52a6173b20b",
                                        "glosses": [
                                            "Mischievous, unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a812ad-cf9f-46a3-983d-0c44b7bb5569",
                                                "sense_id": "b1a388c0-1a71-38ba-b50f-aaa1238b9c4c",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef632fe7-b786-3f0d-aeb0-154cf0bd918d",
                                        "entry_id": "c218dd27-48fb-36aa-b65a-f2ab429230c5",
                                        "glosses": [
                                            "To cull; to destroy plants not meeting a required standard, especially when saving seed, rogue or unwanted plants are removed before pollination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5939cf42-734d-4bca-8f46-620148dddc62",
                                                "sense_id": "ef632fe7-b786-3f0d-aeb0-154cf0bd918d",
                                                "text": "2000 Carol Deppe, Breed Your Own Vegetable Varieties, Totnes: Chelsea Green Pub.\nMaintaining varieties also requires selection, however. It's usually referred to as culling or roguing. ...we examine the [plant] population and eliminate the occasional rogue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa97b61-7c3f-384e-89f5-e65c1d5dfc7a",
                                        "entry_id": "c218dd27-48fb-36aa-b65a-f2ab429230c5",
                                        "glosses": [
                                            "To cheat."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6ac116-b6d5-4d16-abbc-98260d8b21fb",
                                                "sense_id": "4aa97b61-7c3f-384e-89f5-e65c1d5dfc7a",
                                                "text": "And then to think that Mark should have rogued me of five shiners! He was clever—that's a fact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04cbf7ec-496e-3fb9-b8d6-653271423008",
                                        "entry_id": "c218dd27-48fb-36aa-b65a-f2ab429230c5",
                                        "glosses": [
                                            "To give the name or designation of rogue to; to decry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a89c3e38-9e84-4482-a352-90cab5e5d436",
                                                "sense_id": "04cbf7ec-496e-3fb9-b8d6-653271423008",
                                                "text": "he Atheists may endeavour to rogue and ridicule all incorporeal Substance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f48cd9a1-e593-3387-9bc7-7f3efcdc91f9",
                                        "entry_id": "c218dd27-48fb-36aa-b65a-f2ab429230c5",
                                        "glosses": [
                                            "To wander; to play the vagabond; to play knavish tricks."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "127cd142-d070-4dbf-a6e2-a884f22da2ac",
                                                "sense_id": "f48cd9a1-e593-3387-9bc7-7f3efcdc91f9",
                                                "text": "if hee be but once so taken idlely roguing"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
