                "senses": [
                    {
                        "sense_id": "0a377730-750d-36bb-aca6-7baa81bf5533",
                        "entry_id": "7ae204dd-74c5-30b0-b281-a34712983de5",
                        "glosses": [
                            "Attribuer un caractère hérétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb6b298-1e19-4a99-9d08-5855d8f98956",
                                "sense_id": "0a377730-750d-36bb-aca6-7baa81bf5533",
                                "text": "Un élément propre dans son caractère particulier à l’entité à « hérétiser » — des sentinelles — pourrait ainsi s’avérer être d’une « essence », d’une nature générale parallèle au construit ;"
                            },
                            {
                                "example_id": "13d1caba-c35b-4a74-a89f-164886df1941",
                                "sense_id": "0a377730-750d-36bb-aca6-7baa81bf5533",
                                "text": "Calvin n'est pas le seul à hérétiser ceux qui pensent ; mais toi, agis-tu aussi ainsi ?"
                            },
                            {
                                "example_id": "60bb693a-d016-425a-b6c9-6b842df1f2ba",
                                "sense_id": "0a377730-750d-36bb-aca6-7baa81bf5533",
                                "text": "L'on va m'hérétiser après le conseil de guerre qui va se tenir à présent;"
                            }
                        ]
                    }
