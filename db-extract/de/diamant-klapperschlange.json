                "senses": [
                    {
                        "sense_id": "43a93a22-011e-3027-96d0-30d340358bc9",
                        "entry_id": "8859a974-9e7d-342e-b918-0bfce8a5eb4b",
                        "glosses": [
                            "im Südosten der USA verbreitete Klapperschlangenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fabce0bb-6fb4-47ff-a755-ec56515a6b0e",
                                "sense_id": "43a93a22-011e-3027-96d0-30d340358bc9",
                                "text": "„Schlangen! Zweifellos befanden sich ihre Löcher irgendwo am Fuß des Hügels, und vielleicht hatten sich in seinem höhlenartigen Inneren ein Dutzend riesiger Diamant-Klapperschlangen zusammengerollt, die nur darauf warteten, dass er seine Hand zu ihnen hineinsteckte.“"
                            },
                            {
                                "example_id": "ea264007-4425-4789-96f3-5ceda750c584",
                                "sense_id": "43a93a22-011e-3027-96d0-30d340358bc9",
                                "text": "„Ob zur Fauna auch Klapperschlangen gehörten? Diamant-Klapperschlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
