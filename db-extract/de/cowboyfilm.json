                "senses": [
                    {
                        "sense_id": "954fe9bd-2296-3330-91b8-7c1a0cdcd092",
                        "entry_id": "afdfa551-f540-3ff7-8009-e5f719850688",
                        "glosses": [
                            "Film, dessen Handlung im Wilden Westen spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc5e5e7-4f1f-470a-ae2a-c0eba0d108be",
                                "sense_id": "954fe9bd-2296-3330-91b8-7c1a0cdcd092",
                                "text": "„Wie ein schlechter Cowboyfilm, murrt der Kunstkritiker Niklas Maak über Beltracchis, des loners, Auftritt.“"
                            },
                            {
                                "example_id": "4dd6ed3c-057e-434c-ab87-9387bf51c2a8",
                                "sense_id": "954fe9bd-2296-3330-91b8-7c1a0cdcd092",
                                "text": "„Der an Kyles Memoiren angelehnte „American Sniper“ verherrlicht die amerikanische Frontier-Mentalität – es handelt sich um einen neuen Cowboyfilm von einem ehemaligen Cowboyfilm-Star.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
