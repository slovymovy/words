                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69370629-690b-41a2-8228-73fcbcf427b5",
                                                "sense_id": "9cbf1280-e790-3827-9820-c4dc35b715ac",
                                                "text": "Die Insolvenz der Firma war unvermeidbar."
                                            },
                                            {
                                                "example_id": "3a0c2add-2d37-414e-8d0c-fdb2d6748182",
                                                "sense_id": "9cbf1280-e790-3827-9820-c4dc35b715ac",
                                                "text": "„Die Autoren sind sich der Grenzen und der unvermeidbaren Defizite ihrer Untersuchung bewusst und skizzieren deswegen Forschungsdesiderate, die zukünftige Forschungen anregen können.“"
                                            }
