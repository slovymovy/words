            {
                "entry_id": "9e5784fb-87be-3bd4-9f0a-77b14b711352",
                "word": "Gallurais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7254eed8-1293-3b49-94af-83c26b895da5",
                        "entry_id": "9e5784fb-87be-3bd4-9f0a-77b14b711352",
                        "glosses": [
                            "Habitant ou originaire de Gallura."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed6e15c-d0ab-44d4-a34f-567dfcef17c8",
                                "sense_id": "7254eed8-1293-3b49-94af-83c26b895da5",
                                "text": "Mais l’intercompréhension ne peut, à elle seule, fonder l’unité linguistique ; car il y a intercompréhension aussi entre un Porto-vecchiais et un Gallurais, ou entre un Bastiais et un Toscan."
                            },
                            {
                                "example_id": "7759402a-bd24-4e94-9a4d-aae266381bcb",
                                "sense_id": "7254eed8-1293-3b49-94af-83c26b895da5",
                                "text": "Avec une active politique de colonisation des autorités piémontaises, l’archipel de La Maddalena devient un centre dynamique qui attire des Corses du Sud et des Gallurais ce qui renforce les liens familiaux."
                            }
                        ]
                    }
                ],
