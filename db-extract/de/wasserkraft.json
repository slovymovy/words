                        "source_entry_id": "a1c6dc88-17af-3d17-8de3-edbc56b92277",
                        "source_sense_id": "6c875a80-89d2-3763-8da6-7deb587ae62b",
                        "source_sense_description": "Energie, die aus der Bewegung des Wassers stammt",
                        "target_lang_word": "water power",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "water power",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a2b55d5-6c5d-38f3-a962-9306b330e24c",
                                        "entry_id": "0df170ee-f987-3cd9-b2a4-6d548f289d57",
                                        "glosses": [
                                            "Mechanical or electrical energy derived from running or falling water; originally obtained from a waterwheel immersed in a stream; modern hydroelectric power is obtained from turbines fed from reservoirs."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c8ab1a-2dad-47ea-a1f0-460c963d8867",
                                                "sense_id": "7a2b55d5-6c5d-38f3-a962-9306b330e24c",
                                                "text": "Advantage has been taken of the abundant natural water-power resources (which compensate, to a large extent, for the absence of coal) and some 660 route miles have been electrified with overhead conductors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dce85a1d-135e-3b5b-9fbf-2f204d964dc1",
                                        "entry_id": "0df170ee-f987-3cd9-b2a4-6d548f289d57",
                                        "glosses": [
                                            "A site capable of generating power or the right to use a site to generate power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07c14a68-364a-3edc-aa33-1cbd76b6b2ca",
                                        "entry_id": "0df170ee-f987-3cd9-b2a4-6d548f289d57",
                                        "glosses": [
                                            "The capacity to shoot water, as from a fire hose or squirt gun"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b82de17-ac0b-483a-a13c-21ede61462f6",
                                                "sense_id": "07c14a68-364a-3edc-aa33-1cbd76b6b2ca",
                                                "text": "Fire trucks were parked everywhere: a new arrival was being carefully backed around the stacked pallets to add some new waterpower."
                                            }
                                        ]
                                    }
                                ]
                            }
