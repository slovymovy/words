                        "entry_id": "c7145b2a-95a1-35e9-bdde-9591b4153362",
                        "glosses": [
                            "bis ins 20. Jahrhundert benutztes Wundverbandsmaterial aus zerzupftem Leinen oder Baumwollstoff"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "992b6cf8-0bee-4115-a9ef-3093f06c1872",
                                "sense_id": "abd37b51-ea66-315a-86d7-7d678b1339de",
                                "text": "„Nachdem man das Bäuschgen hinweggenommen hat, so muß man damit anfangen, daß man die Scharpie aus der Mitte der Wunde gelinde hinwegnehme, das ist, diejenige Scharpie, die das Fleisch nicht unmittelbar berührt, und man muß alle die darauf lassen, die ihm noch anhängend ist;“"
                            },
                            {
                                "example_id": "e9680d58-6b9d-468a-9643-b1d98f475cda",
                                "sense_id": "abd37b51-ea66-315a-86d7-7d678b1339de",
                                "text": "„Diese Scharpie besteht aus neuer u. grauer Leinwand, die aber durch Chlor gebleicht wird;“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
