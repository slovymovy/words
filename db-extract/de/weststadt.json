                                "example_id": "ce395f3b-36bd-452d-80dd-64e3cf85dc41",
                                "sense_id": "2863242b-9188-35ba-9241-89fcafe43d61",
                                "text": "Das Amt befindet sich in der Weststadt."
                            },
                            {
                                "example_id": "714f871c-612b-46df-bb4d-63a782239d31",
                                "sense_id": "2863242b-9188-35ba-9241-89fcafe43d61",
                                "text": "Wenn sie durch die Weststadt kommen, grüßen sie Frau Meyer von mir."
                            },
                            {
                                "example_id": "263b0c0d-ba93-45bf-86f7-8e2963954c28",
                                "sense_id": "2863242b-9188-35ba-9241-89fcafe43d61",
                                "text": "Ihre Kindheit und Jugend verbrachten die Kinder in der Weststadt."
                            }
                        ],
