                                        "examples": [
                                            {
                                                "example_id": "5cd85950-2903-4988-a5f7-709dd212aa2c",
                                                "sense_id": "d43608e7-c249-3533-adcf-2a20480a3efe",
                                                "text": "Mit Fluchen konnte man ihnen nicht schaden."
