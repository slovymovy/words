                                                "sense_id": "fe481280-a1eb-307c-a418-2bf43bccdc2b",
                                                "text": "Die ist ein kniffliges Rätsel."
                                            },
                                            {
                                                "example_id": "19ade8d8-4965-4f7b-af8b-0f2d21fd70ab",
                                                "sense_id": "fe481280-a1eb-307c-a418-2bf43bccdc2b",
                                                "text": "„Historische Kunstwerke zu reinigen, ist oftmals eine knifflige Aufgabe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f24c7d7-3d49-362a-8e72-6b999bed8872",
                                        "entry_id": "55f09dac-e2c0-360a-84ae-3b6014686b65",
                                        "glosses": [
                                            "heikel, viel Vorsicht und Fingerspitzengefühl erforderlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad29842c-9ed7-4535-974f-aa3785509202",
                                                "sense_id": "1f24c7d7-3d49-362a-8e72-6b999bed8872",
                                                "text": "Die Situation ist sehr knifflig und sollte keinesfalls mit Gewalt gelöst werden."
                                            },
                                            {
                                                "example_id": "f4958854-b87a-42ae-9dd6-2eaaaaa9f8a0",
                                                "sense_id": "1f24c7d7-3d49-362a-8e72-6b999bed8872",
                                                "text": "„Offenbar handelt es sich um einen einfachen Aufschlagzünder, für Entschärfer weit weniger knifflig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
