                                        "entry_id": "15b533bc-9765-3c1c-b12a-6d2d947eb38c",
                                        "glosses": [
                                            "Qualité, emploi de commissaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fe6ca5-2a66-45ef-8ba4-484b978beea8",
                                                "sense_id": "7d7328ca-fe43-304a-a4f6-15e43cf87a19",
                                                "text": "Cet employé a obtenu un commissariat."
                                            },
                                            {
                                                "example_id": "9099ffe8-2f97-4d9d-a184-d5c82c514dab",
                                                "sense_id": "7d7328ca-fe43-304a-a4f6-15e43cf87a19",
                                                "text": "Haut commissariat, dignité du haut commissaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46502337-bc34-346f-bfc6-3ff8cf45a961",
                                        "entry_id": "15b533bc-9765-3c1c-b12a-6d2d947eb38c",
                                        "glosses": [
                                            "Lieu où siège le commissaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "913958bb-7fce-4ad9-b9a3-60ad29e7a6e1",
                                                "sense_id": "46502337-bc34-346f-bfc6-3ff8cf45a961",
                                                "text": "Dans tous les grands ports, il y a un commissariat de marine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488bc4ad-1421-30d4-a773-cdcc61f49ef1",
                                        "entry_id": "15b533bc-9765-3c1c-b12a-6d2d947eb38c",
                                        "glosses": [
                                            "Commissariat de police."
                                        ],
                                        "tags": [
                                            "common",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d667bd-f0ef-43c0-845c-3190416a170b",
                                                "sense_id": "488bc4ad-1421-30d4-a773-cdcc61f49ef1",
                                                "text": "Un pareil crime, si près du commissariat, en bordure du passage où le meurtrier risquait à son insu d'être surpris, se présentait, de prime abord, comme l'acte d'un fou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
