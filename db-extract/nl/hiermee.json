        "nl-extract.jsonl": [
            {
                "entry_id": "8ec1796a-8484-3f7a-8a69-fca699ca2f3c",
                "word": "hiermee",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b1def93-3981-37b1-96e2-9668647c79ca",
                        "entry_id": "8ec1796a-8484-3f7a-8a69-fca699ca2f3c",
                        "glosses": [
                            "met dit, met deze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95e6135-41d7-4236-a903-b4ca4dd84b8a",
                                "sense_id": "2b1def93-3981-37b1-96e2-9668647c79ca",
                                "text": "Hiermee kun je glas snijden."
                            },
                            {
                                "example_id": "f3c49556-73ff-498a-9930-2addf90bd8e5",
                                "sense_id": "2b1def93-3981-37b1-96e2-9668647c79ca",
                                "text": "Ik dacht even na; ik kon hiermee ophouden en naar mijn huis in Clapham gaan, dat net zo stil was."
                            },
                            {
                                "example_id": "3c086c5a-f5fd-4de2-bf7d-882b8ea0604f",
                                "sense_id": "2b1def93-3981-37b1-96e2-9668647c79ca",
                                "text": "Misschien zou ik me op een gegeven moment vervelen met alleen mijn eigen gedachten als vermaak. Of zou ik mezelf heel hard tegenkomen, ook al wist ik nog steeds niet precies wat hiermee bedoeld werd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1640398-cc0a-4a6b-8b2c-2d5eb93b552e",
                        "source_entry_id": "8ec1796a-8484-3f7a-8a69-fca699ca2f3c",
                        "source_sense_id": "2b1def93-3981-37b1-96e2-9668647c79ca",
                        "source_sense_description": "met dit, met deze",
                        "target_lang_word": "hiermit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiermit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24b81a28-0b1a-3636-8089-51f3a3cd2c8a",
                                        "entry_id": "bbee1e4a-75b2-3115-b11e-5aafacf7c3a1",
                                        "glosses": [
                                            "auf diese Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10d60927-89cb-40d0-b419-facdc7b0a84f",
                                                "sense_id": "24b81a28-0b1a-3636-8089-51f3a3cd2c8a",
                                                "text": "Jeder Mensch aber hat nicht allein ein Recht, sondern sogar die strengste Pflicht zur Wahrhaftigkeit in Aussagen, die er nicht umgehen kann: sie mag nun ihm selbst oder anderen Schaden. Er selbst tut also hiermit dem, der dadurch leidet, eigentlich nicht Schaden, sondern diesen verursacht der Zufall."
                                            },
                                            {
                                                "example_id": "925b1244-4860-43df-b4c9-6d4162a11b52",
                                                "sense_id": "24b81a28-0b1a-3636-8089-51f3a3cd2c8a",
                                                "text": "Mein Großvater […] hat vorwiegend die Arbeit gemacht mit der Kindererziehung und hiermit gezeigt, dass auch Männer Menschen sein können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f464af06-add2-35f7-9419-dc5887a59555",
                                        "entry_id": "bbee1e4a-75b2-3115-b11e-5aafacf7c3a1",
                                        "glosses": [
                                            "in diesem Moment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08e071c-4249-405d-ba0e-34355441eedb",
                                                "sense_id": "f464af06-add2-35f7-9419-dc5887a59555",
                                                "text": "[Worte des Standesbeamten bei einer Hochzeit:] „Und hiermit erkläre ich sie zu Mann und Frau.“"
                                            },
                                            {
                                                "example_id": "99ad34fe-b0d7-4878-b93e-a58d79756aa0",
                                                "sense_id": "f464af06-add2-35f7-9419-dc5887a59555",
                                                "text": "Wir ordnen und befehlen hiermit allen Ernstes, dass die Advocati wollene schwarze Mäntel, welche bis unter das Knie gehen, unserer Verordnung gemäß zu tragen haben, damit man die Spitzbuben schon von weitem erkennt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16cc0fca-52f7-35fa-b205-720086fb2d48",
                                        "entry_id": "bbee1e4a-75b2-3115-b11e-5aafacf7c3a1",
                                        "glosses": [
                                            "mit dieser Angelegenheit, Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2164c2db-3859-4464-9bcc-856251772dcc",
                                                "sense_id": "16cc0fca-52f7-35fa-b205-720086fb2d48",
                                                "text": "Ich schreibe gerade einen Brief. Ich hoffe, hiermit bald fertig zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
