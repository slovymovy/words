                "senses": [
                    {
                        "sense_id": "8a9c62f7-1bd1-3fc2-afbb-9ff21c8aaf80",
                        "entry_id": "78ef6cd7-54be-3e4c-bc10-d7e36816340e",
                        "glosses": [
                            "Fait d’appartenir à une province."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9441de-65e2-42d6-b8ae-8251582cbd6e",
                                "sense_id": "8a9c62f7-1bd1-3fc2-afbb-9ff21c8aaf80",
                                "text": "Cette provincialité intervenant pendant une période de regroupement des continents peut paraître paradoxale ; elle traduit la diversification des conditions climatiques et altimétriques (chaînes de montagne). — (Serge Elmi, Claude Babin, Histoire de la Terre, éditeur Dunod, 2012)"
                            },
                            {
                                "example_id": "8e734859-a470-422e-b6b5-079f1d0a216c",
                                "sense_id": "8a9c62f7-1bd1-3fc2-afbb-9ff21c8aaf80",
                                "text": "C’est par l’accent qu’on peut remonter à l’origine primitive du langage, à la provincialité du causeur ou de l’orateur."
                            },
                            {
                                "example_id": "2757658a-b239-4a41-9fac-e054a1a358a1",
                                "sense_id": "8a9c62f7-1bd1-3fc2-afbb-9ff21c8aaf80",
                                "text": "C’est un bon exemple du résultat d’une mobilité spécifique menant de la provincialité à la parisianité."
                            }
                        ]
                    },
                    {
                        "sense_id": "222f2778-ac01-384f-b0b7-582fcbf99caa",
                        "entry_id": "78ef6cd7-54be-3e4c-bc10-d7e36816340e",
                        "glosses": [
                            "Fait d’avoir l’air d’un provincial."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "081ee1d3-23dc-49cd-973c-502d816ba16b",
                                "sense_id": "222f2778-ac01-384f-b0b7-582fcbf99caa",
                                "text": "Elle s’amuse extrêmement de la surprise que me fait éprouver une foule d’objets auxquels elle est habituée ; et elle ne veut pas perdre une des occasions de s’amuser de ma provincialité."
                            },
                            {
                                "example_id": "5cba9e2f-8ad7-4844-ab40-54ffbdc81fff",
                                "sense_id": "222f2778-ac01-384f-b0b7-582fcbf99caa",
                                "text": "Dans La Comédie humaine, la provincialité ne constitue plus une tare, mais une sorte de privilège, du seul fait de la mise en roman."
                            },
                            {
                                "example_id": "b27d8d40-9e4c-4cbb-bd4b-99e8c84046f0",
                                "sense_id": "222f2778-ac01-384f-b0b7-582fcbf99caa",
                                "text": "La voiture commettant l'erreur de s'arrêter à un passage piéton sera à juste titre klaxonnée et son conducteur immédiatement suspecté de provincialité ou de sénilité."
                            }
                        ]
                    }
                ],
