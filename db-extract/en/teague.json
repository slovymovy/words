                "senses": [
                    {
                        "sense_id": "322380ea-2b97-3083-81ab-7f484841df8a",
                        "entry_id": "44211cd2-14ac-37dc-b327-d0de3e8987ce",
                        "glosses": [
                            "An Irishman."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "bba5c131-3fbb-441d-a212-553de9bb6509",
                                "sense_id": "322380ea-2b97-3083-81ab-7f484841df8a",
                                "text": "Let not poor Teg and Shone / Vender from der houses, / Lest dey be quite undone / In der very Trouses"
                            },
                            {
                                "example_id": "4f77b072-086a-4f0c-a20f-c8c652f80264",
                                "sense_id": "322380ea-2b97-3083-81ab-7f484841df8a",
                                "text": "With Shinkin-ap-Morgan, with Blue-cap, or Teague, / We into no Covenant enter, nor League."
                            },
                            {
                                "example_id": "c210c0d1-e2ae-43fa-8835-b447d76c83e1",
                                "sense_id": "322380ea-2b97-3083-81ab-7f484841df8a",
                                "text": "He is not so nice as his Superiors, whom nothing will go down with, under right Nantz or Rum; he shall gulp ye down the rankest Stinkibus with as good a Gusto, as a Teague does Usquenaugh, and not be a Doit the worse for it."
                            },
                            {
                                "example_id": "46590fca-a7c0-4c46-b80a-09f8ed4ecbe9",
                                "sense_id": "322380ea-2b97-3083-81ab-7f484841df8a",
                                "text": "Sempronious, in the second act, comes back once more in the same morning to the governor's hall, to carry on the conspiracy with Syphax against the governor, his country, and his family; which is so stupid, that it is below the wisdom of the O—'s, the Mac's, and the Teague's; even Eustace Cummins himself would never have gone to Justice-hall to have conspired against the government."
                            }
                        ]
                    }
