                "senses": [
                    {
                        "sense_id": "bff7f9d0-a3c8-3a5d-8fff-7e416afff7a2",
                        "entry_id": "1788f00e-20f1-3342-bc8c-c8ad21500d1c",
                        "glosses": [
                            "Sirup zur Behandlung von Husten, gegen Husten eingesetzter Sirup"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7df95b-c7bf-45b7-b422-35d06a07e425",
                                "sense_id": "bff7f9d0-a3c8-3a5d-8fff-7e416afff7a2",
                                "text": "„Das Trankopfer ihres Hustensirups hat purpurrot um ihren Mund herum abgefärbt und erinnert stark an postmortal ausgetretene Körperflüssigkeiten, an den Schaum aus Blut und Magensäure, den Leichen in den Stunden nach ihrem Tod erbrechen.“"
                            },
                            {
                                "example_id": "9cae45a8-af24-4830-b4cc-3e2b5d1b44ef",
                                "sense_id": "bff7f9d0-a3c8-3a5d-8fff-7e416afff7a2",
                                "text": "„Zurück im gleißenden Sonnenschein, entdeckte er an der Ladenfassade, in einem Reklameschild für Hustensirup, ein Thermometer.“"
                            },
                            {
                                "example_id": "ccb73216-7338-47de-9511-761742c22312",
                                "sense_id": "bff7f9d0-a3c8-3a5d-8fff-7e416afff7a2",
                                "text": "„Der alte Mann saß auf der Veranda und trank aus einer Flasche Hustensirup.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
