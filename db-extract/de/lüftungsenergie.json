                ],
                "senses": [
                    {
                        "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                        "entry_id": "f36b7574-2c29-36b6-a8e2-8f237983ccfc",
                        "glosses": [
                            "Maß für den Energiebedarf der Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6379395-ef09-4865-ad5d-620ea806ae41",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "Die einzelnen Lüftungsenergien einer Lüftungsanlage sind zum Beispiel: der Energieverbrauch der Ventilatoren (Strom), die Heiz- oder Kühlleistung (Gas + Energie) usw. abzüglich der eingesparten Lüftungsenergie die über einen Wärmetauscher zurückgewonnen wird."
                            },
                            {
                                "example_id": "70c14dd4-d049-45a3-b83d-28b0706f38e9",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "„Moderne Lüftungsanlagen für Ein- und Mehrfamilienwohnhäuser können nicht nur Straßenstaub und Pollen herausfiltern, sie sparen auch 90% der Lüftungsenergie.“"
                            },
                            {
                                "example_id": "e78b1917-1fc5-42c7-a25a-c718eb7690ec",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "„Die Gebäudehülle besteht aus den Komponenten Außenwände, Fenster, Dach, Dachboden, Kellerdecke und dem Lüftungsanteil, der durch ungewollte Öffnungen (Ritzen in den Fenstern und Spalten in der Dachkonstruktion) Lüftungsenergie nach außen transportiert.“"
                            },
                            {
                                "example_id": "08939fa0-a71a-40fe-9b9d-b30ef2186268",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "„Die Wärme der verbrauchten Abluft wird auf die kalte Zuluft mittels Wärmetauscher übertragen, dabei wird 90% der Lüftungsenergie eingespart.“"
                            },
                            {
                                "example_id": "87675c7f-c7fe-4a81-9731-4a3d661f11a2",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "„Diese werden sicherlich durch die höheren Investitionskosten und die höheren Kosten für Lüftungsenergie, Wasser und Instandhaltung etwas gemindert, eine Amortisation im Bereich von 4-5 Jahren scheint aber machbar.“"
                            },
                            {
                                "example_id": "c1c6acf1-6907-49ff-b7b8-a8263f39e6f8",
                                "sense_id": "78050573-5ad7-3a23-8993-f426044d8d6c",
                                "text": "„Aus betriebswirtschaftlicher Sicht spart die offene Kuppel außerdem viel Lüftungsenergie, da die Lüftung beim Öffnen der Kuppel automatisch abgeschaltet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
