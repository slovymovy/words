                                        "sense_id": "a93e8a8a-7e4d-3ee3-9ee1-1ebd3e9995ec",
                                        "entry_id": "d13ab78f-f496-3c87-8aa9-86d2e14bde68",
                                        "glosses": [
                                            "Being a double point with two distinct tangent planes in 4-dimensional projective space."
