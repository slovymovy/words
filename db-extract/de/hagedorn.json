                ],
                "senses": [
                    {
                        "sense_id": "deea0028-ffe4-30a5-a58b-f966644f2dc1",
                        "entry_id": "04cb0ac6-3f5b-302a-9bfd-8352194082a0",
                        "glosses": [
                            "Trivialname des Weißdorns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5aa61a-5694-4471-9cd2-56e4320afa65",
                                "sense_id": "deea0028-ffe4-30a5-a58b-f966644f2dc1",
                                "text": "Der Hagedorn ist eine wertvolle Bienenweide."
                            },
                            {
                                "example_id": "847637a9-ba1b-4bb8-83a9-e3243fed4d72",
                                "sense_id": "deea0028-ffe4-30a5-a58b-f966644f2dc1",
                                "text": "„Selbst mehr als 150 Jahre, nachdem die Bewohner von europäischen Kolonisten zwangsumgesiedelt wurden, lassen sich diese »Waldgärten«, so der Terminus der Forschenden, am Reichtum von Haselnüssen, Moosbeeren, Hagedorn und Holzäpfeln erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6be7fc83-d658-3e03-8ad1-eeace7b4b5db",
                        "entry_id": "04cb0ac6-3f5b-302a-9bfd-8352194082a0",
                        "glosses": [
                            "dorniger, heckenbildender Strauch"
                        ],
                        "tags": [
                            "im weiteren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "8427d766-5ee8-45f4-983a-91be5b1f38f4",
                                "sense_id": "6be7fc83-d658-3e03-8ad1-eeace7b4b5db",
                                "text": "„Selbst mehr als 150 Jahre, nachdem die Bewohner von europäischen Kolonisten zwangsumgesiedelt wurden, lassen sich diese »Waldgärten«, so der Terminus der Forschenden, am Reichtum von Haselnüssen, Moosbeeren, Hagedorn und Holzäpfeln erkennen.“"
                            },
                            {
                                "example_id": "5af95d2a-1b18-4f3b-9645-06ec5508ac02",
                                "sense_id": "6be7fc83-d658-3e03-8ad1-eeace7b4b5db",
                                "text": "Der von Hagedorn gesäumte Weg führt direkt an den Strand."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
