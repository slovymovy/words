                "senses": [
                    {
                        "sense_id": "b4c8a44a-1b5b-3d85-b412-a87f6e59f5b6",
                        "entry_id": "11dfbaa4-3610-3df7-a2d8-bd15ff0875f1",
                        "glosses": [
                            "äußere bauliche Fassung aus Kunststoff die das Glas trägt und so ein Fenster bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2766c75e-f956-4531-8449-5f70bf64c8da",
                                "sense_id": "b4c8a44a-1b5b-3d85-b412-a87f6e59f5b6",
                                "text": "„Auf jeden Fall werden zur Reinigung von Kunststofffensterrahmen Wasser, ein Tuch und ein entsprechendes Reinigungsmittel benötigt.“"
                            },
                            {
                                "example_id": "ca7f2ba0-7236-4b57-8548-8d7b08e1ae5b",
                                "sense_id": "b4c8a44a-1b5b-3d85-b412-a87f6e59f5b6",
                                "text": "„Kunststofffensterrahmen gelten als Renovierungsabfall und können beim Entsorgungszentrum Dußlingen angeliefert werden.“"
                            },
                            {
                                "example_id": "ad489ca4-926f-4eaf-8802-60dc857483cf",
                                "sense_id": "b4c8a44a-1b5b-3d85-b412-a87f6e59f5b6",
                                "text": "„Stadtverwaltung Wuppertal: Einbau von Kunststofffensterrahmen bei Bauvorhaben der Stadt Wuppertal“"
                            },
                            {
                                "example_id": "7b7ae888-605b-4ea0-93aa-528326efe8e7",
                                "sense_id": "b4c8a44a-1b5b-3d85-b412-a87f6e59f5b6",
                                "text": "„Kunststofffensterrahmen werden nur bei den Deponien mit Wertstoffhof Achern-Maiwald, \"Vulkan\" in Haslach im Kinzigtal, Kehl-Kork, Offenburg-Rammersweier, Oberkirch-Meisenbühl, \"Kahlenberg\" in Ringsheim und Schutterwald-Höfen gegen Gebühr als Siedlungsabfall angenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
