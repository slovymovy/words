                "senses": [
                    {
                        "sense_id": "d9274695-fcb0-3cca-affa-5c6974ae1627",
                        "entry_id": "4837b47f-4877-3ac3-b637-4b351dc6c58d",
                        "glosses": [
                            "намачивая, делать более мягким; вызывать разбухание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b5af1a-8fcd-452b-81a0-50e4d3e95f7f",
                                "sense_id": "d9274695-fcb0-3cca-affa-5c6974ae1627",
                                "text": "Прислонясь к стене, он стал размачивать хлеб под краном и один за другим жадно жевать мокрые, расползавшиеся в пальцах куски."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f747057-d8a9-4145-95e1-4441108a74eb",
                        "source_entry_id": "4837b47f-4877-3ac3-b637-4b351dc6c58d",
                        "source_sense_id": "d9274695-fcb0-3cca-affa-5c6974ae1627",
                        "target_lang_word": "macerate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acce8601-dd5f-3de0-b3c6-0cea27e912b1",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "To soften (something) or separate it into pieces by soaking it in a heated or unheated liquid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1d58c3b-9633-3c1b-853f-bbf2871f01b0",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "To reduce solids to small pieces (in a macerator)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be8edd29-7f89-3538-83da-5b16a49f6047",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "To make lean; to cause to waste away."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "611aa055-bc7b-436b-868e-d716bf6f6150",
                                                "sense_id": "be8edd29-7f89-3538-83da-5b16a49f6047",
                                                "text": "Baal scuttles with ten tails\nBetween as many legs as he could carry—\nPerhaps Thomas poking through the holes\nAnd finding resolution beyond the scales\nAnd incorporeal pain of the hammered Messiah,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "183e7833-044c-3b10-ba00-d0937db0e51f",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "To subdue the appetite by poor or scanty diet; to mortify."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ba7009e-7ea2-3fac-b109-baee0464b885",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "To mortify the flesh in general."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40318a1f-92b6-4665-a960-f7bb9de4d51c",
                                                "sense_id": "6ba7009e-7ea2-3fac-b109-baee0464b885",
                                                "text": "“My dear child, how are you employed?” I knew the voice of the Superior, and I replied, “My father, I was sleeping.” “And I was macerating myself at the foot of the altar for you, my child,—the scourge is red with my blood.” I returned no answer, for I felt the maceration was better merited by the betrayer than the betrayed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ed93c5-9f73-38cf-adfe-9ef6093603c2",
                                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                                        "glosses": [
                                            "past participle of macerate"
