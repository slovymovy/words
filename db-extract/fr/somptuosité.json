            {
                "entry_id": "dbecab5e-2699-3e3f-a843-e39955a2d9aa",
                "word": "somptuosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "468b435a-f708-4db8-8dac-3ff05ad511ac",
                        "entry_id": "dbecab5e-2699-3e3f-a843-e39955a2d9aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "somptuosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                        "entry_id": "dbecab5e-2699-3e3f-a843-e39955a2d9aa",
                        "glosses": [
                            "Grande richesse, éclat, magnificence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404244f9-258d-47e4-8f55-397da1ed5cb3",
                                "sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                                "text": "Après le déjeuner, sa cousine et son cousin, heureux de l’étonnement de Pierrette et pressés d’en jouir, lui montrèrent leur beau salon pour lui apprendre à en respecter les somptuosités."
                            },
                            {
                                "example_id": "d61c2f83-e11b-42f0-96d1-9ad806dfe62f",
                                "sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                                "text": "Le propriétaire de la villa dont elle dépendait, […], eut la fantaisie de mettre cette maisonnette en harmonie avec les somptuosités de sa demeure, et la fit reconstruire sur le modèle d’un cottage."
                            },
                            {
                                "example_id": "d4698160-8184-44bb-8001-c6ed2a63d8bd",
                                "sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                                "text": "Quant aux brides, aux mors, aux têtières, aux frontails, nos langues du Nord sont trop froides, trop pauvres, trop mesquines, pour en décrire les somptuosités."
                            },
                            {
                                "example_id": "aa3b9913-0b57-492c-8d51-1c7926ce0871",
                                "sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                                "text": "La gamme de couleurs où elle est baignée est d'une somptuosité que l'on ne peut décrire. Depuis le rouge et l'or jusqu'au violet céleste, toutes les teintes frappent ses murailles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebf6b93e-21d4-4719-ba69-c46ce7174977",
                        "source_entry_id": "dbecab5e-2699-3e3f-a843-e39955a2d9aa",
                        "source_sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                        "target_lang_word": "sumptuosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sumptuosity",
