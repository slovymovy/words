                                            {
                                                "example_id": "828e4386-a98e-4a73-9ee8-d1604d991f04",
                                                "sense_id": "e988990a-4f3c-31f5-a7a2-9c99085cba5c",
                                                "text": "Nedůvěra veřejnosti v politiku je spojená s malým zájmem o veřejné dění."
                                            },
                                            {
                                                "example_id": "0a349d5b-04a7-40ce-a9cb-122f4c74cbea",
                                                "sense_id": "e988990a-4f3c-31f5-a7a2-9c99085cba5c",
                                                "text": "Jsme celé roky masírováni jednou negací spojenou s EU za druhou. Jako by z Bruselu nepřišlo nikdy nic dobrého, řeči o zakřivených banánech, zákaz mít v hospodě „náš tři dny starý guláš“, úsporné žárovky, ale hlavně uprchlíci nikoli jako pronásledovaní, ale jako hrozba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290bee40-9d47-3629-b323-9a3dcd0713b2",
                                        "entry_id": "296c3509-d6f1-3791-96e6-f980e1af3b3b",
                                        "glosses": [
                                            "opatřený objektem, který nedovoluje vzájemné oddálení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6bfe32d-4110-4eb1-8ff2-47d3e82d8d93",
                                                "sense_id": "290bee40-9d47-3629-b323-9a3dcd0713b2",
                                                "text": "Dokud je záchranný člun spojený lanem s lodí, můžete bezpečně nastupovat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6912186f-34d2-33a9-a64b-ac4405172ed8",
                                        "entry_id": "296c3509-d6f1-3791-96e6-f980e1af3b3b",
                                        "glosses": [
                                            "tvořený společně několika částmi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
