                "senses": [
                    {
                        "sense_id": "c8e19be7-5e6d-3a7a-9b93-bf081a93ddda",
                        "entry_id": "05c753cf-f3d7-3a6c-9f7f-334c3c662e93",
                        "glosses": [
                            "Pôle positif d’une pile électrique, ou négatif dans le cas d’une électrolyse ; pôle où se produit la réduction."
                        ],
                        "tags": [
                            "Électrochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "5ea8aedf-c556-44b1-97cf-c88c56609289",
                                "sense_id": "c8e19be7-5e6d-3a7a-9b93-bf081a93ddda",
                                "text": "L’anode et la cathode de cette pile peuvent donc se concevoir chacune comme une semi-réaction ou une demi-pile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2995913-4203-489d-a0d3-8c47a5b0e607",
                        "source_entry_id": "05c753cf-f3d7-3a6c-9f7f-334c3c662e93",
                        "source_sense_id": "c8e19be7-5e6d-3a7a-9b93-bf081a93ddda",
