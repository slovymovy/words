                "senses": [
                    {
                        "sense_id": "a32d622c-09ba-34d2-9374-8dd6c86482de",
                        "entry_id": "fc739394-4eed-3172-b9f9-8767804fee19",
                        "glosses": [
                            "Stelle, an der zwei im Winkel zueinander stehende Wände eines Hauses aufeinandertreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b510c5-6919-4da8-afe0-109dcf3aabb2",
                                "sense_id": "a32d622c-09ba-34d2-9374-8dd6c86482de",
                                "text": "„Und vom Sims sprang sie hinaus in den rechteckigen Hof, wo sie hinter einer Hausecke verschwand.“"
                            },
                            {
                                "example_id": "7259d009-e243-4efb-9633-2ebc749707ef",
                                "sense_id": "a32d622c-09ba-34d2-9374-8dd6c86482de",
                                "text": "„Ich ging auf den Hof und sah um die Hausecke.“"
                            },
                            {
                                "example_id": "9c0d0e70-1325-456d-bb72-fa4208a86164",
                                "sense_id": "a32d622c-09ba-34d2-9374-8dd6c86482de",
                                "text": "„Als die Beiden erschöpft und gestresst vom Wochenend-Einkauf um die Hausecke kommen, um zur Eingangstür zu gelangen, sehen sie Udo Deppe hinten in der Raucherecke, am Eingang zum Fahrradkeller, stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
