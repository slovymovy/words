                        ],
                        "form": "die Bratzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1aac6902-0538-3dab-9878-a3074b3f6d88",
                        "entry_id": "21eb511e-0a0a-3338-9185-f3bef184a58e",
                        "glosses": [
                            "Vorderpfote eines Tieres oder unförmige Hand eines Menschen"
                        ],
                        "tags": [
                            "veraltet oder noch landschaftlich"
                        ],
                        "examples": [
                            {
                                "example_id": "b0cef5dc-413a-4a98-be85-6a2ef4816610",
                                "sense_id": "1aac6902-0538-3dab-9878-a3074b3f6d88",
                                "text": "„O wie viel gibts Bären (hätt bald gesagt Bärenhäuter), die sich mit ihren Bratzen, aber verstohlenen, diebischen Bratzen erhalten!“"
                            },
                            {
                                "example_id": "5b7bc369-32d5-42a0-b2a8-5add8cdb1572",
                                "sense_id": "1aac6902-0538-3dab-9878-a3074b3f6d88",
                                "text": "„[…] was hilft es, ein Paar wohlriechende Römische Handschuh tragen, und darin krätzige Bratzen?“"
                            },
                            {
                                "example_id": "97bfc396-521e-49fc-a492-2fbefe173eda",
                                "sense_id": "1aac6902-0538-3dab-9878-a3074b3f6d88",
                                "text": "„Das wäre wohl ewig Schade, wenn ein so hübscher junger Herr einem solchen Meerkalb in den Bratzen liegen sollte!“"
                            },
                            {
                                "example_id": "5edd4dbe-8824-4b92-8e7f-d1427c5b9664",
                                "sense_id": "1aac6902-0538-3dab-9878-a3074b3f6d88",
                                "text": "„Da reichte der Löwe, als ob er diese Rede verstanden hätte, die verwundete Bratze dem Soldaten dar, und hielt den Kopf ein wenig krumm, gerade so, als ob er ihn bitten wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                        "entry_id": "21eb511e-0a0a-3338-9185-f3bef184a58e",
                        "glosses": [
                            "eine unattraktive Person, meist eine Frau"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "907bd3b1-459a-4b70-9e1e-33b875f47d22",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„jetzt mach dich mal locker, alte bratze, sag ich zu meinem inneren volkspolizisten.“"
                            },
                            {
                                "example_id": "2d3e28c5-53b6-4623-8859-579a32f75599",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„Cindy ist der Gegenentwurf zur grassierenden Superstar-Epidemie im Land. Das ,fleischgewordene Klischee einer Berliner Bratze‘ (Frankfurter Rundschau), deren Verlierer-Biografie geradezu nach Talkshow-Auftritten schreit.“"
                            },
                            {
                                "example_id": "17af40bb-ec86-470b-8bc1-b9367dd489aa",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„Hier darf sich die Frau noch über ihre Handtasche definieren. Hier ist die Bratze noch Bratze, hier darf sie es sein.“"
                            },
                            {
                                "example_id": "a7e56968-4214-49e9-9b24-b260b3ca7e83",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„Glaubt man die richtige Figur zusammen zu haben drückt man Feuer. Leider wird daraufhin die Bratze nicht umgenietet.“"
                            },
                            {
                                "example_id": "b5e765d0-040d-4b76-9a20-23c3e1b5b2b1",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„Einzig durch das zusätzliche Zimmer, in dem einst Kevin die Bratze genächtigt hatte, unterschied sie sich von meiner.“"
                            },
                            {
                                "example_id": "8b624972-45cf-4678-b6f4-47bc83c13cea",
                                "sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                                "text": "„Gebärt doch, ihr Bratzen!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a8ad3ef-5999-45c3-8594-d38789b03782",
                        "source_entry_id": "21eb511e-0a0a-3338-9185-f3bef184a58e",
                        "source_sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                        "source_sense_description": "umgangssprachlich, abwertend, Schimpfwort: eine unattraktive Person, meist eine Frau",
                        "target_lang_word": "laideron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laideron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                        "entry_id": "1935de49-5aa8-3402-a035-4d8b3d9e3fa7",
                                        "glosses": [
                                            "Jeune fille ou jeune femme laide."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3768e8ce-f14e-4e7b-a8aa-744f1246321e",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Cela m’amusait, j’en tombe d’accord, de voir que, pour danser avec une laideron comme moi, tu laissais de côté une belle fille […]"
                                            },
                                            {
                                                "example_id": "d0c23f41-ce3a-42c7-b366-9f031528669a",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Née avec une sorte de mauvaise chance, se jugeant mal partagée par la fortune, elle consentait le plus souvent à n’être qu’un laideron."
                                            },
                                            {
                                                "example_id": "c71da539-da7c-4745-aef7-3d570d5bb975",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Pouah ! mes salives desséchées,\nRoux laideron\nInfectent encor les tranchées\nDe ton sein rond !"
                                            },
                                            {
                                                "example_id": "b93c9821-81bc-44e8-a77f-3f3ce8998c71",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Onze ans d’assiduité m’ayant valu une médaille de vermeil, mon père accepta, sans enthousiasme, d’assister à la distribution des récompenses ; il se plaignit, le soir, de n’y avoir vu que des laiderons."
                                            },
                                            {
                                                "example_id": "b5acedb2-8d64-450e-b76a-d6858002b9e5",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Il avait pris un laideron pour secrétaire et un laideron pour femme. N'était-ce pas ce qu'il voulait ? Il en avait soupé de la beauté, non ?"
                                            },
                                            {
                                                "example_id": "8772833a-9e20-4367-b014-c8c6fcea16cb",
                                                "sense_id": "c302128b-ea53-3efa-b122-840d0cc5d40c",
                                                "text": "Ma mère aimait à raconter comment le jour de la naissance d’Odette, la vieille tante Céline s’était penchée au-dessus de son berceau et s’était écriée : « Malheur ! C’est un laideron ! » Maman avait fondu en larmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6bd931a-d002-4b0e-8483-15df82d9dd4a",
                        "source_entry_id": "21eb511e-0a0a-3338-9185-f3bef184a58e",
                        "source_sense_id": "cd2e84fd-cc78-3e6c-86ae-9d06d97386e0",
                        "source_sense_description": "umgangssprachlich, abwertend, Schimpfwort: eine unattraktive Person, meist eine Frau",
                        "target_lang_word": "cageot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cageot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa6d77c-35a1-3cb2-8d10-a7da1eaf250f",
                                        "entry_id": "1cae6d81-3b29-3a8a-a6cf-561eb43d94a9",
                                        "glosses": [
                                            "Caisse en bois déroulé permettant le transport de fruits et légumes principalement."
                                        ],
                                        "tags": [
                                            "Usuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3259e5bb-024d-4ea7-9267-de357baa6430",
                                                "sense_id": "bfa6d77c-35a1-3cb2-8d10-a7da1eaf250f",
                                                "text": "Un cageot de légumes."
                                            },
                                            {
                                                "example_id": "f5bc7f9a-31c3-430c-89a4-ad3c51325261",
                                                "sense_id": "bfa6d77c-35a1-3cb2-8d10-a7da1eaf250f",
                                                "text": "Il alla jusqu’au bout de la rue. Des camions arrivaient au trot, encombrant le marché de la Vallée de cageots pleins de volailles vivantes."
                                            },
                                            {
                                                "example_id": "d3d1d696-790e-4236-91a9-6dad7ef369a8",
                                                "sense_id": "bfa6d77c-35a1-3cb2-8d10-a7da1eaf250f",
                                                "text": "Toi, la vieille, tu suis derrière avec ton cageot."
                                            },
                                            {
                                                "example_id": "e3d9b82a-19e3-4d91-b7cb-9c9b600ec21b",
                                                "sense_id": "bfa6d77c-35a1-3cb2-8d10-a7da1eaf250f",
                                                "text": "Il acheva de rassembler les oignons qu’il mit dans trois grands cageots et monta au grenier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b49ed0b-d11e-32a3-b313-c0eb92584bc4",
                                        "entry_id": "1cae6d81-3b29-3a8a-a6cf-561eb43d94a9",
                                        "glosses": [
                                            "Laideron."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc01aa2-95bc-469f-9423-dbe948b9abfc",
                                                "sense_id": "1b49ed0b-d11e-32a3-b313-c0eb92584bc4",
                                                "text": "Il était avec un cageot je ne te raconte pas. Une nana immonde. Même coincé sur une île déserte avec un thon pareil, je préférerais me taper une chèvre!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
