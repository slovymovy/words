                    {
                        "sense_id": "775326dc-806c-3958-a831-ab26d4a0700d",
                        "entry_id": "ade9213a-035f-3561-91aa-3b16ed74894a",
                        "glosses": [
                            "Vertreter einer Gattung fleischfressender Dinosaurier aus der frühenen Kreidezeit"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e91981c-6654-4528-a1b7-b129aa352778",
                                "sense_id": "775326dc-806c-3958-a831-ab26d4a0700d",
                                "text": "„Die Fossilien des Baryonyx wurden 1983 vom britischen Amateur-Fossiliensammler William Walker in einer Tongrube bei Surrey in England gefunden.“"
                            },
                            {
                                "example_id": "1b64cc75-17a7-42e9-8113-605945ea117b",
                                "sense_id": "775326dc-806c-3958-a831-ab26d4a0700d",
                                "text": "„In der kurzen Zeit, die Baryonyx unter uns weilt, wird aus dem Wesen der Theorie und Spekulation das meistfotografierte Lebewesen in der Geschichte der ganzen Welt werden.“"
                            }
                        ],
