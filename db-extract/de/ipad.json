                "senses": [
                    {
                        "sense_id": "3afa9904-ae48-3206-8d1a-a3ed5f6539dd",
                        "entry_id": "23b12714-88c9-3c80-a6a9-2adb2f4a9f20",
                        "glosses": [
                            "bestimmtes Tablet der Firma Apple"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f553a0e-37e0-4be3-8044-e7bcf059544e",
                                "sense_id": "3afa9904-ae48-3206-8d1a-a3ed5f6539dd",
                                "text": "„American Airlines hatte im Juni 2013 das Flugpersonal mit mehr als 8000 iPads ausgestattet.“"
                            },
                            {
                                "example_id": "a52b42d8-9a5d-48ea-98a4-b14d47281068",
                                "sense_id": "3afa9904-ae48-3206-8d1a-a3ed5f6539dd",
                                "text": "„Therese kam mit dem iPad in die Küche, sie hatte große Kopfhörer auf, öffnete die Kühlschranktür und nahm einen Rest Sahnetorte heraus, lud ihn auf einen Teller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "965e8da6-c799-417f-84e1-6bad60d7436b",
                        "source_entry_id": "23b12714-88c9-3c80-a6a9-2adb2f4a9f20",
                        "source_sense_id": "3afa9904-ae48-3206-8d1a-a3ed5f6539dd",
                        "source_sense_description": "bestimmtes Tablet der Firma Apple",
                        "target_lang_word": "iPad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iPad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc2d661-151e-35d0-8d0f-8f16f554abb4",
                                        "entry_id": "9cfa15d3-bbaf-3b13-a39b-7c312ad7c3d1",
                                        "glosses": [
                                            "A lightweight low-power tablet computer of a particular range from Apple Inc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad843c0-e322-406c-b4b4-ad3e29051b6a",
                                                "sense_id": "2cc2d661-151e-35d0-8d0f-8f16f554abb4",
                                                "text": "He was watching a movie on his iPad."
                                            },
                                            {
                                                "example_id": "57cc3ccc-5920-485c-aa0c-ef4fd3026828",
                                                "sense_id": "2cc2d661-151e-35d0-8d0f-8f16f554abb4",
                                                "text": "The ordeal is a world away from Kira now as she plays games on her new iPad while absently talking about downloading more apps to play music, and voicing her excitement over reuniting soon with her grandfather’s girlfriend."
                                            },
                                            {
                                                "example_id": "f0b57b56-135d-4de3-bdb0-bdece79790ba",
                                                "sense_id": "2cc2d661-151e-35d0-8d0f-8f16f554abb4",
                                                "text": "“This is before everyone had [geographic information system] mapping, before iPads, iPhones, laptops, Google,” he says. “This is doing research way back with a hammer and a chisel.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077c22f5-6694-3f7c-b5ab-40e458a04b73",
                                        "entry_id": "9cfa15d3-bbaf-3b13-a39b-7c312ad7c3d1",
                                        "glosses": [
                                            "Any lightweight low-power tablet computer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42eabc82-bc5d-431e-9391-f888d53a4ed1",
                                                "sense_id": "077c22f5-6694-3f7c-b5ab-40e458a04b73",
                                                "text": "I [googled] his name on my Samsung android iPad notebook and familiarised myself with his bibliography before our appointment. Senator Nathan Obadiah Bracken was born in New Jersey but lived in Boston for the first twelve years of his life."
                                            },
                                            {
                                                "example_id": "6bab9439-03e1-4c68-a743-af95d9fcedc5",
                                                "sense_id": "077c22f5-6694-3f7c-b5ab-40e458a04b73",
                                                "text": "She opened her bag and took out her Samsung iPad."
                                            },
                                            {
                                                "example_id": "33d1dde4-ec5a-4964-96d7-9640363e304d",
                                                "sense_id": "077c22f5-6694-3f7c-b5ab-40e458a04b73",
                                                "text": "He told me to head back to the colonel. With the iPad thing I had, they were tracking me every step of the way. From that they could get the exact coordinates of the enemy to help us when we attack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
