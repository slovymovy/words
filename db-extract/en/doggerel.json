                    {
                        "sense_id": "756937c7-1265-3916-b84c-b438ad296685",
                        "entry_id": "d93470f9-2711-3391-bfcf-84eec33fba7f",
                        "glosses": [
                            "Décrivant des vers comiques ou burlesques, le plus souvent irréguliers et mal composés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82a4ee0-8795-4941-9288-cfb4e6144b14",
                                "sense_id": "756937c7-1265-3916-b84c-b438ad296685",
                                "text": "But such manner of poesy is called in our vulgar, rhyme doggerel, with which rebuke we will in no case our maker should be touched."
                            },
                            {
                                "example_id": "850a550a-e924-4b6d-8b8a-d609a76ffc8f",
                                "sense_id": "756937c7-1265-3916-b84c-b438ad296685",
                                "text": "Still — his doggerel verses are not literature."
                            }
                        ]
                    },
                    {
                        "sense_id": "dabf0eab-246c-380e-871c-7302dc6ee10e",
                        "entry_id": "d93470f9-2711-3391-bfcf-84eec33fba7f",
                        "glosses": [
                            "Comique, burlesque."
                        ],
                        "tags": [
