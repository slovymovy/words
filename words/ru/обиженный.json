                {
                    "sense_id": "11fc1966-f996-3e0c-91cf-9dae5cc965e7",
                    "sense_definition": "Испытывающий чувство обиды, огорчения или несправедливости (о человеке).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feeling_offended",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сидел в углу, <w>обиженный</w> на весь мир после вчерашней ссоры.",
                            "target_lang_translations": {
                                "en": "He sat in the corner, <w>offended</w> at the whole world after yesterday's quarrel."
                            }
                        },
                        {
                            "text": "Она выглядела очень <w>обиженной</w> и не хотела ни с кем разговаривать.",
                            "target_lang_translations": {
                                "en": "She looked very <w>hurt</w> and did not want to talk to anyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "оскорблённый",
                        "разобиженный",
                        "расстроенный",
                        "задетый"
                    ],
                    "common_phrases": [
                        "обиженный ребенок",
                        "обиженный на друга"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling hurt, resentful, or treated unfairly (of a person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offended",
                                "target_lang_sense_clarification": "feeling hurt or insulted by someone's words or actions"
                            },
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "feeling emotional pain or distress"
                            },
                            {
                                "target_lang_word": "resentful",
                                "target_lang_sense_clarification": "feeling bitter or angry at having been treated unfairly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a00d646d-fbe8-3263-b6fa-7b5da62aba75",
                    "sense_definition": "Выражающий обиду, огорчение или недовольство (о взгляде, тоне, лице и т. д.).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expressing_offense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик посмотрел на отца <w>обиженным</w> взглядом и молча ушёл в свою комнату.",
                            "target_lang_translations": {
                                "en": "The boy looked at his father with a <w>hurt</w> look and silently went to his room."
                            }
                        },
                        {
                            "text": "Она ответила мне очень <w>обиженным</w> тоном, хотя я не хотел её задеть.",
                            "target_lang_translations": {
                                "en": "She answered me in a very <w>offended</w> tone, although I did not mean to hurt her."
                            }
                        }
                    ],
                    "synonyms": [
                        "надутый"
                    ],
                    "common_phrases": [
                        "обиженный взгляд",
                        "обиженный тон",
                        "обиженный вид"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing hurt, resentment, or displeasure (of a look, tone, face, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurt",
                                "target_lang_sense_clarification": "showing emotional pain or sadness in expression"
                            },
                            {
                                "target_lang_word": "offended",
                                "target_lang_sense_clarification": "expressing that one has been insulted or displeased"
                            },
                            {
                                "target_lang_word": "injured",
                                "target_lang_sense_clarification": "showing a wounded or pained expression or tone"
                            }
                        ]
                    }
                }
            ]
        },
        {
