                    },
                    {
                        "sense_id": "b23de9dc-cfe0-3a06-9857-814160510398",
                        "entry_id": "47c15481-13fa-32a8-961e-03e71546e030",
                        "glosses": [
                            "A diminutive of the male given name Stanley."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0ab33706-d932-4c94-a692-01b1ef3638d3",
                                "sense_id": "b23de9dc-cfe0-3a06-9857-814160510398",
                                "text": "Stan Jessop taught at a different school now but lived in the same small 1930s semi-detached as he had done ten years ago. Stan made him sound like an old allotment guy but he was only thirty-six."
                            },
                            {
                                "example_id": "14f4d0e1-0cb2-44b7-b6e1-1fba6fff03cf",
                                "sense_id": "b23de9dc-cfe0-3a06-9857-814160510398",
                                "text": "Finally, there’s a Stan Lee fly, in honor of the late Marvel Comics visionary."
                            }
                        ]
                    },
                    {
                        "sense_id": "b527fd73-fe4b-30c8-9ef2-98758b2360cb",
                        "entry_id": "47c15481-13fa-32a8-961e-03e71546e030",
