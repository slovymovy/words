                        "cross_references": [
                            {
                                "target_word": "rapide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0d69a02-7b5a-30ca-8a34-3ddf644d7a7d",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
                                            "Qui se meut avec vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0afddb5-f1d0-4775-b2ae-1e1b7610d495",
                                                "sense_id": "f0d69a02-7b5a-30ca-8a34-3ddf644d7a7d",
                                                "text": "Maintenant de longues distances nous séparent et le fleuve rapide m’accompagne."
                                            },
                                            {
                                                "example_id": "e1bfe48f-9b58-4fef-9841-838b1cca540b",
                                                "sense_id": "f0d69a02-7b5a-30ca-8a34-3ddf644d7a7d",
                                                "text": "Une marche rapide. — Le cours rapide d’un fleuve. — Le vol rapide des aigles. — Un mouvement très rapide. — Train rapide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aed8de2-ad70-3958-ac5e-bbfadbf52aac",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
                                            "Qui se fait avec vitesse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7289455-61d1-4c3a-b446-ee25dda114cc",
                                                "sense_id": "5aed8de2-ad70-3958-ac5e-bbfadbf52aac",
                                                "text": "Il est commode de se servir d'une pipette jaugeuse pour le mesurage rapide des 90 cm³ d'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f311946b-2021-37dd-bc71-65e3b22ea931",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
                                            "Très incliné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ebb298-f909-48bb-8800-a81d0863d9ef",
                                                "sense_id": "f311946b-2021-37dd-bc71-65e3b22ea931",
                                                "text": "Une pente rapide."
                                            },
                                            {
                                                "example_id": "1895dd34-f4f9-4270-99bb-eb59123f218e",
                                                "sense_id": "f311946b-2021-37dd-bc71-65e3b22ea931",
                                                "text": "Une descente rapide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
                                            "Qui comprend, qui agit avec rapidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0395599d-e1f7-48b8-89b5-9310c8378aa9",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Une expédition rapide."
                                            },
                                            {
                                                "example_id": "1d607b75-cfd0-4cf9-9d12-1cdd780c147c",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Des conquêtes rapides."
                                            },
                                            {
                                                "example_id": "225128ec-6fcb-466c-ba5a-db187d2f7de6",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Cet enfant fait des progrès rapides."
                                            },
                                            {
                                                "example_id": "5fc247ae-2c66-4292-81f1-724dd750295b",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Ses succès ont été aussi rapides que brillants."
                                            },
                                            {
                                                "example_id": "7814b7c5-d7a9-45fc-bc99-e3a4cfd11ec9",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Un esprit rapide."
                                            },
                                            {
                                                "example_id": "0072f45c-128d-4f1f-8487-cb77323ac7c5",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "J’ai jeté un coup d’œil rapide sur cet ouvrage, sur cette affaire."
                                            },
                                            {
                                                "example_id": "cf6f8cd3-11a4-4a91-8b39-a9b0c86bdc35",
                                                "sense_id": "267c1322-04d4-347a-991b-5bdb46b90de6",
                                                "text": "Une lecture rapide a suffi pour me faire connaître la valeur de cet ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63dcde9f-3ea0-3daf-b622-8479567beec5",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
                                            "Animé, vif, entrainant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a456a90d-ecd3-4369-8356-4f9c07963a9a",
                                                "sense_id": "63dcde9f-3ea0-3daf-b622-8479567beec5",
                                                "text": "Un style rapide, un style où tous les mots portent et qui va droit au but."
                                            },
                                            {
                                                "example_id": "06c546ad-e39b-4b67-a158-0b123c83affc",
                                                "sense_id": "63dcde9f-3ea0-3daf-b622-8479567beec5",
                                                "text": "Une narration rapide, une narration où les faits se pressent."
                                            },
                                            {
                                                "example_id": "abc4c7b0-7dba-4c71-9bbc-86777dd10536",
                                                "sense_id": "63dcde9f-3ea0-3daf-b622-8479567beec5",
                                                "text": "Une éloquence rapide, une éloquence animée, vive, qui entraîne l’auditeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8510df22-7e7e-3d8e-803c-9dfd69497529",
                                        "entry_id": "652a587c-f47a-34ca-a756-84e7cbf68226",
                                        "glosses": [
