                                    {
                                        "sense_id": "95d9b6f7-ff11-30d9-9bc6-e9442653926f",
                                        "entry_id": "ce2fbcb2-b959-3e9f-a50d-9e2d79acaa43",
                                        "glosses": [
                                            "Inactive; undeveloped."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36ade6c-e3c0-40cf-a78b-fa450fcee9c2",
                                                "sense_id": "95d9b6f7-ff11-30d9-9bc6-e9442653926f",
                                                "text": "a fallow period in one's career"
                                            },
                                            {
                                                "example_id": "498f7f47-a7fe-47a1-997a-61537f2c7887",
                                                "sense_id": "95d9b6f7-ff11-30d9-9bc6-e9442653926f",
                                                "text": "After two more homeland hits and a fallow two years, Pickettywitch was parked and junked."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fallow",
