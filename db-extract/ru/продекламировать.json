                                                "sense_id": "2b0d446a-8ca2-33f5-988e-7cbda8525035",
                                                "text": "Er kann Goethes Faust stundenlang ohne Fehler deklamieren."
                                            },
                                            {
                                                "example_id": "5283c45b-51f9-431b-9333-e187e6bec671",
                                                "sense_id": "2b0d446a-8ca2-33f5-988e-7cbda8525035",
                                                "text": "Verzeiht! ich hör' euch deklamieren; Ihr last gewiß ein griechisch Trauerspiel?"
                                            },
                                            {
                                                "example_id": "c2f7c61f-44e0-43b6-9316-e9cfb2a3d96f",
                                                "sense_id": "2b0d446a-8ca2-33f5-988e-7cbda8525035",
                                                "text": "„Er war erster Chortenor am Stadttheater gewesen, sie las nicht nur viel, sie schrieb auch, sang und deklamierte öffentlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02ae4d60-0fe2-3752-8cf6-d48145d2609e",
                                        "entry_id": "3014a6a6-91f2-3b06-b1d0-a6579bd31788",
                                        "glosses": [
                                            "dramatisierend sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c47795d-aa70-4e98-90d4-da4001805aec",
                                                "sense_id": "02ae4d60-0fe2-3752-8cf6-d48145d2609e",
                                                "text": "Während der Demo deklamierten die Studenten ihre antifaschistischen Sprüche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
