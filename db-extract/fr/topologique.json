                        ],
                        "form": "topologiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                        "entry_id": "e1db1c07-5cbc-307d-93d5-58f71f25be69",
                        "glosses": [
                            "Relatif à la topologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be8182e-0dab-4c15-8847-7faedaa5e2ce",
                                "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                                "text": "A l'inverse, l'étendue de telle plaine divisée en une mosaïque de parcelles culturalement distinctes se verra différenciée par des contenus, eux aussi dotés d'attributs géométriques et de surface, mais sans que des discontinuités topologiques les séparent pourtant."
                            },
                            {
                                "example_id": "4b2c35fc-933a-4e57-ad68-96d3017b6509",
                                "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                                "text": "Il s’agissait de faire intervenir des cordes cosmiques, des sortes de défauts topologiques analogues à ceux que l’on trouve dans un réseau cristallin lorsqu’un liquide devient solide en se refroidissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4668860-5609-3040-98e0-7f092c9a991b",
                        "entry_id": "e1db1c07-5cbc-307d-93d5-58f71f25be69",
                        "glosses": [
                            "Qualifie une représentation moléculaire utilisée en chimie organique (Voir formule topologique)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9be002d-e5b3-4d04-8e2d-6c96260f41ca",
                        "source_entry_id": "e1db1c07-5cbc-307d-93d5-58f71f25be69",
                        "target_lang_word": "topologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5698137-2871-30b4-b8a6-1b96a2dc46cd",
                                        "entry_id": "eebbd975-7a03-327c-b7aa-28e4d7f023cd",
                                        "glosses": [
                                            "mit der Topologie in Zusammenhang stehend, sie betreffend"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0055cb26-bbaf-422e-800c-fbb3b2c263f9",
                                                "sense_id": "f5698137-2871-30b4-b8a6-1b96a2dc46cd",
                                                "text": "Topologische Themen wollen alles mathematisch Definieren und sind für die meisten Menschen die schwierigsten Themen der Mathematik."
                                            },
                                            {
                                                "example_id": "677f412e-5064-482b-98fb-ba77aae3ceeb",
                                                "sense_id": "f5698137-2871-30b4-b8a6-1b96a2dc46cd",
                                                "text": "„Tatsächlich aber verbindet der Sehnerv die Netzhaut mit der entsprechenden Region im visuellen Kortex. Dort sind die Nervenzellen tatsächlich topologisch so angeordnet wie die Projektion – wo \"unten\" und \"oben\" ist, das ist dabei ziemlich egal. Wir lernen vom ersten Tag an, welche Nervenzellen welcher Richtung im Raum entsprechen.“"
                                            },
                                            {
                                                "example_id": "95502ac8-6dd0-452d-aa80-aaeea515b149",
                                                "sense_id": "f5698137-2871-30b4-b8a6-1b96a2dc46cd",
                                                "text": "„Um die Servicequalität strategisch abzusichern und auszubauen, spannt UTA nun ein Umbrella Management System (UMS) über ihre Netze. Es erfasst physisch und topologisch Netzwerkelemente und Services aller Technologien (= Inventarmanagement).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8924eca0-c21e-4ad6-9fd3-b551749f3da5",
