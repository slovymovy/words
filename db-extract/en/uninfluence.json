                "senses": [
                    {
                        "sense_id": "926e48ef-d6a2-3f86-82cc-bb05091251da",
                        "entry_id": "071977b5-b2ba-3e36-8fe2-56771f7a5c17",
                        "glosses": [
                            "The lack or absence of influence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "375bb974-bbdc-48df-82be-f24cc40fc194",
                                "sense_id": "926e48ef-d6a2-3f86-82cc-bb05091251da",
                                "text": "This result justifies the negative result of the well-known Lodge's experiment to detect ether drag by rapidly rotating a heavy iron spheroid, and also predicts the uninfluence of the rotation of the earth, the sun and the Jupiter on the velocity of the ray of light passing by their edges."
                            },
                            {
                                "example_id": "ff6c8de9-e39a-4018-8371-b4a860769f57",
                                "sense_id": "926e48ef-d6a2-3f86-82cc-bb05091251da",
                                "text": "Such experiment was devoted to reveal the influence (or uninfluence) of the terrestrial motion on the speed of light."
                            },
                            {
                                "example_id": "97d42656-44b5-4ef7-b387-bf656983e338",
                                "sense_id": "926e48ef-d6a2-3f86-82cc-bb05091251da",
                                "text": "Additional advantages of postmortem imaging are its noninvasive nature, the uninfluence of radiation dosing, the reasonably brief time of execution, and the ability to detect alterations that may not be apparent on traditional autopsies."
                            }
                        ]
                    }
                ],
