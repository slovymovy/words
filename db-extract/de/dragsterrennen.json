                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "643f4fe6-2819-45b9-b664-a6dec57d3eff",
                                "sense_id": "ed7b4f5d-58e7-33b2-8c83-677495ccb468",
                                "text": "„Beim Dragsterrennen am Hockenheimring schafft Jndia Erbacher eine Bestzeit über die Viertelmeile.“"
                            },
                            {
                                "example_id": "15d0849c-5ec3-49e4-91d4-f76f7866c845",
                                "sense_id": "ed7b4f5d-58e7-33b2-8c83-677495ccb468",
                                "text": "„Ahonen füllte die Leere nach seinem ersten Karriereende 2008 mit Dragsterrennen und einer eigenen Firma, doch der Reiz des Skispringens ließ ihn nicht los.“"
                            },
                            {
                                "example_id": "4274496a-e499-43e3-8268-393c85a72f75",
                                "sense_id": "ed7b4f5d-58e7-33b2-8c83-677495ccb468",
                                "text": "„Bei Dragsterrennen messen sich speziell modifizierte Autos mit einem Motor mit einigen Tausend PS auf einer Strecke von einer viertel Meile (402,34 Meter).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
