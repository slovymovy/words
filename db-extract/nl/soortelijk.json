                    },
                    {
                        "form_id": "367c3f1f-bb8b-46b7-9ba9-0478ad5fe093",
                        "entry_id": "61223ab2-d8ac-3d76-a8f7-cc97e62c822a",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "soortelijks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c3069c0-039d-316c-811b-eb12713973f2",
                        "entry_id": "61223ab2-d8ac-3d76-a8f7-cc97e62c822a",
                        "glosses": [
                            "typisch voor een bepaald soort materiaal, eigen aan de soort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1211520d-6a85-484c-aa51-4e4b438bab80",
                                "sense_id": "8c3069c0-039d-316c-811b-eb12713973f2",
                                "text": "Van urine kan men het soortelijk gewicht en het natriumgehalte bepalen, om een indruk te krijgen van het concentrerend vermogen van de nieren. Tevens kan de pH bepaald worden. Daaraan is te zien wat de nieren doen om de zuurgraad van het bloed constant te houden."
                            },
                            {
                                "example_id": "5060c37e-7a15-4916-89c0-75b529bf2ee0",
                                "sense_id": "8c3069c0-039d-316c-811b-eb12713973f2",
                                "text": "Het nummer, destijds een stuk bekender in de vertolking van Ruth Etting, bijgenaamd `America's sweetheart of song', is naar huidige begrippen van een bijzonder laag soortelijk gewicht en is ook nog sterk vaudevilleachtig, zoals trouwens de bulk van de schijven uit de Parijse platendoos van Mondriaan."
                            },
                            {
                                "example_id": "b414b335-cb0e-4258-895d-41713e2ee130",
                                "sense_id": "8c3069c0-039d-316c-811b-eb12713973f2",
                                "text": "Vanaf de Parijse periode waaiert de tentoonstelling open en stijgt het soortelijk gewicht van de presentatie. Er zijn nu ook beelden, onder anderen van Degas en Rodin, en veel meer schilderijen. Het zal niet verbazen dat de Franse school erg present is, met waardevolle schilderijen van Renoir, Monet, Courbet, Seurat en De­lacroix. Uit onze contreien zijn er degelijke stukken van Frans Francken II, Jan Brueghel II en het atelier van Lucas Cranach de Jongere. Oud werk van Dürer, Italiaanse schilderijen van Francesco Guardi en (toch weer) tekeningen van Tiepolo, het is er allemaal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d67b1cb3-ad22-40e5-b14d-22373a44abef",
                        "source_entry_id": "61223ab2-d8ac-3d76-a8f7-cc97e62c822a",
                        "source_sense_id": "8c3069c0-039d-316c-811b-eb12713973f2",
                        "target_lang_word": "specific",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "specific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e338e8a1-1be3-3dd3-9f51-a645963929b8",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Explicit or definite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147cb5b8-4209-4ec2-a920-642047cc5b3e",
                                                "sense_id": "e338e8a1-1be3-3dd3-9f51-a645963929b8",
                                                "text": "While some participants, like Gabi and Jasmine, had access to a gym but still felt uncertain about using specific types of equipment, others who trained at home faced even greater challenges due to the absence of both a coach and proper equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c6fd8f0-49d2-3633-bc06-29ae20328636",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Pertaining to a species, as a taxon or taxa at the rank of species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6dde41-9bd8-4f6e-bd11-fb2c86b5467d",
                                                "sense_id": "2c6fd8f0-49d2-3633-bc06-29ae20328636",
                                                "text": "Holonyms: generic, familial"
                                            },
                                            {
                                                "example_id": "fa7e6a1b-b00e-4097-99b0-7c04ab7e98b6",
                                                "sense_id": "2c6fd8f0-49d2-3633-bc06-29ae20328636",
                                                "text": "Meronyms: infrasubspecific, infraspecific, subspecific"
                                            },
                                            {
                                                "example_id": "e0bc9c43-0911-4d3a-9b5f-7983a5bb885a",
                                                "sense_id": "2c6fd8f0-49d2-3633-bc06-29ae20328636",
                                                "text": "Science and literature, then, are the two achievements of Homo sapiens that most convincingly justify the specific name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbbccd33-3aa4-3fe0-9730-b96e28e0b34d",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Special, distinctive or unique."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28af2182-93d7-44c5-8c13-50752560109b",
                                                "sense_id": "cbbccd33-3aa4-3fe0-9730-b96e28e0b34d",
                                                "text": "A psychologist told WJLA TV that, for the most part, this isn’t a Cocomelon-specific issue. The main issue is too much screen time and children's shows with fast-paced sequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb323332-1811-3c93-bed1-71519723a708",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "intended for, or applying to, a particular thing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8b63de1-84be-37fd-9796-a6742eea1faf",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Serving to identify a particular thing (often a disease or condition), with little risk of mistaking something else for it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421c2fb4-f4ff-4cc5-b867-d7e5c4050798",
                                                "sense_id": "e8b63de1-84be-37fd-9796-a6742eea1faf",
                                                "text": "a highly specific test    specific and nonspecific symptoms"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1cc816a-00d8-3762-8e84-2805033516f5",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Being a remedy for a particular disease on a deeper level, rather than just masking the symptoms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c9196d-764b-4b4e-b144-d5d80d42c72d",
                                                "sense_id": "f1cc816a-00d8-3762-8e84-2805033516f5",
                                                "text": "Quinine is a specific medicine in cases of malaria."
                                            },
                                            {
                                                "example_id": "220229ca-12cb-4607-a554-0b23dcab4c72",
                                                "sense_id": "f1cc816a-00d8-3762-8e84-2805033516f5",
                                                "text": "Any improvement in secondary sciatica is probably due to the analgesic action of the sodium salicylate, but in primary sciatica, in all likelihood “rheumatic,” the effect of the sodium salicylate appears to be specific rather than symptomatic."
                                            },
                                            {
                                                "example_id": "0751c376-e6db-4aa4-b130-266ae6d29ca3",
                                                "sense_id": "f1cc816a-00d8-3762-8e84-2805033516f5",
                                                "text": "The study of specific medicines is too much disregarded now. No doubt, the hunting after specifics is a mark of ignorance and weakness in medicine, yet the neglect of them is proof also of immaturity; for, in fact, all medicines will be found specific in the perfection of science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7db2a0d4-9b6b-345f-955b-84d6458d9318",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Limited to a particular antibody or antigen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecaad49f-81f6-3fed-9139-901cd9eec8a0",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Of a value divided by mass (e.g. specific orbital energy)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea4785ad-310f-3ea7-8910-3fd3240913f2",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "Similarly referring to a value divided by any measure which acts to standardize it (e.g. thrust specific fuel consumption, referring to fuel consumption divided by thrust)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "953ba0cc-14bf-3dad-a0ed-24d0d514fcbe",
                                        "entry_id": "e20f88a0-8830-3127-ab42-a03070ccbc37",
                                        "glosses": [
                                            "A measure compared with a standard reference value by division, to produce a ratio without unit or dimension (e.g. specific refractive index is a pure number, and is relative to that of air)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "specific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0be4c3-ef44-35da-a940-0b8a3cf0a9d7",
                                        "entry_id": "c546993d-66b4-33bb-a9f5-3ef579164bae",
