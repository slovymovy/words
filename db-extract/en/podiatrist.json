    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                "word": "podiatrist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7cde92aa-0197-4fc0-92db-e09e48f82165",
                        "entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "tags": [
                            "plural"
                        ],
                        "form": "podiatrists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                        "entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "glosses": [
                            "A health care practitioner who specializes in the diagnosis and treatment of foot ailments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fde215-06b9-4fa2-9ef0-06cab4c11e30",
                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                "text": "I visited my podiatrist to get a new pair of orthopedic inserts for my sneakers."
                            },
                            {
                                "example_id": "4ab19f91-f9fd-4589-9fe8-7aa539bca75e",
                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                "text": "Dr. Larry Braunstein, a podiatrist who died in 2007, often told the story of providing Donald Trump with the diagnosis of bone spurs in his heels so he could be exempt from military service, his two daughters – Dr. Elysa Braunstein and Sharon Kessel – told the New York Times."
                            },
                            {
                                "example_id": "6fbd054c-4049-4931-810d-3452887dfe3d",
                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                "text": "To better help you in your quest, we asked multiple podiatrists and seasoned long-distance walkers exactly what to look for when selecting the best walking shoes."
                            },
                            {
                                "example_id": "5252c4e2-a8b1-4523-b432-f2d222599b6d",
                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                "text": "The subcommittee, which is chaired by Ohio Republican Rep. Brad Wenstrup, a podiatrist, will hold a markup session for the report Wednesday before submitting it to the congressional record."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d8ebe6-8cbe-49d9-893e-7499e203ec80",
                        "source_entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "source_sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
