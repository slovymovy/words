                                        "glosses": [
                                            "To treat (a person) to cocktails."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59be2da1-5b34-4c28-9d90-8ef313cf3ca7",
                                                "sense_id": "185cf763-e23c-39dc-bab3-66aa90836ff1",
                                                "text": "He dined and cocktailed her at the most exclusive bars and restaurants."
                                            }
                                        ]
                                    }
                                ]
