                            {
                                "target_lang_word": "ostry",
                                "target_lang_sense_clarification": "o mroźnym powietrzu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3bd106f-6bcd-3be3-bf41-c44cf96cc075",
                    "sense_definition": "Bad, evil, or threatening in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter contained some <w>shrewd</w> news that caused great distress to the family.",
                            "target_lang_translations": {
                                "pl": "List zawierał <w>złe</w> wieści, które wywołały wielki niepokój w rodzinie."
                            }
                        },
                        {
                            "text": "He feared that some <w>shrewd</w> mischief was being planned behind closed doors.",
                            "target_lang_translations": {
                                "pl": "Obawiał się, że za zamkniętymi drzwiami planowana jest jakaś <w>niegodziwa</w> psota."
                            }
                        }
