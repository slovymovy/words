                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>misnomered</w> the chemical compound throughout the entire chapter."
                        },
                        {
                            "text": "By <w>misnomering</w> the indigenous community, the report caused considerable offense."
