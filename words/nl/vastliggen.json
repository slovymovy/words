{
    "word_family": [
        "vastleggen",
        "vastlegging",
        "vastliggend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd72b464-2459-3c92-9b18-30678ae48aab",
                    "sense_definition": "officieel bepaald, geregistreerd of onveranderlijk zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bepaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>ligt</w> <w>vast</w> dat de budgettaire spanningen de komende jaren groter worden.",
                            "target_lang_translations": {
                                "en": "It <w>is certain</w> that budgetary tensions will increase in the coming years."
                            }
                        },
                        {
                            "text": "De afspraken voor de nieuwe samenwerking <w>liggen</w> nu definitief <w>vast</w>.",
                            "target_lang_translations": {
                                "en": "The agreements for the new collaboration <w>are</w> now definitively <w>fixed</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bepaald",
                        "gefixeerd",
                        "geregistreerd"
                    ],
                    "antonyms": [
                        "onzeker",
                        "variabel"
                    ],
                    "common_phrases": [
                        "bij wet vastliggen",
                        "definitief vastliggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be officially determined, registered, or unchangeable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be fixed",
                                "target_lang_sense_clarification": "to be set or established and not subject to change"
                            },
                            {
                                "target_lang_word": "be recorded",
                                "target_lang_sense_clarification": "to be officially documented or registered"
                            },
                            {
                                "target_lang_word": "be certain",
                                "target_lang_sense_clarification": "to be a settled fact or outcome"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6301c504-f11d-3d47-8540-549cb4119107",
                    "sense_definition": "fysiek aan iets bevestigd zijn of niet kunnen bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boot <w>lag</w> stevig <w>vast</w> aan de kade tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The boat <w>was</w> firmly <w>moored</w> to the quay during the storm."
                            }
                        },
                        {
                            "text": "Zorg ervoor dat de lading goed <w>vastligt</w> voordat je gaat rijden.",
                            "target_lang_translations": {
                                "en": "Make sure the cargo <w>is</w> properly <w>secured</w> before you start driving."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastzitten",
                        "verankerd"
                    ],
                    "antonyms": [
                        "losliggen"
                    ],
                    "common_phrases": [
                        "aan de ketting vastliggen",
                        "stevig vastliggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be physically attached to something or unable to move"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be moored",
                                "target_lang_sense_clarification": "specifically for ships or boats secured to a dock"
                            },
                            {
                                "target_lang_word": "be secured",
                                "target_lang_sense_clarification": "to be firmly attached or fastened in place"
                            },
                            {
                                "target_lang_word": "be tied up",
                                "target_lang_sense_clarification": "to be fastened with ropes or chains"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}