                        "sense_id": "3e7eedce-c056-388c-941a-0b853cbf710b",
                        "entry_id": "68c76b03-b348-3eba-b88a-98e64ab598fa",
                        "glosses": [
                            "Infirmière ou sage-femme spécialisée en puériculture, dans les soins apportés aux nouveau-nés, aux nourrissons et aux enfants malades."
                        ],
                        "tags": [
                            "Métier",
                            "Puériculture"
                        ],
                        "examples": [
                            {
                                "example_id": "dab6bb93-c7ae-4e25-9ceb-b662fb3b530b",
                                "sense_id": "3e7eedce-c056-388c-941a-0b853cbf710b",
                                "text": "La puéricultrice donne les premiers soins au bébé."
                            },
                            {
                                "example_id": "b8fac63a-be42-4d96-86e5-29a0eb65c527",
                                "sense_id": "3e7eedce-c056-388c-941a-0b853cbf710b",
                                "text": "L’enjeu de la puéricultrice en néonatologie n’est donc pas de faire reconnaître sa spécificité mais d’arriver à la mettre en œuvre, non seulement en faisant face aux résistances des autres professionnels, mais également à sa propre résistance devant la répétition des situations délicates."
                            }
                        ]
                    }
                ],
