                    ]
                },
                {
                    "sense_id": "8bc2da69-2c4f-3ae9-96ca-505891051e33",
                    "sense_definition": "Désigne une personne, une chose ou un moment de manière indéterminée ou imprécise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indetermination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le règlement prévoit que si <w>tel</w> salarié est absent, un collègue le remplace."
                        },
                        {
                            "text": "Le client peut choisir de se faire livrer <w>tel</w> jour, à l'heure qui lui convient."
                        }
                    ],
                    "common_phrases": [
                        "tel ou tel",
                        "à telle heure",
                        "tel jour"
                    ]
                },
                {
                    "sense_id": "d3de3e80-1ebb-33cd-ae5e-fd66ac5750cf",
                    "sense_definition": "Exprime une intensité ou un degré si élevé qu'il entraîne une conséquence particulière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent soufflait avec une <w>telle</w> force que les branches des arbres cassaient."
                        },
                        {
                            "text": "L'obscurité était <w>telle</w> qu'on ne pouvait distinguer les contours du sentier."
                        }
