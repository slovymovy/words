{
    "word_family": [
        "faithful",
        "faithfully",
        "faithfulness",
        "faithless",
        "faithlessness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d22b841b-acb6-3c37-9831-feb62f89e6b5",
                    "sense_definition": "A strong trust or confidence in someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trust_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have complete <w>faith</w> in your ability to succeed.",
                            "target_lang_translations": {
                                "ru": "Я полностью <w>уве́рен</w> в твоей способности преуспеть.",
                                "tr": "Başarılı olacağına dair sana tam bir <w>güvenim</w> var."
                            }
                        },
                        {
                            "text": "She lost <w>faith</w> in the doctor after the treatment failed.",
                            "target_lang_translations": {
                                "ru": "Она потеряла <w>ве́ру</w> во врача после того, как лечение не помогло.",
                                "tr": "Tedavi başarısız olunca doktora olan <w>inancını</w> kaybetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "trust",
                        "confidence",
                        "belief",
                        "conviction"
                    ],
                    "antonyms": [
                        "doubt",
                        "mistrust"
                    ],
                    "common_phrases": [
                        "have faith in",
                        "lose faith in",
                        "put faith in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокое доверие или уверенность в ком-либо или чем-либо.",
                        "tr": "Birine veya bir şeye duyulan güçlü güven veya inanç."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́ра",
                                "target_lang_sense_clarification": "доверие"
                            },
                            {
                                "target_lang_word": "уве́ренность",
                                "target_lang_sense_clarification": "убеждённость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güven",
                                "target_lang_sense_clarification": "itimat, emniyet"
                            },
                            {
                                "target_lang_word": "inanç",
                                "target_lang_sense_clarification": "güvenme duygusu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120ef3e8-6377-320f-ad63-2f4b0fdb2434",
                    "sense_definition": "Strong belief in something, especially without proof or evidence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "trust_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starting a new business often requires a leap of <w>faith</w>.",
                            "target_lang_translations": {
                                "ru": "Начало нового бизнеса часто требует прыжка <w>ве́ры</w>.",
                                "tr": "Yeni bir işe başlamak genellikle bir gözü kapalı <w>inanç</w> adımı gerektirir."
                            }
                        },
                        {
                            "text": "He has <w>faith</w> that everything will work out in the end.",
                            "target_lang_translations": {
                                "ru": "Он <w>ве́рит</w>, что в конце концов всё образуется.",
                                "tr": "Sonunda her şeyin yoluna gireceğine dair <w>inancı</w> var."
                            }
                        }
                    ],
                    "synonyms": [
                        "belief",
                        "conviction"
                    ],
                    "antonyms": [
                        "disbelief",
                        "skepticism"
                    ],
                    "common_phrases": [
                        "leap of faith",
                        "blind faith",
                        "act of faith"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная убеждённость в чем-либо, особенно без доказательств.",
                        "tr": "Kanıt veya delil olmaksızın bir şeye duyulan güçlü inanç."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́ра",
                                "target_lang_sense_clarification": "убеждение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "inanç",
                                "target_lang_sense_clarification": "sarsılmaz bağlılık"
                            },
                            {
                                "target_lang_word": "iman",
                                "target_lang_sense_clarification": "güçlü inanç"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c268f8c-49f0-3c16-8d57-10e9a2553762",
                    "sense_definition": "A particular religion or system of religious beliefs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People of many different <w>faiths</w> live together in this city.",
                            "target_lang_translations": {
                                "ru": "В этом городе живут люди самых разных <w>вероиспове́даний</w>.",
                                "tr": "Bu şehirde birçok farklı <w>dinden</w> insan bir arada yaşıyor."
                            }
                        },
                        {
                            "text": "She was raised in the Christian <w>faith</w> but later explored other religions.",
                            "target_lang_translations": {
                                "ru": "Она была воспитана в христианской <w>ве́ре</w>, но позже заинтересовалась другими религиями.",
                                "tr": "Hristiyan <w>inancıyla</w> yetiştirildi ama daha sonra diğer dinleri araştırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "religion",
                        "belief"
                    ],
                    "common_phrases": [
                        "people of all faiths",
                        "interfaith"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная религия или система религиозных верований.",
                        "tr": "Belli bir din veya dini inanç sistemi."
                    },
                    "translations": {
