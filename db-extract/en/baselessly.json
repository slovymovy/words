                        "examples": [
                            {
                                "example_id": "dda120c4-c500-475e-b4b5-d04028fcfa9a",
                                "sense_id": "7b52fc7a-cee7-36e1-8b33-883b1b8b1dd8",
                                "text": "Having systematically and baselessly pronounced every objective system to which he might be accountable as invalid or illegal — a list that includes polls, data, newspapers, and actual math — Trump suggests that, in fact-free Trumplandia, he has not just the right but the obligation to hold the nation hostage while he judges the election. He alone will pronounce on its legitimacy, and the basis of his pronouncement will not be anything you — a mere outsider to his marvelous world — can measure."
                            }
                        ]
                    }
