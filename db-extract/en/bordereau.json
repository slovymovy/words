                    },
                    {
                        "translation_id": "4b5a757d-6541-455a-978c-bab8c7da78ca",
                        "source_entry_id": "5da950b5-c5f9-3441-9e98-7df862b924da",
                        "source_sense_description": "a statement with listing",
                        "target_lang_word": "bordereau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bordereau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                        "entry_id": "6afebd21-7b8b-38eb-a5bb-7ea26270eed8",
                                        "glosses": [
                                            "Relevé détaillé de quelque chose, par exemple des divers articles dont se compose une somme à payer ou à recevoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7a4f93-7958-43ae-b5e1-fba737394e6b",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "Harcelé par ses supérieurs, eux-mêmes en butte à de pressantes interventions émanant de personnalités influentes et même du « Château », l’inspecteur Duval en arrivait à se demander si le rédacteur du bordereau gagnant — puisque ce bordereau gagnant existe, se disait-il avec rage en contemplant la souche correspondante, hélas anonyme — finirait par présenter, dans l’espoir d’empocher ses gains, un titre sur lequel il aurait certaines explications à fournir…"
                                            },
                                            {
                                                "example_id": "c18bf8c3-a692-40be-ab43-33ed84232cb3",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "À Paris, des bordereaux de banques attestent que les deux agents ont réalisé quand même pour lui certains bénéfices."
                                            },
                                            {
                                                "example_id": "73c4e5ea-2dc8-403f-a262-aeffb668d266",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "Bordereau de courtier, d’agent de change, écrit constatant les opérations, les négociations faites par un courtier, par un agent de change."
                                            },
                                            {
                                                "example_id": "dfb064dc-ad70-4d33-9575-ed7411d9a26b",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "Le bordereau d’un metteur en pages, etc."
                                            },
                                            {
                                                "example_id": "c79841c9-4e75-4759-9b4b-c6a1bb6e127e",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "Bordereau de collocation : Acte que le greffier d’un tribunal délivre à chacun des créanciers hypothécaires utilement colloqués dans un ordre."
                                            },
                                            {
                                                "example_id": "72756d74-087b-469b-9fce-2ca9dad48e9e",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "Bordereau d’inscription : Acte dressé par un créancier et remis par lui à un conservateur des hypothèques, pour que ce dernier le copie sur ses registres, et qui contient, entre autres désignations, celle des sommes dues à ce créancier en principal et accessoires, ainsi que celle de l’immeuble affecté à l’hypothèque."
                                            },
                                            {
                                                "example_id": "8dc22d66-c684-4157-b36e-67798537c766",
                                                "sense_id": "84cab9ff-4b96-31de-b031-09ad45f5d3c6",
                                                "text": "C’est l’inscription de ce bordereau sur les registres du conservateur qui fixe la date et le rang de l’hypothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc58a723-4f71-3882-be2e-acba9835a1a5",
                                        "entry_id": "6afebd21-7b8b-38eb-a5bb-7ea26270eed8",
                                        "glosses": [
                                            "Notice des pièces qui composent un dossier."
                                        ],
