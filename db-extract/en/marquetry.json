                ],
                "senses": [
                    {
                        "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                        "entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                        "glosses": [
                            "A decorative technique in which veneers of wood, ivory, metal etc. are inlaid into a wooden surface to form intricate designs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "433cb284-7e97-4d47-8467-81f3ec52ca1c",
                                "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                                "text": "strawen marquetry"
                            },
                            {
                                "example_id": "15b921e6-cfe9-45f5-b4d2-07a1f9ab982d",
                                "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                                "text": "Wearing a dress in Labour's ruby red, the shadow chancellor joins me at a circular table amid the art deco glamour of Bettys' subterranean Spindler room, which is adorned with numerous stained-wood “marquetry pictures”."
                            }
                        ]
                    },
                    {
                        "sense_id": "421b9811-63e3-3de1-b57d-178c9019f3f7",
                        "entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                        "glosses": [
                            "An example of this work."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ad8f82-97d7-4cf7-9fed-645a90208360",
                                "sense_id": "421b9811-63e3-3de1-b57d-178c9019f3f7",
                                "text": "Unkind people asserted that everything in his apartment was for sale and that after he had invited wealthy Americans for an excellent lunch, with vintage wines, one or two of his valuable drawings would disappear, or a marquetry commode would be replaced by one in lacquer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20fedf5c-4d12-40aa-be23-2cf53ee64719",
                        "source_entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
