                                            {
                                                "example_id": "6900fd50-9416-4aff-b803-4102fa8b9d87",
                                                "sense_id": "29987d56-5de0-3d55-b0cf-fcaa2cf2b926",
                                                "text": "Am Nachmittag fuhr Carmen wieder auf ihre Hazienda."
                                            },
                                            {
                                                "example_id": "f5475451-2da4-4362-9210-033dab3e3743",
                                                "sense_id": "29987d56-5de0-3d55-b0cf-fcaa2cf2b926",
                                                "text": "„Sie reiste heim auf die Hazienda ihrer Eltern: und nach der standesgemäßen Eheschließung zwang ihr der Gatte die Beine auseinander zur Besamung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "537c31e7-7d97-42e4-86c5-b6a74674bb2b",
                        "source_entry_id": "2e70cdeb-264c-3a94-ae5d-e1a4c1a07d6b",
                        "source_sense_id": "4cb0fae1-a2e9-3a31-af2b-324f2bc2c031",
