                        "sense_id": "657bd4db-a861-3697-907c-6f95c4351c8d",
                        "entry_id": "424b5757-dd07-3b82-b22c-30d2e036e9df",
                        "glosses": [
                            "vrouw die het gemaaide graan bijeen bindt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "062046a5-8150-45c3-be35-74424d503237",
                                "sense_id": "657bd4db-a861-3697-907c-6f95c4351c8d",
                                "text": "Boerenkielen, knipmutsen en accordeonmuziek maken de Twentse gemoedelijkheid compleet. Even verderop zijn Jan Busscher, Bennie Veldhuis en Gerard Wassink en bindster Annie Busscher druk met de oogst. Maaien met de zig, dorsen op met de knuppel op de vloer en het kaf van het koren scheiden in de kafmolen."
                            },
                            {
                                "example_id": "8d5abff3-3ec9-457a-aff5-49e206568a92",
                                "sense_id": "657bd4db-a861-3697-907c-6f95c4351c8d",
                                "text": "En dan de dorpsklok die klept plus de forse maaiers die zich staan te bekruisen met de rappe bindsters, het lijkt op de negentiende eeuw vertolkt door iemand die in een later eeuw achteromkijkt."
                            }
                        ]
                    }
                ],
