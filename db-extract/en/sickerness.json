                        "examples": [
                            {
                                "example_id": "51ee9f14-eee1-48c5-a4ce-706179ba5c8d",
                                "sense_id": "298a9ef1-e739-34cf-be66-e63ab629d787",
                                "text": "Lightly she leaped, as a wight forlore, / From her dull horse, in desperate distresse, / And to her feet betooke her doubtfull sickernesse."
                            },
                            {
                                "example_id": "902a5c23-4d8a-46be-87fa-bae259706c4a",
                                "sense_id": "298a9ef1-e739-34cf-be66-e63ab629d787",
                                "text": "Comprehending the world casual and transitory, Who list to consider shall never be beguiled, If it be regist'red well in memory; A plain example of worldly vainglory: How in this world there is no sickerness, But fallible flattery enmixed with bitterness."
                            }
                        ]
                    }
