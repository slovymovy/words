                                    {
                                        "sense_id": "ba12936c-5a78-3d0b-b41a-1a4acc94a1b3",
                                        "entry_id": "73e5208e-d8de-3a49-af26-aa4b6db253b3",
                                        "glosses": [
                                            "stark verdicktes Speicherorgan einiger Pflanzen an dessen Bildung Wurzel und Sprossbestandteile beteiligt sind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3ee723-dee4-4ce1-8317-38c253a37507",
                                                "sense_id": "ba12936c-5a78-3d0b-b41a-1a4acc94a1b3",
                                                "text": "Einige Pflanzen speichern Nährstoffe in Rüben."
                                            },
                                            {
                                                "example_id": "52b61542-b935-45ae-a218-8969c193bcc6",
                                                "sense_id": "ba12936c-5a78-3d0b-b41a-1a4acc94a1b3",
                                                "text": "Rüben sind im Pflanzenreich weit verbreitet, besonders in den Gattungen Brassica, Beta und bei Umbelliferen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e800347-64f4-354a-aada-b3d61a2e18e8",
                                        "entry_id": "73e5208e-d8de-3a49-af26-aa4b6db253b3",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Beta, insbesondere Beta vulgaris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5323ff75-1e35-4051-bef6-3d3e903d7192",
                                                "sense_id": "0e800347-64f4-354a-aada-b3d61a2e18e8",
                                                "text": "Aus der Rübe (Beta vulgaris) wurden viele Kulturformen gezüchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e20d5470-9e94-3d9f-ae0e-cf8e2bad7804",
                                        "entry_id": "73e5208e-d8de-3a49-af26-aa4b6db253b3",
                                        "glosses": [
                                            "Kopf"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bfe383f-9c24-4427-9e47-e258c31dc6f7",
                                                "sense_id": "e20d5470-9e94-3d9f-ae0e-cf8e2bad7804",
                                                "text": "„Dann knackte er ihre Rübe mit ’m Holzklotz und futterte ihr Hirn.“"
                                            },
                                            {
                                                "example_id": "51df3eb5-2c08-4cc3-a9f8-eb788a743edb",
                                                "sense_id": "e20d5470-9e94-3d9f-ae0e-cf8e2bad7804",
                                                "text": "„All diese herrlichen Lieder, die mir in der Rübe herumfahren, während ich im Taxi dahinfahre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "8becf6c7-36af-3bc4-ae1b-94d713400774",
