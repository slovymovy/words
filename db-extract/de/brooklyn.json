                "senses": [
                    {
                        "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                        "entry_id": "491dc0c2-3333-3505-bb93-cbceaced91c9",
                        "glosses": [
                            "Stadtteil im Südosten von New York City"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d40241-5182-4e3f-9a47-2d7a46bab0bf",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Er hatte ein Restaurant namens Olymp mitten in Brooklyn.“"
                            },
                            {
                                "example_id": "1df29ac0-a73c-41aa-ac4c-c0d492f869a3",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Im Februar 1994 ermordete der in Brooklyn gebürtige religiöse Siedler Baruch Goldstein in Hebron neunundzwanzig palästinensische Gläubige.“"
                            },
                            {
                                "example_id": "d1c27aff-787d-48c4-a5c6-0a4e3e1cbafe",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Die Zahl ist im großen Computer in Brooklyn gespeichert.“"
                            },
                            {
                                "example_id": "e69eb508-4617-434d-9e0e-e812f2e9d74a",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Da ich damals als kleiner Junge in Brooklyn aufwuchs, erinnere ich mich sehr gut an diesen Fall.“"
                            },
                            {
                                "example_id": "ae9288e5-cebe-469c-83fc-54b14ba40ded",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Das Folgende betrifft die Bestrafung von Dr. Henry Sargent Moore aus Brooklyn, New York, Professor für Biologie im Fachbereich Wirbellose an der Columbia University, New York, N.Y.“"
                            },
                            {
                                "example_id": "4fac66a6-9e67-4e93-96ee-9beb31cd7851",
                                "sense_id": "4d1cd8b8-8e8a-365a-81fe-bb21575b6691",
                                "text": "„Von ihren Großeltern mütterlicherseits wusste sie gerade, dass sie in Brooklyn gewohnt hatten und irgendwo aus England stammten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
