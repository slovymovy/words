                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147f78ac-fcc4-4063-a931-e5dcd40e3405",
                                                "sense_id": "e4910b7d-6094-3976-993a-caf974d213e5",
                                                "text": "Im hohen Gras sind die Kitze zwar vor Feinden gut versteckt, aber oft werden ihnen Mähmaschinen zum Verhängnis."
                                            }
