{
    "word_family": [
        "redundance",
        "redundancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                    "sense_definition": "Exceeding what is necessary or no longer needed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory closed and left behind a <w>redundant</w> power station.",
                            "target_lang_translations": {
                                "zh": "工厂倒闭后，留下了一座<w>多余的</w>发电站。",
                                "pl": "Fabryka została zamknięta, pozostawiając <w>zbędną</w> elektrownię."
                            }
                        },
                        {
                            "text": "Remove any <w>redundant</w> information from the report to make it clearer.",
                            "target_lang_translations": {
                                "zh": "删掉报告中<w>多余的</w>信息，使其更清晰。",
                                "pl": "Usuń z raportu wszelkie <w>zbędne</w> informacje, aby uczynić go bardziej przejrzystym."
                            }
                        }
                    ],
                    "synonyms": [
                        "superfluous",
                        "unnecessary",
                        "extra",
                        "surplus"
                    ],
                    "antonyms": [
                        "needed"
                    ],
                    "common_phrases": [
                        "redundant equipment",
                        "redundant building"
                    ],
                    "target_lang_definitions": {
                        "zh": "超过了必要的限度，或者不再被需要。",
                        "pl": "Przekraczający to, co konieczne, lub już niepotrzebny."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多余的",
                                "target_lang_sense_clarification": "指物品或信息不再被需要或超出了需求。"
                            },
                            {
                                "target_lang_word": "冗余的",
                                "target_lang_sense_clarification": "指系统或结构中多出的部分。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zbędny",
                                "target_lang_sense_clarification": "taki, który nie jest już potrzebny lub jest nieprzydatny"
                            },
                            {
                                "target_lang_word": "nadmiarowy",
                                "target_lang_sense_clarification": "występujący w ilości większej niż potrzeba"
                            },
                            {
                                "target_lang_word": "redundantny",
                                "target_lang_sense_clarification": "zbyteczny, powielający istniejące funkcje lub elementy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ca3e228-cb5a-3481-a425-0a29dd911d54",
                    "sense_definition": "Using more words than necessary to express an idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The essay was full of <w>redundant</w> phrases that made it difficult to read.",
                            "target_lang_translations": {
                                "zh": "这篇文章充满了<w>啰嗦的</w>短语，读起来很费劲。",
                                "pl": "Esej był pełen <w>rozwlekłych</w> sformułowań, przez co trudno się go czytało."
                            }
                        },
                        {
                            "text": "Avoid <w>redundant</w> language when writing professional emails.",
                            "target_lang_translations": {
                                "zh": "写商务邮件时要避免使用<w>冗长的</w>语言。",
                                "pl": "Unikaj <w>przegadanego</w> języka podczas pisania profesjonalnych wiadomości e-mail."
                            }
                        }
                    ],
                    "synonyms": [
                        "repetitive",
                        "verbose"
                    ],
                    "common_phrases": [
                        "redundant phrasing"
                    ],
                    "target_lang_definitions": {
                        "zh": "表达一个观点时使用了不必要的词汇，显得啰嗦。",
                        "pl": "Używający większej liczby słów, niż jest to konieczne do wyrażenia myśli."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "啰嗦的",
                                "target_lang_sense_clarification": "指语言表达重复且冗长。"
                            },
                            {
                                "target_lang_word": "冗长的",
                                "target_lang_sense_clarification": "指文章或话语中包含过多不必要的修饰。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozwlekły",
                                "target_lang_sense_clarification": "zawierający zbyt wiele słów i niepotrzebnych szczegółów"
                            },
                            {
                                "target_lang_word": "przegadany",
                                "target_lang_sense_clarification": "zawierający zbyt wiele słów, niepotrzebnie wydłużony"
                            },
                            {
                                "target_lang_word": "redundantny",
                                "target_lang_sense_clarification": "językowo nadmiarowy, powtarzający tę samą treść"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b30eed-fc5f-3032-8c7f-db349ec9e3c1",
                    "sense_definition": "Dismissed from a job because the position is no longer required.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many workers were made <w>redundant</w> during the economic downturn.",
                            "target_lang_translations": {
                                "zh": "经济低迷时期，许多工人被<w>裁员</w>了。",
                                "pl": "Wielu pracowników zostało <w>zwolnionych w ramach redukcji etatów</w> podczas spowolnienia gospodarczego."
                            }
                        },
                        {
                            "text": "After the company merged, several staff members were unfortunately made <w>redundant</w>.",
                            "target_lang_translations": {
                                "zh": "公司合并后，不幸有几名员工被<w>裁员</w>了。",
                                "pl": "Po fuzji firm kilku pracowników niestety zostało <w>zwolnionych w wyniku redukcji zatrudnienia</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "laid-off"
                    ],
                    "common_phrases": [
                        "made redundant"
                    ],
                    "target_lang_definitions": {
                        "zh": "因职位不再需要而被解雇。",
                        "pl": "Zwolniony z pracy z powodu likwidacji lub braku zapotrzebowania na dane stanowisko."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被裁员的",
                                "target_lang_sense_clarification": "指因公司业务调整或职位撤销而失去工作。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zwolniony w ramach redukcji etatów",
                                "target_lang_sense_clarification": "taki, z którym rozwiązano umowę z powodu likwidacji stanowiska"
                            },
                            {
                                "target_lang_word": "zredukowany",
                                "target_lang_sense_clarification": "o pracowniku zwolnionym z powodu cięć kadrowych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e945cdda-d2fb-3ddc-a0b6-86de8f828cdf",
                    "sense_definition": "Serving as a backup to ensure a system continues to function if a component fails.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "backup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server has a <w>redundant</w> power supply to prevent data loss.",
                            "target_lang_translations": {
                                "zh": "该服务器配有<w>冗余的</w>电源，以防止数据丢失。",
                                "pl": "Serwer ma <w>nadmiarowe</w> zasilanie, aby zapobiec utracie danych."
                            }
                        },
                        {
                            "text": "Engineers installed a <w>redundant</w> system to ensure safety during the flight.",
                            "target_lang_translations": {
                                "zh": "工程师安装了一套<w>备份的</w>系统，以确保飞行安全。",
                                "pl": "Inżynierowie zainstalowali system <w>redundantny</w>, aby zapewnić bezpieczeństwo podczas lotu."
                            }
                        }
                    ],
                    "synonyms": [
                        "duplicate"
                    ],
                    "antonyms": [
                        "non-redundant"
                    ],
                    "common_phrases": [
                        "redundant system",
                        "redundant backup"
                    ],
                    "target_lang_definitions": {
                        "zh": "作为备份以确保系统在某个组件失效时仍能正常运行。",
                        "pl": "Służący jako rezerwa zapewniająca działanie systemu w razie awarii jednego z elementów."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "备份的",
                                "target_lang_sense_clarification": "指为了安全或容错而额外设置的组件。"
                            },
                            {
                                "target_lang_word": "冗余的",
                                "target_lang_sense_clarification": "技术术语，指为了提高可靠性而增加的重复配置。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nadmiarowy",
                                "target_lang_sense_clarification": "zapewniający rezerwę techniczną w systemie"
                            },
                            {
                                "target_lang_word": "redundantny",
                                "target_lang_sense_clarification": "zdublowany w celu zapewnienia niezawodności"
                            },
                            {
                                "target_lang_word": "rezerwowy",
                                "target_lang_sense_clarification": "zapasowy, uruchamiany w razie awarii"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}