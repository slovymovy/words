                        "sense_id": "50597a75-9790-3f1f-a556-802576cd8d14",
                        "entry_id": "56972f4a-29fc-3782-b48d-27c135c748ee",
                        "glosses": [
                            "een lengtemaat met een waarde van één miljardste meter of 0,000.001 millimeter, weergegeven met symbool nm"
                        ],
