                "senses": [
                    {
                        "sense_id": "8d65fe6e-d66e-317b-a4e5-714bbbe6d1cf",
                        "entry_id": "8520f693-a53d-323f-a0f7-632b3f8f8b6d",
                        "glosses": [
                            "Rakete zur Bekämpfung von Luftzielen von der Erdoberfläche (der Wasseroberfläche) aus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64b2a36-606b-4fd1-a6fc-f38a9cfcfbd3",
                                "sense_id": "8d65fe6e-d66e-317b-a4e5-714bbbe6d1cf",
                                "text": "Das in den Luftraum eingedrungene feindliche Flugzeug wurde von einer Fliegerabwehrrakete zerstört."
                            },
                            {
                                "example_id": "854f4e2d-e002-44f2-8062-ce49faaff9e7",
                                "sense_id": "8d65fe6e-d66e-317b-a4e5-714bbbe6d1cf",
                                "text": "„Islamistische Militante holen einen russischen Schlachtflieger Typ Suchoi Su-25 „Frogfoot“ mit einer tragbaren Fliegerabwehrrakete vom Himmel und erschießen am Boden den Piloten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
