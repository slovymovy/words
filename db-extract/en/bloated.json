                                                "text": "Gerookte vis is langer houdbaar dan verse vis."
                                            },
                                            {
                                                "example_id": "b9452219-ebd7-4549-9fab-94fd2bc0171d",
                                                "sense_id": "6e3bf0aa-733a-3940-84f6-918599189535",
                                                "text": "David Hockney zet zijn tanden in een Double Smash Burger met gekarameliseerde uien en gerookte cheddar. Zijn twee gehoorapparaten heeft hij naast zijn bord gelegd, op zijn schoot ligt een zorgvuldig gevouwen servet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gerookt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb5ee2b-6539-34eb-bf98-b78dfe5d6408",
                                        "entry_id": "7c58c773-054b-3100-b7dd-3ee2b1e43a11",
                                        "glosses": [
                                            "voltooid deelwoord van roken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "733247e7-c4a5-4ab8-81e0-18e3e8390054",
                                                "sense_id": "2eb5ee2b-6539-34eb-bf98-b78dfe5d6408",
                                                "text": "De stank deed vermoeden dat er vroeger duidelijk te veel was gerookt in de kamer."
                                            }
                                        ]
