                "senses": [
                    {
                        "sense_id": "b90badb6-b675-3b04-b585-70c5153ab0f3",
                        "entry_id": "b696ce8a-e16b-3ecb-8ac4-cc99f2262078",
                        "glosses": [
                            "een weggedeelte of vrijliggend pad dat is gereserveerd voor het gebruik door fietsers en snorfietsers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cfcfb2-6b84-49f7-b2bc-66d48541ee17",
                                "sense_id": "b90badb6-b675-3b04-b585-70c5153ab0f3",
                                "text": "Nederland is uniek in de wereld door de aanwezigheid van het grote aantal fietspaden."
                            },
                            {
                                "example_id": "636711dc-909f-4713-8bf0-4a44b87c4667",
                                "sense_id": "b90badb6-b675-3b04-b585-70c5153ab0f3",
                                "text": "De zestien wielrenners uit België fietsten volgens de politie op de weg en niet op het naastgelegen fietspad. De bestuurder van een zwarte auto wilde de groep passeren. Bij het inhalen heeft de automobilist waarschijnlijk twee wielrenners geraakt. Volgens de Belgen was er opzet in het spel."
                            },
                            {
                                "example_id": "e939e219-fdd3-482c-9784-d2fd98810e6a",
                                "sense_id": "b90badb6-b675-3b04-b585-70c5153ab0f3",
                                "text": "Experiment met maximumsnelheid op fietspad moet ongelukken terugdringen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c46b3d4-4924-42ad-bd83-1a31b59dbdc6",
                        "source_entry_id": "b696ce8a-e16b-3ecb-8ac4-cc99f2262078",
                        "source_sense_id": "b90badb6-b675-3b04-b585-70c5153ab0f3",
