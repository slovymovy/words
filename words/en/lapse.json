{
    "word_family": [
        "relapse",
        "lapsed",
        "lapsing",
        "collapsable",
        "collapse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b406e5c-09f2-3a2b-b8c5-b7382c3f3d0d",
                    "sense_definition": "A temporary failure or a minor mistake, often caused by a lack of attention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard had a brief <w>lapse</w> in concentration and forgot to lock the main gate.",
                            "target_lang_translations": {
                                "ru": "Охранник допустил кратковременную <w>потерю</w> концентрации и забыл запереть главные ворота.",
                                "zh": "保安一时<w>疏忽</w>，忘记锁上大门。"
                            }
                        },
                        {
                            "text": "A sudden <w>lapse</w> of judgment led him to share confidential information with the competitor.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>помутнение</w> рассудка заставило его поделиться конфиденциальной информацией с конкурентом.",
                                "zh": "他一时<w>判断失误</w>，将机密信息泄露给了竞争对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slip",
                        "slip-up",
                        "error",
                        "mistake",
                        "blunder"
                    ],
                    "common_phrases": [
                        "lapse of judgment",
                        "memory lapse",
                        "lapse in concentration",
                        "lapse in security"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная неудача или незначительная ошибка, часто вызванная невнимательностью.",
                        "zh": "指因注意力不集中而导致的暂时性失败或小错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплошность",
                                "target_lang_sense_clarification": "ошибочный поступок или промах"
                            },
                            {
                                "target_lang_word": "упущение",
                                "target_lang_sense_clarification": "ошибка по невнимательности"
                            },
                            {
                                "target_lang_word": "ляпсус",
                                "target_lang_sense_clarification": "досадная ошибка или промах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疏忽",
                                "target_lang_sense_clarification": "因粗心大意而造成的过失"
                            },
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "工作或判断上的差错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e4f41b6-229d-3496-9234-d1e66de104c4",
                    "sense_definition": "A period or interval of time that passes between two events.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a <w>lapse</w> of several years, the two old friends finally met for coffee.",
                            "target_lang_translations": {
                                "ru": "По <w>прошествии</w> нескольких лет два старых друга наконец встретились за чашкой кофе.",
                                "zh": "在<w>间隔</w>了几年之后，两位老友终于见面喝了杯咖啡。"
                            }
                        },
                        {
                            "text": "The significant <w>lapse</w> of time between the two experiments made the results difficult to compare.",
                            "target_lang_translations": {
                                "ru": "Значительный <w>промежуток</w> времени между двумя экспериментами затруднил сравнение результатов.",
                                "zh": "两次实验之间<w>间隔</w>的时间太长，导致结果难以比较。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interval",
                        "gap",
                        "interim",
                        "passage"
                    ],
                    "common_phrases": [
                        "lapse of time",
                        "lapse of years"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период или промежуток времени, проходящий между двумя событиями.",
                        "zh": "指两个事件之间经过的一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "интервал времени"
                            },
                            {
                                "target_lang_word": "истечение",
                                "target_lang_sense_clarification": "прохождение определенного срока"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间隔",
                                "target_lang_sense_clarification": "时间上的空隙"
                            },
                            {
                                "target_lang_word": "期间",
                                "target_lang_sense_clarification": "一段时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2defa61-df6e-32ce-8507-92af4e787919",
                    "sense_definition": "A decline or fall from a previously higher standard or state.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic noted a disappointing <w>lapse</w> into mediocrity in the director's latest film.",
                            "target_lang_translations": {
                                "ru": "Критик отметил разочаровывающее <w>скатывание</w> к посредственности в последнем фильме режиссера.",
                                "zh": "评论家指出，这位导演的最新作品令人失望地<w>退步</w>到了平庸的水平。"
                            }
                        },
                        {
                            "text": "The team's recent performance represents a serious <w>lapse</w> from their usual high standards.",
                            "target_lang_translations": {
                                "ru": "Последнее выступление команды представляет собой серьезное <w>отступление</w> от их обычных высоких стандартов.",
                                "zh": "该团队近期的表现与他们一贯的高标准相比，出现了严重的<w>倒退</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "deterioration",
                        "descent"
                    ],
                    "antonyms": [
                        "improvement",
                        "ascent"
                    ],
                    "common_phrases": [
                        "lapse into barbarity",
                        "lapse from standards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение или падение с ранее достигнутого высокого стандарта или состояния.",
                        "zh": "指从之前较高的标准或状态中衰退或下降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "снижение уровня или качества"
                            },
                            {
                                "target_lang_word": "отступление",
                                "target_lang_sense_clarification": "отход от принятых норм или стандартов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "退步",
                                "target_lang_sense_clarification": "水平或质量的下降"
                            },
                            {
                                "target_lang_word": "倒退",
                                "target_lang_sense_clarification": "偏离了原有的高标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cbf6d5f-a1d3-34a9-9e10-50b14d2572e2",
                    "sense_definition": "A temporary pause or interruption in the continuity of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a short <w>lapse</w> in the conversation while everyone waited for the host to speak.",
                            "target_lang_translations": {
                                "ru": "В разговоре возникла небольшая <w>пауза</w>, пока все ждали, когда заговорит хозяин.",
                                "zh": "大家都在等主人发言，谈话中出现了一阵短暂的<w>停顿</w>。"
                            }
                        },
                        {
                            "text": "The radio station experienced a brief <w>lapse</w> in transmission due to the heavy storm.",
                            "target_lang_translations": {
                                "ru": "На радиостанции произошел кратковременный <w>перерыв</w> в вещании из-за сильного шторма.",
                                "zh": "受暴风雨影响，电台的信号传输出现了短暂的<w>中断</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hiatus",
                        "pause",
                        "gap",
                        "interruption",
                        "break"
                    ],
                    "antonyms": [
                        "continuity",
                        "progression"
                    ],
                    "common_phrases": [
                        "lapse in continuity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная пауза или прерывание непрерывности чего-либо.",
                        "zh": "指事物连续性中的暂时停顿或中断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "пауза в процессе"
                            },
                            {
                                "target_lang_word": "заминка",
                                "target_lang_sense_clarification": "кратковременная остановка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停顿",
                                "target_lang_sense_clarification": "过程中的短暂停止"
                            },
                            {
                                "target_lang_word": "中断",
                                "target_lang_sense_clarification": "连续状态的断开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5a4eeb7-8816-3a2f-82e1-41a7aaf6ee93",
                    "sense_definition": "The termination of a right, privilege, or agreement because it was not used or renewed within a set time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lapse</w> of his insurance policy meant he was no longer covered for the accident.",
                            "target_lang_translations": {
                                "ru": "<w>Прекращение действия</w> его страхового полиса означало, что он больше не застрахован на случай аварии.",
                                "zh": "他的保险单<w>失效</w>，意味着他不再享有事故赔付。"
                            }
                        },
                        {
                            "text": "Failure to pay the annual fee resulted in the <w>lapse</w> of her membership rights.",
                            "target_lang_translations": {
                                "ru": "Неуплата ежегодного взноса привела к <w>утрате</w> её членских прав.",
                                "zh": "未缴纳年费导致她的会员权利<w>失效</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expiration",
                        "termination",
                        "expiry"
                    ],
                    "antonyms": [
                        "renewal",
                        "continuation"
                    ],
                    "common_phrases": [
                        "lapse of a right",
                        "policy lapse"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or formal administrative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращение действия права, привилегии или соглашения из-за неиспользования или непродления в срок.",
                        "zh": "指因未在规定时间内使用或续期而导致权利、特权或协议失效。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращение",
                                "target_lang_sense_clarification": "утрата силы из-за истечения срока"
                            },
                            {
                                "target_lang_word": "аннулирование",
                                "target_lang_sense_clarification": "потеря юридической силы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失效",
                                "target_lang_sense_clarification": "失去法律效力"
                            },
                            {
                                "target_lang_word": "过期",
                                "target_lang_sense_clarification": "超过了有效期限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9186b838-fcd1-3722-8c32-90c8afce8d71",
                    "sense_definition": "A decrease in air temperature that occurs as altitude increases.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meteorologists study the environmental <w>lapse</w> rate to predict cloud formation and weather patterns.",
                            "target_lang_translations": {
                                "ru": "Метеорологи изучают <w>градиент</w> падения температуры окружающей среды, чтобы предсказать образование облаков и погодные условия.",
                                "zh": "气象学家研究环境气温<w>递减率</w>，以预测云层的形成和天气模式。"
                            }
                        },
                        {
                            "text": "The steep <w>lapse</w> in temperature at high altitudes makes climbing the mountain very dangerous.",
                            "target_lang_translations": {
                                "ru": "Резкое <w>падение</w> температуры на больших высотах делает восхождение на гору очень опасным.",
                                "zh": "高海拔地区气温的剧烈<w>下降</w>使得登山变得非常危险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapse rate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific and technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение температуры воздуха, происходящее при увеличении высоты.",
                        "zh": "指随海拔升高而产生的气温下降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "градиент температуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "递减率",
                                "target_lang_sense_clarification": "气温随高度变化的速率"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0d1751f-4f9d-3293-9cdc-b537e5a275cf",
                    "sense_definition": "To return to a bad habit or a lower standard after a period of improvement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "revert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is very easy to <w>lapse</w> into old habits when you are feeling stressed at work.",
                            "target_lang_translations": {
                                "ru": "Очень легко <w>скатиться</w> к старым привычкам, когда вы испытываете стресс на работе.",
                                "zh": "当你在工作中感到压力时，很容易又<w>重蹈覆辙</w>，回到旧习惯中。"
                            }
                        },
                        {
                            "text": "After months of healthy eating, he began to <w>lapse</w> into his former diet of junk food.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев здорового питания он начал <w>возвращаться</w> к своему прежнему рациону из вредной еды.",
                                "zh": "在坚持了几个月的健康饮食后，他又开始<w>退回</w>到以前吃垃圾食品的习惯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revert",
                        "relapse",
                        "backslide"
                    ],
                    "antonyms": [
                        "improve",
                        "progress"
                    ],
                    "common_phrases": [
                        "lapse into habits",
                        "lapse into silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение к вредной привычке или более низкому стандарту после периода улучшения.",
                        "zh": "指在一段时间的改善后，又回到了坏习惯或较低的标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скатываться",
                                "target_lang_sense_clarification": "возвращаться к старым привычкам"
                            },
                            {
                                "target_lang_word": "впадать",
                                "target_lang_sense_clarification": "переходить в нежелательное состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重蹈覆辙",
                                "target_lang_sense_clarification": "再次陷入旧有的坏习惯"
                            },
                            {
                                "target_lang_word": "退回",
                                "target_lang_sense_clarification": "回到之前的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f8d523b-0bbc-32e4-aa54-dd3460d76f70",
                    "sense_definition": "To become invalid or expire because of a failure to take necessary action or the passage of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not renew your subscription by Friday, your access to the service will <w>lapse</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы не продлите подписку до пятницы, ваш доступ к сервису <w>аннулируется</w>.",
                                "zh": "如果你不在周五前续订，你的服务权限将会<w>失效</w>。"
                            }
                        },
                        {
                            "text": "The offer was only valid for thirty days and has now <w>lapsed</w>.",
                            "target_lang_translations": {
                                "ru": "Предложение было действительно только в течение тридцати дней и теперь <w>истекло</w>.",
                                "zh": "该优惠仅有效期三十天，现已<w>过期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expire",
                        "terminate",
                        "end"
                    ],
                    "antonyms": [
                        "renew",
                        "continue"
                    ],
                    "common_phrases": [
                        "allow to lapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать недействительным или истечь из-за невыполнения необходимых действий или истечения времени.",
                        "zh": "指因未采取必要行动或时间流逝而变得无效或过期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о сроке действия"
                            },
                            {
                                "target_lang_word": "утрачивать силу",
                                "target_lang_sense_clarification": "становиться недействительным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失效",
                                "target_lang_sense_clarification": "不再具有效力"
                            },
                            {
                                "target_lang_word": "过期",
                                "target_lang_sense_clarification": "超过有效期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3312f1c7-ec92-36fb-89db-7ea8d27e235d",
                    "sense_definition": "To pass gradually into a different, usually worse, state or condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "transition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient would occasionally <w>lapse</w> into unconsciousness during the long surgery.",
                            "target_lang_translations": {
                                "ru": "Во время длительной операции пациент время от времени <w>впадал</w> в беспамятство.",
                                "zh": "在漫长的手术过程中，病人偶尔会<w>陷入</w>昏迷。"
                            }
                        },
                        {
                            "text": "Without regular maintenance, the historic building will slowly <w>lapse</w> into a state of decay.",
                            "target_lang_translations": {
                                "ru": "Без регулярного ухода историческое здание будет медленно <w>приходить</w> в упадок.",
                                "zh": "如果没有定期维护，这座历史建筑将慢慢<w>沦为</w>破败不堪的状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sink",
                        "slide",
                        "drift"
                    ],
                    "common_phrases": [
                        "lapse into unconsciousness",
                        "lapse into decay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенный переход в другое, обычно худшее, состояние или условие.",
                        "zh": "指逐渐陷入另一种通常更糟糕的状态或境地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впадать",
                                "target_lang_sense_clarification": "погружаться в какое-либо состояние"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "постепенно переходить в худшее состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷入",
                                "target_lang_sense_clarification": "进入某种不好的状态"
                            },
                            {
                                "target_lang_word": "沦为",
                                "target_lang_sense_clarification": "逐渐变成某种糟糕的境地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}