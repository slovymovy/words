                ],
                "senses": [
                    {
                        "sense_id": "8c4a6958-54fc-3cc6-9eab-789ca24f0d8b",
                        "entry_id": "51e1b612-81e0-3b1d-9bfb-d492ab2658fd",
                        "glosses": [
                            "осторожно раскачивая, помогать успокоиться или заснуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be332a7a-6bd7-4c01-b645-d83bd7376abb",
                                "sense_id": "8c4a6958-54fc-3cc6-9eab-789ca24f0d8b",
                                "text": "Хата Тараса битком набилась женщинами, пришедшими давать Аксинье советы, как обращаться с младенцем, как и чем его кормить и как его укачивать."
                            },
                            {
                                "example_id": "78b457f3-64a5-4bde-896f-e1744d00e141",
                                "sense_id": "8c4a6958-54fc-3cc6-9eab-789ca24f0d8b",
                                "text": "Ребёнок кричал ещё громче, закатываясь и хрипя. Няня, махнув рукой, подошла к нему, взяла его с рук кормилицы и принялась укачивать на ходу."
                            }
                        ]
                    },
                    {
                        "sense_id": "d67e7afc-3013-35e4-9a9b-fea0554dc40e",
                        "entry_id": "51e1b612-81e0-3b1d-9bfb-d492ab2658fd",
                        "glosses": [
                            "безл. клонить ко сну вследствие испытываемой качки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504638b3-2e17-49ad-9c12-631d9b41947b",
                                "sense_id": "d67e7afc-3013-35e4-9a9b-fea0554dc40e",
                                "text": "В полупустом автобусе Гришку начало укачивать. Он позёвывал, клевал носом, но уснуть никак не мог — слишком разошлись нервы."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3158a72-65db-336c-a0d4-d1ef53cd4d95",
                        "entry_id": "51e1b612-81e0-3b1d-9bfb-d492ab2658fd",
                        "glosses": [
                            "безл. испытывать тошноту, неприятные ощущения вследствие качки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f282ad8-aa23-4922-a717-2eb7af086882",
                                "sense_id": "f3158a72-65db-336c-a0d4-d1ef53cd4d95",
                                "text": "Килевая качка несносная, для меня, впрочем, она лучше боковой, не толкает из угла в угол, но, кого укачивает, тем невыносимо."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4a943a3-0182-42bd-bfa2-b3f8c79f56b1",
                        "source_entry_id": "51e1b612-81e0-3b1d-9bfb-d492ab2658fd",
                        "target_lang_word": "bercer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bercer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7edcff4-3514-31b4-95d9-605f868da0df",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Balancer avec douceur, afin d'apaiser ou d'endormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9de95b33-3a10-4d47-95a5-040fdd6804f3",
                                                "sense_id": "f7edcff4-3514-31b4-95d9-605f868da0df",
                                                "text": "Bercer dans ses bras, sur ses genoux."
                                            },
                                            {
                                                "example_id": "a27b1fbd-4f43-443d-9154-1c03ace43328",
                                                "sense_id": "f7edcff4-3514-31b4-95d9-605f868da0df",
                                                "text": "Il y avait, sur une étoile, une planète, la mienne, la Terre, un petit prince à consoler! Je le pris dans les bras. Je le berçai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f647eb5-2f41-34fb-b786-677f3d3c88bd",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Balancer dans un berceau."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900aadc3-2faa-4b00-a6c5-3e5ce517a9f7",
                                                "sense_id": "5f647eb5-2f41-34fb-b786-677f3d3c88bd",
                                                "text": "Le lendemain matin, elle berçait son bébé dans la cour lorsqu’un ancien domestique de son grand-père vint la chercher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1328123-0fcc-3c3e-a512-ce92395789b0",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Par analogie, imprégner de manière répétée et agréable, en général dès l’enfance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede585ef-f72c-4f7f-8179-4106ef7a99e8",
                                                "sense_id": "d1328123-0fcc-3c3e-a512-ce92395789b0",
                                                "text": "Chaque fois que ma pensée se reporte aux souvenirs de cette province du Valois, je me rappelle avec ravissement les chants et les récits qui ont bercé mon enfance."
                                            },
                                            {
                                                "example_id": "822e4bc2-3268-432d-aa42-fd7a86f724f5",
                                                "sense_id": "d1328123-0fcc-3c3e-a512-ce92395789b0",
                                                "text": "J’ai moi-même gardé longtemps une sensation d’inquiétude générale […]. Elle a eu pour origine le résidu, gisant dans le tréfonds de mon être, des conversations dont ma jeunesse fut bercée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "951f4f75-3637-3c9e-8100-8a2dfbe7fa37",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Amuser d’espérances fausses ou éloignées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98e8d0e-2a45-4ba1-b640-9641fab86464",
                                                "sense_id": "951f4f75-3637-3c9e-8100-8a2dfbe7fa37",
                                                "text": "Il y a longtemps que vous me bercez de cette assurance."
                                            },
                                            {
                                                "example_id": "6499eec4-a65d-4983-959d-3f21f7c7a207",
                                                "sense_id": "951f4f75-3637-3c9e-8100-8a2dfbe7fa37",
                                                "text": "On les berçait d’un espoir qu’on ne pouvait réaliser."
                                            },
                                            {
                                                "example_id": "a6581ed9-44c2-42bf-b1db-9eebcf0e98f4",
                                                "sense_id": "951f4f75-3637-3c9e-8100-8a2dfbe7fa37",
                                                "text": "Bercer quelqu’un de vaines promesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e835757f-46f1-3024-a6fb-fea8efec387c",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Entretenir des espérances frivoles, des idées chimériques."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7710e324-0f99-40f6-bef7-f6e75f1c00ca",
                                                "sense_id": "e835757f-46f1-3024-a6fb-fea8efec387c",
                                                "text": "Je me berce de l'idée que je mourrai réconcilié du moins avec le passé. — (George Sand, Lettres d'un voyageur (1837).)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d422b011-135d-3adf-a73d-5645bf322757",
                                        "entry_id": "3a28bd48-57e6-31a1-9a88-3e6a9a1117c5",
                                        "glosses": [
                                            "Utiliser l'outil appelé berceau pour préparer la plaque de métal à graver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
