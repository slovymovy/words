                        "entry_id": "37bb1b8b-7649-354f-a4c2-b5c7a1a64a15",
                        "glosses": [
                            "Buste de l’allégorie de la République française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13426fc5-61e9-4106-ba94-df450f4b4932",
                                "sense_id": "75896f6d-f1d6-34af-aeae-da1e90b9ef17",
                                "text": "Sur les marches d’entrée s’était brisée la Marianne de plâtre dont le buste devait se trouver dans la niche au-dessus de la porte."
                            }
                        ]
                    },
                    {
                        "sense_id": "af4f9f0f-11ae-38b2-b370-20ea2801ba05",
                        "entry_id": "37bb1b8b-7649-354f-a4c2-b5c7a1a64a15",
                        "glosses": [
