                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бергамот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "36076358-77da-3dbe-9b12-dc6423381469",
                                        "entry_id": "fe2ddb7d-9337-30a5-a14a-117bcd7895ff",
                                        "glosses": [
                                            "сорт груши с ароматными винно-сладкими плодами овальной формы"
                                        ],
                                        "tags": [],
