                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f74df6-6673-4b0f-aad3-47a0359b5517",
                                "sense_id": "f5e3fb99-35a8-3660-84c8-f684b3d78fda",
                                "text": "Tijdens de gymles stonden de kinderen in rangorde van hun lengte, de kortste kinderen vooraan de langste kinderen achteraan."
                            },
                            {
                                "example_id": "0f1b7fb0-8a5f-408d-be3a-27e074c0e2e6",
                                "sense_id": "f5e3fb99-35a8-3660-84c8-f684b3d78fda",
                                "text": "De landen staan in rangorde vermeld naar de bevolkingsgrootte, de grootste landen staan bovenaan."
                            }
                        ]
                    }
