                                "target_senses": [
                                    {
                                        "sense_id": "73ec4cc5-3e95-334d-88d8-4ec24db27080",
                                        "entry_id": "61a6e3f8-e153-3287-861f-9fecd446c7f6",
                                        "glosses": [
                                            "跑路，逃亡"
                                        ],
                                        "tags": [
                                            "Cantonese",
                                            "Min-Nan",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b63d2ba-5cdd-439e-8c77-8dea13c069ee",
                                                "sense_id": "73ec4cc5-3e95-334d-88d8-4ec24db27080",
                                                "text": "佢有一日嚟話、佢掌櫃虧空佢一千銀、個千銀佢係特登留翻嚟還一條債、個掌櫃走路去、揾佢唔到。",
                                                "translation": "有一天他來了，說他的會計挪用了一千元，他把這筆錢用來還債，這個會計跑路了，找不到他。"
                                            },
                                            {
                                                "example_id": "d6f69f7b-5b62-45c1-9f53-355462cfb735",
                                                "sense_id": "73ec4cc5-3e95-334d-88d8-4ec24db27080",
                                                "text": "佢有一日嚟话、佢掌柜亏空佢一千银、个千银佢系特登留翻嚟还一条债、个掌柜走路去、揾佢唔到。",
                                                "translation": "有一天他來了，說他的會計挪用了一千元，他把這筆錢用來還債，這個會計跑路了，找不到他。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
