            "senses": [
                {
                    "sense_id": "5d1b939e-e988-3e0b-ad25-7d5de3ff362b",
                    "sense_definition": "Qui est approprié ou qui convient bien à une situation ou à un usage déterminé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "approprié",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons trouver un lieu <w>convenable</w> pour organiser cette grande fête de famille.",
                            "target_lang_translations": {
                                "en": "We need to find a <w>suitable</w> place to hold this big family celebration.",
                                "ru": "Нам нужно найти <w>подходящее</w> место для проведения этого большого семейного праздника.",
                                "de": "Wir müssen einen <w>geeigneten</w> Ort finden, um diese große Familienfeier auszurichten.",
                                "es": "Debemos encontrar un lugar <w>adecuado</w> para organizar esta gran fiesta familiar.",
                                "zh": "我们必须找一个<w>合适</w>的地方来举办这场大型家庭聚会。"
                            }
                        },
                        {
                            "text": "Ce salarié cherche un logement <w>convenable</w> près de son nouveau bureau en centre-ville.",
                            "target_lang_translations": {
                                "en": "This employee is looking for <w>suitable</w> accommodation near his new office in the city centre.",
                                "ru": "Этот сотрудник ищет <w>подходящее</w> жильё рядом с новым офисом в центре города.",
                                "de": "Dieser Angestellte sucht eine <w>passende</w> Wohnung in der Nähe seines neuen Büros in der Innenstadt.",
                                "es": "Este empleado busca una vivienda <w>adecuada</w> cerca de su nueva oficina en el centro de la ciudad.",
                                "zh": "这名员工想在市中心的新办公室附近找一处<w>合适</w>的住所。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adéquat",
                        "approprié",
                        "adapté"
                    ],
                    "common_phrases": [
                        "logement convenable",
                        "moment convenable"
                    ],
                    "target_lang_definitions": {
