                "senses": [
                    {
                        "sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                        "entry_id": "4912f112-64a5-39e5-babf-8a70a2d2337c",
                        "glosses": [
                            "äußerste Grenze meist terminlicher Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc74f335-f1c8-4cef-b9db-f471e61c8f23",
                                "sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                                "text": "Der Autor muss das Kapitel unbedingt vor Ablauf der Deadline fertiggestellt haben."
                            },
                            {
                                "example_id": "ac500182-37d6-48e0-917f-adabf218b662",
                                "sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                                "text": "„Mit einundzwanzig beginnt für sie das Problemalter, und fünfundzwanzig gilt als Deadline für Hochzeit und das erste Kind.“"
                            },
                            {
                                "example_id": "1ba62c06-2b52-4991-9d08-0c29644abd1d",
                                "sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                                "text": "„Ich habe gerade einen Brief an meinen deutschen Agenten geschrieben und ihn gefragt, ob es möglich wäre, die Deadline für den ersten Entwurf dieses Buches bis Montag zu verlängern.“"
                            },
                            {
                                "example_id": "b471ca86-d859-4187-8174-202e935b2fbe",
                                "sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                                "text": "„Bis heute erscheint alle sechs Monate eine neue Version. Nur einmal in seiner Geschichte verpasste Ubuntu die selbst auferlegte Deadline, im Jahr 2006, als die Version 6.06 Dapper Drake herauskam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ff7ba31-9cb9-4841-9a0f-48937e3d5f97",
                        "source_entry_id": "4912f112-64a5-39e5-babf-8a70a2d2337c",
                        "source_sense_id": "346f4904-aa46-32bb-a64a-455082ade345",
                        "source_sense_description": "äußerste Grenze meist terminlicher Art",
                        "target_lang_word": "deadline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deadline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a88fa8bf-248a-322f-9305-337e2a9a332f",
                                        "entry_id": "11ffbf76-f713-36c7-91d8-0e3281a9d9d8",
                                        "glosses": [
                                            "A time limit in the form of a date on or before which something must be completed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0979ef-7514-45a2-bf9b-29dd2e8183e7",
                                                "sense_id": "a88fa8bf-248a-322f-9305-337e2a9a332f",
                                                "text": "I must make this deadline or my boss will kill me!"
                                            },
                                            {
                                                "example_id": "1d041bed-a212-4cb5-b588-26fe63a1168e",
                                                "sense_id": "a88fa8bf-248a-322f-9305-337e2a9a332f",
                                                "text": "TfW's [Transport for Wales] plans to meet the PRM [Persons with Reduced Mobility] deadline and withdraw all Pacers by 1 January have been made more difficult by delays to introduction of Class 769 and 230 units."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea90aa5e-4d5a-3a6d-b454-44ee4779ccea",
                                        "entry_id": "11ffbf76-f713-36c7-91d8-0e3281a9d9d8",
                                        "glosses": [
                                            "A guideline marked on a plate for a printing press."
