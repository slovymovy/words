                        "examples": [
                            {
                                "example_id": "0a7683c2-37f5-4132-a6bc-a5c07830849e",
                                "sense_id": "d0d6092e-b8bb-3420-b837-28cb31c609ba",
                                "text": "„Dadurch wuchs die Zahl der Homelands mit der Inkorporation nicht an, sondern sie nahm sogar ab, da drei ethnische Gruppen von den Protektoraten absorbiert werden sollten, so dass die Zahl der aus Südafrika auszugliedernden Homelands auf sieben reduziert werden konnte: Transkei, Ciskei, Kwa-Zulu, Venda, Lebowa, Gazankulu und (seit 1975) KwaNdebele.“"
                            }
                        ],
