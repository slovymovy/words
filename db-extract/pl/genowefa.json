                ],
                "senses": [
                    {
                        "sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cdff98-3a70-4d9b-88ac-e03561aa7674",
                                "sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                                "text": "Siwa, szczupła pani, która na długotrwałe dzwonienie otworzyła wreszcie drzwi, przez chwilę wyglądała, jakby musiała się przyzwyczaić do widoku Genowefy. – Przyszłam na obiadek – powtórzyła Genowefa niepewnie. Siwa pani uśmiechnęła się do niej. – Dobrze trafiłaś. Dziś pierogi. – Z czym? – poinformowała się Genowefa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bba4ffbe-b914-4531-a0d3-aa9dfcd82877",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Genevieve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genevieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                                        "entry_id": "635f5f6d-1bce-33c4-9534-a6fe8e8ed9a1",
                                        "glosses": [
                                            "A female given name from French."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65da1f8-fff1-48f4-969a-16d35a18fede",
                                                "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                                                "text": "Her name was Genevieve. A classy name and she was a classy woman or had been, not long ago;"
                                            },
                                            {
                                                "example_id": "a02f58a5-b9ce-418f-8610-e8b95c507735",
                                                "sense_id": "c906e3ae-3f6c-3b0e-9dab-f249c5eb5eaa",
                                                "text": "But I like it when Stella calls me Genevieve, because though I'm Jenny to everyone else, always have been since I was born, I was christened Genevieve. My dad called me after a vintage car in a film, if you can credit it, and to most people it's a bit embarrassing, but the way Stella says it it's got a pretty sound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9285ae-331f-4538-8c0c-33f7c073a09a",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Jenovefa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2586804f-c63a-47e4-b433-8a54a81a6a60",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Jenovéfa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e09f771a-c6ec-4a83-9413-3173a64622c5",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Genovefa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f8868178-0c9d-4980-a4ab-0d4315051672",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Geneviève",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geneviève",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                        "entry_id": "e54ce096-3a33-35ef-8a57-0a77db9effbf",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6aaaa7f-b181-48f0-8363-acc2ac44d85b",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Elle s’appelait Geneviève. Elle appartenait à une des dix meilleures familles de la ville."
                                            },
                                            {
                                                "example_id": "9cee862f-35c9-4a93-82f5-ee0734d8d8b5",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Zaza me conduisit dans la chambre que je devais partager avec elle et Geneviève de Bréville, une petite jeune fille fraîche et sage dont Mme Mabille raffolait."
                                            },
                                            {
                                                "example_id": "ec7938a5-43fc-4fea-bed6-fd1d6bebdcea",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Telle une déesse lors du banquet des dieux, gambas et txakoli en guise de nectar et ambroisie, Geneviève me rejoignit pour que je trouve moins long le temps de risotter."
                                            },
                                            {
                                                "example_id": "74b712a1-3a63-4504-b95e-b3b428e02dd9",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Fondée en 1988 par Henriette Joël, qui en fut la première présidente, et aujourd’hui présidée par Geneviève Escoffier, l’association des Amis du Musée de Saint-Cloud s’est donné pour objet d’aider le musée à enrichir ses collections (acquisitions d’œuvres) et à développer ses actions et son rayonnement auprès du public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cbf0582-50a7-4e89-a518-11a924fe5a1a",
                        "source_entry_id": "68d6708e-0810-3b0e-8bb4-2a8741e33af2",
                        "source_sense_id": "9207e601-4e1d-33a5-a696-aa1f496b7c88",
                        "target_lang_word": "Ginette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ginette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ece9093e-b2f1-3ea4-ae3c-e759e2762c56",
                                        "entry_id": "ec31aedc-3b01-354d-bc7e-d4891067dc50",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd4fcc4-f035-4580-b232-195eed4a027b",
                                                "sense_id": "ece9093e-b2f1-3ea4-ae3c-e759e2762c56",
                                                "text": "Ginette, Ginette,\n t'as mis de la brume dans mes lunettes.\n T'as fait de moi un animal, Ginette.\n Fais-moi sauter dans ton cerceau."
                                            },
                                            {
                                                "example_id": "37bf587e-d272-4704-a25e-15b1e47dcd23",
                                                "sense_id": "ece9093e-b2f1-3ea4-ae3c-e759e2762c56",
                                                "text": "Le visage de Ginette se constipa à nouveau."
                                            },
                                            {
                                                "example_id": "e87afb45-4fe8-4f18-b4d4-f181e70c4ea1",
                                                "sense_id": "ece9093e-b2f1-3ea4-ae3c-e759e2762c56",
                                                "text": "Je devinais, en dessous, invisible, le traître mont Redonta sur lequel le Constellation d’Air France s’était écrasé quelques années auparavant, avec à son bord le champion de boxe Marcel Cerdan et la violoniste Ginette Neveu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
