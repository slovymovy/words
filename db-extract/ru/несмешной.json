                "senses": [
                    {
                        "sense_id": "48b02ed1-bc89-337f-919d-edfd060bb2c5",
                        "entry_id": "8930f040-e612-36ca-994c-a988db29126a",
                        "glosses": [
                            "не вызывающий смеха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e764a86d-52e9-41c1-aa6c-af3d9378c03e",
                                "sense_id": "48b02ed1-bc89-337f-919d-edfd060bb2c5",
                                "text": "«Сделайте милость (просил его Гоголь в октябре 1835 года), дайте какой-нибудь сюжет, хоть какой-нибудь смешной или несмешной, но русский чисто анекдот.»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a363eafb-bc1b-48a7-afc1-a57df0b9d1d3",
                        "source_entry_id": "8930f040-e612-36ca-994c-a988db29126a",
                        "source_sense_id": "48b02ed1-bc89-337f-919d-edfd060bb2c5",
                        "target_lang_word": "unfunny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                                        "entry_id": "5c8e2cd7-e901-36da-a15a-dc0fbb267097",
                                        "glosses": [
                                            "Not funny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c4dffa-8271-44f6-ae14-ff3a44058b67",
                                                "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                                                "text": "Edward told an unfunny knock-knock joke that made his brother groan."
                                            },
                                            {
                                                "example_id": "9f60350e-6b3f-4b46-bbec-373df5d62c17",
                                                "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                                                "text": "The decline of mobility, reason fading in and out like short-wave radio, the trickle of minor ailments that fed a deeper river—the subject was vast and not all of it was unfunny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dbf409c-ffcb-4339-bcb7-8d6b1bf20e1c",
                        "source_entry_id": "8930f040-e612-36ca-994c-a988db29126a",
                        "source_sense_id": "48b02ed1-bc89-337f-919d-edfd060bb2c5",
                        "target_lang_word": "flauw",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flauw",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6178d481-f73a-37d6-b669-aa5d660a210f",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "zonder smaak, meestal door een gebrek aan zout"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ebb491b-2bed-4482-8431-027809c2d17d",
                                                "sense_id": "6178d481-f73a-37d6-b669-aa5d660a210f",
                                                "text": "Deze flauwe hap kan wel wat zout gebruiken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a425b45-4ff0-352b-b857-08d72dae8e61",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "in overdrachtelijke zin smakeloos"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12324ef3-d3c1-439a-ba39-5c0643125bff",
                                                "sense_id": "2a425b45-4ff0-352b-b857-08d72dae8e61",
                                                "text": "Hij haalt soms de flauwste grappen uit."
                                            },
                                            {
                                                "example_id": "1b1a31fb-3781-48d6-9e56-ddb2c962eb30",
                                                "sense_id": "2a425b45-4ff0-352b-b857-08d72dae8e61",
                                                "text": "' 'Wat zeg je?' 'Ik was dronken en maakte een flauw grapje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c02039-d9e3-367a-807b-1c075c6d6ab1",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "weinig enthousiast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8e613d-3bc6-45d8-940e-ad9c82650f05",
                                                "sense_id": "a5c02039-d9e3-367a-807b-1c075c6d6ab1",
                                                "text": "Met een flauw lachje zei ze: 'Ik hoop voor u dat het het eerste is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "zwak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533c60e4-ec6a-4ddc-8fb7-9e75b0f9a0c4",
                                                "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                                "text": "Ze vond het een flauw verweer."
                                            },
                                            {
                                                "example_id": "4f5f4060-51c7-4df3-a5f7-9edd41d50290",
                                                "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                                "text": "Ik wilde die duisternis niet in, ook al ging er een flauw licht aan op het plankier als je er iets verder op liep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "slap zonder kracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b0692e-836a-4e79-bfd2-c2b312aa0530",
                                                "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                                "text": "Wij waren die ochtend helemaal flauw van de honger en dorst, er was geen brood meer en bijna geen water."
                                            },
                                            {
                                                "example_id": "f9bd2787-80a6-470e-bbb5-f40ff36b46d1",
                                                "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                                "text": "De pa van Milan ging net zo lang door tot zijn zoon flauw was gevallen en slap aan het touw hing en zijn rug droop van het bloed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
