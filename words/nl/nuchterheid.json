{
    "word_family": [
        "nuchter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30421715-76ea-3d36-833d-4ced49a63ea7",
                    "sense_definition": "de toestand van geen alcohol of verdovende middelen te hebben gebruikt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lichamelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie controleerde de <w>nuchterheid</w> van de automobilist met een blaastest.",
                            "target_lang_translations": {
                                "pl": "Policja skontrolowała <w>trzeźwość</w> kierowcy za pomocą alkomatu."
                            }
                        },
                        {
                            "text": "Na een lange nacht feesten was zijn <w>nuchterheid</w> ver te zoeken.",
                            "target_lang_translations": {
                                "pl": "Po długiej nocy imprezowania o jego <w>trzeźwości</w> nie mogło być mowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "soberheid"
                    ],
                    "antonyms": [
                        "dronkenschap"
                    ],
                    "target_lang_definitions": {
                        "pl": "stan niespożywania alkoholu ani innych środków odurzających"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trzeźwość",
                                "target_lang_sense_clarification": "brak alkoholu lub narkotyków we krwi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "781c23ba-f100-3d9e-b4b7-2d19510b0ec1",
                    "sense_definition": "de eigenschap om kalm, praktisch en zakelijk te blijven zonder zich te laten meeslepen door emoties",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geestelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dankzij haar typische <w>nuchterheid</w> raakte ze tijdens de crisis nooit in paniek.",
                            "target_lang_translations": {
                                "pl": "Dzięki swojemu typowemu <w>opanowaniu</w> nigdy nie wpadała w panikę podczas kryzysu."
                            }
                        },
                        {
                            "text": "Hij benaderde het ingewikkelde probleem met grote <w>nuchterheid</w> en vond snel een oplossing.",
                            "target_lang_translations": {
                                "pl": "Podszedł do skomplikowanego problemu z wielką <w>trzeźwością umysłu</w> i szybko znalazł rozwiązanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedaardheid",
                        "zakelijkheid"
                    ],
                    "target_lang_definitions": {
                        "pl": "cecha polegająca na zachowywaniu spokoju, rzeczowości i pragmatyzmu bez ulegania emocjom"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trzeźwość umysłu",
                                "target_lang_sense_clarification": "opanowanie i rozsądne podejście"
                            },
                            {
                                "target_lang_word": "pragmatyzm",
                                "target_lang_sense_clarification": "praktyczne i rzeczowe podejście"
                            },
                            {
                                "target_lang_word": "opanowanie",
                                "target_lang_sense_clarification": "spokój emocjonalny"
                            },
                            {
                                "target_lang_word": "rzeczowość",
                                "target_lang_sense_clarification": "konkretne i bezemocjonalne podejście"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "993db257-0aaf-3c89-8088-ff55de987aad",
                    "sense_definition": "de toestand waarin men nog niets gegeten of gedronken heeft sinds het slapen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichamelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor het geplande bloedonderzoek is volledige <w>nuchterheid</w. van de patiënt vereist.",
                            "target_lang_translations": {
                                "pl": "Do planowanego badania krwi wymagane jest <w>bycie pacjenta całkowicie na czczo</w>."
                            }
                        },
                        {
                            "text": "De verpleegkundige vroeg of de <w>nuchterheid</w> vanochtend strikt was nageleefd.",
                            "target_lang_translations": {
                                "pl": "Pielęgniarka zapytała, czy dziś rano ściśle przestrzegano <w>pozostawania na czczo</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "stan powstrzymywania się od jedzenia i picia, bycie na czczo"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bycie na czczo",
                                "target_lang_sense_clarification": "stan przed spożyciem posiłku"
                            },
                            {
                                "target_lang_word": "pozostawanie na czczo",
                                "target_lang_sense_clarification": "wymóg medyczny niespożywania posiłków"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}