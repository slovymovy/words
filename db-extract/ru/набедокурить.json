                "senses": [
                    {
                        "sense_id": "2b5e58c9-d6af-30cc-891e-c41a3a35876e",
                        "entry_id": "00bb8013-f05b-31eb-a4ed-9e3ee3a82e21",
                        "glosses": [
                            "разг. наделать бед; напроказничать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e8528e-f4e3-47a4-84ae-0be879ed0ba7",
                                "sense_id": "2b5e58c9-d6af-30cc-891e-c41a3a35876e",
                                "text": "― Сумел набедокурить ― сумей и ответить за свои грехи."
                            },
                            {
                                "example_id": "4b0866ca-0123-4a60-9852-c2dd62b258cc",
                                "sense_id": "2b5e58c9-d6af-30cc-891e-c41a3a35876e",
                                "text": "Были конечно и такие, которые стремились погулять с девчонкой, набедокурить и бросить ― но этих ребят мы не уважали."
                            }
                        ]
                    }
                ],
