                        "examples": [
                            {
                                "example_id": "19b425c5-3c39-4079-8baa-371a811f44e8",
                                "sense_id": "cf85d769-708d-3ec7-a946-e8af2f59894c",
                                "text": "Но, впрочем, его вы скоро самолично увидите〈…〉"
                            },
                            {
                                "example_id": "25d928d2-b035-4036-9775-c6f128b5e840",
                                "sense_id": "cf85d769-708d-3ec7-a946-e8af2f59894c",
                                "text": "― Да, да, он прав, ― останавливает ритора Гейне, ― это я велел ему самолично явиться перед лицо синьоры…"
                            },
                            {
                                "example_id": "37e92db8-9507-4ed0-b41e-da3229593230",
                                "sense_id": "cf85d769-708d-3ec7-a946-e8af2f59894c",
                                "text": "Строгий приказ: ни одного патрона зря не расходовать. Первого же, кто ослушается, зарублю самолично. Так и передайте бойцам."
                            }
                        ]
                    }
