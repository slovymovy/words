                "senses": [
                    {
                        "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                        "entry_id": "92d4c046-a01a-33d0-9eaf-4207a37d8023",
                        "glosses": [
                            "subjektives Empfinden, das beim Laufen wahrgenommen wird"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "fcb14199-e223-40db-90a6-6dfb7a235259",
                                "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                                "text": "„Diese Schuhe ermöglichen ein ähnliches Laufgefühl wie barfuß, bieten aber dennoch einen gewissen Schutz und Halt.“"
                            },
                            {
                                "example_id": "948010ad-a022-47e8-a888-2c1b8f26c360",
                                "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                                "text": "„Das Laufgefühl erschien weicher als beim Vorgänger, allerdings auch fest genug auf Wald- und Wiesenboden.“"
                            },
                            {
                                "example_id": "66343208-9ea1-4a66-99b0-dc465c73cebc",
                                "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                                "text": "„Das Laufgefühl ist unverwechselbar: dank der leichten Wellung, welche sich dem Fußbett perfekt anpasst, erhalten Sie täglich eine angenehme Fußmassage, welche Sie für den Start in den Tag entspannen lässt.“"
                            },
                            {
                                "example_id": "63bdcc1d-8148-480c-ac31-0b78adfbedbb",
                                "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                                "text": "„In der Lauflinie befindet sich bündig eingelassenes schwarzes Linoleum, um den Widerhall zu mildern und ein angenehmeres Laufgefühl zu vermitteln.“"
                            },
                            {
                                "example_id": "71d3dc58-6b28-42de-946e-7239d54c0faf",
                                "sense_id": "e76c1748-dd9d-390e-bba8-09a91a19e33b",
                                "text": "„‚Ich hatte seit Langem endlich mal wieder ein freies und fliegendes Laufgefühl, was für mich heute das Wichtigste war‘, sagte der TSV-Athlet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
