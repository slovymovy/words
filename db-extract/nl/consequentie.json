                            {
                                "example_id": "101363f9-dc04-4efb-ac40-5618486a80f1",
                                "sense_id": "041595af-e1d4-32eb-9dce-49fa5b321951",
                                "text": "De consequenties van zijn beslissing werden snel duidelijk.",
                                "translation": "The consequences of his decision became clear quickly.",
                                "english": "The consequences of his decision became clear quickly."
                            },
                            {
                                "example_id": "db3479e3-b2c8-4901-95f5-15af1ead2ef6",
                                "sense_id": "041595af-e1d4-32eb-9dce-49fa5b321951",
                                "text": "Heb je nagedacht over de mogelijke consequenties?",
                                "translation": "Have you thought about the possible results?",
