                    {
                        "translation_id": "e5234675-c97b-44ff-a5f6-d01fe793a22d",
                        "source_entry_id": "da98d41d-cd63-310f-bcd1-d82ce2abc7f4",
                        "source_sense_id": "1c641661-87d6-33e6-a96c-fde120230b96",
