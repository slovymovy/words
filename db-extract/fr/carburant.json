                        "sense_id": "49e8ca96-67cf-3c0c-9343-8a5535deacb3",
                        "entry_id": "fb243fad-a506-3f7a-84c8-9b25b571df09",
                        "glosses": [
                            "Qui carbure, qui a les caractéristiques d’un carburant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0638021-607b-4076-9032-1f8e47a6fea5",
                                "sense_id": "49e8ca96-67cf-3c0c-9343-8a5535deacb3",
                                "text": "La décision d`utiliser à fond certaines substances carburantes a, au cours des deux derniers siècles, lancé l'homme sur une voie irréversible en mettant à son service des sources d'énergie dont son avidité et sa violence ont bientôt abusé."
                            }
                        ]
