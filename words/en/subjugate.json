{
    "word_family": [
        "subjugation",
        "subjugator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ab41222-590e-3ef1-8996-1819b42e44d3",
                    "sense_definition": "To forcibly impose obedience, servitude, or submission upon a country or a group of people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The empire sought to <w>subjugate</w> the neighboring tribes to expand its territory."
                        },
                        {
                            "text": "History is full of powerful nations attempting to <w>subjugate</w> smaller, independent states."
                        }
                    ],
                    "synonyms": [
                        "subdue",
                        "vanquish"
                    ],
                    "common_phrases": [
                        "subjugate a nation",
                        "subjugate a people"
                    ]
                },
                {
                    "sense_id": "fcc2b1a2-4938-308c-b72b-776b22bf60f2",
                    "sense_definition": "To make someone or something subordinate to another person or thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He allowed his personal desires to <w>subjugate</w> his professional responsibilities."
                        },
                        {
                            "text": "The new policy aims to <w>subjugate</w> individual interests to the needs of the collective."
                        }
                    ],
                    "synonyms": [
                        "enthrall"
                    ],
                    "common_phrases": [
                        "subjugate one's will"
                    ]
                },
                {
                    "sense_id": "81430aec-1ff9-3028-8647-52b1304a8142",
                    "sense_definition": "To tame or domesticate an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early humans learned how to <w>subjugate</w> wild horses for transportation."
                        },
                        {
                            "text": "It takes great patience to <w>subjugate</w> a wild animal for farm work."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ]
                },
                {
                    "sense_id": "90ae76aa-70a1-3c12-a426-e40d3f55c4fc",
                    "sense_definition": "To put one's neck or shoulders under a metaphorical yoke.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels refused to <w>subjugate</w> their necks to the new regime."
                        },
                        {
                            "text": "They were forced to <w>subjugate</w> their necks to the demands of the conqueror."
                        }
                    ],
                    "synonyms": [
                        "underyoke"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a metaphorical, often religious or historical context."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34028c1d-e026-3b37-99a5-fc4efbe3eb46",
                    "sense_definition": "Forced into submission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>subjugate</w> population lived in constant fear of their rulers."
                        },
                        {
                            "text": "He felt <w>subjugate</w> to the whims of his employer."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87f374f7-a8ca-3a02-8429-026699168cbc",
                    "sense_definition": "A person forced into submission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>subjugate</w> had no rights under the harsh law."
                        },
                        {
                            "text": "Every <w>subjugate</w> dreamed of the day they would be free."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ]
                }
            ]
        }
    ]
}