                    {
                        "translation_id": "5da927bb-2e12-412c-9225-6fb7596812f9",
                        "source_entry_id": "4a3aa033-1f73-3386-9cb2-eecea349d7a3",
                        "source_sense_id": "82fd8a17-40d6-34b2-b420-6ff987333f2e",
                        "source_sense_description": "boek of programma over mensen die trachten misdaden op te lossen",
                        "target_lang_word": "Kriminalroman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriminalroman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5edf4aeb-3560-384d-b701-55a751e9ae26",
                                        "entry_id": "2508df19-c3c6-3b4f-8248-fee8d7d54aba",
                                        "glosses": [
                                            "Genre der Literatur, das in der Regel ein Verbrechen und seine Verfolgung und Aufklärung durch die Polizei, einen Detektiv oder eine Privatperson behandelt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf00ca3a-3288-4cca-ad00-edf3b43406c9",
                                                "sense_id": "5edf4aeb-3560-384d-b701-55a751e9ae26",
                                                "text": "Agatha Christie ist eine Autorin des Kriminalromans."
                                            },
                                            {
                                                "example_id": "97ef57f4-ddf4-437b-8c3c-3bda628b3446",
                                                "sense_id": "5edf4aeb-3560-384d-b701-55a751e9ae26",
                                                "text": "„Es ist eigentlich die Technik, die später von den Verfassern von Kriminalromanen aufgegriffen werden wird.“"
                                            },
                                            {
                                                "example_id": "10fafd08-188c-4bc9-8aeb-c8a527dc1e46",
                                                "sense_id": "5edf4aeb-3560-384d-b701-55a751e9ae26",
                                                "text": "„Er sah aus wie jemand, der sich für nichts, nichts mehr wirklich interessierte, nur noch für Kriminalromane, eine bestimmte Weinmarke und dumme Witze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "940423bc-d2d0-316d-8469-1002eefd0931",
                                        "entry_id": "2508df19-c3c6-3b4f-8248-fee8d7d54aba",
                                        "glosses": [
                                            "ein konkreter Roman aus der Literaturgattung Kriminalroman"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e2dde0-3c3e-4c4b-8a05-b01bd879d284",
                                                "sense_id": "940423bc-d2d0-316d-8469-1002eefd0931",
                                                "text": "Im Urlaub lese ich zwei bis drei Kriminalromane."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
