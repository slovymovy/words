            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e7bc7cf-24e0-322f-a962-757b636eb30a",
                    "sense_definition": "nawiązać kontakt fizyczny z kimś lub czymś, zazwyczaj za pomocą ręki lub palca",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ostrożnie <w>dotknął</w> gorącej powierzchni czajnika, aby sprawdzić, czy woda już się zagotowała.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>дотронулся до</w> горячей поверхности чайника, чтобы проверить, закипела ли уже вода."
                            }
                        },
                        {
                            "text": "Dziecko chciało <w>dotknąć</w> małego psa, ale zwierzę nagle uciekło pod stół.",
                            "target_lang_translations": {
                                "ru": "Ребёнок хотел <w>потрогать</w> маленькую собаку, но животное внезапно убежало под стол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dotknąć ręką",
                        "dotknąć ramienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "вступить в физический контакт с кем-либо или чем-либо, обычно рукой или пальцем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коснуться",
                                "target_lang_sense_clarification": "вступить в физический контакт"
                            },
                            {
                                "target_lang_word": "дотронуться",
                                "target_lang_sense_clarification": "прикоснуться рукой или пальцем"
                            },
                            {
                                "target_lang_word": "прикоснуться",
                                "target_lang_sense_clarification": "осторожно коснуться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad4ab84-cbbd-31de-adb4-4accdada9fa4",
                    "sense_definition": "wywołać silne emocje, wzruszyć lub poruszyć kogoś do głębi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocjonalny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej szczere słowa wdzięczności głęboko <w>dotknęły</w> wszystkich zebranych na uroczystości gości.",
                            "target_lang_translations": {
                                "ru": "Её искренние слова благодарности глубоко <w>тронули</w> всех собравшихся на торжестве гостей."
                            }
                        },
                        {
                            "text": "Ta wzruszająca opowieść o dawnej przyjaźni naprawdę <w>dotknęła</w> moje serce.",
                            "target_lang_translations": {
                                "ru": "Этот трогательный рассказ о давней дружбе по-настоящему <w>затронул</w> моё сердце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dotknąć do głębi",
                        "dotknąć serca"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызвать сильные эмоции, растрогать или глубоко взволновать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тронуть",
                                "target_lang_sense_clarification": "растрогать, взволновать чувства"
                            },
                            {
                                "target_lang_word": "затронуть",
                                "target_lang_sense_clarification": "задеть эмоционально"
                            },
                            {
                                "target_lang_word": "растрогать",
                                "target_lang_sense_clarification": "вызвать сильные эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1be4c7-7d3c-393a-aa2a-1515557aaf84",
                    "sense_definition": "urazić kogoś, sprawić komuś przykrość nieprzyjemnym zachowaniem lub uwagą",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocjonalny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten złośliwy komentarz na temat nowego projektu bardzo mocno go <w>dotknął</w>.",
                            "target_lang_translations": {
                                "ru": "Этот язвительный комментарий о новом проекте очень сильно его <w>задел</w>."
                            }
                        },
                        {
                            "text": "Nie chciałem nikogo <w>dotknąć</w>, po prostu wyraziłem swoje prywatne zdanie.",
                            "target_lang_translations": {
                                "ru": "Я не хотел никого <w>обидеть</w>, а просто выразил своё личное мнение."
                            }
                        }
                    ],
                    "synonyms": [
                        "urazić",
                        "ubliżyć"
                    ],
                    "common_phrases": [
                        "dotknąć do żywego"
                    ],
                    "target_lang_definitions": {
                        "ru": "обидеть, уязвить или задеть кого-либо неприятным поведением или замечанием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задеть",
                                "target_lang_sense_clarification": "обидеть, уязвить"
                            },
                            {
                                "target_lang_word": "обидеть",
                                "target_lang_sense_clarification": "причинить огорчение"
                            },
                            {
                                "target_lang_word": "уязвить",
                                "target_lang_sense_clarification": "больно задеть самолюбие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593a08f1-dd1c-3cf1-a2e9-e392f05948ec",
                    "sense_definition": "wykonać ruch dotknięcia własnego ciała ręką",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy poczuł nagły ból głowy, <w>dotknął</w> się ręką w okolicach czoła.",
                            "target_lang_translations": {
                                "ru": "Почувствовав внезапную головную боль, он <w>прикоснулся</w> рукой ко лбу."
                            }
                        },
                        {
                            "text": "Zawodnik <w>dotknął</w> się w bolące kolano po upadku na twarde boisko.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>дотронулся до</w> больного колена после падения на твёрдое поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершить движение, прикасаясь рукой к собственному телу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дотронуться до себя",
                                "target_lang_sense_clarification": "прикоснуться к своему телу"
                            },
                            {
                                "target_lang_word": "прикоснуться к себе",
                                "target_lang_sense_clarification": "коснуться своего тела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
