                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b469e91-9ef5-4e7b-b1d4-879c20dda696",
                                "sense_id": "e2b5e0a1-a191-3c4b-b39c-c179c3bf665e",
                                "text": "Im Konzernanhang wird beispielsweise darüber informiert, welche Bilanzierungs- und Bewertungsmethoden im Konzern angewandt worden, oder welche besonderen Ereignisse eingetreten sind, sowie welche zukünftigen Chancen und Risiken für den Konzern bestehen."
                            },
                            {
                                "example_id": "78391f69-b15b-4ceb-8bd8-874756852f68",
                                "sense_id": "e2b5e0a1-a191-3c4b-b39c-c179c3bf665e",
                                "text": "Ein handelsrechtlicher Konzernabschluss ist ohne Konzernanhang nicht denkbar."
                            }
                        ],
