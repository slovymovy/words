                                        "examples": [
                                            {
                                                "example_id": "74d1ef01-a651-4da9-89e4-d3e041853ff7",
                                                "sense_id": "d4dec040-747e-3380-b50b-ec8a8c0faf8b",
                                                "text": "\"So I broke away early this mornin', gave my guard a kick in the tummy that laid him out, and sprinted for the camp.\""
                                            },
                                            {
                                                "example_id": "e2d956e3-83eb-4114-a344-91e5f63e79fb",
                                                "sense_id": "d4dec040-747e-3380-b50b-ec8a8c0faf8b",
                                                "text": "I got love in my tummy and a tiny little pain / And a ten ton catastrophe on a 60 pound chain"
                                            },
                                            {
                                                "example_id": "e145cada-88e2-4d20-b7ed-c1a641cd6dcc",
                                                "sense_id": "d4dec040-747e-3380-b50b-ec8a8c0faf8b",
                                                "text": "Oh man —pal! You didn't swallow that gum, did you?? It stays in your tummy for seven years and all the other bad stuff sticks to it and then a doctor has to cut it out with an axe!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c535f54-3ff9-324a-ac68-f06ac6db3ebf",
                                        "entry_id": "4e5738cb-4de7-3235-8fdd-8281a610417f",
                                        "glosses": [
                                            "Stomach or belly.",
                                            "Protruding belly, paunch."
                                        ],
