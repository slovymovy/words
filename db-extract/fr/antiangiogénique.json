                        "glosses": [
                            "Qui défavorise la création de vaisseaux sanguins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c1298c-3e12-44e4-be6b-b3e59542377e",
                                "sense_id": "e81b6eb1-87d3-397b-8468-4e87d51b5c8f",
                                "text": "D’autres traitements antiangiogéniques visent à l’inverse à renforcer les inhibiteurs naturels de l’angiogenèse telles que l’endostatine."
                            },
                            {
                                "example_id": "1fda6cde-d5e8-4b23-a9f6-f38e2f5493eb",
                                "sense_id": "e81b6eb1-87d3-397b-8468-4e87d51b5c8f",
                                "text": "Or, de nombreux aliments présentent également des propriétés antiangiogéniques démontrées."
                            },
                            {
                                "example_id": "b5ec680e-c267-469d-b6d7-49f66afe2a42",
                                "sense_id": "e81b6eb1-87d3-397b-8468-4e87d51b5c8f",
                                "text": "L’angiostatine est une protéine antiangiogénique efficace dans les modèles précliniques."
                            }
                        ]
                    }
