                        "sense_id": "3d0ebc00-e075-3fb6-a743-6296f39048c3",
                        "entry_id": "e3102d1f-572b-37c2-84d8-7263abfecdc0",
                        "glosses": [
                            "im Alten Testament die umschreibende Bezeichnung für einen Menschen"
                        ],
