                        "sense_id": "055f7ab4-1224-31d2-b328-93aa115196ec",
                        "entry_id": "5b91768e-c155-3b5b-8145-705e8964c92c",
                        "glosses": [
                            "Vieille voiture ou voiture en mauvais état."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "85992a75-fe0a-4b8e-af55-a0daf9d765b7",
                                "sense_id": "055f7ab4-1224-31d2-b328-93aa115196ec",
                                "text": "Tu as enfin vendu ton vieux bazou !"
                            },
                            {
                                "example_id": "f69f60fa-aca4-485e-802d-4e3df3491ca5",
                                "sense_id": "055f7ab4-1224-31d2-b328-93aa115196ec",
                                "text": "Il est plus facile de slalomer entre les obstacles avec un vélo qu’avec un bazou de trois mètres de long et Simon a de la difficulté à manœuvrer avec son bras bandé."
                            },
                            {
                                "example_id": "177c4258-9346-458d-8374-93822f1bbd95",
                                "sense_id": "055f7ab4-1224-31d2-b328-93aa115196ec",
                                "text": "Faut qu'j'fasse poser mes pneus d'hiver sur mon bazou couvert de rouille."
                            },
                            {
                                "example_id": "a682ef96-c8a5-44e0-9c24-bb560e52e00d",
                                "sense_id": "055f7ab4-1224-31d2-b328-93aa115196ec",
                                "text": "T’as beau avoir le meilleur pilote au monde, si tu lui mets un vieux bazou dans les mains, tu vas avoir des résultats de vieux bazou."
                            }
                        ]
                    }
