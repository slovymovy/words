                "senses": [
                    {
                        "sense_id": "30cb2b62-dc25-36e4-b28a-19e5b0978e19",
                        "entry_id": "2325e6f6-3954-3250-82d5-e2d90a3b2199",
                        "glosses": [
                            "handballer (player of handball, the European team sport)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "0c6cc6ae-4ced-4d0d-a0f2-d1452480a472",
                                "sense_id": "30cb2b62-dc25-36e4-b28a-19e5b0978e19",
                                "text": "Piłka ręczna znalazła także zwolenników w kilku mniejszych miastach Wielkopolski. Szczypiorniści KKS zdobyli mistrzostwo Polski już w 1946 r.",
                                "translation": "Handball also found supporters in a few smaller cities of Lesser Poland. Handballers KKS won the Polish championship in 1946.",
                                "english": "Handball also found supporters in a few smaller cities of Lesser Poland. Handballers KKS won the Polish championship in 1946."
                            },
                            {
                                "example_id": "557d142f-665b-41c7-a35a-06a36320f7e9",
                                "sense_id": "30cb2b62-dc25-36e4-b28a-19e5b0978e19",
                                "text": "Punktem kulminacyjnym były pojedynki tenisa stołowego, pomiędzy marszałkiem województwa warmińsko-mazurskiego Jackiem Protasem i naszym olimpijczykiem, wielokrotnym mistrzem i reprezentantem Polski - Tomaszem Krzeszewskim; siatkarzami: Wojciechem Grzybem, Michałem Bąkiewiczem, Pawłem Zagumnym i szczypiornistami: Piotrem Frelkiem, Adamem Tetykiem, Marcinem Malewskim.",
                                "translation": "The hightlight was the tabble tennis duals between the marshal of the Warmian-Masurian Voivodeship Jacek Protas and our olympian, multi-champions and representatives of Poland - Tomasz Krzeszewski; volleyballers: Wojciech Grzyb, Michał Bąkiewicz, Pawel Zagumny, and the handballers: Piotr Frelek, Adam Tetyk, Marcin Malewski.",
                                "english": "The hightlight was the tabble tennis duals between the marshal of the Warmian-Masurian Voivodeship Jacek Protas and our olympian, multi-champions and representatives of Poland - Tomasz Krzeszewski; volleyballers: Wojciech Grzyb, Michał Bąkiewicz, Pawel Zagumny, and the handballers: Piotr Frelek, Adam Tetyk, Marcin Malewski."
                            }
                        ]
                    }
