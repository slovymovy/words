                        "cross_references": [
                            {
                                "target_word": "rijverbod",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "91be45e9-4040-3cd8-833d-047cb937e8ea",
                                        "entry_id": "960d6120-b31a-355b-a762-072010b02345",
                                        "glosses": [
                                            "ontzegging van de rijbevoegdheid na het begaan van een overtreding in het verkeer"
                                        ],
                                        "tags": [
                                            "België"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "685ef93b-bb71-450e-af73-9b5a40f13fc9",
                                                "sense_id": "91be45e9-4040-3cd8-833d-047cb937e8ea",
                                                "text": "Schultz en Van der Steur komen komend voorjaar met voorstellen om die Kamerwensen uit te voeren. Van der Steur verwacht dan ook meer duidelijkheid over de mogelijkheden van een alcoholenkelband voor recidivisten. Die registreert het reisgedrag en het alcoholgebruik van iemand die een rijverbod heeft gekregen. Hij heeft verder met de korpschef van de landelijke politie afgesproken dat de alcoholcontroles in het verkeer zullen worden geïntensiveerd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b252b4-9742-3593-af3b-e80439283a32",
                                        "entry_id": "960d6120-b31a-355b-a762-072010b02345",
                                        "glosses": [
                                            "verbod om te rijden met een bepaald soort voertuig of op bepaalde tijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d59412b7-d423-4cb3-a6cd-e19c5d87f0ee",
                                                "sense_id": "b8b252b4-9742-3593-af3b-e80439283a32",
                                                "text": "Ten slotte hamerde Van Vliet er op dat Nederland goede alternatieven heeft – maatregelen die méér effect sorteren en die de markt níet verstoren. Zoals rijverboden voor vuile auto’s in bepaalde periodes en/of in bepaalde gebieden. Of hogere subsidies op schone auto’s. Of rekeningrijden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "102e7277-eee3-3f75-be99-0685bc65e03f",
                                        "entry_id": "960d6120-b31a-355b-a762-072010b02345",
                                        "glosses": [
                                            "het verbod om in een auto te rijden voor bepaalde bevolkingsgroepen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aabee93c-bbfb-45d6-80ad-e434fdc77307",
                                                "sense_id": "102e7277-eee3-3f75-be99-0685bc65e03f",
                                                "text": "Alwaleed bin Talal is al langer bekend als een voorvechter van vrouwenrechten. Zijn uitspraken zijn een steun in de rug voor activisten. Al een aantal jaren protesteren vrouwen tegen het rijverbod. In 2013 was de protestactie #Women2Drive te volgen via Twitter. Vrouwen werden opgeroepen om in de auto te stappen en video’s van zichzelf te maken en op internet te plaatsen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
