        "nl-extract.jsonl": [
            {
                "entry_id": "e930b2c7-c861-3e8e-8a94-09cd3a3f8d96",
                "word": "pedant",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ce927c2-a074-3f39-b755-9100fd591356",
                        "entry_id": "e930b2c7-c861-3e8e-8a94-09cd3a3f8d96",
                        "glosses": [
                            "naar eigen opvatting beter en wijzer dan andere mensen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "083b9094-445b-4573-8036-d6e27b1be8ae",
                                "sense_id": "0ce927c2-a074-3f39-b755-9100fd591356",
                                "text": "'Een welbespraakte intellectueel' is een van de vele kwalificaties die op Thierry Baudet, (Heemstede, 1983) the new kid on the block op de rechter flank van de Nederlandse politiek, worden geplakt. 'Erg pienter' en 'zelfverzekerd' zijn er ook twee. 'Pedant' en 'ronduit gevaarlijk', zijn twee andere."
                            }
                        ]
                    },
                    {
                        "sense_id": "20dc3b75-04ea-3cec-84e8-12a4a20e7c28",
                        "entry_id": "e930b2c7-c861-3e8e-8a94-09cd3a3f8d96",
                        "glosses": [
                            "schoolmeesterachtig"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a510c76c-4b8d-4e67-8506-4770bbd6e277",
                                "sense_id": "20dc3b75-04ea-3cec-84e8-12a4a20e7c28",
                                "text": "Solnit begint het essay met een ogenschijnlijk hilarisch voorvalletje: op een feestje legt een oudere, pedante man haar de inhoud van haar éigen boek uit, dat hij bovendien niet eens gelezen blijkt te hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f18197-adfc-4377-a414-13d7bb3f4c1f",
                        "source_entry_id": "e930b2c7-c861-3e8e-8a94-09cd3a3f8d96",
                        "source_sense_id": "0ce927c2-a074-3f39-b755-9100fd591356",
                        "source_sense_description": "iemand die zichzelf beter en wijzer vindt dan andere mensen",
                        "target_lang_word": "pedantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f49b017-d268-3afd-bc09-75b70ef3e50b",
                                        "entry_id": "4685ca62-3a07-3adc-8ac0-2317f83998d3",
                                        "glosses": [
                                            "Being overly concerned with formal rules and trivial points of learning, like a pedant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bba6758-e8d9-3473-ae15-fc217490c7ea",
                                        "entry_id": "4685ca62-3a07-3adc-8ac0-2317f83998d3",
                                        "glosses": [
                                            "Tending to show off one’s knowledge, often in a tiresome manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6394f688-8ccd-4b23-8aa9-27c8658947af",
                                                "sense_id": "4bba6758-e8d9-3473-ae15-fc217490c7ea",
                                                "text": "The style is pedantic and reviewish: but I can easily fancy states of mind to which it may be no less salutary on that account."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdee98f-64a2-4a28-b701-8fad073975ac",
                        "source_entry_id": "e930b2c7-c861-3e8e-8a94-09cd3a3f8d96",
                        "source_sense_id": "0ce927c2-a074-3f39-b755-9100fd591356",
                        "source_sense_description": "iemand die zichzelf beter en wijzer vindt dan andere mensen",
                        "target_lang_word": "pedante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedante",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff87a62-a378-349d-bd23-62f05d6463cc",
                                        "entry_id": "65b31299-edd1-315d-8cfd-a8d60acd945f",
                                        "glosses": [
                                            "Maestro de primera enseñanza que dictaba clases privadas a domicilio para los hijos de familias pudientes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff2fb73-35df-453f-83d1-4f20da049bf5",
                                                "sense_id": "0ff87a62-a378-349d-bd23-62f05d6463cc",
                                                "text": "Callo aquella sentencia que solía\nrepetir de Terencio mi pedante,\nen que a Baco i a Ceres revolvía."
                                            },
                                            {
                                                "example_id": "0228cb2c-3f13-4063-8e6d-b88d0d0e634c",
                                                "sense_id": "0ff87a62-a378-349d-bd23-62f05d6463cc",
                                                "text": "un pedante, maestro de un gran caballero, niño de muy gallardo entendimiento, hijo de un gran príncipe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "pedante",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0b9341-7380-33f8-b04f-56c696448ef2",
                                        "entry_id": "22245378-760a-3554-b71d-f090931c7e2f",
                                        "glosses": [
                                            "Que alardea y se envanece de sus conocimientos, con o sin causa para ello."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4145548-ec90-43e8-a878-5e7fb036c73c",
                                                "sense_id": "0d0b9341-7380-33f8-b04f-56c696448ef2",
                                                "text": "Ningún cristiano tu principio ignora,\npues ¿por qué vanidad, sastre pedante,\nla aguja infamas de tu vida autora?"
                                            },
                                            {
                                                "example_id": "e5562007-3f6b-4151-a7dc-f6fa4b2e2fd1",
                                                "sense_id": "0d0b9341-7380-33f8-b04f-56c696448ef2",
                                                "text": "No le hagan caso, caballeros. Es un pedante que no pierde la ocasión para exhibir su erudición."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b206af8d-03f0-3294-9416-6ac94f0f109f",
                                        "entry_id": "22245378-760a-3554-b71d-f090931c7e2f",
                                        "glosses": [
                                            "Dicho de una cosa o actitud, propia de un pedante₂."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131d80e7-b4d6-4a39-8477-a51ba5216860",
                                                "sense_id": "b206af8d-03f0-3294-9416-6ac94f0f109f",
                                                "text": "Yo también encontré, como ellos, la mía, una mezcla de apatía y ataraxia: fórmula oscura y pedante de suicidarme de pie."
                                            },
                                            {
                                                "example_id": "f3adc434-d095-4e02-8260-2c2aed6b50fc",
                                                "sense_id": "b206af8d-03f0-3294-9416-6ac94f0f109f",
                                                "text": "La entrevista con la paciente, el modo mismo de expresarse, su suficiencia, la pedante ostentación del cansancio que le provoca el insistente cortejo de X son reveladores de la exaltación del self que obtiene mediante el delirio."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
