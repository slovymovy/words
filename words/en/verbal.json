                                "target_lang_word": "oral",
                                "target_lang_sense_clarification": "relativo a la voz o al habla"
                            },
                            {
                                "target_lang_word": "verbal",
                                "target_lang_sense_clarification": "que se lleva a cabo con la voz y no por escrito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddb7e19a-14d6-3f68-94ce-1fac8800fb3f",
                    "sense_definition": "Relating to words or the use of words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relating_to_words",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has excellent <w>verbal</w> skills and can explain complex ideas clearly.",
                            "target_lang_translations": {
                                "ru": "У нее отличные <w>вербальные</w> навыки, и она может ясно объяснять сложные идеи.",
                                "zh": "她有出色的<w>言语</w>表达能力，能清晰地解释复杂的想法。",
                                "es": "Ella tiene excelentes habilidades <w>verbales</w> y puede explicar ideas complejas con claridad."
                            }
                        },
                        {
                            "text": "The test evaluates both mathematical and <w>verbal</w> reasoning abilities.",
                            "target_lang_translations": {
                                "ru": "Тест оценивает способности как к математическому, так и к <w>вербальному</w> мышлению.",
                                "zh": "这项测试评估数学和<w>言语</w>推理能力。",
                                "es": "La prueba evalúa tanto las habilidades de razonamiento matemático como las <w>verbales</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-verbal"
                    ],
                    "common_phrases": [
                        "verbal skills",
                        "verbal reasoning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный со словами или использованием слов.",
                        "zh": "与词汇或语言使用相关的。",
                        "es": "Relacionado con las palabras o el uso de las mismas."
                    },
                    "translations": {
                        "ru": [
