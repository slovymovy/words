                    {
                        "form_id": "c99dc951-660a-480a-aa11-43e6883093c9",
                        "entry_id": "9c7fcaef-f5c6-3b67-a4aa-b90c683d6689",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sommerabende"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                        "entry_id": "9c7fcaef-f5c6-3b67-a4aa-b90c683d6689",
                        "glosses": [
                            "der Ausklang eines Sommertages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d662a2b-ff2e-459a-8b5e-29f6173c93ff",
                                "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                                "text": "Einen lauen Sommerabend am Strand zu verbringen ist herrlich."
                            },
                            {
                                "example_id": "34892f25-eb3b-43be-858f-842ccc0905c4",
                                "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                                "text": "„Ich hatte hinausgeblickt an diesem Sommerabend im Jahr 1954, fasziniert von den bunten Leuchtreklamen der großen Stadt und von den nach und nach grauer und immer schwärzer werdenden Häusern.“"
                            },
                            {
                                "example_id": "0406b7cb-b54c-4402-9c7d-30ac12d3c471",
                                "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                                "text": "„An einem schwülheißen Sommerabend, als sie mit dem Fahrrad von der Stadt her am Mühlenweiher vorbeigekommen ist, hat sie Lukas Piontek gesehen, der, eben aus dem Wasser gestiegen, sich ihr splitternackt gezeigt hat; was sie sehr irritiert, aber auch heftig erregt hat.“"
                            },
                            {
                                "example_id": "0090d80a-3495-4125-9c8e-cf21382cf79a",
                                "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                                "text": "„An Sommerabenden hängt die Sonne rot in den blanken Scheiben der Klassenräume.“"
                            },
                            {
                                "example_id": "6f318f3b-a055-40aa-a26f-49af95547d91",
                                "sense_id": "68f4d6ff-819f-38dc-82b6-9a34c92e04b3",
                                "text": "„Mit solchen Sorgen und Plänen machte er sich an diesem brandig-schwülen Sommerabend auf den Heimweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
