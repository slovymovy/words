                    },
                    {
                        "translation_id": "d87073f7-a3ab-493e-b34a-7952d4aa4a25",
                        "source_entry_id": "14f79b10-6429-3bf7-ab83-27c9183bf5db",
                        "source_sense_id": "147b297d-5720-38cf-9c95-7a22bd1f2b6b",
                        "target_lang_word": "curviligne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curviligne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2405365-3bc7-3085-8638-ada5de66bc09",
                                        "entry_id": "e05e46bf-cef0-32bc-9159-d9d47caa1a2a",
                                        "glosses": [
                                            "Qui est formé par des lignes courbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0bd5873-2d8f-4e74-80c4-6dcf4fdad376",
                                                "sense_id": "e2405365-3bc7-3085-8638-ada5de66bc09",
                                                "text": "Sans pâlir et sans trembler elle vint se placer derrière Philippe, qui, le visage collé contre une fenêtre, paraissait suivre attentivement la marche des nuages qui passaient sur la Gironde, denses et noirs, éclairés sur leurs contours curvilignes par le mince sillon des éclairs."
                                            },
                                            {
                                                "example_id": "99ff6156-491e-43e9-b914-d0ed6d96c6c0",
                                                "sense_id": "e2405365-3bc7-3085-8638-ada5de66bc09",
                                                "text": "Il est composé de huit secteurs rectilignes, où les particules sont accélérées par un champ électrique, entrecoupés de huit tronçons curvilignes où les trajectoires sont courbées par un champ magnétique intense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44326e0d-5236-3c17-aa34-142d880f57be",
                                        "entry_id": "e05e46bf-cef0-32bc-9159-d9d47caa1a2a",
                                        "glosses": [
                                            "Qui suit une ligne courbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708a6c0e-64c1-428e-a38b-f190c37f6930",
                                                "sense_id": "44326e0d-5236-3c17-aa34-142d880f57be",
                                                "text": "Autant dans le cas réel il n’y a qu’un seul chemin pour aller de u à v, dans le cas complexe, il y a une infinité de chemins. Gauss affirme alors que la valeur de l’intégrale est indépendante de celui qu’on a choisi ! On voit poindre la notion d’intégrale curviligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b3f8d5-89aa-3cdf-86e6-179def30fc66",
                                        "entry_id": "e05e46bf-cef0-32bc-9159-d9d47caa1a2a",
                                        "glosses": [
                                            "Qui suit une ligne courbe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291d0092-6a73-4a41-9205-65deaeb9ccfe",
                                                "sense_id": "76b3f8d5-89aa-3cdf-86e6-179def30fc66",
                                                "text": "Regencrantz ne répondit que par un mouvement curviligne de la main qui ne signifiait rien, qui n’était que le commentaire extérieur d’une pensée inexprimée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
