                "senses": [
                    {
                        "sense_id": "a8ff7b27-2e4b-36cb-8f23-19ac2a3c0c2e",
                        "entry_id": "34ad47e7-c4d9-3dc3-ba2c-d3b9767cf48d",
                        "glosses": [
                            "Rendre corvéable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab7dc6f-2835-4131-8368-a7e58c44d104",
                                "sense_id": "a8ff7b27-2e4b-36cb-8f23-19ac2a3c0c2e",
                                "text": "Eux aussi, ils ont été taillés, corvéabilisés à merci, les deux vieux serfs."
                            },
                            {
                                "example_id": "82dd9ef0-7ec6-4af8-a6ea-4a860da45e82",
                                "sense_id": "a8ff7b27-2e4b-36cb-8f23-19ac2a3c0c2e",
                                "text": "En Italie sous prétexte de supprimer le chomage, on flexibilise, on enlève quelques entraves, on rabote des acquits de certains salariés en espérant que la gars qui est hors du système le réintègre, on veut la-bas corvéabiliser la main-d'oeuvre."
                            },
                            {
                                "example_id": "f536be27-7088-46a1-aea4-3bee8fbd62ff",
                                "sense_id": "a8ff7b27-2e4b-36cb-8f23-19ac2a3c0c2e",
                                "text": "Au lieu d'apporter des solutions drastiques en fonction des indicatifs réelles du monde du travail afin de moderniser les entreprises sans considérer que le salarié est le prolongement de l'outil de travail dont on peut le corvéabiliser et soumettre à souhait... ou le benner à Pôle Emploi."
                            }
                        ]
                    }
                ],
