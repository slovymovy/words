        "fr-extract.jsonl": [
            {
                "entry_id": "4556755e-b640-3c4b-9dd3-afe045ad5b63",
                "word": "animalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5dc1b33-ec7d-3829-88c3-63cddb9d7910",
                        "entry_id": "4556755e-b640-3c4b-9dd3-afe045ad5b63",
                        "glosses": [
                            "D’une manière animale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32258a8-81d1-4897-acf3-47d7ff72f914",
                                "sense_id": "a5dc1b33-ec7d-3829-88c3-63cddb9d7910",
                                "text": "Nous n’osons pas nous livrer à la liberté. Pâles, efféminés, énervés par cette éducation émasculante de l’empire, nous avons peur de cette fille vigoureuse, passionnée, animalement belle avec ses bras musclés d’amazone et son visage au nez court, à l’angle facial de panthère."
                            },
                            {
                                "example_id": "24265ea4-9982-49c6-8f73-8fcaed2ad1ee",
                                "sense_id": "a5dc1b33-ec7d-3829-88c3-63cddb9d7910",
                                "text": "Avant hier dix huit Juillet, à la terrasse d'un café de la place de la Mina, par ces temps de canicule, je dégustais, d’une manière qu’on pourrait taxer d’animalement gourmande, tant les hommes devraient abhorrer cette satisfaction naturelle de leurs appétits qui les rapprochent de la nature tout en les éloignant de ce qu'il est convenu d’appeler les raffinements de la civilisation, je dégustais donc, dis-je, un Rivoire clair aux tons opalins, étendu d’eau frappée."
                            },
                            {
                                "example_id": "f27c7eab-3f20-4880-b43d-ae938dd20f4a",
                                "sense_id": "a5dc1b33-ec7d-3829-88c3-63cddb9d7910",
                                "text": "Le soldat se laissait faire, sans pensée encore, sans reconnaissance, animalement heureux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90860c13-8f66-4d37-b7f8-e92b92ea107c",
                        "source_entry_id": "4556755e-b640-3c4b-9dd3-afe045ad5b63",
                        "source_sense_id": "a5dc1b33-ec7d-3829-88c3-63cddb9d7910",
                        "target_lang_word": "animally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f12f1010-da07-3ff1-af95-b96ca38b529b",
                                        "entry_id": "f577719b-faa6-31c4-98a9-baeceb3048bf",
                                        "glosses": [
                                            "Resembling or characteristic of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4842977f-01b1-447b-890f-9ac898a4a5a0",
                                                "sense_id": "f12f1010-da07-3ff1-af95-b96ca38b529b",
                                                "text": "There were, besides the pleasant fruity smells, a number of vile, animally smells that one could easily make from simple ingredients or extract from plants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "animally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74788d64-5f5c-3703-8415-33a294ca90d8",
                                        "entry_id": "335a1fe3-ab90-3bf7-b552-39f638ed92d8",
                                        "glosses": [
                                            "In respect of the physical or \\\"animal\\\" faculties, as opposed to the intellect or spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4e5b27-ef04-4a10-bd0d-ada808d3ee66",
                                                "sense_id": "74788d64-5f5c-3703-8415-33a294ca90d8",
                                                "text": "'Cosmic emotion' inevitably takes them in the form of enthusiasm and freedom. I speak not only of those who are animally happy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e31c513-51b7-3c20-a0ba-ff2c05fe1045",
                                        "entry_id": "335a1fe3-ab90-3bf7-b552-39f638ed92d8",
                                        "glosses": [
                                            "In respect of the anima or animal spirits."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
