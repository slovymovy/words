                            {
                                "target_word": "digital age",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d94a6be9-3ad5-39bc-b48b-2701f9358c8b",
                                        "entry_id": "b0defd75-43b4-3b4c-b139-f13f69a2e8d3",
                                        "glosses": [
                                            "The current era, characterised by the widespread and increasing use of digital technology in society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a0a565-4401-4899-b80c-36c7424d3fe9",
                                                "sense_id": "d94a6be9-3ad5-39bc-b48b-2701f9358c8b",
                                                "text": "But law enforcement agencies have to find a legal and ethical way to stay ahead of technology, rather than stand in the way of it. Trying to block advances in the digital age is futile."
                                            },
                                            {
                                                "example_id": "4a549c74-efdc-4a28-aa32-f64b0663b1aa",
                                                "sense_id": "d94a6be9-3ad5-39bc-b48b-2701f9358c8b",
                                                "text": "All this data will prove fascinating to sociologists, archaeologists and anthropologists studying the dawn of the digital age. For them, everyday life can be just as interesting as epoch-defining moments."
                                            },
                                            {
                                                "example_id": "805f48c7-35da-40d0-a6a1-b45e92364ed9",
                                                "sense_id": "d94a6be9-3ad5-39bc-b48b-2701f9358c8b",
                                                "text": "We are born in the digital age; we use our phones every minute; we communicate through digital tools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
