                "senses": [
                    {
                        "sense_id": "914089b4-d422-3b62-aeb8-79659ab04aba",
                        "entry_id": "05c2d3d5-023f-3498-afaa-f46d4e31bd9e",
                        "glosses": [
                            "Wand aus mehrere Meter langen, in den Boden gerammten Stahlbohlen, die Baugruben oder Fundamente gegen andrängendes Wasser abschließen oder die Uferränder sichern und befestigen"
                        ],
                        "tags": [
                            "Wasserbau",
                            "Tiefbau"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ca4a0a-75a0-4308-aeb1-7b65a12db847",
                                "sense_id": "914089b4-d422-3b62-aeb8-79659ab04aba",
                                "text": "Flussufer werden häufig mit Spundwänden befestigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0155f374-bfa3-44db-99f8-f05246fb49eb",
                        "source_entry_id": "05c2d3d5-023f-3498-afaa-f46d4e31bd9e",
                        "source_sense_id": "914089b4-d422-3b62-aeb8-79659ab04aba",
                        "target_lang_word": "sheet pile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sheet pile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab99e876-ca3f-3b21-bc77-88d46d76a02d",
                                        "entry_id": "15382281-8121-3650-a468-6bbaf1b09391",
                                        "glosses": [
                                            "A corrugated steel pile, which is vertically driven into the ground to form a wall of sheet piling."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9058c105-9d91-4f2c-bd7d-c3ee74a82f98",
                                                "sense_id": "ab99e876-ca3f-3b21-bc77-88d46d76a02d",
                                                "text": "Once the floodwaters had receded and further damage inspections could be carried out, the engineering solution [...] was to drill more than 120 sheet piles up to eight metres deep along a 115-metre section of the embankment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c95b3ef-a426-45d4-bfce-98fe79a13766",
                        "source_entry_id": "05c2d3d5-023f-3498-afaa-f46d4e31bd9e",
                        "source_sense_id": "914089b4-d422-3b62-aeb8-79659ab04aba",
                        "target_lang_word": "sheet piling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sheet piling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d4e7d54-0a4d-3bbc-8cec-e2759fce1254",
                                        "entry_id": "480f9b44-18dd-3450-80f0-af5678ca28eb",
                                        "glosses": [
                                            "A type of retaining wall used during construction by driving interlocking sheets of material into the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1225c408-b7ab-4f51-8fb5-28a9606640a7",
                                                "sense_id": "3d4e7d54-0a4d-3bbc-8cec-e2759fce1254",
                                                "text": "During the two Sundays preceding the accident, the track had been lifted to permit installation of shallow raft abutments some five to six feet under the track, which will eventually support a temporary bridge span during the construction of the permanent span, and sheet piling across the formation to hold the sides of future excavation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d17fe5-d1f4-3835-8992-40c9fa79ab59",
                                        "entry_id": "480f9b44-18dd-3450-80f0-af5678ca28eb",
                                        "glosses": [
                                            "The material used to assemble a sheet pile retaining wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f6f44f-1b2b-4102-98ba-1209cc17d6ea",
                                                "sense_id": "c2d17fe5-d1f4-3835-8992-40c9fa79ab59",
                                                "text": "During the partial line closure, engineers installed sheet piling to act as a retaining wall to support the embankment and road, and make it safe to carry out long-term repairs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
