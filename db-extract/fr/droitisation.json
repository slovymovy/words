                "senses": [
                    {
                        "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                        "entry_id": "8ce0ea4c-bf81-3f47-a3f5-2d08c738e1f4",
                        "glosses": [
                            "Évolution vers la droite de l’échiquier politique, d’un parti, de l’électorat, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99f38c8-fc8b-45d3-9558-aa2227ed98da",
                                "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                                "text": "Quelques provocations aidant, le pouvoir justifiera sa droitisation et sa terreur. Ses rapports avec la contestation prendront de plus plus un caractère de guerre civile, jusqu’à des affrontements décisifs."
                            },
                            {
                                "example_id": "34025515-d3f1-4017-8eeb-772e6099edb6",
                                "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                                "text": "Le reflux de la vague libérale n’annonce pas forcément la fin du processus de droitisation des sociétés occidentales."
                            },
                            {
                                "example_id": "83be1fc6-0882-4658-ad5e-33702c1a7700",
                                "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                                "text": "Avec une droitisation à l’extrême de Nicolas Sarkozy, l'ex-président a tout de même recueilli 48,4% des suffrages."
                            },
                            {
                                "example_id": "89ca75c7-d01d-4baa-8fd8-5b316f691c24",
                                "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                                "text": "Il s’inquiète des conséquences pour l’avenir de l’actuelle droitisation du débat politique."
                            },
                            {
                                "example_id": "7b8e0da6-8fd1-4568-be92-b67ca1022322",
                                "sense_id": "8b38fd18-a9fc-37f5-9751-4905b95bedc9",
                                "text": "Il y a quelques jours, à l’antenne de la très prestigieuse radio France Inter, la journaliste Sonia Devillers s’inquiétait ouvertement de ce qu’elle appelait la « droitisation » des chaînes d’information continue."
                            }
                        ]
                    }
                ],
