                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crush_grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable master prepared a trough filled with dry hay and <w>spelt</w> beans.",
                            "target_lang_translations": {
                                "pl": "Masztalerz przygotował koryto wypełnione suchym sianem i <w>śrutowanym</w> bobem."
                            }
                        },
                        {
                            "text": "Feeding sick horses with <w>spelt</w> beans was a common practice in earlier centuries.",
                            "target_lang_translations": {
                                "pl": "Karmienie chorych koni <w>rozdrobnionym</w> bobem było powszechną praktyką w dawnych wiekach."
                            }
