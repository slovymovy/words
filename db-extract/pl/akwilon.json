                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "12c37f6e-0bc8-45bb-af1b-09b6c1a0b169",
                        "source_entry_id": "9b8ba956-10bb-3b38-93ce-7768d11759cc",
                        "source_sense_id": "d617d3f6-c2cc-3a75-a8c8-90deedc2799e",
                        "target_lang_word": "Аквилон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Аквилон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "353ae169-7a2d-3b07-a4d5-710eec9a8f5f",
                                        "entry_id": "16776e98-5e71-39a9-b3bf-92dbe2359201",
                                        "glosses": [
                                            "древнеримское божество, олицетворяющее северо-восточный ветер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68815b3f-6ab5-41bf-bf62-d3ef0334d31d",
                                                "sense_id": "353ae169-7a2d-3b07-a4d5-710eec9a8f5f",
                                                "text": "Иногда порыв тугого ветра отводил от окна тяжелый занавес, надувая и кругля его, как парус, и тогда Самсон видел угол дворцовой башни с бронзовой фигурой Аквилона, бога северного ветра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3b9636-d2c3-3279-9c9a-a536d6e2cbf3",
                                        "entry_id": "16776e98-5e71-39a9-b3bf-92dbe2359201",
                                        "glosses": [
                                            "название ветра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608c3861-c632-421a-a501-ebece0dc6fa0",
                                                "sense_id": "bb3b9636-d2c3-3279-9c9a-a536d6e2cbf3",
                                                "text": "Из многочисленных промежуточных ветров Сенека упоминает только два: Кор и Аквилон (оба названия латинские)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0774a13e-92f2-3cfc-ada4-8f11c7aab2ed",
                                        "entry_id": "16776e98-5e71-39a9-b3bf-92dbe2359201",
                                        "glosses": [
                                            "античное и средневековое название земель, лежащих в северо-восточном направлении от Рима"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4c12ee-887f-48e4-8731-0c238d11dbbb",
                                                "sense_id": "0774a13e-92f2-3cfc-ada4-8f11c7aab2ed",
                                                "text": "В 1555 году великий французский провидец Нострадамус писал, что в начале XX в страну Аквилон (Россия. — Э. М.) придет сам Антихрист и будет править этой страной в двух обличиях, ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
