                        "cross_references": []
                    },
                    {
                        "translation_id": "0371e81c-7caa-4a2c-b98b-ecd4b375e251",
                        "source_entry_id": "2d0baf0d-b5b7-3f8f-ac2c-fba8916d10fb",
                        "source_sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
                        "target_lang_word": "patience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f9de87f-c539-3635-a770-b10b6208f49e",
                                        "entry_id": "6ba7d3d2-18ab-3f25-a209-6b9db630b6e9",
                                        "glosses": [
                                            "The quality of being patient."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e615a6ad-6283-470b-97f0-707e4d366a33",
                                                "sense_id": "5f9de87f-c539-3635-a770-b10b6208f49e",
                                                "text": "Musical perfection requires practice and a lot of patience."
                                            },
                                            {
                                                "example_id": "1ba7f72e-2701-4ef2-8def-b30f8466ff8b",
                                                "sense_id": "5f9de87f-c539-3635-a770-b10b6208f49e",
                                                "text": "I appreciate the patience with which you've explained it."
                                            },
                                            {
                                                "example_id": "7a2bafbe-96b3-4017-a680-42bd5dc2b37b",
                                                "sense_id": "5f9de87f-c539-3635-a770-b10b6208f49e",
                                                "text": "The most surprising thing was to discover that each job had its little tricks, peculiarities that had been learned in the experience of years, and one of the really pleasing features was the unlimited patience and kindliness of the chargehands and fitters, who would go to great lengths to teach the budding engineer all they themselves knew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0d795b-1a9a-312b-9ee2-557f6acfd1ca",
                                        "entry_id": "6ba7d3d2-18ab-3f25-a209-6b9db630b6e9",
                                        "glosses": [
                                            "Any of various card games that can be played by one person. Called solitaire in the US and Canada."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
