                    {
                        "sense_id": "e66b6946-ffc0-3d6d-9071-0770e2b331ff",
                        "entry_id": "18d98b11-0c25-320a-8186-1c035e042c23",
                        "glosses": [
                            "Cocktail composé de crème de cassis et de vin blanc (du bourgogne aligoté)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e32771c-9019-41b1-8883-1b5bd566dddc",
                                "sense_id": "e66b6946-ffc0-3d6d-9071-0770e2b331ff",
                                "text": "Elle l'écoutait à peine, encore bouleversée par ce qui venait de se passer. Et les deux Kir qu'elle avait bus coup sur coup achevaient de l'étourdir.\n– Un autre Kir ? Mais si, voyons… avec moi…"
                            },
                            {
                                "example_id": "52949649-d23f-4640-a439-0c2e6d00f47f",
                                "sense_id": "e66b6946-ffc0-3d6d-9071-0770e2b331ff",
                                "text": "Mais les traditions avaient la vie dure; les hommes se retrouvaient toujours pour une partie de quilles ou d'anneaux avant d'aller boire un pontarlier ou un kir au café."
                            }
                        ]
                    }
