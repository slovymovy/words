                                            {
                                                "example_id": "e083d222-8885-40bd-9f6a-4c9a6defb256",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "虐待動物"
                                            },
                                            {
                                                "example_id": "b7bcd51b-d01a-4ec1-a2bc-0d52ad2f3a93",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "虐待动物"
                                            },
                                            {
                                                "example_id": "a785fb7e-3d33-4103-ba18-d2c54191365e",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "珍稀動物"
                                            },
                                            {
                                                "example_id": "6ec0fe0b-7bd9-4c96-a67d-1b77aff04807",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "珍稀动物"
                                            },
                                            {
                                                "example_id": "ecba8b28-5ad7-4e2c-acf7-c2fa5bf004ec",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "你最想成為哪種動物？"
                                            },
                                            {
                                                "example_id": "1c2e601e-cc00-4839-a24c-3b5ac2e5efb4",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "你最想成为哪种动物？"
                                            },
                                            {
                                                "example_id": "b9123d07-2f54-4b69-b613-2e31ac3bcdf8",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "動物的尾巴有什麼功能？"
                                            },
                                            {
                                                "example_id": "fd579566-c8df-4079-9491-74b2512b5ed8",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "动物的尾巴有什么功能？"
                                            },
                                            {
                                                "example_id": "222c897d-c3b4-47e2-9d80-d307503eff95",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "急轉彎以避免撞到動物是造成車禍的主要原因。"
                                            },
                                            {
                                                "example_id": "5ccc196a-39f4-41e7-a52d-964fd375cd77",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "急转弯以避免撞到动物是造成车祸的主要原因。"
                                            },
                                            {
                                                "example_id": "ac727dbb-b241-4fd7-9d53-04371e456fc9",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "一曰山林，其動物宜毛物，其植物宜早物。",
                                                "translation": "一種是在山林裡面，那裡的動物大多是長毛的，那裡的植物大多是柞栗之類的。"
                                            },
                                            {
                                                "example_id": "09f4421c-71e8-471c-8d6b-5818b6dbcca9",
                                                "sense_id": "b7c1fd12-7b3c-3148-a704-98489ec5ffa2",
                                                "text": "一曰山林，其动物宜毛物，其植物宜早物。",
                                                "translation": "一種是在山林裡面，那裡的動物大多是長毛的，那裡的植物大多是柞栗之類的。"
                                            }
                                        ]
                                    },
