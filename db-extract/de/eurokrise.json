                "senses": [
                    {
                        "sense_id": "a0d6d930-8505-3439-8a33-f01514889de1",
                        "entry_id": "ef820519-7932-3590-ab32-8ef78c2a760d",
                        "glosses": [
                            "Krise in der Europäischen Währungsunion auf Grund einer Staatsschulden-, Banken- und Wirtschaftskrise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523c7a1c-ff73-43b7-8402-003f763e0b9a",
                                "sense_id": "a0d6d930-8505-3439-8a33-f01514889de1",
                                "text": "Die Eurokrise begann 2010."
                            },
                            {
                                "example_id": "a10dc800-919d-47b3-be93-62733e9483e4",
                                "sense_id": "a0d6d930-8505-3439-8a33-f01514889de1",
                                "text": "„An dieser Stelle zeigt sich, dass sich die Eurokrise zur eigenen Entität entwickelte, die durch originäre Prozesse zu volkswirtschaftlichen Problemen der Länder führte.“"
                            },
                            {
                                "example_id": "00760527-f581-4c37-b5c7-bd9306b5287a",
                                "sense_id": "a0d6d930-8505-3439-8a33-f01514889de1",
                                "text": "„Seit der Eurokrise kann sich dieses Land nicht länger vormachen, ein kleines, hilfloses Fleckchen am Rande des Weltgeschehens zu sein, von dem niemand etwas erwartet und das nicht in der Lage ist, international etwas zu bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
