                                    {
                                        "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                        "entry_id": "7e69dc38-4600-3784-9633-f3b8085bf008",
                                        "glosses": [
                                            "Communauté des blogueurs, ensemble des blogues."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe094f45-49cc-4802-afab-141552b4bebe",
                                                "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                                "text": "La blogosphère se déchaîne après la venue d’hommes politiques à la conférence sur le Web de demain."
                                            },
                                            {
                                                "example_id": "64ec715e-50a8-465a-b4fa-5c1a50aadd24",
                                                "sense_id": "376ef5e0-b458-335e-a496-3052b7126ad1",
                                                "text": "Avec l’augmentation du nombre de blogs, le phénomène du pollupostage (spam), à l'origine associé seulement au courrier électronique, pénètre aujourd'hui la blogosphère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
