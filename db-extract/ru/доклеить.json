                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f40945f-f939-4e6c-b080-f8cb195585e5",
                                "sense_id": "c86f2d82-a60d-3aa7-ba1d-6765226bdd7e",
                                "text": "Держа конец обоев в руке, он повернул голову и, улыбаясь, произнёс: ― Сейчас доклею!"
                            },
                            {
                                "example_id": "dd489f78-7d9e-44e2-a4ce-c899e3bd9c9a",
                                "sense_id": "c86f2d82-a60d-3aa7-ba1d-6765226bdd7e",
                                "text": "Вчера доклеили лодку…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c38b9537-4e79-3fb8-a4ff-ed0a1145c5e4",
                        "entry_id": "864e0e66-0516-3de6-9d1f-4125b2efa4f6",
                        "glosses": [
                            "спец. закончить монтировать видеоряд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236fa72c-f20e-4f39-88bc-e9d76096d4cd",
                                "sense_id": "c38b9537-4e79-3fb8-a4ff-ed0a1145c5e4",
                                "text": "Доклеить за полчаса эфира два минутных сюжета о культурке проще простого."
                            },
                            {
                                "example_id": "c7f6c7a7-59f7-4758-a3c4-11380617ac8e",
                                "sense_id": "c38b9537-4e79-3fb8-a4ff-ed0a1145c5e4",
                                "text": "А дня через два пришел в монтажную что-то доклеить и узнал, что фильм арестован."
                            }
                        ]
                    }
