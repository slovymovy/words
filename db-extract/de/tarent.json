                        "examples": [
                            {
                                "example_id": "d2a3aaa5-d5f5-4af9-8e46-877f8c35e11f",
                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                "text": "Tarent verdankt seine Existenz seit jeher seinen Meeren."
                            },
                            {
                                "example_id": "2110a1c1-7480-49b3-b264-a6fb958b08d6",
                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                "text": "Das griechische Tarent war […] in seiner Zeit des größten Glanzes in Akropolis, Polis und Nekropolis unterteilt."
                            },
                            {
                                "example_id": "733e6618-0091-42c7-9c44-501aa45ccb03",
                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                "text": "„Die Lukaner brauchten Hilfe gegen die Griechenstadt Tarent, welche den spartanischen König Kleonymos aus Griechenland zu ihrem Schutz herbeigerufen. hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
