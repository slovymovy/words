                    {
                        "sense_id": "1cc6d649-1bd9-37d9-b76c-067bb83ad6a7",
                        "entry_id": "f2e32a18-ce99-3cab-a133-d83bd8eef716",
                        "glosses": [
                            "Buildings, facilities, ships, bridges, highways, and other public works informally known as the JFK or JFK, especially",
