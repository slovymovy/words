                                    {
                                        "sense_id": "3c6a6c6e-4c5b-3443-ac62-7d6dc312a956",
                                        "entry_id": "b26ddd5f-dcdd-3b8e-95a9-e5311db95de1",
                                        "glosses": [
                                            "Free from blame, not open to reproach or criticism; blameless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e1375ed-f04f-42e8-9fa8-d2b48ebc3198",
                        "source_entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "source_sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "target_lang_word": "άμεμπτος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "άμεμπτος",
