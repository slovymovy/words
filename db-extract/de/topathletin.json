                "senses": [
                    {
                        "sense_id": "69515352-4178-3a1d-9d08-397d3d9f8556",
                        "entry_id": "c98371a4-7e5d-37f3-b1d9-d18ecfc97b53",
                        "glosses": [
                            "Sportlerin mit sehr guten sportlichen Leistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e34f7ec-a5b3-4222-aa52-5df6dd067c6f",
                                "sense_id": "69515352-4178-3a1d-9d08-397d3d9f8556",
                                "text": "„Nach Marlies Schild (nunmehr Raich) und Nicole Hosp hat eine weitere alpine ÖSV-Topathletin innerhalb eines Jahres ihre aktive Karriere beendet.“"
                            },
                            {
                                "example_id": "d556dcc8-cd87-4fde-bb2a-59e77246fa3d",
                                "sense_id": "69515352-4178-3a1d-9d08-397d3d9f8556",
                                "text": "„Ohne die Galionsfigur fehlt dem deutschen Frauen-Biathlon die Topathletin. Ohne Laura Dahlmeier war der DSV im Massenstart chancenlos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
