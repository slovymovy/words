                        "entry_id": "0f5710be-49b5-3ce4-bc29-39db14bc2834",
                        "glosses": [
                            "zupa składająca się z płynu (np. wywaru, mleka, piwa, wina) i rozpuszczonego w nim składnika, np. mąki, żółtka"
                        ],
                        "tags": [
