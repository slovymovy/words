                    {
                        "sense_id": "4f39ec3b-9f37-33e9-a3ae-eee30000e28a",
                        "entry_id": "9fd1c7f7-351c-3a4e-9a99-7362aa8cb534",
                        "glosses": [
                            "het haar van een persoon, de sierlijke haardracht van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bec6fc-6b45-4f8a-9824-404f88216206",
                                "sense_id": "4f39ec3b-9f37-33e9-a3ae-eee30000e28a",
                                "text": "Ook is de modern ogende, roodharige bruid al een voorbeeld voor vele Marokkaanse vrouwen die de bazaars afstruinen naar henna om hun haarkleur een extra dimensie te geven. Zodat ze kunnen wedijveren met de uitzonderlijk lange haartooi van de nieuwste koninklijke aanwinst."
                            },
                            {
                                "example_id": "ea3ec2eb-2263-4a12-a8d8-92ee5e467dec",
                                "sense_id": "4f39ec3b-9f37-33e9-a3ae-eee30000e28a",
                                "text": "Monique vertelt dat Anne Marie nog had aangeboden workshops te geven in het maken van haartooien, in Het Adamas Inloophuis, voor iedereen die met kanker te maken krijgt."
                            }
                        ]
                    }
