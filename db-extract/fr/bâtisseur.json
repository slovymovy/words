                    {
                        "sense_id": "20a3c002-065e-3b30-b424-2a0b5e16ca9c",
                        "entry_id": "d433c8c9-25ac-34a7-ab56-f44ea463c026",
                        "glosses": [
                            "Celui qui a l’habitude de faire bâtir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca94fd45-b608-4fcb-85a7-1fa706512208",
                                "sense_id": "20a3c002-065e-3b30-b424-2a0b5e16ca9c",
                                "text": "Dagobert était un grand bâtisseur d'églises et exerçait même la fonction d'aumônier."
                            }
                        ]
                    },
                    {
                        "sense_id": "32095d13-604e-3758-a921-b633ffd92df6",
                        "entry_id": "d433c8c9-25ac-34a7-ab56-f44ea463c026",
                        "glosses": [
                            "Celui qui essaie de bâtir de nouvelles choses pour le bien collectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03564f5d-02a1-4b67-ac37-e346f4cdd5e6",
                                "sense_id": "32095d13-604e-3758-a921-b633ffd92df6",
                                "text": "Ce n’était pas un spécialiste de la chose, c’était plutôt un socioprofessionnel, un bâtisseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d03be06f-e9f4-4b8f-9863-42c961936e55",
