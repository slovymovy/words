                                            {
                                                "example_id": "d68eb322-d10f-4534-a967-b304ef6cf2f8",
                                                "sense_id": "fda12387-a215-3e6e-9982-2eadc5d86690",
                                                "text": "De organisatie van het ziekenhuis heeft een piramidevormige structuur bestaande uit hiërarchieën met veel managementniveaus."
                                            }
                                        ]
