                "senses": [
                    {
                        "sense_id": "66f65948-7cba-3fe4-b7ec-7f5141f58991",
                        "entry_id": "bf9bda73-bb1c-3e8e-83ad-b97b7901de78",
                        "glosses": [
                            "Given to exaggeration or serving to exaggerate; overblown."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a454f277-6506-4002-ac54-64d729844977",
                                "sense_id": "66f65948-7cba-3fe4-b7ec-7f5141f58991",
                                "text": "Bombastic Style is an affectation in the composition, either in presenting simple or common ideas under sonorous and pompous expressions, or in speaking of things which have but a vain appearance of grandeur in the most exaggerating manner."
                            },
                            {
                                "example_id": "da7406c7-ebf6-4c72-bad0-2241803a5889",
                                "sense_id": "66f65948-7cba-3fe4-b7ec-7f5141f58991",
                                "text": "Then there are many men in the world, who, from a sincere desire of doing good, are, to say the least, very exaggerating in their phraseology, exalting mere indications of good into realities; and leaving altogether out of sight the reasoning of St. Paul on the subject, in the Epistle to the Romans, the 3rd chapter and 7th verse."
                            },
                            {
                                "example_id": "5055bbc8-9c8e-4835-9221-594d5fee7bb9",
                                "sense_id": "66f65948-7cba-3fe4-b7ec-7f5141f58991",
                                "text": "Now, I say it don't show anything, it is not a material point; but it shows how ridiculous men will be in their testimony, when actuated by violent motives, and it is one thing that I have noticed, gentlemen, that as a general thing lawyers are more ridiculous and more exaggerating when they give testimony than any other class of men."
                            },
                            {
                                "example_id": "0f66b4a6-ef6d-4f40-9b10-b8dd9edd6035",
                                "sense_id": "66f65948-7cba-3fe4-b7ec-7f5141f58991",
                                "text": "Bridget fanned her face in a very exaggerating way."
                            }
                        ]
                    }
                ],
