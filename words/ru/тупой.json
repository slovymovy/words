                {
                    "sense_id": "37e7e4b3-012a-33b9-9440-2d1a4b39b865",
                    "sense_definition": "Глухой, низкий, не звонкий (о звуке).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory_dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из подвала доносились странные <тупые> звуки.",
                            "target_lang_translations": {
                                "en": "Strange <dull> sounds came from the basement.",
                                "de": "Aus dem Keller waren seltsame, <w>dumpfe</w> Geräusche zu hören."
                            }
                        },
                        {
                            "text": "Послышался тяжёлый <тупой> удар мешка о землю.",
                            "target_lang_translations": {
                                "en": "A heavy <dull> thud of a sack hitting the ground was heard.",
                                "de": "Man hörte den schweren, <w>dumpfen</w> Aufprall eines Sacks auf dem Boden."
                            }
                        }
                    ],
                    "synonyms": [
                        "глухой",
                        "низкий"
                    ],
                    "antonyms": [
                        "звонкий",
                        "высокий"
                    ],
                    "common_phrases": [
                        "тупой звук",
                        "тупой удар"
                    ],
                    "target_lang_definitions": {
