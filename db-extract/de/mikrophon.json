                ],
                "senses": [
                    {
                        "sense_id": "d7d2ff62-e409-317f-8f68-1c8f3e7bdd54",
                        "entry_id": "12956678-bdce-348f-a8b6-c0f82c2ff52f",
                        "glosses": [
                            "ein technisches Gerät zur Aufnahme von Tönen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f4e38f-f22c-4eb7-b442-273c44aa73c9",
                                "sense_id": "d7d2ff62-e409-317f-8f68-1c8f3e7bdd54",
                                "text": "„Zufrieden mit dieser Vorstellung verließ Cold Cuts den Tisch und machte sich am Mikrophon zu schaffen.“"
                            },
                            {
                                "example_id": "d78381a3-c01a-43d3-bde7-1e275b5eda24",
                                "sense_id": "d7d2ff62-e409-317f-8f68-1c8f3e7bdd54",
                                "text": "„Als die Todesnachricht durchs Mikrophon gesagt wurde, ist das Publikum aufgestanden und hat Gerd mit einer Minute des Schweigens geehrt.“"
                            },
                            {
                                "example_id": "d1bb9259-dabb-4804-a23f-f94fbb73326d",
                                "sense_id": "d7d2ff62-e409-317f-8f68-1c8f3e7bdd54",
                                "text": "„Das vom Juniorchef eigens installierte Mikrophon klang, als nähme man die eigene Stimme mit einem Diktaphon auf und spielte sie dann über den Lautsprecher einer Bahnhofsanlage ab – und das alles unter Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
