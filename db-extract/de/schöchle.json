                "senses": [
                    {
                        "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                        "entry_id": "f081d14f-503a-32f6-8395-907821119829",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e473f732-9743-4d0c-85f9-ea7601292664",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Frau Schöchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "55903ea1-4ef4-46ea-a13e-bf79bb6436d2",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Herr Schöchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cb4e0bc9-ff96-4135-99b0-1d61a18bcb89",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Die Schöchles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "406f4b34-3c06-45a1-a3a9-5b7882013a47",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Der Schöchle trägt nie die Schals, die die Schöchle ihm strickt."
                            },
                            {
                                "example_id": "e16fdd20-34fc-415d-9aa0-b5030e762784",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöchle kommt, geht der Herr Schöchle.“"
                            },
                            {
                                "example_id": "4fe47d97-90b0-4206-963b-09531e2c519b",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Schöchle kommt und geht."
                            },
                            {
                                "example_id": "fa225696-33ed-4256-9954-5fc9881b0ee8",
                                "sense_id": "d450a415-37c7-3e38-a3eb-29bf168a808e",
                                "text": "Schöchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
