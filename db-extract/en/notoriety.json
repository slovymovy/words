                                "target_senses": [
                                    {
                                        "sense_id": "9c252914-6bb8-321b-987d-51f4240d2928",
                                        "entry_id": "23938d4f-545b-34e1-b774-350152c95e04",
                                        "glosses": [
                                            "die Tatsache, dass etwas offenkundig, (jedermann) bekannt ist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03f6f15-eca7-42a6-9996-e1fea1f4bcc4",
                                                "sense_id": "9c252914-6bb8-321b-987d-51f4240d2928",
                                                "text": "„Die notorietätsbegründenden Umstände - In seinem Kapitel 'Von kundtlich wissen' beschreibt der Laienspiegel drei Kategorien der Notorietät. Unterscheidungskriterium sind die Umstände, aus denen die Gewissheit resultiert.“"
                                            },
                                            {
                                                "example_id": "17cb9cac-0738-4a79-95dd-b1db3d716cc3",
                                                "sense_id": "9c252914-6bb8-321b-987d-51f4240d2928",
                                                "text": "„Man unterscheidet verschiedene Arten der Notorietät nach dem Umfange der Kreise, in welchem die fragliche Thatsache bekannt ist.“ (1857)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
