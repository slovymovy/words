                "senses": [
                    {
                        "sense_id": "8051eff0-ff63-394d-9ccb-bee2ae14b61f",
                        "entry_id": "83b92bd8-3a90-3680-85a6-3a6f4a19f487",
                        "glosses": [
                            "стремиться превзойти кого-либо в каком-либо отношении, добиться лучших результатов по сравнению с кем-либо"
                        ],
                        "tags": [],
