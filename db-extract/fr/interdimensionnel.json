                                            {
                                                "example_id": "5d159c8c-abc6-4ce1-8f07-92cfc250d931",
                                                "sense_id": "5be5b23a-6d04-3dea-ac80-7814a13e89ae",
                                                "text": "The spaceship made an interdimensional jump."
                                            },
                                            {
                                                "example_id": "d65fd2c8-24ec-4cb9-9cc4-d851c5ba06b9",
                                                "sense_id": "5be5b23a-6d04-3dea-ac80-7814a13e89ae",
                                                "text": "“I’m not crazy,” she said. “I’m literally just living a normal life while also, you know, discovering interdimensional communication.”"
                                            }
                                        ]
                                    }
                                ]
                            },
