                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ed096d-94db-4b84-b527-51f66f474380",
                                "sense_id": "e54a517a-5ffd-3615-83f6-a89dffc63dc4",
                                "text": "„Aus der Entlausung kamen sie alle mit kahl geschorenen Köpfen heraus, angeblich hatten sie alle Läuse.“"
                            },
                            {
                                "example_id": "2119bf62-1d8f-49aa-86ea-385308ebb73c",
                                "sense_id": "e54a517a-5ffd-3615-83f6-a89dffc63dc4",
                                "text": "„An dieser Adresse werden bei Bedarf Entlausungen duchgeführt.“"
                            },
                            {
                                "example_id": "5f98761f-41e4-4c0b-84c6-74c69b947866",
                                "sense_id": "e54a517a-5ffd-3615-83f6-a89dffc63dc4",
                                "text": "„Die Entlausung hatte den Gesamteindruck meiner Großmutter offenbar nicht wesentlich verbessert.“"
                            }
                        ],
