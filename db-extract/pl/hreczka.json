                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a9ec4b2b-cbfd-3eb0-85dd-68ff9ee929de",
                        "entry_id": "eb647883-161e-35fe-af7a-c4d26a282187",
                        "glosses": [
                            "reg. (Kraków) gw. (Bukowina) gryka"
                        ],
                        "tags": [
                            "Lviv",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "1d86b23c-bea5-4fb9-b93e-6c62b0b6adbc",
                                "sense_id": "a9ec4b2b-cbfd-3eb0-85dd-68ff9ee929de",
                                "text": "Łąki pokrywała para unosząca się ku górze; ptaki śpiewały, ludzie wyjeżdżali na pola; płowy łan żytni kołysał się pochylonymi kłosy, a kwitnąca hreczka zaprawiała wonią powietrze czyste, lekkie, którym miło było oddychać"
                            },
                            {
                                "example_id": "743602da-ce47-4e2a-aa7d-1c7ed298decf",
                                "sense_id": "a9ec4b2b-cbfd-3eb0-85dd-68ff9ee929de",
                                "text": "Oto co się dzieje w małych miasteczkach podczas wojny; ludzie, tak gorliwie zajmują się strategją, że im hreczka marnieje i emerytura w kasach miejsce zawala"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
