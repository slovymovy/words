                ],
                "senses": [
                    {
                        "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                        "entry_id": "0383e8ac-96d2-35d8-b6df-455890b09dee",
                        "glosses": [
                            "(männliche^☆) Person, die das Lippenlesen beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "331b2975-78c1-4c06-8742-7d93f34048c5",
                                "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                                "text": "„Wieso reden so viele Spieler bei dieser WM eigentlich nur hinter vorgehaltener Hand? Schuld sind professionelle Lippenleser, die jeden Fluch und jede Lästerei auf dem Platz live übersetzen.“"
                            },
                            {
                                "example_id": "34c3d390-c5a8-44b0-bd0b-98837cccb51e",
                                "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                                "text": "„Scharen von bezahlten Lippenlesern machen bei dieser Weltmeisterschaft den Fußballspielern das Reden zur Hölle.“"
                            },
                            {
                                "example_id": "56003c7a-24b6-49fd-9da1-25d3a86a73f8",
                                "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                                "text": "„Im deutschen Fußball ist eine Debatte über den Einsatz von Lippenlesern entbrannt.“"
                            },
                            {
                                "example_id": "a552d210-e000-4579-bf99-f123cb0208f1",
                                "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                                "text": "„Eine Ausnahme dürfte die Schimpftirade samt Handgeste beim Torjubel in der 89. Minute gewesen sein, aus der Lippenleser inzwischen ihre Schlüsse gezogen haben wollen.“"
                            },
                            {
                                "example_id": "29947c18-959e-4108-8330-651252f46478",
                                "sense_id": "2aa3e2c8-93d1-30ba-a859-adec4d066d72",
                                "text": "„Als er mich erkannte, formten seine Lippen einige japanische Worte, eine hörbare Drohung wollte er wohl nicht ausstoßen. Aber mir kam es auf jeden Fall wie eine Drohung vor, doch ich bin in keiner Sprache ein guter Lippenleser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
