                                "target_senses": [
                                    {
                                        "sense_id": "8704ea1e-14da-3777-8a83-815e62e2fb59",
                                        "entry_id": "b288f0e0-0f29-319c-aae5-049a69b34eb6",
                                        "glosses": [
                                            "nachdrückliche Versicherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccaeb021-773f-4092-b7f9-9bf8064aacbf",
                                                "sense_id": "8704ea1e-14da-3777-8a83-815e62e2fb59",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "ee570aa8-d80b-47ab-8375-b3e30e982b87",
                                                "sense_id": "8704ea1e-14da-3777-8a83-815e62e2fb59",
                                                "text": "„Spätestens jetzt fiel es Ari schwer, dieser wiederholten Beteuerung Glauben zu schenken.“"
                                            }
                                        ],
