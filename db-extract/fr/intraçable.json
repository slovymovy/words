                                        "glosses": [
                                            "Not able to be traced or tracked down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584cbe08-3a6b-4298-bc86-a3042dd3a66b",
                                                "sense_id": "cf195c7b-bae1-3de9-8037-c6720101246e",
                                                "text": "Then there is bitcoin, the cryptocurrency that has been skyrocketing in value lately. Bitcoin is basically virtual cash — anonymous, untraceable currency stuffed into a mobile wallet."
                                            },
                                            {
                                                "example_id": "ddfd9ec6-445f-4a84-b602-f222e79cf19f",
                                                "sense_id": "cf195c7b-bae1-3de9-8037-c6720101246e",
                                                "text": "The core idea of the Nostega paradign is basically camouflaging messages by embedding them in a form of noiseless data by employing either altered authenticated data or legitimate untraceable data, as shown in Section 1.3."
                                            }
