                                        "examples": [
                                            {
                                                "example_id": "19b9584e-e6c6-4e04-96aa-169be4fa3ebe",
                                                "sense_id": "b4deba0f-8719-356a-ad7c-c9b277be63df",
                                                "text": "The bath water gurgled down the drain."
                                            },
                                            {
                                                "example_id": "5d406f89-6241-42e7-93af-3c573cf55ca7",
                                                "sense_id": "b4deba0f-8719-356a-ad7c-c9b277be63df",
                                                "text": "Pure gurgling rills the lonely deſart trace, / And vvaſte their muſick on the ſavage race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e9d217-c53e-372f-8cd6-9788123458a9",
                                        "entry_id": "5f1a7d3a-2e96-3022-a4f4-19ae2f75e4a8",
                                        "glosses": [
                                            "To make such a sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
