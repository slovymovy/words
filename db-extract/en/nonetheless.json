                                        "examples": [
                                            {
                                                "example_id": "276dc610-c849-4930-a189-b283fc2cb936",
                                                "sense_id": "b3691f13-9c39-3159-85a3-42ab301a0cbb",
                                                "text": "Барин не выдержал и рассмеялся, но тем не менее он тронут был глубоко в душе своей."
                                            },
                                            {
                                                "example_id": "c7877622-b6d5-4bb4-823b-9647b847aee2",
                                                "sense_id": "b3691f13-9c39-3159-85a3-42ab301a0cbb",
                                                "text": "Тем не менее нам, русским, деньги тоже нужны, — прибавил я, — а следственно, мы очень рады и очень падки на такие способы, как например рулетки, где можно разбогатеть вдруг, в два часа, не трудясь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffc5bf0f-8904-4e02-9305-499b341f76c5",
                        "source_entry_id": "724ef01f-9a1d-3a37-b269-e9ccb2db5c14",
                        "source_sense_id": "d12b6dde-e3cd-30cf-a72f-982a254b6126",
                        "source_sense_description": "nevertheless",
                        "target_lang_word": "no obstante",
