{
    "word_family": [
        "deform",
        "deformation",
        "deformed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f9f856f-ed74-3de6-bdee-e04fa23dfc68",
                    "sense_definition": "An ugly, misshapen, or malformed part of the body or a physical feature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_malformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident left him with a slight facial <w>deformity</w> that was barely noticeable.",
                            "target_lang_translations": {
                                "ru": "Авария оставила у него небольшое <w>уродство</w> лица, которое было едва заметно."
                            }
                        },
                        {
                            "text": "She worked with children born with limb <w>deformities</w> to help them regain mobility.",
                            "target_lang_translations": {
                                "ru": "Она работала с детьми, рожденными с <w>деформациями</w> конечностей, чтобы помочь им восстановить подвижность."
                            }
                        }
                    ],
                    "synonyms": [
                        "malformation",
                        "disfigurement",
                        "distortion"
                    ],
                    "common_phrases": [
                        "facial deformity",
                        "limb deformity",
                        "physical deformity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уродливая, деформированная или неправильно сформированная часть тела или физическая особенность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформация",
                                "target_lang_sense_clarification": "изменение формы органа или части тела"
                            },
                            {
                                "target_lang_word": "уродство",
                                "target_lang_sense_clarification": "врожденный или приобретенный физический недостаток"
                            },
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "отклонение от нормального строения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac85f16a-0300-3f43-b1d7-0a08b56bc953",
                    "sense_definition": "The state or condition of being deformed or misshapen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_malformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the congenital <w>deformity</w> could be corrected with surgery.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что врожденную <w>деформацию</w> можно исправить с помощью операции."
                            }
                        },
                        {
                            "text": "Severe <w>deformity</w> of the spine can cause significant pain and breathing difficulties.",
                            "target_lang_translations": {
                                "ru": "Тяжелое <w>искривление</w> позвоночника может вызывать сильную боль и затруднение дыхания."
                            }
                        }
                    ],
                    "synonyms": [
                        "misshapenness",
                        "malformation"
                    ],
                    "antonyms": [
                        "symmetry",
                        "shapeliness"
                    ],
                    "common_phrases": [
                        "congenital deformity",
                        "severe deformity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество деформированности, искаженности формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформация",
                                "target_lang_sense_clarification": "состояние искаженной формы"
                            },
                            {
                                "target_lang_word": "искривление",
                                "target_lang_sense_clarification": "нарушение правильной формы, например, позвоночника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}