                                        "sense_id": "359b35df-f886-32a5-82b7-54b8a52e4872",
                                        "entry_id": "03f620d4-9266-316c-981a-b9e99b9dfda9",
                                        "glosses": [
                                            "The fascist ideology of the Nazi-aligned Arrow Cross Party, which ruled Hungary from 1944 to 1945, and of its predecessors and subsequent far-right supporters."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e57e59-f9c3-4d32-a4cb-3f0bc81081b0",
                                                "sense_id": "359b35df-f886-32a5-82b7-54b8a52e4872",
                                                "text": "A revised Party programme allowed, in foreign policy, for “adjustment to the New Order devised by the Axis Powers,” but only in so far as this was compatible with Hungarism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4b1ca2e-2c84-436f-8c99-5a2d67686aed",
                        "source_entry_id": "d0adca8f-75b6-34e6-9931-58d8b4e25c6a",
                        "source_sense_id": "c7a55062-7401-3055-90b0-df1765151df8",
