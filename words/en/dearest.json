    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af10ef7b-46c1-340f-b1c0-03bdbcb2cddd",
                    "sense_definition": "Superlative form of <w>dear</w>: most dear; most loved or cherished.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote a letter to her <w>dearest</w> friend who lived across the country.",
                            "target_lang_translations": {
                                "es": "Le escribió una carta a su <w>más querida</w> amiga, que vivía al otro lado del país."
                            }
                        },
                        {
                            "text": "Fulfilling that dream was one of my mother's <w>dearest</w> wishes.",
                            "target_lang_translations": {
                                "es": "Cumplir ese sueño era uno de los deseos <w>más preciados</w> de mi madre."
                            }
                        }
                    ],
                    "synonyms": [
                        "beloved"
                    ],
                    "common_phrases": [
                        "dearest friend",
                        "dearest wish"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "superlative form"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma superlativa de querido: el más querido, amado o apreciado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "más querido",
                                "target_lang_sense_clarification": "persona o cosa más estimada"
                            },
                            {
                                "target_lang_word": "más preciado",
                                "target_lang_sense_clarification": "deseos, objetos o recuerdos muy valorados"
                            },
                            {
                                "target_lang_word": "queridísimo",
                                "target_lang_sense_clarification": "muy querido, frecuente en cartas o trato afectuoso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a63d7de-72f8-3806-8b27-8235ca3e205d",
                    "sense_definition": "A beloved person; used especially as a term of endearment or affectionate form of address.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Would you please pass the salt, my <w>dearest</w>?",
                            "target_lang_translations": {
                                "es": "¿Me pasarías la sal, por favor, <w>cariño</w>?"
                            }
                        },
                        {
                            "text": "She hugged her <w>dearest</w> tightly before he boarded the train.",
                            "target_lang_translations": {
                                "es": "Abrazó con fuerza a su <w>amor</w> antes de que subiera al tren."
                            }
                        }
                    ],
                    "synonyms": [
                        "beloved",
                        "darling",
                        "honey",
                        "sweetheart"
                    ],
                    "common_phrases": [
                        "my dearest"
                    ],
                    "target_lang_definitions": {
                        "es": "Persona amada; utilizado especialmente como apelativo cariñoso o término de cariño."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "amor mío",
                                "target_lang_sense_clarification": "apelativo cariñoso a la pareja"
                            },
                            {
                                "target_lang_word": "cariño",
                                "target_lang_sense_clarification": "término afectuoso común"
                            },
                            {
                                "target_lang_word": "querido",
                                "target_lang_sense_clarification": "persona amada o estimada"
                            }
                        ]
                    }
                }
