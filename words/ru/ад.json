            "pos": "noun",
            "senses": [
                {
                    "sense_id": "099db2d5-341b-3ceb-99d7-8fbeb53f1cf7",
                    "sense_definition": "Место, где, по религиозным представлениям, души грешников после смерти подвергаются вечным мукам; преисподняя.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Грешники боятся, что после смерти их души попадут в <w>ад</w>.",
                            "target_lang_translations": {
                                "en": "Sinners fear that after death their souls will go to <w>hell</w>.",
                                "es": "Los pecadores temen que después de la muerte sus almas vayan al <w>infierno</w>.",
                                "fr": "Les pécheurs craignent qu'après la mort leurs âmes n'aillent en <w>enfer</w>."
                            }
                        },
                        {
                            "text": "В своей книге автор подробно описал девять кругов <w>ада</w>.",
                            "target_lang_translations": {
                                "en": "In his book, the author described the nine circles of <w>hell</w> in detail.",
                                "es": "En su libro, el autor describió detalladamente los nueve círculos del <w>infierno</w>.",
                                "fr": "Dans son livre, l'auteur a décrit en détail les neuf cercles de l'<w>enfer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "преисподняя",
                        "пе́кло",
                        "гее́нна",
                        "подземное царство"
                    ],
                    "antonyms": [
                        "рай",
                        "эдем"
                    ],
                    "common_phrases": [
                        "гореть в аду",
                        "исчадие ада",
                        "страх ада"
                    ],
                    "target_lang_definitions": {
                        "en": "A place where, according to religious beliefs, the souls of sinners are subjected to eternal torment after death; the underworld.",
                        "es": "Lugar donde, según las creencias religiosas, las almas de los pecadores son sometidas a tormento eterno tras la muerte; el inframundo.",
                        "fr": "Lieu où, selon les croyances religieuses, les âmes des pécheurs sont soumises à des tourments éternels après la mort ; le monde des morts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hell",
                                "target_lang_sense_clarification": "religious concept"
                            },
                            {
                                "target_lang_word": "the underworld",
                                "target_lang_sense_clarification": "mythological context"
                            },
                            {
                                "target_lang_word": "inferno",
                                "target_lang_sense_clarification": "literary or fiery place"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "infierno",
                                "target_lang_sense_clarification": "concepto religioso"
                            },
                            {
                                "target_lang_word": "inframundo",
                                "target_lang_sense_clarification": "contexto mitológico"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "enfer",
                                "target_lang_sense_clarification": "concept religieux"
                            },
                            {
                                "target_lang_word": "enfers",
                                "target_lang_sense_clarification": "contexte mythologique (souvent au pluriel)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b9ba96-a74e-3776-9913-abae49453d5f",
                    "sense_definition": "Обстановка, ситуация или условия жизни, пребывание в которых мучительно, невыносимо (шум, хаос, ссоры).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "figurative_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за постоянного шума и скандалов соседей моя жизнь превратилась в <w>ад</w>.",
                            "target_lang_translations": {
                                "en": "Due to the constant noise and neighbors' scandals, my life turned into <w>hell</w>.",
                                "es": "Debido al ruido constante y los escándalos de los vecinos, mi vida se convirtió en un <w>infierno</w>.",
                                "fr": "À cause du bruit constant et des disputes des voisins, ma vie est devenue un <w>enfer</w>."
                            }
                        },
                        {
                            "text": "На вокзале творился настоящий <w>ад</w>: люди кричали и толкались.",
                            "target_lang_translations": {
                                "en": "It was absolute <w>hell</w> at the station: people were screaming and pushing.",
                                "es": "En la estación había un verdadero <w>infierno</w>: la gente gritaba y se empujaba.",
                                "fr": "C'était un véritable <w>enfer</w> à la gare : les gens criaient et se bousculaient."
                            }
                        }
                    ],
                    "synonyms": [
                        "пе́кло",
                        "ужас",
                        "хаос"
                    ],
                    "antonyms": [
                        "рай"
                    ],
                    "common_phrases": [
                        "настоящий ад",
                        "кромешный ад",
                        "превратить жизнь в ад",
                        "пройти через ад"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe unbearable situations"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An environment, situation, or living conditions that are painful or unbearable to be in (noise, chaos, quarrels).",
                        "es": "Entorno, situación o condiciones de vida que resultan dolorosos o insoportables (ruido, caos, discusiones).",
                        "fr": "Situation, environnement ou conditions de vie particulièrement pénibles, insupportables ou chaotiques."
                    },
