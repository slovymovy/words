                {
                    "sense_id": "9ccea8b0-bfbc-3dce-a0bd-8729c20c702e",
                    "sense_definition": "But; however; used to introduce a statement that modifies or reduces the effect of the previous statement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room is quite small, <w>although</w> it is very comfortable.",
                            "target_lang_translations": {
                                "ru": "Комната довольно маленькая, <w>хотя</w> очень уютная.",
                                "nl": "De kamer is vrij klein, <w>hoewel</w> hij erg comfortabel is.",
                                "pl": "Pokój jest dość mały, <w>chociaż</w> bardzo przytulny.",
                                "de": "Das Zimmer ist ziemlich klein, <w>obwohl</w> es sehr gemütlich ist.",
                                "fr": "La pièce est assez petite, <w>quoiqu'</w>elle soit très confortable.",
                                "it": "La stanza è piuttosto piccola, <w>anche se</w> è molto comoda.",
                                "cs": "Pokoj je docela malý, <w>i když</w> je velmi útulný.",
