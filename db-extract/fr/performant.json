                        "form": "performante"
                    },
                    {
                        "form_id": "8a466326-e4a3-4214-9566-87bfb0fe1328",
                        "entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "performantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c9915ba-158c-3e60-8cf8-bdec0c2244cc",
                        "entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "glosses": [
                            "Capable de performance, compétitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1578796-0cbd-4dee-a53a-819cd20a6d01",
                                "sense_id": "2c9915ba-158c-3e60-8cf8-bdec0c2244cc",
                                "text": "Nils Guyon, très performant en Catalogne comme lors de tous les tournois estivaux de 2021, est encore de la fête."
                            },
                            {
                                "example_id": "5d1fa9f2-81a7-4668-aed2-20ca520d78ca",
                                "sense_id": "2c9915ba-158c-3e60-8cf8-bdec0c2244cc",
                                "text": "On a une voiture plus performante, de six ou sept dixièmes au tout, mais les stratèges ont fait n’importe quoi en faisant rentrer Leclerc pour lui mettre des gommes dures, pas du tout performantes, se désole le twitto."
                            },
                            {
                                "example_id": "de1bb2a4-63ff-45eb-b7b8-944a5be4b37b",
                                "sense_id": "2c9915ba-158c-3e60-8cf8-bdec0c2244cc",
                                "text": "Perforants et performants, les Cognaco-Angériens menaient 28-7 à la pause avant de se faire chahuter durant le second acte."
                            },
                            {
                                "example_id": "3d0f5e46-36ce-40a0-9a27-c3118bb84c25",
                                "sense_id": "2c9915ba-158c-3e60-8cf8-bdec0c2244cc",
                                "text": "Selon la direction de l'évaluation, de la prospective et de la performance (Depp), qui a publié une note d'information sur les résultats, environ un élève sur trois en quatrième (32,4%) se situe parmi les moins performants en français, 38,5% dans la moyenne et 29% parmi les plus performants."
                            }
                        ]
                    },
                    {
                        "sense_id": "220d2c2b-298e-3d00-87ea-fd30f04cec94",
                        "entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "glosses": [
                            "Qui fonctionne bien, productif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e2214b-3da6-4a8e-9856-b25a2c774927",
                                "sense_id": "220d2c2b-298e-3d00-87ea-fd30f04cec94",
                                "text": "Cet ordinateur n'est pas très performant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c2987cb-94a0-420f-8141-0a6fcfb12954",
                        "source_entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "target_lang_word": "efficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Making good, thorough, or careful use of resources; not consuming extra. Especially, making good use of time or energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5e514b-4139-4f78-97ec-7a88019a11b4",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An efficient process would automate all the routine work."
                                            },
                                            {
                                                "example_id": "4a701c63-fe41-4fe1-89e5-d43dde80c8af",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "Our cleaners are almost too efficient: they throw away anything left out on a desk."
                                            },
                                            {
                                                "example_id": "66c5afe3-d585-466f-962c-6865cc5c1e81",
                                                "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Expressing the proportion of consumed energy that was successfully used in a process; the ratio of useful output to total input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc42af8-09fc-4f24-ac1a-61fb26cbb7a4",
                                                "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                                                "text": "The motor is only 20% efficient at that temperature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "Causing effects, producing results; bringing into being; initiating change (rare except in philosophical and legal expression efficient cause = causative factor or agent)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e14d528-4abf-416a-b9d0-bcb7976e94b8",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "Ownership, maintenance, or use of the automobile need not be the direct and efficient cause of the injury sustained"
                                            },
                                            {
                                                "example_id": "a50a1016-f640-4ed6-81b6-bed8354cd4b0",
                                                "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                                                "text": "It was well said of Plotinus, that the stars were significant, but not efficient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                        "entry_id": "ef6e836e-04c6-3c80-b3ba-0b6c12fe4019",
                                        "glosses": [
                                            "effective, efficacious"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfbec1c-65bd-48e5-964b-821a2e8156e1",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "Ye wake no more to anguish;‥ ye have borne\nThe Chosen, the Destroyer!‥ soon his hand\nShall strike the efficient blow;\nSoon shaking off your penal forms, shall ye,\nWith songs of joy, amid the Eden groves,\nHymn the Deliverer’s praise!"
                                            },
                                            {
                                                "example_id": "bc8942a4-614a-4fce-99b1-35305c32284b",
                                                "sense_id": "ab66cafd-4fed-3aff-95e2-896d59668f44",
                                                "text": "The Efficient Cause is that from which emanates the force that produces the Effect"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "efficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                        "entry_id": "dec2f9e4-f053-37f5-aaa8-448ccfe10554",
                                        "glosses": [
                                            "A cause; something that causes an effect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c361c7-e3ba-45f5-bdb2-c369b0ee0655",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "Some are without efficient, as God; others without matter, as Angels […]."
                                            },
                                            {
                                                "example_id": "83e1d88c-3398-49e1-ba75-58f0e8b3079d",
                                                "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                                                "text": "This implies, that something happens without a cause. If it should be said, that motive in this case is not the efficient of the action or doing — this is granted; but at the same time, for reasons already given, it is denied, that the man himself is the efficient cause of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ab781c9-a272-4983-b34e-da2cd06b3d5d",
                        "source_entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "target_lang_word": "effective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Having the power to produce a required effect or effects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0d2105-c319-4d02-8f87-df8558bf288e",
                                                "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                                "text": "The pill is an effective method of birth control."
                                            },
                                            {
                                                "example_id": "5bf3f7f7-547e-4ea8-8cae-54d388b14feb",
                                                "sense_id": "92f6bc92-7f40-390a-af22-7d74a6ae81b9",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Producing a decided or decisive effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d340ef83-97ad-41e2-ac46-bf0a046e7d98",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "The president delivered an effective speech!"
                                            },
                                            {
                                                "example_id": "9e7874d0-b8ae-4fae-b345-a9436ea9a616",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "Whosoever is an effective, real cause of doing his neighbour wrong, is criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Efficient, serviceable, or operative, available for useful work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03884e67-bda6-4cac-a6cc-675bf35dcbbb",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "How long does it take to make a bunch of civilians an effective military force?"
                                            },
                                            {
                                                "example_id": "cd0b53c0-6a07-4d45-bd1b-a33709e21a07",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "My effective income after taxes and child support is $500 a month."
                                            },
                                            {
                                                "example_id": "f5bfddbf-0512-4471-9c6a-4f7da1dec171",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective radiated power is determined by multiplying the transmitter power output with the antenna gain."
                                            },
                                            {
                                                "example_id": "065ffb7e-cf61-44e2-86c3-e031e92e4214",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective voltage of an alternating current is 0.7 times its peak voltage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Actually in effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c70d38c5-299a-442c-a116-55b98878150d",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "effective immediately"
                                            },
                                            {
                                                "example_id": "e2a3dbee-98cf-4d48-9fc3-6cc9b9b931ce",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "The curfew is effective at midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9576b30d-3f51-3ce5-b03a-72594d4008f8",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Having no negative coefficients."
                                        ],
                                        "tags": [
                                            "of a cycle or divisor"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0636d0b3-9ee3-3eb9-a4de-824261a73174",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Such that no group element acts trivially."
                                        ],
                                        "tags": [
                                            "of a group action"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36ff4799-ea97-3dd5-b985-9b52714f9e5a",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "approximate; Not describing the fundamental dynamic changes in some system as they happen."
                                        ],
                                        "tags": [
                                            "for any effective theory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "effective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f760f64-8fa0-3390-99f5-460f2d0dc0b3",
                                        "entry_id": "c1699abd-5509-39d5-8343-c113c87b40b0",
                                        "glosses": [
                                            "a soldier fit for duty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89190bf0-aa25-49d6-bcb8-c8e845a143e7",
                                                "sense_id": "8f760f64-8fa0-3390-99f5-460f2d0dc0b3",
                                                "text": "The Army of the West reached Corinth sometime after the battle of Shiloh. We were 15,000 effectives, and brought Beauregard's effective force up to 45,000 men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7a78a0e-302a-4ccb-a84e-3d5281e350da",
                        "source_entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "target_lang_word": "performant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "performant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d73da9-337b-3c3d-85cd-94f887919d89",
                                        "entry_id": "3b087365-b797-3ba7-a6e7-44bb3c5fe29b",
                                        "glosses": [
                                            "Of or relating to performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2055050-aae0-4f52-a544-3dbf31d7cf0e",
                                                "sense_id": "a4d73da9-337b-3c3d-85cd-94f887919d89",
                                                "text": "A ballet visibly stresses the performant function even though, traditionally, it also claims to communicate some meaning. In sports, the performant function dominates more openly; but, in a symbiotic relation, it derives much of its vitality from a grafted referential function that operates through cultural signs. [...] As a rule, however, the performant function, when it is supported by truly impressive circus performances, tends to monopolize the audience's attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                        "entry_id": "3b087365-b797-3ba7-a6e7-44bb3c5fe29b",
                                        "glosses": [
                                            "Performing well; Capable of or characterized by a high or excellent level of performance or efficiency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b520434f-43fc-4247-acb4-024453783003",
                                                "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                                "text": "The inhabitants commonly use pacing Naggs, singularly performant in travaille, and easily kept in good case."
                                            },
                                            {
                                                "example_id": "17329c90-3d86-4bd3-a704-0824ebe8c518",
                                                "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                                "text": "Nevertheless, it should be realized that most of the trials were conducted with poorly performant neutron installations (similar to old 200 kV X-ray units)."
                                            },
                                            {
                                                "example_id": "7e3f10cd-36c1-4ec9-90e6-edffeb0026bd",
                                                "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                                "text": "Within the Columbus program, the studies defining and optimizing the pressurized spaces must be based on extremely rigorous and highly performant modular and repetitive geometric dimensions, in compliance with ergonomic data inherent to the indispensable presence of man."
                                            },
                                            {
                                                "example_id": "c1db7a63-a7d9-4952-92ed-5dd9f231cdd8",
                                                "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                                "text": "Results suggest that shear actuators can be more performant than extension ones for the control of bending operations."
                                            },
                                            {
                                                "example_id": "cc4b64dc-2aa0-4399-ba59-844af294998f",
                                                "sense_id": "638336a0-422c-39fc-8599-f8d663eb39fb",
                                                "text": "In our energy-conscious society, materials and structures are required to be more performant, lightweight, and cheap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                        "entry_id": "3b087365-b797-3ba7-a6e7-44bb3c5fe29b",
                                        "glosses": [
                                            "Performing well; Capable of or characterized by a high or excellent level of performance or efficiency.",
                                            "Characterized by a level of performance or efficiency that is adequate for or exceeds the expectations of end users."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1f4d98-bf94-48ff-a340-594ee37fd3d5",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "The program ALGOLOG is highly performant: it generated 259 linear subproblems, instead of 2²³."
                                            },
                                            {
                                                "example_id": "c028163b-9f64-4f54-934f-986144cb3e7b",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "Recently, a pure view-based object recognition approach was proposed, that is surprisingly performant."
                                            },
                                            {
                                                "example_id": "62e304dd-ceea-481b-9a9c-cd46face8acc",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "There are strong arguments that some features of J2EE, such as entity beans, can never be as performant in many situations as some alternatives."
                                            },
                                            {
                                                "example_id": "404a0676-3314-4772-8ec0-9def839f293c",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "Yahoo uses YUI in their products, and as a result it is highly performant and well-tested."
                                            },
                                            {
                                                "example_id": "222dc906-445b-490c-91c6-240fceb26e8a",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "While we can run a plethora of tools against our code to check its quality in advance, there really is no substitute for running that code within a web browser to ensure not only that it runs correctly but also that it is performant and memory-efficient."
                                            },
                                            {
                                                "example_id": "dee845d5-a3de-410a-9dad-5c78473c0361",
                                                "sense_id": "d6123e87-2d84-3fec-9039-f990ab9f0ebe",
                                                "text": "To keep the computational requirements within the reach of even aged and low-performant personal computers, computationally intensive operations are avoided."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "performant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                        "entry_id": "317c4393-a7ba-3495-aced-cf652ec363f5",
                                        "glosses": [
                                            "Someone who performs something, such as a ritual; a performer."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9de13a-d772-4973-a0f2-4d0d09221263",
                                                "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                                "text": "As my heart bears me full witness with what unalloyed satisfaction I should have seen this last duty in your hands or in D. Giddy's, so I feel myself permitted to avow the pain, yea, the sense of shame, with which I contemplate Dr. Stock as the performant."
                                            },
                                            {
                                                "example_id": "d62dc3b7-7d27-4085-9134-81a2235b5d21",
                                                "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                                "text": "That there is considerable drollery and fun in the work, alike of the pencil and the pen in this morceau, it were idle to deny. That the performant [Henry Louis Stephens] wields both with not a little freedom, nimbleness and ease, is obvious on inspection."
                                            },
                                            {
                                                "example_id": "d42e0e37-216a-4f13-b4e1-dcd49e08d5b6",
                                                "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                                "text": "It would appear then that the Mycenaean lion-cult involved not only an animal oblation and a ὑδροφορία or λουτροφορία—in one case for the purpose of watering a sacred palm—but also a mimetic dance. The performants of these several offices were dressed in artificial lion-skins, and probably called by the name of λέοντες."
                                            },
                                            {
                                                "example_id": "f4624b59-3494-48c0-8f89-b280ad8b6367",
                                                "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                                "text": "If a performant happens to be on unfriendly terms with any one in the village, the performant does everything to get him reconciled long before the preparation is taken in hand."
                                            },
                                            {
                                                "example_id": "1ae28b27-f491-4bb4-9476-628eb2b7501d",
                                                "sense_id": "08c6d05e-3bc6-30c4-a308-1c3cfd3a0f4e",
                                                "text": "Present-day musicologists in Rajasthan studying the Dev Nārāyaṇ or Pābūjī performance pay their performants by the hour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4af3959-6ceb-413c-981b-90a61b8ef6f3",
                        "source_entry_id": "0fd1be24-8296-3390-a003-49031bf438f1",
                        "target_lang_word": "competitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "competitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                        "entry_id": "7cdd1bc8-c7ec-3bd2-a0f2-bea9855105e6",
                                        "glosses": [
                                            "Of or pertaining to competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a5affc-d1a6-4b71-b907-06dbd7684714",
                                                "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                                "text": "The final remnants of the competitive spirit between companies will be eliminated, and there is no reasonable prospect that the dull uniformity of standardisation will be offset by greater efficiency in operation."
                                            },
                                            {
                                                "example_id": "9d7b413a-dd76-40ca-b575-28df839a10cc",
                                                "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                                "text": "Manchester United's Tom Cleverley impressed on his first competitive start and Lampard demonstrated his continued worth at international level in a performance that was little more than a stroll once England swiftly exerted their obvious authority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1256c8c3-29c4-3aee-bc4e-04826204132b",
                                        "entry_id": "7cdd1bc8-c7ec-3bd2-a0f2-bea9855105e6",
                                        "glosses": [
                                            "Inclined to compete."
                                        ],
                                        "tags": [
                                            "of someone's character"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7eafbece-e6a7-33c6-a65d-d683dcd8e4e7",
                                        "entry_id": "7cdd1bc8-c7ec-3bd2-a0f2-bea9855105e6",
                                        "glosses": [
                                            "Capable of competing successfully."
                                        ],
                                        "tags": [],
