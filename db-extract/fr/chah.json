                "senses": [
                    {
                        "sense_id": "c30e4945-910b-3889-95eb-e64aece6e926",
                        "entry_id": "3f2f69d4-3663-32b2-af5d-6597a2b049be",
                        "glosses": [
                            "Titre des monarques de Perse, puis de l’Iran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0bcd482-c732-471e-808c-e27e475ef40b",
                                "sense_id": "c30e4945-910b-3889-95eb-e64aece6e926",
                                "text": "Abbas le Grand est le cinquième chah séfévide de Perse."
                            },
                            {
                                "example_id": "b28ee4da-2496-47e8-b93d-dd131aa5a07b",
                                "sense_id": "c30e4945-910b-3889-95eb-e64aece6e926",
                                "text": "Les uns comme les autres passaient du chah au sultan, et inversement, au gré de leurs intérêts du moment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "911ee82f-ecc7-4d6f-b5f3-4fd232eef065",
                        "source_entry_id": "3f2f69d4-3663-32b2-af5d-6597a2b049be",
                        "source_sense_id": "c30e4945-910b-3889-95eb-e64aece6e926",
                        "source_sense_description": "souverain iranien",
                        "target_lang_word": "Schah",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schah",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d32fd8cc-0b44-3d08-b80e-506e540331e5",
                                        "entry_id": "fcd63338-92e5-335c-a72c-f26b9836844d",
                                        "glosses": [
                                            "persischer, afghanischer, nordindischer sowie osmanischer Herrschertitel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f178cb-5944-460b-be50-38c6fb5e94c8",
                                                "sense_id": "d32fd8cc-0b44-3d08-b80e-506e540331e5",
                                                "text": "Seit der Abschaffung der Monarchie in Persien 1979 wird der Titel Schah nicht mehr verwendet."
                                            },
                                            {
                                                "example_id": "72209404-d13a-437b-9451-9a567049ee7a",
                                                "sense_id": "d32fd8cc-0b44-3d08-b80e-506e540331e5",
                                                "text": "„Martina Helten-Lexby erinnert sich noch sehr gut an die deutschen Demos gegen den Schah in den Jahren zuvor.“"
                                            },
                                            {
                                                "example_id": "32ebca95-46d5-4cb8-b4e9-3290cdb11871",
                                                "sense_id": "d32fd8cc-0b44-3d08-b80e-506e540331e5",
                                                "text": "„Jetzt jedenfalls, 2002, gab es längst keinen Schah mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d59b0bf-1e9b-38e5-bfe1-aa088baa994b",
                                        "entry_id": "fcd63338-92e5-335c-a72c-f26b9836844d",
                                        "glosses": [
                                            "Träger des unter [1] erwähnten Titels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ad5c74-6a3f-4342-b6ed-68320f303e91",
                                                "sense_id": "4d59b0bf-1e9b-38e5-bfe1-aa088baa994b",
                                                "text": "„Schah Ismail I. versuchte damals die Unabhängigkeit des Landes gegenüber dem Osmanischen Reich der sunnitischen Türken zu behaupten, indem er den schiitischen Islam zur verbindlichen Religion erklärte.“"
                                            },
                                            {
                                                "example_id": "54b3f91f-7633-420b-ae74-081244138d19",
                                                "sense_id": "4d59b0bf-1e9b-38e5-bfe1-aa088baa994b",
                                                "text": "„Des Weiteren würde der Schah ihn sicherlich damit beauftragen, in den Reihen seiner unfähigen Leibwache aufzuräumen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f07de09-219d-3671-8408-51db45efef0b",
                                        "entry_id": "fcd63338-92e5-335c-a72c-f26b9836844d",
                                        "glosses": [
                                            "Kurzform für Schah-in-Schah"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "596682b3-5387-4d41-a044-a7c32dc22f2b",
                        "source_entry_id": "3f2f69d4-3663-32b2-af5d-6597a2b049be",
