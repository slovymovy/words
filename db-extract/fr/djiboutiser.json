                "senses": [
                    {
                        "sense_id": "60102c56-e971-3b8a-a7ee-4aba2ae6b09b",
                        "entry_id": "a384ec68-3b59-3fe0-b89b-8434690c8d32",
                        "glosses": [
                            "Donner un caractère djiboutien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b20b8de4-0564-444d-97a6-7dbd48dc32d9",
                                "sense_id": "60102c56-e971-3b8a-a7ee-4aba2ae6b09b",
                                "text": "C’est le point de départ d’une synergie qui, à moyen terme, conduit à «djiboutiser» l’institution économique."
                            },
                            {
                                "example_id": "c1b8fba4-4b46-41de-99b7-1a992fcdd2a1",
                                "sense_id": "60102c56-e971-3b8a-a7ee-4aba2ae6b09b",
                                "text": "Ce qui me manque, c'est \"seulement\" la version ECM djiboutisée (néologisme)..."
                            },
                            {
                                "example_id": "4b039872-4ff0-4dba-ab67-0ebf405f77ce",
                                "sense_id": "60102c56-e971-3b8a-a7ee-4aba2ae6b09b",
                                "text": "Les noms sous lesquels les navires sont djiboutisés ne peuvent être changés sans l'autorisation de l'autorité maritime."
                            }
                        ]
                    }
