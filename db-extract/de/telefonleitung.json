                "senses": [
                    {
                        "sense_id": "361710f1-6a00-336f-9db5-9980f1fe2192",
                        "entry_id": "b752f4d4-10bc-344d-9b06-4e3f0951d752",
                        "glosses": [
                            "Leitung, die dazu dient, Telefongespräche zu transportieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c6f9c8-883a-4b2a-ac4a-370c9d1a7e51",
                                "sense_id": "361710f1-6a00-336f-9db5-9980f1fe2192",
                                "text": "Die Telefonleitung war defekt, sodass man nicht telefonieren konnte."
                            },
                            {
                                "example_id": "f5e34126-e03d-4b00-8cd9-024139078561",
                                "sense_id": "361710f1-6a00-336f-9db5-9980f1fe2192",
                                "text": "„Sie preßt eine Hand vor den Mund, damit ihr Triumphgefühl nicht überschwappt und in die Telefonleitung gerät.“"
                            },
                            {
                                "example_id": "14633c66-a7e3-4d1f-b946-267c8e931f78",
                                "sense_id": "361710f1-6a00-336f-9db5-9980f1fe2192",
                                "text": "„Er zog die Telefonleitung aus der Wand und durchtrennte das Kabel zusätzlich mit der Zange, um ganz sicher zu gehen.“"
                            },
                            {
                                "example_id": "938b9e41-832a-496f-bc1a-663f2212d37a",
                                "sense_id": "361710f1-6a00-336f-9db5-9980f1fe2192",
                                "text": "„Die Hiobsbotschaft überwand in wenigen Stunden, obwohl es noch kein Radio gab und kaum Telefonleitungen in ländlichen Regionen, Hunderte von Kilometern scheinbar mühelos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
