                ],
                "senses": [
                    {
                        "sense_id": "2a700c7a-1fc5-3157-86ad-5455298bbc2c",
                        "entry_id": "d9fc3da2-90c7-39cc-af84-3e3c15e2c6d4",
                        "glosses": [
                            "то же, что банан (многолетнее травянистое растение семейства банановых)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7736a52-c7f5-4230-99b4-165dbdccaee8",
                                "sense_id": "2a700c7a-1fc5-3157-86ad-5455298bbc2c",
                                "text": "Бамбук и бананник рассажены в саду в виде шпалеры, как загородки."
                            },
                            {
                                "example_id": "0138581e-4ebf-4904-8790-76b5334d4b0e",
                                "sense_id": "2a700c7a-1fc5-3157-86ad-5455298bbc2c",
                                "text": "Под бананником стоял человек, внимательно глядевший на приближающийся караван."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb43343e-1307-30ad-8f4f-7e7d64ed0603",
                        "entry_id": "d9fc3da2-90c7-39cc-af84-3e3c15e2c6d4",
                        "glosses": [
                            "заросли банана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0aff7a6-d7ae-4eab-8f40-b5045116b4b1",
                                "sense_id": "eb43343e-1307-30ad-8f4f-7e7d64ed0603",
                                "text": "Из гущи бананника, окружавшего домишко, высунулась голова мула, потом седок, а следом показались остальные животные, привязанные один за другим."
                            }
                        ]
                    }
