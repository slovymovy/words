                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a19b20-016f-440c-bc91-0fd6dddc44fa",
                                "sense_id": "685e4257-caee-3c8c-93ed-7608ac7e7957",
                                "text": "De nombreux traitements corporels ou psycho-corporels sont utilisés en Santé mentale."
                            },
                            {
                                "example_id": "2b7facdf-fb01-4d1e-ad6a-1da0ef73b996",
                                "sense_id": "685e4257-caee-3c8c-93ed-7608ac7e7957",
                                "text": "Les techniques psycho-corporelles constituent une aide complémentaire efficace dans la prise en charge globale du patient au cabinet dentaire, notamment lors de soins anxiogènes et douloureux."
                            },
                            {
                                "example_id": "116b4d6e-3f5c-4f64-a2dc-e6edacf9be50",
                                "sense_id": "685e4257-caee-3c8c-93ed-7608ac7e7957",
                                "text": "Elle trouve son origine aussi dans l’approche psycho-corporelle issue des recherches de W. Reich, poursuivies, à sa manière, par Gerda Boyesen."
                            }
                        ]
