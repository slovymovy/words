                        "form": "die Stützpfeiler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                        "entry_id": "b592256d-09b9-3a53-bdf5-b377afbe981d",
                        "glosses": [
                            "Säule, die etwas (wie etwa ein Gebäude, eine Brücke) stützt, trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7318a36f-936b-4d4e-81fe-aa1f36bb9768",
                                "sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                                "text": "„Entlang der Dehnungsfuge eines Stützpfeilers ist aus etwa 40 Meter Höhe Beton abgebröckelt und im Schatten der Arena zwischen Haupt- und Osttribüne aufgeprallt.“"
                            },
                            {
                                "example_id": "1c6e9b56-3f52-4f01-b884-43a67e5265ad",
                                "sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                                "text": "„Ein Stützpfeiler war gebrochen, die Plattform hatte daraufhin Schlagseite bekommen.“"
                            },
                            {
                                "example_id": "30e57d72-4ff7-4c62-8dae-73c2cad85acf",
                                "sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                                "text": "„Am Tag zuvor hatte in der Nähe der sibirischen Stadt Norilsk der Stützpfeiler unter dem Lagertank eines firmeneigenen Heizkraftwerks nachgegeben.“"
                            },
                            {
                                "example_id": "59691a93-4d1c-492f-90a5-20b894893a04",
                                "sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                                "text": "„In sechs Hallen erfolgt die Bearbeitung des Gerüsts aus Profilen und Stützpfeilern aus Aluminium sowie die Konfektionierung der Planen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                        "entry_id": "b592256d-09b9-3a53-bdf5-b377afbe981d",
                        "glosses": [
                            "wichtige Grundlage, Basis von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3b738200-9622-4b64-9b3c-a661f578c0e3",
                                "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                                "text": "„Die Deutschen haben das Auto erfunden, die Autobahn und den ADAC, also drei Stützpfeiler der neuzeitlichen Zivilisation.“"
                            },
                            {
                                "example_id": "1ab907c8-bff6-4daf-ae71-d119b6639fef",
                                "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                                "text": "„Die Syrien-Frage ist für die Vereinigten Staaten eine weltpolitische - es geht um ihren Anspruch als Stützpfeiler der Weltordnung.“"
                            },
                            {
                                "example_id": "79ac8700-b1db-4fc6-ac29-617d00418e9d",
                                "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                                "text": "„Lange Zeit galten Großspenden als Stützpfeiler der Parteienfinanzierung.“"
                            },
                            {
                                "example_id": "ee64f054-1fb4-4ce4-9c46-0b65efc60170",
                                "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                                "text": "„An der Wall Street droht ein wichtiger Stützpfeiler des Aktienmarktes ins Wanken zu geraten.“"
                            },
                            {
                                "example_id": "9bfa24e5-93e7-45ce-a304-dcb2c25e0f18",
                                "sense_id": "67cde441-a9c2-320e-a03d-5d37d7618b79",
                                "text": "„Die Hysterie nimmt Überhand und nährt die globalen populistischen Wahlerfolge, die die Stützpfeiler der Demokratie ins Wanken bringen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ced1538-8f5a-4fb5-8467-079d16957b25",
                        "source_entry_id": "b592256d-09b9-3a53-bdf5-b377afbe981d",
                        "source_sense_id": "1726e51a-138a-3d80-94e6-a2cff4a227e9",
                        "source_sense_description": "Säule, die etwas (wie etwa ein Gebäude, eine Brücke) stützt, trägt",
                        "target_lang_word": "buttress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buttress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08ae7d8d-f561-3f1a-9e9e-236a8e1d422c",
                                        "entry_id": "ef2b4475-783d-3a44-93aa-7b6c3cbf1034",
                                        "glosses": [
                                            "A brick, concrete or stone structure built against another structure to support it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cb873c-4962-4166-bbb3-ce03c2627dc9",
                                                "sense_id": "08ae7d8d-f561-3f1a-9e9e-236a8e1d422c",
                                                "text": "It was decided, therefore, to build eight concrete buttresses from the new strengthening work to safeguard the general stability of the wall along the length where the greatest movement had taken place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec1c03d-1641-37ca-9bcc-bb4d868cf95c",
                                        "entry_id": "ef2b4475-783d-3a44-93aa-7b6c3cbf1034",
                                        "glosses": [
                                            "Anything that serves to support something; a prop."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8510be49-59a1-3e79-9622-2b9aa0cd4348",
                                        "entry_id": "ef2b4475-783d-3a44-93aa-7b6c3cbf1034",
                                        "glosses": [
                                            "A buttress-root."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5d1f9f0-ca5e-3cc9-890f-6dab6d1523a1",
                                        "entry_id": "ef2b4475-783d-3a44-93aa-7b6c3cbf1034",
                                        "glosses": [
                                            "A feature jutting prominently out from a mountain or rock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66f4eba-15a3-4c90-b244-e5d6fd349791",
                                                "sense_id": "b5d1f9f0-ca5e-3cc9-890f-6dab6d1523a1",
                                                "text": "Crowell Buttresses, Dismal Buttress"
                                            },
                                            {
                                                "example_id": "ef427922-7727-40ac-ad2b-81d57f774b5a",
                                                "sense_id": "b5d1f9f0-ca5e-3cc9-890f-6dab6d1523a1",
                                                "text": "All that day they rode into broken land. The prairie with its grass and rolling hills was behind them, and they entered a sparse, dry, rocky country, full of draws and short cañons and ominous buttresses."
                                            },
                                            {
                                                "example_id": "b62faac4-12e9-4191-b048-b744205a7c43",
                                                "sense_id": "b5d1f9f0-ca5e-3cc9-890f-6dab6d1523a1",
                                                "text": "Two short pitches up a chimney-crack are followed by a traverse right to the centre of the buttress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c102271-607b-38f6-936d-c6e4ad893913",
                                        "entry_id": "ef2b4475-783d-3a44-93aa-7b6c3cbf1034",
                                        "glosses": [
                                            "Anything that supports or strengthens."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d295e774-1b99-416f-8550-369fc07a6f3f",
                                                "sense_id": "7c102271-607b-38f6-936d-c6e4ad893913",
                                                "text": "the grand pillar and buttress of the good old cause of nonconformity"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buttress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "731de85c-6500-3fe2-bb0a-b68d1e0ba799",
                                        "entry_id": "105c3f9a-20e8-3de2-b690-b2d62785ccf2",
                                        "glosses": [
                                            "To support something physically with, or as if with, a prop or buttress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20afcbab-79e1-3f3f-8170-6cfc9505f4ac",
                                        "entry_id": "105c3f9a-20e8-3de2-b690-b2d62785ccf2",
                                        "glosses": [
                                            "To support something or someone by supplying evidence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18609d6c-f334-4f00-be43-d840a7fd494a",
                                                "sense_id": "20afcbab-79e1-3f3f-8170-6cfc9505f4ac",
                                                "text": "Buttressed by elaborate account statements and a deep reservoir of trust from his investors and regulators, Mr. Madoff steered his fraud scheme safely through a severe recession in the early 1990s, a global financial crisis in 1998 and the anxious aftermath of the terrorist attacks in September 2001."
                                            }
                                        ]
                                    }
                                ]
