                        ],
                        "examples": [
                            {
                                "example_id": "0e250baa-2fc3-4d82-bf12-1995f8a8899b",
                                "sense_id": "5cfa7788-b2d8-38b1-a2d0-6585c83f55ac",
                                "text": "Oft führen Fernsehsendungen das Lemma Gesundheitsmagazin explizit in ihrem Titel."
                            },
                            {
                                "example_id": "589444d6-8bce-42b0-a8e8-03a3d16f7897",
                                "sense_id": "5cfa7788-b2d8-38b1-a2d0-6585c83f55ac",
                                "text": "„Reicht es eigentlich, das Gesundheitsmagazin Praxis nur zwölfmal im Jahr auszustrahlen, wo das Interesse an Medizin doch so ungeheuer ist?“"
                            },
                            {
                                "example_id": "e217ca1f-5ce5-464a-b199-dabdc73c6898",
                                "sense_id": "5cfa7788-b2d8-38b1-a2d0-6585c83f55ac",
                                "text": "„Nach 40 Jahren stellt das ZDF sein Gesundheitsmagazin »Praxis« ein.“"
                            }
                        ],
