                    }
                ],
                "senses": [
                    {
                        "sense_id": "baf2c49d-d80f-3755-bb27-c3a041a46572",
                        "entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "glosses": [
                            "Raccommodement de personnes qui étaient brouillées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87982f9-ddb0-47e1-8804-049fa8169d1b",
                                "sense_id": "baf2c49d-d80f-3755-bb27-c3a041a46572",
                                "text": "Tu avoueras que, dans cette réconciliation, j’ai un intérêt : le bonheur de mon ami et le désir de voir toute dissension s’éteindre entre mes fidèles sujets."
                            },
                            {
                                "example_id": "6f3f17e9-fdd8-456d-987b-24acb6b29a13",
                                "sense_id": "baf2c49d-d80f-3755-bb27-c3a041a46572",
                                "text": "Au milieu du chemin qui mène à la réconciliation, il y a souvent des reproches."
                            }
                        ]
                    },
                    {
                        "sense_id": "8214841a-8810-3265-8777-ed3079f6b7d9",
                        "entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "glosses": [
                            "Acte solennel par lequel un hérétique est réuni à l’Église catholique et relevé des censures qu’il avait encourues."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "300c58d1-9ce7-33e2-be6a-8707b3ff6e00",
                        "entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "glosses": [
                            "Cérémonie qu’on fait pour bénir à nouveau une église profanée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "838ba689-1921-3bf7-85f2-85d882248468",
                        "entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "glosses": [
                            "Rapprochement des comptes avec les relevés bancaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2050a33d-0c66-4ddc-aff3-a3fd118d831c",
                                "sense_id": "838ba689-1921-3bf7-85f2-85d882248468",
                                "text": "La réconciliation doit se faire au moins une fois par mois"
                            }
                        ]
                    },
                    {
                        "sense_id": "cdef82f6-dae2-321e-bf96-e1da68325012",
                        "entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "glosses": [
                            "Resynchronisation à la suite d'une désynchronisation. Mise en cohérence, harmonisation de données."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
