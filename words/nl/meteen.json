                    "antonyms": [
                        "later",
                        "straks"
                    ],
                    "common_phrases": [
                        "meteen beginnen",
                        "kom meteen",
                        "niet meteen"
                    ],
                    "target_lang_definitions": {
                        "en": "Without waiting or delay; at this very moment.",
                        "ru": "Без ожидания или отсрочки; в данный момент.",
                        "pl": "Bez zwłoki lub opóźnienia; w tej samej chwili.",
                        "de": "Ohne zu warten oder Aufschub; in diesem Augenblick.",
                        "fr": "Sans attendre ou sans délai ; à cet instant précis.",
                        "it": "Senza aspettare o indugiare; in questo preciso momento.",
                        "cs": "Bez čekání nebo odkladu; v tuto chvíli.",
                        "tr": "Beklemeden veya gecikmeden; tam şu anda.",
                        "es": "Sin esperar ni retrasarse; en este preciso momento.",
                        "zh": "不加等待或拖延；就在这一刻。"
