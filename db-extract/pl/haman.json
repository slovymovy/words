                "senses": [
                    {
                        "sense_id": "203d2389-3f91-3d69-9909-3635e9d5084f",
                        "entry_id": "e4da9f6e-b5ae-3e41-9339-aa0b3566415f",
                        "glosses": [
                            "groźny olbrzym, potwór"
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7956194-8e87-4df4-a1c5-d835182ebcc3",
                                "sense_id": "203d2389-3f91-3d69-9909-3635e9d5084f",
                                "text": "Z takim hamanem lepiej nie mieć do czynienia."
                            },
                            {
                                "example_id": "9cbc0feb-1536-467f-b4da-c12bb46dd5a1",
                                "sense_id": "203d2389-3f91-3d69-9909-3635e9d5084f",
                                "text": "Ten stary haman przeklęty! Ten… ten… już nie wiem, jak go nazwać!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "39e7e248-b460-3f98-b803-5d6dcf8e623e",
                        "entry_id": "e4da9f6e-b5ae-3e41-9339-aa0b3566415f",
                        "glosses": [
                            "wielkie, ciężkie stworzenie (zwykle o krowie lub koniu)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "01416ae0-bc7d-41c7-8d03-a32bd2bd80c4",
                                "sense_id": "39e7e248-b460-3f98-b803-5d6dcf8e623e",
                                "text": "Taka krowa, taki haman, że i drugiej nie w każdym dworze by znalazł."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
