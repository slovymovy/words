                                        "examples": [
                                            {
                                                "example_id": "b7de5681-950a-4079-ae65-13973215d8c8",
                                                "sense_id": "78435278-8d27-3ed8-9224-72118faad391",
                                                "text": "Het gaat om een Kroatische belangengroep in Frankrijk. In de Franse versie van het muziekblad Rolling Stone gaf de 72-jarige Amerikaanse zanger eerder dit jaar een interview waarin hij reageert op het slavernijverleden van zijn thuisland."
                                            },
                                            {
                                                "example_id": "93dbb6cf-87e7-475f-a28a-22c0419f4d70",
                                                "sense_id": "78435278-8d27-3ed8-9224-72118faad391",
                                                "text": "King ontwikkelde een duidelijk herkenbare eigen speelstijl waarin invloeden uit de traditionele blues, jazz, swing en pop vermengd werden. B.B. King wordt gezien als een van de grootste bluesartiesten aller tijden. Het muziekblad Rolling Stone plaatste hem op de derde plaats in een lijst van de honderd beste gitaristen."
                                            }
                                        ]
                                    }
