                        "glosses": [
                            "Originaire de la région d’Ankara."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ad04da-f66f-4370-b8e6-a1c2f6a8eab9",
                                "sense_id": "6e070d6e-2137-3256-9d4e-7e66e035c4c5",
                                "text": "La chèvre angora habite l'Angora, villayet d’Anatolie en Asie Mineure."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c8a4486-a6cc-37b5-9f7e-7847932a943b",
                        "entry_id": "defd705f-7894-3df2-9c1a-bb6ab5aeccb4",
                        "glosses": [
                            "Qualifie des animaux dotés de poils longs et soyeux suite à une mutation génétique spontanée."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "eda0f878-4e48-4f56-9d01-a8575b49b460",
                                "sense_id": "9c8a4486-a6cc-37b5-9f7e-7847932a943b",
                                "text": "Le meilleur préservatif contre les souris est un chat, non pas un chat angora, mais un chat à poil lisse et ras, rayé de gris et de brun, de la race commune appelée chat de gouttière."
                            },
                            {
                                "example_id": "d98e764d-fd56-4946-a7eb-0d17f731977f",
                                "sense_id": "9c8a4486-a6cc-37b5-9f7e-7847932a943b",
                                "text": "Le lapin angora fournit un poil qu'on peut filer comme la laine."
                            },
                            {
                                "example_id": "bfe6d315-c6ac-4486-aee6-678e9bfda301",
                                "sense_id": "9c8a4486-a6cc-37b5-9f7e-7847932a943b",
                                "text": "Le contact avec la douce fourrure angora de Pupuce, lapine géante, agit comme un anxiolytique et apaise cet enfant atteint de polyhandicaps."
                            }
                        ]
                    }
                ],
