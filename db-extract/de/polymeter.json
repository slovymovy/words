                "senses": [
                    {
                        "sense_id": "2567c949-5caf-30da-9a5b-c60b8f1cd0b0",
                        "entry_id": "2749dbc2-6ba0-3272-8d2e-0c8e7d4aa6e2",
                        "glosses": [
                            "Gerät, das für mehrere meteorologische Messgrößen (wie Temperatur, Luftfeuchtigkeit und dergleichen) ausgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434de8e3-4d1c-4174-b5be-17f987b1dd6d",
                                "sense_id": "2567c949-5caf-30da-9a5b-c60b8f1cd0b0",
                                "text": "„Im December beginnt eine Beobachtungsreihe an einem Lambrecht’schen Polymeter.“"
                            },
                            {
                                "example_id": "a87bce5d-de38-4b53-ba0c-31c58a280323",
                                "sense_id": "2567c949-5caf-30da-9a5b-c60b8f1cd0b0",
                                "text": "„Dass das Polymeter auch für meteorologische Zwecke, für Wetterprognose, sehr nützlich verwendet werden kann, wollen wir hier nur insofern kurz erwähnen, als wir der Ansicht sind, dass auch den Schülern hierdurch Anleitung zu Beobachtungen und zur lehrreichen Beschäftigung mit physikalischen Vorgängen gegeben wird […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
