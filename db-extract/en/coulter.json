                                                "sense_id": "1583c3d3-0044-301c-a170-7ae676a28c5e",
                                                "text": "Čepele ostrých nožů se zásadně myjí studenou vodou."
                                            },
                                            {
                                                "example_id": "de7da895-bd78-4bca-86ff-79df4663807d",
                                                "sense_id": "1583c3d3-0044-301c-a170-7ae676a28c5e",
                                                "text": "Magua ho uchopil za bezvládnou paži a třikrát mu zabořil nůž do prsou, než nešťastný Unkas, dívající se na něj až do konce s nesmiřitelným pohrdáním, klesl mrtev k jeho nohám."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75f199b-5346-3d0c-8fc5-7b23a423c887",
                                        "entry_id": "a71c6308-c315-3584-8e17-6eec351785a8",
                                        "glosses": [
                                            "ostrá čepel k použití ve strojích"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399f725b-bcfe-45fd-80be-654bc913c84e",
                                                "sense_id": "a75f199b-5346-3d0c-8fc5-7b23a423c887",
                                                "text": "Brzy se naučil brousit nože kombajnu a vyrábět si vlastní hračky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
