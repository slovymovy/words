                                        "glosses": [
                                            "A country in West Asia in the Middle East. Official name: State of Qatar. Capital: Doha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75dc250-6d16-4551-a2a7-6d2436555188",
                                                "sense_id": "1e01625a-c829-3bda-b350-edd7499c5216",
                                                "text": "Officials in Qatar have said that companies building World Cup stadiums will be held to higher standards of worker treatment, and proposed changes to the kafala system are undergoing legislative review."
