                        "cross_references": [
                            {
                                "target_word": "conciërge",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9fdcbbe5-4a3d-3099-a5ac-a046a5734fe9",
                                        "entry_id": "65ef6012-f8f8-321b-ace3-69d27505ce78",
                                        "glosses": [
                                            "een huisbewaarder, een toezichthouder in een gebouw"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dca2fd6-4d66-459e-9ea8-954f883b62ae",
                                                "sense_id": "9fdcbbe5-4a3d-3099-a5ac-a046a5734fe9",
                                                "text": "`De conciërge?'\n`Hij haat dat woord, al bevalt de etymologie ervan hem wel. Hij heeft mij geleerd dat het is afgeleid van \"comte des cierges\", de graaf der kaarsen."
                                            },
                                            {
                                                "example_id": "be25c617-a924-4135-b2a2-74a924ddad8b",
                                                "sense_id": "9fdcbbe5-4a3d-3099-a5ac-a046a5734fe9",
                                                "text": "Hij keek nu als een hoogst verontwaardigde conciërge die zojuist twee brugklassers had betrapt op het roken van een sigaret in de toiletten. Voetje voor voetje schuifelden ze zijn kant op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01817fc8-7b35-488a-b956-fe59572db572",
                        "source_entry_id": "c33b36c1-2416-3b74-add3-27e1ccf5effc",
                        "target_lang_word": "Klatschtante",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klatschtante",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                        "entry_id": "a2110fe8-bf40-3296-88bd-45916a21755a",
                                        "glosses": [
                                            "weibliche Person, die gerne über andere Personen herzieht / abfällig redet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f707bb-ebc4-40c2-b7cf-1b78df38006f",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "Eine bessere Gesprächspartnerin [in der Mittagspause] ist allerdings die Klatschtante. Ein Mittagessen mit ihr empfiehlt sich besonders, um sich nach längerer Abwesenheit wieder auf den neuesten Stand zu bringen. Sie weiß, wer mit wem (nicht mehr auskommt), wer als Nächstes kündigt und wie die Stimmung in der Chefetage ist."
                                            },
                                            {
                                                "example_id": "a5b8d560-68af-45bd-840b-f1df96b8f903",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "[Michael Graeter] hat früher die Klatschtante bei der Münchner „AZ“ gemacht."
                                            },
                                            {
                                                "example_id": "034c9fa2-16cc-4523-8b23-028b9db2557a",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "Hollywoods Klatschtante Louella Parsons nannte Pier Angeli die beste Nachwuchsschauspielerin des Monats und verglich sie gleichzeitig mit Ingrid Bergman, als sie in „Intermezzo“ erschien."
                                            },
                                            {
                                                "example_id": "148168fb-8bc0-43d0-8ced-5ef8046e152f",
                                                "sense_id": "95134671-cd17-34d1-971c-0d525c74ba19",
                                                "text": "„Sie hat nichts zu tun und ist die Klatschtante der Straße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
