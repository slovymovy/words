        "nl-extract.jsonl": [
            {
                "entry_id": "9530540f-d7fa-37f9-b5ce-02e5c0dd48a0",
                "word": "eisend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "605ecfa4-06fe-30ec-8cf0-928de9c28271",
                        "entry_id": "9530540f-d7fa-37f9-b5ce-02e5c0dd48a0",
                        "glosses": [
                            "vragend op een dwingende manier; nodig hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31982ecd-f2e4-4973-83f2-4c04bdeac71b",
                                "sense_id": "605ecfa4-06fe-30ec-8cf0-928de9c28271",
                                "text": "Ziekenhuisgroep Twente met ziekenhuizen in Hengelo en Almelo wil vijftien miljoen bezuinigen. Deze maand wordt duidelijk hoe dat zal uitpakken. Sluiting van de 24 uurs-afdeling Spoed Eisende Hulp (SEH) is een scenario, waartegen het college en de gemeenteraad zich verzetten. Ook patiëntenstops kunnen aan de orde komen."
                            },
                            {
                                "example_id": "f6ca25b6-57f0-4b33-ac7b-c3e767e14b86",
                                "sense_id": "605ecfa4-06fe-30ec-8cf0-928de9c28271",
                                "text": "De rechter prijst de verdediging van de Veluwenaren. Advocaat Stockmann voerde met een powerpointpresentatie aan dat Kees Smit op geen enkel onderdeel van de webpagina auteursrecht kan laten rusten, zoals de eisende partij in algemene bewoordingen had beweerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "320d4335-08fb-4dd0-b053-c0e778de82f9",
                        "source_entry_id": "9530540f-d7fa-37f9-b5ce-02e5c0dd48a0",
                        "source_sense_id": "605ecfa4-06fe-30ec-8cf0-928de9c28271",
                        "source_sense_description": "vragend op een dwingende manier; nodig hebbend",
                        "target_lang_word": "exacting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exacting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6af6ac4-5d28-33d0-9666-b2567e8b74cf",
                                        "entry_id": "d297223e-c8b8-301e-8f2c-ecddd3a0b575",
                                        "glosses": [
                                            "Making great demands; difficult to satisfy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af82a965-d1fc-487b-9892-407f6a697464",
                                                "sense_id": "e6af6ac4-5d28-33d0-9666-b2567e8b74cf",
                                                "text": "His exacting taste required no small degree of outward perfection."
                                            },
                                            {
                                                "example_id": "bdf6a246-f7f8-4a4f-808b-ef5d31d067c0",
                                                "sense_id": "e6af6ac4-5d28-33d0-9666-b2567e8b74cf",
                                                "text": "[H]e burst into apologies which would have satisfied a more exacting man than I am."
                                            },
                                            {
                                                "example_id": "f616c254-39ee-4911-a176-7d75e154d305",
                                                "sense_id": "e6af6ac4-5d28-33d0-9666-b2567e8b74cf",
                                                "text": "[Canadian Prime Minister] Mr. [Mark] Carney was the exacting governor of the Bank of Canada during the 2008 financial crisis, and the levelheaded governor of the Bank of England during Brexit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                        "entry_id": "d297223e-c8b8-301e-8f2c-ecddd3a0b575",
                                        "glosses": [
                                            "Requiring precise accuracy, great care, effort, or attention."
                                        ],
                                        "tags": [
                                            "of an action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac89f06-b2bd-424b-a20d-dbf48ed25896",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Wolf's work, which, though not very exacting, had to be done single-handed, kept him to his post."
                                            },
                                            {
                                                "example_id": "5ecd4979-ec9c-442c-be6d-6d6a6154216e",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Every photographer of experience has his own theories and methods of working, but for the last 14 years I have used a Leica exclusively, and have found it best adapted to the somewhat exacting demands of railway photography, which is by no means an easy branch of the art."
                                            },
                                            {
                                                "example_id": "00af05a8-57b0-4128-89fa-fc5b3c1b5192",
                                                "sense_id": "082866d0-5393-3df0-8216-f48edfcffc53",
                                                "text": "Even if a GDF receives its first deposit in the 2040s, the waste has to be delivered and put away with such exacting caution that it can be filled and closed only by the middle of the 22nd century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa58-807e-367b-a7b2-b956c3c90a66",
                                        "entry_id": "d297223e-c8b8-301e-8f2c-ecddd3a0b575",
                                        "glosses": [
                                            "Characterized by exaction."
                                        ],
                                        "tags": [
                                            "of a person or organization"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9b0fc71-395c-4c1d-9b4c-9d0b4ef00a39",
                                                "sense_id": "304aaa58-807e-367b-a7b2-b956c3c90a66",
                                                "text": "\"He is a hard, exacting, money-loving man,\" was my remark."
                                            }
                                        ]
                                    }
                                ]
                            },
