                ],
                "senses": [
                    {
                        "sense_id": "59bf3346-eec9-38d2-afa8-386ae3bbd9d2",
                        "entry_id": "abc09e59-4e61-3da4-a2a9-1fa40bb878d1",
                        "glosses": [
                            "Dépression de terrain karstique dont le fond argileux et fertile est constitué d’argiles de décalcification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d187e14-a31f-44cc-8ffa-40d085bbcfcd",
                                "sense_id": "59bf3346-eec9-38d2-afa8-386ae3bbd9d2",
                                "text": "Une doline… c’est une fissure, un cratère, comme une crevasse de glacier, mais dans le karst…"
                            },
                            {
                                "example_id": "86660d80-abe3-4d7a-a096-f6aed8cbe0b5",
                                "sense_id": "59bf3346-eec9-38d2-afa8-386ae3bbd9d2",
                                "text": "Une sorte de plateau karstique, creusé de peu profondes dolines et rehaussé d'arches de pierres rousses apparut devant nous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85e81c8d-9450-4e44-9848-f0aadf731bcd",
                        "source_entry_id": "abc09e59-4e61-3da4-a2a9-1fa40bb878d1",
                        "source_sense_id": "59bf3346-eec9-38d2-afa8-386ae3bbd9d2",
                        "target_lang_word": "Doline",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doline",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52c9712f-1e57-36f9-91ba-a08c85e63dfd",
                                        "entry_id": "475846c8-5158-38e6-b40c-801725e952bc",
                                        "glosses": [
                                            "eine schlot-, trichter- oder schüsselförmige Senke von meist rundem oder elliptischen Grundriss in Karstgebieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2ad36a-7d4b-4b8e-955c-dd1116aab52b",
                                                "sense_id": "52c9712f-1e57-36f9-91ba-a08c85e63dfd",
                                                "text": "„Am südlichen Rand des Harzes reihen sich perlenschnurartig Erscheinungen aneinander, die auf die gesteinsauflösende Wirkung des Wassers zurückgehen: Höhlen, Erdfälle und Dolinen, Karstquellen, Bachschwinden und Flussversinkungen, Karstkegel, Schlotten, geologische Orgeln, Felsen und weiße Wände, geformt aus dem typischen Gestein des Südharzes, dem Gips.“"
                                            },
                                            {
                                                "example_id": "bbd6ea30-63e8-491f-88a0-2e20216fb544",
                                                "sense_id": "52c9712f-1e57-36f9-91ba-a08c85e63dfd",
                                                "text": "„Er ging geradewegs auf die Doline zu und begann seinen Abstieg in diese trichterförmige Senke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
