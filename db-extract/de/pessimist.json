                        "form": "den Pessimisten"
                    },
                    {
                        "form_id": "a60677ea-1679-4980-883f-a9e656798fa9",
                        "entry_id": "d7ba3975-48cf-3a6a-a763-95ee51843303",
                        "tags": [
                            "accusative",
