                    {
                        "translation_id": "e661eb07-3074-4cb7-aae9-24bc2a113085",
                        "source_entry_id": "3e92977c-256f-33b6-baa9-46bee9eaf495",
                        "source_sense_id": "bc6e5afc-b398-32ac-9d11-77e0791e8e63",
                        "source_sense_description": "inham van een zee",
                        "target_lang_word": "Bucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a82c13ab-f484-34af-b970-a06d806c9d17",
                                        "entry_id": "b99a0951-2e7c-3c5b-ba02-b4351f918908",
                                        "glosses": [
                                            "eine Gewässerfläche innerhalb einer Einbiegung, Einwärtsbiegung von Küsten- und Uferlinien, innerhalb einer dreiseitigen Begrenzung durch Land"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19fa7dab-6ad1-4e0c-8aec-f483786cd316",
                                                "sense_id": "a82c13ab-f484-34af-b970-a06d806c9d17",
                                                "text": "Der Jadebusen ist eine Bucht an der Nordseeküste."
                                            },
                                            {
                                                "example_id": "68bd15e3-a0d2-4f43-bad9-76a677824edd",
                                                "sense_id": "a82c13ab-f484-34af-b970-a06d806c9d17",
                                                "text": "„Wir hielten Kurs auf eine Landzunge im äußersten Osten der Insel, wo wir eine Stunde später in einer geschützten Bucht ankerten.“"
                                            },
                                            {
                                                "example_id": "c1bf81c1-f8b3-45f8-8677-25fdc017469d",
                                                "sense_id": "a82c13ab-f484-34af-b970-a06d806c9d17",
                                                "text": "„Unter so wechselnden Bildern und Betrachtungen bog er wieder in die kurz vorher so stille Bucht ein, in deren Schilf jetzt ein buntes und bewegtes Leben herrschte.“"
                                            },
                                            {
                                                "example_id": "66aa5efa-f8b9-4015-94ac-ff7f3fa54a98",
                                                "sense_id": "a82c13ab-f484-34af-b970-a06d806c9d17",
                                                "text": "„Der Fluß bildet da eine kleine Bucht, in welcher die Marine des Stammes, fünf Palmrinde-Kanus, an Strängen von Wattap ruhig vor Anker lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "240d2275-fe7c-3f6b-a586-4fe3f92633c0",
                                        "entry_id": "b99a0951-2e7c-3c5b-ba02-b4351f918908",
                                        "glosses": [
                                            "eine von drei Seiten durch Bergzüge eingerahmte, ebene Landschaft"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950a968f-8de6-4ec6-a718-ba0e76b4b832",
                                                "sense_id": "240d2275-fe7c-3f6b-a586-4fe3f92633c0",
                                                "text": "„Die Stufentrauf in allen ihren Buchten und Vorsprüngen begleitend, sinkt sie in den Paßmulden jeweils auf das Niveau von 360-400 m herab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64392dca-0f7d-3cd8-be46-a1da236444a4",
                                        "entry_id": "b99a0951-2e7c-3c5b-ba02-b4351f918908",
                                        "glosses": [
                                            "ein kleiner Stall, Verschlag für Haustiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b11c4109-5ede-4485-b031-763ed6ae4c0c",
                                                "sense_id": "64392dca-0f7d-3cd8-be46-a1da236444a4",
                                                "text": "Ich hab das Kalb wieder in die Bucht gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "84c25b29-660e-3e5d-9f55-54ec1d5a07ce",
                                        "entry_id": "b99a0951-2e7c-3c5b-ba02-b4351f918908",
                                        "glosses": [
                                            "eine Wende in einem Seilverlauf, eine Schleife im Tau"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4430032e-6294-435d-8234-92289692a69e",
                                                "sense_id": "84c25b29-660e-3e5d-9f55-54ec1d5a07ce",
                                                "text": "Der Schlauch ist faltbar, man kann ihn auch rollen oder in Buchten legen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
