                        "cross_references": [
                            {
                                "target_word": "edifice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "935eaf7f-acd2-36d6-902f-f19229c6aa18",
                                        "entry_id": "2dc71cc2-8c1e-3505-b902-46306e047120",
                                        "glosses": [
                                            "A building; a structure; an architectural fabric, especially a large and spectacular one."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef9e17e4-4b49-34e1-a8d4-da4e2e1c86e6",
                                        "entry_id": "2dc71cc2-8c1e-3505-b902-46306e047120",
                                        "glosses": [
                                            "An abstract structure, such as a school of thought, an argument, a theoretical position, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c6c795-9085-43b7-9c58-540c36a7c120",
                                                "sense_id": "ef9e17e4-4b49-34e1-a8d4-da4e2e1c86e6",
                                                "text": "The real difficulty was moral, not intellectual. Was the whole edifice of Ptolemy to be destroyed?"
                                            },
                                            {
                                                "example_id": "70a2d515-a057-499d-abbe-76a86e40af71",
                                                "sense_id": "ef9e17e4-4b49-34e1-a8d4-da4e2e1c86e6",
                                                "text": "With a great thump on the table, Poirot demolished his carefully built up edifice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88cd06d9-3dcc-4994-a3e3-6f9b052b6df1",
                        "source_entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
