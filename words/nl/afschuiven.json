            "senses": [
                {
                    "sense_id": "cad5c840-37cb-3743-9108-f607db69be93",
                    "sense_definition": "Iemand anders een taak of verantwoordelijkheid laten uitvoeren die men zelf zou moeten doen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verantwoordelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>schoof</w> het vervelende werkje op zijn collega <w>af</w>.",
                            "target_lang_translations": {
                                "en": "He <w>shifted</w> the unpleasant task onto his colleague."
                            }
                        },
                        {
                            "text": "Probeer niet altijd je eigen fouten op anderen <w>af</w> te <w>schuiven</w>.",
                            "target_lang_translations": {
                                "en": "Try not to always <w>shift</w> your own mistakes onto others."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorschuiven",
                        "afwentelen"
                    ],
                    "common_phrases": [
                        "verantwoordelijkheid afschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To pass on a task or responsibility to someone else that one should have performed oneself."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "To move or transfer responsibility or blame onto someone else."
                            },
                            {
                                "target_lang_word": "pass off",
                                "target_lang_sense_clarification": "To give a task or duty to another person to avoid doing it oneself."
                            },
                            {
                                "target_lang_word": "shirk",
                                "target_lang_sense_clarification": "To avoid or neglect a duty or responsibility."
                            }
                        ]
                    }
                }
            ]
        }
    ]
