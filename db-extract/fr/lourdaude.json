                "senses": [
                    {
                        "sense_id": "66461b05-98ef-3afc-a134-548033de5cde",
                        "entry_id": "c0cab22d-da6e-37e3-9a70-c01fe0e7134c",
                        "glosses": [
                            "Femme lourde et maladroite, pataude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b719026-d69b-42e1-9ba9-60a498286899",
                                "sense_id": "66461b05-98ef-3afc-a134-548033de5cde",
                                "text": "Geneviève me prenait parfois par la tendresse : pauvre lourdaude que j’entendais venir de loin avec ses gros sabots !"
                            },
                            {
                                "example_id": "a2559234-e17c-4c02-815a-bec9f25f745d",
                                "sense_id": "66461b05-98ef-3afc-a134-548033de5cde",
                                "text": "Cette lourdaude à souliers d’homme, qui rase les murs d’un air égaré, ne peut être que suspecte."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f47b0ae-0c47-326d-a3e8-bddec233533b",
                        "entry_id": "c0cab22d-da6e-37e3-9a70-c01fe0e7134c",
                        "glosses": [
                            "Femme d’apparence massive, dénuée de grâce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be69bf9-9c02-4436-9ee1-b17205861cfa",
                                "sense_id": "8f47b0ae-0c47-326d-a3e8-bddec233533b",
                                "text": "Et cette servante mafflue en voulait surtout à cette enfant de ne pas devenir comme elle une lourdaude hâlée par le soleil et de rester, toujours et quand même, la petite Parisienne à la peau blanche et aux mains fines, qui lui obéissait en tremblant, mais qui, dans le jardin où elle la contraignait à rester silencieuse et morne, gardait toujours l’air d’une petite princesse en captivité chez les barbares."
                            }
                        ]
                    },
                    {
                        "sense_id": "95a73a21-e1c4-3848-ab27-3951714ea243",
                        "entry_id": "c0cab22d-da6e-37e3-9a70-c01fe0e7134c",
                        "glosses": [
                            "Femme fruste, dont l’esprit est dépourvu de toute finesse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8b423eea-166a-4ab7-8d47-19a2091fdbe3",
                                "sense_id": "95a73a21-e1c4-3848-ab27-3951714ea243",
                                "text": "C’est trop de subtilité pour une lourdaude de ma trempe. Eclairez-moi, mon ami, je ne demande qu’à comprendre."
                            }
                        ]
                    }
                ],
