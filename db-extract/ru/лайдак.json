                                "target_senses": [
                                    {
                                        "sense_id": "d473093a-0b37-3be6-b242-ce933466de81",
                                        "entry_id": "7b01add9-8007-33ff-a6c6-914ff82afb14",
                                        "glosses": [
                                            "człowiek postępujący niezgodnie z normami etyki, godny pogardy"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d3a83b5-6520-4853-a929-734673bf4135",
                                                "sense_id": "d473093a-0b37-3be6-b242-ce933466de81",
                                                "text": "Jak można seksualnie wykorzystywać małoletnie dziecko? Dla mnie taki człowiek to najgorszy łajdak."
                                            },
                                            {
                                                "example_id": "16dbe424-9098-412a-a781-1e3e61021e3b",
                                                "sense_id": "d473093a-0b37-3be6-b242-ce933466de81",
                                                "text": "Nawet największy złoczyńca, najgorszy łajdak, czy zbrodniarz może mieć wyrzuty sumienia."
                                            },
                                            {
                                                "example_id": "291b3f61-3b3c-4faa-839a-d5ae2449d314",
                                                "sense_id": "d473093a-0b37-3be6-b242-ce933466de81",
                                                "text": "Powiedzcie temu łajdakowi, żeby się tu nawet nie pokazywał!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
