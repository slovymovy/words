                    },
                    {
                        "translation_id": "f38a8649-503c-4d33-8b7e-6cdb63354119",
                        "source_entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "target_lang_word": "Flugschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaf00814-9c02-39c7-9b39-80950806e731",
                                        "entry_id": "40d7a84c-d59a-38a8-bb05-697dff322470",
                                        "glosses": [
                                            "(meist kurzes) Schriftstück, das öffentlich verteilt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4da566-1cf1-4289-a371-e66b6d57a79d",
                                                "sense_id": "aaf00814-9c02-39c7-9b39-80950806e731",
                                                "text": "„Luthers Ideen hätten zweifellos nicht ihre rasche Verbreitung und zündende Wirkung gefunden, wenn die zahlreichen Flugschriften seiner Parteigänger und Gegner nicht von so vielen Zeitgenossen gelesen worden wären.“"
                                            },
                                            {
                                                "example_id": "d443e0ed-e4a3-44d5-a07b-428b7debc2fa",
                                                "sense_id": "aaf00814-9c02-39c7-9b39-80950806e731",
                                                "text": "„Die Passion Magdeburgs – bald über Flugschriften in ganz Europa bekannt – wurde zu einem Symbol für die Grausamkeit kaiserlich-ligistischer Kriegführung und stand jeder Stadt, die eine Belagerungsarmee vor ihren Mauern sah, als Menetekel vor Augen.“"
                                            },
                                            {
                                                "example_id": "82d02eb3-24f9-4c8f-9996-8e9c8d4a741c",
                                                "sense_id": "aaf00814-9c02-39c7-9b39-80950806e731",
                                                "text": "„Das lag nicht allein an Büchern und Bibeln, sondern vor allem an den Flugschriften, häufig Einblattdrucke mit einer Illustration.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
