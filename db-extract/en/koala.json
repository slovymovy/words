                    {
                        "translation_id": "576477db-ee10-4272-87b0-877057f5de7b",
                        "source_entry_id": "a21745ba-fbe5-3ddb-9f25-3f66cc7be036",
                        "source_sense_id": "7e1ffe9a-e258-3d25-836f-66e4985bb01a",
                        "source_sense_description": "a tree-dwelling marsupial that resembles a small bear",
                        "target_lang_word": "коа́ла",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коа́ла",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9745d3-b9f1-320e-bc57-e4bc7968dd3e",
                                        "entry_id": "298b1b4b-6afe-31d6-8598-8db7c7436c74",
                                        "glosses": [
                                            "зоол. животное семейства лазающих сумчатых, обитающее в лесах Восточной Австралии; сумчатый медведь, единственный представитель семейства коаловых (лат. Phascolarctus cinereus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9a2e21-4a6b-4ea2-acea-f186dc9b34fb",
                                                "sense_id": "bc9745d3-b9f1-320e-bc57-e4bc7968dd3e",
                                                "text": "Коала — небольшое животное, величиной с ягнёнка, с мягким, густым мехом светлосерого цвета, беспомощное и безобидное. Живут коала на ветвях особого вида эвкалиптов и питаются листьями."
                                            },
                                            {
                                                "example_id": "25e33ae8-901a-46c1-98c2-555ae6b12157",
                                                "sense_id": "bc9745d3-b9f1-320e-bc57-e4bc7968dd3e",
                                                "text": "С начала века началось массовое истребление коал из-за их шкур, и численность симпатичных сумчатых «мишек» стала сокращаться с ужасающей быстротой. Только в 1924 году было убито два миллиона коал!"
                                            },
                                            {
                                                "example_id": "df8c3254-95b3-41d5-b56d-9173302cd310",
                                                "sense_id": "bc9745d3-b9f1-320e-bc57-e4bc7968dd3e",
                                                "text": "Пока коалы мирно пережёвывали свои пять килограмм эвкалиптовых листьев в день (их пока тоже возят из Австралии, но специально для зверьков в предгорьях Тайпея подрастает эвкалиптовая роща) и адаптировались к местным условиям, по ТВ и в газетах шла активнейшая их «раскрутка»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68908af0-fd89-4329-8bdf-ca8b422869ce",
                        "source_entry_id": "a21745ba-fbe5-3ddb-9f25-3f66cc7be036",
