                "senses": [
                    {
                        "sense_id": "dd2510ee-4513-3b21-a7bd-e81e83cb526f",
                        "entry_id": "39c51c99-b11b-3a53-a62e-59f431c8daeb",
                        "glosses": [
                            "Système d’administration qui consiste à remplacer chaque ministre par un conseil."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "03d1927d-c1d1-4966-8e14-9dcf31a68fdb",
                                "sense_id": "dd2510ee-4513-3b21-a7bd-e81e83cb526f",
                                "text": "Après la mort de Louis XIV, le régent voulut établir la polysynodie en France et abolir les ministères."
                            },
                            {
                                "example_id": "5bacb5d6-6d1f-47ce-9efd-725c49c7bb2e",
                                "sense_id": "dd2510ee-4513-3b21-a7bd-e81e83cb526f",
                                "text": "La polysynodie doit être considérée comme l’initiatrice d’un système de gouvernement dans lequel la figure du ministre, chef d’une administration et détenant de ce fait un pouvoir concurrent face au souverain, n’existe pas."
                            }
                        ]
                    }
                ],
