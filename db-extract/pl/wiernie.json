                                "sense_id": "f06562f8-bdcf-3e41-8e20-97ab6a310390",
                                "text": "Ludzie pyskowali na dziedzica. Żeby Niemców słać na człowieka, który służył wiernie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c52fe7f7-0b0d-33ae-9726-5cced6a2d0dc",
                        "entry_id": "ff693fe2-da16-377d-aa45-c00507e8c2ed",
