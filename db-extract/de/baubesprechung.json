                ],
                "senses": [
                    {
                        "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                        "entry_id": "36b26049-7b69-3ad6-901a-ae26d0496aab",
                        "glosses": [
                            "ergebnisorientiertes Fachgespräch der verantwortlichen Bauleitung zu einem bestimmten Bauvorhaben direkt vor Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab8dd17-e938-4ade-9bc6-6c8316542381",
                                "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                                "text": "„Es ist deshalb bei größeren Bauvorhaben mit formalisierten Baubesprechungen sinnvoll, im Bauvertrag Regelungen zu treffen, wer das Baustellenprotokoll erstellt, wie das Protokoll zu erstellen ist, wie Widersprüche gegen das Protokoll kommuniziert werden und welche Rechtswirkungen ein unwidersprochenes Protokoll entfalten soll.“"
                            },
                            {
                                "example_id": "263cada8-2ce6-49e7-ba7b-1585fa8563ff",
                                "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                                "text": "„Zu regelmäßigen, vorab vereinbarten, Terminen (üblicherweise einmal wöchentlich) treffen sich die Planer (Architekt immer, Statiker und Haustechnikplaner bei Bedarf), die örtliche Bauaufsicht, die rechtsverbindlichen Vertreter der beauftragten Firmen und sonstige ev. Betroffene (z.B. auch Nachbarn etc.) auf der Baustelle um die Baubesprechung abzuhalten.“"
                            },
                            {
                                "example_id": "2728737f-6a05-41d0-84b1-f03e506a68f2",
                                "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                                "text": "„Deswegen sollte eine große Baubesprechung mit dem Bauleiter, den ausführenden Unternehmen, dem Polier und dem Bauherrn etwa alle 4 Wochen stattfinden.“"
                            },
                            {
                                "example_id": "971669f2-b7cd-4164-8005-2d3ecda72f21",
                                "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                                "text": "„Machen Sie sich bewusst, dass Protokolle von Baubesprechungen künftig gravierende Vertragsänderungen auslösen können.“"
                            },
                            {
                                "example_id": "83ea17a8-6941-47d5-8885-423c02776c18",
                                "sense_id": "f21e80de-bebe-322a-ba2b-1fd63ab39869",
                                "text": "„Während der Baubesprechung wurden zunächst die Beladungspläne, sowie die Verlastung der einzelnen Gerätschaften auf dem Fahrzeug geklärt, sowie anschließend an einer ähnlichen Drehleiter Einzelheiten zum Aufbau geklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
