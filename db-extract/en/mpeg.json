                    {
                        "sense_id": "90d9f022-d992-3e07-a40c-179b82d79a87",
                        "entry_id": "29a6f41e-b7f2-3b5f-ad47-e7c2d132273e",
                        "glosses": [
                            "（規格）動画フォーマットの名称。MPEG-1、MPEG-2、MPEG-4の3種がある。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c813878-f86b-45d6-bfa1-6e154135bc66",
                                "sense_id": "90d9f022-d992-3e07-a40c-179b82d79a87",
                                "text": "MPEG-1は主としてビデオCDに用いられる。"
                            },
                            {
                                "example_id": "2d0dd560-fecc-4861-8368-9ba9076ac302",
                                "sense_id": "90d9f022-d992-3e07-a40c-179b82d79a87",
                                "text": "MPEG-2は高圧縮と同時に高画質が実現されたので、DVD－Videoに用いられる。"
                            },
                            {
                                "example_id": "a4fdb3af-baa1-4579-a1c8-08356d5692e5",
                                "sense_id": "90d9f022-d992-3e07-a40c-179b82d79a87",
                                "text": "MPEG-4は今日の動画フォーマットの標準となっており、移動体通信やストリーミングに対応している。"
                            }
                        ]
                    }
