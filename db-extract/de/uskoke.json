                ],
                "senses": [
                    {
                        "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                        "entry_id": "ac541f1b-0808-38a1-91d5-607076575d0f",
                        "glosses": [
                            "Söldner, der aus von Osmanen besetztem Gebiet geflohen war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5c649c89-b548-4804-b2d9-4dc42170ec55",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Hauptgegner der Uskoken waren die Osmanen, deren Schiffe, geführt von muslimischen oder christlichen Untertanen, zu Friedenszeiten in großer Zahl nach Venedig segelten.“"
                            },
                            {
                                "example_id": "2930e415-cd1e-42a7-87ae-85b9b7221673",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Als Uskoke war Ivan Lenković erstmals militärisch im Jahre 1539 als Hauptmann von Senj, zudem als Uskokenanführer auf dem Umland von Senj bis an den Flusslauf der Save, in Erscheinung getreten.“"
                            },
                            {
                                "example_id": "a77cc02f-58f5-495c-8c93-e78a4c8eacc7",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Das ist unstreitig der Uskoke, sagte er zu dem Kommandanten Leonzio gewendet – der Uskoke, den die Signora im Traume gesehen und den der edle Graf heute in der Wirklichkeit getödtet hat.“"
                            },
                            {
                                "example_id": "e5917f74-8841-43a6-bef2-c9f63d5dba7b",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Der einstige Uskoke vereinigte in sich viele der Vorzüge und der Mängel des Südslaven im Allgemeinen, die sich nach und nach verlieren, wovon die Slovenen einen augenscheinlichen Beweis liefern.“"
                            },
                            {
                                "example_id": "786db7b0-0079-41c7-8ff0-cd1ea564c2e4",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Trotz Byron hat der Uskoke noch Interesse, und zwar in dem Genre von Leone Leoni.“"
                            },
                            {
                                "example_id": "f738f205-c15f-41e4-88b1-a50c84ce2f6c",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„»Der Uskoke ist einer der hervorstechendsten socialen Urgebilde, welche die Geschichte aufzuweisen hat; er ist der Verbannte, der ein neues Vaterland gefunden, der Besiegte oder Verurtheilte, der, getrennt von den Seinigen und verfolgt von den Herren des Schwertes, mit einem Satze den Graben der Freistätte übersprungen hat.“"
                            },
                            {
                                "example_id": "8292223d-36e9-4416-a3bb-fd15a929fb9a",
                                "sense_id": "649d32e7-b962-3be5-906f-7f96fa6914bf",
                                "text": "„Der Anblick, der sich dem Uskoken und der Kashmirerin bot, wirkte noch erschütternder, als der seltsame Gesang, den sie gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
