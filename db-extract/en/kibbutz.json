                                        "glosses": [
                                            "izraelskie spółdzielcze gospodarstwo rolne lub produkcyjne wraz z osadą mieszkańców, w którym ziemia i środki produkcji są własnością wspólną"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85c17db-7cee-4f97-b792-cd829539cd98",
                                                "sense_id": "5bce6ceb-6bb6-3d52-8482-170f7bfb65fd",
                                                "text": "Mam na imię Sara i pochodzę z kibucu spod Jerozolimy."
