                        "entry_id": "24c38e74-7fb1-3d30-8cd2-b98a182e2ae5",
                        "glosses": [
                            "Qui élève l’eau en la pressant."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cc275721-914c-454e-a992-c01e928aa0e4",
                                "sense_id": "284f756d-da78-3a4c-abac-63b73a56d3a7",
                                "text": "Ce système a l'avantage de supprimer l’attirail des tiges dans le puits d’exhaure ; il ne présente de difficulté que sous le rapport de la construction des pompes foulantes qui doivent supporter de très-grandes pressions."
                            },
                            {
                                "example_id": "1c8e6403-bece-4ea3-a499-5b9105a36164",
                                "sense_id": "284f756d-da78-3a4c-abac-63b73a56d3a7",
                                "text": "L’eau descendait de bassins en bassins pour finir au Grand Canal et revenir à l’étang de Clagny par une machine foulante."
                            }
                        ]
                    }
