                        "entry_id": "ba14b261-4e06-30f7-80c5-f03a879469e8",
                        "glosses": [
                            "Chanoine chargé d’enseigner la théologie et de prêcher en certaines occasions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f066380b-c438-499a-b34d-502916ae7b94",
                                "sense_id": "21a8e403-32f1-3880-ab92-4ba8eacbae45",
                                "text": "Il fut reçu maître ès-arts à l'âge de 27 ans et docteur en théologie en 1585. […]. Gabriel de Blaigny, évêque de Noyon, se l’attacha en qualité de théologal."
                            },
                            {
                                "example_id": "d1cf51f5-b413-4c2d-8a19-86890ade455d",
                                "sense_id": "21a8e403-32f1-3880-ab92-4ba8eacbae45",
                                "text": "M. Pierre-Nicolas Anot, prêtre, docteur en théologie, chanoine, théologal et grand-pénitencier de Reims, est mort le 21 octobre dernier, âgé de près de 61 ans."
                            }
                        ]
                    }
