                ],
                "senses": [
                    {
                        "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                        "entry_id": "88e280ae-2b6a-335d-932f-e3fa9902604b",
                        "glosses": [
                            "Atom eines Halbmetalls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b406545-a8b7-4b5a-bf9e-9b2476f69a7f",
                                "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                                "text": "„Ein Metall- oder Halbmetallatom kann in vielen Situationen eine kovalente Bindung zu einem Kohlenstoffatom knüpfen, wodurch eine organometallische Verbindung entsteht.“"
                            },
                            {
                                "example_id": "18bcc886-4552-486a-b13d-399d4cb0dd23",
                                "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                                "text": "„Typischerweise werden hier Verbindungen verwendet, die als Zentralatom ein Metall- oder Halbmetallatom enthalten, welches von verschidenen Liganden umgeben ist.“"
                            },
                            {
                                "example_id": "17522679-90ba-4d0f-ac95-aaaee4afed14",
                                "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                                "text": "„Von diesen sind diejenigen zum jeweiligen zentralen Halbmetallatom, das sich außerdem durch den ungewöhnlichen Bindungswinkel von 180° auszeichnet, die längsten.“"
                            },
                            {
                                "example_id": "924f372d-2eff-4830-9683-fc0dcc96310c",
                                "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                                "text": "„Metallorganische Chemie: Chemie organischer Verbindungen, in denen ein Kohlenstoffatom oder mehrere Kohlenstoffatome mit einem Metall- oder Halbmetallatom verknüpft sind.“"
                            },
                            {
                                "example_id": "ebfb38a6-5df8-44e4-81a2-33a5be4bd360",
                                "sense_id": "5ed38739-4fcc-3306-897c-d830c19ea68d",
                                "text": "Bor- und Siliciumatome sind Beispiele für Halbmetallatome."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
