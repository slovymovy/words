                "senses": [
                    {
                        "sense_id": "33db72e7-8c5d-3317-8f93-a9fb12cd61e8",
                        "entry_id": "d85f2a1a-bd89-38ea-b3fd-afe6033da1af",
                        "glosses": [
                            "im Baikalsee endemische Robbenart aus der Familie der Hundsrobben; einzig bekannte Robbenart, die ausschließlich in Süßwasser lebt"
                        ],
                        "tags": [
                            "Mammalogie"
                        ],
                        "examples": [
                            {
                                "example_id": "143bdecb-784b-47db-8eb4-f4c0ca2ac4a6",
                                "sense_id": "33db72e7-8c5d-3317-8f93-a9fb12cd61e8",
                                "text": "Die Baikalrobbe ist eine endemische Robbe des sibirischen Baikalsees."
                            },
                            {
                                "example_id": "6dbeefd0-49ce-4799-a74a-136220e10307",
                                "sense_id": "33db72e7-8c5d-3317-8f93-a9fb12cd61e8",
                                "text": "„Die seltene Baikalrobbe gilt als Wahrzeichen des Baikalsees: Ein mysteriöses Massensterben sorgt nun für Kopfzerbrechen. 140 Tiere sind bereits tot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "681892fd-7282-4789-affb-eb147ac81f2f",
                        "source_entry_id": "d85f2a1a-bd89-38ea-b3fd-afe6033da1af",
