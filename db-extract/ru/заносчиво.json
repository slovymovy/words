                    {
                        "translation_id": "a9782d17-f0ce-4843-b803-f17d7e0adb90",
                        "source_entry_id": "17c8eaff-f0bd-3e60-867e-c3513f9b4e28",
                        "source_sense_description": "высокомерно, самоуверенно, дерзко",
                        "target_lang_word": "arrogamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                        "entry_id": "77dc03dd-cdb1-3b64-b656-af3da7abcdbb",
                                        "glosses": [
                                            "Avec arrogance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e824b4af-3607-418f-be50-bb0fc3346512",
                                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                                "text": "Oser arrogamment se vanter à mes yeux,\nD’être juste seigneur du bien de mes aïeux !"
                                            },
                                            {
                                                "example_id": "62a1e8b9-a0e5-46b7-940a-b89431558368",
                                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                                "text": "Il a vu ses faisceaux marcher arrogamment et braver nos drapeaux."
                                            },
                                            {
                                                "example_id": "dcddf1b1-cecf-403b-874e-c872520d8178",
                                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                                "text": "Cependant le héros pudibond se rengorge comme un paon, et lève arrogamment la crête, lorsque son prôneur impudent ose égaler aux dieux le plus méprisable des faquins […]"
                                            },
                                            {
                                                "example_id": "92254503-7108-4783-8868-da40385088b9",
                                                "sense_id": "ffd0f4a2-69d4-3951-8711-c6293b727c85",
                                                "text": "L’âme comptait seule ; on posait arrogamment comme un fait l’immortalité de cette entité vague que nous n’avons jamais vu fonctionner dans l’absence du corps, avant de prendre la peine d’en prouver l’existence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2db7aad7-de4a-46a2-946b-8e05191481ac",
                        "source_entry_id": "17c8eaff-f0bd-3e60-867e-c3513f9b4e28",
