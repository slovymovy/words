                "senses": [
                    {
                        "sense_id": "9ed537af-8193-3b08-8ac7-def50e64ac72",
                        "entry_id": "8bc72a6e-36a3-3e51-ab81-7f3bedabcb72",
                        "glosses": [
                            "A regular."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "242507a0-f38b-4790-83f1-902b4eba463e",
                                "sense_id": "9ed537af-8193-3b08-8ac7-def50e64ac72",
                                "text": "I've been going to that chat room for months, and I know most of the regs by now."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9f3f873-0e7c-3a95-8a59-ac3fd7e95719",
                        "entry_id": "8bc72a6e-36a3-3e51-ab81-7f3bedabcb72",
                        "glosses": [
                            "A regulation."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "90b8d86e-c974-4776-bb1d-a273e15cad9a",
                                "sense_id": "e9f3f873-0e7c-3a95-8a59-ac3fd7e95719",
                                "text": "It makes me sad to see a prisoner complain about another prisoner not writing. His or her mailroom (or yours!) might have just tossed the letter; besides the rules and regs for prisoners writing each other are different in every state, and may change for no reason. Or, the rules may be ignored (especially for gay prisoners) also, even prisons that do accept mail from other prisoners, may not deliver it to people in isolation or on certain security levels."
                            }
                        ]
                    },
                    {
                        "sense_id": "57a54b12-6bcf-3c7b-8fb2-2be8c2539105",
                        "entry_id": "8bc72a6e-36a3-3e51-ab81-7f3bedabcb72",
