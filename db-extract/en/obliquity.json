                                                "example_id": "2d2d32d8-d512-459a-82f5-833f729ece9f",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Вкралась ошибка."
                                            },
                                            {
                                                "example_id": "d7f94c4a-20bd-4135-9f3a-1d23d02dcc87",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Орфографическая ошибка."
                                            },
                                            {
                                                "example_id": "3bef6646-8e10-434a-9e05-c7891050f43a",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Пишет с грубыми ошибками."
                                            },
                                            {
                                                "example_id": "6efda779-2839-469b-bace-26f3469c6185",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Хронологическая ошибка."
                                            },
                                            {
                                                "example_id": "07d8c321-1943-4343-a94c-6289e8cf780c",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Судебная ошибка."
                                            },
                                            {
                                                "example_id": "64c5bef2-a51b-4974-8c50-10ef0cf36261",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Он не делал ни одной ошибки в письме."
                                            },
                                            {
                                                "example_id": "880e9728-bc6e-4e15-8ee5-65a3075a241e",
                                                "sense_id": "6ad8abcf-9059-3a4e-a3c3-9c7664ef016d",
                                                "text": "Гораздо благороднее сознать свою ошибку, чем довести дело до непоправимого."
                                            }
