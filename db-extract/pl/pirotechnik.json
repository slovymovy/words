                                    {
                                        "sense_id": "02c9dabe-d051-3e0d-96df-7d16884ceaed",
                                        "entry_id": "9861cdbb-859f-3bb5-b703-4cc14d9f86ba",
                                        "glosses": [
                                            "A pyrotechnician: person skilled in the manufacture or setting off of fireworks and firework displays."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad596303-58e4-4ffe-84fc-d508910ab0f4",
                                                "sense_id": "02c9dabe-d051-3e0d-96df-7d16884ceaed",
                                                "text": "That the Secretary of the Navy be, and he is hereby, authorized to appoint a pyrotechnist for the service of the navy, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b05728bb-45f0-3e2f-bedd-45238cf244f6",
                                        "entry_id": "9861cdbb-859f-3bb5-b703-4cc14d9f86ba",
                                        "glosses": [
                                            "One who demonstrates a brilliant display, as of rhetoric or wit, or of virtuosity in the performing arts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4fedd17-48b4-43dd-afd8-cbe32237318f",
                                                "sense_id": "b05728bb-45f0-3e2f-bedd-45238cf244f6",
                                                "text": "\"It is thus the pyrotechnist (should we say demiurge?) who gives meaning to the so to speak explosive effervescences that are weaving the world of the spectator\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
