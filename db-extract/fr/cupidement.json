                                                "example_id": "629f2e50-a348-41f0-80e0-9df45e186c6b",
                                                "sense_id": "3e8d0305-5034-3a93-86a4-e1aaa95dc73a",
                                                "text": "There he ordered beer from the adenoidal Chinese manager and drank the afternoon away, greedily swilling bottle after bottle, feeling gradually his adulthood return."
