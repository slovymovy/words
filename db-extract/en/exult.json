                        "target_lang_word": "торжествова́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "торжествова́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "842cbfbe-2f5d-34e8-9f16-055a69b5841a",
                                        "entry_id": "d5ff2403-e249-30f0-bd93-b0ce562c6d4a",
                                        "glosses": [
                                            "устар. справлять торжество по какому-либо поводу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3b2724-d180-4867-9e3d-be125e1f03a2",
                                                "sense_id": "842cbfbe-2f5d-34e8-9f16-055a69b5841a",
                                                "text": "Победу над врагом Россия снова торжествует."
                                            },
                                            {
                                                "example_id": "7ebb5b8f-663f-47c0-bd05-765fd3c1fb70",
                                                "sense_id": "842cbfbe-2f5d-34e8-9f16-055a69b5841a",
                                                "text": "По старине торжествовали в их доме эти вечера (крещенские)."
                                            },
                                            {
                                                "example_id": "73add870-59bd-4a26-80fa-92d1f047b57c",
                                                "sense_id": "842cbfbe-2f5d-34e8-9f16-055a69b5841a",
                                                "text": "Не хнычем, а торжествуем и чествуем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce40a052-643f-3ebe-b86d-4d6515a0f36a",
                                        "entry_id": "d5ff2403-e249-30f0-bd93-b0ce562c6d4a",
                                        "glosses": [
                                            "быть победителем по отношению к кому-либо, чему-либо"
                                        ],
                                        "tags": [
                                            "над кем-чем и без доп."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "390834b3-ff9e-4172-911e-294bd1a73b5a",
                                                "sense_id": "ce40a052-643f-3ebe-b86d-4d6515a0f36a",
                                                "text": "Торжествовать над врагом."
                                            },
                                            {
                                                "example_id": "e6b1b9f5-fdb4-4144-8d75-ff28b1f53a22",
                                                "sense_id": "ce40a052-643f-3ebe-b86d-4d6515a0f36a",
                                                "text": "Порок любезен и в романе, и там уж торжествует он."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
