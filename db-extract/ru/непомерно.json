                    },
                    {
                        "translation_id": "dcc94abc-6d61-4f48-b088-788c7c535a55",
                        "source_entry_id": "d45bb48e-e464-3336-88c4-76b1f89787cc",
                        "source_sense_id": "60574cee-9270-37b7-b1fc-6e985ae3ef97",
                        "target_lang_word": "excessivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excessivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Avec excès, à un degré excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1446cec1-285f-4672-a3aa-78348edd0437",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Ma tante n’est plus si excessivement mal."
                                            },
                                            {
                                                "example_id": "fb624ef6-68d2-42e3-b395-b8364a2ec69c",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Puisqu’il en est question, je vous dirai tout net que cette liberté me déplaît excessivement."
                                            },
                                            {
                                                "example_id": "4bcb185d-9f65-4217-80d1-10f5bab19033",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Elle est devenue excessivement difficile pour sa chaussure, elle veut faire valoir son pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Extrêmement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1e2fd7-e34c-481b-bbf9-fbde01a18be4",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "On fabrique actuellement des tubes capillaires en verre excessivement fins. Ceux-ci, étirés par des ouvriers spéciaux, ont d’ordinaire une ouverture de deux dixièmes de millimètre."
                                            },
                                            {
                                                "example_id": "c559f0b3-fb2d-4d06-900c-7c684c9e8b87",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "Pendant la première semaine, la brise fut très légère et excessivement variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Un nombre excessif de, une quantité excessive de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db215b9a-32fd-4f3b-b52f-d4f7a24f4a2b",
                                                "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                                "text": "Face à des besoins d’argent pour répondre à la demande, les autorités monétaires ont créé excessivement de monnaie, entraînant un déséquilibre de la balance des paiements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "167376a8-cd57-41a1-8baa-bce27792c7ac",
                        "source_entry_id": "d45bb48e-e464-3336-88c4-76b1f89787cc",
                        "source_sense_id": "60574cee-9270-37b7-b1fc-6e985ae3ef97",
                        "target_lang_word": "démesurément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démesurément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                                        "entry_id": "37ee40da-ea16-3754-ac7a-bc94154c9da7",
                                        "glosses": [
                                            "D’une manière excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ad4530-a5f3-417a-9f86-57b233635997",
                                                "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                                                "text": "Le disque brillant se traînait avec lenteur sur l'horizon de l'ouest, et ses obliques rayons projetaient démesurément devant leurs pas les ombres des explorateurs."
                                            },
                                            {
                                                "example_id": "b87f8d08-c960-4ec1-8da8-634562689c6f",
                                                "sense_id": "8c5fb211-c54d-3b70-94ac-6e15dcc210f7",
                                                "text": "Une histoire banale au fond, démesurément grossie, transformée, dénaturée par les passions politiques, et religieuses!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4923d188-3d77-4b3e-b70d-8e85b7c58c5d",
                        "source_entry_id": "d45bb48e-e464-3336-88c4-76b1f89787cc",
                        "source_sense_id": "60574cee-9270-37b7-b1fc-6e985ae3ef97",
                        "target_lang_word": "outre mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outre mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                        "entry_id": "a59415fd-4a75-3056-87a7-3acda782482a",
                                        "glosses": [
                                            "Avec excès, déraisonnablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832e1862-e36d-4663-8183-a07beba3ca87",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Au bout d’une demi-heure, Lucien, se voyant décidément reçu avec une froideur marquée, se trouva à l’égard de la belle madame Grandet dans la situation d’un connaisseur qui marchande un tableau médiocre : tant qu’il compte l’avoir pour quelques louis, il s’exagère ses beautés ; les prétentions du vendeur s’élèvent-elles outre mesure, le tableau devient ridicule aux yeux du connaisseur, il ne voit plus que des défauts, et n’y songe que pour s’en moquer."
                                            },
                                            {
                                                "example_id": "6d70678d-bc3f-4942-8ba5-07f6a900c0e5",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Je ne puis m’empêcher de dire combien j’ai vu de souffrances peu connues et courageusement portées par une race d’hommes toujours dédaignée ou honorée outre mesure, selon que les nations la trouvent utile ou nécessaire."
                                            },
                                            {
                                                "example_id": "2cc9c602-6c7b-4043-95b7-d8d9d9a15054",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "C'était le frère de Sylvie qui nous rejoignait avec cette bonne gaieté rustique, suite obligée d'une nuit de fête, que des rafraîchissements nombreux avaient développée outre mesure."
                                            },
                                            {
                                                "example_id": "2ede7c08-f3df-44ef-b1f7-a708ac29fa64",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "– Le corps n’a pas été retrouvé, ce qui d’ailleurs ne saurait nous surprendre outre mesure."
                                            },
                                            {
                                                "example_id": "4939cf7a-cfc5-4cbd-a33a-bf816f3b95c5",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "– Je suis tout à fait étonné.\n– Je ne le suis pas outre mesure, dit Anne."
                                            },
                                            {
                                                "example_id": "713d6d59-1231-4ff5-9a8a-588fe61322be",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Les Bruxellois habitués des négociations difficiles, n’auront probablement pas été outre mesure surpris par l’épisode chaotique de ce week-end."
                                            },
                                            {
                                                "example_id": "4dd113d9-551a-4e51-8e52-d445c27bb297",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "La présence de Mescaleros n’inquiétait pas outre mesure les Navajos. Dans le passé, ils avaient parfois eu maille à partir avec eux, mais depuis leur exil commun, à Bosque-Redondo, les choses s’étaient considérablement apaisées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
