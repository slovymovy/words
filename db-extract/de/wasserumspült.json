                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8b5fe75-722f-30d2-9bc3-91970a217685",
                        "entry_id": "8a5c1019-125c-30db-84ca-df3a0c250a38",
                        "glosses": [
                            "von Wasser umspült"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6823d51-e455-4ed0-9f69-b776362056e7",
                                "sense_id": "f8b5fe75-722f-30d2-9bc3-91970a217685",
                                "text": "„Ich kann nicht an die tiefe See denken, ohne über die namenlosen Dinge zu erschaudern, die vielleicht gerade in diesem Augenblick auf ihrem schleimigen Grund kriechen und zappeln, um ihre uralten Steingötzen zu verehren und ihre abscheulichen Abbilder in unterseeische Obelisken aus wasserumspültem Granit zu kratzen.“"
                            },
                            {
                                "example_id": "bb438242-def3-45a3-bb2a-ad672e1609e9",
                                "sense_id": "f8b5fe75-722f-30d2-9bc3-91970a217685",
                                "text": "„Über die Reling gebeugt, beobachtete er, wie der getrocknete Schlick am Boden des Skiffs sich dunkel verfärbte, die Fugen entlang, in denen das wasserumspülte Werg nach und nach aufquoll.“"
                            },
                            {
                                "example_id": "9a200186-80ce-4695-bbc4-a0d251a480bc",
                                "sense_id": "f8b5fe75-722f-30d2-9bc3-91970a217685",
                                "text": "„Und als wäre es vom nahenden Entzug des Lichtes angefacht worden, wuchs mein Verlangen, die wasserumspülten Geheimnisse zu erkunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
