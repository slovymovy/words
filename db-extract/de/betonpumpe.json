                "senses": [
                    {
                        "sense_id": "292d4366-676f-3846-b1c6-dadc33abe892",
                        "entry_id": "e0dd6ccd-97a3-35b7-85e7-08dcaf01b197",
                        "glosses": [
                            "Pumpe, die zur Förderung von flüssigem Beton verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c12a65f-577c-4e7c-98b8-c131bcf2d755",
                                "sense_id": "292d4366-676f-3846-b1c6-dadc33abe892",
                                "text": "„Im Wesentlichen bestehen sie aus der Betonpumpe und einem vier bis fünfteiligen ausklappbaren Mast.“"
                            },
                            {
                                "example_id": "b178bda7-0d4c-4e7b-83fb-807dba44ad77",
                                "sense_id": "292d4366-676f-3846-b1c6-dadc33abe892",
                                "text": "„Gegen 9.20 Uhr waren Polizei und Freisinger Feuerwehr alarmiert worden, weil bei den Arbeiten zur Erweiterung des Fachmarktzentrums an der Münchner Straße ein Lastwagen mit einer tonnenschweren Betonpumpe umgefallen war und zwei Arbeiter unter sich begraben hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a242a65-d1aa-4c3b-8af5-2fb852a8c466",
                        "source_entry_id": "e0dd6ccd-97a3-35b7-85e7-08dcaf01b197",
                        "source_sense_id": "292d4366-676f-3846-b1c6-dadc33abe892",
                        "source_sense_description": "Pumpe, die zur Förderung von flüssigem Beton verwendet wird",
                        "target_lang_word": "pompe à béton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompe à béton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "616a0a9f-108c-3555-b7dc-ec354bd82b4c",
                                        "entry_id": "31dfdfb8-6fa7-3767-a351-c6abeaff3886",
                                        "glosses": [
                                            "Machine servant à acheminer le béton dans des tuyaux jusqu’au lieu de coulage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fee62d6-9694-4987-be2f-678bbdc62a2c",
                                                "sense_id": "616a0a9f-108c-3555-b7dc-ec354bd82b4c",
                                                "text": "Depuis ce vendredi matin, la circulation est réduite sur une seule bande le long de la N50, à hauteur de Ville-Pommeroeul. Un camion pompe à béton s’est renversé sur la chaussée."
                                            },
                                            {
                                                "example_id": "da159bbb-30dd-457f-8ff2-b35fe0f6dfad",
                                                "sense_id": "616a0a9f-108c-3555-b7dc-ec354bd82b4c",
                                                "text": "Sur l’ouvrage Verdun, une pompe à béton Mecbo de 270 bar de pression est employée pour couler dans le tunnel de 19 km, la plus puissante machine actuellement utilisée en France !"
                                            },
                                            {
                                                "example_id": "3cf83c17-9872-4025-b6d3-1fb40ae3cea0",
                                                "sense_id": "616a0a9f-108c-3555-b7dc-ec354bd82b4c",
                                                "text": "Liebherr lance sa plus petite pompe à béton dans la gamme des 30 mètres. La 31 XXT, avec sa flèche en 5 parties se distingue par sa faible hauteur de dépliage de 5,4 m."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
