{
    "word_family": [
        "bride",
        "bridal",
        "bridegroom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3acf477-83a3-3f19-b3ce-c16fa1976ae5",
                    "sense_definition": "A woman or girl who attends a bride during her wedding ceremony as part of the wedding party.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wedding_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She asked her sister to be the chief <w>bridesmaid</w> at her wedding.",
                            "target_lang_translations": {
                                "ru": "Она попросила сестру быть главной <w>подружкой невесты</w> на её свадьбе."
                            }
                        },
                        {
                            "text": "Each <w>bridesmaid</w> wore a matching pale blue dress for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>подружка невесты</w> надела на церемонию одинаковое светло-голубое платье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chief bridesmaid",
                        "always the bridesmaid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина или девушка, сопровождающая невесту во время свадебной церемонии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подружка невесты",
                                "target_lang_sense_clarification": "наиболее частое и современное обозначение"
                            },
                            {
                                "target_lang_word": "свидетельница",
                                "target_lang_sense_clarification": "главная подружка невесты, расписывающаяся в загсе"
                            },
                            {
                                "target_lang_word": "подневестница",
                                "target_lang_sense_clarification": "традиционное или устаревшее название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2186a2c2-75f1-3599-aa72-a9f3e90e4fc2",
                    "sense_definition": "A person or team that repeatedly finishes in second place or comes close to success but never wins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "runner_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After another runner-up finish, the team was tired of being the perpetual <w>bridesmaid</w>.",
                            "target_lang_translations": {
                                "ru": "После очередного второго места команде надоело быть <w>вечно второй</w>."
                            }
                        },
                        {
                            "text": "She had been a <w>bridesmaid</w> in three major tournaments before finally winning gold.",
                            "target_lang_translations": {
                                "ru": "Она оставалась <w>вечно второй</w> на трёх крупных турнирах, пока наконец не завоевала золото."
                            }
                        }
                    ],
                    "synonyms": [
                        "runner-up"
                    ],
                    "antonyms": [
                        "champion",
                        "winner"
                    ],
                    "common_phrases": [
                        "perpetual bridesmaid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или команда, которые постоянно занимают вторые места или останавливаются в шаге от победы, никогда не выигрывая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечно второй",
                                "target_lang_sense_clarification": "о человеке или команде, не способных занять первое место"
                            },
                            {
                                "target_lang_word": "вечный серебряный призёр",
                                "target_lang_sense_clarification": "в спортивном контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "323cd629-851e-31b4-bd79-457a20230b61",
                    "sense_definition": "To act as a bridesmaid for someone during a wedding ceremony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wedding_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She agreed to <w>bridesmaid</w> for her childhood friend next summer.",
                            "target_lang_translations": {
                                "ru": "Она согласилась <w>быть подружкой невесты</w> у своей подруги детства следующим летом."
                            }
                        },
                        {
                            "text": "He remembered when she had <w>bridesmaided</w> for his older sister several years ago.",
                            "target_lang_translations": {
                                "ru": "Он помнил, как несколько лет назад она <w>была подружкой невесты</w> у его старшей сестры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used conversationally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть подружкой невесты на свадьбе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть подружкой невесты",
                                "target_lang_sense_clarification": "выполнять роль подружки невесты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}