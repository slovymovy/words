    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "944696cd-ce79-397d-9219-ced9339d5d0f",
                    "sense_definition": "Funny or amusing in a slightly odd or peculiar way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eccentricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian is famous for his <w>wacky</w> sense of humor and strange costumes.",
                            "target_lang_translations": {
                                "ru": "Комик знаменит своим <w>чокнутым</w> чувством юмора и странными костюмами."
                            }
                        },
                        {
                            "text": "The children loved the <w>wacky</w> characters in the cartoon because they were so unpredictable.",
                            "target_lang_translations": {
                                "ru": "Детям очень понравились <w>эксцентричные</w> персонажи мультфильма, потому что они были такими непредсказуемыми."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "whacky",
                        "zany",
                        "crazy",
                        "silly"
                    ],
                    "antonyms": [
                        "serious",
                        "sensible",
                        "conventional"
                    ],
                    "common_phrases": [
                        "wacky sense of humor",
                        "wacky characters",
                        "wacky ideas"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in informal speech to describe something silly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешной или забавный, но при этом слегка странный, причудливый или эксцентричный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чокнутый",
                                "target_lang_sense_clarification": "в значении забавный и странный"
                            },
                            {
                                "target_lang_word": "эксцентричный",
                                "target_lang_sense_clarification": "необычный и вызывающий смех"
                            },
                            {
                                "target_lang_word": "дурашливый",
                                "target_lang_sense_clarification": "глуповатый, но милый и смешной"
                            },
                            {
                                "target_lang_word": "с чудинкой",
                                "target_lang_sense_clarification": "о человеке или идее с причудами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dda104e3-7abe-3af4-9d53-79902af1e278",
                    "sense_definition": "Alternative form of <w>wacke</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist identified the rock sample as a type of <w>wacky</w> found in this region.",
                            "target_lang_translations": {
                                "ru": "Геолог определил образец породы как разновидность <w>вакки</w>, встречающейся в этом регионе."
                            }
                        },
                        {
                            "text": "In older textbooks, you might find the term <w>wacky</w> used to describe certain sedimentary formations.",
                            "target_lang_translations": {
                                "ru": "В старых учебниках можно встретить термин <w>вакка</w>, используемый для описания определенных осадочных образований."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая или альтернативная форма термина «вакка» (тип осадочной горной породы)."
