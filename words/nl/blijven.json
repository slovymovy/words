    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6da211b7-4265-38ba-acb6-808121cebb43",
                    "sense_definition": "op een bepaalde plaats aanwezig zijn en daar niet weggaan",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Blijf</w> hier wachten, ik ga even kijken wat er aan de hand is.",
                            "target_lang_translations": {
                                "en": "<w>Stay</w> here and wait, I'm going to see what's going on."
                            }
                        },
                        {
                            "text": "Zij wil dit weekend liever <w>blijven</w> slapen bij haar beste vriendin.",
                            "target_lang_translations": {
                                "en": "She would rather <w>stay</w> over at her best friend's house this weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertoeven",
                        "verblijven"
                    ],
                    "antonyms": [
                        "vertrekken",
                        "weggaan"
                    ],
                    "common_phrases": [
                        "blijven slapen",
                        "thuis blijven",
                        "hier blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "to be present in a certain place and not leave"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "to remain in a place"
                            },
                            {
                                "target_lang_word": "remain",
                                "target_lang_sense_clarification": "to stay in a location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ff82bf3-3c42-3d5b-b483-5715a23af13e",
                    "sense_definition": "in een bepaalde toestand of conditie niet veranderen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>blijft</w> vervelend dat de trein elke ochtend te laat komt.",
                            "target_lang_translations": {
                                "en": "It <w>remains</w> annoying that the train is late every morning."
                            }
                        },
                        {
                            "text": "Ik hoop dat het weer vandaag de hele middag droog zal <w>blijven</w>.",
                            "target_lang_translations": {
                                "en": "I hope the weather will <w>stay</w> dry all afternoon today."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortduren",
                        "aanhouden"
                    ],
                    "antonyms": [
                        "veranderen",
                        "worden"
                    ],
                    "common_phrases": [
                        "rustig blijven",
                        "gelijk blijven",
                        "vrienden blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "to not change from a certain state or condition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "to continue to have a quality"
                            },
                            {
                                "target_lang_word": "remain",
                                "target_lang_sense_clarification": "to continue unchanged in condition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76574aa2-34e3-3486-b097-d8506b7955e5",
                    "sense_definition": "doorgaan met een handeling zonder ermee op te houden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "continuering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat er ook gebeurt, je moet altijd <w>blijven</w> lachen en positief denken.",
                            "target_lang_translations": {
                                "en": "Whatever happens, you must always <w>keep</w> smiling and thinking positively."
                            }
                        },
                        {
                            "text": "De vervelende man <w>blijft</w> maar praten terwijl niemand naar hem luistert.",
                            "target_lang_translations": {
                                "en": "The annoying man just <w>keeps</w> talking while nobody is listening to him."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorgaan",
                        "continueren"
                    ],
                    "antonyms": [
                        "stoppen",
                        "ophouden"
                    ],
                    "common_phrases": [
                        "blijven proberen",
                        "blijven hopen",
                        "blijven werken"
                    ],
                    "target_lang_definitions": {
                        "en": "to continue with an action without stopping"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "to continue doing something"
                            },
                            {
                                "target_lang_word": "continue",
                                "target_lang_sense_clarification": "to persist in an activity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
