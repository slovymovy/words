                                    {
                                        "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                        "entry_id": "9235ea52-b148-3ae7-9ab8-99d039ad019c",
                                        "glosses": [
                                            "duża, w zupełności wystarczająca ilość czegoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ccaf63-bd39-47dd-8a38-4f7d88503cd0",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Nie będą już wiedzieli o obfitości w tym kraju wskutek głodu, który potem nadejdzie, bo będzie to głód bardzo ciężki."
                                            },
                                            {
                                                "example_id": "a2bbf424-341e-4ddc-af9e-94f3cbbfc5d6",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Wiedział, gdzie najłatwiej poławiają się kiełbie i płotki, lub w największej obfitości mieszkają szczupaki, u jakich brzegów raki najgęściej obsiadają podwodne mchy i kamienie, w jakiej porze dnia i roku jakie gatunki ryb na jakie biorą się przynęty"
                                            },
                                            {
                                                "example_id": "785867f8-fbb6-4f27-a0b2-3e159a41ad9e",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Mamy szczęście, że żyjemy w kraju pokoju i obfitości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2764762-3d94-4e4f-8e14-a712cc333012",
                        "source_entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
