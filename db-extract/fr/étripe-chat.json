                "senses": [
                    {
                        "sense_id": "1cabef4a-bdbb-335d-bdd2-a3a31859af9f",
                        "entry_id": "3334d53e-b4a5-36d6-b39b-99d62e321bef",
                        "glosses": [
                            "Sorte de glaive."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "75e5ccb6-4bad-43f9-8f8c-2818417cf46d",
                                "sense_id": "1cabef4a-bdbb-335d-bdd2-a3a31859af9f",
                                "text": "Il est possible que le reste de l’équipement, l’épée courte dite Katzbalger (étripe-chat) et le costume si caractéristiques du statut de baroudeur professionnel (la barrette ornée de plumes, les manches et les chausses multicolores à crevés, la braguette proéminente, les chaussures en pied d’ours) soit à la charge de celui-ci."
                            },
                            {
                                "example_id": "c75691c5-cc60-416f-9d83-b259fd4d51eb",
                                "sense_id": "1cabef4a-bdbb-335d-bdd2-a3a31859af9f",
                                "text": "Nous glissons dans le fourreau sur notre ventre le glaive à lame épaisse réglementaire – que nous appelons plus volontiers mutileuse ou étripe-chat – mais mon père seul porte un pistolet à sa ceinture, son privilège de capitaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f5d7e0e-6ef1-319a-8cbb-1b9a6e4569a0",
                        "entry_id": "3334d53e-b4a5-36d6-b39b-99d62e321bef",
                        "glosses": [
                            "Sorte de barreau, armé de crochets, dans l’embrasure d’une fenêtre ou d'un soupirail, pour en limiter l'accès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b7d764-a544-4110-a260-1069b3b363b3",
                                "sense_id": "4f5d7e0e-6ef1-319a-8cbb-1b9a6e4569a0",
                                "text": "Les fenêtres minuscules sont protégées par des herses de main de forge travaillées en «étripe-chat» (B)."
                            },
                            {
                                "example_id": "5880ca2f-c9e2-4f81-bda1-18c611e7ef50",
                                "sense_id": "4f5d7e0e-6ef1-319a-8cbb-1b9a6e4569a0",
                                "text": "Puis, un peu plus à l’ouest, un soupirail condamné mais toujours garni de son étripe-chat fut à son tour dégagé."
                            },
                            {
                                "example_id": "01640868-b1ab-4c4d-a177-a090eff69da6",
                                "sense_id": "4f5d7e0e-6ef1-319a-8cbb-1b9a6e4569a0",
                                "text": "La fenêtre et l’œil-de-bœuf au-dessus de la porte, décoré d'un estripo-cat (étripe-chat), donnent sur la campagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5fb3115-ad10-4c4e-bd2e-95179853c345",
                        "source_entry_id": "3334d53e-b4a5-36d6-b39b-99d62e321bef",
                        "source_sense_description": "Pour le glaive",
                        "target_lang_word": "Katzbalger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katzbalger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                        "entry_id": "d4722f08-f8d1-3613-beb6-238ca3f8e60e",
                                        "glosses": [
                                            "ein europäisches Kurzschwert des 16. Jahrhunderts, das von Landsknechten im Zweikampf während einer Schlacht eingesetzt wurde"
                                        ],
                                        "tags": [
                                            "Waffenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ea3d5f-5bca-4410-b1dc-07f590c850df",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "Der Katzbalger ist mit einer Klingenlänge um die 50 cm nicht sonderlich lang und läuft zur abgerundeten Spitze zu."
                                            },
                                            {
                                                "example_id": "0dc74749-3b13-4d02-9294-af813caa4f00",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "Die Griffe und Parierstangen der Katzbalger waren teilweise reich verziert und mit dekadenten Zusätzen, wie zum Beispiel Besteckscheiden ausgestattet."
                                            },
                                            {
                                                "example_id": "06aeaa45-6ed8-4c58-a1fe-ca424ca89e3e",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "Getragen wurde der Katzbalger in einer horizontal am Waffengürtel befestigten Lederscheide."
                                            },
                                            {
                                                "example_id": "b515005f-57cd-428a-a296-0e1b4800c669",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "Diese »Katzbalger« wurden mit Hellebarden vor der ersten Reihe der Knechte aufgestellt und ließen im Augenblick vor dem Zusammenstoß die Hellebarden in schrägem Hieb auf die Speerspitzen der Feinde fallen, damit die Spießknechte eilig in die Lücken sprangen und an den Leib der Feinde kamen."
                                            },
                                            {
                                                "example_id": "73963751-e082-418d-8b87-48f74117c144",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "Der Katzbalger wurde durch die italienische Schiavona abgelöst."
                                            },
                                            {
                                                "example_id": "85f7e243-c4ed-434d-91e9-2a6f36a7dfe4",
                                                "sense_id": "bcf36ac4-4179-3155-8f06-12bcf090e79f",
                                                "text": "„Für den einfachen Fußknecht kommt aber nur der Katzbalger infrage, ein Kurzschwert mit siebzig Zentimeter langer Klinge für den Nahkampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
