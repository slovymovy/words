                    {
                        "form_id": "98c9d1eb-8725-40ca-a250-01e397f037fe",
                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Fliegenfänger"
                    },
                    {
                        "form_id": "7626eb60-dc8b-4bc9-9047-567cddbd1ec2",
                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fliegenfänger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                        "glosses": [
                            "mit klebrigem Leim versehener Papierstreifen zur Befestigung an der Zimmerdecke, an dem Fliegen und andere störende Insekten haften bleiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01d6dda-04ec-430f-b19e-afac52dd0e57",
                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                "text": "„Ein Streifen Leimpapier hing als Fliegenfänger von der Decke hinunter, um den die Fliegen lustig herumgaukelten, ahnten sie doch nicht, daß er ihnen Verderben brachte.“"
                            },
                            {
                                "example_id": "c6c2b588-17bf-45c3-972e-310877f41eb0",
                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                "text": "„Von der Lampe hing ein gelber Fliegenfänger herab.“"
                            },
                            {
                                "example_id": "bf711895-54b6-4cef-8269-900a81853dce",
                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                "text": "„Aber er deutet gegen die Decke, von der, umsummt und umsurrt von Fliegen, ein Fliegenfänger hängt.“"
                            },
                            {
                                "example_id": "8531437c-e5c0-41fe-a5ac-bd1f32287e89",
                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                "text": "„Sie ging in ein Zimmer, in dem müde Blattpflanzen standen, alte Magazine herumlagen und Fliegen einen Fliegenfänger umsummten, der von der Decke über den Tisch hing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "157be4e9-f80d-35bc-a46b-4a2254e42288",
                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                        "glosses": [
                            "schlechter Torwart (einer, der selten Bälle fängt, der oft danebengreift)"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e398ebfa-f794-4451-947b-744b063545de",
                                "sense_id": "157be4e9-f80d-35bc-a46b-4a2254e42288",
                                "text": "„Ist ja wieder typisch, dass ausgerechnet dieser Fliegenfänger Lehmann das Theater mit der Schuhwahl anzettelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b1b1b80-7059-4643-8176-4a00ff256d3d",
                        "source_entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                        "source_sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                        "target_lang_word": "flypaper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flypaper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b07b165-a666-3461-bc80-c5c2fba26369",
                                        "entry_id": "6b8fa16f-4d37-3e3f-b492-1282a0b1ae7a",
                                        "glosses": [
                                            "A strip of paper coated with a sticky, often poisonous, substance that catches and kills flies that land on it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flypaper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "558e0693-8e75-3133-b44d-f8b641dfcf69",
                                        "entry_id": "bed09171-3aaf-370a-944b-5d6855bb7470",
                                        "glosses": [
                                            "To cause something to become stuck with, or as if with, flypaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea5f101-00e8-49f8-a7a1-04694da8a913",
                                                "sense_id": "558e0693-8e75-3133-b44d-f8b641dfcf69",
                                                "text": "He gets flypapered by a task that should be turned over to a subordinate."
                                            },
                                            {
                                                "example_id": "66d964cc-7f03-4597-b88d-76509a227c8c",
                                                "sense_id": "558e0693-8e75-3133-b44d-f8b641dfcf69",
                                                "text": "Cover painting that flypapered the eyes were very important to G-8 sales, and Frederick Blakeslee's mixing of fantasy with the realistic texture of machines had a hypnotic effect on impressionable coin-holders."
                                            },
                                            {
                                                "example_id": "06027c1d-2282-4319-8af0-a8a3e6e95343",
                                                "sense_id": "558e0693-8e75-3133-b44d-f8b641dfcf69",
                                                "text": "In 'The Vertical Ladder,\" a hapless adolescent is flypapered fast in perpetuity, a mean little speck, on the mast of implacability."
                                            },
                                            {
                                                "example_id": "df41a7ee-191a-4e5e-829f-c34476f492d0",
                                                "sense_id": "558e0693-8e75-3133-b44d-f8b641dfcf69",
                                                "text": "Hysterical parties on her dorm floor concussed the hallways with music and produced a semi-permanent layer of trodden chips flypapered onto the carpet by spilled beer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
