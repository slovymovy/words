                    {
                        "translation_id": "1034a549-eb61-415f-b0c1-a403d9b2afbb",
                        "source_entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                        "source_sense_description": "organized search",
                        "target_lang_word": "Verbrecherjagd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrecherjagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5cfed53-9f51-3b9e-924b-448212ce461b",
                                        "entry_id": "4c6d0c6a-39b8-36c1-80cc-72ca73cc088a",
                                        "glosses": [
                                            "Verfolgung eines Kriminellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eedd4531-58c0-4d06-ac44-10f3ae3bf349",
                                                "sense_id": "d5cfed53-9f51-3b9e-924b-448212ce461b",
                                                "text": "Heute gehen wir auf Verbrecherjagd."
                                            },
                                            {
                                                "example_id": "529642be-06ac-4fd7-be28-ec2d019d2b21",
                                                "sense_id": "d5cfed53-9f51-3b9e-924b-448212ce461b",
                                                "text": "„Die schöne Domino hängte ihre Karriere als Fotomodell an den Nagel, um als Kopfgeldjägerin auf Verbrecherjagd zu gehen.“"
                                            },
                                            {
                                                "example_id": "be71cac3-223f-43f9-a194-a72b2c76ef3e",
                                                "sense_id": "d5cfed53-9f51-3b9e-924b-448212ce461b",
                                                "text": "„Ich habe während meiner bunten, wechselvollen Karriere in mancherlei Ländern mancherlei Tiere gejagt, aber nie hat mich ein Sport so begeistert wie diese verrückte, wahnsinnig schnelle Verbrecherjagd die Themse hinunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ee2bae-351a-40e5-8bd0-957c5422df9e",
                        "source_entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                        "source_sense_description": "organized search",
                        "target_lang_word": "Menschenjagd",
                        "target_lang_code": "de",
                        "note": "for innocents, e.g. to enslave",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenjagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb335259-edf4-3c9f-90e2-b7955b80100b",
                                        "entry_id": "6892b0fa-5ae1-36f8-ab6f-9e8985295439",
                                        "glosses": [
                                            "Jagd auf/Verfolgung von Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b287e63-90d3-4836-bd34-6cf0a216db8d",
                                                "sense_id": "cb335259-edf4-3c9f-90e2-b7955b80100b",
                                                "text": "„Sie selbst gehen fast nie auf Menschenjagd.“"
                                            },
                                            {
                                                "example_id": "ecc0f8c0-c709-4300-9cd1-8d7e1499b87a",
                                                "sense_id": "cb335259-edf4-3c9f-90e2-b7955b80100b",
                                                "text": "„Die Menschenjagd ist eröffnet.“"
                                            },
                                            {
                                                "example_id": "c0d8c764-b460-4c43-8cf4-26d6e8d64d7e",
                                                "sense_id": "cb335259-edf4-3c9f-90e2-b7955b80100b",
                                                "text": "„Im Vorfrühling 1942 brach die Menschenjagd im Getto, bisher systematisch betrieben, plötzlich ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
