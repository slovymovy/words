                ],
                "senses": [
                    {
                        "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                        "entry_id": "3d953376-ed9d-39d6-bab6-f9f78a17d645",
                        "glosses": [
                            "Schuss, Wurf oder Schlag, bei dem das Spielgerät (meist ein Ball) schräg nach vorn (= diagonal) über die Spielfläche gespielt wird"
                        ],
                        "tags": [
                            "Ballsport",
                            "(beispielsweise Fußball, Feldhockey, Eishockey)"
                        ],
                        "examples": [
                            {
                                "example_id": "081c222c-1645-41b4-9ba1-61dc22a9d20e",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "Es gibt Spieler, die recken den Daumen hoch, obwohl sie der Diagonalpass um zehn Meter oder mehr verfehlt hat."
                            },
                            {
                                "example_id": "5235f2cd-46bb-4a39-bb4d-822e44935f45",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Es gibt nicht nur dieses Kurzpassspiel, sondern auch lange Bälle, Diagonalpässe und Flanken.“"
                            },
                            {
                                "example_id": "3908a4a2-551a-4326-abfe-5b773198599c",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Ein Diagonalpass auf den linken Flügel setzt die Bayer-Abwehr außer Gefecht.“"
                            },
                            {
                                "example_id": "b3bfbfd8-762f-48c2-91c5-e7026c0f6342",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Ein Diagonalpass von Fabian Zeidler kam zu Michi Schaffler, doch der vergab freistehend aus zehn Meter.“"
                            },
                            {
                                "example_id": "0c017aab-d768-4ab7-b681-cecb2d5614cc",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Konter der Kölner: Ein Diagonalpass von Heintz findet Guirassy, der in den Strafraum läuft.“"
                            },
                            {
                                "example_id": "f4cdacf9-8b4e-475e-93ea-06373945d4b4",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Das war mal ein ordentlicher Angriff von Freiburg: Koch setzt mit einem schönen Diagonalpass Höler auf der rechten Außenbahn ein.“"
                            },
                            {
                                "example_id": "e08a61fc-764b-4817-a8c9-24ff4abd525c",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Nach einem langen Diagonalpass tauchte Eilers (5.) plötzlich vor Ralf Fährmann auf, der Schalke-Keeper wehrte gerade noch ab.“"
                            },
                            {
                                "example_id": "49b612cf-1074-4c5f-bc7e-83e4d63dff2e",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Schließlich hebelte Russlands Kapitän Andrej Arschawin mit einem flachen Diagonalpass die gesamte tschechische Hintermannschaft aus.“"
                            },
                            {
                                "example_id": "9237dbdd-cee3-46d9-94c9-f63db4a94925",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Ein langer, flacher Diagonalpass in die Spitze genügte, um die Bremer Hintermannschaft auszuhebeln.“"
                            },
                            {
                                "example_id": "20e10cb4-1a02-4d05-b185-5e0104df2b38",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„Aber nur eine Minute später der Ausgleich: herrlicher Diagonalpass von Matthew Leckie aus dem Mittelfeld in den Strafraum, noch schönere Volley-Abnahme von Cahill an die Unterkante der Latte und von dort ins Tor (21.).“"
                            },
                            {
                                "example_id": "0ae98ed5-b9ec-457c-8fe2-71884fe1ddb5",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "„5 Minuten später revanchiert sich Haarhausen bei Müller, indem er ihn am Strafraum per schönem Diagonalpass freispielt, und dieser sofort und ebenso platziert mit einem Schuss ins lange Eck das 7:2 markiert.“"
                            },
                            {
                                "example_id": "476428bd-2d80-4550-832d-ae5f6d156482",
                                "sense_id": "46c52fa6-610f-34df-94a7-ef5869322555",
                                "text": "[SV Meppen:] „Dennoch wurden das Hindenburgstadion, die ländlich-derbe Atmosphäre und das kampfbetonte Spiel der Männer um Torjäger Van der Pütten alsbald zum Synonym für die Zweite Liga, in der eine zünftige Grätsche im Zweifel produktiver war als ein Diagonalpass in die Spitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
