                        "glosses": [
                            "The state of being boring."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d60332f7-7892-4e41-816a-2fa6ed57d110",
                                "sense_id": "2fc10c91-8c0d-379e-8079-9e150659c97c",
                                "text": "“An intolerable mixture of impertinence and boreism,—has not even the points of an effective character about him,—or I might make some use of him in a Farce.”"
                            },
                            {
                                "example_id": "4868c3cf-504d-4321-b6f2-5f8dc01f341f",
                                "sense_id": "2fc10c91-8c0d-379e-8079-9e150659c97c",
                                "text": "Earnestness should not be allowed to lead to boreism—too much insistence is distasteful."
                            },
                            {
                                "example_id": "056d4909-d2c6-48f7-b472-2dd0e08a5986",
                                "sense_id": "2fc10c91-8c0d-379e-8079-9e150659c97c",
                                "text": "We all looked forward with pleasurable anticipation to the bunking-in with Co. G, but we wot not of the familiarity that never savored of boreism which was ours for the whole two weeks."
                            }
                        ]
                    }
