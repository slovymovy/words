                ],
                "senses": [
                    {
                        "sense_id": "ced4d1f5-4b23-3b64-9a4a-7da10e86dd37",
                        "entry_id": "0bf64630-0d7b-3747-8573-7bd6a9d1ba06",
                        "glosses": [
                            "Initialism of rare earth element."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "1feec55a-a621-4086-8466-d8171d9fb670",
                                "sense_id": "ced4d1f5-4b23-3b64-9a4a-7da10e86dd37",
                                "text": "REE-bearing minerals in these occurrences are allanite, betafite, brannerite, davidite, euxenite, fergusonite, florencite, monazite, polycrase, samarskite, synchysite, thorite, xenotime and yttrocrasite."
                            },
                            {
                                "example_id": "839770b0-56b0-47bd-b1a2-8c57a996125f",
                                "sense_id": "ced4d1f5-4b23-3b64-9a4a-7da10e86dd37",
                                "text": "The International Union of Pure and Applied Chemistry (IUPAC) definition of the REE group includes lanthanides (Ln), yttrium (Y) and scandium (Sc)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
