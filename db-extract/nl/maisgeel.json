                        "tags": [],
                        "form": "maïsgeel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c75e7fe-5ac1-3b26-8fac-fd4b02a396e0",
                        "entry_id": "7495c2f8-f6d4-32a4-8117-c3084e2095a8",
                        "glosses": [
                            "in een tint geel met RAL-nummer 1006 ( )."
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "eb1cfd41-9c36-4e9c-be1f-096caccb5ffa",
                                "sense_id": "8c75e7fe-5ac1-3b26-8fac-fd4b02a396e0",
                                "text": "De zijkant was een egaal maisgeel vlak."
                            },
                            {
                                "example_id": "bbac2141-7582-438f-ac45-e40e4bdd15f6",
                                "sense_id": "8c75e7fe-5ac1-3b26-8fac-fd4b02a396e0",
                                "text": "Hij rijdt in een maisgele auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f2dc9f-95df-4937-8060-4fdb10305359",
                        "source_entry_id": "7495c2f8-f6d4-32a4-8117-c3084e2095a8",
                        "source_sense_id": "8c75e7fe-5ac1-3b26-8fac-fd4b02a396e0",
                        "target_lang_word": "Maisgelb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "58999f75-7ed2-4e79-8b27-13bfb57cc7a3",
                        "source_entry_id": "7495c2f8-f6d4-32a4-8117-c3084e2095a8",
                        "source_sense_id": "8c75e7fe-5ac1-3b26-8fac-fd4b02a396e0",
                        "target_lang_word": "maisgelb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maisgelb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                        "entry_id": "cc843dad-e1f2-3de9-b01e-f1695d97f424",
                                        "glosses": [
                                            "in, von dem für reife Maiskörner typischen intensivem Gelb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fff6483-62b9-4d3c-89bc-5df03313a4c3",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "Mein neues Kleid ist maisgelb."
                                            },
                                            {
                                                "example_id": "95c81579-366b-48d8-b1f0-8b7ee9470c1c",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "„Sie trug, wie er es sich immer ausgemalt hatte, ein maisgelbes Kleid, ein Geschenk von ihm.“"
                                            },
                                            {
                                                "example_id": "aaf476bc-3a8f-42a3-8c49-3d461abda9f0",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "«Schon von weitem blitzen die maisgelben Sonnenschirme durch das satte Laubgrün, weisen auf die neue Gartenbeiz hin, deren Betreiber seit April ihre Zelte aufgeschlagen haben.»"
                                            },
                                            {
                                                "example_id": "ce26a6df-1f50-44ed-975f-8dbb7107455f",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "„In einer Siedlung unweit der Hafenstadt Haifa steht die älteste Waldorfschule Israels. Eine Ansammlung maisgelber Häuschen, umgeben von viel Grün.“"
                                            },
                                            {
                                                "example_id": "5a5bcc2c-8c78-42a4-b5b8-ef7004446692",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "„Úlfur ignorierte ihre Worte und hielt ihr ein Trägerkleid aus maisgelbem Wollstoff hin, das am Fußende des Bettes gelegen hatte.“"
                                            },
                                            {
                                                "example_id": "507905b2-a162-49b1-8bd2-1fd4ae72a880",
                                                "sense_id": "96ba3b99-8d9c-3ce5-8fa0-4642a979378c",
                                                "text": "„Olivenschwarzer Lidstrich, künstliche Wimpern, Schmetterlingsbrille, himbeerfarbener Lidschatten, Pailletten, bronzenes Make-up, Puder-Rouge, kirschroter Lippenstift, nachgezogene Lippen, maisgelbe Perücke, Netzstrümpfe, ungeheuer hochhackige Schuhe, die aus der Ferne wirkten wie Spielzeugtürme, und ein fließendes Kleid mit Blattmuster, das hinten bis zum Boden reichte: So stand er vor mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
