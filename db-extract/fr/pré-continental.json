                        "examples": [
                            {
                                "example_id": "fe2c33e5-2dff-4588-a83f-0f3ee81b65d9",
                                "sense_id": "a0d485ae-4e6e-361e-af51-ee23bd21933e",
                                "text": "B. Le plateau pré-continental du golfe du Lion, d’après J. Bourcart. Noter que le rebord du plateau pré-continental, qui commence à –150 m et s’accentue après 200 dans l’Atlantique, débute vers –100 en Méditerranée."
                            },
                            {
                                "example_id": "dd1d7677-a21d-4951-a16a-2cc94fa56247",
                                "sense_id": "a0d485ae-4e6e-361e-af51-ee23bd21933e",
                                "text": "C’est maintenant la pente du plateau et le glacis pré-continental —zones de transition vers les bassins océaniques— qui font l’objet des ambitions à la fois scientifiques et industrielles."
                            }
                        ]
                    }
