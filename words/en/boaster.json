{
    "word_family": [
        "boast",
        "boastful",
        "boastfully",
        "boastfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82bfeff4-af50-3ff3-93b3-313471c1355d",
                    "sense_definition": "A person who habitually boasts or speaks with excessive pride about themselves.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person_who_brags",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody liked listening to the <w>boaster</w> describe his exaggerated achievements.",
                            "target_lang_translations": {
                                "ru": "Никому не нравилось слушать, как этот <w>хвастун</w> расписывает свои преувеличенные достижения."
                            }
                        },
                        {
                            "text": "He was known among his classmates as a relentless <w>boaster</w>.",
                            "target_lang_translations": {
                                "ru": "Среди одноклассников он был известен как неисправимый <w>хвастун</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blowhard",
                        "braggart",
                        "bragger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который постоянно хвастается или излишне гордится собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастун",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "хвастунья",
                                "target_lang_sense_clarification": "женщина"
                            },
                            {
                                "target_lang_word": "бахвал",
                                "target_lang_sense_clarification": "хвастун, хвастунишка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e47c732-988c-377a-bd42-28a0cc3e4bed",
                    "sense_definition": "A broad-faced chisel used by stonemasons for dressing stone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stonemason_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason reached into his toolbox for a <w>boaster</w> to smooth the rough block.",
                            "target_lang_translations": {
                                "ru": "Каменщик полез в ящик с инструментами за <w>скарпелем</w>, чтобы загладить необработанный блок."
                            }
                        },
                        {
                            "text": "Using a hammer and a <w>boaster</w>, he shaped the limestone surface evenly.",
                            "target_lang_translations": {
                                "ru": "С помощью молотка и <w>широкого зубила</w> он ровно обработал поверхность известняка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое зубило (скарпель), используемое каменщиками для черновой обработки и выравнивания камня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скарпель",
                                "target_lang_sense_clarification": "широкое зубило каменщика"
                            },
                            {
                                "target_lang_word": "широкое зубило",
                                "target_lang_sense_clarification": "инструмент для обработки камня"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}