                        ]
                    },
                    {
                        "translation_id": "be72d4e4-6af2-4ee5-ab4b-ad0a0564bc0c",
                        "source_entry_id": "e588b1a6-f1be-32cc-9ae7-be2c7e83f49c",
                        "source_sense_id": "4985df59-d7cf-3ded-b734-a9b44a50c99e",
                        "source_sense_description": "practice of following a vegetarian diet",
                        "target_lang_word": "végétarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "végétarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                        "entry_id": "14ab84c2-5522-30ba-9462-24ebecaea7db",
                                        "glosses": [
                                            "Système d’alimentation ne consommant pas les viandes et toute chair animale : poisson, fruits de mer, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23dcf271-e60b-41d2-80c5-9deae21c010b",
                                                "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                                "text": "Comment se pose la question du végétarisme, du crudivorisme et de la macrobiotique pour les informateurs de la deuxième génération, c'est-à-dire ceux qui ont suivi un régime non carné ou macrobiotique pendant leur enfance ou dès leur naissance, […]."
                                            },
                                            {
                                                "example_id": "07c5325f-508b-4e9e-acb9-978c5a84bc59",
                                                "sense_id": "d11259ae-09dd-3651-befe-dbeb4c94268b",
                                                "text": "Dans une Inde gouvernée depuis 2014 par les nationalistes du BJP sous la houlette du Premier ministre Narendra Modi, l'idéologie du végétarisme –symbole de l'hindouisme pur– n'a rien d'étonnant et prend des formes violentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5992fd6-e400-4170-83f0-3fe191d67b81",
                        "source_entry_id": "e588b1a6-f1be-32cc-9ae7-be2c7e83f49c",
                        "source_sense_id": "4985df59-d7cf-3ded-b734-a9b44a50c99e",
                        "source_sense_description": "practice of following a vegetarian diet",
                        "target_lang_word": "Vegetarismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vegetarismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                                        "entry_id": "b18b012d-b537-3bc1-9cf3-1b1ddc9dccd9",
                                        "glosses": [
                                            "Ernährungseinstellung, die einen Verzicht auf Fleisch und Fisch sowie gegebenenfalls weiterer tierischer Produkte bedingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cebb0fdc-7684-48ca-b821-b25efa88fda7",
                                                "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                                                "text": "In Indien ist Vegetarismus sehr verbreitet."
                                            },
                                            {
                                                "example_id": "524eb7c0-6fcd-4652-bc4e-13e855590b55",
                                                "sense_id": "72c23986-db99-31a1-8ad3-38e9cce5e004",
                                                "text": "„Es gab 1974 wesentlich mehr Vegetarier oder dem gelegentlichen Vegetarismus nicht abgeneigte Menschen, als er kannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "518041a2-72f9-4ab1-823b-c33947a98a91",
