                                "example_id": "085f0a29-f2ae-4c00-8195-262ec2f1c8b7",
                                "sense_id": "6e332612-77ff-3e3f-b316-2e80dfc794ef",
                                "text": "Österreich-Ungarns Hauptstadt war Wien."
                            },
                            {
                                "example_id": "fdebca97-2599-42ea-be61-a8fcdeb14348",
                                "sense_id": "6e332612-77ff-3e3f-b316-2e80dfc794ef",
                                "text": "„Die amtliche Bezeichnung Österreich-Ungarns lautete seit 1806 Österreichische Monarchie, seit dem ungarischen Ausgleich von 1867 Österreichisch-ungarische Monarchie.“"
