                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Pièce de bois ou d’autre matière soutenue par le milieu de manière qu’en pesant sur l’un des bouts on fait lever l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17834518-5bce-48b0-9a28-ba67379a4eba",
                                                "sense_id": "3e964f05-c697-35d1-a4b1-a3b27a066f5c",
                                                "text": "La bascule d’un pont-levis."
                                            },
                                            {
                                                "example_id": "766214b8-7635-4233-a00e-33d9b8c1bcae",
                                                "sense_id": "3e964f05-c697-35d1-a4b1-a3b27a066f5c",
                                                "text": "Une bascule qui n’est pas assez chargée."
                                            },
                                            {
                                                "example_id": "a7195c0d-9465-470c-b942-0727170cbd50",
                                                "sense_id": "3e964f05-c697-35d1-a4b1-a3b27a066f5c",
                                                "text": "La bascule d’une souricière."
                                            },
                                            {
                                                "example_id": "74305aa5-d1d9-45b0-abd8-593efe511715",
                                                "sense_id": "3e964f05-c697-35d1-a4b1-a3b27a066f5c",
                                                "text": "La bascule d’un loquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbf9b79-1912-3ad5-8571-634068f19b84",
                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Jeu où deux personnes, étant chacune sur le bout d’une pièce de bois mise en équilibre, s’amusent à se balancer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c57c2a1c-3ab3-31a0-af04-c5c13e9ba0a5",
                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Mouvement semblable à celui de la bascule."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29461bf7-9bbb-44c7-8eda-0be02f02d521",
                                                "sense_id": "c57c2a1c-3ab3-31a0-af04-c5c13e9ba0a5",
                                                "text": "Faire la bascule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecdaa26-4932-3f19-b2d1-6f46ad737ab7",
                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Genre de balance dont on se sert pour peser les objets lourds et encombrants. → voir balance de Quintenz"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88efeed9-d171-40c5-a80b-43944c2baf95",
                                                "sense_id": "7ecdaa26-4932-3f19-b2d1-6f46ad737ab7",
                                                "text": "Il faut remplir les sacs de charbon de cinquante kilos sur la bascule en tenant compte des différentes qualités : anthracite, flambant, tête de moineau, boulet, une quinzaine de variétés au moins, et charger la voiture à bras."
                                            },
                                            {
                                                "example_id": "1abe80a1-8e18-4d81-993e-6e663213471c",
                                                "sense_id": "7ecdaa26-4932-3f19-b2d1-6f46ad737ab7",
                                                "text": "Il y a des bascules dans les gares de chemins de fer."
                                            },
                                            {
                                                "example_id": "c65720f5-958d-4d00-8be1-016fd55d6a62",
                                                "sense_id": "7ecdaa26-4932-3f19-b2d1-6f46ad737ab7",
                                                "text": "La bascule serait réparée tous les ans, et l’on ne serait plus obligé de retrancher dix kilos de chaque pesée, comme si la colonne d’air qui est au-dessus de la plaque surpassait d’un nombre infini de kilomètres toutes les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7768c8d5-429e-365e-ba43-0f1cafd6b7f3",
                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Dispositif qui fait fonction de bascule ou de levier dans un appareil de serrurerie, d’horlogerie, de fumisterie, de menuiserie, etc."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e3ce09-b17a-430d-9258-212214bec607",
                                                "sense_id": "7768c8d5-429e-365e-ba43-0f1cafd6b7f3",
                                                "text": "Couteau à bascule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa033209-fa43-3ce9-97ec-0dfd7f046608",
                                        "entry_id": "622cd6bb-3b21-381a-aa54-efc9e7f843a7",
                                        "glosses": [
                                            "Circuit possédant deux états stables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9106484a-e5be-45a8-94b3-3e4e755d8d1c",
                                                "sense_id": "fa033209-fa43-3ce9-97ec-0dfd7f046608",
                                                "text": "la bascule a été la première mémoire électronique, elle reste très utilisée en raison de sa rapidité."
                                            }
                                        ]
                                    }
                                ]
                            },
