                        ],
                        "form": "den Schupo"
                    },
                    {
                        "form_id": "0bc5f8e3-c2f8-4625-be08-cc4d7546a115",
                        "entry_id": "cf3d4cec-0fff-3f36-a3ce-901cad2c6034",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schupos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                        "entry_id": "cf3d4cec-0fff-3f36-a3ce-901cad2c6034",
                        "glosses": [
                            "Schutzpolizist"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "7f85b622-c0a2-4865-887a-9129805cb472",
                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                "text": "„Der Schupo hatte unterdes die Karte gelesen.“"
                            },
                            {
                                "example_id": "c7385e07-b764-4937-af57-36e2322ea2cc",
                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                "text": "„Auf der Straße stand ein Lastwagen mit Schupos.“"
                            },
                            {
                                "example_id": "bb7d186f-a1c7-444f-a36a-b04fd6be3f51",
                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                "text": "„Die Schupos haben jetzt blaue Uniformen.“"
                            },
                            {
                                "example_id": "ddbbf7ab-abfa-432f-bc95-77b0efdfb604",
                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                "text": "„In diesem Moment öffnete sich die Türe und drei Schupos polterten herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
