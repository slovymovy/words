                                "example_id": "6b64be48-3d53-49fc-9c48-3f6aaa2b8b2b",
                                "sense_id": "1c48a0a7-7331-3be2-b85c-7a1dfb8c05fd",
                                "text": "Essen wir heute Sashimi?"
                            }
