                    {
                        "sense_id": "57977aef-f31e-39e0-82ec-f1b7488ff45c",
                        "entry_id": "0dd3286b-46c7-30e5-acd8-aee0d630762b",
                        "glosses": [
                            "A prefecture-level city and subprovincial city, the provincial capital of Jilin, in northeastern China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf30c48-d8f1-44aa-b6cf-40ae79b8d216",
                                "sense_id": "57977aef-f31e-39e0-82ec-f1b7488ff45c",
                                "text": "It costs but from $0.86 to $1.14 per ton to load Japanese coal into the cars at the mines, and as these are under the control of the South Manchuria Railway it is said that coal is freighted to Changchun free."
                            },
                            {
                                "example_id": "05f3bd87-2134-4051-b311-30b35854dc3f",
                                "sense_id": "57977aef-f31e-39e0-82ec-f1b7488ff45c",
                                "text": "A “big-character” wall appearing in Changchun, Kirin Province, on Feb. 2, denounced the Chinese Communist regime’s crackdown on dissidents clamoring for human rights, an intelligence report from the Chinese mainland said April 3.\nThe wall poster accused the Peiping regime [of] \"practicing Fascist totalitarianism,\" the report said, adding that some 40 people in Changchun had been arrested for putting up wall posters."
                            },
                            {
                                "example_id": "799e6f12-c18e-4aa5-a658-0fde86c7f6a2",
                                "sense_id": "57977aef-f31e-39e0-82ec-f1b7488ff45c",
                                "text": "At least one person was killed and another was injured in a series of explosions Friday afternoon in the northeastern Chinese city of Changchun, the local authorities said.\nThe police are tentatively treating the explosions as “a criminal case,” the propaganda office of the Changchun Municipal Communist Party Committee said in a statement posted online."
                            }
                        ]
                    }
