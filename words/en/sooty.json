{
    "word_family": [
        "soot"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "42d8a9b7-1ada-384b-bd95-8ad6a478cb96",
                    "sense_definition": "Relating to or producing soot",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "soot-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sooty</w> smoke from the chimney covered the roof in a layer of black dust.",
                            "target_lang_translations": {
                                "cs": "<w>Sazový</w> kouř z komína pokryl střechu vrstvou černého prachu."
                            }
                        },
                        {
                            "text": "Old factories often released a <w>sooty</w> exhaust that polluted the nearby air.",
                            "target_lang_translations": {
                                "cs": "Staré továrny často vypouštěly <w>zakouřené</w> zplodiny, které znečišťovaly okolní vzduch."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sooty atmosphere"
                    ],
                    "target_lang_definitions": {
                        "cs": "Týkající se sazí nebo produkující saze"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sazový",
                                "target_lang_sense_clarification": "vztahující se k sazi"
                            },
                            {
                                "target_lang_word": "zakouřený",
                                "target_lang_sense_clarification": "produkující kouř se sazemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52958816-a200-3c4f-a235-6e66a3f955f6",
                    "sense_definition": "Covered or stained with soot",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "soot-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After cleaning the fireplace, his hands were completely <w>sooty</w> and black.",
                            "target_lang_translations": {
                                "cs": "Po vyčištění krbu měl ruce úplně <w>od sazí</w> a černé."
                            }
                        },
                        {
                            "text": "The <w>sooty</w> walls showed that the old stove had been leaking for years.",
                            "target_lang_translations": {
                                "cs": "<w>Začouzené</w> stěny ukazovaly, že stará kamna roky propouštěla kouř."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrytý nebo ušpiněný sazemi"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "od sazí",
                                "target_lang_sense_clarification": "ušpiněný od sazí"
                            },
                            {
                                "target_lang_word": "začouzený",
                                "target_lang_sense_clarification": "pokrytý vrstvou sazí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f9bf2f-e6ce-3b65-a375-aabbfd78f587",
                    "sense_definition": "Having the dark color of soot",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a <w>sooty</w> shade of grey to paint the stormy sky.",
                            "target_lang_translations": {
                                "cs": "Umělec použil <w>sazově</w> šedý odstín k namalování bouřlivé oblohy."
                            }
                        },
                        {
                            "text": "She wore a <w>sooty</w> black dress that looked elegant in the dim light.",
                            "target_lang_translations": {
                                "cs": "Měla na sobě <w>uhelně</w> černé šaty, které v šeru vypadaly elegantně."
                            }
                        }
                    ],
                    "synonyms": [
                        "black",
                        "inky"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající tmavou barvu sazí"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sazově černý",
                                "target_lang_sense_clarification": "velmi tmavá barva"
                            },
                            {
                                "target_lang_word": "uhelně černý",
                                "target_lang_sense_clarification": "přirovnání k barvě uhlí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb45957a-77c5-390a-9e4a-68a4c2e3b3a3",
                    "sense_definition": "Having dark skin",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text described the traveler as having a <w>sooty</w> complexion from the desert sun.",
                            "target_lang_translations": {
                                "cs": "Historický text popisoval cestovatele jako někoho s <w>tmavou</w> pletí od pouštního slunce."
                            }
                        },
                        {
                            "text": "The poem refers to a <w>sooty</w> figure standing in the shadows of the alley.",
                            "target_lang_translations": {
                                "cs": "Báseň odkazuje na <w>smuhlou</w> postavu stojící ve stínech uličky."
                            }
                        }
                    ],
                    "synonyms": [
                        "dusky",
                        "swarthy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term is considered offensive and outdated when used to describe people."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající tmavou pleť (zastaralé a urážlivé)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tmavý",
                                "target_lang_sense_clarification": "popis pleti"
                            },
                            {
                                "target_lang_word": "smuhlý",
                                "target_lang_sense_clarification": "zastaralý výraz pro tmavou pleť"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15bfcaf7-8c24-33df-8e7b-4bf2eaaf3089",
                    "sense_definition": "To make something dirty or black with soot",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soot-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaking oil lamp began to <w>soot</w> the ceiling above the table.",
                            "target_lang_translations": {
                                "cs": "Tekoucí olejová lampa začala <w>začouzet</w> strop nad stolem."
                            }
                        },
                        {
                            "text": "The heavy smoke from the fire will <w>soot</w> the curtains if we do not open a window.",
                            "target_lang_translations": {
                                "cs": "Hustý kouř z ohně <w>začoudí</w> záclony, pokud neotevřeme okno."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ušpinit nebo začernit něco sazemi"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "začoudit",
                                "target_lang_sense_clarification": "pokrýt sazemi z kouře"
                            },
                            {
                                "target_lang_word": "začernit sazemi",
                                "target_lang_sense_clarification": "způsobit znečištění sazemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}