                        "entry_id": "f4ada261-6825-39bb-9ebe-90c1d6c6d502",
                        "glosses": [
                            "een vrouwelijke beoefenaar van de sociologie"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "59dcb0ac-c27b-49bd-9277-7e93df05d52b",
                                "sense_id": "ceb5d1a7-054d-336f-a061-1cbeea6916cf",
                                "text": "OpinieSociologe Aline van de Watering voelt zich zo thuis bij Denk dat ze zich in dit opiniestuk afvraagt hoe andere mensen geen bewondering kunnen hebben voor de positiviteit van de partij."
                            },
                            {
                                "example_id": "593b62f7-975e-4721-b3df-12ef24cb5406",
                                "sense_id": "ceb5d1a7-054d-336f-a061-1cbeea6916cf",
                                "text": "De Marokkaanse sociologe en feministe Fatima Mernissi is maandag op 75-jarige leeftijd overleden, zo meldde haar Franse uitgever. Een van de bekendste werken van de hoogleraar aan de universiteit van Rabat, die betoogde dat de islam te verenigen is met democratie, is Achter de sluier."
                            }
                        ]
                    }
