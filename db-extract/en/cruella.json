                ],
                "senses": [
                    {
                        "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                        "entry_id": "acff0ad8-6eb1-309b-93d5-3b27c9f4c497",
                        "glosses": [
                            "A cruel, despicable, or otherwise unpleasant woman."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "956ffb9b-4d4c-467d-9fab-c2921e4458a0",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "But I am left to wonder, what kind of a government, what kind of a Cruella, could cut retirement benefits to a group of Eskimos in their eighties, in the dead of an Alaskan winter, and say: Sorry, there is nothing we can do."
                            },
                            {
                                "example_id": "9b417a65-5aec-4560-ad0d-c17ab122444c",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "One person may be a refined aristocrat in a social setting, and switch to a Cruella at the steering wheel. If you believe you are in good shape and find yourself snapping at others with less power than yourself, watch out, as your emotional stability may only be a façade."
                            },
                            {
                                "example_id": "81da70ea-a34e-43a1-9e5b-9269c2eb4da8",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "Ari immediately liked this woman he had heard about for more than a year. She didn’t seem like a Cruella at all."
                            },
                            {
                                "example_id": "94f27c43-6826-471a-a862-95063842ab3e",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "This is not to say that I’m advocating using negativity to make others miserable. (No one likes a Cruella.)"
                            },
                            {
                                "example_id": "8536bfc9-f8b4-4d10-a5a1-d1a22b9c0e92",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "There are Cruellas out there and should any new recruits have the misfortune to meet a Cruella in the workplace then this resource would give you information of some behaviours and actions that you would encounter since the core natures of criminal and corporate psychopaths are the same."
                            },
                            {
                                "example_id": "e6acb2ad-478b-4f5b-a343-754f0a883f74",
                                "sense_id": "40937ec0-99f0-3642-81b2-310080069f71",
                                "text": "We begged. We cried. We asked her not to call the principal. But, sadly enough, it didn’t work. She was a Cruella. We begged someone who didn’t know what forgiveness was."
                            }
                        ]
                    }
