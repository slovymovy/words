                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En français, les noms et les adjectifs sont des mots <w>variables</w>."
