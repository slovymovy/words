                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31bdfd59-9d7f-4074-86b0-84c49aaf4227",
                                                "sense_id": "3b19e607-572d-3052-9ae0-550c618647b3",
                                                "text": "Auf der Straße war ein Film von Öl, der mich von der Straße abbrachte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3d3b152-b13c-355b-a890-abef013e9edd",
                                        "entry_id": "a09a7553-71a0-32d2-896e-1532de795233",
                                        "glosses": [
                                            "Material für die Fotografie von statischen Bildern"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c012b6-8ec8-4bf3-a8a6-a5c86bd1942d",
                                                "sense_id": "c3d3b152-b13c-355b-a890-abef013e9edd",
                                                "text": "Der Film wurde belichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                        "entry_id": "a09a7553-71a0-32d2-896e-1532de795233",
                                        "glosses": [
                                            "Abfolge von verschiedenen Bildern (heute in der Regel mit Tonspur und digital, siehe auch Video)"
                                        ],
                                        "tags": [
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d16a74-5e62-44ed-8801-e735bfe209dc",
                                                "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                                "text": "Dieser Film wurde für den Oscar nominiert."
                                            },
                                            {
                                                "example_id": "75921924-2bb8-4367-825c-335c157903b1",
                                                "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                                "text": "„Der Film war ganz anders, als ich es mir vorgestellt hatte.“"
                                            },
                                            {
                                                "example_id": "0c19d464-04c8-4ed5-b6a0-615bba9eef9a",
                                                "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                                "text": "„Da war der Film auch schon wieder aus.“"
                                            },
                                            {
                                                "example_id": "507f47d6-36a0-4950-b715-ec15856eb46a",
                                                "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                                "text": "„Man schaut sich den Film einfach in der türkischen Synchronisation an und gewöhnt sich langsam an den wunderbaren Klang dieser Sprache.“"
                                            },
                                            {
                                                "example_id": "c75a7203-cfa3-45a2-a9d3-ad7d7aa8103b",
                                                "sense_id": "36a5eff6-e009-3d02-9d44-302ead178b49",
                                                "text": "„Forstrat Bertram, Meixner durch die gemeinsame Jagd verbunden, hatte einen Film über die seit längerem beobachteten Baumschäden gedreht, den er gern in dieser Runde gezeigt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "901f5fa8-54be-3535-be4a-ca267368a9f2",
                                        "entry_id": "a09a7553-71a0-32d2-896e-1532de795233",
                                        "glosses": [
                                            "Kunstrichtung und Industriezweig, der Filme^([3]) produziert"
                                        ],
                                        "tags": [
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ca4ea5-2024-4314-9748-820b0ce00b54",
                                                "sense_id": "901f5fa8-54be-3535-be4a-ca267368a9f2",
                                                "text": "Er arbeitet beim Film."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
