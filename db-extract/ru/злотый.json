                        "examples": [
                            {
                                "example_id": "dff5112c-5294-40d2-82ec-404208e916d9",
                                "sense_id": "6ec858e5-663b-3d5a-89d9-9bca8d71c054",
                                "text": "Я бросился туда и за один злотый нанял у хозяина самое запачканное платье до утра."
                            },
                            {
                                "example_id": "27957314-1d40-4850-a5ab-d91d6d0ce630",
                                "sense_id": "6ec858e5-663b-3d5a-89d9-9bca8d71c054",
                                "text": "Польский злотый, скажем, уже конвертируемый, и что?"
                            }
                        ]
                    }
