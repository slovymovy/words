                        ],
                        "form": "die Bedeutungswandel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                        "entry_id": "5b85c0be-121f-36f5-a128-3c3d895806f7",
                        "glosses": [
                            "Veränderung der Bedeutung eines sprachlichen Ausdrucks mit der Zeit; der Begriff wird vorwiegend auf die Veränderungen bei Wörtern angewendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007c1073-3909-4dc2-9e53-15763979bcc2",
                                "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                                "text": "Wörter unterliegen im Lauf der Zeit Bedeutungswandeln; das Wort Weib z.B. hat - außer in biblischen Zusammenhängen - in der Konkurrenz mit dem Wort Frau eine starke Bedeutungsverschlechterung erfahren, da es heute fast nur noch negativ verstanden wird."
                            },
                            {
                                "example_id": "6a992fc6-4e5f-41ff-b9d3-f3a3ae9d6bb3",
                                "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                                "text": "„In einer Lexikologie sind also die Probleme besonders zu betrachten, die die lexikalisch-semantischen Aspekte der Wortbildung berühren: die Prozesse der Motivation, Demotivierung, Lexikalisierung und Idiomatisierung, die Zusammenhänge von Wortbildung und Wortbedeutung und Bedeutungswandel.“"
                            },
                            {
                                "example_id": "7d0dbbf0-c9a7-47ca-9d47-49548c03f9c2",
                                "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                                "text": "„Aber selbstverständlich ist es Aufgabe der Wissenschaft, die Fülle der Erscheinungen zu ordnen und die Vorgänge beim Bedeutungswandel der Wörter so zu beschreiben, daß man sie miteinander vergleichen kann.“"
                            },
                            {
                                "example_id": "02963464-ef48-45a0-b80f-0d4356cf76ac",
                                "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                                "text": "„Allerdings ist dabei der historische Sprachwandel, insbesondere der Bedeutungswandel vieler Elemente des Lexikons zu beachten.“"
                            },
                            {
                                "example_id": "c89e5b56-f865-4ea2-9802-19d18ab3cf24",
                                "sense_id": "8407f579-f80b-3fbb-ad6d-b68a02332145",
                                "text": "„Zum Mittelhochdeutschen hin ist ein bemerkenswerter Bedeutungswandel festzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
