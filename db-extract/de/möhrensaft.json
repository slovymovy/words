                                "example_id": "dcfa7922-8f2e-48b6-ac54-8255c7ff7aca",
                                "sense_id": "59583e9c-2111-328c-8360-1f0af145fc73",
                                "text": "Sie trinkt jeden Morgen ein Glas Möhrensaft."
                            },
