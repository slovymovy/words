            "senses": [
                {
                    "sense_id": "9a7e085a-dad9-3e42-8e0b-7213d7e9f26c",
                    "sense_definition": "Niet uitgenodigd, ongevraagd op bezoek komend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uninvited",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het huis is goed beveiligd tegen <w>ongenode</w> gasten.",
                            "target_lang_translations": {
                                "en": "The house is well secured against <w>uninvited</w> guests."
                            }
                        },
                        {
                            "text": "We willen geen <w>ongenode</w> bezoekers op ons besloten feest hebben.",
                            "target_lang_translations": {
                                "en": "We do not want any <w>uninvited</w> visitors at our private party."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongevraagd",
                        "ongewenst"
                    ],
                    "antonyms": [
                        "genood"
                    ],
                    "common_phrases": [
                        "ongenode gasten",
                        "ongenode bezoekers"
                    ],
                    "target_lang_definitions": {
                        "en": "Not invited, coming to visit without being asked."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uninvited",
                                "target_lang_sense_clarification": "not having received an invitation"
                            },
                            {
                                "target_lang_word": "unbidden",
                                "target_lang_sense_clarification": "without being asked or invited"
                            },
                            {
                                "target_lang_word": "unwelcome",
                                "target_lang_sense_clarification": "not wanted or welcome"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae3d95d5-33dc-3f84-9902-86752ca2b0f5",
                    "sense_definition": "Zonder dwang of drang gebeurend; uit vrije wil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unforced",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed haar verhaal geheel <w>ongenood</w> en in alle rust.",
                            "target_lang_translations": {
                                "en": "She told her story completely <w>unprompted</w> and in all peace."
                            }
                        },
                        {
                            "text": "Zonder enige druk van buitenaf gaf hij een <w>ongenood</w> advies.",
                            "target_lang_translations": {
                                "en": "Without any external pressure, he gave <w>unsolicited</w> advice."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijwillig",
                        "ongedwongen"
                    ],
                    "traits": [
                        {
