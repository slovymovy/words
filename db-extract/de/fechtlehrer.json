                "senses": [
                    {
                        "sense_id": "cd019e5b-ff8f-3ac8-b62a-ec7255d52c93",
                        "entry_id": "2325ecb2-e1a4-3af2-a5b8-338793ae3f9f",
                        "glosses": [
                            "Lehrer, der Unterricht im Fechten gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6d1ebf-a560-47a7-ac32-df43a605b565",
                                "sense_id": "cd019e5b-ff8f-3ac8-b62a-ec7255d52c93",
                                "text": "„Normalerweise ist es an dem Fürsten (König, Herzog, was immer), den heranwachsenden Sohn, der bisher sein Leben mit Haus-, Fecht- und Tanzlehrern verbracht hat (und mit der Jagd), langsam an die Regierungsgeschäfte heranzuführen.“"
                            },
                            {
                                "example_id": "e63b832e-98cb-4d7c-8e35-773a556caa78",
                                "sense_id": "cd019e5b-ff8f-3ac8-b62a-ec7255d52c93",
                                "text": "„Er sah die beiden Fechtlehrer in langen schwarzen Röcken und weißen Halsbinden mannhaft ausfallen und parieren, bis einer von ihnen fiel, an dessen Stelle – nachdem die Kameras abgeblendet hatten – der Hauptdarsteller trat (aus Garderoberücksichten war er gezwungen gewesen dem nunmehr Besiegten seinen Rock zu leihen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
