                                        "entry_id": "ece0bd48-545f-3b43-9853-270a70a46959",
                                        "glosses": [
                                            "weibliche Person, die nicht mehr überwiegend erwerbstätig ist und ihren Lebensunterhalt aus einer Rente, also einer gesetzlichen oder privaten Versicherungsleistung, bestreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a398aab-32f3-46e8-aa15-276af91038ef",
                                                "sense_id": "4f6780a0-4246-3a92-be67-a27423f6df3b",
                                                "text": "Sie genießt ihr Leben als Rentnerin."
                                            },
                                            {
                                                "example_id": "9c9bdde4-aa78-4e68-8e79-aa99d065ebb1",
                                                "sense_id": "4f6780a0-4246-3a92-be67-a27423f6df3b",
                                                "text": "„Jeden Abend regte Tante Dagmar sich über die Rentnerinnen auf, die erst kurz vor Ladenschluß einkaufen gingen, wenn die berufstätige Bevölkerung Feierabend habe.“"
                                            },
                                            {
                                                "example_id": "fdcdab68-8ee9-4626-83e8-8f5cdcf95e6c",
                                                "sense_id": "4f6780a0-4246-3a92-be67-a27423f6df3b",
                                                "text": "„In den letzten Krisen-Jahren bekam Stavroula, die inzwischen Rentnerin war, immer weniger Geld vom Staat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "327c8482-9017-481b-b314-1df705f5b531",
