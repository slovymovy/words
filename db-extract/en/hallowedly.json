                        "entry_id": "95a3ffe7-1b9c-3281-a35a-cd7d0079e87c",
                        "glosses": [
                            "In a hallowed, sacred, or solemn manner; sacredly; solemnly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e94d263-9e3b-444d-bef0-b9fc982f04f9",
                                "sense_id": "61383ef7-a67b-3578-9113-7a06ceea5d03",
                                "text": "So hallowedly have ye fulfilled your part, My pride repudiates ev'n the sigh that blends With Poland's name — name written on my heart."
                            },
                            {
                                "example_id": "0c2d5f08-ef23-492e-869d-1156dace998b",
                                "sense_id": "61383ef7-a67b-3578-9113-7a06ceea5d03",
                                "text": "At first, during regeneration in spirit, it finds its way to an enchanted wood, and then, arriving at integration, it breaks into the open and discovers a hallowedly resplendent world."
                            },
                            {
                                "example_id": "5d717539-a202-4e4c-bfb5-f0f386f552c1",
                                "sense_id": "61383ef7-a67b-3578-9113-7a06ceea5d03",
                                "text": "The Ground of Being begins to take on the sense, in Washburn's beautiful phrase, of the self's own \"hallowedly resplendent home.\""
                            },
                            {
                                "example_id": "44abfd7f-305d-4b73-9f86-518a7783a206",
                                "sense_id": "61383ef7-a67b-3578-9113-7a06ceea5d03",
                                "text": "She shall be with me, sweetly and hallowedly, for the time it takes for me to fill these pots."
                            }
                        ]
                    }
