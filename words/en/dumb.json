    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b72386cf-b8c7-3996-924d-cdbd8e969b2f",
                    "sense_definition": "Lacking intelligence or good judgment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be <w>dumb</w>; wear a helmet when you ride your bike.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>глу́пым</w>; надевай шлем, когда катаешься на велосипеде.",
                                "tr": "<w>Aptallık etme</w>; bisiklete binerken kask tak.",
                                "zh": "别<w>犯傻</w>了，骑自行车时要戴头盔。"
                            }
                        },
                        {
                            "text": "He felt <w>dumb</w> after forgetting his own phone number.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>глу́пым</w>, забыв свой собственный номер телефона.",
                                "tr": "Kendi telefon numarasını unuttuktan sonra kendini <w>aptal</w> gibi hissetti.",
                                "zh": "忘了自己的电话号码后，他觉得自己很<w>笨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stupid",
                        "unintelligent",
                        "foolish",
                        "brainless",
                        "dense",
                        "slow",
                        "silly"
                    ],
                    "antonyms": [
                        "smart",
                        "intelligent"
                    ],
                    "common_phrases": [
                        "play dumb",
                        "dumb luck",
                        "look dumb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий высоким интеллектом или здравым смыслом.",
                        "tr": "Aptalca veya mantıksız davranan, zekadan yoksun.",
                        "zh": "缺乏智慧或判断力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глу́пый",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "тупо́й",
                                "target_lang_sense_clarification": "разговорное, грубое"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aptal",
                                "target_lang_sense_clarification": "genel kullanım"
                            },
                            {
