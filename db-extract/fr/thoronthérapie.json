                        "examples": [
                            {
                                "example_id": "a083f1d8-4ede-4387-9455-da2575937e63",
                                "sense_id": "2c9dca7e-9db4-389b-879a-86c31149c70d",
                                "text": "L'infra-rouge est utilisé contre les affections articulaires chroniques, la sciatique, la cellulite, tandis que la thoronthérapie a pour applications principales le rhumatisme goutteux, les anémies et les leucémies chroniques."
                            },
                            {
                                "example_id": "ea019f46-635f-486b-9afd-f51ca10fc3fa",
                                "sense_id": "2c9dca7e-9db4-389b-879a-86c31149c70d",
                                "text": "La Société Sadera construit suivant les procédés Vaugeois de nombreux appareils destinés à utiliser l'émanothérapie (radon et thoronthérapie). Les générateur d'émanation se présentent sous la forme de tubes métalliques renfermant une matière productrice de thoron ou de radon."
                            }
                        ]
                    }
