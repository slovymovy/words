                        "glosses": [
                            "Any ungulate mammal with an odd number of toes and belonging to the Perissodactyla, an equid, a tapir, or a rhinoceros."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1c6f56-af68-4277-acc0-5a9640528777",
                                "sense_id": "faf03cc5-ef1a-3428-9ac6-4e230c8406cf",
                                "text": "The chalicotheres were among the strangest mammals that ever lived. They were perissodactyls - relatives of horses, rhinos and tapirs - and if all you had seen of one was its head, you might have mistaken it for a very strange horse."
                            }
                        ]
                    }
