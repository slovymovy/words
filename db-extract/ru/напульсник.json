                "senses": [
                    {
                        "sense_id": "412ed864-b181-328f-8e5e-a99021152f48",
                        "entry_id": "def04c61-3e2a-3963-81f6-3d2bf0c364ed",
                        "glosses": [
                            "мягкая повязка на запястье, где прощупывается пульс"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad25706-8c15-4b1d-a951-0486c0ee5e7a",
                                "sense_id": "412ed864-b181-328f-8e5e-a99021152f48",
                                "text": "А Ипполит Матвеевич снял с себя шерстяные напульсники, баронские сапоги и, оставшись в заштопанном егерском белье, посапывая, полез под одеяло."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce51d867-3a23-3dc8-8f3a-e7083099901c",
                        "entry_id": "def04c61-3e2a-3963-81f6-3d2bf0c364ed",
                        "glosses": [
                            "атрибут наряда металлистов в виде кожаного браслета с металлическими вставками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5dcd4f-4603-4ca8-ab91-74f26841fce1",
                                "sense_id": "ce51d867-3a23-3dc8-8f3a-e7083099901c",
                                "text": "За длинной стойкой бара и за столиками вдоль красных кирпичных стен сидели молодые парни в чёрной коже, в жилетках на голое тело, в напульсниках и даже в широких кожаных ошейниках с шипами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f22fc676-17bc-43bd-ab6c-d2cd8f8db4f7",
                        "source_entry_id": "def04c61-3e2a-3963-81f6-3d2bf0c364ed",
                        "source_sense_description": "повязка на запястье",
                        "target_lang_word": "bracer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bracer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "346922c9-33a5-3b8c-8da5-a9e5a3c23b85",
                                        "entry_id": "f05c73f8-075a-3316-b9dc-bddc799414aa",
                                        "glosses": [
                                            "That which braces, binds, or makes firm; a band or bandage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3f86b8f-e392-32bf-8bcf-45580464edf5",
                                        "entry_id": "f05c73f8-075a-3316-b9dc-bddc799414aa",
                                        "glosses": [
                                            "Something bracing; a stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d17435-c935-4597-961e-3199d8f54b37",
                                                "sense_id": "d3f86b8f-e392-32bf-8bcf-45580464edf5",
                                                "text": "Country air in the fields, or in gardens, when breathed at proper hours, is an excellent bracer of the nerves, and a sure brightener of the complexion."
                                            },
                                            {
                                                "example_id": "2fa211ff-1b80-4950-9a49-8e63f54945d9",
                                                "sense_id": "d3f86b8f-e392-32bf-8bcf-45580464edf5",
                                                "text": "In fact I did not feel good. I was suffering from the morning sickness of the steady, heavy drinker. What I needed was a pick-me-up, a bracer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30bbb95-d579-38ff-b44e-3285b1065c5e",
                                        "entry_id": "f05c73f8-075a-3316-b9dc-bddc799414aa",
                                        "glosses": [
                                            "A covering to protect the arm of the bowman from the vibration of the string."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff2769f-eaa0-44d4-8817-e79f3e223184",
                                                "sense_id": "c30bbb95-d579-38ff-b44e-3285b1065c5e",
                                                "text": "To prevent the bow string from hanging on the left arm, it is covered with a piece of smooth leather, fastened on the outside of the arm, this is called a bracer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f694339-4bc8-3e5a-bad9-cff64c248ecc",
                                        "entry_id": "f05c73f8-075a-3316-b9dc-bddc799414aa",
                                        "glosses": [
                                            "Armor for the forearm; a brassard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3655d831-6bfb-3051-a592-9df37bb44f03",
                                        "entry_id": "f05c73f8-075a-3316-b9dc-bddc799414aa",
                                        "glosses": [
                                            "A medicine, as an astringent or a tonic, which gives tension or tone to any part of the body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
