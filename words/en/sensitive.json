{
    "word_family": [
        "sensitivity",
        "sensitize",
        "sensor",
        "sensory",
        "insensitivity",
        "hypersensitive",
        "desensitize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0abc59f5-6be8-32cf-be90-4324d85a1e0c",
                    "sense_definition": "Easily offended, upset, or hurt by what others say or do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is very <w>sensitive</w> about his height, so please don't mention it.",
                            "target_lang_translations": {
                                "ru": "Он очень <w>чувствителен</w> к теме своего роста, поэтому, пожалуйста, не упоминай об этом.",
                                "zh": "他对自己身高很<w>敏感</w>，所以请不要提起。"
                            }
                        },
                        {
                            "text": "Teenagers can be quite <w>sensitive</w> to criticism from their parents.",
                            "target_lang_translations": {
                                "ru": "Подростки могут быть весьма <w>чувствительны</w> к критике со стороны родителей.",
                                "zh": "青少年对父母的批评往往非常<w>敏感</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stoic",
                        "insensitive"
                    ],
                    "common_phrases": [
                        "sensitive nature",
                        "sensitive about",
                        "too sensitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко обижающийся или расстраивающийся из-за слов или действий других.",
                        "zh": "指人容易因为他人的言行而感到受伤害或不悦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ранимый",
                                "target_lang_sense_clarification": "эмоционально уязвимый"
                            },
                            {
                                "target_lang_word": "обидчивый",
                                "target_lang_sense_clarification": "склонный легко обижаться"
                            },
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "воспринимающий всё близко к сердцу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏感",
                                "target_lang_sense_clarification": "容易受影响或受伤害"
                            },
                            {
                                "target_lang_word": "玻璃心",
                                "target_lang_sense_clarification": "形容人极其脆弱、容易受伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27997ebc-9469-33a0-93ef-39e78356a43d",
                    "sense_definition": "Being aware of the feelings of others and taking care not to offend them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good teacher must be <w>sensitive</w> to the needs of every student.",
                            "target_lang_translations": {
                                "ru": "Хороший учитель должен быть <w>чутким</w> к потребностям каждого ученика.",
                                "zh": "一位好老师必须<w>体贴</w>每一位学生的需求。"
                            }
                        },
                        {
                            "text": "Thank you for being so <w>sensitive</w> and understanding during this difficult time.",
                            "target_lang_translations": {
                                "ru": "Спасибо за то, что вы были таким <w>чутким</w> и понимающим в это трудное время.",
                                "zh": "谢谢你在这一困难时期表现得如此<w>善解人意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caring",
                        "compassionate",
                        "aware"
                    ],
                    "antonyms": [
                        "uncaring",
                        "insensitive"
                    ],
                    "common_phrases": [
                        "sensitive to others",
                        "sensitive approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимающий чувства других и старающийся не обидеть их.",
                        "zh": "指能够体察他人的感受，并注意不冒犯他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чуткий",
                                "target_lang_sense_clarification": "внимательный к другим"
                            },
                            {
                                "target_lang_word": "деликатный",
                                "target_lang_sense_clarification": "тактичный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体贴",
                                "target_lang_sense_clarification": "善解人意"
                            },
                            {
                                "target_lang_word": "善解人意",
                                "target_lang_sense_clarification": "能够理解他人的心思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b978216-5c7f-36e0-9b37-9f4b655628f9",
                    "sense_definition": "Quick to respond to slight changes, signals, or physical stimuli; easily irritated or damaged.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My eyes are very <w>sensitive</w> to bright light in the morning.",
                            "target_lang_translations": {
                                "ru": "Мои глаза очень <w>чувствительны</w> к яркому свету по утрам.",
                                "zh": "我的眼睛在早晨对强光非常<w>敏感</w>。"
                            }
                        },
                        {
                            "text": "She uses a special toothpaste because she has <w>sensitive</w> teeth.",
                            "target_lang_translations": {
                                "ru": "Она пользуется специальной зубной пастой, так как у нее <w>чувствительные</w> зубы.",
                                "zh": "她用一种特殊的牙膏，因为她的牙齿很<w>敏感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tender"
                    ],
                    "antonyms": [
                        "resistant"
                    ],
                    "common_phrases": [
                        "sensitive skin",
                        "sensitive to light",
                        "sensitive stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро реагирующий на изменения или физические раздражители; легко раздражаемый.",
                        "zh": "指对细微的变化、信号或物理刺激反应迅速；容易受刺激或受损。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "о теле, органах чувств"
                            },
                            {
                                "target_lang_word": "восприимчивый",
                                "target_lang_sense_clarification": "подверженный влиянию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏感",
                                "target_lang_sense_clarification": "对外界刺激反应强烈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5b4b551-2a53-30df-a9e2-cba1208b148e",
                    "sense_definition": "Capable of causing offense, upset, or trouble; requiring careful handling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "delicate_matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politics is often a <w>sensitive</w> topic at family gatherings.",
                            "target_lang_translations": {
                                "ru": "Политика — часто <w>щекотливая</w> тема на семейных встречах.",
                                "zh": "在家庭聚会上，政治往往是一个<w>敏感</w>话题。"
                            }
                        },
                        {
                            "text": "We need to discuss a <w>sensitive</w> issue regarding the company budget.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обсудить <w>деликатный</w> вопрос, касающийся бюджета компании.",
                                "zh": "我们需要讨论一个关于公司预算的<w>敏感</w>问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sensitive topic",
                        "sensitive issue",
                        "sensitive subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный вызвать обиду или проблемы; требующий осторожного обращения.",
                        "zh": "指容易引起冒犯、不悦或麻烦；需要谨慎处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотливый",
                                "target_lang_sense_clarification": "о вопросе или ситуации"
                            },
                            {
                                "target_lang_word": "деликатный",
                                "target_lang_sense_clarification": "требующий такта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏感",
                                "target_lang_sense_clarification": "指话题或问题需要谨慎对待"
                            },
                            {
                                "target_lang_word": "棘手",
                                "target_lang_sense_clarification": "指问题难以处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a96b7349-2783-3e12-ac4c-9479bb28cf61",
                    "sense_definition": "Meant to be concealed or kept secret to protect security or privacy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "delicate_matter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The file contains <w>sensitive</w> information about the bank's clients.",
                            "target_lang_translations": {
                                "ru": "Файл содержит <w>конфиденциальную</w> информацию о клиентах банка.",
                                "zh": "该文件包含有关银行客户的<w>机密</w>信息。"
                            }
                        },
                        {
                            "text": "Do not share these <w>sensitive</w> documents with anyone outside the team.",
                            "target_lang_translations": {
                                "ru": "Не передавайте эти <w>секретные</w> документы никому за пределами команды.",
                                "zh": "不要与团队以外的任何人分享这些<w>机密</w>文件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classified"
                    ],
                    "common_phrases": [
                        "sensitive information",
                        "sensitive data",
                        "highly sensitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для сокрытия в целях безопасности или конфиденциальности.",
                        "zh": "指为了安全或隐私而需要保密的信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфиденциальный",
                                "target_lang_sense_clarification": "не для публичного доступа"
                            },
                            {
                                "target_lang_word": "секретный",
                                "target_lang_sense_clarification": "тайный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机密",
                                "target_lang_sense_clarification": "涉及秘密的"
                            },
                            {
                                "target_lang_word": "敏感",
                                "target_lang_sense_clarification": "指需要严格保护的信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c3fef46-742e-3a7e-bc39-fa7f4acb4464",
                    "sense_definition": "Accurate; able to register or measure very small changes.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory uses highly <w>sensitive</w> equipment to detect earthquakes.",
                            "target_lang_translations": {
                                "ru": "Лаборатория использует высоко <w>чувствительное</w> оборудование для обнаружения землетрясений.",
                                "zh": "实验室使用高<w>灵敏</w>度的设备来探测地震。"
                            }
                        },
                        {
                            "text": "This microphone is very <w>sensitive</w> to background noise.",
                            "target_lang_translations": {
                                "ru": "Этот микрофон очень <w>чувствителен</w> к фоновому шуму.",
                                "zh": "这个麦克风对背景噪音非常<w>灵敏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "precise"
                    ],
                    "common_phrases": [
                        "sensitive instrument",
                        "sensitive equipment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точный; способный регистрировать или измерять очень малые изменения.",
                        "zh": "指精确的；能够记录或测量极小变化的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "о приборах"
                            },
                            {
                                "target_lang_word": "высокоточный",
                                "target_lang_sense_clarification": "прецизионный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灵敏",
                                "target_lang_sense_clarification": "指仪器反应快且精确"
                            },
                            {
                                "target_lang_word": "高精度",
                                "target_lang_sense_clarification": "指测量非常准确"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e09e5e7-0c84-3556-93f8-9ffde7b998fb",
                    "sense_definition": "A person believed to have paranormal abilities to perceive things others cannot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group hired a <w>sensitive</w> to investigate the strange noises in the old house.",
                            "target_lang_translations": {
                                "ru": "Группа наняла <w>экстрасенса</w> для расследования странных шумов в старом доме.",
                                "zh": "该小组雇了一位<w>灵媒</w>来调查老房子里的怪声。"
                            }
                        },
                        {
                            "text": "She claimed to be a <w>sensitive</w> who could communicate with spirits.",
                            "target_lang_translations": {
                                "ru": "Она утверждала, что она <w>экстрасенс</w>, способный общаться с духами.",
                                "zh": "她声称自己是一位能与灵魂沟通的<w>通灵者</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий паранормальными способностями воспринимать то, что недоступно другим.",
                        "zh": "指被认为具有超自然能力，能感知他人无法感知事物的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстрасенс",
                                "target_lang_sense_clarification": "человек со сверхспособностями"
                            },
                            {
                                "target_lang_word": "медиум",
                                "target_lang_sense_clarification": "посредник между мирами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灵媒",
                                "target_lang_sense_clarification": "声称能与超自然力量沟通的人"
                            },
                            {
                                "target_lang_word": "通灵者",
                                "target_lang_sense_clarification": "具有超感官知觉的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}