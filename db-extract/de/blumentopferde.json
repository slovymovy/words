                "senses": [
                    {
                        "sense_id": "24dc0f24-17aa-3cfc-9878-edeb332a11e5",
                        "entry_id": "b057af45-8d39-34d2-bf67-3d4365602101",
                        "glosses": [
                            "Blumenerde für Topfpflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0748bee7-db03-4489-ae0f-27b4e4e2c236",
                                "sense_id": "24dc0f24-17aa-3cfc-9878-edeb332a11e5",
                                "text": "Ich habe Blumentopferde gekauft."
                            },
                            {
                                "example_id": "d09ec3ee-de81-4371-accf-eb677a23c770",
                                "sense_id": "24dc0f24-17aa-3cfc-9878-edeb332a11e5",
                                "text": "„Dort misst der Sensor die Feuchtigkeit der Blumentopferde.“"
                            },
                            {
                                "example_id": "0a921f20-1a3e-49f2-958c-d9d7299fcf2b",
                                "sense_id": "24dc0f24-17aa-3cfc-9878-edeb332a11e5",
                                "text": "„Zwar enthält, wie der Freiburger Hygieniker Franz Daschner einräumt, Blumenwasser häufig krank machende Keime, und in Blumentopferde fänden sich oft Pilze oder Tetanussporen.“"
                            },
                            {
                                "example_id": "ab292bfb-03e2-458d-a300-7392e23e0940",
                                "sense_id": "24dc0f24-17aa-3cfc-9878-edeb332a11e5",
                                "text": "„So ein Ableger entsteht an Blättern dieser populären Sukkulente, sobald sie von einer ausgewachsenen Pflanze abbrechen und die Blumentopferde berühren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
