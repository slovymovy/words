                        "glosses": [
                            "Suite d’épisodes télévisuels qui ont une même trame narrative et une unité relative au niveau du genre, des personnages et de la forme, par exemple la même durée."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "a36d01cf-408f-41a0-9217-cb14dab59862",
                                "sense_id": "ad33f12c-4d9d-397b-b227-d13cc2e12a97",
                                "text": "Ma télésérie préférée passe à la télévision ; j’ai hâte de voir la suite, parce que l’épisode d’hier s’est terminé sur le meurtre de la femme du héros."
                            }
                        ]
                    }
