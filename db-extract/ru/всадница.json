                                "target_senses": [
                                    {
                                        "sense_id": "ed4eadf7-1c64-3008-a1f6-4b76928bfd63",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Celle qui monte à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad862f50-39a2-43ab-96bd-a3f062df7468",
                                                "sense_id": "ed4eadf7-1c64-3008-a1f6-4b76928bfd63",
                                                "text": "Que Brantome dise tant qu’il lui plaira que la Duchesse de Valentinois eut du courage, qu’elle fut belle jusqu’à l’âge de 70 ans, qu’elle était bonne cavaliere, personne ne s’en formalisera."
                                            },
                                            {
                                                "example_id": "ae4179f8-1161-460d-96f1-b581a5d8a8ab",
                                                "sense_id": "ed4eadf7-1c64-3008-a1f6-4b76928bfd63",
                                                "text": "Dans les contre-allées, passent rapides, le cigare en bouche, des cavaliers et, cravache levée, des cavalières dont les éclats de voix, les rires bruyants, les propos, mêlés de toutes les langues, de toutes les argots de l’Europe, étonnent la feuillue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca9b6172-8eb1-3359-9d5d-777bdfbaab00",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Femme qui accompagne un ou une partenaire, particulièrement à un bal, ou qui danse avec lui ou avec elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e6fb3f-0e98-4f1b-ace3-f2d340c1cfb3",
                                                "sense_id": "ca9b6172-8eb1-3359-9d5d-777bdfbaab00",
                                                "text": "Je m’attendais à chaque instant à le voir danser à quatre pattes, tellement il baissait la partie supérieure de son corps vers la terre. Je ne pus même m’empêcher d’avoir l’idée saugrenue que sa cavalière n’aurait pas beaucoup de peine à lui passer la jambe par-dessus la tête, comme cela se pratiquait alors dans certains bals publics."
                                            },
                                            {
                                                "example_id": "1570a2e8-3486-412a-bf7e-14255f316108",
                                                "sense_id": "ca9b6172-8eb1-3359-9d5d-777bdfbaab00",
                                                "text": "– C’est… c’est mon anniversaire demain et je serais heureux de vous avoir pour cavalière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53798dd-d9ff-3ec3-aee0-e45e9ba3791c",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Femme qui sert dans la cavalerie militaire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a44b89a8-16f5-35e0-b65c-2598592692d4",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Femme du monde qui monte dans les courses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd4c66bb-0d22-3657-a172-85fae1ef86f4",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Désignation de grade d’une membre d’un régiment blindé et du régiment The Queen’s York Rangers détenant le grade de soldate."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55b4b9fc-f6f5-3f31-b19a-bc398269f4cd",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Piste destinée à la circulation à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992d7c32-e28d-4c00-9864-f128437c46a6",
                                                "sense_id": "55b4b9fc-f6f5-3f31-b19a-bc398269f4cd",
                                                "text": "On peut encore revenir à Fontainebleau par la cavalière du Dormoir, mais pour cela il faut suivre l’itinéraire de la grande promenade […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a60111-61c6-3c35-bf11-0a455b5a9d82",
                                        "entry_id": "27127ab6-64d7-37bb-adcb-971e3e8230ab",
                                        "glosses": [
                                            "Une des figures d’un jeu de cartes, particulièrement des tarots de divertissement ou de divination, représentant une femme montée à cheval."
                                        ],
