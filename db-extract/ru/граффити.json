                        ],
                        "form": "граффи́ти"
                    },
                    {
                        "form_id": "f8657fe3-e43a-4467-84fb-7a56a6d73992",
                        "entry_id": "6ba8d190-51a3-34e3-af4a-dac38ac5db93",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "граффи́ти"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93e79f4f-8702-3f65-9678-23bad6a85541",
                        "entry_id": "6ba8d190-51a3-34e3-af4a-dac38ac5db93",
                        "glosses": [
                            "истор. рисунки и надписи, оставленные древними людьми на стенах своих жилищ, храмов и т. п., а также на других поверхностях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ab2ef7-5614-4588-b9fd-48c3c979196a",
                                "sense_id": "93e79f4f-8702-3f65-9678-23bad6a85541",
                                "text": "Отдельные глаголические знаки встречаются в граффити Софии Новгородской."
                            },
                            {
                                "example_id": "384c5ae9-b520-436a-bec9-077448effa85",
                                "sense_id": "93e79f4f-8702-3f65-9678-23bad6a85541",
                                "text": "Большое число граффити XI–XV веков имеется в соборе св. Софии в Киеве, они содержат как рисунки, так и (чаще) текст."
                            }
                        ]
                    },
                    {
                        "sense_id": "712be39f-a436-3948-b94b-6f843543a8ab",
                        "entry_id": "6ba8d190-51a3-34e3-af4a-dac38ac5db93",
                        "glosses": [
                            "надписи или рисунки на вертикальных, реже горизонтальных поверхностях в общественных местах (на стенах, заборах, транспортных средствах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46dc94b8-414c-4349-907f-8e01e4c6c6a6",
                                "sense_id": "712be39f-a436-3948-b94b-6f843543a8ab",
                                "text": "Его освещали редкие фонари; в свете одного из них на стене дома мелькнуло размашистое граффити «LENINE EST MERDE»."
                            },
                            {
                                "example_id": "8ac22dac-176c-49de-a818-5a8023c0c7bc",
                                "sense_id": "712be39f-a436-3948-b94b-6f843543a8ab",
                                "text": "Она выслушала первого заместителя начальника Октябрьской железной дороги Василия Голубцова, который рассказал, что «одной из серьезных проблем по-прежнему остается вандализм на железной дороге», и отметил, что граффити на вагонах и разбитые окна добавляют забот железнодорожникам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d357ceee-b9e5-41f8-8a3e-1f07e93c7e78",
                        "source_entry_id": "6ba8d190-51a3-34e3-af4a-dac38ac5db93",
                        "source_sense_description": "рисунки и надписи древних людей",
                        "target_lang_word": "graffiti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graffiti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                        "entry_id": "8be8f619-18bc-3471-9a95-d495eb0bc94d",
                                        "glosses": [
                                            "Drawings or words drawn on a surface in a public place, usually made without authorization."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fcaee0-a662-4b3f-a071-e6d922ae49f7",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The underpass is a popular place for graffiti artists."
                                            },
                                            {
                                                "example_id": "fca19e70-a1b1-481f-9711-e71ef087e474",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The city council spends thousands of pounds removing graffiti from public buildings."
                                            },
                                            {
                                                "example_id": "f4541d23-aaa2-4dc9-b774-92a5eb46757f",
                                                "sense_id": "efcb38b6-88e2-3be6-bcd6-2aa9db83be42",
                                                "text": "The removal of unsightly graffiti on the sides of railway bridges spanning major roads in the North West is to be handed over to National Highways, to speed up the job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5160b678-c277-3c0a-9922-22019c7e4e65",
                                        "entry_id": "8be8f619-18bc-3471-9a95-d495eb0bc94d",
                                        "glosses": [
                                            "Informal inscriptions, figure drawings, etc., as opposed to official inscriptions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "graffiti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
