                "senses": [
                    {
                        "sense_id": "0100b5fc-892c-3a80-b323-b24af8f65612",
                        "entry_id": "229abc1f-3d6f-382b-8f4c-f36b9f5f7ee1",
                        "glosses": [
                            "verpleegkundig hulpmiddel waar mee een patient op bed kan urineren en defaeceren, ook gebruikt in een postoel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40058960-fe9c-4a24-9606-cdc4aa15594f",
                                "sense_id": "0100b5fc-892c-3a80-b323-b24af8f65612",
                                "text": "De reeks Beroepsgeheim levert elke week op maandag artikels op die bij de meest gelezen artikels van de week horen. Wat denken de mensen die ons bedienen, ons huis poetsen, onze mond verzorgen, of onze bedpan wegnemen, nu echt? Ontmoet de thuisverpleegster."
                            },
                            {
                                "example_id": "2c59ebff-afe7-4af4-b76f-85b201594417",
                                "sense_id": "0100b5fc-892c-3a80-b323-b24af8f65612",
                                "text": "Mijn leraar in China werkte in 1942 in een ziekenhuis met tuberculosepatiënten. Doodvermoeide mensen die aan hun bed gekluisterd waren en slijmen en bloed ophoestten in een bedpan. Toen mijn leraar werd opgebeld dat de Japanners onderweg waren, zetten de patiënten hun bedpan op hun hoofd, namen een geweer en renden naar buiten. Omdat de Japanners hen anders vermoord zouden hebben."
                            },
                            {
                                "example_id": "c1fbbe54-3c53-4467-9949-ae2004570eba",
                                "sense_id": "0100b5fc-892c-3a80-b323-b24af8f65612",
                                "text": "Wie nog vast hangt aan schrikbeelden van oudemannenhuizen in neogotische kloosters met hoge kamers en de bedpan achter het gordijn vindt in het OCMW woonzorgcentrum Ter Leenen in Nevele een waardig alternatief."
                            }
                        ]
                    }
                ],
