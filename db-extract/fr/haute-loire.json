        "fr-extract.jsonl": [
            {
                "entry_id": "4c45c946-f213-373a-9ff1-2499d5801929",
                "word": "Haute-Loire",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "458a892a-6862-4a7c-81f4-eabc30367eee",
                        "entry_id": "4c45c946-f213-373a-9ff1-2499d5801929",
                        "tags": [
                            "invariable"
                        ],
                        "form": "^((h aspiré))\\o.tlwaʁ\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c03741b8-61c6-35f1-8167-8db63d2c6e40",
                        "entry_id": "4c45c946-f213-373a-9ff1-2499d5801929",
                        "glosses": [
                            "Département français de la région administrative Auvergne-Rhône-Alpes, qui porte le numéro 43."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab665cea-5010-4004-b18b-b2e8d8e3f3d1",
                                "sense_id": "c03741b8-61c6-35f1-8167-8db63d2c6e40",
                                "text": "Moi je me vois sergent, je dis : Allons-y ! Eh ! mes enfants ! On est tous du même pays, autour du même feu du bivouac, et l’on parle de la Haute-Loire."
                            },
                            {
                                "example_id": "be1bd2fc-8297-4b55-9de6-dc7fd9625a71",
                                "sense_id": "c03741b8-61c6-35f1-8167-8db63d2c6e40",
                                "text": "Il y a des paysans aux cheveux longs et rares, tristes et laids : ils vont muets derrière leurs chariots à travers la ville et ont l’air terne et morne des sourds. Pas de gestes robustes, point l’allure large, la voix forte ! La lèvre est mince ou le nez est pointu, l’œil est creux et la tempe en front de serpent, — ils ne ressemblent pas, comme les paysans de la Haute-Loire, à des bœufs, — ils ne sentent pas l’herbe, mais la vase ; ils n’ont pas la grosse veste couleur de vache, ils portent une camisole d’un blanc sale comme un surplis crotté. Je leur trouve l’air dévot, dur et faux, à ces fils de la Vendée, à ces hommes de Bretagne."
                            },
                            {
                                "example_id": "0c14a0cd-e46e-48b4-98bf-b8a0ceb584b7",
                                "sense_id": "c03741b8-61c6-35f1-8167-8db63d2c6e40",
                                "text": "Craponne-sur-Arzon, dans la Haute-Loire, est le rendez-vous depuis plus de trente ans des amateurs de danse en ligne avec de nombreuses démonstrations."
                            }
                        ]
                    }
                ],
