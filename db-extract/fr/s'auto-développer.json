                        "glosses": [
                            "Se développer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09119677-0fe3-4cac-adf2-7f1343ea16b7",
                                "sense_id": "45c0f6c1-1f7d-3fe2-94c7-5be5300c9409",
                                "text": "Certes les comités de membres sont souvent mêlés à ces actions, mais ne servent-ils pas alors de caution à un mouvement qui, fort de sa puissance, peut parfaitement s’auto-entraîner, s’auto-développer dans un esprit de stricte logique commerciale ?"
                            },
                            {
                                "example_id": "a701d8d2-c6fb-40de-8106-ca2489910548",
                                "sense_id": "45c0f6c1-1f7d-3fe2-94c7-5be5300c9409",
                                "text": "S'auto-développer, ça signifie chercher soi-même ses dates de concerts ?"
                            },
                            {
                                "example_id": "fc1db724-3c96-4808-b100-6c85fb6ad449",
                                "sense_id": "45c0f6c1-1f7d-3fe2-94c7-5be5300c9409",
                                "text": "Travailler ensemble pour s'auto-développer"
                            }
                        ]
