                                        "glosses": [
                                            "A native or inhabitant of ancient Lycia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc7119e-ef20-41ba-88ae-a50de64e0ad0",
                                                "sense_id": "109aa965-5a8a-3273-a7d7-c0101ada5cb0",
                                                "text": "From the 4th Century BCE onwards, the Lycians built rock-hewn \"house\" tombs – often funeral chambers carved into cliffs, with the rock face around the doorway cut to imitate the façade of a wooden Lycian house, complete with \"timbers\" and protruding \"joists\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lycian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2aa1fc-0e09-3c5d-8b34-d5b66c89ebc9",
                                        "entry_id": "ff1aa708-1356-3914-a94c-0a276d1250fe",
                                        "glosses": [
                                            "Of, or relating to Lycia, or its people, language or culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b2f825-7863-4f12-9ba7-a68a1138e4ec",
                                                "sense_id": "3e2aa1fc-0e09-3c5d-8b34-d5b66c89ebc9",
                                                "text": "Formed in the 2nd Century BCE and composed of 23 city-states, the Lycian League was the world's first democratic union, a model of a strong confederacy based on popular and proportional representation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
