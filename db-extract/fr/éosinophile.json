                    {
                        "sense_id": "418298c2-33ac-3518-9526-d5c0168929cd",
                        "entry_id": "234f8dfb-1408-3b9c-8307-2cbc33f3cf2f",
                        "glosses": [
                            "Cellule qui a une affinité pour un colorant, l’éosine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16bfe77e-fd64-4ca6-9efd-f84ff8b1ed62",
                                "sense_id": "418298c2-33ac-3518-9526-d5c0168929cd",
                                "text": "Les éosinophiles ou granulocytes éosinophiles sont des leucocytes polynucléaires (granulocytes) du sang qui ont une affinité pour l’éosine."
                            },
                            {
                                "example_id": "6fb06885-0e8b-4fff-ba6f-8494ded49134",
                                "sense_id": "418298c2-33ac-3518-9526-d5c0168929cd",
                                "text": "Les éosinophiles se mobilisent contre les parasites multicellulaires et d’autres infections, et jouent un rôle dans l’allergie."
                            },
                            {
                                "example_id": "64505ac7-7373-4523-9dc4-94231edf4ffa",
                                "sense_id": "418298c2-33ac-3518-9526-d5c0168929cd",
                                "text": "Longtemps on a considéré l’éosinophile comme cellule bénéfique, occultant le potentiel destructeur également libéré contre l’hôte."
                            }
                        ]
                    }
                ],
