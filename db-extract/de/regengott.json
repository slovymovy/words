                "senses": [
                    {
                        "sense_id": "2200d315-56b8-327b-b94f-d915d909acd4",
                        "entry_id": "8e3e5fdd-22ea-3c12-bf3b-37019f30844b",
                        "glosses": [
                            "Gott des Regens, mit dem Regen assoziierte Gottheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a863ab5-fdae-4f0d-bfa4-dd9a4d8c1a94",
                                "sense_id": "2200d315-56b8-327b-b94f-d915d909acd4",
                                "text": "„Einheimische Würdenträger haben eine solche religiöse Deutung in Gesprächen mit britischen Abgesandten nach der Zerstörung Benins im Jahre 1897 nahe gelegt; nach ihren Aussagen war es ‚das Hauptziel der Feste, durch besondere Botschafter den Geistern der Verstorbenen oder anderen Geistern, wie denen der Korallen, dem Regengott, dem Sonnengott oder dem Gott der Gesundheit und des Lebens Gebete für das Wohl der Gemeinschaft zu überbringen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
