                            {
                                "example_id": "baa32bd5-4004-4f05-b5a7-f2313e85711e",
                                "sense_id": "fbabb08e-238b-3d30-84f8-7855d1cd33a8",
                                "text": "Perceur de murailles."
                            },
                            {
                                "example_id": "20d82d5d-ca08-4fd5-955e-0e6cb418f85c",
                                "sense_id": "fbabb08e-238b-3d30-84f8-7855d1cd33a8",
                                "text": "Perceur de coffres-forts."
                            },
                            {
                                "example_id": "ca699606-ce65-43f1-af48-dd00ebeb056c",
                                "sense_id": "fbabb08e-238b-3d30-84f8-7855d1cd33a8",
                                "text": "Le père Bouvet, le perceur d’oreilles, ne passait qu’une fois l’an, le dimanche qui précédait la foire, à la joie des fillettes et des couturières, car il vendait des boucles pour les oreilles qu’il trouait et lui seul de plus savait ce que c’était que repasser les ciseaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
