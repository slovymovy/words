                        "glosses": [
                            "een spanner waarmee een stag van het want op een zeilboot, op de gewenste spanning wordt gebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9425224-992f-448d-8f96-48f295c77bea",
                                "sense_id": "3df030b3-7db6-3422-b86f-9f8eadac1618",
                                "text": "De wantspanners zijn doorgaans schroefspanners."
