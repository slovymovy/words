                                "target_senses": [
                                    {
                                        "sense_id": "f8f2b413-4dba-35c3-a6d2-fbd9dbd88273",
                                        "entry_id": "cd6e34db-4c8b-308f-b745-7c5416f645f7",
                                        "glosses": [
                                            "Province de la Nouvelle-Espagne (actuel Mexique), subdivisée en 1804 en Haute-Californie devenue l’État américain, et la Basse-Californie, restée mexicaine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdab9ed7-3712-32ce-bb41-e90d083bdf0f",
                                        "entry_id": "cd6e34db-4c8b-308f-b745-7c5416f645f7",
                                        "glosses": [
                                            "État des États-Unis d’Amérique (code postal CA), bordé par l’Oregon au nord, le Nevada et l’Arizona à l’est, le Mexique au sud, et le Pacifique Nord à l’ouest. Sa capitale est Sacramento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12752658-f61b-4703-b484-6e894f2523e5",
                                                "sense_id": "bdab9ed7-3712-32ce-bb41-e90d083bdf0f",
                                                "text": "La Californie est une frontière entre mer et terre, le désert et la vie."
                                            },
                                            {
                                                "example_id": "4be64a85-5206-4ac1-ba02-5d44fd6ba769",
                                                "sense_id": "bdab9ed7-3712-32ce-bb41-e90d083bdf0f",
                                                "text": "Un sandwich enroulé (wrap en anglais) dans une tortilla de blé, voilà l’idée toute simple née en Californie dans les années 1990. Digne descendant du burrito, le wrap n’a pas tardé à conquérir le monde, tant il se prête à toutes les variations."
                                            },
                                            {
                                                "example_id": "53ec84e7-4b6f-4439-96fc-ee65ea8360f6",
                                                "sense_id": "bdab9ed7-3712-32ce-bb41-e90d083bdf0f",
                                                "text": "La Californie est à la fois un aimant et un carrefour, on y promeut l’avenir comme un culte ouvert à tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d3875a-13d4-3d16-93a9-2dac0983291a",
                                        "entry_id": "cd6e34db-4c8b-308f-b745-7c5416f645f7",
                                        "glosses": [
                                            "Zone située dans le département de l'Aisne, non loin du village de Craonne, dans la partie est du Chemin des Dames."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae36969-b517-42c2-bdcd-2ba2d4c7c73c",
                                                "sense_id": "09d3875a-13d4-3d16-93a9-2dac0983291a",
                                                "text": "Je suis sûr que le jour où il y eut sur ma gauche, dans le secteur appelé Californie, cet énorme éclair rond, jaune, filamenteux et plein de graines comme une citrouille, je suis sûr que tu as avancé la main pour détourner sa flamme, et je n'ai eu droit qu'à un seul pépin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1863b534-f335-3cba-b8c3-7823191588e6",
                                        "entry_id": "cd6e34db-4c8b-308f-b745-7c5416f645f7",
                                        "glosses": [
                                            "Contrée aux ressources naturelles innombrables, eldorado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4fea4f-a1cb-4d9c-b205-f769b72480d4",
                                                "sense_id": "1863b534-f335-3cba-b8c3-7823191588e6",
                                                "text": "Ils s’en vont (…) dans les nouvelles Californies qu’on découvre, sur les côtes brûlées du Mexique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f08973-f850-3614-893f-da919354e19b",
                                        "entry_id": "cd6e34db-4c8b-308f-b745-7c5416f645f7",
                                        "glosses": [
                                            "Masse énorme, richesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a31b8a-c358-4048-84c1-fbf30fda30f8",
                                                "sense_id": "f2f08973-f850-3614-893f-da919354e19b",
                                                "text": "La Californie du ménage. Plus de deux mille recettes, formules et procédés économiques empruntés aux sciences, à l'industrie, à l'hygiène et aux arts domestiques."
                                            },
                                            {
                                                "example_id": "931375cf-0481-4373-9725-7645055c4ddd",
                                                "sense_id": "f2f08973-f850-3614-893f-da919354e19b",
                                                "text": "C’est une Californie, se dit pour exprimer la richesse d’un lieu, d’une maison, d’une entreprise ^([1])."
                                            },
                                            {
                                                "example_id": "4fe9c553-4371-4499-86e4-f065e1c5cc0a",
                                                "sense_id": "f2f08973-f850-3614-893f-da919354e19b",
                                                "text": "Des californies de grotesque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
