                        "sense_id": "9e186778-e2e1-359d-bf2f-96800707d5a4",
                        "entry_id": "0996f78d-e982-3a79-ae55-ee674f0f0198",
                        "glosses": [
                            "The quality or state of being grey."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "438fa697-d83e-4122-b6a3-06ec87387301",
                                "sense_id": "9e186778-e2e1-359d-bf2f-96800707d5a4",
                                "text": "The sun had gone behind the clouds. As the ship slid out on its way a stray beam pierced the greyness."
                            },
                            {
                                "example_id": "b1a88993-0199-4027-9474-7758958acaf9",
                                "sense_id": "9e186778-e2e1-359d-bf2f-96800707d5a4",
                                "text": "The sight of them [the Grampians] as we crossed the viaduct over the North Esk I am not likely to forget. After a night of snow, they hung wraith-like across the sky, exquisitely beautiful in the greyness of winter dawn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8604aba9-b263-4a9f-9c58-e31b87ffc150",
                        "source_entry_id": "0996f78d-e982-3a79-ae55-ee674f0f0198",
                        "source_sense_id": "9e186778-e2e1-359d-bf2f-96800707d5a4",
                        "source_sense_description": "quality or state of being grey",
                        "target_lang_word": "се́рость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "се́рость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a977ec-e6a8-3212-b3f1-3348ec066507",
                                        "entry_id": "84107823-d4ee-3516-ac85-9aa76d563d53",
                                        "glosses": [
                                            "свойство по значению прилагательного серый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd181cfb-a881-4ec0-88fc-6083bbf8437b",
                                                "sense_id": "e1a977ec-e6a8-3212-b3f1-3348ec066507",
                                                "text": "После второго укола Гайдар задышал ровнее, но серость с лица не сходила и речь не ладилась, хотя явно тужился сказать что-то."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39bcc98c-0b7f-3e60-ac4a-86a8befd59d0",
                                        "entry_id": "84107823-d4ee-3516-ac85-9aa76d563d53",
                                        "glosses": [
                                            "перен. что-либо маловыразительное, посредственное, серое, унылое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92d37026-23aa-49cf-ad2b-c07243f59600",
                                                "sense_id": "39bcc98c-0b7f-3e60-ac4a-86a8befd59d0",
                                                "text": "Прохожие упорно не поднимали глаз, будто боялись увидеть, какая их окружает серость, и тем самым придавали пейзажу ещё больше уныния."
                                            },
                                            {
                                                "example_id": "3cf51881-67d2-47c7-8d0b-7f462669dfcd",
                                                "sense_id": "39bcc98c-0b7f-3e60-ac4a-86a8befd59d0",
                                                "text": "А вот два-три глупых бабьих слова — и всё яркое сразу потухло, вернулась мелкая, обрыдлая обыденщина, скука, безнадёжная теснота, серость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870dad54-10a4-3e6e-924a-6e76171c387e",
                                        "entry_id": "84107823-d4ee-3516-ac85-9aa76d563d53",
                                        "glosses": [
                                            "перен. пренебр. глупость, некультурность, необразованность; о ком-либо приниженном, недостойном"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc094493-1cbd-4131-9525-382bf48206da",
                                                "sense_id": "870dad54-10a4-3e6e-924a-6e76171c387e",
                                                "text": "Главное, по серости своей она не сразу и разобралась в своём капитале."
                                            },
                                            {
                                                "example_id": "0a56293b-bb55-4569-bfd5-b86393c74c38",
                                                "sense_id": "870dad54-10a4-3e6e-924a-6e76171c387e",
                                                "text": "Он оправдался, он так её любит и между тем осуждён жить в крестьянской серости."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
