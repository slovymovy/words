                        "glosses": [
                            "Donner un caractère exceptionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2973a7-3ad3-4218-af72-a9b760043c4e",
                                "sense_id": "e57a3504-417e-3c8c-ba17-608f4271a44a",
                                "text": "Il paraissait très épris ; il sut le dire ; la jeune fille se plut à « exceptionnaliser » son fiancé, à le transformer en miroir spirituel où elle aima le reflet de ses propres désirs."
                            },
                            {
                                "example_id": "6ded63de-cd75-4d15-bc0d-99da5502852f",
                                "sense_id": "e57a3504-417e-3c8c-ba17-608f4271a44a",
                                "text": "Le propre de l’aoristique est d’exceptionnaliser l’action dans son rapport à l’état donné du fond."
                            }
                        ]
