                "translations": [
                    {
                        "translation_id": "cd57a214-7e38-4341-988a-72f976f6339d",
                        "source_entry_id": "06931ed3-748c-3cce-a21c-78882863e9bc",
                        "source_sense_id": "c5e03f75-371c-34f3-88fe-bf58f5b9f60c",
                        "target_lang_word": "great-granddaughter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "great-granddaughter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "accb80c8-d141-3f60-8c20-8376f9ddc5c1",
                                        "entry_id": "d006e761-2ea3-3649-b94a-8fa7ce27b649",
                                        "glosses": [
                                            "The daughter of someone's grandchild."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d952448-4330-4e7f-8c7b-81588ffe75df",
                                                "sense_id": "accb80c8-d141-3f60-8c20-8376f9ddc5c1",
                                                "text": "Her unluckier daughter and great-granddaughter have been tarred by amour's sloppy brush; but Mrs. Keppel, as her biographer Diana Souhami has written, \"turned adultery into an art.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "665aa73b-c357-4cb2-b061-a4eb3261dfc4",
                        "source_entry_id": "06931ed3-748c-3cce-a21c-78882863e9bc",
                        "source_sense_id": "c5e03f75-371c-34f3-88fe-bf58f5b9f60c",
                        "target_lang_word": "Urenkelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                        "entry_id": "936386e9-b56a-3da0-8e51-0fe3e6f74a44",
                                        "glosses": [
                                            "weibliches Kind von Enkel oder Enkelin oder weibliche Nachfahrin der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b35c08-c906-43e4-a914-3faf54cb8962",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "Unsere Urenkelin wird auch schon bald 6 Jahre alt."
                                            },
                                            {
                                                "example_id": "e37c4e70-8d05-435e-87c4-b31f7f8c23ee",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Im Laufe der Analysen kristallisierte sich allerdings heraus, dass auch unbearbeitete Themen aus der Familienvergangenheit bei den Enkelinnen und Urenkelinnen ihren Niederschlag fanden.“"
                                            },
                                            {
                                                "example_id": "03b0b3e3-7a76-491c-8876-4ba8ec359616",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Auch Helenes Mutter ist auf dem Bild zu sehen: Die mondän aussehende Dame hält die Hand ihrer kleinen Urenkelin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67c7eccb-83af-4f38-b93b-9d3e3510ebcc",
                        "source_entry_id": "06931ed3-748c-3cce-a21c-78882863e9bc",
                        "source_sense_id": "c5e03f75-371c-34f3-88fe-bf58f5b9f60c",
