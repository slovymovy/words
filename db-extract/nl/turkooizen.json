                "translations": [
                    {
                        "translation_id": "9f2be927-2345-46b1-8a4e-addb7ed099f3",
                        "source_entry_id": "26e8bf21-bdcc-38e8-bd37-30d3f0c1efc3",
                        "source_sense_id": "f242d4e8-493a-37db-9b06-b402dac39ed9",
                        "source_sense_description": "met de blauwgroene kleur turkoois.",
                        "target_lang_word": "türkis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "türkis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                        "entry_id": "d0c4d50d-0583-365e-a5d5-2a1269f064bb",
                                        "glosses": [
                                            "in einer Farbe zwischen blau und grün (für Textilien verwendet, sonst umgangssprachlich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1559955f-106f-42b2-8063-0d0465241e34",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Ihr BH ist türkis, vorne Spitze am Körbchen.“"
                                            },
                                            {
                                                "example_id": "1d3c5eef-d042-4aa6-be06-b41be83c8724",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Als ich mir im Spiegel die Zahnbüste ansehe (ja, auch die ist türkis bei mir), mit der ich mir gerade lustlos übers Gebiss fahre, platzt dem Liebsten, der gerade von einer anderen Party heimgekehrt ist, der Kragen: […]“"
                                            },
                                            {
                                                "example_id": "2c8d874a-ecd3-4d48-a826-309e80963996",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Das Zimmer ist türkis.“"
                                            },
                                            {
                                                "example_id": "8aa8334a-d56e-4f4a-8e16-f2e9751ce758",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Hach, das Bett ist türkis bezogen.“"
                                            },
                                            {
                                                "example_id": "eb0303f0-ca35-4250-8d9c-4eb95afcb984",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Die Luft ist klar und rein, der unter ihm liegende See leuchtet türkis.“"
                                            },
                                            {
                                                "example_id": "77d7cbfa-ce8f-466a-a3ec-a4d4ae55443f",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Ein türkis Hemd, eine sandfarbene Hose,dazu passend das Sakko lässig über die Schulter geworfen.“"
                                            },
                                            {
                                                "example_id": "67ac51f5-ee55-425f-a211-e71b73d0f03d",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "Sie trug einen türkisen Hut."
                                            },
                                            {
                                                "example_id": "c919ea69-4950-4e43-90e0-b378d1aa21a9",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Bobby's Bus Shelter hat bereits seine gelbe, türkise und rosa Periode durchlaufen.“"
                                            },
                                            {
                                                "example_id": "90135482-c7ee-4cd5-9989-0f8d0af2c851",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„So sollen auf dem Heimatmarkt künftig 80 bis 100 Läden den Schmuck in den markanten türkisen Schachteln verkaufen.“"
                                            },
                                            {
                                                "example_id": "17c25ab9-730e-451f-97c2-ac2a14204e95",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Etwa die «Blancaneaux Logde», ein Hideaway im Regenwald der Maya Mountains, wo Wasserfälle in türkise Becken rauschen und man auf den Balkons der Lodges praktisch mitten im tiefgrünen Urwald sitzt.“"
                                            },
                                            {
                                                "example_id": "d0cb825a-547c-48cb-972f-ca82b418d58e",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Die Website wurde einem Relaunch unterzogen, den türkisen Farbton der Bundespartei hat man aber nicht hinbekommen.“"
                                            },
                                            {
                                                "example_id": "eaa4138f-b71a-414b-ba2c-9a67c43429ef",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Dschungelhügel, Kolibris an den Blüten, turnende Eichkätzchen, dahinter weißer Sand und türkise Meereswellen.“"
                                            },
                                            {
                                                "example_id": "0d3db466-9680-4793-b4b4-35d731db7dba",
                                                "sense_id": "1cd5f755-b573-3bdc-8a87-2d46c77d1e69",
                                                "text": "„Nach einer halben Stunde kam er wieder heraus und knöpfte sich ein türkises Hemd zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b42e7905-5835-49d3-9bed-f6973bf44a86",
                        "source_entry_id": "26e8bf21-bdcc-38e8-bd37-30d3f0c1efc3",
