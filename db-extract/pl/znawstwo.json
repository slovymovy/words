                    {
                        "sense_id": "39709cf5-f5d3-36c5-bfb7-2d7320f725ce",
                        "entry_id": "878f1e13-bcbb-33ec-aa1d-4859831760e4",
                        "glosses": [
                            "knowledge, expertise, connoisseurship (familiarity or understanding of a particular skill)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "44542a9f-e8f2-4cbd-959f-e4abd50ca119",
                                "sense_id": "39709cf5-f5d3-36c5-bfb7-2d7320f725ce",
                                "text": "Albowiem tutejsze damy, dodał mój przyjaciel ze znawstwem, nie przebaczają finansowych rozczarowań.",
                                "translation": "Because local ladies, added my friend knowledgeably, don't forgive financial let-downs.",
                                "english": "Because local ladies, added my friend knowledgeably, don't forgive financial let-downs."
                            },
                            {
                                "example_id": "a2aa0ea3-323d-4790-bd9c-e6800015b1b4",
                                "sense_id": "39709cf5-f5d3-36c5-bfb7-2d7320f725ce",
                                "text": "[…] niemożna prawdziwie pojąć, dlaczego ta młodzież w pocie czoła znawstwo na koniach udająca, prawdziwéj nauki nabyć się nie stara.",
                                "translation": "[…] one can't truly fathom, why this youth pretending its knowledge of horses in the sweat of brows, doesn't try to acquire the real knowledge.",
                                "english": "[…] one can't truly fathom, why this youth pretending its knowledge of horses in the sweat of brows, doesn't try to acquire the real knowledge."
                            },
                            {
                                "example_id": "901e8076-3fb9-4feb-b063-95d618539407",
                                "sense_id": "39709cf5-f5d3-36c5-bfb7-2d7320f725ce",
                                "text": "Obejrzał zwłoki z wszystkich stron, włożył nawet palec w dziurę po kuli i nieco w niej pogmerał z miną świadczącą o znawstwie.",
                                "translation": "He saw over the corpse from all directions, even inserted his finger into the bullet hole and rummaged slightly with a face indicating expertise.",
                                "english": "He saw over the corpse from all directions, even inserted his finger into the bullet hole and rummaged slightly with a face indicating expertise."
                            }
                        ]
                    }
