                    {
                        "sense_id": "30269637-3f4c-3fed-a882-73bad2134b34",
                        "entry_id": "85045cbb-ad70-3d7a-94ee-10038ba144a8",
                        "glosses": [
                            "A user of the social media site Gab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07255ab9-73d9-45d5-ab1b-8f7d5f80dbad",
                                "sense_id": "30269637-3f4c-3fed-a882-73bad2134b34",
                                "text": "In a post on Medium on May 8, Gab leaders shared the latest statistics: \"In under nine months, 170,000 Gabbers have 7.6 million posts and raised $145,000 to help us expand our team and cover operational expenses.\""
                            },
                            {
                                "example_id": "778830ae-01fa-4edb-b0fc-20f32bd804f0",
                                "sense_id": "30269637-3f4c-3fed-a882-73bad2134b34",
                                "text": "These folks were the ideal Gabbers: salt of the earth types who fully understand that Big Tech is evil and free speech is important."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
