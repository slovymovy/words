                "senses": [
                    {
                        "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                        "entry_id": "2d2f6ee2-e1dc-3c38-b057-1467a7f2f94d",
                        "glosses": [
                            "Kunststoffteil, das im Spritzgussverfahren maschinell gespritzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c1c655-a46d-4862-8174-2ebcb1c7fc65",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Als Hersteller für Kunststoffspritzgussteile aller Art fertigen wir für die Industrie die unterschiedlichsten Produkte.“"
                            },
                            {
                                "example_id": "2712b52d-5577-4d99-8f68-30f7b2453c83",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Nach Ihren Anforderungen bezüglich Verwendungszweck, Beschaffenheit, Material, Oberfläche und Farbe, fertigen wir für Sie kostengünstig kleine hochwertige Kunststoffspritzgussteile aus allen gängigen thermoplastischen Materialien.“"
                            },
                            {
                                "example_id": "833d6abb-3a6d-4740-b2e5-8c873778d1e0",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Wir haben in Zusammenarbeit mit unserem Kunden ein kleines aber feines Kunststoffspritzgussteil geschaffen, dass die Ohren schützt und für einen angenehmen Flug sorgt.“"
                            },
                            {
                                "example_id": "da811684-c83e-4f19-9fb1-80d7881c54b9",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Dabei ist es unerheblich ob Sie nur ein einzelnes Bauteil, z.B. ein Kunststoffspritzgussteil, eine ganze Baugruppe oder ein ganzes Gerät oder eine Maschine benötigen.“"
                            },
                            {
                                "example_id": "d50dd32f-b3fa-4c2e-ac3c-4ab31e56960c",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Mehrschalige Bauteile mit konstanter Wandstärke werden in erster Linie als Kunststoffspritzgussteil hergestellt.“"
                            },
                            {
                                "example_id": "179fa2c7-5729-425f-a736-6b3317e85134",
                                "sense_id": "e13596a2-1275-334c-b0d9-e4606704910d",
                                "text": "„Wir fertigen Kunststoffspritzgußteile aus allen marktüblichen Thermoplast-Werkstoffen (Polyamid, Polyethylen, Polypropylen, ABS, Plexiglas, Polystyrol, Teflon, POM usw.), aus Duroplast-Materialien (Epoxidharz, Polyesterharz, Phenolharz u.a.) und aus Thermoplastischen Elastomeren (TPEs).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
