                                            {
                                                "example_id": "799403e0-f738-4021-ac12-f7e0cf57cada",
                                                "sense_id": "db2d122e-dd18-33ee-90a3-5cdece039ef3",
                                                "text": "Hij fietste in aangeschoten toestand naar huis."
                                            },
                                            {
                                                "example_id": "ca1b8b38-dc33-4082-9b29-bb6d25aea458",
                                                "sense_id": "db2d122e-dd18-33ee-90a3-5cdece039ef3",
                                                "text": "Ze is waarschijnlijk nog helemaal opgeladen van de auditie. Of aangeschoten."
                                            },
                                            {
                                                "example_id": "e335cb5e-687a-42fa-8eb6-88deffe4461d",
                                                "sense_id": "db2d122e-dd18-33ee-90a3-5cdece039ef3",
                                                "text": "De man en de vrouw leken een beetje aangeschoten."
                                            },
                                            {
                                                "example_id": "c364ba00-79bb-4bd1-b103-0b74ab5c6cdb",
                                                "sense_id": "db2d122e-dd18-33ee-90a3-5cdece039ef3",
                                                "text": "nou ja, hij was verzot op drank en als hij flink aangeschoten was, bleef je uit zijn buurt."
                                            }
