                    {
                        "sense_id": "b1ecd3a5-2f91-3aa9-a35d-68b15d91ab95",
                        "entry_id": "614f5759-d78e-3ba9-be6a-1143c4e87dab",
                        "glosses": [
                            "To kick back; to kick against anything."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "65d0a6ac-2f70-4291-961a-667331c41d7a",
                                "sense_id": "b1ecd3a5-2f91-3aa9-a35d-68b15d91ab95",
                                "text": "[The National Assembly] has to hear of innumerable fresh revolts, Brigand expeditions; of Chateaus in the West, especially of Charter-chests, Chartiers, set on fire; for there too the overloaded Ass frightfully recalcitrates."
                            }
                        ]
                    },
                    {
                        "sense_id": "6838e03c-fc0f-3901-bf24-ff59ef952bdc",
                        "entry_id": "614f5759-d78e-3ba9-be6a-1143c4e87dab",
                        "glosses": [
                            "To express repugnance or opposition."
                        ],
                        "tags": [
                            "broadly",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "549891d5-55df-42e9-b381-ed31b6dd5e41",
                                "sense_id": "6838e03c-fc0f-3901-bf24-ff59ef952bdc",
                                "text": "The more one was indignant at being the object of such a man's contempt, the more heartily did one disdain his disdain, and recalcitrate his kicks."
                            }
                        ]
                    }
