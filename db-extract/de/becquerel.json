                "senses": [
                    {
                        "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                        "entry_id": "053a7f0f-2d0e-31f1-b86c-2a3aadbf5fb9",
                        "glosses": [
                            "seit 1975 abgeleitete SI-Einheit der Radioaktivität; gibt die mittlere Anzahl der Atomkerne an, die pro Sekunde radioaktiv zerfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981858b4-f6b1-4049-a955-143969cd04e0",
                                "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                                "text": "„Angegeben wird die Aktivität üblicherweise in der SI-Einheit Becquerel (Bq), ein Becquerel entspricht einem Zerfall pro Sekunde.“"
                            },
                            {
                                "example_id": "bc05dbbf-a40c-4fb4-a1db-4aba0d334cff",
                                "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                                "text": "„Die Belastung der Maronen-Röhrlinge mit radioaktivem ¹³⁷Cs liegt auch 20 Jahre nach dem Reaktorunglück von Tschernobyl gebietsweise über dem EU-Grenzwert für Lebensmittel von 600 Becquerel pro Kilogramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
