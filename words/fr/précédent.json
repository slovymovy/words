{
    "word_family": [
        "précéder",
        "précédemment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "999cf582-8c92-3c8d-ade6-3321f0b8dfee",
                    "sense_definition": "Qui a eu lieu immédiatement avant un moment donné dans le temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a confirmé les déclarations faites lors du rendez-vous <w>précédent</w>."
                        },
                        {
                            "text": "Il est retourné voir sa famille pendant la semaine <w>précédente</w>."
                        }
                    ],
                    "synonyms": [
                        "antécédent"
                    ],
                    "antonyms": [
                        "suivant"
                    ],
                    "common_phrases": [
                        "le jour précédent",
                        "la semaine précédente"
                    ]
                },
                {
                    "sense_id": "84a4fb83-0add-3468-a032-a78624d659aa",
                    "sense_definition": "Qui se trouve immédiatement avant dans un rang, un livre ou une série ordonnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous trouverez la formule mathématique à la page <w>précédente</w>."
                        },
                        {
                            "text": "L'auteur résume les arguments du chapitre <w>précédent</w> avant de continuer."
                        }
                    ],
                    "antonyms": [
                        "suivant"
                    ],
                    "common_phrases": [
                        "la page précédente",
                        "le chapitre précédent"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5091941f-0a70-303d-86cf-297bccc127af",
                    "sense_definition": "Fait ou événement antérieur servant d'exemple ou de justification pour l'avenir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette crise sanitaire a provoqué une récession économique sans <w>précédent</w>."
                        },
                        {
                            "text": "Accepter une telle dérogation risquerait de créer un dangereux <w>précédent</w>."
                        }
                    ],
                    "common_phrases": [
                        "sans précédent",
                        "créer un précédent"
                    ]
                },
                {
                    "sense_id": "08dfd3e5-cf47-3bb0-84a0-c899ebac02f8",
                    "sense_definition": "Décision de justice antérieure servant de référence juridique pour trancher une affaire analogue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a cité un <w>précédent</w> de la cour pour appuyer sa défense."
                        },
                        {
                            "text": "Les magistrats doivent déterminer si ce <w>précédent</w> s'applique à l'affaire en cours."
                        }
                    ],
                    "common_phrases": [
                        "faire précédent",
                        "force de précédent"
                    ]
                }
            ]
        }
    ]
