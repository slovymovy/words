        "fr-extract.jsonl": [
            {
                "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                "word": "kimono",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa8f439d-181d-46ea-82b9-d8b20f3710b0",
                        "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "kimonos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                        "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                        "glosses": [
                            "Vêtement japonais traditionnel flottant et à manches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbaba128-e31d-4b30-a3f5-5fcf74460310",
                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                "text": "Arrivé au Japon au VIIᵉ siècle, le kimono s’y est développé au XIVᵉ siècle, selon des codes précis : tissu et couleur indiquaient la classe sociale ou le statut marital. Dans un pays désormais occidentalisé, le kimono est aujourd’hui plutôt réservé aux événements traditionnels."
                            },
                            {
                                "example_id": "1f93a049-52ec-4666-af7a-5e09841c601f",
                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                "text": "Cette scène menaçant de s’éterniser, la Caille se levait en silence et, ficelé dans un kimono, ouvrait la fenêtre, s’accoudait…"
                            },
                            {
                                "example_id": "b04fd0e2-7d1f-433f-b2cd-baaf3eabdfd6",
                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                "text": "Sept lés de tissu assemblés les uns aux autres. Le côté droit se rabat sur le côté gauche, la taille se laisse ceindre d’une large bande de quatre ou cinq mètres de long pour environ 35 centimètres de large. Le kimono est à la fois un vêtement très simple et l’expression d'un univers infiniment complexe."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c506266-d46a-3335-a08e-13056eac520f",
                        "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                        "glosses": [
                            "(Usage critiqué) référence nécessaire (résoudre le problème) Vêtement d’entraînement des arts martiaux japonais, et des par extension d’autres arts martiaux.\\nL’appellation correcte est dogi ou keikogi."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4dd1dcf-433d-4a6e-be01-82f1b5511488",
                        "source_entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                        "target_lang_word": "Kimono",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kimono",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                        "entry_id": "e12af3a8-58e7-3576-9e71-cb346aea47f5",
                                        "glosses": [
                                            "japanisches Gewand mit weiten, angeschnittenen Ärmeln, das von Männern und Frauen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593837cf-90da-4512-a04c-c88cd359f2c1",
                                                "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                                "text": "Sie trug einen Kimono."
                                            },
                                            {
                                                "example_id": "1e9c8883-30aa-4032-8f32-739481c34e08",
                                                "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                                "text": "„Sie hat wie immer ein weißes einfaches Kleid an; Eva geht in einem schwarzseidenen Kimono.“"
                                            },
                                            {
                                                "example_id": "16c54199-557e-4841-a664-8fbac8f93d2c",
                                                "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                                "text": "„Mein Blick fiel auf den mit schimmernden Kolibris bestickten Kimono, der an der Badezimmertür hing.“"
                                            },
                                            {
                                                "example_id": "55df5e07-d344-4c0c-9bbd-d39cd7ea9cc6",
                                                "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                                "text": "„Sie hatte im Koffer gelegen, als Papa einmal aus Japan zurückgekommen war, er war zwei Wochen weg gewesen, ich bekam als Mitbringsel einen seltenen Kimono, während die Puppe nach oben ins Regal gesetzt wurde, damit ich sie nicht erreichen könnte.“"
                                            },
                                            {
                                                "example_id": "5e765162-9ad9-489b-869e-aff08efcc2fe",
                                                "sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                                                "text": "„Er sah zu, wie der alte Mann seinen baumwollenen Kimono ablegte und aufhängte, ohne nach dem Kleiderhaken dafür zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "032a5b6d-d0c5-48d2-8fae-da0513174000",
