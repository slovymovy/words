                        "sense_id": "2acae1f8-619b-311c-b4d9-371acf1c6a63",
                        "entry_id": "d1617b3e-b4f4-37a8-be4a-6fa6f857275d",
                        "glosses": [
                            "fernab der Küste oder mittig / zentral liegendes Land"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "74a46809-90ae-46c5-ad6d-72adf1b1af40",
                                "sense_id": "2acae1f8-619b-311c-b4d9-371acf1c6a63",
                                "text": "„Das Tiroler Mittelland oder Innsbrucker Land umfasst den Zentralraum Tirols um die Stadt Innsbruck.“"
                            },
                            {
                                "example_id": "54201bf3-73a9-4dd4-b910-a711b4ae9361",
                                "sense_id": "2acae1f8-619b-311c-b4d9-371acf1c6a63",
                                "text": "„Das genannte Phänomen nennt man etwa im Großteil Tirols Kchåi. Im Paznaun, im Stanzertal sowie im Tiroler Mittelland spricht man dagegen von Kchai – das a ist hier nicht verdumpft.“"
                            }
                        ],
