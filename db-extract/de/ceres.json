                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fd3e02-a99a-4976-9c7a-e148ee1ce1e5",
                                "sense_id": "bd205757-1494-3649-9a4d-b42a3cfe0f79",
                                "text": "Ceres ist ein Zwergplanet und mit einem Äquatordurchmesser von 975 km das größte Objekt im Asteroiden-Hauptgürtel."
                            }
                        ],
                        "sense_index_json": "\"2\""
