        "ru-extract.jsonl": [
            {
                "entry_id": "cd681483-cc29-3d2a-9f2a-83f74fe22f78",
                "word": "непосредственно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "56e05ce6-3d79-3737-b276-e386b01520b1",
                        "entry_id": "cd681483-cc29-3d2a-9f2a-83f74fe22f78",
                        "glosses": [
                            "наречие к непосредственный; напрямую, без посредника"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b886b9-e64b-4b41-802c-d678212370f1",
                                "sense_id": "56e05ce6-3d79-3737-b276-e386b01520b1",
                                "text": "Гребенщиков предупредил, что ему известна из вырученных Зубром только малая часть, те, с кем непосредственно приходилось работать; были и другие, но кто, сколько — не знает, считал, что не вправе интересоваться."
                            }
                        ]
                    },
                    {
                        "sense_id": "b845cb93-0135-3293-8092-6a611aebd387",
                        "entry_id": "cd681483-cc29-3d2a-9f2a-83f74fe22f78",
                        "glosses": [
                            "естественно, без раздумий и сомнений следуя своему внутреннему влечению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c1ebd5-2e04-4068-a91e-6abd9c7a1af5",
                                "sense_id": "b845cb93-0135-3293-8092-6a611aebd387",
                                "text": "Колеватов вёл себя великолепно, держался непосредственно, старался быть весёлым."
                            }
                        ]
                    },
                    {
                        "sense_id": "882e6e72-09bf-38cb-be9c-385c538aec86",
                        "entry_id": "cd681483-cc29-3d2a-9f2a-83f74fe22f78",
                        "glosses": [
                            "то же, что сразу; без пространственного или временно́го интервала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6701393f-56f5-448f-bc89-50ffca437990",
                                "sense_id": "882e6e72-09bf-38cb-be9c-385c538aec86",
                                "text": "Кроме того, показано, что корь оказывает влияние на смертность не только в период, следующий непосредственно за инфекцией, но и в более поздний период времени."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a436e2e-542c-4bd1-baaa-c3d5f89b69cc",
                        "source_entry_id": "cd681483-cc29-3d2a-9f2a-83f74fe22f78",
                        "target_lang_word": "onmiddellijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onmiddellijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a133fb-2f8e-3e45-84ad-5d569dbb6f56",
                                        "entry_id": "79a52cbd-a785-3378-b153-c1e6884eb49c",
                                        "glosses": [
                                            "zonder uitstel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a646901f-b108-471d-94d4-29eec5e5a1be",
                                                "sense_id": "e8a133fb-2f8e-3e45-84ad-5d569dbb6f56",
                                                "text": "Dit heeft een onmiddellijke verlaging van de temperatuur ten gevolge."
                                            },
                                            {
                                                "example_id": "b3562fc3-5d83-4913-ad2f-ccdf1b0ed417",
                                                "sense_id": "e8a133fb-2f8e-3e45-84ad-5d569dbb6f56",
                                                "text": "Het vertrek werd onmiddellijk gestopt en alle passagiers werden uit het vliegtuig gehaald. Het vliegtuig verliet Manchester uiteindelijk pas zaterdagochtend om 05.00 uur met enkele tientallen minder passagiers aan boord."
                                            },
                                            {
                                                "example_id": "a684b162-55fb-4ce7-8548-922eb03394b1",
                                                "sense_id": "e8a133fb-2f8e-3e45-84ad-5d569dbb6f56",
                                                "text": "De reflex om het gewicht onmiddellijk over te pakken of om me als een slangenmens snel uit de hengsels te wurmen zodat het de ander zo min mogelijk moeite kost mij te bevrijden: hij is er niet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb504a59-5850-37db-81cc-6b79fad2ceea",
                                        "entry_id": "79a52cbd-a785-3378-b153-c1e6884eb49c",
                                        "glosses": [
                                            "zonder omwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b8fb9d1-583a-47f2-9d2d-c1ae85128c14",
                                                "sense_id": "cb504a59-5850-37db-81cc-6b79fad2ceea",
                                                "text": "Deze gang is een onmiddellijke uitgang naar de straat."
                                            },
                                            {
                                                "example_id": "a5a9884f-2ba2-4aab-9223-6470f7091fe3",
                                                "sense_id": "cb504a59-5850-37db-81cc-6b79fad2ceea",
                                                "text": "Een jonge jongen in een Schotse rok kwam keihard in een stofwolk de berg af rennen en sprong onmiddellijk op Pogues rug."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onmiddellijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2b23784c-74c5-3f23-a5e3-5e41037d4d16",
                                        "entry_id": "d66a8ebe-9ee8-3e5f-a37e-f6573c0131b3",
                                        "glosses": [
                                            "zonder uitstel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40615c0b-8816-4939-8342-c8962fbdc592",
                                                "sense_id": "2b23784c-74c5-3f23-a5e3-5e41037d4d16",
                                                "text": "De injectie gaf onmiddellijk verbetering in de toestand van de patiënt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f0c9ac-7534-3d9f-917d-df56629ec640",
                                        "entry_id": "d66a8ebe-9ee8-3e5f-a37e-f6573c0131b3",
                                        "glosses": [
                                            "zonder omwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98106cbb-f0c6-4ff9-8f3d-bfd76ace05d6",
                                                "sense_id": "98f0c9ac-7534-3d9f-917d-df56629ec640",
                                                "text": "Deze weg geeft niet onmiddellijk toegang tot de binnenstad, maar gaat er met een bocht omheen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
