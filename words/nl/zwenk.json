                    "sense_id": "14884131-25f9-31a9-847f-52aa00266a32",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>zwenken</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwenk</w> naar rechts om de drukke weg te vermijden.",
                            "target_lang_translations": {
