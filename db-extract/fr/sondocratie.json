                "senses": [
                    {
                        "sense_id": "545f7e1e-5a95-3a31-b972-10152b318b59",
                        "entry_id": "23c6329f-2188-39f0-b9a8-209785069c4e",
                        "glosses": [
                            "Politique opportuniste influencée par les résultats de sondages d’opinion."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bfe76276-8e95-42df-8d2d-72a661e86037",
                                "sense_id": "545f7e1e-5a95-3a31-b972-10152b318b59",
                                "text": "Le recours systématique aux sondages a conduit certains auteurs à se demander si nous ne vivions pas désormais en « sondocratie », celle-ci désignant le gouvernement par les sondages."
                            },
                            {
                                "example_id": "9aaa601a-7851-4aac-8b6d-49780e36c686",
                                "sense_id": "545f7e1e-5a95-3a31-b972-10152b318b59",
                                "text": "Le 20 heures de TF1 semble se constituer en vitrine de tout un monde postmoderne qui relève de la « sondocratie », c’est-à-dire dans lequel les sondages d’opinion, autrement dit la doxa, prennent une valeur de vérité."
                            },
                            {
                                "example_id": "69765ab7-1adc-41b3-937b-3cb995779fc1",
                                "sense_id": "545f7e1e-5a95-3a31-b972-10152b318b59",
                                "text": "Les pourfendeurs de la « sondocratie » se régalent des multiples questions que posent les conditions de réalisation de deux sondages Harris Interactive sur les intentions de vote au premier tour de la présidentielle de 2012."
                            }
                        ]
                    }
                ],
