    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94c7b560-79ae-3313-a988-386cbb6e135c",
                    "sense_definition": "bij benadering een waarde, grootte of aantal bepalen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inschatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men <w>schat</w> dat er in West- en Midden-Europa totaal ongeveer 7000 ruigpootuilen zijn.",
                            "target_lang_translations": {
                                "en": "It is <w>estimated</w> that there are a total of about 7000 Boreal owls in Western and Central Europe."
                            }
                        },
                        {
                            "text": "Het is lastig om de <w>kosten</w> te <w>schatten</w> zonder een officieel plan.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>estimate</w> the costs without an official plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "benaderen"
                    ],
                    "common_phrases": [
                        "kosten schatten",
                        "waarde schatten"
                    ],
                    "target_lang_definitions": {
                        "en": "To determine a value, size, or number approximately"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "estimate",
                                "target_lang_sense_clarification": "to calculate roughly"
                            },
                            {
                                "target_lang_word": "guess",
                                "target_lang_sense_clarification": "to make an informal estimate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec797ac3-7391-3205-bead-37ab534fb093",
                    "sense_definition": "een oordeel vormen over iemands eigenschappen, zoals leeftijd of karakter",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inschatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schatte</w> hem zo'n jaar of vijftig op basis van zijn grijze haar.",
                            "target_lang_translations": {
                                "en": "I <w>estimated</w> him to be about fifty years old based on his gray hair."
                            }
                        },
                        {
                            "text": "Zij kan mensen heel goed op hun <w>leeftijd</w> <w>schatten</w>.",
                            "target_lang_translations": {
                                "en": "She is very good at <w>estimating</w> people's ages."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leeftijd schatten"
                    ],
                    "target_lang_definitions": {
                        "en": "To form a judgment about someone's characteristics, such as age or character"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "estimate",
                                "target_lang_sense_clarification": "to judge someone's age or traits"
                            },
                            {
                                "target_lang_word": "judge",
                                "target_lang_sense_clarification": "to form an opinion about someone"
                            },
                            {
                                "target_lang_word": "gauge",
                                "target_lang_sense_clarification": "to assess a person's qualities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f7d128-c91d-3955-8df4-879ab515ed6f",
                    "sense_definition": "de officiële waarde van iets vaststellen, vaak door een expert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waardebepaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De expert kwam langs om de antieke kast op <w>waarde</w> te <w>schatten</w>.",
                            "target_lang_translations": {
                                "en": "The expert came by to <w>appraise</w> the value of the antique cabinet."
                            }
                        },
                        {
                            "text": "De verzekering laat de schade aan de auto door een specialist <w>schatten</w>.",
                            "target_lang_translations": {
                                "en": "The insurance company is having the damage to the car <w>assessed</w> by a specialist."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op waarde schatten"
                    ],
                    "target_lang_definitions": {
                        "en": "To determine the official value of something, often by an expert"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appraise",
                                "target_lang_sense_clarification": "to determine the official value"
                            },
                            {
                                "target_lang_word": "value",
                                "target_lang_sense_clarification": "to set a price or worth"
                            },
                            {
                                "target_lang_word": "assess",
                                "target_lang_sense_clarification": "to evaluate for insurance or tax"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5956ccf6-e862-3f76-bc56-f18d36d18cc6",
                    "sense_definition": "iets of iemand naar waarde weten te waarderen of op prijs stellen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bijdragen van alle gebruikers horen naar <w>waarde</w> <w>geschat</w> te worden.",
                            "target_lang_translations": {
                                "en": "The contributions of all users should be <w>appreciated</w> for their true worth."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat je je personeel naar <w>waarde</w> <w>schat</w>.",
                            "target_lang_translations": {
                                "en": "It is important that you <w>value</w> your staff appropriately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar waarde schatten"
                    ],
                    "target_lang_definitions": {
                        "en": "To know how to appreciate something or someone according to their worth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appreciate",
                                "target_lang_sense_clarification": "to recognize the full worth of"
                            },
                            {
                                "target_lang_word": "value",
                                "target_lang_sense_clarification": "to consider someone important"
                            },
                            {
                                "target_lang_word": "esteem",
                                "target_lang_sense_clarification": "to respect and admire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b2fb80f-a4c5-3bd0-a970-38cb33b4d805",
                    "sense_definition": "vanuit een beperkte steekproef een getalswaarde bepalen die een parameter benadert",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "statistiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een steekproefgemiddelde kan het gemiddelde het meest efficiënt <w>geschat</w> worden.",
                            "target_lang_translations": {
                                "en": "With a sample mean, the population mean can be <w>estimated</w> most efficiently."
                            }
                        },
                        {
                            "text": "In de statistiek probeert men parameters te <w>schatten</w> met een kleine foutmarge.",
                            "target_lang_translations": {
                                "en": "In statistics, one tries to <w>estimate</w> parameters with a small margin of error."
                            }
                        }
                    ],
                    "common_phrases": [
                        "parameters schatten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische of wetenschappelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To determine a numerical value that approximates a parameter from a limited sample"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "estimate",
                                "target_lang_sense_clarification": "statistical calculation of a parameter"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
