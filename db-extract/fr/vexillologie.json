        "fr-extract.jsonl": [
            {
                "entry_id": "ee13bb40-fbe8-37b1-9e7c-b1301ade8d0b",
                "word": "vexillologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49e4857d-a37c-4492-9e07-9639fca0c851",
                        "entry_id": "ee13bb40-fbe8-37b1-9e7c-b1301ade8d0b",
                        "tags": [
                            "plural"
                        ],
