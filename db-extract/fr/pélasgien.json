                        "examples": [
                            {
                                "example_id": "ab6c9d38-6895-4909-bf3c-51a34fe06d76",
                                "sense_id": "d14fef36-f255-3b77-b75b-827c68365b3b",
                                "text": "Ce furent les vaincus qui leur firent connaître les éléments de la civilisation, et ce fut par le mélange du sang pélasgien avec Iʼionien, lʼéolien et lʼachéen que se produisit, dans la succession des générations, ce génie heureux des Grecs pour la poésie et pour les arts."
                            },
                            {
                                "example_id": "64960523-c7b5-462e-a82f-730f4f7796f1",
                                "sense_id": "d14fef36-f255-3b77-b75b-827c68365b3b",
                                "text": "A cet élément se rattache essentiellement la civilisation pélasgienne."
                            }
                        ]
                    }
