                                "target_senses": [
                                    {
                                        "sense_id": "1bb7ca10-f05e-363b-8b0a-15c9ff7efa4e",
                                        "entry_id": "b78cdb52-d477-3c72-b483-550f7b2dd6ed",
                                        "glosses": [
                                            "A province and metropolitan municipality in western Anatolia in Turkey, along the Mediterranean coast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32924e5d-cead-319e-8c4f-f466971bf622",
                                        "entry_id": "b78cdb52-d477-3c72-b483-550f7b2dd6ed",
                                        "glosses": [
                                            "A major port city, the capital of İzmir Province, Turkey, geographically continuous with the ancient city of Smyrna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7b75ff-d336-4bc2-9bc3-f9ae93fe8b97",
                                                "sense_id": "32924e5d-cead-319e-8c4f-f466971bf622",
                                                "text": "1954, Amerikan Kız Koleji [aut.] and Margaret W. Meyer [ed.], İzmir: The Gateway to Turkey (Piyasa Matbaası), main title"
                                            },
                                            {
                                                "example_id": "343200c1-4ac9-4e1e-b8ed-8272167bc64c",
                                                "sense_id": "32924e5d-cead-319e-8c4f-f466971bf622",
                                                "text": "One major problem in towns of all sizes is the lack of street signs, but almost every local tourist office can provide you with a map. City tourist offices almost always provide acceptable maps; those for İstanbul and İzmir are as good as any you pay for."
                                            },
                                            {
                                                "example_id": "092b6850-cb5b-4914-a963-4cf9da5ca6ac",
                                                "sense_id": "32924e5d-cead-319e-8c4f-f466971bf622",
                                                "text": "It may be Turkey’s third-largest city in terms of population, but in the congestion stakes İzmir has to be challenging for top honours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
