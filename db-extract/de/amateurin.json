                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "amatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b7668f-5fc1-3ba6-bd05-1058f92145e3",
                                        "entry_id": "d8466589-66b6-3136-bb48-1e75751c4aae",
                                        "glosses": [
                                            "Féminin singulier de amateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5128dec8-89fb-49fa-bff4-db7fff7c50be",
                                                "sense_id": "39b7668f-5fc1-3ba6-bd05-1058f92145e3",
                                                "text": "Une footballeuse amatrice poitevine a écrit à la ministre déléguée chargée des Sports, Roxana Maracineanu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
