                                "target_senses": [
                                    {
                                        "sense_id": "9e4ce06f-589b-3efb-8e9d-a760413a93c6",
                                        "entry_id": "219e7654-f0d8-3048-b0d3-3ac3e0890c2b",
                                        "glosses": [
                                            "S’accroupir, se ramasser de manière à tenir le moins d’espace possible."
                                        ],
                                        "tags": [],
                                        "note": "Cela se dit des hommes et des animaux",
                                        "examples": [
                                            {
                                                "example_id": "fdaf6b59-ee55-4882-9ae6-2f301a9ea248",
                                                "sense_id": "9e4ce06f-589b-3efb-8e9d-a760413a93c6",
                                                "text": "Par cette matinée glaciale d'octobre, où tombait un mélange de pluie et de neige fondue, les deux enfants, faute de places dans l'intérieur et la rotonde, durent se blottir sous la bâche, derrière le conducteur."
                                            },
                                            {
                                                "example_id": "7ed359df-781d-4a80-92fe-1ee8abb7f707",
                                                "sense_id": "9e4ce06f-589b-3efb-8e9d-a760413a93c6",
                                                "text": "Les perdrix se blottissent devant le chien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52ad76f-e2dd-3fad-ad84-9fa5ab63b036",
                                        "entry_id": "219e7654-f0d8-3048-b0d3-3ac3e0890c2b",
                                        "glosses": [
                                            "Se tenir l’un contre l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764cbf83-28a4-48bd-8f13-99ee036a7748",
                                                "sense_id": "c52ad76f-e2dd-3fad-ad84-9fa5ab63b036",
                                                "text": "Nous nous affalons côte à côte dans le grand canapé blanc, moelleux comme un marshmallow géant ; mon corps s'enfonce confortablement dans les coussins tandis que Damen attrape la télécommande et se blottit contre moi."
                                            }
                                        ]
                                    }
                                ]
                            }
