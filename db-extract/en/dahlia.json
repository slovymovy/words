                    {
                        "translation_id": "b645f822-af13-4d46-bd71-c5e994011c43",
                        "source_entry_id": "8b823301-0af1-310a-bce9-89f1bab53795",
                        "source_sense_id": "94e9d3ae-8d25-3e16-9446-e54d2898e894",
                        "source_sense_description": "any plant of the genus Dahlia",
