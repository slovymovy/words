                {
                    "sense_id": "a3866285-a946-3ec9-a7aa-c4581b632a1c",
                    "sense_definition": "The state or process of drying out completely or losing all moisture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drying_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extreme heat caused rapid <w>desiccation</w> of the soil, making it impossible to grow crops.",
                            "target_lang_translations": {
                                "ru": "Экстремальная жара вызвала быстрое <w>иссушение</w> почвы, сделав выращивание урожая невозможным."
                            }
                        },
                        {
                            "text": "Certain desert frogs have evolved adaptations to survive prolonged periods of <w>desiccation</w>.",
                            "target_lang_translations": {
                                "ru": "У некоторых пустынных лягушек выработались приспособления для выживания в длительные периоды <w>обезвоживания</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "demoisturization",
                        "demoisturisation"
                    ],
                    "common_phrases": [
                        "rapid desiccation",
                        "prevent desiccation",
                        "complete desiccation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или процесс полного высыхания или потери всей влаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высыхание",
                                "target_lang_sense_clarification": "процесс утраты влаги или обезвоживания"
                            },
                            {
                                "target_lang_word": "иссушение",
