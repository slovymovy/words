                    "sense_id": "fd490c2b-a72a-305a-a2aa-f56adf452211",
                    "sense_definition": "The sport or activity of moving over snow on skis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_activities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are planning to go <w>skiing</w> in the mountains this winter.",
                            "target_lang_translations": {
                                "ru": "Мы планируем поехать <w>кататься на лыжах</w> в горы этой зимой.",
                                "zh": "我们计划今年冬天去山上<w>滑雪</w>。"
                            }
                        },
                        {
                            "text": "Cross-country <w>skiing</w> is excellent exercise for the whole body.",
                            "target_lang_translations": {
                                "ru": "<w>Катание на беговых лыжах</w> — это отличное упражнение для всего тела.",
                                "zh": "越野<w>滑雪</w>是对全身极好的锻炼。"
                            }
                        }
                    ],
                    "common_phrases": [
