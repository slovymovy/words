        "fr-extract.jsonl": [
            {
                "entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                "word": "visiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                        "entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                        "glosses": [
                            "D’une manière visible ou appréciable à la vue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee60620-8ebc-41d6-a5de-3ca65ac7e887",
                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                "text": "Elizabeth II était visiblement accro à Twin Peaks. C’est ce qu’avait confié le compositeur de la série, Angelo Badalamenti, au New Musical Express."
                            },
                            {
                                "example_id": "db3603e7-6fbd-40f3-8938-9ff3f19e5d3a",
                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                "text": "Visiblement, en dépit de ses constantes fanfaronnades, le docteur était, à tout le moins, aussi poltron que ses compatriotes de Werst."
                            },
                            {
                                "example_id": "1dbccae2-6b08-4643-8485-1439b9fae430",
                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                "text": "Visiblement, son ex-mari avait laissé ses livres en partant."
                            },
                            {
                                "example_id": "6086e63f-8a5d-4c7e-879e-851412234373",
                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                "text": "Son visage portait les marques de la plus profonde perplexité et, visiblement, il se demandait si Tacherot ne se moquait pas un peu de lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                        "entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                        "glosses": [
                            "Manifestement ; évidemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c17f1c-0761-40c6-88d5-c54c72ad8a24",
                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                "text": "L'étendue visible du monde nous surpasse visiblement,"
                            },
                            {
                                "example_id": "2cb8e9f7-0697-4b86-81ae-92a496ba0038",
                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                "text": "Madame me fit des merveilles d’abord ; mais, quand l’abbé de Chavigny fut entré, mon étoile pâlit visiblement,"
                            },
                            {
                                "example_id": "d8d5cb7b-07a7-418d-9fa0-6b1c0ba9fc7f",
                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                "text": "Depuis ce malheureux moment tout alla visiblement en décadence, et les affaires furent sans retour,"
                            },
                            {
                                "example_id": "3bd47b3a-45d4-4803-9d79-9d0d0ca0684c",
                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                "text": "Puisqu'enfin, quand on aurait multiplié les années au delà de tous les nombres connus, visiblement ce ne sera rien, quand nous serons arrivés au terme fatal,"
                            },
                            {
                                "example_id": "babdaa3a-beef-4db4-b740-ed407067aded",
                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                "text": "Saturne, qui dévore ses enfants, est visiblement le temps qui détruit ses propres ouvrages,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf23470c-700f-4752-8622-3bbbb8f825a8",
                        "source_entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f23ca6b1-c0c8-4958-ae0d-c0b0c1f47a92",
                        "source_entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                        "target_lang_word": "obviously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obviously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "In an obvious or clearly apparent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a2cb00-0ff5-4d12-a65f-dfcc4ec7ebec",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She was in floods of tears and obviously very upset."
                                            },
                                            {
                                                "example_id": "61370174-7462-4f05-97a9-743a3abcb477",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She'd obviously not gone to sleep yet: her eyes were bloodshot with sleepiness."
                                            },
                                            {
                                                "example_id": "1039c7ad-6815-4a9f-b377-98f227539248",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "The plane has obviously been delayed."
                                            },
                                            {
                                                "example_id": "2dfc1c3f-39e0-4137-b412-af9e1da3a71b",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "27eba153-6a8e-4637-94ee-071ae04d77b6",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "Used as a filler word, or to introduce information even when not obvious."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38742759-5d9a-4fa9-825e-818d1b5c53f0",
                                                "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                                "text": "You weren't to know, but I've spoken to, obviously, Jim about this, and ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64099dc1-f783-473f-9c9a-c0d285ae9462",
                        "source_entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                        "target_lang_word": "perceptibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perceptibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48416eb4-cce5-3032-ba92-178e8b715a4b",
                                        "entry_id": "f11ae49f-ea28-36ce-9f36-607c9e2f6b0e",
                                        "glosses": [
                                            "In a perceptible manner; noticeably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f1cd48-7d50-4a2f-b756-27e9e6fb9a64",
                                                "sense_id": "48416eb4-cce5-3032-ba92-178e8b715a4b",
                                                "text": "\"Where'd you get it?\" demanded Limpet, perceptibly livening up for the first time since the curate's entrance."
                                            }
                                        ]
