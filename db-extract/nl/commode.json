                        "sense_id": "e6374b6e-855a-3b89-b584-ab3d7262e03c",
                        "entry_id": "56076196-9793-35c2-a175-334b487958a4",
                        "glosses": [
                            "een kast met veel laatjes op werkhoogte om een baby aan te kleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe32004c-4773-4d0e-b0db-24fa5102b909",
                                "sense_id": "e6374b6e-855a-3b89-b584-ab3d7262e03c",
                                "text": "De commode stond al klaar op de babykamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c525def-d678-449c-9429-e991dfb18350",
                        "source_entry_id": "56076196-9793-35c2-a175-334b487958a4",
                        "source_sense_id": "e6374b6e-855a-3b89-b584-ab3d7262e03c",
                        "source_sense_description": "een kast met veel laatjes op werkhoogte om een baby aan te kleden",
                        "target_lang_word": "Kommode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
