                                        "entry_id": "873d85b0-ad23-3cb1-b1b6-0a405d7a819e",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de euthanasier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
