                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a4a298-d094-476c-947e-d1a71c58dab6",
                                "sense_id": "546df800-1372-33be-bc8f-7ba4aebf554a",
                                "text": "Misschien denk je aan een ronddwarrelend stofje of een stuifmeelkorrel."
                            },
                            {
                                "example_id": "1a3f8589-2df6-4473-aa61-502d3959730d",
                                "sense_id": "546df800-1372-33be-bc8f-7ba4aebf554a",
                                "text": "000 jaar in totaal): de stuifmeelkorrels in de bodem vertellen iets over de voormalige vegetatie en dus ook over het klimaat dat er sinds de ijstijd in Nederland heerste."
                            },
                            {
                                "example_id": "84151e4d-ff5c-46ac-a3fe-cc7bbb853fd5",
                                "sense_id": "546df800-1372-33be-bc8f-7ba4aebf554a",
                                "text": "Deze stuifmeelkorrels haalden ze uit dezelfde grondlagen als de zaden van de waterplant in 2021, zodat ze de metingen direct konden vergelijken. De leeftijd van het stuifmeel kwam steeds overeen met de leeftijd die ze in 2021 bepaald hadden voor het zaadje van de waterplant."
                            }
                        ]
                    }
