                    {
                        "translation_id": "8a1bb19a-4703-4367-9750-f0c35d168310",
                        "source_entry_id": "72b135fc-14fc-342e-b817-b2fdb715fef6",
                        "source_sense_id": "209c21d2-8553-3b0f-8f4c-6fc1681edaff",
