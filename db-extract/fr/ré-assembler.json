                "senses": [
                    {
                        "sense_id": "5e38992b-48fc-3ca4-8bcf-d13a06f0893b",
                        "entry_id": "c44ee35a-01aa-392e-ad41-248364d23bb4",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de réassembler (assembler à nouveau, pour reconstituer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8cd281-20f9-40f3-9342-f15434315009",
                                "sense_id": "5e38992b-48fc-3ca4-8bcf-d13a06f0893b",
                                "text": "Il faut la démonter, la laver à la main et la ré-assembler."
                            },
                            {
                                "example_id": "121b0653-305c-4660-add7-69fcd51205eb",
                                "sense_id": "5e38992b-48fc-3ca4-8bcf-d13a06f0893b",
                                "text": "Nous arrivons enfin à une étape relativiste c’est-à-dire celle où l’organisme (la personne) devient habile à se re-former; à ne pas confondre avec se ré-assembler."
                            },
                            {
                                "example_id": "45cce7d7-65b0-429b-9720-daea7833bef0",
                                "sense_id": "5e38992b-48fc-3ca4-8bcf-d13a06f0893b",
                                "text": "Comme si j’avais laissé traîner des morceaux de moi-même, et que je devais me ré-assembler, comme un puzzle, le tableau du bœuf, découpé sur le mur du boucher, une poupée en carton, dont je bouleverse l’ordre, les vêtements, la couleur des cheveux, échappant ainsi au modèle, au dos de la boîte, des mains qui écrivent et me conduisent à Bruxelles, mes pieds de chat botté qui survolent l’Ebre et le Tibre, un œil au Prado, l’autre à Tolède."
                            }
                        ]
                    }
                ],
