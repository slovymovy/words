                                        "sense_id": "1e5d518f-0855-3f51-9589-f35843ab79ce",
                                        "entry_id": "bed7bd39-4f8c-3b20-b6cc-00c59300f07b",
                                        "glosses": [
                                            "krótkie omówienie szerszej treści"
                                        ],
                                        "tags": [],
                                        "examples": [
