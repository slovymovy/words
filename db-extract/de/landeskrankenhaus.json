                "senses": [
                    {
                        "sense_id": "45bd9b08-fdf4-3474-81fa-bedaa621b607",
                        "entry_id": "c7d3b871-5ad5-3a1d-9afd-ecbf15fee02c",
                        "glosses": [
                            "öffentlich-rechtliches Krankenhaus, dessen Träger ein Bundesland ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302108db-8c41-4a62-a1e4-4fe382b001c1",
                                "sense_id": "45bd9b08-fdf4-3474-81fa-bedaa621b607",
                                "text": "„Der einzige Überlebende habe bisher aber noch nicht befragt werden können, teilte die Polizeit. Der 75-Jährige sei nicht mehr in Lebensgefahr, aber in kritischem Zustand im Salzburger Landeskrankenhaus.“"
                            },
                            {
                                "example_id": "6c412e07-72a4-4136-903f-8c3ac0360aad",
                                "sense_id": "45bd9b08-fdf4-3474-81fa-bedaa621b607",
                                "text": "„Die menschenunwürdigen Verhältnisse an den ehemaligen Landeskrankenhäusern, die eher Asylen als Kliniken glichen, sind längst verschwunden.“"
                            },
                            {
                                "example_id": "701be923-fb85-4a6e-8e32-b7108e32c4d5",
                                "sense_id": "45bd9b08-fdf4-3474-81fa-bedaa621b607",
                                "text": "„Weiters liegt vor ein Antrag der Abg. Stöffler, Dr. Pittermann, Dr. Kaan, Hegenbarth, Dr. Allitsch, betreffend Einsetzung eines Untersuchungsausschusses zum Gegenstande: Unterschlagungen im Landeskrankenhause Graz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
