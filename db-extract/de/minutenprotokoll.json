                        "glosses": [
                            "in sehr kurzen Zeitabschnitten (minütlich) geführtes Protokoll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c404e1-ce66-41be-b8d3-c745ed8e8a8b",
                                "sense_id": "773d5dc0-64ec-35d3-9da8-9a2b80550ff7",
                                "text": "„Lesen Sie hier die Ereignisse des Tages im Minutenprotokoll nach.“"
