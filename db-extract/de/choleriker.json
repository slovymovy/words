                    {
                        "sense_id": "a69c5e39-3b88-30e8-a4c9-cb67507c968c",
                        "entry_id": "d7392cd5-35d4-3ca6-aa11-eab222374edc",
                        "glosses": [
                            "eine (männliche,) leicht reizbare, aufbrausende und unbeherrschte Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c151d3e-da76-4a7c-8acd-5c456ecac7ee",
                                "sense_id": "a69c5e39-3b88-30e8-a4c9-cb67507c968c",
                                "text": "Dieser unverbesserliche Choleriker muss immer und überall Streit anfangen."
                            },
                            {
                                "example_id": "fda8d8da-b7df-4fe7-bd69-342543b0d7aa",
                                "sense_id": "a69c5e39-3b88-30e8-a4c9-cb67507c968c",
                                "text": "„Der Choleriker war der Leiter der Redaktion, und der Zyniker sein Stellvertreter.“"
                            },
                            {
                                "example_id": "9ab1c3cb-fe8a-4cb9-afb5-789adc2d94d5",
                                "sense_id": "a69c5e39-3b88-30e8-a4c9-cb67507c968c",
                                "text": "„Der Choleriker Sade fällt in zwei Stücke auseinander, die wir nicht zu einem Ganzen zusammenfassen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
