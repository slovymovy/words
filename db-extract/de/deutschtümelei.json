                ],
                "senses": [
                    {
                        "sense_id": "c05b5a1d-1e02-3c64-85dc-ba8f0e970f8c",
                        "entry_id": "e799ffbd-c06c-38cc-979e-76dba78827c4",
                        "glosses": [
                            "übertriebene Wertschätzung/Betonung all dessen, was als deutsch angesehen wird"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c62862fb-29ba-4d6a-b84d-aaa2467b1a95",
                                "sense_id": "c05b5a1d-1e02-3c64-85dc-ba8f0e970f8c",
                                "text": "„Man wird schnell als Ewiggestriger belächelt und der Deutschtümelei bezichtigt, wenn man heute den Verfall der deutschen Sprache beklagt.“"
                            },
                            {
                                "example_id": "c74d1a30-6cae-47c8-8dec-27ca3f17e8bc",
                                "sense_id": "c05b5a1d-1e02-3c64-85dc-ba8f0e970f8c",
                                "text": "„Abgesehen von den Auswüchsen einer allzu gefühlsseligen oder gar chauvinistischen Deutschtümelei, wie sie sich besonders um die Jahrhundertwende und dann während des Faschismus breitmachte, ist das Zurückgreifen auf gute alte Wörter zur Bereicherung des Wortbestandes sehr zu begrüßen.“"
                            },
                            {
                                "example_id": "bb3d0220-f2e6-4a66-9ca9-9e1e495a76da",
                                "sense_id": "c05b5a1d-1e02-3c64-85dc-ba8f0e970f8c",
                                "text": "„Die Gründe dafür liegen in der Natur des Buches, nicht in Deutschtümelei oder revanchistischer Phantasie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
