                    {
                        "sense_id": "9e08c3bd-c481-325c-92f2-39413b4d331a",
                        "entry_id": "f638f8a3-aaa9-321e-9943-07ba80fe74a8",
                        "glosses": [
                            "For which no solution has been found."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28d3c14-201b-4590-8992-6dde7ca0dc73",
                                "sense_id": "9e08c3bd-c481-325c-92f2-39413b4d331a",
                                "text": "If the Chairman has been convinced of all this why is the matter still unresolved?"
                            },
                            {
                                "example_id": "bad16ae2-2259-4465-8de9-6eef97a9726f",
                                "sense_id": "9e08c3bd-c481-325c-92f2-39413b4d331a",
                                "text": "Ultimately, Furst suggests that each generation is condemned to live out its parents’ unresolved stories, over and over, fuguelike."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1946f2c-de40-3863-b5f8-9e40049981ff",
                        "entry_id": "f638f8a3-aaa9-321e-9943-07ba80fe74a8",
                        "glosses": [
                            "Not yet processed or resolved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4a9174-1503-4299-b5e6-6fe6004b3df2",
                                "sense_id": "c1946f2c-de40-3863-b5f8-9e40049981ff",
                                "text": "unresolved trauma"
                            },
                            {
                                "example_id": "02ed9abe-7618-4ae6-aab9-b3349d4c8ead",
                                "sense_id": "c1946f2c-de40-3863-b5f8-9e40049981ff",
                                "text": "The psychotherapist encouraged patients to describe their unresolved emotional problems."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf2c3f80-0ca9-3ed2-ae5c-08b423447303",
                        "entry_id": "f638f8a3-aaa9-321e-9943-07ba80fe74a8",
                        "glosses": [
