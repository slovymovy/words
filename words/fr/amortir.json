    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b977fb0-f5f9-34f1-85ef-b04a6f8f0060",
                    "sense_definition": "Atténuer la force ou la violence d'un choc, d'un coup ou d'une chute.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuer_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matelas épais a permis d'<w>amortir</w> sa lourde chute."
                        },
                        {
                            "text": "Cette nouvelle semelle en mousse sert à <w>amortir</w> le choc à chaque foulée."
                        }
                    ],
                    "synonyms": [
                        "atténuer",
                        "absorber",
                        "adoucir"
                    ],
                    "antonyms": [
                        "accentuer",
                        "intensifier"
                    ],
                    "common_phrases": [
                        "amortir le choc",
                        "amortir une chute"
                    ]
                },
                {
                    "sense_id": "46c6fb52-276c-30db-8e36-cc11562e19fe",
                    "sense_definition": "Assourdir un bruit ou diminuer l'intensité d'une sensation auditive ou visuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuer_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les rideaux épais permettent d'<w>amortir</w> le bruit de la circulation."
                        },
                        {
                            "text": "La neige fraîche <w>amortit</w> tous les sons de la forêt."
                        }
                    ],
                    "synonyms": [
                        "assourdir",
                        "étouffer",
                        "atténuer"
                    ],
                    "antonyms": [
                        "amplifier"
                    ],
                    "common_phrases": [
                        "amortir le bruit",
                        "amortir un son"
                    ]
                },
                {
                    "sense_id": "606ce8fd-c1e0-3237-bdc2-471f8fb37be8",
                    "sense_definition": "Rembourser progressivement une somme empruntée ou rentabiliser une dépense par un usage prolongé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faudra plusieurs années d'utilisation pour <w>amortir</w> cet équipement coûteux."
                        },
                        {
                            "text": "L'entreprise espère <w>amortir</w> un emprunt immobilier sur une durée de quinze ans."
                        }
                    ],
                    "synonyms": [
                        "rembourser",
                        "rentabiliser"
                    ],
                    "common_phrases": [
                        "amortir un coût",
                        "amortir un emprunt",
                        "amortir un investissement"
                    ]
                },
                {
                    "sense_id": "579ce88a-7ac3-3eb3-9111-37f6a8bc6dd5",
                    "sense_definition": "Rendre moins ardent un feu, ou calmer l'intensité d'un sentiment, d'une passion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuer_ardeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pompier a versé du sable pour <w>amortir</w> le foyer menaçant."
                        },
                        {
                            "text": "Les années passées loin de chez lui ont fini par <w>amortir</w> ses ressentiments."
                        }
                    ],
                    "synonyms": [
                        "apaiser",
                        "calmer",
                        "tempérer"
                    ],
                    "antonyms": [
                        "attiser",
                        "enflammer"
                    ],
                    "common_phrases": [
                        "amortir le feu",
                        "amortir une ardeur"
                    ]
                },
                {
                    "sense_id": "62b51d3c-d619-362c-bf4e-0708b42507a7",
                    "sense_definition": "Constater dans la comptabilité la perte de valeur d'une immobilisation due au temps ou à l'usure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable propose d'<w>amortir</w> le parc informatique sur une période de trois ans."
                        },
                        {
                            "text": "La société doit légalement <w>amortir</w> ses nouveaux véhicules professionnels."
