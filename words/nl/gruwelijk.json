                    "frequency": "Middle",
                    "semantic_group_id": "afschuwelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het hele dorpje was diep geschokt door een <w>gruwelijke</w> moord in het bos.",
                            "target_lang_translations": {
                                "en": "The whole village was deeply shocked by a <w>gruesome</w> murder in the forest."
                            }
                        },
                        {
                            "text": "De getuigen vertelden over de <w>gruwelijke</w> details van het ongeluk op de snelweg.",
                            "target_lang_translations": {
                                "en": "The witnesses spoke about the <w>horrible</w> details of the accident on the highway."
                            }
                        }
                    ],
