                "senses": [
                    {
                        "sense_id": "e313de06-fa3b-394b-bf8c-1bb9f59e256c",
                        "entry_id": "f0cbe611-b340-3435-826d-b82246fbfea1",
                        "glosses": [
                            "het onbewust graag op een bepaalde manier gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "100f9867-f477-4733-b77b-c007b5f1e198",
                                "sense_id": "e313de06-fa3b-394b-bf8c-1bb9f59e256c",
                                "text": "Hij heeft soms de neiging om weg te dromen."
                            },
                            {
                                "example_id": "dc520e04-e0fa-4172-8a4e-58c56e0f194f",
                                "sense_id": "e313de06-fa3b-394b-bf8c-1bb9f59e256c",
                                "text": "Ik heb zelf de neiging om voor het andere te kiezen."
                            },
                            {
                                "example_id": "fa6b396b-ebac-4121-86e5-9c6f878fd3ce",
                                "sense_id": "e313de06-fa3b-394b-bf8c-1bb9f59e256c",
                                "text": "Ze greep de reling vast, vechtend tegen de neiging om te springen, zich in het kolkende water te laten vallen."
                            },
                            {
                                "example_id": "03b16eec-2b58-4ab7-8bce-26e18e440501",
                                "sense_id": "e313de06-fa3b-394b-bf8c-1bb9f59e256c",
                                "text": "Ik heb de neiging om haar hand te pakken en mijn hoofd op haar schouder te leggen."
                            }
                        ]
                    }
                ],
