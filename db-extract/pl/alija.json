                                "target_senses": [
                                    {
                                        "sense_id": "1176dee6-c0d2-34d9-a55a-e35a10488930",
                                        "entry_id": "321ecafa-0bec-3021-aa7e-6283e6bffb1c",
                                        "glosses": [
                                            "To make aliyah, to immigrate to Israel."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e66fb53-69a5-4a42-a997-2067833b25db",
                                                "sense_id": "1176dee6-c0d2-34d9-a55a-e35a10488930",
                                                "text": "Anti-Semitism is a method of fooling Jews into aliyahing to Israel, the homeland, the sanctuary, in the pretence they will be safe. In the last 50 years how many Jews have died in Israel as a result of anti Jewish attacks....and how many have died in the diaspora?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
