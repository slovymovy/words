                "senses": [
                    {
                        "sense_id": "d67efbed-b3f2-35f0-b462-4278ae75e029",
                        "entry_id": "92e0b2fa-af5c-36d8-a502-f84ed9c09104",
                        "glosses": [
                            "älteste, bedeutendste Moschee eines Bezirks, einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "275ea8e2-e51b-443f-ac03-d91a631cf32b",
                                "sense_id": "d67efbed-b3f2-35f0-b462-4278ae75e029",
                                "text": "„Wir passierten die Hauptmoschee, wo sich bereits eine Menschenmenge zum Gebet versammelte, und betraten den Schrein direkt daneben.“"
                            },
                            {
                                "example_id": "1d60601e-6c92-4b4b-aa58-2e842224dc4a",
                                "sense_id": "d67efbed-b3f2-35f0-b462-4278ae75e029",
                                "text": "„Am Anfang der Bewegung ging er gern unter Leute, wenn er seine Freitagsgebete in der Hauptmoschee in Kandahar abgehalten hatte, doch im Laufe der Zeit zog er sich immer mehr zurück und verließ seine Regierungsvilla immer seltener.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
