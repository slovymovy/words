                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prévoyant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5d214dd-1f36-3ce9-9981-361e8dd21c71",
                                        "entry_id": "37145fc2-f47d-3123-aeb5-6602f7e5dc8d",
                                        "glosses": [
                                            "Qui juge par avance qu'une chose devrait arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edaeb12c-45f6-4bed-a699-6b288cae0cd6",
                                                "sense_id": "a5d214dd-1f36-3ce9-9981-361e8dd21c71",
                                                "text": "Les prévoyantes paroles de son père retentissaient derechef à son oreille, et sa conscience lui reprochait d’en avoir méconnu la sagesse."
                                            },
                                            {
                                                "example_id": "3a2a78a0-02c7-4227-a5d3-1102768506f2",
                                                "sense_id": "a5d214dd-1f36-3ce9-9981-361e8dd21c71",
                                                "text": "Moraliste prévoyant, il expulsa les jésuites du Danemark ; savant éclairé, il fut, comme son père Frédéric II, le protecteur de Ticho-Brahé, l’illustre astronome à qui l’on doit la découverte de la planète Mercure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a883e4-da91-3d57-9fd8-f3ea5effb7b7",
                                        "entry_id": "37145fc2-f47d-3123-aeb5-6602f7e5dc8d",
                                        "glosses": [
                                            "Qui s’assure à l’avance des conséquences de ce qui va ou ce qui peut arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33fbfec5-0ecf-42ca-b6a6-25c26d89e4b7",
                                                "sense_id": "b4a883e4-da91-3d57-9fd8-f3ea5effb7b7",
                                                "text": "Tu as pensé aux serviettes ! Tu as été prévoyant."
                                            }
                                        ]
                                    }
                                ]
