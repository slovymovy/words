                        "examples": [
                            {
                                "example_id": "8835da85-5277-40a1-b331-66b9bdbeb9e6",
                                "sense_id": "8d29394f-cf23-320d-bc1a-b827521fd9b7",
                                "text": "Przez rynek kroczy z zawiniątkiem w ręku rewirowy Oczumiełow w nowym płaszczu. Tuż za nim – rudy stójkowy z rzeszotem pełnym skonfiskowanego agrestu."
                            }
