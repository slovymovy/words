        "fr-extract.jsonl": [
            {
                "entry_id": "34f78130-0ff4-37d8-b939-e98cb7035afa",
                "word": "contouring",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "58079b9f-504e-3f7b-b578-6c85f7343914",
                        "entry_id": "34f78130-0ff4-37d8-b939-e98cb7035afa",
                        "glosses": [
                            "Technique de maquillage assombrissant ou éclaircissant des parties du visage pour prononcer ou diminuer ses traits"
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1db2ede3-4d38-439c-b286-6b7400ad0c6d",
                                "sense_id": "58079b9f-504e-3f7b-b578-6c85f7343914",
                                "text": "La méthode façon henné n’est pas la seule interprétation créative du contouring classique."
                            },
                            {
                                "example_id": "07676d47-f10d-4958-879d-c2c18b561a3a",
                                "sense_id": "58079b9f-504e-3f7b-b578-6c85f7343914",
                                "text": "On peut jaser sur une éventuelle opération chirurgicale du nez, une modification de l’implantation de ses cheveux au niveau du front, un lissage parfait de sa tignasse, l’abus des filtres sur les photos ou la magie du contouring (technique de maquillage)."
                            },
                            {
                                "example_id": "6176b25b-a801-4312-bf27-44630dbd3137",
                                "sense_id": "58079b9f-504e-3f7b-b578-6c85f7343914",
                                "text": "Si on est complexée par son nez trop plat, son visage trop rond ou son front trop court, le contouring aide à mettre en valeur nos atouts pour mieux cacher nos défauts."
                            }
                        ]
                    }
                ],
