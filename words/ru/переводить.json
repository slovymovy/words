                {
                    "sense_id": "5268d131-0197-37c8-a39c-f93d363057f8",
                    "sense_definition": "Передавать смысл текста или речи с одного языка на другой.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "language_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я люблю <переводить> песни с английского языка на русский.",
                            "target_lang_translations": {
                                "en": "I love <w>translating</w> songs from English into Russian.",
                                "es": "Me encanta <w>traducir</w> canciones del inglés al ruso.",
                                "fr": "J'aime <w>traduire</w> des chansons de l'anglais vers le russe."
                            }
                        },
                        {
                            "text": "Учитель попросил нас <переводить> текст без использования словаря.",
                            "target_lang_translations": {
                                "en": "The teacher asked us to <w>translate</w> the text without using a dictionary.",
                                "es": "El profesor nos pidió <w>traducir</w> el texto sin usar el diccionario.",
                                "fr": "Le professeur nous a demandé de <w>traduire</w> le texte sans utiliser de dictionnaire."
