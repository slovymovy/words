                "senses": [
                    {
                        "sense_id": "009715f7-ede6-3e5b-85ca-be9901ec1fe2",
                        "entry_id": "c78612ca-c8e8-37ab-8ed9-4346aeabe6db",
                        "glosses": [
                            "Lebewesen, das auf der Oberfläche eines anderen (Basibiont) oder etwas anderem lebt; Organismus, der mit einem andersartigen Organismus (oder Objekt) in einer Epibiose lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df9ec6fb-4429-4c23-b7e0-bfd040255107",
                                "sense_id": "009715f7-ede6-3e5b-85ca-be9901ec1fe2",
                                "text": "Diese Pilze leben als Epibionten und Endophyten auf mehr als 600 Pflanzenarten der Familien Süßgräser, Binsengewächse und Sauergrasgewächse."
                            },
                            {
                                "example_id": "236aa045-93fc-45e2-bc83-8887f5d500fd",
                                "sense_id": "009715f7-ede6-3e5b-85ca-be9901ec1fe2",
                                "text": "Diese [chemoautotrophen sulfidabbauenden Bakterien] bedecken als Epibionten die gesamte Oberfläche der Kolonien von Zoothamnium niveum."
                            },
                            {
                                "example_id": "a4bfd8bf-0db7-4133-97a7-648bdc3c498e",
                                "sense_id": "009715f7-ede6-3e5b-85ca-be9901ec1fe2",
                                "text": "Als Larve besiedelt der Epibiont, z.B. die Auster, das geeignete Substrat, heftet sich mit der flachen rechten Klappe fest und formt im Laufe des Wachstums die Oberfläche des Substrates oft bis in alle Einzelheiten und mit hoher Wiedergabetreue in der Negativform, gleichsam als Abdruck, nach."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
