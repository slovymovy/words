                    {
                        "sense_id": "1d83fe6a-20e9-3078-a914-3464c3ca67f8",
                        "entry_id": "e312870c-81f1-36a6-bdbc-2fc824d2cfd7",
                        "glosses": [
                            "eine Person, die nach dem morgendlichen Aufstehen nur schwer in den Tag findet und dabei oft schlecht gelaunt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe2e5ad-8965-4139-969e-eeb1ed3eaba7",
                                "sense_id": "1d83fe6a-20e9-3078-a914-3464c3ca67f8",
                                "text": "Ich wusste gar nicht, dass du ein solcher Morgenmuffel bist."
                            },
                            {
                                "example_id": "c2fb4dd4-6370-41f1-b89c-6788733f43a2",
                                "sense_id": "1d83fe6a-20e9-3078-a914-3464c3ca67f8",
                                "text": "„Sie war schon immer eher ein Morgenmuffel gewesen, und nach der anstrengenden Nacht fühlte sich ihr Körper immer noch taub an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
