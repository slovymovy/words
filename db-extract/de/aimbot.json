                        "examples": [
                            {
                                "example_id": "d47723ea-bcf2-485a-9c30-7b765c3f1ead",
                                "sense_id": "c585e9af-ff50-35ed-a028-57b90625f71b",
                                "text": "In den meisten Fällen ist der Aimbot so programmiert, dass er auf den Kopf zielt, also automatisch Kopfschüsse (Headshots) verteilt."
                            },
                            {
                                "example_id": "2e69714a-c7d4-439f-b513-42340b61c41f",
                                "sense_id": "c585e9af-ff50-35ed-a028-57b90625f71b",
                                "text": "Im Shooter wären dies etwa Aimbots, die für den Spieler zielen und im richtigen Moment die Waffe abfeuern, oder aber Wallhacks, die dafür sorgen, dass man durch Wände gucken kann."
                            }
                        ]
                    }
