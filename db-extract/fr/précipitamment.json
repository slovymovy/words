        "fr-extract.jsonl": [
            {
                "entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
                "word": "précipitamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                        "entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
                        "glosses": [
                            "Avec précipitation ; à la hâte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d85616-be44-474a-bf85-1bba1a9044a2",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "L’invasion de la Belgique et du nord de la France par les Allemands disperse la famille Mermoz. Les grands-parents maternels de Jean choisissent la prudence et quittent précipitamment Mainbressy pour se réfugier à Aurillac, […]."
                            },
                            {
                                "example_id": "52c14063-fd3e-4800-bb76-be656138ea14",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "Un mourant qui comptait plus de cent ans de vie, Se plaignait à la mort que précipitamment Elle le contraignait de partir tout à l’heure,"
                            },
                            {
                                "example_id": "88018eda-de8a-41b2-8edb-0a818e4e107f",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "Cette impatience téméraire de la plupart des jeunes gens qui se dispensent de l’ordre du temps et de la raison, pour monter précipitamment aux premiers tribunaux du royaume,"
                            },
                            {
                                "example_id": "2388cdb0-e120-41ca-b169-a30546fc1d74",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "Les Étoliens se réfugièrent précipitamment dans la citadelle,"
                            },
                            {
                                "example_id": "0b7c2344-e425-4365-8ae0-479fa9c8b493",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "Ô que ceux qui jugent si précipitamment les enfants sont sujets à se tromper ! ils sont souvent plus enfants qu’eux,"
                            },
                            {
                                "example_id": "9c6ce450-a79b-418d-8d3b-2c0335c20a5c",
                                "sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                                "text": "Les passagers embarquaient escortés d’une foule d’amis, affluaient sur le pont éclairé par la pâle clarté de la lune et s’engouffraient précipitamment dans les profondeurs du navire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3bdbefb-0b1d-46cb-ac55-df8e5facbf63",
                        "source_entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
                        "source_sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                        "target_lang_word": "precipitously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precipitously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4753c82-d256-39ef-9815-ca127c97589a",
                                        "entry_id": "e2c65a96-4cb9-3585-b6fd-201e11ef177e",
                                        "glosses": [
                                            "In a precipitous manner.",
                                            "Abruptly; quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12977539-b014-4ac3-be94-97f79f711e24",
                                                "sense_id": "f4753c82-d256-39ef-9815-ca127c97589a",
                                                "text": "Population dropped to the lowest point in five millennia. State resources declined precipitously. In many strategic and formerly prosperous areas, there were tax revenue losses of 90 percent or more in less than a single lifetime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                                        "entry_id": "e2c65a96-4cb9-3585-b6fd-201e11ef177e",
                                        "glosses": [
                                            "In a precipitous manner.",
                                            "At a sharp upwards angle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98542cf8-fb92-47e2-ab7c-832de8a666c5",
                                                "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                                                "text": "Never will I visit it again; it is a place of evil omen.' After a very brief halt for breakfast we pressed on with such good will that by two o'clock in the afternoon we were at the foot of the vast wall of rock that formed the lip of the volcano, and which at this point towered up precipitously above us for fifteen hundred or two thousand feet."
                                            },
                                            {
                                                "example_id": "c09a386a-113b-49fa-87ab-0cb130c41d85",
                                                "sense_id": "c9291605-f382-34ba-84e8-08fe236a6d48",
                                                "text": "On all sides, wild mountains rise precipitously above wooded nullahs, and we have a clear view, to the right, of the famous Amah Rock, with its singular resemblance to a Chinese woman carrying her baby on her back in the traditional fashion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79a310cc-85b5-41a4-9ec6-3f710b6b7376",
                        "source_entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
                        "source_sense_id": "6b864675-f632-3829-8093-1b7c357a7300",
                        "target_lang_word": "hastily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hastily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db1c7dab-9d93-3be4-8ace-c3770ae32762",
                                        "entry_id": "9a743cdd-1b40-3322-94be-566372b790ea",
                                        "glosses": [
                                            "In a hasty manner; quickly or hurriedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46eaceea-523e-4a0c-985a-dff394daa9b9",
                                                "sense_id": "db1c7dab-9d93-3be4-8ace-c3770ae32762",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            },
                                            {
                                                "example_id": "99579e44-1e6f-4eb4-8591-88253bb90475",
                                                "sense_id": "db1c7dab-9d93-3be4-8ace-c3770ae32762",
                                                "text": "The last occasion on which the Kaiser [Wilhelm II] used this train was for an inglorious journey into Holland towards the end of the 1914 war. He spent the night in it at Eysden [Eijsden], while the Queen of the Netherlands and a hastily summoned Cabinet debated what to do with him."
                                            },
                                            {
                                                "example_id": "956737a4-882c-4062-b3e1-0d597a61d10d",
                                                "sense_id": "db1c7dab-9d93-3be4-8ace-c3770ae32762",
                                                "text": "Eudemis moved hastily but as unobtrusively as he could through the gaping crowd[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f844bc29-3eee-367c-ba37-0c294f793050",
                                        "entry_id": "9a743cdd-1b40-3322-94be-566372b790ea",
                                        "glosses": [
                                            "Soon, shortly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0256fa2c-def6-4f68-a5ef-0c231fd06937",
                                                "sense_id": "f844bc29-3eee-367c-ba37-0c294f793050",
                                                "text": "she with liquors strong his eyes did steepe, / That nothing should him hastily awake [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8f4deca-1b7e-4d2f-b5b3-b54d61f48429",
                        "source_entry_id": "b3913b7a-f61d-3564-b753-e0243001780c",
