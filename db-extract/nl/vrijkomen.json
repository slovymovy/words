                            {
                                "example_id": "3e34ee2b-12c9-4f5d-85e1-b84f138f19a1",
                                "sense_id": "a7a40b8a-54c7-359b-bd25-4d94383813ca",
                                "text": "Na 20 jaar zitten kwam de moordenaar weer vrij.",
                                "translation": "After 20 years in prison, the murderer was released.",
                                "english": "After 20 years in prison, the murderer was released."
                            }
                        ]
