                "senses": [
                    {
                        "sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
                        "entry_id": "b878c9d2-18fe-388d-bf45-2fb7c0ffc20a",
                        "glosses": [
                            "overmoedig, zonder zorg over de gevolgen of het gevaar van een handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afeb0d83-a24f-4ab1-b448-3e9c5ae767cb",
                                "sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
                                "text": "Geschepte fietsster gewond op voorruit roekeloze automobilist: Een 19-jarige fietster is vrijdag geschept door een auto in de Langestraat in Hengelo, waarna ze op de motorkap van de auto belandde en met haar hoofd tegen de voorruit knalde. Ze is gewond naar het ziekenhuis gebracht. De bestuurder is zijn rijbewijs kwijt omdat hij gevaarlijk reed."
                            },
                            {
                                "example_id": "e789cc83-4add-4602-8672-5e3510d5de29",
                                "sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
                                "text": "Wees toch niet zo roekeloos!"
                            },
                            {
                                "example_id": "3627cfde-7b94-465c-87b4-a2ee0c96a510",
                                "sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
                                "text": "Na de ochtendvergadering van acht uur trokken Eric, Ariadne en de laatst aangesloten partner Jens Ehrenberg zich een halve dag terug om het offensief te gaan plannen tegen éer, roem en de zege van de rechtvaardigheid', zoals ze het, misschien wat roekeloos, al waren begonnen te noemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7bd3fd5-a88b-44bb-894e-e1ab929ba0d5",
                        "source_entry_id": "b878c9d2-18fe-388d-bf45-2fb7c0ffc20a",
                        "source_sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
                        "source_sense_description": "zonder zorg over de gevolgen of het gevaar van een handeling",
                        "target_lang_word": "tollkühn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tollkühn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28db2a9e-d304-382c-b4ad-ef66889c3817",
                                        "entry_id": "13df1943-410d-30bf-8d96-3a3bf2ad6014",
                                        "glosses": [
                                            "Charaktereigenschaft eines Menschen: äußerst wagnisbereite und risikofreudige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08459a18-3b9d-4670-9987-cb4fb1fbf131",
                                                "sense_id": "28db2a9e-d304-382c-b4ad-ef66889c3817",
                                                "text": "„Die sechsjährige Romy klettert, wie es ihre Art ist, wieder einmal tollkühn auf einen Baum, unter ihr das Wasser.“"
                                            },
                                            {
                                                "example_id": "56e0cb63-c102-4f2e-9276-018a04dcf598",
                                                "sense_id": "28db2a9e-d304-382c-b4ad-ef66889c3817",
                                                "text": "„Waghalsigkeit […] ist in unserer sicherheitsorientierten Zeit als Vabanque-Spiel verpönt; sie trägt den Makel tollkühnen, d.h. verrückt-verantwortungslosen Handelns und findet sich nicht selten in den Mutproben Jugendlicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1e7e18a-984a-3a4e-9046-1e70af1eda57",
                                        "entry_id": "13df1943-410d-30bf-8d96-3a3bf2ad6014",
                                        "glosses": [
                                            "Charakteristikum einer Sache: waghalsige Unternehmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb81d09-fb7a-474d-90de-448b34fddf73",
                                                "sense_id": "e1e7e18a-984a-3a4e-9046-1e70af1eda57",
                                                "text": "„Aller Kleinmut war fortgeweht, jetzt hatte keiner jemals am glücklichen Erfolg der tollkühnen Reise gezweifelt.“"
                                            },
                                            {
                                                "example_id": "5c68e7d5-7eda-4b8e-98a3-005f29c0383e",
                                                "sense_id": "e1e7e18a-984a-3a4e-9046-1e70af1eda57",
                                                "text": "„Für diesen tollkühnen Auftrag suchte Hitler einen österreichischen Landsmann aus, den SS-Hauptsturmführer Otto Skorzeny, einen über zwei Meter großen Wiener, nicht nur seiner Länge wegen eine imposante Erscheinung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "336a1fdf-6193-4fd0-9b42-349bbb5ecb9a",
                        "source_entry_id": "b878c9d2-18fe-388d-bf45-2fb7c0ffc20a",
                        "source_sense_id": "5fb2f297-f339-3361-8cdd-9221a1c59565",
