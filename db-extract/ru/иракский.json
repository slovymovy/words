                ],
                "senses": [
                    {
                        "sense_id": "7b35b5ee-c1cf-354c-af28-cebd740274f0",
                        "entry_id": "bf0d1378-3e78-340c-983d-8b6ff9c8b226",
                        "glosses": [
                            "относящийся к Ираку или иракцам"
                        ],
                        "tags": [],
