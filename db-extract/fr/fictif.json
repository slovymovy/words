                    {
                        "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                        "entry_id": "d1406d55-61a5-3119-b2b9-8d0123c78cfc",
                        "glosses": [
                            "Qui n'existe que par imagination, qui est irréel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0caee0-00d2-4e98-be59-aca3dddd862f",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Des êtres fictifs."
                            },
                            {
                                "example_id": "ed2ede4c-3272-4db5-99fd-a280f7113a78",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Valeur fictive."
                            },
                            {
                                "example_id": "9af3227e-ca02-40b9-893d-d8519f97662e",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Une monnaie fictive."
                            },
                            {
                                "example_id": "2bb39c0e-70a2-43c4-a9c9-a9bdee1a7f8d",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Titre fictif."
                            },
                            {
                                "example_id": "901bbb18-3935-4688-854c-039bc0270ac4",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Propriété fictive."
                            },
                            {
                                "example_id": "21a9032d-32dc-4ce1-8bc5-cd8132cf0d34",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Une histoire fictive."
                            },
                            {
                                "example_id": "3d287768-8f66-4fc5-9870-7e65b2bed538",
                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                "text": "Et sais-tu ce qu’il m’a proposé ? Une vente fictive de toute sa propriété, de sorte que tu serais en fait son héritier, l’héritier de la petite…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa45d342-697f-4300-94ee-a0e6b55ba1f2",
                        "source_entry_id": "d1406d55-61a5-3119-b2b9-8d0123c78cfc",
                        "source_sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                        "target_lang_word": "fiktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                        "entry_id": "032d3263-2c06-3cb6-a599-02594bfc83b7",
                                        "glosses": [
                                            "auf einer Fiktion, etwas Erdachtem beruhend; konstruiert, erfunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7513a06e-fe56-4aa9-b215-9782f0fcf8c0",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Sie telefonierte mit einem fiktiven Gesprächspartner."
                                            },
                                            {
                                                "example_id": "76d83c65-24ec-47f9-8313-e1dc14ffaf51",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Das ist die fiktive Geschichte eines Präsidentenmörders."
                                            },
                                            {
                                                "example_id": "69faa4db-b110-4d3e-981a-89a8b95b75e7",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Science Fiction beschreibt eine fiktive Welt."
                                            },
                                            {
                                                "example_id": "f9c8bf40-2c1c-4bda-a6e3-86e44ecab44b",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Da es sich dabei nur um eine modelltheoretische Fiktion handelt, werden diese Größen im folgenden als fiktive Größen bezeichnet."
                                            },
                                            {
                                                "example_id": "75cf8ce4-3163-4282-9a93-18086feac34c",
                                                "sense_id": "e12c0a6a-616c-3214-9bee-f4b4934d1d4c",
                                                "text": "Kalkulatorische Kosten sind rein rechnerische, fiktive Kosten, die im Rahmen der Kosten- und Erlösrechnung bei der Ermittlung der Herstellungsbzw. Selbstkosten eines Produkts (Kalkulation) benötigt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81c512c9-1ae1-4f32-905e-756d07a28150",
