                "senses": [
                    {
                        "sense_id": "37540dad-089a-38a7-a25d-b055387ea140",
                        "entry_id": "391ab43e-7f14-3d4a-947d-28ca200705e3",
                        "glosses": [
                            "Hai aus der Familie der Requiemhaie, der eine runde, sehr kurze Schnauze hat und sich sowohl in Süß- als auch in Salzwasser aufhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d45e17-245d-4bb7-afff-92f2ef96ab2a",
                                "sense_id": "37540dad-089a-38a7-a25d-b055387ea140",
                                "text": "„Demnach nahm die Zahl aller untersuchten Hai-Arten seit 1970 um mindestens 50 Prozent ab, jene der Tigerhaie, der Bogenstirn-Hammerhaie und der Bullenhaie sank sogar um mehr als 95 Prozent.“"
                            },
                            {
                                "example_id": "d947995c-0312-45cb-85dd-2885f967e396",
                                "sense_id": "37540dad-089a-38a7-a25d-b055387ea140",
                                "text": "„Tatsächlich fangen Fischer auch in Amazonien immer wieder Haie in ihren Netzen: Bullenhaie, die im Süßwasser überleben und vom Atlantik weit flussaufwärts wandern können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
