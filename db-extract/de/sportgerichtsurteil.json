                                "example_id": "0dbd5b58-9fd3-4f05-84e5-8e11c5013b74",
                                "sense_id": "f7a6bd34-d81b-38e0-bda9-e19cd8043baf",
                                "text": "„Die Absurdität, dass Athleten bislang unterschreiben mussten, nicht gegen Sportgerichtsurteile vorzugehen, wenn sie zu Olympischen Spielen oder Weltmeisterschaften zugelassen werden wollten, ist endgültig passé.“"
                            },
                            {
                                "example_id": "e13fc32c-c424-4509-806f-ab1388a2bd98",
                                "sense_id": "f7a6bd34-d81b-38e0-bda9-e19cd8043baf",
                                "text": "„ Laut einem Sportgerichtsurteil vom Juli wird es nun im kommenden Heimspiel gegen Energie Cottbus mindestens zu einem Teilausschluss kommen.“"
                            }
