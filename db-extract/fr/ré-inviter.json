                ],
                "senses": [
                    {
                        "sense_id": "523b082e-aefd-3eec-a3ad-21c982226d21",
                        "entry_id": "b5e3682a-9caf-38f4-854b-af7d2ab67753",
                        "glosses": [
                            "Inviter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26cfcb2-81d0-4de1-bfb8-da8dd1f24428",
                                "sense_id": "523b082e-aefd-3eec-a3ad-21c982226d21",
                                "text": "Pour se faire, Marie retourne une nouvelle fois aux Etats-Unis, ré-invitée par la journaliste Mrs Meloney."
                            },
                            {
                                "example_id": "5924adf3-9e7e-454c-b247-e95b4651ad05",
                                "sense_id": "523b082e-aefd-3eec-a3ad-21c982226d21",
                                "text": "Malgré notre évidente différence de milieu social, ses parents ont dû me trouver fréquentable, ou peut-être ont-ils été séduits par ma nationalité française, car j’ai ensuite été ré-invitée à plusieurs reprises."
                            },
                            {
                                "example_id": "da07d34e-155c-4059-a751-078db7163ab8",
                                "sense_id": "523b082e-aefd-3eec-a3ad-21c982226d21",
                                "text": "À la chasse, on ne mâche pas les mots : les femmes emm… ne sont pas ré-invitées."
                            }
                        ]
                    }
                ],
