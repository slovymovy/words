                        "sense_id": "14b50366-214f-39b2-b27f-e52eff541771",
                        "entry_id": "4459ec24-8cf5-3bc3-92d4-fb95fe76bdb3",
                        "glosses": [
                            "het op een passieve manier, zonder eigen overweging doen wat een andere zegt dat men moet doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ed255f-def8-42f7-b336-a9ac99fe8ecd",
                                "sense_id": "14b50366-214f-39b2-b27f-e52eff541771",
                                "text": "Maar in al haar lijdelijkheid had zij zich juist volledig aan hem overgegeven."
                            },
                            {
                                "example_id": "471761cd-1b30-440f-b194-434bef336a61",
                                "sense_id": "14b50366-214f-39b2-b27f-e52eff541771",
                                "text": "De meeste notarissen handelden volgens 'het principe van de lijdelijkheid'. Dat maakte ze volgens Schütz tot een robot. Met het \"lijdelijk\" zijn, legden ze de verantwoordelijkheid voor hun handelen bij de partijen die de overeenkomst sloten. Ze hielden zich alleen bezig met het exact vastleggen en bewaren van de transactie."
                            }
                        ]
                    }
