                "senses": [
                    {
                        "sense_id": "6db2d231-226c-3ccc-9358-3ccb55bccefd",
                        "entry_id": "223aad61-121e-385c-b8c3-c1689bd8635a",
                        "glosses": [
                            "As many as fill a list."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dace6977-52ed-4d09-a4fd-9ae606adb9f8",
                                "sense_id": "6db2d231-226c-3ccc-9358-3ccb55bccefd",
                                "text": "Tony had the rest of the day off so he went on to Winslow, for a haircut, parts for a generator, several listsful of groceries and miscellaneous other items."
                            },
                            {
                                "example_id": "cfc666ee-d0d0-40fd-b937-209345c5864a",
                                "sense_id": "6db2d231-226c-3ccc-9358-3ccb55bccefd",
                                "text": "And these loving couples and individuals are waiting by the listful to adopt children regardless of race; children with terminal illnesses, like AIDS; and children with special medical needs, like Downs Syndrome and Spina Bifida."
                            },
                            {
                                "example_id": "3787814c-1554-44c9-9051-112435ebdfbe",
                                "sense_id": "6db2d231-226c-3ccc-9358-3ccb55bccefd",
                                "text": "The Medoc peninsula north of Bordeaux on the left bank of the Gironde river produces a good listful of the world's most famous reds."
                            },
                            {
                                "example_id": "1dc99a99-7350-4bf8-a838-4d3c92468cf0",
                                "sense_id": "6db2d231-226c-3ccc-9358-3ccb55bccefd",
                                "text": "As a rough guess, activities are worth one quarter of a grade point; maybe a half point in truly extraordinary cases. It is better to devote yourself to your studies than to explain your weak grade-point average with a listful of activities."
                            }
                        ]
                    }
