                ],
                "senses": [
                    {
                        "sense_id": "7484426a-5dd0-30b6-b034-2d7991fa4d07",
                        "entry_id": "133bce04-ab81-3b63-96ce-948b3a173acd",
                        "glosses": [
                            "Kunststoffabfall, der Wiederverwendung findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead91d4a-6708-4797-89ba-d9d5e92fb5a4",
                                "sense_id": "7484426a-5dd0-30b6-b034-2d7991fa4d07",
                                "text": "„Altkunststoffe sind bereits mindestens einmal verwendete Kunststoffe.“"
                            },
                            {
                                "example_id": "82caf87c-c606-46ef-96d4-d5ac332dc259",
                                "sense_id": "7484426a-5dd0-30b6-b034-2d7991fa4d07",
                                "text": "„Wir sind Ihr kompetenter und zuverlässiger Partner für die Aufbereitung und den internationalen Handel mit Altkunststoffen.“"
                            },
                            {
                                "example_id": "fcf46397-e58e-4e19-b903-a31495bfd42c",
                                "sense_id": "7484426a-5dd0-30b6-b034-2d7991fa4d07",
                                "text": "„Der nachgeschalteten Kunststoffaufbereitung und der Kunststoffverarbeitung wurden durch die Dualen Systeme enge Grenzen gesetzt; der Export von Altkunststoffen und ihre Verbrennung erhielten in zu vielen Fällen den Vorzug vor einer ökologisch sinnvolleren stofflichen Verwertung.“"
                            },
                            {
                                "example_id": "c83794d2-da50-4b34-b85a-864179816cbe",
                                "sense_id": "7484426a-5dd0-30b6-b034-2d7991fa4d07",
                                "text": "„Die Rewe International AG will ihren Kunststoffverbrauch ab August drastisch verringern: Künftig wird es in allen Standorten von Billa, Merkur und Penny in Österreich ausschließlich Plastik-Tragetaschen aus Altkunststoff geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
