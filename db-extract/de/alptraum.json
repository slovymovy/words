                        "form": "den Alptraum"
                    },
                    {
                        "form_id": "d2207c58-3728-4107-98bf-fc44352dbde3",
                        "entry_id": "884594f6-352b-3b81-95b6-eb586c5c1f6b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Alpträume"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                        "entry_id": "884594f6-352b-3b81-95b6-eb586c5c1f6b",
                        "glosses": [
                            "unangenehmer Traum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841610b5-d5c0-4341-8206-4bb75e9f962e",
                                "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                                "text": "„Sich Leute vorzustellen, die tatsächlich daran glauben, ist ein unendlicher Alptraum.“"
                            },
                            {
                                "example_id": "2a086331-ba42-4d00-b108-47a912c4c79a",
                                "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                                "text": "„Ich hatte häufig Alpträume, in denen ich entweder vor meiner Mutter weglief oder meine schwangere Hand hinter dem Rücken versteckte.“"
                            },
                            {
                                "example_id": "3e636cf2-955b-425c-ac19-39f8dad116b4",
                                "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                                "text": "„Kennedy dagegen wurde von Alpträumen geplagt.“"
                            },
                            {
                                "example_id": "faa46ab7-9378-45a7-ac1a-eb1d3f1df8b0",
                                "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                                "text": "„Zur selben Zeit hatte Laura Leonore einen Alptraum.“"
                            },
                            {
                                "example_id": "7dfb7a8a-b72d-4865-88b9-df8022e99c52",
                                "sense_id": "4f03416f-dabe-3843-839e-aa7efce729f6",
                                "text": "„Doch dann kamen die Schlafstörungen, die Alpträume und andere erschreckende Beschwerden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b902d9a2-7bbe-3f2f-aac4-0b366b33560c",
