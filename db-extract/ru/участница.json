                ],
                "senses": [
                    {
                        "sense_id": "ee14613b-d8b8-35b6-b5ad-1bbe9e0a681d",
                        "entry_id": "660074c1-ba35-397a-b67b-cf18fa014233",
                        "glosses": [
                            "женск. к участник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7d0056-438a-457a-986f-dacb76a44c3d",
                                "sense_id": "ee14613b-d8b8-35b6-b5ad-1bbe9e0a681d",
                                "text": "— А тебя за что отобрали? Ты участница? — Нет."
                            },
                            {
                                "example_id": "0839df2a-71de-4a86-a2c4-fa38ba8173b3",
                                "sense_id": "ee14613b-d8b8-35b6-b5ad-1bbe9e0a681d",
                                "text": "То она актриса воздушного аниме, то участница мираж-шоу, в общем — всё исключительно масштабное, из разряда событий, которые я бы помнила."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be522e7a-78e5-42f6-b745-fc3f25d35d76",
                        "source_entry_id": "660074c1-ba35-397a-b67b-cf18fa014233",
                        "source_sense_id": "ee14613b-d8b8-35b6-b5ad-1bbe9e0a681d",
                        "target_lang_word": "Teilnehmerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilnehmerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b00912f8-75e3-31be-a2d7-b971869c5b66",
                                        "entry_id": "1c6bbd70-2015-3368-b339-a6f6b19f2a09",
                                        "glosses": [
                                            "weibliche Person, die an einem Ereignis oder einer Veranstaltung beteiligt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f3ff2a-d4dc-4a4f-a694-657493e3e29e",
                                                "sense_id": "b00912f8-75e3-31be-a2d7-b971869c5b66",
                                                "text": "Die Teilnehmerinnen an der Tagung müssen einen Tagungsbeitrag leisten."
                                            },
                                            {
                                                "example_id": "a043d1c3-6c88-4a8a-a2cc-885f1519707d",
                                                "sense_id": "b00912f8-75e3-31be-a2d7-b971869c5b66",
                                                "text": "„Sie konnte sich nicht als Teilnehmerin von Unterhaltungen Zurückgebliebener vorstellen.“"
                                            },
                                            {
                                                "example_id": "74536832-020c-483a-9dde-531b448e4dca",
                                                "sense_id": "b00912f8-75e3-31be-a2d7-b971869c5b66",
                                                "text": "„Sie war zu einer enthusiastischen Teilnehmerin geworden und steuerte ihre eigene, definitiv französisch gefärbte Version von Süßkartoffeln bei, die sie mit Butter und dunklem Zucker fast zu einer Mousse aufschlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
