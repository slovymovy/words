                        "glosses": [
                            "onderbreking van een activiteit om een document dat hiervoor van belang is te kunnen lezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92beced7-8d2e-42e2-ba48-5a8647b3bd83",
                                "sense_id": "553ccf53-bb56-334c-b4a9-5913318bfa52",
                                "text": "Omdat het desbetreffende stuk ons pas zojuist is overhandigd stel ik een leespauze in van enkele minuten."
                            }
                        ]
                    },
                    {
                        "sense_id": "10cc4113-e83f-3349-a436-6cd35ee9f826",
                        "entry_id": "e81bb027-9539-32a4-9ea6-6dc764ed3c37",
                        "glosses": [
                            "moment waarop het in zich opnemen van een tekst bij een overgang daarbinnen even stokt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8a1eed-0b77-48d9-ad76-6283de8924e6",
                                "sense_id": "10cc4113-e83f-3349-a436-6cd35ee9f826",
                                "text": "Hiermee bedoel ik zowel de leessnelheid, als ook (en vooral) de factor van de tijdsindeling. Men realiseert die door een leespauze op de plaats van een syntactische grens. Deze rust neemt de lezer in acht bij een punt, komma of een ander leesteken. Uiteraard is het ontbreken van een leespauze in principe even belangrijk voor het tempo (literair interessant is dit bij een fenomeen als het enjambement)."
                            }
                        ]
                    }
