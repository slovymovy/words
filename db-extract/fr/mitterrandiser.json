                "senses": [
                    {
                        "sense_id": "53134e7c-5e49-3542-ae0c-2c6be0f853b9",
                        "entry_id": "853e7ae4-fefd-3dfb-acce-88292e9ac174",
                        "glosses": [
                            "Donner un caractère rappelant François Mitterrand à."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "dc7aea1e-d444-4cbc-9edf-6588e714d50f",
                                "sense_id": "53134e7c-5e49-3542-ae0c-2c6be0f853b9",
                                "text": "Lionel Jospin assure ne pas se « balladuriser » ou se « juppéiser », mais n’est-il pas en train de se « mitterrandiser » ?"
                            },
                            {
                                "example_id": "c6aaae64-f27f-4452-8a91-1c419eb0309c",
                                "sense_id": "53134e7c-5e49-3542-ae0c-2c6be0f853b9",
                                "text": "Mais la patronne du PS n’est-elle pas plutôt en train de se mitterrandiser, avec ce débat sur les 60 ans qui se dogmatise ?"
                            },
                            {
                                "example_id": "069ff25e-a352-4db2-8a03-1a3bce4bab5f",
                                "sense_id": "53134e7c-5e49-3542-ae0c-2c6be0f853b9",
                                "text": "Il serait même, de l’avis de son entourage, en train de se mitterrandiser !"
                            }
                        ]
                    }
