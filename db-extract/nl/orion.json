                                        "sense_id": "117753d7-768c-38f9-84f7-19d80ba13855",
                                        "entry_id": "0ece8b8c-06dd-3738-8831-fb06493af4cb",
                                        "glosses": [
                                            "riesenhafter, gewaltiger Jäger in der griechischen Sage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f193b3e4-278c-4f66-83e9-8923eff70a7c",
                                                "sense_id": "117753d7-768c-38f9-84f7-19d80ba13855",
                                                "text": "Orion hat laut der griechischen Mythologie gleich drei Väter: Poseidon, Zeus und Hermes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Orion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf910063-803f-3553-9711-fe696ad671c1",
                                        "entry_id": "0452253e-335a-300c-bfe8-725989c1ef06",
                                        "glosses": [
                                            "Sternbild auf dem Himmelsäquator, in Mitteleuropa die auffallendste Konstellation am Winterhimmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00748b0c-73e7-4d4b-a4dd-fd3019df6ddb",
                                                "sense_id": "cf910063-803f-3553-9711-fe696ad671c1",
                                                "text": "„Das Haupterkennungsmerkmal des Orion ist aber die auffällige Reihe der Sterne Alnitak, Alnilam und Mintaka (ζ, ε und δ Orionis).“"
                                            },
                                            {
                                                "example_id": "60288845-06df-48e6-984f-b91ee2a06c94",
                                                "sense_id": "cf910063-803f-3553-9711-fe696ad671c1",
                                                "text": "„Im Sternbild Orion können wir auch sehr schön sehen, dass die hellsten Sterne nicht unbedingt jene sind, die uns am nächsten stehen: Der hellste Stern Beteigeuze ist mit 600 Lichtjahren erheblich weiter entfernt als Bellatrix, der dritthellste Stern.“"
                                            },
                                            {
                                                "example_id": "d08b7d29-fcb9-40ca-bd57-2cc09ef9bef9",
                                                "sense_id": "cf910063-803f-3553-9711-fe696ad671c1",
                                                "text": "„Jetzt stand der Orion mit einem Fuß auf der Kimm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
