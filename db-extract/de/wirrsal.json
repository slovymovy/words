                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27894eb4-03d6-4545-8c8e-906d181aeb4f",
                        "source_entry_id": "e2218aae-d508-3f15-9409-8f74c0ed2180",
                        "source_sense_id": "42e990a5-f9d5-343d-91ba-e288036298b9",
                        "source_sense_description": "Situation, die unübersichtlich ist und deshalb eine Orientierung erheblich erschwert",
                        "target_lang_word": "неразбериха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неразбериха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ae97a0-aed8-346b-9323-af3225533b6c",
                                        "entry_id": "5975df5e-c223-3125-854b-1a0fbaa05cea",
                                        "glosses": [
                                            "разг. бессмысленная, никем и ничем не направляемая деятельность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16a6316-9b9e-48ff-900e-fc4caad7c11f",
                                                "sense_id": "b5ae97a0-aed8-346b-9323-af3225533b6c",
                                                "text": "Из газеты, которую ты мне прислала, видно, какая неразбериха у них на Мосфильме ― со всех сторон несутся вопли и громкие слова о выполнении «плана», который они никогда не выполняют."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0660d3a2-7f44-3792-8e54-c585a10d44a8",
                                        "entry_id": "5975df5e-c223-3125-854b-1a0fbaa05cea",
                                        "glosses": [
                                            "разг. запутанная, бестолковая ситуация; состояние неупорядоченности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e9bec2-f50c-47a5-a488-d0b634c21d07",
                                                "sense_id": "0660d3a2-7f44-3792-8e54-c585a10d44a8",
                                                "text": "И действительно, когда дело дошло до финала, в оркестре началась полная неразбериха."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
