                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bebdb4d3-70bd-3a36-8587-b6cf6b5bb23c",
                                        "entry_id": "96fbd566-062a-38bd-b54a-f904c6cc47ce",
                                        "glosses": [
                                            "Qui mange de tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74047d3f-2771-47b9-96e2-98b2b0deb2fe",
                                                "sense_id": "bebdb4d3-70bd-3a36-8587-b6cf6b5bb23c",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "omnivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2540c935-7f2b-3986-9ef0-41f988635a1a",
                                        "entry_id": "a30abd61-1ff7-3120-b696-1db015c9b074",
                                        "glosses": [
                                            "Animal qui mange de tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a31c57-c0d0-4e38-9cb3-4c8ade502068",
                                                "sense_id": "2540c935-7f2b-3986-9ef0-41f988635a1a",
                                                "text": "Un omnivore mange à la fois de l’herbe (fruits et légumes) et de la viande."
                                            },
                                            {
                                                "example_id": "5bffa110-792a-4f3f-8e99-9d0f07f2669b",
                                                "sense_id": "2540c935-7f2b-3986-9ef0-41f988635a1a",
                                                "text": "Victor mange ce qu’il trouve au sol ; Marie-Angélique est une omnivore, grande carnivore, et elle sait imiter les oiseaux, tant pour s’enjouer que pour les piéger et les dévorer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
