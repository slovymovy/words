                },
                {
                    "sense_id": "cb23e43a-a293-375d-84d6-3e94fa3903f9",
                    "sense_definition": "iets wat aan een haak vastzit losmaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "losmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je de aanhanger voorzichtig <w>afhaken</w> van de auto?",
                            "target_lang_translations": {
                                "en": "Can you carefully <w>unhook</w> the trailer from the car?",
                                "fr": "Peux-tu <w>dételer</w> prudemment la remorque de la voiture ?"
                            }
                        },
                        {
                            "text": "Hij probeerde de vis voorzichtig van de hengel te <w>afhaken</w>.",
                            "target_lang_translations": {
                                "en": "He tried to carefully <w>unhook</w> the fish from the rod.",
                                "fr": "Il a essayé de <w>décrocher</w> prudemment le poisson de la ligne."
                            }
                        }
                    ],
                    "synonyms": [
                        "losmaken",
                        "ontkoppelen"
                    ],
                    "antonyms": [
                        "aanhaken"
                    ],
                    "common_phrases": [
                        "de aanhanger afhaken"
                    ],
                    "target_lang_definitions": {
