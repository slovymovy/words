                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ab8ec8d-5fe3-437a-95f3-710d86cdb51c",
                        "source_entry_id": "36c81149-c30b-3d5c-8e87-ec603cf5bd19",
                        "source_sense_description": "чрезмерно",
                        "target_lang_word": "excessivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excessivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Avec excès, à un degré excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1446cec1-285f-4672-a3aa-78348edd0437",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Ma tante n’est plus si excessivement mal."
                                            },
                                            {
                                                "example_id": "fb624ef6-68d2-42e3-b395-b8364a2ec69c",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Puisqu’il en est question, je vous dirai tout net que cette liberté me déplaît excessivement."
                                            },
                                            {
                                                "example_id": "4bcb185d-9f65-4217-80d1-10f5bab19033",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Elle est devenue excessivement difficile pour sa chaussure, elle veut faire valoir son pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Extrêmement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1e2fd7-e34c-481b-bbf9-fbde01a18be4",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "On fabrique actuellement des tubes capillaires en verre excessivement fins. Ceux-ci, étirés par des ouvriers spéciaux, ont d’ordinaire une ouverture de deux dixièmes de millimètre."
                                            },
                                            {
                                                "example_id": "c559f0b3-fb2d-4d06-900c-7c684c9e8b87",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "Pendant la première semaine, la brise fut très légère et excessivement variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Un nombre excessif de, une quantité excessive de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db215b9a-32fd-4f3b-b52f-d4f7a24f4a2b",
                                                "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                                "text": "Face à des besoins d’argent pour répondre à la demande, les autorités monétaires ont créé excessivement de monnaie, entraînant un déséquilibre de la balance des paiements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac872342-f1c8-47d0-a168-e5e9346e46d9",
                        "source_entry_id": "36c81149-c30b-3d5c-8e87-ec603cf5bd19",
                        "source_sense_description": "чрезмерно",
                        "target_lang_word": "férocement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "férocement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                        "entry_id": "9fe36cf1-30cc-384d-9037-63d334396101",
                                        "glosses": [
                                            "D’une manière féroce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd97c233-68a0-4812-be10-4bc1cc782225",
                                                "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                                "text": "De leurs fleurs férocement bariolées et tigrées […] s'exhalent des parfums âcres, pénétrants, vertigineux."
                                            },
                                            {
                                                "example_id": "27a26139-aea1-43de-8a74-28ff8dc52712",
                                                "sense_id": "645b5335-c492-3c9a-9be0-e5192fe335cf",
                                                "text": "Le capitalisme n'a pas arraché la femme au foyer domestique et ne l'a pas lancée dans la production sociale pour l'émanciper, mais pour l'exploiter encore plus férocement que l'homme ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                        "entry_id": "9fe36cf1-30cc-384d-9037-63d334396101",
                                        "glosses": [
                                            "Avec dureté"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744acef0-9641-4962-a723-906f636c1098",
                                                "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                                "text": "Il riait de plus en plus fort, férocement joyeux, guettant les reflets de la stupéfaction sur la physionomie du journaliste."
                                            },
                                            {
                                                "example_id": "b1112b5c-e767-4d98-8661-571d5e4bd8bb",
                                                "sense_id": "0410ad3a-66fd-3c11-8383-5a06094758be",
                                                "text": "Les années de famine, se déroulent des scènes effroyables, émeutes férocement réprimées, meurtres d'enfants, nécrophagies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
