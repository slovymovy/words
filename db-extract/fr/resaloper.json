                "senses": [
                    {
                        "sense_id": "d7d7de0e-7c37-3297-8562-e448c2256e6c",
                        "entry_id": "10843772-4d00-31ee-a9a6-297b43c01858",
                        "glosses": [
                            "Saloper à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0f1a6b-82d2-4a9f-a008-f96e01f4b68d",
                                "sense_id": "d7d7de0e-7c37-3297-8562-e448c2256e6c",
                                "text": "Mais si c'est pour permettre aux Etats de resaloper le prochain système financier comme ils ont salopé le précédent, ce n'est vraiment pas la peine."
                            },
                            {
                                "example_id": "46d8f933-086e-4dc4-b0eb-042dd8fcf8cf",
                                "sense_id": "d7d7de0e-7c37-3297-8562-e448c2256e6c",
                                "text": "J'ai pratiquement résolu le problème, mais à cause d'un petit détail de la norme, j'ai dû resaloper un peu la solution, et bien sûr ça ne me satisfait pas tout à fait du tout."
                            },
                            {
                                "example_id": "e035b96e-b360-431b-ad8c-f6eb1e98f186",
                                "sense_id": "d7d7de0e-7c37-3297-8562-e448c2256e6c",
                                "text": "Ca s'entend au son, et vu qu'il nettoie son sabre après avoir tué le père de Fuu c'est pô pour le resaloper 2 secondes après."
                            }
                        ]
                    }
