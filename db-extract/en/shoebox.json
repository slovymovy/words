                            {
                                "example_id": "61a8b5b3-62ec-4317-baa0-f20c9256c182",
                                "sense_id": "8cc36f2a-7b1e-301f-afa5-a0fe13a8e4cb",
                                "text": "In one shoebox he had a whole collection of seeds he had saved from last year."
                            }
                        ]
                    },
                    {
                        "sense_id": "85c2a7bd-9f24-3597-828e-03654fe50b7a",
                        "entry_id": "1e333ffe-32bd-36fc-9950-6e19be87e9d4",
                        "glosses": [
                            "A small, cramped residence or similar space."
                        ],
                        "tags": [
                            "derogatory",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8e4f5d1a-5aaf-47a4-801e-f18e55e0f74e",
                                "sense_id": "85c2a7bd-9f24-3597-828e-03654fe50b7a",
                                "text": "She wondered how come Ho had a garden when everyone she knew lived in shoeboxes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c801e5a6-0426-4740-82ca-3615bad2d4c2",
