                "senses": [
                    {
                        "sense_id": "38698d68-2fc7-3286-a466-63dd2d094c42",
                        "entry_id": "7363ee79-bc05-3920-aeff-3d76a11cc589",
                        "glosses": [
                            "junge, weibliche Person, welche die Tochter eines Nachbarn ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e717774-62cc-47b5-a928-3c30110bca70",
                                "sense_id": "38698d68-2fc7-3286-a466-63dd2d094c42",
                                "text": "„Der Sommer kann durchaus überraschende Erkenntnisse bereithalten. Zum Beispiel, dass das Nachbarsmädchen Schiffe versenken entdeckt hat - und die zu Besuch gekommene Oma nun bei jeder Gelegenheit auf die Jagd nach Kreuzern und U-Booten gehen darf.“"
                            },
                            {
                                "example_id": "59913b72-dca8-4541-a00b-99c589c67916",
                                "sense_id": "38698d68-2fc7-3286-a466-63dd2d094c42",
                                "text": "„\"Ich mochte sie. Sie war nett\", sagt Robert K., 16 Jahre alt, über das siebenjährige Nachbarsmädchen, das er am 11. Mai in einem Gemeindebau in Wien-Döbling getötet haben soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
