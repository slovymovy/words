                    {
                        "translation_id": "fb156463-162e-48b7-a4a9-d959bfd56014",
                        "source_entry_id": "7f6ff090-6e8b-3d5e-a5fb-b3d039f679c8",
                        "source_sense_id": "b51fd433-69c0-3697-8b0f-433ce543b022",
                        "target_lang_word": "Brunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d4ab60-0132-3e37-befc-65990dd45c00",
                                        "entry_id": "f81b3f6e-9ffd-3a12-9136-d05edea8293b",
                                        "glosses": [
                                            "Paarungszeit bei vielen Säugetieren, wie zum Beispiel bei Hirschen und Rehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c13c69-ba01-4c0e-babe-3268e101da77",
                                                "sense_id": "b3d4ab60-0132-3e37-befc-65990dd45c00",
                                                "text": "Die Hirsche sind jetzt in der Brunst und tragen oft Kämpfe aus."
                                            },
                                            {
                                                "example_id": "afb42dca-0c39-4faa-a3e2-57d2d457b508",
                                                "sense_id": "b3d4ab60-0132-3e37-befc-65990dd45c00",
                                                "text": "„Erkennt der Bauer die Brunst nicht, muss er 21 Tage warten bis zur nächsten Brunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "153b2eba-827b-348a-a941-536de3128f0a",
                                        "entry_id": "f81b3f6e-9ffd-3a12-9136-d05edea8293b",
                                        "glosses": [
                                            "geschlechtliche Erregtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bacf472-e724-4b9d-bd4d-919a534393ed",
                                                "sense_id": "153b2eba-827b-348a-a941-536de3128f0a",
                                                "text": "„Wenn Anna auch Männerschuhe trägt, deren Schäfte sie mit ihren Waden nicht ausfüllt, so ist sie doch ein Weib. In welchem Weibe verbirgt sich nicht der Wunsch, bis ins Alter und länger, als wir Männer es wahrhaben wollen, von einem Manne umarmt, von einem Manne in Brunst oder Inbrunst anerkannt zu werden? Eine gewisse Lust, sie hört nicht auf, wenn der angeheiratete Mann in Flandern aus dem Leben herausgeschossen wurde.“"
                                            },
                                            {
                                                "example_id": "de502dc9-b489-46ea-a09a-023d6570ac13",
                                                "sense_id": "153b2eba-827b-348a-a941-536de3128f0a",
                                                "text": "„In der Folgezeit haben Schriftsteller und Theaterkritiker von «triebhaftem Drang», «Schwüle», «Dämonie entfesselter Reize», «Brunst» oder «Orgien» geschrieben, die sie dem Werk anhefteten. Die Reaktionen zeigen, dass man den sinnlichen Gehalt der Musik und den damit verbundenen Bruch bürgerlicher Tabus durchaus heraushörte.“"
                                            },
                                            {
                                                "example_id": "fe4a3601-c6b2-433d-a5c5-f1afd6b42758",
                                                "sense_id": "153b2eba-827b-348a-a941-536de3128f0a",
                                                "text": "„Als beider Brunst sich gesteigert hatte, hörten sie zu trinken auf, verriegelten die Stubentüre und entledigten sich ihrer Kleidung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
