                                        "entry_id": "e7c89c0b-4f2a-38b8-8fa4-4201e18c412f",
                                        "glosses": [
                                            "Able to give advice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d765cd-42b5-42c5-a27c-cc645837883e",
                                                "sense_id": "4232b870-99f7-3bcf-bf4b-fb5357aa960c",
                                                "text": "The advisory committee could only offer advice, but since that was almost always accepted they had real power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41847876-09a3-3e53-8cc3-d8c791c1ed15",
                                        "entry_id": "e7c89c0b-4f2a-38b8-8fa4-4201e18c412f",
                                        "glosses": [
                                            "Containing advice; advising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a0dd27-d0b3-4273-b1f9-7a51dc31fe22",
                                                "sense_id": "41847876-09a3-3e53-8cc3-d8c791c1ed15",
                                                "text": "The consultant's advisory recommendations were selectively adopted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advisory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d61cf5e-911a-3c37-b409-c5aa08d92615",
                                        "entry_id": "a7c29e00-ca9e-3c41-a98b-191494d7cd48",
                                        "glosses": [
                                            "A warning."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ee42da-083c-4dc9-8d50-1f6e1f907744",
                                                "sense_id": "4d61cf5e-911a-3c37-b409-c5aa08d92615",
                                                "text": "The Coast Guard issued a small craft advisory, warning little boats to watch out for bad weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60009850-3cff-30bf-9efb-c110344bd14b",
                                        "entry_id": "a7c29e00-ca9e-3c41-a98b-191494d7cd48",
                                        "glosses": [
                                            "A warning.",
                                            "Official information issued by the National Weather Service that highlights special weather conditions that are less serious than a warning. They are for events that may cause significant inconvenience, and if caution is not exercised, it could lead to situations that may threaten life and/or property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e09b084-02dd-315c-a09a-56ba13c69b03",
                                        "entry_id": "a7c29e00-ca9e-3c41-a98b-191494d7cd48",
                                        "glosses": [
                                            "Supervision by an advisor."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "possibly",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659a179e-18e6-414d-a44a-505be9884989",
                                                "sense_id": "2e09b084-02dd-315c-a09a-56ba13c69b03",
                                                "text": "Every morning, every 20 students on discipline, will [be under] the advisory of one teacher for 20 minutes."
                                            },
                                            {
                                                "example_id": "74afc6f7-62a6-43bc-abca-bfab17dae0b5",
                                                "sense_id": "2e09b084-02dd-315c-a09a-56ba13c69b03",
                                                "text": "After that, however, the village made steady progress in establishing a system of collective agriculture and communal organization under the advisory of the SERA."
                                            }
                                        ]
                                    }
