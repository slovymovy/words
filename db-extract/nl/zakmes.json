                    {
                        "sense_id": "95cf4081-f224-391d-bd05-544931683f37",
                        "entry_id": "9aa8b4c0-1e84-3274-84fb-b7cc68862290",
                        "glosses": [
                            "een klein invouwbaar mes, vaak met extra gereedschappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5ade93b-1757-4ce0-b043-23b866280f90",
                                "sense_id": "95cf4081-f224-391d-bd05-544931683f37",
                                "text": "Op een survivaltocht is een zakmes een van de belangrijkste spullen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ebb4fe-319e-4634-86a8-1d40aef00f97",
                        "source_entry_id": "9aa8b4c0-1e84-3274-84fb-b7cc68862290",
                        "source_sense_id": "95cf4081-f224-391d-bd05-544931683f37",
                        "source_sense_description": "een klein invouwbaar mes, vaak met extra gereedschappen",
                        "target_lang_word": "Taschenmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschenmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                        "entry_id": "884ca9c7-c46b-3840-a238-64bff29716aa",
                                        "glosses": [
                                            "ein Messer, dessen Klinge zum gefahrlosen Transport in den Griff eingeklappt werden kann und das oft weitere Funktionen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79c7f8c-b27f-4466-ad97-ecfa71e408e4",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Mein Taschenmesser ist mit seinen vielen Funktionen ein kleiner Werkzeugkasten."
                                            },
                                            {
                                                "example_id": "8a91d6dc-1120-4461-a6ec-0f3884f247b6",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Mit seinem Taschenmesser ratschte Bertram so energisch über die Verpackung, dass ich schon um den Inhalt fürchtete.“"
                                            },
                                            {
                                                "example_id": "35bec946-f256-4ce7-b7d1-bfabd4ced2a2",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Einer der Mobber greift den 14jährigen körperlich an. Der zieht ein Taschenmesser, das er seit Wochen mit in die Schule gebracht hat. Zu seiner Verteidigung, wie er sagt."
                                            },
                                            {
                                                "example_id": "75cf8879-cdb6-428f-8e86-aa55e1e0352a",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Besondere Erwähnung verdient das Taschenmesser. Natürlich passt es in so gut wie jede Tasche, aber es hat selbst eine. Seine Klinge lässt sich in die taschenähnliche Vertiefung im Griff klappen, weshalb es auch Klappmesser heißt."
                                            },
                                            {
                                                "example_id": "48183c20-937b-4a92-9bd4-8772c621d240",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Da saß ich und trällerte oder schrieb auf weiße Birkenrinde oder schnitzte etwas mit meinem Taschenmesser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2327c694-5204-43d7-9517-58f8cd087fd9",
                        "source_entry_id": "9aa8b4c0-1e84-3274-84fb-b7cc68862290",
                        "source_sense_id": "95cf4081-f224-391d-bd05-544931683f37",
                        "source_sense_description": "een klein invouwbaar mes, vaak met extra gereedschappen",
                        "target_lang_word": "Klappmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klappmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2666a0-83c3-3666-b1a2-ac259faa4070",
                                        "entry_id": "36278b49-5062-34f9-8f43-a47985b62307",
                                        "glosses": [
                                            "Messer, dessen Klinge man einklappen und ausklappen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4f4a07-155b-4c52-802e-4bad403b9678",
                                                "sense_id": "5e2666a0-83c3-3666-b1a2-ac259faa4070",
                                                "text": "Ein Klappmesser kann man in die Tasche stecken, ohne sie zu beschädigen."
                                            },
                                            {
                                                "example_id": "ef4b6a67-8126-4e39-aeab-01f896e74b54",
                                                "sense_id": "5e2666a0-83c3-3666-b1a2-ac259faa4070",
                                                "text": "„Er hielt Bobby ein Klappmesser vors Gesicht, so nah, dass Bobby fast die Kühle des Metalls auf seiner Haut spüren konnte.“"
                                            },
                                            {
                                                "example_id": "c598c6bc-e1df-4d8f-8d58-40d5778803e2",
                                                "sense_id": "5e2666a0-83c3-3666-b1a2-ac259faa4070",
                                                "text": "„Wenn man beim Schwarzfahren in der U-Bahn ein gültiges Klappmesser dabeihat, kann einem nicht viel passieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0625233d-9f81-4ddc-9f0e-9e804a443c48",
                        "source_entry_id": "9aa8b4c0-1e84-3274-84fb-b7cc68862290",
                        "source_sense_id": "95cf4081-f224-391d-bd05-544931683f37",
                        "source_sense_description": "een klein invouwbaar mes, vaak met extra gereedschappen",
                        "target_lang_word": "pocketknife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pocketknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                        "entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                                        "glosses": [
                                            "A knife small enough for carrying safely and handily in a pocket; usually a folding knife (with blades or tools that the user can fold or retract into the handle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8f5066-538e-41bf-b0a7-1351fbb50c3c",
                                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                                "text": "Jimmy had a pocketknife, and he wandered into the drawing-room with it one day, alone, and reduced ten thousand dollars' worth of furniture to an indeterminable value in rather less than three-quarters of an hour."
                                            },
                                            {
                                                "example_id": "c8f956b6-e4a6-4613-ada9-d220d7209598",
                                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                                "text": "The Army, the Navy, the Maritime Commission, and Lend-Lease demanded more and more pocketknives — for demolition kits, medical kits, aviators’ kits, electricians’ kits; knives with tools, knives with marlin spikes. The pocketknife attained a new status — as indispensable equipment for all men in uniform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
