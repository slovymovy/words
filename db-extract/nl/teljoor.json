                        "sense_id": "6518e7e7-a10a-39b0-b788-5b6b8d3d9997",
                        "entry_id": "7228729a-a14e-31b6-bfdd-edf18d83ce06",
                        "glosses": [
                            "vlak voorwerp om voedsel van te eten, tegenwoordig meestal van rond aardewerk, vroeger ook wel van metaal of hout"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "fd7fe891-08e2-4e9f-afb1-81c7fc971e14",
                                "sense_id": "6518e7e7-a10a-39b0-b788-5b6b8d3d9997",
                                "text": "En José heeft er nog zo’n goeie: eet eerst de teljoor van een ander leeg en begin dan pas aan jouw bord."
                            },
                            {
                                "example_id": "c5d687f7-5f69-42bc-adbe-31a2c171def5",
                                "sense_id": "6518e7e7-a10a-39b0-b788-5b6b8d3d9997",
                                "text": "Onder meer zijn een teljoor (eetbord), een leren muil en een harpoen uit het Behouden Huys van Willem Barentsz op Nova Zembla te zien."
                            }
                        ]
                    }
                ],
