                        "entry_id": "507d3962-70d1-39c3-ae74-96d7593ac9f0",
                        "glosses": [
                            "diminutive of ду́шка (dúška) pleasant person, dear, love (a term of friendly address)"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6c969c6c-66c0-4169-9bb3-02ca67d54db6",
                                "sense_id": "5eb691d8-54a9-3aab-8bf2-0206c5cc8268",
                                "text": "Посыла́ю вам виногра́ду немно́го, ду́шечка; для выздора́вливающей э́то, говоря́т, хорошо́, да и до́ктор рекоменду́ет для утоле́ния жа́жды, так то́лько еди́нственно для жа́жды.",
                                "translation": "I send you a few grapes, my love; I am told they are good for a convalescent and the doctor recommends them for quenching the thirst—simply for thirst.",
                                "english": "I send you a few grapes, my love; I am told they are good for a convalescent and the doctor recommends them for quenching the thirst—simply for thirst."
                            }
                        ]
                    }
