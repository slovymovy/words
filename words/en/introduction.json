{
    "word_family": [
        "introduce",
        "introductory",
        "introducer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a5190c3-75fe-353d-a9b2-b7d1ccb625af",
                    "sense_definition": "The act of formally presenting one person to another so they can know each other.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a brief <w>introduction</w>, the two colleagues started discussing the project.",
                            "target_lang_translations": {
                                "ru": "После краткого <w>представления</w> друг другу коллеги начали обсуждать проект.",
                                "tr": "Kısa bir <w>tanıştırmadan</w> sonra, iki meslektaş projeyi tartışmaya başladı."
                            }
                        },
                        {
                            "text": "He was nervous during his <w>introduction</w> to the director of the company.",
                            "target_lang_translations": {
                                "ru": "Он нервничал во время своего <w>представления</w> директору компании.",
                                "tr": "Şirket müdürüne <w>takdim</w> edilirken heyecanlıydı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an introduction",
                        "formal introduction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по официальному представлению одного человека другому для знакомства.",
                        "tr": "Bir kişinin başka bir kişiyle tanışması için resmi olarak takdim edilmesi eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "знакомство людей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tanıştırma",
                                "target_lang_sense_clarification": "insanları birbirine takdim etme"
                            },
                            {
                                "target_lang_word": "tanışma",
                                "target_lang_sense_clarification": "karşılıklı tanışma süreci"
                            },
                            {
                                "target_lang_word": "takdim",
                                "target_lang_sense_clarification": "resmi sunma veya tanıtma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89121ad5-acb6-3e33-bb4c-ade47313ecf9",
                    "sense_definition": "The beginning part of a book, speech, or article that explains what follows.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "text_section",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should read the <w>introduction</w> to understand the author's main purpose.",
                            "target_lang_translations": {
                                "ru": "Вам следует прочитать <w>введение</w>, чтобы понять главную цель автора.",
                                "tr": "Yazarın asıl amacını anlamak için <w>giriş</w> kısmını okumalısınız."
                            }
                        },
                        {
                            "text": "The <w>introduction</w> provides a helpful summary of the chapters ahead.",
                            "target_lang_translations": {
                                "ru": "<w>Введение</w> содержит полезное краткое изложение следующих глав.",
                                "tr": "<w>Giriş</w> bölümü, gelecek bölümlerin faydalı bir özetini sunar."
                            }
                        }
                    ],
                    "synonyms": [
                        "preface",
                        "foreword",
                        "opening",
                        "prologue"
                    ],
                    "common_phrases": [
                        "write an introduction",
                        "read the introduction",
                        "brief introduction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступительная часть книги, речи или статьи, поясняющая последующее содержание.",
                        "tr": "Bir kitabın, konuşmanın veya makalenin devamını açıklayan başlangıç bölümü."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "часть книги или текста"
                            },
                            {
                                "target_lang_word": "предисловие",
                                "target_lang_sense_clarification": "вводная статья"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "giriş",
                                "target_lang_sense_clarification": "metin veya kitap bölümü"
                            },
                            {
                                "target_lang_word": "önsöz",
                                "target_lang_sense_clarification": "kitap başlangıcındaki yazı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "840051d7-99ca-30d7-81d6-fc7c8f93ff3a",
                    "sense_definition": "A basic explanation or course that teaches the fundamentals of a subject.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_section",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This class serves as an <w>introduction</w> to modern economics.",
                            "target_lang_translations": {
                                "ru": "Этот курс служит <w>введением</w> в современную экономику.",
                                "tr": "Bu ders, modern ekonomiye bir <w>giriş</w> niteliğindedir."
                            }
                        },
                        {
                            "text": "She bought a book that gives a clear <w>introduction</w> to gardening.",
                            "target_lang_translations": {
                                "ru": "Она купила книгу, которая дает ясное <w>введение</w> в садоводство.",
                                "tr": "Bahçeciliğe anlaşılır bir <w>giriş</w> sunan bir kitap satın aldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "introduction to physics",
                        "good introduction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовое объяснение или курс, обучающий основам предмета.",
                        "tr": "Bir konunun temel ilkelerini öğreten temel açıklama veya ders."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "основы предмета"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "giriş",
                                "target_lang_sense_clarification": "konunun veya dersin temelleri"
                            },
                            {
                                "target_lang_word": "başlangıç",
                                "target_lang_sense_clarification": "temel düzey bilgi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46041fc7-b647-3328-8ca7-017b973a462e",
                    "sense_definition": "The action of bringing something into use, existence, or a place for the first time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>introduction</w> of new technology has improved our work speed significantly.",
                            "target_lang_translations": {
                                "ru": "<w>Внедрение</w> новых технологий значительно повысило скорость нашей работы.",
                                "tr": "Yeni teknolojinin <w>getirilmesi</w> çalışma hızımızı önemli ölçüde artırdı."
                            }
                        },
                        {
                            "text": "We are planning the <w>introduction</w> of a new product into the global market.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>внедрение</w> нового продукта на глобальный рынок.",
                                "tr": "Yeni bir ürünün küresel pazara <w>sunulmasını</w> planlıyoruz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "introduction of new rules",
                        "gradual introduction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по вводу чего-либо в употребление, существование или в какое-либо место впервые.",
                        "tr": "Bir şeyin ilk kez kullanıma, yürürlüğe veya bir yere sunulması eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внедрение",
                                "target_lang_sense_clarification": "технологий, методов"
                            },
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "правил, законов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "getirilme",
                                "target_lang_sense_clarification": "yürürlüğe koyma veya sunma"
                            },
                            {
                                "target_lang_word": "tanıtım",
                                "target_lang_sense_clarification": "yeni ürün lansmanı"
                            },
                            {
                                "target_lang_word": "sokma",
                                "target_lang_sense_clarification": "kullanıma veya piyasaya dahil etme"
                            },
                            {
                                "target_lang_word": "uygulama",
                                "target_lang_sense_clarification": "kullanıma başlama"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}