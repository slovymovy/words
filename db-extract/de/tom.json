                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7ca9db5-b85d-32bc-87c8-652a6a2dfd04",
                        "entry_id": "d916c040-125e-3189-b232-80025b174ba6",
                        "glosses": [
                            "Nebenfluss des Ob"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a221da7-87dd-4a17-9af7-03bc953e9ce6",
                                "sense_id": "e7ca9db5-b85d-32bc-87c8-652a6a2dfd04",
                                "text": "„Der Tom durchfließt die Stadt [Tomsk], wasserreich und breit, etwa wie der Oberrhein.“"
                            },
                            {
                                "example_id": "4a53af7d-8c86-4870-bf11-107e4165b409",
                                "sense_id": "e7ca9db5-b85d-32bc-87c8-652a6a2dfd04",
                                "text": "„Ehemals waren die Ländereien längs des Tom von Tatarenstämmen besiedelt; erfolgreiche Eroberungszüge und geschickte Bündnisse mit den einander sich befehdenden Stämmen brachten das Gebiet unter Moskauer Herrschaft.“"
                            },
                            {
                                "example_id": "bf461ea0-9bf7-4dac-900a-01ae30a6e269",
                                "sense_id": "e7ca9db5-b85d-32bc-87c8-652a6a2dfd04",
                                "text": "„Tief im Süden, dort wo auf dem Ob und dem Tom die Großschiffahrt mit den kleinen Dampfern und Kähnen des Oberlaufs die Waren tauscht, waren Semipalatinsk und Barnaul wichtig genug geworden, uns für ein paar Tage zu beschäftigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
