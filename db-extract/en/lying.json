                "senses": [
                    {
                        "sense_id": "8d3004b2-a027-3f86-a16a-c09e449c9a10",
                        "entry_id": "b745a0d0-ac0d-3948-a5d7-616a1a198379",
                        "glosses": [
                            "Tending to tell lies, untruthful, mendacious"
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "024630ba-ce2e-4c14-8b3e-ebda981e890e",
                                "sense_id": "8d3004b2-a027-3f86-a16a-c09e449c9a10",
                                "text": "Gloster: Then, Saunder, sit there, the lyingest knave in Christendom."
                            },
                            {
                                "example_id": "3c86c6de-b124-4211-b598-f46120594bc1",
                                "sense_id": "8d3004b2-a027-3f86-a16a-c09e449c9a10",
                                "text": "Sly: Ask Marian Hacket, the fat ale-wife of Wincot, if she know me not: if she say I am not fourteen pence on the score for sheer ale, score me up for the lyingest knave in Christendom."
                            },
                            {
                                "example_id": "c8a6984d-51ab-44a1-9bd5-0dfc93ce5b69",
                                "sense_id": "8d3004b2-a027-3f86-a16a-c09e449c9a10",
                                "text": "“God, how you lie, skinny! You’re about the lyingest woman I’ve ever met. I’ll be damned if I’ll keep on asking questions when it’s plain as day you’re not about to give out any answers."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d5262609-6a9e-3209-8962-56d1c9431109",
