                ],
                "senses": [
                    {
                        "sense_id": "fa8a4e3f-297c-3418-a5dd-c0b2c6763f1f",
                        "entry_id": "ee365c3b-bd0b-3bc9-8bc9-c7774521bfa7",
                        "glosses": [
                            "церк. недавно умерший человек в течение сорока дней после кончины"
                        ],
                        "tags": [
                            "у православных христиан"
                        ],
                        "examples": [
                            {
                                "example_id": "1bb36431-2a58-4816-897f-18575b6f14e2",
                                "sense_id": "fa8a4e3f-297c-3418-a5dd-c0b2c6763f1f",
                                "text": "За упокой души раба Божия новопреставленного Феодора она молиться будет обязательно, а вот другой раб Божий помер или жив?"
                            },
                            {
                                "example_id": "1c600844-cba7-4702-853c-8355a94083fe",
                                "sense_id": "fa8a4e3f-297c-3418-a5dd-c0b2c6763f1f",
                                "text": "С момента кончины тело покойного находилось в храме Покрова Пресвятой Богородицы, где собратья пастыри читали над новопреставленным протоиереем Василием Евангелие."
                            }
                        ]
                    },
                    {
                        "sense_id": "96e74072-4e0a-31c3-af37-4701bed7f78d",
                        "entry_id": "ee365c3b-bd0b-3bc9-8bc9-c7774521bfa7",
                        "glosses": [
                            "церк., субстантивир. тот, кто недавно умер (до 40 дней)"
                        ],
                        "tags": [
                            "у православных христиан"
                        ],
                        "examples": [
                            {
                                "example_id": "d48477ab-9a2c-47d8-a004-901a13f09657",
                                "sense_id": "96e74072-4e0a-31c3-af37-4701bed7f78d",
                                "text": "Выменяла шубу на хлеб ― на молоко ― на крупу, гостей созвала на пир: помяните новопреставленного!"
                            },
                            {
                                "example_id": "e50b2a93-0cae-4946-bd5d-cf0c6f28c8d9",
                                "sense_id": "96e74072-4e0a-31c3-af37-4701bed7f78d",
                                "text": "Как зловеще возносил руку толстоплечий дьякон, возглашая о упокоении новопреставленного!"
                            }
                        ]
                    }
                ],
