                    {
                        "sense_id": "b9341a75-c346-39d9-9015-fdcbd4701a29",
                        "entry_id": "ebcab6c4-f76f-3b32-b2b4-279188c02959",
                        "glosses": [
                            "azurn, himmelblau, azur-"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0ae2697e-43ef-40c3-844f-bb65287d6911",
                                "sense_id": "b9341a75-c346-39d9-9015-fdcbd4701a29",
                                "text": "« Au levant, se voyait un petit port précédé de quelques maisons, et dans lequel des navires d’une forme particulière se balançaient aux ondulations des flots azurés. »"
                            },
                            {
                                "example_id": "13e41cbf-7f0f-41e1-ab14-a838068caa14",
                                "sense_id": "b9341a75-c346-39d9-9015-fdcbd4701a29",
                                "text": "« Ses yeux, sous l’ombre azurée des cils, brillaient de désir en regardant ma montre posée sur la table. »"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2446b3-1972-44eb-91fd-b7a8868fca78",
