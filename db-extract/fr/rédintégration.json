                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80766a0b-1f8c-3eb7-b6ba-54c97b93e4d4",
                                        "entry_id": "09571820-4c04-3978-a09b-58637a125cfd",
                                        "glosses": [
                                            "The reinstatement of a memory upon the presentation of a stimulus element that was a part of the stimulus complex that had aroused the event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2911a129-b661-44af-9f40-8609d72d62de",
                                                "sense_id": "80766a0b-1f8c-3eb7-b6ba-54c97b93e4d4",
                                                "text": "Now all this story might be true. But even if it were, it does not follow that reference to redintegration should be included as part of the definition of ‘motive’."
                                            },
                                            {
                                                "example_id": "75eb5535-2a44-409d-b05e-8f0d1a933963",
                                                "sense_id": "80766a0b-1f8c-3eb7-b6ba-54c97b93e4d4",
                                                "text": "Is McClelland’s concept of ‘motive’ yet another example of explanation masquerading as analysis? This is obviously so in his definition which includes the reference to redintegration of affect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
