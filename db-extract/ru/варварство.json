                "senses": [
                    {
                        "sense_id": "cd3b1646-90db-3086-9a51-5c6626d38d8d",
                        "entry_id": "84ee1482-bee2-3239-8595-1417bd2fc801",
                        "glosses": [
                            "в культурно-исторической периодизации, принятой в науке 18-19 вв., средняя из трёх эпох истории человечества (дикость, варварство, цивилизация), начинающаяся с изобретения гончарного производства и завершающаяся появлением письменности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0da90dae-534b-377b-a094-5d84cbdc0666",
                        "entry_id": "84ee1482-bee2-3239-8595-1417bd2fc801",
                        "glosses": [
                            "перен. крайняя жестокость, грубость, дикость нравов; бессмысленное разрушение культурных ценностей"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d35c54d5-692d-4214-ac98-d231bb7c3aa1",
                        "source_entry_id": "84ee1482-bee2-3239-8595-1417bd2fc801",
                        "target_lang_word": "Barbarei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbarei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                        "entry_id": "24a46e2f-9931-3e8c-80c1-5d4b1890d148",
                                        "glosses": [
                                            "ungezügelte Rohheit, Vandalismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2a3d46-79de-45c4-9914-399b78c21487",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "Die Behandlung der Gefangenen erwies sich als reine Barbarei."
                                            },
                                            {
                                                "example_id": "5c8ff28d-bafa-4573-9ce8-90dd3a835500",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Ich fing an zu begreifen, weshalb die Angst, es könne zu einem Rückfall in die Barbarei kommen, viele Menschen zeitlebens begleitete.“"
                                            },
                                            {
                                                "example_id": "a031c8b8-fb68-4a35-85b2-55e673ac7707",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Bis dahin hatte Nikolai das Regime nur mit vagem Widerwillen betrachtet; nun erkannte er dessen archaische Barbarei in ihrem ganzen grauenvollen Ausmaß.“"
                                            },
                                            {
                                                "example_id": "f278db31-234c-4755-ace7-06439f855f80",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Leopolds System stellt längst jene Barbarei der Sklaverei in den Schatten, zu deren Beseitigung es vorgeblich eingerichtet worden ist.“"
                                            },
                                            {
                                                "example_id": "b8562937-15e0-40c0-863e-0a508676c353",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Er musste schreiben, anschreiben gegen die um sich greifende Barbarei des Nationalsozialismus in der Weimarer Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                        "entry_id": "24a46e2f-9931-3e8c-80c1-5d4b1890d148",
                                        "glosses": [
                                            "Zustand der Unzivilisiertheit und des Nichtvorhandenseins von Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca91d07-3eee-4aad-8b84-7f2849b3c2ed",
                                                "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                                "text": "„Der gesellschaftlich akzeptierte und etablierte Kannibalismus, also die Barbarei erscheint als codierte Darstellung des »Dritten Reiches«.“"
                                            },
                                            {
                                                "example_id": "68ad6c5b-eb39-4de3-b0d5-c937adf06744",
                                                "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                                "text": "„Weskott fand das empörend, als eine kulturelle Barbarei schlimmsten Ausmaßes, die er nicht hinzunehmen bereit war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
