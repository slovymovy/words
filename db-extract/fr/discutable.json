                "forms": [
                    {
                        "form_id": "6bebde91-1c4d-4ba4-8bc9-078a256ca322",
                        "entry_id": "f587855d-405c-3335-b254-a5d192b3c8d4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "discutables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44035836-e2ee-3f92-b043-06cc49653b4f",
                        "entry_id": "f587855d-405c-3335-b254-a5d192b3c8d4",
                        "glosses": [
                            "Qui peut se discuter, qui est susceptible d’être discuté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352499a9-398d-44db-b13c-b9dad9d8cdff",
                                "sense_id": "44035836-e2ee-3f92-b043-06cc49653b4f",
                                "text": "Cela est fort discutable."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f60732b-3aca-35ea-888b-579591e71532",
                        "entry_id": "f587855d-405c-3335-b254-a5d192b3c8d4",
                        "glosses": [
                            "Douteux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c312fd7-24f0-41f6-90f6-e9da2cce439f",
                                "sense_id": "2f60732b-3aca-35ea-888b-579591e71532",
                                "text": "Plusieurs associations, notamment l’Association contre l’heure d’été double (ACHED), dénoncent cependant ces changements d’heure et leurs effets nocifs sur la santé et jugent également discutables les économies d’énergies [sic] ainsi réalisées."
                            },
                            {
                                "example_id": "a5e15e80-f961-4d95-9b0d-361297637da1",
                                "sense_id": "2f60732b-3aca-35ea-888b-579591e71532",
                                "text": "À 17 h 45, comme on le lui a commandé, vêtu en pingouin (de location, frais remboursés) et suant à grands seaux dans cette tenue discutable pour une fin d'après-midi affichant encore 24° à l'ombre, il fait les cent pas dans le hall du Martinez."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf73c912-83f4-4e3f-9848-610572cac682",
                        "source_entry_id": "f587855d-405c-3335-b254-a5d192b3c8d4",
                        "source_sense_description": "Qui peut se discuter",
                        "target_lang_word": "arguable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arguable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf92c39-30c0-33ab-9110-4e08175d275f",
                                        "entry_id": "d7abba0f-cd3a-36b3-835f-8f3b33e16c11",
                                        "glosses": [
                                            "That can be argued; that can be proven or strongly supported with sound logical deduction, precedent, and evidence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b9c217-6f4b-3b0d-af35-c35432d2ce3e",
                                        "entry_id": "d7abba0f-cd3a-36b3-835f-8f3b33e16c11",
                                        "glosses": [
                                            "Open to doubt, argument or debate."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d404ab9-555b-4ed1-a349-a0ed5bab05d7",
                                                "sense_id": "71b9c217-6f4b-3b0d-af35-c35432d2ce3e",
                                                "text": "This led to a set of rules (play cannot begin before crossing East Blithedale Avenue), then subrules (\"crossing\" means reaching the always arguable halfway point of the avenue) […"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d901d75-fc07-4f86-aa48-193d85ccf508",
                        "source_entry_id": "f587855d-405c-3335-b254-a5d192b3c8d4",
                        "source_sense_description": "Qui peut se discuter",
                        "target_lang_word": "debatable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                        "entry_id": "6fe4b60d-3d64-3fbc-9062-4386a153408f",
                                        "glosses": [
                                            "Open to debate; not fully proved or confirmed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3cb4f4e-d14c-4863-8ac7-4d1c20b35fcc",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "Those data are debatable: no one has been able to replicate them."
                                            },
                                            {
                                                "example_id": "55a90c90-c3c1-4580-8487-77358fa56e44",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "It's debatable whether he is the best candidate for the position."
                                            },
                                            {
                                                "example_id": "2f9ffe52-af36-4cee-89a4-7e91603c6ff6",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "While the SCP universe is, of course, filled with things that we would certainly not consider \"real\", most of the SCPs are tangible or perceivable in some way. There are those concepts, however, whose reality is debatable, even to the SCP Foundation, begging them to ask the question of what, exactly, is real."
                                            },
                                            {
                                                "example_id": "2ccf50c0-6644-4697-923e-39dc77dbb597",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "There’s been a change in President Donald Trump. He used to say he had accomplished more than any other President, a debatable claim. But now he’s using messianic language about himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fab0324-195e-3a95-94a4-da6750d327a9",
                                        "entry_id": "6fe4b60d-3d64-3fbc-9062-4386a153408f",
                                        "glosses": [
                                            "Able to be debated; up for discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae419ff-8c72-4de9-8dd2-3e836b36a9cb",
                                                "sense_id": "0fab0324-195e-3a95-94a4-da6750d327a9",
                                                "text": "The lack of bonuses this year is not debatable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f736af9-cd6e-31aa-8442-ac0252c211f3",
                                        "entry_id": "b9199e72-5f94-3ce2-85c6-afabd105506d",
                                        "glosses": [
                                            "A topic that is open to debate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da12cca0-b0d5-40db-8063-87a10a6b8621",
                                                "sense_id": "8f736af9-cd6e-31aa-8442-ac0252c211f3",
                                                "text": "Just how many glaucoma patients there are in the United States and just how prevalent is the disease are two unknowns or at least two debatables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
