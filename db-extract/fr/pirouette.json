        "fr-extract.jsonl": [
            {
                "entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                "word": "pirouette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cf44626-94f3-4416-9e28-a8800da4d33e",
                        "entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "pirouettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cabafa5b-62f7-36ba-99b9-b10a1ad3a398",
                        "entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                        "glosses": [
                            "Tour entier qu’on fait de tout le corps, en se tenant sur la pointe d’un seul pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d6b8301-0527-41d3-8a78-77592fc731f9",
                                "sense_id": "cabafa5b-62f7-36ba-99b9-b10a1ad3a398",
                                "text": "Faire une pirouette, des pirouettes."
                            },
                            {
                                "example_id": "017655ec-d423-4356-ac2a-67609d9421e1",
                                "sense_id": "cabafa5b-62f7-36ba-99b9-b10a1ad3a398",
                                "text": "Faire une double pirouette."
                            },
                            {
                                "example_id": "71513339-0714-4cfd-9008-a9a63264b685",
                                "sense_id": "cabafa5b-62f7-36ba-99b9-b10a1ad3a398",
                                "text": "Comme il sortait du bain, un camarade lui conseilla par manière de plaisanterie de rentrer à l’hôtel en dansant. L’autre accepte le défi, exécute une pirouette et tombe mort sur la route, aux côtés de son compagnon épouvanté."
                            }
                        ]
                    },
                    {
                        "sense_id": "565c26d6-7bb2-399b-ad7f-7b7180d44864",
                        "entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                        "glosses": [
                            "Sorte de volte que fait le cheval sur sa longueur dans une seule et même place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2901c5f7-db78-4600-956b-744fef617c52",
                                "sense_id": "565c26d6-7bb2-399b-ad7f-7b7180d44864",
                                "text": "La passade consiste à mener un cheval au galop sur une ligne droite et à exécuter une demi-volte ou une demi-pirouette ordinaire à chaque extrémité de cette ligne, de manière à la parcourir plusieurs fois de suite, en passant et repassant."
                            }
                        ]
                    },
                    {
                        "sense_id": "68332f38-fe90-3196-bdcc-35bb36402dc1",
                        "entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                        "glosses": [
                            "Dérobade."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "290cdce8-ac83-4d25-9f93-123af7886f6f",
                                "sense_id": "68332f38-fe90-3196-bdcc-35bb36402dc1",
                                "text": "À tout ce que j’ai pu lui dire, dans ces graves circonstances, il n’a répondu que par des pirouettes."
                            },
                            {
                                "example_id": "ee4985ca-facd-4950-b106-a25a240d1120",
                                "sense_id": "68332f38-fe90-3196-bdcc-35bb36402dc1",
                                "text": "Nous nous sommes écrit tous les deux de grandes phrases tendres, sans peut-être y croire beaucoup, pour au bout faire la pirouette en souriant un peu plus fort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b7cdd3-dcab-4209-b49b-15673a540c1e",
                        "source_entry_id": "85411b46-9d08-3cc6-b0af-19706c91cf8f",
                        "source_sense_description": "Tour, volte",
                        "target_lang_word": "Pirouette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pirouette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                                        "entry_id": "e8a349ba-12bf-382a-990d-e952d9ba5abf",
                                        "glosses": [
                                            "eine zentrierte einfache oder mehrfache schnelle Drehung um die eigene Körperhochachse"
                                        ],
                                        "tags": [
                                            "Tanz",
                                            "Eiskunstlauf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1817f069-6aea-4694-bef9-be41089eabad",
                                                "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                                                "text": "Die jungen Eiskunstläuferinnen gleiten leicht übers Eis und drehen kunstvoll eine Pirouette."
                                            },
                                            {
                                                "example_id": "6e3c4554-f678-4f7c-b348-8d211eb2a249",
                                                "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                                                "text": "„Sie machte Luftsprünge, Pirouetten, Kapriolen, Beinschläge, kurz alle Possen einer Ballettratte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
