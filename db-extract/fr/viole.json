        "fr-extract.jsonl": [
            {
                "entry_id": "13198af3-1278-39e1-ba5e-441d11dbab40",
                "word": "viole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0a06bff-5573-4c60-99f9-c0d23d5a30f2",
                        "entry_id": "13198af3-1278-39e1-ba5e-441d11dbab40",
                        "tags": [
                            "plural"
                        ],
                        "form": "violes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                        "entry_id": "13198af3-1278-39e1-ba5e-441d11dbab40",
                        "glosses": [
                            "Instrument de musique à six ou sept cordes, dont on joue avec un archet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd796bd-07bf-4b34-8c42-9fd0be76fa2e",
                                "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                                "text": "Une viole de gambe."
                            },
                            {
                                "example_id": "6bf96a35-1edd-482f-b15f-e0675558cec0",
                                "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                                "text": "Au même moment, la voix pure et légère d’une cantatrice qui enchantait les convives, fortifiée par les accords de la viole sur laquelle elle s’accompagnait, domina le râle de l’ouragan, et retentit jusque dans cette chambre funèbre."
                            },
                            {
                                "example_id": "6a1881da-cd8d-4351-8687-8b37bcfeb6e4",
                                "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                                "text": "Comme il aimait la musique, il acheta une viole pour charmer ses ennuis et essaya d’en jouer sans avoir jamais appris."
                            },
                            {
                                "example_id": "dc77ff34-2c91-42bf-8c64-dfabbcd7c0ba",
                                "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                                "text": "Pauvre M Hyacinthe ! je ne le vois pas en pourpoint brodé, une viole à la main !"
                            },
                            {
                                "example_id": "427bc646-b383-4f4a-96cc-f3c12c42ff43",
                                "sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
                                "text": "Madeleine vint embrasser Marin Marais qui lui dit, tout en disposant sa viole entre ses jambes et en cherchant l'accord, qu'il avait joué devant le roi à la chapelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ba4c4a6-9abb-468c-99f7-5b334f0f4738",
                        "source_entry_id": "13198af3-1278-39e1-ba5e-441d11dbab40",
                        "source_sense_id": "1a9d153b-b3b1-37ab-b4be-f7f3376a7b8f",
