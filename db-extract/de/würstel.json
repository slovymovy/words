                        ],
                        "examples": [
                            {
                                "example_id": "172b9ed6-b0f6-4432-89f3-c11775bc7e51",
                                "sense_id": "07b92c2a-1f75-396e-bbf2-af8816095b43",
                                "text": "„Vor dem Bahnhof aß er rasch ein Paar heiße Würstel.“"
                            },
                            {
                                "example_id": "e0eafda8-e1b6-4afb-9416-2930bfc3a337",
                                "sense_id": "07b92c2a-1f75-396e-bbf2-af8816095b43",
                                "text": "„Wir pflegten uns sonst immer in der großen Pause beim Schuldiener warme Würstel und Salzstangen zu kaufen.“"
                            },
                            {
                                "example_id": "799a1b40-0667-43f9-b00b-a1b70ea22a29",
                                "sense_id": "07b92c2a-1f75-396e-bbf2-af8816095b43",
                                "text": "„Helene brühte Kaffee und machte Würstel warm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
