                "senses": [
                    {
                        "sense_id": "42a06b9a-4a89-3ed6-bacd-d26c383fed03",
                        "entry_id": "f5aa1763-d0ac-348a-91db-9200e9399b62",
                        "glosses": [
                            "Fass, in welchem Teer aufbewahrt und transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb75133-96cd-4c90-9d46-580aa07e2108",
                                "sense_id": "42a06b9a-4a89-3ed6-bacd-d26c383fed03",
                                "text": "Es wirkt unheimlich und unwirklich hier, man fühlt sich an die Bronx oder sonstige berühmt-berüchtige Gegenden erinnert, besonders bei Regen oder Nebel, wenn in den Teerfässern Feuer brennen."
                            },
                            {
                                "example_id": "b7e8c6e9-6320-4ca9-aec5-0430c1d915bc",
                                "sense_id": "42a06b9a-4a89-3ed6-bacd-d26c383fed03",
                                "text": "„Die waren irgendwann in der Nacht angerückt, hatten ein Stück Gelände als Landepiste planiert und als Beleuchtung zwei Reihen Teerfässer aufgestellt und angezündet, aber es gab keine Möglichkeit, das Ding von dort aus zurückzufliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
