                        "glosses": [
                            "Titre donné dans l’empire de Perse aux princes du sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e3da52-9f24-442f-8b98-7c9eefa08f22",
                                "sense_id": "1cc975a0-d679-3bb7-89c3-5c8e5d97de08",
                                "text": "Tel est le nombre des fils des différents Chahs que la plupart des gouverneurs persans sont des chahzadés, que le gouvernement est dans l’obligation d’entretenir."
                            }
                        ]
                    },
                    {
                        "sense_id": "feab7a2c-f672-37f1-aaa2-886274930e41",
                        "entry_id": "ec619ae8-0e72-33a9-bf83-8fc86d5c5648",
                        "glosses": [
                            "Titre donné dans l’Empire ottoman aux princes du sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f109208-2880-4cbb-b08d-1a03d6e0ac69",
                                "sense_id": "feab7a2c-f672-37f1-aaa2-886274930e41",
                                "text": "Les chahzadés, ou princes du sang ottoman, n’ajoutent aucun titre à leurs noms ; on les qualifie simplement d’efendis."
