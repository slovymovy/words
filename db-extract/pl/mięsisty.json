                                        "glosses": [
                                            "sestávající z masa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee05441-fd5e-46c1-8acb-aa9f023a7848",
                                                "sense_id": "2c4579f8-f788-32e8-bb4d-766da7865b91",
                                                "text": "K uspokojení současného vyšponovaného zvyku na dennodenní",
                                                "translation": "masitou dietu jsou každoročně v průmyslových velkochovech zpracovány miliardy zvířat, které kvůli tlaku na co nejnižší cenu masa žijí v podmínkách tak příšerných, že v řadě států platí zákony zabraňující veřejnosti, aby se o nich dozvěděla plnou pravdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb77221-ac52-3a33-b1a9-c249c7835e09",
                                        "entry_id": "4bd1a3b4-bd52-3e4e-b5bc-a79a95d0ec4b",
                                        "glosses": [
                                            "svojí strukturou připomínající maso"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99bacbdc-530c-4446-9f9d-b37903580460",
                        "source_entry_id": "c5afee5b-68a5-3b72-9e44-9ee8aa5ee38a",
