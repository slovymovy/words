                "senses": [
                    {
                        "sense_id": "4442fa4a-3084-3a4b-80bf-abcf0510a70c",
                        "entry_id": "4ad929ff-2d42-3bf5-95d3-5abc8b6f1cff",
                        "glosses": [
                            "jemand, der von den Mitgliedern einer Nation als bedeutsam für die Nation verehrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da51810-cf17-45d0-b4f3-28cd96183ff5",
                                "sense_id": "4442fa4a-3084-3a4b-80bf-abcf0510a70c",
                                "text": "„Einer der größten Nationalhelden der Färinger kam aus diesem Ort, Nólsoyar Páll.“"
                            },
                            {
                                "example_id": "593fcad6-f3e8-4a9f-be5c-650ff7681619",
                                "sense_id": "4442fa4a-3084-3a4b-80bf-abcf0510a70c",
                                "text": "„Robert Baden-Powell wurde ein gefeierter Nationalheld.“"
                            },
                            {
                                "example_id": "b35e298e-68b4-4990-8260-f05d98a94f8a",
                                "sense_id": "4442fa4a-3084-3a4b-80bf-abcf0510a70c",
                                "text": "„Man konzentriert sich darauf, die Werke der alten kulturellen Nationalhelden so sorgsam abzustauben wie möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
