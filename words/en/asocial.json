{
    "word_family": [
        "asociality",
        "social",
        "antisocial"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33ee7ea3-34cf-3758-9f34-a85c7a354362",
                    "sense_definition": "Not sociable; avoiding or lacking interest in social interaction with others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "interpersonal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became increasingly <w>asocial</w> after moving to the countryside, rarely leaving his home or answering phone calls.",
                            "target_lang_translations": {
                                "de": "Nach seinem Umzug aufs Land wurde er zunehmend <w>ungeselliger</w>, verließ kaum noch das Haus und ging nicht ans Telefon."
                            }
                        },
                        {
                            "text": "Living in isolation often makes people develop <w>asocial</w> habits that make reconnecting difficult.",
                            "target_lang_translations": {
                                "de": "In Isolation zu leben führt oft dazu, dass Menschen <w>zurückgezogene</w> Gewohnheiten entwickeln, die eine Wiederannäherung erschweren."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsociable",
                        "withdrawn",
                        "reclusive"
                    ],
                    "antonyms": [
                        "sociable",
                        "social",
                        "outgoing"
                    ],
                    "common_phrases": [
                        "asocial behavior",
                        "asocial tendencies"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht gesellig; soziale Interaktionen mit anderen meidend oder desinteressiert daran."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ungesellig",
                                "target_lang_sense_clarification": "keine Gesellschaft suchend"
                            },
                            {
                                "target_lang_word": "kontaktarm",
                                "target_lang_sense_clarification": "wenig soziale Kontakte pflegend"
                            },
                            {
                                "target_lang_word": "zurückgezogen",
                                "target_lang_sense_clarification": "für sich lebend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "192c8997-52a3-34da-b367-b32bcb2fe84b",
                    "sense_definition": "Not social; not relating to or involving society.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "societal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued from an entirely <w>asocial</w> perspective, ignoring cultural and historical contexts.",
                            "target_lang_translations": {
                                "de": "Der Philosoph argumentierte aus einer völlig <w>nichtsozialen</w> Perspektive und ignorierte kulturelle sowie historische Kontexte."
                            }
                        },
                        {
                            "text": "Many theories assume an <w>asocial</w> state of nature before communal laws were introduced.",
                            "target_lang_translations": {
                                "de": "Viele Theorien gehen von einem <w>außersozialen</w> Naturzustand aus, bevor gemeinschaftliche Gesetze eingeführt wurden."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsocial"
                    ],
                    "antonyms": [
                        "social"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht sozial; die menschliche Gesellschaft oder das Zusammenleben nicht betreffend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nichtsozial",
                                "target_lang_sense_clarification": "die Gesellschaft nicht betreffend"
                            },
                            {
                                "target_lang_word": "außersozial",
                                "target_lang_sense_clarification": "außerhalb gesellschaftlicher Zusammenhänge stehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d7c429-b663-3f67-ad95-134e0b7a7a88",
                    "sense_definition": "Actively opposed to the laws and moral standards of society; antisocial.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deviance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities punished what they classified as <w>asocial</w> actions against the state.",
                            "target_lang_translations": {
                                "de": "Die Behörden bestraften Handlungen, die sie als <w>asozial</w> gegenüber dem Staat einstuften."
                            }
                        },
                        {
                            "text": "The criminologist studied whether childhood neglect leads to dangerously <w>asocial</w> conduct in adulthood.",
                            "target_lang_translations": {
                                "de": "Der Kriminologe untersuchte, ob Vernachlässigung in der Kindheit zu gefährlich <w>antisozialem</w> Verhalten im Erwachsenenalter führt."
                            }
                        }
                    ],
                    "synonyms": [
                        "antisocial"
                    ],
                    "antonyms": [
                        "prosocial"
                    ],
                    "common_phrases": [
                        "asocial conduct"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Gesetzen und moralischen Normen der Gesellschaft aktiv zuwiderlaufend; antisozial."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "asozial",
                                "target_lang_sense_clarification": "gemeinschaftsschädigend, gesellschaftswidrig"
                            },
                            {
                                "target_lang_word": "antisozial",
                                "target_lang_sense_clarification": "gegen gesellschaftliche Normen gerichtet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e93581c-8eba-3dcf-8603-b39aa925ab74",
                    "sense_definition": "A person deemed antisocial or uncooperative with societal norms, especially as a classification under the Nazi regime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During World War II, many individuals deemed to be an <w>asocial</w> were imprisoned in concentration camps.",
                            "target_lang_translations": {
                                "de": "Während des Zweiten Weltkriegs wurden viele Personen, die als <w>Asoziale</w> galten, in Konzentrationslagern inhaftiert."
                            }
                        },
                        {
                            "text": "The totalitarian government branded vagrants, beggars, and non-conformists as dangerous <w>asocials</w>.",
                            "target_lang_translations": {
                                "de": "Das totalitäre Regime stempelte Landstreicher, Bettler und Nonkonformisten als gefährliche <w>Asoziale</w> ab."
                            }
                        }
                    ],
                    "synonyms": [
                        "misfit",
                        "outcast"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die als gemeinschaftsunfähig oder normabweichend eingestuft wurde, insbesondere als NS-Kategorie."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Asozialer",
                                "target_lang_sense_clarification": "historisch, insbesondere im Nationalsozialismus"
                            },
                            {
                                "target_lang_word": "Gemeinschaftsfremder",
                                "target_lang_sense_clarification": "historische NS-Bezeichnung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}