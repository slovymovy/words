                {
                    "sense_id": "72cac962-0524-3770-8754-557009b1bb75",
                    "sense_definition": "Manifestation faible, début ou indice passager d'un sentiment ou d'une idée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette annonce inattendue a redonné une <w>lueur</w> d'espoir à toute la famille.",
                            "target_lang_translations": {
                                "en": "This unexpected announcement gave the whole family a renewed <w>glimmer</w> of hope.",
                                "ru": "Это неожиданное объявление вновь подарило всей семье <w>проблеск</w> надежды.",
                                "nl": "Deze onverwachte aankondiging gaf de hele familie weer een <w>sprankje</w> hoop.",
                                "de": "Diese unerwartete Ankündigung schenkte der ganzen Familie wieder einen <w>Schimmer</w> Hoffnung.",
                                "pl": "To nieoczekiwane ogłoszenie przywróciło całej rodzinie <w>iskierkę</w> nadziei.",
                                "it": "Questo annuncio inatteso ha ridato un <w>barlume</w> di speranza a tutta la famiglia.",
                                "cs": "Toto nečekané oznámení dalo celé rodině opět <w>záblesk</w> naděje.",
                                "tr": "Bu beklenmedik duyuru, tüm aileye yeniden bir umut <w>kıvılcımı</w> yaktı.",
                                "es": "Este anuncio inesperado devolvió a toda la familia un <w>atisbo</w> de esperanza.",
                                "zh": "这个出人意料的消息，让全家人重新看到了希望的<w>曙光</w>。"
                            }
                        },
                        {
                            "text": "Une <w>lueur</w> d'intelligence a brillé dans son regard lorsqu'il a enfin compris l'exercice.",
                            "target_lang_translations": {
                                "en": "A <w>gleam</w> of intelligence shone in his eyes when he finally understood the exercise.",
                                "ru": "В его взгляде мелькнул <w>проблеск</w> ума, когда он наконец понял задание.",
                                "nl": "Er flonkerde een <w>vleugje</w> intelligentie in zijn blik toen hij de oefening eindelijk begreep.",
                                "de": "In seinem Blick blitzte ein <w>Anflug</w> von Intelligenz auf, als er die Aufgabe endlich verstanden hatte.",
                                "pl": "W jego spojrzeniu pojawił się <w>przebłysk</w> inteligencji, gdy wreszcie zrozumiał zadanie.",
                                "it": "Un <w>lampo</w> d'intelligenza gli brillò nello sguardo quando finalmente ha capito l'esercizio.",
                                "cs": "V jeho pohledu se mihl <w>záblesk</w> inteligence, když konečně pochopil úlohu.",
                                "tr": "Alıştırmayı sonunda anladığında gözlerinde zekânın bir <w>kıvılcımı</w> parladı.",
                                "es": "Un <w>destello</w> de inteligencia brilló en su mirada cuando por fin comprendió el ejercicio.",
                                "zh": "他终于看懂了这道题，眼中闪过一丝智慧的<w>迹象</w>。"
                            }
                        }
                    ],
