                    "sense_id": "a6bbb545-c1ee-3256-9958-7d17a423d853",
                    "sense_definition": "Een versiersel of decoratie die dient om iets of iemand mooier te maken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "versiering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koningin droeg een prachtige <w>tooi</w> van veren op haar hoofd tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "The queen wore a beautiful <w>headdress</w> of feathers on her head during the ceremony."
                            }
                        },
                        {
                            "text": "In de herfst verliest de boom langzaam zijn kleurrijke <w>tooi</w>.",
                            "target_lang_translations": {
                                "en": "In autumn, the tree slowly loses its colorful <w>foliage</w>."
                            }
