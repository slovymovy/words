        "ru-extract.jsonl": [
            {
                "entry_id": "1074c453-e02b-38d4-b65e-c2a11697e651",
                "word": "Власов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ee89b46-df29-3513-96c9-bdf0fd19c678",
                        "entry_id": "1074c453-e02b-38d4-b65e-c2a11697e651",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4654116-28f7-43a5-aff4-68c59d032cc1",
                                "sense_id": "2ee89b46-df29-3513-96c9-bdf0fd19c678",
                                "text": "Власов в годы Второй Мировой войны был генерал-лейтенантом Красной армии, командующим 2-й ударной армии, был награждён высшей советской наградой — орденом Ленина. После пленения вермахтом он возглавил коллаборационистскую Русскую освободительную армию, а в 1946 году был казнён в Москве по обвинению в государственной измене."
                            },
                            {
                                "example_id": "ea7edba1-ae25-482a-b598-a172cdab891c",
                                "sense_id": "2ee89b46-df29-3513-96c9-bdf0fd19c678",
                                "text": "В субботу, 13 февраля, в Москве скончался олимпийский чемпион по тяжёлой атлетике Юрий Власов. Ему было 85 лет. Об этом сообщили российские СМИ."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
