{
    "word_family": [
        "прошлый",
        "прошлогодний",
        "пройти",
        "проходить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e28a0a67-f8f4-39f1-873e-16d1e4e53a39",
                    "sense_definition": "Время, события или переживания, которые уже прошли, минули.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы часто с теплотой вспоминаем наше общее счастливое <w>прошлое</w>.",
                            "target_lang_translations": {
                                "en": "We often remember our shared happy <w>past</w> with warmth."
                            }
                        },
                        {
                            "text": "Нужно уметь отпускать <w>прошлое</w> и с уверенностью смотреть вперед.",
                            "target_lang_translations": {
                                "en": "One must know how to let go of the <w>past</w> and look forward with confidence."
                            }
                        }
                    ],
                    "synonyms": [
                        "былое"
                    ],
                    "antonyms": [
                        "будущее"
                    ],
                    "common_phrases": [
                        "вернуться в прошлое",
                        "остаться в прошлом",
                        "взгляд в прошлое"
                    ],
                    "target_lang_definitions": {
                        "en": "Time, events, or experiences that have already happened or gone by."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "past",
                                "target_lang_sense_clarification": "the period of time before the present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9572a7d-294d-3d5e-b975-a1fc3a3fcd93",
                    "sense_definition": "Прежняя жизнь человека, часто связанная с предосудительными поступками или тайнами.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "биография",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он старался начать новую жизнь и скрыть от всех свое темное <w>прошлое</w>.",
                            "target_lang_translations": {
                                "en": "He tried to start a new life and hide his dark <w>past</w> from everyone."
                            }
                        },
                        {
                            "text": "Человек с таким подозрительным <w>прошлым</w> вряд ли получит эту должность.",
                            "target_lang_translations": {
                                "en": "A person with such a suspicious <w>past</w> is unlikely to get this position."
                            }
                        }
                    ],
                    "common_phrases": [
                        "темное прошлое",
                        "человек с прошлым",
                        "забыть свое прошлое"
                    ],
                    "target_lang_definitions": {
                        "en": "A person's earlier life, often associated with disreputable deeds, questionable history, or secrets."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "past",
                                "target_lang_sense_clarification": "earlier life, often scandalous or secretive"
                            },
                            {
                                "target_lang_word": "background",
                                "target_lang_sense_clarification": "personal history"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "18aa5e51-0601-3974-85b8-b8857aa852b1",
                    "sense_definition": "Форма именительного или винительного падежа среднего рода единственного числа прилагательного <w>прошлый</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все это странное происшествие уже ушло в <w>прошлое</w> лето.",
                            "target_lang_translations": {
                                "en": "This entire strange incident already faded into <w>last</w> summer."
                            }
                        },
                        {
                            "text": "Мое <w>прошлое</w> решение оказалось совершенно правильным в этой ситуации.",
                            "target_lang_translations": {
                                "en": "My <w>previous</w> decision turned out to be completely right in this situation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Nominative or accusative neuter singular form of the adjective прошлый (past, previous, last)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "past",
                                "target_lang_sense_clarification": "previous, elapsed"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "most recent (of a season, period, etc.)"
                            },
                            {
                                "target_lang_word": "previous",
                                "target_lang_sense_clarification": "earlier, preceding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}