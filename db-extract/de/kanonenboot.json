                    {
                        "form_id": "9466c6bc-f324-4378-b7d9-c1f561b41b21",
                        "entry_id": "6a3d39e7-0e91-3e5e-b87a-30ece45d0d2c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kanonenboote"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                        "entry_id": "6a3d39e7-0e91-3e5e-b87a-30ece45d0d2c",
                        "glosses": [
                            "relativ kleines, mit Kanonen bewaffnetes Kriegsschiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6df51a-1d8c-4578-ac3a-b8063ae0966d",
                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                "text": "„Die Zeit der Kanonenboote ist vorbei, auch wenn einige Nationen tatsächlich Schiffe in Marsch setzen.“"
                            },
                            {
                                "example_id": "b63c0c16-1f53-426b-8aa4-948ddffe37bb",
                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                "text": "„In der Hoffnung, über den Mekong den lukrativen chinesischen Markt zu erschließen, entsandte Kaiser Napoleon III. Kanonenboote nach Vietnam.“"
                            },
                            {
                                "example_id": "8a0047d1-fe1c-4b0a-bb63-7f900f12524b",
                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                "text": "„Kanonenboote dringen sogar in brasilianische Häfen ein, um die Regierung der ehemaligen portugiesischen Kolonie zur Beendigung des Sklavenhandels zu zwingen.“"
                            },
                            {
                                "example_id": "766b0821-df15-4300-8bc1-a4bd24e666e9",
                                "sense_id": "0f04ac75-f441-36d3-8adc-42cb2b699205",
                                "text": "„Als wir Samdy Hook erreichten, wurden wir von einem Kanonenboot begrüßt und hörten vom »kleinen Embargo«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17efd444-5b09-486e-ab82-158522972d54",
                        "source_entry_id": "6a3d39e7-0e91-3e5e-b87a-30ece45d0d2c",
