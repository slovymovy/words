                "senses": [
                    {
                        "sense_id": "dbb59931-1d55-3de0-94a5-fc6506718a39",
                        "entry_id": "a4cf3d07-eccd-3ad8-9f1b-d826f03f187c",
                        "glosses": [
                            "(insbesondere nicht-priesterliche) Person, die einen Gottesdienst zelebriert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c780460e-6733-499b-85a0-f2d449cc7702",
                                "sense_id": "dbb59931-1d55-3de0-94a5-fc6506718a39",
                                "text": "„Es wäre aber offenkundig naiv zu glauben, dass diese Grenze genau zwischen den ‚einfachen Gläubigen‘ auf der einen Seite und dem Klerus und den übrigen hauptberuflichen Gottesdienstleitern auf der anderen Seite verläuft.“"
                            },
                            {
                                "example_id": "46a4d8fb-469d-4787-9e37-12205d76d8ef",
                                "sense_id": "dbb59931-1d55-3de0-94a5-fc6506718a39",
                                "text": "„Ergänzend zum liturgischen Dienst werden ehrenamtliche Gottesdienstleiter ausgebildet.“"
                            },
                            {
                                "example_id": "181a1b79-1564-4e34-92b9-b53875853c24",
                                "sense_id": "dbb59931-1d55-3de0-94a5-fc6506718a39",
                                "text": "„C. 1248 § 2 empfiehlt ebenfalls solche Gottesdienste. Daraufhin wurden in vielen Diözesen der Weltkirche Laien als Gottesdienstleiter ausgebildet und erhielten vom Bischof die entsprechende Beauftragung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06d67cd5-d9aa-425f-a292-055bead43d0e",
                        "source_entry_id": "a4cf3d07-eccd-3ad8-9f1b-d826f03f187c",
                        "source_sense_id": "dbb59931-1d55-3de0-94a5-fc6506718a39",
                        "source_sense_description": "jemand, der einen Gottesdienst zelebriert",
                        "target_lang_word": "célébrant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célébrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53dc751a-03df-3112-91c0-ae6264160b07",
                                        "entry_id": "53bd32f8-e56d-3bd4-bdb6-e7dba64ef489",
                                        "glosses": [
                                            "Celui qui célèbre la messe ou qui officie."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56ee970-fd83-41df-ad87-09e30935e4c5",
                                                "sense_id": "53dc751a-03df-3112-91c0-ae6264160b07",
                                                "text": "Au moment où le célébrant, qui priait d’une voix très haute, prononçait les paroles de l’Offertoire : Ne cadant in obscurum, l’un des auditeurs du premier rang eut la jambe frappée d’une balle et tomba par terre avec une précision liturgique, sans troubler d’un cri le recueillement de ses camarades."
                                            },
                                            {
                                                "example_id": "28e55cec-5c8a-4b95-94e1-b9b8389b226f",
                                                "sense_id": "53dc751a-03df-3112-91c0-ae6264160b07",
                                                "text": "Pendant l’offertoire, le roi, et en son absence la reine, était encensé immédiatement après le célébrant."
                                            },
                                            {
                                                "example_id": "2fb9f24d-d858-4c19-9f90-9b1284b3dd30",
                                                "sense_id": "53dc751a-03df-3112-91c0-ae6264160b07",
                                                "text": "Tout à coup, dominant les mornes intonations du célébrant, s’éleva la voix de Villegagnon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "célébrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a066e946-d0d4-3313-aed4-ffb4f3d56d6e",
                                        "entry_id": "e89382e4-0aaf-3b92-8fc7-79400b7d1a09",
                                        "glosses": [
                                            "Participe présent du verbe célébrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24692a13-0ba8-4b75-9ff5-9dab5979edab",
                                                "sense_id": "a066e946-d0d4-3313-aed4-ffb4f3d56d6e",
                                                "text": "La liturgie que le protestantisme eut le tort de « prosaïquer » y connaîtra une reviviscence inimaginable sous la forme d’une englobante « sociurgie » : une société se fêtant et se célébrant elle-même non pas dans un culte de possession, mais le culte de sa prise de possession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22130008-c855-409f-9588-e5b6d4597742",
                        "source_entry_id": "a4cf3d07-eccd-3ad8-9f1b-d826f03f187c",
