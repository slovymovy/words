                ],
                "senses": [
                    {
                        "sense_id": "cc940a2f-49a7-305d-aeb7-9717e92d455c",
                        "entry_id": "9b484210-784d-3910-9a6b-b6abc3181b07",
                        "glosses": [
                            "Gesamtheit der Maßnahmen zur Prävention, Diagnostik und Therapie von plaquebedingten Erkrankungen sowie kariesbedingten und nicht kariesbedingten Schäden der Zähne, um einen Zahn zu erhalten oder wiederherzustellen, ohne ihn durch ein künstliches Produkt zu ersetzen"
                        ],
                        "tags": [
                            "Zahnmedizin",
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "5c52ff32-916f-4fb5-bbab-6bd812565750",
                                "sense_id": "cc940a2f-49a7-305d-aeb7-9717e92d455c",
                                "text": "Die Deutsche Gesellschaft für Zahnerhaltung (DGZ) als oberste Fachgesellschaft steht im Verbund mit drei Fachgesellschaften, die alle Bereiche der Zahnerhaltung eigenständig vertreten, der Deutschen Gesellschaft für Präventivzahnmedizin (DGPZM), der Deutschen Gesellschaft für Restaurative und Regenerative Zahnerhaltung (DGR²Z) und der Deutschen Gesellschaft für Endodontologie und zahnärztliche Traumatologie (DGET)."
                            },
                            {
                                "example_id": "4e056749-5386-4818-9619-006acc476edc",
                                "sense_id": "cc940a2f-49a7-305d-aeb7-9717e92d455c",
                                "text": "„Ebenfalls großes Interesse zeigte das Publikum auch an Informationen über Hautkrebsscreening, Schutzimpfungen, Gesundheitschecks, Stimm- und Sprachbehandlungen, Heilkräuter, Nahrungsergänzungsprodukten und Zahnerhaltungen sowie Implantaten.“"
                            },
                            {
                                "example_id": "efb23810-1320-4c24-89b5-eb9002dd6593",
                                "sense_id": "cc940a2f-49a7-305d-aeb7-9717e92d455c",
                                "text": "„Es gibt in Deutschland nur sechs eigenständige, parodontologische Abteilungen (Münster, Gießen, Frankfurt am Main, Marburg, Dresden, Witten/ Herdecke) und zwei Zahnerhaltungen unter parodontologischer Führung (Bonn und Kiel).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
