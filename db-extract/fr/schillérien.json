                "senses": [
                    {
                        "sense_id": "caef8699-d2b2-3480-9a95-f7eb43b3fb3f",
                        "entry_id": "a3d1ae07-c063-3233-b98b-1b09aefbc9fd",
                        "glosses": [
                            "Qui découle ou s’apparente à la pensée de Friedrich von Schiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4adbb687-b588-455e-bd57-8cf70dc81629",
                                "sense_id": "caef8699-d2b2-3480-9a95-f7eb43b3fb3f",
                                "text": "Il en est toujours ainsi avec les belles âmes schillériennes : jusqu’au dernier moment, elles parent les hommes de plumes de paon, jusqu’au dernier moment elles misent sur le bien, et non sur le mal et, tout en soupçonnant que la médaille a un revers, pour rien au monde elles se l’avoueront à l’avance"
                            },
                            {
                                "example_id": "3031005c-0a6f-4451-8de6-bc1d56cb0831",
                                "sense_id": "caef8699-d2b2-3480-9a95-f7eb43b3fb3f",
                                "text": "La pensée pascalienne et schillérienne sur la frêle et auguste condition de l’homme est un des emprunts les plus certains qui, par Schopenhauer, aient passé à Nietzsche."
                            }
                        ]
                    }
                ],
