                        "entry_id": "85f8e109-5938-363d-8c0a-823cd481fcb4",
                        "glosses": [
                            "Habitant du Bénin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "110e1e05-6048-49cb-adac-07b6df69790e",
                                "sense_id": "f36eb418-f335-3109-8bf3-75bd58d5822b",
                                "text": "Quelque vaste que soit ce Royaume [de Benin], le plus grand de toute la Guinée, puisqu’il renferme nombre d’autres petits Royaumes qui sont tributaires du Roi de Benin […] Les Beninois, mieux civilisés que les autres Nations de la Guinée, ne se contenteroient pas de nos petites merceries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233b1859-ff61-48f8-9389-75946f7defc4",
                        "source_entry_id": "85f8e109-5938-363d-8c0a-823cd481fcb4",
                        "source_sense_id": "f36eb418-f335-3109-8bf3-75bd58d5822b",
