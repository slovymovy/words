                        "examples": [
                            {
                                "example_id": "a56e6973-2566-4aea-ae9e-4998a6bf4a06",
                                "sense_id": "7464dcf6-3b1f-325b-b982-d7bdb9760b49",
                                "text": "Nach dem Hochwasser flutete das Wasser schneller ab als gedacht."
                            },
                            {
                                "example_id": "faef3d08-744d-4fdd-aa87-a32638895387",
                                "sense_id": "7464dcf6-3b1f-325b-b982-d7bdb9760b49",
                                "text": "Das Konzert war vorbei und die Menschenmasse flutete ab.",
                                "translation": "metaphorisch:"
                            },
                            {
                                "example_id": "8f2d8b05-2e23-4b0c-90ff-a64847776682",
                                "sense_id": "7464dcf6-3b1f-325b-b982-d7bdb9760b49",
                                "text": "Und das Wasser sprach: „Achtung, jetzt flute ich ab!“"
                            }
                        ],
