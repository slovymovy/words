                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gyros",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                        "entry_id": "5ae734bb-aa01-3354-8bde-81367d8852a6",
                                        "glosses": [
                                            "griechisches Fleischgericht, bei dem am drehenden Spieß gegrilltes und nach und nach in kleinen, fertig gegarten Stücken abgeschnittenes Fleisch mit jeweils unterschiedlichen Beilagen auf dem Teller serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77cbf22-6589-4da8-a5b4-0d3fe2573c7a",
                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "Gyros schmeckt am besten mit Zaziki."
                                            },
                                            {
                                                "example_id": "0506aed5-be3d-4d2e-b5d7-b93a2d32f1fd",
                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "„‚Guten Appetit. Ich habe meinen schon unterwegs gegessen. Hoffentlich macht es dir nichts aus?‘ fragte Jessica und sah Celine an, wie sie hastig den Gyros aß.“"
                                            },
                                            {
                                                "example_id": "f842960a-b9ba-4cb9-8410-d9465c881240",
                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "„Pat schaute entgeistert: ‚Hast du den Gyros nicht vertragen?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c367cb0-7ea7-3b26-b0c1-939615725282",
                                        "entry_id": "5ae734bb-aa01-3354-8bde-81367d8852a6",
                                        "glosses": [
                                            "von „Gyros Pita“, einem unter Verwendung von [1] zubereitetem Fast-Food-Gericht, bei dem das Fleisch zusammen mit Gemüse und Soße, eingewickelt in einem Fladenbrot („Pita“) dargereicht wird."
                                        ],
