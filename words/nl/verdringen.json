{
    "word_family": [
        "dringen",
        "verdringing",
        "opdringen",
        "doordringen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78603c63-716b-3178-ab6f-9237580d7303",
                    "sense_definition": "ervoor zorgen dat er voor anderen geen plaats meer is door hun positie in te nemen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De door de Europeanen ingevoerde ratten, katten en varkens hebben veel inheemse diersoorten <w>verdrongen</w>.",
                            "target_lang_translations": {
                                "en": "The rats, cats, and pigs introduced by Europeans have <w>displaced</w> many native species."
                            }
                        },
                        {
                            "text": "Nieuwe technologieën zullen de oude methoden op de markt snel <w>verdringen</w>.",
                            "target_lang_translations": {
                                "en": "New technologies will quickly <w>supplant</w> the old methods in the market."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervangen",
                        "verstoten",
                        "verjagen"
                    ],
                    "common_phrases": [
                        "van de markt verdringen",
                        "elkaar verdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To take the place of someone or something, often by force or competition, leaving no room for the original."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "displace",
                                "target_lang_sense_clarification": "to take over the position of something"
                            },
                            {
                                "target_lang_word": "supplant",
                                "target_lang_sense_clarification": "to replace something, especially by force or strategy"
                            },
                            {
                                "target_lang_word": "crowd out",
                                "target_lang_sense_clarification": "to force something out by taking up all the space or resources"
                            },
                            {
                                "target_lang_word": "oust",
                                "target_lang_sense_clarification": "to drive out or expel from a position"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f668bec-6e8f-3f65-b4da-0bfcce4a9985",
                    "sense_definition": "het onbewust wegstoppen van pijnlijke herinneringen of gevoelens uit het bewustzijn",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde de nare herinneringen aan het ongeluk te <w>verdringen</w> door hard te werken.",
                            "target_lang_translations": {
                                "en": "He tried to <w>repress</w> the unpleasant memories of the accident by working hard."
                            }
                        },
                        {
                            "text": "Het is niet gezond om je emoties constant te <w>verdringen</w> in plaats van ze te uiten.",
                            "target_lang_translations": {
                                "en": "It is not healthy to constantly <w>suppress</w> your emotions instead of expressing them."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderdrukken",
                        "wegstoppen"
                    ],
                    "antonyms": [
                        "uiten",
                        "verwerken"
                    ],
                    "common_phrases": [
                        "herinneringen verdringen",
                        "gevoelens verdringen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychologische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The unconscious process of pushing painful memories or feelings out of the conscious mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repress",
                                "target_lang_sense_clarification": "to block painful thoughts or feelings from the mind"
                            },
                            {
                                "target_lang_word": "suppress",
                                "target_lang_sense_clarification": "to consciously or unconsciously push down emotions"
                            },
                            {
                                "target_lang_word": "push away",
                                "target_lang_sense_clarification": "to try not to think about something unpleasant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb9434f-70bd-32d5-a3ad-d704782722d5",
                    "sense_definition": "iemand of iets met fysieke kracht opzij duwen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "duwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte probeerde de bewakers bij de ingang te <w>verdringen</w>.",
                            "target_lang_translations": {
                                "en": "The crowd tried to <w>push aside</w> the guards at the entrance."
                            }
                        },
                        {
                            "text": "Met veel moeite wist hij de zware kast een stukje te <w>verdringen</w>.",
                            "target_lang_translations": {
                                "en": "With great effort, he managed to <w>dislodge</w> the heavy cabinet a little bit."
                            }
                        }
                    ],
                    "synonyms": [
                        "opzijduwen",
                        "wegduwen"
                    ],
                    "common_phrases": [
                        "opzij verdringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To push someone or something aside using physical force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "push aside",
                                "target_lang_sense_clarification": "to move someone or something out of the way"
                            },
                            {
                                "target_lang_word": "shove",
                                "target_lang_sense_clarification": "to push roughly"
                            },
                            {
                                "target_lang_word": "dislodge",
                                "target_lang_sense_clarification": "to force something out of its fixed position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}