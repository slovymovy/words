                        "sense_id": "f74b99cc-53a8-3ada-95e6-1e0b83721d7d",
                        "entry_id": "37ff7b3b-f7f1-3a21-a5eb-cdab427949a1",
                        "glosses": [
                            "That does not break; unbreakable or unbroken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04aab192-5117-4ee2-b31f-10fcded6309e",
                                "sense_id": "f74b99cc-53a8-3ada-95e6-1e0b83721d7d",
                                "text": "Their sorry tragedy is cleared away from the universe, and at the end comes in that strange consciousness of the unbreaking perpetual stream of life which makes every tragedy bearable."
                            },
                            {
                                "example_id": "fb76bb1d-e254-4ff1-a0f9-26a4303a26f7",
                                "sense_id": "f74b99cc-53a8-3ada-95e6-1e0b83721d7d",
                                "text": "The river snaked through the forest, and they travelled on hour after hour, through an unbreaking monotony of green."
                            },
                            {
                                "example_id": "ccd1decf-3c87-41ea-81d8-ce75efcb3394",
                                "sense_id": "f74b99cc-53a8-3ada-95e6-1e0b83721d7d",
                                "text": "At evening, another meal and catheter emptying followed by more television watching until “lights out.” Each new day was a boring and monotonous extension of the previous day—eat, watch TV, sleep—in an unbreaking, sickening cycle."
                            }
                        ]
                    }
