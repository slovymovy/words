                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wound",
                                "target_lang_sense_clarification": "a physical injury, especially one where the skin is broken"
                            },
                            {
                                "target_lang_word": "injury",
                                "target_lang_sense_clarification": "general damage to the body"
                            },
                            {
                                "target_lang_word": "sore",
                                "target_lang_sense_clarification": "a raw or painful place on the body"
                            }
