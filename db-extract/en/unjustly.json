                        "examples": [
                            {
                                "example_id": "5ab8eb15-d7f9-4ecb-a6e2-fbde5f4ab02d",
                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                "text": "unjustly punished"
                            },
                            {
                                "example_id": "1799e7df-846a-4574-ae2b-8a3562b214ca",
                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                "text": "Nowe is iuſte iuſtice, ſo iotted out of iointe, / That ye here vniuſtely, ſtande at deniall, / To do me iuſtice, and wolde by power ryall: / Directe mine acquitall or condemnacion, / Euen as wyll in both: weith your acceptacion."
                            },
                            {
                                "example_id": "8f338d52-3c46-48bc-806d-023ea49035a7",
                                "sense_id": "22e41e80-4c28-325e-ae4d-daf44de898c4",
                                "text": "I am satisfied that there are many convicts in this prison unprovenly or unjustly confined, and that should have relief."
                            }
                        ]
                    }
                ],
