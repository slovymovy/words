                "translations": [
                    {
                        "translation_id": "d0f210da-4d2e-4163-888e-e8bce1b51ea7",
                        "source_entry_id": "db542934-f983-3d24-b921-9d3ceb113748",
                        "source_sense_description": "to divide into, form or create a network",
                        "target_lang_word": "vernetzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernetzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7b959a-f75a-342a-9263-3e7e7edfa703",
                                        "entry_id": "7abd2e71-6e49-349d-b142-1d153c49713b",
                                        "glosses": [
                                            "mehrere Elemente miteinander verbinden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785f728b-7f26-4b40-936b-60647ac7c8d7",
                                                "sense_id": "ed7b959a-f75a-342a-9263-3e7e7edfa703",
                                                "text": "Seid ihr gut vernetzt?"
                                            },
                                            {
                                                "example_id": "46428c36-d382-4a10-99e6-a000d24e3922",
                                                "sense_id": "ed7b959a-f75a-342a-9263-3e7e7edfa703",
                                                "text": "Ernst-Heinrich vernetzt sich über soziale Netzwerke."
                                            },
                                            {
                                                "example_id": "e6267866-885d-45b7-869c-ed792bb230cc",
                                                "sense_id": "ed7b959a-f75a-342a-9263-3e7e7edfa703",
                                                "text": "Einer ist 26 Jahre alt, hat einen Universitätsabschluss, ist Mitglied mehrerer Burschenschaften und bestens vernetzt: Philip Stein."
                                            },
                                            {
                                                "example_id": "092df2d1-1694-448a-b2aa-886cf45a2eb0",
                                                "sense_id": "ed7b959a-f75a-342a-9263-3e7e7edfa703",
                                                "text": "Dieser parlamentarische Abend ist ein guter Baustein, um ins Gespräch zu kommen, sich enger zu vernetzen und damit die Region weiter voranzubringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32bd1ce1-dce1-3c51-b70e-4289acc24c51",
                                        "entry_id": "7abd2e71-6e49-349d-b142-1d153c49713b",
                                        "glosses": [
                                            "Moleküle zu einer netzartigen Struktur verknüpfen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb96e329-b3c5-47a2-a167-57e79183bde3",
                                                "sense_id": "32bd1ce1-dce1-3c51-b70e-4289acc24c51",
                                                "text": "Man stellt duroplastische Werkstoffe häufig aus thermoplastischen Vorstufen her, die während oder nach der Formgebung durch chemische Reaktionen und teilweise unter zusätzlicher Wärmezufuhr vernetzt werden."
                                            },
                                            {
                                                "example_id": "7bf30c05-558c-4680-ad56-3e959ded2c15",
                                                "sense_id": "32bd1ce1-dce1-3c51-b70e-4289acc24c51",
                                                "text": "Härtbare Harze enthalten reaktionsfähige Gruppen, die untereinander vernetzen können (härten bzw. vulkanisieren)."
                                            },
                                            {
                                                "example_id": "f1304155-014a-444f-99ea-837fbd7e1586",
                                                "sense_id": "32bd1ce1-dce1-3c51-b70e-4289acc24c51",
                                                "text": "Erst oberhalb 60% Gelanteil berühren sich die Gelpartikel und vernetzen untereinander."
                                            },
                                            {
                                                "example_id": "8952ead8-8383-492e-960b-354bad2ceeff",
                                                "sense_id": "32bd1ce1-dce1-3c51-b70e-4289acc24c51",
                                                "text": "Aber auch Negativresists, die durch hochenergetische Strahlung vernetzen, kommen zum Einsatz (Schenk97)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
