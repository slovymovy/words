                    {
                        "form_id": "0157c0bc-4a4f-4152-a320-14214d4e0957",
                        "entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Verlass"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d9795e6-261e-3a75-bf73-e45be94484db",
                        "entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "glosses": [
                            "Überzeugung, dass man vertrauen kann, sich verlassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e43ee95-dbcb-4b0b-ad81-1f42e0dba2ca",
                                "sense_id": "7d9795e6-261e-3a75-bf73-e45be94484db",
                                "text": "„Er war ein alter Freund, insbesondere in den ersten Monaten des Studiums auch ein Vertrauter, auf ihn war Verlass, stets Verlass, bis heute, sie war nicht umsonst hier, bei ihm.“"
                            },
                            {
                                "example_id": "25d4cccf-b2cb-448c-acc8-b32deb30170b",
                                "sense_id": "7d9795e6-261e-3a75-bf73-e45be94484db",
                                "text": "Auf die Bahn ist Verlass."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c83e0061-63f5-33a9-8ff3-55b967974d59",
                        "entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "glosses": [
                            "Nachlass, Hinterlassenschaft"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3993f73f-8108-4bfb-a778-c3f954628388",
                                "sense_id": "c83e0061-63f5-33a9-8ff3-55b967974d59",
                                "text": "„Für die Pupillin Anna Knar, welche aus dem Verlasse nach Cäcilia Höfler 50 fl. zu bekommen hatte, wurden über Einmahnung des Verlaßschuldners Mathias Schirmhofer von diesem […] 51 f. 45 kr. bezahlt.“ (1867)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1b424992-4201-3f79-90ac-b7eecc277694",
                        "entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "glosses": [
                            "Vertrag, Absprache"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1b5ea3b0-054c-4134-a722-8284ca20ab2e",
                                "sense_id": "1b424992-4201-3f79-90ac-b7eecc277694",
                                "text": "„Darüber beschweren sich die übrigen Meister; doch der Rat entscheidet am 6. August 1527, dass es bei dem vorigen Verlass bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be09586e-8841-4e62-8880-72b52ec15e51",
                        "source_entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "source_sense_id": "7d9795e6-261e-3a75-bf73-e45be94484db",
                        "source_sense_description": "Überzeugung, dass man vertrauen kann, sich verlassen kann",
                        "target_lang_word": "certitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                        "entry_id": "f64254a1-fc58-3f2d-bcbb-75d8e815ab06",
                                        "glosses": [
                                            "Assurance pleine et entière d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f133845b-aff2-44dd-bcaf-baf1df112967",
                                                "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                                "text": "Dans l’esprit de nos dames, l’hypothèse eut tôt fait de se muer en certitude. Quoi d’étonnant à cela? Le sexe qui s'intitule intelligent n’agit guère d'autre façon ; voyez plutôt les dissertations savantes."
                                            },
                                            {
                                                "example_id": "deda776a-b0e3-4dc0-b10a-de1844ff29b2",
                                                "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                                "text": "Elle était la maîtresse de M. de Mériolle, et s’il n’en avait pas la preuve, il en avait au moins la certitude."
                                            },
                                            {
                                                "example_id": "89a36c37-b2cb-49f7-82e6-899b49225ebb",
                                                "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                                "text": "La jeunesse connaît ces privilèges : Qui saurait la confondre ? L'expérience, cette béquille pour éclopés de la vie, ne vient point alourdir le survol de ses certitudes."
                                            },
                                            {
                                                "example_id": "87ab5edb-7f24-4384-9764-42883f301be2",
                                                "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                                "text": "J’ai connu l'Amérique de la prospérité. J’ai connu cette confiance, cette certitude, cet orgueil. J’ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                                            },
                                            {
                                                "example_id": "0b1339d7-0dc1-4a8f-9a15-5013b2526387",
                                                "sense_id": "33eebbef-ea39-3a56-8579-fda0a1290c1f",
                                                "text": "Bientôt tes appels ne seront plus que rauquements de plus en plus sourds, beuglements de désespoir si fatigués qu'ils ne dépasseront plus ta gorge, étranglée de terreur par la furieuse certitude, la peur atroce et annihilante, la frayeur immonde de périr en Fagne : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa454da-a1a4-384a-876d-792acd580ece",
                                        "entry_id": "f64254a1-fc58-3f2d-bcbb-75d8e815ab06",
                                        "glosses": [
                                            "Adhésion forte et invincible de l’esprit à une chose qu’il reconnaît vraie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda54ba1-18d7-4085-85af-d538faa0ff95",
                                                "sense_id": "8fa454da-a1a4-384a-876d-792acd580ece",
                                                "text": "Ce qui est plus grave, c'est que, d’auteur en auteur, les hypothèses sont devenues des certitudes et l'on peut lire dans des ouvrages de vulgarisation les plus étonnantes affirmations, jamais vérifiées, jamais critiquées, prises un jour à la source du possible et entraînées depuis dans le flot de l’indiscutable."
                                            },
                                            {
                                                "example_id": "5013912b-ad12-4a78-b3cc-1338b779c839",
                                                "sense_id": "8fa454da-a1a4-384a-876d-792acd580ece",
                                                "text": "Certitude morale. Certitude mathématique. (Philosophie) La question de la certitude. Les bases de la certitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7e9ed44-68b0-3e45-bb1c-1d481699ae9f",
                                        "entry_id": "f64254a1-fc58-3f2d-bcbb-75d8e815ab06",
                                        "glosses": [
                                            "Stabilité, pérennité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f887efc9-c624-4077-a094-70d2327f7a6f",
                                                "sense_id": "c7e9ed44-68b0-3e45-bb1c-1d481699ae9f",
                                                "text": "Il n’y a nulle certitude dans les choses du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cf98718-d6c8-424d-b1b9-d3c34bdca05e",
                        "source_entry_id": "81572c6e-f3f1-30c0-abd6-950269edb623",
                        "source_sense_id": "7d9795e6-261e-3a75-bf73-e45be94484db",
                        "source_sense_description": "Überzeugung, dass man vertrauen kann, sich verlassen kann",
                        "target_lang_word": "confiance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confiance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                        "entry_id": "bcb82def-a2c9-33bb-83c9-10610cfadf95",
                                        "glosses": [
                                            "Sentiment de sécurité vis-à-vis de quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc89035-a289-4fce-bb89-3b7f0b449239",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "J’éprouvai pour cet officier une sympathique confiance qui s’accentua, dans la suite de nos rapports. La fréquentation des Danois a toujours provoqué chez moi des sentiments de même nature."
                                            },
                                            {
                                                "example_id": "096a2ee2-9a39-4e0c-8f33-1fd9500ef11f",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "Depuis son départ de Rejkjavik en Islande, le 9 août, on en est sans nouvelles, et malgré ma grande confiance en lui, je suis fort inquiet."
                                            },
                                            {
                                                "example_id": "63c4c062-47a5-459a-ad80-a2a691fad451",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "C’est avec de telles calembredaines que les prêtres s’imaginent piper la confiance des enfants à l’âge où, précisément, ils commencent à discerner qu’ils n’ont pas poussé dans les choux."
                                            },
                                            {
                                                "example_id": "eccf29d1-8dfc-4e02-a6c3-dd6beccd72fb",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "J’ai connu l’Amérique de la prospérité. J’ai connu cette confiance, cette certitude, cet orgueil. J’ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                                            },
                                            {
                                                "example_id": "2488d836-430b-4888-bc87-d64897a69e64",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "Nous les hommes des douars lointains, des hauts djebels, des larges vallées, nous savions que l’on ne bâtit pas sa maison si l’on n’a pas confiance dans la solidité du sol."
                                            },
                                            {
                                                "example_id": "2157528c-3e42-40f9-ba1f-809bbeba19b2",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "Les véritables écrivains (s’il en reste) jouent leur existence au jour le jour, ils ne peuvent faire confiance à personne, l’absence de futur assuré est leur loi."
                                            },
                                            {
                                                "example_id": "8f46f17c-f808-4250-affd-290fad9e7500",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "L’amîn est celui dont l’écriture, dans les contrats, actes et autres documents, fait foi. Il doit donc bénéficier de la confiance de toutes les parties."
                                            },
                                            {
                                                "example_id": "b0656aa1-78db-4d8d-bbd6-e6c73d9188c3",
                                                "sense_id": "7711c16e-fc2b-3a3b-b610-3fcc87b50a2a",
                                                "text": "La vision du (groupe) créateur de Bitcoin consistait à court-circuiter les problèmes des preneurs de décisions centralisés et a introduit un passage sans précédent du modèle basé sur la confiance à l’absence systémique de confiance. «Toutefois, cette tentative audacieuse de remplacer les humains par les mathématiques a mal calculé l’incalculable: la prédisposition de l’humanité à s’immiscer dans le processus, à le modifier, à le spolier, à le manipuler et à s’y immiscer», nuance Maxwell Short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b0ef6f-4e70-3d49-bee8-148e4562c606",
                                        "entry_id": "bcb82def-a2c9-33bb-83c9-10610cfadf95",
                                        "glosses": [
                                            "Assurance, hardiesse."
                                        ],
                                        "tags": [],
                                        "examples": [
