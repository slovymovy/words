                                                "sense_id": "85f2c845-9ea7-3918-8765-3cf0abf6a5bc",
                                                "text": "Katrina was de ergste ramp die New Orleans tot dusver overkomen is."
                                            },
                                            {
                                                "example_id": "466683f6-08bb-4953-afcc-7ead5d312b89",
                                                "sense_id": "85f2c845-9ea7-3918-8765-3cf0abf6a5bc",
                                                "text": "Wat is het toch erg dat ze kanker heeft."
                                            },
                                            {
                                                "example_id": "51c30da6-68eb-400d-b1ac-cae8e18d0897",
                                                "sense_id": "85f2c845-9ea7-3918-8765-3cf0abf6a5bc",
                                                "text": "Elke dag het ergste vuil eraf poetsen met een natte bandana of een plons in een rivier zijn meer dan voldoende om jezelf schoon te houden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "erg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75782233-b4a2-3982-865f-9f164865985f",
                                        "entry_id": "52e86065-a87a-361f-9ef8-c9956919fccf",
                                        "glosses": [
                                            "in hoge mate, danig, zeer, heel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6053f265-1ee8-4074-b3c1-ad16de39e82d",
                                                "sense_id": "75782233-b4a2-3982-865f-9f164865985f",
                                                "text": "Dit is een erg moeilijke zaak."
                                            },
                                            {
                                                "example_id": "edc3c3cf-7909-4239-9cf5-105cd530cc49",
                                                "sense_id": "75782233-b4a2-3982-865f-9f164865985f",
                                                "text": "Zelf moest ik ook erg nodig naar de wc, maar ik durfde na dit verhaal absoluut niet meer naar buiten."
                                            },
                                            {
                                                "example_id": "b5cfcf24-8daa-4740-98a0-9e68641928e8",
                                                "sense_id": "75782233-b4a2-3982-865f-9f164865985f",
                                                "text": "De VU laat aan de NOS weten te waarderen dat het werkveld erg betrokken is. \"De realiteit blijft echter dat de afdeling Aardwetenschappen langdurig te maken heeft met structurele financiële tekorten, ondanks eerdere reorganisaties en gedeeltelijk steun van andere afdelingen. Deze structurele tekorten zijn niet langer mogelijk gezien de bezuinigingsopgave waar we als faculteit, maar ook als universiteit in haar geheel, nu voor staan.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "erg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e6bd6d7-1832-3398-aba4-e8ab46de03e0",
                                        "entry_id": "170dc265-d8de-30f8-a740-1e7f0c9f3bd4",
                                        "glosses": [
                                            "het zich bewust zijn van iets; alleen voorkomend in de vaste uitdrukking geen erg hebben in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d47086-cee3-4bbd-b962-7412fd341183",
                                                "sense_id": "7e6bd6d7-1832-3398-aba4-e8ab46de03e0",
                                                "text": "Ik heb daar geen erg in gehad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e401900f-860d-3246-b34d-08c11d8ac258",
                                        "entry_id": "170dc265-d8de-30f8-a740-1e7f0c9f3bd4",
                                        "glosses": [
                                            "iets heel verschrikkelijks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7887edd-49ef-44fd-8ae2-c27808335c63",
                                                "sense_id": "e401900f-860d-3246-b34d-08c11d8ac258",
                                                "text": "Het allerergste van al die meelopers van Engeland en Sovjet-Rusland was dat ze totaal geen idee hadden van de gevaarlijke consequenties als Duitsland zou verliezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
