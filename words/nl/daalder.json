                {
                    "sense_id": "1434d2be-5284-3735-9f71-43515bf22a28",
                    "sense_definition": "Oude Nederlandse munt of rekeneenheid met een waarde van anderhalve gulden (f 1,50).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "muntwaarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de markt is je gulden een <w>daalder</w> waard.",
                            "target_lang_translations": {
                                "fr": "Au marché, ton florin vaut un <w>daldre</w>."
                            }
                        },
                        {
                            "text": "Mijn grootvader vertelde dat hij vroeger een <w>daalder</w> betaalde voor een warme maaltijd.",
                            "target_lang_translations": {
                                "fr": "Mon grand-père racontait qu'autrefois il payait un <w>daldre</w> pour un repas chaud."
                            }
                        }
                    ],
                    "common_phrases": [
