                "senses": [
                    {
                        "sense_id": "c637c831-16a7-32a8-8989-449c30148b74",
                        "entry_id": "1ffe0ae7-daa6-3554-b153-44b9ad534372",
                        "glosses": [
                            "kleiner doppelstöckiger Wagen zum Organisieren, Abstellen oder Transportieren von Speisen oder Geschirr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0ff5de-eac2-41c3-95eb-d9797e5af45a",
                                "sense_id": "c637c831-16a7-32a8-8989-449c30148b74",
                                "text": "„Von Papa hatte Mama einen Servierwagen gekriegt, einen Leifheit Regulus, den man zusammenklappen konnte.“"
                            },
                            {
                                "example_id": "84800b75-6a41-499f-a8dc-31a925508fe4",
                                "sense_id": "c637c831-16a7-32a8-8989-449c30148b74",
                                "text": "„Ich ging durch die Rezeption, in die alte Halle mit der Treppe, wo ein Kellner einen Servierwagen aus einem der Festsäle schob, dort wurden Konfirmationen und Hochzeiten gefeiert, Arrangements, die noch immer mit einem gewissen Stil durchgeführt werden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "711a4d22-24ea-4382-ac7b-8b1781cfff37",
                        "source_entry_id": "1ffe0ae7-daa6-3554-b153-44b9ad534372",
                        "source_sense_id": "c637c831-16a7-32a8-8989-449c30148b74",
                        "source_sense_description": "Wagen zum Servieren",
                        "target_lang_word": "table roulante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "table roulante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fe3d27c-eba3-3135-ac78-9c465e7d8996",
                                        "entry_id": "6a58f491-03e0-3415-bd7b-1d7dece225fe",
                                        "glosses": [
                                            "Table montée sur roulettes destinée à véhiculer des objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa90e177-5a4f-40d2-8a7b-d1638a8995b9",
                                                "sense_id": "7fe3d27c-eba3-3135-ac78-9c465e7d8996",
                                                "text": "Quatre fois par jour on amenait dans la chambre une table roulante chargée de bandages, de gazes, de linge, de ouate, de sparadrap, de boîtes en fer, de cuvettes, de ciseaux ; je détournais soigneusement les yeux quand elle ressortait de la pièce."
                                            },
                                            {
                                                "example_id": "10311547-ca1d-4f04-8028-6285c4415ea5",
                                                "sense_id": "7fe3d27c-eba3-3135-ac78-9c465e7d8996",
                                                "text": "La sage-femme arrive cette fois avec une table roulante chargée de boîtes métalliques et d’instruments qui tintent les uns contre les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff301996-3ae4-460e-b71c-1457728195a2",
                        "source_entry_id": "1ffe0ae7-daa6-3554-b153-44b9ad534372",
                        "source_sense_id": "c637c831-16a7-32a8-8989-449c30148b74",
                        "source_sense_description": "Wagen zum Servieren",
                        "target_lang_word": "desserte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desserte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a122118f-2f5e-32ba-a3ca-333e5c23d457",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Meuble ou table où l’on met ce que l’on a desservi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bb99e5e-8dd9-4b77-9c2b-1c66fed9e178",
                                                "sense_id": "a122118f-2f5e-32ba-a3ca-333e5c23d457",
                                                "text": "Un play-boy à gourmette d'acier et à la prunelle jaugeuse les installa sur des poufs autour d'une petite desserte ronde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8533358a-814a-3b60-8f3e-004cea09d926",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Viande, mets qu’on a desservis, qu’on a ôtés de dessus la table."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "360d37f9-5a24-47e1-ab40-c44ee954d88f",
                                                "sense_id": "8533358a-814a-3b60-8f3e-004cea09d926",
                                                "text": "Donner la desserte aux domestiques, aux pauvres."
                                            },
                                            {
                                                "example_id": "1f774235-8c22-4f3c-8188-e01aa792d5b7",
                                                "sense_id": "8533358a-814a-3b60-8f3e-004cea09d926",
                                                "text": "Grimaud avait déjà pris les devants avec le panier et la desserte."
                                            },
                                            {
                                                "example_id": "27858037-98ab-4611-8aff-1169313f15bb",
                                                "sense_id": "8533358a-814a-3b60-8f3e-004cea09d926",
                                                "text": "Ces officiers ^([porte-manteaux]) avaient « bouche à Cour », c’est-à-dire que, étant de quartier, ils étaient nourris aux frais du roi, à la table des valets de chambre, et leur valet mangeait la desserte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9564b5b7-6749-31ba-8fe8-9d79cb8221e8",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Ensemble des fonctions attachées au service d’une cure, d’une chapelle, etc. S’emploie surtout en parlant du service que fait un prêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d107a416-6ee0-4853-8e22-60b125445466",
                                                "sense_id": "9564b5b7-6749-31ba-8fe8-9d79cb8221e8",
                                                "text": "Il le charge de la desserte de la paroisse de Saint-Edouard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996483dc-761e-3c3e-abfe-1c663e7f6313",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Fait de desservir un lieu, arrêt pour permettre la montée et descente des passagers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccc7e87-468e-4de7-bafe-7f41109c8865",
                                                "sense_id": "996483dc-761e-3c3e-abfe-1c663e7f6313",
                                                "text": "De bons résultats, quant au trafic voyageurs, vinrent dès le début de l'exploitation de cette ligne de Paris à Orsay conforter la situation financière de la Société Arnoux, mais toutefois pas suffisamment pour qu'elle puisse acquérir du matériel permettant une desserte marchandise, […]."
                                            },
                                            {
                                                "example_id": "610f4d46-00bd-48d2-876f-e6c35ec2c197",
                                                "sense_id": "996483dc-761e-3c3e-abfe-1c663e7f6313",
                                                "text": "C’est la troisième année consécutive que le traversier NM F.-A.-Gauthier n’est pas en service pendant la période des Fêtes. Cependant, lors des deux dernières années, la Société des traversiers du Québec (STQ) avait mis en place une desserte aérienne pour remplacer les traversiers."
                                            },
                                            {
                                                "example_id": "d359dce8-2153-4355-a1e2-e7ee9547c85f",
                                                "sense_id": "996483dc-761e-3c3e-abfe-1c663e7f6313",
                                                "text": "Pourtant, le trambus desservait surtout le centre-ville, et non la banlieue, ce qui rend la déclaration de M. Legault d’autant plus déroutante. Et la desserte du secteur n’a pas été abandonnée, mais remplacée par des métrobus et voies réservées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288fbced-c77d-39cf-808d-6237c290d083",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Transport qui dessert."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c747e21e-ef52-445b-8e06-9ed5c86e2b17",
                                                "sense_id": "288fbced-c77d-39cf-808d-6237c290d083",
                                                "text": "Parking, station tram souterraine, arrêt-minute, desserte taxi, sont interconnectés. La force du projet réside dans l’intégration judicieuse de toute contrainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d8cc4c-6414-313d-98de-278c0da15c42",
                                        "entry_id": "762a1c81-54f5-3930-8339-52a56378cb2d",
                                        "glosses": [
                                            "Voie ou ensemble de voies permettant l’accès à une parcelle, à un massif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212cb40b-92cf-4036-bffd-0e4155b7d02c",
                                                "sense_id": "c2d8cc4c-6414-313d-98de-278c0da15c42",
                                                "text": "Or les prévisions se sont avérées fausses de telle sorte que des bois de valeur restent sur pied actuellement faute de desserte pour être mobilisés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
