                                    {
                                        "sense_id": "569e6266-4fee-37bf-96a4-d12d294928d1",
                                        "entry_id": "51a6ed97-858b-395e-ade8-fed7fa041872",
                                        "glosses": [
                                            "Any organic compound having one or more carbon–carbon triple bonds; an alkyne."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcbcdcbb-1ab0-4818-888a-57e0cc919987",
                                                "sense_id": "569e6266-4fee-37bf-96a4-d12d294928d1",
                                                "text": "The acetylene gas lighting in the station offices and platforms at Kyle of Lochalsh recently has been replaced by electric lighting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5239d966-d19e-3353-a1f1-7767573ca2aa",
                                        "entry_id": "51a6ed97-858b-395e-ade8-fed7fa041872",
                                        "glosses": [
                                            "Ethyne; the simplest alkyne, a hydrocarbon of formula HC≡CH. It is a colourless, odourless, extremely flammable, explosive gas, formerly used as an illuminating gas, but now used in welding and metallurgy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f3bbd43-df12-3ae0-a129-3c0543a3ebc5",
                                        "entry_id": "51a6ed97-858b-395e-ade8-fed7fa041872",
                                        "glosses": [
                                            "A lamp powered by acetylene, particularly a motor vehicle headlight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3566cdc3-9916-407a-a90e-e9af751239c9",
                                                "sense_id": "1f3bbd43-df12-3ae0-a129-3c0543a3ebc5",
                                                "text": "Mrs. Winnie had kindly sent her limousine car for them, and it stood throbbing in front of the hotel-entrance, its acetylenes streaming far up the street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8f4e15-86ed-4f5e-b247-84e0e1f08a08",
                        "source_entry_id": "dcbb0e2c-2118-36ae-b091-c59493b3e38f",
                        "source_sense_id": "fd397f45-13df-3405-ac48-8732a5ffeae5",
                        "source_sense_description": "een verbinding van waterstof en koolstof met de samenstelling H₂C₂, die als gasvormige brandstof voor het vormen van hete vlammen gebruikt wordt",
                        "target_lang_word": "acétylène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acétylène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                        "entry_id": "b99fb642-f610-3943-a5a4-7d2959e7cde8",
                                        "glosses": [
                                            "Hydrocarbure gazeux à la température ordinaire de la classe des alcynes, de formule chimique C₂H₂ ou H−C≡C−H, résultant entre autres de la décomposition de l’eau par le carbure de calcium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7654f2c6-8682-4c97-854b-cc4c20138bbd",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "La nomenclature adoptée au congrès de Genève consiste, dans le cas des acétylènes, à remplacer le suffixe « yle » des radicaux alcooliques correspondants, par la terminaison « ine » (alkines)."
                                            },
                                            {
                                                "example_id": "6338024c-896e-4d4f-a4b0-beb628e75683",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "Berthelot a obtenu la benzine dans l'action de la chaleur sur l’acétylène : 3 C₂H₂ = C₆H₆."
                                            },
                                            {
                                                "example_id": "d32a6d04-dd2a-4f4b-907b-bafe388422fd",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "Chaleur sur la terrasse où nous dînons, éclairés à l’acétylène."
                                            },
                                            {
                                                "example_id": "b668409e-829f-45a7-88c2-472d6775371e",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "La soirée étant brumeuse, beaucoup de commerçants avaient allumé leurs quinquets à acétylène et ces flaques de lumière blanche ou dorée faisaient planer sur la foule en rumeur un rayonnement de fête foraine."
                                            },
                                            {
                                                "example_id": "476a8c9f-ce59-40f4-8d34-29cf94769aa3",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "La nomenclature adoptée au congrès de Genève consiste, dans le cas des acétylènes, à remplacer le suffixe « yle » des radicaux alcooliques correspondants, par la terminaison « ine » (alkines)."
                                            },
                                            {
                                                "example_id": "dd88c35c-6b18-4e9f-90d9-dd0c8633ff69",
                                                "sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                                                "text": "Jusqu'à cette date, le laminoir de Givonne est éclairé à l’acétylène que produit un générateur comprenant deux cloches, placées dans un bâtiment séparé. Les 5 becs répandaient, semble-t-il, une clarté suffisante dans le laminoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
