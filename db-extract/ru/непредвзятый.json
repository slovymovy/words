                                    {
                                        "sense_id": "259e7222-2ac4-3204-9317-56f5516eb2dd",
                                        "entry_id": "1f4be23d-a92a-34c0-9f7b-802c99273fa5",
                                        "glosses": [
                                            "Juste, équitable, qui ne favorise aucun parti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3053994-bfd9-47bb-ae0a-fb05fd1f035c",
                                                "sense_id": "259e7222-2ac4-3204-9317-56f5516eb2dd",
                                                "text": "Le fonctionnaire de la police nationale est loyal envers les institutions républicaines. Il est intègre et impartial ; il ne se départit de sa dignité en aucune circonstance."
                                            },
                                            {
                                                "example_id": "a00b44e2-d48b-40cf-92b9-2323389e0d95",
                                                "sense_id": "259e7222-2ac4-3204-9317-56f5516eb2dd",
                                                "text": "Dans l'exercice de ses missions, le commissaire aux comptes conserve en toutes circonstances une attitude impartiale. Il fonde ses conclusions et ses jugements sur une analyse objective de l'ensemble des données dont il a connaissance, sans préjugé ni parti pris. Il évite toute situation qui l'exposerait à des influences susceptibles de porter atteinte à son impartialité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
