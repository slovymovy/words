            {
                "entry_id": "e2d98b9c-6ba7-3893-9584-4aa83ddf361f",
                "word": "dag",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fb6db346-5f0c-4381-990e-aab1377cb74b",
                        "entry_id": "e2d98b9c-6ba7-3893-9584-4aa83ddf361f",
                        "tags": [
                            "plural"
                        ],
                        "form": "dags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69d996d2-078c-3268-8d96-d8c808bc10f2",
                        "entry_id": "e2d98b9c-6ba7-3893-9584-4aa83ddf361f",
                        "glosses": [
                            "One who dresses unfashionably or without apparent care about appearance; someone who is not cool; a dweeb or nerd."
                        ],
                        "tags": [
                            "Australia",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e5f70001-8cd1-4430-bd2f-8e0aa200d7a6",
                                "sense_id": "69d996d2-078c-3268-8d96-d8c808bc10f2",
                                "text": "2004 July 25, Debbie Kruger, Melbourne Weekly Magazine, All the World's a Stage,\nNow, wide-eyed and unfashionably excited (\"I’m such a dag!\" she remarks several times), she has the leading role of Viola in the Bell Shakespeare Company’s production of Twelfth Night, opening on August 10 at the Victorian Arts Centre Playhouse."
                            },
                            {
                                "example_id": "0f78e923-4b5d-494a-a9fa-868bc8b426ca",
                                "sense_id": "69d996d2-078c-3268-8d96-d8c808bc10f2",
                                "text": "What did you think about Mark calling you a dag?\nTo me a dag is a person who doesn't have a lot of pride in their appearance or the way they present themselves — the way they sing and how they hold themselves basically. But it didn't really bother me. He said, \"You're such a dag, you're cool.\" I took it as \"you're a laidback person\". The way they cut it and edited it made it sound on TV like I was grumpy about it, but I wasn't. It was pretty funny how it came across."
                            },
                            {
                                "example_id": "a8ae72e4-adbf-448a-97b3-8dc5059f4961",
                                "sense_id": "69d996d2-078c-3268-8d96-d8c808bc10f2",
                                "text": "SHE is one of Hollywood's most beautiful leading ladies and has access to any fashion designers, so then why is Catherine Zeta-Jones dressing like a bag lady?"
                            },
                            {
                                "example_id": "7de4129c-e22a-42bd-9fa3-22ab0661076c",
                                "sense_id": "69d996d2-078c-3268-8d96-d8c808bc10f2",
                                "text": "A graduate of film studies in New York, May has had a hand in editing two of his three videos. Each casts him as a bespectacled dag in a world of glamour."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6d4bcce-f9b3-3e37-8788-7820127be3cd",
                        "entry_id": "e2d98b9c-6ba7-3893-9584-4aa83ddf361f",
                        "glosses": [
                            "An odd or eccentric person; someone who is a bit strange but amusingly so."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "216e2dee-9567-4e82-94ee-752e9cd6c0bc",
                        "source_entry_id": "e2d98b9c-6ba7-3893-9584-4aa83ddf361f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "неряха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неряха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61d88f09-f024-3007-aa8b-7c4e68d88690",
                                        "entry_id": "25491803-9239-3f2b-89a8-69024d753e9d",
                                        "glosses": [
                                            "разг. неаккуратный, неряшливый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3d74f6-28a6-4776-b51a-3604b618ce73",
                                                "sense_id": "61d88f09-f024-3007-aa8b-7c4e68d88690",
                                                "text": "Теперь же, когда шла она опять вечером, попался на улице семиклассник Костя Орешкин — нескладень и неряха."
                                            },
                                            {
                                                "example_id": "b418c324-d07c-44c5-b17e-9a4570157750",
                                                "sense_id": "61d88f09-f024-3007-aa8b-7c4e68d88690",
                                                "text": "Лика была едва ли не просто неряха, волосы скручивала редькой на макушке, и то редька всегда сползала на бок; она грызла ногти, и чулки у неё, плохо натянутые, морщились гармоникой из-под не совсем ещё длинной юбки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
