                ],
                "senses": [
                    {
                        "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                        "entry_id": "df930369-0d0f-33b7-9847-5580a8ff4a4c",
                        "glosses": [
                            "Machtübernahme der kommunistischen Bolschewiki 1917 in Russland, Große Sozialistische Oktoberrevolution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd57bdb5-2649-4126-8f5a-c7e5af6ae4f2",
                                "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                                "text": "„Die Oktoberrevolution wird als Stimulans für die Entfesselung einer avantgardistisch-experimentellen Moderne begriffen, deren Produkte auch heute noch eine derartige Faszination ausstrahlen, daß man ihr Ende bereitwillig mit despotisch-stalinistischem Zugriff in Verbindung setzt und mit ihm das Aufhören ‚relevanter Kultur‘ datiert.“"
                            },
                            {
                                "example_id": "3f9a0600-703a-4d99-b900-c44ff00de5e9",
                                "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                                "text": "„Viele können heute noch nicht Französisch, sind aber seit der Oktoberrevolution dort.“"
                            },
                            {
                                "example_id": "532bbeb0-8037-45a7-baac-31c96f3363e1",
                                "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                                "text": "„Wir Juden haben die Oktoberrevolution unterstützt, weil wir glaubten, dass damit die Einschränkungen entfallen würden, die uns das Zarenregime auferlegt hat.“"
                            },
                            {
                                "example_id": "928f0e57-002c-45fd-a7da-0a5301e2599e",
                                "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                                "text": "„Seit der Oktoberrevolution von 1917 waren die Bolschewiken mit der Roten Armee auf dem Vormarsch nach Osten.“"
                            },
                            {
                                "example_id": "b56fd728-3b80-48b8-a45b-e513751a3a2a",
                                "sense_id": "8da29b9e-6f0e-33ce-944f-009bb04672a8",
                                "text": "„Deformierte Revolutionen wie die Oktoberrevolution in Russland unter Lenin oder abgebrochene Revolutionen wie die verschiedenen Erhebungen bei den europäischen Mittelmächten nach dem Ersten Weltkrieg können, wie wir heute wissen, Folgen haben, die in ihrem blanken Horror nachgerade beispiellos sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
