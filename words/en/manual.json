{
    "word_family": [
        "manually"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "63d8b5a4-3e1a-3876-8d8b-a81cc7c3eaea",
                    "sense_definition": "Relating to or done with the hands.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farming used to require much more <w>manual</w> labor than it does today.",
                            "target_lang_translations": {
                                "ru": "Раньше сельское хозяйство требовало гораздо больше <w>ручного</w> труда, чем сегодня.",
                                "zh": "过去，农业比现在需要多得多的<w>手工</w>劳动。"
                            }
                        },
                        {
                            "text": "The job requires a high degree of <w>manual</w> dexterity and attention to detail.",
                            "target_lang_translations": {
                                "ru": "Эта работа требует высокой <w>ручной</w> ловкости и внимания к деталям.",
                                "zh": "这份工作要求很强的<w>手部</w>灵巧性和对细节的关注。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "manual labor",
                        "manual dexterity",
                        "manual worker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к рукам или выполняемый ими.",
                        "zh": "与手有关的，或由手完成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "выполняемый руками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手工",
                                "target_lang_sense_clarification": "用手完成的；与手有关"
                            },
                            {
                                "target_lang_word": "手部",
                                "target_lang_sense_clarification": "强调手的动作或技能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a955df03-eb09-3126-af5a-cdbc2294d545",
                    "sense_definition": "Operated or performed by a person rather than automatically by a machine.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot switched to <w>manual</w> control during the storm.",
                            "target_lang_translations": {
                                "ru": "Пилот переключился на <w>ручное</w> управление во время шторма.",
                                "zh": "暴风雨中，飞行员切换到了<w>手动</w>控制。"
                            }
                        },
                        {
                            "text": "We had to do a <w>manual</w> count of the inventory because the scanner broke.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось проводить <w>ручной</w> подсчет инвентаря, потому что сканер сломался.",
                                "zh": "由于扫描器坏了，我们只好对库存进行<w>人工</w>清点。"
                            }
                        }
                    ],
                    "antonyms": [
                        "automatic"
                    ],
                    "common_phrases": [
                        "manual control",
                        "manual override",
                        "manual transmission",
                        "manual operation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управляемый или выполняемый человеком, а не автоматически машиной.",
                        "zh": "由人而不是机器自动操作或完成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "не автоматический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手动",
                                "target_lang_sense_clarification": "由人操作的，不是自动的"
                            },
                            {
                                "target_lang_word": "人工",
                                "target_lang_sense_clarification": "由人来完成而非机器自动完成"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b9bf856-0244-3987-b21a-1cd4ca7a30bb",
                    "sense_definition": "A book that gives instructions or information about how to use or do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the instruction <w>manual</w> before setting up the device.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте <w>руководство</w> по эксплуатации перед настройкой устройства.",
                                "zh": "安装设备之前，请先阅读说明<w>书</w>。"
                            }
                        },
                        {
                            "text": "I keep the owner's <w>manual</w> in the glove compartment of my car.",
                            "target_lang_translations": {
                                "ru": "Я храню <w>руководство</w> пользователя в бардачке моей машины.",
                                "zh": "我把车主<w>手册</w>放在汽车的手套箱里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "handbook",
                        "guide",
                        "instructions"
                    ],
                    "common_phrases": [
                        "instruction manual",
                        "user manual",
                        "owner's manual",
                        "training manual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга, содержащая инструкции или информацию о том, как пользоваться чем-либо или делать что-либо.",
                        "zh": "提供如何使用某物或如何做某事的说明或信息的书或资料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "справочное издание"
                            },
                            {
                                "target_lang_word": "инструкция",
                                "target_lang_sense_clarification": "свод правил использования"
                            },
                            {
                                "target_lang_word": "пособие",
                                "target_lang_sense_clarification": "учебный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说明书",
                                "target_lang_sense_clarification": "用于设备、产品等的使用说明书"
                            },
                            {
                                "target_lang_word": "手册",
                                "target_lang_sense_clarification": "用户或所有者随附的说明资料"
                            },
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "较正式或教学性的指导材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e73ced4c-c4f2-32f9-ab98-5df94e68401e",
                    "sense_definition": "A vehicle with a gearbox that requires the driver to change gears by hand, or the gearbox itself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I learned to drive on a <w>manual</w>, so I can drive almost any car.",
                            "target_lang_translations": {
                                "ru": "Я учился водить на <w>механике</w>, поэтому могу водить почти любую машину.",
                                "zh": "我是开<w>手动挡</w>学会开车的，所以几乎什么车都会开。"
                            }
                        },
                        {
                            "text": "He prefers driving a <w>manual</w> because he feels more in control of the vehicle.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает водить <w>механику</w>, потому что чувствует больший контроль над автомобилем.",
                                "zh": "他更喜欢开<w>手动挡</w>，因为他觉得这样对车的控制更强。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick shift",
                        "stick"
                    ],
                    "antonyms": [
                        "automatic"
                    ],
                    "common_phrases": [
                        "drive a manual",
                        "five-speed manual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство с коробкой передач, требующей переключения вручную, или сама такая коробка передач.",
                        "zh": "需要驾驶员手动换挡的车辆，或这种变速箱本身。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "механика",
                                "target_lang_sense_clarification": "разговорное название МКПП"
                            },
                            {
                                "target_lang_word": "механическая коробка передач",
                                "target_lang_sense_clarification": "тип трансмиссии"
                            },
                            {
                                "target_lang_word": "ручная коробка передач",
                                "target_lang_sense_clarification": "дословный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手动挡",
                                "target_lang_sense_clarification": "指配备手动变速器的汽车，也可指这种变速系统"
                            },
                            {
                                "target_lang_word": "手动变速箱",
                                "target_lang_sense_clarification": "较完整说法，指手动变速器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3639503-ffec-358b-9662-8d7d7a8e834b",
                    "sense_definition": "A setting or state of operation controlled by a person, not a machine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The camera is currently on <w>manual</w>, so you have to adjust the focus yourself.",
                            "target_lang_translations": {
                                "ru": "Камера сейчас в <w>ручном режиме</w>, поэтому вам нужно настраивать фокус самостоятельно.",
                                "zh": "相机目前处于<w>手动模式</w>，所以你得自己调焦。"
                            }
                        },
                        {
                            "text": "If the automatic system fails, switch the controls to <w>manual</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Если автоматическая система выйдет из строя, немедленно переключите управление на <w>ручное</w>.",
                                "zh": "如果自动系统失灵，立即把控制切换到<w>手动模式</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "automatic"
                    ],
                    "common_phrases": [
                        "on manual",
                        "switch to manual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настройка или режим работы, контролируемый человеком, а не машиной.",
                        "zh": "由人而不是机器控制的一种设置或运行状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручной режим",
                                "target_lang_sense_clarification": "режим управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手动模式",
                                "target_lang_sense_clarification": "由人控制的操作状态或设置"
                            },
                            {
                                "target_lang_word": "手动",
                                "target_lang_sense_clarification": "与自动相对的控制方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b65560b-db0b-3de5-88b6-2a46f6aeb0aa",
                    "sense_definition": "A keyboard on an organ or harpsichord played with the hands, as opposed to the pedals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organist played the melody on the upper <w>manual</w>.",
                            "target_lang_translations": {
                                "ru": "Органист играл мелодию на верхнем <w>мануале</w>.",
                                "zh": "管风琴演奏者在上方的<w>手键盘</w>上弹奏了这段旋律。"
                            }
                        },
                        {
                            "text": "This large pipe organ has four <w>manuals</w> and a full pedalboard.",
                            "target_lang_translations": {
                                "ru": "У этого большого органа четыре <w>мануала</w> и полная педальная клавиатура.",
                                "zh": "这台大型管风琴有四层<w>手键盘</w>和一整套脚键盘。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиатура органа или клавесина, на которой играют руками, в отличие от педалей.",
                        "zh": "管风琴或羽管键琴上用手演奏、与脚踏键盘相对的键盘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мануал",
                                "target_lang_sense_clarification": "музыкальный термин"
                            },
                            {
                                "target_lang_word": "клавиатура",
                                "target_lang_sense_clarification": "часть инструмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手键盘",
                                "target_lang_sense_clarification": "管风琴、羽管键琴等上用手弹奏的键盘"
                            },
                            {
                                "target_lang_word": "键盘",
                                "target_lang_sense_clarification": "音乐语境中的较一般说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23858353-5e69-3595-869f-7bfb31cc8466",
                    "sense_definition": "A trick on a skateboard or bicycle where the rider balances on one set of wheels without pedaling or touching the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He performed a long <w>manual</w> all the way down the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Он выполнил длинный <w>мануал</w> по всему тротуару.",
                                "zh": "他沿着人行道一路完成了一个很长的<w>后轮平衡</w>动作。"
                            }
                        },
                        {
                            "text": "Balancing a <w>manual</w> requires a lot of practice and core strength.",
                            "target_lang_translations": {
                                "ru": "Балансирование в <w>мануале</w> требует большой практики и силы корпуса.",
                                "zh": "保持<w>后轮平衡</w>需要大量练习和核心力量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "skateboarding and cycling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трюк на скейтборде или велосипеде, при котором райдер балансирует на одной паре колес, не касаясь земли ногами.",
                        "zh": "滑板或自行车中的一种特技，骑行者只用一组轮子保持平衡滑行，不踩踏也不触地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мануал",
                                "target_lang_sense_clarification": "трюк"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后轮平衡",
                                "target_lang_sense_clarification": "滑板或自行车中以前后轮平衡滑行的特技，通常指后轮平衡"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "56961971-6ff9-3f3e-b5a3-41843b8e3273",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Manual</w> spells his name differently than most people expect.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Мануал</w> пишет свое имя иначе, чем ожидает большинство людей.",
                                "zh": "我叔叔<w>曼努埃尔</w>把自己的名字拼写得和大多数人以为的不一样。"
                            }
                        },
                        {
                            "text": "The name <w>Manual</w> is sometimes found as a variant spelling in old records.",
                            "target_lang_translations": {
                                "ru": "Имя <w>Мануал</w> иногда встречается как вариант написания в старых записях.",
                                "zh": "在旧档案里，名字<w>曼努埃尔</w>有时会以这种异体拼写出现。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "variant of Manuel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мануал",
                                "target_lang_sense_clarification": "имя"
                            },
                            {
                                "target_lang_word": "Мануэль",
                                "target_lang_sense_clarification": "вариант имени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曼努埃尔",
                                "target_lang_sense_clarification": "男性名字，Manual是Manuel的一种异体拼写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
