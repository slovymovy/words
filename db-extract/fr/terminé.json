                    {
                        "translation_id": "c2566cb2-d011-4f57-b840-3af9b64b7a4e",
                        "source_entry_id": "7e9c03b3-e2b0-3254-a168-65004a3109ce",
                        "source_sense_id": "d6f08fdc-311f-33d8-b164-e142fbc0ba26",
