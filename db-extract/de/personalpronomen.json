                                "target_senses": [
                                    {
                                        "sense_id": "5818bfe6-ab7d-3e47-a7b1-2c98171a5d4c",
                                        "entry_id": "25025691-a378-39a7-9430-2962c0562230",
                                        "glosses": [
                                            "A pronoun which, in English, refers to one or a combination of the following"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439d78f7-7752-4f69-8bbc-2f4895fce5e2",
                                                "sense_id": "5818bfe6-ab7d-3e47-a7b1-2c98171a5d4c",
                                                "text": "Mondays come with questions of couples\nWhere and with whom did you go?\nAvoiding the personal pronoun\nShe hopes it doesn't show\nShopping with her lover in the city\nTwo women holding hands don't get a stare\nIf the kids at school knew what they do\nWould they hate her? Why should they care?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df1fef17-c036-3fdd-90ee-ebfe310528e4",
                                        "entry_id": "25025691-a378-39a7-9430-2962c0562230",
                                        "glosses": [
                                            "A pronoun which, in English, refers to one or a combination of the following:",
                                            "The person or people speaking. (first person)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
