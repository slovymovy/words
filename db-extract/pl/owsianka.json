                                        "sense_id": "93e054da-a744-3304-9cfb-d18464d29703",
                                        "entry_id": "9a7715e9-1ab1-3aa7-b921-ca38daa3ba84",
                                        "glosses": [
                                            "A dish made of grain or legumes, milk or water, heated and stirred until thick and typically eaten for breakfast."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9390db35-0a69-48f3-82db-3b0b3b47cc74",
                                                "sense_id": "93e054da-a744-3304-9cfb-d18464d29703",
                                                "text": "Eat your porridge while it's hot!"
                                            },
                                            {
                                                "example_id": "f5c534e1-0936-4060-a9a4-0ed65453d41b",
                                                "sense_id": "93e054da-a744-3304-9cfb-d18464d29703",
                                                "text": "There were rumours, new rumours every morning, delightful and outrageous rumours, so that the lumps in the porridge were swallowed without comment and the fish-cakes were eaten without contumely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456d4fee-4234-3320-9b6b-1fef79775bac",
