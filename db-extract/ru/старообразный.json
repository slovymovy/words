                        "source_sense_id": "876fe73d-3880-3720-87eb-8acedd882c08",
                        "target_lang_word": "vieillot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieillot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c117bb3-a4dc-34ba-9724-e052f3911d3d",
                                        "entry_id": "e058778b-70bd-3eea-a8cb-ed59ca1a9f52",
                                        "glosses": [
                                            "Qui a un air de vieillesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1126b3e-1ed4-4d6a-8c12-560e21ac342c",
                                                "sense_id": "6c117bb3-a4dc-34ba-9724-e052f3911d3d",
                                                "text": "Il a un petit air vieillot."
                                            },
                                            {
                                                "example_id": "6561c098-0e44-49f0-b094-5d24ce7eb5c3",
                                                "sense_id": "6c117bb3-a4dc-34ba-9724-e052f3911d3d",
                                                "text": "Cet enfant a quelque chose de vieillot dans le visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee55e69e-3db8-36fd-9e26-fefb1f18594a",
                                        "entry_id": "e058778b-70bd-3eea-a8cb-ed59ca1a9f52",
                                        "glosses": [
                                            "Démodé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee946fc2-ebf2-453b-b5c9-6ae305e21610",
                                                "sense_id": "ee55e69e-3db8-36fd-9e26-fefb1f18594a",
                                                "text": "C’est une opinion vieillotte."
                                            },
                                            {
                                                "example_id": "b72c3737-ac4b-466a-999d-55b324fcfa3a",
                                                "sense_id": "ee55e69e-3db8-36fd-9e26-fefb1f18594a",
                                                "text": "Imaginez une très-petite ville, dévote, attristée, vieillotte, oubliée dans un fond de province, ne menant nulle part, ne servant à rien, d’où la vie se retirait de jour en jour, et que la campagne envahissait ; une industrie nulle, un commerce mort, une bourgeoisie vivant étroitement de ses ressources, une aristocratie qui boudait."
                                            },
                                            {
                                                "example_id": "402dfe3b-5de3-4f49-ba2e-a5b5142f7969",
                                                "sense_id": "ee55e69e-3db8-36fd-9e26-fefb1f18594a",
                                                "text": "Simplement, le droit et les habitudes réagissent toujours avec un temps de retard, ce qui leur donne parfois cette patine vieillotte qu’on appelle « archaïsme »."
                                            },
                                            {
                                                "example_id": "b5e86623-9ab8-4be5-8868-d954df542914",
                                                "sense_id": "ee55e69e-3db8-36fd-9e26-fefb1f18594a",
                                                "text": "Pardonnez mes références vieillottes, mais je lui souhaite d’acquérir la verve et l’aplomb d’un Daniel Johnson père, lui qui échevelait le panache d’un Jean Lesage!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vieillot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89a3f129-3906-310d-be44-062e01cd2dab",
                                        "entry_id": "29080749-bc12-3469-a12c-82c4c714400b",
                                        "glosses": [
                                            "Celui qui semble vieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c718c76-1b86-4025-85c4-9f93c0e1318d",
                                                "sense_id": "89a3f129-3906-310d-be44-062e01cd2dab",
                                                "text": "Maxime eut soin de se placer à une certaine distance de quelques vieillots qui par habitude se mettent en espalier, dès une heure après midi, pour sécher leurs affections rhumatiques."
                                            }
                                        ]
                                    },
                                    {
