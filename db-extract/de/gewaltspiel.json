                "senses": [
                    {
                        "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                        "entry_id": "eb1178fd-201b-3f3f-a948-4d9f087983b1",
                        "glosses": [
                            "Spielform, bei der aggressive Handlungen physischer, psychischer oder virtueller Art gegen Personen, Spielfiguren oder Sachwerte praktiziert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f497a1-0d05-4b9b-9fce-33fec59af197",
                                "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                                "text": "„Festzuhalten ist, daß das Angebot an Gewaltspielen insgesamt hoch bleibt.“"
                            },
                            {
                                "example_id": "3c47b5e4-a0e2-479d-ac34-bc5239924ed6",
                                "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                                "text": "„Verstärken Gewaltspiele die Gewalt oder sind sie eher ein Ventil für angestaute Frustrationen?“"
                            },
                            {
                                "example_id": "26925edf-fd3b-4726-9743-402b556e0d99",
                                "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                                "text": "„Experten bestreiten seit Jahren, dass es einen ursächlichen Zusammenhang zwischen Gewaltspielen und Amokläufen gibt.“"
                            },
                            {
                                "example_id": "2c5c938e-b33e-43b4-8088-5de0b5e692c9",
                                "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                                "text": "„Befürworter und Kritiker streiten sich schon heute, ob Computerspiele aggressiv machen und Gewalt auslösen, weil der Spieler den Zusammenstoß zweier Autos oder – in einem Gewaltspiel – den Tod des Gegners immer realistischer erfährt.“"
                            },
                            {
                                "example_id": "360447d3-513b-4259-b707-ee45d74aabf7",
                                "sense_id": "85dbe4ba-f147-38ac-9e48-3bd89af687a7",
                                "text": "„Ein in relativ gewaltfreier Umgebung aufgewachsenes Kind wird durch das Gewaltspiel auf dem Computer nicht gleich zum Gewalttäter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
