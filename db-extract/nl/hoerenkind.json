                                    {
                                        "sense_id": "eb66f831-d25f-3487-92ce-a5b8be4de013",
                                        "entry_id": "9c421b0f-5976-3b4a-935f-8cb0924b2920",
                                        "glosses": [
                                            "Kind einer Prostituierten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8e8198-8c8f-4c02-b95a-afb477ca9de0",
                                                "sense_id": "eb66f831-d25f-3487-92ce-a5b8be4de013",
                                                "text": "„Liebe gibt es nicht, und Sex nur gegen Geld, das hatte das Hurenkind schon früh begriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                        "entry_id": "9c421b0f-5976-3b4a-935f-8cb0924b2920",
                                        "glosses": [
                                            "eine einzelne Zeile eines Absatzes, die auf einer neuen Seite steht, während alle anderen Zeilen noch auf der vorherigen Seite stehen"
                                        ],
                                        "tags": [
                                            "Typographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e09c604-3bc4-4c8d-a3ac-083954f4d177",
                                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                                "text": "Hurenkinder gelten in der Typografie als schwere handwerkliche Fehler, da sie die Ästhetik des Satzspiegels besonders stark beeinträchtigen."
                                            },
                                            {
                                                "example_id": "9b5b8c61-c6ce-4623-a977-2d9dbb717d9a",
                                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                                "text": "„Mit EDV-Programmen können Hurenkinder durch Veränderung der vorhergehenden Wortzwischenräume vermieden werden.“"
                                            },
                                            {
                                                "example_id": "13af54c4-c530-4015-94a7-7275a08137f1",
                                                "sense_id": "2f1d971b-316f-31c3-b625-5eb8331b57be",
                                                "text": "„Heute als klassische Druckfehler bekannte Lapsus wie Schusterjungen und Hurenkinder hingegen begegnen zumindest in der deutschen Fassung des »Mechanismus« gar nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1beaf375-90be-4ed6-8df2-67ffc96cf995",
                        "source_entry_id": "6a00b0b5-7df0-3705-912b-12d24423fac5",
                        "source_sense_id": "ed4d5626-c55d-3257-b927-29690e8ae541",
