{
    "word_family": [
        "recommandation",
        "recommandable",
        "décommander",
        "commander",
        "commande"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9ed1037-9207-3dd8-ac99-1bd13acc54d7",
                    "sense_definition": "Conseiller vivement une chose à quelqu'un en faisant valoir ses qualités ou son utilité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conseil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous <w>recommande</w> vivement ce petit restaurant italien du centre-ville."
                        },
                        {
                            "text": "Mon médecin m'a <w>recommandé</w> de marcher au moins une demi-heure par jour."
                        }
                    ],
                    "synonyms": [
                        "conseiller",
                        "préconiser",
                        "suggérer"
                    ],
                    "antonyms": [
                        "déconseiller"
                    ],
                    "common_phrases": [
                        "recommander chaudement",
                        "recommander vivement",
                        "recommander un livre"
                    ]
                },
                {
                    "sense_id": "d6b12847-cde7-3afd-a062-9cd08bcf6892",
                    "sense_definition": "Présenter favorablement une personne à autrui pour lui attirer sa bienveillance ou son appui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a <w>recommandé</w> cette brillante étudiante pour un stage en entreprise."
                        },
                        {
                            "text": "Je vais vous <w>recommander</w> auprès du directeur des ressources humaines."
                        }
                    ],
                    "synonyms": [
                        "appuyer",
                        "introduire",
                        "parrainer"
                    ],
                    "common_phrases": [
                        "recommander un candidat",
                        "recommander à l'attention de"
                    ]
                },
                {
                    "sense_id": "ea1bb557-f158-36ee-a726-ea3cecd564ff",
                    "sense_definition": "Faire enregistrer un courrier ou un colis à la poste pour garantir sa remise contre signature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il vaut mieux <w>recommander</w> cette lettre importante pour avoir une preuve légale d'envoi."
                        },
                        {
                            "text": "L'employé de la poste m'a conseillé de <w>recommander</w> ce paquet précieux."
                        }
                    ],
                    "common_phrases": [
                        "recommander une lettre",
                        "recommander un pli",
                        "recommander un envoi"
                    ]
                },
                {
                    "sense_id": "e86d9911-29b2-3908-8413-78bb32367243",
                    "sense_definition": "Passer une nouvelle commande d'un produit, d'un plat ou d'une boisson.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "achat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur est venu nous demander si nous voulions <w>recommander</w> des boissons."
                        },
                        {
                            "text": "J'ai tellement aimé ce dessert que j'en ai <w>recommandé</w> une seconde part."
                        }
                    ],
                    "common_phrases": [
                        "recommander un plat",
                        "recommander une boisson"
                    ]
                },
                {
                    "sense_id": "a461f4b1-b7ce-351e-9a4b-23f205d21d52",
                    "sense_definition": "Donner des instructions impératives ou exhorter quelqu'un à adopter une conduite prudente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conseil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les consignes de sécurité <w>recommandent</w> la plus grande prudence lors des intempéries."
                        },
                        {
                            "text": "Notre guide nous a <w>recommandé</w> de ne jamais quitter le sentier balisé."
                        }
                    ],
                    "synonyms": [
                        "enjoindre",
                        "exhorter",
                        "prescrire"
                    ],
                    "antonyms": [
                        "défendre",
                        "interdire"
                    ],
                    "common_phrases": [
                        "recommander la prudence",
                        "recommander le calme",
                        "recommander la discrétion"
                    ]
                },
                {
                    "sense_id": "7986f14b-eaf8-352a-8f5c-e8f39156e7d0",
                    "sense_definition": "Faire valoir le nom ou le crédit de quelqu'un pour appuyer sa propre démarche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>recommandé</w> du ministre pour obtenir un entretien plus rapidement."
                        },
                        {
                            "text": "Vous pouvez vous <w>recommander</w> de moi lorsque vous rencontrerez le responsable."
                        }
                    ],
                    "synonyms": [
                        "se prévaloir de"
                    ],
                    "common_phrases": [
                        "se recommander de"
                    ]
                }
            ]
        }
    ]
}