                ],
                "senses": [
                    {
                        "sense_id": "b39a68db-2f93-3675-a9d5-bdff1eedb641",
                        "entry_id": "1c08db9a-15d1-3ce8-bf76-32fdd8765457",
                        "glosses": [
                            "A proponent of panpsychism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "340ea8db-e511-4a65-b6b4-c60dc8faa16f",
                                "sense_id": "b39a68db-2f93-3675-a9d5-bdff1eedb641",
                                "text": "As the philosopher Philip Goff, one of the most prominent contemporary panpsychists, has pointed out, our belief that science will solve the mystery of consciousness, given that it triumphed in so many other areas, ignores that its success was predicated in the first place on the exclusion of the mind."
                            }
                        ]
                    }
                ],
