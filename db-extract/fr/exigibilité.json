                        "cross_references": [
                            {
                                "target_word": "enforceability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                        "entry_id": "40872662-f4a0-3984-85f5-ca1dc6d0c4db",
                                        "glosses": [
                                            "The quality of being enforceable."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63319f5-9fea-49d3-bbcd-4f7cfa4a38af",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "The position of the individual as a subject of international law has often been obscured by the failure to observe the distinction between the recognition, in an international instrument of rights enuring to the benefit of the individual and the enforceability of these rights at his instance."
                                            },
                                            {
                                                "example_id": "b92b2806-f13b-4cd7-9cc9-0bad51ab3644",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "Safety advocates counter that the same arguments about enforceability pervaded the discussion surrounding seat belt laws but that those laws, even when they were not vigorously enforced, led to widespread behavioral changes."
                                            },
                                            {
                                                "example_id": "12d6d5d9-0bb8-46ab-93b5-a7b0a124c1a0",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "The use of AI-generated content introduces complex questions regarding copyright and ownership. Under Australian law, copyright generally applies to original works authored by humans. Text generated by AI would probably be outside this framework, creating uncertainty regarding its protectability and enforceability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
