                    {
                        "sense_id": "df735870-eaed-32d9-b395-c838ad5e3f62",
                        "entry_id": "094ddd01-a586-3bf0-ba47-9d7d1d8bec90",
                        "glosses": [
                            "ungeübter, schlechter, übervorsichtiger Auto- oder Motorradfahrer, der nur selten (etwa beim sonntäglichen Ausflug) fährt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "805846be-0fd5-4b58-90c0-8a11ce0cfc38",
                                "sense_id": "df735870-eaed-32d9-b395-c838ad5e3f62",
                                "text": "Sonntagsfahrer zeichnen sich durch eine übermäßig langsame Fahrweise aus, tragen meist einen Hut und haben einen Wackeldackel oder eine umhäkelte Klopapierrolle auf der hinteren Hutablage."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9610b352-f6ae-4b32-a76f-928f90bab3d9",
                        "source_entry_id": "094ddd01-a586-3bf0-ba47-9d7d1d8bec90",
                        "source_sense_id": "df735870-eaed-32d9-b395-c838ad5e3f62",
                        "target_lang_word": "Sunday driver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sunday driver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d497f91-0080-3ecf-9da1-839685618317",
                                        "entry_id": "0dadcc39-7dac-3818-9c5d-2ead72f250c8",
                                        "glosses": [
                                            "One who drives slowly or inexpertly, as for leisure or sightseeing."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26339e5d-2db3-4c64-b792-40105375a1a1",
                                                "sense_id": "7d497f91-0080-3ecf-9da1-839685618317",
                                                "text": "I was eager to get there, but I got stuck behind one Sunday driver after another on that trip."
                                            },
                                            {
                                                "example_id": "3ffaf8c1-ef4d-4535-9a83-8b5f2bfaeebd",
                                                "sense_id": "7d497f91-0080-3ecf-9da1-839685618317",
                                                "text": "Wallace is hardly your typical Sunday driver out on a jaunt in the countryside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d22889-e663-3624-9025-08775a5e9b03",
                                        "entry_id": "0dadcc39-7dac-3818-9c5d-2ead72f250c8",
                                        "glosses": [
                                            "One who drives infrequently, and often poorly."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "badc4a55-101a-47af-b274-fe6b117ddee8",
                        "source_entry_id": "094ddd01-a586-3bf0-ba47-9d7d1d8bec90",
                        "source_sense_id": "df735870-eaed-32d9-b395-c838ad5e3f62",
                        "target_lang_word": "conducteur du dimanche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conducteur du dimanche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e32410-281d-35fd-99ec-fd077dc83ed9",
                                        "entry_id": "bac9b61d-bad8-3474-b16b-71cbd55c569a",
                                        "glosses": [
                                            "Conducteur peu expérimenté ou qui ne respecte pas le code de la route."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09f912e1-cfc4-4985-b709-f3f8f4ac09b9",
                                                "sense_id": "c5e32410-281d-35fd-99ec-fd077dc83ed9",
                                                "text": "On peut être le meilleur pilote de rallye au monde et connaître un banal accident de la circulation avec un conducteur du dimanche. Au moment de se rendre au départ de la première spéciale de la troisième journée du Rallye de Croatie, dimanche, Sébastien Ogier a été percuté par une voiture le doublant sur sa droite sur une voie réservée aux bus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae6dd023-2fd9-431f-a27f-12937dde91cf",
                        "source_entry_id": "094ddd01-a586-3bf0-ba47-9d7d1d8bec90",
                        "source_sense_id": "df735870-eaed-32d9-b395-c838ad5e3f62",
                        "target_lang_word": "chauffard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauffard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                        "entry_id": "62877484-e14c-390f-8214-149fb47bac21",
                                        "glosses": [
                                            "Mauvais conducteur, personne dont le comportement au volant est dangereux. Souvent utilisé de manière injurieuse."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee6c030-6473-423c-9d7a-9dfad0bda6c7",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "Le chauffard qui a mortellement percuté une femme sur le parking d'un restaurant de Béziers (Hérault) dans la nuit de samedi à dimanche a été mis en examen pour assassinat et placé en détention provisoire"
                                            },
                                            {
                                                "example_id": "96b7457b-b233-470e-abb8-ce6c2fdbe76a",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "Et puis il paraît qu’on a tous failli mourir à cause d’un chauffard."
                                            },
                                            {
                                                "example_id": "0d0bd0f9-272c-4918-91cd-d777a9c75a65",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "C’est lui qui m’a permis de me redresser et de remarcher après qu’un chauffard m’a renversée à bicyclette quand j’avais 19 ans et laissée polytraumatisée, en miettes, quasi-amnésique, sur la chaussée."
                                            },
                                            {
                                                "example_id": "e536f881-3af9-4678-8d2f-dffe806f3505",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "Les chauffards vinrent rapidement à leur hauteur, les prirent en tenaille en les fracassant sur les côtés tandis que le troisième véhicule les bloquait par l'avant. Il n'y avait plus d'échappatoire possible […]."
                                            },
                                            {
                                                "example_id": "9a41da51-dc30-4887-9d04-95862fd16af8",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "«Peut-on permettre à un chauffard comme vous de conduire sur route ! On devrait vous pendre ! »"
                                            },
                                            {
                                                "example_id": "f75e0679-4003-4500-8ff3-78529153cf7a",
                                                "sense_id": "e611b53f-18b7-3bdc-afd3-158a1bfb19e4",
                                                "text": "Un bilan positif donnerait suffisamment de poids pour changer la réglementation et imposer aux vélos électriques les mêmes dispositifs anti-chauffard que sur les voitures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
