                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "расплывчатый",
                                "target_lang_sense_clarification": "об объяснениях или очертаниях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指轮廓不清晰或记忆不深刻"
                            },
                            {
                                "target_lang_word": "不明确",
                                "target_lang_sense_clarification": "指解释或表达不清晰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e91f36a2-4e11-38b1-a5dd-01dcd40f3431",
                    "sense_definition": "Raar, vreemd of verdacht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er loopt een <w>vaag</w> type rond in de buurt.",
                            "target_lang_translations": {
                                "en": "There is a <w>sketchy</w> guy walking around the neighborhood.",
                                "ru": "По району ходит какой-то <w>мутный</w> тип.",
                                "zh": "附近有个<w>可疑</w>的人在转悠。"
                            }
                        },
                        {
                            "text": "Hij vertelde een <w>vaag</w> verhaal over waarom hij te laat was.",
                            "target_lang_translations": {
                                "en": "He told a <w>sketchy</w> story about why he was late.",
                                "ru": "Он рассказал какую-то <w>мутную</w> историю о том, почему опоздал.",
                                "zh": "他编了一个<w>古怪</w>的理由来解释为什么迟到。"
                            }
                        }
                    ],
                    "antonyms": [
                        "normaal"
                    ],
                    "common_phrases": [
                        "een vage gast",
                        "vaag doen"
                    ],
                    "traits": [
                        {
