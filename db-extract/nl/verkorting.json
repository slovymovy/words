                                        "sense_id": "d81dce51-22cd-3300-844e-878409cd9604",
                                        "entry_id": "38c3e34a-cbec-3402-8183-e3248d509399",
                                        "glosses": [
                                            "Any of various brief statements of case law made before modern reporting of legal cases."
