                                        "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                                        "entry_id": "1d35454c-8477-3a23-8993-7f04bef82f79",
                                        "glosses": [
                                            "Spécialiste de la sexologie, des troubles dans l’exercice de la sexualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ead0cd8-1ca6-4ee4-914f-ff42503f0f51",
                                                "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                                                "text": "Toutes les femmes sont-elles un peu ondinistes ? Je me souviens d’un vieux livre sur l’ondinisme par Havelock Ellis, sexologue avant la lettre et qui m’avait bien diverti."
                                            },
                                            {
                                                "example_id": "4a2b4768-315a-4ca4-ae33-54fefb64663d",
                                                "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                                                "text": "Il existe, outre les sexologues de formation, des médecins généralistes sexologues, des psychologues sexologues, des gynécologues sexologues, des psycothérapeutes sexologues, des psychiatres sexologues."
                                            }
                                        ]
                                    }
                                ]
                            },
