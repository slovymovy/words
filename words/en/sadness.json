{
    "word_family": [
        "sad",
        "sadly",
        "sadden"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68665fdb-7ae6-3217-aee5-32b7078324a6",
                    "sense_definition": "The state or emotion of being sad.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>sadness</w> after hearing the bad news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала глубокую <w>печаль</w>, услышав плохие новости.",
                                "de": "Sie empfand eine tiefe <w>Traurigkeit</w>, nachdem sie die schlechten Nachrichten gehört hatte.",
                                "zh": "听到坏消息后，她感到一阵深切的<w>悲伤</w>。"
                            }
                        },
                        {
                            "text": "There is often <w>sadness</w> when saying goodbye to close friends.",
                            "target_lang_translations": {
                                "ru": "При прощании с близкими друзьями часто возникает <w>грусть</w>.",
                                "de": "Es gibt oft <w>Traurigkeit</w>, wenn man sich von engen Freunden verabschiedet.",
                                "zh": "与挚友道别时，心中常会涌起一股<w>难过</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unhappiness",
                        "sorrow",
                        "grief",
                        "misery",
                        "melancholy",
                        "depression"
                    ],
                    "antonyms": [
                        "happiness"
                    ],
                    "common_phrases": [
                        "deep sadness",
                        "feelings of sadness",
                        "overcome with sadness",
                        "great sadness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или чувство, когда человеку грустно; эмоциональное переживание печали.",
                        "de": "Der Zustand oder das Gefühl, traurig zu sein; ein emotionales Erlebnis von Betrübnis.",
                        "zh": "感到悲伤的状态或情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грусть",
                                "target_lang_sense_clarification": "чувство лёгкого огорчения, сожаления, неглубокая печаль"
                            },
                            {
                                "target_lang_word": "печаль",
                                "target_lang_sense_clarification": "чувство душевной горечи и утраты, более глубокое, чем грусть"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "сильное душевное томление, глубокая меланхолия или скука"
                            },
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "мрачное, подавленное состояние духа, безнадёжность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Traurigkeit",
                                "target_lang_sense_clarification": "Das allgemeine Gefühl, traurig zu sein."
                            },
                            {
                                "target_lang_word": "Schwermut",
                                "target_lang_sense_clarification": "Ein tieferes, oft anhaltendes Gefühl von Melancholie."
                            },
                            {
                                "target_lang_word": "Betrübnis",
                                "target_lang_sense_clarification": "Ein gehobener Ausdruck für ein Gefühl von Kummer oder Trauer."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悲伤",
                                "target_lang_sense_clarification": "指内心感到痛苦、难过，程度较深。"
                            },
                            {
                                "target_lang_word": "难过",
                                "target_lang_sense_clarification": "指心情不愉快，感到痛苦。"
                            },
                            {
                                "target_lang_word": "忧伤",
                                "target_lang_sense_clarification": "指忧愁和悲伤，常带有文学色彩。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e926c19d-a8e5-331a-ae79-fa68c061dd32",
                    "sense_definition": "An event in one's life that causes sadness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has experienced many <w>sadnesses</w> in her forty years.",
                            "target_lang_translations": {
                                "ru": "За свои сорок лет она пережила много <w>горестей</w>.",
                                "de": "Sie hat in ihren vierzig Jahren viele <w>Schicksalsschläge</w> erlebt.",
                                "zh": "在四十岁的人生中，她经历过许多<w>苦难</w>。"
                            }
                        },
                        {
                            "text": "It was a great <w>sadness</w> for him to leave the house he built.",
                            "target_lang_translations": {
                                "ru": "Для него было огромным <w>горем</w> покидать дом, который он построил.",
                                "de": "Es war ein großer <w>Kummer</w> für ihn, das Haus zu verlassen, das er selbst gebaut hatte.",
                                "zh": "离开自己亲手建造的房子，对他来说是一件非常<w>伤心</w>的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misfortune",
                        "affliction",
                        "hardship",
                        "tragedy"
                    ],
                    "common_phrases": [
                        "many sadnesses",
                        "great sadness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие в жизни, вызывающее чувство печали, горя или огорчения.",
                        "de": "Ein Ereignis im Leben, das Kummer, Leid oder Trauer verursacht.",
                        "zh": "生活中导致悲伤的事件或不幸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горе",
                                "target_lang_sense_clarification": "большое несчастье, трагическое событие"
                            },
                            {
                                "target_lang_word": "огорчение",
                                "target_lang_sense_clarification": "неприятность, вызывающая расстройство"
                            },
                            {
                                "target_lang_word": "печаль",
                                "target_lang_sense_clarification": "источник или причина грусти"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schicksalsschlag",
                                "target_lang_sense_clarification": "Ein schweres, oft plötzliches Ereignis, das das Leben negativ verändert."
                            },
                            {
                                "target_lang_word": "Leid",
                                "target_lang_sense_clarification": "Ein allgemeiner Begriff für schmerzhafte Erfahrungen oder Unglück."
                            },
                            {
                                "target_lang_word": "Kummer",
                                "target_lang_sense_clarification": "Ein anhaltender Schmerz oder Sorge, oft durch ein Ereignis ausgelöst."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悲剧",
                                "target_lang_sense_clarification": "指生活中发生的重大不幸事件。"
                            },
                            {
                                "target_lang_word": "苦难",
                                "target_lang_sense_clarification": "指生活中经历的痛苦和磨难。"
                            },
                            {
                                "target_lang_word": "伤心事",
                                "target_lang_sense_clarification": "指让人感到难过的事情。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}