{
    "word_family": [
        "mixen",
        "mix",
        "mengpaneel",
        "menger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a86de7ea-22ff-36bb-b98d-f4f05f54ecd4",
                    "sense_definition": "Een elektrisch keukengereedschap dat gebruikt wordt om ingrediënten te mengen, te kloppen of te kneden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "keukenapparatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij gebruikt een <w>mixer</w> om het beslag voor de cake glad te maken.",
                            "target_lang_translations": {
                                "it": "Usa uno <w>sbattitore</w> per rendere liscio l'impasto della torta."
                            }
                        },
                        {
                            "text": "Zorg ervoor dat je de <w>mixer</w> uitzet voordat je de gardes schoonmaakt.",
                            "target_lang_translations": {
                                "it": "Assicurati di spegnere lo <w>sbattitore</w> prima di pulire le fruste."
                            }
                        }
                    ],
                    "synonyms": [
                        "handmixer",
                        "keukenmixer"
                    ],
                    "common_phrases": [
                        "elektrische mixer",
                        "de mixer gebruiken"
                    ],
                    "target_lang_definitions": {
                        "it": "Un elettrodomestico da cucina utilizzato per mescolare, sbattere o impastare gli ingredienti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbattitore elettrico",
                                "target_lang_sense_clarification": "per dolci e impasti leggeri"
                            },
                            {
                                "target_lang_word": "frullatore",
                                "target_lang_sense_clarification": "per frullare o mixare ingredienti"
                            },
                            {
                                "target_lang_word": "mixer",
                                "target_lang_sense_clarification": "generico da cucina"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76b5b2d1-be73-3f53-a368-4fe6f57cd25e",
                    "sense_definition": "Een apparaat waarmee audio- of videosignalen van verschillende bronnen worden samengevoegd en bewerkt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "audiovisuele_apparatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dj paste het volume van de muziek aan op zijn <w>mixer</w>.",
                            "target_lang_translations": {
                                "it": "Il DJ ha regolato il volume della musica sul suo <w>mixer</w>."
                            }
                        },
                        {
                            "text": "In de geluidsstudio staat een geavanceerde <w>mixer</w> met tientallen kanalen.",
                            "target_lang_translations": {
                                "it": "Nello studio di registrazione c'è un <w>mixer</w> avanzato con dozzine di canali."
                            }
                        }
                    ],
                    "synonyms": [
                        "mengpaneel",
                        "mengtafel"
                    ],
                    "common_phrases": [
                        "een professionele mixer"
                    ],
                    "target_lang_definitions": {
                        "it": "Un dispositivo utilizzato per combinare ed elaborare segnali audio o video provenienti da diverse sorgenti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "mixer",
                                "target_lang_sense_clarification": "dispositivo audio/video"
                            },
                            {
                                "target_lang_word": "mixer audio",
                                "target_lang_sense_clarification": "specifico per la musica e il suono"
                            },
                            {
                                "target_lang_word": "regolo di missaggio",
                                "target_lang_sense_clarification": "pannello di controllo audio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c7558c7-f779-3c68-8541-b4fcedad12e1",
                    "sense_definition": "Een algemeen apparaat of machine die ontworpen is om verschillende stoffen of materialen tot een mengsel te verwerken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mengapparaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de fabriek wordt de vloeistof door een grote industriële <w>mixer</w> geroerd.",
                            "target_lang_translations": {
                                "it": "In fabbrica, il liquido viene mescolato da un grande <w>miscelatore</w> industriale."
                            }
                        },
                        {
                            "text": "De bouwvakkers gooiden het cement en water in de <w>mixer</w>.",
                            "target_lang_translations": {
                                "it": "Gli operai edili hanno gettato il cemento e l'acqua nella <w>betoniera</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "menger",
                        "mengmachine"
                    ],
                    "common_phrases": [
                        "industriële mixer"
                    ],
                    "target_lang_definitions": {
                        "it": "Un dispositivo o macchina generica progettata per miscelare diverse sostanze o materiali."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "miscelatore",
                                "target_lang_sense_clarification": "per liquidi o sostanze industriali"
                            },
                            {
                                "target_lang_word": "mescolatore",
                                "target_lang_sense_clarification": "macchinario industriale per mescolare"
                            },
                            {
                                "target_lang_word": "betoniera",
                                "target_lang_sense_clarification": "per cemento e materiali edili"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}