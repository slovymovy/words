                "senses": [
                    {
                        "sense_id": "de8a1a63-1f0f-342d-8c6c-f880e4e5291b",
                        "entry_id": "07088850-5fd6-3e9d-b1e2-94160f3f9953",
                        "glosses": [
                            "Lehrer der Musik unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33230088-80ac-473d-b23d-d1af8b90727c",
                                "sense_id": "de8a1a63-1f0f-342d-8c6c-f880e4e5291b",
                                "text": "Wir haben einen netten Musiklehrer."
                            },
                            {
                                "example_id": "2a57ffc5-9252-43ce-8901-3c1677d508ae",
                                "sense_id": "de8a1a63-1f0f-342d-8c6c-f880e4e5291b",
                                "text": "„Nachdem ihr Musiklehrer fortgegangen war, blieb ich mit ihr allein.“"
                            },
                            {
                                "example_id": "73094d97-7e93-4269-8a2f-44fb2f0129b9",
                                "sense_id": "de8a1a63-1f0f-342d-8c6c-f880e4e5291b",
                                "text": "„Ich weiß, daß unser Musiklehrer recht hatte, wenn er Mozart himmlisch, Beethoven großartig, Gluck einzigartig und Bach gewaltig nannte; ich weiß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
