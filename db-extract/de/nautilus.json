                    {
                        "sense_id": "72980ce0-6356-391f-8adc-ee45a456586d",
                        "entry_id": "3e00b171-5ed2-319f-84f4-0c18eafe9cf9",
                        "glosses": [
                            "eine Tiergattung aus der Familie der Perlboote, welche zur Ordnung der Nautiliden gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4ddfe0-ca44-4b3a-8560-10847a9611c3",
                                "sense_id": "72980ce0-6356-391f-8adc-ee45a456586d",
                                "text": "„Da sich der Nautilus seit vielen Millionen Jahren nicht mehr verändert hat, wird er als lebendes Fossil bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
