                                                "example_id": "a385d4de-0ad1-4d3a-aac9-aa5b4bcdeb79",
                                                "sense_id": "3da13856-4836-3f08-80dd-a10ac4ce47c6",
                                                "text": "Сесть стулом"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf44b7d2-64d4-302c-8730-c72516631f53",
                                        "entry_id": "7f2728a1-32ff-3984-9193-e55903a673d7",
                                        "glosses": [
                                            "устар. какая-либо вещь, товар, припас, в виде обрубка или жернова"
                                        ],
