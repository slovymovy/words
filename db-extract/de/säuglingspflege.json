                "senses": [
                    {
                        "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                        "entry_id": "ab847dc5-1adc-3b7c-aaa4-2d756a7f167e",
                        "glosses": [
                            "Maßnahmen im ersten Lebensjahrs eines Babys, damit dieses sich möglichst gesund entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43695f8-f6f3-43f5-9c91-72ccae768f9c",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Vorher hat sie einen Kurs in Säuglingspflege belegt.“"
                            },
                            {
                                "example_id": "eff9d9f7-4e9f-4cd7-9dd3-5e47c93ca5e7",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Das Gesundheitsamt Bremen bietet noch Kurse zu Säuglingspflege an.“"
                            },
                            {
                                "example_id": "81496aa2-4797-4087-a0de-5ebbe580e893",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Sport kann nicht den Geburtsvorbereitungskurs ersetzen, weil in diesen Kursen neben Körperübungen Wichtiges zum Thema Geburt und Säuglingspflege vermittelt wird.“"
                            },
                            {
                                "example_id": "b657d93a-73cc-4f7e-bf29-2016ecfd014d",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Fencheltee wird v. a. in der Säuglingspflege häufig zur Vorbeugung und Therapie von Verdauungsstörungen verwendet.“"
                            },
                            {
                                "example_id": "5f4fa2bc-8cc7-42f6-a853-59a88f9a633b",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "[Freiburg im Üechtland:] „Seit 1983 gibt es einen kantonalen Beratungsdienst für Familienplanung und Säuglingspflege.“"
                            },
                            {
                                "example_id": "0c01908b-26f6-4ffb-b56f-9b3c9f078d4c",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Seit Januar 2023 können sich werdende Eltern außerdem bei der sogenannten “U0”-Untersuchung schon vor der Geburt beim Kinderarzt zu zahlreichen Fragen der Säuglingspflege beraten lassen: Welche Impfungen braucht das Kind? Wie sieht eine sichere Schlafumgebung aus? Worauf muss man beim Stillen achten?“"
                            },
                            {
                                "example_id": "6dae35c9-798d-47cd-b0a8-143243397906",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "[Obwohl die Hebamme Dayo Oliver] „erst 28 Jahre alt ist, hat sie schon über 200 Babys auf die Welt gebracht. Dayo Oliver leistet Geburtshilfe, unterstützt frischgebackene Mütter im Wochenbett, beim Stillen und in der Säuglingspflege.“"
                            },
                            {
                                "example_id": "08c10030-0d4c-448a-9d21-39c625c27c6f",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Die Ärztin Frida Imboden-Kaiser ist die Begründerin des Kinderspitals St. Gallen. Mit ihrem Engagement in der Säuglingspflege rettete sie wohl tausenden Kindern das Leben.“"
                            },
                            {
                                "example_id": "e404ac8c-fcfc-4e79-9b58-4e763574db02",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Als das Paar 1933 Zwillinge bekam, gab Haarer ihre Arzttätigkeit auf und begann Kolumnen über Säuglingspflege zu schreiben, um das Familienbudget aufzubessern.“"
                            },
                            {
                                "example_id": "9d4397c8-1d47-4c39-94be-6aed895010d0",
                                "sense_id": "005559fd-4509-3432-bdd7-b92480e63882",
                                "text": "„Die praktiſche Säuglingspflege muß in einer Krippe oder in einem Säuglingsheim erfolgen, die von ſtaatlich geprüften Säuglingspflegerinnen und von einem Arzt beaufſichtigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
