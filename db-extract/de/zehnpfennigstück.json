                "senses": [
                    {
                        "sense_id": "fedf1472-8bce-3ba9-a48d-5f0d01738837",
                        "entry_id": "208101e1-ba9e-399c-bf92-cd4c3861f7a8",
                        "glosses": [
                            "Münze mit dem Wert von zehn Pfennig"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3a3e4e2c-360c-4465-9406-4bda1f14b139",
                                "sense_id": "fedf1472-8bce-3ba9-a48d-5f0d01738837",
                                "text": "„Nachdenklich zieht er sein Portemonnaie hervor, nimmt zwei Zehnpfennigstücke heraus und zieht an einem grünen Automaten neben dem der Wahrsagerin eine Packung Pfefferminz.“"
                            },
                            {
                                "example_id": "8b9415a5-d70c-4cb9-84f5-6cf88a1ff185",
                                "sense_id": "fedf1472-8bce-3ba9-a48d-5f0d01738837",
                                "text": "„Die restlichen Zehnpfennigstücke hält sie fest in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
