                    {
                        "translation_id": "7e39667c-6931-4d75-8933-efbecab9a2ff",
                        "source_entry_id": "2d0d7ef0-a88b-3d2f-a399-4df0e1b56181",
                        "source_sense_id": "9716395f-8daf-34a4-a578-6eb30cf763d8",
