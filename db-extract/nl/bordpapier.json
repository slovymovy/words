                                                "sense_id": "81c33e63-4010-3a3c-aa86-327203d273a5",
                                                "text": "Feuille de carton."
                                            },
                                            {
                                                "example_id": "c5d8f3d3-4605-48ec-b9c7-fb8bd2bedc50",
                                                "sense_id": "81c33e63-4010-3a3c-aa86-327203d273a5",
                                                "text": "Boîte de carton."
                                            },
