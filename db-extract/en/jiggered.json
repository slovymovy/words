                        ],
                        "examples": [
                            {
                                "example_id": "d7f1584f-84aa-4f63-9302-0c6e76f83f2f",
                                "sense_id": "f401425e-972a-3847-92f4-d19f1060c343",
                                "text": "Time stopped tick-tocking, because there was too much moisture in the air and it had interfered with the mechanical workings of dozens of watches and clocks that ended up jiggered, and afterwards, were only fit to be thrown down on the rubbish dump."
                            }
                        ]
                    },
                    {
                        "sense_id": "a66055b4-9716-3dcb-ae86-a9707ce48858",
                        "entry_id": "05d8f3cf-7da1-365f-9698-71fcd7a14874",
                        "glosses": [
                            "Damned."
                        ],
                        "tags": [
