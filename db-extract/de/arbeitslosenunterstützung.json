                "senses": [
                    {
                        "sense_id": "8e5693a6-ffba-3970-8023-6479be2f2829",
                        "entry_id": "4f57d855-eb55-3533-bd59-b4e8bfb8945d",
                        "glosses": [
                            "das Geld, das die Arbeitslosenversicherung an Arbeitslose auszahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38115639-a250-47c5-957d-72cc018d653c",
                                "sense_id": "8e5693a6-ffba-3970-8023-6479be2f2829",
                                "text": "„Im Wirtschaftsabschwung steigt andererseits die konjunkturelle Arbeitslosigkeit. Der Einkommensverlust bei den Arbeitslosen wird aber durch Arbeitslosenunterstützungen abgefedert.“"
                            },
                            {
                                "example_id": "640e4ffd-fda0-4c55-a5c4-21c1786d16d9",
                                "sense_id": "8e5693a6-ffba-3970-8023-6479be2f2829",
                                "text": "„Manche meinen, das Essen sei besser als das, was sie zu Hause von ihrer Arbeitslosenunterstützung bekämen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
