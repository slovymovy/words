                                        "entry_id": "64f8438a-01ae-304c-9374-03d22038134d",
                                        "glosses": [
                                            "A grape plantation, especially one used in the production of wine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8439758-9982-41ec-9301-021ea41a3dc4",
                                                "sense_id": "edb55d63-3d6f-3769-9815-66eaf4ecab0c",
                                                "text": "The vineyard of Château Margaux stands as the producer of one of the world's greatest and most sought-after red wines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dc531d0-ab16-441f-92f3-d6a62472d159",
                        "source_entry_id": "5e655f21-d631-39d2-8eae-0cc78421c772",
                        "source_sense_id": "691cd04e-b8aa-3d0a-9c93-9e9c8d07430f",
