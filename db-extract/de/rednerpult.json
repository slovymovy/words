                    {
                        "form_id": "b8ad526f-9dd1-4c82-ab9c-a08e823553e1",
                        "entry_id": "22cabb35-4ada-3933-b28a-5dccb01299b9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rednerpulte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab558301-eaea-30f7-a38b-e9d41f7ef5e4",
                        "entry_id": "22cabb35-4ada-3933-b28a-5dccb01299b9",
                        "glosses": [
                            "(oft schräger) Tisch oder Tischaufsatz, auf dem ein Vortragender seine Unterlagen ablegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b747d3c-6f3a-480e-9bcb-4f433c72a382",
                                "sense_id": "ab558301-eaea-30f7-a38b-e9d41f7ef5e4",
                                "text": "„Dort hat Duschkans Fritze mit Hilfe seiner Mitarbeiter ein Rednerpult aus starken Brettern aufgestellt, ein Rednerpult, das einen kräftigen Faustschlag verträgt.“"
                            },
                            {
                                "example_id": "e611c161-1b56-44c3-aa26-134ceeddfd3b",
                                "sense_id": "ab558301-eaea-30f7-a38b-e9d41f7ef5e4",
                                "text": "„Der König aber bleibt, wie im Schreck erstarrt, auf seinem Stuhl links vom Rednerpult sitzen.“"
                            },
                            {
                                "example_id": "26d67c17-18ce-467a-b09c-c5bbaf08a267",
                                "sense_id": "ab558301-eaea-30f7-a38b-e9d41f7ef5e4",
                                "text": "„An der Frontseite des Rednerpults prangte die Flagge der NATO.“"
                            },
                            {
                                "example_id": "23afd3af-bef9-4c88-abd8-585be20cd54b",
                                "sense_id": "ab558301-eaea-30f7-a38b-e9d41f7ef5e4",
                                "text": "„Gemächlich nahm ich das Rednerpult ein und dozierte anscheinend aus dem Stegreif eine gute Viertelstunde über die Funktion von Mutterliebe und Mutterpflicht im Werk Bertold Brechts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
