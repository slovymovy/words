                        "glosses": [
                            "Nom donné à la résine de première qualité que l'on récolte sur les pins maritimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00afe47f-1b01-4f45-aa94-16d0cd507402",
                                "sense_id": "3e49e699-6cfe-36f9-b934-09a9c6aa465d",
                                "text": "La Périne vierge est la résine qui coule naturellement de l'arbre, une fois filtrée elle se nomme périne bijou,"
                            },
                            {
                                "example_id": "267ced5f-476d-4ef6-8031-84216e1ba384",
                                "sense_id": "3e49e699-6cfe-36f9-b934-09a9c6aa465d",
                                "text": "Les Provençaux donnent le nom de périne vierge au suc qui découle par incision au pied des pins , et celui de bijou à celui qu'ils font découler dans un autre."
                            }
                        ]
                    }
