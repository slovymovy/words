    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85898991-2e45-3c8c-b7d5-8a921935dcc6",
                    "sense_definition": "met feiten of argumenten aantonen dat iets waar is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aantonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat probeerde de onschuld van zijn cliënt te <w>bewijzen</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer tried to <w>prove</w> his client's innocence.",
                                "ru": "Адвокат пытался <w>доказать</w> невиновность своего подзащитного."
                            }
                        },
                        {
                            "text": "Je moet je stelling <w>bewijzen</w> met duidelijke cijfers en feiten.",
                            "target_lang_translations": {
                                "en": "You must <w>prove</w> your thesis with clear figures and facts.",
                                "ru": "Вы должны <w>доказать</w> свой тезис четкими цифрами и фактами."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantonen"
                    ],
                    "common_phrases": [
                        "stelling bewijzen",
                        "onschuld bewijzen",
                        "tegendeel bewijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To demonstrate that something is true or valid using facts or arguments",
                        "ru": "Доказывать истинность чего-либо с помощью фактов или аргументов"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prove",
                                "target_lang_sense_clarification": "to demonstrate truth with evidence"
                            },
                            {
                                "target_lang_word": "demonstrate",
                                "target_lang_sense_clarification": "to show clearly by giving proof"
                            },
                            {
                                "target_lang_word": "substantiate",
                                "target_lang_sense_clarification": "to provide evidence to support a claim"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "доказывать",
                                "target_lang_sense_clarification": "подтверждать истинность фактами"
                            },
                            {
                                "target_lang_word": "обосновывать",
                                "target_lang_sense_clarification": "приводить веские аргументы"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "служить доказательством"
                            }
                        ]
