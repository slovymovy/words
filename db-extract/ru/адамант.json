                                                "sense_id": "c857b4bd-ca0e-3704-b8a8-f6f68e7d2aac",
                                                "text": "What a beautiful engagement diamond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66aa6490-27c0-39e5-83c2-ce3f9be218a2",
