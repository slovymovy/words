                                                "example_id": "256ae3e7-7a79-448a-bebc-b3775e3afbaa",
                                                "sense_id": "c544aa50-3be8-3a62-9c72-97033ec36c0b",
                                                "text": "Merchants sometimes discount five or six per cent for prompt payment of bills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To disregard an account or regard as unimportant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62aca499-b295-4e18-bc39-a01f3e30523e",
                                                "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                                "text": "Owing to his reputation, they discounted his comments."
                                            },
                                            {
                                                "example_id": "976695a5-4155-4aa3-95e2-b82613558685",
                                                "sense_id": "18d2d7cd-b883-35ec-8f53-74ead2cae82f",
                                                "text": "Of the three opinions, (I discount Brown's), under this head, one supposes that the law of Causality is a positive affirmation, and a primary fact of thought, incapable of all further analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To lend money upon, deducting the discount or allowance for interest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e570bc-4551-4ff3-ba63-31a8d1717e3a",
                                                "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                                "text": "The banks discount notes and bills of exchange."
                                            },
                                            {
                                                "example_id": "1ab94dc3-31ef-4c39-b834-3524db9fb9b1",
                                                "sense_id": "cbabe04f-f522-3b03-89cb-b7c251664a02",
                                                "text": "Discount only unexceptionable paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa7a8b9-2b90-3ad6-b182-a2ec68c8d65e",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To take into consideration beforehand; to anticipate and form conclusions concerning (an event)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c212b2-3193-4bf9-adf5-2e948a76ccfc",
                                                "sense_id": "efa7a8b9-2b90-3ad6-b182-a2ec68c8d65e",
                                                "text": "The market has dropped, discounting changes in interest rates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701ba9f7-fc07-3a8f-8529-4fc44299e3de",
                                        "entry_id": "61fcfb0f-18a2-37fd-b4fe-c073c7a7fe6e",
                                        "glosses": [
                                            "To believe, or act as though one believes, that one's own feelings are more important than the reality of a situation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
