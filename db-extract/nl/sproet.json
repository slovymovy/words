                    {
                        "sense_id": "0b45444d-51a5-35e0-a06b-87907c6acfea",
                        "entry_id": "068fb326-6ff1-34f1-9ff8-4bdfb8015e0b",
                        "glosses": [
                            "een bruin vlekje op de huid dat veroorzaakt wordt door ultraviolet licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43746d42-6e41-4c3d-a826-621419abee12",
                                "sense_id": "0b45444d-51a5-35e0-a06b-87907c6acfea",
                                "text": "Zij had veel sproeten in haar gezicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3e59afe-fcc4-4661-93fc-478e5f65b191",
                        "source_entry_id": "068fb326-6ff1-34f1-9ff8-4bdfb8015e0b",
                        "source_sense_id": "0b45444d-51a5-35e0-a06b-87907c6acfea",
                        "source_sense_description": "een bruin vlekje op de huid dat veroorzaakt wordt door ultraviolet licht",
                        "target_lang_word": "Sommersprosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommersprosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                        "entry_id": "662d6da6-0feb-3454-bb0b-44e9d7fd5bec",
                                        "glosses": [
                                            "(sommers deutlicher sichtbar werdender) kleiner, bräunlicher Pigmentfleck auf der Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b61fa1eb-b538-40b7-af4c-4585123d1ca7",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "Sie hatte viele Sommersprossen im Gesicht."
                                            },
                                            {
                                                "example_id": "2ca18c2e-c326-4dc4-a331-af7a1caff308",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "„Und Grube 34 hatte keinen Pumpenmeister, sondern eine Pumpenmeisterin; und die Fördermaschinistin hatte Sommersprossen auf ihrer Stupsnase.“"
                                            },
                                            {
                                                "example_id": "ebc53eb1-0a98-488f-b913-47ca2c787d39",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "„Diese Szene kam mir vertraut vor, das Gefühl der Spannung kannte ich gut, auch das der Erleichterung, als er, da die Antwort auf seine Frage wohl befriedigend gewesen war, endlich das Visum stempelte und mir meinen Paß mit seiner von Sommersprossen übersäten Hand über die Theke zurückreichte:[…].“"
                                            },
                                            {
                                                "example_id": "01a858a8-c995-406a-9351-68b8f05bd3d2",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "„Eigentlich hatte er nichts für rothaarige Frauen übrig, schon gar nicht, wenn sie Sommersprossen hatten.“"
                                            },
                                            {
                                                "example_id": "2aa6d65e-db71-4b33-babd-9b1d57f409ad",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "„Dick, ein kleiner, ungefähr dreizehn Jahre alter Junge, wurde unter seinen Sommersprossen rot.“"
                                            },
                                            {
                                                "example_id": "6dc6a51f-7fff-411d-b28a-975897002035",
                                                "sense_id": "fb607874-a355-3548-b5e1-4c0a98c9b2aa",
                                                "text": "„Die leichte Bräune lässt winzige Sommersprossen auf ihren Wangen und ihrer Nase zum Vorschein kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c78e93cd-2374-4ca1-b4c7-e81d820c9ef8",
