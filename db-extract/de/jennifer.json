                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca8e9961-cdb0-4f8a-a42e-4ae83903d166",
                        "source_entry_id": "0b1fed49-91e9-34ae-895a-ce5be67198d8",
                        "source_sense_id": "a993a656-32aa-353a-915f-0a0c1c852513",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Jennifer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jennifer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                        "entry_id": "9a0e91ec-ed10-3229-9df0-3c1228c67429",
                                        "glosses": [
                                            "A female given name from Cornish, Middle Cornish, or Proto-Brittonic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998d4d44-ba25-471f-93f0-435197723b5d",
                                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                                "text": "RIDGEON. Thats a wonderful drawing. Why is it called Jennifer?\nMRS DUBEDAT. My name is Jennifer.\nRIDGEON. A strange name.\nMRS DUBEDAT. Not in Cornwall. I am Cornish. It's only what you call Guinevere."
                                            },
                                            {
                                                "example_id": "1814917f-036a-43cf-bd2b-4725a6f1cab1",
                                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                                "text": "\"Most people's sisters have decent names like Jennifer or Jane or something. What did you say hers was?\""
                                            },
                                            {
                                                "example_id": "9d97a681-5883-4270-87e8-fe97cabd225b",
                                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                                "text": "Jennifer. Jenny with the light brown hair. Jenny-fair, their high school French teacher had called her, and fair she had been."
                                            },
                                            {
                                                "example_id": "d7991506-179e-44f3-be44-e908ed4578c8",
                                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                                "text": "“When it comes to the dry skin, it’s really a matter of that top barrier that’s not holding onto the moisture as well,” said Dr. Jennifer Stein, a dermatologist at NYU Langone Health."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65da11e6-ae0d-413b-80c8-c3582ce71b02",
                        "source_entry_id": "0b1fed49-91e9-34ae-895a-ce5be67198d8",
                        "source_sense_id": "a993a656-32aa-353a-915f-0a0c1c852513",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Geneviève",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geneviève",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                        "entry_id": "e54ce096-3a33-35ef-8a57-0a77db9effbf",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6aaaa7f-b181-48f0-8363-acc2ac44d85b",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Elle s’appelait Geneviève. Elle appartenait à une des dix meilleures familles de la ville."
                                            },
                                            {
                                                "example_id": "9cee862f-35c9-4a93-82f5-ee0734d8d8b5",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Zaza me conduisit dans la chambre que je devais partager avec elle et Geneviève de Bréville, une petite jeune fille fraîche et sage dont Mme Mabille raffolait."
                                            },
                                            {
                                                "example_id": "ec7938a5-43fc-4fea-bed6-fd1d6bebdcea",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Telle une déesse lors du banquet des dieux, gambas et txakoli en guise de nectar et ambroisie, Geneviève me rejoignit pour que je trouve moins long le temps de risotter."
                                            },
                                            {
                                                "example_id": "74b712a1-3a63-4504-b95e-b3b428e02dd9",
                                                "sense_id": "2869b82a-ee78-316b-b944-b853c300fd31",
                                                "text": "Fondée en 1988 par Henriette Joël, qui en fut la première présidente, et aujourd’hui présidée par Geneviève Escoffier, l’association des Amis du Musée de Saint-Cloud s’est donné pour objet d’aider le musée à enrichir ses collections (acquisitions d’œuvres) et à développer ses actions et son rayonnement auprès du public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
