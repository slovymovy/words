                        ],
                        "examples": [
                            {
                                "example_id": "d5f2b1e0-50b2-42b7-b90e-b4870b18a13b",
                                "sense_id": "6f329dcc-eddb-3112-a174-2f25d5d5558a",
                                "text": "Kann man an dieser Uni Sumerologie studieren?"
                            },
                            {
                                "example_id": "c407b6e4-7c4b-40fb-be86-e078a1451658",
                                "sense_id": "6f329dcc-eddb-3112-a174-2f25d5d5558a",
                                "text": "Durch die Entdeckung vieler neuer Keilschrifttexte machte die Sumerologie große Fortschritte."
                            },
                            {
                                "example_id": "f519b636-d10c-46cf-a670-946e12a6c00f",
                                "sense_id": "6f329dcc-eddb-3112-a174-2f25d5d5558a",
                                "text": "Ein ungeklärtes Rätsel der Sumerologie ist die Verwandtschaft der sumerischen Sprache."
                            },
                            {
                                "example_id": "07e21047-bab1-4d6b-9820-4d1ddf332471",
                                "sense_id": "6f329dcc-eddb-3112-a174-2f25d5d5558a",
                                "text": "„In der Sumerologie hat sich der Begriff für einen Kasus eingebürgert, der auch oft die Richtung zu einem Ziel angibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
