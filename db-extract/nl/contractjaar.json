                        "glosses": [
                            "periode van een jaar dat een economische overeenkomst geldigheid heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f60f6126-4642-4a36-9ba8-f241de0b7e09",
                                "sense_id": "db27a682-b235-364b-af87-df8f329f3191",
                                "text": "Huistra was tussen 2010 en 2012 hoofdtrainer van FC Groningen, waar hij na een tegenvallend seizoen niet aan zijn derde contractjaar hoefde te beginnen. De oud-international had daarvoor Jong Ajax onder zijn hoede."
                            },
                            {
                                "example_id": "f96c54bc-44c0-4300-89ab-f8b829d4a66d",
                                "sense_id": "db27a682-b235-364b-af87-df8f329f3191",
                                "text": "Zijn voorlaatste contractjaar - \"ik zou zo maar mijn laatste wedstrijd gespeeld kunnen hebben\" - had moeten uitmonden in een kampioenschap met Ajax. Met hem in de hoofdrol."
                            },
                            {
                                "example_id": "75fe9b76-6178-4f83-9ae6-959e9d6e7637",
                                "sense_id": "db27a682-b235-364b-af87-df8f329f3191",
                                "text": "Kwakman had bij Augsburg nog een doorlopend contractjaar in Duitsland. Zijn overgang naar Groningen is financieel mede mogelijk gemaakt met de hulp van een sponsorrelatie."
                            }
                        ]
                    }
