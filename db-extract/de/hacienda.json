                ],
                "senses": [
                    {
                        "sense_id": "81609a0e-2c36-3cc1-a372-c4146c2cf571",
                        "entry_id": "6b083005-2081-3ab2-b947-52fd9c35672b",
                        "glosses": [
                            "Landgut in Lateinamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c62fd2-fd6f-4a50-b50e-f9b41dfcf741",
                                "sense_id": "81609a0e-2c36-3cc1-a372-c4146c2cf571",
                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                            },
                            {
                                "example_id": "eacd3d24-21b1-4750-b686-9420e767d10c",
                                "sense_id": "81609a0e-2c36-3cc1-a372-c4146c2cf571",
                                "text": "„Je kleiner die Zahl der Indios durch die regelmäßigen Epidemien wurde, desto mehr übernahmen die »castas« ihre Rolle im Städtebau, in den Silber- und Goldminen und auf den Haciendas der spanischen Adligen.“"
                            },
                            {
                                "example_id": "0bdfb1e2-6e89-4c86-b149-8b0367003bbc",
                                "sense_id": "81609a0e-2c36-3cc1-a372-c4146c2cf571",
                                "text": "„Die Zeit schien stillzustehen; zwischen den alten Haciendas sah man oft Autos aus den dreißiger Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
