                "senses": [
                    {
                        "sense_id": "f49dad32-4820-337e-8886-29477884f326",
                        "entry_id": "4875b2ff-2d4b-3463-a3f6-fa3b2cc93d25",
                        "glosses": [
                            "jemand, der Steindrucke (Lithografien) herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b24cedf-4fd7-4f27-8407-a4d06523f666",
                                "sense_id": "f49dad32-4820-337e-8886-29477884f326",
                                "text": "„Fernand Mourlot hatte zu Beginn der Zwanzigerjahre die Druckerei von seinem Vater übernommen und sich bald einen Namen als Steindrucker, also für den künstlerischen Druck von Lithografien, gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35400778-ad89-4854-97e9-836086f196ca",
                        "source_entry_id": "4875b2ff-2d4b-3463-a3f6-fa3b2cc93d25",
                        "source_sense_id": "f49dad32-4820-337e-8886-29477884f326",
                        "source_sense_description": "jemand, der Steindrucke (Lithografien) herstellt",
                        "target_lang_word": "lithographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lithographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "684f5468-5d14-3b62-883e-60b07faf24f0",
                                        "entry_id": "a3c3fd73-78f9-3a38-850b-427b31c200d4",
                                        "glosses": [
                                            "Celui, celle qui imprime par les procédés de la lithographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec599cb9-4ce0-4e41-a9d1-9ecef8d13ce2",
                                                "sense_id": "684f5468-5d14-3b62-883e-60b07faf24f0",
                                                "text": "L’atelier appartient à un lithographe qui, pour améliorer son ordinaire, organise ces séances de nus."
                                            },
                                            {
                                                "example_id": "32fd5520-805e-4677-a673-02c3081b89af",
                                                "sense_id": "684f5468-5d14-3b62-883e-60b07faf24f0",
                                                "text": "Rien de plus plat, de plus nul, de plus insipide que ces interminables lanières de terrain, pareilles à ces bandelettes au moyen desquelles les lithographes renferment les boulevards de Paris dans une même feuille de papier."
                                            },
                                            {
                                                "example_id": "ba11e4ac-66ca-4d87-9fe0-532775d91251",
                                                "sense_id": "684f5468-5d14-3b62-883e-60b07faf24f0",
                                                "text": "Alors que des burinistes et des aquafortistes s'efforçaient de maintenir la prééminence de l'art sur le métier, les lithographes et les graveurs sur bois se flattaient, au contraire, de triompher des procédés photomécaniques en cherchant à les imiter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
