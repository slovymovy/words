{
    "word_family": [
        "capsule",
        "encapsulation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8ff6fc6-fd3d-34f5-ab4b-771481fe7e02",
                    "sense_definition": "To express the essential features of something in a brief summary.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This short speech perfectly <w>encapsulates</w> the main goals of our new project.",
                            "target_lang_translations": {
                                "ru": "Эта короткая речь идеально <w>подытоживает</w> главные цели нашего нового проекта."
                            }
                        },
                        {
                            "text": "The photograph <w>encapsulated</w> the joy of the entire summer vacation.",
                            "target_lang_translations": {
                                "ru": "Эта фотография <w>воплотила в себе</w> радость всех летних каникул."
                            }
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "epitomize",
                        "embody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратко выражать, подытоживать или воплощать в себе суть чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подытоживать",
                                "target_lang_sense_clarification": "кратко формулировать суть"
                            },
                            {
                                "target_lang_word": "воплощать",
                                "target_lang_sense_clarification": "воплощать в себе, выражать"
                            },
                            {
                                "target_lang_word": "вмещать в себя",
                                "target_lang_sense_clarification": "в сжатом виде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c324098-bfac-344d-9691-7e0c6629d2f6",
                    "sense_definition": "To cover or surround something completely, as if in a capsule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick layer of wax <w>encapsulates</w> the delicate flower to preserve it.",
                            "target_lang_translations": {
                                "ru": "Толстый слой воска <w>покрывает</w> нежный цветок <w>оболочкой</w>, чтобы сохранить его."
                            }
                        },
                        {
                            "text": "The ancient resin <w>encapsulated</w> the insect for thousands of years.",
                            "target_lang_translations": {
                                "ru": "Древняя смола <w>запечатала</w> насекомое на тысячи лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "enclose",
                        "surround",
                        "envelop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью покрывать или заключать что-либо в оболочку, как в капсулу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инкапсулировать",
                                "target_lang_sense_clarification": "помещать в капсулу или оболочку"
                            },
                            {
                                "target_lang_word": "заключать в капсулу",
                                "target_lang_sense_clarification": "покрывать защитным слоем"
                            },
                            {
                                "target_lang_word": "запечатывать",
                                "target_lang_sense_clarification": "герметично окружать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c919f636-5a99-3a94-be8f-4059fad190c5",
                    "sense_definition": "To hide the internal details of an object or function within a program to protect its state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good software design helps to <w>encapsulate</w> complex logic within simple classes.",
                            "target_lang_translations": {
                                "ru": "Грамотное проектирование ПО помогает <w>инкапсулировать</w> сложную логику внутри простых классов."
                            }
                        },
                        {
                            "text": "We <w>encapsulated</w> the database connection settings to prevent accidental modification.",
                            "target_lang_translations": {
                                "ru": "Мы <w>инкапсулировали</w> настройки подключения к базе данных, чтобы предотвратить их случайное изменение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать внутренние детали объекта или модуля в программировании для защиты его состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инкапсулировать",
                                "target_lang_sense_clarification": "в объектно-ориентированном программировании"
                            },
                            {
                                "target_lang_word": "скрывать реализацию",
                                "target_lang_sense_clarification": "защищать внутренние данные объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0a26d2-5089-3676-b684-b6ea92793b24",
                    "sense_definition": "To wrap data into a specific format for transmission over a network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network protocol <w>encapsulates</w> the data packets before sending them.",
                            "target_lang_translations": {
                                "ru": "Сетевой протокол <w>инкапсулирует</w> пакеты данных перед их отправкой."
                            }
                        },
                        {
                            "text": "The system <w>encapsulated</w> the information to ensure it could be read by the receiver.",
                            "target_lang_translations": {
                                "ru": "Система <w>упаковала</w> информацию так, чтобы получатель гарантированно мог её прочитать."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упаковывать данные в определённый формат или сетевой пакет для передачи по сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инкапсулировать",
                                "target_lang_sense_clarification": "в сетевых протоколах"
                            },
                            {
                                "target_lang_word": "упаковывать",
                                "target_lang_sense_clarification": "помещать пакет данных в заголовок другого протокола"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}