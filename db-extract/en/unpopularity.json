                                    {
                                        "sense_id": "a9c7d649-a5da-387d-8bd5-df81ec0017d2",
                                        "entry_id": "e2dab995-cbe1-3c8c-b7f4-b999d074537c",
                                        "glosses": [
                                            "het niet geliefd zijn bij veel mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632debfb-2bac-4ae2-ba17-a561dc025edb",
                                                "sense_id": "a9c7d649-a5da-387d-8bd5-df81ec0017d2",
                                                "text": "De legers waren versnipperd, er was geen eenheid in de leiding, Barclay was niet populair; maar die warboel, die versplintering en de impopulariteit van de Duitse opperbevelhebber resulteerden enerzijds in de besluiteloosheid en het ontwijken van het gevecht (wat onvermijdelijk zou zijn geweest als de legers verenigd waren en Barclay geen commandant was geweest), anderzijds in een groeiende anti-Duitse stemming en een groeiend patriottisme."
                                            },
                                            {
                                                "example_id": "b34b6d61-7d68-4d63-9e97-3ad3937e1f4f",
                                                "sense_id": "a9c7d649-a5da-387d-8bd5-df81ec0017d2",
                                                "text": "Verschil met de vorige regeerperiode, toen alle oppositiepartijen in de Peilingwijzer profiteerden van de impopulariteit van de regeringspartijen, is dat inmiddels ook partijen als de PVV en de SP het moeilijk hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4277039-82a3-4524-a6aa-fc43f5b6573d",
                        "source_entry_id": "91e4ea58-59f7-31be-b2a4-7dc5fb61c386",
                        "source_sense_id": "37af9a96-98c0-304b-9c07-ba0fd08b4ee1",
                        "source_sense_description": "property or degree of being unpopular",
                        "target_lang_word": "impopularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impopularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ff59c3-97a2-3085-8c35-f4e763bbff51",
                                        "entry_id": "5bdf9a11-4e8b-3886-92b6-a15470f29cfd",
                                        "glosses": [
                                            "Défaut de popularité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ea37e4-814e-42f6-8c00-99faa243ac00",
                                                "sense_id": "e0ff59c3-97a2-3085-8c35-f4e763bbff51",
                                                "text": "Son impopularité n'en poussa pas moins le peuple à lui chercher un remplaçant parmi les imaginaires héritiers du Terrible."
                                            },
                                            {
                                                "example_id": "5968df7e-49dd-46cb-bcb7-449a66b04279",
                                                "sense_id": "e0ff59c3-97a2-3085-8c35-f4e763bbff51",
                                                "text": "Ne désespérons cependant pas de voir un jour le parlement, dans un élan collectif de patriotisme, oser braver certaines tendances funestes, chères à une partie de l'opinion publique, et de risquer même le danger d'une impopularité passagère, pour assurer le bien du peuple malgré lui."
                                            },
                                            {
                                                "example_id": "89866494-33cd-4481-be9f-03231437d564",
                                                "sense_id": "e0ff59c3-97a2-3085-8c35-f4e763bbff51",
                                                "text": "Seul, Delcassé s'est rendu à l’Étoile en auto ouverte. Il espérait une ovation, mais la foule resta muette. Elle exprimait à son insu l’impopularité de cette guerre, et ses appréhensions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
