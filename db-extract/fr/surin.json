            {
                "entry_id": "ee7a8d9c-4006-363e-bddd-ec79a8241dd9",
                "word": "surin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ddc957a-e250-4797-85e2-5f14dfce9c71",
                        "entry_id": "ee7a8d9c-4006-363e-bddd-ec79a8241dd9",
                        "tags": [
                            "plural"
                        ],
                        "form": "surins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56873d1b-888b-3010-a0b6-42f5bbee51dc",
                        "entry_id": "ee7a8d9c-4006-363e-bddd-ec79a8241dd9",
                        "glosses": [
                            "Couteau, poignard."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "86eb3e50-c939-4714-89c9-9cae762c03e5",
                                "sense_id": "56873d1b-888b-3010-a0b6-42f5bbee51dc",
                                "text": "Aussi je ne veux pas qu’il leur fasse du mal à ces ratons, et je garde le surin."
                            },
                            {
                                "example_id": "d110e5c6-3b2a-432b-a8a0-7ecfa60efcb6",
                                "sense_id": "56873d1b-888b-3010-a0b6-42f5bbee51dc",
                                "text": "Jean Valjean tira de son gousset un couteau, et l’ouvrit. — Un surin ! s’écria Javert."
                            },
                            {
                                "example_id": "74b98d6f-5a4c-4c00-8566-0be0937c4067",
                                "sense_id": "56873d1b-888b-3010-a0b6-42f5bbee51dc",
                                "text": "On condamne à mort le meurtrier timide qui tue le passant d’un coup de surin, au détour des rues nocturnes."
                            },
                            {
                                "example_id": "c0ef55c3-90d8-4d86-90d0-64d6bda92f69",
                                "sense_id": "56873d1b-888b-3010-a0b6-42f5bbee51dc",
                                "text": "– Chien-Fou, récupère toute leur quincaillerie, surins, pétoires, qu’on ait pas de mauvaise surprise !"
                            }
                        ]
                    }
                ],
