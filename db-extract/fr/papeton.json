                "senses": [
                    {
                        "sense_id": "d2da4489-c43e-3341-8872-3894f2c2cb73",
                        "entry_id": "38f862d6-2eab-3575-a552-88a49abf5481",
                        "glosses": [
                            "Flan de légumes, plus particulièrement d’aubergines."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "f169a439-50fd-453f-a7a3-69c5ff5c49cd",
                                "sense_id": "d2da4489-c43e-3341-8872-3894f2c2cb73",
                                "text": "Coupez le papeton en tranches, dressez-les sur les assiettes, entourées et nappées d’un peu de coulis."
                            },
                            {
                                "example_id": "0f4902ab-eb9d-41b5-936e-94a59abfc16f",
                                "sense_id": "d2da4489-c43e-3341-8872-3894f2c2cb73",
                                "text": "Papeton de courgettes, de légumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a405e7a-961d-327d-856a-5b89a3ea2926",
                        "entry_id": "38f862d6-2eab-3575-a552-88a49abf5481",
                        "glosses": [
                            "Cœur d’un épi de maïs, rafle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fea2875-f67d-4847-ac7f-f67ab110fc4c",
                                "sense_id": "2a405e7a-961d-327d-856a-5b89a3ea2926",
                                "text": "La quatrième façon d’égrener le maïs, dans plusieurs de nos provinces se réduit à tenir l’épi de la main droite et à le frotter avec le papeton d’un autre épi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4801dc1-d7b3-3986-b3ce-70fd83a62822",
                        "entry_id": "38f862d6-2eab-3575-a552-88a49abf5481",
                        "glosses": [
                            "Cœur d’un épi de maïs, rafle.",
                            "Combustible."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "471c0c4b-e091-4053-8e45-7afce4f1516f",
                                "sense_id": "d4801dc1-d7b3-3986-b3ce-70fd83a62822",
                                "text": "Le papeton sert à ranimer le feu, il l’alimente seul dans quelques familles, ainsi rien ne demeure sans être utilisé dans cette plante précieuse."
                            }
                        ]
                    }
                ],
