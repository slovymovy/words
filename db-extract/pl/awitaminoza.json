                                        "glosses": [
                                            "Carence totale, absence d’une ou plusieurs vitamines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4580c5-d2fc-4a96-885c-26b90c015be7",
                                                "sense_id": "3364f302-f43f-3b6a-882f-24f0f3dbd867",
                                                "text": "Le béribéri fut la première avitaminose connue."
                                            },
                                            {
                                                "example_id": "c09c53a4-ed0e-4723-8d8f-b0418e3ee452",
                                                "sense_id": "3364f302-f43f-3b6a-882f-24f0f3dbd867",
                                                "text": "Une carence vitaminique observe une (avitaminose), le cas contraire marque une (hypervitaminose)."
