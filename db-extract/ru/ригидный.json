                                        "examples": [
                                            {
                                                "example_id": "93ee0820-c013-4b47-9d15-b303a853de66",
                                                "sense_id": "ce15653c-4b7f-3140-abbb-aae58d37cf00",
                                                "text": "Er glaubte mal wieder, rigide durchgreifen zu müssen."
                                            },
                                            {
                                                "example_id": "add3743e-c294-4aaa-875e-f17ab1f3a7df",
                                                "sense_id": "ce15653c-4b7f-3140-abbb-aae58d37cf00",
                                                "text": "„Australien gehört seit Beginn der Coronakrise zu den Ländern mit den rigidesten Einreiseregeln und ist weiterhin fast völlig abgeschottet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
