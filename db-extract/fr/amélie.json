                        "sense_id": "4b24ad14-287f-3287-b4df-fb5146f04439",
                        "entry_id": "8cc985fb-0aeb-3ab6-92ec-7961e8a51f35",
                        "glosses": [
                            "Absence congénitale d’un ou de plusieurs membres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30b8836e-eed7-4407-872f-4fb1cbcef7a6",
                                "sense_id": "4b24ad14-287f-3287-b4df-fb5146f04439",
                                "text": "La thalidomide prescrite contre les nausées des femmes enceintes a provoqué de nombreuses malformations telles que l’amélie."
                            },
                            {
                                "example_id": "6ac1ae04-8100-4618-a0fd-1debb7ca0769",
                                "sense_id": "4b24ad14-287f-3287-b4df-fb5146f04439",
                                "text": "D’autres, au contraire, sont compatibles avec la vie comme les phocomélies ou les amélies, récemment mises à l’ordre du jour par les accidents dus à la thalidomide."
                            }
                        ]
                    }
