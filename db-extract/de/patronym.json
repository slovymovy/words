                                    {
                                        "sense_id": "ed4068b1-b06a-399b-9292-69784635519c",
                                        "entry_id": "c060d8f0-79a3-35ce-8801-eb428fc83b93",
                                        "glosses": [
                                            "relativo a un nome proprio che deriva dal nome del padre di una persona, generalmente apponendo un suffisso o un prefisso o utilizzando altre costruzioni linguistiche"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd4d2ad-cc52-4dea-a2a9-ae99411496b3",
                                                "sense_id": "ed4068b1-b06a-399b-9292-69784635519c",
                                                "text": "l'appellativo patronimico di Achille era Pelide in quanto era figlio di Peleo"
                                            },
                                            {
                                                "example_id": "5b199806-f1d3-4d1a-aa75-a0f1acecd835",
                                                "sense_id": "ed4068b1-b06a-399b-9292-69784635519c",
                                                "text": "in Italia esistono alcuni cognomi di origine patronimica, come per esempio \"Di Giacomo\" o \"Di Giovanni\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e48299-6a2c-3fd2-a213-692978c308db",
                                        "entry_id": "c060d8f0-79a3-35ce-8801-eb428fc83b93",
                                        "glosses": [
                                            "relativo a un nome proprio ereditato dal padre, come per esempio il cognome (vedi sotto)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patronimico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "084a2036-ee69-3546-a2e2-e6fe6e635285",
                                        "entry_id": "9128963c-eab5-30b2-86bf-8d03a07864e0",
                                        "glosses": [
                                            "il nome patronimico (vedi sopra)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b724275-2753-4594-93df-05f9fa25b02c",
                                                "sense_id": "084a2036-ee69-3546-a2e2-e6fe6e635285",
                                                "text": "il patronimico di Mikhail Gorbachëv è Sergeevič, infatti il padre si chiamava Sergej"
                                            },
                                            {
                                                "example_id": "f416f635-2a17-4f77-9b20-64457b33dbb7",
                                                "sense_id": "084a2036-ee69-3546-a2e2-e6fe6e635285",
                                                "text": "in Islanda non esiste il cognome; ai figli si assegnano solamente il nome e il patronimico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0547d8-55a8-3449-97e0-404dd0d0e867",
                                        "entry_id": "9128963c-eab5-30b2-86bf-8d03a07864e0",
                                        "glosses": [
                                            "il cognome o altro nome proprio ereditato dal padre"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e72fee0-f896-46d9-9f9f-d951114f2c08",
                                                "sense_id": "ff0547d8-55a8-3449-97e0-404dd0d0e867",
                                                "text": "nel periodo della Roma classica il patronimico era il nome della \"gens\"; ad esempio Marco Cicerone faceva parte della \"gens Tullia\" ed era dunque chiamato Marco Tullio Cicerone\""
                                            }
