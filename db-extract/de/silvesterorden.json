                        "sense_id": "e895805c-9285-3551-97f9-467a4a3f2ecd",
                        "entry_id": "d2d6ed39-9c2f-34be-8639-f354c656a723",
                        "glosses": [
                            "nach Papst Silvester I. benannter vom Vatikan an Laien verliehener Orden zur Auszeichnung für Verdienste um die römisch-katholische Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6912ad36-9086-46ae-b675-2cfed2ce4f6d",
                                "sense_id": "e895805c-9285-3551-97f9-467a4a3f2ecd",
                                "text": "„Er ist Inhaber des Komturkreuzes des Silvesterordens und verwaltet zahlreiche Ehrenämter.“"
                            },
                            {
                                "example_id": "8525cde3-7562-4526-9db3-dc2dc7404ac0",
                                "sense_id": "e895805c-9285-3551-97f9-467a4a3f2ecd",
                                "text": "„Am 14. Januar 2000 verlieh ihm in Würdigung seiner Verdienste Dr. Johannes Joachim Kardinal Degenhard, Erzbischof von Paderborn, den Päpstlichen Silvesterorden.“"
                            }
                        ],
