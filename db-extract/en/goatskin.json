                ],
                "senses": [
                    {
                        "sense_id": "4bd2b35b-7909-39e3-9c4a-bd57a9269606",
                        "entry_id": "eae72cbf-4a79-39f3-be1f-10b14391491a",
                        "glosses": [
                            "The skin of a goat, especially when cured and used as a material for clothing, tents, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "11284c20-a787-4911-9a58-e05c254ac052",
                                "sense_id": "4bd2b35b-7909-39e3-9c4a-bd57a9269606",
                                "text": "Near-synonym: kidskin"
                            },
                            {
                                "example_id": "484ec399-a613-4084-ac93-e381c786e6fa",
                                "sense_id": "4bd2b35b-7909-39e3-9c4a-bd57a9269606",
                                "text": "The Arabs came out of their goatskin tents, and surrounded the soldiers, asking many questions in the native tongue, for the soldiers were themselves natives."
                            }
                        ]
                    },
                    {
                        "sense_id": "39453115-9e76-3990-af44-d781af7212e4",
                        "entry_id": "eae72cbf-4a79-39f3-be1f-10b14391491a",
                        "glosses": [
                            "A liquid container (especially for holding wine or water) made from goat leather."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13e8090b-f450-366a-8df1-1c7f7692ab2c",
                        "entry_id": "eae72cbf-4a79-39f3-be1f-10b14391491a",
