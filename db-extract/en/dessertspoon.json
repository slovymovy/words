                                                "sense_id": "d710fccb-9432-33d9-9b79-4256e4a7f212",
                                                "text": "Jacusiu, jeszcze tylko dwie łyżeczki rosołku i będzie koniec obiadku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "9c6142a1-dee5-393b-9996-c75c4f5b928d",
                                        "entry_id": "1b83488c-9a38-3def-be16-ec99b6f638e1",
                                        "glosses": [
                                            "mała łyżka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9a48b8-2cd8-4a4d-826a-e5b0cb73e843",
                                                "sense_id": "9c6142a1-dee5-393b-9996-c75c4f5b928d",
                                                "text": "Po uzyskaniu zgody mamy, pewnego popołudnia przyjaciółki zataszczyły na wieżę piecyk elektryczny, materac dmuchany, koce, lampę, adapter „Mister Hit”, stos płyt, garnek, grzałkę do wody, paczkę herbaty, cukier, łyżeczki, kubki – no, i oczywiście, książki i zeszyty."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4239093e-5524-39d0-b0c6-458da9846a7c",
                                        "entry_id": "1b83488c-9a38-3def-be16-ec99b6f638e1",
                                        "glosses": [
                                            "porcja substancji nabrana łyżeczką (1.2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "847983c3-9741-4f6c-b7bb-8561a6dc91b0",
                                                "sense_id": "4239093e-5524-39d0-b0c6-458da9846a7c",
                                                "text": "Herbatę słodzę dwoma łyżeczkami cukru."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
