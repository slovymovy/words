                    }
                ],
                "senses": [
                    {
                        "sense_id": "f968e5a4-c37c-35ac-a921-7eddd103ef09",
                        "entry_id": "daaefd08-488e-3e2c-a3ec-83c8499cfc26",
                        "glosses": [
                            "Politik eines Landes gegenüber anderen Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af0bf5d-2935-4a33-b891-b307d26d8564",
                                "sense_id": "f968e5a4-c37c-35ac-a921-7eddd103ef09",
                                "text": "In der Außenpolitik geht es um das Handeln eines Staates gegenüber anderen Staaten."
                            },
                            {
                                "example_id": "3faf566d-2172-4532-a154-676dcb425236",
                                "sense_id": "f968e5a4-c37c-35ac-a921-7eddd103ef09",
                                "text": "„Zur Außenpolitik gehören Höflichkeit und gute Manieren ebenso wie Heuchelei und scheinheiliges Agieren.“"
                            },
                            {
                                "example_id": "c166d0a9-1eee-4978-990f-08a696d727f2",
                                "sense_id": "f968e5a4-c37c-35ac-a921-7eddd103ef09",
                                "text": "„Die Befindlichkeit des Reiches war im Inneren durch sozialen Frieden und wirtschaftliche Prosperität gekennzeichnet sowie durch Stabilität in der Außenpolitik, die zeitweilig in den Hintergrund trat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56ac9692-08ca-49b9-8c69-5811bfbf1b8e",
                        "source_entry_id": "daaefd08-488e-3e2c-a3ec-83c8499cfc26",
                        "source_sense_id": "f968e5a4-c37c-35ac-a921-7eddd103ef09",
                        "source_sense_description": "Politik eines Landes gegenüber anderen Staaten",
                        "target_lang_word": "foreign policy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreign policy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a0077af-b3f3-3a96-8b00-83cc46a51584",
                                        "entry_id": "3f718296-9b3c-3d84-a910-60399a82f6b2",
                                        "glosses": [
                                            "A government's policy relating to relations with other nations and international organisations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b001309-024b-4b1a-8ed5-7d176d763d80",
                                                "sense_id": "7a0077af-b3f3-3a96-8b00-83cc46a51584",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, […]. They also exposed the blatant discrepancy between the west's professed values and actual foreign policies."
                                            },
                                            {
                                                "example_id": "f1aa003d-1849-4ffa-8d3f-412a2c3a0e9e",
                                                "sense_id": "7a0077af-b3f3-3a96-8b00-83cc46a51584",
                                                "text": "Willing to upend the nation’s postwar role as a bulwark against authoritarianism, he promises to usher in a foreign policy rooted in “America First” transactionalism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b95c4b66-18e3-3189-9b75-2191167e8893",
                                        "entry_id": "3f718296-9b3c-3d84-a910-60399a82f6b2",
                                        "glosses": [
                                            "Used retrospectively, the sum of a leader or government's dealings and relations with other nations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad5333c2-4d31-4f98-975a-a74ed21416ef",
                                                "sense_id": "b95c4b66-18e3-3189-9b75-2191167e8893",
                                                "text": "Bismarck's foreign policy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "537bb433-1b55-44cd-9e37-ba3cc67c7328",
                        "source_entry_id": "daaefd08-488e-3e2c-a3ec-83c8499cfc26",
