                ],
                "translations": [
                    {
                        "translation_id": "d093e980-49a7-41b3-9e2d-34443ee696a0",
                        "source_entry_id": "2403541e-5f87-3ccc-919a-f4335d90aa3d",
                        "source_sense_id": "e35da0f8-2b64-342f-956a-9228ee8c9de5",
                        "target_lang_word": "Verunreinigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunreinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3af8b813-fbb2-346f-b895-da0191d0a3ec",
                                        "entry_id": "221c66e6-eb93-3e67-a702-4de97a8e2b8b",
                                        "glosses": [
                                            "Zustand und Vorgang des Kontaminierens/des Verunreinigens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33debff-afed-4775-a53f-239ff16d6f12",
                                                "sense_id": "3af8b813-fbb2-346f-b895-da0191d0a3ec",
                                                "text": "„Bisher sei nicht klar, ob es sich um eine Verunreinigung durch Viren oder Bakterien handelt, sagte der Sprecher des Thüringer Gesundheitsministeriums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "132ee769-a79a-31c2-8715-338bef878540",
                                        "entry_id": "221c66e6-eb93-3e67-a702-4de97a8e2b8b",
                                        "glosses": [
                                            "unerwünschter/verunreinigender Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ed3f36-4171-4d49-86fb-7a7c8eb44016",
                                                "sense_id": "132ee769-a79a-31c2-8715-338bef878540",
                                                "text": "„Mit allen verfügbaren Mitteln mussten zunächst Verunreinigungen ausgeschlossen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6639e2c7-1c90-4579-85e3-c479ecfd1ab2",
                        "source_entry_id": "2403541e-5f87-3ccc-919a-f4335d90aa3d",
                        "source_sense_id": "e35da0f8-2b64-342f-956a-9228ee8c9de5",
                        "target_lang_word": "Verschmutzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschmutzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                        "entry_id": "e0ec0acf-fd7a-301d-bc33-3a85e4a4e3dc",
                                        "glosses": [
                                            "Verunreinigung durch Schmutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb51f470-f653-4f15-a442-399832cc3e7b",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "Aber die Meere leiden ja vor allem unter der Verschmutzung vom Land aus."
                                            },
                                            {
                                                "example_id": "cfba7b52-f718-41e9-8a83-0750c223f322",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Auch die Verschmutzung durch Mikroplastik wird in jedem Land deutlich zunehmen.“"
                                            },
                                            {
                                                "example_id": "9f08986a-95b6-4a07-9ed3-dfd33d445b0a",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Ein globales Abkommen zur Eindämmung von Verschmutzung durch Plastikmüll könnte das ändern.“"
                                            },
                                            {
                                                "example_id": "cd7c2f93-b38c-4d8f-93a3-900caf27e755",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Mikroplastik im Süßwasser - Wie lässt sich die Verschmutzung stoppen?“"
                                            },
                                            {
                                                "example_id": "d312e972-6b11-4d4a-b9c4-a5ea489d90a2",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Fischsterben in der Oder: Die Europaabgeordnete hat die Umweltbehörden] „aufgefordert, die Quelle der Verschmutzung zu finden und die Schuldigen zur bestrafen.“"
                                            },
                                            {
                                                "example_id": "4f5ec4bf-3b88-4a2a-afea-03da93054c8c",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Schlagzeile:] „Über tausend Fische sterben nach Verschmutzung in Freiburger Bach“"
                                            },
                                            {
                                                "example_id": "32cd88f1-e6bb-4fd7-85d4-dd7ef9bfe96a",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Die Ursache der Verschmutzung ist derzeit noch unbekannt.“"
                                            },
                                            {
                                                "example_id": "6c9bd5ea-8a3d-4db5-b492-af39e40ff381",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Allerdings konnten die Einsatzkräfte die Quelle der Verschmutzung im Bach Diron lokalisieren, wie die Freiburger Kantonspolizei mitteilte.“"
                                            },
                                            {
                                                "example_id": "4f6cfe66-a695-432f-8c2e-130508e331bc",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Die Verschmutzung“ [erstreckt] „sich über zwei Kilometer bis in die Sionge.“"
                                            },
                                            {
                                                "example_id": "23df0598-2ce7-4ebc-a0cf-b5e6ba795e59",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Wenn die Verschmutzung ein bestimmtes Maß nicht überschreitet, kann sich ein Gewässer selbst reinigen.“"
                                            },
                                            {
                                                "example_id": "89c2e7c5-95e9-49e3-9711-2c60312ad8c6",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "[Delfine in Flüssen:] „Doch fast überall auf der Welt sind die Populationen geschrumpft. Hauptgrund ist die Verschmutzung der Flüsse.“"
                                            },
                                            {
                                                "example_id": "a129ed48-1f1a-4f6d-802a-5f3d8c148534",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Das Mittelmeer gilt“ […] „als Hotspot für Verschmutzung durch Plastik, weil viele Küstenabschnitte dicht besiedelt sind.“"
                                            },
                                            {
                                                "example_id": "605cc91a-810b-4fde-a797-d0dcaf1c63b6",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "Die Bevölkerung wurde in vielen Fällen bisher nicht über die Verschmutzung informiert."
                                            },
                                            {
                                                "example_id": "7334bcd0-876a-451b-b905-e25fa4c478d8",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„Deutlich mehr Luftverschmutzung durch Kreuzfahrten in Hamburg“ […] „Auch in Kiel nahm 2022 die Verschmutzung mit Schwefeloxiden deutlich zu, hier gab es einen Anstieg von 71 Prozent gegenüber 2019.“"
                                            },
                                            {
                                                "example_id": "b110a447-768f-4ece-ae39-9fb84e0f5657",
                                                "sense_id": "9136d87f-b099-3358-914d-7a641810caa1",
                                                "text": "„So tretet den wackeren Männern in die Seite, die gegen die Überzahl ihrer veraltet sauberen Kollegen schon Hervorragendes auf dem Gebiet der öffentlichen Verschmutzung geleistet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "721dda2e-c593-44f6-b905-47bc76b7417b",
                        "source_entry_id": "2403541e-5f87-3ccc-919a-f4335d90aa3d",
                        "source_sense_id": "e35da0f8-2b64-342f-956a-9228ee8c9de5",
                        "target_lang_word": "pollution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Physical contamination, now especially the contamination of the environment by harmful substances, or by disruptive levels of noise, light etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b33aa9-28ea-423b-8307-f56a7119c294",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Pollution levels are almost always higher in cities rather than the countryside, what with the cars, industry and so on."
                                            },
                                            {
                                                "example_id": "5e658696-7b36-45a8-92ca-fda8ce21fd61",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "If successful, Edison and Ford—in 1914—would move society away from the[…]hazards of gasoline cars: air and water pollution, noise and noxiousness, constant coughing and the undeniable rise in cancers caused by smoke exhaust particulates."
                                            },
                                            {
                                                "example_id": "f605ba7e-9a26-49b7-b516-2963687d21b2",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Schools across the country are moving to ban the school run amid growing concern about the devastating impact of air pollution on young people’s health."
                                            },
                                            {
                                                "example_id": "efcdd7f3-2007-4c74-b35f-d899fc813919",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "Pollution now kills three times as many people worldwide as Aids, tuberculosis and malaria combined."
                                            },
                                            {
                                                "example_id": "eb8365ab-79e2-42e0-9941-7e124da1972c",
                                                "sense_id": "745af4c5-9c21-3a5c-8afc-7c2bdbf2d08e",
                                                "text": "\"Flying only looks like a bargain because the cost of pollution is so cheap.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59b07af-02dc-3df4-b5a1-9ab6792edbf9",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Something that pollutes; a pollutant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "The desecration of something holy or sacred; defilement, profanation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0496b295-34f9-48b2-8aa6-9f98b36114cd",
                                                "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                                "text": "Men who attend the Altar, and should most / Endevor Peace: thir strife pollution brings / Upon the Temple it self […]."
                                            },
                                            {
                                                "example_id": "97d5f985-c1b5-4db3-9267-dd4a516c27b5",
                                                "sense_id": "9cf579dc-06df-30c6-83be-cc50af5989c8",
                                                "text": "[T]he most gallant knights that ever wielded sword wasted their lives away in a struggle to seize it and hold it sacred from infidel pollution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "The ejaculation of semen outside of sexual intercourse, especially a nocturnal emission."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda54bca-526e-46dc-88af-c323197f0791",
                                                "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                                "text": "When occasioned by a voluntary act it is called, simply, Pollution or Masturbation (q.v.); when excited, during sleep, by lascivious dreams, it takes the name Noctur'nal pollution, Exoneiro'sis, Oneirog'mos, Oneirog'onos, Gonorrhœ'a dormien'tium, G. oneirog'onos, G. Vera, G. libidino'sa, Proflu'vium Sem'inis, Spermatorrhœ'a, Paronir'ia salax, Night pollution."
                                            },
                                            {
                                                "example_id": "e942482d-2d26-40cf-924b-f3ae67989ce4",
                                                "sense_id": "7b40e7ba-bc09-3b4c-8d59-d17334e5fc73",
                                                "text": "According to Billuart and other theologians, pollution in sleep is not sin, unless voluntarily caused; if, however, it begins in sleep, and is completed in the half-waking state, with a sense of pleasure, it is a venial sin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a6b64ec-3957-3b81-a7b1-8db8979796e7",
                                        "entry_id": "09d161ce-0808-3672-8f49-c862f3e1bbe8",
                                        "glosses": [
                                            "Moral or spiritual corruption; impurity, degradation, defilement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "224ffc88-94a2-41fc-8292-22149319b6e6",
                                                "sense_id": "2a6b64ec-3957-3b81-a7b1-8db8979796e7",
                                                "text": "She condescended to wait on them at Pemberley, in spite of that pollution which its woods had received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
