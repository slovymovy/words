                ],
                "senses": [
                    {
                        "sense_id": "c49cd72f-2309-3d9b-9f4a-819418cdb32b",
                        "entry_id": "a934d8f5-a7ea-34b4-abde-5c8a00c7a9aa",
                        "glosses": [
                            "Nom donné à la mercuriale annuelle (Mercurialis annua) en Picardie, dans le Nord, en Artois et en Franche-Comté."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "41a19c40-3de5-4cca-a3df-2c78ee67c98a",
                                "sense_id": "c49cd72f-2309-3d9b-9f4a-819418cdb32b",
                                "text": "La plante entière et ses graines sont purgatives (on l'appelle parfois le Caquenlit) et un peu dangereuses. Ne pas la porter à la bouche."
                            },
                            {
                                "example_id": "e0d11b1c-3a9d-4ec9-86e5-2d09f40c1916",
                                "sense_id": "c49cd72f-2309-3d9b-9f4a-819418cdb32b",
                                "text": "Longue vie (sirop de) — Se prépare avec la mercuriale annuelle, appelée encore : caquenlit, chou de chien, foiraude, foirole, ortie bâtarde."
                            }
                        ]
                    }
                ],
