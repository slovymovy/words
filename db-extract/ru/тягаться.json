                "senses": [
                    {
                        "sense_id": "fba622e8-eab6-3748-adf7-c953d7d6bb10",
                        "entry_id": "4932708d-01d5-3294-b213-82e1fc934f56",
                        "glosses": [
                            "to compete (to be better at or outdo someone)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1d89cdf2-7be6-4fe1-a94b-f9bed1576aca",
                                "sense_id": "fba622e8-eab6-3748-adf7-c953d7d6bb10",
                                "text": "Я не могу́ с ним тяга́ться.",
                                "translation": "I can't compete with him.",
                                "english": "I can't compete with him."
                            },
                            {
                                "example_id": "78abc3f4-d2db-4a43-8f32-5bb43d7fb041",
                                "sense_id": "fba622e8-eab6-3748-adf7-c953d7d6bb10",
                                "text": "С тобо́й сло́жно тяга́ться.",
                                "translation": "It's hard to compete with you.",
                                "english": "It's hard to compete with you."
                            }
                        ]
                    },
                    {
                        "sense_id": "93ae2bb3-e2c0-34df-beb1-84f7acbfeff4",
                        "entry_id": "4932708d-01d5-3294-b213-82e1fc934f56",
