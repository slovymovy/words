                    }
                },
                {
                    "sense_id": "2e234105-24f5-33a3-974e-f55df132681a",
                    "sense_definition": "Одна двадцатая часть чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "дробь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это составляет лишь <w>двадцатую</w> часть от всей суммы.",
                            "target_lang_translations": {
                                "en": "This accounts for only a <w>twentieth</w> part of the total sum."
                            }
                        },
                        {
                            "text": "Мы получили три <w>двадцатых</w> от общего объема прибыли.",
                            "target_lang_translations": {
                                "en": "We received three <w>twentieths</w> of the total profit."
                            }
