                        ]
                    },
                    {
                        "sense_id": "74c7a834-c7ef-33db-b56a-21a7040063c8",
                        "entry_id": "ae865dc1-3947-3ece-8e19-c88464fa1e37",
                        "glosses": [
                            "voorbeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c18ef3d-1b4a-46b8-8c57-8ecf8a6ab678",
                                "sense_id": "74c7a834-c7ef-33db-b56a-21a7040063c8",
                                "text": "Een versleten, opgezette zwarte beer was een voorproefje van wat me te wachten stond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dbd3ce4-ba9c-495a-861c-0ed66ddc6701",
                        "source_entry_id": "ae865dc1-3947-3ece-8e19-c88464fa1e37",
                        "source_sense_id": "88a6edae-267e-3b05-8e7f-6ba1d3573669",
                        "source_sense_description": "een voorlopige test",
                        "target_lang_word": "Vorgeschmack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgeschmack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55bed6b5-3f2b-359d-9cdb-89bf9c959371",
                                        "entry_id": "d83f7d3d-dcba-3fe5-81fb-3fd576b67ae6",
                                        "glosses": [
                                            "Vorstellung von dem, was bevorsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557f55ce-7a74-473d-b835-7f5a26981070",
                                                "sense_id": "55bed6b5-3f2b-359d-9cdb-89bf9c959371",
                                                "text": "„Als ich an Deck stand und beobachtete, wie Europa immer kleiner wurde, überlegte ich mir, ob die heutigen Ereignisse wohl ein Vorgeschmack darauf waren, was mich erwartete.“"
                                            },
                                            {
                                                "example_id": "7bdf3427-ab9a-4685-881a-c4af0654b522",
                                                "sense_id": "55bed6b5-3f2b-359d-9cdb-89bf9c959371",
                                                "text": "„Mein Münchner Aufenthalt war wie ein Fluch, oder besser gesagt, in diesem unseligen Monat brachen alle gemeinsam über mich herein, wie um mir einen Vorgschmack von den ganzen Qualen zu geben, die die Seelen der Verdammten erleiden.“"
                                            },
                                            {
                                                "example_id": "cc26d2c6-35a5-4800-a1b0-30f3ceb4b2a8",
                                                "sense_id": "55bed6b5-3f2b-359d-9cdb-89bf9c959371",
                                                "text": "„Letzterer gibt schon einmal einen Vorgeschmack auf die zu erwartende Atmosphäre, indem er beantragt, den Kollegen Walter von Molo bereits vor der Sitzung auszuschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5ced27-c3bf-411f-8657-4e5eb23b663e",
                        "source_entry_id": "ae865dc1-3947-3ece-8e19-c88464fa1e37",
                        "source_sense_id": "88a6edae-267e-3b05-8e7f-6ba1d3573669",
                        "source_sense_description": "een voorlopige test",
                        "target_lang_word": "Kostprobe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
