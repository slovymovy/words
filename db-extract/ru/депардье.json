                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Depardieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34744048-5b50-3cd9-814e-ef2eb62249ae",
                                        "entry_id": "237f3a18-11c6-302e-aee6-607e1d85bc32",
                                        "glosses": [
                                            "Nom de famille français, connu en particulier pour Gérard Depardieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deec1aa5-bb9c-40f2-b271-8be151a1d431",
                                                "sense_id": "34744048-5b50-3cd9-814e-ef2eb62249ae",
                                                "text": "Parce qu’il les connaît depuis longtemps, qu’il les a déjà mis en scène l’un et l’autre, qu’il est devenu leur ami, le réalisateur Guillaume Nicloux a pu réunir devant sa caméra Houellebecq et Depardieu pour une fiction – un séjour en thalasso à Cabourg – où, comme souvent dans le travail de l’auteur, les personnages jouent leur propre rôle"
                                            },
                                            {
                                                "example_id": "dd391881-3cde-4293-b50d-e87d70bcf9f1",
                                                "sense_id": "34744048-5b50-3cd9-814e-ef2eb62249ae",
                                                "text": "Cette année, on a pu croiser Philippe Katerine et Julie Depardieu sur la très fréquentée digue dinardaise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
