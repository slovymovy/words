                                        "entry_id": "0eb55c11-e11a-3a56-97f4-1d9c6b5d4fd5",
                                        "glosses": [
                                            "The state of total inaction caused by holding global skepticism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2e2684-4ccb-4a97-a734-b14d6038a372",
                                                "sense_id": "a2897631-ad0a-3f8c-ac04-76f5d43b9ae3",
                                                "text": "But how does the skeptic live without knowledge or at least belief? It seems that the skeptical challenges, though theoretically unimpeachable, have objectionable practical consequences. Call this the apraxia problem for skepticism."
                                            }
                                        ]
                                    }
                                ]
                            }
