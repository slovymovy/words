    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                "word": "bairn",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1cebb01d-4d3d-4dd8-b85d-d01a3b70b3a9",
                        "entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "bairns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                        "entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                        "glosses": [
                            "A child or baby."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "423f2c10-f03b-4ed0-a039-a981b895bb7f",
                                "sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                                "text": "She moved about the country like a ghost, gathering herbs in dark loanings, lingering in kirkyairds, and casting a blight on innocent bairns."
                            },
                            {
                                "example_id": "cab43d6a-5def-4abf-b9e2-b8485caf945f",
                                "sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                                "text": "They say that a shag is good for an unborn child, they get the circulation of blood, or some shite. The least ah kin dae is take an interest in the bairn’s welfare."
                            },
                            {
                                "example_id": "117fbb02-9bad-4f69-9b92-e85ba309700e",
                                "sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                                "text": "Bobby Shaftoe's getten a bairn\nFor to dandle in his arm;\nIn his arm and on his knee,\nBobby Shaftoe loves me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0873af9-e0f1-4fb0-b3f1-c762b68fa502",
                        "source_entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                        "source_sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                        "source_sense_description": "child or baby",
                        "target_lang_word": "Kind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                        "entry_id": "57aadefc-220c-3127-adf9-9c3715102245",
                                        "glosses": [
                                            "heranwachsender Mensch, aber noch kein Jugendlicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f008b7d3-8243-4572-bd3d-f680a030e8cf",
                                                "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                                "text": "Die Kinder spielten im Garten."
                                            },
                                            {
                                                "example_id": "6989d807-f86d-4569-97c4-96adda7ed049",
                                                "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                                "text": "„Bei einem Auftritt in Odessa präsentierte er [Petro Poroschenko] die brutale Maßnahme als Garantie für den Sieg: ‘Wir werden Renten haben, sie keine. Bei uns werden die Kinder in die Schule gehen, bei ihnen werden sie in den Kellern sitzen. So, und nur so gewinnen wir den Krieg.‘ “"
                                            },
                                            {
                                                "example_id": "ad97850d-293b-4b70-a0d6-1b26d08c7170",
                                                "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                                "text": "„Die Ankömmlinge sind meist so verblüfft, daß sie ihre schlimmen Vorsätze vergessen, mitunter sogar sich in herumalbernde große Kinder verwandeln.“"
                                            },
                                            {
                                                "example_id": "fa64066e-9fd8-47ef-836b-19915b9695df",
                                                "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                                "text": "„Wir haben hier zu unterscheiden zwischen dem Kinderwitz, das heißt dem von Kindern für Kinder produzierten Witz, den Kinder selbst erzählen und lustig finden, und dem sogenannten Kindermundwitz, der wirklichen oder vermeintlichen unfreiwilligen Komik ernstgemeinter kindlicher Aussagen für Erwachsene.“"
                                            },
                                            {
                                                "example_id": "c97e9e41-ae20-4ebb-b67e-0327a487347b",
                                                "sense_id": "73e4e9e0-fc3d-33b8-b8f3-270f9566820e",
                                                "text": "„Sie atment wie ein müdes Kind neben mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a76a62f-59b5-316e-9523-2ff61edce3b6",
                                        "entry_id": "57aadefc-220c-3127-adf9-9c3715102245",
                                        "glosses": [
                                            "Mensch, mit Bezug auf seine familiäre Zugehörigkeit (Beziehung der Abkommenschaft)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f8795a-b0ce-4f98-b1b7-edb9459b0cb0",
                                                "sense_id": "0a76a62f-59b5-316e-9523-2ff61edce3b6",
                                                "text": "Er war das zweitgeborene Kind in der Familie."
                                            },
                                            {
                                                "example_id": "3d8d33a4-94dc-4016-8a93-6a2af2f7eb28",
                                                "sense_id": "0a76a62f-59b5-316e-9523-2ff61edce3b6",
                                                "text": "„Jetzt lebten sechs von seinen sieben Kindern, Enkelkindern und Urenkeln ebenfalls hier.“"
                                            },
                                            {
                                                "example_id": "29bd135b-8643-4efe-956e-feb535694d51",
                                                "sense_id": "0a76a62f-59b5-316e-9523-2ff61edce3b6",
                                                "text": "„Denn ein Kind ist ein mächtiger Fixpunkt für Eltern, man kann sich da schnell untereinander aus den Augen verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ec44299-ddd0-3f35-be95-773d11a5f6dc",
                                        "entry_id": "57aadefc-220c-3127-adf9-9c3715102245",
                                        "glosses": [
                                            "vertrauliche Anrede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdadfbd-294e-4fd5-b811-8b32d8e29654",
                                                "sense_id": "1ec44299-ddd0-3f35-be95-773d11a5f6dc",
                                                "text": "„Mein Kind komm her!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e2566b9-8a96-47ca-ac7a-dd4c13b64069",
                        "source_entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                        "source_sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                        "source_sense_description": "child or baby",
                        "target_lang_word": "Kleinkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                        "entry_id": "a9f67a56-f4a1-3b43-8759-2af3bad5b461",
                                        "glosses": [
                                            "Kind unter sechs Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9cad32-f673-48f5-b3c5-671001d06d39",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "Es gibt ein extra Planschbecken für Kleinkinder."
                                            },
                                            {
                                                "example_id": "873d0824-9193-4661-9e69-28070f4efddc",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Es fehlte die Wahrnehmung dafür, dass es für die Kleineren weit schwerer war, mit einer Kette von furchtbaren Erlebnissen fertigzuwerden, weil die überforderten Erwachsenen nicht die Sicherheit und Nestwärme geben konnten, die Kleinkinder für den Aufbau ihrer psychischen Stabilität brauchen.“"
                                            },
                                            {
                                                "example_id": "9654fbb2-cdb7-474a-9acd-79eb8a58fac1",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Wolfgang Thierse, geboren 1943, floh als Kleinkind mit seiner Familie vor der russischen Armee aus dem brennenden Breslau bei 16 Grad unter Null und 50 Zentimeter Neuschnee.“"
                                            },
                                            {
                                                "example_id": "2d6c6036-9d09-4320-a7b9-e9546757a6cb",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Er wandte sich mir zu und behandelte mich nicht wie ein Kleinkind.“"
                                            },
                                            {
                                                "example_id": "f56fe350-0cdc-45c9-9859-0ff89810a62a",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Hier wohnte die eine als Kleinkind und sie erinnere sich noch immer an einen fantastischen Blick auf den Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42f0bde-f605-46bd-b77f-377b9f1351ad",
                        "source_entry_id": "af4ac3bf-726d-39dc-8f77-dca4afe1e8e9",
                        "source_sense_id": "664386dc-a5e1-3b9d-b465-e3e147c8e1e2",
                        "source_sense_description": "child or baby",
                        "target_lang_word": "Baby",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baby",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "Kind, das sich noch im ersten Lebensjahr befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14b9d44-d33d-41fe-94e3-950368a113d5",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "Ihr habt aber ein sehr süßes Baby!"
                                            },
                                            {
                                                "example_id": "b718a8d2-e990-4cbb-9255-926e15cb070f",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "Das Baby schreit schon wieder, ist es hungrig?"
                                            },
                                            {
                                                "example_id": "758ac6c5-79ea-463f-9ab5-9a321ebace59",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "„Als ich ein Baby war, wohnten meine Eltern mit mir in einer winters nur durch einen kleinen Kohleofen beheizbaren Dachkammer im Esslinger Haus meiner Großeltern.“"
                                            },
                                            {
                                                "example_id": "1f116eee-63b5-4fee-acae-01b9911d2340",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "„Das Baby auf Mâys Arm tat keinen Mucks.“"
                                            },
                                            {
                                                "example_id": "4c2e7d17-d113-4ce5-b971-d7114c3463c5",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "„Josey nickte, drehte sich um und wollte gehen, das Baby im Arm.“"
                                            },
                                            {
                                                "example_id": "094fc345-a214-41be-941a-34bda9c7c9b1",
                                                "sense_id": "1cd8ad0d-8073-375b-83f3-b0b02f6bf457",
                                                "text": "„Noch nie zuvor hatte sie Shakespeare and Company jemand anderem als Adrienne überlassen, und sie kam sich vor wie eine junge Mutter, die ihr Baby zum ersten Mal dem Kindermädchen anvertraut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b2b9746-7d03-3eec-b2c4-868a6e936fbb",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "Kind im Allgemeinen, Tierjunges"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne",
                                            "in Zusammensetzungen auch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec5d92d-8e7f-46dd-90bc-db9981b0844a",
                                                "sense_id": "0b2b9746-7d03-3eec-b2c4-868a6e936fbb",
                                                "text": "Sie wünschen sich beide ein Baby."
                                            },
                                            {
                                                "example_id": "be982e21-0891-485c-a848-20a41a94ceed",
                                                "sense_id": "0b2b9746-7d03-3eec-b2c4-868a6e936fbb",
                                                "text": "Sie erwartet ein Baby."
                                            },
                                            {
                                                "example_id": "984d137d-0355-49ad-92c3-d90f352089a5",
                                                "sense_id": "0b2b9746-7d03-3eec-b2c4-868a6e936fbb",
                                                "text": "Schau mal die kleinen Katzenbabys."
                                            },
                                            {
                                                "example_id": "7ddc2088-8af7-4386-b74b-028ca1a5982e",
                                                "sense_id": "0b2b9746-7d03-3eec-b2c4-868a6e936fbb",
                                                "text": "„Das Baby konnte jede Stunde ankommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "75f96f95-184b-3250-9d4d-4d93f343cd9b",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "liebevolle Bezeichnung für die Partnerin/den Partner in einer Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6d17f9-4843-4e4d-8350-a0b331eb1a5b",
                                                "sense_id": "75f96f95-184b-3250-9d4d-4d93f343cd9b",
                                                "text": "Sie ist mein Baby, mein Ein und Alles."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0b5a7975-dcfd-3ed3-ae90-f6fa48f448e9",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "Bezeichnung von Männern für ein hübsches Mädchen (mit sexistischer oder chauvinistischer Konnotation)"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed62be0b-ee54-4092-935e-643af05284af",
                                                "sense_id": "0b5a7975-dcfd-3ed3-ae90-f6fa48f448e9",
                                                "text": "Hey, Baby, (hast du/haste) heute Abend schon was vor?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d39e7aff-3265-3d2d-8c2a-97aef3be23ed",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "abfällige Bezeichnung für einen Menschen mit wenig Mut"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e78d83a-9431-487e-856e-eac3e0366315",
                                                "sense_id": "d39e7aff-3265-3d2d-8c2a-97aef3be23ed",
                                                "text": "Nicht einmal das traust du dich; du bist ein echtes Baby!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "4801c9e8-3521-304a-8f61-8129e27d258c",
                                        "entry_id": "bc9429dd-4e34-3e4b-9ef5-62405c05223d",
                                        "glosses": [
                                            "liebevolle Bezeichnung für selbstgeschaffene Gegenstände oder Besitz, zu dem man besondere Beziehungen hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd102e5b-62f2-4c2c-891f-533f7ea4e0bc",
                                                "sense_id": "4801c9e8-3521-304a-8f61-8129e27d258c",
                                                "text": "Dieses Auto ist mein Baby; ich habe es selbst getunt."
                                            },
                                            {
                                                "example_id": "c7206a28-6651-4354-8009-e29835ecc02f",
                                                "sense_id": "4801c9e8-3521-304a-8f61-8129e27d258c",
                                                "text": "Dieses Projekt ist mein Baby. Da lasse ich mir von niemandem reinreden."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
