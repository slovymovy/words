{
    "word_family": [
        "plucker",
        "plucky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0883757-d6af-344c-8ddf-8ccd7dce0d2b",
                    "sense_definition": "Courage, determination, and spirit in the face of difficulty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have to admire the <w>pluck</w> she showed when facing such a difficult challenge.",
                            "target_lang_translations": {
                                "ru": "Нельзя не восхититься тем <w>упорством</w>, которое она проявила, столкнувшись с таким сложным испытанием."
                            }
                        },
                        {
                            "text": "Despite the odds, the young athlete displayed great <w>pluck</w> to win the match.",
                            "target_lang_translations": {
                                "ru": "Вопреки всему, молодой спортсмен проявил огромную <w>смелость</w>, чтобы выиграть матч."
                            }
                        }
                    ],
                    "synonyms": [
                        "courage",
                        "grit",
                        "guts",
                        "nerve",
                        "spunk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смелость, решительность и стойкость перед лицом трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упо́рство",
                                "target_lang_sense_clarification": "настойчивое стремление к цели, стойкость"
                            },
                            {
                                "target_lang_word": "сме́лость",
                                "target_lang_sense_clarification": "способность действовать решительно в трудных ситуациях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df702cef-e937-35c1-9f39-f873fd387012",
                    "sense_definition": "A quick, sharp pull or tug.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pulling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave the loose thread a quick <w>pluck</w> to remove it from her sweater.",
                            "target_lang_translations": {
                                "ru": "Она сделала быстрый <w>рывок</w> за свободную нитку, чтобы убрать её со свитера."
                            }
                        },
                        {
                            "text": "With a sudden <w>pluck</w> at his sleeve, the child got his father's attention.",
                            "target_lang_translations": {
                                "ru": "Внезапно <w>дёрнув</w> отца за рукав, ребёнок привлёк его внимание."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое, резкое движение, рывок или потягивание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыво́к",
                                "target_lang_sense_clarification": "резкое, быстрое движение"
                            },
                            {
                                "target_lang_word": "дёрганье",
                                "target_lang_sense_clarification": "процесс резкого потягивания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0126f540-bdc7-3fe9-91fb-329fcdc63c27",
                    "sense_definition": "To pull something quickly or sharply, often to remove it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pulling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>plucked</w> a ripe apple from the tree.",
                            "target_lang_translations": {
                                "ru": "Она <w>сорвала</w> спелое яблоко с дерева."
                            }
                        },
                        {
                            "text": "He <w>plucked</w> a stray hair from his jacket.",
                            "target_lang_translations": {
                                "ru": "Он <w>выдернул</w> прилипший волос со своего пиджака."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pluck from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или резко потянуть что-либо, часто чтобы удалить или оторвать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́дернуть",
                                "target_lang_sense_clarification": "извлечь что-либо резким движением"
                            },
                            {
                                "target_lang_word": "сорва́ть",
                                "target_lang_sense_clarification": "резко отделить, например, плод от ветки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ed6b26b-5dde-3c02-aad8-675fe4f67c76",
                    "sense_definition": "To play a stringed instrument by pulling and releasing the strings with fingers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist began to <w>pluck</w> the strings to create a soft melody.",
                            "target_lang_translations": {
                                "ru": "Гитарист начал <w>щипать</w> струны, чтобы создать мягкую мелодию."
                            }
                        },
                        {
                            "text": "Musicians often <w>pluck</w> the strings of a harp to produce a clear sound.",
                            "target_lang_translations": {
                                "ru": "Музыканты часто <w>щиплют</w> струны арфы, чтобы извлечь чистый звук."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на струнном инструменте, извлекая звуки пальцами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щипа́ть",
                                "target_lang_sense_clarification": "способ звукоизвлечения на струнных инструментах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d92fc813-837a-3fc7-a756-049e8366a0cd",
                    "sense_definition": "To remove the feathers from a bird before cooking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a long time to <w>pluck</w> a chicken for dinner.",
                            "target_lang_translations": {
                                "ru": "Требуется много времени, чтобы <w>ощипать</w> курицу к обеду."
                            }
                        },
                        {
                            "text": "The chef had to <w>pluck</w> the pheasant before roasting it.",
                            "target_lang_translations": {
                                "ru": "Шеф-повару пришлось <w>ощипать</w> фазана перед тем, как запечь его."
                            }
                        }
                    ],
                    "synonyms": [
                        "defeather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаление перьев с птицы перед приготовлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ощи́пывать",
                                "target_lang_sense_clarification": "процесс удаления перьев с птицы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}