                "senses": [
                    {
                        "sense_id": "f580a1b6-a0a8-3d1b-b0b8-dc31951fd757",
                        "entry_id": "e5b4f523-4b21-32d2-95a6-0e5018a253dc",
                        "glosses": [
                            "Treppe aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72c8b8b-37d3-4397-9bce-173f718e5740",
                                "sense_id": "f580a1b6-a0a8-3d1b-b0b8-dc31951fd757",
                                "text": "„Schnell und geduckt huschten sie ungesehen über einen offenen Laufgang und einige Metalltreppen hinauf in das Gebäude.“"
                            },
                            {
                                "example_id": "c24ca7d7-beb0-41c3-a0d9-7451ed22eb39",
                                "sense_id": "f580a1b6-a0a8-3d1b-b0b8-dc31951fd757",
                                "text": "„Er stieg die Metalltreppen empor bis zum fünften Stock und folgte dort einem langen schmalen Flur.“"
                            },
                            {
                                "example_id": "96e275cb-2b0d-4cb1-ab9d-3e3d1ba43eae",
                                "sense_id": "f580a1b6-a0a8-3d1b-b0b8-dc31951fd757",
                                "text": "„Der Verkehr rings um den Arc de Triomphe rauschte, aber Daniel wollte sichergehen, dass seine schweren Stiefel nicht auf der Metalltreppe dröhnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
