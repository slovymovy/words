                    {
                        "translation_id": "1f4fd9db-3151-483e-929d-96f994bd24ee",
                        "source_entry_id": "9c01a333-a1a0-3931-b9f4-d2d992d8b135",
                        "source_sense_description": "oiseau",
                        "target_lang_word": "wielewaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
