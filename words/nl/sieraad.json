    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06a7404b-0b4f-30e0-b3e1-68732fa62812",
                    "sense_definition": "Een voorwerp, vaak gemaakt van edelmetaal en edelstenen, dat gedragen wordt om het lichaam of de kleding te verfraaien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "juwelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een prachtig gouden <w>sieraad</w> om haar hals tijdens het feest.",
                            "target_lang_translations": {
                                "en": "She wore a beautiful golden <w>piece of jewellery</w> around her neck during the party."
                            }
                        },
                        {
                            "text": "In die winkel verkopen ze handgemaakte <w>sieraden</w> van zilver.",
                            "target_lang_translations": {
                                "en": "In that shop they sell handmade silver <w>jewellery</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "juweel",
                        "tooisel"
                    ],
                    "common_phrases": [
                        "gouden sieraad",
                        "kostbaar sieraad"
                    ],
                    "target_lang_definitions": {
                        "en": "An object, often made of precious metal and gemstones, worn to adorn the body or clothing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "piece of jewellery",
                                "target_lang_sense_clarification": "an individual item of personal adornment"
                            },
                            {
                                "target_lang_word": "jewel",
                                "target_lang_sense_clarification": "a precious stone or ornament"
                            },
                            {
                                "target_lang_word": "ornament",
                                "target_lang_sense_clarification": "an accessory used to beautify appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6a665aa-dbb0-32d5-8d34-fbeb7c11296c",
                    "sense_definition": "Iets wat dient tot versiering of verfraaiing van een ruimte, gebouw of landschap; een ornament.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze oude eikenboom is een waar <w>sieraad</w> voor de dorpskern.",
                            "target_lang_translations": {
                                "en": "This old oak tree is a true <w>ornament</w> to the village center."
                            }
                        },
                        {
                            "text": "Het gerestaureerde paleis is een <w>sieraad</w> voor de hele stad.",
                            "target_lang_translations": {
                                "en": "The restored palace is an <w>asset</w> to the entire city."
                            }
                        }
                    ],
                    "synonyms": [
                        "ornament",
                        "versiering"
                    ],
                    "common_phrases": [
                        "een sieraad voor"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that serves to decorate or beautify a space, building, or landscape; an ornament."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ornament",
                                "target_lang_sense_clarification": "a decorative feature or embellishment"
                            },
                            {
                                "target_lang_word": "asset",
                                "target_lang_sense_clarification": "a source of pride or beauty for a place"
                            },
                            {
                                "target_lang_word": "adornment",
                                "target_lang_sense_clarification": "something that adds beauty or decoration"
                            }
                        ]
                    }
                }
            ]
        }
    ]
