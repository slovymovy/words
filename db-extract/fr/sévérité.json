                                    {
                                        "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                        "entry_id": "8820cd73-b7cd-39be-ad6c-0d7c0bf03228",
                                        "glosses": [
                                            "The state or quality of being strict."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec038508-cba9-4047-b062-9cc6cd94f756",
                                                "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                                "text": "Discipline calls for a certain strictness."
                                            },
                                            {
                                                "example_id": "9c0d66e7-b349-408c-a41d-eed96db90a42",
                                                "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                                "text": "I lost all restraint, and yielding to the force of the emotion, gave down, as mere woman, those effusions of pleasure, which, in the strictness of still faithful love, I could have wished to have held up.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483ba4cf-ab90-3d94-b127-caef2ab92d3b",
                                        "entry_id": "8820cd73-b7cd-39be-ad6c-0d7c0bf03228",
                                        "glosses": [
                                            "The result or product of being strict."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c67f1ae-b148-4a70-88c9-54350b6ca822",
                        "source_entry_id": "0eb9b3a7-42bd-3f8a-a5ad-426e5a424f6f",
                        "target_lang_word": "harshness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harshness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                        "entry_id": "ebbe658f-30fb-345e-8d26-f3cb8c06bfcc",
                                        "glosses": [
                                            "The quality of being harsh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c88f5d-ea3c-4336-bc89-80716edac67b",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "And yet these harshnesses are tenderness itself when compared with the universal harshness out of which they grow; the harshness of the position towards the temperament, of the means towards the aims, of to-day towards yesterday, of hereafter towards to-day."
                                            },
                                            {
                                                "example_id": "d06d9a76-a1af-47b3-b315-51a21e681c54",
                                                "sense_id": "7212fcc6-81b3-3742-9872-87245dce33c8",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
