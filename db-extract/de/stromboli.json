                "entry_id": "227e02de-d1fd-3e28-baba-f664116fe733",
                "word": "Stromboli",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "27dbf824-6ff9-46fa-8edb-dbdbffdf7015",
                        "entry_id": "227e02de-d1fd-3e28-baba-f664116fe733",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "Strombolis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                        "entry_id": "227e02de-d1fd-3e28-baba-f664116fe733",
                        "glosses": [
                            "eine zwölf Quadratkilometer große, nördlich von Sizilien gelegene Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b706e11-2e8d-4846-a00e-f4a75b5ffdbd",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "Die Insel Stromboli ist die am weitesten nördlich gelegenen Insel des Archipels der Liparischen (Äolischen) Inseln."
                            },
                            {
                                "example_id": "48629007-d1d9-4fa9-a982-a4ce00067581",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "Die Insel Stromboli im Mittelmeer ist schwer erreichbar, ihre Strände sind schwarz."
                            },
                            {
                                "example_id": "6d3f0df6-ff3a-4d4c-a3e0-f26d1531e72a",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "Stromboli ist eine der sieben bewohnten, UNESCO-geschützten Äolischen Inseln, die sich nördlich von Sizilien im Tyrrhenischen Meer befinden und politisch zur sizilianischen Provinz Messina gehören."
                            },
                            {
                                "example_id": "8fa30dca-1978-478a-a31a-791d1ff0cba5",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "An Bord des Ausflugsschiffes „Star“, das wie viele andere abends vor der Nordwestküste der Insel Stromboli ankert, ist es um 20.30 Uhr mucksmäuschenstill."
                            },
                            {
                                "example_id": "a14b7ee3-d726-44dc-b434-d7f8abfc6bd7",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "Rund 350 Menschen leben ständig auf Stromboli."
                            },
                            {
                                "example_id": "afd135ed-73d0-41b0-b480-3471e4a78de4",
                                "sense_id": "d54f7e0d-0e31-38d1-8bd9-bd852bcdfeee",
                                "text": "Es war eine stürmische Liebesgeschichte, die 1949 auf der Insel Stromboli irgendwo vor der sizilianischen Küste begann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
