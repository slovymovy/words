                                        "entry_id": "005d913d-7e9f-395f-8560-a908db58d525",
                                        "glosses": [
                                            "ohnout kolena tak, aby se dotýkala země či jiného vodorovného povrchu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f929153-2df1-4593-8e38-5fb06fedf0a5",
                                                "sense_id": "4454af0f-b11c-3e7f-9984-088c45a604ef",
                                                "text": "Královnička poklekla na šátek rozprostřený, ponořila džbán do stříbrné pěny, pak do všech světa stran vodu vylila"
                                            },
                                            {
                                                "example_id": "e2105621-3571-4afc-826d-a74beb40ff70",
                                                "sense_id": "4454af0f-b11c-3e7f-9984-088c45a604ef",
                                                "text": "Má milá pojď a poklekni, teď právě čas je k modlení — měsíček vyšel nad lesy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3173f75-e344-326a-baa7-5b44fdb89d5c",
                                        "entry_id": "005d913d-7e9f-395f-8560-a908db58d525",
                                        "glosses": [
                                            "pokořit se před někým nebo něčím, jakoby v nábožné úctě"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
