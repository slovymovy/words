                                        "sense_id": "bcae8d7d-07c6-3923-807d-c7e9f9c9e6cc",
                                        "entry_id": "37650c83-bd85-3823-9252-60161034d7a3",
                                        "glosses": [
                                            "Texte donnant par écrit sur l’écran les paroles d’un film ou d’un programme télévisé, soit pour traduire dans une autre langue ce qui est dit, soit pour le rendre accessible à ceux qui ne sont pas en situation d'entendre la bande sonore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8219e0-f0d0-466b-8297-17ef641a7e1e",
                                                "sense_id": "bcae8d7d-07c6-3923-807d-c7e9f9c9e6cc",
                                                "text": "Ils écoutaient la radio, sans doute, et ma mère tapait à la machine, maladroitement, les sous-titres qu’elle devait remettre chaque semaine à la Continental."
                                            }
                                        ]
                                    }
