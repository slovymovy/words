                                "target_senses": [
                                    {
                                        "sense_id": "5206b50b-9db0-38f1-bd16-27acfa14c572",
                                        "entry_id": "4f8a32a8-5939-3421-9481-9f4f6373f31d",
                                        "glosses": [
                                            "Sœur d’un des quatre grands-parents d’une personne. On est pour sa grand-tante un petit-neveu ou une petite-nièce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a48368-fb26-4e21-834d-f98ef1b4558b",
                                                "sense_id": "5206b50b-9db0-38f1-bd16-27acfa14c572",
                                                "text": "Bien que je ne sois pas une Frontenac, j’estime que mes enfants doivent contribuer pour leur part à l’entretien de leur grand-tante et même lui assurer ce train de vie ridiculement coûteux et dont elle est incapable de jouir."
                                            },
                                            {
                                                "example_id": "a5dd8ee9-ccf3-4851-89ab-fa6a1772528b",
                                                "sense_id": "5206b50b-9db0-38f1-bd16-27acfa14c572",
                                                "text": "Jamais on ne me commandait. Un père et une mère ont sur leur fils des droits consacrés qu’une grand-tante ne pensa jamais à exercer sur son petit-neveu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328d4ecd-daea-30f6-9df7-bcb16034596c",
                                        "entry_id": "4f8a32a8-5939-3421-9481-9f4f6373f31d",
                                        "glosses": [
                                            "Conjointe d’un membre de la fratrie d’un des quatre grands-parents d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
