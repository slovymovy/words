                "senses": [
                    {
                        "sense_id": "1edc391e-50f6-30af-85a9-d3650489b00c",
                        "entry_id": "6a51bfea-260d-3835-b224-3f7b669883e9",
                        "glosses": [
                            "relativ hohe Temperaturen im Sommer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d39ca8e-dfee-4144-a191-7645c6cc58a2",
                                "sense_id": "1edc391e-50f6-30af-85a9-d3650489b00c",
                                "text": "„Seit dem Frühjahr wütet die Seuche, und mit der Sommerwärme hat sie ihren Höhepunkt erreicht.“"
                            },
                            {
                                "example_id": "ff6c5584-e183-412b-9d03-0d3faebb48d1",
                                "sense_id": "1edc391e-50f6-30af-85a9-d3650489b00c",
                                "text": "„Ich schlenderte zum Jardin du Luxembourg, wo sich eine Handvoll Menschen in der Sommerwärme ausruhte, wo Kinder auf einem kleinen Spielplatz Karussel fuhren und fröhlich lachten.“"
                            }
                        ],
