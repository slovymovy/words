                        "translation_id": "8da4023f-a28f-4027-8224-25e7540925be",
                        "source_entry_id": "862a275b-267c-314b-a278-faf382df3eb4",
                        "source_sense_id": "88b2de8e-6d2f-3d4b-9685-8b5bc93a07ad",
                        "target_lang_word": "incest",
