                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a678b64-54a4-495a-8ab6-3ae8ab1ced44",
                        "source_entry_id": "5e961f83-b7dd-3c99-aeb0-b979a0d5f8eb",
                        "source_sense_id": "047d1f57-9fe3-3943-81fd-5f841def43c2",
                        "target_lang_word": "palefrenier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palefrenier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                        "entry_id": "69d43a41-34e6-30b0-a204-8a80098953d3",
                                        "glosses": [
                                            "Employé d’une structure équestre chargé de l’entretien des écuries et des soins quotidiens aux chevaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b01e666-8c0d-457b-826d-1332807040ec",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Le coursier fut conduit dans la lice par deux palefreniers richement vêtus."
                                            },
                                            {
                                                "example_id": "487aa859-7a7e-4f3c-ac84-09c61367457a",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Les écuries du roi et l'hôtel des gardes-du-corps devinrent pour eux un nouveau sujet de désordre; ils s’y précipitèrent en foule et jetèrent l’effroi parmi les valets d'écurie et les palefreniers."
                                            },
                                            {
                                                "example_id": "1758c259-5e87-416b-8ad8-f3f3fe82e4b2",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "M. de la Vablerie-Chamberlan n’aimait que la chasse ; il avait six chiens au fond de sa cour et une voiture à deux chevaux ; le père Robert, de la rue des Capucins, leur servait de cocher, de palefrenier, de domestique et de piqueur."
                                            },
                                            {
                                                "example_id": "690ac234-bbe9-4b1a-ae64-f0bfba88f468",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Avant de sortir le cheval, le piqueur ou le palefrenier le peigne, le lisse, et, en retirant la couverture, si on le lui ordonne, il en profite pour l’emboucher."
                                            },
                                            {
                                                "example_id": "f38835ec-3138-4369-b7a7-3b722c0ef88a",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Charlemagne m’apparut comme un gros palefrenier allemand ; nos chevaliers me semblèrent des lourdauds, dont Thémistocle et Alicibiade eussent souri."
                                            },
                                            {
                                                "example_id": "2715bd1d-fd27-4f5d-ba63-987786abea8b",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Quatre chevaux splendides, tout sellés et bridés, marchent aux deux côtés de la route, tenus en main par des palefreniers nègres."
                                            },
                                            {
                                                "example_id": "d15144a5-2d3e-4485-83b8-42c60f478da5",
                                                "sense_id": "f099d684-b4d4-3c54-88f6-9b1d398461ac",
                                                "text": "Le haras s’étend sur plusieurs hectares d'une herbe de contes de fées. J'emprunte une allée bordée de fusains et débouche sur la cour centrale où un palefrenier et un maître de manège s'engueulent virilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
