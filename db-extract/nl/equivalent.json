                "senses": [
                    {
                        "sense_id": "1367ba07-9e10-38c7-9558-449b1bcd7b2c",
                        "entry_id": "b82fa16b-9b9a-3aa0-a655-35021cc2dc5f",
                        "glosses": [
                            "iets gelijkwaardigs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05539a57-d0e9-4691-9386-5cb208e1127a",
                                "sense_id": "1367ba07-9e10-38c7-9558-449b1bcd7b2c",
                                "text": "Dat is het equivalent van drie glazen bier."
                            },
                            {
                                "example_id": "9cbeab40-1cf5-4abc-aed0-0fef9f2ba02e",
                                "sense_id": "1367ba07-9e10-38c7-9558-449b1bcd7b2c",
                                "text": "Maar nadat Boedapest zijn equivalent van het Slânsky-proces had doorgemaakt, werden de demonstraties steeds oncontroleerbaarder en ontwikkelden zich tot een opstand tegen alles waar de partij en regering voor stonden, geleidelijk aan met gewapende groepen."
                            }
                        ]
                    },
                    {
                        "sense_id": "843b8a90-efec-3718-bb1a-afc690963fc4",
                        "entry_id": "b82fa16b-9b9a-3aa0-a655-35021cc2dc5f",
                        "glosses": [
                            "een woord of woordgroep in een bepaalde taal dat verwijst naar precies hetzelfde concept als een woord of woordgroep in een andere taal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41583ae-d81b-4cd9-93ec-862ec579dbf2",
                                "sense_id": "843b8a90-efec-3718-bb1a-afc690963fc4",
                                "text": "Chambres d'hôte is het Franse equivalent van 'bed and breakfast'."
                            }
                        ]
                    },
                    {
                        "sense_id": "f30a409a-6198-3c52-a367-224db1d59af7",
                        "entry_id": "b82fa16b-9b9a-3aa0-a655-35021cc2dc5f",
                        "glosses": [
                            "een woord met volledig gelijke betekenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf74b05-5bb5-4952-9154-2d5d2e08a066",
                                "sense_id": "f30a409a-6198-3c52-a367-224db1d59af7",
                                "text": "'Plezant' is het Vlaamse equivalent van 'leuk'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87c789ae-f779-40e2-82ee-e1abb8ec3678",
                        "source_entry_id": "b82fa16b-9b9a-3aa0-a655-35021cc2dc5f",
