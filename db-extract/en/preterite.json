                    {
                        "sense_id": "6f958c48-e26b-38af-84bc-f7ed937fdd58",
                        "entry_id": "3975b3d8-1cb3-3def-abaa-e36ac8a5a666",
                        "glosses": [
                            "Showing an action at a determined moment in the past."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3826926e-2656-4c07-8b3b-cf62004890cb",
                                "sense_id": "6f958c48-e26b-38af-84bc-f7ed937fdd58",
                                "text": "The Dravidian preterite tense is ordinarily formed, like the present, by annexing the pronominal signs to the preterite verbal participle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5855c04-32f4-3ad7-bcde-3c18be2b0219",
                        "entry_id": "3975b3d8-1cb3-3def-abaa-e36ac8a5a666",
                        "glosses": [
                            "Belonging wholly to the past; passed by."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "41ccb404-0173-407d-ba52-8939d9b8f201",
                                "sense_id": "d5855c04-32f4-3ad7-bcde-3c18be2b0219",
                                "text": "Without leaving your elbow-chair, you shall go back with me thirty years, which will bring you among things and persons as thoroughly preterite as Romulus or Numa."
                            },
                            {
                                "example_id": "9b17c388-3d99-44ec-a724-f31a10a3a389",
                                "sense_id": "d5855c04-32f4-3ad7-bcde-3c18be2b0219",
                                "text": "Boas, Benedict, Malinowski, Radcliffe-Brown, Murdock, Evans-Pritchard, Griaule, Levi-Strauss, to keep the list short, preterite, and variegated, […]"
                            }
                        ]
                    }
                ],
