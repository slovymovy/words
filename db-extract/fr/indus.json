                                    {
                                        "sense_id": "5655e9ef-b604-3c65-9d43-1b7e63bbc7da",
                                        "entry_id": "592b96c0-dc17-3a7d-9c53-e99da487df54",
                                        "glosses": [
                                            "Strom in Pakistan, Teilen Indiens und Tibets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde64e22-d4dc-4ed0-831c-a9e79fb08fab",
                                                "sense_id": "5655e9ef-b604-3c65-9d43-1b7e63bbc7da",
                                                "text": "„Der Indus oder «Sind», wie ihn die Bewohner nennen, ist die pulsierende Lebensader, die das Land von Norden nach Süden durchzieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0e870f4-5646-4571-9770-cc9dbdc1cd01",
                        "source_entry_id": "47e5590e-1d40-360b-924e-2475c89d4813",
                        "target_lang_word": "Indus",
                        "target_lang_code": "en",
