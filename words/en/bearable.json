{
    "word_family": [
        "bear",
        "bearer",
        "unbearable",
        "bearably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c15d215c-9b42-33ba-aa00-a6ae3fefb39b",
                    "sense_definition": "Able to be accepted, endured, or tolerated, even if unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taking frequent rests made the long and exhausting hike barely <w>bearable</w>.",
                            "target_lang_translations": {
                                "it": "Fare pause frequenti ha reso la lunga ed estenuante escursione a malapena <w>sopportabile</w>."
                            }
                        },
                        {
                            "text": "The medicine made the pain somewhat more <w>bearable</w> throughout the night.",
                            "target_lang_translations": {
                                "it": "Il medicinale ha reso il dolore un po' più <w>sopportabile</w> per tutta la notte."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolerable",
                        "endurable"
                    ],
                    "antonyms": [
                        "unbearable",
                        "intolerable"
                    ],
                    "common_phrases": [
                        "barely bearable",
                        "make life bearable",
                        "bearable pain"
                    ],
                    "target_lang_definitions": {
                        "it": "Che può essere accettato, sopportato o tollerato, sebbene spiacevole o doloroso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sopportabile",
                                "target_lang_sense_clarification": "riferito a dolore, fatica o situazioni sgradevoli"
                            },
                            {
                                "target_lang_word": "tollerabile",
                                "target_lang_sense_clarification": "accettabile, che si può tollerare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5456c122-895e-3820-820e-08a11967ec8f",
                    "sense_definition": "Capable of being carried or physically supported.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "portable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden crate was easily <w>bearable</w> by two strong workers.",
                            "target_lang_translations": {
                                "it": "La cassa di legno era facilmente <w>trasportabile</w> da due operai robusti."
                            }
                        },
                        {
                            "text": "The heavy load remained <w>bearable</w> only because its weight was distributed evenly.",
                            "target_lang_translations": {
                                "it": "Il carico pesante è rimasto <w>sostenibile</w> solo perché il peso era distribuito uniformemente."
                            }
                        }
                    ],
                    "synonyms": [
                        "portable",
                        "supportable"
                    ],
                    "target_lang_definitions": {
                        "it": "Che può essere sostenuto fisicamente o trasportato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sostenibile",
                                "target_lang_sense_clarification": "che può essere retto fisicamente da una struttura o da un corpo"
                            },
                            {
                                "target_lang_word": "trasportabile",
                                "target_lang_sense_clarification": "che può essere sollevato o portato"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}