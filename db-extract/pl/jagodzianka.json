                "senses": [
                    {
                        "sense_id": "7a8e8013-b573-3eac-bc17-7821f0cd5d55",
                        "entry_id": "85bacab4-9d42-3cf7-b43e-545e455f129e",
                        "glosses": [
                            "zupa jagodowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077cbe8d-c73a-478f-827c-58ff10a14c80",
                                "sense_id": "7a8e8013-b573-3eac-bc17-7821f0cd5d55",
                                "text": "W ciepłe, sierpniowe dni gotuję dzieciom jagodziankę na obiad."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7cb0433e-3bf1-3a78-8bac-c3e3f523213b",
                        "entry_id": "85bacab4-9d42-3cf7-b43e-545e455f129e",
                        "glosses": [
                            "drożdżówka nadziewana jagodami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cb3964-6597-4e6b-bd14-c5992d8f0d08",
                                "sense_id": "7cb0433e-3bf1-3a78-8bac-c3e3f523213b",
                                "text": "Do pracy, na drugie śniadanie, wziąłem dwie jagodzianki i precla."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "bcd60a49-9a0b-3114-9c89-9b8d6afff3f1",
                        "entry_id": "85bacab4-9d42-3cf7-b43e-545e455f129e",
                        "glosses": [
                            "denaturat"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "34db73ab-906a-4931-88e3-93970f46c0ac",
                                "sense_id": "bcd60a49-9a0b-3114-9c89-9b8d6afff3f1",
                                "text": "Za rogiem jakieś menele raczą się jagodzianką pod salceson."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "d2bc9f35-8cd8-3ad1-af63-247297efe86a",
                        "entry_id": "85bacab4-9d42-3cf7-b43e-545e455f129e",
                        "glosses": [
                            "przydrożna prostytutka, stojąca przy drodze w lesie"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "d80389c7-ae8e-47f4-9a27-707b76828c9a",
                                "sense_id": "d2bc9f35-8cd8-3ad1-af63-247297efe86a",
                                "text": "Kupuje nowe ubrania i kosmetyki, w tym mocno czerwoną szminkę. Stylizuje się na jakąś \"jagodziankę\", a wiadomo, że czerwone usta zawsze działają silnie na mężczyzn"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
