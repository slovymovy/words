                                    {
                                        "sense_id": "e938b09a-6fe4-3655-8a93-bb996d60ae1b",
                                        "entry_id": "a18cc451-fed1-3dc7-95d2-5520ebbf15e8",
                                        "glosses": [
                                            "A large, transparent, inflatable ball, inside which a person may be secured and then rolled downhill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b3a0b1-d374-47cf-81ed-3dbc60300c79",
                                                "sense_id": "e938b09a-6fe4-3655-8a93-bb996d60ae1b",
                                                "text": "An Interlaken entrepreneur […] came across the activity in the Swiss canton of Valais (the Rhone Valley) and ended up buying the 'zorbs' from a German manufacturer."
                                            },
                                            {
                                                "example_id": "a9c58899-6e33-4a2d-be1d-441560f6ca2a",
                                                "sense_id": "e938b09a-6fe4-3655-8a93-bb996d60ae1b",
                                                "text": "Uneven plains that are interspersed with pebbles and rocks are likely to cause punctures in the zorbs."
                                            },
                                            {
                                                "example_id": "e25d1bd3-4429-49e7-9b8a-ab9dd258d17a",
                                                "sense_id": "e938b09a-6fe4-3655-8a93-bb996d60ae1b",
                                                "text": "There's even a kids' zorb for the under six."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zorb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74a89ad3-5774-3e62-9fe3-5c754fcb48d5",
                                        "entry_id": "f78fe4d9-6edf-3c72-8470-2d051ba12717",
                                        "glosses": [
                                            "To roll downhill or engage in sports in a zorb ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0fa616-d25c-4fbb-9976-d00766a19e32",
                                                "sense_id": "74a89ad3-5774-3e62-9fe3-5c754fcb48d5",
                                                "text": "People who've zorbed in New Zealand, say Swiss mountains are too steep to allow the leisurely roll-out that's the real thrill."
                                            },
                                            {
                                                "example_id": "74884336-3c19-48d5-928e-264588921aad",
                                                "sense_id": "74a89ad3-5774-3e62-9fe3-5c754fcb48d5",
                                                "text": "We hadn't even zorbed. Not all bad news then."
                                            },
                                            {
                                                "example_id": "7bc65941-491e-460e-bc6e-177f46cf7548",
                                                "sense_id": "74a89ad3-5774-3e62-9fe3-5c754fcb48d5",
                                                "text": "Vieira zorbed — that is, rolled down a hill within an inflatable ball."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
