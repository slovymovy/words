                        "reconnaissance vocale"
                    ]
                },
                {
                    "sense_id": "5cda4699-467d-33e9-a393-0be02fb3f56b",
                    "sense_definition": "Action d'admettre la valeur, les mérites ou le statut de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés réclament une plus grande <w>reconnaissance</w> de leurs efforts quotidiens."
                        },
                        {
                            "text": "Cet artiste a finalement obtenu la <w>reconnaissance</w> internationale qu'il méritait."
                        }
                    ],
                    "common_phrases": [
                        "reconnaissance professionnelle",
                        "manque de reconnaissance"
                    ]
                },
                {
                    "sense_id": "c1225fbf-788e-3dc3-b2b3-9aaddab61240",
                    "sense_definition": "Opération militaire d'exploration pour observer un terrain et recueillir des informations sur l'adversaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux soldats sont partis en mission de <w>reconnaissance</w> près de la frontière."
                        },
                        {
                            "text": "Un avion de <w>reconnaissance</w> survole la zone pour repérer les positions ennemies."
                        }
                    ],
                    "common_phrases": [
