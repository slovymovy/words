                    {
                        "sense_id": "c2ee7e3c-d7f7-32fe-8414-94e8783c4f84",
                        "entry_id": "5f879419-8680-3264-adba-eb05aa116a53",
                        "glosses": [
                            "Extrêmement fin, d'une épaisseur ou d'un diamètre nettement inférieur à la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234f71c0-50af-4770-91f4-d56dfb399b5e",
                                "sense_id": "c2ee7e3c-d7f7-32fe-8414-94e8783c4f84",
                                "text": "Vous allez me passer tout ce merdier au tamis ultra-fin."
                            },
                            {
                                "example_id": "8e44cbcb-fe85-4e58-9a66-3f580e5f212d",
                                "sense_id": "c2ee7e3c-d7f7-32fe-8414-94e8783c4f84",
                                "text": "Il s’agit d’un sel ultra-fin, obtenu par tamisage du sel fin."
                            },
                            {
                                "example_id": "bc5c8214-59b0-4186-94d2-87dc8a1921ba",
                                "sense_id": "c2ee7e3c-d7f7-32fe-8414-94e8783c4f84",
                                "text": "L’ensemble est délicat, évolue sur les fruits jaunes au fil de la gorgée ; l’acidité fait place à un filet de sucrosité, ultra-fin et fugace, car l’amertume reprend le dessus."
                            }
                        ]
                    }
                ],
