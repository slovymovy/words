                    },
                    {
                        "sense_id": "f3c1ebe4-1282-3c73-be9c-1d597fb38935",
                        "entry_id": "3f172c01-54d7-3cff-a495-33734e45073a",
                        "glosses": [
                            "Tumeur.",
                            "Tumeur du chêne."
