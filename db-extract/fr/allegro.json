            {
                "entry_id": "b49a2407-ac64-3879-b03b-ee19275d5d0d",
                "word": "Allegro",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e87eb055-2b06-354b-bd4d-e92e8a20d104",
                        "entry_id": "b49a2407-ac64-3879-b03b-ee19275d5d0d",
                        "glosses": [
                            "Nom donné par la marque automobile Austin à un modèle compact, produit de 1973 à 1982."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "bb69931e-f95a-4beb-be37-5e37357fc6ed",
                                "sense_id": "e87eb055-2b06-354b-bd4d-e92e8a20d104",
                                "text": "Et si l’Allegro avait été étudiée pour être équipée d’un Hayon, elle se contente finalement d’une malle pour éviter de faire de l’ombre à l’Austin Maxi…"
                            },
                            {
                                "example_id": "fb6773b1-056f-41d0-9b06-59d2eb25dc73",
                                "sense_id": "e87eb055-2b06-354b-bd4d-e92e8a20d104",
                                "text": "Même si on ne peut pas vraiment la qualifier de bide, l’Allegro marque pourtant le début de la fin pour l’industrie automobile britannique."
                            },
                            {
                                "example_id": "9c3960e5-b80b-441a-8326-e9d30cf0e3ac",
                                "sense_id": "e87eb055-2b06-354b-bd4d-e92e8a20d104",
                                "text": "Il ne reste plus que 170 Austin Allegro sur les 642.340 produites."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "41905ea6-ae06-3b29-ae64-caab5637f8d1",
                "word": "allegro",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a83859e-dea0-4a3d-860d-8535e0ba82de",
                        "entry_id": "41905ea6-ae06-3b29-ae64-caab5637f8d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "allegros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4f8c39a-e710-35da-9a33-94102978b805",
                        "entry_id": "41905ea6-ae06-3b29-ae64-caab5637f8d1",
                        "glosses": [
                            "Variante, dans l’orthographe traditionnelle, de allégro."
                        ],
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "examples": [
                            {
                                "example_id": "a53dc483-980c-4238-8e0c-c183a62adf3b",
                                "sense_id": "e4f8c39a-e710-35da-9a33-94102978b805",
                                "text": "Jeanne le plaint, fléchit, bémolise, repart dans le majeur, l’allegro vivace, le finale où toutes les lances fleurissent, où les ailes poussent à chacun et font de pauvres bougres l’assemblée des anges."
                            },
                            {
                                "example_id": "7b838777-c4db-4e37-be5a-c56592f89b7d",
                                "sense_id": "e4f8c39a-e710-35da-9a33-94102978b805",
                                "text": "Jadis, quand on avait écrit un allegro pour instruments à cordes, on le faisait paisiblement entendre à la première occasion et on se mettait à élaborer un petit morceau de piano orné d’un titre généralement exquis."
                            }
                        ]
                    }
                ],
