                                                "example_id": "8e1b4184-e210-4a6c-8be3-da4539925f56",
                                                "sense_id": "ca7e88f1-497c-3123-acda-263c137df352",
                                                "text": "Can you cut me a wedge of cheese?"
                                            },
                                            {
                                                "example_id": "84196d89-d062-4400-aaa8-9c28670c5ee5",
                                                "sense_id": "ca7e88f1-497c-3123-acda-263c137df352",
                                                "text": "We ordered a box of baked potato wedges with our pizza."
                                            }
                                        ]
                                    },
                                    {
