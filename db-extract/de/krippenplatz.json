                "senses": [
                    {
                        "sense_id": "7db0ad6d-d61c-314c-9bf2-927439c38933",
                        "entry_id": "61501312-c5f1-319e-9bd3-cd3786e4e703",
                        "glosses": [
                            "vertraglich vereinbarte Aufnahme eines Kleinkindes in eine Betreuungseinrichtung speziell für Kinder unter 3 Jahren, zwecks Tagesbetreuung (früher auch wochenweise)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24c5aad-a1c2-435b-8e4f-706cbb429a52",
                                "sense_id": "7db0ad6d-d61c-314c-9bf2-927439c38933",
                                "text": "Um sich einen Krippenplatz zu sichern, melden viele Eltern ihr Kind noch vor der Geburt in einer entsprechenden Kinderbetreuungseinrichtung an."
                            },
                            {
                                "example_id": "df90f505-03c8-42df-9b3d-469f85c479dc",
                                "sense_id": "7db0ad6d-d61c-314c-9bf2-927439c38933",
                                "text": "Der Ausbau der Kinderbetreuung erfordert die Schaffung von mehr Krippenplätzen."
                            },
                            {
                                "example_id": "782658a1-4442-48c2-916e-3dacb159c9a7",
                                "sense_id": "7db0ad6d-d61c-314c-9bf2-927439c38933",
                                "text": "Nur 33, 6 Prozent der Kinder unter drei Jahren hatten im Jahr 2017/18 in Deutschland einen Krippenplatz."
                            }
                        ],
