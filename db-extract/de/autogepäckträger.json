                "senses": [
                    {
                        "sense_id": "6dd2b547-86bd-32d6-8411-fd04de125b2a",
                        "entry_id": "57529c03-9493-3a8f-b5ec-e9990f204df6",
                        "glosses": [
                            "an Fahrzeugen befestigte Vorrichtung zum Transportieren von Gepäck oder anderen Gegenständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715da4f9-4be0-4737-89e4-ef66d183c497",
                                "sense_id": "6dd2b547-86bd-32d6-8411-fd04de125b2a",
                                "text": "„Wer mit dem Fahrrad auf dem Autogepäckträger anreist, sollte sein Auto nicht unbedingt in den beiden Großstädten Osnabrück und Bremen abstellen, sondern lieber in einem der ruhigeren Vororte.“:[1] „Sinnvoll ist es auch, den Autogepäckträger abzubauen, wenn du ihn nicht verwendest, weil das Fahren bei Luftwiderstand zusätzliches Benzin verbraucht.“"
                            }
                        ],
