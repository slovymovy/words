                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1517ef1-c32a-4f71-b6a1-c5178ea2e882",
                                "sense_id": "4883a424-d752-3ed6-b3b4-8296ecad4e18",
                                "text": "De tocht over het ijsveld was een hachelijke onderneming."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69672773-447b-4eb7-8229-9ace706578ef",
                        "source_entry_id": "9dc22704-1b15-3db5-b6fd-195b21a3107b",
                        "source_sense_id": "4883a424-d752-3ed6-b3b4-8296ecad4e18",
                        "source_sense_description": "aanmerkelijk aan gevaar of risico blootstaand",
                        "target_lang_word": "dicey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dicey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37cfb842-6b0e-3c6c-8fc3-f0be65002eab",
                                        "entry_id": "7366e625-10d4-369b-8dfe-f8ff821a335c",
                                        "glosses": [
                                            "Fraught with danger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2086374-80b3-3174-890c-f63e6c5e756e",
                                        "entry_id": "7366e625-10d4-369b-8dfe-f8ff821a335c",
                                        "glosses": [
                                            "Of uncertain, risky outcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6411d16-742a-4197-b4a8-15c44cd4d66f",
                                                "sense_id": "c2086374-80b3-3174-890c-f63e6c5e756e",
                                                "text": "This was a dicey stratagem because all too often the support Britain rendered played into Zanu-PF's anti-colonial constructions."
                                            },
                                            {
                                                "example_id": "2b66a35c-6a88-4db2-ba83-971cd0d21e40",
                                                "sense_id": "c2086374-80b3-3174-890c-f63e6c5e756e",
                                                "text": "Devouring the flesh of animals killed on roadways can be a bit dicey."
                                            },
                                            {
                                                "example_id": "6cc71e35-75e3-457b-b1bc-0b1bdbd50380",
                                                "sense_id": "c2086374-80b3-3174-890c-f63e6c5e756e",
                                                "text": "For sure, the economic and fiscal prospects for an independent Scotland look a lot dicier than they did three years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c315f8-c907-3819-adfb-1ba9276af649",
                                        "entry_id": "7366e625-10d4-369b-8dfe-f8ff821a335c",
                                        "glosses": [
                                            "Of doubtful or uncertain efficacy, provenance, etc.; dodgy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b261d11-c2f2-4829-a351-66b939a7f093",
                                                "sense_id": "47c315f8-c907-3819-adfb-1ba9276af649",
                                                "text": "As if I'm not a bit past that, Clem thought, as if with his dicey ticker and all he shouldn′t be taking life pretty quietly, instead of waking with the old memoroes disturbing him."
                                            },
                                            {
                                                "example_id": "b37f2709-ede3-431f-b9ab-42b8f51e500e",
                                                "sense_id": "47c315f8-c907-3819-adfb-1ba9276af649",
                                                "text": "If you were in the business of selling dicey meat, the invention of the telephone rocked your world."
                                            },
                                            {
                                                "example_id": "63c8453d-6f20-47d3-acaf-c668ce10051c",
                                                "sense_id": "47c315f8-c907-3819-adfb-1ba9276af649",
                                                "text": "Some more birds were scared off by the dicey smell. The man was dying gradually."
                                            },
                                            {
                                                "example_id": "cb28c850-3b60-4be8-9478-9dcd4d5039a6",
                                                "sense_id": "47c315f8-c907-3819-adfb-1ba9276af649",
                                                "text": "But on abortion, one of his diciest issues, his repeated commitment to follow Trump's lead seemed to satisfy ardent anti-abortion members, although several Democrats did their best to remind those colleagues that Kennedy's personal values have been in stark contrast with their own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c0c141-d880-4953-8044-207c1356985d",
                        "source_entry_id": "9dc22704-1b15-3db5-b6fd-195b21a3107b",
                        "source_sense_id": "4883a424-d752-3ed6-b3b4-8296ecad4e18",
                        "source_sense_description": "aanmerkelijk aan gevaar of risico blootstaand",
                        "target_lang_word": "dangerous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dangerous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3d5c1a-5fc4-3c0d-8c30-0fe1ea47a67d",
                                        "entry_id": "577f2fa8-bf06-35b5-a22d-2b36cca98693",
                                        "glosses": [
                                            "Full of danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c8c7c3-3fa6-4f71-9b92-bdc16e9c7266",
                                                "sense_id": "ce3d5c1a-5fc4-3c0d-8c30-0fe1ea47a67d",
                                                "text": "Railway crossings without gates are highly dangerous."
                                            },
                                            {
                                                "example_id": "392d18b0-1beb-403b-b886-2c7f36d12306",
                                                "sense_id": "ce3d5c1a-5fc4-3c0d-8c30-0fe1ea47a67d",
                                                "text": "[I]t is not fair of you to bring against mankind double weapons! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves."
                                            },
                                            {
                                                "example_id": "1e86b9ac-3447-4bcb-b446-ff3115ecadb3",
                                                "sense_id": "ce3d5c1a-5fc4-3c0d-8c30-0fe1ea47a67d",
                                                "text": "Young Indians looking for work opportunities have made up a sizeable portion of undocumented migrants in the US, many after making the dangerous trek through Latin America to reach the US southern border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595ec23e-5055-332d-95b8-fff32a3c5eba",
                                        "entry_id": "577f2fa8-bf06-35b5-a22d-2b36cca98693",
                                        "glosses": [
                                            "Causing danger; ready to do harm or injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc512ab-d1a1-4b9d-bc7d-1372aa9ef2c4",
                                                "sense_id": "595ec23e-5055-332d-95b8-fff32a3c5eba",
                                                "text": "If they incline to think you dangerous, / They have their knaviſh Arts to make you ſo."
                                            },
                                            {
                                                "example_id": "f01577a2-175e-43e3-a146-27f5bf1397c1",
                                                "sense_id": "595ec23e-5055-332d-95b8-fff32a3c5eba",
                                                "text": "And the Duke thought: The truth could he worse than he imagines, but even dangerous facts are valuable if you’ve been trained to deal with them. And there’s one place where nothing has been spared for my son—dealing with dangerous facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3392884c-08be-3356-bb5a-a7013706bd27",
                                        "entry_id": "577f2fa8-bf06-35b5-a22d-2b36cca98693",
                                        "glosses": [
                                            "In a condition of danger, as from illness; threatened with death."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
