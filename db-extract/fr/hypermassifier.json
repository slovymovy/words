                ],
                "senses": [
                    {
                        "sense_id": "747a7965-1417-3331-be21-ea2dbdbd417c",
                        "entry_id": "734d92f6-0bee-383b-8ca3-78253f8a89b0",
                        "glosses": [
                            "Donner un caractère hypermassif à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a677fa6-379c-4480-9289-dad406297206",
                                "sense_id": "747a7965-1417-3331-be21-ea2dbdbd417c",
                                "text": "Mais, dans la mesure où le capital doit hypermassifier les comportements, il doit aussi hypermassifier les désirs et grégariser les individus."
                            },
                            {
                                "example_id": "52e203b8-6478-4a2f-a187-65ab66238a4f",
                                "sense_id": "747a7965-1417-3331-be21-ea2dbdbd417c",
                                "text": "Démassifier l’audience ou hypermassifier la culture ?"
                            },
                            {
                                "example_id": "af4033a5-7820-481d-9664-3f4bcf7a649b",
                                "sense_id": "747a7965-1417-3331-be21-ea2dbdbd417c",
                                "text": "L’auteur soutient que le développement des loisirs, produits et organisés par les industries culturelles et de programmes, n’ont pas pour fonction de libérer l’individu, mais bien de le contrôler pour l’hypermassifier."
                            }
                        ]
                    }
                ],
