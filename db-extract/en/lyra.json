                                            {
                                                "example_id": "c408ab30-7bcf-4e48-ac33-dff9bfd7a4e8",
                                                "sense_id": "6ed77320-2ff7-3945-9883-94668e0b111c",
                                                "text": "Die Leier war vor allem in der Renaissance verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b55e4843-cbc7-3c09-a5ef-aa45e78b103c",
                                        "entry_id": "7953d5f7-9d4a-3e08-a445-69f86890684b",
                                        "glosses": [
                                            "Drehvorrichtung, Kurbel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b122bb-10b3-4ad2-8f6a-1111ccb5e28e",
                                                "sense_id": "b55e4843-cbc7-3c09-a5ef-aa45e78b103c",
                                                "text": "Dreh mal an der Leier!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d6f0de55-5b4a-3730-b7e8-09fd247f1f5d",
                                        "entry_id": "7953d5f7-9d4a-3e08-a445-69f86890684b",
                                        "glosses": [
                                            "Sternbild am nördlichen Sternenhimmel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11f14099-b24e-4e1d-b18e-2ccc8701b17f",
                                                "sense_id": "d6f0de55-5b4a-3730-b7e8-09fd247f1f5d",
                                                "text": "Die Leier befindet sich östlich des Schwans."
                                            },
                                            {
                                                "example_id": "17c2c2d0-93dd-4b3b-bdc7-b996b306ac2a",
                                                "sense_id": "d6f0de55-5b4a-3730-b7e8-09fd247f1f5d",
                                                "text": "„Da drehte ihn Pécuchet mit dem Blick auf den Großen Bären und zeigte ihm den Polarstern, dann Cassiopeia, deren Konstellation ein Y bildet, die funkelnde Wega im Sternbild der Leier und unten am Horizont den roten Aldebaran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
