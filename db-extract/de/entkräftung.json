                "senses": [
                    {
                        "sense_id": "d3cbce60-0f67-38ac-abda-4603a8f7a1e8",
                        "entry_id": "9bed8651-3637-3f8b-ba1d-573232b6b897",
                        "glosses": [
                            "Vorgang, immer kraftloser zu werden, und Ergebnis dieses Vorgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d9d250-be32-417f-9a16-6bd2411669c5",
                                "sense_id": "d3cbce60-0f67-38ac-abda-4603a8f7a1e8",
                                "text": "„Endlich kam Laura und berichtete, daß sich die Kranke unverändert in einem Zustand der Entkräftung befinde, daß sich der Arzt über ihre große Schwäche sehr wundere und nicht wisse, worauf sie zurückzuführen sei.“"
                            },
                            {
                                "example_id": "09caf6b4-c064-4a7a-84c8-621486ac71f6",
                                "sense_id": "d3cbce60-0f67-38ac-abda-4603a8f7a1e8",
                                "text": "„Dann hatte er irgendwann vor Entkräftung das Bewußtsein verloren und war erst in der Hütte wieder aufgewacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66cd7376-cf3d-4a5a-99e2-fcc5ab6c5775",
                        "source_entry_id": "9bed8651-3637-3f8b-ba1d-573232b6b897",
                        "source_sense_id": "d3cbce60-0f67-38ac-abda-4603a8f7a1e8",
                        "source_sense_description": "Vorgang, immer kraftloser zu werden, und Ergebnis dieses Vorgangs",
                        "target_lang_word": "exhaustion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhaustion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The point of complete depletion, of the state of being used up."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768b21e8-36e2-46ab-b010-cc7a95c40aa5",
                                                "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                                "text": "We worked the mine to exhaustion, there's nothing left to extract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "Supreme tiredness; having exhausted energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6fa4f0-c62c-4a02-8ad3-1a5a261e094a",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "I ran in the marathon to exhaustion, then I collapsed and had to be carried away."
                                            },
                                            {
                                                "example_id": "99900432-3d94-419a-8db7-cb3871848968",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bfcc54a-22b5-3a62-afa7-44028aa37c60",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal (by percolation etc) of an active medicinal constituent from plant material."
                                        ],
