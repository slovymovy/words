                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8742d00-4915-4a50-8559-fa574687c8d1",
                                "sense_id": "812d38cd-b9c6-3ff4-af62-35ca9f711bd1",
                                "text": "Как-то утром пришёл дед со стамеской в руке, подошёл к окну и стал отковыривать замазку зимней рамы."
                            },
                            {
                                "example_id": "f3c568b0-eb71-4007-9875-146a6c4f0296",
                                "sense_id": "812d38cd-b9c6-3ff4-af62-35ca9f711bd1",
                                "text": "Ловля мидий свелась к тому, что я, раздирая себе в кровь руки, отковыривал мидий от скал тупым штыком, а Иванов складывал их в свою мокрую фуражку."
                            }
                        ]
                    }
