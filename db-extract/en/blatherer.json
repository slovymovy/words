                "senses": [
                    {
                        "sense_id": "8ed7662d-795d-3cf5-93e3-5cc360c027e9",
                        "entry_id": "b924d96a-5e93-3412-81c6-63c775506d20",
                        "glosses": [
                            "jemand, der viel Unsinn oder Belangloses daherredet: Schwätzer, Schwätzerin, Dummschwätzer, Dummschwätzerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31274803-350f-49f6-b1eb-aaca9df52b8a",
                                "sense_id": "8ed7662d-795d-3cf5-93e3-5cc360c027e9",
                                "text": "He's a blatherer.",
                                "translation": "Er ist ein Dummschwätzer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d5712a-1d5a-423d-a53b-67a163c49b3b",
                        "source_entry_id": "b924d96a-5e93-3412-81c6-63c775506d20",
                        "source_sense_id": "8ed7662d-795d-3cf5-93e3-5cc360c027e9",
                        "source_sense_description": "jemand, der Unsinn oder Belangloses daherredet",
                        "target_lang_word": "Schwätzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwätzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                        "entry_id": "ec920827-b477-346b-a75d-bf24d236f417",
                                        "glosses": [
                                            "jemand, der zu jedem Thema meist ungefragt ausschweifende Kommentare abgibt, die im eigentlichen Sinne keiner der Anwesenden hören möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b150ac-611f-4322-8630-1fa77974b7cd",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "Aha, der Schwätzer hat das Wort."
                                            },
                                            {
                                                "example_id": "5e57ae55-7c6e-4a72-b507-b4f68f67f6ca",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "„Dieser lästige Schwätzer hatte ihm gerade noch gefehlt!“"
                                            },
                                            {
                                                "example_id": "fc2481a4-3f14-42ad-8572-1165a13f4814",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "„Der Richter hielt mich für einen Schwätzer.“"
                                            },
                                            {
                                                "example_id": "7e371fec-4ac5-42e5-b8b5-71968c9374e1",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "„Umweltminister Michael Gove, ein Schwätzer vor dem Herrn, behauptete erst, er habe den Brexit mit seiner erfolgreichen Leave-Kampagne quasi im Alleingang herbeigeführt.“"
                                            },
                                            {
                                                "example_id": "e4c3e066-78a5-44fc-ab5d-628a5e17bac1",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "„Die heutigen Gelehrten sind lauter Schwätzer.“"
                                            },
                                            {
                                                "example_id": "bad0223e-1bbb-482e-8073-936016f451b0",
                                                "sense_id": "f67008ed-a227-348d-8f98-781a44af8c35",
                                                "text": "„Die Angst vor der Stille, vor dem Versiegen der künstlerischen Kräfte, vor dem Alter, vor dem Tod trieb ihn in Spelunken, snobistische Bars und laszive Orte der Subkultur an die Seite von Schwätzern und intellektuell wenig reizvollen Trinkgenossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "156edff3-65ce-34dc-ba29-d64e2675f2ec",
                                        "entry_id": "ec920827-b477-346b-a75d-bf24d236f417",
                                        "glosses": [
                                            "jemand, der von seinem Vorhaben zwar redet, beziehungsweise Zusagen macht, diese aber nicht in die Tat umsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e1c3a3-34fe-408b-92c9-bc5ee66ee4a5",
                                                "sense_id": "156edff3-65ce-34dc-ba29-d64e2675f2ec",
                                                "text": "Er ist ein Schwätzer, da steckt nichts dahinter!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "982c211e-ffc9-4251-99d7-1bd83d08d3f3",
                        "source_entry_id": "b924d96a-5e93-3412-81c6-63c775506d20",
                        "source_sense_id": "8ed7662d-795d-3cf5-93e3-5cc360c027e9",
                        "source_sense_description": "jemand, der Unsinn oder Belangloses daherredet",
                        "target_lang_word": "Schwätzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwätzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5fa14f-0afd-3cd8-abb0-6a81e9ac80bb",
                                        "entry_id": "a358daf5-eb66-3983-8b63-8f7a7c860ad9",
                                        "glosses": [
                                            "weibliche Person, die sich gerne reden hört und deshalb viel von sich gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d03973ab-e3ef-46a7-b9d0-6bffc85dce98",
                                                "sense_id": "6b5fa14f-0afd-3cd8-abb0-6a81e9ac80bb",
                                                "text": "Ich schwieg und starrte aus dem Fenster, um diese Schwätzerin nicht auch noch zu ermuntern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b401afd5-20e3-38c4-917d-564fac0be1a2",
                                        "entry_id": "a358daf5-eb66-3983-8b63-8f7a7c860ad9",
                                        "glosses": [
                                            "weibliche Person, die keine Geheimnisse für sich behalten kann, sondern sie ausplaudert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151b3ebe-f520-4106-928c-c3b59a4315b8",
                                                "sense_id": "b401afd5-20e3-38c4-917d-564fac0be1a2",
                                                "text": "Wenn du möchtest, dass alle hier Bescheid wissen, sag es einfach der Schwätzerin Rosi im Vertrauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
