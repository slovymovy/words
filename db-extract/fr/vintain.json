                    },
                    {
                        "sense_id": "4c4e625f-ebd8-355a-8a98-757f46973db5",
                        "entry_id": "18c8869b-fc59-37d9-b554-4871387f83db",
                        "glosses": [
                            "Protection du seigneur moyennant redevance du vingtième, pour la construction et réparation des murailles de la forteresse, puis la redevance elle-même. → voir droit de vintain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                        "entry_id": "18c8869b-fc59-37d9-b554-4871387f83db",
                        "glosses": [
                            "Protection du seigneur moyennant redevance du vingtième, pour la construction et réparation des murailles de la forteresse, puis la redevance elle-même. → voir droit de vintain.",
                            "Enceinte extérieure, muraille d’une forteresse, ou entourant les maisons et le bourg"
                        ],
                        "tags": [
                            "colloquial",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "f59702df-75a5-445c-9c6f-e7c2aa354aa1",
                                "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                                "text": "vintain de la ville, vintain de vent ,vintain de la bise."
                            },
                            {
                                "example_id": "147a27c2-8464-4ab8-9286-712f7f7fd72b",
                                "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                                "text": "[…] soigneux de fortifier leurs châteaux, et de clore leurs bourgs et villages villages de murailles, que le vulgaire appelle vintains."
                            },
                            {
                                "example_id": "1bf90266-a85e-4d2d-bc03-007a18ba32eb",
                                "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                                "text": "[…] les jardins sis à l’emplacement des anciens fossés arrivant « contre le vintain de la ville de vent (au sud) » (juxta vintenum villae ex vento) et « contre ledit vintain sous le cimetière de soir (à l'ouest) » (juxta dictiim vintenum subtus cimiterium ex sero)."
                            },
                            {
                                "example_id": "82ca8f8e-e149-4966-b55e-0f722c0fb546",
                                "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                                "text": "D’autre part, le même terrier nous montre la forteresse primitive bien affaiblie, les murs du vintain percés de multiples poternes pour la commodité des habitants, ces mêmes murs abénévisés par le châtelain."
                            },
                            {
                                "example_id": "3afdb565-3a98-40c8-8e99-f45256ea9411",
                                "sense_id": "59272d0d-3e4b-3168-b9d7-203bc90559cf",
                                "text": "Le Château ne servant pas seulement au Seigneur , mais encore aux habitants pour leur conservation, leur étant un lieu de retraite et de refuge, et à leurs bestiaux- en temps de guerre, comme ils ont intérêt à maintenir la clôture et le vintain , ils en doivent souffrir la dépense ; et ce vintain se peut dire en bon latin , « muralis ambitis »"
                            }
                        ]
                    },
                    {
                        "sense_id": "0e0d3a05-8a16-3e88-8708-6d5a1fa19821",
                        "entry_id": "18c8869b-fc59-37d9-b554-4871387f83db",
                        "glosses": [
                            "Protection du seigneur moyennant redevance du vingtième, pour la construction et réparation des murailles de la forteresse, puis la redevance elle-même. → voir droit de vintain.",
                            "Murs de clôture d’une maison de campagne ou de fonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48320dd-d524-4f64-9f3c-8a9cc780d9ef",
                                "sense_id": "0e0d3a05-8a16-3e88-8708-6d5a1fa19821",
                                "text": "Vintain, l’on appelle ainsi, en Dauphiné, les murailles qui servent de clôture au fonds d’un domaine de campagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf02f8a8-d212-3886-b2b2-80727f6d6bbe",
                        "entry_id": "18c8869b-fc59-37d9-b554-4871387f83db",
                        "glosses": [
                            "(Provence, Dauphiné Languedoc) Sorte de drap, à Ceuta, ou en Provence : en France autrefois appelés draps Vint-cent ou vint-deux-cent."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "540e5488-bded-450b-9990-79b70a9efcd0",
                                "sense_id": "bf02f8a8-d212-3886-b2b2-80727f6d6bbe",
                                "text": "Vintain ou Vingtin. C’est ainsi que l’on appelle les draps de laine donc la chaîne est compilée de vingt fois cent fils , qui font en tout deux mille fils. Il y a d’autres sortes de draps que l’on nomme Vintdeuxaius ; d’autres, Vintquatrains ; d’autres , Vintsixains ; & d’autres encore , Vinthuitains."
                            }
                        ]
                    }
