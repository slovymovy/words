                                "target_lang_sense_clarification": "umgangssprachlich für einen unrunden Motorlauf"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运转不稳",
                                "target_lang_sense_clarification": "指机械故障"
                            },
                            {
                                "target_lang_word": "缺火",
                                "target_lang_sense_clarification": "指发动机点火故障"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8800c227-b6a0-32a4-b710-b6cfdc9dce4b",
                    "sense_definition": "Present participle and gerund of <w>miss</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>missing</w> the bus because I woke up late.",
                            "target_lang_translations": {
                                "ru": "Я <w>опаздываю</w> на автобус, потому что проснулся поздно.",
                                "de": "Ich <w>verpasse</w> den Bus, weil ich zu spät aufgewacht bin.",
                                "zh": "因为起晚了，我<w>错过</w>了公交车。"
                            }
                        },
                        {
                            "text": "She is <w>missing</w> her family back home very much.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>скучает</w> по своей семье, оставшейся на родине.",
                                "de": "Sie <w>vermisst</w> ihre Familie zu Hause sehr.",
                                "zh": "她非常<w>想念</w>家乡的亲人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола miss.",
                        "de": "Partizip Präsens und Gerundium des Verbs miss.",
                        "zh": "miss 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропускающий",
                                "target_lang_sense_clarification": "событие или цель"
