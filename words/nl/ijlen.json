                    "sense_id": "8e398096-69a5-36b5-9420-51cbb1932ed1",
                    "sense_definition": "onamenhangende dingen zeggen als gevolg van hoge koorts of ziekte",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delirium",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt lag de hele nacht te <w>ijlen</w> door de zware infectie.",
                            "target_lang_translations": {
                                "en": "The patient was <w>delirious</w> all night because of the severe infection.",
                                "fr": "Le patient a <w>déliré</w> toute la nuit à cause de la grave infection."
                            }
                        },
                        {
                            "text": "Zij lag te <w>ijlen</w> van de griep en herkende haar eigen familie niet meer.",
                            "target_lang_translations": {
                                "en": "She was <w>raving</w> from the flu and no longer recognized her own family.",
                                "fr": "Elle était en train de <w>délirer</w> à cause de la grippe et ne reconnaissait plus sa propre famille."
                            }
