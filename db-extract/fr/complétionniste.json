                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae9162e2-9ad7-33f9-9ef4-cb390d1d9f30",
                        "entry_id": "14945eaf-e9a5-328c-9992-26d1b18580c2",
                        "glosses": [
                            "Type de joueurs cherchant à compléter un jeu vidéo, à achever tout le contenu qu'il propose ; et, , à débloquer tous les succès."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ce3b9601-63ec-4d54-b7c6-a9295ba4520e",
                                "sense_id": "ae9162e2-9ad7-33f9-9ef4-cb390d1d9f30",
                                "text": "Malgré que l’objectif soit communautaire, chaque jeu se voit accorder une valeur, signifiant une compétition au sein du groupe pour le meilleur « complétionniste »"
                            },
                            {
                                "example_id": "7ff7ca8b-abe5-475a-851e-33be814714e9",
                                "sense_id": "ae9162e2-9ad7-33f9-9ef4-cb390d1d9f30",
                                "text": "Mais l'important, c'est que cette intro me permet de préciser que cet article se destine plus aux Yasmina qu'aux Jonathan, c'est-à-dire aux complétionnistes qui considèrent que finir un jeu, c'est s'assurer que toutes les activités qu'il pouvait nous offrir ont été réussies, avec le meilleur \"score\" possible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0fcf8b6-0d9f-430f-8bef-3088e1004eac",
                        "source_entry_id": "14945eaf-e9a5-328c-9992-26d1b18580c2",
                        "source_sense_id": "ae9162e2-9ad7-33f9-9ef4-cb390d1d9f30",
                        "target_lang_word": "completionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65f18601-8a0e-368a-be82-5875e9d5408c",
                                        "entry_id": "5861ce35-dcc5-3f09-8e24-e2ae5c42a600",
                                        "glosses": [
                                            "Engaging in completionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6125389c-e4ba-49fe-a793-5219c648a3f8",
                                                "sense_id": "65f18601-8a0e-368a-be82-5875e9d5408c",
                                                "text": "M did not have this completionist fetish regarding other matters—he would happily leave a meal uneaten and a book half read—but in matters of travel it was something of a matter of pride."
                                            },
                                            {
                                                "example_id": "57deef74-f365-4908-8e88-cce29781c2cc",
                                                "sense_id": "65f18601-8a0e-368a-be82-5875e9d5408c",
                                                "text": "Visiting the site was part of a completionist project engaged by many Johnny Cash fans, who wanted to see all the places associated with him, but for some, it was enough to glimpse it without leaving the car."
                                            },
                                            {
                                                "example_id": "dbdbc80a-b2fe-4a19-b913-6a852f039bee",
                                                "sense_id": "65f18601-8a0e-368a-be82-5875e9d5408c",
                                                "text": "When I asked him about what drives our completionist mindset, he said, \"I think, as humans, we're obsessed with categorization and patterns. We see them everywhere, and we get a lot of pleasure from 'completing' things, whether it's a set of to-dos for the day or a larger project. […]\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "completionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40cb0af4-1903-3520-9598-cbe16fce0807",
                                        "entry_id": "eae1b9cf-3ca8-34b0-a95d-e3aa89fb211e",
                                        "glosses": [
                                            "A person who practices completionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab52fa04-7fff-4a2e-b83a-e58b7fa156ce",
                                                "sense_id": "40cb0af4-1903-3520-9598-cbe16fce0807",
                                                "text": "If you are a Halo completionist and need to experience every moment of the Halo story, you have no choice."
                                            },
                                            {
                                                "example_id": "2a976fd4-6f80-46e4-8db6-f0351ce203f5",
                                                "sense_id": "40cb0af4-1903-3520-9598-cbe16fce0807",
                                                "text": "I rarely listen to any of them but I'm a completionist and meticulous fanatic (for better or worse), and wouldn't want to miss any component from his recording career."
                                            },
                                            {
                                                "example_id": "a4c9923a-8b87-4c39-8d30-8adfea0437e6",
                                                "sense_id": "40cb0af4-1903-3520-9598-cbe16fce0807",
                                                "text": "To turn the discussion back toward kaiju toys, I argue that, unless I am a completionist with significant cash flow, the toys I seek out will be those from which I will earn the most personal enjoyment."
                                            },
                                            {
                                                "example_id": "d5199ddd-7127-445c-bb5b-80689e565bd1",
                                                "sense_id": "40cb0af4-1903-3520-9598-cbe16fce0807",
                                                "text": "I’ll be honest here: I’ve gone the romantic route in every game only because I wanted the achievement to add to my Xbox Gamerscore. I’m a semi-completionist when it comes to achievements, but once I got the achievement, I haven’t gone the romantic route again for the sake of my conscience.[…]\nTo summarise this topic, if BioWare’s approach to premarital sex really bothers you, don’t go the romantic route. However, if you’re a completionist like I am and want that achievement, by all means, get that achievement and don’t go the romantic route again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
