                "senses": [
                    {
                        "sense_id": "e390dc8c-d4b2-3201-bc00-6cb9f348238b",
                        "entry_id": "4c5ea423-35d4-30c6-9d94-d7b8efe5b413",
                        "glosses": [
                            "Flugzeug, bei dem ein Düsentriebwerk für den Vortrieb sorgt; das über einen Düsenantrieb verfügt"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "a576f549-4fbe-4678-9b58-5159769e1ad5",
                                "sense_id": "e390dc8c-d4b2-3201-bc00-6cb9f348238b",
                                "text": "„Vor 75 Jahren hob das erste Düsenflugzeug ab, Testpilot der waghalsigen Mission war Erich Warsitz.“"
                            },
                            {
                                "example_id": "fe3b9c88-2572-461f-9cbb-7544ea456055",
                                "sense_id": "e390dc8c-d4b2-3201-bc00-6cb9f348238b",
                                "text": "„Die Boeing 737 ist die erfolgreichste Familie von Düsenflugzeugen, die jemals gebaut wurde.“"
                            },
                            {
