                "senses": [
                    {
                        "sense_id": "bd9720a1-f6ba-3390-8e68-3fb1ae4bbabc",
                        "entry_id": "8b59a660-29c8-3132-a005-3ef95a119c98",
                        "glosses": [
                            "Textlinguistik: Intention der Texte, deren Textfunktion hauptsächlich darin besteht, an einen Hörer oder Leser appellieren, etwas zu tun oder zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a949385f-ccc5-4cb4-b20d-e670d2d09f76",
                                "sense_id": "bd9720a1-f6ba-3390-8e68-3fb1ae4bbabc",
                                "text": "Die Appellfunktion ist die dominierende Textfunktion in Textklassen wie (manchen) Kommentaren, Wahlaufrufen oder Werbetexten."
                            },
                            {
                                "example_id": "8bfbac35-7aec-4a72-80f8-3e6cc4458ba1",
                                "sense_id": "bd9720a1-f6ba-3390-8e68-3fb1ae4bbabc",
                                "text": "„Bei Äußerungen in Appellfunktion, wenn das Kind etwas haben wollte und die Eltern nicht gleich darauf reagierten, wurde das Thema nicht selten in der anderen Sprache wiederholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
