{
    "word_family": [
        "animate",
        "animation",
        "animator",
        "inanimate",
        "reanimate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c986ef1-cc9d-3d1c-8966-95a38ef08314",
                    "sense_definition": "Made using drawings, models, or computer graphics that appear to move.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My children love watching <w>animated</w> movies on the weekend.",
                            "target_lang_translations": {
                                "ru": "Мои дети любят смотреть <w>анимационные</w> фильмы по выходным.",
                                "zh": "我的孩子们周末喜欢看<w>动画</w>电影。"
                            }
                        },
                        {
                            "text": "The studio produced a famous <w>animated</w> series about space travel.",
                            "target_lang_translations": {
                                "ru": "Студия выпустила известный <w>анимационный</w> сериал о космических путешествиях.",
                                "zh": "这家工作室制作了一部关于太空旅行的著名<w>动画</w>系列片。"
                            }
                        }
                    ],
                    "antonyms": [
                        "live-action"
                    ],
                    "common_phrases": [
                        "animated film",
                        "animated series",
                        "animated character",
                        "animated gif"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созданный с использованием рисунков, моделей или компьютерной графики, которые кажутся движущимися.",
                        "zh": "指通过绘画、模型或计算机图形制作，看起来会动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анимационный",
                                "target_lang_sense_clarification": "относящийся к анимации, кино"
                            },
                            {
                                "target_lang_word": "мультипликационный",
                                "target_lang_sense_clarification": "относящийся к мультфильмам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动画",
                                "target_lang_sense_clarification": "指动画形式的电影或系列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb7ded3-7add-3380-ad0e-2a0928db905c",
                    "sense_definition": "Full of interest, energy, and excitement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had an <w>animated</w> discussion about the new school policy.",
                            "target_lang_translations": {
                                "ru": "У них была <w>оживлённая</w> дискуссия о новой школьной политике.",
                                "zh": "他们就新的学校政策进行了<w>热烈</w>的讨论。"
                            }
                        },
                        {
                            "text": "Her face became <w>animated</w> when she started talking about her art.",
                            "target_lang_translations": {
                                "ru": "Её лицо стало <w>оживлённым</w>, когда она начала говорить о своём искусстве.",
                                "zh": "当她开始谈论自己的艺术作品时，她的表情变得<w>生动</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dynamic",
                        "active",
                        "peppy"
                    ],
                    "antonyms": [
                        "lethargic",
                        "dull"
                    ],
                    "common_phrases": [
                        "animated discussion",
                        "animated conversation",
                        "animated gesture",
                        "animated face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный интереса, энергии и волнения.",
                        "zh": "充满兴趣、活力和兴奋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлённый",
                                "target_lang_sense_clarification": "полный жизни, энергии и движения"
                            },
                            {
                                "target_lang_word": "воодушевлённый",
                                "target_lang_sense_clarification": "полный энтузиазма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "热烈",
                                "target_lang_sense_clarification": "形容讨论或气氛充满活力"
                            },
                            {
                                "target_lang_word": "生动",
                                "target_lang_sense_clarification": "形容表情或神态充满活力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31a653e6-2c85-3711-bb39-8168dd7120f0",
                    "sense_definition": "Possessing life; living.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist studied the difference between <w>animated</w> and inanimate matter.",
                            "target_lang_translations": {
                                "ru": "Биолог изучал разницу между <w>одушевлённой</w> и неодушевлённой материей.",
                                "zh": "生物学家研究了<w>有生命</w>物质与无生命物质之间的区别。"
                            }
                        },
                        {
                            "text": "Every <w>animated</w> being on earth relies on the sun for energy.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>живое</w> существо на земле зависит от солнечной энергии.",
                                "zh": "地球上每一个<w>活的</w>生物都依赖太阳获取能量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "living",
                        "alive",
                        "animate"
                    ],
                    "antonyms": [
                        "inanimate"
                    ],
                    "common_phrases": [
                        "animated nature",
                        "animated being"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий жизнью; живой.",
                        "zh": "拥有生命；活着的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "биологически живой"
                            },
                            {
                                "target_lang_word": "одушевлённый",
                                "target_lang_sense_clarification": "обладающий душой, противоположность неодушевлённому"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有生命的",
                                "target_lang_sense_clarification": "指生物学上的生命体"
                            },
                            {
                                "target_lang_word": "活的",
                                "target_lang_sense_clarification": "指具有生命特征的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c325ee7-0455-31a3-b01c-bbec0aedaed5",
                    "sense_definition": "Simple past and past participle of <w>animate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>animated</w> the history lesson with exciting stories.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>оживил</w> урок истории захватывающими рассказами.",
                                "zh": "老师用精彩的故事<w>使</w>历史课变得<w>生动</w>起来。"
                            }
                        },
                        {
                            "text": "He <w>animated</w> the digital puppet to make it look like it was walking.",
                            "target_lang_translations": {
                                "ru": "Он <w>анимировал</w> цифровую куклу, чтобы она выглядела идущей.",
                                "zh": "他为数字木偶<w>制作</w>了<w>动画</w>，使其看起来像是在走路。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола animate.",
                        "zh": "animate的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживил",
                                "target_lang_sense_clarification": "сделал более живым или интересным (прош. вр.)"
                            },
                            {
                                "target_lang_word": "анимировал",
                                "target_lang_sense_clarification": "привел в движение, создал анимацию (прош. вр.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……生动",
                                "target_lang_sense_clarification": "使某事变得更有趣或更有活力"
                            },
                            {
                                "target_lang_word": "制作动画",
                                "target_lang_sense_clarification": "通过技术手段使物体产生动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}