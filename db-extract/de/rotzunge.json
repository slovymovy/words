                    {
                        "translation_id": "3ac6c70b-3140-408a-9857-73e7b59d77a0",
                        "source_entry_id": "13eec368-d4f0-3474-b70f-5e42a93e97a7",
                        "source_sense_id": "09e97002-e125-3d70-b18c-3f180fbfcdab",
