                    {
                        "sense_id": "5f2195cb-cf1f-3d75-9253-96ab858550a9",
                        "entry_id": "ee8c267e-2155-3747-a83e-1fd19d7f18ef",
                        "glosses": [
                            "Langue germanique aujourd’hui éteinte, parlée au début de l’ère chrétienne par les Goths et, plus particulièrement, les Wisigoths."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "046231ba-a75e-46ad-8fca-54472e9592a3",
                                "sense_id": "5f2195cb-cf1f-3d75-9253-96ab858550a9",
                                "text": "Le gotique, la plus ancienne des langues germaniques attestées, n’a donné naissance à aucune langue germanique actuelle et a cessé d’être couramment utilisé à partir de la seconde moitié du VIᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0863c16-dd28-4454-81d6-2ffa817bb7ad",
                        "source_entry_id": "ee8c267e-2155-3747-a83e-1fd19d7f18ef",
                        "source_sense_id": "5f2195cb-cf1f-3d75-9253-96ab858550a9",
                        "target_lang_word": "Gotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22df0b98-7d26-3dd1-a68f-9db18691caf1",
                                        "entry_id": "c4b80323-1638-3b26-8c58-8887bd12b5fe",
                                        "glosses": [
                                            "die ostgermanische Sprache der Goten (4. bis 6. Jahrhundert), durch die Wulfilabibel (→Wikipedia) die älteste schriftlich überlieferte germanische Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4483e5f5-4de8-41d2-881e-7360485103c4",
                                                "sense_id": "22df0b98-7d26-3dd1-a68f-9db18691caf1",
                                                "text": "Können Sie Gotisch?"
                                            },
                                            {
                                                "example_id": "232d5b24-f51a-4e39-8e83-c03e682a8fd3",
                                                "sense_id": "22df0b98-7d26-3dd1-a68f-9db18691caf1",
                                                "text": "Wie heißt das auf Gotisch?"
                                            },
                                            {
                                                "example_id": "6e7935b0-4cd4-4534-bd7c-7d96fca82400",
                                                "sense_id": "22df0b98-7d26-3dd1-a68f-9db18691caf1",
                                                "text": "Das Gotische ist mit dem Vandalischen verwandt."
                                            },
                                            {
                                                "example_id": "6ccb6064-9250-42fe-b136-d17f39125049",
                                                "sense_id": "22df0b98-7d26-3dd1-a68f-9db18691caf1",
                                                "text": "„Die Sprachen des ostgermanischen Zweigs, von denen das Gotische durch eine frühe Bibelübersetzung die bekannteste ist, sind untergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59072eb9-43ba-35e7-838e-cd48ba483c51",
                                        "entry_id": "c4b80323-1638-3b26-8c58-8887bd12b5fe",
                                        "glosses": [
                                            "die Schrift, in der die Zeugnisse dieser Sprache niedergelegt wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c4ce2a-25e8-43f9-b1fa-eb85a79896ff",
                                                "sense_id": "59072eb9-43ba-35e7-838e-cd48ba483c51",
                                                "text": "Kennst du einen Font für Gotisch?"
                                            },
                                            {
                                                "example_id": "9c907762-e261-4e1f-882b-4c3b3166a9d8",
                                                "sense_id": "59072eb9-43ba-35e7-838e-cd48ba483c51",
                                                "text": "Das Gotische ist eine Mischung zwischen griechischer und Lateinschrift."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0394d8d3-af51-3697-9835-d2681389a8b9",
                                        "entry_id": "c4b80323-1638-3b26-8c58-8887bd12b5fe",
                                        "glosses": [
                                            "die gebrochene Schrift Textur"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
