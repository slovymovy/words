{
    "word_family": [
        "fusil",
        "fusillade",
        "fusilier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d544e48-8ae7-336c-9455-b0f890b581d3",
                    "sense_definition": "Exécuter une personne avec des armes à feu, généralement par décision de justice militaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la guerre, le tribunal a décidé de <w>fusiller</w> le traître à l'aube."
                        },
                        {
                            "text": "Plusieurs soldats ont refusé d'obéir et risquaient de se faire <w>fusiller</w> sur-le-champ."
                        }
                    ],
                    "synonyms": [
                        "exécuter"
                    ],
                    "common_phrases": [
                        "se faire fusiller",
                        "fusiller un déserteur"
                    ]
                },
                {
                    "sense_id": "39d20b2a-48bd-33a9-934b-126afb298f69",
                    "sense_definition": "Fixer quelqu'un avec un regard perçant, furieux ou réprobateur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entendant cette remarque déplacée, elle a <w>fusillé</w> son collègue du regard."
                        },
                        {
                            "text": "Le professeur <w>fusille</w> des yeux les deux élèves bavards au fond de la classe."
                        }
                    ],
                    "common_phrases": [
                        "fusiller du regard",
                        "fusiller des yeux"
                    ]
                },
                {
                    "sense_id": "4820fc41-ecc0-3b70-adfd-9f0d44a34cca",
                    "sense_definition": "Tuer ou abattre avec une arme à feu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les insurgés ont commencé à <w>fusiller</w> les cibles aperçues derrière les murs."
                        },
                        {
                            "text": "Les chasseurs <w>fusillaient</w> le gibier dès qu'il sortait des hautes herbes."
                        }
                    ],
                    "synonyms": [
                        "abattre"
                    ]
                },
                {
                    "sense_id": "8b8b14c9-9b21-38c0-b01b-d472c42939d5",
                    "sense_definition": "Détruire, abîmer complètement ou mettre hors d'usage un objet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En branchant le mauvais câble, tu as réussi à <w>fusiller</w> le moteur de l'appareil."
                        },
                        {
                            "text": "Cette mauvaise manipulation risque de <w>fusiller</w> tous les composants électroniques."
                        }
                    ],
                    "synonyms": [
                        "bousiller",
                        "abîmer"
                    ],
                    "antonyms": [
                        "réparer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "4ccb02af-b40a-3505-9354-6ab56b85bb44",
                    "sense_definition": "Échanger des tirs d'armes à feu lors d'un affrontement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux régiments se sont <w>fusillés</w> pendant plusieurs heures près de la rivière."
                        },
                        {
                            "text": "Notre bataillon <w>fusilla</w> longtemps contre les lignes adverses avant de se replier."
                        }
                    ]
                },
                {
                    "sense_id": "d498273d-b999-3940-a278-0f37a6af4a78",
                    "sense_definition": "Critiquer très vivement et publiquement quelqu'un par des paroles ou des écrits acérés.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le polémiste aime <w>fusiller</w> ses rivaux dans sa chronique hebdomadaire."
                        },
                        {
                            "text": "Elle n'a pas hésité à <w>fusiller</w> son adversaire de remarques acerbes lors du débat."
                        }
                    ],
                    "synonyms": [
                        "éreinter"
                    ],
                    "antonyms": [
                        "louer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "sens figuré littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "47d69a91-17b7-34de-8b20-73c23090bbf4",
                    "sense_definition": "Photographier quelqu'un ou quelque chose de manière intensive et rapide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "photographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes rassemblés à l'entrée <w>fusillaient</w> les célébrités sur le tapis rouge."
                        },
                        {
                            "text": "Il s'amuse à <w>fusiller</w> chaque recoin du paysage avec son nouvel appareil."
                        }
                    ],
                    "synonyms": [
                        "mitrailler"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "remplacé par mitrailler"
                        }
                    ]
                }
            ]
        }
    ]
