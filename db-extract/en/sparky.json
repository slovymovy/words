                    },
                    {
                        "translation_id": "582831b6-7a00-4523-9f8c-76d964e0552d",
                        "source_entry_id": "2cdcf6be-b293-3c13-972f-0bc98c74a73c",
                        "source_sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                        "source_sense_description": "Lifely, animated",
                        "target_lang_word": "lebhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lebhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d036ef-27c2-3f44-9ac0-12e83c3961c6",
                                        "entry_id": "1690b671-dfc7-3f94-a2bb-a984a103a7c5",
                                        "glosses": [
                                            "sich angeregt zeigend, voller Interesse und mit der Unterstützung von Mimik und Gestik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24217107-5bd2-4047-994f-44637d99d9dc",
                                                "sense_id": "e5d036ef-27c2-3f44-9ac0-12e83c3961c6",
                                                "text": "Meine Freundin hat ein lebhaftes Wesen."
                                            },
                                            {
                                                "example_id": "f13a89b4-6557-485f-b1c1-37c3f0d6e3dd",
                                                "sense_id": "e5d036ef-27c2-3f44-9ac0-12e83c3961c6",
                                                "text": "Wir führten eine lebhafte Debatte."
                                            },
                                            {
                                                "example_id": "1f003ba0-9ae3-4c31-a7b1-81553f3d05c6",
                                                "sense_id": "e5d036ef-27c2-3f44-9ac0-12e83c3961c6",
                                                "text": "„Zunehmende Gebrechen und der Kummer um ihren Sohn hatten Charlene ihres Witzes und ihrer lebhaften Art beraubt, und dieselben zwei Dämonen hatten ihren Vater zu einem verbitterten Mann gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "d4eb83c8-0803-3581-a908-b1a893823db8",
                "word": "Sparky",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0cb8805b-a273-3b4b-876c-1445c9cef77f",
                        "entry_id": "d4eb83c8-0803-3581-a908-b1a893823db8",
                        "glosses": [
                            "A nickname for a person who is lively and animated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30e9b65f-c594-41c9-8234-cbdfa0b041e7",
                                "sense_id": "0cb8805b-a273-3b4b-876c-1445c9cef77f",
                                "text": "You should keep working, driving for whatever goal you have your eye on, while at the same time avoiding a tip over into a workaholic relapse. How?\nBy becoming a manager, Sparky. The purpose of management is to make other people do the things that need doing, so you can think about strategy and leave early."
                            }
                        ]
                    },
                    {
                        "sense_id": "e534e30d-3c78-3fa0-9c04-94a77e97522d",
                        "entry_id": "d4eb83c8-0803-3581-a908-b1a893823db8",
                        "glosses": [
                            "A name for a pet, traditionally especially a dog, with similar connotations."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                "word": "sparky",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b3d7524a-6c34-4fba-ae98-1e03b5a79455",
                        "entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "sparkies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b5c606a-77dc-3aba-9e42-153e90385d7d",
                        "entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                        "glosses": [
                            "A radio operator."
                        ],
                        "tags": [
                            "Navy",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "b4582ca6-6b38-478f-933a-34493b7570eb",
                                "sense_id": "2b5c606a-77dc-3aba-9e42-153e90385d7d",
                                "text": "The headlines ground out big and black at home, but by the time they had gone out on the Fleet broadcast circuits, been picked out of the air by Mr. Woodside′s sparkies in the radio shack, whacked onto a stencil and run through a mimeograph machine by Harry Dolliver, they were not nearly so impressive."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d66bf58-9928-304d-9448-0adaf2e9d309",
                        "entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                        "glosses": [
                            "An electrician."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "98479fc2-4795-4f65-9faa-25c0980246ac",
                                "sense_id": "6d66bf58-9928-304d-9448-0adaf2e9d309",
                                "text": "[…]the manager of one of the largest hotels, also a committee member ‘let it be known that sparkies working for the hotel should be involved in the programme. The next day saw three very keen contractors ring us up to enrol.’"
                            },
                            {
                                "example_id": "23774c11-97cf-4cb1-bb7f-714dce2d51da",
                                "sense_id": "6d66bf58-9928-304d-9448-0adaf2e9d309",
                                "text": "Pete said that the sparkies, the electricians, had turned the power off."
                            },
                            {
                                "example_id": "920bb1d3-c3b1-42fb-9829-60d62fa742a2",
                                "sense_id": "6d66bf58-9928-304d-9448-0adaf2e9d309",
                                "text": "Sam and Jamie set up the barbecue and tables they′d borrowed from the surf club, Tony organised all the tradesmen, the chippies quickly put the first platform in place so Fizz could set up her sound system while the sparkies rigged up sound and lights, and the plumbers were happy to act as security."
                            },
                            {
                                "example_id": "f4fe9baf-7cba-4afb-9de4-9c724472ed1e",
                                "sense_id": "6d66bf58-9928-304d-9448-0adaf2e9d309",
                                "text": "2010, Meegan Jones, Sustainable Event Management: A Practical Guide, Earthscan, UK and US, page 86,\nYou need to educate yourself so you can talk turkey with the sparkies. You don′t need an electrician′s qualification, but if you can demonstrate a basic understanding of the principles behind supplying power to your event, you can have a decent conversation about options and solutions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1710bbc-dd1c-47c1-9dc8-99f65d548d84",
                        "source_entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                        "source_sense_description": "Radio operator",
                        "target_lang_word": "Funker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Funker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f47646-6252-3a65-bfc2-65d8698d2626",
                                        "entry_id": "ed00ec3f-baca-3f7c-9ab5-cb355d041be2",
                                        "glosses": [
                                            "Berufsbezeichnung für eine Person, die eine Ausbildung zum Betrieb einer Funkstation absolviert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d281f9a8-c964-45c9-ab76-1b08f9a549ea",
                                                "sense_id": "d6f47646-6252-3a65-bfc2-65d8698d2626",
                                                "text": "„Bei der Indienststellung 1948 standen im Seetörn für die durchgehende Besetzung der Funkstation drei Funker zur Verfügung, die sich nach einer Wache von vier Stunden Dauer nach Dienstplan ablösten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2c4243b-38e4-3d23-8895-5ccb5f8c7397",
                                        "entry_id": "ed00ec3f-baca-3f7c-9ab5-cb355d041be2",
                                        "glosses": [
                                            "Soldat des niedrigsten Dienstranges in der Fernmeldetruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2304ed-5e57-45d6-a21b-ed077ec9c497",
                                                "sense_id": "b2c4243b-38e4-3d23-8895-5ccb5f8c7397",
                                                "text": "„Inzwischen ist Besuch gekommen, zwei Funker, die freigebig zum Essen eingeladen werden.“"
                                            },
                                            {
                                                "example_id": "a99431c3-b98a-4e4f-b6b6-fec04b09a027",
                                                "sense_id": "b2c4243b-38e4-3d23-8895-5ccb5f8c7397",
                                                "text": "„Die Funker erzählten uns, dass dieses Lied sogar in englischer und französischer Sprache durch den Äther schwirrte, sich also internationaler Beliebtheit zu erfreuen schien.“"
                                            },
                                            {
                                                "example_id": "ba1dca01-6fb5-43e5-a9d6-7690389aa442",
                                                "sense_id": "b2c4243b-38e4-3d23-8895-5ccb5f8c7397",
                                                "text": "„Die Mannschaftsräume waren klein und bis zur Unerträglichkeit überfüllt, alles war da zusammengewürfelt: Matrosen, Heizer, Signalgasten und Funker.“"
                                            },
                                            {
                                                "example_id": "d30824cc-e4c0-471c-a328-0dec73a189cd",
                                                "sense_id": "b2c4243b-38e4-3d23-8895-5ccb5f8c7397",
                                                "text": "„Der Pilot schaltete die Kurssteuerung ein, der Funker kam aus seinem Kabäuschen, und die anderen versammelten sich ebenfalls alle um den Kaffee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e2b32d5-5fe2-4be6-a231-a5d23adfd942",
                        "source_entry_id": "8ed9eb9d-a7ec-3c26-ad4c-6803d52fc7d0",
                        "source_sense_description": "Electrician",
