    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9135ca01-ba06-35fd-8327-7ea2e635c2a3",
                    "sense_definition": "al geruime tijd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voelde je niet goed, dat wist ik toch <w>allang</w>.",
                            "target_lang_translations": {
                                "en": "You weren't feeling well, I knew that <w>for a long time</w> already."
                            }
                        },
                        {
                            "text": "Zij is <w>allang</w> klaar met haar huiswerk.",
                            "target_lang_translations": {
                                "en": "She finished her homework <w>a long time ago</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sinds",
                        "lang"
                    ],
                    "common_phrases": [
                        "dat wist ik allang"
                    ],
                    "target_lang_definitions": {
                        "en": "for a considerable amount of time already"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for a long time",
                                "target_lang_sense_clarification": "referring to a duration that has already passed"
                            },
                            {
                                "target_lang_word": "already",
                                "target_lang_sense_clarification": "emphasizing that something happened before the expected time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40d58784-bcbb-3c75-883f-f93f5c32fbbc",
                    "sense_definition": "tevreden met de huidige situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tevredenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was <w>allang</w> blij dat het feest voorbij was.",
                            "target_lang_translations": {
                                "en": "I was <w>more than</w> happy that the party was over."
                            }
                        },
                        {
                            "text": "Hij was <w>allang</w> tevreden met een kleine winst.",
                            "target_lang_translations": {
                                "en": "He was <w>perfectly</w> satisfied with a small profit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "allang blij"
                    ],
                    "target_lang_definitions": {
                        "en": "satisfied or content with the current situation, often implying relief"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more than",
                                "target_lang_sense_clarification": "used to express that one is sufficiently satisfied"
                            },
                            {
                                "target_lang_word": "perfectly",
                                "target_lang_sense_clarification": "used to emphasize being content or happy with a situation"
                            }
                        ]
                    }
                }
            ]
        }
