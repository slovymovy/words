                                        "glosses": [
                                            "That cries."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce490e4-3335-48b6-9883-4286111d14ab",
                                                "sense_id": "d0d50e97-09aa-3173-8249-818946f998d2",
                                                "text": "The crying child on the street was evidently lost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83885b04-70a8-3f85-8e71-1dc7505dd902",
                                        "entry_id": "4851c2a6-70a9-3705-9a2b-7cb2d184f4fd",
                                        "glosses": [
                                            "That demands action or attention; desperate."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1b4eef7-06f4-4c73-a4f8-19e3b605e3f1",
                                                "sense_id": "83885b04-70a8-3f85-8e71-1dc7505dd902",
                                                "text": "There is a crying need for more manual workers in this country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5b228e-cef2-3069-a674-a1d7700379d0",
                                        "entry_id": "4851c2a6-70a9-3705-9a2b-7cb2d184f4fd",
                                        "glosses": [
                                            "That deserves rebuke or censure; deplorable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b59624-9e10-4e67-b33b-38df33c24bcc",
                                                "sense_id": "3d5b228e-cef2-3069-a674-a1d7700379d0",
                                                "text": "It is a crying shame that he managed to get away with that!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crying",
                                "target_lang_code": "en",
