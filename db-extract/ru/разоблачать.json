                                        "entry_id": "13606e5e-1fc0-3cb7-8c0d-8da7f3dc12b1",
                                        "glosses": [
                                            "A revelation; an uncovering of what was hidden in the scene or story."
                                        ],
                                        "tags": [
                                            "informal",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8684ab57-908e-4057-bac9-d33d57304d28",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "The comedian had been telling us about his sleep being disturbed by noise. Then came the reveal: he was sleeping on a bed in a department store."
                                            },
                                            {
                                                "example_id": "e61aa7dc-00c4-410b-b3f9-991eef73aa17",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "A simple dolly or crane move can be used for an effective reveal. A subject fills the frame, then with a move, something else is revealed."
                                            },
                                            {
                                                "example_id": "50426bb6-a3a2-4ede-84ef-f31561c0240e",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "Once you find out what’s going on—the girl is a “hungry,” this film’s term for zombies—it’s still interesting enough, if not quite as powerful. That’s basically what you’re in for with this British postapocalyptic survival horror tale, which starts off strong but dilutes its impact with every consecutive reveal."
                                            },
                                            {
                                                "example_id": "73989ae8-6a43-499d-87a8-a714aa1a1722",
                                                "sense_id": "0c5d685d-2f36-334d-af9a-7272855d62a3",
                                                "text": "Even Westworld—based on a science-fiction novel where robots run amok—ended its second season with the ultimate reveal: human beings are simpler and more predictable than the artificial intelligences we create."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reveal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                        "entry_id": "cf173fb1-4152-39fc-a489-070f76afd27c",
                                        "glosses": [
                                            "To uncover; to show and display that which was hidden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b14ba4d-2c40-4bbd-9cd5-1f536178f67f",
                                                "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                                "text": "c. 1625, Edmund Waller, Of the Danger His Majesty (being Prince) Escaped in the Road at St Andero\nLight was the wound, the prince's care unknown, / She might not, would not, yet reveal her own."
                                            },
                                            {
                                                "example_id": "6f6bd1cd-1c0e-4573-98c3-c49de08b722b",
                                                "sense_id": "28af3f68-070d-319d-b59c-5b2b21307118",
                                                "text": "The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ad2427-707b-35bc-8253-91128cfb2a6d",
                                        "entry_id": "cf173fb1-4152-39fc-a489-070f76afd27c",
                                        "glosses": [
                                            "To communicate that which could not be known or discovered without divine or supernatural instruction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d177061-a12b-4194-b74e-cc6d1f72400b",
                        "source_entry_id": "38900556-e9d3-354b-a2cf-9721d78b3d88",
                        "target_lang_word": "find out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "find out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover, as by asking or investigating."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d41972-c2be-429a-8700-fb5fbc415413",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I don't know who the twenty-first president of the United States was, but it should be very easy to find out."
                                            },
                                            {
                                                "example_id": "17479836-6c47-456a-882d-d626c2402730",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "\"Why shouldn't somethin' new and wonderful lie in such a country? And why shouldn't we be the men to find it out?\""
                                            },
                                            {
                                                "example_id": "2698d7f2-9c46-4811-99a8-452e180fa116",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "Somethin' happens when everybody finds out\nSee the vultures circling, dark clouds"
                                            },
                                            {
                                                "example_id": "b5779327-7631-4b2d-8526-b5842c554fbe",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover or expose (someone) as disobedient, dishonest, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168f191d-6882-4262-a319-40a2b21fd1cf",
                                                "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                                "text": "He had been fiddling the books for years, but finally he was found out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To uncover a weakness in (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7a0f06-075b-446e-90ad-f31d91d112dd",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "He may cope with the multiple choice questions, but the written exam will find him out."
                                            },
                                            {
                                                "example_id": "7f7cf588-e8e4-4a32-8946-dad5dd8b0b78",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "If you don't try, you do not find it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810bfa98-4168-3a61-9601-b446cfb557a3",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover (something), as by perceiving or coming upon it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To receive the consequences of one's actions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf557d0e-8915-420a-a72e-49f603f56375",
                                                "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                                "text": "With the way he behaved, it's no wonder he found out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
