                "senses": [
                    {
                        "sense_id": "2083df22-0aa2-36ab-9bc8-3bc0015201a1",
                        "entry_id": "a2f6f929-45a6-340d-b28f-6b6385b74c83",
                        "glosses": [
                            "Dreary."
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "02b27a51-bb7c-48fc-be8b-a571be08a973",
                                "sense_id": "2083df22-0aa2-36ab-9bc8-3bc0015201a1",
                                "text": "Earth raised up her head\nFrom the darkness dread and drear,"
                            },
                            {
                                "example_id": "207682ae-35b4-46d0-b2dd-75939a603f11",
                                "sense_id": "2083df22-0aa2-36ab-9bc8-3bc0015201a1",
                                "text": "I spoke, perplexed by something in the signs\nOf desolation I had seen and heard\nIn this drear pilgrimage to ruined shrines:"
                            },
                            {
                                "example_id": "db439793-4b49-4c37-9ae2-a4b6d5bcf3e2",
                                "sense_id": "2083df22-0aa2-36ab-9bc8-3bc0015201a1",
                                "text": "And over all, the dead silence of the dead, the sense of utter loneliness, and the brooding spirit of the Past! How beautiful it was, and yet how drear! We did not dare to speak aloud."
                            },
                            {
                                "example_id": "c62a3974-0c53-408e-8d56-cb0165cbe952",
                                "sense_id": "2083df22-0aa2-36ab-9bc8-3bc0015201a1",
                                "text": "Now dreary dawns the eastern light,\nAnd fall of eve is drear, [...]"
                            }
                        ]
                    }
                ],
