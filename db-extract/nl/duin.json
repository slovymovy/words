                "senses": [
                    {
                        "sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                        "entry_id": "4915dafc-7085-3972-bfd1-4c45f71e0daf",
                        "glosses": [
                            "Hügel aus zusammengewehtem Sand (an Küsten und in Trockengebieten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc31aaec-99a1-459a-a077-af9f5e0c5fab",
                                "sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                                "text": "“De duinen waren heel afwisselend. Kleine korte duinen volgden op grote, lange, steile duinen die eigenlijk meer weg hadden van bergen.”",
                                "translation": "„Die Dünen waren ganz abwechslungsreich. Kleine kurze Dünen folgten großen, langen, steilen Dünen, die eigentlich eher wie Berge aussahen.“"
                            },
                            {
                                "example_id": "13a7d9f1-919f-4fbc-9d9a-9fd3a937231d",
                                "sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                                "text": "“Toen ik het duin op liep maakten mijn voeten gaten in het mulle zand die zich onmiddellijk weer opvulden, ik had zijn lichtheid en zijn snelheid niet.”",
                                "translation": "„Als ich die Düne hochkletterte, hinterließen meine Füße Löcher im weichen Sand, die sich sofort wieder füllten – ich war weder so leicht noch so schnell wie er.“"
                            },
                            {
                                "example_id": "d5b0c7db-17fa-4355-9b88-ff058e070c91",
                                "sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                                "text": "“De explosieven werden gevonden tijdens opsporingsonderzoeken voorafgaand aan de renovatie van een fietspad dat door de duinen loopt.”",
                                "translation": "„Die Sprengkörper wurden während Bodenuntersuchungen gefunden, die der anstehenden Sanierung eines durch die Dünen führenden Radwegs vorausgingen.“"
                            },
                            {
                                "example_id": "307fe4f9-c786-447f-9b22-cc54aa3cf56a",
                                "sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                                "text": "“Voor veel Surinamers is een vakantie op Aruba meer dan de moeite waard. De vele cactussen en andere planten die goed in de hitte kunnen gedijen, samen met de woeste zee, duinen en metershoge bergen, zijn ultieme inspiratiebronnen.”",
                                "translation": "„Für viele Surinamer ist ein Urlaub auf Aruba allemal wert. Die vielen Kakteen und anderen Pflanzen, die gut in der Hitze gedeihen können, sowie das tobende Meer, die Dünen und die meterhohen Berge sind ultimative Inspirationsquellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90a20b05-7ee9-41c3-876d-c53a300acf7f",
                        "source_entry_id": "4915dafc-7085-3972-bfd1-4c45f71e0daf",
                        "source_sense_id": "2f02ec63-165b-3f47-a007-0f1245371ab8",
                        "source_sense_description": "Hügel aus zusammengewehtem Sand (an Küsten und in Trockengebieten)",
                        "target_lang_word": "Düne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Düne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                        "entry_id": "05b29db7-4b8a-32f4-8c69-2b89fb016d21",
                                        "glosses": [
                                            "Hügel aus zusammengewehtem Sand (an Küsten und in Trockengebieten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec88a543-888f-45c1-bb4b-985089aeae1d",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„In den Dünen iſt es immer am ſchönſten.“"
                                            },
                                            {
                                                "example_id": "b95e95f5-d9f1-4573-8a75-d3d59601f615",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„Auf der Suche nach O’Neills Haus war sie in die Dünen gegangen und hatte den Weg verloren.“"
                                            },
                                            {
                                                "example_id": "3f51ce50-3687-4da2-b2b2-bf290dc7b91e",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„Die Sonne die roten, gelben und grünen Farben der Wüste ausgeblichen; die schwarzen Stämme schmolzen in der erhitzten Luft und ließen die Bäume, meterhohe Riesen, wie hingeducktes Gestrüpp aussehen, die scharf umrissenen Konturen der Dünen lösten sich auf, der Sand lief ineinander, und bei der kleinsten Brise verzerrte sich das Antlitz der Kalahari, als tobe in der Ferne ein Sturm.“"
                                            },
                                            {
                                                "example_id": "a1e8ceb5-bcd2-4d06-bf99-835e080d0915",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„Und fünf Minuten vor Silvester, ich weiß das noch, als wär es gestern, da haben wir uns ganz schön lange angeschaut, und dann lagen wir in den Dünen mit ’ner Gänsehaut.“"
                                            },
                                            {
                                                "example_id": "0ef559fc-2cf3-4b3b-878c-a35a11fcc831",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„Zu Mittag nahmen wir in den Dünen über der Bucht ein paar Bissen zu uns.“"
                                            },
                                            {
                                                "example_id": "f13bf3b5-f259-4cce-aaa2-519a478e31ad",
                                                "sense_id": "829291cb-8d01-37b5-aaba-4dbb58eda5d9",
                                                "text": "„Er blickt hinüber zu den Nudisten, die in den Dünen am Rand des Kiefernwaldes liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Düne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88e6ae23-b5d1-3e59-8163-f9fee98f3e51",
