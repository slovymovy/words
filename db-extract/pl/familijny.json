                                                "example_id": "25a6ceae-93d2-47a1-a9a5-82639a68a102",
                                                "sense_id": "6b4e28b7-a70a-3a8e-bf5c-e512e12d96d9",
                                                "text": "„Die Atmosphäre ist familiär, Hierarchien gibt es nicht, selbst die Dozenten werden mit Vornamen angeredet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
