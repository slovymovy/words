                "senses": [
                    {
                        "sense_id": "bec6ff17-0fdd-3421-9403-a5b7833bd81a",
                        "entry_id": "88bc6b84-e7cf-3235-87eb-03b25cad9201",
                        "glosses": [
                            "(für die Herstellung von Tabak[waren] geerntetes, getrocknetes) Blatt der Tabakpflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b427f770-4f56-4f36-8151-e0731f631b95",
                                "sense_id": "bec6ff17-0fdd-3421-9403-a5b7833bd81a",
                                "text": "«Die erste Lieferung zerriebener Tabakblätter ins schwedische Königreich datiert von 1637. An zentraleuropäischen Höfen bereits populär, eroberte das Produkt bald auch die schwedische Aristokratie.»"
                            },
                            {
                                "example_id": "69637b4c-499d-4730-b83f-e498f1612292",
                                "sense_id": "bec6ff17-0fdd-3421-9403-a5b7833bd81a",
                                "text": "„Vorsichtig schmuggelten sie ein ganzes Bündel Tabakblätter ins Granithaus und versteckten es vor Pencroff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
