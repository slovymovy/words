                                        "entry_id": "132e3f51-2cc0-3fff-9b8b-bd6a38ccd57a",
                                        "glosses": [
                                            "Profilé en bois ou métallique, doté de nervures, constituant un élément de rideau ou de caisson et utilisé, une fois planté dans le sol, comme mur de soutènement ou écran imperméable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19625e31-8069-4a3d-b3ce-3884438e9488",
                                                "sense_id": "454df9e3-ee3f-377b-8c8a-66e606ba7ea5",
                                                "text": "Initialement en bois, puis en béton, aujourd’hui la palplanche est un élément en métal destiné à être battu dans le sol pour créer des murs de soutènements, un batardeau, une cloison étanche, une berge."
                                            },
                                            {
                                                "example_id": "50cefe57-d87f-4b51-bc6b-8f2bc687f297",
                                                "sense_id": "454df9e3-ee3f-377b-8c8a-66e606ba7ea5",
                                                "text": "Les berges sont fixées, protégées contre les sapements du courant par de gros blocs de pierre déposés le long des talus et les immanquables palplanches métalliques peu propices au développement d’une végétation aquatique."
                                            },
                                            {
                                                "example_id": "fd84a8ed-c619-4a7f-9cfb-c80a15b7c275",
                                                "sense_id": "454df9e3-ee3f-377b-8c8a-66e606ba7ea5",
                                                "text": "\"Nous avons débâtardé trois palplanches qui étaient en place depuis deux mois\", explique Daniel Spada, responsable de chantier chez Le Du Industrie."
                                            }
                                        ]
                                    }
