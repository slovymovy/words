                ],
                "translations": [
                    {
                        "translation_id": "72ffbdb0-0f35-4d00-80cb-b5ccc38f56a7",
                        "source_entry_id": "36e84acb-4cc3-3354-bee6-c197b3b58090",
                        "source_sense_id": "254a6b90-4a64-3717-9750-77f5c6e2e9fd",
                        "target_lang_word": "foolishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foolishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "In a foolish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54204a58-e657-437f-9889-75f85fe2fd74",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "He dressed foolishly to entertain the children."
                                            },
                                            {
                                                "example_id": "318ddac9-000a-4de7-8850-186e20c70e58",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "I never wish to offend, but I am so foolishly shy, that I often seem negligent, when I am only kept back by my natural aukwardness."
                                            },
                                            {
                                                "example_id": "21e51553-8547-4cc9-bf5f-47640497c46d",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "“Nothing to speak of,” said Adam Woodcock, answering for the boy—“a foolish quarrel with me, which was more foolishly told over again to my honoured lady, cost the poor boy his place.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "Without good judgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6ae2c0-6925-42e3-9b61-966c672840b3",
                                                "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                                "text": "Foolishly, he had decided that, because a home was the best investment, two homes were even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
