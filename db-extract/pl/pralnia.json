                                        "entry_id": "cf94aed3-6cee-3337-b9cb-319573a968d9",
                                        "glosses": [
                                            "Betrieb oder Abteilung innerhalb eines Betriebs, in dem Textilien gewaschen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa81d78-a289-4ac7-b945-64d0b5c8e870",
                                                "sense_id": "8a783b8c-ab6e-342f-b8e0-5d1955757ea9",
                                                "text": "Das Hotel betreibt eine eigene Wäscherei, die sich im Kellergeschoss befindet."
                                            },
                                            {
                                                "example_id": "594e4e37-e455-4ce2-8fa0-561601f62a39",
                                                "sense_id": "8a783b8c-ab6e-342f-b8e0-5d1955757ea9",
                                                "text": "„Am schönsten aber war es für mich immer, wenn wir zur Wäscherei in unserer Straße gingen, die einen großen Lieferwagen besaß.“"
                                            },
                                            {
                                                "example_id": "c804c4c9-633b-4ef1-b36a-ea37fae5d77f",
                                                "sense_id": "8a783b8c-ab6e-342f-b8e0-5d1955757ea9",
                                                "text": "„In der Wäscherei beschmutzten sie die von Henni gewaschene Wäsche, und in der Nähstube sabotierten sie ihre Nähmaschine, sodass Henni das Tagessoll nicht erreichte.“"
                                            },
                                            {
                                                "example_id": "c722122e-5a16-46fc-97fe-69aaf69ed101",
                                                "sense_id": "8a783b8c-ab6e-342f-b8e0-5d1955757ea9",
                                                "text": "„Seine Wäsche gibt Papa Mostmann in die Wäscherei.“"
                                            },
                                            {
                                                "example_id": "e76937fc-523d-4bab-b2e0-6107cf6c9af6",
                                                "sense_id": "8a783b8c-ab6e-342f-b8e0-5d1955757ea9",
                                                "text": "„Der Supermarkt ist ein Zentrum der vierhundert Inseln, ein Flachbau aus Wellblech und festzementierten Platten, mit Parkplätzen, Wäscherei und verstreuten Containern, das umgebende Gelände ist steinig und weit, zwei ramponierte Kiefern, ein halber Zaun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
