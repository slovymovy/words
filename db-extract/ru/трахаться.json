                ],
                "senses": [
                    {
                        "sense_id": "5b5e15f1-d63f-3381-a705-846d34c29331",
                        "entry_id": "1b841814-b3f3-357f-843f-baee208a42bb",
                        "glosses": [
                            "вульг. совершать половой акт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deeda8c9-392b-4f02-bb0a-4dea21736fb5",
                                "sense_id": "5b5e15f1-d63f-3381-a705-846d34c29331",
                                "text": "Ну не хотел он сегодня трахаться. Ни с этой бабой, ни с какой иной."
                            },
                            {
                                "example_id": "8a35f325-8dd4-4ecc-a709-2679ee3378aa",
                                "sense_id": "5b5e15f1-d63f-3381-a705-846d34c29331",
                                "text": "Наверное, ты ей симпатичен, с тобой неплохо трахаться, тусоваться, бухать и двигаться, но ты не герой её романа."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e95b748-218c-3fae-8755-00f5c5e67016",
                        "entry_id": "1b841814-b3f3-357f-843f-baee208a42bb",
                        "glosses": [
                            "жарг. выполнять нудную, неприятную работу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a46c496-6ec9-406d-8db0-4e156d15d642",
                                "sense_id": "7e95b748-218c-3fae-8755-00f5c5e67016",
                                "text": "Но я этого не знал и трахался с этим модемом до глубокой ночи."
                            }
                        ]
                    },
                    {
                        "sense_id": "05cb863a-3d65-31e3-8c2d-6c306c4afbae",
                        "entry_id": "1b841814-b3f3-357f-843f-baee208a42bb",
                        "glosses": [
                            "устар. издавать громкий звук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7df21e6-305b-42be-88a1-b6226c4e0716",
                                "sense_id": "05cb863a-3d65-31e3-8c2d-6c306c4afbae",
                                "text": "А раздался такой неистовый бой и такой стук: что-то трахалось и кувыркалось тут вот где-то — по всей комнате."
                            }
                        ]
                    }
                ],
