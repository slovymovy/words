                "senses": [
                    {
                        "sense_id": "994d5ce2-610c-3d34-9410-5c2b77363b64",
                        "entry_id": "374b8133-34b9-3ccd-a5cf-eb717a735d20",
                        "glosses": [
                            "разг. кривляться, ломаться, вести себя шутом, паяцем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8958306-221b-4b92-8ca6-1991cc4f3383",
                                "sense_id": "994d5ce2-610c-3d34-9410-5c2b77363b64",
                                "text": "Разыгрывал шутов, зубоскалов, паясничал, развращал умы, а ведь какой художник был, какой талант!"
                            },
                            {
                                "example_id": "a4784bda-6ac4-41a3-9702-9424ecc093e4",
                                "sense_id": "994d5ce2-610c-3d34-9410-5c2b77363b64",
                                "text": "Пристало ли тебе эк ломаться-то, да паясничать, женин ты муж?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee61ca37-5628-45ae-9157-cd5e5a752720",
                        "source_entry_id": "374b8133-34b9-3ccd-a5cf-eb717a735d20",
                        "source_sense_id": "994d5ce2-610c-3d34-9410-5c2b77363b64",
                        "target_lang_word": "play the fool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "play the fool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b25b76e5-bf1b-34fc-ae74-f9974f9e6a70",
                                        "entry_id": "9a2fc365-a1c4-349a-9ef3-15ca11018e34",
                                        "glosses": [
                                            "To behave in a foolish or comical manner."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc064f46-dc99-4ad6-8d30-05c1bc863d92",
                                                "sense_id": "b25b76e5-bf1b-34fc-ae74-f9974f9e6a70",
                                                "text": "Back in school again, Maxwell plays the fool again\nTeacher gets annoyed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764db134-4974-3740-983b-b35decdcddd7",
                                        "entry_id": "9a2fc365-a1c4-349a-9ef3-15ca11018e34",
                                        "glosses": [
                                            "To pretend or feign ignorance."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5228f94a-d669-4249-a679-3adadfb5454b",
                                                "sense_id": "764db134-4974-3740-983b-b35decdcddd7",
                                                "text": "I play the fool when we're together\nBut I cry when we're apart, yeah\nI couldn't do you no better\nDon't break what's left of my broken heart, baby"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
