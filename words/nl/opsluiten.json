                },
                {
                    "sense_id": "7cfc56ed-6350-30c9-b56c-edbafa98b6d7",
                    "sense_definition": "iemand als straf in een gevangenis of instelling plaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gevangen zetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief werd voor drie jaar <w>opgesloten</w> in de gevangenis.",
                            "target_lang_translations": {
                                "en": "The thief was <w>locked up</w> in prison for three years.",
                                "ru": "Вора <w>посадили</w> в тюрьму на три года."
                            }
                        },
                        {
                            "text": "Ik was al eens zes maanden <w>opgesloten</w> omdat ik de wet had overtreden.",
                            "target_lang_translations": {
                                "en": "I had already been <w>imprisoned</w> for six months because I had broken the law.",
                                "ru": "Я уже был <w>заключён</w> под стражу на шесть месяцев за нарушение закона."
                            }
                        }
