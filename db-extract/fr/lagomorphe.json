                "senses": [
                    {
                        "sense_id": "8ab0d927-7240-3ce9-b0b9-bf94057699c5",
                        "entry_id": "74233a1c-7dd2-37d4-b827-d1de345e028f",
                        "glosses": [
                            "Animal appartenant à l'ordre des Lagomorphes, qui comprend des mammifères comme le lièvre et le lapin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6191713-fe4a-42f2-a66f-c935f749c9f9",
                                "sense_id": "8ab0d927-7240-3ce9-b0b9-bf94057699c5",
                                "text": "– Enfin un pays qui accorde au lapin la place qui lui est due !\nTandis qu’elle photographie des dizaines de statues de lagomorphes, je me laisse envelopper par des rouleaux de nostalgie."
                            },
                            {
                                "example_id": "92b87bd2-67ef-497f-ad2b-9389ac342f19",
                                "sense_id": "8ab0d927-7240-3ce9-b0b9-bf94057699c5",
                                "text": "Un lagomorphe est un des nombreux mammifères rongeurs de l’ordre des lagomorphes qui comprend entre autres les lapins, les lièvres et les pikas."
                            },
                            {
                                "example_id": "e16b6e9b-0a00-47fc-b1ad-b7575ec36122",
                                "sense_id": "8ab0d927-7240-3ce9-b0b9-bf94057699c5",
                                "text": "L'abondance des lagomorphes nous fait envisager une opération de destruction massive dans cette plaine cultivée."
                            }
                        ]
                    }
                ],
