                ],
                "senses": [
                    {
                        "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                        "entry_id": "e36c23fe-2955-3c80-ad66-0492c16842b8",
                        "glosses": [
                            "Treiben eines Tanzknopfs, der sich auf seiner Spitze im Kreise dreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1813da-1527-4178-9c6a-43ba57b514cb",
                                "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                                "text": "„Während die Mehrzahl der einschlägigen Werke das Kreiselspiel als Kinderspiel bezeichnet, muß man jedoch wissen, dass sich vielerorts magische Vorstellungen mit dem Kreisel verbanden.“"
                            },
                            {
                                "example_id": "9d8694f1-29e9-49f1-81be-72225f89a1d0",
                                "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                                "text": "„Der sakrale Charakter, etwa von Ballspielen oder Hüpfspielen bzw. die kultische Wurzel von Murmel- oder Kreiselspielen sind heute oft kaum mehr zu erkennen.“"
                            },
                            {
                                "example_id": "1539155a-f286-443a-a350-575462a0d4c8",
                                "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                                "text": "„Drei Männer debattieren in einer Berghütte über die Weltrevolution, eine Frau hockt sich indessen zu den Kindern, um ihnen ein Kreiselspiel zu zeigen.“"
                            },
                            {
                                "example_id": "2a6646d0-034f-4140-85b2-f6632847d944",
                                "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                                "text": "„Zu den Spielen, die Gutsmuths weiland zur Übung und Erholung des Körpers und Geistes, für die Jugend, ihre Erzieher und alle Freunde unschuldiger Jugendfreuden vorschlug, gehören nicht nur Schlittschuhlauf, Eishockey, Eisschießen oder Curling, sondern auch Fangspiele, Jagdspiele, Kreiselspiele, Eiskarussell.“"
                            },
                            {
                                "example_id": "d7e289a8-2589-4ab0-86f7-8152efd45502",
                                "sense_id": "7118ce30-de51-3c63-9e3e-691ab83cfa72",
                                "text": "„So wie viele andere Jungen und Mädchen hat die Jüdin in ihrer Kindheit das Kreiselspiel Trend l gespielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
