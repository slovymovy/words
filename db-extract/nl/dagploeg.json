                        "entry_id": "3f30547c-09e9-31bb-aebb-d8928f16964b",
                        "glosses": [
                            "groep mensen die overdag werkt, groep mensen die tijdens de kantooruren werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b21919b-578f-4ecd-831c-deafc8453c99",
                                "sense_id": "3b1607d9-2a57-3cb5-8c39-e54328bb2a59",
                                "text": "De vakbond wil dat de werknemers worden gecompenseerd. Maandagochtend wordt de staking overgenomen door de dagploeg. De werknemers gaan dan in een stille tocht naar het hoofdkantoor van Smiths, elders in Utrecht."
                            },
                            {
                                "example_id": "cc02a3d1-4ac0-4acf-8e91-379b4293f2a6",
                                "sense_id": "3b1607d9-2a57-3cb5-8c39-e54328bb2a59",
                                "text": "Werknemers van containeroverslagbedrijf ECT in Rotterdam hebben vanochtend vroeg het werk neergelegd. De nachtploeg is gestopt met werken en de dagploeg is niet begonnen."
                            }
                        ]
                    }
