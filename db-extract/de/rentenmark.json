                                "target_senses": [
                                    {
                                        "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                                        "entry_id": "9a66a3b5-300d-3589-a2f3-75e0be6f2ec0",
                                        "glosses": [
                                            "Monnaie allemande qui a eu cours officiel en 1925 et 1924, et jusque 1939 dans la pratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b38a40-1cb3-4c2f-a39a-947d24e90a62",
                                                "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                                                "text": "Le capital et les réserves de la nouvelle banque d’émission sont fixés (art.2), à 3.200 millions de rentenmarks ; le montant en sera fourni par une contribution établie sur l'agriculture d'une part, et d'autre part sur l'industrie, le commerce et les banques."
                                            },
                                            {
                                                "example_id": "48e090a6-ea33-418b-91da-9de4187d0bd2",
                                                "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                                                "text": "On évaluait le montant du vol à quatre millions de rentenmarks, soit environ seize millions de francs."
                                            }
                                        ]
                                    }
                                ]
                            }
