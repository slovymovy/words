                                "target_lang_sense_clarification": "изменяю направление или вращаю"
                            },
                            {
                                "target_lang_word": "разворачиваю",
                                "target_lang_sense_clarification": "меняю направление на противоположное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51eadc38-2e46-3af0-a3b5-8480ca334f0d",
                    "sense_definition": "De gebiedende wijs van <w>keren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Keer</w> de pannenkoek voorzichtig om in de pan.",
                            "target_lang_translations": {
                                "en": "<w>Flip</w> the pancake carefully in the pan.",
                                "ru": "Осторожно <w>переверни</w> блин на сковороде."
                            }
                        },
                        {
                            "text": "<w>Keer</w> terug naar de basis voor verdere instructies.",
                            "target_lang_translations": {
                                "en": "<w>Return</w> to the base for further instructions.",
                                "ru": "<w>Вернись</w> на базу за дальнейшими инструкциями."
                            }
