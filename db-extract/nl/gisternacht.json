                                        "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                        "entry_id": "fbcb5805-38c4-35b9-b4f2-037f4c702632",
                                        "glosses": [
                                            "Last night."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f0916c-598a-42c8-877e-9d6c45afabd0",
                                                "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                                "text": "What man was he talk'd with you yesternight\n Out at your window betwixt twelve and one?"
                                            },
                                            {
                                                "example_id": "75a5c031-7e63-4a55-af6e-ed18072c33f4",
                                                "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                                "text": "It is in the power of my hand to do you hurt: but the God of your father spake unto me yesternight, saying, Take thou heed that thou speak not to Jacob either good or bad."
                                            },
                                            {
                                                "example_id": "65bdfea0-ae6c-45ca-a072-d20003ef4d9c",
                                                "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                                "text": "[…] when the Templar crossed the hall yesternight, he spoke to his Mussulman slaves in the Saracen language, which I well understand, and charged them this morning to watch the journey of the Jew […]"
                                            },
                                            {
                                                "example_id": "e97494c6-657b-44d3-91b3-064835044cb9",
                                                "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                                "text": "[…] she has disturbed me, night and day, through eighteen years—incessantly—remorselessly—till yesternight; and yesternight I was tranquil."
                                            },
                                            {
                                                "example_id": "02a5b729-e067-444e-a8b9-4e4476db2542",
                                                "sense_id": "5d7f8df4-6518-349f-89ca-d874e29c298f",
                                                "text": "I came here yesternight for a call of nature and to do what none can do for me[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
