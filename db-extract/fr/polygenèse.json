            {
                "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                "word": "polygenèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8744386-9537-45cb-b7d1-4ea94228ff82",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "polygenèses"
                    },
                    {
                        "form_id": "7085d93c-b625-42d3-aa41-94353957553b",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "tags": [
                            "Moins courant"
                        ],
                        "form": "polygénèse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20d06bf2-32c3-3bd4-a8ea-f59758d3a756",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "glosses": [
                            "Qualité de ce qui a plusieurs origines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c197a610-1ad4-4a97-b0cb-35f895f8fc93",
                                "sense_id": "20d06bf2-32c3-3bd4-a8ea-f59758d3a756",
                                "text": "Étudiant, [Paul] Broca avait suivi le cours sur la polygenèse du professeur Bérard père à la Faculté de Médecine mais il pouvait également se montrer lamarckien dans ses arguments. Il penchait, selon ses propres dires, en faveur du « transformisme polygénique »."
                            },
                            {
                                "example_id": "197bb206-cbc2-49c5-a275-6e5942150635",
                                "sense_id": "20d06bf2-32c3-3bd4-a8ea-f59758d3a756",
                                "text": "L’approche psychanalytique conforte la position des tenants de la polygenèse en déduisant de la profusion des rêves, des facteurs invariants du psychisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "87de8bed-f515-38f1-861f-ed5806a46f66",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "glosses": [
                            "Reproduction polygenèse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "67bfe64f-3586-3fc6-ab93-9619212d1106",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "glosses": [
                            "Formation indépendante de plusieurs langues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af8ba74-eaa7-4863-afbd-25cb2ceafc8e",
                                "sense_id": "67bfe64f-3586-3fc6-ab93-9619212d1106",
                                "text": "Ceci nous laisse deux hypothèses opposées : la polygenèse et la monogenèse."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a8e2308-30da-310d-bbca-9f7ffce67462",
                        "entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3557c63a-0912-4a41-9843-9903e1501e78",
                                "sense_id": "5a8e2308-30da-310d-bbca-9f7ffce67462",
                                "text": "Selon la théorie de ce groupe, connue sous le nom de polygenèse, Adam et Ève n’étaient pas le père et la mère de l’ensemble de l’humanité mais seulement de l’humanité blanche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "101a5bee-0fff-4b97-bde2-01e83ad3b884",
                        "source_entry_id": "1e5a5754-4fed-36a3-8f9e-00443f2da8c3",
                        "target_lang_word": "polygenesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygenesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3043f7-2f4a-3f25-81f7-1dad6a3fb53f",
                                        "entry_id": "6964f587-a63d-3d2a-90b2-c0785c0845e4",
                                        "glosses": [
                                            "The genesis of a species from more than one ancestor."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a43ca2-46cc-447a-b730-88aaf285d071",
                                                "sense_id": "fc3043f7-2f4a-3f25-81f7-1dad6a3fb53f",
                                                "text": "After polygenesis was soundly rejected by theologians, it was taken up with enthusiasm by many scientists. Thomas Henry Huxley published Evidence as to Man's Place in Nature in 1863, applying Darwin's evolutionary theory to human origins. […] Evolutionary polygenesis, of course, did away with belief in Adam and Eve, and instead asserted that humans arose as a population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d227d01-39e0-3c9e-8aa2-b6269c21f717",
                                        "entry_id": "6964f587-a63d-3d2a-90b2-c0785c0845e4",
                                        "glosses": [
                                            "The theory that living organisms originate in cells or embryos of different kinds, instead of coming from a single cell; as opposed to monogenesis."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03fcf4b6-9e5e-3455-99bf-86fec726dbce",
                                        "entry_id": "6964f587-a63d-3d2a-90b2-c0785c0845e4",
                                        "glosses": [
                                            "The theory that languages developed independently in different places at different periods, as opposed to originating from a single source."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c6c4ba5-5518-4547-a0a2-95a9417d6428",
                                                "sense_id": "03fcf4b6-9e5e-3455-99bf-86fec726dbce",
                                                "text": "The alternative to monogenesis for the origin of language is polygenesis, i.e. that language originated in human evolution at a number of distinct points. If polygenesis is assumed, then the different protolanguages would have developed independently and lead over millennia to the diversity of the descendant languages found at the present day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b41f81bf-abce-30cb-b32f-d45e9e233773",
                                        "entry_id": "6964f587-a63d-3d2a-90b2-c0785c0845e4",
                                        "glosses": [
                                            "The emergence from multiple causes or origins."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7d75e70-71b2-415b-be27-91a82a0a2078",
                                                "sense_id": "b41f81bf-abce-30cb-b32f-d45e9e233773",
                                                "text": "The contrasting theory of polygenesis assumes that resemblances among tales can be attributed to independent invention in places unconnected by trade routes or travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
