                "senses": [
                    {
                        "sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                        "entry_id": "29f715b7-8dc5-3466-b374-319d11fa13ab",
                        "glosses": [
                            "een steen die iets bedekt of afdekt, met name de horizontale stenen van een hunebed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608fe8ea-4543-426a-a1bb-48bd8cebdb98",
                                "sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                                "text": "Het aangekondigde gedenkteken voor de sinds 2011 vermoorde demonstranten heeft deze verbitterde groep alleen maar verder in de gordijnen gejaagd. Zij zien het monument niet als een gedenksteen, maar als een deksteen. Het leger, dat president Morsi afgelopen zomer afzette en sindsdien de lakens uitdeelt, zou voortaan ook over de nagedachtenis van de gevallen betogers het laatste woord willen."
                            },
                            {
                                "example_id": "b1ee7d32-8f31-4e47-8297-4f06f1eaba10",
                                "sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                                "text": "De archeologen geloven dat het kanaal bedoeld was om de geest van de overleden heerser gemakkelijk naar de onderwereld te brengen. Tot nu toe ging de meeste aandacht naar de deksteen van het graf van Pacal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b600241-f975-4b13-9c98-6d61eb4f0ef0",
                        "source_entry_id": "29f715b7-8dc5-3466-b374-319d11fa13ab",
                        "source_sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                        "target_lang_word": "Deckplatte",
