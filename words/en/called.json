                        "called meeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созванный, объявленный или официально назначенный",
                        "tr": "Resmi olarak toplanmış, çağrılmış veya ilan edilmiş"
                    },
                    "translations": {
