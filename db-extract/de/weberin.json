                        "sense_id": "66cf098a-98cb-3074-b05e-bea2d4490ac7",
                        "entry_id": "147698e9-babb-34c9-b61e-a3c517b69032",
                        "glosses": [
                            "weibliche Person, die das Handwerk der Weberei als Beruf ausübt"
