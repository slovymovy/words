                ],
                "senses": [
                    {
                        "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                        "entry_id": "632ffc54-0807-368f-b7ce-f4eb48adb50b",
                        "glosses": [
                            "Betrieb, dessen Einrichtungen durch Pflege und/oder Zucht von Pferden der Erzielung von Einnahmen dient"
                        ],
                        "tags": [
                            "Pferdesport"
                        ],
                        "examples": [
                            {
                                "example_id": "640197f9-acb4-4eb4-b440-3da2f63eeaa7",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Der Hobbyreiter zahlt einen festen monatlichen Betrag an den Reitstall und hat im Gegenzug regelmäßig Zugriff auf \"sein\" Pferd.“"
                            },
                            {
                                "example_id": "3b5b3430-c717-45b9-8e07-af9674ed0a1c",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Tomislav, der Chef des Reitstalles, gibt der kleinen Teresa Unterricht - ein Paradies für bewegungsfreudige Kinder.“"
                            },
                            {
                                "example_id": "a5a3b03d-6a92-4d85-bcbe-24bf95fc7329",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Laut Oberlandesgericht Oldenburg muss der Reitstall in Osnabrück für die Unfallfolgen haften, weil ihm das Pony gehört.“"
                            },
                            {
                                "example_id": "d183ee9a-9b77-43b9-841a-5e0b0e44f7c2",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Zunächst verkauft der Landwirt seine [Stroh-]Ballen bis in die Schweiz, heute beliefert er lokale Reitställe und macht gute Geschäfte.“"
                            },
                            {
                                "example_id": "88e52be4-3145-459b-850f-85cfd718aa28",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Familie Potthoff ist extra hierher gezogen, denn hier kann man sich Land noch leisten. Jetzt bewirtschaften sie auf 200 Hektar einen Biobauernhof, vermieten Ferienwohnungen und betreiben einen Reitstall mit 30 Pferden.“"
                            },
                            {
                                "example_id": "3cfa523a-6f28-45dd-9d12-ee5a598256ad",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "[Einige Kilometer nördlich von München:] „Hier betreibt die neue Weltmeisterin gemeinsam mit ihrem Lebensgefährten Hans-Günter Goskowitz und ihren Eltern den Reitstall \"Gut Eichenhof\", auf dem ihre 16 Pferde stehen.“"
                            },
                            {
                                "example_id": "b44716c4-f2b2-4fe1-b1f1-32349d330339",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Weil sie in der Region keinen Reitstall fand, der ihren Ansprüchen genügt hat, hat Corinna Denndörfer vor gut einem Jahr im oberfränkischen Thierstein ihren eigenen Dressurreitstall „Classic Dressage“ eröffnet.“"
                            },
                            {
                                "example_id": "0a56fa35-36ad-41ab-8153-8af490bdc031",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "[Pferdewirt/-in:] „Obwohl Roxana schon Erfahrung in einem Reitstall gesammelt hatte, war es nicht leicht die Ausbildungsstelle zu bekommen. Schließlich schaffte sie es mit einem Praktikum.“"
                            },
                            {
                                "example_id": "05773e72-403a-4d0f-a42c-574caff18c6b",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„Von Reitlehrerin Caro erfährt Anna im Reitstall in Inning am Ammersee, wie die Ponys bewegt und gepflegt werden, wie sie untergebracht sind, was sie fressen und inwiefern sich das Deutsche Reitpony von anderen Ponys unterscheidet.“"
                            },
                            {
                                "example_id": "6c51d443-7dc5-4a41-be84-9a4e2a7da188",
                                "sense_id": "91739272-8a62-359f-b7c5-01ee8a522656",
                                "text": "„»Es gab das Pferd aus Privatbesitz in einem Reitstall, das (...) im Schlachthof endete, obwohl es mit Medikamenten behandelt worden und damit nicht mehr für den Konsum geeignet war«, sagte ein Ermittler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
