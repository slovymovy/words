                                "target_senses": [
                                    {
                                        "sense_id": "30ee3d43-85b1-3ed5-840a-53b59adaf640",
                                        "entry_id": "3e02811a-813f-37fa-a4c2-0c51b74740bd",
                                        "glosses": [
                                            "Fait de tâter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b93a1f-ffb3-44cb-aeb9-dfdfd4ba5f2b",
                                                "sense_id": "30ee3d43-85b1-3ed5-840a-53b59adaf640",
                                                "text": "En cueillant les fruits, on doit éviter soigneusement le tâtement, car une pression un peu forte en meurtrit la chair, le fruit se tache ensuite et ne tarde pas à se corrompre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
