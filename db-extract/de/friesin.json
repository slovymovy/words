                    {
                        "sense_id": "890bb9be-52a3-36db-92c1-3edcb44d9d14",
                        "entry_id": "82c574df-9f16-3910-a364-189f8f566f39",
                        "glosses": [
                            "Angehörige einer Volksgruppe in Friesland (an der Nordseeküste), in der neben Platt- und Hochdeutsch beziehungsweise Niederländisch das Friesische gesprochen wird oder früher wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766cbb92-ba77-413a-a806-e99f5858d3ca",
                                "sense_id": "890bb9be-52a3-36db-92c1-3edcb44d9d14",
                                "text": "Mata Hari war die wohl bekannteste Friesin aller Zeiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00ea11df-b853-4133-856a-e62c3af3edcc",
                        "source_entry_id": "82c574df-9f16-3910-a364-189f8f566f39",
                        "source_sense_id": "890bb9be-52a3-36db-92c1-3edcb44d9d14",
                        "source_sense_description": "Frau aus Friesland",
                        "target_lang_word": "Frisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "The West Frisian (or Western Frisian) lect, spoken in the northern Netherlands."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab7d4af-0a63-4cc7-b911-e8f096a69b69",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "In the province of Friesland, in the north of the Netherlands, a high percentage of the population, about 350000, speak Frisian as their first language."
                                            },
                                            {
                                                "example_id": "56b305fd-5dfa-4fff-ad22-b122231c6db4",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "This means that full competence in both Frisian and Dutch (ie understanding, speaking, reading and writing ability) is aimed at all pupils in the province, whether they speak Frisian or Dutch at home."
                                            },
                                            {
                                                "example_id": "f7954aa7-8329-464e-96fd-6517d4fe4f9b",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "Many Frisians speak Frisian at home and Dutch at work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f89a40-a0e2-3522-9fb3-26e1ed6121e0",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "Saterland Frisian, the last surviving dialect of the East Frisian lect, spoken in Northern Germany close to the Dutch border."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a8d48dc-25fd-33db-86d8-270bda75cc75",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "The North Frisian lect, spoken in northwestern Schleswig-Holstein in Germany."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3695d12c-e3c3-34b6-9582-0db0a56db0c2",
                                        "entry_id": "9ef90c23-a71a-398d-a17c-e08cfea1a780",
                                        "glosses": [
                                            "A member of the Germanic ethnic group which is native to the region of Frisia (which is in the Netherlands, northern Germany, and southern Denmark)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f94ed21-be6c-4341-872b-ef521f660a90",
                                                "sense_id": "3695d12c-e3c3-34b6-9582-0db0a56db0c2",
                                                "text": "King Hygelac of the Geats had been struck down by one might swipe of the foemen, the Frisians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28cb961-5ae7-3aec-89a7-2d1178ecae47",
                                        "entry_id": "9ef90c23-a71a-398d-a17c-e08cfea1a780",
                                        "glosses": [
                                            "A native or inhabitant of the Dutch province of Friesland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90373339-5f8f-3e7b-acca-8d2b4634b7d7",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of, in or relating to the Frisian language or a Frisian language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b067197-4a63-41f2-9e47-5c68fa033567",
                                                "sense_id": "90373339-5f8f-3e7b-acca-8d2b4634b7d7",
                                                "text": "Because the instruction manual was Frisian, Yves couldn't read it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a1a1ef-92a5-3efe-854e-51a8f2527936",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of, from or relating to the region of Frisia: Either West Frisia (the Dutch province of Friesland); North Frisia (in the German state of Schleswig-Holstein, near the Danish border); or East Frisia (in the German state of Lower Saxony, near the Dutch border)."
                                        ],
