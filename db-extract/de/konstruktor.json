                "senses": [
                    {
                        "sense_id": "58049482-1f3e-3401-866a-45a7278f2550",
                        "entry_id": "3afb3dab-f594-3718-bc5f-19d3b1cb3268",
                        "glosses": [
                            "Methode, die zur Erzeugung und Initialisierung eines abstrakten Datentyps, eines Objekts, aufgerufen wird"
                        ],
                        "tags": [
                            "objektorientierte Programmierung"
                        ],
                        "examples": [
                            {
                                "example_id": "3ede8de5-583d-41e7-bf79-4f7715d7974a",
                                "sense_id": "58049482-1f3e-3401-866a-45a7278f2550",
                                "text": "In Java werden Objekte mit dem Schlüsselwort „new“, gefolgt vom Konstruktor, erzeugt."
                            },
                            {
                                "example_id": "97fcbf5a-2158-41a4-9d2a-e4b3f2bdeda0",
                                "sense_id": "58049482-1f3e-3401-866a-45a7278f2550",
                                "text": "Dieser Konstruktor erzeugt ein Objekt, in dem zehn Bilddateien gespeichert werden können."
                            },
                            {
                                "example_id": "68ec9b8c-feb2-47f7-979e-e53b8a124a39",
                                "sense_id": "58049482-1f3e-3401-866a-45a7278f2550",
                                "text": "Komplexe Zahlen können als Objekte dargestellt werden. Der Konstruktor reserviert dann Speicher, in dem der Real- und der Imaginärteil gespeichert wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bac276d-aa97-45dc-8909-355cdae6aa80",
                        "source_entry_id": "3afb3dab-f594-3718-bc5f-19d3b1cb3268",
                        "source_sense_id": "58049482-1f3e-3401-866a-45a7278f2550",
