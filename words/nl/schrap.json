                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schrap</w> de wortels voordat ik ze in de pan doe.",
                            "target_lang_translations": {
                                "en": "I <w>scrape</w> the carrots before I put them in the pan."
                            }
