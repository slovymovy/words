                "senses": [
                    {
                        "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                        "entry_id": "7b32e259-d016-3f57-b8d8-eb06794451bf",
                        "glosses": [
                            "in den Zellen von Pflanzen vorkommender, roter, violetter oder blauer wasserlöslicher Farbstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d58067-cb77-44ee-b7a9-133ab244b60b",
                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                "text": "Anthocyane sind chymochrome Farbstoffe, die nahezu in allen höheren Pflanzen vorkommen, jedoch nur im Zellsaft von Landpflanzen, nicht aber in Tieren, Mikroorganismen oder Wasserpflanzen zu finden sind."
                            },
                            {
                                "example_id": "da19f95c-2971-4963-bef7-03e1252e3731",
                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                "text": "„Anthocyan wird im Herbst von einigen Bäumen neu gebildet.“"
                            },
                            {
                                "example_id": "147eae8f-112f-4d30-b62a-ae7bfd4e8f2a",
                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                "text": "„100 g Rotkohl enthalten rund 25 mg Anthocyane, etwa so viel wie ein Glas Rotwein.“"
                            },
                            {
                                "example_id": "161f7f23-af8e-4eb7-9565-60d75e73d0f8",
                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                "text": "„Rotweintrauben erhalten ihre typische Farbe durch das Pigment Anthocyan, das die weißen Kultursorten der Weinrebe (Vitis vinifera) nur in geringem Maße produzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
