                "translations": [
                    {
                        "translation_id": "1a892b3d-8cd2-437f-aa1a-573d878eee1c",
                        "source_entry_id": "b9431922-e57a-349c-8ddd-a8dd53130893",
                        "source_sense_id": "1d82e6c6-9edf-3a90-9d30-8d9c50a45b81",
                        "target_lang_word": "thesis",
                        "target_lang_code": "en",
