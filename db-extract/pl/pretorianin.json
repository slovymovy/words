                                        "sense_id": "0dde57ef-b371-338f-b9e7-8daef3604102",
                                        "entry_id": "fdc8b626-8d53-30f4-bd6b-8db88d0f4577",
                                        "glosses": [
                                            "Of or pertaining to a praetor."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79bd54e8-fb45-301b-8e06-e0bfba1385ef",
                                        "entry_id": "fdc8b626-8d53-30f4-bd6b-8db88d0f4577",
                                        "glosses": [
                                            "Of or pertaining to the pretorium in an ancient Roman camp."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "562cde7a-32cf-479b-aef0-21178937336d",
                                                "sense_id": "79bd54e8-fb45-301b-8e06-e0bfba1385ef",
                                                "text": "The praetorian gate was directly in front of the general's tent, and nearest to the enemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba5682b7-173a-3b69-8d13-6a00a69c2533",
                                        "entry_id": "fdc8b626-8d53-30f4-bd6b-8db88d0f4577",
                                        "glosses": [
                                            "Of or pertaining to the special bodyguard force used by Roman emperors."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c5d12b-d32e-4bac-b075-1a8415dfa1b8",
                                                "sense_id": "ba5682b7-173a-3b69-8d13-6a00a69c2533",
                                                "text": "praetorian guard"
                                            },
                                            {
                                                "example_id": "f2177e6b-2a20-46ab-8174-4fa398c04116",
                                                "sense_id": "ba5682b7-173a-3b69-8d13-6a00a69c2533",
                                                "text": "Hey, sir? Sir, excuse me?” The blonde was calling out to him, in imperious tones that insisted on a reply. Her satraps became watchful, like a Praetorian guard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f16f81c0-a519-360e-9057-101be1953331",
                                        "entry_id": "fdc8b626-8d53-30f4-bd6b-8db88d0f4577",
                                        "glosses": [
                                            "Corruptly mercenary and venal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "praetorian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb981049-a385-3a51-9a9b-d9159275dc2f",
                                        "entry_id": "b6043a53-668c-3751-91ac-a84c052a4232",
                                        "glosses": [
                                            "A praetor; a person of praetorian rank."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988e2840-f19d-48da-89e7-3f45d5d417b1",
                                                "sense_id": "cb981049-a385-3a51-9a9b-d9159275dc2f",
                                                "text": "I am so rich, I could have given bid for bid with the wealthiest Prætorians at the auction of the Roman empire (which was the world’s); and yet I owe for the flesh in the tongue I brag with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f5af9e-b4f3-3887-82f8-ab7063017bac",
                                        "entry_id": "b6043a53-668c-3751-91ac-a84c052a4232",
                                        "glosses": [
                                            "Alternative letter-case form of Praetorian (“member of a special bodyguard force used by Roman emperors”)."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3506aa2-733f-48e0-93a6-6851581da692",
                                                "sense_id": "16f5af9e-b4f3-3887-82f8-ab7063017bac",
                                                "text": "Durry's work is still cited as the definitive study of the praetorians, and in fact most modern scholarship on the praetorians is based on material from his work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011be964-470c-306b-a900-7150199c4081",
                                        "entry_id": "b6043a53-668c-3751-91ac-a84c052a4232",
                                        "glosses": [
                                            "A venal mercenary."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8a1001f-b643-4e74-9295-0da8c6cf2836",
                                                "sense_id": "011be964-470c-306b-a900-7150199c4081",
                                                "text": "The Trump praetorians who initially denied there was any effort to pressure the Ukrainians into action on a Biden probe, possibly including the withholding of congressionally approved military aid, suddenly surfaced a new talking point: “They’re trying to turn what was a Biden scandal into a Trump scandal.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
