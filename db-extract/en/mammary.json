                                        "entry_id": "820d3187-41b4-3fe5-8247-f0c801147983",
                                        "glosses": [
                                            "Relatif aux mamelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36abb0c2-7361-4666-8445-dd26ee8c8a2f",
                                                "sense_id": "1b6493c9-3d95-3e06-b002-beb79ee764cd",
                                                "text": "- le degré de liposolubilité de la fraction non ionisée est le second paramètre qui, avec le pKa, détermine la liposolubilité des molécules et leur répartition plus ou moins étendue dans le tissu mammaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643101a3-95e0-31d9-9262-9768ca90a162",
                                        "entry_id": "820d3187-41b4-3fe5-8247-f0c801147983",
                                        "glosses": [
                                            "Relatif au sein de la femme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43557061-7275-4b10-b984-015b5306c13f",
                                                "sense_id": "643101a3-95e0-31d9-9262-9768ca90a162",
                                                "text": "L’échographie mammaire doit être intégrée dans la consultation sénologique."
                                            },
                                            {
                                                "example_id": "1016c44c-6671-4c3b-82a3-06c8e6427030",
                                                "sense_id": "643101a3-95e0-31d9-9262-9768ca90a162",
                                                "text": "Nous avons étudié l’activité antiproliférative et antitumorale des dérivés du dextrane sur plusieurs lignées de cellules épithéliales mammaires humaines et tenté d’élucider leur mécanisme d’action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "719b4505-ff85-4bb5-a073-60de356cf0b5",
                        "source_entry_id": "807df1c5-f6db-3e95-8ac5-ea63ece08bc2",
                        "source_sense_id": "8ebca565-2898-39d7-b856-4a8af3277449",
                        "source_sense_description": "of or relating to mamma",
                        "target_lang_word": "Brust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faa55d7d-1c07-377a-8223-30e752a0179b",
                                        "entry_id": "6391182b-16ae-3eec-ab26-79900cd25f50",
                                        "glosses": [
                                            "vorderer Oberkörper bei Wirbeltieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb96419-50db-46d2-a50e-10ae7a2ee8e7",
                                                "sense_id": "faa55d7d-1c07-377a-8223-30e752a0179b",
                                                "text": "Er hat ständig Schmerzen in der Brust."
                                            },
                                            {
                                                "example_id": "7fdfe2a6-0e33-409c-9c1a-85575e032465",
                                                "sense_id": "faa55d7d-1c07-377a-8223-30e752a0179b",
                                                "text": "„Und da fuhr es ihm durch die Brust, und er stöhnte, und es war natürlich niemand da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                        "entry_id": "6391182b-16ae-3eec-ab26-79900cd25f50",
                                        "glosses": [
                                            "auf Höhe von [1] befindliches sekundäres Geschlechtsmerkmal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3040f2f-6d11-4c13-914c-24eb3ff9ff03",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "Sie besitzt riesige Brüste."
                                            },
                                            {
                                                "example_id": "d21f4450-da83-4a79-ad9d-bf9e33288fa7",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "Die weibliche Brust besteht zum größten Teil aus Fett- und Drüsengewebe."
                                            },
                                            {
                                                "example_id": "facbe7ab-357c-40f1-abb7-41286c1a0e93",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "„Dann erschien im Altenteil ein etwa dreizehnjähriges Mädchen, mit frühentwickelten Brüsten, einem scheuen, blassen Gesicht und zwei langen, weizenblonden Zöpfen.“"
                                            },
                                            {
                                                "example_id": "d2170476-455a-46ee-893e-8a2a2551ff44",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "„Eos neigt sich diesen fremden Brüsten zu und kippt dem Schlaf entgegen.“"
                                            },
                                            {
                                                "example_id": "b41abfda-7fca-4327-af01-89ab682888e9",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "„Fast übergangslos kam er vom Reden zum Küssen, es blieb angenehm und herzklopflos, und manchmal durfte er seine Hände nach meinen Brüsten ausstrecken, sie ein wenig drücken oder streicheln, so, wie den Rücken, zwischen den Schulterblättern war es mir am liebsten.“"
                                            },
                                            {
                                                "example_id": "8b05dbbe-e518-481f-9ccb-b92bfd59e190",
                                                "sense_id": "cfda5266-4bd5-3000-81a4-2557d2516dc4",
                                                "text": "„Mindestens zwanzig Minuten lang nahm er keine Notiz von ihm und befummelte stattdessen lieber die Brüste des Mädchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "040e848d-7914-3d7d-8eac-ef66be943782",
                                        "entry_id": "6391182b-16ae-3eec-ab26-79900cd25f50",
                                        "glosses": [
                                            "kurz für Brustschwimmen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84247794-45d4-410d-8f42-e67ec8a50ded",
                                                "sense_id": "040e848d-7914-3d7d-8eac-ef66be943782",
                                                "text": "Unsere Staffel gewann die 200 m Brust sowie die 400 m Lagen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
