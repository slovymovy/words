                ],
                "senses": [
                    {
                        "sense_id": "0870b51b-03f3-3056-aeae-d72affb4618d",
                        "entry_id": "57ef2b9e-e213-3161-918c-3e34b2eedeff",
                        "glosses": [
                            "Reproduktionszahl/R; Vervielfältigungszahl, die angibt, mit welcher Geschwindigkeit sich etwas vermehrt"
                        ],
                        "tags": [
                            "Epidemiologie",
                            "kurze Bezeichnung für die"
                        ],
                        "examples": [
                            {
                                "example_id": "419b652f-33a8-45bd-95d2-8bb8e99b7a75",
                                "sense_id": "0870b51b-03f3-3056-aeae-d72affb4618d",
                                "text": "„Der aktuelle R-Wert gibt damit eine Information über die Erkrankungen (Krankheitsbeginn), die im Mittel sieben Tage zurückliegen.“"
                            },
                            {
                                "example_id": "d8875177-ec71-4234-8f4d-b8261f3274da",
                                "sense_id": "0870b51b-03f3-3056-aeae-d72affb4618d",
                                "text": "„Die Schätzung des R-Wertes basiert auf dem sogenannten Nowcasting, einem statistischen Verfahren, das die Entwicklung der Fallzahlen nach Erkrankungsbeginn darstellt und für die letzten Tage auch prognostiziert (mehr Informationen zur Methode, Beispielrechnungen und aktuelle Zahlen unter www.rki.de/covid-19-nowcasting).“"
                            },
                            {
                                "example_id": "d710bc97-db39-4db5-9609-7bf67b006c0a",
                                "sense_id": "0870b51b-03f3-3056-aeae-d72affb4618d",
                                "text": "„Die berichteten R-Werte lagen im Oktober stabil deutlich über 1. In den letzten Tagen unterlag der R-Wert leichten Schwankungen; aktuell liegt er um 1.“"
                            },
                            {
                                "example_id": "fc399617-2f4e-49d0-9636-1637a769221a",
                                "sense_id": "0870b51b-03f3-3056-aeae-d72affb4618d",
                                "text": "[Coronapandmie 2022:] „»Der R-Wert ist dramatisch gesunken.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
