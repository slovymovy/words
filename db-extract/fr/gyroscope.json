                "senses": [
                    {
                        "sense_id": "3cdaf81d-22d3-3b24-9b32-fbbe4b758a7f",
                        "entry_id": "b4ab7529-4807-32a0-9799-c43c771331e2",
                        "glosses": [
                            "Gyroskop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15aac174-1bd6-455e-b4fc-67bd701ba7b6",
                                "sense_id": "3cdaf81d-22d3-3b24-9b32-fbbe4b758a7f",
                                "text": "« Comme tous ces phénomènes dépendent du mouvement de la Terre et en sont des manifestations variées, je propose de nommer gyroscope l’instrument unique qui m’a servi à les constater. »"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d89959e4-7725-4766-bdce-7cf710b127d1",
                        "source_entry_id": "b4ab7529-4807-32a0-9799-c43c771331e2",
                        "source_sense_id": "3cdaf81d-22d3-3b24-9b32-fbbe4b758a7f",
                        "source_sense_description": "Technik: Gyroskop",
                        "target_lang_word": "Gyroskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gyroskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                        "entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                                        "glosses": [
                                            "rasch rotierender, symmetrischer Kreisel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d667307d-ae4b-415a-8402-043ffedd0ef5",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "Mit dem Gyroskop lässt sich die Achsendrehung der Erde nachweisen."
                                            },
                                            {
                                                "example_id": "4c959667-3db9-4a1b-9c97-bdd4fdad31cd",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "„Ein Gyroskop (auch Kreiselinstrument genannt) dient im Smartphone zur Lagebestimmung des Geräts.“"
                                            },
                                            {
                                                "example_id": "d56df896-5087-4b4e-a1f2-90935be10cf1",
                                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                                "text": "„Der Begriff Gyroskop bezeichnet ein Kreiselinstrument, das aus einem Kreisel besteht, der sich in einem Lager dreht. Das Gyroskop ist dabei nicht nur ein interessanten physikalisches Spielzeug, sondern war als Kreiselinstrument eine überaus wichtige Erfindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
