                            },
                            {
                                "target_lang_word": "дурацкий",
                                "target_lang_sense_clarification": "нелепый или бессмысленный"
                            },
                            {
                                "target_lang_word": "безрассудный",
                                "target_lang_sense_clarification": "поступающий вопреки здравому смыслу"
