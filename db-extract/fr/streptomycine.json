                ],
                "senses": [
                    {
                        "sense_id": "4f1ee639-5be4-34c7-aaea-7b721bb4ee5b",
                        "entry_id": "ad56a7e8-d738-3ebc-a2bd-00b95213028c",
                        "glosses": [
                            "Antibiotique antibactérien cytostatique et cytotoxique, appartenant à la classe des aminosides (ou aminoglycosides)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d159586d-6967-4022-8a28-910d23c6c530",
                                "sense_id": "4f1ee639-5be4-34c7-aaea-7b721bb4ee5b",
                                "text": "Je les ai contenus à coups de pneumos, rimifon, streptomycine, années de sana, privations de coïts et de vinasse."
                            },
                            {
                                "example_id": "014c91b3-2c62-4fa5-9643-ba144acee55e",
                                "sense_id": "4f1ee639-5be4-34c7-aaea-7b721bb4ee5b",
                                "text": "Ainsi, la résistance aux aminosides qui ne concernait, jusqu'en 1975, que la streptomycine et la kanamycine a été modifiée par l'apparition cette même année de deux nouveaux phénotypes de résistance plasmidique."
                            },
                            {
                                "example_id": "46048a8c-bd87-4660-9f82-410f6bafd271",
                                "sense_id": "4f1ee639-5be4-34c7-aaea-7b721bb4ee5b",
                                "text": "Le spectre d'action de la streptomycine est assez large puisqu'elle peut agir sur certains bacilles gram négatifs (comme Escherichia coli) ou certains cocci gram positifs (comme le Staphylococcus aureus.)"
                            },
                            {
                                "example_id": "cb2d1fcf-9e24-4db6-ae78-7942b8fb134c",
                                "sense_id": "4f1ee639-5be4-34c7-aaea-7b721bb4ee5b",
                                "text": "La streptomycine, est tout aussi dangereuse. Son administration peut entraîner une paralysie respiratoire, un risque élevé de lésions vestibulaires permanentes et induire un coma chez les très jeunes enfants."
                            }
                        ]
                    }
                ],
