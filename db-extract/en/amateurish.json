                                "target_senses": [
                                    {
                                        "sense_id": "b5d40cb5-d020-392d-904f-eb0219d9df10",
                                        "entry_id": "dbcc693d-2fa8-3121-bac8-707516b50e27",
                                        "glosses": [
                                            "betrekking hebbend op personen en het werk van personen die iets doen of maken zonder daarin een professionele scholing te hebben ontvangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f941c19a-762f-4b41-8c79-fc88cbdac307",
                                                "sense_id": "b5d40cb5-d020-392d-904f-eb0219d9df10",
                                                "text": "De amateuristische muziekuitvoering was prachtig o.a. door het enthousiasme van de uitvoerende kunstenaars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                        "entry_id": "dbcc693d-2fa8-3121-bac8-707516b50e27",
                                        "glosses": [
                                            "van slechte kwaliteit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f80cae-3661-4718-a0fa-d94bfd2ad253",
                                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                                "text": "De fiets was op een amateuristische wijze gerepareerd."
                                            },
                                            {
                                                "example_id": "c2bb1580-38a9-4550-b8ef-5e9880d388aa",
                                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                                "text": "Mijn onderzoeksmethoden waren zowel lomp als amateuristisch."
                                            },
                                            {
                                                "example_id": "011b6ed1-d7ae-4de4-9d60-778d3e587f30",
                                                "sense_id": "453cb4db-85f3-32d4-a032-839604776917",
                                                "text": "\" „Dus u hebt in uw jeugd al archeologie gestudeerd?\" „Het was allemaal erg amateuristisch, maar ik ben altijd vooral geïnteresseerd geweest in grafkelders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d6c0569-0d03-4788-a310-8239e82747b4",
                        "source_entry_id": "aa8fddeb-0dc4-316e-a2b3-fa1073d5d174",
                        "source_sense_id": "cfec0f8c-9a6e-3165-bdd5-31410039d6b3",
                        "source_sense_description": "reflecting the efforts of an amateur",
                        "target_lang_word": "amateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1467ba-eedf-3482-8911-44d8ca49db75",
                                        "entry_id": "cce6068c-cb6b-3c64-8757-f3cf9d06f4d3",
                                        "glosses": [
                                            "Qui aime, aime à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dcc3915-b5d1-437d-9db0-d847d5482c74",
                                                "sense_id": "5d1467ba-eedf-3482-8911-44d8ca49db75",
                                                "text": "Dit autrement, le gueuleton bien arrosé du bon vivant, amateur de viande et de cigare, n’a pas son équivalent chez l’adepte de la graine germée et du tofu mariné à la sauce soja."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cdc5bcc-9c7d-3706-9393-e312d744d984",
                                        "entry_id": "cce6068c-cb6b-3c64-8757-f3cf9d06f4d3",
                                        "glosses": [
                                            "Relatif à l’amateurisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34a7355-f544-4023-a078-03f46f948791",
                                                "sense_id": "2cdc5bcc-9c7d-3706-9393-e312d744d984",
                                                "text": "Une footballeuse amatrice poitevine a écrit à la ministre déléguée chargée des Sports, Roxana Maracineanu."
                                            },
                                            {
                                                "example_id": "5c47c05f-ef6e-4317-8f31-78e1c86a3add",
                                                "sense_id": "2cdc5bcc-9c7d-3706-9393-e312d744d984",
                                                "text": "Une telle bonne volonté dans le désir de régler l’énigme d’une vie ferait sourire si elle ne se prenait pas au sérieux, et se montrait un peu moins amateure dans sa façon, proche du off pauvre d’Avignon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "922cf642-e2fd-30eb-8b61-5143cb9b52c3",
                                        "entry_id": "fac8e7d9-fef3-3480-a1f5-985d10752478",
                                        "glosses": [
                                            "Celui qui a de l’attachement, du goût pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814130db-6acc-4e2d-be8c-03fa1bb57d36",
                                                "sense_id": "922cf642-e2fd-30eb-8b61-5143cb9b52c3",
                                                "text": "Quand un amant désirait se présenter à une courtisane, il lui suffisait d’écrire leurs deux noms avec le prix qu’il proposait ; si l’homme et l’argent étaient reconnus dignes, la femme restait debout sous l’affiche en attendant que l’amateur revînt."
                                            },
                                            {
                                                "example_id": "ed55fa53-86a9-4b6b-8208-04be5bf04ea3",
                                                "sense_id": "922cf642-e2fd-30eb-8b61-5143cb9b52c3",
                                                "text": "Après Zoza, la route monte vers Sorbollano en longeant la rivière : le lieu est idéal pour les amateurs de pêche et de canoë-kayak."
                                            },
                                            {
                                                "example_id": "5138f4d1-6cab-4446-a021-ef910e0db0da",
                                                "sense_id": "922cf642-e2fd-30eb-8b61-5143cb9b52c3",
                                                "text": "L'accident n'avait en rien entamé la bonne humeur des convives qui attaquaient vaillamment le plateau de fromages bourguignons : clacbitou, chaource, époisses, trou du cru, soumaintrain... Quoique grand amateur de fromages, Adrien n'y toucha pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                                        "entry_id": "fac8e7d9-fef3-3480-a1f5-985d10752478",
                                        "glosses": [
                                            "Celui qui aime les Beaux-Arts sans les exercer ou sans en faire profession."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f60f15ce-d6fa-4d22-a083-c6bd67fd8b32",
                                                "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                                                "text": "— Vous êtes donc en tournée d’amateur ?"
                                            },
                                            {
                                                "example_id": "e79e480b-4dac-4af4-a3e1-55e8c9fad6ca",
                                                "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                                                "text": "En ouvrant la séance, M. Hibon, président sortant, adresse ses remerciements pour le grand honneur, qui, dit-il, fut fait à un amateur de présider les travaux de la Société en 1936, puis il prie M. Allorge de lui succéder au fauteuil présidentiel."
                                            },
                                            {
                                                "example_id": "8d6ccb45-c52e-43c3-a6a5-4744d504bedf",
                                                "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                                                "text": "Il n’est pas artiste, il n’est qu’amateur."
                                            },
                                            {
                                                "example_id": "ea173df4-de3b-4a6e-91f3-524017a31035",
                                                "sense_id": "4e4478fc-6891-3c6f-bad5-be2e417bb37e",
                                                "text": "C’est un talent d’amateur, un ouvrage d’amateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db05bcd-1731-3f98-84f9-b00a605882d3",
                                        "entry_id": "fac8e7d9-fef3-3480-a1f5-985d10752478",
                                        "glosses": [
                                            "Celui qui, ayant à faire une chose, s’en occupe négligemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebeb97d-b758-4717-9012-c6f121d65286",
                                                "sense_id": "5db05bcd-1731-3f98-84f9-b00a605882d3",
                                                "text": "Il étudie en amateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7b4c76-65bf-32f7-8cc7-75ff2fc4b93f",
                                        "entry_id": "fac8e7d9-fef3-3480-a1f5-985d10752478",
                                        "glosses": [
                                            "Celui qui pratique les sports sans en tirer aucun profit pécuniaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d23d484-2919-4057-8460-eb6a7287dce8",
                                                "sense_id": "2d7b4c76-65bf-32f7-8cc7-75ff2fc4b93f",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu’un prétexte d’orgies, une occasion de plaisirs faciles, au lieu d’un amusement salutaire et convenable à la dignité de l’homme."
                                            },
                                            {
                                                "example_id": "9773d70c-d7fd-4508-a982-b9c1e47f44e1",
                                                "sense_id": "2d7b4c76-65bf-32f7-8cc7-75ff2fc4b93f",
                                                "text": "Mais si les courses ne donnent point au cheval les caractères de bonté que l’on en attend, pourquoi le gouvernement français les subventionne-t-il ? pourquoi ne laisserait-on pas les amateurs du turf se soutenir par eux-mêmes […] ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d18d6472-3123-45e0-99a1-5e4404014f1c",
                        "source_entry_id": "aa8fddeb-0dc4-316e-a2b3-fa1073d5d174",
