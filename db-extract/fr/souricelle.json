                        ],
                        "examples": [
                            {
                                "example_id": "b6e9f6c2-81cc-4413-9b2b-fa291c6ab21f",
                                "sense_id": "663d104e-ba51-3bea-908e-16ad56a45f13",
                                "text": "Et, en effet, cette vilaine perspective refroidit vite l’ardeur des jeunes souricelles ; il n’y en eut que quatre qui se présentèrent pour tenter l’expérience."
                            }
                        ]
                    }
