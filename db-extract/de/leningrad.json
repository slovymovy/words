                "senses": [
                    {
                        "sense_id": "f959de33-6800-3843-a18d-8975fd2f02a1",
                        "entry_id": "f857ea22-5ebd-388b-a142-06c4ef178186",
                        "glosses": [
                            "von 1924 bis 1991 der Name der russischen Stadt Sankt Petersburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d918eaf-7cd6-4e51-9120-0bc8205f8a76",
                                "sense_id": "f959de33-6800-3843-a18d-8975fd2f02a1",
                                "text": "Die Front hatte die Aufgabe, den Zugang zu Leningrad zu decken und die Wegnahme der Stadt durch den Gegner zu verhindern."
                            },
                            {
                                "example_id": "8155fbc9-83c4-4492-8bf3-ca828758ede2",
                                "sense_id": "f959de33-6800-3843-a18d-8975fd2f02a1",
                                "text": "Das Leningrad und Moskau der 1930er Jahre – wenn man das als die Geburt der sozialistischen Zivilisation gelten lässt – sind nur von oben betrachtet übersichtliche, wohlgeordnete Städte"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fe4c509-8ce0-4ba3-b64a-192130653e58",
                        "source_entry_id": "f857ea22-5ebd-388b-a142-06c4ef178186",
                        "source_sense_id": "f959de33-6800-3843-a18d-8975fd2f02a1",
                        "target_lang_word": "Léningrad",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Léningrad",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf966d9-8017-3e1b-a9f2-2e75537dc75f",
                                        "entry_id": "94901a59-85b5-39fc-a9a6-e201481a3a05",
                                        "glosses": [
                                            "Nom que porta Saint-Pétersbourg de 1924 à 1991."
                                        ],
                                        "tags": [
                                            "Communisme",
                                            "URSS"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1e8958-1e7c-475d-a466-adf366412e83",
                                                "sense_id": "5bf966d9-8017-3e1b-a9f2-2e75537dc75f",
                                                "text": "En U.R.S.S. le peuple est admirable ; celui de Géorgie, de Kakhétie, d’Abkhasie, d’Ukraine […] et plus encore à mon goût, celui de Léningrad et de la Crimée."
                                            },
                                            {
                                                "example_id": "a0c0683d-68f9-4dbe-924e-4308d9c896f3",
                                                "sense_id": "5bf966d9-8017-3e1b-a9f2-2e75537dc75f",
                                                "text": "Zinoviev préside l’Internationale communiste et le Soviet de Pétrograd qu’il rebaptise Léningrad."
                                            },
                                            {
                                                "example_id": "6473ae04-6224-4d27-b39e-e7edb1d579bc",
                                                "sense_id": "5bf966d9-8017-3e1b-a9f2-2e75537dc75f",
                                                "text": "Léningrad est la plus belle ville du monde. Plate comme l’Océan, sans collines ni gratte-ciel, immense, avec des perspectives illimitées, des rues où l’œil se perd en largeur comme en longueur, pavées d’un carrelage en tronçons de bois, un pavé doux et luxueux comme un tapis."
                                            },
                                            {
                                                "example_id": "6b32abe0-7721-471e-9ff2-5f2a0d2435c8",
                                                "sense_id": "5bf966d9-8017-3e1b-a9f2-2e75537dc75f",
                                                "text": "Le physiologiste hollandais Jordan écrivait que les travaux de Pavlov ont fait de Léningrad la Mecque des physiologistes du monde entier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18616e28-f406-3817-b355-1004c49ac4bc",
                                        "entry_id": "94901a59-85b5-39fc-a9a6-e201481a3a05",
                                        "glosses": [
                                            "Bataille et siège qui se déroula dans cette ville pendant la Seconde Guerre mondiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6638880e-f50f-4736-88dd-c865552580e2",
                                                "sense_id": "18616e28-f406-3817-b355-1004c49ac4bc",
                                                "text": "Le mot « Léningrad » n’avait pas pour nous qu’un sens géographique. Il était devenu un mot d’ordre, synonyme du mot « victoire »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
