                "senses": [
                    {
                        "sense_id": "c518dbfc-0c26-3c15-b8f5-4a64418a073d",
                        "entry_id": "1becb41f-86b9-3c8e-9248-b136fd695e26",
                        "glosses": [
                            "Débarrasser des toxines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b0f2d3-4621-4ebd-b7c8-ed3a4a2821cf",
                                "sense_id": "c518dbfc-0c26-3c15-b8f5-4a64418a073d",
                                "text": "On a testé et adopté ces soins hyper pratiques : prêts en 30 secondes, ils hydratent, estompent les rides, purifient, détoxent la peau en quelques minutes."
                            },
                            {
                                "example_id": "be0d2b15-da85-4b61-a6e2-7456f8bd353a",
                                "sense_id": "c518dbfc-0c26-3c15-b8f5-4a64418a073d",
                                "text": "De fait, «se détoxer» est devenu le nouveau mantra des adeptes de cures qui visent à débarrasser l’organisme des toxines."
                            },
                            {
                                "example_id": "eb1b0966-87b1-4689-883f-e101878689a2",
                                "sense_id": "c518dbfc-0c26-3c15-b8f5-4a64418a073d",
                                "text": "Comment profiter de l’été pour se détoxer ?"
                            }
                        ]
                    }
