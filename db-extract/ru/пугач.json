                        "glosses": [
                            "игрушечный пистолет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35e506c-1b54-46e4-b79f-19a8ee4a2672",
                                "sense_id": "9d5aac45-d71c-3471-8091-80cbf0c512db",
                                "text": "Пугач мы взяли у одного второклассника, но пробок у него нашлось всего пять штук: две из них я раздавил, а третья куда-то закатилась и ее никак не найти ― осталось всего две."
                            }
                        ]
                    }
                ],
