                                                "example_id": "36517b4c-01ce-4fff-9559-7fea274459d5",
                                                "sense_id": "a57b15a0-12dc-342f-83af-4d1e7b9e8791",
                                                "text": "Земля движется вокруг своей оси."
                                            },
