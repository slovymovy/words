                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce73e93-bf8b-4dcc-a9e8-204a05014718",
                                "sense_id": "954988d5-4688-3f82-8851-9868f189f5f8",
                                "text": "„Eines Tages sah Roth im St.-Barth's-Schwimmbad an der Kreuzung 51th Street und Park Avenue, wie ein Mann, der etwa in seinem Alter war, beim Umziehen eine Beinschiene abnahm, und fragte ihn, ob er Polio gehabt habe.“"
                            }
                        ],
