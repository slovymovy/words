                        "examples": [
                            {
                                "example_id": "15c80a83-ca6d-4c54-ad64-c9a8dbd40f33",
                                "sense_id": "30ce1eaf-467b-33dd-8a3d-bebc8b494676",
                                "text": "'We moeten ze een wortel voorhangen. Dat als ze echt hun best doen, we op enig moment verlichting aanbrengen in hun schuldenproblematiek.'"
                            },
                            {
                                "example_id": "05ca9f9a-ce8a-4624-bb47-2a6260d38648",
                                "sense_id": "30ce1eaf-467b-33dd-8a3d-bebc8b494676",
                                "text": "Twente en PSV zijn klaar in de Europa League. Het toernooi geniet weinig aanzien. „Je moet clubs een worst voorhangen.”"
                            }
                        ]
