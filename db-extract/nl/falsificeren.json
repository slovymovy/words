        "nl-extract.jsonl": [
            {
                "entry_id": "06fb6b77-3c09-3384-a37d-0c3ffe6c1af0",
                "word": "falsificeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b239f7d-2ec5-3d17-aa41-849a88bc6993",
                        "entry_id": "06fb6b77-3c09-3384-a37d-0c3ffe6c1af0",
                        "glosses": [
                            "de onjuistheid van een theorie of uitspraak aantonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0cb2db5-7025-460a-a579-a1fb548c4784",
                                "sense_id": "9b239f7d-2ec5-3d17-aa41-849a88bc6993",
                                "text": "Wat drijft onderzoekers? Nieuwsgierigheid. De wereld willen verbeteren. Kennis willen bijdragen. Jonge mensen willen opleiden. Zonder al deze deugden kan een wetenschapper niet slagen, maar hierbij blijft het niet. Ook geldingsdrang is vereist. Beroemd willen worden. Iets voor de eerste keer willen ontdekken. In de filosofie werden deze ijdelheden vertaald in de noodzaak om te falsificeren. Volgens de Oostenrijks-Britse filosoof Karl Popper ligt de vooruitgang in de wetenschap in het falsificatieprincipe – de voortdurende wil om eerder gevonden resultaten onderuit te halen. Nog beter voelt het om de eerste te zijn en aan anderen de eer te laten de fouten in je resultaten te ontdekken."
                            },
                            {
                                "example_id": "d9c652a3-de8e-45bd-84e8-115e446390e9",
                                "sense_id": "9b239f7d-2ec5-3d17-aa41-849a88bc6993",
                                "text": "De theorie is dus het zoeklicht waarmee naar de waarneembare wereld wordt gekeken.Dat wordt ook geïllustreerd door de Bijlmerramp. Zonder een acceptabele 'theorie' over de aard en de mate van blootstelling van mensen, was het namelijk niet duidelijk waarnaar gezocht moest worden, en werd het verrichten van metingen/onderzoek als weinig zinvol gezien.Het gaat dus niet om de bevestiging van 'de waarheid' vanuit het waarnemingsmateriaal, maar om het 'falsificeren', het aantonen van 'onwaarheid'. Theorieën zijn daarom ook nooit als 'waar' aan te merken, hoogstens kan er een zekere mate van waarschijnlijkheid aan worden toegekend. Z"
                            }
                        ]
                    },
                    {
                        "sense_id": "4fe0b4e6-f411-366d-909f-c19adb785bbf",
                        "entry_id": "06fb6b77-3c09-3384-a37d-0c3ffe6c1af0",
                        "glosses": [
                            "liegen en bedriegen door te vervalsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b29fce2-dd2a-4017-949c-6e962d6beb7a",
                                "sense_id": "4fe0b4e6-f411-366d-909f-c19adb785bbf",
                                "text": "Het falsificeren van onderzoeksresultaten is de ernstigste vorm van wetenschappelijk wangedrag. De mate waarin het wordt ingezet door medici ter vergroting van hun kansen op de arbeidsmarkt is verontrustend."
                            },
                            {
                                "example_id": "9a39f54f-4929-41bb-a927-983b76a53b81",
                                "sense_id": "4fe0b4e6-f411-366d-909f-c19adb785bbf",
                                "text": "Hoewel falsificeren van wetenschappelijke theorieën de hoeksteen is van de wetenschap, is het falsificeren van onderzoeksresultaten een ernstige vorm wetenschappelijk wangedrag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97253ec1-e8f3-45bb-a4b7-eb504e7c875c",
                        "source_entry_id": "06fb6b77-3c09-3384-a37d-0c3ffe6c1af0",
                        "source_sense_id": "4fe0b4e6-f411-366d-909f-c19adb785bbf",
                        "source_sense_description": "liegen en bedriegen door te vervalsen",
                        "target_lang_word": "falsify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "204d7a9e-1d62-3f21-835d-29fc64491fd4",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To alter so as to make false; especially when done with intent to deceive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62dc4687-9dd9-4412-ae2a-268c6c94d222",
                                                "sense_id": "204d7a9e-1d62-3f21-835d-29fc64491fd4",
                                                "text": "to falsify a record or document"
                                            },
                                            {
                                                "example_id": "721e5794-839f-456d-8961-f64ad1bdc6cd",
                                                "sense_id": "204d7a9e-1d62-3f21-835d-29fc64491fd4",
                                                "text": "The Irish bards use to forge and falsify everything as they list, to please or displease any man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4496491c-9e17-3060-9681-25c8fee761f6",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To misrepresent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a57078e7-c42f-39bc-9d9d-e417b8412394",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To counterfeit; to forge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0623eff9-0c2c-46b9-839b-edf39790d63a",
                                                "sense_id": "a57078e7-c42f-39bc-9d9d-e417b8412394",
                                                "text": "to falsify money"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3fdb69b-3fcc-32b8-ba0e-ef476c81aac2",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To prove to be false."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15dc7dd3-9266-4610-9c3d-f9644d8c39d0",
                                                "sense_id": "d3fdb69b-3fcc-32b8-ba0e-ef476c81aac2",
                                                "text": "By how much better than my word I am, / By so much shall I falsify men's hope."
                                            },
                                            {
                                                "example_id": "55f91269-01b7-4996-b8a2-8a74c6dc08b9",
                                                "sense_id": "d3fdb69b-3fcc-32b8-ba0e-ef476c81aac2",
                                                "text": "Hovv much greater confirmation of his faith vvould he have received, had he ſeen our Saviour's prophecy ſtand good in the deſtruction of the temple, and the diſſolution of the Jevviſh œconomy, vvhen Jevvs and Pagans united all their endeavours under Julian the Apoſtate, to baffle and falſify the prediction?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f1f7f1-7ef1-33e8-a57e-8928d331e4f8",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To show (an item of charge inserted in an account) to be wrong."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa5e4e9-f086-4508-95b1-5d5c4f04436c",
                                                "sense_id": "73f1f7f1-7ef1-33e8-a57e-8928d331e4f8",
                                                "text": "It will allow the account to stand, with liberty to the plaintiff to surcharge and falsify it"
                                            },
                                            {
                                                "example_id": "a0691c05-b6ae-4ecf-bcfd-bc9e33b643db",
                                                "sense_id": "73f1f7f1-7ef1-33e8-a57e-8928d331e4f8",
                                                "text": "The chancery rules governing proceedings to surcharge and falsify accounts are applicable only where an account has been stated between the parties, or where something equivalent thereto has been done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18fdcb2-787a-3575-99de-35148ce97766",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To baffle or escape."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea05043-4895-4d44-aa20-09dd081f0770",
                                                "sense_id": "c18fdcb2-787a-3575-99de-35148ce97766",
                                                "text": "For disputants (as swordsmen use to fence / With blunted foyles) engage with blunted sense; / And as th' are wont to falsify a blow, / Use nothing else to pass upon a foe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a2cede6-2a48-3dd9-95c1-597e50aed9c5",
                                        "entry_id": "89812099-21ce-3130-8cd8-abd9126c5b21",
                                        "glosses": [
                                            "To violate; to break by falsehood."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "405b1bd3-bdfd-40a9-afaf-9fa38b5aa704",
                                                "sense_id": "4a2cede6-2a48-3dd9-95c1-597e50aed9c5",
                                                "text": "to falsify one's faith or word"
                                            },
                                            {
                                                "example_id": "b95a14f5-dacd-41c4-899b-2d065b0f100b",
                                                "sense_id": "4a2cede6-2a48-3dd9-95c1-597e50aed9c5",
                                                "text": "he would not falsify his promise to Philanax",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
