                "senses": [
                    {
                        "sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                        "entry_id": "c8d415be-dd01-363e-99ff-f9b8ff13e55b",
                        "glosses": [
                            "System (unterirdischer) Wasser-Stollen mit Revisionsschächten zur Bewässerung arider und semi-arider Regionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8934a5a-6a17-4b87-a455-9379bbe789b5",
                                "sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                                "text": "In der Oasenlandschaft von Tuat ist eines der Zentren der „Foggara\"-Bewässerung zu erfassen, eines wunderbaren Grundwasser-Systems in unterirdischen Stollen, deren Gefälle geringer ist als das der Landoberfläche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68215f9a-51e6-475b-9c2a-7aa91d1a4c7c",
                        "source_entry_id": "c8d415be-dd01-363e-99ff-f9b8ff13e55b",
                        "source_sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                        "target_lang_word": "qanat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qanat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17add39b-c09e-394c-80e3-f6b24273f6db",
                                        "entry_id": "0ce33a25-f0f7-3be3-9b1a-42cd1a1ad467",
                                        "glosses": [
                                            "An underground conduit, between vertical shafts, that leads water from the interior of a hill to villages in the valley"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c1e80e-2114-475e-9db0-9f14feda366d",
                                                "sense_id": "17add39b-c09e-394c-80e3-f6b24273f6db",
                                                "text": "Shafts are dug to the required level along the planned route of the qanat, every 300 m or so […]."
                                            },
                                            {
                                                "example_id": "f52546ae-4772-45f5-901f-fec3745dcc8d",
                                                "sense_id": "17add39b-c09e-394c-80e3-f6b24273f6db",
                                                "text": "Elsewhere over large areas of the plateau and the foothill regions, the qanat irrigation cultures were weakened considerably."
                                            },
                                            {
                                                "example_id": "d016b129-a8fb-47f8-99cf-c17a6703e26c",
                                                "sense_id": "17add39b-c09e-394c-80e3-f6b24273f6db",
                                                "text": "Its gardens are watered by rivers that invariably flow underground, like the subterranean qanat'''s developed by the Persians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c98ab44-34d0-40cd-acec-f2998516220d",
                        "source_entry_id": "c8d415be-dd01-363e-99ff-f9b8ff13e55b",
                        "source_sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                        "target_lang_word": "kareez",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7105d570-4f2a-4214-ae26-43da5d2e79e9",
                        "source_entry_id": "c8d415be-dd01-363e-99ff-f9b8ff13e55b",
                        "source_sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                        "target_lang_word": "qanat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qanat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a33c98d6-1d66-3471-94e7-0965dcf77114",
                                        "entry_id": "3435c78e-0342-366b-9850-59f78d69eabd",
                                        "glosses": [
                                            "Système d’irrigation souterrain permettant de récolter les eaux d’infiltration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8e321e-7684-4139-b5af-6bd194e0d7fb",
                                                "sense_id": "a33c98d6-1d66-3471-94e7-0965dcf77114",
                                                "text": "Une histoire locale et globale : l’assèchement de l’étang languedocien de Montady au XIIIᵉ siècle apparaît comme la résultante d’une technique bimillénaire, celle des qanats, d’origine orientale et qui s’est propagée à travers les mondes romain et arabe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b832f11d-af85-4270-8cf9-0cc763fb0747",
                        "source_entry_id": "c8d415be-dd01-363e-99ff-f9b8ff13e55b",
                        "source_sense_id": "d27765cc-6621-36e2-ab68-bb771fea53cf",
                        "target_lang_word": "foggara",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foggara",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3be4b9f-827d-3833-967a-46ceaec4a958",
                                        "entry_id": "8fc30c77-6a01-371a-ae1f-8e1bfc078bda",
                                        "glosses": [
                                            "Type de qanat (galerie souterraine destinée à la captation et l’adduction d’eau vers l’extérieur) spécifique au Sahara septentrional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1095d17a-c9d6-452b-9a6c-19b9be27b9c7",
                                                "sense_id": "d3be4b9f-827d-3833-967a-46ceaec4a958",
                                                "text": "Qanats et foggaras restent encore aujourd’hui le mode traditionnel de captage et de distribution de l’eau des nappes au sud de la Méditerranée et en Orient."
                                            },
                                            {
                                                "example_id": "371f877b-df62-4ad6-b293-3648a4a04d32",
                                                "sense_id": "d3be4b9f-827d-3833-967a-46ceaec4a958",
                                                "text": "Les foggaras (appelés kattara ou goutte-à-goutte au Maroc) sont des galeries de la taille d’un homme, creusées sous la surface du désert. La pente est de l’ordre de 3 à 5 % maximum."
                                            },
                                            {
                                                "example_id": "0859d415-d986-4428-96b4-b78a3af08a17",
                                                "sense_id": "d3be4b9f-827d-3833-967a-46ceaec4a958",
                                                "text": "les foggaras miraculeux puits jumeaux\nremontent l’eau du tréfonds des sables\nlà où bat le sang intime de l’Afrique"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
