                    {
                        "sense_id": "c4d64705-7206-3be3-842f-bd6f14d03be3",
                        "entry_id": "5e3ba549-39f1-39e4-a90f-a251a21bcad0",
                        "glosses": [
                            "Stimmabgabe zu einer Wahl per Post"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5613a74-647c-4710-9271-2e08bb69e3f3",
                                "sense_id": "c4d64705-7206-3be3-842f-bd6f14d03be3",
                                "text": "In Deutschland ist die Briefwahl ohne Vorliegen besonderer Gründe erlaubt, obwohl sie den Grundsatz der geheimen Wahl einschränkt."
                            },
                            {
                                "example_id": "0d4d7e4f-ef32-4da0-b27f-05cda7460917",
                                "sense_id": "c4d64705-7206-3be3-842f-bd6f14d03be3",
                                "text": "„Innenminister Wolfgang Sobotka (ÖVP) will jedenfalls Reformen bei der Briefwahl andenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
