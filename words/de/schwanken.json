                    "frequency": "High",
                    "semantic_group_id": "veraenderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Temperaturen in den Bergen <w>schwanken</w> zwischen Tag und Nacht oft sehr stark."
