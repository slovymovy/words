                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ea7d7c-5a58-459e-ba4c-c77e934de819",
                                                "sense_id": "278edd49-908c-35ea-b31a-d37008cd50e2",
                                                "text": "a farther paſſion feeds my thoughts,\nWith ceaſeleſſe and diſconſolate conceits,\nWhich dies my lookes so liueleſſe as they are,\nAnd might, if my extreames had ful euents,\nMake me the gaſtly counterfeit of death."
                                            }
