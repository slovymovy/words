                "senses": [
                    {
                        "sense_id": "e9962f01-e205-3672-9c73-288261320055",
                        "entry_id": "576ee865-f4f5-341b-ad46-8485b6b8ca0f",
                        "glosses": [
                            "Sport collectif pratiqué au Val d’Aoste, dans lequel il faut, grâce à une massette emmanchée, projeter le plus loin possible une petite balle de bois ou de métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdd5b31-174c-4ee6-96a0-b1f42a7f1114",
                                "sense_id": "e9962f01-e205-3672-9c73-288261320055",
                                "text": "À Pollein, vous pouvez vous détendre ou faire du sport dans la zone équipée « Grand-Place », une zone d’environ 10 hectares avec de grands espaces verts où vous pouvez vous allonger et prendre le soleil et où, surtout le week-end, vous pouvez assister à la pratique de sports populaires tels que le tsan et la rebatta."
                            },
                            {
                                "example_id": "a94f2621-356e-4053-ae2f-d4d3153d8863",
                                "sense_id": "e9962f01-e205-3672-9c73-288261320055",
                                "text": "Le jeu de la rebatta voit s'affronter deux équipes de 5 joueurs, chacun desquels dispose de 20 lancers (batua ou tsachà)."
                            },
                            {
                                "example_id": "cfdf06f0-d216-43d3-b80b-eaad47c99776",
                                "sense_id": "e9962f01-e205-3672-9c73-288261320055",
                                "text": "L’attachement très fort de ses habitants aux traditions vaut à Jovençan la pratique intense du sport populaire de la rebatta."
                            }
                        ]
                    },
                    {
                        "sense_id": "e89777b7-def8-3582-aace-052421ed1f9f",
                        "entry_id": "576ee865-f4f5-341b-ad46-8485b6b8ca0f",
                        "glosses": [
                            "Balle utilisée pour ce jeu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01fa38d1-1bbe-4018-8d02-941a0cb15807",
                                "sense_id": "e89777b7-def8-3582-aace-052421ed1f9f",
                                "text": "La victoire est déterminée par la somme des points obtenus (1 point tous les 15 mètres) lors des lancers individuels de la rebatta, petite balle en bois (en général en racine de buis - 28 mm de diamètre et un poids de 25/40 g), couverte de clous en laiton ou en fer et peinte en blanc pour la repérer dans l’herbe. … La rebatta est frappée avec une batte appelée masetta ou maciocca, composée de deux parties assemblées entre elles : la partie finale (maciocca) est un prisme en bois dur pressé qui s’encastre dans un bâton en bois (bâton)."
                            }
                        ]
                    }
