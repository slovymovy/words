                    },
                    {
                        "translation_id": "cec3270b-62dd-4ba1-8a87-7e9ce7e0f21b",
                        "source_entry_id": "ad715dfe-1dde-310a-a9f9-dbad8f6ccc94",
                        "source_sense_id": "1579d786-b695-38ea-a39d-620a4f64801f",
                        "source_sense_description": "vordere Fläche",
                        "target_lang_word": "surface avant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a381dbaa-bbc8-4959-a833-ed5d6dd307b2",
                        "source_entry_id": "ad715dfe-1dde-310a-a9f9-dbad8f6ccc94",
                        "source_sense_id": "1579d786-b695-38ea-a39d-620a4f64801f",
                        "source_sense_description": "vordere Fläche",
                        "target_lang_word": "façade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "façade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Un des côtés d’un bâtiment, d’un édifice, lorsqu’il se présente au spectateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b4ef35-09ce-495f-ab03-0877bf6f4a4b",
                                                "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                                "text": "Les quatre façades de la maison close brûlaient en même temps et celle qui bordait le pont Saint-Michel vomissait des flammes par toutes les ouvertures."
                                            },
                                            {
                                                "example_id": "12827f0f-7f4c-43e7-b9be-28dca4200737",
                                                "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                                "text": "Manuelle Gautrand, elle, propose des structures en verre massif, conçues à partir de façades vitrées recyclées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Le côté où se trouve l'entrée principale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a61e9c-0003-453c-9124-be6d16b4468e",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Sur la rue, la maison présentait cette façade de moellons ravalée en plâtre, ondée par le temps et rayée par le crochet du maçon de manière à figurer des pierres de taille."
                                            },
                                            {
                                                "example_id": "7841dc13-c7c2-4f0b-a5dc-23d11c07d991",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                                            },
                                            {
                                                "example_id": "c67dd768-30d8-47c8-b987-6eb518171a06",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Sa maison était propre, bien tenue; elle tranchait avec la blancheur gaie de sa façade et le luisant de ses meubles, sur les taudis immondes où, d’ordinaire, croupissent dans la fange et dans la vermine, les marins bretons."
                                            },
                                            {
                                                "example_id": "0cfcd752-016a-42f9-8fa7-09f618403a04",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Mon hôtel, en façade sur l’une des principales voies, a vraiment noble allure : des portiers corrects gardent son huis."
                                            },
                                            {
                                                "example_id": "46f99b43-1c6e-4afe-bec8-52abe8d16f28",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "[…], et une peinture sous verre, fixée sur la façade, représentait une femme appétissante aux yeux noirs qui, frileusement, s’emmitouflait de fourrures."
                                            },
                                            {
                                                "example_id": "34a19efa-4aa8-4ee6-97ea-f392ba9042fb",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Émile vit dans une ville, petite, quiète, une ville aux rues propres, aux trottoirs nets et les façades des maisons rénovées, […]."
                                            },
                                            {
                                                "example_id": "fe6c9ee2-2c0f-41c4-bdef-73246f71455e",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Aussi, je me cachai derrière la première, à l’angle de la rue, dotée d’un gazon envahi par les mauvaises herbes et d’un grand lantana aux fleurs rouge et jaune couvertes de poussière qui luttait sur la façade contre un chèvrefeuille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32153450-c54d-357f-9e48-4fed44bbb6fe",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Face des murs en contact avec l’extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627ca1ee-9c46-48c1-aa18-ade524d9305b",
                                                "sense_id": "32153450-c54d-357f-9e48-4fed44bbb6fe",
                                                "text": "Isolation des façades d’une maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Apparence qui trompe sur la réalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8370328e-f328-41cd-af5e-71be8c11c228",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Talent qui n’est qu’en façade."
                                            },
                                            {
                                                "example_id": "aa996b3a-0d5c-4a9f-89b5-45e4d8bbe787",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Cet homme est tout en façade."
                                            },
                                            {
                                                "example_id": "754e8062-43e4-4c7f-a7d5-26ce3c0c8fbf",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Derrière une satisfaction de façade, voter cette motion dut être pénible à beaucoup de sénateurs à une époque où l’avènement de Claude demeurait une blessure ouverte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
