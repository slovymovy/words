                                        "sense_id": "aafcab5d-8d1c-3987-972d-4ed48fd2733e",
                                        "entry_id": "0bfdc56f-826c-343c-901f-ce60e274f2e5",
                                        "glosses": [
                                            "heftige Immunreaktion auf normalerweise harmlose Substanzen oder Umweltstoffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf7d150-51f1-4bce-a641-91296ec109ff",
                                                "sense_id": "aafcab5d-8d1c-3987-972d-4ed48fd2733e",
                                                "text": "Die verbreitetste Allergie ist der Heuschnupfen."
                                            },
                                            {
                                                "example_id": "1c4989b1-9423-4f8c-9bae-80532d079a5c",
                                                "sense_id": "aafcab5d-8d1c-3987-972d-4ed48fd2733e",
                                                "text": "„Frauen leiden daher häufiger an Allergien und an Autoimmunerkrankungen – an der Schilddrüsenerkrankung Morbus Basedow etwa, bei der sich eigene Antikörper gegen Schilddrüsengewebe richten, erkranken Frauen etwa achtmal häufiger als Männer.“"
                                            },
                                            {
                                                "example_id": "b011723b-0d28-4802-aac1-b967539bbe81",
                                                "sense_id": "aafcab5d-8d1c-3987-972d-4ed48fd2733e",
                                                "text": "„Obwohl nur etwa drei Prozent aller Bundesbürger nachweislich an Allergien leiden, glaubt inzwischen fast jeder, gegen irgendetwas allergisch zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
