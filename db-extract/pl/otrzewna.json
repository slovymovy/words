                "senses": [
                    {
                        "sense_id": "79befd0b-b5eb-379f-83ad-4c40c221bedc",
                        "entry_id": "5513388f-1461-399e-8e1b-da7f524887f7",
                        "glosses": [
                            "błona surowicza wyścielająca jamę brzuszną i jamę miednicy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d846b3ce-5853-4b13-9e55-a30ebc75c6e3",
                                "sense_id": "79befd0b-b5eb-379f-83ad-4c40c221bedc",
                                "text": "Chyba właśnie rozciął otrzewną, miał krew na rękach, a z otworu brzusznego wystawały kiszki. Widziałem olbrzymią ilość krwi, wypływającej z ciała na blat stołu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55fd630a-cda2-4843-a152-8a7c39b626eb",
                        "source_entry_id": "5513388f-1461-399e-8e1b-da7f524887f7",
                        "source_sense_id": "79befd0b-b5eb-379f-83ad-4c40c221bedc",
                        "target_lang_word": "peritoneum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peritoneum",
