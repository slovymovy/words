                        "examples": [
                            {
                                "example_id": "40a7c17c-aa70-4d99-b963-0021c53bb7fa",
                                "sense_id": "ea193e9c-de17-30cc-967e-e040af38eba6",
                                "text": "Kronfeld describes the narcists as “mostly reserved, tender, often delicate cool natures who love solitude and are literally self-sufficient.”"
                            },
                            {
                                "example_id": "b6f2f65e-48e8-4526-ab4c-e9d0d65fe12e",
                                "sense_id": "ea193e9c-de17-30cc-967e-e040af38eba6",
                                "text": "Experts in matters analytic speak of Napoleon as a narcist, but he was too much more than that to be measured in the cup of mere vanity."
                            },
                            {
                                "example_id": "ff7420ba-94c0-4d2c-8d5d-499ab40d53f6",
                                "sense_id": "ea193e9c-de17-30cc-967e-e040af38eba6",
                                "text": "Many narcists seem to build all their love energy into the life ambition to stamp their will upon the world."
                            }
                        ]
                    }
