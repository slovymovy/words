                                "target_lang_word": "Silly Point",
                                "target_lang_sense_clarification": "Fachbegriff im Cricket für eine sehr nahe Position"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9238ccb-5c3e-3132-aec7-103dde117658",
                    "sense_definition": "Absurdly or ridiculously large, especially regarding price.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid a <w>silly</w> price for that vintage car at the auction.",
                            "target_lang_translations": {
                                "ru": "Он заплатил <w>бешеную</w> цену за тот винтажный автомобиль на аукционе.",
                                "tr": "Müzayedede o klasik araba için <w>çılgın</w> bir fiyat ödedi.",
                                "de": "Er hat bei der Auktion einen <w>wahnsinnigen</w> Preis für diesen Oldtimer gezahlt."
                            }
                        },
                        {
                            "text": "The company spent a <w>silly</w> amount of money on unnecessary office decorations.",
                            "target_lang_translations": {
                                "ru": "Компания потратила <w>несусветную</w> сумму денег на ненужные украшения для офиса.",
                                "tr": "Şirket, gereksiz ofis dekorasyonlarına <w>saçma</w> miktarda para harcadı.",
                                "de": "Die Firma hat eine <w>absurde</w> Menge Geld für unnötige Bürodekoration ausgegeben."
                            }
