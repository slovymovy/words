                    "sense_definition": "rozrzucić nasiona na dużym obszarze w celu uprawy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
