                        "sense_id": "cbc89800-eaf5-3203-a9d9-9041814c14d6",
                        "entry_id": "94278d54-0b94-376c-9241-4fa2e7de1958",
                        "glosses": [
                            "drie zaken of personen samen als ondeelbaar geheel voorgesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c0ea51-e6b0-4d1b-be4e-cbd16f11668c",
                                "sense_id": "cbc89800-eaf5-3203-a9d9-9041814c14d6",
                                "text": "Om de week spraken Genie, Jetfighter en ik af in een lokaal café om te ontbijten en de trailroddels door te nemen. We waren geen vaste trailfamilie, maar wel een sterke drie-eenheid die elkaar steeds opzocht."
                            }
                        ]
