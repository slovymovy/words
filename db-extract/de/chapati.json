                "senses": [
                    {
                        "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                        "entry_id": "4c07a032-11b4-3996-837f-bf5e0b474f4b",
                        "glosses": [
                            "ungesäuertes Fladenbrot aus Vollkornmehl verschiedener Getreidesorten"
                        ],
                        "tags": [
                            "indische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "c10acace-6287-4f57-b084-90070f136647",
                                "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                                "text": "Die Urform aller indischen Brote sind Chapatis."
                            },
                            {
                                "example_id": "05189664-755e-4f44-8b9b-76ca2c55eeae",
                                "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                                "text": "Durch Völkerwanderung brachten es die Inder einst nach Ostafrika und noch heute wird Chapati in Teilen Kenias, Tansanias oder Ugandas gern gegessen sowie dort auch als einheimisches Essen bezeichnet."
                            },
                            {
                                "example_id": "3b56462f-f2fe-4716-8231-7250e61872a7",
                                "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                                "text": "Chapatis werden zu indischem Essen gereicht, und zusammengerollt wie eine Art Löffel für Fleisch und Gemüse benutzt."
                            },
                            {
                                "example_id": "2f6de577-dee2-4513-af87-53d2ba318baa",
                                "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                                "text": "Wenn das Chapati in ungebackenem Zustand nicht ganz dünn und flach gedrückt war, würde es im Feuer ungleichmäßig gar werden."
                            },
                            {
                                "example_id": "ebdc9277-bf7a-461b-b5be-81bc427e75e5",
                                "sense_id": "d614c210-d8ac-3aa2-a84c-a776a19ee3df",
                                "text": "Sobald sich auf der Oberseite des Chapatis kleine Bläschen bilden und sich die Ränder nach innen wölben mit einer Küchenzange wenden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44135fc6-1bf5-48aa-89ce-8759e3d26287",
