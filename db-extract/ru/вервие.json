                                "example_id": "1dbefe48-f43a-48e1-8627-24561d2bb18c",
                                "sense_id": "5b6248c9-beb5-3343-afb0-6f1757219292",
                                "text": "Было в ней что-то от утверждения, что верёвка есть вервие простое."
                            }
                        ]
                    }
