                    {
                        "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                        "entry_id": "372b89b0-9845-33f8-88a4-e4e3f6d55813",
                        "glosses": [
                            "Crazy."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e06c39e4-92f4-4a28-99b0-fc9144f4d72f",
                                "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                                "text": "It's Cottontail Smith, and he's gone plumb loco!"
                            },
                            {
                                "example_id": "eeeae456-124c-436c-bfbc-97d2a8ebf625",
                                "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                                "text": "Going loco down in Acapulco / If you stay too long / Yes, you'll be going loco down in Acapulco / The magic down there is so strong"
                            },
                            {
                                "example_id": "f6ce3938-4c83-4619-b146-59bb9335dcc9",
                                "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                                "text": "Who you trying to get crazy with ése? Don't you know I'm loco?"
                            },
                            {
                                "example_id": "9f17c080-a8b6-4e4e-a359-8236af17ffe8",
                                "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                                "text": "Holla in New York, fo'sho they'll tell you I'm loco"
                            },
                            {
                                "example_id": "ec1af19c-9555-4173-b37d-15989be6ad4f",
                                "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                                "text": "You know, I’m a little loco. Kinda crazy, zany guy."
                            }
                        ]
                    },
