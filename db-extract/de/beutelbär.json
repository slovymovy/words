                        "glosses": [
                            "im weiteren Sinne auch für die verwandten Wombats (Familie Vombatidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b793f0-56bd-43d6-8e34-f1ffc3d9e8a0",
                                "sense_id": "86f525c5-b992-378c-a4e0-318a834f8050",
                                "text": "„Der Wombat (ein Beutelbär), ist ebenso vertreten wie zahlreiche Känguru-Arten.“"
                            }
