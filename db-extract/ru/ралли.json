                                "target_senses": [
                                    {
                                        "sense_id": "29343dfe-e47f-37a7-8765-bca1fa3c0139",
                                        "entry_id": "2a45a23a-75fe-3059-a605-8778b0458860",
                                        "glosses": [
                                            "Veranstaltung, die nicht auf einer Rennstrecke, sondern in mehreren Etappen auf abgesperrten Straßen und Wegen ausgetragen wird"
                                        ],
                                        "tags": [
                                            "Motorsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bfdd982-f708-437f-8493-a55dc5aef315",
                                                "sense_id": "29343dfe-e47f-37a7-8765-bca1fa3c0139",
                                                "text": "Die Rallye führt quer durch die Wüste."
                                            },
                                            {
                                                "example_id": "f6f100a3-acc4-460f-84c5-8c61b7808c8f",
                                                "sense_id": "29343dfe-e47f-37a7-8765-bca1fa3c0139",
                                                "text": "Die Rallye führt über befestigte Straßen, aber auch über Nebenstrecken."
                                            },
                                            {
                                                "example_id": "b06b2ab4-949d-422f-8573-62737e091fa4",
                                                "sense_id": "29343dfe-e47f-37a7-8765-bca1fa3c0139",
                                                "text": "„Wir verabredeten uns in Douz, am Rand der Wüste, wo die Rallye und ihre Entourage übernachten wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6e72029-508b-3035-88e2-6fc5e240fb7b",
                                        "entry_id": "2a45a23a-75fe-3059-a605-8778b0458860",
                                        "glosses": [
                                            "meist kurzer, aber starker Kursanstieg an der Börse"
                                        ],
                                        "tags": [
                                            "Börsenwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91187e0a-a497-4542-ada9-bab9f88bb19c",
                                                "sense_id": "e6e72029-508b-3035-88e2-6fc5e240fb7b",
                                                "text": "„Tatsächlich markierte das Edelmetall im September 2011 in einer frenetischen Rallye ein Rekordhoch bei 1900 Dollar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
