            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21578c2f-87a6-3fef-ac21-8a415dbb751a",
                    "sense_definition": "łączyć dwie części zamka błyskawicznego lub zapinać coś za pomocą suwaka",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na mróz zawsze dokładnie <w>zasuwam</w> ciepłą kurtkę.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на мороз я всегда тщательно <w>застёгиваю</w> тёплую куртку."
                            }
                        },
                        {
                            "text": "Dziecko z trudem <w>zasuwa</w> zamek błyskawiczny w swoim nowym plecaku.",
                            "target_lang_translations": {
                                "ru": "Ребёнок с трудом <w>застёгивает</w> молнию на своём новом рюкзаке."
                            }
                        }
                    ],
                    "synonyms": [
                        "zapinać",
                        "spinać"
                    ],
                    "antonyms": [
                        "rozsuwać"
                    ],
                    "common_phrases": [
                        "zasuwać zamek"
                    ],
                    "target_lang_definitions": {
                        "ru": "застёгивать на молнию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застёгивать",
                                "target_lang_sense_clarification": "молнию"
                            },
                            {
                                "target_lang_word": "затягивать",
                                "target_lang_sense_clarification": "застёжку-молнию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "181d39b2-1eea-3327-98b1-587f1ed866d9",
                    "sense_definition": "przesuwać coś w celu zakrycia, odgrodzenia lub zamknięcia jakiejś przestrzeni",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy robi się ciemno, gospodyni starannie <w>zasuwa</w> grube zasłony w salonie.",
                            "target_lang_translations": {
                                "ru": "Когда темнеет, хозяйка аккуратно <w>задёргивает</w> плотные шторы в гостиной."
                            }
                        },
                        {
                            "text": "Wieczorem zawsze <w>zasuwamy</w> rolety, aby nikt nie zaglądał do mieszkania.",
                            "target_lang_translations": {
                                "ru": "Вечером мы всегда <w>задвигаем</w> жалюзи, чтобы никто не заглядывал в квартиру."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakrywać",
                        "zasłaniać"
                    ],
                    "antonyms": [
                        "odsuwać",
                        "rozsuwać"
                    ],
                    "common_phrases": [
                        "zasuwać zasłony",
                        "zasuwać rolety"
                    ],
                    "target_lang_definitions": {
                        "ru": "задвигать, задёргивать что-либо для закрытия или отгораживания пространства"
