                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c7989d-02a5-4573-aefe-bc07846d11a0",
                                "sense_id": "aaf3c2d7-cef4-3a73-b357-c666d2f9e60a",
                                "text": "„Die Kriegsanstrengungen beherrschten das tägliche Leben.“"
                            },
                            {
                                "example_id": "6a97539c-060d-4ad7-9622-2c8039c84cf0",
                                "sense_id": "aaf3c2d7-cef4-3a73-b357-c666d2f9e60a",
                                "text": "„Tipus Allianz mit den Franzosen gab den Briten in Indien den Vorwand, ihre kostspieligen Kriegsanstrengungen gegen ihn gegenüber dem Direktorium in London zu rechtfertigen, das stets zur Sparsamkeit mahnte.“"
                            },
                            {
                                "example_id": "1c9dcab8-415f-49b2-b40c-2697783f8089",
                                "sense_id": "aaf3c2d7-cef4-3a73-b357-c666d2f9e60a",
                                "text": "„Sie war noch nie in Belgrad gewesen, und sie wollte die Kriegsanstrengungen unterstützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
