                                    {
                                        "sense_id": "f202691d-f2ef-3212-8725-fa6af4a5a5e6",
                                        "entry_id": "20cc1c00-117c-3559-866f-756d9a5fc574",
                                        "glosses": [
                                            "A person who writes polemics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                        "entry_id": "20cc1c00-117c-3559-866f-756d9a5fc574",
                                        "glosses": [
                                            "A person who puts forward controversial views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032fe3ff-daed-4a3e-a5d7-b5a722d2c1a5",
                                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                                "text": "The choice is between a polemicist with deep ties to the alt-right movement, or a conventional policy professional with an open channel to the political establishment that Trump ran against, but which he needs to pass an agenda."
                                            },
                                            {
                                                "example_id": "a9e7fee5-cfa9-42fe-96b1-b2fe3d298116",
                                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                                "text": "You know Ann describes herself as a polemicist..."
                                            },
                                            {
                                                "example_id": "3dcf2839-b1c6-4a08-8647-90c03b90a3c3",
                                                "sense_id": "d41337a2-0bc1-3c9f-b08a-80bade435e9c",
                                                "text": "A similar impulse sometimes accompanies my reading of the work of Christopher F. Rufo, a fellow at the Manhattan Institute and one of the most gifted conservative polemicists of his generation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
