                "senses": [
                    {
                        "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                        "entry_id": "d0a0ae52-5e2c-316c-878e-bff2f78ef6c9",
                        "glosses": [
                            "Einschränkung/Verlust der Fahrtüchtigkeit durch plötzliches, meist hörbares Entweichen von Luft wegen Beschädigung des Schlauchs (Teil des Reifens)"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "010b9072-6b69-4143-b486-4bba28d34a08",
                                "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                                "text": "„Nach dreißig Kilometern brutaler Waschbrettpiste verabschiedete sich mein hinterer Reifen mit einer Knallpanne.“"
                            },
                            {
                                "example_id": "dbfec57d-6b14-4bcf-87b9-4737c9dcc21d",
                                "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                                "text": "„Kurz vor dem Ziel hatte das Auto zu allem Unglück eine Knallpanne und mein barfüßiger Chauffeur wechselte in aller Ruhe das Rad.“"
                            },
                            {
                                "example_id": "2502751c-7714-4e54-9e24-df37706b1de1",
                                "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                                "text": "„Am nächsten Tag müssen wir wieder einmal zu AVIS, denn aus dem linken Vorderreifen wölbt sich eine Beule – Auswechseln ist notwendig, um eine Knallpanne zu vermeiden.“"
                            },
                            {
                                "example_id": "7c8cd360-def4-4f9e-a357-b1b8ba1e5936",
                                "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                                "text": "„Wenige Kilometer nach dem Ortsausgangsschild Schwerin knallte es plötzlich. Wir hatten den ersten Platten zu beklagen. Kaum war der behoben, gab es nach ein paar Kilometern die nächste Knallpanne.“"
                            },
                            {
                                "example_id": "2cbaefd9-5d8c-485b-9a83-bdee2f2a7cbe",
                                "sense_id": "a6388dd5-c284-3cbe-952a-72806ce59bd8",
                                "text": "„Vermutlich wegen einer Knallpanne kam ein Autofahrer kurz nach 12 Uhr auf der A 20, Höhe Abzweig Altentreptow, mit seinem Firmenwagen von der rechten Spur nach links ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
