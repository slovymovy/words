                                "example_id": "b4ce7a7a-fa8d-4c34-b390-ccd11fb4c0fd",
                                "sense_id": "0a4506a0-1131-3024-a618-b3b9face9b06",
                                "text": "Ze liet haar nagels lakken door een manicure."
