                {
                    "sense_id": "541122be-805b-3f32-bbf9-dcecf537c578",
                    "sense_definition": "Action de secourir et d'arracher des personnes à un danger imminent ou mortel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "secours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont réussi le <w>sauvetage</w> des habitants pris au piège par l'incendie."
                        },
                        {
                            "text": "Chaque passager du bateau doit porter un gilet de <w>sauvetage</w> pendant la traversée."
                        }
                    ],
                    "synonyms": [
                        "secours"
                    ],
                    "common_phrases": [
                        "gilet de sauvetage",
                        "bouée de sauvetage",
                        "opération de sauvetage",
                        "canot de sauvetage"
                    ]
                },
                {
                    "sense_id": "1c573897-5240-3d03-80ac-2473dd06067a",
                    "sense_definition": "Action de récupérer ou de préserver un navire, des biens ou des marchandises menacés de destruction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a immédiatement entamé le <w>sauvetage</w> du navire échoué près de la côte rocheuse."
                        },
                        {
                            "text": "Le <w>sauvetage</w> des œuvres d'art a permis de préserver des toiles inestimables après l'inondation."
                        }
                    ],
                    "synonyms": [
                        "récupération"
                    ],
                    "common_phrases": [
                        "sauvetage de la cargaison"
                    ]
                },
                {
                    "sense_id": "7a533bc6-c0ad-3dab-8a98-cadbcf4672f3",
                    "sense_definition": "Au baseball, action pour un lanceur de terminer le match en conservant l'avance de son équipe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le lanceur a réussi un <w>sauvetage</w> décisif en éliminant les trois derniers frappeurs adverses."
                        },
                        {
                            "text": "Grâce à ce nouveau <w>sauvetage</w>, il a permis à son équipe de remporter la victoire finale."
