                                "target_senses": [
                                    {
                                        "sense_id": "185426d8-d48e-32d6-8297-01c18c95035f",
                                        "entry_id": "788805e1-7204-33f0-9ba2-29d8e09f2617",
                                        "glosses": [
                                            "Curved or bulged outward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f74740be-6660-441e-8992-f9330ecf96ab",
                                                "sense_id": "185426d8-d48e-32d6-8297-01c18c95035f",
                                                "text": "In fact, what these gibbous human shapes specially represented was ready money—money insistently ready [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e40fca17-cd31-3808-9f52-037bd2c9d4e5",
                                        "entry_id": "788805e1-7204-33f0-9ba2-29d8e09f2617",
                                        "glosses": [
                                            "Having more than half (but not the whole) of its disc illuminated."
                                        ],
                                        "tags": [
                                            "of a celestial body"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f8a06f7-fc90-44b6-a5e4-2d64abba286b",
                                                "sense_id": "e40fca17-cd31-3808-9f52-037bd2c9d4e5",
                                                "text": "The moving moon, full, gibbous, or crescent-shaped, shone at last for the navigators of the eighteenth century like a luminous hand on the clock of heaven."
                                            },
                                            {
                                                "example_id": "c84357a0-0c5d-4910-bfaf-68a7d78bbe22",
                                                "sense_id": "e40fca17-cd31-3808-9f52-037bd2c9d4e5",
                                                "text": "On December 7, 1972, the Apollo 17 astronauts took a photograph of a gibbous Earth at a distance of eighteen thousand miles from its surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7ec783-e974-3e81-9c95-398dd14f9773",
                                        "entry_id": "788805e1-7204-33f0-9ba2-29d8e09f2617",
                                        "glosses": [
                                            "Humpbacked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8cf39c-a922-456c-9df5-08b256706c50",
                                                "sense_id": "7d7ec783-e974-3e81-9c95-398dd14f9773",
                                                "text": "A pointed flinty rock, all bare and black,\nGrew gibbous from behind the mountain's back;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
