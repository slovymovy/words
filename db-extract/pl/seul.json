                                        "glosses": [
                                            "hlavní město Jižní Koreje"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82fe1466-3ba6-31da-8e93-b387f7c0e504",
                                        "entry_id": "4f1d4031-1b25-388c-806c-5922c9f58ca7",
                                        "glosses": [
                                            "političtí zástupci Jižní Koreje"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80649ff4-de11-4a4b-8447-e931da7a38c1",
                                                "sense_id": "82fe1466-3ba6-31da-8e93-b387f7c0e504",
                                                "text": "Americký prezident Donald Trump severokorejskému režimu pohrozil „ohnivou zlobou“ a Soul se obává, že by se mohl uchýlit k preventivnímu úderu na KLDR."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8d445b0-9d43-4fcf-819e-8a14796f4099",
                        "source_entry_id": "6c3edc73-6c89-32ab-8c7b-5ba5ee4e00b7",
                        "source_sense_id": "17609f65-7f3f-3d6a-8b8b-a20bb0e86c86",
                        "target_lang_word": "Séoul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Séoul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7be3237e-40d5-3dce-9305-d333fc355f99",
                                        "entry_id": "961efb71-a395-3f06-977b-3202a40877e1",
                                        "glosses": [
                                            "Ville et capitale de la Corée du Sud, et de l’ancien royaume de Corée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e539f5-b0be-4011-90f5-6e75436580d0",
                                                "sense_id": "7be3237e-40d5-3dce-9305-d333fc355f99",
                                                "text": "Une lettre très-intéressante au point de vue des progrès de la mission est celle de Mgr Ferréol, évêque de Belline et vicaire apostolique de Corée, à M. Barran, directeur du séminaire des Missions étrangères, datée de Séoul, capitale de la Corée, le 24 novembre 1847."
                                            },
                                            {
                                                "example_id": "9097c447-6ca7-4379-8c87-d509c1292782",
                                                "sense_id": "7be3237e-40d5-3dce-9305-d333fc355f99",
                                                "text": "Après cinq ans à la tête de la Corée du Sud, l’ex-président Moon Jae-in aspirait à une retraite paisible dans un petit village, loin du tumulte de Séoul."
                                            },
                                            {
                                                "example_id": "779bc3ec-f9de-4671-84e0-68005a839ce3",
                                                "sense_id": "7be3237e-40d5-3dce-9305-d333fc355f99",
                                                "text": "Sa nomination a été annoncée sur la scène du LG Arts Center de Séoul, où le danseur, ovationné, venait d’interpréter pour la seconde fois le rôle d’Albrecht dans le ballet romantique de Jean Coralli et Jules Perrot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "962fa1c3-ce61-34e4-aa6c-cca243ccd07c",
                                        "entry_id": "961efb71-a395-3f06-977b-3202a40877e1",
                                        "glosses": [
                                            "Le gouvernement de Corée du Sud."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ef69fc-13d3-404b-ac71-e1f4ec2dca66",
                                                "sense_id": "962fa1c3-ce61-34e4-aa6c-cca243ccd07c",
                                                "text": "En ce qui concerne l'interception, Séoul peut compter sur six batteries Patriot PAC-2 GEM-T achetées d'occasion à l'Allemagne (qui devraient bénéficier d'une rénovation au standard PAC-3) et, à terme, sur 136 missiles Patriot PAC-3 […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
