                                "target_senses": [
                                    {
                                        "sense_id": "a39518b9-9fcd-32dd-a2ad-8c4b21e2e728",
                                        "entry_id": "50626c61-aced-3c04-93bd-3c97019af763",
                                        "glosses": [
                                            "eine Auswahl treffend und deshalb nur bestimmt Dinge betreffend, die den Auswahlkriterien entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959334fa-b182-4ae3-958f-687c4a5bcc38",
                                                "sense_id": "a39518b9-9fcd-32dd-a2ad-8c4b21e2e728",
                                                "text": "Und dies, obwohl das deutsche Schulsystem im Hinblick auf die Differenzierung leistungsstärkerer und —schwächerer Schüler am selektivsten ist."
                                            },
                                            {
                                                "example_id": "5e6f0909-076e-4d0a-be2a-5297a577fb1b",
                                                "sense_id": "a39518b9-9fcd-32dd-a2ad-8c4b21e2e728",
                                                "text": "Er hat von den Vorgängen leider nur eine selektive Wahrnehmung, er nimmt nur zur Kenntnis, was er auch sehen möchte."
                                            },
                                            {
                                                "example_id": "c8b8faf7-a99a-4cdb-a9bc-f7cb7aa9107d",
                                                "sense_id": "a39518b9-9fcd-32dd-a2ad-8c4b21e2e728",
                                                "text": "Bei dem Medikament handelt es sich um einen selektiven Serotonin-Wiederaufnahmehemmer."
                                            },
                                            {
                                                "example_id": "3e5197ad-ac28-43eb-a7ca-748b1188a738",
                                                "sense_id": "a39518b9-9fcd-32dd-a2ad-8c4b21e2e728",
                                                "text": "Dexmedetomidin ist ein sehr effektiver und hoch selektiver α-2-Adrenorezeptoragonist (8× selektiver als Clonidin) mit hoher sedierender Wirkkomponente."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765ac2d1-29f3-4dd7-af46-9d5d9caa8eb8",
                        "source_entry_id": "24e59c0e-6f2f-314b-a12e-e3300de65642",
