                "senses": [
                    {
                        "sense_id": "ac7bc1f8-59d4-378e-b522-3d808892bd0a",
                        "entry_id": "0e8a9511-7245-33ae-a816-8c56972308b9",
                        "glosses": [
                            "schoenen met hoge hakken dragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bee37d0-3493-4902-a3fd-fc1fa13bd4e6",
                                "sense_id": "ac7bc1f8-59d4-378e-b522-3d808892bd0a",
                                "text": "Hooggehakt, op platte stappers, kek gerokt of in skinny broek,"
                            },
                            {
                                "example_id": "b98a9e04-ba33-47d0-9f52-b9db56157079",
                                "sense_id": "ac7bc1f8-59d4-378e-b522-3d808892bd0a",
                                "text": "Maar onbewust houdt ze er toch de hele tijd rekening mee. „Ik let op wat ik eet, ik kan niet meer sporten zoals ik gewend was en als ik hooggehakt op de set loop, probeer ik tussendoor af en toe te zitten”."
                            }
                        ]
                    },
                    {
                        "sense_id": "90c64990-88ea-3051-802a-2051fba887f2",
                        "entry_id": "0e8a9511-7245-33ae-a816-8c56972308b9",
                        "glosses": [
                            "van schoenen dat deze hoge hakken hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358cb982-1653-490f-a2c3-8749dff627aa",
                                "sense_id": "90c64990-88ea-3051-802a-2051fba887f2",
                                "text": "Laatst zag ik een foto van de hooggehakte schoenen van Humphrey Bogart, die hij buiten beeld dragen moest om langer te lijken dan zijn tegenspeelster."
                            }
                        ]
                    }
