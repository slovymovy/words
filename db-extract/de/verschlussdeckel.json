                "senses": [
                    {
                        "sense_id": "e46c851a-9990-383d-8551-08f4058bc875",
                        "entry_id": "e9a37ba6-1dce-341f-a6d1-8e7555d1add0",
                        "glosses": [
                            "Deckel, der dazu dient, etwas (ein Behältnis) zu verschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2c7f33-254d-485d-9007-0e4552aa268f",
                                "sense_id": "e46c851a-9990-383d-8551-08f4058bc875",
                                "text": "„Decken Sie anschließend die Gläser ab, ohne den Verschlussdeckel fest zuzudrehen.“"
                            },
                            {
                                "example_id": "1f33ffd5-444d-4661-ab8d-4ef2954e171a",
                                "sense_id": "e46c851a-9990-383d-8551-08f4058bc875",
                                "text": "„Da ich die Trinkflasche sehr häufig benutze, war es mir zudem wichtig, dass sie sich gut reinigen lässt – eine breite Öffnung und ein separater Verschlussdeckel sind dafür hilfreich.“"
                            },
                            {
                                "example_id": "e1c600c3-b5c1-44bd-b468-80bc8e209f9a",
                                "sense_id": "e46c851a-9990-383d-8551-08f4058bc875",
                                "text": "„Es handelt sich hier um einen Verschlussdeckel einer Einfüllöffnung für einen Wassertank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
