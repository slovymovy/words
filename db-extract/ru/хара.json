                "senses": [
                    {
                        "sense_id": "195c07a7-c076-3be4-9e7f-18c80d1bbc52",
                        "entry_id": "eb743b3a-b7c3-3f33-8831-52eb87d72938",
                        "glosses": [
                            "подводное растение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebed0fc-d0a8-4023-9b9d-adca5c9fe22f",
                                "sense_id": "195c07a7-c076-3be4-9e7f-18c80d1bbc52",
                                "text": "Хара образует на дне как бы толстый матрац. Лишь кое-где видны светлые прогалины заиленного песка. Да и кусты хары покрыты хлопьями ила."
                            }
                        ]
                    }
                ],
