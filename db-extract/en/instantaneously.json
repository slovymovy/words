                                        "glosses": [
                                            "D’une manière instantanée, soudaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f674d3a-ab81-4432-a772-cafedda7ed6a",
                                                "sense_id": "8170d845-d662-31c5-bcc5-b03d45d62688",
                                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (…) devinrent instantanément un feu d’artifice où les illustrations et les titres de colonnes s’enlevaient comme des fusées et éclataient comme des bombes."
                                            },
                                            {
                                                "example_id": "1c465aab-6f0d-465a-b694-3a9f89ac3bb1",
                                                "sense_id": "8170d845-d662-31c5-bcc5-b03d45d62688",
                                                "text": "Instantanément les rats se laissèrent tomber du grillage et se jetèrent sur la nourriture."
                                            },
                                            {
                                                "example_id": "c970e1b3-ac2c-4f05-8c71-d618488ddb67",
                                                "sense_id": "8170d845-d662-31c5-bcc5-b03d45d62688",
                                                "text": "Il existe aujourd'hui des masques de soudeur automatiques pour un prix d'environ 100 € qui s’opacifient instantanément lorsque l’arc électrique se produit ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
