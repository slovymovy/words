                        "entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                        "glosses": [
                            "A virgin consecrated to Vesta, and to the service of watching the sacred fire, which was to be perpetually kept burning upon her altar; a vestal virgin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "615ab5b0-b4d5-3a56-aa64-d883db6d3fd0",
                        "entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                        "glosses": [
                            "A female virgin; a woman who has never had sexual relations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "33e85714-8e67-355e-b9fb-8ea7ad67ed7a",
                        "entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                        "glosses": [
                            "A nun."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c253190-16c9-484f-b28d-7d0879c125ba",
                        "source_entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                        "source_sense_description": "female virgin",
                        "target_lang_word": "де́вственница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "де́вственница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88ed3e8f-ad64-3244-a3b2-0ec58b3764d2",
                                        "entry_id": "cf42db6d-9fd7-3ffa-8342-80bdc54434c3",
                                        "glosses": [
                                            "девушка, женщина, не имевшая половых сношений, сохраняющая невинность, целомудрие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf7dc4d-a867-4be0-a2b5-ea2cb6470aab",
                                                "sense_id": "88ed3e8f-ad64-3244-a3b2-0ec58b3764d2",
                                                "text": "И не то чтоб я в самом деле много жил, много изведал, много выстрадал… нет, я чувствую, что в этом отношении я ещё свеж и непорочен, как девственница, и между тем сознаю, что душа моя действительно огрубела, а в сердце царствует преступная вялость."
                                            },
                                            {
                                                "example_id": "708fc1ef-353a-43ba-b899-678b04b3c2ea",
                                                "sense_id": "88ed3e8f-ad64-3244-a3b2-0ec58b3764d2",
                                                "text": "Как Марья Павловна была вполне целомудренная девственница, так Ранцева была вполне целомудренная мужняя жена-женщина."
                                            },
                                            {
                                                "example_id": "ba42746e-37f1-475c-9631-286e0dd2c759",
                                                "sense_id": "88ed3e8f-ad64-3244-a3b2-0ec58b3764d2",
                                                "text": "Когда они стали делать настойку из этой плаценты или из самого зародыша и впрыскивали в кровь небеременным или даже девственницам, у последних начинали развиваться грудные железы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
