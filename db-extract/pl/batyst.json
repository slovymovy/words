                ],
                "senses": [
                    {
                        "sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "glosses": [
                            "cienka, prawie przezroczysta tkanina lniana, bawełniana lub jedwabna, o splocie płóciennym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d053ceb-a38a-422d-819c-6b2b2719116c",
                                "sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                                "text": "Na łożu, usłanym z całym przepychem batystów i haftów, (…) leżała postać kobieca, na wpół już ogarnięta sztywnością śmierci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec88b4b9-0007-4440-aeac-838406acb303",
                        "source_entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "source_sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "target_lang_word": "cambric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cambric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                        "entry_id": "bd8e89b0-781d-3d1a-972d-7b0032395b48",
                                        "glosses": [
                                            "A finely-woven fabric made originally from linen but often now from cotton."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eebd4cf0-f220-4e17-b4d7-31379ccbaacb",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "Could a Taff'ta ſcarf, a long Eſtridge vvhing, / A ſtiffe Iron Doublet, and a Brazeel Pole / Tempt thee from Cambrick ſheets, fine active Thighs, / From Caudles vvhere the precious Amber ſvvims?"
                                            },
                                            {
                                                "example_id": "2ac48999-ea71-4178-ae0d-e5f0c0fef65d",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "Scotch cambric, now largely manufactured, is a kind of imitation cambric, made from fine hard-twisted cotton."
                                            },
                                            {
                                                "example_id": "20624729-bd1a-4c84-b143-c58cc3f252c7",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "His upper tunic was of white cambric, as fine as a handkerchief, so that the bright red tunic beneath it showed through."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5710a8f-2469-4379-beca-8d5d2288d29e",
                        "source_entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "source_sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "target_lang_word": "chambray",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e54d947e-93c2-3459-acb4-45905f5c0663",
                                        "entry_id": "2a991c95-0c62-3cfa-9b45-2f28cd378b1c",
                                        "glosses": [
                                            "A soft fabric woven with a white weft and coloured warp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7479a54-5715-478d-923f-b21bd3744da1",
                                                "sense_id": "e54d947e-93c2-3459-acb4-45905f5c0663",
                                                "text": "She lies wrapped in a book muslin bedgown, a chambray gauze shift, and a french net nightcap."
                                            },
                                            {
                                                "example_id": "04036464-8bc8-4cff-a49a-48761f0201ff",
                                                "sense_id": "e54d947e-93c2-3459-acb4-45905f5c0663",
                                                "text": "I had bought some jeans and a couple of blue chambray workshirts to replace the kitchen-whites, but such clothes weren't nearly enough."
                                            },
                                            {
                                                "example_id": "0369a19f-3859-4202-89d0-c06cbdd56125",
                                                "sense_id": "e54d947e-93c2-3459-acb4-45905f5c0663",
                                                "text": "Always, the relentless bass of hip-hop blasting in rooms of nautical-themed furnishings, faded driftwood, gingham upholstery, linen and chambray."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d2e980e-bfe7-4056-9c90-2977cb3db9d8",
                        "source_entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "source_sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "target_lang_word": "batiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "batiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                        "entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                                        "glosses": [
                                            "Espèce de toile de lin ou de chanvre très fine et d’un tissu très serré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e892189-5219-493c-8278-18e245f4ce9a",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Mademoiselle de Langeais ouvrit la boîte, y trouva un mouchoir de batiste très-fine, souillé de sueur."
                                            },
                                            {
                                                "example_id": "25b7c230-26d5-4065-ac5f-f38785bf6e60",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Une des recherches de leur luxe est encore d’avoir un très beau mouchoir de batiste brodé garni de dentelles."
                                            },
                                            {
                                                "example_id": "7464e816-3998-4b88-a106-a8127225dc48",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Il appuya sa tête livide sur l’épaule de la jeune femme, et ses doigts crispés se cramponnèrent, en la déchirant, à la fine batiste brodée qui couvrait d’un flot de gaze le corps de Marguerite."
                                            },
                                            {
                                                "example_id": "3077a50c-123e-40e9-b4e4-31cfbce53251",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Ses doigts passionnés éprouvaient des jouissances physiques à courir sur les satins, à toucher les crêpes, à caresser les velours, à se perdre dans les flots laiteux des fines batistes."
                                            },
                                            {
                                                "example_id": "8f9a6583-5de5-41d1-a792-6745922dc787",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Les nuées se déchirèrent comme un voile de batiste, et les flots joyeux du soleil inondèrent la montagne entièrement repeinte à neuf."
                                            },
                                            {
                                                "example_id": "6ed464ef-dc0b-453e-959b-c22751bd705c",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Elle chiffonne toujours dans sa main un petit mouchoir de batiste…"
                                            },
                                            {
                                                "example_id": "419cdd3d-4afd-4e6a-bcb3-2fb243d5b554",
                                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                                "text": "Étendue sur le lit de batiste, vêtue d’une légère combinaison de soie, la señorita Lynch était d’une beauté interminable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a9579b8-5e96-4124-bf0e-6548b90c373d",
                        "source_entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "source_sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "target_lang_word": "Batist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Batist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                        "entry_id": "a2f4cc51-14af-3de1-ba22-bf41596c1b65",
                                        "glosses": [
                                            "sehr feinfädiges Gewebe, meist aus Baumwolle oder Leinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15a94e9-f3b2-47c6-b3bb-dc8418be8270",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "Sie trug ein Nachthemd aus Batist."
                                            },
                                            {
                                                "example_id": "af896e69-b716-44b0-9b2d-6a79fcbc36ca",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "„Seine Gattin Väsele Li trug – es war Sommer – ihr Haar aufgebunden und mit silbernen Fäden durchflochten und Ohrringe aus Rosenquarz in Goldfassung, dazu ein taubenfarbenes ungefüttertes Jäckchen und ein Röckchen aus weißem Batist, das mit einer längs gestreiften Borte eingefaßt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "013396a2-0941-45b0-9823-acd3f294d3c1",
                        "source_entry_id": "f8c0f7d9-dc18-393f-a75c-6f34d2c70662",
                        "source_sense_id": "984efb3a-0d0f-3aa9-8cdb-29759ca5b6e1",
                        "target_lang_word": "батист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "батист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "65245a28-2033-3eee-b7da-79f9e2828940",
                                        "entry_id": "8b5459df-80f3-3500-8c93-4ea07b160be0",
                                        "glosses": [
                                            "текст. тонкая, полупрозрачная льняная или хлопчатобумажная ткань, вырабатываемая из крученой пряжи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4236ffe9-0399-4b66-a482-a52bce35a1c0",
                                                "sense_id": "65245a28-2033-3eee-b7da-79f9e2828940",
                                                "text": "На этом торгу продаются только одни остатки, начиная от дорогого бархата до самых дешёвых тафтяных лент, от воздушных газов и индийской кисеи до толстого миткаля и тридцатикопеечных ситцев, от мягкого, шелковистого терно до грубого фриза и от белоснежного батиста до простой посконной холстины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63bec5d-7e85-3036-a9cf-f9066d98668d",
                                        "entry_id": "8b5459df-80f3-3500-8c93-4ea07b160be0",
                                        "glosses": [
                                            "текст. изделия из такой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0e2278-1857-487a-8f30-a62527f2d45c",
                                                "sense_id": "d63bec5d-7e85-3036-a9cf-f9066d98668d",
                                                "text": "Лиза под окном в зале шила себе серенькое платье из сурового батиста; было утро знойного дня; со стола только что убрали завтрак, и в зале было совершенно тихо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2625beb-1d0a-3aa5-9b6e-2f41b5088dac",
                                        "entry_id": "8b5459df-80f3-3500-8c93-4ea07b160be0",
                                        "glosses": [
                                            "перен. предмет роскоши, дорогой ткани, богатства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bda8aef-29a4-4c65-ba6a-d82ae1917312",
                                                "sense_id": "b2625beb-1d0a-3aa5-9b6e-2f41b5088dac",
                                                "text": "Ему всякий день завивали волосы пуклями, которые спускались до плеч, водили его в шелку, в батисте, в бархате, в перьях и в соболях по Невскому проспекту."
                                            },
                                            {
                                                "example_id": "54d278c5-045a-487a-afa3-d808a4fe2adb",
                                                "sense_id": "b2625beb-1d0a-3aa5-9b6e-2f41b5088dac",
                                                "text": "Он с рождения, я думаю, упал в батист и кружева."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9d066b-32e3-32ab-b3ad-3fffbf4a0442",
                                        "entry_id": "8b5459df-80f3-3500-8c93-4ea07b160be0",
                                        "glosses": [
                                            "перен., поэт. то, что нежностью или цветом напоминает такую ткань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339a07fb-253e-4f0e-868c-5d8f6a3ce691",
                                                "sense_id": "1f9d066b-32e3-32ab-b3ad-3fffbf4a0442",
                                                "text": "Но белей и свежей кисеи и батиста миловидное личико Дуни, самокатного жемчуга краше перловые зубы, камней самоцветных светлее синие очи…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26da7f96-ba7b-3fd8-872f-43ce1fd234de",
                                        "entry_id": "8b5459df-80f3-3500-8c93-4ea07b160be0",
                                        "glosses": [
                                            "разг. батистовый платок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6f72bc-4004-4bd7-8b58-0f633012575e",
                                                "sense_id": "26da7f96-ba7b-3fd8-872f-43ce1fd234de",
                                                "text": "Бригадный генерал слезы батистом утирает, полковой командир ручкой отмахивается, батальонный уж и смеху лишился ― только хрюкает."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
