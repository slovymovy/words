                        "glosses": [
                            "относящийся к объектам, названным в честь императорских особ с именем Мария: императриц Марии Фёдоровны или Марии Александровны, или великой княгини Марии Николаевны; связанный с этими объектами"
                        ],
                        "tags": [],
