                "senses": [
                    {
                        "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                        "entry_id": "cbefa2ef-388f-3138-9280-d266334bd19d",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d6b45dd-c46f-49da-81e3-85c91b6ccb1c",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Frau Ahern ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a6569015-e209-44bf-94e6-d98f2f65ed85",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Herr Ahern wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd763385-1a9e-4418-81d9-b1d1f06e86bc",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Die Aherns fliegen heute nach Dublin."
                            },
                            {
                                "example_id": "5b40e794-9312-4db3-9c18-2ad8bae085d3",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Der Ahern trägt nie die Pullover, die die Ahern ihm strickt."
                            },
                            {
                                "example_id": "a067b2d9-24c9-4cd8-b744-822b47160396",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ahern kommt, geht der Herr Ahern.“"
                            },
                            {
                                "example_id": "9f431126-d3ec-4b97-8ce3-8ebf81d60feb",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Ahern kommt und geht."
                            },
                            {
                                "example_id": "8d1a1d45-9d0d-4eae-a630-59d62a8b990f",
                                "sense_id": "f8ebe20c-8bec-3407-bea1-3efba77fd906",
                                "text": "Aherns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
