                        ],
                        "examples": [
                            {
                                "example_id": "9776fd30-fb89-47f6-8491-ce100c5a3be4",
                                "sense_id": "32dd34f9-224d-3a4f-9d5f-2669a0156e53",
                                "text": "Les méninges minces sur le lobe occipital, plus épaisses à la partie antérieure présentent des opalescences le long des scissures."
                            },
                            {
                                "example_id": "190c9b02-193a-42fb-a0c7-0e274d333147",
                                "sense_id": "32dd34f9-224d-3a4f-9d5f-2669a0156e53",
                                "text": "On procède immédiatement au barbotage dans une solution d'acétate de plomb; il se produit rapidement une opalescence laiteuse par précipitation de carbonate de plomb, puis deux minutes environ après l'injection, le liquide opalescent vire au gris, puis au brun très clair (café au lait)."
                            }
                        ]
                    }
