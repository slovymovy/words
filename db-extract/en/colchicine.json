                                            {
                                                "example_id": "869d68b0-d16e-4dcd-bd9f-cc032cf7d561",
                                                "sense_id": "e0d2fef1-19b5-3006-81b0-d5085413820d",
                                                "text": "Colchicine is een ontstekingsremmende stof die oorspronkelijk werd gewonnen uit herfsttijloos, een bolgewas uit de leliefamilie dat toevallig nu overal in bloei staat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f339b0-8155-3f6d-b70f-84041fc3a55c",
                                        "entry_id": "e7e4f205-be59-3d7d-9b3b-40262004e083",
                                        "glosses": [
                                            "uit herfsttijloos Colchicum gewonnen alkaloïde",
                                            "ontstekingsremmend middel dat helpt tegen jicht en hartkwalen, maar bij iets hogere dosering al giftig kan zijn; vroeger ook wel gebruikt tegen kanker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b445386-e171-49a1-a33f-51bb78793c46",
                                                "sense_id": "74f339b0-8155-3f6d-b70f-84041fc3a55c",
                                                "text": "Colchicine is een ontstekingsremmende stof die oorspronkelijk werd gewonnen uit herfsttijloos, een bolgewas uit de leliefamilie dat toevallig nu overal in bloei staat."
                                            },
                                            {
                                                "example_id": "4860ad95-b288-4b1c-bc3b-906f16d1ec34",
                                                "sense_id": "74f339b0-8155-3f6d-b70f-84041fc3a55c",
                                                "text": "De onderzoekers koppelden het ANP-gen aan een ander gen dat de cellen resistent maakt tegen de ontstekingsremmer colchicine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d4ddb8-4a30-3ba6-8bce-ce792684f7a1",
                                        "entry_id": "e7e4f205-be59-3d7d-9b3b-40262004e083",
                                        "glosses": [
                                            "uit herfsttijloos Colchicum gewonnen alkaloïde",
                                            "stof gebruikt om polyploïde planten te produceren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea090188-89e4-4e27-a6e1-74da15ff0974",
                                                "sense_id": "a9d4ddb8-4a30-3ba6-8bce-ce792684f7a1",
                                                "text": "Colchicine is een ontstekingsremmende stof die oorspronkelijk werd gewonnen uit herfsttijloos, een bolgewas uit de leliefamilie dat toevallig nu overal in bloei staat."
                                            },
                                            {
                                                "example_id": "71267d3f-6c22-491a-8840-0f81ce7a6e24",
                                                "sense_id": "a9d4ddb8-4a30-3ba6-8bce-ce792684f7a1",
                                                "text": "Steichen bewerkte zijn riddersporen in de jaren dertig met colchicine, waardoor hij het aantal chromosomen van de plant kon verdubbelen."
                                            }
                                        ]
                                    }
                                ]
                            }
