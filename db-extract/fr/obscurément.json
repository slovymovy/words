        "fr-extract.jsonl": [
            {
                "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                "word": "obscurément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c56fa3cc-383f-3795-8083-acccf9b015bf",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "Sans clarté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872729c0-4512-4112-a973-798445bab439",
                                "sense_id": "c56fa3cc-383f-3795-8083-acccf9b015bf",
                                "text": "La nuit approchait, on ne voyait les objets qu’obscurément."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd7372fd-936e-3523-b966-2dbceaa0a638",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "D’une manière brune, foncée, en parlant de teintes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb45d5a4-c0d2-43df-8898-62c6408eb840",
                                "sense_id": "bd7372fd-936e-3523-b966-2dbceaa0a638",
                                "text": "Le dessus du dos, de la tête et des ailes est d’un brun obscurément teint de verdâtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "044a9574-0289-34f0-9e4b-ed9975b722d0",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "D’une manière à peine visible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6c3884-e269-488f-a93d-0d58714d742a",
                                "sense_id": "044a9574-0289-34f0-9e4b-ed9975b722d0",
                                "text": "À son origine, le cœur n'est qu’une vésicule obscurément contractile."
                            }
                        ]
                    },
                    {
                        "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "D’une manière peu intelligible."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4656f77c-e436-4b45-b981-c91bbf66a98d",
                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                "text": "L'enfant […] devinait obscurément que le monsieur, si bizarrement apparu, n'était pas comme les autres et elle songeait à quelque père Noël, les poches pleines de jouets et de friandises."
                            },
                            {
                                "example_id": "4cd88769-12a7-47ab-8d02-736a9760c336",
                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                "text": "Quoi ! mon père tantôt parlait obscurément."
                            },
                            {
                                "example_id": "2e3ef304-8759-4df0-bd54-6e9eccd8182c",
                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                "text": "Si le temps [du Messie] eût été prédit obscurément."
                            },
                            {
                                "example_id": "71809037-e818-4040-b677-e2662696a886",
                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                "text": "Dans cette grammaire, dont l’objet ne paraissait pas devoir effrayer les âmes pieuses, les phrases citées par l’auteur pour exemples de ses préceptes étaient une suite d’assertions obscurément impies contre l’existence de Dieu, la spiritualité de l’âme, et les autres vérités que la religion nous oblige de croire."
                            },
                            {
                                "example_id": "8fa29675-30f0-4b0d-906f-7d8b959c762c",
                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                "text": "Dois-je, au lieu de Laharpe, obscurément écrire : C’est ce petit rimeur, de tant de prix enflé."
                            }
                        ]
                    },
                    {
                        "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "Sans renom, sans éclatin."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bbf65fbc-fbca-45de-a6c6-19a70fd54fb5",
                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                "text": "Il dévore en secret ses sentiments d’humanité, il gémit obscurément sur la nature humaine."
                            },
                            {
                                "example_id": "1899bbf1-6e3c-452a-ab8d-99bed7ae601c",
                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                "text": "Rien n'est si désagréable que d’être pendu obscurément."
                            },
                            {
                                "example_id": "f4d4a7dc-75c8-4d63-9207-e4cc732bbb6f",
                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                "text": "Le bonheur, cet objet de nos désirs, mais qui fuit et repousse la grandeur et les richesses, serait-il donc obscurément attaché à la médiocrité en tout genre ?"
                            },
                            {
                                "example_id": "d384fc11-b51e-40ff-9a03-d4f0b29296ef",
                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                "text": "Soldat obscurément utile, Je ne partageais les lauriers Ni de Saxe, ni de Belle-Isle."
                            },
                            {
                                "example_id": "3ed2cab0-1e44-4122-828d-cba57ee93f29",
                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                "text": "Dans les bras d’une épouse chérie Je goûte obscurément les doux fruits de ma vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "glosses": [
                            "D’une manière mal éclaircie, qui n'est pas bien certaine."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "28d7e549-fcd5-456e-b4c1-fae5be9977cd",
                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                "text": "Obscurément plongé dans ce doute cruel, Mes yeux, chargés de pleurs, se tournaient vers le ciel."
                            },
                            {
                                "example_id": "b36b43cf-98e3-45e6-b391-474353d96f2c",
                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                "text": "Il se répandit obscurément de tous côtés que les Malais, qui seuls avaient des relations avec ces contrées, avaient porté du girofle et de la muscade dans plusieurs marchés."
                            },
                            {
                                "example_id": "3755de5c-ac60-45eb-92d2-0c1983bbabc2",
                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                "text": "L'empereur flattait encore obscurément une espérance qu’il n'avait pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54515b34-0e2c-41e3-b139-5565fd62159d",
                        "source_entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "target_lang_word": "darkly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darkly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c93e4e71-d329-3be3-aa41-f435e34fd30a",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "With insufficient light for easy discernment or comprehension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da240e03-4e63-41d5-bd48-2a4407ea627e",
                                                "sense_id": "c93e4e71-d329-3be3-aa41-f435e34fd30a",
                                                "text": "I could make out his image darkly."
                                            },
                                            {
                                                "example_id": "49c17782-b6a2-485b-bc3f-7ba156f54b39",
                                                "sense_id": "c93e4e71-d329-3be3-aa41-f435e34fd30a",
                                                "text": "For now we ſee through a glaſſe darkley: but then face to face: now I know in part, but then ſhall I know euen as alſo I am knowen."
                                            },
                                            {
                                                "example_id": "c67dab31-bcc5-4904-8a07-d90bcb5db029",
                                                "sense_id": "c93e4e71-d329-3be3-aa41-f435e34fd30a",
                                                "text": "With his hands behind his back he walked through the echoing rooms. In the reddish mist his shadow flitted darkly across the mirrors on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "With a dark appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f0fa18-1b1c-4800-af5c-f9c1972ee91a",
                                                "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                                                "text": "And still when loudliest howls the storm, / And darkliest lowers his native sky, / The king's fierce soul is in that form, / The warrior's spirit threatens nigh!"
                                            },
                                            {
                                                "example_id": "2bafd940-2995-4e1d-a652-eb8084fc2e69",
                                                "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                                                "text": "Darkly painted machinery takes a great deal of light out of a shop; the rays seem to be absorbed into the somber pigments."
                                            },
                                            {
                                                "example_id": "98d47045-5230-45d3-be52-4bc9bb049150",
                                                "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                                                "text": "Cerro Colorado is composed of granitic rocks covered with a dark-colored desert varnish. The Sierra Cucapa are a lighter reddish-brown and lie in the background on the far side of Laguna Salada. They are also covered with a patina of desert varnish but not as darkly as the surface of Cerro Colorado. […] A minor weathering feature of the desert is a thin, shiny, reddish-brown to blackish coating called desert varnish that occurs on some desert rocks."
                                            },
                                            {
                                                "example_id": "de078a98-2818-4fbf-a544-4b288ab80d16",
                                                "sense_id": "6e0a099d-5be2-32c5-8bd0-ab833f086bf8",
                                                "text": "He saw how the candlesticks shone darkly in the vicinity of the diamond flames in Shevele's ears and on her silk dress collar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcee74a4-50aa-325c-9138-8ee211423f06",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a manner which is not readily visible or noticeable; inconspicuously."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "defdd6ec-cdb5-4895-b96a-091c6c260e72",
                                                "sense_id": "dcee74a4-50aa-325c-9138-8ee211423f06",
                                                "text": "Set defenses permitted a coach to plan an attack with scant worry as to where he would find the offensive men. So our Tom Reilly schemed darkly and came up with the attack which pried apart the Brown Bowlers. His scheme was to double team every man in the defensive line by employing one back as an eighth lineman and spreading the enemy further by posting a wingback outside the strong end of an unbalanced line which had five men on this side of center."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0057759e-43e2-3ec0-89c2-e4ceeb34e669",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a manner which retards or prevents discernment; clandestinely."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c451c134-35d3-41ad-944b-6b05c1cff634",
                                                "sense_id": "0057759e-43e2-3ec0-89c2-e4ceeb34e669",
                                                "text": "His secret wooing of the Norman lady who was so proud and stately was very dear to him, and the romance of it pleased him even more than the mere material joys he hoped some day to gain from it. Proud as she was, womanlike she at least deigned to listen to him, and his crafty brain schemed darkly to take opportunity as it came, and make her his own by treachery."
                                            },
                                            {
                                                "example_id": "f387bb3a-56bc-46a8-b970-70054ea095ea",
                                                "sense_id": "0057759e-43e2-3ec0-89c2-e4ceeb34e669",
                                                "text": "As for thee, false friend, subtle fox, unfaithful servant, this long time am I grown weary of thee slinking up and down my palace devising darkly things I know not: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6cee52-e7ae-38c8-af77-82e55d3816a2",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a manner which is difficult to understand, or which retards or prevents understanding; incomprehensibly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ba2ef69-fe5a-46a9-bf54-ab6ecd3e25e1",
                                                "sense_id": "4b6cee52-e7ae-38c8-af77-82e55d3816a2",
                                                "text": "Secondly, The Covenant was then revealed more darkly and obſcurely, but now the diſpenſation of it, is more cleare and evident: the light is now marvellous, it is as the Sunne ſhining at noone-day. […] Though it was revealed before, yet it was but darkly, but now it is revealed more clearly ſince the coming of our Saviour Chriſt; […]"
                                            },
                                            {
                                                "example_id": "4c4b581c-62f8-4d26-a5ae-39ea53ab7b41",
                                                "sense_id": "4b6cee52-e7ae-38c8-af77-82e55d3816a2",
                                                "text": "Strange friend, past, present, and to be, / Loved deeplier, darklier understood; / Behold I dream a dream of good / And mingle all the world with thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "973faae9-85a1-302c-966d-9cc2111abb51",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a manner which tends to produce uncertainty or confusion; bewilderingly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc790c15-7bfe-4c92-b2e3-58b6054e9e85",
                                                "sense_id": "973faae9-85a1-302c-966d-9cc2111abb51",
                                                "text": "Here, as Genevieve sat musing, in apparent slumber, on her situation of peril, and her hope of liberty, her sentinels, who had hitherto walked at a surly distance from her, now chanced to pass nearer; and she heard one of them say, “She sleeps, thou need'st not whisper; -I tell thee it must be done to-night.” “What must be done?” said his companion, “for hitherto thou hast spoken thy purpose darkly.”—“The queen must be removed this night,” said the other. “Here have been missives from the bishop, who, amid the thunders of the siege, found leisure to receive and answer the letters of King Philip, touching the matter of the queen's thraldom, and to send the order thou wottest of, and which must be suddenly obeyed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabc4039-d377-305a-9fec-3761f358dafa",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a manner which produces an inward conviction of future misfortune; ominously."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df08438-dad4-4767-86b0-415a9a851029",
                                                "sense_id": "eabc4039-d377-305a-9fec-3761f358dafa",
                                                "text": "But the God I had cried to answer me / When my destiny darkliest frowned, / And He showed me a reef of rocks in the sea, / Whereunto I clung, and there I found / On a coral jag the goblet of gold, / Which else to the lowermost crypt had rolled."
                                            },
                                            {
                                                "example_id": "9aff7c73-00a7-464d-ab6a-c41859bce875",
                                                "sense_id": "eabc4039-d377-305a-9fec-3761f358dafa",
                                                "text": "Certain portions of the conversation of the talkative old clerk, which had wearied me at the time, now recurred to my memory with a new significance; and a suspicion crossed my mind darkly, which had not occurred to me while I was in the vestry."
                                            },
                                            {
                                                "example_id": "948c38a2-d4c4-4cd7-89ca-7f95d76a7edd",
                                                "sense_id": "eabc4039-d377-305a-9fec-3761f358dafa",
                                                "text": "Pierrot the photographer is utterly mute; always lurking darkly in the background and probing unwanted with his camera, he is the \"foreboding presence\" in this film [La Nuit américaine (Day for Night, 1973) by François Truffaut], as the television actor was in Domicile conjugal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e172b458-5211-37e7-bcb1-47842f928204",
                                        "entry_id": "ef2ae498-4cf5-319f-aa6b-1f204ed7b421",
                                        "glosses": [
                                            "In a morbid manner; morbidly, sinisterly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105e69f6-7429-45bc-9e5e-411e71f15fb9",
                                                "sense_id": "e172b458-5211-37e7-bcb1-47842f928204",
                                                "text": "a darkly comic dystopian drama"
                                            },
                                            {
                                                "example_id": "528dd8d2-8e0f-467d-8ab3-8aa34b2a3cd2",
                                                "sense_id": "e172b458-5211-37e7-bcb1-47842f928204",
                                                "text": "There was a laughing Devil in his sneer, / That raised emotions both of rage and fear; / And where his frown of hatred darkly fell, / Hope withering fled—and Mercy sighed farewell!"
                                            },
                                            {
                                                "example_id": "06705ffb-3c0d-4c4a-b347-ecd45de24321",
                                                "sense_id": "e172b458-5211-37e7-bcb1-47842f928204",
                                                "text": "By visible evidence, this Saturday morning is a comparatively placid one. Earlier in the week a young man had died after being stabbed in a flat, and from the overpass at Archway Road, darkly referred to as “suicide bridge,” another man had jumped to his death."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "darkly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7247ee23-5674-314f-a428-c70df9495331",
                                        "entry_id": "3c9cfa8f-a418-3436-bb54-396d47a853c3",
                                        "glosses": [
                                            "Relating to darkness or obscurity."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1207974c-d6bb-41b0-b8d0-9ef884529684",
                                                "sense_id": "7247ee23-5674-314f-a428-c70df9495331",
                                                "text": "A Scanner Darkly"
                                            },
                                            {
                                                "example_id": "9b6da23f-ffa9-48e2-87d6-c2f86e5d1c6d",
                                                "sense_id": "7247ee23-5674-314f-a428-c70df9495331",
                                                "text": "Earth's noblest sons are schooled in hut and cell,\nAs purest gems in darkliest caverns dwell."
                                            },
                                            {
                                                "example_id": "f5c709d5-d57a-4f49-8365-8abf71fa1800",
                                                "sense_id": "7247ee23-5674-314f-a428-c70df9495331",
                                                "text": "A clue of lilies was I bid to find,\nWhere the green alleys most obscurely wind;\nWhere tall oaks darkliest canopy o'erhead,\nAnd moss and violet make the softest bed; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fea0314d-54c3-40ea-b59d-85b7f1243cd3",
                        "source_entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                        "target_lang_word": "obscurely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscurely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc74b32-0630-3787-a50c-ab9a2c287de1",
                                        "entry_id": "e7ddb9ff-c12b-384d-b3b9-b8be9cfb5dc1",
                                        "glosses": [
                                            "In an obscure manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135cd012-e99a-4f6b-b443-90687976e111",
                                                "sense_id": "5dc74b32-0630-3787-a50c-ab9a2c287de1",
                                                "text": "I vvill this Night, / in ſeuerall Hands, in at his VVindovves throvv, / As if they came from ſeuerall Citizens, / VVritings, all tending to the great opinion / That Rome holds of his Name: vvherein obſcurely / Cæſars Ambition ſhall be glanced at."
                                            }
