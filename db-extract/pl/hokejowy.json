                                        "entry_id": "822aaa40-f057-349a-9d27-8a808c8defc8",
                                        "glosses": [
                                            "Field hockey, a team sport played on a pitch on solid ground where players have to hit a ball into a net using a hockey stick."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea4d808-2a1c-4b20-b0e5-6d1efd8659ae",
                                                "sense_id": "e4f8d943-cdaa-326c-83c9-0af7f8780849",
                                                "text": "He helped his team beat the opponent at hockey 11-9 in a high-scoring match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5de0101-aa13-3d19-a005-778e82989c75",
                                        "entry_id": "822aaa40-f057-349a-9d27-8a808c8defc8",
                                        "glosses": [
                                            "Ice hockey, a game on ice in which two teams of six players skate and try to score by shooting a puck into the opposing team's net, using their sticks."
                                        ],
