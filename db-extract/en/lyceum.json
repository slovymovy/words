                        "target_lang_word": "Aula",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aula",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                        "entry_id": "77e17830-34fc-3d46-a1d4-eebbb62b3aaf",
                                        "glosses": [
                                            "Raum für besondere Veranstaltungen und Versammlungen (besonders in Schulen und Universitäten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d2da25-c399-4d26-967b-8b9b1a1a7067",
                                                "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                                "text": "Die Antrittsvorlesung findet in der Aula der Universität statt."
                                            },
                                            {
                                                "example_id": "95d72731-355b-4ee6-acaa-091572ee561a",
                                                "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                                "text": "„In Berlin war ich auf eine Mädchenschule gegangen – ein großer, grauer Kasten mit vier Stockwerken, Aula, Turnhalle und vielen Klassenzimmern an langen Fluren.“"
                                            },
                                            {
                                                "example_id": "f3aafcb9-0166-486a-89f6-7f255b485b09",
                                                "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                                "text": "„Es waren nur ein paar Zweitklässlerinnen, die die Köpfe zusammensteckten und tuschelten, als Minh mit seiner Großmutter und der Puppe den Gang entlang zur Aula eilte.“"
                                            },
                                            {
                                                "example_id": "80fe07a6-9ba3-4b8d-8dd0-bcee7ad568b4",
                                                "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                                "text": "„Die Aula war überfüllt, das Rauchverbot wurde lustvoll übertreten, Bierflaschen kreisten, Papierflieger aus den Flugblättern der Konkurrenz durchbrachen die gegnerischen Linien.“"
                                            },
                                            {
                                                "example_id": "3639bcf9-3e01-4302-b6dc-5feb55bccb0f",
                                                "sense_id": "242df735-ecc0-304d-b374-cc4cb392c38e",
                                                "text": "„Eines Tages 1951, also ein Jahr vor dem Abitur meiner Klasse, wurden wir in die Aula zusammengetrommelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1141f670-4435-3ab3-be74-b325f3c34acc",
                                        "entry_id": "77e17830-34fc-3d46-a1d4-eebbb62b3aaf",
                                        "glosses": [
                                            "freier, hofähnlicher Platz in großen griechischen und römischen Häusern der Antike"
                                        ],
                                        "tags": [],
