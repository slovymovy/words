                "senses": [
                    {
                        "sense_id": "8918cc0d-2f12-3a4f-8535-8a0936cf4cd4",
                        "entry_id": "f40d9973-fe1e-3540-bf07-46dee4f17d6f",
                        "glosses": [
                            "Célèbre médecin grec, dit le père de la médecine, et qui vivait au Vᵉ siècle avant l’ère chrétienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1ce6a0-9647-44c0-8206-99e9dee57114",
                                "sense_id": "8918cc0d-2f12-3a4f-8535-8a0936cf4cd4",
                                "text": "Hippocrate dit oui, mais Galien dit non."
                            },
                            {
                                "example_id": "bedeb458-adad-47d3-9096-573c5a33fcf3",
                                "sense_id": "8918cc0d-2f12-3a4f-8535-8a0936cf4cd4",
                                "text": "C'est là plus qu'une métaphore. Hippocrate fut représenté à l'époque byzantine comme un Christ en gloire tenant ouvert son livre des Aphorismes."
                            },
                            {
                                "example_id": "1f7173ac-56ff-4983-b74f-580dfe1fe784",
                                "sense_id": "8918cc0d-2f12-3a4f-8535-8a0936cf4cd4",
                                "text": "L'importance d’Hippocrate et du Corpus hippocratique ne saurait être surestimée car l’œuvre du Maître de Cos fut objet d'enseignement médical jusqu'au milieu du XIX^(ème) siècle avant de devenir objet d'histoire."
                            }
                        ]
                    }
                ],
