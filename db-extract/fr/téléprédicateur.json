                    {
                        "form_id": "2cc7b13f-b312-48bd-8ca6-d6363d24e90e",
                        "entry_id": "29899a28-b70f-3578-ab20-2a4f1afb43f2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "téléprédicatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "360c8db6-be39-339b-8e09-db3607286837",
                        "entry_id": "29899a28-b70f-3578-ab20-2a4f1afb43f2",
                        "glosses": [
                            "Religieux qui prêche à la télévision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e37ae0-afb6-4e1e-bb11-33fc0b68efb5",
                                "sense_id": "360c8db6-be39-339b-8e09-db3607286837",
                                "text": "Jusqu’à ce qu'on se rende compte de l’effet pervers des pratiques de l’un des membres dirigeants dont l’ambition personnelle était de devenir téléprédicateur, et qui a vu l’opportunité de se servir du réseau pour faire la propagande de sa foi évangélique..."
                            },
                            {
                                "example_id": "a5632e89-ec54-4944-956e-e930139c40c7",
                                "sense_id": "360c8db6-be39-339b-8e09-db3607286837",
                                "text": "Il convient cependant de préciser que les téléprédicateurs sont avant tout des convertisseurs de masse et des sauveurs d’âmes. Ils sont les héritiers des évangélisateurs revivalistes."
                            },
                            {
                                "example_id": "548032cc-c78d-474f-b713-a1a6b46235ce",
                                "sense_id": "360c8db6-be39-339b-8e09-db3607286837",
                                "text": "Amr Khaled, élu en 2006 par le New York Times le téléprédicateur musulman le plus célèbre et le plus influent du monde, est, selon le journal, une « véritable rock star de l’islam »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c30dcdb-f384-4a80-9f64-dc103409e0cd",
                        "source_entry_id": "29899a28-b70f-3578-ab20-2a4f1afb43f2",
                        "source_sense_id": "360c8db6-be39-339b-8e09-db3607286837",
                        "target_lang_word": "Fernsehprediger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernsehprediger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                        "entry_id": "1abe2189-5db9-38f6-9305-b593d505cfe8",
                                        "glosses": [
                                            "Geistlicher, dessen religiöse Ansprache an die Gläubigen über das Medium Fernsehen verbreitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d2e24d8-db51-4000-9ae2-f894224e549d",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Auf der anderen Seite versichern uns populäre Bücher und Fernsehprediger ständig, dass wir allein durch die Ausübung des Glaubens an Christus sofort von allem geheilt werden können.“"
                                            },
                                            {
                                                "example_id": "dd765da4-cf1e-4e91-885d-a8742ccf27f5",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Der amerikanische Fernsehprediger Andrew Wommack empfiehlt, sich das Ziel mit ‚positiver Imagination‘ so intensiv vorzustellen, als würden wir es sehen, als würden wir in dem Ergebnis leben.“"
                                            },
                                            {
                                                "example_id": "6b8ed69d-d0fe-471a-b297-a5b7a3185a53",
                                                "sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                                                "text": "„Es fiel mir schwer, mir vorzustellen, daß ich einem der berühmtesten Fernsehprediger der Vereinigten Staaten gegenüberstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e7f424-3127-4cc7-8eb6-c1b2610b3260",
                        "source_entry_id": "29899a28-b70f-3578-ab20-2a4f1afb43f2",
