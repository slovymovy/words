                        "source_sense_description": "jemand, der Sabotage betreibt",
                        "target_lang_word": "Saboteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saboteur",
