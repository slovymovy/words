                                    {
                                        "sense_id": "9609a4fe-0dcd-3741-863a-786c9b569b4f",
                                        "entry_id": "05df54ce-94f6-3820-b84f-e5b66084ea0e",
                                        "glosses": [
                                            "A dragon-like creature with many heads and the ability to regrow them when maimed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd62d406-9e6f-389e-9069-1f7049a230fd",
                                        "entry_id": "05df54ce-94f6-3820-b84f-e5b66084ea0e",
                                        "glosses": [
                                            "Any of several small freshwater polyps of the genus Hydra and related genera, having a naked cylindrical body and an oral opening surrounded by tentacles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6434080-4538-3d5c-b334-ed2d5154eab4",
                                        "entry_id": "05df54ce-94f6-3820-b84f-e5b66084ea0e",
                                        "glosses": [
                                            "A complex, multifarious problem or situation that cannot be easily and rapidly solved."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4055729d-a611-4c1c-820f-060e0a89b271",
                                                "sense_id": "c6434080-4538-3d5c-b334-ed2d5154eab4",
                                                "text": "Because the statute is so vaguely worded, award decisions are habitually based on case law, the growing mountain of which is a hydra of rulings that point in so many directions that almost any decision can be defended or overturned on appeal, depending on how smart your lawyer is and which precedent he selects to argue your case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d64860-9532-49f7-9713-39df2a49bf80",
