                ],
                "senses": [
                    {
                        "sense_id": "cdc23ba4-03e9-3073-8fce-a8c4074f3f99",
                        "entry_id": "46dee814-11e1-3466-92ac-4db1535c045e",
                        "glosses": [
                            "Traumatiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e680ee-0965-48c1-b84b-2364fd4520e6",
                                "sense_id": "cdc23ba4-03e9-3073-8fce-a8c4074f3f99",
                                "text": "Il n’est pas question donc, de re-blesser, re-traumatiser, re-faire violence."
                            },
                            {
                                "example_id": "e89b2ade-1683-49e1-b064-f6e11d11a690",
                                "sense_id": "cdc23ba4-03e9-3073-8fce-a8c4074f3f99",
                                "text": "Dans le cadre de leur aptitude à écouter et à explorer, les aidants sont soucieux de ne pas « re-traumatiser » à cause du débriefing et de la recherche des circonstances et des causes."
                            },
                            {
                                "example_id": "893fe300-9493-4675-8912-f2f699560a79",
                                "sense_id": "cdc23ba4-03e9-3073-8fce-a8c4074f3f99",
                                "text": "Rechercher activement et immédiatement ces expériences ou impressions risquent dès lors de les « re-traumatiser »."
                            }
                        ]
                    }
                ],
