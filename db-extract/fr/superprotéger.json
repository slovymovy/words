                "senses": [
                    {
                        "sense_id": "ade3c1f2-2a84-31e6-a96f-e66fda09440b",
                        "entry_id": "fff5f52c-cff9-3553-adae-957502ef86bf",
                        "glosses": [
                            "Protéger de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5995bd9c-7dcd-4fe4-80f6-8236c3ebb203",
                                "sense_id": "ade3c1f2-2a84-31e6-a96f-e66fda09440b",
                                "text": "Vous ne rendez pas nécessairement un bon service à toutes ces familles que vous essayez de « superprotéger », car mesures pourraient inciter certains propriétaires à ne pas leur louer un appartement disponible, de crainte de ne pouvoir ultérieurement exercer le droit de reprise."
                            },
                            {
                                "example_id": "169e023d-da22-4d95-a608-3191016d3007",
                                "sense_id": "ade3c1f2-2a84-31e6-a96f-e66fda09440b",
                                "text": "Ainsi lorsque l’on injecte des virus aux animaux pour leur faire produire des anticorps en pagaille à usage de vaccin, leur hyper production qui devrait les superprotéger en réalité les condamne à l’abattage."
                            },
                            {
                                "example_id": "041e4424-c7ce-472b-84a7-97c06391fb84",
                                "sense_id": "ade3c1f2-2a84-31e6-a96f-e66fda09440b",
                                "text": ".....j’aurais pas fait mieux ....... et agréablement surpris de la savoir à cet endroit ou elle trouve de quoi se nourrir ..... à superprotéger impérativement ......"
                            }
                        ]
                    }
                ],
