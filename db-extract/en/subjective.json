                    }
                ],
                "senses": [
                    {
                        "sense_id": "69691488-e4aa-3a91-9812-ff77df058608",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Formed, as in opinions, based upon a person's feelings or intuition, rather than upon observation or purely logical reasoning; coming more from within the observer than from observations of the external environment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4ef929c8-8910-385e-b5cd-5096e6adbf55",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Pertaining to subjects as opposed to objects (A subject is one who perceives or is aware; an object is the thing perceived or the thing that the subject is aware of.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "de91608f-a845-3ede-8807-8b59dc7510c2",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Resulting from or pertaining to personal mindsets or experience, arising from perceptive mental conditions within the brain and not necessarily or directly from external stimuli."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be41ab4d-f6a1-42d1-ab1b-021495d8e2a3",
                                "sense_id": "de91608f-a845-3ede-8807-8b59dc7510c2",
                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too.[…]But as a foundation for analysis it is highly subjective: it rests on difficult decisions about what counts as a territory, what counts as output and how to value it. Indeed, economists are still tweaking it."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc17ef5-186d-338a-b496-e93a540f5ecb",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Lacking in reality or substance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6cbb6d76-34d5-35e8-8aef-cac9bfcb3cd8",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "As used by Carl Jung, the innate worldview orientation of the introverted personality types."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0ad6a73-d25c-3243-9fd0-607540872018",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Experienced by a person mentally and not directly verifiable by others."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6412e83d-5c6a-3553-9b30-d04499a99278",
                        "entry_id": "39e90e69-30d5-34f7-ae47-f2514bf0c6fd",
                        "glosses": [
                            "Describing conjugation of a verb that indicates only the subject (agent), not indicating the object (patient) of the action. (In linguistic descriptions of Tundra Nenets, among others.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c913b1f-51c8-49aa-8b3c-d62d8809c8da",
                                "sense_id": "6412e83d-5c6a-3553-9b30-d04499a99278",
                                "text": "The general finite stem is the verbal stem which serves as the basis of inflection in the indicative present and past in the subjective conjugation and the objective conjugation with the singular and dual object."
                            }
                        ]
                    }
