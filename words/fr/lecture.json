    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                    "sense_definition": "Action ou habitude de déchiffrer et de comprendre des textes écrits pour s'instruire ou se divertir.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action_lire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque soir avant de dormir, je consacre une demi-heure à la <w>lecture</w>."
                        },
                        {
                            "text": "Ce roman captivant redonne rapidement le goût de la <w>lecture</w> aux jeunes enfants."
                        }
                    ],
                    "common_phrases": [
                        "goût de la lecture",
                        "salle de lecture",
                        "séance de lecture"
                    ]
                },
                {
                    "sense_id": "8c018979-3a18-34ae-973d-dc465474a176",
                    "sense_definition": "Restitution ou reproduction d'un contenu sonore, visuel ou informatique par un appareil électronique.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>lecture</w> de cette vidéo s'est interrompue soudainement à cause d'une mauvaise connexion."
                        },
                        {
                            "text": "Vous pouvez régler la vitesse de <w>lecture</w> pour écouter ce document audio plus rapidement."
                        }
                    ],
                    "common_phrases": [
                        "vitesse de lecture",
                        "mode de lecture",
                        "tête de lecture"
                    ]
                },
                {
                    "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                    "sense_definition": "Action de prononcer à haute voix un texte écrit devant un auditoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a réuni tous les héritiers pour faire la <w>lecture</w> du testament."
                        },
                        {
                            "text": "L'auteur a été invité à la bibliothèque pour une <w>lecture</w> publique de son dernier recueil."
                        }
                    ],
                    "synonyms": [
                        "déclamation",
                        "récitation"
                    ],
                    "common_phrases": [
                        "lecture publique",
                        "faire la lecture",
                        "lecture à haute voix"
                    ]
                },
                {
                    "sense_id": "c3add633-5c23-3832-8fe4-eee84402c25b",
                    "sense_definition": "Ensemble des ouvrages, livres ou articles qu'une personne lit ou a l'habitude de lire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle emporte toujours plusieurs <w>lectures</w> passionnantes dans sa valise avant de partir en vacances."
                        },
                        {
                            "text": "Le professeur d'histoire a partagé une liste de <w>lectures</w> recommandées pour le trimestre."
                        }
                    ],
                    "common_phrases": [
                        "conseil de lecture",
                        "choix de lectures",
                        "bonnes lectures"
                    ]
                },
                {
                    "sense_id": "32c706cc-5ec2-3817-bb86-d5b13dfc0f19",
                    "sense_definition": "Façon particulière de comprendre, d'analyser ou d'interpréter un texte, une œuvre ou une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grille de <w>lecture</w> novatrice permet de mieux comprendre les enjeux économiques actuels."
                        },
                        {
                            "text": "Les historiens ne partagent pas tous la même <w>lecture</w> de cette crise politique majeure."
                        }
                    ],
                    "synonyms": [
                        "analyse",
                        "décryptage",
                        "interprétation"
                    ],
                    "common_phrases": [
                        "grille de lecture",
                        "proposer une lecture",
                        "première lecture"
                    ]
                },
                {
                    "sense_id": "487c003b-6315-36e2-8568-c294fd8edbd4",
                    "sense_definition": "Action de relever ou d'observer attentivement une donnée chiffrée, un cadran ou une carte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>lecture</w> d'une carte géographique demande un apprentissage rigoureux des symboles et des échelles."
                        },
                        {
                            "text": "Le technicien est passé ce matin pour faire la <w>lecture</w> de notre compteur d'électricité."
                        }
                    ],
                    "synonyms": [
                        "relevé"
                    ],
                    "common_phrases": [
                        "lecture de compteur",
                        "lecture d'une carte",
                        "lecture d'un graphique"
                    ]
                }
            ]
        }
    ]
