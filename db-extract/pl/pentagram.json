                "translations": [
                    {
                        "translation_id": "b9006d7a-12f6-405e-8294-1a768f38b67b",
                        "source_entry_id": "60516db8-c953-3485-ab0e-0ba9be56d8ee",
                        "source_sense_id": "b2d177c8-eca2-3cc9-a606-ea9636e89e7c",
                        "target_lang_word": "pentagram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentagram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                        "entry_id": "47383d6e-50c1-3307-8096-e3fb32832c66",
                                        "glosses": [
                                            "The shape of a five-pointed star constructed of five intersecting lines meeting at the vertices, such that a central pentagon and five surrounding isosceles triangles are formed; often with magical connotations; a 5/2 (or 5/3) star polygon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268ef499-10ea-4007-8368-01a8bead3b7f",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "Prove that the circles so belonging to the 6 pentagrams formed by 6 lines meet in a point, and so on; the series of theorems being interminable."
                                            },
                                            {
                                                "example_id": "4d057fa8-b2ec-49d8-a423-9d04a6a11c22",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "The passive pentagrams of spirit are drawn first in the quarters of the passive elements—water and earth—and likewise followed by the appropriate traditional elemental pentagram."
                                            },
                                            {
                                                "example_id": "d4b130c2-8d2b-4adb-a83d-58f3a4380799",
                                                "sense_id": "e27807a9-b560-38a7-ab30-d68578f3464b",
                                                "text": "Four figures involve 12 pentagrams arranged as in the faces of a dodecahedron with their vertices touching."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a82f957d-d5cd-4588-b601-8acb03766719",
                        "source_entry_id": "60516db8-c953-3485-ab0e-0ba9be56d8ee",
                        "source_sense_id": "b2d177c8-eca2-3cc9-a606-ea9636e89e7c",
                        "target_lang_word": "pentagram",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentagram",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "892cb227-e6ad-3413-a0fa-fe18a1c83601",
                                        "entry_id": "cf0f2e8d-a3cb-3204-b826-2c0925a0a0f5",
                                        "glosses": [
                                            "pěticípá hvězda nakreslená pěti přímými tahy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72eb9ef1-ce57-4de9-9d64-90152a91bdf3",
                                                "sense_id": "892cb227-e6ad-3413-a0fa-fe18a1c83601",
                                                "text": "Pentagram nosí Markéta Vostrá na krku pro svou ochranu. Představuje čtyři hlavní živly a pátý cíp náleží lidskému duchu."
                                            },
                                            {
                                                "example_id": "5bbd1197-dbf7-42ed-bbe0-173b5a9a5480",
                                                "sense_id": "892cb227-e6ad-3413-a0fa-fe18a1c83601",
                                                "text": "…nakreslil jsem dle udání na zem žádanou hvězdu Šalomonovu a posvátný pentagram, a pak shasnuv lampu, vzýval dle návodu ducha světla, ducha moudrosti…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaf6c7f0-0418-4820-ba71-83067f5dd3a0",
                        "source_entry_id": "60516db8-c953-3485-ab0e-0ba9be56d8ee",
                        "source_sense_id": "b2d177c8-eca2-3cc9-a606-ea9636e89e7c",
