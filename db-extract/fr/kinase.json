                        "entry_id": "2113ef9f-1a58-3fc5-a965-8aacf1c36b80",
                        "glosses": [
                            "Protéine dont la fonction est de modifier les paramètres d’autres protéines en leur ajoutant des phosphates (par phosphorylation)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2535a18-abef-40e9-ba98-a1fc3bb59ec4",
                                "sense_id": "e32bf2bd-be6a-30ee-809a-c7a2df599a94",
                                "text": "Les portions intracellulaires des chaines β du récepteur membranaire de l'insuline sont douées d'une activité tyrosine kinase intrinsèque."
                            },
                            {
                                "example_id": "8b316308-aed3-42c4-89df-9619deaeedb8",
                                "sense_id": "e32bf2bd-be6a-30ee-809a-c7a2df599a94",
                                "text": "La phosphorylation de Foxo1 par la kinase Akt/PKB stimulée par l’insuline induit une inactivation et une exclusion du noyau de Foxo1."
                            }
                        ]
                    }
                ],
