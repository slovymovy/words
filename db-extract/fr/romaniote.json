                                        "glosses": [
                                            "A member of a Jewish population living in Greece, historically distinct from the Sephardim, who settled in Greece later."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74e62cb-51fc-43d7-bef3-5e4e741d4b56",
                                                "sense_id": "33852de3-109f-343c-a093-bc735ed1219b",
                                                "text": "Native (Romaniote) Jews submerged hy increasing numbers of Sephardi Jews plus the Karaites constituted the three main communities."
                                            },
                                            {
                                                "example_id": "693f19fe-39aa-4379-9de9-2e08871dc515",
                                                "sense_id": "33852de3-109f-343c-a093-bc735ed1219b",
                                                "text": "Gradually, however, the greater wealth and more dynamic culture of the Sephardim overwhelmed the Romaniotes, most of whom merged with the newcomers."
                                            }
                                        ]
                                    }
