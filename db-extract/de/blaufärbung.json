                "senses": [
                    {
                        "sense_id": "4b4f1f74-e92c-3209-ae84-c1ae090cf09a",
                        "entry_id": "2ce67b5b-d35b-39a4-b90a-cf5e5b994b0d",
                        "glosses": [
                            "(Ver-)Färbung in einen Blauton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341e95f2-7862-49b4-83cf-549dd6cc7bca",
                                "sense_id": "4b4f1f74-e92c-3209-ae84-c1ae090cf09a",
                                "text": "„Der südamerikanische Morphofalter ist berühmt für seine einzigartig schillernde Blaufärbung, die durch den Feinbau der Schuppen hervorgerufen wird.“"
                            },
                            {
                                "example_id": "e8230e41-8d5d-42b9-aedb-c82ab5f0f14c",
                                "sense_id": "4b4f1f74-e92c-3209-ae84-c1ae090cf09a",
                                "text": "„Eine Verunreinigung des Brotgetreides mit den Samen des Ackerwachtelweizens verursacht wegen des hohen Aucubingehaltes eine Blaufärbung des Brotes, was im Mittelalter zu manchen Spekulationen über die Auslösung dieses Effektes geführt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
