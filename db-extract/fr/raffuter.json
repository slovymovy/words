                "senses": [
                    {
                        "sense_id": "860b82fa-7447-3e46-8e81-56bf30117b1f",
                        "entry_id": "e976e967-8d6a-36f3-be87-18a5cf31df9a",
                        "glosses": [
                            "Aiguiser de nouveau un outil, réaffuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a64d1ee6-9a42-40dc-ae1d-8e600f0539af",
                                "sense_id": "860b82fa-7447-3e46-8e81-56bf30117b1f",
                                "text": "Raffuter son ciseau, son burin, un crayon."
                            }
                        ]
                    },
                    {
                        "sense_id": "eabca83d-37a8-3413-961e-ef510416602f",
                        "entry_id": "e976e967-8d6a-36f3-be87-18a5cf31df9a",
                        "glosses": [
                            "Utiliser la technique du raffut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2f9756-a5b8-4081-ba82-52036e268575",
                                "sense_id": "eabca83d-37a8-3413-961e-ef510416602f",
                                "text": "Il est interdit de raffuter avec le poing et a fortiori le coude !"
                            },
                            {
                                "example_id": "7043ac1e-a25c-41d0-b022-ee9a9ee4958e",
                                "sense_id": "eabca83d-37a8-3413-961e-ef510416602f",
                                "text": "[David] joue à l'aile. Quand il est lancé personne ne peut l'arrêter, il n'a pas son pareil pour percer les lignes adverses, zigzaguer, feinter, raffûter et sa course s'achève souvent dans l'en-but adverse."
                            }
                        ]
                    }
                ],
