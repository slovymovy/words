                                        "entry_id": "75cc4481-45fe-3ec8-982a-3e3bad370142",
                                        "glosses": [
                                            "Transporté par avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1f4298-5f0e-4c62-ac62-534872b4fb26",
                                                "sense_id": "99de39a3-9a7c-34da-a961-493a14acbb0c",
                                                "text": "Troupes aéroportées, généralement larguées par parachute au-dessus de leur destination. (À comparer à aérotransportée, qui implique un débarquement par atterrissage)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b92a079-9bfb-3f3e-884a-a1822e90650d",
                                        "entry_id": "75cc4481-45fe-3ec8-982a-3e3bad370142",
                                        "glosses": [
                                            "Véhiculé par avion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a8b1f6-d126-4282-9fe3-e6c7f761dd62",
                                                "sense_id": "0b92a079-9bfb-3f3e-884a-a1822e90650d",
                                                "text": "Radar aéroporté. Missile aéroporté. Système de Détection Aéroporté, également appelé AWACS (en) (Airborne Warning and Control System (en))"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fa49e3-88c1-3b40-9a2f-5f5c22111c80",
                                        "entry_id": "75cc4481-45fe-3ec8-982a-3e3bad370142",
                                        "glosses": [
                                            "Effectué à partir d’un avion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c52dfe8-225f-4641-9f16-bbac08732e35",
                                                "sense_id": "50fa49e3-88c1-3b40-9a2f-5f5c22111c80",
                                                "text": "Prospection aéroportée."
                                            },
                                            {
                                                "example_id": "a9c9c363-cb8e-40b3-9048-d3bd45ae9057",
                                                "sense_id": "50fa49e3-88c1-3b40-9a2f-5f5c22111c80",
                                                "text": "Protéger la vie aéroportée en activant un système aérien de dissuasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb050d2d-04a4-3e7e-9775-da7b60e8e7d0",
                                        "entry_id": "75cc4481-45fe-3ec8-982a-3e3bad370142",
                                        "glosses": [
                                            "Transporté par l’air ambiant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443b5b79-eadc-44a7-be21-8e10e4997e86",
                                                "sense_id": "fb050d2d-04a4-3e7e-9775-da7b60e8e7d0",
                                                "text": "(Chimie) Agents aéroportés, particules aéroportées. (Médecine) Infection aéroportée. (Environnement) Poussières aéroportées."
                                            }
                                        ]
                                    }
                                ]
