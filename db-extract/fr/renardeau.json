                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a4cabc-56b3-3ae8-9bfe-98cd4bfceeb2",
                                        "entry_id": "d0ce9484-f831-3c8d-a875-c2c9c86c696c",
                                        "glosses": [
                                            "A young fox."
                                        ],
                                        "tags": [],
