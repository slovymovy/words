                "senses": [
                    {
                        "sense_id": "715caab2-f289-3f72-885c-7bbe8efe4be0",
                        "entry_id": "c0c217cf-c5bb-3080-826f-d89dbe53d5c3",
                        "glosses": [
                            "vor Kurzem gewaschen, gerade erst gewaschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf39b7de-64b0-47ad-b317-b98e50d3dc77",
                                "sense_id": "715caab2-f289-3f72-885c-7bbe8efe4be0",
                                "text": "„Die Soldaten hatten sich an die immer gleiche Ansammlung von tristen Gebäuden mit ihren mürrischen und frustrierten Bewohnern gewöhnt, die einer wie der andere die auf diesem trostlosen Stützpunkt vergeudeten Tage bedauerten und sich verzweifelt nach der Rückkehr in bewohnbare Gegenden sehnten, nach den Bildern und Geräuschen überfüllter Basare, dem Geruch von Wasser und Vegetation, dem Gefühl von sauberer, frischgewaschener Kleidung auf der Haut und den Scherzen und dem Gefeilsche in den Läden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
