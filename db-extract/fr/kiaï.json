                                        "glosses": [
                                            "The short yell or shout uttered when performing an attacking move in martial arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac425d4-e093-4a35-9653-1047132ad3dc",
                                                "sense_id": "e1f55d02-ec71-39bd-9212-c31c0b05ad44",
                                                "text": "The kiai is a battle cry to raise your battle spirit. It keeps your body in top shape, in top concentration. Different people have different kiai."
                                            }
