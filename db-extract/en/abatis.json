                                                "sense_id": "9c7ace88-5e27-3259-9be2-c02f4d91dfc2",
                                                "text": "„Um das Ausräumen eines Verhaues zu erschweren, befestigte man die Stämme durch Pfähle, die man vor und zwischen den Ästen einschlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a8e5be9-c520-39ea-8650-5ec9ad11edc7",
                                        "entry_id": "97b575f4-9f71-3746-9d40-1366868fecdd",
                                        "glosses": [
                                            "schlampig oder unter Zeitdruck konstruierte Vorrichtung, eine Ansammlung aus wirr durcheinander liegenden Gegenständen, eine chaotische Unordnung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
