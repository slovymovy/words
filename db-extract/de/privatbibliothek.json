                "senses": [
                    {
                        "sense_id": "b36b190e-30d9-383d-ab72-84b9a4880511",
                        "entry_id": "ff84a533-01d9-3c1e-8612-f939d5e48c51",
                        "glosses": [
                            "Bibliothek, die von jemand nach eigenen Interessen/Bedürfnissen zusammengestellt wurde und sich im Privatbesitz befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3956385-969e-4e7f-9733-7255de723851",
                                "sense_id": "b36b190e-30d9-383d-ab72-84b9a4880511",
                                "text": "„Christian Jagemann verlor seine Stelle und zog nach Weimar, wo er 1775 an der Privatbibliothek der Herzogin Regentin eine neue Anstellung fand.“"
                            },
                            {
                                "example_id": "fd1ad22c-b3b5-4df8-b451-422ea28dd2c6",
                                "sense_id": "b36b190e-30d9-383d-ab72-84b9a4880511",
                                "text": "„Digbys Privatbibliothek wurde unter dem parlamentarischen Regime Oliver Cromwells vermutlich beschlagnahmt und verbrannt, denn solches war bei den Puritanern die übliche Praxis.“"
                            },
                            {
                                "example_id": "bb58566c-6900-4086-85f5-8788c8412211",
                                "sense_id": "b36b190e-30d9-383d-ab72-84b9a4880511",
                                "text": "„Seine Privatbibliothek fülle jedes seiner sieben Zimmmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
