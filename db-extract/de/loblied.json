                        ],
                        "examples": [
                            {
                                "example_id": "c8e0f011-5795-4302-93e9-cfb049d03981",
                                "sense_id": "02c409f7-1087-385d-af20-9e28e269e930",
                                "text": "Das Gedicht, das er vorgelegt hatte, ein begeistertes Loblied auf die Lebenslust oder vielmehr ein überaus stürmischer Ausbruch der Lebenslust selbst, ein hinreißender Hymnus auf des Lebens Schönheit und Furchtbarkeit, war im Stile seiner beiden Bücher gehalten und hatte Zwietracht ins Richterkollegium getragen.",
                                "translation": "Royal Highness",
                                "english": "Royal Highness"
                            }
                        ]
                    }
