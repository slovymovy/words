            "pos": "verb",
            "senses": [
                {
                    "sense_id": "514bb7dc-d907-3db3-8a0d-5ade861cfb1d",
                    "sense_definition": "Donner un aspect visible, tangible ou concret à ce qui est abstrait ou virtuel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concretiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a dessiné une maquette pour <w>matérialiser</w> son projet avant le début des travaux."
                        },
                        {
                            "text": "Cette médaille d'or vient <w>matérialiser</w> des années de travail acharné et de sacrifices quotidiens."
                        }
                    ],
                    "synonyms": [
                        "concrétiser",
                        "incarner",
                        "réaliser"
                    ],
                    "antonyms": [
                        "dématérialiser",
                        "spiritualiser"
                    ],
                    "common_phrases": [
                        "matérialiser une idée",
                        "matérialiser un projet"
                    ]
                },
                {
                    "sense_id": "330b7d86-a530-3a2f-835d-8f4af673773a",
                    "sense_definition": "Prendre une forme physique, devenir visible ou réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparaitre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une silhouette étrange semblait se <w>matérialiser</w> dans la brume épaisse de la forêt."
                        },
                        {
                            "text": "Après plusieurs mois d'attente, les premiers résultats ont enfin commencé à se <w>matérialiser</w>."
                        }
                    ],
                    "synonyms": [
                        "apparaître",
                        "se concrétiser"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'évanouir"
                    ],
                    "common_phrases": [
                        "se matérialiser sous nos yeux",
                        "commencer à se matérialiser"
                    ]
                },
                {
                    "sense_id": "2ac11638-4ab1-34cc-b21d-63544e53ed25",
                    "sense_definition": "Considérer ou représenter une réalité spirituelle ou abstraite comme étant matérielle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce critique, certains philosophes <w>matérialisent</w> excessivement la conscience humaine dans leurs théories."
                        },
                        {
                            "text": "Les croyances populaires ont parfois tendance à <w>matérialiser</w> des concepts purement spirituels."
                        }
                    ],
                    "antonyms": [
                        "spiritualiser"
                    ],
                    "common_phrases": [
                        "matérialiser la pensée",
                        "matérialiser l'esprit"
                    ]
                }
            ]
        }
    ]
