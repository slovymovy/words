                ],
                "senses": [
                    {
                        "sense_id": "2d79e435-6d12-3d60-b5a8-1d5bc2448f77",
                        "entry_id": "0ac4ac4c-bd01-353b-982c-dd5384b0385b",
                        "glosses": [
                            "Licht von nur einer Wellenlänge"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "77502b30-455f-40ba-9d52-37c624c69679",
                                "sense_id": "2d79e435-6d12-3d60-b5a8-1d5bc2448f77",
                                "text": "„Newton wies 1676 nach, daß das farblos-durchsichtige, »weiße« Tageslicht aus Spektralfarben zusammengesetzt ist.“"
                            },
                            {
                                "example_id": "bf521c8c-4c59-422f-99c8-b019c8ab0c03",
                                "sense_id": "2d79e435-6d12-3d60-b5a8-1d5bc2448f77",
                                "text": "„Und der saftig-gelbe Limoncello, der nur hier produzierte und wohl auch nur hier getrunkene Zitronenlikör, erleuchtet in seiner schönsten Spektralfarbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8fab49ca-fa85-3cac-9f7f-239e6f7b851b",
                        "entry_id": "0ac4ac4c-bd01-353b-982c-dd5384b0385b",
                        "glosses": [
                            "die durch Zerlegung eines Spektrums entstehenden, reinen, unvermischten sieben Farben"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3da2d3c8-05d4-474f-a9ac-b2fd84e053bd",
                                "sense_id": "8fab49ca-fa85-3cac-9f7f-239e6f7b851b",
                                "text": "„Im Osten stiegen dünne Nebelschwaden auf und leuchteten durch die Brechung des Sonnenlichts in allen Spektralfarben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
