                                        "entry_id": "c6ce2d04-0fb1-3534-a4ca-aaab02c758c3",
                                        "glosses": [
                                            "A joke, especially one which strikes the listener or reader as particularly humorous."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9256a46-7bcc-4369-be20-e4993795ba1f",
                                                "sense_id": "7e131b4f-cc78-395c-a07b-ba80900c116b",
                                                "text": "Not exactly a thigh-slapper, but not terrible for a psychiatrist joke either."
                                            },
                                            {
                                                "example_id": "d80b91f1-6cfd-4a1f-bf35-34bf9a91cede",
                                                "sense_id": "7e131b4f-cc78-395c-a07b-ba80900c116b",
                                                "text": "\"There's a lot of USO girls in Hollywood,\" Hope mused on his World War II tours. \"USO - Use Slacks Only.\" Ho ho ho. Women wearing pants. Real thigh-slapper."
                                            }
                                        ]
