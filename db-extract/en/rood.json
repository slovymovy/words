                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb3d1fc-e56e-419a-b589-2c081b683acf",
                                                "sense_id": "60040847-ef94-3dc4-8233-f4a244cde69b",
                                                "text": "Het kruis van Olaf toont zich in volledige en volle glorie aan me."
                                            },
                                            {
                                                "example_id": "d140e900-3ddc-4625-b8b0-b01a270f99b6",
                                                "sense_id": "60040847-ef94-3dc4-8233-f4a244cde69b",
                                                "text": "Als ik de volle maan zie sla ik vreemd genoeg altijd een kruis, kus mijn duim en wijs naar de maan als gebaar van dankbaarheid voor de rijke ervaringen in mijn leven en de mensen om mij heen."
                                            },
                                            {
                                                "example_id": "7b03b913-6d71-4740-82f6-4f8172731975",
                                                "sense_id": "60040847-ef94-3dc4-8233-f4a244cde69b",
                                                "text": "Ook al ben ik geen katholiek, toch sla ik vaak een kruisje voor mijn borst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff31d3bb-e1eb-3cf2-a365-910f1b82554e",
