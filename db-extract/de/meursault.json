                                    {
                                        "sense_id": "c5ddea24-37f8-310c-81aa-07ea8cb77fbc",
                                        "entry_id": "6d0a2be6-a110-3684-bc6f-b600d4cb31e8",
                                        "glosses": [
                                            "Vin produit sur une partie de la commune de Meursault, en Côte-d’Or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb6b829-0749-44fd-a370-9b3a387a36cf",
                                                "sense_id": "c5ddea24-37f8-310c-81aa-07ea8cb77fbc",
                                                "text": "Comme beaucoup d’Annamites, le Jaune était natif du Puy-de-Dôme et préférait les tripoux d’Auvergne au canard laqué. Il raffolait également des fruits de mer et le meursault qui les escortait enchanta son palais"
                                            },
                                            {
                                                "example_id": "30899bc4-7411-4934-b940-cb1687cc8ef0",
                                                "sense_id": "c5ddea24-37f8-310c-81aa-07ea8cb77fbc",
                                                "text": "Rien que le mot d'humanisme me donnait légèrement envie de vomir, mais c'était peut-être les pâtés chauds, j'avais abusé ; je repris un verre de meursault pour faire passer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
