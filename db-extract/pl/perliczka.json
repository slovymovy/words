                    {
                        "sense_id": "91d00319-f709-3731-986f-54fbfbad392c",
                        "entry_id": "ad3dc43d-f1e4-336d-83da-e93c07d67e39",
                        "glosses": [
                            "Numida meleagris, udomowiony naziemny ptak grzebiący z rodziny perlic"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99f8f10-29e3-4970-b0d4-23a550e599c6",
                                "sense_id": "91d00319-f709-3731-986f-54fbfbad392c",
                                "text": "Tak to obserwując wszystko, panna zabrnęła między perliczki, których całe stado wykrzykiwało popod krzakami porzeczek"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d01e3df4-1278-480f-9346-7f90f2c7abee",
                        "source_entry_id": "ad3dc43d-f1e4-336d-83da-e93c07d67e39",
                        "source_sense_id": "91d00319-f709-3731-986f-54fbfbad392c",
                        "target_lang_word": "guinea fowl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guinea fowl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed35dc9-1b6e-3671-ab60-1b9a1832c7db",
                                        "entry_id": "69deccd8-ff57-3159-8a5f-8545f1b82f22",
                                        "glosses": [
                                            "Any of several African birds of the family Numididae (6 species) resembling partridges."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9440a1c8-85b5-4d42-b7fb-ebdedb44614b",
                                                "sense_id": "8ed35dc9-1b6e-3671-ab60-1b9a1832c7db",
                                                "text": "A tiny white head with a small red wattle hanging from its beak was peeking into our tent. It whistled softly. I laughed. A guinea fowl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                        "entry_id": "69deccd8-ff57-3159-8a5f-8545f1b82f22",
                                        "glosses": [
                                            "The meat of this bird."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d834f12-681f-421c-b194-9e26eef4eaed",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "While Lawrence had given her the uncut version of his divorce, she had stolidly munched her way through a vast plate of guinea fowl stuffed with foie gras, boulangère potatoes and a wigwam of French beans."
                                            },
                                            {
                                                "example_id": "6aef4238-a35f-45b8-be99-476ab322a116",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "To the right is a long table housing a mouth-watering buffet of roast duck on platters, surrounded by smaller plates of guinea fowl, French bread, cold meats, and egg segments."
                                            },
                                            {
                                                "example_id": "85095e91-6a92-4cc5-9f2a-5733b05df7fe",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "The waiter reappeared with plates of guinea fowl, baked with pancetta and apples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
