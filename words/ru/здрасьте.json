{
    "word_family": [
        "здравствовать",
        "здоровье",
        "здоровый",
        "поздороваться"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "27750acf-e46e-3c3b-abc0-98ec333930c6",
                    "sense_definition": "Разговорная форма приветствия при встрече; то же, что <w>здравствуйте</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сосед вежливо кивнул головой и громко сказал: «<w>Здрасьте</w>, как ваши дела?»",
                            "target_lang_translations": {
                                "pl": "Sąsiad uprzejmie skinął głową i powiedział głośno: „<w>Dzień dobry</w>, co u pana słychać?”"
                            }
                        },
                        {
                            "text": "Мальчик вбежал в комнату и с порога крикнул: «Всем <w>здрасьте</w>!»",
                            "target_lang_translations": {
                                "pl": "Chłopiec wbiegł do pokoju i od progu krzyknął: „<w>Cześć</w> wszystkim!”"
                            }
                        }
                    ],
                    "synonyms": [
                        "здравствуйте",
                        "здрасте",
                        "привет"
                    ],
                    "antonyms": [
                        "пока"
                    ],
                    "common_phrases": [
                        "всем здрасьте"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное приветствие"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Potoczne powitanie przy spotkaniu; to samo co dzień dobry lub cześć."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dzień dobry",
                                "target_lang_sense_clarification": "uniwersalne, standardowe powitanie"
                            },
                            {
                                "target_lang_word": "bry",
                                "target_lang_sense_clarification": "bardzo potoczne, skrócone powitanie"
                            },
                            {
                                "target_lang_word": "cześć",
                                "target_lang_sense_clarification": "nieformalne powitanie"
                            },
                            {
                                "target_lang_word": "siemanko",
                                "target_lang_sense_clarification": "luźne, potoczne powitanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e343235d-60a4-330f-acea-57aefbee3e48",
                    "sense_definition": "Выражение неожиданности, удивления, недоумения или досады по поводу услышанного или произошедшего.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договаривались встретиться утром, а он заявляет: «<w>Здрасьте</w>, приехали, я всё забыл».",
                            "target_lang_translations": {
                                "pl": "Umawialiśmy się rano, a on oznajmia: „<w>No to ładnie</w>, wszystko zapomniałem”."
                            }
                        },
                        {
                            "text": "Вот тебе и <w>здрасьте</w>, поезд уже ушёл, а билеты остались у меня в кармане!",
                            "target_lang_translations": {
                                "pl": "<w>Masz babo placek</w>, pociąg już odjechał, a bilety zostały w mojej kieszeni!"
                            }
                        }
                    ],
                    "synonyms": [
                        "здрасте"
                    ],
                    "common_phrases": [
                        "здрасьте приехали",
                        "вот тебе и здрасьте",
                        "здрасьте пожалуйста"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение эмоции"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykrzyknik wyrażający zaskoczenie, zdziwienie, konsternację lub zniecierpliwienie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "masz babo placek",
                                "target_lang_sense_clarification": "wyraz niemiłego zaskoczenia lub kłopotu"
                            },
                            {
                                "target_lang_word": "no to ładnie",
                                "target_lang_sense_clarification": "ironiczny wyraz zdziwienia lub rozczarowania"
                            },
                            {
                                "target_lang_word": "dobre sobie",
                                "target_lang_sense_clarification": "wyraz zdziwienia, niedowierzania lub powątpiewania"
                            },
                            {
                                "target_lang_word": "no proszę",
                                "target_lang_sense_clarification": "wyraz niespodziewanego obrotu spraw"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}