                "senses": [
                    {
                        "sense_id": "9e24ff49-7cff-30bb-afa4-5cc80d3e7aaa",
                        "entry_id": "c208b45f-606e-338d-9e05-f27fa930af4a",
                        "glosses": [
                            "Qui peut être acheté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba70d270-6329-4e06-9130-9511626fe23d",
                                "sense_id": "9e24ff49-7cff-30bb-afa4-5cc80d3e7aaa",
                                "text": "Et si je meurs en ma poursuite, ce ne sera point sans honneur. L’oser seulement entreprendre est une gloire achetable de mille morts."
                            },
                            {
                                "example_id": "9a825c2c-1736-4663-ac66-f4952e8c1a5f",
                                "sense_id": "9e24ff49-7cff-30bb-afa4-5cc80d3e7aaa",
                                "text": "D’ailleurs, je ne suis point achetable ; & qui que ce soit n’a eu le pouvoir de me mettre à prix."
                            },
                            {
                                "example_id": "3d645462-af28-40d8-b700-f6c42d8139af",
                                "sense_id": "9e24ff49-7cff-30bb-afa4-5cc80d3e7aaa",
                                "text": "Si l'on court après l'argent, c'est donc parce que tout ou presque, tout le monde ou presque, est achetable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "674f9277-4835-49be-ad56-b8d65b815423",
                        "source_entry_id": "c208b45f-606e-338d-9e05-f27fa930af4a",
                        "source_sense_id": "9e24ff49-7cff-30bb-afa4-5cc80d3e7aaa",
                        "target_lang_word": "käuflich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "käuflich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe66b153-e750-3165-b75d-592c14b4c1fa",
                                        "entry_id": "2bfc2e59-3b20-307b-9a09-4f9db1a037ea",
                                        "glosses": [
                                            "durch Kauf zu erwerben"
                                        ],
                                        "tags": [
                                            "von Waren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d476190-69d9-4306-95d3-d1b048e6a93a",
                                                "sense_id": "fe66b153-e750-3165-b75d-592c14b4c1fa",
                                                "text": "Für die käufliche Liebe gibt es viele Orte, am bekanntesten dürfte die Herbertstraße in der Nähe der Reeperbahn in St. Pauli sein."
                                            },
                                            {
                                                "example_id": "44045079-6043-4538-ac22-ce748e443aa1",
                                                "sense_id": "fe66b153-e750-3165-b75d-592c14b4c1fa",
                                                "text": "Auch virtuelle Waren sind im Internet käuflich zu erwerben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27db168b-e7d3-3128-b124-5eb8f8701eb0",
                                        "entry_id": "2bfc2e59-3b20-307b-9a09-4f9db1a037ea",
                                        "glosses": [
                                            "bereit gegen Geld etwas Illegales zu tun"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a44b7809-8085-485e-abf1-851162aeb2b1",
                                                "sense_id": "27db168b-e7d3-3128-b124-5eb8f8701eb0",
                                                "text": "Der Anfang der Korruption ist, sich für Gefälligkeiten käuflich zu zeigen."
                                            },
                                            {
                                                "example_id": "466ead2a-b568-4fbd-b965-29dc05ebc60c",
                                                "sense_id": "27db168b-e7d3-3128-b124-5eb8f8701eb0",
                                                "text": "„Donald Trump ist käuflich. Er verdient an der eigenen Kryptowährung und nimmt Geschenke aus Katar an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
