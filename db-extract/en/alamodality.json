                                "example_id": "76d0d541-648c-41b2-a704-b051b9e1f6d7",
                                "sense_id": "763d29c6-5070-37b0-b133-60d9730ee91a",
                                "text": "Doubtless it hath been selected for me because of its alamodality,- a good and pregnant word, on the fitness of which some German whose name appears to be erroneously as well as uncouthly written Geamoenus, is said to have composed a dissertation."
                            },
                            {
                                "example_id": "3c3fec7c-3b6d-45bb-be83-d8523897b03a",
                                "sense_id": "763d29c6-5070-37b0-b133-60d9730ee91a",
                                "text": "Gwendolyn Hackworth hadn't packed a parasol, but she was untroubled; she'd always had a kind of natural, unconscious alamodality."
                            }
                        ]
                    }
