                "senses": [
                    {
                        "sense_id": "6ea3474c-b80e-3606-8a44-4e165d07f1f6",
                        "entry_id": "1961a4c8-9c35-3f8d-95eb-f2844d27d5b8",
                        "glosses": [
                            "dalszy ciąg jakiegoś dzieła, najczęściej filmu lub książki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61bbcd1-1e10-4013-9425-b1d23d30f891",
                                "sense_id": "6ea3474c-b80e-3606-8a44-4e165d07f1f6",
                                "text": "Po sukcesie pierwszej części filmu, realizatorzy zapowiedzieli nakręcenie sequelu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7530b8f1-f4d8-438b-903b-73b3d9b3687c",
                        "source_entry_id": "1961a4c8-9c35-3f8d-95eb-f2844d27d5b8",
                        "source_sense_id": "6ea3474c-b80e-3606-8a44-4e165d07f1f6",
                        "target_lang_word": "sequel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sequel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc8f26d-2377-33a6-958a-38b210df852d",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "The events, collectively, which follow a previously mentioned event; the aftermath."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb706c7-80ce-4f80-9f48-74e38124eea2",
                                                "sense_id": "2bc8f26d-2377-33a6-958a-38b210df852d",
                                                "text": "Now here Chriſtian was worſe put to it then in his fight with Apollyon, as by the ſequel you ſhall ſee."
                                            },
                                            {
                                                "example_id": "41f05dbd-fb8f-4bee-a510-69f2a809d120",
                                                "sense_id": "2bc8f26d-2377-33a6-958a-38b210df852d",
                                                "text": "In its sixty-year history here, some 4,170 engines of the 4-6-0 type have been constructed. This is the vast sequel of that bold experimental step of the Highland Railway in 1894."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db48f6d-8438-3097-8a87-faef7e6cfdc1",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "A narrative that is written after another narrative set in the same universe, especially a narrative that is chronologically set after its predecessors, or (perhaps improper usage) any narrative that has a preceding narrative of its own."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d59492d0-557d-3002-b9bf-b38899fad6ce",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "Any text that continues on from another text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6972fce-3cf9-42c9-96e1-257cfe49e5b5",
                                                "sense_id": "d59492d0-557d-3002-b9bf-b38899fad6ce",
                                                "text": "It greatly resembles the Rabbinical account of the origin of the Mazckeen, which the reader will meet in the sequel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "035492df-2017-3f14-b1de-18e5f7463be3",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "The remainder of the text; what follows. Used exclusively in the set phrase \\\"in the sequel\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf350a2-4f57-4d74-a7e3-5ede0770f22e",
                                                "sense_id": "035492df-2017-3f14-b1de-18e5f7463be3",
                                                "text": "In the sequel we restrict ourselves to “nice” cases without going into details about the nicety conditions which have to be fulfilled (see, e.g., Freudenthal [1])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426eb875-17bb-37de-bc59-6656ef64cc10",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "Thirlage."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d72f9e13-e6ba-3d34-aba5-6178d7988cce",
                                        "entry_id": "8c52620a-11dc-3b8b-912b-3fc400a7318b",
                                        "glosses": [
                                            "A person's descendants."
                                        ],
