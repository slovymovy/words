                        ],
                        "form": "gabbles"
                    },
                    {
                        "form_id": "4da5a013-1aff-4c33-80e6-646acdced050",
                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                        "tags": [
                            "participle",
