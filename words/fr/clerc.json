                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>clerc</w> a préparé l'acte de vente avant l'arrivée des clients à l'étude."
                        },
                        {
                            "text": "Elle a commencé sa carrière comme simple <w>clerc</w> avant de devenir notaire."
                        }
                    ],
                    "common_phrases": [
