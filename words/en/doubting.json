    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3567c93-60ae-3d38-a1c3-517bd145eea2",
                    "sense_definition": "present participle and gerund of <w>doubt</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was secretly <w>doubting</w> her ability to finish the difficult marathon.",
                            "target_lang_translations": {
                                "ru": "Втайне она <w>сомневалась</w> в своей способности добежать сложный марафон."
                            }
                        },
                        {
                            "text": "There is no point in <w>doubting</w> his intentions after everything he did to help.",
                            "target_lang_translations": {
                                "ru": "Нет никакого смысла <w>сомневаться</w> в его намерениях после всего, что он сделал, чтобы помочь."
                            }
                        }
                    ],
                    "synonyms": [
                        "questioning",
                        "distrusting"
                    ],
                    "antonyms": [
                        "believing",
                        "trusting"
                    ],
                    "common_phrases": [
                        "doubting one's ability",
                        "doubting his word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола doubt (сомневаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомневающийся",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "сомневаясь",
                                "target_lang_sense_clarification": "деепричастие"
                            },
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "герундий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a6de95b-bbf3-3d15-b12d-1ad6f8acd234",
                    "sense_definition": "Full of doubt; feeling or showing uncertainty; skeptical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained a <w>doubting</w> Thomas until he saw the final results with his own eyes.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>Фомой неверующим</w>, пока не увидел окончательные результаты своими глазами."
                            }
                        },
                        {
                            "text": "The committee cast <w>doubting</w> looks at the presenter during the unexpected proposal.",
                            "target_lang_translations": {
                                "ru": "Члены комитета бросали <w>недоверчивые</w> взгляды на докладчика во время его неожиданного предложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "dubious",
                        "skeptical",
                        "uncertain"
                    ],
                    "antonyms": [
                        "certain",
                        "confident",
                        "convinced"
                    ],
                    "common_phrases": [
                        "doubting Thomas",
                        "doubting mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий сомнения; скептический, недоверчивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомневающийся",
                                "target_lang_sense_clarification": "о человеке или взгляде"
                            },
                            {
                                "target_lang_word": "недоверчивый",
                                "target_lang_sense_clarification": "скептически настроенный"
                            },
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "выражающий скептицизм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd001a45-38bc-31df-ad01-38c1e8696a93",
                    "sense_definition": "A condition or feeling of uncertainty and hesitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "doubt_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of internal <w>doubting</w>, she finally made the brave decision to resign.",
                            "target_lang_translations": {
                                "ru": "После месяцев внутренних <w>сомнений</w> она наконец приняла смелое решение уйти в отставку."
                            }
                        },
                        {
                            "text": "His speech was intended to put an end to all lingering fears and <w>doubtings</w>.",
                            "target_lang_translations": {
                                "ru": "Его речь была призвана положить конец всем оставшимся страхам и <w>сомнениям</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncertainty",
                        "hesitation",
                        "misgiving"
                    ],
                    "antonyms": [
                        "certainty",
                        "conviction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или чувство неопределённости, неуверенности и колебаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "чувство неуверенности"
                            },
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "нерешительность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
