                    {
                        "translation_id": "d04c211b-b1b6-43c4-a7ae-baa586201140",
                        "source_entry_id": "0f926b34-58ca-3600-b716-d3c71d0668a9",
                        "source_sense_id": "7dd35ad6-6f43-3842-8fdb-2b61b35db83b",
                        "source_sense_description": "iets in de vorm van een zaagtand",
                        "target_lang_word": "Zahnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "532e49c0-77c0-3a4e-a6c4-61e53e3e6fde",
                                        "entry_id": "4754f4a8-af92-33a3-a2e5-44be2e7193ca",
                                        "glosses": [
                                            "Durchbruch/Hervorkommen der Zähne; Dentition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8d8a22-e20a-46a2-8863-4393d44a2f49",
                                                "sense_id": "532e49c0-77c0-3a4e-a6c4-61e53e3e6fde",
                                                "text": "„Fehlende Zahnung mit einem Jahr wird allgemein als verzögert angesehen, kann aber noch normal sein.“"
                                            },
                                            {
                                                "example_id": "8012cfcf-65e0-40b2-ba75-5c0c43d66260",
                                                "sense_id": "532e49c0-77c0-3a4e-a6c4-61e53e3e6fde",
                                                "text": "„Halbjährig fängt die Zahnung an,",
                                                "translation": "Wackelt dein Kopf samt künstlichem Gebiss.“"
                                            },
                                            {
                                                "example_id": "8c736798-270d-4bc9-b859-b9216dd8c842",
                                                "sense_id": "532e49c0-77c0-3a4e-a6c4-61e53e3e6fde",
                                                "text": "„Es hat sich bewährt bei weichem Zahnschmelz, Karies, verzögerter Zahnung, Knochenbrüchen, rachitischem Knochenbau sowie bei schlaffen Bändern und Gelenken.“"
                                            },
                                            {
                                                "example_id": "a154c1ed-b7bc-4a48-8c72-af5b7b36c0af",
                                                "sense_id": "532e49c0-77c0-3a4e-a6c4-61e53e3e6fde",
                                                "text": "„Durch verschieden große Zahnung können bei diesen Mühlen unterschiedliche Korngrößen erzielt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54d0bae0-c7d0-3bdc-a0d9-cff77f6d737d",
                                        "entry_id": "4754f4a8-af92-33a3-a2e5-44be2e7193ca",
                                        "glosses": [
                                            "zackenartiger Rand bei etwas; Gesamtheit der aneinandergereihten Zähne, Zinken (zum Beispiel bei einer Säge); Zähnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9056e007-93ac-40b7-953e-fff551bb9d60",
                                                "sense_id": "54d0bae0-c7d0-3bdc-a0d9-cff77f6d737d",
                                                "text": "„Die im Handel erhältlichen normalen Fräser haben in den meisten Fällen eine gröbere Zahnung.“"
                                            },
                                            {
                                                "example_id": "e3dc6f75-930c-462f-beb6-1bc58c8e0648",
                                                "sense_id": "54d0bae0-c7d0-3bdc-a0d9-cff77f6d737d",
                                                "text": "„Die Sägeblätter der Hubsägen werden bei gröberer Zahnung meist mit geschränkten Zähnen, bei feinerer Zahnung mit gewellten Zähnen ausgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
