                                "target_senses": [
                                    {
                                        "sense_id": "ebd69157-0141-32ff-95a8-1dae8f7fe268",
                                        "entry_id": "341d34f6-29f0-3b7b-8de8-25a7f840213b",
                                        "glosses": [
                                            "A means of exit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8516f5-6725-4a6a-a4c8-e743ccd3dea5",
                                                "sense_id": "ebd69157-0141-32ff-95a8-1dae8f7fe268",
                                                "text": "The way out is along this corridor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed676a4-4235-3709-b385-a2d1aa5b5c68",
                                        "entry_id": "341d34f6-29f0-3b7b-8de8-25a7f840213b",
                                        "glosses": [
                                            "An act or instance of departure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f26b57e-5592-4357-ad7a-6a63b8655cbb",
                                                "sense_id": "0ed676a4-4235-3709-b385-a2d1aa5b5c68",
                                                "text": "Lock the door on your way out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aada345-d848-3429-a95d-18c190a11554",
                                        "entry_id": "341d34f6-29f0-3b7b-8de8-25a7f840213b",
                                        "glosses": [
                                            "A solution to a problem; an escape."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb335ae-f67a-4b15-a629-7cb080609099",
                                                "sense_id": "0aada345-d848-3429-a95d-18c190a11554",
                                                "text": "This is a real mess. I need a way out."
                                            },
                                            {
                                                "example_id": "0d9f0b53-09f4-4199-b4c4-91925326f763",
                                                "sense_id": "0aada345-d848-3429-a95d-18c190a11554",
                                                "text": "The plight of the elderly plagued with mental decline, such as Alzheimer's dementia, is particularly poignant because at the point where the decline in mental capacity may make life no longer worth living to them, they are incapable of choosing suicide as a way out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "way out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37494ece-d2ee-3b20-bd19-6e7ced6dbfbd",
                                        "entry_id": "7f086bc1-a5bb-3dc5-a8f5-2ae5efc6756e",
                                        "glosses": [
                                            "Unconventional, eccentric."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f203a3-bee9-4558-84f4-0798e9b6575a",
                                                "sense_id": "37494ece-d2ee-3b20-bd19-6e7ced6dbfbd",
                                                "text": "This modern art is too way out for me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "way out",
                                "target_lang_code": "en",
                                "target_senses": [
