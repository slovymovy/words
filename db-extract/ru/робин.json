                "senses": [
                    {
                        "sense_id": "da6f87fc-0f5f-3cc9-a83c-2e0f7be410d3",
                        "entry_id": "4b14f550-4f1a-3ac4-9806-522b13fb535d",
                        "glosses": [
                            "английское женское имя; уменьш. от Роберта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ff5af2-875a-4951-8756-1ab9ea45ed81",
                                "sense_id": "da6f87fc-0f5f-3cc9-a83c-2e0f7be410d3",
                                "text": "Путешествие Робин Дэвидсон стало сенсацией 1977 года."
                            },
                            {
                                "example_id": "e1bf5056-6f23-4455-be11-1d9030028837",
                                "sense_id": "da6f87fc-0f5f-3cc9-a83c-2e0f7be410d3",
                                "text": "Ранней осенью 78-го года я разыскал в Нью-Йорке Робин, и теперь уже она повела нас с Жанной обедать в ресторан, а оттуда в кафе ― пить кофе и есть мороженое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d8289a8-22e2-4632-9b99-954b3990f0d8",
                        "source_entry_id": "4b14f550-4f1a-3ac4-9806-522b13fb535d",
                        "source_sense_id": "da6f87fc-0f5f-3cc9-a83c-2e0f7be410d3",
                        "source_sense_description": "Перевод имени",
                        "target_lang_word": "Robin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Robin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ad8753d-453e-3917-80eb-0bbcee54d9b4",
                                        "entry_id": "7fe098b6-ac2e-3b08-b436-11816ae97ce6",
                                        "glosses": [
                                            "A unisex given name.",
                                            "A male given name from the Romance languages or the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b240e10-2bcd-4dc9-b978-a76afbad6bdd",
                                                "sense_id": "7ad8753d-453e-3917-80eb-0bbcee54d9b4",
                                                "text": "They ſay hee is already in the Forreſt of Arden, and a many merry men with him; and there liue like the old Robin Hood of England"
                                            },
                                            {
                                                "example_id": "ac21f72b-55bc-487d-9568-49c6b6f76f35",
                                                "sense_id": "7ad8753d-453e-3917-80eb-0bbcee54d9b4",
                                                "text": "This waly boy will be nae coof: /I think we'll call him Robin./ Robin was a rovin' boy, / Rantin', rovin', rantin', rovin', /Robin was a rovin' boy, / Rantin', rovin' Robin."
                                            },
                                            {
                                                "example_id": "73a85dcd-49a8-449d-aebd-f59711fedaf4",
                                                "sense_id": "7ad8753d-453e-3917-80eb-0bbcee54d9b4",
                                                "text": "Some names simply aren't appropriate after a while. Say you were called Robin, for instance. Well that's a perfectly good monicker up to the age of about nine, but pretty soon you'd have to do something about it, wouldn't you? Change your name by deed-poll to Samson, or Goliath, or something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c3e6459-4dca-3e37-afb1-362c9560f11e",
                                        "entry_id": "7fe098b6-ac2e-3b08-b436-11816ae97ce6",
                                        "glosses": [
                                            "A unisex given name.",
                                            "A female given name from the Germanic languages, also associated with the bird robin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10c4f91-e170-411c-ad25-0b633db9227d",
                                                "sense_id": "7c3e6459-4dca-3e37-afb1-362c9560f11e",
                                                "text": "\"We'll name her Robin,\" her mother said, and it was as though at her words something of that spring and the bird's song and his gay and friendly and impudent spirit entered into the child."
                                            },
                                            {
                                                "example_id": "04f785e4-6e08-4ee5-bb75-57f8bf550d52",
                                                "sense_id": "7c3e6459-4dca-3e37-afb1-362c9560f11e",
                                                "text": "In March 1953, a month after Jeb was born, the Bush family received the devastating news that Robin had leukemia. A local doctor told the Bushes that doctors had never seen a white blood cell count that high and there was nothing they could do for her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6853c9f7-7637-3551-96c4-377a4ded3069",
                                        "entry_id": "7fe098b6-ac2e-3b08-b436-11816ae97ce6",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
