                    {
                        "translation_id": "0a52512f-2d3b-4192-9c2b-195552415b29",
                        "source_entry_id": "fa7051a4-b653-3128-820b-3727733b9143",
                        "source_sense_id": "25816bc7-1e64-3576-bf20-e2f96f1a7829",
                        "source_sense_description": "plants of the genus Verbascum",
                        "target_lang_word": "molène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                        "entry_id": "37b3e911-2e62-3394-aa73-6444f6b12bd4",
                                        "glosses": [
                                            "Plante de la famille des Scrofulariacées, bisannuelles, cotonneuses, aux feuilles en rosette à la base, elliptiques et alternes, aux fleurs à cinq pétales, le plus souvent jaunes et groupées en longs épis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555af5ec-a7f7-474e-970d-c09d82d49119",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "Elle arrosait elle-même ses plates-bandes de roses trémières, de molènes pourpres, de phlox vivaces."
                                            },
                                            {
                                                "example_id": "17297908-8004-4c9c-a3d5-1723024923e6",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "Si votre chaussure vous irrite le pied, mettez-y une feuille de molène."
                                            },
                                            {
                                                "example_id": "3de771b9-42f1-4004-b3c3-65dafc157319",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "De sa main restée libre, il écarta des feuilles de molène poussées entre les interstices."
                                            },
                                            {
                                                "example_id": "ca9dbeb7-d967-4476-a391-6d888705961a",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "Les tiges des molènes de l'année dernière se dressent sur le banc de sable comme des bougies sans flamme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48ecff23-ab48-49c0-bb58-2d42dfcdb1cd",
                        "source_entry_id": "fa7051a4-b653-3128-820b-3727733b9143",
                        "source_sense_id": "25816bc7-1e64-3576-bf20-e2f96f1a7829",
                        "source_sense_description": "plants of the genus Verbascum",
                        "target_lang_word": "Königskerze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Königskerze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae989fd8-4104-3e44-bf85-a73dcb67778b",
                                        "entry_id": "95d23590-7afa-36c4-9151-e6fadb3b4fbc",
                                        "glosses": [
                                            "eine Pflanzengattung (Verbascum) aus der Familie der Braunwurzgewächse (Scrophulariaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74fce50b-d1d2-4028-ab18-a385f4882cf1",
                                                "sense_id": "ae989fd8-4104-3e44-bf85-a73dcb67778b",
                                                "text": "Die Königskerze wächst wild an Wiesen- und Waldrändern."
                                            },
                                            {
                                                "example_id": "ab6130a2-250b-4766-ae51-1f4a16e7ddc5",
                                                "sense_id": "ae989fd8-4104-3e44-bf85-a73dcb67778b",
                                                "text": "Die alten Germanen verehrten die Königskerze bei ihren Sonnwendfeiern."
                                            },
                                            {
                                                "example_id": "b397063d-5bee-439a-aa10-8059d192a432",
                                                "sense_id": "ae989fd8-4104-3e44-bf85-a73dcb67778b",
                                                "text": "Die Königskerze wurde einst verräuchert, um böse Zauberkräfte und Dämonen abzuwehren."
                                            },
                                            {
                                                "example_id": "818dc0d0-9e3d-47f0-9bb3-7b81c3b4a2a4",
                                                "sense_id": "ae989fd8-4104-3e44-bf85-a73dcb67778b",
                                                "text": "„Es war wohl ein letztes Zeichen seines Heuschnupfens, da immer noch Königskerzen in den Wiesen standen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
