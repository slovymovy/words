                        ],
                        "examples": [
                            {
                                "example_id": "11322e04-409c-4875-8722-213666fa5cbf",
                                "sense_id": "8186d3c5-598d-3154-a11b-97e6b3e0c519",
                                "text": "Le cric d’arbalète est erronément connu de nos jours, sous le nom de cranequin. À l’origine, ce mot désignait l’arbalète et non le mécanisme destiné à la tendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30d28c10-0ee4-47ef-8950-bbef82f83280",
                        "source_entry_id": "89d469a6-5c6d-305c-a3ce-046a1c96292e",
                        "source_sense_id": "8186d3c5-598d-3154-a11b-97e6b3e0c519",
                        "source_sense_description": "De façon erronée",
                        "target_lang_word": "irrtümlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
