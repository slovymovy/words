            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99990140-eeb0-374f-99b6-2a6dfcb6c31d",
                    "sense_definition": "To be successful, thrive, or gain good fortune, especially financially or in one's endeavors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With hard work and dedication, the new business began to <w>prosper</w> in its second year.",
                            "target_lang_translations": {
                                "tr": "Çok çalışma ve özveriyle, yeni işletme ikinci yılında <w>gelişmeye</w> başladı.",
                                "nl": "Door hard werken en toewijding begon het nieuwe bedrijf in het tweede jaar te <w>bloeien</w>.",
                                "ru": "Благодаря упорному труду и преданности делу новый бизнес начал <w>процветать</w> уже на второй год."
                            }
                        },
                        {
                            "text": "The small coastal town continues to <w>prosper</w> under the new economic policies.",
                            "target_lang_translations": {
                                "tr": "Küçük sahil kasabası yeni ekonomik politikalar altında <w>refaha kavuşmaya</w> devam ediyor.",
                                "nl": "Het kleine kuststadje blijft onder het nieuwe economische beleid <w>gedijen</w>.",
                                "ru": "Небольшой прибрежный городок продолжает <w>процветать</w> благодаря новой экономической политике."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrive",
                        "flourish",
                        "succeed",
                        "do well"
                    ],
                    "antonyms": [
                        "fail",
                        "decline",
                        "fall"
                    ],
                    "common_phrases": [
                        "begin to prosper",
                        "continue to prosper"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle finansal alanda veya girişimlerde başarılı olmak, gelişmek veya iyi bir talih elde etmek.",
                        "nl": "Succesvol zijn, floreren of voorspoed genieten, met name financieel of in iemands ondernemingen.",
                        "ru": "Быть успешным, процветать, преуспевать, особенно в финансовом плане или в делах."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "refaha kavuşmak",
