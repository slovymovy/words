                "senses": [
                    {
                        "sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                        "entry_id": "a59b170e-330c-30bc-a019-fb7051dda46e",
                        "glosses": [
                            "jemand, der sich durch Leichtsinn und Unzuverlässigkeit auszeichnet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a32f03-b1e8-4d77-ac8c-68573ea1ff73",
                                "sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                                "text": "In dieser Angelegenheit hat sich Hein nicht zum ersten Mal als echter Luftikus erwiesen."
                            },
                            {
                                "example_id": "d2b7fce2-ddfc-483b-a2e6-d9f30042e57a",
                                "sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                                "text": "„Bis in die zwanziger Jahre galt Franklin D. Roosevelt in weiten Kreisen als fröhlicher Luftikus mit nicht allzu großem Sachverstand- obwohl er von 1913 bis 1919 Staatssekretär im Marineministerium gewesen war.“"
                            },
                            {
                                "example_id": "c12c38f5-d787-4804-9a8a-719225e38671",
                                "sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                                "text": "„Sehr anständig hat sich dieser Herr Pagel kaum benommen, und es ist nur gut, so ein Luftikus merkt mal, man sieht ihm auf die Finger.“"
                            },
                            {
                                "example_id": "e2149c44-1aef-4021-8ebb-7252d4b0a4b7",
                                "sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                                "text": "„Nie war ich Spieler, nie einer, der ohne Strapazen davonkam. Nie Luftikus, der tänzelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd65010-b26c-4289-aedd-99b9215ec40d",
                        "source_entry_id": "a59b170e-330c-30bc-a019-fb7051dda46e",
                        "source_sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                        "source_sense_description": "umgangssprachlich: jemand, der sich durch Leichtsinn und Unzuverlässigkeit auszeichnet",
                        "target_lang_word": "lightheaded person",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c3dcc8ed-024b-45e6-9416-95d50ce1e72b",
                        "source_entry_id": "a59b170e-330c-30bc-a019-fb7051dda46e",
                        "source_sense_id": "ff53a37d-a84b-3cf0-9137-153b2ed082d7",
                        "source_sense_description": "umgangssprachlich: jemand, der sich durch Leichtsinn und Unzuverlässigkeit auszeichnet",
                        "target_lang_word": "écervelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écervelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a7f61e6-e5b2-3272-953c-0924fd5264cd",
                                        "entry_id": "b8ba9988-0deb-3071-be25-9cfae494401e",
                                        "glosses": [
                                            "Qui a peu de jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b0cf07-bd00-4b73-b102-836ed972e413",
                                                "sense_id": "0a7f61e6-e5b2-3272-953c-0924fd5264cd",
                                                "text": "Renée, depuis qu’on négociait son mariage, avait retrouvé son allure d’écervelée, sa tête folle."
                                            },
                                            {
                                                "example_id": "43e1bc05-ae07-40e8-9afa-b4a3efbf3d5f",
                                                "sense_id": "0a7f61e6-e5b2-3272-953c-0924fd5264cd",
                                                "text": "Du temps qu'il était ministre, […], quel non initié eût imaginé que Ferry était le salonard écervelé que l'on découvre aujourd'hui ?"
                                            },
                                            {
                                                "example_id": "7df7b5ca-3459-4627-b8fe-ea5fcee78cd4",
                                                "sense_id": "0a7f61e6-e5b2-3272-953c-0924fd5264cd",
                                                "text": "Gerbederose la regardait aller et hochait parfois la tête, pensive, se disant qu’il devait y avoir un bon Dieu pour les écervelées, car, malgré toute l’affection que lui inspirait son employée, elle continuait de la blâmer pour sa décision."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écervelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69d61118-9169-364d-9d7f-0994262a3fe9",
                                        "entry_id": "6efcf360-da47-3a76-93cd-c6a2899d036d",
                                        "glosses": [
                                            "Personne qui a peu de jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bb8523-459d-40e1-a808-00a6ccdfe737",
                                                "sense_id": "69d61118-9169-364d-9d7f-0994262a3fe9",
                                                "text": "– Vous comprenez, disait-il au serrurier, c’est pour une chambre de jeune fille : ces écervelées égarent la clé et il faut pour la retenir quelque chose de solide, une grosse chaîne persuasive, assez gracieuse pourtant, n’est-ce pas ?"
                                            },
                                            {
                                                "example_id": "0de8a89a-dd01-4c30-8755-a1a1b62925a3",
                                                "sense_id": "69d61118-9169-364d-9d7f-0994262a3fe9",
                                                "text": "Ni la vieille schnoque au chignon grisaillant entortillé par-dessus son austère visage rebutant de gouvernante acariâtre, ni la jeune écervelée qui se prenait pour le nombril du monde, n'entendait lâcher prise, jamais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écervelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40993b66-99a8-343c-9ff0-1188d21f470d",
                                        "entry_id": "60a2d566-f700-3c74-a724-db94d408633d",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe écerveler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
