                        "entry_id": "6ed893ab-0bab-3693-8c78-360cf43c2563",
                        "glosses": [
                            "жить некоторое время у кого-либо в качестве гостя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d40088-0f9c-4b92-89b4-100c1aa5f5a2",
                                "sense_id": "d973d4e1-ff46-3cb3-aa7f-beb47e29f1de",
                                "text": "Учитель же в гимназии Буркин каждое лето гостил у графов П."
