                        "translation_id": "923864ff-927d-481b-bec3-a052bf9f7d19",
                        "source_entry_id": "fd966857-4a6c-3d8d-bf56-be2453616c21",
                        "source_sense_id": "cd5d7d2f-ff3f-3358-b081-744fd58377da",
