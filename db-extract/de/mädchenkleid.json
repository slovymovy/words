                "senses": [
                    {
                        "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                        "entry_id": "a9f6d436-fe7d-3813-89ba-a30ea7115b68",
                        "glosses": [
                            "einteilige Oberbekleidung (= Kleid) eines Mädchens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adcebaf-52db-4b8b-a3ab-5be3d885d814",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "Das ist aber ein hübsches Mädchenkleid!"
                            },
                            {
                                "example_id": "e5ff7511-b34a-4901-9e4b-80fd17980531",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Das war gemein, ihn hier allein am Baggersee zurückzulassen in diesem lächerlichen Aufzug mit einem Mädchenkleid.“"
                            },
                            {
                                "example_id": "08480541-acca-4d40-afbe-f7aa222ecc0c",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Ich war splitterfasernackt. Sie hatten mir nur ein Mädchenkleid dagelassen. Ich hatte die Wahl, entweder nackt oder in einem Kleid aus der Umkleide zu kommen.“"
                            },
                            {
                                "example_id": "901b9126-a144-498c-9491-62da7f70aeff",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Dies hier war ein Frauenkleid, kein Mädchenkleid. Soviel verriet ihr allein Macs Blick.“"
                            },
                            {
                                "example_id": "bd2965c6-2aad-4cdf-af66-ef87341df9a4",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Kinderkleid nähen: Mit diesem einfachen Schnittmuster zauberst du ein wunderschönes Mädchenkleid aus Jersey und anderen dehnbaren Stoffen.“"
                            },
                            {
                                "example_id": "1076e04f-cf4a-475b-bfe9-53d64f79fcb8",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Was tun, mit alten Männerhemden? Wegwerfen? Zu schade! Wenn der Stoff nicht gerade voller Flecken oder Mottenlöcher ist, kann daraus ein zuckersüßes Mädchenkleid genäht werden.“"
                            },
                            {
                                "example_id": "922aca56-aac7-4900-a71c-5d6e7f547967",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "[Kaufhaus:] Die Mädchenkleider finden sie bei uns in der dritten Etage."
                            },
                            {
                                "example_id": "a626134c-0d00-46cb-80cb-a95bc7600f48",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Mit seinen Mädchenkleidern und grellen Handtaschen ist der Künstler und Transvestit Grayson Perry aus der britischen Kunstszene nicht mehr wegzudenken.“"
                            },
                            {
                                "example_id": "480efeaf-5c95-4235-9e7f-aaf7ca8ffb90",
                                "sense_id": "b53a0285-0f89-3035-8349-25dfbce2c10d",
                                "text": "„Schon als Bub wollte sie lieber Mädchenkleider tragen. Gemeinsam mit ihrer Ehefrau und den drei Kindern ist sie den schweren Weg vom Mann zur Frau gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
