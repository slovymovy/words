                "forms": [
                    {
                        "form_id": "934e6068-1206-45f8-a2f7-d23408863700",
                        "entry_id": "bc8453d5-5cc3-3a88-afba-3dec31608364",
                        "tags": [
                            "plural"
                        ],
                        "form": "friteuses"
                    },
                    {
                        "form_id": "1c866654-814e-42e9-89af-984ab94d2f31",
                        "entry_id": "bc8453d5-5cc3-3a88-afba-3dec31608364",
                        "tags": [
                            "masculine"
                        ],
                        "form": "friteur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                        "entry_id": "bc8453d5-5cc3-3a88-afba-3dec31608364",
                        "glosses": [
                            "Ustensile de cuisine constitué d’une bassine, pouvant contenir de l’huile de cuisson, et d’un panier métallique servant à y plonger les aliments à frire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f4f10a-ea85-41d2-8108-09c371b41ffa",
                                "sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                                "text": "L’huile bouillonne dans la friteuse, et, à l’odeur, tout le quartier doit savoir que nous allons manger des beignets."
                            },
                            {
                                "example_id": "58c1605b-2f19-4dc5-a26f-f0a767a2aaca",
                                "sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                                "text": "Cette transformation est indispensable pour assurer une bonne tenue de la sardine dans les opérations de « friterie » proprement dites, menées immédiatement après par les friteuses."
                            },
                            {
                                "example_id": "3a245589-5e94-412e-ba6f-88c91a709ddd",
                                "sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                                "text": "On ne t’a jamais appris qu’on n’éteint pas une friteuse en flammes avec de l’eau ? Viiite, l’extincteur !"
                            },
                            {
                                "example_id": "7ef73908-46f7-474c-ad96-3a4e7156870a",
                                "sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                                "text": "Barbecue, friteuse, groupe électrogène, barils à feu pour se réchauffer… depuis jeudi 18 janvier, le monde agricole occitan s’organise pour faire entendre sa voix."
                            }
                        ]
                    },
                    {
                        "sense_id": "c56c4b46-311c-3080-bf4a-0d67a814634d",
                        "entry_id": "bc8453d5-5cc3-3a88-afba-3dec31608364",
                        "glosses": [
                            "Cuisinière spécialement chargée des fritures."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "78389ebb-a4fe-4322-8e23-8038645e389b",
                                "sense_id": "c56c4b46-311c-3080-bf4a-0d67a814634d",
                                "text": "Un carrefour. Marchandes, peuple. Hercule, jeune moutard populaire, s’approche de la friteuse. Il est suivi d’un second gamin beaucoup plus grand que lui.\nLa Friteuse. Qu’est-c’qui t’faut, moutard ?\nHercule. Des bien frites pour un sou."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fff8831-020d-41d0-9d42-70306aa7234c",
                        "source_entry_id": "bc8453d5-5cc3-3a88-afba-3dec31608364",
                        "source_sense_id": "42da7243-c69b-3970-a12a-63a14bd53b98",
                        "source_sense_description": "Ustensile",
                        "target_lang_word": "Fritteuse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fritteuse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                        "entry_id": "78b50aea-ac1c-3945-b693-42e4fa3d19f6",
                                        "glosses": [
                                            "Küchengerät zum Frittieren von Speisen mit heißem Fett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ef1b07-6493-4ec1-b440-6631a6b4b703",
                                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                                "text": "Die Anschaffung einer Fritteuse will gut überlegt sein."
                                            },
                                            {
                                                "example_id": "5fb19f63-4881-412b-b713-6646f0378b17",
                                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                                "text": "„An der fehlenden Fritteuse liegt es im Übrigen nicht, dass ich nicht als waschechte Holländerin durchgehen kann.“"
                                            },
                                            {
                                                "example_id": "82ee8f05-bc28-4092-91c6-8b5d9e5f0523",
                                                "sense_id": "eb94aa75-4962-3c96-832f-d1baeefcaa6f",
                                                "text": "„Ungeklärtes Gänseschmalz oder Hammelfett dagegen haben in der Fritteuse nichts zu suchen, sie entwickeln ein penetrantes Schweißfußaroma.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
