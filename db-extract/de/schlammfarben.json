                ],
                "senses": [
                    {
                        "sense_id": "69c9998f-c453-3c5d-ab27-e6b91d345406",
                        "entry_id": "315c4924-8f35-3a48-9604-e6da552bb1d7",
                        "glosses": [
                            "die Farbe von Schlamm habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe721c0-f628-413c-810a-06525e2a8726",
                                "sense_id": "69c9998f-c453-3c5d-ab27-e6b91d345406",
                                "text": "„Er zeigte auf ein langbeiniges, schlammfarbenes Kalb.“"
                            },
                            {
                                "example_id": "d95391bc-3898-4390-a80e-5b667210d2f7",
                                "sense_id": "69c9998f-c453-3c5d-ab27-e6b91d345406",
                                "text": "„Sie kleidet sich besonders sorgfältig, tuscht sich die Wimpern, und als der Himmel schlammfarben ist und die Sonne das halbherzige Versprechen gibt aufzugehen, verlässt sie das Al-Aman.“"
                            },
                            {
                                "example_id": "dc29f733-c0c8-43ab-8d55-d0777cf7f825",
                                "sense_id": "69c9998f-c453-3c5d-ab27-e6b91d345406",
                                "text": "„Balthazarr hatte die Räume in ein Abbild seines spanischen Heimatstudios verwandelt. Farben, Leinwände, Pinsel, die in schlammfarbenen Gläsern schwammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
