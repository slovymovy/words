                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6c8a04-f2fe-499f-9cea-09a85cd2fe6c",
                                "sense_id": "96b92cd5-d166-30e6-b37e-d8e80fc8a2d7",
                                "text": "„Kennst du diesen Gospelsong?“"
                            },
                            {
                                "example_id": "505cba82-37cb-48a4-bee5-99bc39719d50",
                                "sense_id": "96b92cd5-d166-30e6-b37e-d8e80fc8a2d7",
                                "text": "„Er hörte, wie in der Küche Wasser lief und die Polizistin einen Gospelsong summte.“"
                            },
                            {
                                "example_id": "cad88711-04c2-41c6-846d-294f686b0436",
                                "sense_id": "96b92cd5-d166-30e6-b37e-d8e80fc8a2d7",
                                "text": "„Sie tranken aus Harrys Feldflasche, die Reinemachfrau krächzte Gospelsongs, während die Officer, die Telefonate zu erledigen hatten, die Hände an die Ohren pressten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
