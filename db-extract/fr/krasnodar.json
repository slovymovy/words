                                "example_id": "ed1961b8-ced1-44b6-8ddc-4396bd799cd5",
                                "sense_id": "e4f388f1-823d-3aac-b563-0bc2242741cc",
                                "text": "Le visage fatigué, ces Français du salon agricole de Krasnodar ne cachent toutefois pas certaines frustrations."
                            }
