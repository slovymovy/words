                "senses": [
                    {
                        "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                        "entry_id": "a1654d70-3ae9-375b-8494-9b5d5084419f",
                        "glosses": [
                            "bei der Modellierung eines Projekts auftretende Schwierigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21af84fe-cd7a-427d-9c5d-89e7de048db4",
                                "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                                "text": "„Sowohl Moderne wie Neugotik versprachen umfassende Lösung aller Entwurfsprobleme.“"
                            },
                            {
                                "example_id": "f401d247-1779-428e-ae4c-eb4a28033cb3",
                                "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                                "text": "„Ein echtes Entwurfsproblem liegt dann vor, wenn im technischen Abbildbereich keine funktionserfüllende Struktur bekann ist.“"
                            },
                            {
                                "example_id": "2dd8bf73-549c-4f6b-bf4b-ddff5957109a",
                                "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                                "text": "„Wenn das konkrete Entwurfsproblem nicht in die Klassifikation eingeordnet werden kann, wird zum siebten Arbeitsschritt verzweigt, um einen alternativen Problembereich zu selektieren.“"
                            },
                            {
                                "example_id": "9d6dd164-4309-4ddf-8ca8-c778e2929f64",
                                "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                                "text": "„Jedes als Lösung hervorgebrachte Artefakt vermittelt ein Wissen über das Verhältnis der Entwurfslösung im Bezug auf das Entwurfsproblem.“"
                            },
                            {
                                "example_id": "fa0b280d-91db-4f7a-8306-5aec747cef49",
                                "sense_id": "1144dd45-564b-3df5-a09e-1b528bb71892",
                                "text": "„In der Softwareentwicklung stößt man früher oder später auf Entwurfsprobleme, die man lösen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
