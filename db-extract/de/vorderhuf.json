                        "glosses": [
                            "Huf an einem der vorderen Beine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4d3f8b-a052-46a0-b333-b47c66cd8b1e",
                                "sense_id": "63160e1a-0313-30f3-adcf-08ad2920df94",
                                "text": "„Ruhig ließ er ihm die Zügel auf dem Sattelknopf liegen und trat rasch durch die Tür, während sein Pony zuerst den schöngeformten Hals schüttelte, so daß der weiße Schaum ringsum flog, und dann mit dem rechten Vorderhuf den Boden zerscharrte und stampfte, als ob es ungeduldig auf den Herrn warte und die Hetze so schnell wie möglich fortzusetzen wünsche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
