                "senses": [
                    {
                        "sense_id": "32903aed-8c2e-3e82-92e2-54979bd5f7c7",
                        "entry_id": "32322136-a674-3a05-be48-5fe57c6d309f",
                        "glosses": [
                            "(kleiner) Teil von Gestein, der zur Untersuchung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1f954d-3704-4b5f-b143-5516c7925853",
                                "sense_id": "32903aed-8c2e-3e82-92e2-54979bd5f7c7",
                                "text": "„Dann laufen die beiden Mondmänner umher und sammeln Gesteinsproben und Mondstaub ein, insgesamt 47,7 Kilogramm.“"
                            },
                            {
                                "example_id": "0ad76c18-b8fb-4d74-a81d-ee6e6965049e",
                                "sense_id": "32903aed-8c2e-3e82-92e2-54979bd5f7c7",
                                "text": "„Sein Spiel drückte das Rasen der Sinne, Gewissensbisse, Verzweiflung aus, und er stürzte sich in Pécuchets Schwert (das man sich denken mußte) mit solcher Wucht, daß er über die Gesteinsproben stolperte und beinahe zu Boden fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
