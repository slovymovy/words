            "senses": [
                {
                    "sense_id": "c8da3ba9-ff35-3f57-99f6-5d0633256780",
                    "sense_definition": "The process of making something clean.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen requires a thorough <w>cleaning</w> before we can cook in it.",
                            "target_lang_translations": {
