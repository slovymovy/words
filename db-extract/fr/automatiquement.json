                                            {
                                                "example_id": "3b626d1f-03b2-4c08-8250-3f1db384266c",
                                                "sense_id": "1bee6b61-067a-354b-a20d-1ff9581bda4a",
                                                "text": "In dat gebouw staat een automatische machine te draaien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fefaaec3-adcb-3ec1-bb0e-b0343b4e2ff5",
                                        "entry_id": "6828a283-c1c2-3315-9e85-9e3d95daf1b4",
                                        "glosses": [
                                            "vanzelfgaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dcf53ca-0486-41de-b126-f2032a516c1f",
                                                "sense_id": "fefaaec3-adcb-3ec1-bb0e-b0343b4e2ff5",
                                                "text": "Zoals altijd richtte ik mijn slaapplaats direct bij aankomst in voordat ik te moe werd. Het ging op de automatische piloot en in minder dan twee minuten stond mijn tent klaar; een lichtgewicht ontwerp van ‘Zpacks’, een klein bedrijf uit Florida."
                                            },
                                            {
                                                "example_id": "4d398bca-bb7d-4353-8b83-85b94b8d4de9",
                                                "sense_id": "fefaaec3-adcb-3ec1-bb0e-b0343b4e2ff5",
                                                "text": "In die tijd zwommen we voornamelijk op kracht, dus je werd automatisch sneller naarmate je groeide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd0fd96-fcb6-343a-a242-4af47c9f7389",
                                        "entry_id": "6828a283-c1c2-3315-9e85-9e3d95daf1b4",
                                        "glosses": [
                                            "gedachteloos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5979b55-37de-4de7-af88-62774ccc352d",
                                                "sense_id": "cbd0fd96-fcb6-343a-a242-4af47c9f7389",
                                                "text": "Dat was een automatische reactie op het probleem van hem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "automatisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "93b47370-7f03-39c0-ad07-2581d8c67ec1",
