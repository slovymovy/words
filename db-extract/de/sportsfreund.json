                                "example_id": "3a6e925f-08c7-4ff4-afd6-556c5fa9f4e1",
                                "sense_id": "34787d9b-30f2-3706-8b6c-ff7d19881b39",
                                "text": "Meine Sportsfreunde waren sauer, weil ich das Training geschwänzt hatte."
                            }
                        ],
