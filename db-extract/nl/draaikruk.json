                        "glosses": [
                            "eenvoudig zitmeubel zonder leuning dat kan draaien om een verticale as"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded56020-58c7-4834-985a-15be1ad39dee",
                                "sense_id": "95d4543c-e95c-3a90-ba1e-bfafeb696bfc",
                                "text": "Ik zat al enige tijd in de halfschaduw van de cabine, de draaikruk op de goede hoogte, en maakte geen haast om munten in de machine te gooien."
                            },
                            {
                                "example_id": "e10945d2-bc96-46b6-a420-32ef3392a1d3",
                                "sense_id": "95d4543c-e95c-3a90-ba1e-bfafeb696bfc",
                                "text": "De pianist rees enkele centimeters van zijn draaikruk omhoog en loerde al spelend over zijn muziek naar de uitzonderlijke verschijning van Gerarda, die zijn taak zo nu en dan zou overnemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "88f7cd7f-a8dd-3ebd-b6c1-36d028601604",
                        "entry_id": "349d8607-6fd9-3811-8132-271c160dffc0",
                        "glosses": [
                            "handvat aan een raam waarmee je het door ronddraaien kan openen of afsluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8a84b2-9ad7-417e-acac-d636adf542bc",
                                "sense_id": "88f7cd7f-a8dd-3ebd-b6c1-36d028601604",
                                "text": "Het kozijn heeft een nette en afgewerkte uitstraling, omdat alle beslagonderdelen verdekt zijn gemonteerd. Het is mogelijk om de draaikruk te beveiligen met een slot, om de kans op een inbraak kleiner te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef7931a9-4888-39e3-b7bd-a2e1dbbfa99d",
                        "entry_id": "349d8607-6fd9-3811-8132-271c160dffc0",
                        "glosses": [
                            "handgreep aan iets dat rond kan draaien"
