                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ee1aad-947f-4f92-9ac0-89374ff39f11",
                                "sense_id": "53e7e2f9-bc76-3b0a-b00b-de5941340b11",
                                "text": "De zon was nog niet op en met mijn hoofdlamp checkte ik nog een laatste keer al mijn spullen om te zorgen dat ik niets zou vergeten."
                            },
                            {
                                "example_id": "2df80a1e-a9ab-4063-a8c0-55ebdc8ec221",
                                "sense_id": "53e7e2f9-bc76-3b0a-b00b-de5941340b11",
                                "text": "De bonnetjes geven ook een inkijkje in de diverse afscheidscadeaus voor de bewindslieden. Zo kreeg Jeanine Hennis (Defensie) onder meer een survivalkit met een kompas, poncho, multitool, hoofdlamp en een rugzak."
                            }
                        ]
