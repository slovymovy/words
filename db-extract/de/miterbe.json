                "senses": [
                    {
                        "sense_id": "e8e8215b-cc0a-3e97-8230-962520085b2b",
                        "entry_id": "8337b93b-efd3-30b2-990d-a94007b9a0cc",
                        "glosses": [
                            "Person, die sich mit mindestens einer weiteren Person eine Erbschaft teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf5f4ce-8ba0-484b-a632-71879f993775",
                                "sense_id": "e8e8215b-cc0a-3e97-8230-962520085b2b",
                                "text": "„Verkauft ein Miterbe seinen Anteil an einen Dritten, so sind die übrigen Miterben zum Vorkauf berechtigt.“"
                            },
                            {
                                "example_id": "88d9bf06-5225-49a2-b57a-1bb922b06980",
                                "sense_id": "e8e8215b-cc0a-3e97-8230-962520085b2b",
                                "text": "„Das Geld der Erbtante wäre dann für die Familie nicht verloren - es würde, statt auf den Staat, auf die übrigen Miterben überspringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
