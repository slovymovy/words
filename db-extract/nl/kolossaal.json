                ],
                "senses": [
                    {
                        "sense_id": "b4a1c17c-848d-3c56-992a-6dd474ee5dc1",
                        "entry_id": "bfd81740-ce45-3ca7-bb78-c3ec5ff543f6",
                        "glosses": [
                            "van bijzonder grote omvang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8765acbe-6f15-4785-ad71-31310edf0f42",
                                "sense_id": "b4a1c17c-848d-3c56-992a-6dd474ee5dc1",
                                "text": "Lufthansa volgt het voorbeeld van Singapore Airlines, Qantas, ANA en Korean Air, die allen hebben besloten het kolossale vliegtuig van 73 meter weer de lucht in te sturen."
                            }
                        ]
                    },
                    {
                        "sense_id": "33d6be39-1315-367c-bd8b-955779b965cc",
                        "entry_id": "bfd81740-ce45-3ca7-bb78-c3ec5ff543f6",
                        "glosses": [
                            "geweldig"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "766b68f0-4366-4b19-bbf3-8fe83a32d52f",
                        "source_entry_id": "bfd81740-ce45-3ca7-bb78-c3ec5ff543f6",
                        "target_lang_word": "colossal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colossal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Extremely large or on a great scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72454110-5d2b-4d10-8578-17265690b6f4",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "A single puppy can make a colossal mess."
                                            },
                                            {
                                                "example_id": "b1b65ea9-eac6-4c08-93e3-3929f3a7de0b",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "7c26a2ae-992b-4886-9bc1-5010e0f05976",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "What is wrong with you, you colossal fucking creep⁉ You found the only possible wrong answer to that question! “What’s your favorite color? Hitler.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Amazingly spectacular; extraordinary; epic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37153e2a-c473-48a5-a43e-6ee174b171be",
                                                "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                                "text": "\"It's just the very biggest thing that I ever heard of!\" said I, though it was my journalistic rather than my scientific enthusiasm that was roused. \"It is colossal. You are a Columbus of science who has discovered a lost world.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69af7e66-a9ba-4b2f-ad76-7d49c33542a8",
                        "source_entry_id": "bfd81740-ce45-3ca7-bb78-c3ec5ff543f6",
                        "target_lang_word": "huge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8fa5a1-a8d4-44db-9d3c-6cb00ee94896",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the chlorotic squatters on huge yachts,[…]the neurotic victims of mental cirrhosis, the jewelled animals whose moral code is the code of the barnyard—!”"
                                            },
                                            {
                                                "example_id": "756a1c7a-cb79-452a-8b00-709ce8431997",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            },
                                            {
                                                "example_id": "2d21e2b2-f460-4cf6-99f0-c7c69240bf45",
                                                "sense_id": "e4338431-3357-32fd-bd9a-a27e92d1290c",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very strong, powerful, or dedicated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c4504b-e424-4a9b-b81a-764fa7012faa",
                                                "sense_id": "df94a0a2-df36-3de4-b4c2-0b5c9f6ea90c",
                                                "text": "Both of my parents are huge supporters of animal rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                        "entry_id": "b35a7fde-6367-33d7-b61c-5d48526cdac1",
                                        "glosses": [
                                            "Very interesting, significant, or popular."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3a2e1e-cbba-4939-bc35-1d53dc32c905",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "The band's next album is going to be huge."
                                            },
                                            {
                                                "example_id": "be4fa9d9-f27c-4d6c-ae72-8a73a776af17",
                                                "sense_id": "be18f605-da18-3b06-8a05-8b1cd7541e75",
                                                "text": "In our league our coach is huge!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
