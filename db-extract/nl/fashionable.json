                "senses": [
                    {
                        "sense_id": "3dce572f-e6a5-337a-851b-4b678562fc89",
                        "entry_id": "49b09bce-db07-3720-9cdf-a7c5e98b870b",
                        "glosses": [
                            "goed passend bij de heersende mode; volgens de laatste mode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5d9105-8148-41c1-ad36-2e4b35c8bd91",
                                "sense_id": "3dce572f-e6a5-337a-851b-4b678562fc89",
                                "text": "Australiërs Ben Lipschitz en Rick Munitz ontdekten dat vrouwen na een avondje stappen de behoefte hebben aan schoeisel dat makkelijk loopt. Ze bedachten samen de Flipster, een opvouwbare 'fashionable' slipper en ballerina."
                            },
                            {
                                "example_id": "74ac6699-1b9f-4ef0-a16f-fd34e4541b2a",
                                "sense_id": "3dce572f-e6a5-337a-851b-4b678562fc89",
                                "text": "Toen haar zus Eline (17) en vriendin Eva Peeters (18) uit Laren met het initiatief voor een goedkope fashionable webshop kwamen, deed ze direct mee."
                            },
                            {
                                "example_id": "82e0f849-ebd3-4ff9-b211-9716f40119d9",
                                "sense_id": "3dce572f-e6a5-337a-851b-4b678562fc89",
                                "text": "Modebewust rondlopen in je vrije tijd is een ding, maar niet elke fashionable look is ook geschikt voor de werkvloer. De volgende trends voor deze herfst kun je beter niet dragen op kantoor."
                            }
                        ]
                    }
