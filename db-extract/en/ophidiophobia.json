                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2128750-67a1-3a44-b756-161ca0faeb99",
                        "entry_id": "3ebd3693-aafd-3383-b6b3-1d0dcecad3fc",
                        "glosses": [
                            "Ophiophobia; a fear of snakes."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "36a70705-6793-4ba1-bc8a-dd3542ec7520",
                                "sense_id": "e2128750-67a1-3a44-b756-161ca0faeb99",
                                "text": "His father had a severe case of ophidiophobia, but to his credit he allowed his non-ophidiophobic 12-year-old son to keep a small colony of the Common Garter Snake (Thamnophis sirtalis) in a large box pen in a far corner of their Wisconsin backyard."
                            },
                            {
                                "example_id": "ab2d4dba-955b-46f3-9308-5decdb49fefd",
                                "sense_id": "e2128750-67a1-3a44-b756-161ca0faeb99",
                                "text": "The second-most-common phobia is ophidiophobia, the fear of snakes. Ophidiophobia is one of the most debilitating fears in humans; even the picture of a snake in a magazine or image of one on TV can invoke intense fear in some people."
                            }
                        ]
                    }
                ],
