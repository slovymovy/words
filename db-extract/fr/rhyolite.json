                    }
                ],
                "senses": [
                    {
                        "sense_id": "87963ed0-dbaa-392b-8e48-c0fa65170bff",
                        "entry_id": "90008062-d070-38f3-a17e-8832d15f0a6a",
                        "glosses": [
                            "Roche effusive, à structure microlithique, équivalente pour les roches plutoniques au granite. Contient des quartz, des feldspaths et des micas dans une pâte rougeâtre. Couleur rose clair à rouge (porphyre rouge)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0382774-efab-44b4-8b11-2c0a16cd0674",
                                "sense_id": "87963ed0-dbaa-392b-8e48-c0fa65170bff",
                                "text": "Le Mont Porphyrites est constitué de rhyolite, une roche volcanique de couleur rouge, avec laquelle on a fait de nombreuses statues qui trônent aujourd’hui dans les musées."
                            },
                            {
                                "example_id": "c5b5d306-77ff-4552-83d3-a5451826ded5",
                                "sense_id": "87963ed0-dbaa-392b-8e48-c0fa65170bff",
                                "text": "Pour les fabriquer, on a eu recours tantôt à la rhyolite (pointe quasi-Port Maitland) et tantôt au chert (mini-pointes à pédoncule et pointes de type Levanna)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768cbe97-8a49-4833-832a-843144baccd4",
                        "source_entry_id": "90008062-d070-38f3-a17e-8832d15f0a6a",
                        "source_sense_id": "87963ed0-dbaa-392b-8e48-c0fa65170bff",
