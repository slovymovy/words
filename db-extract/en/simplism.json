                        "source_entry_id": "3bc9a801-b0a3-336c-8bcd-781071a5fc96",
                        "source_sense_description": "trait of oversimplifying things by ignoring complexity and complications",
                        "target_lang_word": "simplisme",
                        "target_lang_code": "fr",
