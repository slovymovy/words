                "senses": [
                    {
                        "sense_id": "95d0d76c-6c93-3ac9-b949-c2ad9bb97aaf",
                        "entry_id": "de5d044d-8391-38ce-a0f9-c7b4fa8f1754",
                        "glosses": [
                            "weibliche Person, die mit einem Fahrrad fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e9b3fc-cd6b-48d9-99f6-6459c51f7dd1",
                                "sense_id": "95d0d76c-6c93-3ac9-b949-c2ad9bb97aaf",
                                "text": "Die Fahrradfahrerin beobachtete aufmerksam die anderen Verkehrsteilnehmer."
                            },
                            {
                                "example_id": "fb2c2b39-8bbb-469a-b46e-30f92c136008",
                                "sense_id": "95d0d76c-6c93-3ac9-b949-c2ad9bb97aaf",
                                "text": "„Der 46-Jährige Lenker dürfte die Fahrradfahrerin übersehen haben.“"
                            },
                            {
                                "example_id": "c8e7b71f-1e50-496e-bb5b-9600a5f53764",
                                "sense_id": "95d0d76c-6c93-3ac9-b949-c2ad9bb97aaf",
                                "text": "„Dabei stieß er mit der 53-jährigen Fahrradfahrerin zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4b7731a-3dce-4f5c-a92a-92fbadc36ce9",
                        "source_entry_id": "de5d044d-8391-38ce-a0f9-c7b4fa8f1754",
                        "source_sense_id": "95d0d76c-6c93-3ac9-b949-c2ad9bb97aaf",
                        "source_sense_description": "weibliche Person, die mit einem Fahrrad fährt",
                        "target_lang_word": "bicyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                        "entry_id": "78ea4dd8-3d16-3659-8b6e-f62cbad43391",
                                        "glosses": [
                                            "Rare form of cyclist."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf80c2b-19ba-44d8-8bdf-d1b7565c8b6b",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "“Yes, that is true, professor. I believe I’ve been guilty of doing so myself; but look here, Miss Eunice,” and he turned suddenly to the professor’s daughter, “they tell me that you are an enthusiastic bicyclist.”"
                                            },
                                            {
                                                "example_id": "0e8ff210-3678-4de6-bb92-d7b41debe5c4",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "Our policemen, of course, will be fitted out with large, twirlable moustaches and small, twirlable rolling-pins, and will be taught to turn their backs on traffic jams, but to blow whistles violently at solitary bicyclists."
                                            }
                                        ]
                                    }
                                ]
                            }
