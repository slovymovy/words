                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>reculer</w> la date limite pour rendre les devoirs."
                        },
                        {
                            "text": "En raison des retards de livraison, nous avons dû <w>reculer</w> le lancement du produit."
                        }
                    ],
                    "synonyms": [
                        "retarder",
                        "reporter",
                        "ajourner",
                        "différer"
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
