                    {
                        "sense_id": "d924dc47-e0d3-3de8-bab3-1ac7986e156e",
                        "entry_id": "f5c8a858-281e-32ac-bb26-344158e6c0ef",
                        "glosses": [
                            "Verbindung/Sequenz von Aminosäuren"
