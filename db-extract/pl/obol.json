                ],
                "translations": [
                    {
                        "translation_id": "f142b4a9-e1d0-441d-9dcb-fbc4f34cfecc",
                        "source_entry_id": "1a324c40-c683-3489-b2ca-b09edb7481bd",
                        "source_sense_id": "cac3a36e-978d-3178-8e0e-64a8ac108731",
                        "source_sense_description": "antikes Griechenland: Obolus",
                        "target_lang_word": "Obolus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obolus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cab6bd07-3c11-3a64-abed-b021f0209079",
                                        "entry_id": "09e8a950-ad44-30b8-ba97-16908d89cc13",
                                        "glosses": [
                                            "kleine Münze im alten Griechenland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745c1711-a664-4536-9ba2-3805937fdd04",
                                                "sense_id": "cab6bd07-3c11-3a64-abed-b021f0209079",
                                                "text": "Jedem toten Griechen wurde ein Obolus unter die Zunge gelegt."
                                            },
                                            {
                                                "example_id": "6590a4b9-5f1b-43e2-a289-4c5f8041cc20",
                                                "sense_id": "cab6bd07-3c11-3a64-abed-b021f0209079",
                                                "text": "(hyperkorrekte „lateinische“ Pluralform) Die älteste Silbermünze, welche hier bekannt ist, war der halbe Denar, 15 Oboli enthaltend; auf der einen Seite ist ein Christuskopf mit der Inschrift: „ Iesus Christus\" in gothischen Buchstaben, […]"
                                            },
                                            {
                                                "example_id": "48cb43b6-cb4b-46e1-aa5f-784ec83e2b9b",
                                                "sense_id": "cab6bd07-3c11-3a64-abed-b021f0209079",
                                                "text": "(griechische Pluralform) Während zunächst nur große Münzen geprägt wurden, begann sehr bald auch die Produktion kleinerer Nominale. Ein Talent umfaßte 60 Minen, eine Mine 100 Drachmen und eine Drachme 6 Oboloi, […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9ee3e9c-137d-3a58-b5f3-dc2fb3bb4374",
                                        "entry_id": "09e8a950-ad44-30b8-ba97-16908d89cc13",
                                        "glosses": [
                                            "kleine Geldspende, kleiner finanzieller Beitrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5620796a-83c5-4025-8006-bc9fa2f560dc",
                                                "sense_id": "a9ee3e9c-137d-3a58-b5f3-dc2fb3bb4374",
                                                "text": "Und es wäre nett, wenn Sie für unsere weitere Arbeit einen kleinen Obolus entrichten würden."
                                            },
                                            {
                                                "example_id": "8621876c-41f8-425d-b860-2dc460ba6913",
                                                "sense_id": "a9ee3e9c-137d-3a58-b5f3-dc2fb3bb4374",
                                                "text": "„Ein verdrossenes Ehepaar saß dort einsam am Tisch und nahm meine Kupferstücke mit einem Lächeln entgegen, das dem des trübsinnigen Charon glich, mit dem er den Obolus empfängt.“"
                                            },
                                            {
                                                "example_id": "6130ee86-f591-447c-8905-f64d2140382c",
                                                "sense_id": "a9ee3e9c-137d-3a58-b5f3-dc2fb3bb4374",
                                                "text": "„Uschi Obermaier noch einmal in die Augen zu sehen: Das wäre sicherlich einen Obolus wert gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
