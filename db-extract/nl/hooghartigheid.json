                        "glosses": [
                            "verwaande houding tegenover anderen; zich hoger achten dan anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7dc549b-df3b-4bb7-b5d5-ad7acf78d63c",
                                "sense_id": "a1869848-b1bc-3503-bea6-2e6d5bb177ef",
                                "text": "Lang dachten veel Nederlandse clubs en voetbalfans veel te lichtzinnig over wedstrijden tegen kleine voetballanden. Een bepaald soort hooghartigheid, die gebaseerd was op resultaat uit een alweer ver verleden."
                            },
                            {
                                "example_id": "645a190e-f5cc-4ecc-b636-c09609ba933c",
                                "sense_id": "a1869848-b1bc-3503-bea6-2e6d5bb177ef",
                                "text": "Yang werd er door zijn opstandige aandeelhouders uitgeknikkerd. Zijn opvolgster Carol Bartz verklaarde dat Yahoo alleen te koop is voor 'scheepsladingen geld'. Die hooghartigheid is nu helemaal weg. De financiële resultaten van Yahoo worden steeds slechter en het personeel loopt weg. Op de beurs is het aandeel Yahoo ingestort."
                            }
                        ]
                    }
