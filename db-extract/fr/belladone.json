                                        "entry_id": "aada5fd9-4f06-371e-a4b9-c624cc537488",
                                        "glosses": [
                                            "The plant Atropa belladonna, a perennial shrub of the nightshade family that contains high concentrations of the alkaloid atropine which can be deadly if taken in excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b434cf7-8134-479b-bcb5-51fb8b44a1a0",
                                                "sense_id": "05e68618-9baa-396b-8bd9-c1ab891223a6",
                                                "text": "Deadly nightshade, henbane, hellebore and mandrakes were of evil reputation[.]"
                                            }
                                        ]
