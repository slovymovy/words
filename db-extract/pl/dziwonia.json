                "senses": [
                    {
                        "sense_id": "dc77905e-61a3-3d03-a2a7-ca9d932d36a3",
                        "entry_id": "2c5b5ea2-fd64-3785-8216-0675c2dbe109",
                        "glosses": [
                            "Carpodacus erythrinus, niewielki ptak należący do rodziny ziarnojadów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b486c454-f352-4d22-81fa-bbb261bbd837",
                        "source_entry_id": "2c5b5ea2-fd64-3785-8216-0675c2dbe109",
                        "source_sense_id": "dc77905e-61a3-3d03-a2a7-ca9d932d36a3",
                        "target_lang_word": "чечевица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чечевица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "edea914d-db5d-3621-9fc2-9452ed0a4e7c",
                                        "entry_id": "ede899cf-3a17-30c2-ba89-0982171da67e",
                                        "glosses": [
                                            "ботан. однолетнее травянистое растение из семейства бобовых, со съедобными плоскими округлыми бобами (Lens)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc9158e-54c4-48c8-96c6-bfce3b7be31f",
                                                "sense_id": "edea914d-db5d-3621-9fc2-9452ed0a4e7c",
                                                "text": "Большинство таких форм цветут и созревают одновременно с чечевицей и представляют собою типичный случай мимикрии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1b8f1ff-5908-30f9-b160-e5230316ed59",
                                        "entry_id": "ede899cf-3a17-30c2-ba89-0982171da67e",
                                        "glosses": [
                                            "плод такого растения, зерно в форме маленькой двояковыпуклой линзы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10aa6868-25b7-4e0c-8e51-7ac7b9248428",
                                                "sense_id": "b1b8f1ff-5908-30f9-b160-e5230316ed59",
                                                "text": "Эльза делала какие-то бусы из крашеной чечевицы, из негритянского горошка, она их продавала в модные дома — у Арагона не было денег…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ec3ca2-5fb5-3ec4-acfe-8a28fda62e4d",
                                        "entry_id": "ede899cf-3a17-30c2-ba89-0982171da67e",
                                        "glosses": [
                                            "кулин. кушанье из таких плодов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e337c8-b469-40ae-bd52-2003232a72ca",
                                                "sense_id": "06ec3ca2-5fb5-3ec4-acfe-8a28fda62e4d",
                                                "text": "Знатным хочется прослыть меценатами за дешевую цену; им любо посмеяться со мной или надо мной, потому, что смех способствует пищеварению, — и я, второй Исав, продам свое первородство за блюдо чечевицы?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf1212b-7272-31c4-a375-9501c4aa7b79",
                                        "entry_id": "ede899cf-3a17-30c2-ba89-0982171da67e",
                                        "glosses": [
                                            "устар. линза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf5918a-27cf-483a-a20d-15db5102d593",
                                                "sense_id": "ebf1212b-7272-31c4-a375-9501c4aa7b79",
                                                "text": "Вогнутая чечевица, выточенная из пластинки кварца, помещенная в том же аппарате и в подобных же условиях, представляет ряд концентрических колец, подобных ньютоновским кольцам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4997157d-c887-3fa8-9e89-00f9f46e31b2",
                                        "entry_id": "ede899cf-3a17-30c2-ba89-0982171da67e",
                                        "glosses": [
                                            "перен. объект в форме чечевицы [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc236f67-73d7-46ce-bd4e-1c58dccda02e",
                                                "sense_id": "4997157d-c887-3fa8-9e89-00f9f46e31b2",
                                                "text": "Снимок был сделан из неудобного поворота — Галактика пришлась сильно вкось и сверху, так что центральное ядро едва выступало горящей выпуклой массой в середине узкой чечевицы."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чечевица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "546c7f5c-a747-38be-b460-f1db53467a31",
                                        "entry_id": "13d32c41-2094-393b-8d82-5ba7b126cf1a",
                                        "glosses": [
                                            "орнитол. небольшая певчая птица семейства вьюрковых отряда воробьиных (лат. Carpodacus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c9532f-f0a9-40db-9ef8-be5633cc31b3",
                                                "sense_id": "546c7f5c-a747-38be-b460-f1db53467a31",
                                                "text": "Как побегут ручьи, как вскроются камчатские речки, прилетает из Индии красный воробей-чечевица и везде поёт свою песню чистым, флейтовым свистом."
                                            },
                                            {
                                                "example_id": "88be9009-110d-430d-9015-95a4887415d1",
                                                "sense_id": "546c7f5c-a747-38be-b460-f1db53467a31",
                                                "text": "В определителях, изданных в середине прошлого века, её называли длиннохвостым снегирём, к концу XX переименовали в длиннохвостую чечевицу, что более соответствовало современной систематике."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
