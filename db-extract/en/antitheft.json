                    },
                    {
                        "translation_id": "bccd0dae-05a8-47bc-81fe-8f8c8a15f025",
                        "source_entry_id": "b219ff46-0f10-3f39-9bd6-6c5833e48e29",
                        "source_sense_id": "6d4a8d48-592f-3413-84a0-628d42c182ae",
                        "source_sense_description": "preventing from being stolen",
                        "target_lang_word": "einbruchsicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einbruchsicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                        "entry_id": "5a9415bc-bf3b-34a0-8ba9-df5a402b63db",
                                        "glosses": [
                                            "(durch spezielle Vorrichtungen) vor Einbruch geschützt, gegen Einbruch gesichert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b86b9b-a3fd-4d98-800e-5184478b1cab",
                                                "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                                "text": "„Der ermordete Treuhandchef hatte sich entgegen den polizeilichen Empfehlungen kein schußhemmendes, sondern lediglich einbruchsicheres Fensterglas in seine Düsseldorfer Villa einbauen lassen.“"
                                            },
                                            {
                                                "example_id": "b047e636-45b9-409d-9d74-2c4390265c76",
                                                "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                                "text": "„‚Einbruchhemmendes Glas und spezielle Beschläge mit Verriegelungen machen es Ganoven immer schwerer‘, sagte Schmid, warnte aber gleichzeitig vor zu großen Hoffnungen: ‚Das total einbruchsichere Haus gibt es nicht.‘“"
                                            },
                                            {
                                                "example_id": "eb6551ad-0eff-4ce2-95c6-f43a39d7f485",
                                                "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                                "text": "„Der vom Amtsdirektor vor einigen Monaten ins Leben gerufene Arbeitskreis hatte sich bereits im April auf eine Reihe von Kompromissen, so zum Einbau einbruchsicherer Kellerfenster, zu Beschlägen und Briefkästen, geeinigt.“"
                                            },
                                            {
                                                "example_id": "7d9784f4-f8c3-4fd0-b2b7-bdd8d6606536",
                                                "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                                "text": "„Ich hatte mir fest vorgenommen, unser Heim irgendwann einmal einbruchsicher zu machen; meine Kontakte bei der Polizei zu nutzen und jemanden kommen zu lassen, der die offensichtlichen Schwachstellen an Fenstern und Türen beseitigte.“"
                                            },
                                            {
                                                "example_id": "62f4351a-c4e2-4e32-b34a-f9914eaa7ac5",
                                                "sense_id": "a1d4aff0-87a8-3c47-a9fe-368511f9df61",
                                                "text": "„Die einbruchsichersten Fenster nützen allerdings wenig, wenn die Bewohner ihr Haus nur ‚kurz‘ für etwa eine Stunde verlassen, ohne gekippte Fenster zu schließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
