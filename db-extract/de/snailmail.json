                "translations": [
                    {
                        "translation_id": "560bea12-40a7-4f9b-9b1f-3d6c2aa9f955",
                        "source_entry_id": "07810937-1b97-3abe-8928-b7749b3565a1",
                        "source_sense_id": "8d8e6dc2-d9bf-3ecb-a92d-53ecbc3de9c8",
                        "target_lang_word": "snail mail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snail mail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99794a33-dd2f-3859-a438-ea954ceaa698",
                                        "entry_id": "c76ae9b0-ebfb-3803-b980-8131e5fa5853",
                                        "glosses": [
                                            "Mail (physical material) sent in the post, especially as compared with email."
                                        ],
                                        "tags": [
                                            "retronym",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec50ea84-6afd-403a-8751-f38f297879d5",
                                                "sense_id": "99794a33-dd2f-3859-a438-ea954ceaa698",
                                                "text": "I came home to a mailbox stuffed with snail mail."
                                            },
                                            {
                                                "example_id": "9d7d39c7-d9b6-44b1-921d-71ad42955573",
                                                "sense_id": "99794a33-dd2f-3859-a438-ea954ceaa698",
                                                "text": "To send a letter by snail mail (the Postal Service), you must still compose it, and also print it out, unless you write it by hand or on a typewriter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501cf1ad-0185-32ad-b665-071d134ab9ab",
                                        "entry_id": "c76ae9b0-ebfb-3803-b980-8131e5fa5853",
                                        "glosses": [
                                            "Mail (postal service), especially as compared with email."
                                        ],
                                        "tags": [
                                            "retronym",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b27230-c4fd-4279-a082-dabb3179368b",
                                                "sense_id": "501cf1ad-0185-32ad-b665-071d134ab9ab",
                                                "text": "The official notice will be sent via both email and snail mail owing to legal requirements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c8ac872-46ce-4c9e-be70-f2fde24567f0",
                        "source_entry_id": "07810937-1b97-3abe-8928-b7749b3565a1",
                        "source_sense_id": "8d8e6dc2-d9bf-3ecb-a92d-53ecbc3de9c8",
                        "target_lang_word": "smail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                        "entry_id": "a09946f3-d058-31c1-883e-2e0942c7a9f6",
                                        "glosses": [
                                            "Conventional postal mail; snail mail."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b34302a-4e4d-44a4-bc45-88781ece1e3d",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "To receive this list by smail send self addressed stamped envelope"
                                            },
                                            {
                                                "example_id": "ddd3c2b9-6631-471c-8b69-f7d92bd8665e",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "On a similar note just imagine if we could persuade companies that sending junk smail is hugely ineffective. All those people, using all that paper, printers, ink, postmen etc etc."
                                            },
                                            {
                                                "example_id": "6c9b64a0-fa31-4bd8-bafb-26be3aa2628b",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "I would require a copy of the original image either by smail or email (scanned image requirement - 600 dpi min / jpg file) and the basic required size you would like the stamp/stamps to be."
                                            },
                                            {
                                                "example_id": "bf842583-b89f-45d6-8222-4cf91603b0ed",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "... so when I get promoted I can promote my connection :-) It has now been ordered, I just have to wait for the connection pack to be sent by smail."
                                            },
                                            {
                                                "example_id": "d24b01db-db45-4da9-8f0d-370b2d99a884",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "If anyone knows a smail order or internet vendor who carries them, please let me know ¶"
                                            },
                                            {
                                                "example_id": "66a87e28-14fc-4bbd-8a98-838096d9dc9f",
                                                "sense_id": "e892afae-4b41-374a-82c1-f06ee496e7a1",
                                                "text": "You must give the seller access to your checking account, which is risky, or send funds via smail, which is slow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83fca0a6-873d-3934-a18e-276254d26b0c",
                                        "entry_id": "779e687b-9726-3866-b7b6-c10e915c4426",
                                        "glosses": [
                                            "To send by postal mail."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aacd957f-de26-4dee-8afe-33b35a514a66",
                                                "sense_id": "83fca0a6-873d-3934-a18e-276254d26b0c",
                                                "text": "You can retrieve the references and go to lib. to get the articles, order the articles to be smailed to you from NLM, or download them to your fax machine"
                                            },
                                            {
                                                "example_id": "3a1d9aa1-6d77-4832-a283-726f141fa32d",
                                                "sense_id": "83fca0a6-873d-3934-a18e-276254d26b0c",
                                                "text": "I sent some key lime seeds to Davida last year by US Mail. IIRC, the cost of smailing few seeds was 4 or 5 bucks. --Dick."
                                            },
                                            {
                                                "example_id": "3e757c9e-5c1c-4c01-a9b4-fd470e780122",
                                                "sense_id": "83fca0a6-873d-3934-a18e-276254d26b0c",
                                                "text": "He met her on IRC and she started emailing, then smailing, then calling on the phone"
                                            },
                                            {
                                                "example_id": "ef710a9f-a22c-46e7-af9e-76bbe16525f7",
                                                "sense_id": "83fca0a6-873d-3934-a18e-276254d26b0c",
                                                "text": "I eventually stopped trying this bloated crud, and rang the Department to smail me the docs.[…] I gave up and got a friend to get me the documents in person from that office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
