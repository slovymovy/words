                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f8f85f1-e69e-45dd-a2c3-884383e1b5e5",
                        "source_entry_id": "fbde54fd-036b-36e3-a5cd-225b0810cbd5",
                        "source_sense_id": "a0a496ce-ae80-34fc-b450-949c6b047e0d",
