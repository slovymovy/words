                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "to draw a figure with geometric tools"
                            },
                            {
                                "target_lang_word": "draw",
                                "target_lang_sense_clarification": "general term for creating a figure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c71c00b4-53e2-3bd0-85a0-389f0393375f",
