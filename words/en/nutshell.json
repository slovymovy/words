    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "389823ee-3fb3-3faa-bf13-45a349cb663f",
                    "sense_definition": "The hard exterior shell enclosing the edible kernel of a nut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a metallic tool to crack the hard <w>nutshell</w> open.",
                            "target_lang_translations": {
                                "pl": "Użył metalowego narzędzia, aby rozłupać twardą <w>łupinę orzecha</w>."
                            }
                        },
                        {
                            "text": "To put it in a <w>nutshell</w>, the entire project was an overwhelming success.",
                            "target_lang_translations": {
                                "pl": "Mówiąc <w>w skrócie</w>, cały projekt okazał się ogromnym sukcesem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a nutshell"
                    ],
                    "target_lang_definitions": {
                        "pl": "Twarda, zewnętrzna łupina otaczająca jadalny środek orzecha."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łupina orzecha",
                                "target_lang_sense_clarification": "twarda zewnętrzna powłoka"
                            },
                            {
                                "target_lang_word": "skorupka orzecha",
                                "target_lang_sense_clarification": "twarda osłona owocu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed50dec9-35f8-3c54-95f7-2a2cfb5c1345",
                    "sense_definition": "A very small or fragile boat, especially when compared to a rough sea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive waves threatened to overturn our tiny <w>nutshell</w>.",
                            "target_lang_translations": {
                                "pl": "Ogromne fale groziły wywróceniem naszej malutkiej <w>łupinki</w>."
                            }
                        },
                        {
                            "text": "They bravely set out across the turbulent bay in a fragile wooden <w>nutshell</w>.",
                            "target_lang_translations": {
                                "pl": "Dzielnie wyruszyli przez wzburzoną zatokę w kruchej drewnianej <w>łupince</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo mała lub krucha łódź, zwłaszcza w zestawieniu z wzburzonym morzem; łupinka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łupinka",
                                "target_lang_sense_clarification": "o małej, niestabilnej łódce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3906e108-f4f6-33d5-8ced-1379d9c7f74b",
                    "sense_definition": "A concise handbook or guide summarizing a specific area of law.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student reviewed a legal <w>nutshell</w> right before the final exam.",
                            "target_lang_translations": {
                                "pl": "Student powtórzył materiał z <w>kompendium</w> prawniczego tuż przed egzaminem końcowym."
                            }
                        },
                        {
                            "text": "I bought a practical <w>nutshell</w> on contract law to prepare for my class.",
                            "target_lang_translations": {
                                "pl": "Kupiłem praktyczne <w>kompendium</w> z zakresu prawa umów, aby przygotować się do zajęć."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zwięzłe kompendium lub przewodnik podsumowujący daną dziedzinę prawa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kompendium",
                                "target_lang_sense_clarification": "zwięzłe opracowanie"
                            },
                            {
                                "target_lang_word": "zarys",
                                "target_lang_sense_clarification": "skrótowe omówienie tematu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "feb5d315-74fd-30bc-892b-28160af0b7c5",
                    "sense_definition": "To summarize or state something concisely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presenter managed to <w>nutshell</w> a complicated theory in just two minutes.",
                            "target_lang_translations": {
                                "pl": "Prezenter zdołał <w>streścić</w> skomplikowaną teorię w zaledwie dwie minuty."
                            }
                        },
                        {
                            "text": "Can you <w>nutshell</w> the main points of the report for the board?",
                            "target_lang_translations": {
                                "pl": "Czy możesz <w>podsumować</w> główne punkty raportu dla zarządu?"
                            }
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "capsulize"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage derived from the phrase in a nutshell"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Podsumować lub przedstawić coś w zwięzły sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "streszczać",
                                "target_lang_sense_clarification": "przedstawiać w skrócie"
                            },
                            {
                                "target_lang_word": "podsumowywać",
                                "target_lang_sense_clarification": "ujmować w krótkiej formie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
