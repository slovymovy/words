{
    "word_family": [
        "custodian",
        "custodial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4738dfd-569e-369b-8fe7-de479d7c59ae",
                    "sense_definition": "The legal right or duty to care for someone or something, especially a child after a divorce.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long legal battle, the court finally awarded <w>custody</w> to the child's father.",
                            "target_lang_translations": {
                                "ru": "После долгой судебной тяжбы суд наконец передал <w>опеку</w> отцу ребенка."
                            }
                        },
                        {
                            "text": "The parents decided to share joint <w>custody</w> to ensure the children spent time with both of them.",
                            "target_lang_translations": {
                                "ru": "Родители решили разделить совместную <w>опеку</w>, чтобы дети проводили время с обоими родителями."
                            }
                        }
                    ],
                    "synonyms": [
                        "guardianship",
                        "wardship"
                    ],
                    "common_phrases": [
                        "joint custody",
                        "sole custody",
                        "award custody",
                        "gain custody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законное право или обязанность заботиться о ком-либо или чем-либо, особенно о ребенке после развода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "над ребенком"
                            },
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "забота и ответственность"
                            },
                            {
                                "target_lang_word": "право на воспитание",
                                "target_lang_sense_clarification": "юридическое право"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9cef2af-4cb4-3d04-92f7-d8aea155bdc2",
                    "sense_definition": "The state of being kept in prison or a police station, especially while waiting for a trial.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was taken into police <w>custody</w> shortly after the incident occurred.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый был взят под <w>стражу</w> полицией вскоре после инцидента."
                            }
                        },
                        {
                            "text": "He remained in <w>custody</w> for three days before being released on bail.",
                            "target_lang_translations": {
                                "ru": "Он оставался под <w>арестом</w> в течение трех дней, прежде чем его выпустили под залог."
                            }
                        }
                    ],
                    "synonyms": [
                        "detention",
                        "imprisonment",
                        "confinement"
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "police custody",
                        "remand in custody",
                        "take into custody",
                        "escape from custody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения в тюрьме или полицейском участке, особенно в ожидании суда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержание под стражей",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "заключение",
                                "target_lang_sense_clarification": "лишение свободы"
                            },
                            {
                                "target_lang_word": "арест",
                                "target_lang_sense_clarification": "взятие под стражу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8da9f370-27a6-3746-ae49-4d650e407e00",
                    "sense_definition": "The protective care or temporary possession of someone else's property or assets.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank has safe <w>custody</w> of the family's historical documents and jewelry.",
                            "target_lang_translations": {
                                "ru": "Банк обеспечивает надежное <w>хранение</w> исторических документов и драгоценностей семьи."
                            }
                        },
                        {
                            "text": "The hotel management kept his passport in their <w>custody</w> until the bill was settled.",
                            "target_lang_translations": {
                                "ru": "Администрация отеля держала его паспорт у <w>себя</w>, пока счет не был оплачен."
                            }
                        }
                    ],
                    "synonyms": [
                        "safekeeping",
                        "charge",
                        "possession"
                    ],
                    "common_phrases": [
                        "safe custody",
                        "in the custody of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охрана или временное владение чужим имуществом или активами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранение",
                                "target_lang_sense_clarification": "в банке или сейфе"
                            },
                            {
                                "target_lang_word": "сохранение",
                                "target_lang_sense_clarification": "обеспечение сохранности"
                            },
                            {
                                "target_lang_word": "ответственное хранение",
                                "target_lang_sense_clarification": "юридическая обязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7e2409d-24d3-3246-9bde-6b2635443d11",
                    "sense_definition": "An administrative territorial division or area under the jurisdiction of a custos, particularly within the Franciscan Order.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_jurisdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Custody</w> of the Holy Land is responsible for maintaining several important Christian shrines.",
                            "target_lang_translations": {
                                "ru": "<w>Кустодия</w> Святой Земли отвечает за содержание нескольких важных христианских святынь."
                            }
                        },
                        {
                            "text": "Each Franciscan <w>custody</w> is overseen by a superior known as a custos.",
                            "target_lang_translations": {
                                "ru": "Каждая францисканская <w>кустодия</w> находится под надзором настоятеля, известного как кустод."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Административно-территориальное деление или область под юрисдикцией кустода, особенно в ордене францисканцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кустодия",
                                "target_lang_sense_clarification": "религиозная единица"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}