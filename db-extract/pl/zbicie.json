                "senses": [
                    {
                        "sense_id": "8007d87b-7d4f-38d4-b485-691df734dd2c",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "uderzanie w celu zadania bólu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81add8e-6fcb-4117-abb7-fe6be821d40d",
                                "sense_id": "8007d87b-7d4f-38d4-b485-691df734dd2c",
                                "text": "Została ukarana za zbicie koleżanki z drużyny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "93aa546a-003a-3b81-b663-50dd7c837d48",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "mocne uderzenie się podczas upadku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8bf559b-668f-4e04-81d0-b7597bd78419",
                                "sense_id": "93aa546a-003a-3b81-b663-50dd7c837d48",
                                "text": "Nastąpiło zbicie i założą ci specjalny opatrunek."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "67c30411-78d0-39cb-a5d9-db83dd41bb2c",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "stłuczenie czegoś ze szkła lub porcelany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30f837b-a14d-4cee-a1ae-f7321fcc5548",
                                "sense_id": "67c30411-78d0-39cb-a5d9-db83dd41bb2c",
                                "text": "Musi pan jednak zapłacić za przypadkowe zbicie dwunastu talerzy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "ed9c0d6c-1cb9-3061-bdb3-a27b00428050",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "połączenie desek gwoźdźmi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed872093-fb17-4aaf-9f93-142ef4ff5a17",
                                "sense_id": "ed9c0d6c-1cb9-3061-bdb3-a27b00428050",
                                "text": "Ile zajmie wam zbicie tej skrzyni?"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "76a333f7-3416-3e60-8bc8-1507f6b264bd",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "mocne odbicie piłki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe6575a-199e-4cde-9e43-568a4a83e5f9",
                                "sense_id": "76a333f7-3416-3e60-8bc8-1507f6b264bd",
                                "text": "Mocne zbicie piłki wpłynęło na dalsze losy setu."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "8e37856b-a804-3370-a456-f202c8b6e588",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "zabranie rywalowi karty, bierki lub pionka w grze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef6d0ead-525f-41bf-9000-3755605c39f2",
                                "sense_id": "8e37856b-a804-3370-a456-f202c8b6e588",
                                "text": "O wyniku zadecydowało zbicie damki przeciwnika."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "51b014a6-f946-39ae-9ea8-865e8a98e8c1",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "odparcie czyiś argumentów w dyskusji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fe7034-5666-4051-b5a9-ff60345f7c7e",
                                "sense_id": "51b014a6-f946-39ae-9ea8-865e8a98e8c1",
                                "text": "Całkowite zbicie argumentów adwokata okazało się niemożliwe."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    },
                    {
                        "sense_id": "741c4b8a-bd59-392a-a541-6cab57ff09a1",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "zmniejszenie wagi lub natężenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9d766d-04ce-4d3d-a63d-075d26498610",
                                "sense_id": "741c4b8a-bd59-392a-a541-6cab57ff09a1",
                                "text": "Co ci pomogło w tak szybkim zbiciu wagi?"
                            }
                        ],
                        "sense_index_json": "\"1.8\""
                    },
                    {
                        "sense_id": "5a99725d-4dcd-333a-a5be-f6a9174af6e5",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "usunięcie wierzchniej warstwy ze ścian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137cf25a-f5a3-4e68-b39f-668d5827b1e3",
                                "sense_id": "5a99725d-4dcd-333a-a5be-f6a9174af6e5",
                                "text": "Zapewne zbicie wszystkich tynków zajmie im cały tydzień."
                            }
                        ],
                        "sense_index_json": "\"1.9\""
                    },
                    {
                        "sense_id": "2dbcc554-90f3-3df8-9aab-ca71a6d57a4b",
                        "entry_id": "c8dbe78b-8e13-3a94-af3b-17ffbef353d8",
                        "glosses": [
                            "osiągnięcie dużego zysku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d70d914-9c9f-4337-a182-cd947dd5d599",
                                "sense_id": "2dbcc554-90f3-3df8-9aab-ca71a6d57a4b",
                                "text": "W zbiciu fortuny pomogła dobra koniunktura rynku."
                            }
                        ],
                        "sense_index_json": "\"1.10\""
                    }
