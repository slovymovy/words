                "translations": [
                    {
                        "translation_id": "75f4ade7-ea22-457d-80d0-1f6d8ffeb500",
                        "source_entry_id": "62d52436-74c5-3535-a893-57b9af90439b",
                        "source_sense_id": "c063fe91-8df2-37db-8fab-77bac61ca81e",
                        "target_lang_word": "consensus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c98a46e-f3ee-31c4-bf45-5d01b269d3df",
                                        "entry_id": "04094798-edb2-375b-9852-7142bbc583e6",
                                        "glosses": [
                                            "A process of decision-making that seeks widespread agreement among group members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee9643e8-97b9-312f-9525-199b364ca1c0",
                                        "entry_id": "04094798-edb2-375b-9852-7142bbc583e6",
                                        "glosses": [
                                            "General agreement among the members of a given group or community, each member of which exercises some discretion in decision-making and follow-up action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2fe259-b711-4b84-b46a-b9106cafe875",
                                                "sense_id": "ee9643e8-97b9-312f-9525-199b364ca1c0",
                                                "text": "reach consensus"
                                            },
                                            {
                                                "example_id": "c7d56f92-aad5-493a-b1ef-734a014f7a9a",
                                                "sense_id": "ee9643e8-97b9-312f-9525-199b364ca1c0",
                                                "text": "After years of debate over the best wine to serve at Thanksgiving, no real consensus has emerged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412b4c0e-e6a5-31a2-9790-b197e719163a",
                                        "entry_id": "04094798-edb2-375b-9852-7142bbc583e6",
                                        "glosses": [
                                            "An agreement on some data value that is needed during computation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b178d10f-ab43-32ff-8bb1-76819d4e94bf",
                                        "entry_id": "04094798-edb2-375b-9852-7142bbc583e6",
                                        "glosses": [
                                            "Average projected value."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37cd12c6-066a-47f5-be6a-30f25f080022",
                                                "sense_id": "b178d10f-ab43-32ff-8bb1-76819d4e94bf",
                                                "text": "a financial consensus forecast"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consensus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba979ae-81fe-358d-9920-ee4489b34fb0",
                                        "entry_id": "6f1540ff-7a8c-30f2-91cc-aaf6d5dcf512",
                                        "glosses": [
                                            "To seek consensus; to hold discussions with the aim of reaching mutual agreement."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc8add1-974b-41ca-85d8-31dcedae0b47",
                                                "sense_id": "dba979ae-81fe-358d-9920-ee4489b34fb0",
                                                "text": "I think we are a strongly consensused society. There was a consensus during the 1950's, the Eisenhower years, in our society. Then in the 1960's came a period of division."
                                            },
                                            {
                                                "example_id": "5e0b8110-413c-4854-bc12-d30a127f6b2c",
                                                "sense_id": "dba979ae-81fe-358d-9920-ee4489b34fb0",
                                                "text": "None of this consensusing was done with the Manual. There were no national workshops, forums, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d8d0d14-4cf7-4cc0-9984-72126281ed40",
                        "source_entry_id": "62d52436-74c5-3535-a893-57b9af90439b",
                        "source_sense_id": "c063fe91-8df2-37db-8fab-77bac61ca81e",
                        "target_lang_word": "consensus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dd71860-1793-3961-a99a-a168ed4e2c1e",
                                        "entry_id": "455878a4-242f-373e-a970-4e76d12f2425",
                                        "glosses": [
                                            "Accord tacite, ou sans opposition catégorique, des différentes parties d’une discussion sur un sujet déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3172be60-f744-403e-b48e-471b5a4cbce6",
                                                "sense_id": "6dd71860-1793-3961-a99a-a168ed4e2c1e",
                                                "text": "… En revanche, lorsque sur un même thème, les résultats débouchent sur des conclusions convergentes, on parle alors de consensus. Ce terme est préférable à celui de « vérité » car un consensus est toujours susceptible d’être remis en question par d’autres études."
                                            },
                                            {
                                                "example_id": "403f7ca0-9832-4963-91b8-51606454b79f",
                                                "sense_id": "6dd71860-1793-3961-a99a-a168ed4e2c1e",
                                                "text": "La prise de décision par consensus a été souvent présentée comme une innovation sociale et administrative prometteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25a922a-789c-3bad-8cf9-b3217f8ef366",
                                        "entry_id": "455878a4-242f-373e-a970-4e76d12f2425",
                                        "glosses": [
                                            "Accord d’une forte majorité de la population, de l’électorat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadcf70d-91ec-4d31-97c3-8f243d8e73b2",
                                                "sense_id": "f25a922a-789c-3bad-8cf9-b3217f8ef366",
                                                "text": "Cette théorie explicative fait consensus dans la communauté scientifique."
                                            },
                                            {
                                                "example_id": "c5917c63-be53-4eda-962f-1bb53568ec65",
                                                "sense_id": "f25a922a-789c-3bad-8cf9-b3217f8ef366",
                                                "text": "Les 14 premières composantes de la doctrine de la CIIVISE font l’objet d’un large consensus au sein des sociétés contemporaines. Il était tout de même utile de les mentionner pour rendre hommage aux personnes et aux associations qui ont lutté à la fin du XX^(ème) siècle pour parvenir à ce que la réalité fasse l’objet d’une acceptation consensuelle, même partielle et fragile."
                                            },
                                            {
                                                "example_id": "9d77dc96-6cc5-491a-a7fe-88cbc571d2cf",
                                                "sense_id": "f25a922a-789c-3bad-8cf9-b3217f8ef366",
                                                "text": "« De l’expérience du national-socialisme, les partis démocratiques en Allemagne ont tiré un consensus général : c’est le mur pare-feu [équivalent du cordon sanitaire] contre les partis d’extrême droite », a-t-il réagi sur X."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20795d0-2767-3e03-a616-339757bc982b",
                                        "entry_id": "455878a4-242f-373e-a970-4e76d12f2425",
                                        "glosses": [
                                            "Accord de plusieurs organes dans l’accomplissement d’une fonction vitale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f770d58-a638-4a58-831b-13e4d0fa6d7d",
                                                "sense_id": "e20795d0-2767-3e03-a616-339757bc982b",
                                                "text": "N’attendez pas, car l’antitoxine perdra toute efficacité dès le moment où le consensus symptomatique se sera déjà produit. De même que vous ne pouvez, par le traitement de Pasteur, arrêter la rage après son éclosion, de même vous ne pouvez sérothérapiquement guérir le tétanos déclaré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9e538e-e187-3614-b97b-47b2f01ebe1b",
                                        "entry_id": "455878a4-242f-373e-a970-4e76d12f2425",
                                        "glosses": [
                                            "Accord d’un certain nombre de processus sur une valeur unique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca944f89-db08-4542-89d9-63fe633fd5fa",
                        "source_entry_id": "62d52436-74c5-3535-a893-57b9af90439b",
