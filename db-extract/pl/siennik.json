                "senses": [
                    {
                        "sense_id": "d4d71d18-18ff-301d-a26f-5e1f53d96528",
                        "entry_id": "50ee16da-c078-34e8-8aab-7d6ecbd9786c",
                        "glosses": [
                            "duży płócienny worek wypełniony słomą (sieczką) lub sianem, służący za materac do spania"
                        ],
                        "tags": [],
                        "examples": [],
