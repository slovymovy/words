                                "target_senses": [
                                    {
                                        "sense_id": "a3455f4e-546e-36ca-8603-02e625d2b318",
                                        "entry_id": "8a917f05-5576-361d-9fae-3b8a569b25a9",
                                        "glosses": [
                                            "An infectious disease of amphibians caused by Batrachochytrium dendrobatidis (amphibian chytrid fungus) or (chiefly in salamanders and newts) by Batrachochytrium salamandrivorans."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a659ee-72c4-47fa-a7cc-e03d205fa9aa",
                                                "sense_id": "a3455f4e-546e-36ca-8603-02e625d2b318",
                                                "text": "In epidemic outbreaks and when it is present as an endemic, vulnerability to chytridiomycosis caused by B. dendrobatidis varies widely among species."
                                            },
                                            {
                                                "example_id": "6bdec1f8-8724-4364-96b5-36fe7f229076",
                                                "sense_id": "a3455f4e-546e-36ca-8603-02e625d2b318",
                                                "text": "2013, Evan A. Eskew, Brian D. Todd, Parallels in Amphibian and Bat Declines from Pathogenic Fungi, D. Peter Drotman (editor-in-chief), Emerging Infectious Diseases, Volume 19, Issues 1-3, Centers for Disease Control and Prevention, page 379,\nPathogenic fungi have substantial effects on global diversity, and 2 emerging pathogenic species—the chytridiomycete Batrachochrytium dendrobatidis, which causes chytridiomycosis in amphibians, and the ascomycete Geomyces destructans, which causes white-nose syndrome in hibernating bats—are implicated in the widespread decline of their vertebrate hosts."
                                            },
                                            {
                                                "example_id": "16aa5f7f-f4f6-4736-95b8-c84166dc5dc6",
                                                "sense_id": "a3455f4e-546e-36ca-8603-02e625d2b318",
                                                "text": "Chytridiomycosis is a fungal disease that was first discovered in Queensland, Australia in 1993, though it has probably been in Australia since the 1970s."
                                            }
                                        ]
                                    }
                                ]
                            }
