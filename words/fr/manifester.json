{
    "word_family": [
        "manifestation",
        "manifestant",
        "manifeste",
        "manifestement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54d72168-83da-3a0f-a6cc-b616f1de4213",
                    "sense_definition": "Prendre part à un rassemblement public pour exprimer une opinion ou une revendication.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de citoyens ont décidé de <w>manifester</w> pacifiquement dans les rues de la capitale."
                        },
                        {
                            "text": "Les étudiants se rassemblent pour <w>manifester</w> contre les réformes proposées par l'université."
                        }
                    ],
                    "synonyms": [
                        "descendre dans la rue"
                    ],
                    "common_phrases": [
                        "manifester dans la rue",
                        "droit de manifester"
                    ]
                },
                {
                    "sense_id": "22f5e54b-3a13-375b-8c39-eea0a49619d4",
                    "sense_definition": "Exprimer ou faire connaître clairement un sentiment, un avis ou une intention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public n'a pas hésité à <w>manifester</w> son enthousiasme dès l'entrée des musiciens sur scène."
                        },
                        {
                            "text": "Il a souhaité <w>manifester</w> sa reconnaissance envers toute l'équipe qui l'avait soutenu."
                        }
                    ],
                    "common_phrases": [
                        "manifester sa joie",
                        "manifester son mécontentement",
                        "manifester son intérêt"
                    ]
                },
                {
                    "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                    "sense_definition": "Devenir visible ou perceptible, apparaître.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les premiers symptômes de cette maladie peuvent se <w>manifester</w> plusieurs jours après la contamination."
                        },
                        {
                            "text": "Aucun candidat ne s'est encore <w>manifesté</w> pour reprendre ce poste vacant au sein du service."
                        }
                    ],
                    "common_phrases": [
                        "se manifester"
                    ]
                },
                {
                    "sense_id": "96907e29-9d53-3513-a92a-04e1f27194b3",
                    "sense_definition": "Inscrire des marchandises sur un document de douane maritime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "douane",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le transporteur maritime doit obligatoirement <w>manifester</w> l'ensemble des marchandises avant l'arrivée au port."
                        },
                        {
                            "text": "Ces conteneurs n'ont pas été correctement <w>manifestés</w> lors du contrôle douanier préliminaire."
                        }
                    ]
                }
            ]
        }
    ]
}