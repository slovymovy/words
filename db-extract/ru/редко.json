                    {
                        "sense_id": "b536a7b1-b856-34e4-831a-d488b75e4fec",
                        "entry_id": "58cdd166-831d-362f-af87-ccd9b9128a89",
                        "glosses": [
                            "с низкой частотой; в небольшом количестве за единицу времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b36de5-4c40-483f-a995-0f7019172def",
                                "sense_id": "b536a7b1-b856-34e4-831a-d488b75e4fec",
                                "text": "Поезда здесь ходят редко."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9eddda9-2bfd-30e2-9cdd-e287040ce2d4",
                        "entry_id": "58cdd166-831d-362f-af87-ccd9b9128a89",
                        "glosses": [
                            "на большом расстоянии друг от друга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727ad3f4-874d-45a1-a907-ced6da0762fd",
                                "sense_id": "c9eddda9-2bfd-30e2-9cdd-e287040ce2d4",
                                "text": "— Вы огурцы посадили очень редко, так не сажают!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af23a359-2165-4dd0-94fb-5b1662aa36fd",
                        "source_entry_id": "58cdd166-831d-362f-af87-ccd9b9128a89",
                        "source_sense_description": "с низкой частотой; в небольшом количестве за единицу времени",
                        "target_lang_word": "rarely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9964a6b-1667-351f-b0a0-d521d941bc8f",
                                        "entry_id": "fe8bc0c9-36e2-319d-b593-fa90674a3174",
                                        "glosses": [
                                            "Not occurring at a regular interval; seldom; not often."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c44c280-9e95-4875-9942-03d8841bbccb",
                                                "sense_id": "c9964a6b-1667-351f-b0a0-d521d941bc8f",
                                                "text": "We rarely go to the theatre."
                                            },
                                            {
                                                "example_id": "55b550e2-3ed7-443e-8571-f3ae45e2e86c",
                                                "sense_id": "c9964a6b-1667-351f-b0a0-d521d941bc8f",
                                                "text": "Rarely do you ever find an eagle this far up the river."
                                            },
                                            {
                                                "example_id": "e0738cdd-5565-4052-8ec8-06af1d5cd1d3",
                                                "sense_id": "c9964a6b-1667-351f-b0a0-d521d941bc8f",
                                                "text": "You have to give them credit, rarely does a character appeal equally to four-year-old children and middle-aged aunts posting tepid jokes and fake Oscar Wilde quotes on their timelines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7ee0c4-7e35-3c1c-8356-4b04baa2e23b",
                                        "entry_id": "fe8bc0c9-36e2-319d-b593-fa90674a3174",
                                        "glosses": [
                                            "Unusually well; excellently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0faa21c-9f8a-3588-b4ac-9061924ecd89",
                                        "entry_id": "fe8bc0c9-36e2-319d-b593-fa90674a3174",
                                        "glosses": [
                                            "To a rare degree; very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564c4039-0514-465c-aba7-7bcc4e55bace",
                                                "sense_id": "f0faa21c-9f8a-3588-b4ac-9061924ecd89",
                                                "text": "others speake very honourably of his life and death, and in all other circumstances declare him to have beene a most excellent and rarely virtuous man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "957654fc-bf0e-43e6-bdbf-a54615777387",
                        "source_entry_id": "58cdd166-831d-362f-af87-ccd9b9128a89",
                        "source_sense_description": "с низкой частотой; в небольшом количестве за единицу времени",
                        "target_lang_word": "seldom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                        "entry_id": "d6b226e6-4526-30b2-bf6c-ed356a973c0b",
                                        "glosses": [
                                            "Infrequently, rarely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd1efa2-cfe2-484b-b2d9-d3b3dec63d3e",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "They seldom come here now."
                                            },
                                            {
                                                "example_id": "87110131-9625-4240-8b66-b5f244a5da8f",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "990e6365-3a77-4721-8862-ec1aebc654fe",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I'll miss the sea. But a person needs new experiences. They draw something deep inside, allowing him to grow. Without change, something sleeps inside us and seldom awakens. The sleeper must awaken."
                                            },
                                            {
                                                "example_id": "58b00a85-1603-46ea-bd1f-69962149ed02",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "People who talk about an imminent possibility of war seldom pose this question: What would North Korea’s leadership get from unleashing a war that they are likely to lose in weeks, if not days?"
                                            },
                                            {
                                                "example_id": "1465c2f0-6081-4c72-b186-22d8d883c130",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                        "entry_id": "e078bb78-f32d-3041-975b-9238708b0207",
                                        "glosses": [
                                            "Rare; infrequent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa91202-c3da-46cf-a7d8-294dd7dfb361",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "a suppressed and seldom anger"
                                            },
                                            {
                                                "example_id": "a2973b3e-3552-4fd6-b0b3-43568b7dc3b7",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "He was very curious in his garden, which was never out of order; in which he would at seldom times take a short walk or two, not enduring to see a weed in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f437dc8-dc26-4f8c-ba18-1902834ed0c7",
                        "source_entry_id": "58cdd166-831d-362f-af87-ccd9b9128a89",
