                                                "sense_id": "1b2fc9e7-66f2-3ce1-9256-65f4f894e365",
                                                "text": "„Vor ihm stand der Wachtmeister und rapportierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "811366d0-dc9c-3575-9a86-ef11a551cd4c",
