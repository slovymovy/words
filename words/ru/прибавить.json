                },
                {
                    "sense_id": "7bc239be-f569-311a-b977-229945e19cb1",
                    "sense_definition": "Увеличить количество, длительность или иной параметр чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Судья решил <w>прибавить</w> срок заключения из-за новых улик."
                        },
                        {
                            "text": "Тренер попросил <w>прибавить</w> интенсивности на тренировке."
