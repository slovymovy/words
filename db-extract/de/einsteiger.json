                ],
                "senses": [
                    {
                        "sense_id": "ea86fe84-d8a5-39ba-85e5-66dd56dcc410",
                        "entry_id": "3bf0f8a5-d691-3c42-9b5d-4a25316cfbd0",
                        "glosses": [
                            "Person, die einsteigt, etwas Neues anfängt, beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fb919db-fdc6-45c1-8608-95d810e62d3b",
                                "sense_id": "ea86fe84-d8a5-39ba-85e5-66dd56dcc410",
                                "text": "„Grundsätzlich sollten sich Einsteiger von qualifiziertem Personal gut in die einzelnen Übungen einweisen lassen.“"
                            },
                            {
                                "example_id": "47d3aa35-b885-4186-8ff1-a317158c9826",
                                "sense_id": "ea86fe84-d8a5-39ba-85e5-66dd56dcc410",
                                "text": "„Ein Mädchen aus dem Ort hatte Vater und Sohn unterrichtet und große Gedult mit den beiden Einsteigern gehabt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                        "entry_id": "3bf0f8a5-d691-3c42-9b5d-4a25316cfbd0",
                        "glosses": [
                            "Ball, der den Beginn eines Breaks darstellt"
                        ],
                        "tags": [
                            "Snooker"
                        ],
                        "examples": [
                            {
                                "example_id": "4c224dda-48b8-46d1-8962-a6f002488419",
                                "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                                "text": "„Murphy spielte zwar eine Reihe spektakulärer Einsteiger, doch entweder wurde kein Break daraus oder er verschoss die entscheidenden Bälle.“"
                            },
                            {
                                "example_id": "d2f36304-853c-4e91-9756-52682aca803f",
                                "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                                "text": "„Die lange Rote als Einsteiger lag eigentlich an der langen Bande, was aber Wasley nicht davon abhielt diese zu lochen und mit einem 103er Century Break den Decider zu erzwingen.“"
                            },
                            {
                                "example_id": "5a94120f-bf80-4940-a0b3-550500d02801",
                                "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                                "text": "„Er, der das schnelle, aggressive Snooker liebt, zeigte jetzt auch beim geduldigen Sicherheitsspiel, bei den sogenannten langen Einsteigern sowie bei der Ablage des weißen Spielballs nach jedem Stoß auf die roten und andersfarbigen Kugeln phasenweise vollendetes Können.“"
                            },
                            {
                                "example_id": "2eca258b-01df-49f8-ac51-8276e4a66dde",
                                "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                                "text": "„Lange Bälle, Kombinationen und schwierige Winkel werden nun öfter und mutiger angegangen, besonders bei den sogenannten „Einsteigern“, dem jeweils ersten Ball nach einer Aufnahme, der die Basis für die großen Breaks der Profis bildet.“"
                            },
                            {
                                "example_id": "dace5e65-143e-48c5-b3bc-3eb9831207f8",
                                "sense_id": "b6d3d6b4-aa9f-300b-85cf-e9c89dc2ec05",
                                "text": "„Oftmals bietet sich nach einem missglückten Safety-Stoß die Möglichkeit über einen langen Einsteiger ins Spiel zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
