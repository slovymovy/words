                                                "sense_id": "3afc0329-d78c-3ef6-920e-7648308b0b00",
                                                "text": "„Ein Achteck […] ist ein Polygon mit acht Ecken und acht Seiten.“"
                                            },
                                            {
                                                "example_id": "1fcc379b-37a2-4adb-8d07-74047cc133f3",
                                                "sense_id": "3afc0329-d78c-3ef6-920e-7648308b0b00",
                                                "text": "„Neben Dreiecken lassen sich auch andere Polygone als Grundrisse von Pyramiden verwenden.“"
                                            }
                                        ],
