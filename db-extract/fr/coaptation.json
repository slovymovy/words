                "senses": [
                    {
                        "sense_id": "f27f5780-0f6e-34ef-86c7-107b19aac59d",
                        "entry_id": "64e82bb0-179e-378e-a37d-c20b2c2ec07c",
                        "glosses": [
                            "Action pour deux surfaces de se faire face, de s’ajuster, de coïncider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c62ddde-6a17-484a-9f16-076fccaa207d",
                                "sense_id": "f27f5780-0f6e-34ef-86c7-107b19aac59d",
                                "text": "La coaptation de deux tissus avant cicatrisation."
                            },
                            {
                                "example_id": "759d3f4c-a0b4-4ff8-85dd-3e2604d9b865",
                                "sense_id": "f27f5780-0f6e-34ef-86c7-107b19aac59d",
                                "text": "L’opération faite, le patient ne recouvra pas la vue instantanément, et cinq ou six jours s’écoulèrent avant que ne commençât la coaptation de la plaie de son œil recouvert d’un bandeau compressif."
                            },
                            {
                                "example_id": "5e9b42c6-b3ba-4582-96ea-df72af9453d5",
                                "sense_id": "f27f5780-0f6e-34ef-86c7-107b19aac59d",
                                "text": "Les uns, confiant dans la valeur ostéogénétique des fragments, se contentent d’en assurer la coaptation par des enchevillements inertes (vissage, chevilles d’ivoire)."
                            }
                        ]
                    }
                ],
