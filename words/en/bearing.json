                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer calculated the necessary <w>bearing</w> for the heavy steel beam.",
                            "target_lang_translations": {
                                "ru": "Инженер рассчитал необходимую <w>площадь опирания</w> для тяжелой стальной балки.",
                                "es": "El ingeniero calculó el <w>apoyo</w> necesario para la viga de acero pesada.",
                                "cs": "Inženýr vypočítal potřebné <w>uložení</w> pro těžký ocelový nosník."
