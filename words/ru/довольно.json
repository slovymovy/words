        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7494a388-fb84-3f36-84f4-00a44138213a",
                    "sense_definition": "Возглас, выражающий требование прекратить какое-либо действие; хватит.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Довольно</w> спорить, давайте лучше займёмся делом!",
                            "target_lang_translations": {
                                "en": "<w>Enough</w> arguing, let's get to work instead!",
                                "zh": "<w>够了</w>，别再争论了，我们还是干正事吧！",
                                "nl": "<w>Genoeg</w> gediscussieerd, laten we liever aan het werk gaan!",
                                "pl": "<w>Dość</w> kłótni, zajmijmy się lepiej pracą!",
                                "de": "<w>Genug</w> gestritten, lasst uns lieber an die Arbeit gehen!",
                                "fr": "<w>Assez</w> discuté, occupons-nous plutôt de choses sérieuses !",
                                "it": "<w>Basta</w> discutere, occupiamoci piuttosto del lavoro!",
                                "cs": "<w>Dost</w> bylo hádek, raději se dejme do práce!",
                                "tr": "<w>Yeter</w> tartıştığınız, hadi işimize bakalım!",
                                "es": "<w>Basta</w> de discutir, ¡mejor pongámonos a trabajar!"
                            }
                        },
                        {
                            "text": "С меня <w>довольно</w>, я ухожу домой.",
                            "target_lang_translations": {
