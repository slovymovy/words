                                        "examples": [
                                            {
                                                "example_id": "95cbbc94-96a9-4e0c-b04b-aa01eb740a4c",
                                                "sense_id": "870ea730-a71a-34c3-b081-ed94292a677f",
                                                "text": "Des architectes et des peintres élèvent et décorent des églises à Kief, à Novgorod ; d’ici quelques années, Kief deviendra l’émule en beauté de Constantinople."
                                            },
                                            {
                                                "example_id": "be601f9d-0181-4259-9495-ad51a49f4651",
                                                "sense_id": "870ea730-a71a-34c3-b081-ed94292a677f",
                                                "text": "À Novgorod, j’entre à la faculté\nAu mois d’octobre, p’tite mère est effrayée.\nMais vous serez fiers de moi\nQuand j’aurai fini mon droit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
