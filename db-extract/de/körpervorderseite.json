                ],
                "senses": [
                    {
                        "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                        "entry_id": "c8fcd681-9714-35ed-81d4-a2c88f786f05",
                        "glosses": [
                            "vordere Seite des menschlichen oder tierlichen Körpers (die unter anderem die Brust, den Bauch und die Hüfte umfasst)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7777ae73-cf93-4acf-82e0-1aff5fbab5ee",
                                "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                                "text": "„Die Muskeln und Faszien an der Körpervorderseite, sprich im Brust-, Bauch- sowie Hüftbereich, sind dadurch meist verkürzt und werden kaum noch gedehnt.“"
                            },
                            {
                                "example_id": "1ca679ba-4bd4-4ab4-9d65-edb5aa3e3346",
                                "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                                "text": "„Die Asana sorgt für Flexibilität und Kraft deiner Körpervorderseite, sie stärkt die Arme und den Halsbereich.“"
                            },
                            {
                                "example_id": "997ff50a-c3a1-42e9-83ab-16523f469032",
                                "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                                "text": "„Entscheidest Du Dich für die dauerhafte Haarentfernung bei Hairfree PLUS, dann steht einer unbehaarten Körpervorderseite nichts mehr im Weg!“"
                            },
                            {
                                "example_id": "46dc981d-78b4-4282-a8dd-bf65127decee",
                                "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                                "text": "„Konzentriere dich nicht auf das nach hinten beugen [sic], sondern denke daran, die Körpervorderseite zu strecken.“"
                            },
                            {
                                "example_id": "622215dd-0a0c-4af5-b7de-99cefbe18f3c",
                                "sense_id": "b00c3266-9ea2-3097-b192-c1490ecba857",
                                "text": "„Er sei auf ihrem Bett herumgehüpft, heruntergefallen, mit der Körpervorderseite liegengeblieben und habe nicht mehr geatmet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
