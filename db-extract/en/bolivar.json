                "senses": [
                    {
                        "sense_id": "39aea947-f099-3713-b55a-35c0993feea3",
                        "entry_id": "72516a2d-aac6-36ed-be7b-8abe238d3eef",
                        "glosses": [
                            "Alternative form of bolívar."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "8330136e-733c-4ae8-87d4-19becff48ee6",
                                "sense_id": "39aea947-f099-3713-b55a-35c0993feea3",
                                "text": "The mining law of 1925 places taxes at two Bolivars ($0.39) per hectare on property not in operation. […] The 125,000,000 Bolivars surplus in the treasury, while not a great deal of money in London or New York ($25,000,000) denotes a condition of things in Venezuela that the British and French like."
                            },
                            {
                                "example_id": "39c844a8-0031-4cf6-8741-8e1a3cc152ae",
                                "sense_id": "39aea947-f099-3713-b55a-35c0993feea3",
                                "text": "“These people want to buy some arepas. How much are they?” “They are two Bolivars apiece, and I haven’t gone yet.[…]”"
                            },
                            {
                                "example_id": "3c170467-c183-4bba-a8ee-54fa47ecdd41",
                                "sense_id": "39aea947-f099-3713-b55a-35c0993feea3",
                                "text": "The Venezuelan unit of currency is the Bolivar (VEB). […] The Bolivar is nominally subdivided into 100 céntimos, although coins denominated in céntimos no longer circulate."
                            }
                        ]
                    }
                ],
