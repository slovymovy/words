                "senses": [
                    {
                        "sense_id": "1ef0b03f-64b9-380b-ba87-1a379cbe9462",
                        "entry_id": "451eaa13-c29a-38d9-ad5e-0997f441db8c",
                        "glosses": [
                            "zo wit als krijt, heel erg wit, meestal van het gelaat van een persoon die erg geschrokken of bang is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50382744-d018-4778-aebd-48885f5de0c8",
                                "sense_id": "1ef0b03f-64b9-380b-ba87-1a379cbe9462",
                                "text": "De bewuste foto’s brachten gisteren heel wat teweeg. Enkele mensen uit het publiek werd het allemaal teveel. Met een krijtwit gelaat verlieten ze de publiekstribune. ‘Dit is te confronterend’, zucht een meisje terwijl ze probeert te bekomen."
                            },
                            {
                                "example_id": "306d01ff-f9ba-4d34-99a8-d0e74d558cc3",
                                "sense_id": "1ef0b03f-64b9-380b-ba87-1a379cbe9462",
                                "text": "Zijn gelaat steekt krijtwit af tegen de zwarte kleding van de IS-beul, die van achteren een mes naar zijn keel brengt."
                            }
                        ]
                    }
