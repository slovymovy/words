                ],
                "senses": [
                    {
                        "sense_id": "af0fc3a6-0b9c-3435-9c01-25a6fcb33d49",
                        "entry_id": "3ab2dfe1-7a04-355b-a676-57f139eb6060",
                        "glosses": [
                            "To sail."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b680cd-0856-47ae-b916-ab881cb359ff",
                                "sense_id": "af0fc3a6-0b9c-3435-9c01-25a6fcb33d49",
                                "text": "I tried to read George Moore last night, and was dreadfully bored. He may be a realist, but I solemnly aver he does not know reality on that tight, little, sheltered-life archipelago of his. If he could wind-jam around the Horn just one voyage he would be twice the writer."
                            },
                            {
                                "example_id": "9b7d496e-ed0a-461f-8756-10ded4273f1d",
                                "sense_id": "af0fc3a6-0b9c-3435-9c01-25a6fcb33d49",
                                "text": "By that time Virginia Beach was abeam and Cape Henry Lighthouse appeared dimly over the port bow. The breeze was no fresher, so we shook out the reefs in the mainsail, and windjammed up the coast, N½W with started sheets. Good old crock!"
                            },
                            {
                                "example_id": "2813ec64-63ee-42ca-890e-326783d7a117",
                                "sense_id": "af0fc3a6-0b9c-3435-9c01-25a6fcb33d49",
                                "text": "I have to close my eyes. Either that or puke my guts into my lap. ¶ 'You can look now,' sneers Sky, a long time later. ¶ It's okay for her, she's used to windjamming."
                            }
                        ]
                    },
                    {
                        "sense_id": "9357bf50-414e-3aed-a223-19371bed94e1",
                        "entry_id": "3ab2dfe1-7a04-355b-a676-57f139eb6060",
                        "glosses": [
                            "To speak in a long-winded manner; to chatter, bloviate."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fa92dc72-7e27-4d52-b8c0-eacead5c79ba",
                                "sense_id": "9357bf50-414e-3aed-a223-19371bed94e1",
                                "text": "He set a hand on the small of her back, steered her to the rear of the salon. \"This'll take five minutes.\" You got time to windjam with Alice, you got time for me."
                            }
                        ]
                    }
