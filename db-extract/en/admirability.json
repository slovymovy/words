                    },
                    {
                        "translation_id": "8117107f-c6a2-4d20-b815-2781314530d9",
                        "source_entry_id": "14cbc137-e1c6-3e81-ad3e-bc37d27835e2",
                        "source_sense_id": "8fe3141d-3f81-3b45-9de4-8bdb8135b317",
                        "source_sense_description": "die Bewunderungswürdigkeit, die Großartigkeit",
                        "target_lang_word": "Großartigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großartigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d4c477b-19dc-35f9-a506-0fdd09aa5c57",
                                        "entry_id": "ea892360-6444-3e7e-8140-c41504120029",
                                        "glosses": [
                                            "Eigenschaft, von großer Bedeutung und/oder beeindruckend zu sein; Art, sehr gut zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6266c4dd-e8c6-4cd0-92de-669d837c840d",
                                                "sense_id": "7d4c477b-19dc-35f9-a506-0fdd09aa5c57",
                                                "text": "„Es gibt Haydns ‚Schöpfung‘, es gibt Richard Strauss, Gustav Holst, lauter Versuche, mit der Großartigkeit eines Symphonieorchesters die Unendlichkeit des Raums, die Wunder der Kosmologie zum Klingen zu bringen.“"
                                            },
                                            {
                                                "example_id": "2a918eb9-b316-461c-b5c4-5839099dfb6a",
                                                "sense_id": "7d4c477b-19dc-35f9-a506-0fdd09aa5c57",
                                                "text": "„Dann kommt der Giro d’Italia, der Jahr für Jahr mit immer aberwitzigeren Streckenprofilen versucht, im Vergleich mit dem französischen Marktführer eigene Größe und Großartigkeit zu demonstrieren.“"
                                            },
                                            {
                                                "example_id": "87e73949-9527-4dc0-bc17-73620b07d6e8",
                                                "sense_id": "7d4c477b-19dc-35f9-a506-0fdd09aa5c57",
                                                "text": "„Das Kind wächst heran, und berufliche Leistung, sexuelle Bestätigung oder besondere Abenteuer vermögen nagende Selbstzweifel außer Kraft zu setzen und das Selbstbild eigener Großartigkeit aufrechtzuhalten.“"
                                            },
                                            {
                                                "example_id": "ce45c04c-d980-45c1-89c5-90b4dc5a698f",
                                                "sense_id": "7d4c477b-19dc-35f9-a506-0fdd09aa5c57",
                                                "text": "„Immer wieder betont Söder in seiner Rede die Großartigkeit des Freistaates, wie viel toller der Münchner Flughafen im Vergleich zum unfertigen Berliner Flughafen sei, wie viel friedlicher der G7-Gipfel auf Schloss Elmau war, im Vergleich zum G20-Treffen in Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
