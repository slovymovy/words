                                "target_senses": [
                                    {
                                        "sense_id": "16523be1-1795-3329-9c2b-61f9d8d6b4f9",
                                        "entry_id": "c837108a-f464-3ccc-90f7-ccb05dfa88bd",
                                        "glosses": [
                                            "Faire participer au système de location de logement géré par Airbnb."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397a440b-95da-4e0e-9ecf-35bf54bdd434",
                                                "sense_id": "16523be1-1795-3329-9c2b-61f9d8d6b4f9",
                                                "text": "On commence à dire qu'on « airbnbise » son appart et qu'on « snapchate » ses cannellonis ricotta-épinards."
                                            },
                                            {
                                                "example_id": "02c36ae7-3610-4f52-97cb-4ec309a433b9",
                                                "sense_id": "16523be1-1795-3329-9c2b-61f9d8d6b4f9",
                                                "text": "Aujourd'hui, il est de bon ton de s'« airbnbiser » au lieu de s'extasier sur le roof top avec piscine d'un énième boutique-hôtel impersonnel."
                                            },
                                            {
                                                "example_id": "204993a6-5e50-4f94-a608-b51649264ba4",
                                                "sense_id": "16523be1-1795-3329-9c2b-61f9d8d6b4f9",
                                                "text": "J'ai voyagé plusieurs fois avec lui en utilisant AirBnb, et cela s'est toujours bien passé. A Airbnbiser sans modération !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
