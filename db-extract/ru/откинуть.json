                    {
                        "sense_id": "fb537b2b-60d9-3460-8054-7c04ba51d7b0",
                        "entry_id": "c00b1424-91a1-37e4-9f68-51a574cda298",
                        "glosses": [
                            "поднять, опустить или отвести в сторону что-либо, закрепленное на шарнирах или на петлях"
                        ],
                        "tags": [],
