                "senses": [
                    {
                        "sense_id": "f381beda-d532-3f82-ab74-016f6f5213fb",
                        "entry_id": "5606dc42-87f2-3627-a685-03e9908bf3b7",
                        "glosses": [
                            "gekrümmt verlaufender Bereich eines Ufers, auf den die Fließrichtung eines Gewässers gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb235825-7ede-4d00-92a3-755d26a7a7ad",
                                "sense_id": "f381beda-d532-3f82-ab74-016f6f5213fb",
                                "text": "„An diesen Stellen liegen sich ein steileres Prallufer und ein seicht auslaufendes Gleitufer gegenüber.“"
                            },
                            {
                                "example_id": "8d14f055-3e58-40d8-8072-3991310b4bda",
                                "sense_id": "f381beda-d532-3f82-ab74-016f6f5213fb",
                                "text": "„Der rechtsrheinische Rand des Rheinknies stellt ein sogenanntes Prallufer dar, weil hier die Flussströmung an das Ufer „prallt“.“"
                            },
                            {
                                "example_id": "e40e6cca-b101-4245-a1c4-f0fe5b49fdfc",
                                "sense_id": "f381beda-d532-3f82-ab74-016f6f5213fb",
                                "text": "„Am Prallufer der Seine hat sich zwischen der Straße und den Felsen ein Ort eingefügt, der vollkommen zerstört ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
