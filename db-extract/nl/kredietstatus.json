                        "sense_id": "6d572370-1366-3abc-a5a4-ad8678a18219",
                        "entry_id": "aedd9db8-c572-36e1-b6c5-8909c1b32799",
                        "glosses": [
                            "het vertrouwen dat een bedrijf of land heeft bij kredietbeoordelaars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551c53e3-140d-4da8-be26-9286395822a1",
                                "sense_id": "6d572370-1366-3abc-a5a4-ad8678a18219",
                                "text": "Kredietbeoordelaar Standard en Poor's heeft vijftien eurolanden gewaarschuwd dat hun kredietstatus mogelijk wordt afgewaardeerd. Ook de landen met de hoogste kredietwaardigheid, de Triple A-status, worden genoemd. Daar hoort ook Nederland bij."
                            },
                            {
                                "example_id": "c89d5bec-2b2f-4bea-9d1c-f3a8ece48419",
                                "sense_id": "6d572370-1366-3abc-a5a4-ad8678a18219",
                                "text": "De vertrekkend hoofdeconoom van de ECB, Jürgen Stark, waarschuwde vandaag op een bijeenkomst in Dublin dat de schuldencrisis zich aan het verspreiden is naar de kernlanden van de euro. Duitsland, Nederland, Frankrijk, Finland, Oostenrijk en Luxemburg worden beschouwd als die kernlanden, omdat ze allemaal een Triple A-status hebben, de hoogste kredietstatus."
                            }
                        ]
                    }
