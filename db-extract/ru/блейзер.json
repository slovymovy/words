                                    {
                                        "sense_id": "d9ad8857-2953-3454-8356-a046c1d0110e",
                                        "entry_id": "06171539-ca97-3aab-9551-5f61c3f1db85",
                                        "glosses": [
                                            "Anything that blazes or glows, as with heat or flame."
