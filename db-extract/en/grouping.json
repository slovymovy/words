                                        "entry_id": "7de0e404-652b-3c42-99de-21d56db71964",
                                        "glosses": [
                                            "locker gefasste Gemeinschaft (Gruppe) ohne feste Abgrenzung, die ein gemeinsames Ziel verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c34daa-4eec-417d-835f-cc85ce1bc563",
                                                "sense_id": "10c94e30-52cc-3689-9a79-d67da94a7cbd",
                                                "text": "Das ist nach wie vor eine sehr interessante Gruppierung, die sich da damals unter den Kriegsdienstverweigerern gebildet hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecc2632e-229a-3674-ab48-db7273378449",
                                        "entry_id": "7de0e404-652b-3c42-99de-21d56db71964",
                                        "glosses": [
                                            "das Sortieren in Einheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f565a6-fae2-4b5c-80cb-f7aaa3323389",
                                                "sense_id": "ecc2632e-229a-3674-ab48-db7273378449",
                                                "text": "Diese Gruppierung nach Herkunft lehne ich ab, weil sie zu wenige Kriterien berücksichtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
