                    },
                    {
                        "form_id": "e82191a7-66c9-43b8-9440-092864f3afcb",
                        "entry_id": "e63a1f78-4e93-3014-a8b2-47755405fe21",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "vitulines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                        "entry_id": "e63a1f78-4e93-3014-a8b2-47755405fe21",
                        "glosses": [
                            "Relatif au veau, qui est semblable au veau, physiquement ou intellectuellement, ou à sa tête. Utilisé principalement pour désigner une personne sans énergie ou un visage peu expressif."
                        ],
                        "tags": [
                            "formal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7b38ccb1-c17a-4e17-b754-c1e2fe61b35f",
                                "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                                "text": "La superficie de son tour extérieur est lisse jusques vers le bas, où on apperçoit quelques stries élevées et légèrement granuleuses qui différent par leur petitesse, et leur nombre, des cordelettes circulaires du cone vitulin."
                            },
                            {
                                "example_id": "b9badc53-5e8a-492e-be6a-9231f14a6fbc",
                                "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                                "text": "Les phoques vitulines ou veaux-marins, qu’on prétend exister dans la mer Caspienne, dans les lacs d’Aral, de Baikal et de Ladoga, paraissent être une espèce rapprochée des loutres et différente des phoques marins."
                            },
                            {
                                "example_id": "f4a2ee10-6493-4a38-8313-e55e38c3b21b",
                                "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                                "text": "Canalis est un petit homme sec, de tournure aristocratique, brun, doué d’une figure vituline, et d’une tête un peu menue, comme celle des hommes qui ont plus de vanité que d’orgueil."
                            },
                            {
                                "example_id": "c2275d84-98b6-4304-a7f9-98a9798a870e",
                                "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                                "text": "De grand’ substance est la chair vituline,\nJ’appelle ainsi les plus jeunes taureaux ;\nAu proche rang marcheront les chevreaux,\nSans oublier la tendresse agneline."
                            },
                            {
                                "example_id": "e0cf877e-e8e1-4243-8c8b-5b1694e94cc8",
                                "sense_id": "013a235c-1745-3975-80d6-484a9f70f70a",
                                "text": "Il a les yeux tombants, une bouche écrasée, les paupières presque jointes, les cheveux mal coiffés, l’air vitulin dès le matin."
                            }
                        ]
                    }
                ],
