                "senses": [
                    {
                        "sense_id": "1ba070a4-6276-341e-90b4-9abf65acfc54",
                        "entry_id": "da3b66f4-0f99-3258-9e93-e4d9afd6d3c9",
                        "glosses": [
                            "w Indiach: człowiek należący do jednej z najniższych kast lub będący poza systemem kastowym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8e688e5d-f373-33ef-87db-981ccb51dc07",
                        "entry_id": "da3b66f4-0f99-3258-9e93-e4d9afd6d3c9",
                        "glosses": [
                            "człowiek uważany w jakiejś grupie za gorszego, pogardzany"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "908dc262-3418-4b72-ab3a-14b163ab9d5a",
                        "source_entry_id": "da3b66f4-0f99-3258-9e93-e4d9afd6d3c9",
                        "source_sense_id": "1ba070a4-6276-341e-90b4-9abf65acfc54",
                        "target_lang_word": "pariah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pariah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "Synonym of outcast: A person despised and excluded by their family, community, or society, especially a member of the untouchable castes in Indian society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ba56ca-37db-451f-b601-61fa69fc9eb8",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "What is this smoking that it should be considered a crime? I believe in my heart that women are jealous of it, as of a rival. They speak of it as of some secret, awful vice that seizes upon a man, and makes him a Pariah from genteel society."
                                            },
                                            {
                                                "example_id": "86e0ca5a-5b5b-4429-bcf0-8016b2dc4f00",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "I’m a pariah, outlawed from Time Lord society."
                                            },
                                            {
                                                "example_id": "ad771975-d037-4101-b08a-19c9e664f8c4",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "[…] I went from being a much-feted author to a pariah, since one of the many problems of being trashed on the front page of the New York Times is that everyone is in the know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "A similarly despised group of people or species of animal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ee605c-d8f3-45dd-b598-368cdf83c75e",
                                                "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                                "text": "As ecological conditions became unfavorable for pig raising, there was no alternative function which could redeem its existence. The creature became not only useless, but worse than useless—harmful, a curse to touch or merely to see—a pariah animal."
                                            },
                                            {
                                                "example_id": "7ab014ec-9269-478a-a72c-42ebafd772b9",
                                                "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                                "text": "This scenario could lead to war crimes the scale of which has not been seen in Europe since the Nazis — crimes that would make Vladimir Putin, his cronies and Russia as a country all global pariahs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4660e2e6-4dcf-3e86-a95b-952144c6cba7",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "Ellipsis of pariah dog (“an Indian breed, any stray dog in Indian contexts”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2570b683-556b-4877-9d2d-bf8c22c11de1",
                        "source_entry_id": "da3b66f4-0f99-3258-9e93-e4d9afd6d3c9",
                        "source_sense_id": "1ba070a4-6276-341e-90b4-9abf65acfc54",
                        "target_lang_word": "paria",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paria",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "33f5e728-759d-30f1-9e3e-dc555775da46",
                                        "entry_id": "03fae755-246e-387e-b1ff-deb6f75daeed",
                                        "glosses": [
                                            "nome con cui nell'uso europeo sono indicati gli individui appartenenti alle classi sociali più basse dell'India, detti anche intoccabili"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e121780a-54c3-4a5e-a820-de3ba7a7e9af",
                                                "sense_id": "33f5e728-759d-30f1-9e3e-dc555775da46",
                                                "text": "la casta dei paria"
                                            },
                                            {
                                                "example_id": "453c9a5b-0e23-426f-89bc-7c19a63e4d1c",
                                                "sense_id": "33f5e728-759d-30f1-9e3e-dc555775da46",
                                                "text": "Gandhi chiamava i paria \"figli di Dio\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d944b27-5800-3eec-a53c-05ae139182e5",
                                        "entry_id": "03fae755-246e-387e-b1ff-deb6f75daeed",
                                        "glosses": [
                                            "persona che è o ritiene di essere estromessa dalla società o comunque socialmente indesiderata a causa della sua origine umile, della sua condizione di povertà eccetera"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ff1a06-b4af-4047-9353-76448657c5b1",
                                                "sense_id": "6d944b27-5800-3eec-a53c-05ae139182e5",
                                                "text": "i paria della società"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paria",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d08ba0b2-1cbf-3724-96dc-d7082047e284",
                                        "entry_id": "7c820882-50f5-3a9e-8248-9331e8316cf4",
                                        "glosses": [
                                            "corpo di onori, benefici e diritti riconosciuto da alcune monarchie europee a una parte della nobiltà del proprio paese; coloro che ne fanno parte e che godono di tali diritti sono detti pari (di)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baea9418-ca14-4bb1-b3eb-305334d13b67",
                                                "sense_id": "d08ba0b2-1cbf-3724-96dc-d7082047e284",
                                                "text": "la paria di Francia, d'Inghilterra"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
