                "senses": [
                    {
                        "sense_id": "fedd2dea-fdb8-342b-8b0f-6092ac7a9db6",
                        "entry_id": "85edd534-ce1f-3d8a-940c-fdc7e8cf29d5",
                        "glosses": [
                            "Benennung einer Ware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1ad846-a21c-419b-8719-354387079efe",
                                "sense_id": "fedd2dea-fdb8-342b-8b0f-6092ac7a9db6",
                                "text": "„Insgesamt gilt, daß aus einem Eigennamen ein Warenname geworden ist.“"
                            },
                            {
                                "example_id": "aec65155-5702-46b9-9459-a0dc2412e7a1",
                                "sense_id": "fedd2dea-fdb8-342b-8b0f-6092ac7a9db6",
                                "text": "„Das Weltmeer der Warennamen wogt nur scheinbar wild – auch wenn selbsternannte Sprachpfleger angesichts der Flutwellen »Dauerschäden für die Gemeinsprache« (…) befürchten, sind Produktnamen doch unbestritten Elemente der Kommunikation, die keinem dämonischen furor oeconomicus entspringen, sondern im allgemeinen ganz bewußt von Menschen für Menschen geschaffen wurden.“"
                            }
                        ],
