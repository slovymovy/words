                        ],
                        "form": "entuzjaści"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fff3f145-0d5c-3cff-b84f-3b57e05594e4",
                        "entry_id": "e0ee59be-b782-3734-98e9-1023ef654f7f",
                        "glosses": [
                            "osoba pełna entuzjazmu, chęci i wiary w możliwość zrealizowania jakiejś idei; osoba żywo poruszona, pobudzona jakąś ideą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cebdba-c61e-4bd9-ba5b-64bfe85fb07c",
                                "sense_id": "fff3f145-0d5c-3cff-b84f-3b57e05594e4",
                                "text": "Było wielu entuzjastów wierzących w sukces ośrodka, ale byli też i sceptycy niewierzący w powodzenie tego przedsięwzięcia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd494784-e092-4114-9664-5b5691671324",
                        "source_entry_id": "e0ee59be-b782-3734-98e9-1023ef654f7f",
                        "source_sense_id": "fff3f145-0d5c-3cff-b84f-3b57e05594e4",
                        "target_lang_word": "enthusiast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthusiast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                        "entry_id": "029a23de-4001-3410-8972-4ffc62560d20",
                                        "glosses": [
                                            "A person filled with or guided by enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd22552d-c3ff-44ce-81b9-6269fca8b4e8",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "But Charles Aubyn (for it was he) had, like most enthusiasts, overcalculated the influence of his eloquence; surprise had alone procured him a hearing, and the bold cavaliers around were little in the mood for a homily."
                                            },
                                            {
                                                "example_id": "cd28ba49-7500-4c4f-aa5f-0026929abce2",
                                                "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                                                "text": "I would challenge any rock enthusiast to refrain from tapping his/her foot when listening to such music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc859136-4878-3bd1-9966-1558cadd2f23",
                                        "entry_id": "029a23de-4001-3410-8972-4ffc62560d20",
                                        "glosses": [
                                            "A person exhibiting over-zealous religious fervour."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77bb8f12-7b5a-44f6-bbb1-36909cdce902",
                        "source_entry_id": "e0ee59be-b782-3734-98e9-1023ef654f7f",
                        "source_sense_id": "fff3f145-0d5c-3cff-b84f-3b57e05594e4",
                        "target_lang_word": "enthousiaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthousiaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                        "entry_id": "c2b44bf4-23da-3bbb-92ab-afbf8be80864",
                                        "glosses": [
                                            "Qui exprime ou qui dégage l’enthousiasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7bb6ee-7f6b-4d19-930d-e06cadb2c714",
                                                "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            },
                                            {
                                                "example_id": "910c739b-d1f6-4d88-bbb1-28045d1e88ca",
                                                "sense_id": "89f963e7-bf25-3647-8792-ca0204ec61ea",
                                                "text": "Et, de plus, il travaille pour la patrie, avec le consentement enthousiaste de tout ce que la France contient de repopulateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enthousiaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34ba3c54-5e2b-35c1-ab5b-14f3add365c3",
                                        "entry_id": "cf5cac5e-76e5-3643-8009-8f1f3a97aea2",
                                        "glosses": [
                                            "Celui, celle qui a une admiration excessive, une sorte d’engouement pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f213f65e-d041-484c-9514-366bada9656f",
                                                "sense_id": "34ba3c54-5e2b-35c1-ab5b-14f3add365c3",
                                                "text": "Si donc, dans le principe, ces célèbres enthousiastes qui ont tant prôné les courses, avaient plus connu le fond de l’institution que la superficie, ils n’auraient pas concouru au développement d’un prétendu moyen d’amélioration si peu en rapport avec nos usages et nos besoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfaf922-384f-3f3a-92c7-05c8e4f7e32a",
                                        "entry_id": "cf5cac5e-76e5-3643-8009-8f1f3a97aea2",
                                        "glosses": [
                                            "Quiconque est sujet à s’engouer, à s’enthousiasmer."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f546ee-c92f-4238-908c-7afbff387c2c",
                                                "sense_id": "3cfaf922-384f-3f3a-92c7-05c8e4f7e32a",
                                                "text": "Mr Balfour écrivait jadis: « Il est regrettable que seuls les enthousiastes puissent émouvoir les peuples, car les enthousiastes sont presque toujours des imbéciles. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f4ce879-061f-4f32-80bf-d56b4ac5843d",
                        "source_entry_id": "e0ee59be-b782-3734-98e9-1023ef654f7f",
                        "source_sense_id": "fff3f145-0d5c-3cff-b84f-3b57e05594e4",
                        "target_lang_word": "entusiasta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entusiasta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "44d8c285-0fee-3a48-b445-bc9fcc9dff81",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Que siente entusiasmo por alguien o algo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f055cd-f68b-4db1-8d55-2dd218f11e57",
                                                "sense_id": "44d8c285-0fee-3a48-b445-bc9fcc9dff81",
                                                "text": "«Un seguidor entusiasta de Kepler fue Jeremiah Horrocks (1618-1641), fallecido a los 22 años»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac711d0e-4b7d-3d4c-b01d-1c45226a942b",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Propenso a entusiasmarse."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d42a5bb-2597-4825-b448-87d02e8afeff",
                                                "sense_id": "ac711d0e-4b7d-3d4c-b01d-1c45226a942b",
                                                "text": "«Muchos son los medios de que se puede valer el maestro o profesor entusiasta y deseoso de progresar, para mejorar su desempeño profesional; (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c040f6c2-5d11-35f4-b259-0023e39dbc8a",
                                        "entry_id": "43678005-1e95-3068-b74b-f91f110ba322",
                                        "glosses": [
                                            "Entusiástico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "229ce3d7-7ed5-4ba2-b1c4-2102eecc5673",
                                                "sense_id": "c040f6c2-5d11-35f4-b259-0023e39dbc8a",
                                                "text": "«El público de Milán, tan crítico cuando se trata de aquellos roles que se consideraban dominio de tenores italianos desde siempre, me ovacionó de forma entusiasta»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
