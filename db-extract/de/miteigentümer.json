                        "cross_references": [
                            {
                                "target_word": "совладелец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1997658a-b5b4-31eb-9224-9f41e22fd0ff",
                                        "entry_id": "ce22cf9d-8aea-34e3-85ba-dbbf28541551",
                                        "glosses": [
                                            "тот, кто совместно с кем-либо владеет чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b6d490-8d65-4289-8ef9-03c75d555e5d",
                                                "sense_id": "1997658a-b5b4-31eb-9224-9f41e22fd0ff",
                                                "text": "Торговая площадь не была разделена, и доходы с неё делились пропорционально между совладельцами."
                                            },
                                            {
                                                "example_id": "63295a7f-625c-4968-8104-f9c909ca1873",
                                                "sense_id": "1997658a-b5b4-31eb-9224-9f41e22fd0ff",
                                                "text": "Из положения заключённого и каторжника я одним мановением начальственных рук был перенесён в положение соучастника некоей жульнической комбинации, в положение, так сказать, совладельца некоей жульнической тайны."
                                            },
                                            {
                                                "example_id": "f33837da-6f10-4432-8758-d14b00140804",
                                                "sense_id": "1997658a-b5b4-31eb-9224-9f41e22fd0ff",
                                                "text": "Очень часто за психологической консультацией обращаются совладельцы фирм, которые не могут найти общий язык друг с другом."
                                            },
                                            {
                                                "example_id": "998a60c8-db35-432b-bfe0-c49078f5c5a0",
                                                "sense_id": "1997658a-b5b4-31eb-9224-9f41e22fd0ff",
                                                "text": "Они получили свои доли собственности и превратились в совладельцев комбината."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
