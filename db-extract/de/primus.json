                    {
                        "sense_id": "df1e384a-eb89-3ce3-86fd-f9f5806753df",
                        "entry_id": "2996c2c6-b327-3c0c-a8f6-873438236e07",
                        "glosses": [
                            "top pupil of a class"
                        ],
                        "tags": [
