                ],
                "senses": [
                    {
                        "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                        "entry_id": "6a5f11f5-53d1-38d7-b6cd-5e93eec5595a",
                        "glosses": [
                            "Sportdisziplin, bei der eine an einem Stahldraht befestigte Kugel aus dem Hammerwurfring möglichst weit geworfen werden soll"
                        ],
                        "tags": [
                            "Leichtathletik"
                        ],
                        "examples": [
                            {
                                "example_id": "614a5f30-f713-456f-8e38-81b4bd5ca4cb",
                                "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                                "text": "Das Hammerwerfen im Hochleistungssport ist von einer fortschreitenden Leistungsverbesserung gekennzeichnet."
                            },
                            {
                                "example_id": "1a5b9a70-8450-4239-8b77-d4a21b6d1416",
                                "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                                "text": "Dort gibt es verschiedene Wettbewerbe wie Seilziehen, Hammerwerfen, Wettrennen oder traditionelles Tanzen."
                            },
                            {
                                "example_id": "fda6318f-06a0-4dce-828a-a9dfa039cb01",
                                "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                                "text": "Das Hammerwerfen ist seit den Spielen von 1900 (Paris) eine olympische Disziplin der Leichtathletik und ohne Zweifel eine der schwierigsten technischen Disziplinen."
                            },
                            {
                                "example_id": "3b25195a-fb82-4b2f-9ed5-9281639e8e25",
                                "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                                "text": "Seit dem Jahr 2000 immerhin ist Hammerwerfen auch für Frauen olympisch, und damit als Sportart eben auch für alle offen."
                            },
                            {
                                "example_id": "c0d74232-81f6-4f2f-aec8-b90e67d61461",
                                "sense_id": "17f5dab1-1927-3c5f-8460-3e566fad9349",
                                "text": "Dass die Frankfurterin Betty Heidler einen neuen Weltrekord im Hammerwerfen aufstellen konnte, ist auch ein Resultat moderner Analysemethoden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
