                "senses": [
                    {
                        "sense_id": "2555e827-d851-3691-a064-7b9e59fbb41e",
                        "entry_id": "c2567527-0d60-3b25-b49c-ec4af244e23f",
                        "glosses": [
                            "ein besonders angesehenes, herausforderndes Teilgebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb25052-3d84-48e7-9a88-6469e31f76c1",
                                "sense_id": "2555e827-d851-3691-a064-7b9e59fbb41e",
                                "text": "„Die Manipulation ist die Königsdisziplin der Zauberkunst.“"
                            },
                            {
                                "example_id": "54668313-f728-453c-bf36-e48bca937a94",
                                "sense_id": "2555e827-d851-3691-a064-7b9e59fbb41e",
                                "text": "„Die vier Lauf-, drei Sprung- und drei Wurfdisziplinen erfordern große Vielseitigkeit und Ausdauer der Sportler. Deshalb wird der Zehnkampf auch die Königsdisziplin der Leichtathletik genannt.“"
                            },
                            {
                                "example_id": "7890bad5-ed67-4e4a-bd29-ac6d6ccd047b",
                                "sense_id": "2555e827-d851-3691-a064-7b9e59fbb41e",
                                "text": "„Der Marathon ist eine Königsdisziplin der Leichtathletik, bei der eine gute Renntaktik essenziell ist.“"
                            }
                        ],
