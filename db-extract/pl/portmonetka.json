                    },
                    {
                        "translation_id": "9b795b2f-9627-4c86-bc80-b55e9b5c262c",
                        "source_entry_id": "c0b994a3-eaa9-364e-a10d-6864dd546a03",
                        "source_sense_id": "dc2546ce-d5cb-32db-b1ac-5bedd460edb7",
                        "target_lang_word": "Portemonnaie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portemonnaie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                        "entry_id": "e12b6db9-51e3-3e62-b944-73fa0f7255f7",
                                        "glosses": [
                                            "kleines Behältnis für das bei sich getragene Geld"
                                        ],
                                        "tags": [
                                            "Accessoire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5ca7ac-c801-4696-85cb-1dddbf18c499",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "Kannst Du mir zehn Euro leihen? Ich habe mein Portemonnaie daheim liegenlassen."
                                            },
                                            {
                                                "example_id": "50001c12-c4eb-4a9d-84fc-0b60df08e47b",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "Mein Portemonnaie ist zerschlissen, ich sollte mir ein neues kaufen."
                                            },
                                            {
                                                "example_id": "da0327ab-4295-4fa6-9425-8fb549916242",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "„In Köln gibt es noch viele französische Wörter aus der Zeit der Besetzung durch Napoleon: Portemonnaie für Geldbörse, Plumeau für Federbettdecke, Trottoir für Bürgersteig.“"
                                            },
                                            {
                                                "example_id": "4672ef61-34fb-4d87-bacf-2b981275ebbe",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "„Da zuckt er mit den Schultern und holt eine Visitenkarte aus dem Portemonnaie heraus.“"
                                            },
                                            {
                                                "example_id": "712ad1cf-b550-4333-b3f0-394a004726b2",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "„Das Portemonnaie an sich wird also schon geliebt, die Füllung macht es nur noch bedeutender.“"
                                            },
                                            {
                                                "example_id": "61c775c6-329b-4f61-bc51-ca92ea48d8bc",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "„In einer Marktwirtschaft ist niemand und nichts so mächtig wie das Portemonnaie des Verbrauchers.“"
                                            },
                                            {
                                                "example_id": "903623e8-8efe-4a3c-a93e-3b082714b951",
                                                "sense_id": "7e498df2-e986-36fd-8e12-5fb0e91de670",
                                                "text": "„Dann aber holte er sein Portemonnaie heraus und gab mir fünf Mark und sagte, davon könne ich mir eine Kleinigkeit oder auch etwas zu essen kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
