                        "form": "den Quendel"
                    },
                    {
                        "form_id": "0e59afbf-5cd2-4fc5-9e31-877f81169164",
                        "entry_id": "d0b3d100-9d7d-306f-9847-dfdb655fb097",
                        "tags": [
                            "accusative",
