                "senses": [
                    {
                        "sense_id": "2c385674-d661-3542-9c9b-2465241d1310",
                        "entry_id": "fe2e3b10-6c28-3d75-9711-96894cbe7940",
                        "glosses": [
                            "хим. сложная органическая молекула, мономеры которой состоят из углеродного скелета, как правило, замкнутого в кольцо, и присоединенных к нему в разных положениях остатков молекул воды (–Н и –ОН)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4d4f5071-f8ae-34a7-9e8f-4ddc412800eb",
                        "entry_id": "fe2e3b10-6c28-3d75-9711-96894cbe7940",
                        "glosses": [
                            "биохим., мн. ч. сахара, алифатические полиоксикарбонильные соединения и их многочисленные (в т. ч. полимерные) производные, компоненты всех без исключения живых организмов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dfeb007-1194-4fcf-bb8d-3539b7e7c748",
                        "source_entry_id": "fe2e3b10-6c28-3d75-9711-96894cbe7940",
                        "target_lang_word": "carbohydrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbohydrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                        "entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                                        "glosses": [
                                            "A sugar, starch, or cellulose that is a food source of energy for an animal or plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cf2489-ccb6-482b-a9db-67f903536935",
                                                "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                                "text": "These microbes are primarily responsible for breaking down cellulose and other carbohydrates into volatile fatty acids (VFAs)."
                                            },
                                            {
                                                "example_id": "5d17b056-7ba7-40cb-a9bb-94184d601780",
                                                "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd21a0c6-a6ec-35d4-aa35-15c5c0075cdc",
                                        "entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                                        "glosses": [
                                            "Any food rich in starch or other carbohydrates."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee65c7cd-da93-4019-8ed4-2eebae90d2dd",
                                                "sense_id": "dd21a0c6-a6ec-35d4-aa35-15c5c0075cdc",
                                                "text": "I'm cutting down on carbohydrates like bread and pasta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
