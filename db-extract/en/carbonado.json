                                    {
                                        "sense_id": "268fe227-e6e1-36ce-9b90-56e30da9430c",
                                        "entry_id": "b206566a-27ab-3768-a529-8faae44a86b1",
                                        "glosses": [
                                            "Variante orthographique de carbonnade."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a22a60e-c852-4ea3-9ed5-b086671940b8",
                                                "sense_id": "268fe227-e6e1-36ce-9b90-56e30da9430c",
                                                "text": "Chez les bouchers, quand la vieille Annou demandait une carbonade, l’étalier lui riait au nez ; il ne savait pas ce que c’était une « carbonade », ce sauvage !…"
                                            },
                                            {
                                                "example_id": "874707ec-b8b1-4299-a7e1-171790daf01a",
                                                "sense_id": "268fe227-e6e1-36ce-9b90-56e30da9430c",
                                                "text": "Les gens ne voulaient pas entendre parler de poissons. Il ne leur fallait que du bœuf, des carbonades et des vitolets."
                                            },
                                            {
                                                "example_id": "3f8facad-f80a-4a7c-89ae-b2bc45a23871",
                                                "sense_id": "268fe227-e6e1-36ce-9b90-56e30da9430c",
                                                "text": "Je comprends pourquoi on ne trouve pas de cassoulet ni de carbonade flamande aux USA."
                                            },
                                            {
                                                "example_id": "55fa9aed-9a64-4180-870f-e3ec9fea45fc",
                                                "sense_id": "268fe227-e6e1-36ce-9b90-56e30da9430c",
                                                "text": "Les bières brunes s'associent pour un accord de caractère avec des rognons grillés ou un civet de marcassin, sans oublier la fameuse carbonade, du boeuf en sauce à base de bière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b3141ff-75a5-46c3-a5a1-56a2b77249d5",
