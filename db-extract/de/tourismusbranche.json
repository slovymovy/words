                ],
                "senses": [
                    {
                        "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                        "entry_id": "b6ab1a7b-7864-3e56-af87-fcc11a1b1ad7",
                        "glosses": [
                            "Geschäftszweig, der sich vor allem damit beschäftigt, Reisen an Personen zu verkaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87f3513-c797-4324-ab40-2466813b9250",
                                "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                                "text": "„Die Tourismusbranche wächst stetig - trotz Krisenanfälligkeit und Konjunkturabhängigkeit.“"
                            },
                            {
                                "example_id": "607edc37-6ce6-47b9-a094-21ba1bcb491b",
                                "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                                "text": "„Die Tourismusbranche ist voll auf das Geschäft mit der Gesundheit abgefahren.“"
                            },
                            {
                                "example_id": "63a912e3-e59b-4067-936d-6e258ab8768f",
                                "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                                "text": "„Nach einer Studie der WTTC ist bereits jeder dreizehnte beschäftigte Erdenbürger in der Tourismusbranche tätig und jährlich werden es 2,8 Prozent mehr.“"
                            },
                            {
                                "example_id": "1f0a70f8-a3bd-4087-8537-fd41648ccf26",
                                "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                                "text": "„Auch Hanse-Nostalgie macht sich günstig in Zeiten, da die Tourismusbranche zu einem der wichtigsten Wirtschaftsfaktoren der Region geworden ist.“"
                            },
                            {
                                "example_id": "7702b2d3-249f-4137-9c68-4a56929a4264",
                                "sense_id": "5197ac15-743f-35a6-9ee9-22534877df7a",
                                "text": "„Die krisengeplagte Tourismusbranche in den Alpen braucht nicht nur jeden zahlenden Gast, sondern hat gerade abenteuerlustige Bergsportler als lohnende Zielgruppe wiederentdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
