                "senses": [
                    {
                        "sense_id": "e1090eb3-5d89-3040-9350-cddf201e87bb",
                        "entry_id": "d7bb2c43-00be-367f-8b61-9067d2e2c9d8",
                        "glosses": [
                            "extrem kleine Poren mit einem Durchmesser von unter 0,4 Nanometern"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5988c96b-02be-43ae-bdc0-680ca1a99f0a",
                                "sense_id": "e1090eb3-5d89-3040-9350-cddf201e87bb",
                                "text": "„Während Helium wegen seiner geringen Atomgröße auch die Submikroporen füllt, kann Quecksilber unter den Versuchsbedingungen nicht einmal in die Zuleitungsporen eindringen.“"
                            },
                            {
                                "example_id": "07c0a602-a8c1-4aca-83ea-bee753de03dd",
                                "sense_id": "e1090eb3-5d89-3040-9350-cddf201e87bb",
                                "text": "„Zur direkten Bestimmung der Kapillar- und Submikroporen (Gelporen) des Überdeckungsbetons sind andere Methoden anzuwenden.“"
                            },
                            {
                                "example_id": "78ba53f4-0f88-4c58-95d6-2570695ae888",
                                "sense_id": "e1090eb3-5d89-3040-9350-cddf201e87bb",
                                "text": "„In ihr ist auch das Volumen der Submikroporen enthalten, das nicht mit Flüssigkeit ausgefüllt werden kann.“"
                            },
                            {
                                "example_id": "d025c5ef-3fd6-417e-904c-3a5965001697",
                                "sense_id": "e1090eb3-5d89-3040-9350-cddf201e87bb",
                                "text": "„Die adsorptive Abwasserreinigung mit regenerierbarer Aktivkohle wirft zunächst die Frage auf, wieweit sich aus der im allgemeinen durch Gasadsorption bestimmten Textur der Mikro- und Submikroporen auch Schlüsse auf die Adsorption organischer Stoffe aus wäßrigen Lösungen ziehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
