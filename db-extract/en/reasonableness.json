                        "sense_id": "6c670d87-f04e-349d-b6c0-1111ad50ac9b",
                        "entry_id": "572f8f4e-bb0b-3861-936f-86185a205ad2",
                        "glosses": [
                            "The state or characteristic of being reasonable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9e259043-446a-4d7e-9980-eaca6edb261c",
                                "sense_id": "6c670d87-f04e-349d-b6c0-1111ad50ac9b",
                                "text": "This dictates the reasonableness of the rupture of a unipersonalist absolute that is pseudomonotheistic since, in this case, the possibility of any other being would have been made impossible."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0926b6f-e547-362e-98b1-6ae2bb15f6b6",
                        "entry_id": "572f8f4e-bb0b-3861-936f-86185a205ad2",
                        "glosses": [
                            "A reasonable action or behaviour."
                        ],
