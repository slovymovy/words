                "senses": [
                    {
                        "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                        "entry_id": "e15f0785-58dc-3eea-9806-8e8125a1ac9b",
                        "glosses": [
                            "Bescheinigung, Schriftstück, der zur Nutzung von bestimmten Segelbooten berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51838b7-6564-4fca-9074-fdb54d964959",
                                "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                                "text": "„Diesen Lehrgang hätte man fortsetzen und den Segelschein erwerben können, doch irgendwie wollte ich dies damals nicht.“"
                            },
                            {
                                "example_id": "ade958a7-90d2-4e69-9072-8d307dc0680b",
                                "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                                "text": "„1945 hat sie als erste Frau in Island den Segelschein erworben.“"
                            },
                            {
                                "example_id": "fc5495dc-6961-4049-bc69-e90413540dac",
                                "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                                "text": "„Einen Segelschein hat keiner von ihnen, den braucht man in Holland auch nicht.“"
                            },
                            {
                                "example_id": "4e82c754-3e74-4fc7-8f90-23c71268328d",
                                "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                                "text": "„Franzi hat vor zwei Jahren den Segelschein gemacht und rate mal, wer sie beim Lernen andauernd abgefragt hat?“"
                            },
                            {
                                "example_id": "720e2763-dd81-401d-9157-0b08cad2c123",
                                "sense_id": "416f156b-83c1-375a-92e3-4071453b7f68",
                                "text": "„Dieser hatte sowohl einen Segelschein für Hochseegewässer, als auch einen entsprechenden Motorbootführerschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
