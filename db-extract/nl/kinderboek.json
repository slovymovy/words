                ],
                "senses": [
                    {
                        "sense_id": "60f3a838-d489-3bb0-b563-db31e56ffd73",
                        "entry_id": "fc24735d-15f3-384d-a35c-b8284ea246b9",
                        "glosses": [
                            "boek speciaal voor kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec39b13-ef08-4d5d-807c-bbc804826729",
                                "sense_id": "60f3a838-d489-3bb0-b563-db31e56ffd73",
                                "text": "Een jubileum waar niemand bij stil staat, verdient die naam misschien niet. Een herdenking met één deelnemer, dat klinkt niet koosjer. Toch grijp ik de gelegenheid, omdat het kinderboek dat precies 25 jaar geleden verscheen, met elke verhuizing mee mocht: Plinius Pinguïn (1990) van Boudewijn Büch (1948-2002), met tekeningen van Pauline Drost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38ed95fc-b55c-4a0c-8246-8a9f521d4acd",
                        "source_entry_id": "fc24735d-15f3-384d-a35c-b8284ea246b9",
                        "source_sense_id": "60f3a838-d489-3bb0-b563-db31e56ffd73",
                        "target_lang_word": "Kinderbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kinderbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                        "entry_id": "da0888f9-5374-32fa-9c59-6aa5c9dd1b79",
                                        "glosses": [
                                            "Buch, das in Inhalt und Aufmachung an Kindern ausgerichtet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a6e833-6a29-482c-ae43-b5a5b5d9e2d5",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "Mein erstes Kinderbuch war „Hauffs Märchen“."
                                            },
                                            {
                                                "example_id": "0db96a33-e78f-42e5-a788-f12653c7145b",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "„Wenn ich zurückblicke und mich an die Bücher erinnere, die ich in meiner Kindheit gelesen habe, so fällt mir auf: jene Bücher haben nichts mit Kinderbüchern gemeinsam.“"
                                            },
                                            {
                                                "example_id": "2827ca81-aabf-4428-9a8e-520600c6a46d",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "„Der naive, wie von Kinderhand gezeichnete Valek nahm den Stil seiner zukünftigen Kinderbücher vorweg.“"
                                            },
                                            {
                                                "example_id": "70b68900-de05-430e-89fc-9c6537f1c716",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "„Ich glaube, es ist das erfolgreichste Kinderbuch der Welt.“"
                                            },
                                            {
                                                "example_id": "ef31a5d9-fc28-41a4-a16f-79f0eb4a5769",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "„Daneben verfasste er populärwissenschaftliche Werke sowie ein Kinderbuch, studierte die Psychoanalyse und übersetzte Freud ins Jiddische.“"
                                            },
                                            {
                                                "example_id": "859b136e-decc-4a0e-a296-1e1282086676",
                                                "sense_id": "1f709c68-1de2-3bf7-bc7b-f93a858940c0",
                                                "text": "„Sie hat Kästner auf die Idee gebracht, es doch einmal mit Kinderbüchern zu versuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
