                                    {
                                        "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                        "entry_id": "cc7c88cd-eb80-3be5-a560-cd1c451a89ee",
                                        "glosses": [
                                            "von Mode und Geschmack zeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f483819-01a4-4d75-92d1-4d09e888a66b",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Sie ist eine ausgesprochen schicke Person."
                                            },
                                            {
                                                "example_id": "ef1f69d5-98b7-44a3-9c07-a1d6e6a5f9c3",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Der neue Laden ist sehr schick aufgemacht."
                                            },
                                            {
                                                "example_id": "1c28395d-c201-4242-ba57-dd32c3caadc1",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "„Wir hatten uns schick gemacht am ersten Tag nach den großen Ferien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                        "entry_id": "cc7c88cd-eb80-3be5-a560-cd1c451a89ee",
                                        "glosses": [
                                            "sich positiv abhebend, hervorragend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740da69f-b807-4fed-87f7-e08c8c65cfad",
                                                "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                                "text": "Das ist aber schick, dass Du die Prüfung bestanden hast!"
                                            },
                                            {
                                                "example_id": "bc529288-8a1a-45d8-90c0-69350be834be",
                                                "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                                "text": "„Abgesehen von der deutschen Sprache, der modischen Kleidung aus Kunstseide, Arbeit im Handel und der Verachtung für die niederen Klassen war es außerdem schick, Zigaretten zu rauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "schick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89fd74b9-8612-3e5d-afc5-179f4fa82692",
                                        "entry_id": "541c12ab-4997-3040-83ab-dcc8eb812f68",
