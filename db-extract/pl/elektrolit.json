                                "target_senses": [
                                    {
                                        "sense_id": "4f9d7466-83aa-3add-b1f3-68c01f76bf5f",
                                        "entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                                        "glosses": [
                                            "A substance that, in solution or when molten, ionizes and conducts electricity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a322865a-0ed7-3b8f-b9b8-addfd457c624",
                                        "entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                                        "glosses": [
                                            "A solution containing such substances, which therefore also conducts electricity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77116d0b-ff8f-42e6-88d9-aba1a0f518fc",
                                                "sense_id": "a322865a-0ed7-3b8f-b9b8-addfd457c624",
                                                "text": "Some modern lead-acid batteries are sealed because they never need to have any electrolyte added during their service life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bffb52cd-9746-3433-a79e-3a940a460880",
                                        "entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                                        "glosses": [
                                            "Any of the various ions in such a solution, or (metonymically) their concentration therein."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b13febdd-abe6-39e9-bfc8-f3e5a2dbe7af",
                                        "entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                                        "glosses": [
                                            "Any of the various ions in such a solution, or (metonymically) their concentration therein.",
                                            "Any of the various biometal ions (such as sodium or chloride) that regulate the electric charge on cells and the flow of water across their membranes, or (metonymically) such an ion's concentration in a bodily fluid, usually and especially blood, blood serum, or urine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c3d6f4-dcaa-4ae3-a915-89dbde6d2bae",
                                                "sense_id": "b13febdd-abe6-39e9-bfc8-f3e5a2dbe7af",
                                                "text": "Lab tests to consider under these circumstances include serum electrolytes, serum glucose, and urine protein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb0e436-d280-4e85-b7a6-3b77e2ee18c1",
