                "translations": [
                    {
                        "translation_id": "0fcdc6f3-7fd2-4965-8316-0aa6aee04e35",
                        "source_entry_id": "0ac8ed3e-7075-3913-9db2-cf7f4fb0dcbd",
                        "source_sense_id": "25491535-c535-3e7e-870f-cf1d1a2468cf",
                        "source_sense_description": "jemand, der einen Job hat; jemand, der jobbt",
                        "target_lang_word": "jobber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jobber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d6a605d-66c1-3505-a7a7-21bd48b521b6",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "One who works by the job (i.e. paid per individual piece of work) and/or recruits other people for such work."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e5bcb8-89bb-4d28-9cf0-f645fb289876",
                                                "sense_id": "5d6a605d-66c1-3505-a7a7-21bd48b521b6",
                                                "text": "The deponent, in the course of negotiation for sundry jobs, expressed his curiosity repecting the Habits and Life of the Knights of the Thimble, when the jobber to the Nobility and Gentry kindly volunteered to accompny him on a round to some of the great shops of the west."
                                            },
                                            {
                                                "example_id": "da631e46-1141-42fa-bb6b-d67437b21b75",
                                                "sense_id": "5d6a605d-66c1-3505-a7a7-21bd48b521b6",
                                                "text": "Every person who shall keep any boat for the purpose aforesaid without having such license, and every owner of, or other person who shall be employed or shall ply for hire in any such boat within the limits aforesaid without having such license or wearing such badge as aforesaid, and every person who shall offer himself as a porter or jobber within the said town of Saint George without having such license or wearing such badge aforesaid, shall, for every such offence, forfeit and pay a penalty not exceeding forrty shillings."
                                            },
                                            {
                                                "example_id": "4b2662cd-b3e9-4221-bcc1-5d23696671f0",
                                                "sense_id": "5d6a605d-66c1-3505-a7a7-21bd48b521b6",
                                                "text": "The jobbing clerk immediately upon receipt of the ticket minuted it properly in the book, and, upon looking at the annunciator, saw that it showed no jobbers in the waiting room; he went at once to the waiting room, but found no one there; he then returned to his own room and called down the speaking-tube to the basement for a jobber, but was told by the boiler tender that no jobber was there. The foreman of the jobbing department was then at his desk, but the clerk did not call his attention to the fact of the complaint or to his failure to find a jobber, nor did he make any further effort to find a jobber or to mention the complaint to any one until about 11.35, when he again called to the basement for a jobber, and ordered the first one who came in to be sent up."
                                            },
                                            {
                                                "example_id": "9db9602c-8732-4fa8-9d8e-ce4500982817",
                                                "sense_id": "5d6a605d-66c1-3505-a7a7-21bd48b521b6",
                                                "text": "In the Mills there existed a usage under which a worker was first appointed as a Cleaner then an Oiler and thereafter promoted as a Jobber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0423898-a3c2-3ed2-acdc-1d0eb6705b57",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "An actor temporarily employed for a specific role, often in a touring company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e455909-14b6-4814-8830-fad0d8c59500",
                                                "sense_id": "a0423898-a3c2-3ed2-acdc-1d0eb6705b57",
                                                "text": "Most of the music circuses use jobbers in four to eight of the leading roles for each show. These jobbers are principal actors who are employed for one or two leading roles during the season. There is no difference between a star and a jobber, except that a jobber is not necessarily a \"big-name\" performer […]"
                                            },
                                            {
                                                "example_id": "a11f8dc6-6859-41dd-b5c6-34940941a0ec",
                                                "sense_id": "a0423898-a3c2-3ed2-acdc-1d0eb6705b57",
                                                "text": "Jobbers are used as needed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c3b1bc-ad7a-3847-801e-d2bd6b101f49",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "A promoter or broker of stocks for investment."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38658c5b-1e49-4a67-9115-be0543acb3cf",
                                                "sense_id": "24c3b1bc-ad7a-3847-801e-d2bd6b101f49",
                                                "text": "An act to restrain the number and ill practice of brokers and stock jobbers: 8 & 9 Wm. 3, ch. 32 (1697) [legislation of English parliament]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23674b04-911e-3ed5-b6d5-518a3e493e73",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "An intermediary who buys and sells merchandise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16ed09e-7344-46a8-ab7a-8402bc57f1d9",
                                                "sense_id": "23674b04-911e-3ed5-b6d5-518a3e493e73",
                                                "text": "We will say \"I would rather be an expressman hauling tobacco, cigarettes, et cetera, than be a jobber of such commodities,\" especially in the city of Boston at the present writing."
                                            },
                                            {
                                                "example_id": "9b4858dc-8bad-42f2-828e-e63d3528f970",
                                                "sense_id": "23674b04-911e-3ed5-b6d5-518a3e493e73",
                                                "text": "In considering the reasons for the manufacturer's growing independence of the jobber we must class them under two heads; first the reasons that might apply to the old-fashioned jobber who has not varied his activities from the historic model, and, second, the reasons that apply only to the jobber who has departed from the old model and has undertaken or abandoned certain activities in an attempt to strengthen his position."
                                            },
                                            {
                                                "example_id": "4e88582f-84f2-4399-a9fb-2d62c79679e4",
                                                "sense_id": "23674b04-911e-3ed5-b6d5-518a3e493e73",
                                                "text": "It is usually best to choose a book jobber to handle the bulk of a library's purchases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d01c483-14f6-3280-995e-952964f3463e",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "An intermediary who buys and sells merchandise.",
                                            "A type of intermediary in the apparel industry, as well as others, who buys excess merchandise from brand owners and manufacturers, and sells to retailers at prices that are 20-70% below wholesale."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c2a0dc4-013a-3b10-95fe-7e131b58e582",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "An intermediary who buys and sells merchandise.",
                                            "A market maker on the stock exchange; a stockjobber."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cac89a1c-37d1-31e6-bfab-d478ff535aa4",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "A performer whose primary role is to lose to established talent."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63c7d83-b94a-49f3-ba2a-02ea43b0404d",
                                                "sense_id": "cac89a1c-37d1-31e6-bfab-d478ff535aa4",
                                                "text": "My argument has ALWAYS been that 99.9% of all wrestlers are jobbers (and I'm 100% correct)."
                                            },
                                            {
                                                "example_id": "7ceee056-f00a-4779-b2d5-1a536a28a17b",
                                                "sense_id": "cac89a1c-37d1-31e6-bfab-d478ff535aa4",
                                                "text": "I agree, Superstars got a bit dull with the jobber matches at times but it furthered storylines so they didn't have to give away PPV matches on a regular TV show..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b95fae-3117-3dcb-a7ee-69d08241080f",
                                        "entry_id": "ad2383d5-6f77-3c85-8a3b-86d1c8647af7",
                                        "glosses": [
                                            "A thing (often used in a vague way to refer to something the name of which one cannot recall)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
