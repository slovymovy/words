                                                "sense_id": "9be4436d-339b-3e0e-9805-5bb3b020fa77",
                                                "text": "waarop staat die vaas met bloemen?"
                                            },
                                            {
                                                "example_id": "c16fc27e-05b9-419d-a0a8-abd0a5465127",
                                                "sense_id": "9be4436d-339b-3e0e-9805-5bb3b020fa77",
