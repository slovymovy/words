                    },
                    {
                        "translation_id": "367b9ac9-590d-4810-96f5-5a2995375100",
                        "source_entry_id": "6ba4d075-ae6a-3b80-a348-fc6be997532f",
                        "source_sense_description": "housing, barracks",
                        "target_lang_word": "Wohnraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                        "entry_id": "e089a3fb-bd3f-39b3-8bbb-3bb3df3861a3",
                                        "glosses": [
                                            "ein Zimmer, welches zum Schlafen oder Wohnen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc41e88-705e-4bee-9c33-3778c2a02ff4",
                                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                                "text": "Die Polizei durchsuchte nochmals die Wohnräume des Verdächtigen."
                                            },
                                            {
                                                "example_id": "7e91e426-5f7b-4a81-900f-e0502217c7ca",
                                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                                "text": "„Meine Freude wurde allerdings bald getrübt, da die Suche nach bezahlbarem Wohnraum mich beinahe in den Wahnsinn trieb.“"
                                            },
                                            {
                                                "example_id": "87c8c6fa-b243-45db-8381-98071694b480",
                                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                                "text": "„Der Wohnraum war rustikal eingerichtet.“"
                                            },
                                            {
                                                "example_id": "62c31207-1254-4072-a421-f51e507c65c0",
                                                "sense_id": "54032fc3-499c-3ab3-9aba-d8776815b703",
                                                "text": "„Der H-förmig erbauten dreigeschossigen Villa mit Walmdächern schließt sich ein großer, geschlossener Wirtschaftshof mit Wohnräumen für Bedienstete, Küche, Werkstätten, Garagen und Ställen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                        "entry_id": "e089a3fb-bd3f-39b3-8bbb-3bb3df3861a3",
                                        "glosses": [
                                            "Sammelbegriff für alle Wohnungen und Wohnhäuser in einer gewissen Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56002702-607b-4cf7-ab7a-8d23cd898642",
                                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                                "text": "In Bayern suchen vermehrt Studenten nach günstigem Wohnraum."
                                            },
                                            {
                                                "example_id": "5048e43a-ce26-434a-ab47-aee363d679e3",
                                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                                "text": "„Der Wiederaufbau und die Schaffung von neuem Wohnraum bestimmten die Entwicklung der Stadt bis in die 1960er Jahre hinein.“"
                                            },
                                            {
                                                "example_id": "086d1697-c032-4ef7-a473-c5ec8bb2692a",
                                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                                "text": "„Doch das Ballungsgebiet hat auch Nachteile: Bezahlbarer Wohnraum wird knapp.“"
                                            },
                                            {
                                                "example_id": "a40062f5-cb93-490c-b909-65660e0ca951",
                                                "sense_id": "da42ebde-1592-3a3a-8efa-df1791a65176",
                                                "text": "„Bundesweit fehlen […] rund 550.000 Wohnungen - insbesondere bezahlbarer Wohnraum in Ballungszentren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a30469b8-1e6a-4c4e-aa7c-94126384ead8",
                        "source_entry_id": "6ba4d075-ae6a-3b80-a348-fc6be997532f",
                        "source_sense_description": "housing, barracks",
                        "target_lang_word": "Quartier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quartier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                        "entry_id": "ada51142-d7f7-3c61-8c33-99161409836a",
                                        "glosses": [
                                            "Örtlichkeit, an der jemand unterkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c6dbf0-0c14-412d-8efa-162b544bca98",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "Alle Quartiere sind belegt."
                                            },
                                            {
                                                "example_id": "ef3f6f67-1256-46ea-9fe6-531ee05d7e9a",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Wir erkundigten uns ungesäumt hergebrachterweise, was für Quartier, Tisch, Wein, Frühstück und sonstiges Bestimmbare zu bezahlen sei.“"
                                            },
                                            {
                                                "example_id": "e1814eeb-2fd4-40e4-8f54-3876971bd91c",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Während die allermeisten Teilnehmer in Zelten und Massenunterkünften Quartier finden, hat Gerhard einmal mehr das große Los gezogen.“"
                                            },
                                            {
                                                "example_id": "e97ec8f0-022e-4996-ada2-c60c71186d22",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Gilli kam die Straße entlang, verschränkte die Arme wie jemand, der friert, ging in Richtung zu ihrem Quartier und winkte gequält.“"
                                            },
                                            {
                                                "example_id": "08e3dd4b-2748-4712-8167-0b610ef8547f",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Schlump und Jolles gingen in die Stadt, um sich nach einem Quartier umzusehen, die anderen räumten aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                        "entry_id": "ada51142-d7f7-3c61-8c33-99161409836a",
                                        "glosses": [
                                            "Teil einer Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30712990-4ffb-4d7b-b79c-e3e7788edf79",
                                                "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                                "text": "In diesem Quartier wohnen viele Menschen mit Migrationshintergrund."
                                            },
                                            {
                                                "example_id": "cb11fe88-157a-404c-80cd-fd0f37edac1f",
                                                "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                                "text": "„16 Polizeibeamte unterstehen ihm, sie sollen gegen Drogendealer vorgehen, Cafés kontrollieren, das Quartier entkriminalisieren, so weit das möglich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
