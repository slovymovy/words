                                    {
                                        "sense_id": "60b8b03a-85a6-3e3c-b7ad-cf90f5007c27",
                                        "entry_id": "0cb38d55-18fa-32d1-8526-5ec76185f5ab",
                                        "glosses": [
                                            "To stand or jump up quickly."
                                        ],
                                        "tags": [
                                            "of a guinea pig or chinchilla"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0020216-2758-4d07-8e7d-1ec74c20a8be",
                                                "sense_id": "60b8b03a-85a6-3e3c-b7ad-cf90f5007c27",
                                                "text": "Popcorning behavior is a fun sight—as long as you know what it is. Otherwise, it can scare you. During this action a pig runs around very fast and suddenly leaps straight up in the air, twitching and squeaking. It then lands and takes off again, often in another direction. This activity shows pure joy. Babies start to popcorn when they are about two weeks old or so—they may try it earlier, but they usually fall down instead."
                                            }
                                        ]
                                    },
