                "senses": [
                    {
                        "sense_id": "20febe01-b486-34ca-ac78-6bf21f2a3e5c",
                        "entry_id": "7394c09b-50b9-366a-9d5e-1a60dffbf494",
                        "glosses": [
                            "odnoszący się do Ariów (mieszkańców starożytnych Indii)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c87a75e5-5a60-3151-99ba-b512d69c7497",
                        "entry_id": "7394c09b-50b9-366a-9d5e-1a60dffbf494",
                        "glosses": [
                            "o języku: stosowany na subkontynencie indyjskim, wywodzący się z indoirańskiej grupy języków indoeuropejskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8cc5b8-0c3e-470f-b719-cb27849f4ca4",
                                "sense_id": "c87a75e5-5a60-3151-99ba-b512d69c7497",
                                "text": "Trzy najważniejsze grupy językowe: indoaryjska, semicka i mongolska zakładają istnienie jakiegoś wspólnego prajęzyka, bo niektóre podstawowe źródłosłowy są w nich wspólne."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6557fcea-e0bf-423a-a4b0-6e97cd87cafd",
                        "source_entry_id": "7394c09b-50b9-366a-9d5e-1a60dffbf494",
                        "source_sense_id": "20febe01-b486-34ca-ac78-6bf21f2a3e5c",
                        "target_lang_word": "Indo-Aryan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indo-Aryan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                        "entry_id": "6a08d493-5048-3581-bc0e-574af61b15ff",
                                        "glosses": [
                                            "A branch of the Indo-Iranian languages in the Indo-European language family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c05ef9-4d2a-48f2-b650-affd61193c5b",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "Such a situation is not unusual in the history of languages, but Indo-Aryan has a very virulent case of the disease."
                                            },
                                            {
                                                "example_id": "bd5d07a6-1869-4497-a6f6-b643cc33e8ac",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "This is another way in which a depiction of the historical developments in Indo-Aryan bears on the theory of phrase structure generally, and on the rise of adpositional phrases in Indo-European specifically, showing us alternative pathways of change."
                                            },
                                            {
                                                "example_id": "b765fb02-a07a-4011-aad2-e69f1603bc60",
                                                "sense_id": "fc3ede99-060e-3752-b453-74a98e836854",
                                                "text": "Indo-Aryan has a very long history of attestation, from around 1400 bc to the present […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Indo-Aryan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6756643b-b248-3a2f-8a38-ec32b5913c82",
