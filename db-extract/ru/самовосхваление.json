                                "target_senses": [
                                    {
                                        "sense_id": "8e5f0661-6177-35a8-b9b3-5141e7241c8d",
                                        "entry_id": "3b368ee9-578a-35ad-a535-5a4897890810",
                                        "glosses": [
                                            "Promoción, alabanza o elogio explícito, frecuentemente ostentoso y público, que hace uno de sí mismo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc79fa79-18d2-4c69-ba42-14f8738b5312",
                                                "sense_id": "8e5f0661-6177-35a8-b9b3-5141e7241c8d",
                                                "text": "Su autobombo convencerá a otros pero a mí me parece simplemente un bocazas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
