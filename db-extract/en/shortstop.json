                ],
                "senses": [
                    {
                        "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                        "entry_id": "899f7381-901f-3cb3-84ed-5eecfc8a43d5",
                        "glosses": [
                            "Alternative form of short-stop (to play shortstop)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "f4149211-2204-4676-b05e-3c4a6842e2fd",
                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                "text": "He captained the Tecumsehs of London, Ontario, (International Association) in 1878; shortstopped for Cincinnati in 1879; stayed out of baseball in 1880; and finished as shortstop for Boston (NL) in 1881."
                            },
                            {
                                "example_id": "aedd9de5-0bf1-4ac3-9c0c-f0c72caa6dfc",
                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                "text": "Managed and shortstopped by George Wright and full of league stalwarts—Joe Start, Paul Hines, and Jim O'rourke—they also had 1-year-old phenom Monte Ward as primary moundsman (teams now generally used multiple pitchers)."
                            },
                            {
                                "example_id": "50e86053-0686-4f62-a766-50cd1e72c0ce",
                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                "text": "He shortstopped for a few years for the Houston Astros when they won the World Series twice in a row."
                            }
                        ]
                    },
                    {
                        "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                        "entry_id": "899f7381-901f-3cb3-84ed-5eecfc8a43d5",
                        "glosses": [
                            "Alternative form of short-stop (to cause to stop short)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "67f03e11-aaa7-4a79-a654-1cf6a6137b95",
                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                "text": "In the polymerization of BD by Ti-, Co- and Ni-based catalyst systems the polymerization has to be shortstopped at a specific monomer conversion in order to avoid the formation of gel."
                            },
                            {
                                "example_id": "9f75d293-8b49-4aa2-81a7-cacbcafb65a2",
                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                "text": "They will be shortstopped in the port for lease by the government, then continue their journey by military train."
                            },
                            {
                                "example_id": "c6ddb31b-70ed-4b4c-9f9c-73cb6da3fe40",
                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                "text": "Although he successfully shortstopped the assault on his two teammates, the enemy soldiers now concentrated their fire directly on him."
                            }
                        ]
                    }
