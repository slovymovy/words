                                        "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                                        "entry_id": "7ec4ca0e-db0a-3f60-9676-13d8a29e6ef4",
                                        "glosses": [
                                            "öffentliche Toilette"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f0037e-035e-4f46-ba5f-579c958cb0fe",
                                                "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                                                "text": "Bereits in der Antike gab es allgemein zugängliche Bedürfnisanstalten."
                                            },
                                            {
                                                "example_id": "04cd03d1-df51-4679-b265-1fe42b2ee52b",
                                                "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                                                "text": "„Dass der Streit zwischen Transaktivisten und traditionellen Frauenrechtlerinnen um die politisch korrekte Kennzeichnung von Bedürfnisanstalten in Frankfurt nun sogar in Gewalttätigkeit mündete, macht es nicht leichter, das Thema ernst zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50fa39aa-cafb-4dc5-9be5-15e4575753ad",
                        "source_entry_id": "c3821638-dd58-3332-9db2-0e408e4dd842",
                        "source_sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                        "source_sense_description": "Édicule public",
                        "target_lang_word": "Pissoir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pissoir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                        "entry_id": "0dbbaca2-ba41-3161-a40b-90c0661eecf0",
                                        "glosses": [
                                            "Toilette für Männer mit Becken zum Urinieren im Stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ad5ecc-9235-4260-ab39-72fcd52f62b8",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Im Pissoir des »Adler« hatte ein Unbekannter an die Wand geschrieben, »der Arbeiter, wo Hindenburg oder Hitler wählt, gehört mein Lebetag gequält«.“"
                                            },
                                            {
                                                "example_id": "7d6b78f7-50e4-4e19-a6b4-ee7caf755aac",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Die ersten öffentlichen Pissoirs wurden errichtet, die Anwohner allerdings protestierten gegen die neuen »Stinkbuden«.“"
                                            },
                                            {
                                                "example_id": "e9e6684a-4ecc-48d3-9e2e-709b427c1443",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Stuff stellt sich im Pissoir an das Becken neben Kalübbe.“"
                                            },
                                            {
                                                "example_id": "431d1441-fb6b-44b7-b621-eef63400543e",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Als zwei Männer hereinkamen, die sich am Pissoir weiter auf italienisch unterhielten, atmete er unwillkürlich ganz flach und rührte sich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
