                ],
                "senses": [
                    {
                        "sense_id": "86f4c0f6-4b82-38d6-96bb-97b7ca5b724c",
                        "entry_id": "32717342-e46d-3724-af07-e70fd4dd18e4",
                        "glosses": [
                            "сотрудник полиции (в Англии, США и некоторых других странах); полицейский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd0b360-3542-4512-86fb-03fb950350e6",
                                "sense_id": "86f4c0f6-4b82-38d6-96bb-97b7ca5b724c",
                                "text": "Двое местных инспекторов нас встретили с маленьким отрядом из четырёх полисменов, и в первом часу ночи мы начали осмотр трёхэтажного большого дома, где изволили ночевать лондонские воры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1fa76e6-7f49-4def-955e-358dee17d6e4",
                        "source_entry_id": "32717342-e46d-3724-af07-e70fd4dd18e4",
                        "source_sense_id": "86f4c0f6-4b82-38d6-96bb-97b7ca5b724c",
                        "target_lang_word": "policeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "policeman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "A police officer, usually a male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24379d2b-dc87-4a27-b67c-5faa85887f3d",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "The policeman who arrests the \"Red\" does not understand the theories the \"Red\" is preaching; if he did, his own position as bodyguard of the monied class might seem less pleasant to him."
                                            },
                                            {
                                                "example_id": "93617855-7138-4600-936c-a7540f86d798",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "a9eac769-d510-4e14-b7b2-c68572a22dc6",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "Still agitated, she watched resentfully as two traffic policemen remounted their motorcycles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a198f39c-877d-3ad4-a59a-3c16d2f990fd",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "A glass rod capped at one end with rubber, used in a chemistry laboratory for gravimetric analysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c613385-770d-313b-b0ba-7c5ea4be5d58",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "Any skipper of the genus Coeliades."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc384f96-4702-332f-821f-cbdf87167c60",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "Synonym of enforcer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14a0e43-fab9-40bc-b033-5cbe8cce97b8",
                                                "sense_id": "bc384f96-4702-332f-821f-cbdf87167c60",
                                                "text": "A team may have a policeman or enforcer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ccfdbd-6442-4515-8a77-b27e5426f4d8",
                        "source_entry_id": "32717342-e46d-3724-af07-e70fd4dd18e4",
                        "source_sense_id": "86f4c0f6-4b82-38d6-96bb-97b7ca5b724c",
                        "target_lang_word": "police",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "A public agency charged with enforcing laws and maintaining public order, usually being granted special privileges to do so, particularly"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69acc8eb-cf4d-4d9d-8c80-029a820f6612",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "There are nine Principles of Police:\n...\n7 To maintain at all times a relationship with the public that gives reality to the historic tradition that the police are the public and that the public are the police; the police being only members of the public who are paid to give full-time attention to duties which are incumbent on every citizen, in the interests of community welfare and existence."
                                            },
                                            {
                                                "example_id": "ef235eab-1fc9-4841-b08e-d8ea96a53b21",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police […]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            },
                                            {
                                                "example_id": "7d440f16-cd14-4341-ad02-6b870eb3c5c7",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "In the criminal justice system, the People are represented by two separate yet equally important groups: the police, who investigate crime, and the district attorneys, who prosecute the offenders."
                                            },
                                            {
                                                "example_id": "92827df2-36d8-4626-a410-34f9bd90dbdd",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "Citadel Security is a volunteer police service answering to the Citadel Council. The 200,000 constables of C-Sec are responsible for maintaining public order in the densely populated Citadel."
                                            },
                                            {
                                                "example_id": "ce19690f-30f1-445d-ade0-37ee93fb2a42",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "The rally on Sunday in Victoria Park, in the Causeway Bay district, was authorized in advance by the police. But protesters were also expected to begin marching later in the day from Sham Shui Po, a working-class neighborhood on the Kowloon peninsula, across the harbor from North Point. The police rejected their application for a permit."
                                            },
                                            {
                                                "example_id": "7c32a76a-1e0e-47a7-8f2c-e749000949f4",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "Call the police!"
                                            },
                                            {
                                                "example_id": "ab7c2b78-7822-490f-a552-7e6f10fe87bf",
                                                "sense_id": "ba766804-fa77-3bb8-900c-95263134eba7",
                                                "text": "There’s only one police in this town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d98c951-7043-3905-b5c2-4e3aaf33d987",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "A public agency charged with enforcing laws and maintaining public order, usually being granted special privileges to do so, particularly",
                                            "A department of local (usually municipal) government responsible for general law enforcement."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "historical",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1168d1a-3022-4fdd-9a1f-130fa1d50692",
                                                "sense_id": "4d98c951-7043-3905-b5c2-4e3aaf33d987",
                                                "text": "The Cook County Sheriff's Department has jurisdiction across most of Chicago but focuses on the unincorporated area and tasks like prisoner transport, leaving the rest to the Chicago Police Department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5c3938-f198-3f96-bdca-50c4b62c98ce",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "A public agency charged with enforcing laws and maintaining public order, usually being granted special privileges to do so, particularly",
                                            "A branch of the Home Office responsible for general law enforcement within a specific territory."
                                        ],
                                        "tags": [
                                            "UK",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b027e03b-0d06-4a12-a2a3-4d0a19d0c643",
                                                "sense_id": "7e5c3938-f198-3f96-bdca-50c4b62c98ce",
                                                "text": "Scotland Yard is, technically speaking, only the metropolitan police for Greater London but because of their importance they have special jurisdiction for some crimes across the United Kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b49d7de9-c198-3cf3-8c84-527a18afb704",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "A public agency charged with enforcing laws and maintaining public order, usually being granted special privileges to do so, particularly",
                                            "Any of the formally enacted law enforcement agencies at various levels of government."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa899de5-99d1-334d-a145-0ab4934cf8a3",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "The staff of such a department or agency, particularly its officers; (regional, chiefly US, Caribbean, Jamaica, Scotland, countable) an individual police officer."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally",
                                            "plural-only",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36ddf65-b7bb-4eda-bf87-e2e9a690e1ad",
                                                "sense_id": "aa899de5-99d1-334d-a145-0ab4934cf8a3",
                                                "text": "Pearlman: Very clever, Lester. You got it all figured, huh?\nFreamon: Me? I'm just a police."
                                            },
                                            {
                                                "example_id": "bbf88611-3f1f-409d-bcc2-3c9263987c8f",
                                                "sense_id": "aa899de5-99d1-334d-a145-0ab4934cf8a3",
                                                "text": "This time it is the worst kind of call a murder police can get."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e749ada8-b839-3fcc-bd75-12a5f99fd770",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "People who try to enforce norms or standards as if granted authority similar to the police."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "ironic",
                                            "mildly",
                                            "plural",
                                            "plural-normally",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be0f0cfb-2ad4-4674-8e0c-bc0bd1e3e428",
                                                "sense_id": "e749ada8-b839-3fcc-bd75-12a5f99fd770",
                                                "text": "Who called the fashion police?"
                                            },
                                            {
                                                "example_id": "4e60fc78-915c-4df8-9ee3-da2c73539851",
                                                "sense_id": "e749ada8-b839-3fcc-bd75-12a5f99fd770",
                                                "text": "Then there were the taste police, who thought that this bulky modern machine was an inappropriate intrusion […]"
                                            },
                                            {
                                                "example_id": "2615a2a4-f920-47e1-a4f5-a34386b5b2d6",
                                                "sense_id": "e749ada8-b839-3fcc-bd75-12a5f99fd770",
                                                "text": "A major drama has broken out in France after the local language police decreed one of their cute little accents to be largely redundant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b872144-4cc1-3ce6-b07d-4caa23002081",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "Cleanup of a military facility, as a formal duty."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02cd093-9d48-4310-b2cc-18d9feeb1383",
                                                "sense_id": "8b872144-4cc1-3ce6-b07d-4caa23002081",
                                                "text": "Q. […] What did you do that day? — A. I was cleaning up around quarters.\nQ. You had been on guard and went on police duty? You were policing, cleaning up around the barracks? — A. Yes, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe5bfa5-4a75-3266-97d1-2a31c0c1e715",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "Synonym of administration, the regulation of a community or society."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4123a33-036c-4cf3-b7e9-3cae2556be6d",
                                                "sense_id": "8fe5bfa5-4a75-3266-97d1-2a31c0c1e715",
                                                "text": "The notion of ‘police’ – that is, rational administration – was seen as a historical force which could bring civilized improvement to societies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c857a8-2574-314c-8b49-33698cc67160",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "Alternative form of policy."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d3373ee-3994-3cd3-8b45-800e26765876",
                                        "entry_id": "9c1987ed-e4c6-3399-a094-8cf797a7d851",
                                        "glosses": [
                                            "Alternative form of polity, civilization, a regulated community."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "police",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae667b80-cc8a-3d53-b3e0-f34bca525e70",
                                        "entry_id": "99c9c352-e0be-3c97-a477-8abd8fdc5d2e",
                                        "glosses": [
                                            "To enforce the law and keep order among (a group)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be9fda95-9162-45c4-8bf3-e647419bfe19",
                                                "sense_id": "ae667b80-cc8a-3d53-b3e0-f34bca525e70",
                                                "text": "Extra security was hired to police the crowd at the big game."
                                            },
                                            {
                                                "example_id": "61c896c8-1806-4f59-a224-a7893fef5770",
                                                "sense_id": "ae667b80-cc8a-3d53-b3e0-f34bca525e70",
                                                "text": "Smith returns in Men In Black 3 as a veteran agent of a secret organization dedicated to policing the earth’s many extraterrestrials."
                                            },
                                            {
                                                "example_id": "2cf35a2a-2bb5-43df-9c75-808ac56c2a00",
                                                "sense_id": "ae667b80-cc8a-3d53-b3e0-f34bca525e70",
                                                "text": "Policing the relationship between government and business in a free society is difficult. Businesspeople have every right to lobby governments, and civil servants to take jobs in the private sector. Governments have to find the best people to fill important jobs: there is a limited supply of people who understand the financial system, for example."
                                            },
                                            {
                                                "example_id": "d85e2dce-4d92-4ea5-9f23-afa1f1c3e9b3",
                                                "sense_id": "ae667b80-cc8a-3d53-b3e0-f34bca525e70",
                                                "text": "Train operators were reluctant to speak to RAIL on the record, but one responded: \"The unions are rightly very clear that they don't want staff policing face coverings after the removal of legal backing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "651b6fd8-ab17-32dc-bcc8-1da580a644be",
                                        "entry_id": "99c9c352-e0be-3c97-a477-8abd8fdc5d2e",
                                        "glosses": [
                                            "To clean up an area."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff23e960-326c-4395-a217-ac671289e9a5",
                                                "sense_id": "651b6fd8-ab17-32dc-bcc8-1da580a644be",
                                                "text": "This comes to him through the company housekeeping, for in the field each organization takes care of itself, cooks its own food, makes its own beds, does its own policing (cleaning up); […]"
                                            },
                                            {
                                                "example_id": "86e47963-6b98-4719-87fd-ceaeef1b5673",
                                                "sense_id": "651b6fd8-ab17-32dc-bcc8-1da580a644be",
                                                "text": "Q. […] What did you do that day? — A. I was cleaning up around quarters.\nQ. You had been on guard and went on police duty? You were policing, cleaning up around the barracks? — A. Yes, sir."
                                            },
                                            {
                                                "example_id": "bcef36c9-f251-4cf1-b0e3-ce27ada65694",
                                                "sense_id": "651b6fd8-ab17-32dc-bcc8-1da580a644be",
                                                "text": "ELIAS: Police up your extra ammo and frags, don't leave nothing for the dinks."
                                            },
                                            {
                                                "example_id": "41fadd99-9c58-4d24-9d52-713f527abd51",
                                                "sense_id": "651b6fd8-ab17-32dc-bcc8-1da580a644be",
                                                "text": "\"Fire off several rounds in a residential building and stop to police the brass?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1239e10a-0114-3e47-ba82-0c7d45fb5df5",
                                        "entry_id": "99c9c352-e0be-3c97-a477-8abd8fdc5d2e",
                                        "glosses": [
                                            "To enforce norms or standards upon."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2360a1-f076-42a4-8a9b-54f3ad9c04da",
                                                "sense_id": "1239e10a-0114-3e47-ba82-0c7d45fb5df5",
                                                "text": "to police a person's identity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
