                                "target_senses": [
                                    {
                                        "sense_id": "336c2b7c-b9e1-32a0-b10b-b83059068608",
                                        "entry_id": "99414877-cec5-346e-b85e-d05297537b8f",
                                        "glosses": [
                                            "An utterance relaying information and likely to be regarded as true or false."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603e2253-fd90-4771-93cc-e0a1684dc434",
                                                "sense_id": "336c2b7c-b9e1-32a0-b10b-b83059068608",
                                                "text": "The distinction between constatives and performatives is one of the distinctions that he starts questioning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb9f4df-5840-3de5-a219-00579eaf5b9f",
                                        "entry_id": "e3039ff4-ff9c-385e-9220-50b0b46736de",
                                        "glosses": [
                                            "Pertaining to an utterance relaying information and likely to be regarded as true or false."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e41cc4bc-0587-46a8-9ffa-c96212fa1d6f",
                                                "sense_id": "3fb9f4df-5840-3de5-a219-00579eaf5b9f",
                                                "text": "Statements are constative utterances."
                                            },
                                            {
                                                "example_id": "f56e7f90-7e0b-4c5b-951e-d20d17ba942c",
                                                "sense_id": "3fb9f4df-5840-3de5-a219-00579eaf5b9f",
                                                "text": "One thing, however, that it will be more dangerous to do, and that we are very prone to do, is to take it that we somehow know that the primary or primitive use of sentences must be, because it ought to be, statemental or constative, in the philosophers' preferred sense of simply uttering something whose sole pretension is to be true or false and which is not liable to criticism in any other dimension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
