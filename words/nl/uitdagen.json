            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cb65c2d-c234-392e-a0fe-9d9b1cba4661",
                    "sense_definition": "Iemand met woorden of daden aanzetten tot een actie of strijd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitdagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smalend <w>daagde</w> hij zijn tegenstander <w>uit</w> tot een partijtje armpjedrukken.",
                            "target_lang_translations": {
                                "en": "He mockingly <w>challenged</w> his opponent to a game of arm wrestling."
                            }
                        },
                        {
                            "text": "Hij kon met een stevige stelling mensen goed <w>uitdagen</w> in een discussie.",
                            "target_lang_translations": {
                                "en": "He was good at <w>challenging</w> people in a discussion with a firm statement."
                            }
                        }
                    ],
                    "synonyms": [
                        "aansporen",
                        "opjutten"
                    ],
                    "common_phrases": [
                        "iemand uitdagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To invite or incite someone to take part in a competition, fight, or difficult task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "challenge",
                                "target_lang_sense_clarification": "To invite someone to take part in a competition or contest."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "788d17f4-7cf3-34d1-a729-d8a2b0f3ce55",
                    "sense_definition": "Provoceren of proberen iemand boos te maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitdagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Daag</w> me nu niet <w>uit</w>!",
                            "target_lang_translations": {
                                "en": "Don't <w>provoke</w> me now!"
                            }
                        },
                        {
                            "text": "Hij bleef maar doorgaan en probeerde haar opzettelijk te <w>uitdagen</w>.",
                            "target_lang_translations": {
                                "en": "He kept going and was intentionally trying to <w>provoke</w> her."
                            }
                        }
                    ],
                    "synonyms": [
                        "provoceren",
                        "tergen"
                    ],
                    "common_phrases": [
                        "niet uitdagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in een emotionele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To provoke someone or deliberately try to make them angry or defensive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "provoke",
                                "target_lang_sense_clarification": "To deliberately incite someone to anger or a reaction."
                            },
                            {
                                "target_lang_word": "dare",
                                "target_lang_sense_clarification": "To challenge someone to do something risky or to test their limits."
                            }
                        ]
                    }
                }
            ]
        }
    ]
