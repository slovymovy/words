{
    "word_family": [
        "возможный",
        "возможно",
        "невозможность",
        "невозможный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f331c03e-e35c-3740-ad5b-5a1c3b4ab62e",
                    "sense_definition": "Условие, обстоятельство или удобный случай, позволяющие сделать что-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня есть <w>возможность</w> поехать в отпуск этим летом.",
                            "target_lang_translations": {
                                "en": "I have the <w>opportunity</w> to go on vacation this summer.",
                                "zh": "今年夏天我有<w>机会</w>去度假。"
                            }
                        },
                        {
                            "text": "Эта новая работа даёт мне <w>возможность</w> учиться и развиваться.",
                            "target_lang_translations": {
                                "en": "This new job gives me the <w>opportunity</w> to learn and develop.",
                                "zh": "这份新工作给了我学习和发展的<w>机会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "шанс",
                        "вариант"
                    ],
                    "antonyms": [
                        "невозможность"
                    ],
                    "common_phrases": [
                        "дать возможность",
                        "иметь возможность",
                        "упустить возможность",
                        "по мере возможности",
                        "получить возможность"
                    ],
                    "target_lang_definitions": {
                        "en": "A set of circumstances that makes it possible to do something; a favorable occasion.",
                        "zh": "指做某事的环境、条件或有利时机。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "opportunity",
                                "target_lang_sense_clarification": "favorable circumstance"
                            },
                            {
                                "target_lang_word": "chance",
                                "target_lang_sense_clarification": "occasion or luck"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "有利的条件或时机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51124797-72f0-3563-b5c6-a6590aad578e",
                    "sense_definition": "Вероятность того, что какое-либо событие может произойти; допустимость чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны учитывать <w>возможность</w> дождя во время пикника.",
                            "target_lang_translations": {
                                "en": "We must consider the <w>possibility</w> of rain during the picnic.",
                                "zh": "我们必须考虑到野餐时下雨的<w>可能性</w>。"
                            }
                        },
                        {
                            "text": "Врачи обсуждали <w>возможность</w> осложнений после сложной операции.",
                            "target_lang_translations": {
                                "en": "The doctors discussed the <w>possibility</w> of complications after the complex surgery.",
                                "zh": "医生们讨论了复杂手术后出现并发症的<w>可能性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вероятность"
                    ],
                    "antonyms": [
                        "невозможность"
                    ],
                    "common_phrases": [
                        "возможность ошибки",
                        "исключить возможность",
                        "рассмотреть возможность",
                        "существует возможность"
                    ],
                    "target_lang_definitions": {
                        "en": "The chance that something might happen or be true.",
                        "zh": "指某事可能发生或存在的概率。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possibility",
                                "target_lang_sense_clarification": "theoretical chance"
                            },
                            {
                                "target_lang_word": "probability",
                                "target_lang_sense_clarification": "likelihood"
                            },
                            {
                                "target_lang_word": "chance",
                                "target_lang_sense_clarification": "likelihood"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能性",
                                "target_lang_sense_clarification": "某事发生的概率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8520261a-4a3f-3995-abe3-05acfd832345",
                    "sense_definition": "Средства, ресурсы или условия, необходимые для осуществления чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наши финансовые <w>возможности</w> ограничены, поэтому мы не купим эту машину.",
                            "target_lang_translations": {
                                "en": "Our financial <w>means</w> are limited, so we won't buy this car.",
                                "zh": "我们的经济<w>能力</w>有限，所以我们不会买这辆车。"
                            }
                        },
                        {
                            "text": "Этот современный компьютер имеет большие технические <w>возможности</w>.",
                            "target_lang_translations": {
                                "en": "This modern computer has great technical <w>capabilities</w>.",
                                "zh": "这台现代电脑具备强大的技术<w>能力</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "финансовые возможности",
                        "технические возможности",
                        "ограниченные возможности",
                        "широкие возможности"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "часто используется во множественном числе"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Financial or technical resources available to achieve something.",
                        "zh": "指实现某事所需的资源、手段或技术条件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "capabilities",
                                "target_lang_sense_clarification": "technical or functional power"
                            },
                            {
                                "target_lang_word": "means",
                                "target_lang_sense_clarification": "financial resources"
                            },
                            {
                                "target_lang_word": "resources",
                                "target_lang_sense_clarification": "available assets"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能力",
                                "target_lang_sense_clarification": "技术或功能上的实力"
                            },
                            {
                                "target_lang_word": "财力",
                                "target_lang_sense_clarification": "经济资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17b87c75-0933-3bd3-9a3c-4eb4b3255b6a",
                    "sense_definition": "Личные способности, таланты или задатки для развития.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик показал свои творческие <w>возможности</w> на школьном конкурсе.",
                            "target_lang_translations": {
                                "en": "The student showed his creative <w>abilities</w> at the school competition.",
                                "zh": "学生在学校比赛中展示了他的创造性<w>才能</w>。"
                            }
                        },
                        {
                            "text": "Тренер верит в скрытые <w>возможности</w> этого молодого спортсмена.",
                            "target_lang_translations": {
                                "en": "The coach believes in the hidden <w>potential</w> of this young athlete.",
                                "zh": "教练相信这位年轻运动员身上隐藏的<w>潜能</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "творческие возможности",
                        "раскрыть возможности",
                        "скрытые возможности"
                    ],
                    "target_lang_definitions": {
                        "en": "Natural qualities or talents that can be developed.",
                        "zh": "指个人可以发展的内在天赋或潜能。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "potential",
                                "target_lang_sense_clarification": "latent ability"
                            },
                            {
                                "target_lang_word": "abilities",
                                "target_lang_sense_clarification": "skills or talents"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潜能",
                                "target_lang_sense_clarification": "潜在的能力"
                            },
                            {
                                "target_lang_word": "才能",
                                "target_lang_sense_clarification": "个人的技能或天赋"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}