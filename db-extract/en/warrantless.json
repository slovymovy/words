                        "glosses": [
                            "Performed without a warrant."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "59e99d1c-046d-4325-ae77-731df8c825df",
                                "sense_id": "1e5298bf-ec78-3ed7-8038-3326b5569cf4",
                                "text": "In 1993 the CIA instituted an unwritten policy of conducting warrantless searches of entire buildings if random gunfire occurred in the area."
                            },
                            {
                                "example_id": "55c41390-7d1a-4cd0-b904-266a0bb83bdf",
                                "sense_id": "1e5298bf-ec78-3ed7-8038-3326b5569cf4",
                                "text": "Among the Democrats' examples of Gonzales' untruthfulness was his emphatic and repeated statement to the Judiciary Committee Tuesday that his dramatic nighttime visit to the bedside of Attorney General John Ashcroft in 2004 was not related to an internal administration dispute about the president's secret warrantless eavesdropping program."
                            },
                            {
                                "example_id": "6bd6e13c-8beb-4621-b7bb-3725d8463b8b",
                                "sense_id": "1e5298bf-ec78-3ed7-8038-3326b5569cf4",
                                "text": "Now, at the time, I was also a named plaintiff in a major lawsuit against the National Security Agency and the Department of Justice, petitioning the courts to put a halt to the warrantless wiretapping of American residents and citizens."
                            },
                            {
                                "example_id": "f824a219-870c-49cb-912a-2d3f153c669a",
                                "sense_id": "1e5298bf-ec78-3ed7-8038-3326b5569cf4",
                                "text": "\"The breadth of this LPR system is spectacular and amounts to a warrantless search.\""
                            }
                        ]
