                            {
                                "example_id": "61138934-fc03-4ed4-94b4-d27e4de6f4fd",
                                "sense_id": "3c497255-8d7c-390c-bbd3-1c7b1548d431",
                                "text": "Het Amerikaanse congres heeft de deponering nog niet goedgekeurd. Daar is veel kritiek op omdat personen met een publieke functie niets van waarde mogen aannemen van buitenlandse overheden zonder toestemming van het congres. Ook brengt de goedkeuring door China schijn van belangenverstrengeling met zich mee, zeggen critici."
                            },
                            {
                                "example_id": "c1a23e81-085f-47f7-9313-8aac330e50d4",
                                "sense_id": "3c497255-8d7c-390c-bbd3-1c7b1548d431",
                                "text": "Een klachtprocedure van de Limburgse broers via het Benelux-Merkenbureau tegen de deponering van de naam Moszkowicz door Yehudi werd afgewezen. Volgens het merkenbureau is er geen sprake van enig verwarringsgevaar."
                            }
                        ]
                    }
