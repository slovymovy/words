                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a470d37c-4395-4755-af81-5009166d75cd",
                                "sense_id": "b4bb8f71-701d-37a6-89ad-f99c4eb3e7ce",
                                "text": "Oh, Marilla, it was heartrending. Mr. Phillips made such a beautiful farewell speech beginning, ‘The time has come for us to part.’ It was very affecting. And he had tears in his eyes too, Marilla."
                            },
                            {
                                "example_id": "b8961157-340d-4fce-b907-289557aebf90",
                                "sense_id": "b4bb8f71-701d-37a6-89ad-f99c4eb3e7ce",
                                "text": "She had been named after Aunt Marilla of Green Gables, but Aunt Marilla had died before Rilla was old enough to know her very well, and Rilla detested the name as being horribly old-fashioned and prim."
                            }
                        ]
                    }
