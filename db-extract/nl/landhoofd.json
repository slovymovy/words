                        "cross_references": [
                            {
                                "target_word": "culée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72a2518b-6e89-35e9-99d6-746dfa62c0f2",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Massif de maçonnerie qui soutient, dans leur poussée, les voûtes des dernières arches d’un pont. Élément statique en béton ou en métal, destiné à recevoir l’extrémité du tablier d’un pont ou d’un viaduc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c846ab61-4109-45b8-a05c-9f6fde589c75",
                                                "sense_id": "72a2518b-6e89-35e9-99d6-746dfa62c0f2",
                                                "text": "Bert avait suivi les péripéties de la catastrophe, depuis la séparation des eaux jusqu’à la culée du pont."
                                            },
                                            {
                                                "example_id": "91eee994-6159-458b-b3e2-718b3504c96d",
                                                "sense_id": "72a2518b-6e89-35e9-99d6-746dfa62c0f2",
                                                "text": "[…] des ouvriers et des techniciens consolidaient les culées d’un pont en acier, sous les ordres d’ingénieurs civils allemands arrivés quelques semaines plus tôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8eea23-0da2-3ec5-9c9b-0abc62dc5e28",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Pilier qui soutient les retombées d’un arc-boutant d’une église gothique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d54deab-52a5-38c4-b73f-3a27778c2584",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Rang de pieux pour soutenir les terres."
                                        ],
                                        "tags": [
                                            "Ponts et chaussées"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88feb916-430c-34a9-8a11-fab73471247e",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Partie la plus proche de la queue de l’animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67bb2473-56b7-3581-a67e-da6d832e3db9",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Action de culer, chemin fait par l’arrière; coup que la quille d’un vaisseau donne quelquefois contre le fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e359179d-378a-4e6a-b036-f2a39abc4740",
                                                "sense_id": "67bb2473-56b7-3581-a67e-da6d832e3db9",
                                                "text": "Schouten, en parlant d’un tremblement de terre qui se fit aux îles Moluques, dit que les montagnes furent ébranlées, et que les vaisseaux qui étaient à l’ancre sur trente ou quarante brasses, se tourmentèrent comme s’ils se fussent donné des culées sur le rivage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd02796-bfe6-39dd-b664-4ddf5b0761af",
                                        "entry_id": "603a4bad-2a70-321f-88b2-1b81a4c91a2b",
                                        "glosses": [
                                            "Gros bout de la grume, celui qui a été séparé de la souche."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32ac797-5ca5-4f45-91d9-4fb8aeacacbe",
                                                "sense_id": "3bd02796-bfe6-39dd-b664-4ddf5b0761af",
                                                "text": "Assis bas sur une chauffeuse bancale, les mains en avant, devant l'âtre qui fut celui de Bertine et où brûle encore ce noueux bois de culée qui appartient à l'abatteur et que Jobeau, ahanant, a dû passer des heures à fendre, je n'ai plus qu'à écouter Marthe."
                                            },
                                            {
                                                "example_id": "0dfb169e-d115-4539-a567-48d669729f6d",
                                                "sense_id": "3bd02796-bfe6-39dd-b664-4ddf5b0761af",
                                                "text": "Les cavités, correspondant à la décomposition de l’ancien ensouchement de ces tiges issues de taillis, ne dépassent guère 50 cm de hauteur, même si elles sont particulièrement importantes à la culée."
                                            },
                                            {
                                                "example_id": "92089a66-40d9-455d-96b1-0356be0aaefb",
                                                "sense_id": "3bd02796-bfe6-39dd-b664-4ddf5b0761af",
                                                "text": "Pendant le décours de la lune, les bûcherons s’occupent à déhoupper les arbres, à faire des bourrées, scier les tiges dans les longueurs qu’on les veut, former leurs chantiers de bois de chauffage, et fendre les culées ; en même temps, les scieurs de long et les charpentiers débitent les pièces ainsi coupées et préparées par les bûcherons."
                                            }
                                        ]
                                    }
                                ]
                            },
