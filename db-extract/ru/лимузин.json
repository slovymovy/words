                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0332bb4-0187-44a8-8765-c1a21baebb6f",
                        "source_entry_id": "1d9799f9-e1ff-303f-bf41-a8de851e33a1",
                        "target_lang_word": "Limousine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Limousine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e637ee9b-eaea-3bfd-83f6-ab74a0bdafdf",
                                        "entry_id": "7b0a825d-77c7-399b-859d-d66e633aeec3",
                                        "glosses": [
                                            "im Gegensatz zum Cabrio oder Cabriolet mit einem Dach vollkommen geschlossenes Auto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d4c152-9e9f-4c67-8222-128ce0fc5ac4",
                                                "sense_id": "e637ee9b-eaea-3bfd-83f6-ab74a0bdafdf",
                                                "text": "Ich fahre sehr gerne eine Limousine."
                                            },
                                            {
                                                "example_id": "6d10ce51-bb4f-40cd-badc-09d03889709d",
                                                "sense_id": "e637ee9b-eaea-3bfd-83f6-ab74a0bdafdf",
                                                "text": "Wenn er in die Stadt kommt, fährt er Limousine."
                                            },
                                            {
                                                "example_id": "eb73fa47-d683-4e58-a83b-c3fcfc9d3607",
                                                "sense_id": "e637ee9b-eaea-3bfd-83f6-ab74a0bdafdf",
                                                "text": "„Am Abend des 10. Mai sitzt der 65-Jährige in einer Limousine, die ihn zum Buckingham-Palast bringt, wo ihm König Georg VI. den Auftrag erteilt, eine Regierung zu bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26b04ec0-08d6-3472-8f0d-fa3ef2d7a01e",
                                        "entry_id": "7b0a825d-77c7-399b-859d-d66e633aeec3",
                                        "glosses": [
                                            "Pferdewagen zur Beförderung von Personen, so genannt in der französischen Landschaft Limousin"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9503cd2b-358e-4b16-9e12-62c03fea182b",
                                                "sense_id": "26b04ec0-08d6-3472-8f0d-fa3ef2d7a01e",
                                                "text": "Die Limousine wurde zum Personentransport eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "716c8288-d3c0-39a9-897c-54dd34821fb7",
                                        "entry_id": "7b0a825d-77c7-399b-859d-d66e633aeec3",
                                        "glosses": [
                                            "Fuhrmannsmantel aus Ziegenwolle, der in der französischen Landschaft Limousin benutzt wurde"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9914a7f-79c3-4ebf-9701-165635bf6ad3",
                                                "sense_id": "716c8288-d3c0-39a9-897c-54dd34821fb7",
                                                "text": "Er brauchte bald eine neue Limousine."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                        "entry_id": "7b0a825d-77c7-399b-859d-d66e633aeec3",
                                        "glosses": [
                                            "großes, teures Auto"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f267fa-7ebe-4b1b-808f-5745554a91c4",
                                                "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                                "text": "Zur Hochzeit buchten sie eine Limousine mit abgedunkelten Scheiben und Stander."
                                            },
                                            {
                                                "example_id": "e12827ec-d0c2-43c3-8169-2c89ddbb0ed2",
                                                "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                                "text": "„Einen Tag nachdem der alte Zdenek telefoniert habe, würde er also, eine kleine Tasche unterm Arm, mit dieser Limousine wegfahren.“"
                                            },
                                            {
                                                "example_id": "b3051baf-4df3-441c-9124-84cfaa905f5d",
                                                "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                                "text": "„Ali reparierte ihre Autos, kümmerte sich um die Elektrik, montierte neue Airbags in ihre Limousinen.“"
                                            },
                                            {
                                                "example_id": "0fb7fc1d-bbaa-4c80-83d7-237005101773",
                                                "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                                "text": "„Sobald wir seine schwarze Limousine von Weitem sahen, verdrückten wir uns – wenn dieser Mann Friedel besuchte, waren wir Kinder auch nicht erwünscht.“"
                                            },
                                            {
                                                "example_id": "ca53a2d4-587c-42e8-9651-f7e5504d2010",
                                                "sense_id": "b496bc92-049f-397a-94df-d6763949333c",
                                                "text": "„Niemand ist verdächtiger als eine Person, die aus einer großen Limousine in einen klapprigen Bus umsteigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
