        "fr-extract.jsonl": [
            {
                "entry_id": "98fbb3ef-94b5-3f4d-b5ed-ba20bba85504",
                "word": "prion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd23dcac-7229-4848-a01b-7ddb3109aab4",
                        "entry_id": "98fbb3ef-94b5-3f4d-b5ed-ba20bba85504",
                        "tags": [
                            "plural"
                        ],
                        "form": "prions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd95e032-48bf-33df-bccf-d0afbba954d3",
                        "entry_id": "98fbb3ef-94b5-3f4d-b5ed-ba20bba85504",
                        "glosses": [
                            "Protéine qui existe naturellement dans le cerveau des mammifères mais qui devient infectieuse par une conformation particulière, formant des agrégations et des dépôts et détruisant peu à peu les neurones, provoquant à la longue une mort cérébrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183580ec-2612-4571-8085-b01555c09598",
                                "sense_id": "dd95e032-48bf-33df-bccf-d0afbba954d3",
                                "text": "Le prion est impliqué dans des maladies comme l’encéphalopathie spongiforme bovine ou la maladie de Creutzfeldt-Jakob chez l’être humain."
                            },
                            {
                                "example_id": "95470dd0-2b21-4360-8bda-43f457fa3e35",
                                "sense_id": "dd95e032-48bf-33df-bccf-d0afbba954d3",
                                "text": "Pour ce qu’en savent les chercheurs, les prions anormaux se fixent sur les prions sains situés à la surface des neurones, les déformant à leur tour. Ils pénètrent ensuite dans les neurones et s’accumulent dans des vacuoles qui fusionnent, conduisant à la destruction des cellules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af99a363-6c65-498b-8743-f2f096edaa48",
                        "source_entry_id": "98fbb3ef-94b5-3f4d-b5ed-ba20bba85504",
                        "source_sense_id": "dd95e032-48bf-33df-bccf-d0afbba954d3",
                        "target_lang_word": "Prion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6863d112-a3e0-3c75-b8f8-a6dc1020a9b7",
                                        "entry_id": "cedd9b11-1285-3c36-9017-cff563e569fb",
                                        "glosses": [
                                            "Eiweißstruktur, die im Verdacht steht, Krankheiten auszulösen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd2da80-18da-4e4e-8154-f6ef2773896c",
                                                "sense_id": "6863d112-a3e0-3c75-b8f8-a6dc1020a9b7",
                                                "text": "Von Prionen gibt es natürliche und pathogene Formen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc84baea-6921-49d4-aa31-c13f2f7b8a2e",
                        "source_entry_id": "98fbb3ef-94b5-3f4d-b5ed-ba20bba85504",
                        "source_sense_id": "dd95e032-48bf-33df-bccf-d0afbba954d3",
                        "target_lang_word": "prion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15ba2e39-96a9-3a47-909d-18c481e2a385",
                                        "entry_id": "706dfd4e-7288-3040-86c6-3a4aba5d3962",
                                        "glosses": [
                                            "A self-propagating misfolded conformer of a protein that is responsible for a number of diseases that affect the brain and other neural tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae12850f-bdab-4e13-9823-e3ceef74fa6f",
                                                "sense_id": "15ba2e39-96a9-3a47-909d-18c481e2a385",
                                                "text": "Prions retain deep mysteries, the foremost of which is what on earth they exist for."
                                            },
                                            {
                                                "example_id": "2255ad56-9e63-4be7-bb31-b0f25293837a",
                                                "sense_id": "15ba2e39-96a9-3a47-909d-18c481e2a385",
                                                "text": "Five public research institutions in France have imposed a 3-month moratorium on the study of prions—a class of misfolding, infectious proteins that cause fatal brain diseases—after a retired lab worker who handled prions in the past was diagnosed with Creutzfeldt-Jakob disease (CJD), the most common prion disease in humans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prion",
                                "target_lang_code": "en",
                                "target_senses": [
