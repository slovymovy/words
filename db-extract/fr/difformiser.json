                "senses": [
                    {
                        "sense_id": "80ce3f0d-d31a-321f-a849-9ceb8236c449",
                        "entry_id": "0361929b-2ea5-3571-b21e-b39dd0594656",
                        "glosses": [
                            "Rendre difforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e764598-c2e1-4634-aa52-ed3f53fc321a",
                                "sense_id": "80ce3f0d-d31a-321f-a849-9ceb8236c449",
                                "text": "De fait, « barrière de contact » de la société en « effroi » face à ce qui dépare, dérive, diffère, « difformise», l’intervenant social se voit imaginairement institué garant ou restaurateur des tabous fondateurs ;"
                            },
                            {
                                "example_id": "ceaff9a8-f9dc-4fca-ada5-a6c6a4849b1e",
                                "sense_id": "80ce3f0d-d31a-321f-a849-9ceb8236c449",
                                "text": "Je confirme : elle ne te difformise pas du tout (j'invente des mots si je veux!)."
                            },
                            {
                                "example_id": "81b35929-a6f8-4c5e-8417-b87cebd5a777",
                                "sense_id": "80ce3f0d-d31a-321f-a849-9ceb8236c449",
                                "text": "Les buds commencent à bien brunir, les feuilles tournent pourpre violet, les fleurs se difformisent !!"
                            }
                        ]
                    }
