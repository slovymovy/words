            "senses": [
                {
                    "sense_id": "67a4b51f-ae97-3e79-8150-356d672ae467",
                    "sense_definition": "Personne inattentive ou fréquemment absorbée par ses pensées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un grand <w>distrait</w> qui égare régulièrement son téléphone et ses clés dans la maison."
                        },
                        {
                            "text": "Ce pauvre <w>distrait</w> s'est trompé d'étage et a essayé d'ouvrir la porte de son voisin."
                        }
                    ],
                    "synonyms": [
