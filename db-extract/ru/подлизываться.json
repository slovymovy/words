                        "source_entry_id": "3bd85aea-48e5-3e3b-9765-edc6405dc708",
                        "source_sense_id": "5a0211f9-e3e3-3d88-bee6-f0b42326c2b9",
                        "target_lang_word": "ingratiate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingratiate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                        "entry_id": "ae24560d-a67a-37d4-8269-9f908459a353",
                                        "glosses": [
                                            "To bring oneself into favour with someone by flattering or trying to please them; to insinuate oneself; to worm one's way in."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5656fe8-3351-4349-a6c7-77d42b102e7e",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "[H]e considered this offering an homage to his merits, and an attempt on the part of the heiress to ingratiate herself into his priceless affections."
                                            },
                                            {
                                                "example_id": "0e069365-c864-4e1a-9c1f-c93c23b318ad",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "[H]e would pat the children on the head when he saw them on the stairs, and ingratiate himself with them as far as he dared."
                                            },
                                            {
                                                "example_id": "96c9270d-f494-4ed3-8342-e7036f609931",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "Her name was Michaela, but the men called her filthy things in dulcet, ingratiating voices, and she giggled with childish joy because she understood no English and thought they were flattering her and making harmless jokes."
                                            },
                                            {
                                                "example_id": "28cc69bd-398e-4176-8a3c-bd38724e331d",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "And it is symptomatic of the many paradoxes of Lederer's life that of all the people in the room, Brotherhood is the one whom he would most wish to serve, if ever he had the opportunity, even though — or perhaps because — his occasional efforts to ingratiate himself with his adopted hero have met with iron rebuff."
                                            },
                                            {
                                                "example_id": "015307f8-ee89-4626-bd26-2c73413d8d30",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "The Federal Bureau of Investigation (FBI) is trying to crawl out from under its rock and ingratiate itself as an \"equal opportunity employer\" and a friend of progressive movements."
                                            },
                                            {
                                                "example_id": "b0de9c8c-0a83-43f3-b1e5-435c7187c3d1",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "He ingratiated himself with the Kurdish bloc when he stood up to aggressive Turkish rhetoric about the Kurdish border in May."
                                            },
                                            {
                                                "example_id": "38725dab-4880-4f62-be8f-9d5b05eee9c5",
                                                "sense_id": "31f61b8f-03a2-358a-ad56-a687ea2a2eca",
                                                "text": "Like many other executives in Silicon Valley, [Meta CEO Mark] Zuckerberg has recently been ingratiating himself with the Trump administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0ba181-a5d2-371a-ad1f-220a842b1439",
                                        "entry_id": "ae24560d-a67a-37d4-8269-9f908459a353",
                                        "glosses": [
                                            "To recommend; to render easy or agreeable."
                                        ],
                                        "tags": [
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "645a5ddb-e857-4b37-a1e2-142844331ea5",
                                                "sense_id": "ae0ba181-a5d2-371a-ad1f-220a842b1439",
                                                "text": "What difficulty would it [the love of Christ] not ingratiate to us?"
                                            },
                                            {
                                                "example_id": "57a28dd6-8ef4-4161-ad11-c75b537e1f25",
                                                "sense_id": "ae0ba181-a5d2-371a-ad1f-220a842b1439",
                                                "text": "the Sense of this will mightily indear and ingratiate them to us"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d42f414-9903-41cc-8ec6-b8667c9c52b9",
                        "source_entry_id": "3bd85aea-48e5-3e3b-9765-edc6405dc708",
                        "source_sense_id": "5a0211f9-e3e3-3d88-bee6-f0b42326c2b9",
                        "target_lang_word": "suck up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suck up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2bb199-8eb8-3a94-9659-f30d82b5c330",
                                        "entry_id": "9ba6f582-17c6-3e8a-a179-c4b18446444c",
                                        "glosses": [
                                            "To absorb (fluid)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ee15d2-a744-4b3a-a26a-069d16570c5a",
                                                "sense_id": "1b2bb199-8eb8-3a94-9659-f30d82b5c330",
                                                "text": "The dry soil sucked up water like a sponge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c6d2706-1822-3033-9ac0-0d49f0ced6db",
                                        "entry_id": "9ba6f582-17c6-3e8a-a179-c4b18446444c",
                                        "glosses": [
                                            "To adulate or flatter (someone) excessively, generally to obtain some personal benefit or favour."
                                        ],
                                        "tags": [
                                            "often",
                                            "slang",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b606b28-c25c-4f8d-aa65-af7195a42827",
                                                "sense_id": "2c6d2706-1822-3033-9ac0-0d49f0ced6db",
                                                "text": "Jimmy sucked up to the English teacher hoping he would get an A."
                                            },
                                            {
                                                "example_id": "09d63876-37dc-4d16-bae2-e46222143968",
                                                "sense_id": "2c6d2706-1822-3033-9ac0-0d49f0ced6db",
                                                "text": "And in between sips of Coke / He told me that he thought we were sellin' out / Layin' down, suckin' up to the man / Well now I've got some / Advice for you, little buddy / Before you point the finger / You should know that I'm the man / I'm the man and you're the man / And he's the man as well"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7044fd28-406e-33ef-9591-94b21c39f0ed",
                                        "entry_id": "9ba6f582-17c6-3e8a-a179-c4b18446444c",
                                        "glosses": [
                                            "To fellate (someone)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ae0c0f-da43-4c4a-ba5c-a1fc750d1078",
                        "source_entry_id": "3bd85aea-48e5-3e3b-9765-edc6405dc708",
                        "source_sense_id": "5a0211f9-e3e3-3d88-bee6-f0b42326c2b9",
                        "target_lang_word": "sich einschmeicheln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d54a7b8a-3d74-46c6-8584-9c92adf0999f",
                        "source_entry_id": "3bd85aea-48e5-3e3b-9765-edc6405dc708",
                        "source_sense_id": "5a0211f9-e3e3-3d88-bee6-f0b42326c2b9",
                        "target_lang_word": "lécher les bottes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lécher les bottes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                        "entry_id": "862a16cd-45e7-375d-815e-77cb23ac5e18",
                                        "glosses": [
                                            "Flatter servilement."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060f24c6-9652-41b6-93aa-b48bcc6d4fbb",
                                                "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                                "text": "Ces polissons de mobiles et de francs-tireurs — juste les gens que haïssaient le plus les Prussiens — avaient bien besoin vraiment de venir faire leurs farces dans un pays raisonnable où on ne demandait, en somme, qu’à lécher les bottes allemandes !"
                                            },
                                            {
                                                "example_id": "dc79e191-cbde-4167-9bf9-5204f1f9c8b0",
                                                "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                                "text": "Il est inutile de respecter les vivants, à moins qu'ils ne soient les plus forts. Dans ce cas, l’expérience conseille plutôt de lécher leurs bottes, fussent-elles merdeuses. Mais les morts doivent toujours être respectés."
                                            },
                                            {
                                                "example_id": "2158fc0b-69ee-49c8-83cc-aed9522729e0",
                                                "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                                "text": "On ne laissera pas plus gazouiller mes rossignols littéraires qu’on ne laissera aboyer mes colères politiques. J’ai engagé la lutte, le rire aux dents. Il faudra que ces dents s’allongent, ou que je me les laisse arracher, que je demande grâce, et que j’aille leur lécher les bottes."
                                            },
                                            {
                                                "example_id": "cd9dddde-7c63-4e05-9c40-3e0c8f0ec9a5",
                                                "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                                "text": "Pour troubler à nouveau le pays, pour salir notre armée, il fallait donc susciter un nouveau laquais du capitalisme, un homme qui léchât les bottes des juifs et proclamât l’innocence de Dreyfus. Qui donc va recueillir la succession de Zola ?"
                                            },
                                            {
                                                "example_id": "ecb29cb5-d72b-4fc8-af1b-548ac594b6f2",
                                                "sense_id": "e719e7c5-ff4e-3887-ad44-81a39069f337",
                                                "text": "Pour le député fédéral belge Laurent Louis , il est pratiquement impossible de développer un projet humanitaire au Congo sans lécher les bottes de Kabila."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff455d27-f8f8-4cb9-8371-10c25cd370ac",
                        "source_entry_id": "3bd85aea-48e5-3e3b-9765-edc6405dc708",
                        "source_sense_id": "5a0211f9-e3e3-3d88-bee6-f0b42326c2b9",
                        "target_lang_word": "faire de la lèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faire de la lèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a89b8c71-37f7-3dbe-86d0-cbac3d60211e",
                                        "entry_id": "4b556061-cf33-3f32-9303-faab3734cdad",
                                        "glosses": [
                                            "Flatter."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a97b5a7-2587-424a-af5c-68acbe4e7564",
                                                "sense_id": "a89b8c71-37f7-3dbe-86d0-cbac3d60211e",
                                                "text": "Tu fais de la lèche à ma secrétaire pour avoir une augmentation, pas vrai ?"
                                            },
                                            {
                                                "example_id": "9d5436fe-3b49-4387-8d00-67b13a281347",
                                                "sense_id": "a89b8c71-37f7-3dbe-86d0-cbac3d60211e",
                                                "text": "Hélas, les signes de faux respect abondent. Par exemple, la tendance à faire de la lèche aux supérieurs et d’enfoncer les subalternes est assez répandue."
                                            },
                                            {
                                                "example_id": "fa56e048-8d07-4d66-932d-ad717390e266",
                                                "sense_id": "a89b8c71-37f7-3dbe-86d0-cbac3d60211e",
                                                "text": "Elle n’aurait peut-être pas à faire de la lèche à quelqu’un comme moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
