                ],
                "senses": [
                    {
                        "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                        "entry_id": "03e39e9b-deff-3a23-904d-47e175087846",
                        "glosses": [
                            "Konzentration des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5087fd-244d-432e-8422-cecfc0a2a653",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Das Ding soll sich voller Spucke ziehen, um den Melaninspiegel zu testen und Dutzende andere spuckeverwandte Stoffe, von denen ich nicht weiß, dass sie mich ausmachen oder ich sie.“"
                            },
                            {
                                "example_id": "b94e5104-dbda-441c-8229-7b2234e3cf85",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Afroamerikaner, die tendenziell eine dunklere Haut haben, bei der höhere Melaninspiegel die UV-Strahlen einschränken, die die Vitamin D-Produktion fördern, und ältere Menschen, sowie Übergewichtigen.“"
                            },
                            {
                                "example_id": "212238ab-99e1-4190-830d-5ca215612c1c",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Den Melaninspiegel meiner Haut betrachtet sie hier in einem biologischen und in einem symbolischen Sinn.“"
                            },
                            {
                                "example_id": "e2310237-2ad9-435f-a37f-344bafd09a45",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Und trägt eine weiße Haut wirklich die Spuren dessen, was andere Individuen mit dem gleichen Melaninspiegel in der Vergangenheit getan haben?“"
                            },
                            {
                                "example_id": "630a8d5f-f631-4484-ae03-8c7483859f3c",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Tatsächlich weisen diese dunklen Augenfärbungen auf einen hohen Melaninspiegel im Körper hin.“"
                            },
                            {
                                "example_id": "af68356d-abf3-4abc-ac91-93afb133b477",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Der Melaninspiegel des Menschen wird genetisch kontrolliert, das heißt Unterschiede werden durch wenige Gene bestimmt.“"
                            },
                            {
                                "example_id": "3726bf01-8927-4c8d-98be-94ea8dcd58cf",
                                "sense_id": "e7ece98a-a4d6-3a96-8a21-eebfeaf9b55e",
                                "text": "„Eine genetische Mutation und ein niedriger Melaninspiegel seien verantwortlich für die Fellfarbe des Tieres, heißt es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
