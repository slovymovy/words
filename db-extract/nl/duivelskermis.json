                        ],
                        "examples": [
                            {
                                "example_id": "a7eaa996-68a5-4524-a508-da96de196f8e",
                                "sense_id": "c674eb1e-1e0f-34f9-be01-ac8f1b485161",
                                "text": "Schwinger was een wiskundekanon, die met behulp van een gigantische machinerie kon beschrijven hoe elektronen en fotonen botsen. Een duivelskermis van een apparaat, het wiskundig equivalent van een beeld van Tinguely."
                            }
                        ]
                    },
                    {
