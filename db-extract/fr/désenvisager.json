                "senses": [
                    {
                        "sense_id": "50e21697-3056-33a7-ac68-8e7390bfb8e1",
                        "entry_id": "00d97798-2bf7-3f63-b4e1-9448466c550c",
                        "glosses": [
                            "Ne plus envisager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8feafd6e-90c7-4b4c-8863-5ea25a87ecd8",
                                "sense_id": "50e21697-3056-33a7-ac68-8e7390bfb8e1",
                                "text": "Il pense tout le temps, mesure, compare, arpente, envisage, désenvisage, pèse (le pour, le contre, l'entre-deux)."
                            },
                            {
                                "example_id": "223abdcd-1fdf-4d0a-a317-101a19fb48b9",
                                "sense_id": "50e21697-3056-33a7-ac68-8e7390bfb8e1",
                                "text": "C'est d'ailleurs pour ça que je ne désenvisage pas de m'équiper en 50 chez eux, CQFD."
                            },
                            {
                                "example_id": "82277eba-3eb8-4a8b-b58f-e1e4e403a77b",
                                "sense_id": "50e21697-3056-33a7-ac68-8e7390bfb8e1",
                                "text": "Je souhaitais partager un avis sur un sujet qui en intéresse sûrement plus d'un, et moi notamment, car je ne désenvisage pas d'y avoir recours le cas échéant."
                            }
                        ]
                    }
