                ],
                "translations": [
                    {
                        "translation_id": "1008f46e-b9ba-4762-874f-376e7328555c",
                        "source_entry_id": "28119ab0-be9c-398e-a38c-3478a6137e4f",
                        "source_sense_id": "e70599c0-1f14-3ae5-a086-26e2e248f47c",
                        "target_lang_word": "Hugh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hugh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                        "entry_id": "e4475492-d2e7-38ff-ba9a-f84f5132fc53",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdea651-ac92-44a3-a936-4a7d5ca345e6",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "I will rather trust a Fleming with my butter, Parson Hugh the Welshman with my cheese, an Irishman with my aqua-vitae bottle, or a thief to walk my ambling gelding, than my wife with herself."
                                            },
                                            {
                                                "example_id": "635a895a-0829-4aba-879f-dbea61188c10",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "Cold's the wind, and wet's the rain, / Saint Hugh be our good speed. / Ill is the weather that bringeth no gain, / Nor helps good hearts in need."
                                            },
                                            {
                                                "example_id": "cd2b701e-cd27-41b9-86e0-fd0722d95f80",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "\"You are engaged to Mr. Harden, I suppose?\" \"Yes, Mr. Harden. I call him Hugh, his second name. I like the name of Hugh. The exquisite long vowel pleases me―Hugh! Hugh!\"."
                                            },
                                            {
                                                "example_id": "9d97fbcc-4d1a-4990-b26e-8b52b77cea5b",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "Hugh McAnally was universally known as \"Wee Shug\". He didn't know why people called Hugh always ended up nicknamed Shug."
                                            },
                                            {
                                                "example_id": "496036a1-651b-474a-9784-cacb67e44c07",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "What I had noticed all of my young life, from as early as five years old, was that very few people outside my family knew how to pronounce my name―or spell it. \"Hue, Hug, Huge, Huh, Hugo. Everything but my name, HUGH!\" - - - I grew up thinking that I was the only Hugh in the world, and all my life I'll be meeting people who will have trouble pronouncing my name."
                                            },
                                            {
                                                "example_id": "021e96ab-94a4-4c8b-9319-837307617257",
                                                "sense_id": "69b64da6-22d5-3294-8f04-233166699076",
                                                "text": "\"To be frank, at first I thought it was a joke,\" Hugh Hurwitz, who served as acting director of the BOP between May 2018 and August 2019, told the BBC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "297a9208-381b-36af-a917-d5e74d68f958",
                                        "entry_id": "e4475492-d2e7-38ff-ba9a-f84f5132fc53",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
