                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eff19d4-775e-46ab-9416-e0395e547f96",
                                                "sense_id": "64ec2203-a236-3499-a5f7-a0f0746d2382",
                                                "text": "„So hat die AG Korpus in der ersten und zweiten Amtsperiode von 2006 bis 2016 in rund 960 Erhebungen 510 Fallbeispiele untersucht.“"
                                            },
                                            {
                                                "example_id": "e1dcb23b-46b4-4bcb-9a4a-67c39ef37b43",
                                                "sense_id": "64ec2203-a236-3499-a5f7-a0f0746d2382",
                                                "text": "„So kam es, dass ich das Klavierspielen begann und in der Schule – meine erste und einzige AG – einen Buchbinderei-Kurs besuchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ea684060-eb55-3754-b53c-1800657b8424",
                                        "entry_id": "c33cb712-1057-39f4-973f-c71df316cf10",
                                        "glosses": [
                                            "Die offizielle Abkürzung von Aargau lautet AG."
                                        ],
