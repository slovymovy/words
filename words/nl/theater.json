                    "frequency": "High",
                    "semantic_group_id": "gebouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij gaan graag samen naar het <w>theater</w> om een nieuwe musical te bekijken.",
                            "target_lang_translations": {
                                "en": "We like going to the <w>theater</w> together to see a new musical.",
                                "ru": "Мы любим вместе ходить в <w>театр</w>, чтобы посмотреть новый мюзикл."
                            }
                        },
                        {
                            "text": "Het oude <w>theater</w> in het centrum van de stad wordt dit jaar volledig gerenoveerd.",
                            "target_lang_translations": {
                                "en": "The old <w>theater</w> in the city center is being completely renovated this year.",
                                "ru": "Старый <w>театр</w> в центре города в этом году будет полностью отремонтирован."
                            }
                        }
                    ],
                    "synonyms": [
                        "schouwburg"
                    ],
                    "common_phrases": [
                        "naar het theater",
                        "modern theater",
                        "klein theater"
                    ],
                    "target_lang_definitions": {
