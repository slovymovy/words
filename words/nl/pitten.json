{
    "word_family": [
        "pit",
        "pitter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e5bafd6-59b0-396a-aa8f-f5bbd527dd29",
                    "sense_definition": "slapen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga nu lekker <w>pitten</w> want ik ben erg moe.",
                            "target_lang_translations": {
                                "de": "Ich gehe jetzt schön <w>pennen</w>, weil ich sehr müde bin."
                            }
                        },
                        {
                            "text": "Hij ligt al uren te <w>pitten</w> op de bank.",
                            "target_lang_translations": {
                                "de": "Er liegt schon seit Stunden auf dem Sofa und <w>pennt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slapen",
                        "maffen",
                        "tukken"
                    ],
                    "common_phrases": [
                        "lekker pitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "schlafen (umgangssprachlich)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "pennen",
                                "target_lang_sense_clarification": "sehr umgangssprachlich für schlafen"
                            },
                            {
                                "target_lang_word": "schlafen",
                                "target_lang_sense_clarification": "neutraler Begriff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3599e835-251f-35c7-a945-dca38d517c3e",
                    "sense_definition": "het verwijderen van de pitten uit vruchten of de ogen uit aardappelen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de kersen eerst <w>pitten</w> voordat je ze in de taart doet.",
                            "target_lang_translations": {
                                "de": "Du musst die Kirschen erst <w>entkernen</w>, bevor du sie in den Kuchen tust."
                            }
                        },
                        {
                            "text": "Een patiënt hoeft als voorschrift de aardappels te schuieren en te <w>pitten</w> en dan met schil en al op te eten.",
                            "target_lang_translations": {
                                "de": "Ein Patient muss laut Vorschrift die Kartoffeln abbürsten und <w>ausstechen</w> und dann mit Schale essen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Kerne aus Früchten entfernen oder Augen aus Kartoffeln herausschneiden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "entkernen",
                                "target_lang_sense_clarification": "Kerne aus Obst entfernen"
                            },
                            {
                                "target_lang_word": "ausstechen",
                                "target_lang_sense_clarification": "Augen aus Kartoffeln entfernen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e207bdfb-03a9-3423-b620-48c31da14eb7",
                    "sense_definition": "tijdens een autorace de pitstraat inrijden voor onderhoud of brandstof",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de eerste paar rondes had ik het heel moeilijk op de medium banden. Dus toen besloten we te <w>pitten</w> en over te stappen op harde banden.",
                            "target_lang_translations": {
                                "de": "In den ersten paar Runden hatte ich es sehr schwer auf den Medium-Reifen. Also entschieden wir uns, <w>an die Box zu kommen</w> und auf harte Reifen zu wechseln."
                            }
                        },
                        {
                            "text": "Hij had het er op gewaagd om het geheele traject zonder een enkele maal te <w>pitten</w> uit te rijden, teneinde daarmede tijd te besparen.",
                            "target_lang_translations": {
                                "de": "Er hatte es gewagt, die gesamte Strecke ohne einen einzigen <w>Boxenstopp</w> durchzufahren, um damit Zeit zu sparen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tijdens de race pitten"
                    ],
                    "target_lang_definitions": {
                        "de": "bei einem Autorennen in die Boxengasse fahren"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "an die Box kommen",
                                "target_lang_sense_clarification": "Standardbegriff im Motorsport"
                            },
                            {
                                "target_lang_word": "einen Boxenstopp machen",
                                "target_lang_sense_clarification": "den Stopp in der Boxengasse durchführen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00a2303b-492f-33e3-8708-7db04d99a764",
                    "sense_definition": "wild dansen op harde muziek waarbij men tegen anderen aanbotst",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vooraan bij het podium was het de hele tijd keihard <w>pitten</w> en crowdsurfen.",
                            "target_lang_translations": {
                                "de": "Vorne an der Bühne wurde die ganze Zeit hart <w>gepogt</w> und Crowdsurfing betrieben."
                            }
                        },
                        {
                            "text": "De fans begonnen te <w>pitten</w> zodra de band het eerste nummer inzette.",
                            "target_lang_translations": {
                                "de": "Die Fans fingen an zu <w>pogen</w>, sobald die Band das erste Lied anstimmte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keihard pitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gebruikt in de context van concerten"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "wild zu harter Musik tanzen (Moshpit)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "pogen",
                                "target_lang_sense_clarification": "wilder Tanz bei Konzerten"
                            },
                            {
                                "target_lang_word": "im Moshpit tanzen",
                                "target_lang_sense_clarification": "sich im Bereich vor der Bühne bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c81b409b-497c-3261-a20c-da5c34075f49",
                    "sense_definition": "in de grond stoppen of inkuilen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer ging de zaden in de koude grond <w>pitten</w> voor de winter.",
                            "target_lang_translations": {
                                "de": "Der Bauer wollte die Samen für den Winter in die kalte Erde <w>eingraben</w>."
                            }
                        },
                        {
                            "text": "Men moet de planten zorgvuldig <w>pitten</w> om ze tegen de vorst te beschermen.",
                            "target_lang_translations": {
                                "de": "Man muss die Pflanzen sorgfältig <w>einpflanzen</w>, um sie vor dem Frost zu schützen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verouderd of regionaal gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "in die Erde pflanzen oder eingraben"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einpflanzen",
                                "target_lang_sense_clarification": "allgemein für in die Erde setzen"
                            },
                            {
                                "target_lang_word": "eingraben",
                                "target_lang_sense_clarification": "in die Erde einbringen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4029791f-4f72-331f-912d-a1ca3ae56c05",
                    "sense_definition": "meervoud van <w>pit</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verwijder alle <w>pitten</w> uit de appel voordat je hem aan het kind geeft.",
                            "target_lang_translations": {
                                "de": "Entferne alle <w>Kerne</w> aus dem Apfel, bevor du ihn dem Kind gibst."
                            }
                        },
                        {
                            "text": "De <w>pitten</w> van deze vrucht zijn erg hard.",
                            "target_lang_translations": {
                                "de": "Die <w>Kerne</w> dieser Frucht sind sehr hart."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural von Kern oder Samen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kerne",
                                "target_lang_sense_clarification": "Plural von Kern"
                            },
                            {
                                "target_lang_word": "Samen",
                                "target_lang_sense_clarification": "Plural von Same"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}