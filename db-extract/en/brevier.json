                    },
                    {
                        "translation_id": "1fcb5cde-8c30-4ef7-8870-26b8bbe92b04",
                        "source_entry_id": "d08adabe-667f-3ab1-ab22-ade899e05d90",
                        "source_sense_id": "24e61283-bc99-3c56-b72f-12fa4354105d",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Jungfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jungfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                        "entry_id": "03a5a66e-a998-333f-99ca-c9e0663257a7",
                                        "glosses": [
                                            "eine junge, unverheiratete Frau, Jungfrau"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb7e310-ce07-4306-afd9-c84c3d3990c2",
                                                "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                                "text": "„‚Ach, wem gehört der schöne Wald?‘ ‚Der gehört dem König Drosselbart; hättst du‘n genommen, so wär er dein.‘ ‚Ich arme Jungfer zart, ach, hätt ich genommen den König Drosselbart!‘ “"
                                            },
                                            {
                                                "example_id": "8bba1817-1eaf-4851-b0d4-86f68a3ad177",
                                                "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                                "text": "„Er wurde verlegen, als habe er eine Jungfer zur Leichtfertigkeit überredet.“"
                                            },
                                            {
                                                "example_id": "ca64ad15-c085-400f-b0bd-6fb3873a8da7",
                                                "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                                "text": "„Als ihr Vater starb, war sie dreißig - eine alte Jungfer, die sich nach Liebe sehnte.“"
                                            },
                                            {
                                                "example_id": "c267b6b3-1dbf-4c3c-bb0b-0e49c3300e20",
                                                "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                                "text": "„Die süße kleine Nelly zeigte ihm manchmal die Krallen, wenn er sie zu toll drückte, denn sie war noch eine Jungfer.“"
                                            },
                                            {
                                                "example_id": "f01567ca-9e20-4c00-9f17-8e100c1d6e80",
                                                "sense_id": "3c7fa88d-cc8b-3e01-8a6b-3170e82f073a",
                                                "text": "„Fräulein Trautmann ist gewiß eine herzensgute Seele, doch, mit Verlaub, als späte und knöcherne Jungfer spukhäßlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c630e63-b484-3996-a3d4-affc0a9e6815",
                                        "entry_id": "03a5a66e-a998-333f-99ca-c9e0663257a7",
                                        "glosses": [
                                            "sich durch unbefruchtete Eier mit der Jungfernzeugung vermehrende Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae02dce-7479-4130-a360-36feeb70cb44",
                                                "sense_id": "0c630e63-b484-3996-a3d4-affc0a9e6815",
                                                "text": "Bisher nachgewiesen wurde die Jungfernzeugung, die auf natürliche Weise zu voll entwickelten Organismen führt, bei vielen Tierarten, unter anderem bei Echsen, und führt zu Jungfern, wie zum Beispiel das beim australischen Gecko Heteronotia binoei, dem Komodowaran und dem Jungferngecko der Fall ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
