                        "examples": [
                            {
                                "example_id": "5d764f0f-a226-4c13-bfb8-d4969648fde1",
                                "sense_id": "85ae6334-8bee-3780-87c0-d9097140549e",
                                "text": "Nach dem frühen Tod seiner ersten Frau hält Kanoffski diesmal nicht in Freiburg Brautschau, sondern verehelicht sich 1639 in Straßburg mit Maria Salome Wetzlerin von Marsilien."
                            },
                            {
                                "example_id": "4cbf6d5e-3bbf-4be6-b91c-790ef7837544",
                                "sense_id": "85ae6334-8bee-3780-87c0-d9097140549e",
                                "text": "Marsilie soll deshalb mit einer Übermacht die Nachhut des abziehenden fränkischen Heeres überfallen; Ganelon will dafür sorgen, dass Roland ihr Befehlshaber ist."
                            }
                        ]
                    }
