                    {
                        "sense_id": "1fd522cf-3c72-366d-a778-c3c146aa1618",
                        "entry_id": "9fd57257-5584-3d97-9211-0b55a509f5b4",
                        "glosses": [
                            "To remove a glove or gloves (from)."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a9aab4d-315f-47a5-acef-db5eaafb7d5b",
                                "sense_id": "1fd522cf-3c72-366d-a778-c3c146aa1618",
                                "text": "undated, John Keats, Sonnet to a Lady seen for a Few Moments at Vauxhall\nLong hours have to and fro let creep the sand, / Since I was tangled in thy beauty's web, / And snared by the ungloving of thine hand."
                            },
                            {
                                "example_id": "3ccce18d-2a95-46fb-ad97-20cb3403ae48",
                                "sense_id": "1fd522cf-3c72-366d-a778-c3c146aa1618",
                                "text": "If ladies go from the ball-room to the supper-room for half an hour, they are not expected to unglove...But, if the supper be final, and close the evening's entertainment, they may unglove, if they please."
                            },
                            {
                                "example_id": "e31f20f0-85e0-4364-b23b-f44cf9ecec10",
                                "sense_id": "1fd522cf-3c72-366d-a778-c3c146aa1618",
                                "text": "Formerly, strict etiquette demanded that a person should unglove the hand before offering it to another in friendly greeting."
                            },
                            {
                                "example_id": "00351375-afca-4aa7-adf5-c88d94217781",
                                "sense_id": "1fd522cf-3c72-366d-a778-c3c146aa1618",
                                "text": "A simple way to remember how to unglove safely is “glove to glove, skin to skin.”"
                            }
                        ]
                    }
                ],
