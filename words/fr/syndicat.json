                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'immeuble est géré par un <w>syndicat</w> de copropriété réuni une fois par an."
                        },
                        {
                            "text": "Les exploitants locaux ont créé un <w>syndicat</w> agricole pour mutualiser l'achat du matériel."
                        }
                    ],
                    "common_phrases": [
