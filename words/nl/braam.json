                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>braam</w> de randen van het metaal om ze glad te maken.",
                            "target_lang_translations": {
                                "en": "I <w>deburr</w> the edges of the metal to make them smooth."
