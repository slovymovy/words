                ],
                "senses": [
                    {
                        "sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                        "entry_id": "0aae817e-00e4-3211-8a95-472ac665b276",
                        "glosses": [
                            "het ter hand nemen van iets nieuws"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88fa35b-dc46-42a4-a649-b11ab640a715",
                                "sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                                "text": "Initiatieven voor ecotoerisme op de Malediven bestaan, maar zijn een druppel op de gloeiende plaat."
                            },
                            {
                                "example_id": "489c29c4-60a2-4bea-aa94-0b35c88352ae",
                                "sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                                "text": ",,We hechten als CDA zeker aan de christelijke tradities’’, zei fractieleider Dirk Getkate de voorbije week in de raad. ,,Maar voor ons is gespreide verantwoordelijkheid die ook bij partners uit de samenleving ligt, van belang. Daarom gaan wij mee in maatschappelijke initiatieven. Wij ondersteunen wel van harte de bestaande vrijheid om als ondernemer of inwoner hieraan niet mee te doen.’’"
                            },
                            {
                                "example_id": "c61a3eea-cfaf-45a6-8d59-15df7500f133",
                                "sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                                "text": "Ik vind het een geweldig initiatief van je."
                            },
                            {
                                "example_id": "21f3ce4e-c401-46a9-9dd7-6b95b41e02f8",
                                "sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                                "text": "Van het gesprek met Lana had ik wederom geleerd dat initiatief nemen soms heel goed kan uitpakken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15e8ad0e-5e88-4b34-a9c9-cd98e4c453a7",
                        "source_entry_id": "0aae817e-00e4-3211-8a95-472ac665b276",
                        "source_sense_id": "663d2bfb-19fa-3016-ad65-7eae194f5bd4",
                        "source_sense_description": "het ter hand nemen van iets nieuws",
                        "target_lang_word": "Initiative",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Initiative",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                        "entry_id": "06ef3490-6ffc-3ea0-925b-a937090e0d0c",
                                        "glosses": [
                                            "Anstoß zu einer Handlung oder der erste Schritt zu ebendieser Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d2ec1fb-3e6d-4ea7-8da8-bc601ce8cd06",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "„Als Cäsar zugetragen wurde, dass Nachschub für die Germanen unterwegs sein sollte, ergriff er die Initiative und brach mit seinen Legionen auf.“"
                                            },
                                            {
                                                "example_id": "4c624937-fad4-4cce-a655-9b3025d60a5c",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "„Als Kardinal Anton Gruscha die Initiative ergriff, ordnete Franz Joseph I. am 18. April 1896 dem Kultusministerium die Bereitstellung der Geldmittel an; die Grundsteinlegung erfolgte am 10. Oktober 1896 in seiner Anwesenheit.“"
                                            },
                                            {
                                                "example_id": "473b0297-b381-4e01-bcac-425a30f9754a",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "„In der Metropole Berlin gab es ähnliche Veranstaltungen, aber meist auf lokale Initiative von Aktivisten hin.“"
                                            },
                                            {
                                                "example_id": "dd79d613-bb31-413b-be14-2d275365dfa1",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "„Eine kleines Land hatte gegenüber einer Großmacht die Initiative ergriffen und die Welt wissen lassen, daß es sich im Schachspiel der europäischen Machtpolitik nicht als bloßer Bauer mißbrauchen lassen wollte.“"
                                            },
                                            {
                                                "example_id": "ed60f43d-5be3-4d67-8b40-55820edc95ed",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "Wer ergreift die Initiative?"
                                            },
                                            {
                                                "example_id": "ef30f232-ec42-4f57-a660-76570f057961",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "[Die Ukraine dürfte] „zu Beginn des Jahres die strategische Initiative ergreifen und diese nutzen, um im Januar und Februar, wenn der Boden gefroren ist, weitere Gegenangriffe gegen die russischen Besatzer zu starten.“"
                                            },
                                            {
                                                "example_id": "31cc9a52-4340-4f49-bfda-85667a7be34e",
                                                "sense_id": "fcd870d4-257f-3a2b-933d-ad978c5cc54b",
                                                "text": "„Die Initiative auf dem Schlachtfeld ist vollständig auf die russische Armee übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddd1e575-a6af-31c7-a95f-152398362918",
                                        "entry_id": "06ef3490-6ffc-3ea0-925b-a937090e0d0c",
                                        "glosses": [
                                            "Fähigkeit, selbstständig zu handeln und Entscheidungen zu treffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5395acef-f288-457a-8ed9-8fd7f0cfa032",
                                                "sense_id": "ddd1e575-a6af-31c7-a95f-152398362918",
                                                "text": "Nun zeigen Sie mal Initiative! Machen Sie mal einen Vorentwurf und präsentieren Sie den dann morgen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9bd7e87-a636-32c4-9c8b-b227daf12dda",
                                        "entry_id": "06ef3490-6ffc-3ea0-925b-a937090e0d0c",
                                        "glosses": [
                                            "Interessengemeinschaft, Arbeitskreis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7842c57-1638-4901-a64c-ce401ef7ed08",
                                                "sense_id": "e9bd7e87-a636-32c4-9c8b-b227daf12dda",
                                                "text": "Die Initiative hat zu einem Informationsabend geladen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
