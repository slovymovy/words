                ],
                "senses": [
                    {
                        "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                        "entry_id": "d9b08655-1707-3bae-8974-a1fc7a467131",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857c1c06-a8fc-4353-9722-a8b3ef133a5e",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Frau Ullreich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0394c2f1-3f43-4fe5-8ac7-65590ef56608",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Herr Ullreich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec617931-aff2-43c8-bf20-a3021f5b4ec7",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Die Ullreichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "70f850e9-8592-42a2-8efd-aa7e8a1549db",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Der Ullreich trägt nie die Schals, die die Ullreich ihm strickt."
                            },
                            {
                                "example_id": "16354746-89bc-4563-bf43-b9712b30c56c",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ullreich kommt, geht der Herr Ullreich.“"
                            },
                            {
                                "example_id": "5794d79c-d7e4-4199-8712-4051c70332a5",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Ullreich kommt und geht."
                            },
                            {
                                "example_id": "feb3a849-f22a-48a1-b426-6d071f68cdb0",
                                "sense_id": "b1b52dfb-9c5e-3b45-8310-64020f49040d",
                                "text": "Ullreichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
