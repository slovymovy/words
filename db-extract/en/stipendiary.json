                        "glosses": [
                            "One who receives a stipend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be83900d-efc9-4a14-97b5-65b752f4c864",
                                "sense_id": "ce8446d1-a6ef-32a1-b5a3-5debf5b17f10",
                                "text": "Delhi, the capital of the Great Mogul, fell into the hands of the English, and the emperor himself became a stipendiary of a company of merchants."
                            },
                            {
                                "example_id": "c02773f1-09fa-492a-a29d-b50aaa81b5a1",
                                "sense_id": "ce8446d1-a6ef-32a1-b5a3-5debf5b17f10",
                                "text": "I confess I have stipendiaries; they are the poor of Christ's flock; a treasure which I am well used in amassing."
                            }
                        ]
                    }
                ],
