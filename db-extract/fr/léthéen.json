                                        "glosses": [
                                            "Que pertenece o concierne al Lete o Leteo, río del Hades cuyas aguas, en la antigua tradición griega y romana, causan el olvido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d4312c0-6b6f-489b-ad9e-02b3aa954d54",
                                                "sense_id": "fb972c6c-b76a-3d65-a155-c88e4c26eb8c",
                                                "text": "Tú, que tan noche mareas\nsobre las aguas leteas,\n si amas a ti, castiga\n en nuestra triste fatiga\n que en ellas nunca te veas»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
