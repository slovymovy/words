                "senses": [
                    {
                        "sense_id": "d017b654-dde0-395f-a12e-777e314b4782",
                        "entry_id": "85cc8372-3762-3c1b-835c-60b45356e25d",
                        "glosses": [
                            "wechselseitige Übermittlung von Daten zwischen zwei oder mehreren Systemen in vorher festgelegter Form"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "b22d8df4-604c-4793-b3b7-aece1d0fb2f6",
                                "sense_id": "d017b654-dde0-395f-a12e-777e314b4782",
                                "text": "„Der Datenaustausch soll 2018 auf Grundlage von im Jahr 2017 erhobenen Daten beginnen. Voraussetzung ist, dass das Schweizer Parlament zustimmt und der Vertrag ein mögliches Referendum in der Eidgenossenschaft übersteht.“"
                            },
                            {
                                "example_id": "baec2cdf-aeee-4750-860a-46a0933e15ae",
                                "sense_id": "d017b654-dde0-395f-a12e-777e314b4782",
                                "text": "„Tatsächlich gibt es schon eine Reihe von XML-Anwendungen, die speziell für den Business-to-Business-Datenaustausch konzipiert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
