                                                "sense_id": "3b62cbce-f7e2-3883-a12e-ab8167270162",
                                                "text": "Обрезать стропы парашюта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d2a087-0559-3731-b843-2e6216bf29ad",
                                        "entry_id": "5ff6eaa9-beb7-33c1-9361-17355fd67d4a",
                                        "glosses": [
                                            "морск. конец троса, сплетённый в кольцо, которым охватывается груз при подъёме талями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
