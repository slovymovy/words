                "senses": [
                    {
                        "sense_id": "ee1d4ca1-8bea-3fd6-b663-b9c572d771b7",
                        "entry_id": "78b163e4-6da8-37e4-8ae9-7dee53a6f24c",
                        "glosses": [
                            "het beeld dat iemand in zijn of haar gedachten heeft over hoe de wereld functioneert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5763e5-4f75-48b0-ae26-a13295a24a93",
                                "sense_id": "ee1d4ca1-8bea-3fd6-b663-b9c572d771b7",
                                "text": "De overgang van de middelbare school of het hbo naar de universiteit kan best groot zijn, zegt een student. \"Het is een hele omscholing om van scholier naar student te gaan. Om die hele academische denkwereld in te komen.\""
                            },
                            {
                                "example_id": "6530d7ec-6e34-42cf-aaf9-dbeba79e8295",
                                "sense_id": "ee1d4ca1-8bea-3fd6-b663-b9c572d771b7",
                                "text": "Fenomenale lenigheid en inzicht, maar hij paste niet in de denkwereld van Johan Cruijff en Cor Coster. 'Lange Jan' werd weggepest door de Amsterdamse 'voetbalmaffia'."
                            },
                            {
                                "example_id": "6df7ac80-6499-4842-b3a7-3882ae7d7ef6",
                                "sense_id": "ee1d4ca1-8bea-3fd6-b663-b9c572d771b7",
                                "text": "De belangrijkste conclusie van de psychiatrische autopsie is volgens Duits dat Tristan van der Vlis een jongen was die al heel lang ziek was. \"Hij had al vanaf zijn 14de psychotische kenmerken en werd steeds zieker. Hij isoleerde zich eigenlijk steeds meer en raakte ook steeds meer overtuigd van zijn psychotische denkwereld.\""
                            }
                        ]
                    }
