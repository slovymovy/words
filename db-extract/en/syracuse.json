                                        "glosses": [
                                            "Commune et ville de la région de Sicile en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d28f6d0-d8a7-4546-84fc-030b6778b869",
                                                "sense_id": "bbb6c464-7ca8-3893-a78f-78e5c44ab8ac",
                                                "text": "La neige en mai n’est pas non plus déroutante, ni Archimède faisant de la géométrie pendant le siège de Syracuse."
                                            },
                                            {
                                                "example_id": "37c1b937-220e-40d5-8de5-22bbe57ee09d",
                                                "sense_id": "bbb6c464-7ca8-3893-a78f-78e5c44ab8ac",
                                                "text": "Privilégiez les fruits disposant d’une IGP : clémentines et pomelos de Corse, citrons de Menton ou de Syracuse, orange de Sicile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fbfa263-e645-3db4-8bb8-8e5fc0fed0ea",
                                        "entry_id": "160eac6c-7652-3adf-906e-cab46ec2afcc",
                                        "glosses": [
                                            "Province autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d007d9ce-1ca6-35b4-bd1a-7a40be89e7f5",
                                        "entry_id": "160eac6c-7652-3adf-906e-cab46ec2afcc",
                                        "glosses": [
                                            "Chef-lieu du comté d’Onondaga, dans l'État de New York, aux États-Unis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ecb20bc-2378-4b7a-83a1-f35657082d26",
                                                "sense_id": "d007d9ce-1ca6-35b4-bd1a-7a40be89e7f5",
                                                "text": "Au retour d’un job à Syracuse, entre parenthèses New York, elle a fait un léger détour par Ithaca pour rendre visite à son oncle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
