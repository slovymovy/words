                                "example_id": "51cc9941-e227-4dee-b221-d9eae3ea51b7",
                                "sense_id": "76b2b90d-d29a-33ba-88d3-9347ab0a7d00",
                                "text": "En mai 2019, la série phénomène d’HBO tirait sa révérence après une ultime saison controversée."
                            }
                        ]
                    }
