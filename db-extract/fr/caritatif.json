                "senses": [
                    {
                        "sense_id": "4e78a236-9d35-3581-b24e-806e522dc2e5",
                        "entry_id": "0ff06bd4-79e7-3f5c-b1c1-c1514db386b2",
                        "glosses": [
                            "Relatif à la charité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c154442-f79d-47b8-91f0-d8946b6f531b",
                                "sense_id": "4e78a236-9d35-3581-b24e-806e522dc2e5",
                                "text": "A cette action caritative, due aux malheurs de la guerre, tant à l'égard des réfugiés que des soldats, vient s'ajouter pour les jécistes demeurés à l'arrière une mission de suppléance."
                            },
                            {
                                "example_id": "40c9560f-7be0-4c40-b0d7-054354c6772b",
                                "sense_id": "4e78a236-9d35-3581-b24e-806e522dc2e5",
                                "text": "Les efforts se déploient surtout dans le domaine caritatif et s'accompagnent d'une recatholicisation en profondeur des pauvres secourus, l'objectif étant d'aller au peuple pour rétablir la suprématie de l'Église catholique sur la société civile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c368107-3166-47ca-a65d-c14557448ee7",
                        "source_entry_id": "0ff06bd4-79e7-3f5c-b1c1-c1514db386b2",
                        "source_sense_id": "4e78a236-9d35-3581-b24e-806e522dc2e5",
