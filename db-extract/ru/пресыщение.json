                "senses": [
                    {
                        "sense_id": "cb5a9df8-ba0f-3e04-b845-60a7b66dfc24",
                        "entry_id": "46f8546e-5856-3607-83bf-6eb56aa640b2",
                        "glosses": [
                            "действие по значению гл. пресыщать, пресыщаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b4dc02-8fea-4f80-8108-0c1c5322afb9",
                                "sense_id": "cb5a9df8-ba0f-3e04-b845-60a7b66dfc24",
                                "text": "Безмерный пост и пресыщение равным образом предосудительны."
                            }
                        ]
                    },
                    {
                        "sense_id": "55e7db54-890d-38d2-9d86-027dee55e739",
                        "entry_id": "46f8546e-5856-3607-83bf-6eb56aa640b2",
                        "glosses": [
                            "состояние по значению гл. пресытиться; чрезмерная сытость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af212051-918c-42ea-a9e3-1b71be5245eb",
                                "sense_id": "55e7db54-890d-38d2-9d86-027dee55e739",
                                "text": "С пресыщением и пьянством враг бесплотный входит в сердце человека, ― это каждый внимательный может ощущать."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b504e77-0328-397c-949d-8e1c9a4c18c0",
                        "entry_id": "46f8546e-5856-3607-83bf-6eb56aa640b2",
                        "glosses": [
                            "перен. равнодушие, усталость от чрезмерного удовлетворения каких-либо потребностей, от чрезмерного восприятия чего-либо, злоупотребления чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4700a6e4-6278-4a1e-96a9-b4f64b592428",
                                "sense_id": "8b504e77-0328-397c-949d-8e1c9a4c18c0",
                                "text": "Нечего говорить, что однообразные уличные явления небольшого городка были нам знакомы до пресыщения и скуки."
                            }
                        ]
                    }
                ],
