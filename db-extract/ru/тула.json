                                    {
                                        "sense_id": "8c29080c-f30f-348b-beec-fc117667f2ef",
                                        "entry_id": "407c6e26-b8ba-3618-97e5-9306987ff035",
                                        "glosses": [
                                            "am Fluss Upa gelegene Stadt im westlichen Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56320cfa-9ca6-4aa4-a2f5-35c6147293c4",
                                                "sense_id": "8c29080c-f30f-348b-beec-fc117667f2ef",
                                                "text": "„Tulas Ruhm gründet sich in erster Linie auf die Produktion von Kalaschnikows und eine glückliche Fügung der Geschichte. Während des deutschen Vormarsches auf Moskau fiel die Stadt nie den Panzereinheiten General Guderians in die Hände. Auf dem Hauptplatz begrüßt bis heute ein großlettriges Leninzitat den Besucher: ‚Die Bedeutung Tulas für die Republik ist groß.‘“"
                                            },
                                            {
                                                "example_id": "39d86233-f833-4d71-9072-49220b941332",
                                                "sense_id": "8c29080c-f30f-348b-beec-fc117667f2ef",
                                                "text": "„Die Bewohner der Stadt Tula, in der achtzig Prozent der Betriebe für das Militär arbeiten, reisen zum Einkaufen in die Agrarstadt Orjol.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51113456-a597-37e7-a0ae-27e01df2fa6d",
                                        "entry_id": "407c6e26-b8ba-3618-97e5-9306987ff035",
                                        "glosses": [
                                            "kulturelles Zentrum der Tolteken in Mesoamerika, heute eine archäologische Stätte im mexikanischen Bundesstaat Hidalgo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfbca623-5191-4237-b413-2b9599fa483f",
                                                "sense_id": "51113456-a597-37e7-a0ae-27e01df2fa6d",
                                                "text": "„Die Zahl der Adligen ging in die Zehntausende, sie machten wahrscheinlich rund zwei Prozent der Bevölkerung aus. Ihre privilegierte Stellung legitimierten sie mit der Abstammung von den Königen der Tolteken in Tula und von der Schöpfergottheit Quetzalcoatl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
