                "senses": [
                    {
                        "sense_id": "4c664eb4-90ac-32c1-bcdf-f619f9395737",
                        "entry_id": "b3c00c00-2a79-3516-93a5-7e7a2bda12d5",
                        "glosses": [
                            "charming, delightful, lovely"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9661443-39e8-4fec-9aa7-65f3feb458de",
                                "sense_id": "4c664eb4-90ac-32c1-bcdf-f619f9395737",
                                "text": "— Он преле́стен, твой разбо́йник, — по-францу́зски сказа́ла Ма́рья Васи́льевна му́жу. — Бу́лька стал любова́ться его́ кинжа́лом — он подари́л его́ ему́.",
                                "translation": "\"He is delightful, your brigand!\" said Marya Vasilevna to her husband in french. \"Bulka has been admiring his dagger, and he has given it to him.\"",
                                "english": "\"He is delightful, your brigand!\" said Marya Vasilevna to her husband in french. \"Bulka has been admiring his dagger, and he has given it to him.\""
                            }
                        ]
                    }
                ],
