                "entry_id": "77a4ad63-5299-3884-89ca-23eeeed97f7c",
                "word": "tiers-lieu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d12aa762-2cad-4e3a-90a4-5fc8471378e4",
                        "entry_id": "77a4ad63-5299-3884-89ca-23eeeed97f7c",
