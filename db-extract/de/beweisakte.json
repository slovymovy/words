                "senses": [
                    {
                        "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                        "entry_id": "864030d4-fa2a-3c9e-8626-d2345896104d",
                        "glosses": [
                            "Akte, in der alle Beweise eines Falles enthalten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9632c404-ca92-494a-ba3e-af1db9323d12",
                                "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                                "text": "„Die Union der Opferverbände kommunistischer Gewaltherrschaft (UOKG) betonte, mit Altendorf habe man den \"Bock zum Gärtner\" gemacht: \"Einer, der den Tätern mit Sicherheit sehr nahe stand, und das ganz freiwillig und bewusst in den alten Bundesländern, verwaltet heute die Beweisakten der Verbrechen der kommunistischen Diktatur in Deutschland.“"
                            },
                            {
                                "example_id": "c8db3bab-a33b-413a-adf8-f01469b0e2f1",
                                "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                                "text": "„Die Anklage umfasst 36 Seiten – die Beweisakten über 5000 Blatt.“"
                            },
                            {
                                "example_id": "3a99695f-113b-4166-a130-9774ebfdce08",
                                "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                                "text": "„Im Geheimdienst-Hauptquartier in Langley bei Washington liegen die Beweisakten und Dossiers, die die Amis in den Wirren der Wende aus Ostberlins Stasi-Kammern klauten.“"
                            },
                            {
                                "example_id": "04880564-49b7-454e-9dfb-8836c7ca982e",
                                "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                                "text": "„Sie entschieden, die Beweisakte von Guy Theunis, einem Mitglied der Missionsgesellschaft der \"Weißen Väter\", der staatlichen Justiz zu übergeben“"
                            },
                            {
                                "example_id": "bc813270-723e-4355-8dd6-2121264a7940",
                                "sense_id": "914e55c1-dce6-3f92-b6be-3d3bb5dfda44",
                                "text": "„Bei der Staatsanwaltschaft Magdeburg sind irrtümlich Beweisakten für das Ermittlungsverfahren zum Stendaler Sparkassen-Skandal vernichtet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
