                ],
                "senses": [
                    {
                        "sense_id": "40c27903-8e07-3b46-9c49-e7fdad29f0ce",
                        "entry_id": "4f4b9d8d-efae-3ecf-be8e-76d329d892e8",
                        "glosses": [
                            "Tisch zur Bereitstellung von Rauchwaren und -zubehör"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f154aa8-5e83-4894-892a-67557dc5e2ae",
                                "sense_id": "40c27903-8e07-3b46-9c49-e7fdad29f0ce",
                                "text": "„Der Mann nimmt aus dem Bibliotheksschrank eine Schachtel Zigaretten, ein Kistchen Zigarren und stellt das auf den Rauchtisch.“"
                            },
                            {
                                "example_id": "35b08748-f4fe-4792-8b00-5e82d4154841",
                                "sense_id": "40c27903-8e07-3b46-9c49-e7fdad29f0ce",
                                "text": "„Er und Pole saßen an dem runden Rauchtisch in der Wohnstube und unterhielten sich, und als Pole zum zweiten oder dritten Mal Portwein ins Glas goss, sagte er, dieses halbe Jahr in der Wildnis sei eine der besten Zeiten seines Lebens gewesen.“"
                            },
                            {
                                "example_id": "24b41cb5-f5c7-4993-87cd-829dc05bb1e7",
                                "sense_id": "40c27903-8e07-3b46-9c49-e7fdad29f0ce",
                                "text": "„Als aber in ebendiesem Augenblick einer der Diener an ihn herantrat und ihm zuflüsterte, daß der Rauchtisch arrangiert und der Kaffee serviert sei, hob er die Tafel auf und führte seine Gäste, während er Bülows Arm nahm, auf den an den Eßsaal angebauten Balkon.“"
                            },
                            {
                                "example_id": "1aadf984-2b66-411d-86be-d6e7851abde3",
                                "sense_id": "40c27903-8e07-3b46-9c49-e7fdad29f0ce",
                                "text": "„Binding setzte sich in einen Sessel neben einen Rauchtisch aus gehämmertem Kupfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
