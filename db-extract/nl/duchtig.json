                                "target_senses": [
                                    {
                                        "sense_id": "73bbf509-487f-3aea-a405-0b9003dbb0c3",
                                        "entry_id": "681abd12-3eec-3502-8f4e-4b013ab0c814",
                                        "glosses": [
                                            "zu etwas geeignet, in der Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b9c2a0-17b0-4c87-9994-b97f9bef81c9",
                                                "sense_id": "73bbf509-487f-3aea-a405-0b9003dbb0c3",
                                                "text": "Der neue Kollege ist einer unserer tüchtigsten Mitarbeiter."
                                            }
