                                "example_id": "011aa0f3-9560-4d58-a100-9f77edb88457",
                                "sense_id": "f2c9a64a-05d1-34b9-9872-61d06ffbf048",
                                "text": "Die Protestler verhielten sich gegenüber den Polizisten friedlich."
                            },
                            {
                                "example_id": "78d5271c-6a35-42e2-8eeb-142e1aec1ee2",
                                "sense_id": "f2c9a64a-05d1-34b9-9872-61d06ffbf048",
                                "text": "„Die technikaffinen Protestler stellten alles ins Netz und sorgten, wenn auch mit dem Defizit, dass nicht alles nachprüfbar war, für eine breite Öffentlichkeit.“"
                            }
                        ],
