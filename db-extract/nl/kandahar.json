                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a100d48-0167-4be9-97b9-3cfbd19a30d1",
                        "source_entry_id": "40fd3e47-9696-3c85-9556-89b460536dcf",
                        "source_sense_id": "fb88166e-4ddb-3581-a8ac-4e76a5c15944",
                        "source_sense_description": "een stad gelegen in Zuid-Afghanistan en de hoofdstad van de gelijknamige provincie",
                        "target_lang_word": "Kandahar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kandahar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                        "entry_id": "64775dcb-7b12-33c5-b90a-17d280dbdce3",
                                        "glosses": [
                                            "mit 460.000 Einwohnern drittgrößte Stadt Afghanistans, Hauptstadt der gleichnamigen Provinz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3ffa67-e6ff-4e39-b604-c8a554251dd5",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Dabei war es ihm sogar möglich, Persien Kandahar zu entreißen und damit die Grenze des Mogulreiches an den Helmand-Fluss zu verlegen.“"
                                            },
                                            {
                                                "example_id": "4f2fb0ad-5af6-4d75-83c0-ae9076a938c6",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Der Paschtune Ahmad Shah Durrani, der sich nach dem Tod Nadir Schahs in Kandahar zum Herrscher aufschwang, fiel zwischen 1747 und 1773 mehrfach in Indien ein, plünderte 1757 erneut Delhi und schlug 1761 ein vereintes Heer der Marathen.“"
                                            },
                                            {
                                                "example_id": "74508d62-f85f-4fd4-acee-c89daf983b55",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„So bildete Kandahar, auf halbem Weg zwischen Indien und Persien, eine Oase zwischen den schroffen südlichen Ausläufern des Hindukusch und Khorassan.“"
                                            },
                                            {
                                                "example_id": "d5d3927a-5e2a-4b5d-b949-81ab3c913951",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„Vor bald fündundzwanzig Jahren habe ich ein Buch über die Taliban geschrieben, als sie gerade in der zweitgrößten Stadt Afghanistans, Kandahar, aufgetaucht waren.“"
                                            },
                                            {
                                                "example_id": "101c8257-58e4-415b-a1d2-5d7a2e6fadfb",
                                                "sense_id": "69320b76-12a3-3e11-8fc7-4d0bb58e05fd",
                                                "text": "„General Nott kommt aus Kandahar, wo er den Befehl führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9390e90-480a-38c0-9b1d-1b31ac16ccc8",
                                        "entry_id": "64775dcb-7b12-33c5-b90a-17d280dbdce3",
                                        "glosses": [
                                            "Provinz in Afghanistan mit mehr als 1.000.000 Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49712ee-7fe1-4c3a-96fc-b948584b2d03",
                                                "sense_id": "b9390e90-480a-38c0-9b1d-1b31ac16ccc8",
                                                "text": "„Seit ihrem dramatischen und unerwarteten Erscheinen Ende 1994 hatten die Taliban relativen Frieden und Sicherheit nach Kandahar und in die benachbarten Provinzen gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f883a1cb-c108-4b04-bc35-d6e950778fa0",
                        "source_entry_id": "40fd3e47-9696-3c85-9556-89b460536dcf",
