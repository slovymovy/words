{
    "word_family": [
        "present",
        "presentation",
        "presenter",
        "presently",
        "presentable",
        "omnipresence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "717fe084-9444-3aef-bcd8-8a30dccb2072",
                    "sense_definition": "The state or fact of existing, occurring, or being present at a specific place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>presence</w> of security guards made the staff feel much safer.",
                            "target_lang_translations": {
                                "ru": "<w>Присутствие</w> охранников заставило персонал чувствовать себя намного безопаснее.",
                                "zh": "保安的<w>在场</w>让员工感到安全多了。"
                            }
                        },
                        {
                            "text": "Tests revealed the <w>presence</w> of a rare chemical in the water supply.",
                            "target_lang_translations": {
                                "ru": "Тесты выявили <w>наличие</w> редкого химиката в системе водоснабжения.",
                                "zh": "检测显示供水中<w>存在</w>一种稀有化学物质。"
                            }
                        }
                    ],
                    "antonyms": [
                        "absence"
                    ],
                    "common_phrases": [
                        "presence of mind",
                        "your presence is requested",
                        "acknowledge the presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние существования или нахождения в определенном месте.",
                        "zh": "存在、发生或在特定地点出现的事实或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "факт нахождения где-либо"
                            },
                            {
                                "target_lang_word": "наличие",
                                "target_lang_sense_clarification": "существование чего-либо (например, вещества)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "某物客观存在的事实"
                            },
                            {
                                "target_lang_word": "在场",
                                "target_lang_sense_clarification": "某人出现在某地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c259faee-81ab-3b5a-a642-cb4ad0eb2ab4",
                    "sense_definition": "The area immediately around a person; one's immediate vicinity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not discuss confidential matters in my <w>presence</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не обсуждайте конфиденциальные вопросы в моем <w>присутствии</w>.",
                                "zh": "请不要在我的<w>在场</w>时讨论机密事项。"
                            }
                        },
                        {
                            "text": "He signed the legal documents in the <w>presence</w> of two witnesses.",
                            "target_lang_translations": {
                                "ru": "Он подписал юридические документы в <w>присутствии</w> двух свидетелей.",
                                "zh": "他在两名证人的<w>在场</w>下签署了法律文件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in my presence",
                        "in the presence of",
                        "grace us with your presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство непосредственно вокруг человека; чья-либо непосредственная близость.",
                        "zh": "某人周围的空间；某人的直接近处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "в выражениях «в моем присутствии»"
                            },
                            {
                                "target_lang_word": "близость",
                                "target_lang_sense_clarification": "нахождение рядом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在场",
                                "target_lang_sense_clarification": "指在某人面前或身边"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3001016-207b-3083-9d37-8f7ecce24fdc",
                    "sense_definition": "The existence or reach of a group, business, or military force in a particular area or market.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is trying to build a strong online <w>presence</w> to attract young customers.",
                            "target_lang_translations": {
                                "ru": "Компания пытается создать сильное <w>присутствие</w> в интернете, чтобы привлечь молодых клиентов.",
                                "zh": "该公司正试图建立强大的网络<w>存在</w>以吸引年轻客户。"
                            }
                        },
                        {
                            "text": "The government maintained a heavy military <w>presence</w> along the border.",
                            "target_lang_translations": {
                                "ru": "Правительство сохраняло значительное военное <w>присутствие</w> вдоль границы.",
                                "zh": "政府在边境地区保持了强大的军事<w>存在</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "online presence",
                        "global presence",
                        "military presence",
                        "market presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наличие или охват деятельности группы, бизнеса или военных сил в определенном районе или на рынке.",
                        "zh": "团体、企业或军事力量在特定区域或市场中的存在或影响力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "военное или коммерческое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "指商业或军事上的布局与影响力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a581e72c-b7f2-3ffa-8532-b1667d50eb87",
                    "sense_definition": "A quality of personal dignity, poise, or charisma that makes a person impressive and noticed by others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even without speaking, the actor had a commanding <w>presence</w> on stage.",
                            "target_lang_translations": {
                                "ru": "Даже не говоря ни слова, актер обладал внушительной <w>харизмой</w> на сцене.",
                                "zh": "即使一言不发，这位演员在舞台上依然有着令人折服的<w>气场</w>。"
                            }
                        },
                        {
                            "text": "She lacks the stage <w>presence</w> required for such a leading role.",
                            "target_lang_translations": {
                                "ru": "Ей не хватает сценического <w>обаяния</w>, необходимого для такой главной роли.",
                                "zh": "她缺乏担任主角所必需的舞台<w>风度</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stage presence",
                        "commanding presence",
                        "imposing presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество личного достоинства, самообладания или харизмы, которое делает человека впечатляющим и заметным для окружающих.",
                        "zh": "一种使人印象深刻并引起他人注意的个人尊严、风度或魅力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "харизма",
                                "target_lang_sense_clarification": "личное обаяние"
                            },
                            {
                                "target_lang_word": "внушительность",
                                "target_lang_sense_clarification": "производимое впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风度",
                                "target_lang_sense_clarification": "指人的气质与仪态"
                            },
                            {
                                "target_lang_word": "气场",
                                "target_lang_sense_clarification": "指一个人带给人的强大印象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a57c60b1-d5ff-3ab4-86e3-00307b934201",
                    "sense_definition": "A supernatural force, spirit, or entity that is felt to be nearby.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After entering the old house, I immediately felt a ghostly <w>presence</w>.",
                            "target_lang_translations": {
                                "ru": "Войдя в старый дом, я сразу почувствовал призрачное <w>присутствие</w>.",
                                "zh": "走进那座老房子后，我立刻感觉到了一种幽灵般的<w>存在</w>。"
                            }
                        },
                        {
                            "text": "She claimed that a dark <w>presence</w> was haunting the attic.",
                            "target_lang_translations": {
                                "ru": "Она утверждала, что темная <w>сущность</w> обитает на чердаке.",
                                "zh": "她声称有一个黑暗的<w>灵体</w>在阁楼里游荡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "felt a presence",
                        "dark presence",
                        "evil presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверхъестественная сила, дух или сущность, ощущаемая поблизости.",
                        "zh": "一种被感觉到在附近的超自然力量、灵魂或实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "ощущение чего-то невидимого"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "дух или призрак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "指超自然的存在感"
                            },
                            {
                                "target_lang_word": "灵体",
                                "target_lang_sense_clarification": "指鬼魂或超自然实体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a18d7b71-8078-3bc2-a55a-124964b6d7d9",
                    "sense_definition": "To make something present or to become present, often used in philosophical contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist attempted to <w>presence</w> the emotion of grief through abstract colors.",
                            "target_lang_translations": {
                                "ru": "Художник попытался <w>явить</w> эмоцию горя через абстрактные цвета.",
                                "zh": "艺术家试图通过抽象的色彩来<w>呈现</w>悲伤的情绪。"
                            }
                        },
                        {
                            "text": "In his theory, the past is <w>presenced</w> in our current actions and memories.",
                            "target_lang_translations": {
                                "ru": "В его теории прошлое <w>проявляется</w> в наших текущих действиях и воспоминаниях.",
                                "zh": "在他的理论中，过去在我们的当前行为和记忆中得到了<w>体现</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо присутствующим или становиться явным, часто используется в философских контекстах.",
                        "zh": "使某物呈现或变得显现，常用于哲学语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "являть",
                                "target_lang_sense_clarification": "делать явным"
                            },
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "обнаруживать присутствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呈现",
                                "target_lang_sense_clarification": "使某物显现出来"
                            },
                            {
                                "target_lang_word": "体现",
                                "target_lang_sense_clarification": "使抽象事物具体化"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}