    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d194b14c-dad0-37aa-84ed-d79077d1c6b4",
                    "sense_definition": "Devenir différent, évoluer ou passer d'un état à un autre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps <w>change</w> très vite en montagne pendant l'après-midi."
                        },
                        {
                            "text": "Tu as beaucoup <w>changé</w> depuis la fin de nos études secondaires."
                        }
                    ],
                    "synonyms": [
                        "évoluer"
                    ],
                    "antonyms": [
                        "demeurer",
                        "rester"
                    ],
                    "common_phrases": [
                        "changer avec le temps"
                    ]
                },
                {
                    "sense_id": "1a9d51d9-1164-3c7e-bb50-a7997b8f477b",
                    "sense_definition": "Rendre quelqu'un ou quelque chose différent de ce qu'il était.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle coupe de cheveux va <w>changer</w> ton visage."
                        },
                        {
                            "text": "Nous devons <w>changer</w> la date de la réunion de service."
                        }
                    ],
                    "synonyms": [
                        "modifier",
                        "transformer"
                    ],
                    "antonyms": [
                        "conserver",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "changer la donne"
                    ]
                },
                {
                    "sense_id": "985da93f-563b-3fdd-a7c7-0a8ea570d179",
                    "sense_definition": "Quitter ou abandonner une chose pour en prendre une autre de même nature.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "remplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a décidé de <w>changer</w> d'avis après avoir écouté ses collègues."
                        },
                        {
                            "text": "Nous devons <w>changer</w> de train à la prochaine gare."
                        }
                    ],
                    "synonyms": [
                        "remplacer",
                        "substituer"
                    ],
                    "antonyms": [
                        "garder"
                    ],
                    "common_phrases": [
                        "changer d'avis",
                        "changer d'air",
                        "changer de sujet"
                    ]
                },
                {
                    "sense_id": "dcb4c6d7-72ba-3670-939f-0ef0c5660642",
                    "sense_definition": "Remplacer des vêtements ou du linge par d'autres propres, ou habiller à neuf.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vetements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père va <w>changer</w> le bébé avant de lui donner son biberon."
                        },
                        {
                            "text": "Je rentre à la maison pour me <w>changer</w> avant la fête."
                        }
                    ],
                    "common_phrases": [
                        "changer de vêtements",
                        "se changer"
                    ]
                },
                {
                    "sense_id": "f11c7c19-3891-3ced-8a7e-4b63fcf9a697",
                    "sense_definition": "Convertir une monnaie, des devises ou des billets contre d'autres valeurs monétaires équivalentes.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "monnaie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous me <w>changer</w> ce billet de cinquante euros en pièces ?"
                        },
                        {
                            "text": "Les touristes préfèrent <w>changer</w> de l'argent dès leur arrivée à l'aéroport."
                        }
                    ],
                    "synonyms": [
                        "convertir",
                        "échanger"
                    ],
                    "common_phrases": [
                        "changer de l'argent"
                    ]
                },
                {
                    "sense_id": "62cd31db-afaa-31f1-a893-7a2e2b5743a9",
                    "sense_definition": "Métamorphoser ou convertir entièrement une substance, un être ou une chose en une autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sorcier a réussi à <w>changer</w> le prince en bête féroce."
                        },
                        {
                            "text": "Le froid intense a fini par <w>changer</w> l'eau du lac en glace."
                        }
                    ],
                    "synonyms": [
                        "métamorphoser",
                        "muer"
                    ],
                    "common_phrases": [
                        "changer en or"
                    ]
                }
            ]
        }
    ]
}