                "senses": [
                    {
                        "sense_id": "8841383a-a06a-34a6-9542-94beb3e70e3f",
                        "entry_id": "bc3be1e5-3244-3eea-83fc-c931ecb48a4d",
                        "glosses": [
                            "Schema, das die Methode zur Durchführung einer Berechnung vorgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3249cecb-08aa-4f53-bc49-7cead0d761d0",
                                "sense_id": "8841383a-a06a-34a6-9542-94beb3e70e3f",
                                "text": "„Die Staats- und Gemeindesteuern werden aufgrund des Berechnungsschemas (vgl. Ziff. 11) erhoben.“"
                            },
                            {
                                "example_id": "47311988-5032-42b7-8354-18b8f4d4a334",
                                "sense_id": "8841383a-a06a-34a6-9542-94beb3e70e3f",
                                "text": "„Berechnungsschemata sind formale Beschreibungsmittel, die es erlauben, die Transformation von Information durch die Zusammenhänge zwischen den verschiedenen Schritten eines Algorithmus darzustellen.“"
                            },
                            {
                                "example_id": "23226011-59c5-418d-8db9-f9cdc354d4aa",
                                "sense_id": "8841383a-a06a-34a6-9542-94beb3e70e3f",
                                "text": "„Für die Lärmexpositionszeit gibt es verschiedene Berechnungsschemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
