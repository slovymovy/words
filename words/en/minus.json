                        "zh": "某事物的缺点、弊端或负面方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательная сторона"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺点",
                                "target_lang_sense_clarification": "负面因素"
                            },
                            {
                                "target_lang_word": "弊端",
                                "target_lang_sense_clarification": "不利之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ed3ab92-43d1-3abb-8f85-99efea72ecbd",
                    "sense_definition": "The symbol (−) used to indicate subtraction or a negative value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student forgot to write the <w>minus</w> before the number.",
                            "target_lang_translations": {
                                "ru": "Ученик забыл написать <w>минус</w> перед числом.",
                                "zh": "学生忘了在数字前写<w>减号</w>。"
                            }
                        },
                        {
                            "text": "Make sure you distinguish between the <w>minus</w> and the dash.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы различаете <w>минус</w> и тире.",
                                "zh": "确保你能区分<w>减号</w>和破折号。"
                            }
                        }
