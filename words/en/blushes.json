{
    "word_family": [
        "blush",
        "blusher",
        "blushful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1acfcd26-1745-3580-bce8-110b14434450",
                    "sense_definition": "A feeling of shame or embarrassment that causes the face to turn red.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>blushes</w> gave her away as soon as his name was mentioned.",
                            "target_lang_translations": {
                                "nl": "Haar <w>blos</w> verried haar zodra zijn naam werd genoemd."
                            }
                        },
                        {
                            "text": "He tried to hide his <w>blushes</w> by looking down at the floor.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn <w>blozen</w> te verbergen door naar de grond te kijken."
                            }
                        }
                    ],
                    "synonyms": [
                        "embarrassment",
                        "shame"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gevoel van schaamte of verlegenheid waardoor het gezicht rood wordt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blozen",
                                "target_lang_sense_clarification": "het proces van rood worden door emotie"
                            },
                            {
                                "target_lang_word": "blos",
                                "target_lang_sense_clarification": "de rode kleur op de wangen door schaamte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f80c7259-4c71-3748-aefe-053fa76e460c",
                    "sense_definition": "Plural of <w>blush</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>blushes</w> on her cheeks revealed her secret feelings.",
                            "target_lang_translations": {
                                "nl": "De plotselinge <w>blossen</w> op haar wangen verraadden haar geheime gevoelens."
                            }
                        },
                        {
                            "text": "He could not control the <w>blushes</w> that appeared whenever he spoke in public.",
                            "target_lang_translations": {
                                "nl": "Hij kon de <w>blozen</w> die verschenen wanneer hij in het openbaar sprak niet onderdrukken."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Meervoud van bloos of blozen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blozen",
                                "target_lang_sense_clarification": "meervoudsvorm van de handeling van het rood worden"
                            },
                            {
                                "target_lang_word": "blossen",
                                "target_lang_sense_clarification": "meervoud van de rode kleur op de wangen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "273d46ae-fe69-38f5-8bd9-fe0cc8300d66",
                    "sense_definition": "Third-person singular simple present indicative of <w>blush</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always <w>blushes</w> when someone gives her a compliment.",
                            "target_lang_translations": {
                                "nl": "Ze <w>bloost</w> altijd wanneer iemand haar een compliment geeft."
                            }
                        },
                        {
                            "text": "He <w>blushes</w> easily whenever he is the center of attention.",
                            "target_lang_translations": {
                                "nl": "Hij <w>bloost</w> gemakkelijk wanneer hij in het middelpunt van de belangstelling staat."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Derde persoon enkelvoud van het werkwoord blozen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bloost",
                                "target_lang_sense_clarification": "vervoeging van het werkwoord blozen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}