                                        "sense_id": "fde14201-eed7-3a63-aee5-9035f8db2c7b",
                                        "entry_id": "a6370db3-cacb-3845-8c4f-6fe9a2e0e74e",
                                        "glosses": [
                                            "An instrument for measuring rigidity by the torsional oscillations of a weighted wire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4db20055-5fcd-364c-930c-a409049cdff4",
                                        "entry_id": "a6370db3-cacb-3845-8c4f-6fe9a2e0e74e",
                                        "glosses": [
                                            "A pattern that returns to its original state, in the same orientation and position, after a finite number of generations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31d0776-7f66-498f-84c0-aca97ffac535",
                                                "sense_id": "4db20055-5fcd-364c-930c-a409049cdff4",
                                                "text": "He has turned up a number of new oscillators of periods 2,3,4,5,6, & 8."
                                            },
                                            {
                                                "example_id": "1c36d107-72e6-4379-938c-e930794546fa",
                                                "sense_id": "4db20055-5fcd-364c-930c-a409049cdff4",
                                                "text": "Two track segments, each of which realizes the same transformation in a different number of generations are particularly useful for obtaining oscillator periods."
                                            },
                                            {
                                                "example_id": "2379a6e5-ef2d-488d-b296-e726a926e1a5",
                                                "sense_id": "4db20055-5fcd-364c-930c-a409049cdff4",
                                                "text": "Synthesis of spaceship flotillas is even more complicated than synthesis of oscillators, since spaceships are like oscillators that move[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10c737d-7f8d-4b3c-b60a-9445321691ea",
                        "source_entry_id": "356171ec-cc4a-322f-b0cb-ed1a0a4133f9",
                        "source_sense_id": "dd9912ef-38e9-34aa-89b3-ac47305400f1",
