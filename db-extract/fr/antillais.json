            {
                "entry_id": "6c7aaea3-26cc-3a8d-946a-095d57ed997f",
                "word": "Antillais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ca29afe8-bcf1-48a7-8d02-5d4de285c844",
                        "entry_id": "6c7aaea3-26cc-3a8d-946a-095d57ed997f",
                        "tags": [
                            "feminine"
