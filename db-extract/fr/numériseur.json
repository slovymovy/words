                        "entry_id": "dedc448f-f79a-34d8-9aff-d646a74f1ad3",
                        "glosses": [
                            "Appareil permettant de transformer un signal analogique en un signal numérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a333fa7f-0ad2-4490-a4df-52ce2d6134d1",
                                "sense_id": "71095617-14aa-3c29-accd-5d9dcc549a42",
                                "text": "Un numériseur (« scanner ») ou scanneur transforme une image sur papier en données binaires compréhensibles par l’ordinateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7089eb47-33d7-4874-8f1a-d9a0970bab70",
                        "source_entry_id": "dedc448f-f79a-34d8-9aff-d646a74f1ad3",
                        "source_sense_id": "71095617-14aa-3c29-accd-5d9dcc549a42",
                        "source_sense_description": "Appareil permettant de transformer un signal analogique en un signal numérique",
                        "target_lang_word": "digitizer",
