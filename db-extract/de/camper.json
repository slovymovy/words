                            }
                        ]
                    },
                    {
                        "translation_id": "0e60ec5c-4d1a-44f5-b069-6e84307c4186",
                        "source_entry_id": "199b9881-f9f3-3433-914f-c9e283717e66",
                        "source_sense_id": "a28fc227-d982-3e2d-be77-a70406a73ee1",
                        "source_sense_description": "Person, die für eine gewisse Zeit in einem Zelt oder Wohnmobil/Wohnwagen zu Erholungszwecken lebt",
                        "target_lang_word": "campeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                                        "glosses": [
                                            "Personne qui campe, qui pratique le camping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f95bb6-b3a1-4d03-8380-f31d2c5f2b5f",
                                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                                "text": "Par ailleurs, les sondages effectués démontrent que l'âge moyen du campeur adulte est passé de 28 ans en 1954 à 38 ans en 1964."
                                            },
                                            {
                                                "example_id": "3a4e6be2-e2fb-4a0e-b7b4-96837bf20596",
                                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                                "text": "Pour planter sa tente, comptez 6 € la nuit (seul) et 10 € à 2 personnes, en basse saison. 160 emplacements attendent les campeurs au milieu de 2 ha de verdure, sur les bords de la Charente."
                                            },
                                            {
                                                "example_id": "e15ee5c3-64ec-4360-bcf5-892cc7c6c0ed",
                                                "sense_id": "49fc0381-bf42-33f8-ab69-5b1388634bbc",
                                                "text": "C’est ce que nous allons voir en étudiant les différentes modalités d’insertion des campeurs dans la nature, puis l’installation du camp en camping sauvage ou en camp recommandé par les fédérations de campeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce2dbce-6fff-3965-a7ba-52fd398fb2cb",
                                        "entry_id": "d28fd50c-bd27-38d9-a008-3549aa7edce6",
                                        "glosses": [
                                            "Joueur qui reste à la même zone stratégique lui permettant d’obtenir facilement des points."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
