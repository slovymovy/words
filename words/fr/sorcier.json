                },
                {
                    "sense_id": "9e6fe9f3-6839-38e4-9f42-97a3be802f4b",
                    "sense_definition": "Dans certaines cultures ou sociétés traditionnelles, praticien de rites thérapeutiques ou magiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois consultent souvent le <w>sorcier</w> de la tribu pour tenter de guérir les maladies mystérieuses."
                        },
                        {
                            "text": "L'ethnologue a longuement interrogé le <w>sorcier</w> du village sur les rituels sacrés ancestraux."
                        }
                    ],
                    "synonyms": [
                        "chaman",
                        "guérisseur"
                    ],
                    "common_phrases": [
