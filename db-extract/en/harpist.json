                    {
                        "translation_id": "65fbee81-2cd9-4d36-981f-9178c649f080",
                        "source_entry_id": "5316e2ad-011b-3204-b2f1-f2a672f977bd",
                        "source_sense_id": "d306e0ba-0cd1-30fa-9d09-96cdaa6c3fda",
                        "source_sense_description": "Person who plays the harp",
                        "target_lang_word": "harpiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harpiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                        "entry_id": "cc0f9c2a-8c6d-374c-ae68-f6f19ccdda36",
                                        "glosses": [
                                            "Musicien ou musicienne qui joue de la harpe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67ac98d-f150-4d9c-b61c-bcac91b1893b",
                                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                                "text": "Les sons d’une harpe retentirent, elle voulut voir la musique ; et bientôt le joueur d’instrument, amené par la négresse, entra dans les Premières. […]. Enfin le harpiste rejeta ses longs cheveux derrière ses épaules, étendit les bras et se mit à jouer."
                                            },
                                            {
                                                "example_id": "61cf45f4-b0d6-44a3-bbb2-ed55fe335ec4",
                                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                                "text": "Rendez-vous samedi 21 janvier à 16 h pour la lecture musicale du roman par la comédienne Solange Boulanger accompagnée par la harpiste Françoise de Maubus qui vous entraîneront dans l’histoire de Saint-Avit et Morhange."
                                            },
                                            {
                                                "example_id": "9440b3db-31b9-4e99-8e57-85b875b01bd4",
                                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                                "text": "Quant à la harpiste elle-même, elle ne dépareillait pas en apparaissant dans une robe de concert fendue à mi-cuisse."
                                            },
                                            {
                                                "example_id": "ea377faf-ddad-40bc-b838-eb8a2bce4119",
                                                "sense_id": "bf629693-87e9-3e6b-bda4-f6034fa9ae30",
                                                "text": "Profitez aussi dès 19h30 d’un moment musical dans la Rotonde du musée avec le concert Les cordes de l’âme, donné par le duo de harpistes Véronique Ghesquière et Marta Power, en partenariat avec le conservatoire de Saint-Cloud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbedc928-401b-4860-9250-74ed18fbf192",
                        "source_entry_id": "5316e2ad-011b-3204-b2f1-f2a672f977bd",
