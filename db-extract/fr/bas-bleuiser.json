                ],
                "senses": [
                    {
                        "sense_id": "f4ad3dc8-ee7a-3cc2-bd3a-61b4ad99b37f",
                        "entry_id": "9f399be4-cba0-3090-bfbc-5ccdfad48551",
                        "glosses": [
                            "Donner un caractère évoquant un bas-bleu à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df11a42-9e73-4b7a-8977-cc593167be10",
                                "sense_id": "f4ad3dc8-ee7a-3cc2-bd3a-61b4ad99b37f",
                                "text": "A-t-on remarqué qu’en prenant la plume nos femmes-écrivains n’ont rien abdiqué de ce qui fait au naturel leur séduisance ? Nulle n’a tenté de bas-bleuiser ni de viriliser sa plume et, en vérité, il faut les en bénir."
                            },
                            {
                                "example_id": "4c25dac7-e022-4fb2-af2f-bf7b3bd4dece",
                                "sense_id": "f4ad3dc8-ee7a-3cc2-bd3a-61b4ad99b37f",
                                "text": "Sept ans plus tard, nous voyons Fanny Burney, qui en 1780 se vantait de « bas-bleuiser », déclarer qu’elle « était toujours prête à se défendre contre cette appellation pédante »."
                            }
                        ]
                    }
