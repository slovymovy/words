                    },
                    {
                        "translation_id": "0fae4f9a-7982-4f0b-b5ac-568db897ce4e",
                        "source_entry_id": "5fdc4d50-6339-3f84-a19f-0c6468da8ff9",
                        "source_sense_id": "e0ca9d32-0d3e-368a-a199-11297edf4582",
