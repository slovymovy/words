                        "sense_id": "4b40310f-6272-3035-a7c2-9623a11fdb6c",
                        "entry_id": "9e4ae9a6-7994-3e3d-9a06-ae8f9edf9f80",
                        "glosses": [
                            "identité congolaise ou appartenance à un groupe ethnique originaire du Congo."
                        ],
                        "tags": [
                            "Congo-Kinshasa"
                        ],
                        "examples": [
                            {
                                "example_id": "3173abc8-09d9-4b96-b131-6e9a1a95183e",
                                "sense_id": "4b40310f-6272-3035-a7c2-9623a11fdb6c",
                                "text": "Certains de ses opposants doutent de la congolité de ce candidat."
                            },
                            {
                                "example_id": "17d31b3a-b26a-47b7-9e7a-0eaf23c74c8f",
                                "sense_id": "4b40310f-6272-3035-a7c2-9623a11fdb6c",
                                "text": "Des chansons à la gloire de Bemba, entrecoupées de slogans sur la « congolité , ont été entonnées : « Bemba, fils du pays », « Il revient, ce fils du Congo, Bemba est en route »."
                            },
                            {
                                "example_id": "00db8c2c-e837-412a-92a2-e2c7f989aae2",
                                "sense_id": "4b40310f-6272-3035-a7c2-9623a11fdb6c",
                                "text": "Nous voici déjà au-delà de l’homophonie : « ivoirité » comme « congolité » ne sont pas des idéologies issues de génération spontanée mais des (sous-)produits de luttes pour le pouvoir politique : comme en Côte d’Ivoire pour Ouattara, en RDC, la remise en cause de la « congolité » de Kabila ne semble guère avoir d’autre but que de contester à ce dernier le droit d’exercer la magistrature suprême."
                            }
                        ]
                    }
