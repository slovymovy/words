                    "sense_definition": "w sposób niejasny, skomplikowany lub zawiły",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sposób",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor opisał historię bardzo <w>zagmatwanie</w>, przez co trudno było zrozumieć zakończenie.",
                            "target_lang_translations": {
                                "ru": "Автор описал историю очень <w>запутанно</w>, из-за чего было трудно понять концовку."
                            }
                        },
                        {
                            "text": "Tłumaczył wszystko tak <w>zagmatwanie</w>, że nikt nie wiedział, o co mu chodzi.",
                            "target_lang_translations": {
                                "ru": "Он объяснял все так <w>запутанно</w>, что никто не понимал, о чем он говорит."
                            }
