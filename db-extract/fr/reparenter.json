                "senses": [
                    {
                        "sense_id": "f455a409-2aa7-3d86-a6da-0d8331e1cb4b",
                        "entry_id": "0ac90f0b-522b-3829-81b3-cdfe9753f3a2",
                        "glosses": [
                            "Rétablir une relation de type parent-enfant avec quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61bcd91c-dd0e-4487-82a6-a6a46411ad8d",
                                "sense_id": "f455a409-2aa7-3d86-a6da-0d8331e1cb4b",
                                "text": "Finalement à Family Futures nous reconnaissons que reparenter des enfants traumatisés est un défi qui nécessite un engagement à long terme, nous reconnaissons que la route sera cahoteuse."
                            },
                            {
                                "example_id": "b1694d96-628d-4652-9fdf-6764b739bcbb",
                                "sense_id": "f455a409-2aa7-3d86-a6da-0d8331e1cb4b",
                                "text": "De même, si nous choisissons de nous reparenter, nous pouvons nous engager à apprendre et à évoluer d’une manière qui ne nous semble pas naturelle au premier abord."
                            },
                            {
                                "example_id": "bb1267a6-db73-4e59-adf8-ec219cb59cf2",
                                "sense_id": "f455a409-2aa7-3d86-a6da-0d8331e1cb4b",
                                "text": "Comment se reparenter ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8e82b2b3-f9de-33b8-9e1e-87b81921f531",
                        "entry_id": "0ac90f0b-522b-3829-81b3-cdfe9753f3a2",
                        "glosses": [
                            "Redonner un parent à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "177a19a2-bb94-4599-a688-3cd33b494270",
                                "sense_id": "8e82b2b3-f9de-33b8-9e1e-87b81921f531",
                                "text": "Vous pouvez reparenter vos objets orphelins simplement en les important tous dans le même sous-site Web."
                            },
                            {
                                "example_id": "df748c14-9a9b-473e-82de-73c545eeb3ac",
                                "sense_id": "8e82b2b3-f9de-33b8-9e1e-87b81921f531",
                                "text": "Je sais qu'il est possible de reparenter un widget X11 avec une JFrame (j'ai vu une application le faire)."
                            },
                            {
                                "example_id": "f41f3aab-f4ca-4b46-a94e-2db9fd7b9b05",
                                "sense_id": "8e82b2b3-f9de-33b8-9e1e-87b81921f531",
                                "text": "J'ai essayé de déparenter - reparenter tout les objets, même problème."
                            }
                        ]
                    }
                ],
