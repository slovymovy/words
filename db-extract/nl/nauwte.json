                                                "example_id": "de87b34e-9147-4e14-a9d7-edaf749c90ab",
                                                "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                                                "text": "a man of stricture and firm abstinence"
                                            }
                                        ]
                                    },
