    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "874eb714-38d2-309f-81cf-8c678db5755f",
                "word": "Schwarzenegger",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a4116e20-6e1a-4696-bf7d-d099e29ba271",
                        "entry_id": "874eb714-38d2-309f-81cf-8c678db5755f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Schwarzeneggers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                        "entry_id": "874eb714-38d2-309f-81cf-8c678db5755f",
                        "glosses": [
                            "A surname from German; used specifically of Arnold Schwarzenegger (b. 1947), an Austrian-American businessman and governor of California, known especially for his success as a professional bodybuilder and action film actor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5c00e0-6ea6-4f10-86a9-57b65f659802",
                                "sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                                "text": "The Twilight of the Action-Movie Gods has been a long time coming. The great action-hero triumvirate of the Reagan-Bush years—Stallone, Schwarzenegger, Willis—seem collectively to have realised that the shadows are lengthening at the end of their day in the sun."
                            },
                            {
                                "example_id": "57ceaa5b-187d-40ca-9514-8e6e9cb2eb57",
                                "sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                                "text": "“Schwarzenegger vs Zombies” is a pitch that would have most studio executives sprinting for their chequebooks, but “Maggie” isn't the film they'd have in mind."
                            },
                            {
                                "example_id": "05516aa0-be42-44dc-ad32-068eb7e3747c",
                                "sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                                "text": "When he graduated from UCLA on time, he missed getting Schwarzenegger's autograph on his diploma by four months."
                            },
                            {
                                "example_id": "d85a95d2-ab0e-4773-a5b1-502c6814c079",
                                "sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                                "text": "Arnold Schwarzenegger issued a stinging rebuke of Donald Trump on Sunday, comparing the riot at the US Capitol which the president incited to Kristallnacht, the night in November 1938 when Nazi thugs attacked Jewish Germans and their property, a harbinger of horrors to come."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31a92726-26d1-400c-b24f-31f64f5c2e28",
                        "source_entry_id": "874eb714-38d2-309f-81cf-8c678db5755f",
                        "source_sense_id": "eb4f1f17-bace-3c9e-b5e1-4dcfeb909f41",
                        "source_sense_description": "surname of German-speakers",
                        "target_lang_word": "Шварцене́ггер",
