                        "source_sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                        "source_sense_description": "fachsprachlich: chemischer Stoff, der ab einem bestimmten Ausmaß der Natur schadet",
                        "target_lang_word": "pollutant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollutant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bf857a-d49c-3ba4-8709-d42bdc5b95d2",
                                        "entry_id": "3179f272-d106-3a47-b59d-a559392ecbba",
                                        "glosses": [
                                            "A foreign substance that makes something dirty, or impure, especially waste from human activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e75bb29a-32e4-4f29-86c9-919f1bea46df",
                                                "sense_id": "81bf857a-d49c-3ba4-8709-d42bdc5b95d2",
                                                "text": "Acid rain forms when water in the atmosphere condenses on particles containing acid-forming pollutants, such as sulfate produced by the burning of fossil fuels and nitrogen oxides from automobile exhausts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff03381-f0fa-43f1-b3f2-4ea4b3d9e2c2",
                        "source_entry_id": "8412e246-1cf9-3e15-80e6-38779b98f287",
                        "source_sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                        "source_sense_description": "fachsprachlich: chemischer Stoff, der ab einem bestimmten Ausmaß der Natur schadet",
                        "target_lang_word": "polluant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polluant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                        "entry_id": "a36a68df-fe9f-34d9-997d-cb50fdcbaefe",
                                        "glosses": [
                                            "Qui pollue, qui souille ou dénature l’environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c0801f-810a-4775-bf3a-c4f3a97a0da4",
                                                "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                                            },
                                            {
                                                "example_id": "43b57a88-1e48-4abf-b69c-bff672e9061e",
                                                "sense_id": "e6363d57-4d55-3e05-985d-2a5d4894a221",
                                                "text": "Encore un truc made in China, avec des colorants polluants, importés en cargos, pour un événement climaticide complètement inutile en plein effondrement climatique, se désole Marie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polluant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                        "entry_id": "6d7090ea-8584-3ce9-9bb5-11dc37117307",
                                        "glosses": [
                                            "Substance qui pollue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65138d2-171e-45bf-a5ff-357f98e312c5",
                                                "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                                "text": "Les propriétés physico-chimiques du polluant influencent fortement son devenir dans la lithosphère."
                                            },
                                            {
                                                "example_id": "9a4648c8-5828-43b9-b4a1-a14f2df5aa33",
                                                "sense_id": "bf6e9aa2-796a-3bb9-9e4d-f860b58f6c05",
                                                "text": "Un appareil surdimensionné fonctionne le plus souvent au ralenti, tirage fermé. Il s’encrasse, ses émissions de polluants augmentent, et il est soumis à une forte corrosion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polluant",
