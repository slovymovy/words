                        "glosses": [
                            "Petit fleuve côtier français, dont le bassin est entièrement situé dans le département de la Manche, en Normandie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "1fa1bf1d-0a3c-474e-b9bc-a974f0fba6f2",
                                "sense_id": "0fff9745-0712-3d6e-b8b0-92c92c5efb09",
                                "text": "Ils franchissent la Saire au pont du Vast, longent l’orée des bois de Pépinvast et du Rabey et enfin surplombent la baie de Morsalines."
                            },
                            {
                                "example_id": "191c735e-8643-492d-aa4f-6022d2352c02",
                                "sense_id": "0fff9745-0712-3d6e-b8b0-92c92c5efb09",
                                "text": "Indifférent à un gamin qui pêchait non loin de là à la vermée, au bord de la rivière aux eaux calmes, indifférent aussi au pittoresque du vieux pont de Saire, où les faux saulniers d’antan pratiquaient la contrebande en pleine nuit, il ne pouvait se retenir d’un long retour vers ce passé lointain."
                            }
                        ]
