                                "target_senses": [
                                    {
                                        "sense_id": "ff2fce4b-09e5-3285-9ab4-f995c9315af9",
                                        "entry_id": "3466e70a-b338-3489-9c01-bae412e5b607",
                                        "glosses": [
                                            "The second-largest city in Estonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc09c40a-44d2-492e-90dc-1823e55c20d7",
                                                "sense_id": "ff2fce4b-09e5-3285-9ab4-f995c9315af9",
                                                "text": "Even though teacher training has been completely overhauled at Tartu University to place more emphasis on how to teach students critical thinking and communication and less on content knowledge, officials there say it’s taking a while to trickle down into the classroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "308c8af6-23a2-49e4-bee8-30fe7379501b",
                        "source_entry_id": "edfe684d-8b70-35b6-8623-4c1aa89cbae4",
                        "source_sense_id": "e6e63b64-7704-3782-96f4-76ec329888d2",
                        "target_lang_word": "Tartu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1aba918b-6cb2-448d-b377-a249aa193609",
                        "source_entry_id": "edfe684d-8b70-35b6-8623-4c1aa89cbae4",
                        "source_sense_id": "e6e63b64-7704-3782-96f4-76ec329888d2",
                        "target_lang_word": "Dorpat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorpat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                        "entry_id": "5d37fbc9-9d67-3885-b582-095bf01b3335",
                                        "glosses": [
                                            "Estlands zweitgrößte Stadt am Fluss Embach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590da024-977d-441f-885b-7eb50c78fda8",
                                                "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                                "text": "Dorpat ist eine typische Studentenstadt."
                                            },
                                            {
                                                "example_id": "7c4d5af0-651e-45a3-a843-d6afb65f5338",
                                                "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                                "text": "„Vor Dorpat warteten ein Dutzend Journalisten sowie die gesamte naturwissenschaftliche Fakultät.“"
                                            },
                                            {
                                                "example_id": "eb21607f-d3bd-49e6-aae8-288ef754ae54",
                                                "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                                "text": "„Fast im Geistreichen noch liegt die Diagnose des alten Holst zu Dorpat.“"
                                            },
                                            {
                                                "example_id": "f27b439f-c412-4978-90f6-6c330758941f",
                                                "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                                "text": "„Da ist zum Beispiel die Geschichte von jener Stütze der Hausfrau auf dem baltischen Gutshof, die sich von dem alten, etwas zynischen Geheimrat in Dorpat untersuchen läßt.“"
                                            },
                                            {
                                                "example_id": "644eec16-e029-492e-83d2-b300a75e1b4b",
                                                "sense_id": "6c014cf9-612a-3784-9945-b4b30da4879e",
                                                "text": "„Ab Herbst 1941 wurden dann Ostland-Marken verwendet. Die in Dorpat herausgegebene Ausgabe der Estland-Marken war bis 31.3.1942 frankaturgültig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6735429d-a781-4ae6-8aea-d4a607f8fc61",
                        "source_entry_id": "edfe684d-8b70-35b6-8623-4c1aa89cbae4",
