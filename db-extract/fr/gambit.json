        "fr-extract.jsonl": [
            {
                "entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                "word": "gambit",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "694eb7e2-4f1d-4be0-8a2c-c6fda6c6919c",
                        "entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "tags": [
                            "plural"
                        ],
                        "form": "gambits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d9320e3-edf5-3370-9f92-be805832037c",
                        "entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "glosses": [
                            "Sacrifice d’une pièce en vue d’obtenir un avantage positionnel."
                        ],
                        "tags": [],
                        "note": "Le terme est utilisé aux échecs et au jeu de dames",
                        "examples": [
                            {
                                "example_id": "8c04335d-6685-4e84-bcb6-09f9d796cf99",
                                "sense_id": "1d9320e3-edf5-3370-9f92-be805832037c",
                                "text": "Il en était à se dire qu’il pouvait bien laisser Frolov manger son pion en F6 avec sa tour si c’est ce qu’il voulait, que le gambit en valait la peine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed82f699-8494-3779-a9fe-07509866aef1",
                        "entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "glosses": [
                            "Type d’ouverture présentant un tel sacrifice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9354dd7-0724-41d8-b26d-1a2b5349ea65",
                                "sense_id": "ed82f699-8494-3779-a9fe-07509866aef1",
                                "text": "Aux échecs, un gambit peut être accepté, si la pièce offerte est prise, sinon il est refusé."
                            },
                            {
                                "example_id": "b3e8b85c-71c3-4d44-bd6c-431e8459883a",
                                "sense_id": "ed82f699-8494-3779-a9fe-07509866aef1",
                                "text": "Chaque pièce [de l'échiquier] a son gambit qui porte son nom, de sorte que Palamède, Tamerlan, Alexandre de Macédoine, Parménion, Sésostris, Confucius, Mahomet, Sélim II, Lusignan, Charlemagne, Renaud de Montauban, Lancelot, François Ier, Charles-Quint..., tous ces grands hommes qui avaient de si hautes prétentions à la science de l’échiquier, tomberaient morts de surprise aujourd’hui s’ils ressuscitaient seulement devant le gambit du capitaine Évans [1790-1872]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08c9e514-a60b-4f2d-ba56-c17061e82833",
                        "source_entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "target_lang_word": "Gambit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gambit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc362b14-347e-33ee-8b52-d276315aabc4",
                                        "entry_id": "de5264bf-a8c9-36cd-a5c5-9e3433e46b62",
                                        "glosses": [
                                            "ein Bauern- oder (seltener) Figurenopfer in der Eröffnung mit dem Ziel, den Materialverlust durch daraus resultierende Vorteile wie Entwicklungsvorsprung und damit die Möglichkeit, schnell einen Angriff starten zu können, zu kompensieren"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfc323d-e048-4ed1-ac2a-007a8cbb7d9b",
                                                "sense_id": "dc362b14-347e-33ee-8b52-d276315aabc4",
                                                "text": "„Bis zur zehnten Begegnung war es ja tatsächlich Anand, der die Neuerungen servierte, nur sind eben die allerwenigsten so zwangsläufig und effizient gewesen wie Kasparows Gambit.“"
                                            },
                                            {
                                                "example_id": "a62ae2ba-e289-4e68-be69-f26b615fd594",
                                                "sense_id": "dc362b14-347e-33ee-8b52-d276315aabc4",
                                                "text": "„Schwarz bringt in allerfrühestem Stadium ein Bauernopfer, und zwar nicht eines der bekannten Gambits, sondern ein ‚frei erfundenes‘ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1507da-7790-4386-bad4-bf45bd572e6c",
                        "source_entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "target_lang_word": "gambit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gambit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0c7e2a-79e0-35b2-a3fc-ceb34d1c0e6f",
                                        "entry_id": "7dc91d6f-3c9a-30a4-ac90-e870b1d03e3e",
                                        "glosses": [
                                            "An opening in chess in which a minor piece or a pawn is sacrificed to gain an advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "086aaf72-a64c-4a72-a014-d7bd842b88ec",
                                                "sense_id": "dc0c7e2a-79e0-35b2-a3fc-ceb34d1c0e6f",
                                                "text": "Her clever gambit gave her an advantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ea502a-0c62-308a-bc1c-6c6c48bb6d64",
                                        "entry_id": "7dc91d6f-3c9a-30a4-ac90-e870b1d03e3e",
                                        "glosses": [
                                            "Any ploy or stratagem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d11b009-4501-4cad-a810-6ddbd8f97adc",
                                                "sense_id": "58ea502a-0c62-308a-bc1c-6c6c48bb6d64",
                                                "text": "Their promise to lower taxes is clearly an election-year gambit."
                                            },
                                            {
                                                "example_id": "16e1f596-2e3c-4556-9229-446760cffdce",
                                                "sense_id": "58ea502a-0c62-308a-bc1c-6c6c48bb6d64",
                                                "text": "The Red Holocaust is best interpreted in this light as the bitter fruit of an^([sic]) utopian gambit that was socially misengineered into a dystopic nightmare by despots in humanitarian disguise."
                                            },
                                            {
                                                "example_id": "6f49bb05-11b5-4429-b33a-dedb3a4741a6",
                                                "sense_id": "58ea502a-0c62-308a-bc1c-6c6c48bb6d64",
                                                "text": "An opening sequence, featuring a de-aged Ford playing a younger Indy, is a bold and nostalgic gambit, offering a glimpse of what you've missed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47e584a-8b8a-30d9-a0c7-32bb1d6b0c95",
                                        "entry_id": "7dc91d6f-3c9a-30a4-ac90-e870b1d03e3e",
                                        "glosses": [
                                            "A remark intended to open a conversation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
