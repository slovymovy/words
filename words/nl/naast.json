                        },
                        {
                            "text": "Ze spreekt <w>naast</w> Nederlands ook vloeiend Engels en Frans.",
                            "target_lang_translations": {
                                "ru": "<w>Кроме</w> нидерландского, она также свободно говорит по-английски и по-французски.",
                                "en": "<w>In addition to</w> Dutch, she also speaks fluent English and French.",
                                "pl": "<w>Poza</w> niderlandzkim mówi również płynnie po angielsku i francusku.",
                                "de": "Sie spricht <w>neben</w> Niederländisch auch fließend Englisch und Französisch.",
                                "fr": "Elle parle couramment l'anglais et le français, <w>outre</w> le néerlandais.",
                                "it": "Parla correntemente inglese e francese, <w>oltre all'</w>olandese.",
                                "cs": "<w>Kromě</w> nizozemštiny mluví také plynule anglicky a francouzsky.",
                                "tr": "Hollandacanın <w>yanında</w> akıcı bir şekilde İngilizce ve Fransızca da konuşuyor.",
                                "es": "Ella habla, <w>además de</w> neerlandés, inglés y francés con fluidez."
