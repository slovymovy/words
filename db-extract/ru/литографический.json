                "senses": [
                    {
                        "sense_id": "0f1fa4e2-42e4-3fa6-b962-5c49dea24578",
                        "entry_id": "298bbf9c-a373-32ce-9e13-b09fbfea9333",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным литография"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600762fe-9cfd-4517-b96a-3724b0c235f8",
                                "sense_id": "0f1fa4e2-42e4-3fa6-b962-5c49dea24578",
                                "text": "Чтобы построить литографический процесс на более чем в 10 раз меньшей длине волны, требуется пересмотреть всю технологию."
                            }
                        ]
                    },
                    {
                        "sense_id": "b94187a2-60f4-3b6c-939a-448a746cfd6e",
                        "entry_id": "298bbf9c-a373-32ce-9e13-b09fbfea9333",
                        "glosses": [
                            "сделанный посредством литографирования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12a8c03-62c9-4319-ba08-b307c75f8360",
                                "sense_id": "b94187a2-60f4-3b6c-939a-448a746cfd6e",
                                "text": "Было несколько литографических портретов русских современных и прежних архиереев, но уже по другим стенам."
                            }
                        ]
                    }
