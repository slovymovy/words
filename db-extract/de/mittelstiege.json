                "senses": [
                    {
                        "sense_id": "cd1aef4c-f786-3266-b28b-947639924c58",
                        "entry_id": "0beeb7ef-f75c-318e-b446-0e5347427ee6",
                        "glosses": [
                            "zentrale Möglichkeit zum Auf- und Abstieg zwischen Geschoßen in einem Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f8b77c-b583-4b40-92e6-32928f2e4ab7",
                                "sense_id": "cd1aef4c-f786-3266-b28b-947639924c58",
                                "text": "„Im Februar 1945 durchschlug eine Bombe das Dach der Mittelstiege.“"
                            },
                            {
                                "example_id": "586a74fe-67b0-4cd1-84e0-c7dfeca24681",
                                "sense_id": "cd1aef4c-f786-3266-b28b-947639924c58",
                                "text": "„Die Mittelstiege führt aus dem Vestibül zu den oberen Stockwerken; sie ist in jeder halben Stockwerkshöhe durch einen Wendeplatz unterbrochen und erhält in jedem Stockwerke Licht durch zwei Fenster von der Hofseite.“"
                            },
                            {
                                "example_id": "715be43a-2943-44e4-825a-1b36cf97533d",
                                "sense_id": "cd1aef4c-f786-3266-b28b-947639924c58",
                                "text": "„Von da ein [sic!] Stock abwärts in die mechanische Abtheilung, in die Chemitypie; dann in den Setzersaal für alle fremden Sprachen, über die eiserne Mittelstiege nach dem Singerstrassentrakte in die beiden Setzersäle für ämtliche [?] Arbeiten, ferner in den Setzersaal für das Reichsgesetzblatt.“"
                            },
                            {
                                "example_id": "ca02799b-a0a1-4c7f-9f49-06c514f881a9",
                                "sense_id": "cd1aef4c-f786-3266-b28b-947639924c58",
                                "text": "„Der Aufstieg über die Mittelstiege, die vielen Etagen und zahlreichen Räume und natürlich die Suche nach dem perfekten Kleid: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
