{
    "word_family": [
        "custody",
        "custodial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "908ab38e-ec96-36b4-a80f-86afeac4395c",
                    "sense_definition": "A person responsible for the care or protection of something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guardian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum <w>custodian</w> ensures that all the historical artifacts are kept in perfect condition.",
                            "target_lang_translations": {
                                "zh": "博物馆的<w>保管人</w>确保所有历史文物都处于完好状态。"
                            }
                        },
                        {
                            "text": "She acts as a <w>custodian</w> of the family estate, managing the property for future generations.",
                            "target_lang_translations": {
                                "zh": "她担任家族产业的<w>管理人</w>，为后代打理这些房产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caretaker",
                        "guardian",
                        "keeper"
                    ],
                    "common_phrases": [
                        "custodian of records",
                        "custodian of assets"
                    ],
                    "target_lang_definitions": {
                        "zh": "负责照看或保护某物或某人的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保管人",
                                "target_lang_sense_clarification": "指负责保管财物或资产的人。"
                            },
                            {
                                "target_lang_word": "监护人",
                                "target_lang_sense_clarification": "指负责照看或保护某人的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50e33cb4-d1ec-306b-ad5a-4b43d8bcafa2",
                    "sense_definition": "A person employed to clean and maintain a building.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school <w>custodian</w> cleaned the hallways after the students left for the day.",
                            "target_lang_translations": {
                                "zh": "学生放学后，学校的<w>管理员</w>打扫了走廊。"
                            }
                        },
                        {
                            "text": "If you spill something in the cafeteria, please notify the <w>custodian</w> immediately.",
                            "target_lang_translations": {
                                "zh": "如果你在食堂洒了东西，请立即通知<w>清洁工</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "janitor",
                        "cleaner"
                    ],
                    "common_phrases": [
                        "school custodian",
                        "building custodian"
                    ],
                    "target_lang_definitions": {
                        "zh": "受雇负责清洁和维护建筑物的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "管理员",
                                "target_lang_sense_clarification": "指负责建筑物日常维护和管理的人。"
                            },
                            {
                                "target_lang_word": "清洁工",
                                "target_lang_sense_clarification": "指专门负责打扫卫生的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06abc6f9-7c0f-3b98-babe-bd5cb27814d7",
                    "sense_definition": "A person who protects or guards something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "guardian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community acts as a <w>custodian</w> of the forest, preventing illegal logging activities.",
                            "target_lang_translations": {
                                "zh": "当地社区作为森林的<w>守护者</w>，阻止非法砍伐活动。"
                            }
                        },
                        {
                            "text": "He considers himself a <w>custodian</w> of traditional values in a rapidly changing world.",
                            "target_lang_translations": {
                                "zh": "在这个瞬息万变的世界里，他认为自己是传统价值的<w>守护者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "protector",
                        "guard",
                        "defender"
                    ],
                    "target_lang_definitions": {
                        "zh": "保护或守护某事物的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "守护者",
                                "target_lang_sense_clarification": "指保护某种价值、传统或自然资源的人。"
                            },
                            {
                                "target_lang_word": "保护人",
                                "target_lang_sense_clarification": "指致力于维护某事物完整性的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7167b9d8-421c-3ce5-912a-175cf3a2d9f8",
                    "sense_definition": "A person who manages or administers an organization or system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administrator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board appointed a new <w>custodian</w> to oversee the financial operations of the foundation.",
                            "target_lang_translations": {
                                "zh": "董事会任命了一位新的<w>管理人</w>来监督基金会的财务运作。"
                            }
                        },
                        {
                            "text": "As the <w>custodian</w> of the trust, he is responsible for distributing funds according to the will.",
                            "target_lang_translations": {
                                "zh": "作为信托的<w>受托人</w>，他负责根据遗嘱分配资金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "administrator",
                        "manager"
                    ],
                    "target_lang_definitions": {
                        "zh": "管理或行政管理组织或系统的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "管理人",
                                "target_lang_sense_clarification": "指负责管理信托或基金等资产的人。"
                            },
                            {
                                "target_lang_word": "受托人",
                                "target_lang_sense_clarification": "指法律上负责管理他人财产的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "641a1af0-c63c-389d-830f-4917f2c56cc7",
                    "sense_definition": "A player whose role is to prevent the ball from entering the goal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's <w>custodian</w> made an incredible save in the final minute of the match.",
                            "target_lang_translations": {
                                "zh": "在比赛的最后一分钟，球队的<w>守门员</w>完成了一次精彩的扑救。"
                            }
                        },
                        {
                            "text": "Being a <w>custodian</w> requires quick reflexes and excellent communication with the defense.",
                            "target_lang_translations": {
                                "zh": "担任<w>守门员</w>需要敏捷的反应，并与后防线保持良好的沟通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goalkeeper",
                        "goalie"
                    ],
                    "target_lang_definitions": {
                        "zh": "在体育比赛中负责防止球进入球门的角色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "守门员",
                                "target_lang_sense_clarification": "足球等运动中负责防守球门的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}