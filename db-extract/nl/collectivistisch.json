                "senses": [
                    {
                        "sense_id": "bcc3ab6e-4722-3411-8c66-99996ce78735",
                        "entry_id": "9003e7bd-29a2-363f-b64c-ca7cd0db842f",
                        "glosses": [
                            "gericht zijn op de gemeenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb11458f-1e8e-4126-bbb9-2f5fc603121a",
                                "sense_id": "bcc3ab6e-4722-3411-8c66-99996ce78735",
                                "text": "De moskeebestuurder, die hij bij een iftar-maaltijd had leren kennen, had tegen hem gezegd dat het mooie collectivistische leven stond of viel met de bereidheid van de mens om het eigen geluk op te offeren voor het belang van de gemeenschap, de staat, de kerk, de Diyanet en de familie."
                            },
                            {
                                "example_id": "7af64233-aa10-4913-a7b0-ae4fd9f73017",
                                "sense_id": "bcc3ab6e-4722-3411-8c66-99996ce78735",
                                "text": "De auteurs vinden echter meer bewijs: het tit-for-tat gedrag is sterker in landen met een collectivistische cultuur en in relatief arme landen."
                            },
                            {
                                "example_id": "e03b711a-4a67-4b3a-a82e-3814da61345d",
                                "sense_id": "bcc3ab6e-4722-3411-8c66-99996ce78735",
                                "text": "Maar hoe breng je mensen uit een collectivistische of tribale religieuze cultuur de eigenschappen bij die noodzakelijk zijn voor het bestaan in een moderne, tolerante, en uiterst vrijzinnige verzorgingsstaat?"
                            },
                            {
                                "example_id": "9e9a0f38-e6f8-451b-94eb-4771a633f735",
                                "sense_id": "bcc3ab6e-4722-3411-8c66-99996ce78735",
                                "text": "Televisie, radio en de gedrukte media zijn collectivistisch, bieden vaste structuren en duwen consumenten in een passieve rol."
                            }
                        ]
                    }
