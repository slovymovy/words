                "senses": [
                    {
                        "sense_id": "d0698908-c5c4-3270-acfa-d3a23563f5d7",
                        "entry_id": "618dd6be-99e6-302d-a139-b427e61faccb",
                        "glosses": [
                            "Fortbewegung mit einem Fahrzeug unter der Wasseroberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f0eca2-050e-4ff0-b85b-1fc154b22ae6",
                                "sense_id": "d0698908-c5c4-3270-acfa-d3a23563f5d7",
                                "text": "„Für die Unterwasserfahrt setzte man auf ebenso starke Elektromotoren.“"
                            },
                            {
                                "example_id": "ca8fda94-a60a-4185-a70d-8ee297995c72",
                                "sense_id": "d0698908-c5c4-3270-acfa-d3a23563f5d7",
                                "text": "„Die ruhige Unterwasserfahrt während des täglichen Prüfungstauchens wird im Bugraum zum Regeln der Torpedos genutzt.“"
                            },
                            {
                                "example_id": "7af97a18-95d2-4b94-bf9f-ac0f63752251",
                                "sense_id": "d0698908-c5c4-3270-acfa-d3a23563f5d7",
                                "text": "„Wichers erhielt 1927 ein Patent für einen Luftmast, der bei Unterwasserfahrt auf Sehrohrtiefe eine gute Bootsbelüftung garantieren sollte.“"
                            },
                            {
                                "example_id": "24bd01d1-1f8f-4a00-81f9-0e727d225678",
                                "sense_id": "d0698908-c5c4-3270-acfa-d3a23563f5d7",
                                "text": "„Bei Unterwasserfahrt ging es jedoch oft an die Höchstbelastungsgrenze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
