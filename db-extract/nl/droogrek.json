                ],
                "senses": [
                    {
                        "sense_id": "daa480ac-ec23-3508-a605-004d28d45f68",
                        "entry_id": "eb3c3257-d7f6-3924-a447-1452b6f9680b",
                        "glosses": [
                            "constructie met horizontale spijlen bestemd om door verdamping het vocht uit voorwerpen te verwijderen, door ze op deze spijlen te leggen of ze ervanaf te laten hangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f35868-522f-4776-924d-298e1d042eaf",
                                "sense_id": "daa480ac-ec23-3508-a605-004d28d45f68",
                                "text": "In april 2012 besloot hij in zijn huis een hennepkwekerij te beginnen. Hij richtte een professionele kweekruimte in en droogde de planten op droogrekken in de gang en slaapkamer."
                            },
                            {
                                "example_id": "2051babb-e1fe-4397-9f36-417a6c17ab4b",
                                "sense_id": "daa480ac-ec23-3508-a605-004d28d45f68",
                                "text": "Er is met huisvlijtpasta nog iets wonderlijks. Na het persen van de lap en het draaien van brede of smalle slierten, moet de pasta aan de waslijn of op een droogrek, Waarom? Om te drogen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5f1a454-f394-3ad8-bd54-7f2f3fe9c9a0",
                        "entry_id": "eb3c3257-d7f6-3924-a447-1452b6f9680b",
                        "glosses": [
                            "constructie met horizontale spijlen bestemd om door verdamping het vocht uit voorwerpen te verwijderen, door ze op deze spijlen te leggen of ze ervanaf te laten hangen",
                            "gebruikt om gewassen wasgoed op te hangen zodat het kan drogen"
                        ],
                        "tags": [
                            "pregnant",
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "07f1e81d-8074-4b36-bf1d-a74b2dced123",
                                "sense_id": "f5f1a454-f394-3ad8-bd54-7f2f3fe9c9a0",
                                "text": "In april 2012 besloot hij in zijn huis een hennepkwekerij te beginnen. Hij richtte een professionele kweekruimte in en droogde de planten op droogrekken in de gang en slaapkamer."
                            },
                            {
                                "example_id": "13a9ef7b-c714-4320-bf14-9d74c6e389d5",
                                "sense_id": "f5f1a454-f394-3ad8-bd54-7f2f3fe9c9a0",
                                "text": "Er is met huisvlijtpasta nog iets wonderlijks. Na het persen van de lap en het draaien van brede of smalle slierten, moet de pasta aan de waslijn of op een droogrek, Waarom? Om te drogen."
                            },
                            {
                                "example_id": "05b23dc4-44bd-45c7-a303-14d4af5f2092",
                                "sense_id": "f5f1a454-f394-3ad8-bd54-7f2f3fe9c9a0",
                                "text": "Aan de keukendeur, die open staat en de woonkamer in draait, hangt een droogrek met kleren die bungelen op de kruin van moeder wanneer zij, zoals nu, aan de eettafel zit."
                            },
                            {
                                "example_id": "e6824715-1ae0-4fe0-8d3b-c1d204801dd9",
                                "sense_id": "f5f1a454-f394-3ad8-bd54-7f2f3fe9c9a0",
                                "text": "Een deel van het winkeloppervlak van het concern bestaat uit interieurs van nagebouwde huisjes, en ingeklemd tussen een overvolle badkamer en een tot aan het plafond toe volgestouwde slaapkamer bevond zich een smalle wasruimte met daarin een wasmachine en een droger ordelijk zij aan zij. Aan de muur hing een in te klappen droogrek, de strijkplank was opgeborgen tegen de muur, de strijkbout hing aan een speciale houder, wasmiddelen waren weggestopt in een apart kastje. Onder een brede vouwplank stonden drie manden voor witte, bonte en fijne was."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e8cc520-c23a-33eb-963b-8ba36300d4ac",
                        "entry_id": "eb3c3257-d7f6-3924-a447-1452b6f9680b",
                        "glosses": [
                            "constructie met horizontale spijlen bestemd om door verdamping het vocht uit voorwerpen te verwijderen, door ze op deze spijlen te leggen of ze ervanaf te laten hangen",
                            "gebruikt om gewassen vaat in te zetten zodat het kan drogen"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "418dae90-bba1-45d7-a4e8-438059143824",
                                "sense_id": "9e8cc520-c23a-33eb-963b-8ba36300d4ac",
                                "text": "In april 2012 besloot hij in zijn huis een hennepkwekerij te beginnen. Hij richtte een professionele kweekruimte in en droogde de planten op droogrekken in de gang en slaapkamer."
                            },
                            {
                                "example_id": "29d6f1cb-b5ba-46f4-ad5f-08d34511df30",
                                "sense_id": "9e8cc520-c23a-33eb-963b-8ba36300d4ac",
                                "text": "Er is met huisvlijtpasta nog iets wonderlijks. Na het persen van de lap en het draaien van brede of smalle slierten, moet de pasta aan de waslijn of op een droogrek, Waarom? Om te drogen."
                            },
                            {
                                "example_id": "e31a2b67-efa5-4baa-a9f3-a1c7818bcdbd",
                                "sense_id": "9e8cc520-c23a-33eb-963b-8ba36300d4ac",
                                "text": "Een ander project gaat om afwasrekjes. „Ik vind afwassen niet leuk, maar wel als ik er iets van kan bouwen.” Hij maakt dan een constructie van de schone vaat in het droogrek."
                            },
                            {
                                "example_id": "bfbb001c-0fb2-4762-8cdd-89378a88f945",
                                "sense_id": "9e8cc520-c23a-33eb-963b-8ba36300d4ac",
                                "text": "Als Nederlanders gaan afwassen, gaan ze meteen afwassen, afdrogen en alles in de kast zetten. In Portugal laat je dingen gewoon op het droogrek hangen."
                            }
                        ]
                    }
                ],
