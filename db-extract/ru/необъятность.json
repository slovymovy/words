                    },
                    {
                        "translation_id": "676f3e19-2b9b-40ee-a91e-9462a9f0958b",
                        "source_entry_id": "4f9a0e2b-7810-3ad8-9759-84ac8d169a5e",
                        "source_sense_id": "36865ced-f7ce-3604-b7e0-f4f5f3819b30",
                        "target_lang_word": "boundlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boundlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f7ca431-b009-3a24-8dec-92b958a8b5d1",
                                        "entry_id": "89768ebc-06d9-3884-8e18-2e946cdfcb99",
                                        "glosses": [
                                            "The property of being boundless, of being without limits or ends."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfba2043-298c-411e-b411-4f8e051920ac",
                                                "sense_id": "3f7ca431-b009-3a24-8dec-92b958a8b5d1",
                                                "text": "The boundlessness of the night sky mocks our sense of scale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "185f77e6-3903-4ae1-9757-b72a8416c2b1",
                        "source_entry_id": "4f9a0e2b-7810-3ad8-9759-84ac8d169a5e",
                        "source_sense_id": "36865ced-f7ce-3604-b7e0-f4f5f3819b30",
                        "target_lang_word": "Immensität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immensität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "907664f0-83a5-371c-a78b-826fa15478d0",
                                        "entry_id": "f90241fc-a0ef-3fad-b4d1-e5cacff5cc7b",
                                        "glosses": [
                                            "Eigenschaft, in deutlichem Maße riesige, nicht endende (immense) Dimensionen zu zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8366c32-0ac4-45ef-a242-1b5cf6ff04f6",
                                                "sense_id": "907664f0-83a5-371c-a78b-826fa15478d0",
                                                "text": "„Die Immensität des Verbrechens ist in zahlreichen dokumentarischen Werken nachlesbar.“"
                                            },
                                            {
                                                "example_id": "b40e650f-57a5-4d59-a066-6e2d4bb9691e",
                                                "sense_id": "907664f0-83a5-371c-a78b-826fa15478d0",
                                                "text": "„Vermöge dieser Immensität ist die göttliche Substanz überall hin verbreitet; nicht allein im Weltall, sondern unendlich weit darüber hinaus.“ (1896)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "689fd036-d398-4c51-80db-ec3376cfc3bf",
                        "source_entry_id": "4f9a0e2b-7810-3ad8-9759-84ac8d169a5e",
                        "source_sense_id": "36865ced-f7ce-3604-b7e0-f4f5f3819b30",
                        "target_lang_word": "immensité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immensité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc44b84-1052-324f-9d6f-90d0b55c99a8",
                                        "entry_id": "d421a82d-febd-3aa0-97a5-4968db4b4d2f",
                                        "glosses": [
                                            "Espace sans bornes ; état de ce qui est immense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829bacde-e962-437d-b92f-9d18fd944756",
                                                "sense_id": "7dc44b84-1052-324f-9d6f-90d0b55c99a8",
                                                "text": "Au milieu de l’insondable obscurité, dont s’enveloppe le Kara-Koum, j’éprouve l’impression que donne l’immensité nocturne de la mer autour d’un navire."
                                            },
                                            {
                                                "example_id": "4afd3649-1789-4d11-94ab-0be22c50d099",
                                                "sense_id": "7dc44b84-1052-324f-9d6f-90d0b55c99a8",
                                                "text": "Là-bas, ils ne verront plus que les immensités interdites aux pas des hommes : le ciel et l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99561b11-d98d-3608-b047-9ec6d0fa4b9b",
                                        "entry_id": "d421a82d-febd-3aa0-97a5-4968db4b4d2f",
                                        "glosses": [
                                            "Espace sans bornes ; état de ce qui est immense.",
                                            "Grandeur infinie, sans bornes, en parlant de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f10ca3-874e-4886-ada5-24699cbf5046",
                                                "sense_id": "99561b11-d98d-3608-b047-9ec6d0fa4b9b",
                                                "text": "L’immensité est un attribut de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f58527c-e606-3853-9a46-ccd73443874e",
                                        "entry_id": "d421a82d-febd-3aa0-97a5-4968db4b4d2f",
                                        "glosses": [
                                            "Très vaste étendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7ec896-01f0-48ac-82d4-faa052834f92",
                                                "sense_id": "2f58527c-e606-3853-9a46-ccd73443874e",
                                                "text": "Ces infortunés, depuis les temps les plus anciens, se sont évertués à épierrer ces immensités du Causse, ces plateaux calcaires."
                                            },
                                            {
                                                "example_id": "46e4a978-72fa-4180-a28d-61a6518f0da2",
                                                "sense_id": "2f58527c-e606-3853-9a46-ccd73443874e",
                                                "text": "A quoi peut-on songer lorsque l'on s'engage sur une immensité aussi vaste que celle de l'Atlantique Nord?"
                                            },
                                            {
                                                "example_id": "f88daa94-a7e1-48ad-b72f-cf851f80acc0",
                                                "sense_id": "2f58527c-e606-3853-9a46-ccd73443874e",
                                                "text": "Le navire imperturbable cingle vers l'immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a53327-cfea-3b9c-99f6-5e2aaef779c4",
                                        "entry_id": "d421a82d-febd-3aa0-97a5-4968db4b4d2f",
                                        "glosses": [
                                            "Ce qui est très considérable dans son genre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9d0684-e87d-433e-9e3d-c8ecec7c6987",
                                                "sense_id": "a3a53327-cfea-3b9c-99f6-5e2aaef779c4",
                                                "text": "L’immensité de ses richesses, de sa fortune."
                                            },
                                            {
                                                "example_id": "4c0a8945-9460-43e3-b0ee-880d56735ed4",
                                                "sense_id": "a3a53327-cfea-3b9c-99f6-5e2aaef779c4",
                                                "text": "Rien ici-bas ne peut répondre à l’immensité de nos désirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aba7d85a-d7ff-4c86-9263-8dcac264b425",
                        "source_entry_id": "4f9a0e2b-7810-3ad8-9759-84ac8d169a5e",
                        "source_sense_id": "36865ced-f7ce-3604-b7e0-f4f5f3819b30",
                        "target_lang_word": "infini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28be53c8-0fc6-307e-8813-b67d481d6fa4",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Qui n’a ni commencement ni fin, qui est sans bornes et sans limites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740f1a49-462b-41f6-84c1-d361dc3f054c",
                                                "sense_id": "28be53c8-0fc6-307e-8813-b67d481d6fa4",
                                                "text": "Ne revenez plus, monsieur, autrement vous tueriez aussi la mère, car la puissance de Dieu est infinie, mais la nature humaine a ses limites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd5d406-bd05-3dcc-922a-874eac8d99a5",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Qui ne doit pas avoir de fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fedfa8-a537-4c45-80a8-bbe363b1b36b",
                                                "sense_id": "9dd5d406-bd05-3dcc-922a-874eac8d99a5",
                                                "text": "La gloire, la béatitude infinie des saints."
                                            },
                                            {
                                                "example_id": "0e8cdbcf-ee95-46dd-a3fa-ddd71f47237a",
                                                "sense_id": "9dd5d406-bd05-3dcc-922a-874eac8d99a5",
                                                "text": "Il faut une infinie patience pour attendre toujours ce qui n’arrive jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f884eb-eea3-3881-bda0-6d32e744b81a",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Dont on ne peut assigner les bornes, le terme, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f227d51a-69e1-40ed-bd4d-7619f350913d",
                                                "sense_id": "f5f884eb-eea3-3881-bda0-6d32e744b81a",
                                                "text": "Un espace infini. — Une durée infinie."
                                            },
                                            {
                                                "example_id": "0e10591b-a216-4c34-9ef5-118df9a2604d",
                                                "sense_id": "f5f884eb-eea3-3881-bda0-6d32e744b81a",
                                                "text": "Le silence éternel de ces espaces infinis m’effraie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Qui est très considérable en son genre, tant au sens physique qu’au sens moral."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c159f65-3183-46bb-bf8b-50424fd4b019",
                                                "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                                                "text": "Très intrigué, j’allais quérir une échelle ; je l’appliquai contre le mur et montai avec d’infinies précautions..."
                                            },
                                            {
                                                "example_id": "15f95342-0672-437b-8699-76e5fdaa6fd8",
                                                "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                                                "text": "– Bigre ! — s’écria-t-il, avec un sentiment d’infinie vexation. — Quel idiot je suis ! J’aurais dû leur faire rendre leurs épées…"
                                            },
                                            {
                                                "example_id": "ad54bcd2-6c90-4034-ad64-127e5d0b4aa3",
                                                "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                                                "text": "La plupart des astres sont placés à une distance infinie."
                                            },
                                            {
                                                "example_id": "0f569596-da1f-4571-9253-5be4ef855130",
                                                "sense_id": "55d22f8b-430a-3bf1-828b-ed749d1710f6",
                                                "text": "Cette jeune fille a une grâce infinie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf02783-5431-3e68-a275-3e03a621a5f7",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Innombrable, incommensurable."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16ad05b-52c6-41e7-95c3-d4188fe00b8b",
                                                "sense_id": "baf02783-5431-3e68-a275-3e03a621a5f7",
                                                "text": "Il y a un nombre infini d’auteurs qui ont écrit sur ce sujet."
                                            },
                                            {
                                                "example_id": "ddad5aa1-0af7-4ae8-a769-ff6696850154",
                                                "sense_id": "baf02783-5431-3e68-a275-3e03a621a5f7",
                                                "text": "Une infinie variété d’objets."
                                            },
                                            {
                                                "example_id": "9251ac7b-6079-49b2-bbb4-97d08e85470c",
                                                "sense_id": "baf02783-5431-3e68-a275-3e03a621a5f7",
                                                "text": "Des peines infinies."
                                            },
                                            {
                                                "example_id": "c8386639-e904-4477-bbb8-9d2ee30323c7",
                                                "sense_id": "baf02783-5431-3e68-a275-3e03a621a5f7",
                                                "text": "Je vous ai des obligations infinies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ad3d1c-6708-3f30-9731-b1a75bfc30a2",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Qui est plus grand que n’importe quelle grandeur proposée ; qui est plus nombreux que n’importe quelle multitude proposée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51748b84-24aa-3e53-acc1-8aa6edc125ad",
                                        "entry_id": "060d5a6f-08aa-3a28-8d0e-0cdbc5b8fa48",
                                        "glosses": [
                                            "Qui est équipotent ou de même cardinal que l’un de ses sous-ensembles propres, en parlant d’un ensemble."
                                        ],
                                        "tags": [
                                            "Théorie des ensembles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e92a690d-c3be-4753-bb47-4b1023abe307",
                                                "sense_id": "51748b84-24aa-3e53-acc1-8aa6edc125ad",
                                                "text": "L’ensemble ℕ des entiers naturels est infini, équipotent par exemple à son sous-ensemble des entiers naturels pairs."
                                            },
                                            {
                                                "example_id": "2c7508ea-d5b7-4139-b7ef-bebbabdda839",
                                                "sense_id": "51748b84-24aa-3e53-acc1-8aa6edc125ad",
                                                "text": "D’une façon générale on dit que des objets sont en nombre infini, lorsque le nombre de ces objets dépend du nombre des entiers, de façon que ce dernier augmentant suffisamment, le premier augmente."
                                            },
                                            {
                                                "example_id": "5e26a359-0119-4320-84fb-2dab5a539cda",
                                                "sense_id": "51748b84-24aa-3e53-acc1-8aa6edc125ad",
                                                "text": "Souvent on considère l’ensemble fini ou infini de tous les nombres qui satisfont à certaines conditions précises."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11315fe5-36b3-3800-a658-1d43394f8943",
                                        "entry_id": "21a5f228-a8fa-3446-9a92-ca76a4955cc0",
                                        "glosses": [
                                            "Ce que l’on suppose sans limites, en parlant des choses divines."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f7e880-60e9-465c-9de7-437a2204101b",
                                                "sense_id": "11315fe5-36b3-3800-a658-1d43394f8943",
                                                "text": "L’homme ne peut bien concevoir l’infini."
                                            },
                                            {
                                                "example_id": "6fbbc672-05da-4d8d-8f7e-2e52e2ae65cf",
                                                "sense_id": "11315fe5-36b3-3800-a658-1d43394f8943",
                                                "text": "Exister en tant qu'individu libre, face à l'infini et à la mort, tel a été et tel est le lot de chacun des vivants qui m'ont précédé ou qui m'accompagnent aujourd'hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ab9f63-5149-3a04-a261-e49f1089bdbe",
                                        "entry_id": "21a5f228-a8fa-3446-9a92-ca76a4955cc0",
                                        "glosses": [
                                            "Concept pour désigner ce qui est supérieur à tout nombre réel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e4c3362-d511-461d-b0f5-41663fb3fd5d",
                                                "sense_id": "d5ab9f63-5149-3a04-a261-e49f1089bdbe",
                                                "text": "Pour démontrer cette proposition, nous supposerons d'abord que le nombre m tend vers l’infini en ne prenant que des valeurs entières et positives."
                                            },
                                            {
                                                "example_id": "ba505478-b83d-4220-9eb7-fd5182d65486",
                                                "sense_id": "d5ab9f63-5149-3a04-a261-e49f1089bdbe",
                                                "text": "L’infini est habituellement noté ∞."
                                            },
                                            {
                                                "example_id": "77d75c27-6237-4206-bfb6-f0a7593972b3",
                                                "sense_id": "d5ab9f63-5149-3a04-a261-e49f1089bdbe",
                                                "text": "L’infini ne peut guère conduire qu'à zéro et réciproquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9c1c9a-cf85-3a0f-9123-cdff74fa8c8b",
                                        "entry_id": "21a5f228-a8fa-3446-9a92-ca76a4955cc0",
                                        "glosses": [
                                            "Ce qui n’est pas fini ; ce qui n’a pas de fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e19bdc-b3b1-438b-8ead-5312af044f42",
                                                "sense_id": "9d9c1c9a-cf85-3a0f-9123-cdff74fa8c8b",
                                                "text": "La métaphysique tout entière est attachée à la détermination de l’idée d’infini ; il n’est point de difficulté métaphysique qui ne naisse de l’opposition entre le fini et l’infini."
                                            },
                                            {
                                                "example_id": "32acb8cd-9814-45c2-b401-0d370bfe7865",
                                                "sense_id": "9d9c1c9a-cf85-3a0f-9123-cdff74fa8c8b",
                                                "text": "La borne fut l'entrée de l’Hindostan. Le peuple voyageur se trouva en présence de trois infinis, dont un seul suffisait pour le troubler profondément."
                                            },
                                            {
                                                "example_id": "8b54b633-a062-42f3-bd6f-860b60abe370",
                                                "sense_id": "9d9c1c9a-cf85-3a0f-9123-cdff74fa8c8b",
                                                "text": "Je dois mon premier contact précis avec la notion d’infini à une boîte de cacao de marque hollandaise, matière première de mes petits déjeuners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                        "entry_id": "21a5f228-a8fa-3446-9a92-ca76a4955cc0",
                                        "glosses": [
                                            "Nature, caractère de ce qui ne finit pas, ou semble ne pas finir, de ce qui semble incommensurablement grand, immense, au point qu'on ne peut en apercevoir ou même en concevoir les limites."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a44865-ac2b-42da-9908-53a802ec393a",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "Devant lui, au sommet de la montagne, après une montée harassante, l'horizon s'étendait jusqu'à l’infini."
                                            },
                                            {
                                                "example_id": "c8a7bb12-9746-438e-8c02-4e10df67deef",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "Le silence devient plus dangereux que la parole, en communiquant aux yeux toute la puissance de l’infini des cieux qu’ils reflètent."
                                            },
                                            {
                                                "example_id": "3337b644-0ae2-4351-bf98-6158a6dc6529",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "Du blé, du blé partout, un infini de blé dont la houle d’or roulait d’un bout de l’horizon à l’autre."
                                            },
                                            {
                                                "example_id": "4ef656a8-44e0-46ca-8b96-7ab9fdf16276",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "– Voici les murs de chez moi, le plafond de chez moi, le parquet de chez moi. On ne pense pas assez à ces choses qui nous protègent si humblement mais si sûrement de l’infini qui nous entoure."
                                            },
                                            {
                                                "example_id": "3a3d3569-df46-4dfb-af09-073096bbf20c",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "On eût dit que son regard, triste et lointain comme le regard des hommes qui ont longtemps vécu sur la mer ou dans les solitudes immenses, gardait comme un reflet de l’infini."
                                            },
                                            {
                                                "example_id": "cf195a93-49c3-4ee0-b034-41fef747c3c3",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "Les goûteurs d'infini sont de deux sortes : les uns aiment l'immensité liquide, les autres la verticalité. Les premiers préfèrent en général les océans, les seconds les massifs."
                                            },
                                            {
                                                "example_id": "e86c9dc0-fcbd-41cc-b68b-877807beb326",
                                                "sense_id": "c4f946e3-fe20-3c70-a9cb-a9e140222103",
                                                "text": "La bêtise humaine est la seule chose qui donne une idée de l’infini."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
