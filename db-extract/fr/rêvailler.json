                "senses": [
                    {
                        "sense_id": "9809a44e-c920-3981-9ca4-f78eb8c49a8a",
                        "entry_id": "842fd518-9181-35b8-ba6e-51b24d4c853a",
                        "glosses": [
                            "Rêver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc888e6-ad3b-421b-88ed-297a62ad820b",
                                "sense_id": "9809a44e-c920-3981-9ca4-f78eb8c49a8a",
                                "text": "Mon paresseux d’esprit, qui aime mieux rêvailler que travailler, ne s’empresse guère à ces compositions louangeuses."
                            },
                            {
                                "example_id": "ba46fbc9-b87a-47a9-8b3e-2923b2bad433",
                                "sense_id": "9809a44e-c920-3981-9ca4-f78eb8c49a8a",
                                "text": "Elle rêvaille à son aise."
                            },
                            {
                                "example_id": "9eedb719-baee-4013-a8a1-98bb4872e1ce",
                                "sense_id": "9809a44e-c920-3981-9ca4-f78eb8c49a8a",
                                "text": "Et d’autres, rouges comme pivoines, le pouce dans la bouche, à rêvailler devant la merveilleuse créature."
                            }
                        ]
                    }
