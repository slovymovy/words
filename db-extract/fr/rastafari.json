                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83129230-2485-423a-9076-9718ece05a3e",
                        "entry_id": "d34ab2a6-d9d0-3a07-a55d-12ea9b381adb",
