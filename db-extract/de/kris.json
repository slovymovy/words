                "senses": [
                    {
                        "sense_id": "c72a8f1b-ff99-3627-b13f-cac169576488",
                        "entry_id": "fdb3bc5d-517d-3a89-b226-0cbcb777164b",
                        "glosses": [
                            "Dolch mit besonderer, geflammter Klinge"
                        ],
                        "tags": [
                            "Waffe",
                            "Asien"
                        ],
                        "examples": [
                            {
                                "example_id": "01806e63-5fa2-4b06-8631-5bab6e852f3d",
                                "sense_id": "c72a8f1b-ff99-3627-b13f-cac169576488",
                                "text": "„Zu den zweifellos bekanntesten, technisch und künstlerisch höchststehenden Erzeugnissen der Eisenschmiede zählt der Kris (eigentlich keris).“"
                            },
                            {
                                "example_id": "217251f2-fdb5-43ee-822c-a5d368b80f68",
                                "sense_id": "c72a8f1b-ff99-3627-b13f-cac169576488",
                                "text": "„Die meisten Klingen, auch diejenigen der Lanzen, waren nach Art der Krise, der malaiischen Kurzdolche, geflammt.“"
                            },
                            {
                                "example_id": "62b1acab-a3ea-4fc4-b6c2-afe241dd4b44",
                                "sense_id": "c72a8f1b-ff99-3627-b13f-cac169576488",
                                "text": "Die Klinge des Krises ist geflammt und oben sehr breit, das Heft kurz und aus hartem Holz, es sitzt im stumpfen Winkel an der Klinge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
