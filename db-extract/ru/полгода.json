                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Payer le semestre échu."
                                            },
                                            {
                                                "example_id": "6f533a57-d737-4620-a5b3-3966dbbe95a4",
                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Il a touché le second semestre de sa pension."
                                            },
                                            {
                                                "example_id": "9c948069-7122-4959-b98f-46242287bc73",
                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Il lui est dû un semestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76357809-8f8e-3ac7-970d-b29e7940a99a",
                                        "entry_id": "82e5c8f6-f005-3c6f-a9e9-63981c2cb22f",
                                        "glosses": [
                                            "Période de certains emplois qu’on est obligé de remplir pendant la moitié de l’année."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5fd6d2-1e34-4a75-beff-bd95ad696163",
                                                "sense_id": "76357809-8f8e-3ac7-970d-b29e7940a99a",
                                                "text": "Servir par semestre."
                                            },
                                            {
                                                "example_id": "0b920225-dde6-45cf-acf6-2af5471282c4",
                                                "sense_id": "76357809-8f8e-3ac7-970d-b29e7940a99a",
                                                "text": "Il est de semestre."
                                            },
                                            {
                                                "example_id": "de77a273-028d-43d5-90b1-985c94385569",
                                                "sense_id": "76357809-8f8e-3ac7-970d-b29e7940a99a",
                                                "text": "Le grand conseil, la chambre des comptes de Paris servaient par semestre, Une partie de ces compagnies servait pendant six mois, et l’autre partie pendant les six autres mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ae3382-2bec-36a1-a3ca-a42e4384df97",
                                        "entry_id": "82e5c8f6-f005-3c6f-a9e9-63981c2cb22f",
                                        "glosses": [
                                            "Partie de l’année universitaire."
                                        ],
                                        "tags": [
                                            "Université"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
