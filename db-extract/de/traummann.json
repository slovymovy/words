                            {
                                "example_id": "06b43455-88a6-4e1b-8b5a-72aac70dc6c3",
                                "sense_id": "6570cde2-cc85-3c33-8a2d-8fb39fde7b37",
                                "text": "Wow, sieh dir mal diese Traummänner dort drüben an!"
                            },
                            {
                                "example_id": "f2b0f716-567f-4187-b1e5-f60b93688871",
                                "sense_id": "6570cde2-cc85-3c33-8a2d-8fb39fde7b37",
                                "text": "Mein Traummann kann alle meine Wünsche wahr werden lassen."
                            },
                            {
                                "example_id": "adfca45f-a1cd-4304-bc3b-c024bd41b8c7",
                                "sense_id": "6570cde2-cc85-3c33-8a2d-8fb39fde7b37",
                                "text": "Doch bald bemerkte sie, dass ihr Traummann mit ihr nichts zu tun haben wollte."
                            },
                            {
                                "example_id": "ad6064d9-cda7-4b8c-8fd5-8d1fe44a10d2",
                                "sense_id": "6570cde2-cc85-3c33-8a2d-8fb39fde7b37",
                                "text": "Ich habe meinen Traummann geheiratet."
                            }
                        ],
