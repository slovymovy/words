                "senses": [
                    {
                        "sense_id": "284587b9-1587-30c0-99ad-4ef632a6001a",
                        "entry_id": "34f9d485-74c1-35ca-b473-e1878e8d2672",
                        "glosses": [
                            "Qui est coiffé d’une perruque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd083e5e-c5ae-435f-a1b8-d81c6c3b22b7",
                                "sense_id": "284587b9-1587-30c0-99ad-4ef632a6001a",
                                "text": "Le Léandre prenait des tons de cierge jauni et ressemblait à ces Saint-Jean de cire emperruqués de soie et dont le fard est tombé malgré la montre de verre."
                            },
                            {
                                "example_id": "dfcb165c-2050-4f41-85b9-4432916bdc51",
                                "sense_id": "284587b9-1587-30c0-99ad-4ef632a6001a",
                                "text": "Elle avait de quoi les séduire, ainsi costumée en sultane, un petit fez rouge sur la tête, ou en duchesse emperruquée, toute de blanc vêtue avec son joli visage aux traits fins, ses grands yeux sombres et ses faux grains de beauté."
                            },
                            {
                                "example_id": "6cd96564-9246-43b0-88bb-00671da0218a",
                                "sense_id": "284587b9-1587-30c0-99ad-4ef632a6001a",
                                "text": "Nul juge emperruqué ne m’a fait pendre encore.\nBref, je suis un gredin amoureux de l’aurore."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea8351c9-83c6-3171-91df-d307d4e6e536",
                        "entry_id": "34f9d485-74c1-35ca-b473-e1878e8d2672",
                        "glosses": [
                            "Qui est surmonté de ce qui peut évoquer une perruque."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "b7f7156d-fc87-4f94-af3e-e3b546ee64fb",
                                "sense_id": "ea8351c9-83c6-3171-91df-d307d4e6e536",
                                "text": "L’avion virait sur l’aile droite, offrait à ses passagers le spectacle merveilleux du port entrant de toutes ses jetées, comme les rayons d’une gloire, dans l’Hudson, tandis que la pointe de Manhattan, portée à l’incandescence par le couchant, enfonçait comme un fer rouge son étrave dans une mer sillonnée de chalands, d’allèges et de remorqueurs emperruqués de fumée noire."
                            }
                        ]
                    }
