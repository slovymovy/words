                ],
                "senses": [
                    {
                        "sense_id": "f0c0df91-e46d-37da-ac96-c7d6e505ad0e",
                        "entry_id": "0e48f2f7-91ac-377f-9e9e-1a9d7dc2f105",
                        "glosses": [
                            "Bouillonner par l'effet de la chaleur."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c061ee66-ed43-476e-8f73-52eaeec0c565",
                                "sense_id": "f0c0df91-e46d-37da-ac96-c7d6e505ad0e",
                                "text": "Le même jour de l’eau-de-vie chaude et de l’eau-de-vie froide y furent placées. La première ne fit pas de petites bulles, mais l’eau-de-vie froide en fit, sans cependant bouillonner ou ébullir comme de l’eau chaude."
                            },
                            {
                                "example_id": "5ae31796-54ad-4f27-bb9e-ddd0c2361bdd",
                                "sense_id": "f0c0df91-e46d-37da-ac96-c7d6e505ad0e",
                                "text": "[…] mettez de cette matière dans un bon creuset autant qu’il soit environ à demi plein, mettez le dans un fourneau à fondre, couvrez vôtre creuset d’un couvercle de terre, donnez peu à peu du feu, faites fondre vôtre matière, & prenez garde qu’elle n’ébullisse, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0cb96db9-6254-3d14-83b8-b1d659f11cb7",
                        "entry_id": "0e48f2f7-91ac-377f-9e9e-1a9d7dc2f105",
                        "glosses": [
                            "Réduire, consommer par une ébullition."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9fbb6f35-bfc9-4ba2-a36b-ebf0e673a9ca",
                                "sense_id": "0cb96db9-6254-3d14-83b8-b1d659f11cb7",
                                "text": "Composition de cire, de suif. de noir de fumée et d’autres ingrédients qu’on fait ébullir pour cirer les bottes. les gros souliers. etc."
                            }
                        ]
                    }
