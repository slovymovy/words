                "senses": [
                    {
                        "sense_id": "1b3760d9-1249-3ceb-88f9-f3358b6b5d25",
                        "entry_id": "17faf6b5-4cf5-31bb-98a2-130b5d143644",
                        "glosses": [
                            "A faint brightening of the night sky in the region of the ecliptic directly opposite the Sun."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61007094-0a10-473d-886a-dd7f0197d04a",
                                "sense_id": "1b3760d9-1249-3ceb-88f9-f3358b6b5d25",
                                "text": "My object in appearing before the Association, at this time, is to present the observations of several other persons on the gegenschein or completed arch of the zodiacal light, of which I have received accounts since our meeting in Motreal."
                            },
                            {
                                "example_id": "c7686a2a-945f-4f23-8c0b-9f942776bfea",
                                "sense_id": "1b3760d9-1249-3ceb-88f9-f3358b6b5d25",
                                "text": "The zodiacal light, gegenschein, and zodiacal band … are all visible."
                            }
                        ]
                    }
                ],
