                "senses": [
                    {
                        "sense_id": "68b44cae-459b-399c-b6e8-13eb6f6821ff",
                        "entry_id": "eedff639-836b-321a-9ede-fe926f9b7217",
                        "glosses": [
                            "diminutive of чиж (čiž): siskin"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf65cc4-1848-4bae-a4b3-d8851b8c1df1",
                                "sense_id": "68b44cae-459b-399c-b6e8-13eb6f6821ff",
                                "text": "У нас чи́жики так и мрут. Ми́чман уж пя́того покупа́ет, — не живу́т в на́шем во́здухе, да и то́лько.",
                                "translation": "Siskins simply die with us. The naval man is just buying the fifth—they can't live in our air and that is the long and short of it.",
                                "english": "Siskins simply die with us. The naval man is just buying the fifth—they can't live in our air and that is the long and short of it."
                            }
                        ]
                    },
                    {
                        "sense_id": "16a28f7a-57a2-3fb2-91f7-d321d5a00283",
                        "entry_id": "eedff639-836b-321a-9ede-fe926f9b7217",
                        "glosses": [
                            "a social butterfly, slicker"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ff8c5899-0539-4c58-8629-764a4a5cc55b",
                                "sense_id": "16a28f7a-57a2-3fb2-91f7-d321d5a00283",
                                "text": "Со мной вообще́, на́хуй, лу́чше не обща́ться\nЕ́сли ты не хо́чешь, чи́жик, ло́хом оказа́ться"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
