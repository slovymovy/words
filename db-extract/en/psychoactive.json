                                        "glosses": [
                                            "Qui a un effet sur le système nerveux, sur la psyché, qui peut modifier l’état psychique d’un individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55798044-68be-4a64-8165-f15b2bf0ed55",
                                                "sense_id": "81cf3f0a-84e6-3f34-87f3-4f4499009c3a",
                                                "text": "Certains médicaments ont des effets secondaires psychoactifs."
