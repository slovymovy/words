                "senses": [
                    {
                        "sense_id": "b7c4ff4a-0b09-3cf2-9099-0bb81243b936",
                        "entry_id": "31a67a35-1aba-3757-ad07-d6a85cfcae01",
                        "glosses": [
                            "Gesamtheit der materiellen und ideellen Grundlagen, die im Alltag eine Rolle spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8a6ab4-294d-4037-a6c4-9e10461dc8f0",
                                "sense_id": "b7c4ff4a-0b09-3cf2-9099-0bb81243b936",
                                "text": "„Ein Aspekt der jüdischen Alltagskultur ist aber bislang bei allen Dokumentationen ausgespart geblieben: die jüdische oder besser jiddische Sprache.“"
                            },
                            {
                                "example_id": "532ef984-3bc9-471b-ad58-498d23b3e86c",
                                "sense_id": "b7c4ff4a-0b09-3cf2-9099-0bb81243b936",
                                "text": "„Ich bin mir nicht so sicher, ob es die Wahrnehmung eines Besuchers ist, vielleicht bilde ich mir das auch einfach nur ein, aber in Island ist die Sagenwelt bis heute Teil der Alltagskultur.“"
                            },
                            {
                                "example_id": "8d75cb2d-b9a0-43e1-9a03-f2d7b6a9e2a2",
                                "sense_id": "b7c4ff4a-0b09-3cf2-9099-0bb81243b936",
                                "text": "„Fußball ist ein wichtiger Teil unserer Alltagskultur geworden, auch wenn es natürlich auch »Fußballhasser« gibt, das ist ihr gutes Recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
