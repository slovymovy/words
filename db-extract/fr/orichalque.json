                                        "entry_id": "c1c98e1c-4dd3-3f06-8835-974d670744eb",
                                        "glosses": [
                                            "A valuable yellow metal known to the Ancient Greeks and Romans; now sometimes interpreted as referring to a natural alloy of gold and copper, and sometimes treated as a mythical substance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3001cdfa-e466-408e-9cae-f9c1ea2ad1c1",
                                                "sense_id": "3f53004c-a9e4-3e56-89cf-ddf0bd727666",
                                                "text": "Many walls were coated with metals – with brass, tin and a red ^([sic]) metal, unknown to us, called orichalcum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
