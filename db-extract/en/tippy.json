                "senses": [
                    {
                        "sense_id": "3300316b-1d59-3c19-ab80-da09d165f300",
                        "entry_id": "438e18c6-923a-3466-8be4-b10733bf9008",
                        "glosses": [
                            "Fashionable, tip-top."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "58ac61aa-c49a-4ba7-af8e-31c956cdf90a",
                                "sense_id": "3300316b-1d59-3c19-ab80-da09d165f300",
                                "text": "Of all the gay beaux, / That sport their smart cloathes, / There's none that my fancy can please, / With their Spencers or Crops, / Or woolly Foretops, / Like Bob with his Tippy Bootees."
                            }
                        ]
                    },
                    {
                        "sense_id": "12df4aa4-9df7-37b7-bd44-4cc4f14c04fc",
                        "entry_id": "438e18c6-923a-3466-8be4-b10733bf9008",
                        "glosses": [
                            "Clever, neat, smart."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "df7e72e8-bce4-436f-ac93-f7dcf181638c",
                                "sense_id": "12df4aa4-9df7-37b7-bd44-4cc4f14c04fc",
                                "text": "She read Renan's Vie de Jésus, and I am now going to lend her the antidote—a tippy little bit of criticism by Pressensé."
                            }
                        ]
                    },
                    {
                        "sense_id": "81eaf5d8-d9bd-32c6-80f1-a40470490813",
                        "entry_id": "438e18c6-923a-3466-8be4-b10733bf9008",
                        "glosses": [
                            "Of tea, having a large amount of tips, or leaf buds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a11dd08-a6f6-4290-be68-9083b10e73a1",
                                "sense_id": "81eaf5d8-d9bd-32c6-80f1-a40470490813",
                                "text": "Before rolling some planters are in the habit of sifting the leaf through a No. 4 sieve, and manufacturing the small leaf and tips that fall through separately. This will add to the appearance of the tea, by making it more tippy, but unless fancy teas are being made will not pay for the time and trouble incurred."
                            }
                        ]
                    }
                ],
