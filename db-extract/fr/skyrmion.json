                        "glosses": [
                            "Tourbillon au sein d’un champ de spins."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "04758e36-5d82-464e-bc65-8a1e7d11f29a",
                                "sense_id": "fa2a31d0-70b2-395c-a4ee-3246f2fcce25",
                                "text": "Plus stables que les électrons, les skyrmions trouvent des applications directes en électronique et dans le développement de futurs systèmes de stockage de données ultra-rapides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5918465c-6a63-452a-843f-80f6a7c8b10d",
