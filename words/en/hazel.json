{
    "word_family": [
        "hazelnut"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ec1e33f-414d-3aaf-8dc6-92b2ba3106db",
                    "sense_definition": "A tree or shrub of the genus Corylus, bearing edible nuts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>hazel</w> tree grew quickly in the corner of the garden.",
                            "target_lang_translations": {
                                "pl": "Mała <w>leszczyna</w> szybko urosła w rogu ogrodu.",
                                "de": "Der kleine <w>Haselstrauch</w> wuchs schnell in der Ecke des Gartens."
                            }
                        },
                        {
                            "text": "Birds often build their nests in the branches of a <w>hazel</w>.",
                            "target_lang_translations": {
                                "pl": "Ptaki często budują swoje gniazda na gałęziach <w>leszczyny</w>.",
                                "de": "Vögel bauen ihre Nester oft in den Zweigen eines <w>Haselstrauchs</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Drzewo lub krzew z rodzaju Corylus, wydające jadalne owoce.",
                        "de": "Ein Baum oder Strauch der Gattung Corylus, der essbare Nüsse trägt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "leszczyna",
                                "target_lang_sense_clarification": "rodzaj krzewu lub drzewa"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Haselstrauch",
                                "target_lang_sense_clarification": "Strauchform"
                            },
                            {
                                "target_lang_word": "Haselnussstrauch",
                                "target_lang_sense_clarification": "Pflanze mit essbaren Nüssen"
                            },
                            {
                                "target_lang_word": "Hasel",
                                "target_lang_sense_clarification": "Pflanzengattung Corylus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61674094-253a-3151-9b92-a93a21930512",
                    "sense_definition": "The nut of the hazel tree.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added a crushed <w>hazel</w> to the top of the chocolate cake.",
                            "target_lang_translations": {
                                "pl": "Dodała pokruszony <w>orzech laskowy</w> na wierzch ciasta czekoladowego.",
                                "de": "Sie gab eine zerstoßene <w>Haselnuss</w> auf den Schokoladenkuchen."
                            }
                        },
                        {
                            "text": "The squirrel gathered every <w>hazel</w> it could find before winter.",
                            "target_lang_translations": {
                                "pl": "Wiewiórka zebrała każdy <w>orzech laskowy</w>, jaki mogła znaleźć przed zimą.",
                                "de": "Das Eichhörnchen sammelte vor dem Winter jede <w>Haselnuss</w>, die es finden konnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "filbert",
                        "hazelnut"
                    ],
                    "target_lang_definitions": {
                        "pl": "Owoc leszczyny, orzech laskowy.",
                        "de": "Die Nuss des Haselstrauchs."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "orzech laskowy",
                                "target_lang_sense_clarification": "owoc leszczyny"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Haselnuss",
                                "target_lang_sense_clarification": "essbare Nuss"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2a696b2-8ed9-3609-89da-39dd0bdaa52b",
                    "sense_definition": "A greenish-brown colour.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls of the living room were painted a soft shade of <w>hazel</w>.",
                            "target_lang_translations": {
                                "pl": "Ściany salonu zostały pomalowane na delikatny <w>orzechowy</w> odcień.",
                                "de": "Die Wände des Wohnzimmers wurden in einem sanften <w>Haselnussbraun</w> gestrichen."
                            }
                        },
                        {
                            "text": "She wore a scarf that matched the <w>hazel</w> of her eyes.",
                            "target_lang_translations": {
                                "pl": "Założyła szalik, który pasował do <w>orzechowego</w> koloru jej oczu.",
                                "de": "Sie trug einen Schal, der zum <w>Grünbraun</w> ihrer Augen passte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zielonkawobrązowy kolor.",
                        "de": "Eine grünlich-braune Farbe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "orzechowy",
                                "target_lang_sense_clarification": "kolor złocistobrązowy"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Haselnussbraun",
                                "target_lang_sense_clarification": "Farbbezeichnung"
                            },
                            {
                                "target_lang_word": "Grünbraun",
                                "target_lang_sense_clarification": "Mischfarbe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e9664ef-a402-359f-a364-1dcf195acdf2",
                    "sense_definition": "The wood of a hazel tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basket was woven from flexible <w>hazel</w> branches.",
                            "target_lang_translations": {
                                "pl": "Koszyk był upleciony z elastycznych gałęzi <w>leszczyny</w>.",
                                "de": "Der Korb wurde aus biegsamen <w>Haselzweigen</w> geflochten."
                            }
                        },
                        {
                            "text": "He used a sturdy piece of <w>hazel</w> to make a walking stick.",
                            "target_lang_translations": {
                                "pl": "Użył solidnego kawałka <w>leszczyny</w>, aby zrobić laskę do chodzenia.",
                                "de": "Er benutzte ein stabiles Stück <w>Haselholz</w>, um einen Gehstock zu schnitzen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Drewno drzewa leszczyny.",
                        "de": "Das Holz eines Haselstrauchs oder -baums."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drewno leszczyny",
                                "target_lang_sense_clarification": "materiał z drzewa leszczyny"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Haselholz",
                                "target_lang_sense_clarification": "Werkstoff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b75afbf-0e2c-3d12-be49-aafafa8f10d9",
                    "sense_definition": "A type of stone that breaks easily into regular shapes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quarry workers identified the rock as <w>hazel</w> due to its cleavage.",
                            "target_lang_translations": {
                                "pl": "Pracownicy kamieniołomu zidentyfikowali skałę jako <w>hazel</w> ze względu na jej łupliwość.",
                                "de": "Die Steinbrucharbeiter identifizierten das Gestein aufgrund seiner Spaltbarkeit als <w>Hazel</w>."
                            }
                        },
                        {
                            "text": "Builders preferred using <w>hazel</w> for the foundation because it was easy to shape.",
                            "target_lang_translations": {
                                "pl": "Budowniczowie woleli używać <w>hazel</w> do fundamentów, ponieważ łatwo było ją formować.",
                                "de": "Bauherren bevorzugten <w>Hazel</w> für das Fundament, da es sich leicht bearbeiten ließ."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rodzaj skały łatwo łupiącej się na regularne kawałki.",
                        "de": "Eine Gesteinsart, die leicht in regelmäßige Formen bricht."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "hazel",
                                "target_lang_sense_clarification": "termin górniczy zachowany w oryginale: skała o regularnej łupliwości"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "bergmännische Gesteinsbezeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                    "sense_definition": "Of a greenish-brown colour, often used to describe eyes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has bright <w>hazel</w> eyes that change color in the sunlight.",
                            "target_lang_translations": {
                                "pl": "Ma jasne <w>piwne</w> oczy, które zmieniają kolor w świetle słonecznym.",
                                "de": "Er hat strahlende <w>haselnussbraune</w> Augen, die im Sonnenlicht ihre Farbe ändern."
                            }
                        },
                        {
                            "text": "She wore a <w>hazel</w> dress that complemented her skin tone perfectly.",
                            "target_lang_translations": {
                                "pl": "Miała na sobie <w>orzechową</w> sukienkę, która idealnie pasowała do jej karnacji.",
                                "de": "Sie trug ein <w>haselnussbraunes</w> Kleid, das ihren Hautton perfekt unterstrich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hazel eyes"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zielonkawobrązowy kolor, często używany do opisu oczu.",
                        "de": "Von grünlich-brauner Farbe; besonders für die Augenfarbe verwendet."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "piwny",
                                "target_lang_sense_clarification": "o kolorze oczu"
                            },
                            {
                                "target_lang_word": "orzechowy",
                                "target_lang_sense_clarification": "o kolorze oczu lub przedmiotów"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "haselnussbraun",
                                "target_lang_sense_clarification": "bezüglich Augen- oder Objektfarbe"
                            },
                            {
                                "target_lang_word": "grün-braun",
                                "target_lang_sense_clarification": "Mischfarbe, oft Augenfarbe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "01fa9db0-c2d9-3b5d-bcf5-94cad8d30f5c",
                    "sense_definition": "A female given name.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Hazel</w> decided to start a new career in graphic design.",
                            "target_lang_translations": {
                                "pl": "<w>Hazel</w> postanowiła rozpocząć nową karierę w projektowaniu graficznym.",
                                "de": "<w>Hazel</w> beschloss, eine neue Karriere im Grafikdesign zu beginnen."
                            }
                        },
                        {
                            "text": "My grandmother, <w>Hazel</w>, always told the best stories.",
                            "target_lang_translations": {
                                "pl": "Moja babcia, <w>Hazel</w>, zawsze opowiadała najlepsze historie.",
                                "de": "Meine Großmutter <w>Hazel</w> erzählte immer die besten Geschichten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Żeńskie imię własne.",
                        "de": "Ein weiblicher Vorname."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "imię żeńskie"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "weiblicher Vorname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b9b150-2c47-3745-8914-ae22e839b1e9",
                    "sense_definition": "A surname for someone who lived near a hazel tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian researched the family history of the <w>Hazel</w> lineage.",
                            "target_lang_translations": {
                                "pl": "Historyk badał historię rodziny rodu <w>Hazel</w>.",
                                "de": "Der Historiker erforschte die Familiengeschichte der Linie <w>Hazel</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Hazel</w> was a well-known local farmer in the village.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Hazel</w> był znanym lokalnym rolnikiem we wsi.",
                                "de": "Herr <w>Hazel</w> war ein bekannter örtlicher Landwirt im Dorf."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko osoby mieszkającej w pobliżu leszczyny.",
                        "de": "Ein Familienname für jemanden, der in der Nähe eines Haselstrauchs lebte."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "Familienname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f30ae626-90cf-32d3-8804-88d6fa86d5fa",
                    "sense_definition": "A city in Kentucky, USA.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Hazel</w> on their way south.",
                            "target_lang_translations": {
                                "pl": "Przejechali przez małe miasteczko <w>Hazel</w> w drodze na południe.",
                                "de": "Auf ihrem Weg nach Süden fuhren sie durch die kleine Stadt <w>Hazel</w>."
                            }
                        },
                        {
                            "text": "The post office in <w>Hazel</w> serves the surrounding rural community.",
                            "target_lang_translations": {
                                "pl": "Poczta w <w>Hazel</w> obsługuje okoliczną społeczność wiejską.",
                                "de": "Das Postamt in <w>Hazel</w> versorgt die umliegende ländliche Gemeinde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Miasto w stanie Kentucky w USA.",
                        "de": "Eine Stadt im Bundesstaat Kentucky, USA."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "nazwa miejscowości"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hazel",
                                "target_lang_sense_clarification": "Ortsname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}