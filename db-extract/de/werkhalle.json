                ],
                "senses": [
                    {
                        "sense_id": "32b7f6ec-aaed-3e19-abb8-129908bed93f",
                        "entry_id": "20649168-ea31-32b1-85a6-e39d5f6ae396",
                        "glosses": [
                            "Halle, in der etwas gebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc41f708-500a-4f25-89f9-522d6ebcb87c",
                                "sense_id": "32b7f6ec-aaed-3e19-abb8-129908bed93f",
                                "text": "Zur Werkhalle hat man nur mit einem besonderen Firmenausweis Zutritt."
                            },
                            {
                                "example_id": "1f0a5b41-6df4-4c31-9b29-7ae13f10c9b4",
                                "sense_id": "32b7f6ec-aaed-3e19-abb8-129908bed93f",
                                "text": "„Im ohrenbetäubenden Lärm der Werkhalle trifft er auf skeptische Arbeiter, die daran zweifeln, ob ihnen nach der Wahl auch wirklich \"mehr Netto vom Brutto\" bleibt.“"
                            },
                            {
                                "example_id": "356fdccc-e4f0-4549-a5ed-cadace19639e",
                                "sense_id": "32b7f6ec-aaed-3e19-abb8-129908bed93f",
                                "text": "„In Industriegebieten, wie z.B. nordöstlich des Flughafens von Shenzen, steht eine Vielzahl Werkhallen, in denen für den Weltmarkt produziert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
