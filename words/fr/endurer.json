                        "endurer des épreuves",
                        "endurer en silence"
                    ]
                },
                {
                    "sense_id": "218e27ba-b841-3785-b5d5-afaac5f7cf26",
                    "sense_definition": "Permettre ou tolérer qu'une chose fâcheuse ou contestable se produise.",
