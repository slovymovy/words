                "senses": [
                    {
                        "sense_id": "22a2a4a4-887c-3c17-9c99-4e3d0e4126e8",
                        "entry_id": "cafaa9d8-7530-34fd-ab67-21082af4fd5d",
                        "glosses": [
                            "Einatmung (Inhalation) von Dampf zur medizinischen Behandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c22054ca-99b1-442e-8612-631923b6342d",
                                "sense_id": "22a2a4a4-887c-3c17-9c99-4e3d0e4126e8",
                                "text": "„Um zu verhindern, dass die Schleimhäute austrocknen, können Sie eine Dampfinhalation machen.“"
                            },
                            {
                                "example_id": "6cc6dcda-462d-4435-9e6e-388172870863",
                                "sense_id": "22a2a4a4-887c-3c17-9c99-4e3d0e4126e8",
                                "text": "„Zu den Hausmitteln, die bei Keuchhusten helfen, gehören außerdem warme Brustwickel und die Dampfinhalation mit einer Meersalzlösung.“"
                            },
                            {
                                "example_id": "1587443b-5afa-4594-afd0-2fdac19ade9c",
                                "sense_id": "22a2a4a4-887c-3c17-9c99-4e3d0e4126e8",
                                "text": "„Heiße Getränke mit Honig, Lutschtabletten und Dampfinhalationen verschaffen Linderung bei Halsschmerzen, Heiserkeit und Husten.“"
                            },
                            {
                                "example_id": "a73f14c1-bc05-4ae0-b23d-69dc1faca9ae",
                                "sense_id": "22a2a4a4-887c-3c17-9c99-4e3d0e4126e8",
                                "text": "„Eine englische Studie untersuchte an knapp 900 Patienten in 25 Arztpraxen, wie sich Ibuprofen und Paracetamol allein oder kombiniert, mit oder ohne Dampfinhalationen auf den Krankheitsverlauf eines grippalen Infektes auswirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
