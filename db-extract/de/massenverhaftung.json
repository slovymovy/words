                ],
                "senses": [
                    {
                        "sense_id": "7c379bfe-ed12-3fcf-89dc-78f3121f1b25",
                        "entry_id": "58d662da-5585-3ae7-8341-d274c2bd050e",
                        "glosses": [
                            "Verhaftung einer großen Zahl von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4f988f-adda-4ea8-9087-bfea0ae083bc",
                                "sense_id": "7c379bfe-ed12-3fcf-89dc-78f3121f1b25",
                                "text": "„Premierminister Edgar Whitehead rief im Februar 1959 den Ausnahmezustand aus, dem Massenverhaftungen von über 500 Funktionären folgten.“"
                            },
                            {
                                "example_id": "e4d64f83-89bf-48a5-a38e-f94be6302141",
                                "sense_id": "7c379bfe-ed12-3fcf-89dc-78f3121f1b25",
                                "text": "„Er antwortete mit einer Massenverhaftung führender Mitglieder der DVPA in der Nacht vom 25. auf den 26. April.“"
                            },
                            {
                                "example_id": "062d55ef-cca1-44a3-902e-9cdaac957fac",
                                "sense_id": "7c379bfe-ed12-3fcf-89dc-78f3121f1b25",
                                "text": "„Massenverhaftungen, die umfassende Anwendung von Administrativhaft, also die Inhaftierung ohne Anklage oder Gerichtsverfahren, sowie die Deportation von Aktivisten kamen hinzu.“"
                            },
                            {
                                "example_id": "87cb9a1b-aa18-4838-a78b-5f62addd8d70",
                                "sense_id": "7c379bfe-ed12-3fcf-89dc-78f3121f1b25",
                                "text": "„Er schaffte es, sie zu einer Diskussion zusammenzubringen darüber, wie man von beiden Seiten aus den Mord an Zivilisten stoppen könne - die Mau-Mau hielten sich an die Abmachung, aber die Engländer machten weiter mit ihren Massenverhaftungen und dem Töten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
