                                        "examples": [
                                            {
                                                "example_id": "f3b23c4d-0722-4705-bff9-74869ec70ddd",
                                                "sense_id": "db62bebb-c401-379e-ab58-31591f1a1782",
                                                "text": "In onze tijd bestaat er een toenemende belangstelling, zowel voor de folklore als voor de achtergrond en de inhoud van de feesten. Temeer als die beleefd kunnen worden door het hele gezin en de hele groep, jong of oud."
                                            },
                                            {
                                                "example_id": "6df285ea-0473-43d0-abe1-816ad2b18d6e",
                                                "sense_id": "db62bebb-c401-379e-ab58-31591f1a1782",
                                                "text": "Ik verbaasde me erover hoe een aantal jonge hikers buiten met de naderende storm omgingen. Ze maakten uitgebreid filmpjes en juichten bij elke donderslag terwijl ik juist dieper in mijn slaapzak kroop. Ik voelde me klein en uiterst kwetsbaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de21ca2-848b-306f-976b-b11b2ef0ed01",
                                        "entry_id": "33c81c30-3235-3721-947c-bd3deb89dc48",
                                        "glosses": [
                                            "recent, van nog maar kort geleden"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde571b3-2a09-4f31-ab66-1f97203cc93c",
                                                "sense_id": "9de21ca2-848b-306f-976b-b11b2ef0ed01",
                                                "text": "We houden de jongste ontwikkelingen in de gaten."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9c442d15-d3f7-30d4-afc2-06800cfe21cf",
                                        "entry_id": "296ddd6c-fe6e-3ee1-93f8-0825c042455b",
                                        "glosses": [
                                            "een directe nakomeling van een dier (m.n. van een zoogdier of reptiel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c0c770-fd6d-4539-a4ee-c864136df04e",
                                                "sense_id": "9c442d15-d3f7-30d4-afc2-06800cfe21cf",
                                                "text": "Een welp is het jong van een leeuw."
                                            },
                                            {
                                                "example_id": "9dbf22e4-1e45-40b2-bcfe-40d26f359ead",
                                                "sense_id": "9c442d15-d3f7-30d4-afc2-06800cfe21cf",
                                                "text": "De poes heeft jongen gekregen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d8903d-a767-3592-867c-c934946e1faa",
                                        "entry_id": "296ddd6c-fe6e-3ee1-93f8-0825c042455b",
                                        "glosses": [
                                            "min of meer denigrerende dan wel beledigende benaming voor iemand die minderjarig en van het mannelijk geslacht is (ofwel voor een jongen)"
                                        ],
                                        "tags": [
