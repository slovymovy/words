                        "entry_id": "f4554294-8c8e-387e-ab9b-3450981ca430",
                        "glosses": [
                            "Käfer aus der Familie der Laufkäfer (Carabidae), der in großen Teilen Europas beheimatet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78810fd-8a64-4e60-9408-e5a07f3161aa",
                                "sense_id": "68a029a2-46e5-3a8a-ae76-a8cb04b408d9",
                                "text": "„Die Goldleiste ist, wie auch ihre Larven, dämmerungsaktiv und jagt am Waldboden.“"
                            }
                        ],
