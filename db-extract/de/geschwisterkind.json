                "senses": [
                    {
                        "sense_id": "2ad66534-91a8-35d1-98fc-7c081a1b06a0",
                        "entry_id": "fc4a9a86-eb07-3f00-bee5-9c9438196b5d",
                        "glosses": [
                            "sibling (usually restricted to children and not used of adults)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "286c15e5-fe97-35d1-b8c6-647e29dc4e1b",
                        "entry_id": "fc4a9a86-eb07-3f00-bee5-9c9438196b5d",
                        "glosses": [
                            "child of a sibling, niece, nephew, or (in the plural, reciprocally) first cousins"
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c6a3544e-90aa-448e-906e-0352b4a49bf6",
                                "sense_id": "286c15e5-fe97-35d1-b8c6-647e29dc4e1b",
                                "text": "Zustimmung herrschte im Zimmer, und die Unterhaltung blieb ein wenig bei dieser Familienangelegenheit, dieser bevorstehenden Verehelichung stehen; denn da vorteilhafte Heiraten zwischen Geschwisterkindern in der Stadt nichts Ungewöhnliches waren, so nahm niemand Anstoß daran."
                            }
                        ]
                    }
