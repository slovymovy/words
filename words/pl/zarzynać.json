                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "niszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysokie podatki <w>zarzynają</w> małe firmy w tym regionie.",
