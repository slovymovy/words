                "forms": [
                    {
                        "form_id": "740ac021-7feb-45ad-b962-30b9fa8ceb78",
                        "entry_id": "2b5612bf-bf69-341f-b1c9-c8ab7bc4f89e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "légalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df4b38d7-dbbf-386f-83bf-9e5ccd665ab1",
                        "entry_id": "2b5612bf-bf69-341f-b1c9-c8ab7bc4f89e",
                        "glosses": [
                            "Relatif au légalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d9970f-b3b0-44b2-bae1-bbbe25a4dea4",
                                "sense_id": "df4b38d7-dbbf-386f-83bf-9e5ccd665ab1",
                                "text": "Car, si « légalisme » signifie que l’obéissance à la Loi sert à l’obtention du salut, alors le nomisme d’alliance est un nomisme légaliste."
                            },
                            {
                                "example_id": "6c698455-b790-4cdf-a16c-9fb96d4b697e",
                                "sense_id": "df4b38d7-dbbf-386f-83bf-9e5ccd665ab1",
                                "text": "Les réponses de quelques pays manifestent davantage de cohérence : c’est le cas de la Belgique faiblement légaliste et tolérante à la fraude fiscale, et dans l’autre sens, de l’Irlande et du Portugal à la fois légalistes et rigoristes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f43accc7-a230-4b9d-a50e-938d9c37ea90",
                        "source_entry_id": "2b5612bf-bf69-341f-b1c9-c8ab7bc4f89e",
                        "source_sense_id": "df4b38d7-dbbf-386f-83bf-9e5ccd665ab1",
                        "target_lang_word": "legalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eddd4b1-7e0e-3d12-b7ad-5cb728ef8fb1",
                                        "entry_id": "5c3b25ae-dac6-34d0-8ed8-020397b6fdd3",
                                        "glosses": [
                                            "Of or related to legalism, in its various senses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "legalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68094a87-832a-3d4e-8465-8501d71f9187",
                                        "entry_id": "5650211d-290c-38ec-96e7-4fffdde07ce6",
                                        "glosses": [
                                            "One who adheres to legalism, in its various senses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139645bb-c643-4723-b422-989af9f7a36f",
                                                "sense_id": "68094a87-832a-3d4e-8465-8501d71f9187",
                                                "text": "“Don’t say anything! Oh, don’t say anything,” cried the atheist cobbler, dancing about in an ecstasy of admiration of the English legal system. For no man is such a legalist as the good Secularist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14e5bb66-d8a7-4f67-906b-63cebff4e47a",
                        "source_entry_id": "2b5612bf-bf69-341f-b1c9-c8ab7bc4f89e",
                        "source_sense_id": "df4b38d7-dbbf-386f-83bf-9e5ccd665ab1",
                        "target_lang_word": "legalistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legalistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95931913-b090-3886-a9cd-6740f19e70d6",
                                        "entry_id": "6b2f07e6-a8a0-357d-8d0c-2370ea8fad2d",
                                        "glosses": [
                                            "Of a person, following the letter of the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d74b096-c5e0-4328-a3a9-32b9a7f7405d",
                                                "sense_id": "95931913-b090-3886-a9cd-6740f19e70d6",
                                                "text": "He's very legalistic, so let's hope the law is just and merciful as well as strict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b276a995-9343-34e8-8072-72e0fc573cf4",
                                        "entry_id": "6b2f07e6-a8a0-357d-8d0c-2370ea8fad2d",
                                        "glosses": [
                                            "Of a person, tending to resort to the law, as one who sues frequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f172a7-5607-47f8-9212-a48ce9b00db4",
                                                "sense_id": "b276a995-9343-34e8-8072-72e0fc573cf4",
                                                "text": "His legalistic tendencies irritated his neighbors, especially since they had to defend themselves against his frivolous suits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4751eca7-1e7e-3463-a541-348377987e1e",
                                        "entry_id": "6b2f07e6-a8a0-357d-8d0c-2370ea8fad2d",
                                        "glosses": [
                                            "Practicing or characterized by legalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cecfcb-2f1f-4900-aa11-197d953098b2",
                                                "sense_id": "4751eca7-1e7e-3463-a541-348377987e1e",
                                                "text": "the European Union is legalistic, bureaucratic and runs by precedent."
                                            },
                                            {
                                                "example_id": "4ca070eb-2cb2-4094-a4bc-b901df2cfeb4",
                                                "sense_id": "4751eca7-1e7e-3463-a541-348377987e1e",
                                                "text": "She was legalistic in her observation of religious rules and traditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b89d98-93c6-45f2-93e3-51377642617a",
                        "source_entry_id": "2b5612bf-bf69-341f-b1c9-c8ab7bc4f89e",
