                ],
                "senses": [
                    {
                        "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                        "entry_id": "5300ec6f-3213-3632-9a23-ad13d7bd1423",
                        "glosses": [
                            "Stärke des von einem Stern ausgestrahlten Lichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29e670c-2812-4669-9983-ccbe029cb0d5",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Diese Sterne eignen sich sehr gut dazu, regelmäßige Beobachtungen durchzuführen, die Sternhelligkeit zu schätzen, sie im Beobachtungsbuch festzuhalten und später daraus eine Lichtkurve zu erstellen.“"
                            },
                            {
                                "example_id": "80e4e91b-f78b-41bf-9924-7293e51f6fc0",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Die Explosionen auf Flaresternen sind hingegen so hell, dass die Sternhelligkeit sich durch sie wahrnehmbar verändert.“"
                            },
                            {
                                "example_id": "3d1edd99-5f93-448f-a626-794e38926998",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Ein weiterer Exoplanet in Pegasus, HD 209458b, zieht aus irdischer Perspektive alle 3,5 Tage vor seinem Mutterstern vorbei, was zu winzigen periodischen Einbrüchen in der Sternhelligkeit führt.“"
                            },
                            {
                                "example_id": "48934642-7178-446b-868f-8ebeb367f5b9",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Im Moment des Eintrittes der Wiedervereinigung entsteht ein Wärmeausbruch, der die lichtabsorbirenden Wolken in der Sternatmosphäre auflöst und dadurch die Sternhelligkeit vermehrt.“"
                            },
                            {
                                "example_id": "f38b4775-565f-4e28-9e2c-2a5f72f2ecd8",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Es wurde untersucht, mit welcher Genauigkeit Sternhelligkeiten durch Messung der Durchmesser der Sternscheiben auf den Blättern des Palomar-Atlasses (Blauaufnahmen) bestimmt werden können.“"
                            },
                            {
                                "example_id": "be928a3d-0d8a-49b3-a755-b4ea41f69fb2",
                                "sense_id": "fe9c8fe3-1566-3f4d-a3f0-bf16b5be88d7",
                                "text": "„Damals lernte man aufgrund fortgeschrittener physikalischer Erkenntnisse, aus den verschiedenen Sternhelligkeiten wesentliche Aussagen über die Natur der strahlenden Objekte selbst abzuleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
