                                                "sense_id": "9f5fea3d-163f-3be8-893f-0c4192c57abc",
                                                "text": "Dem Bulletin der Regierung war zu entnehmen, dass es zu einer Einigung gekommen war."
                                            },
                                            {
                                                "example_id": "c40be8c6-83e5-49cc-a7e8-66f4b3d62ca2",
                                                "sense_id": "9f5fea3d-163f-3be8-893f-0c4192c57abc",
                                                "text": "Man hat schon lange nichts mehr von einem Bulletin zum Gesundheitszustand von … gehört."
                                            },
                                            {
                                                "example_id": "b95a5b5a-9fac-4e40-8e07-e757fcade0a0",
                                                "sense_id": "9f5fea3d-163f-3be8-893f-0c4192c57abc",
                                                "text": "„Das Bulletin der Großen Armee sprach von geringen Verlusten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
