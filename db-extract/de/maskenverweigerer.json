                ],
                "senses": [
                    {
                        "sense_id": "e1832fd1-0cad-3d40-bba1-ea186f954774",
                        "entry_id": "94f7bc60-cba1-3f73-b162-9fa74184ab2d",
                        "glosses": [
                            "Person, die das Tragen eines Mund-Nasen-Schutzes ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d58c1c0-61eb-43cd-ad8e-257bcfac3167",
                                "sense_id": "e1832fd1-0cad-3d40-bba1-ea186f954774",
                                "text": "„Die Beamten erteilen dem Maskenverweigerer einen Platzverweis.“"
                            },
                            {
                                "example_id": "92de7326-4398-471f-9c46-69bc4b1d4727",
                                "sense_id": "e1832fd1-0cad-3d40-bba1-ea186f954774",
                                "text": "„Offenbar gibt es an Thüringer Schulen immer mehr Maskenverweigerer.“"
                            },
                            {
                                "example_id": "55d359cc-4701-4e1c-b88a-08dcab1448ce",
                                "sense_id": "e1832fd1-0cad-3d40-bba1-ea186f954774",
                                "text": "„Wenig Verständnis für die Maskenverweigerer zeigt die grün-rote Rathauskoalition.“"
                            },
                            {
                                "example_id": "8b44c8a1-e153-4adc-88ca-32a9e623126a",
                                "sense_id": "e1832fd1-0cad-3d40-bba1-ea186f954774",
                                "text": "„Ein Jahr nach dem provokanten Auftritt von Maskenverweigerern in einem Supermarkt in Troisdorf beginnt heute der Prozess vor dem Bonner Landgericht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
