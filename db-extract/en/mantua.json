                                            {
                                                "example_id": "d8bca6a5-3a5a-4918-ba9e-c4a7c20987fd",
                                                "sense_id": "b58c0131-8686-3400-ab1e-d88b8993e7dd",
                                                "text": "Mantuę uważano za klucz do północnych Włoch i dlatego co jakiś czas narażona była na ataki ze strony przeciwnika"
                                            },
                                            {
                                                "example_id": "35b14fa3-888e-43a3-b270-ce8d72852e25",
                                                "sense_id": "b58c0131-8686-3400-ab1e-d88b8993e7dd",
                                                "text": "Mantua wyróżnia się brukiem z rzecznych okrąglaków, wspaniałym kompleksem pałacowym Gonzagów i okrągłym kościołem San Lorenzo z 1082 roku"
                                            }
                                        ],
