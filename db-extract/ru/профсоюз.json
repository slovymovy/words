                                        "examples": [
                                            {
                                                "example_id": "00c6a9e7-afe6-4c51-b2ba-78918dc0760f",
                                                "sense_id": "f3e02168-7821-33cb-a701-1944bf095f2b",
                                                "text": "Die Gewerkschaften riefen einen Streik aus."
                                            },
                                            {
                                                "example_id": "08a9b1ec-c9b3-46d7-b1ea-6e63dd2e05c0",
                                                "sense_id": "f3e02168-7821-33cb-a701-1944bf095f2b",
                                                "text": "„Das war die Auffassung einer Oppositionsgruppe unter dem Gewerkschafter Josef Zinner, der eine England-Gruppe von Vertrauensmännern der Gewerkschaften ins Leben gerufen hatte.“"
                                            },
                                            {
                                                "example_id": "77301b64-c411-49d1-a828-84999c6d8e49",
                                                "sense_id": "f3e02168-7821-33cb-a701-1944bf095f2b",
                                                "text": "„Der von Gewerkschaften geplante unbefristete Kitastreik in Berlin bleibt verboten.“"
                                            },
                                            {
                                                "example_id": "a78f0c19-73cf-4a0f-89bc-7fba2cc43d75",
                                                "sense_id": "f3e02168-7821-33cb-a701-1944bf095f2b",
                                                "text": "„Auf ein Verbot [Anmerkung: der Partei AfD] kann es aber gar nicht ankommen, weil nicht dem Bundesverfassungsgericht, sondern allein der Gewerkschaft die Beurteilung der politischen Unvereinbarkeit zusteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff784e84-2f0c-3992-a142-43fb028faa72",
