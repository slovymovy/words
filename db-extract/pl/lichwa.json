                    },
                    {
                        "translation_id": "963721d8-3393-4483-b050-457d4a82604c",
                        "source_entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
                        "source_sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                        "target_lang_word": "Wucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2314b89-c436-3a23-a172-a2d35363ce12",
                                        "entry_id": "a3caffd5-85bd-3212-ae5b-cec12fdec09b",
                                        "glosses": [
                                            "Einforderung zu hoher Kosten bei Geschäften, insbesondere bei Krediten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c61af0e-b66e-4b16-9533-e95e637f3da5",
                                                "sense_id": "a2314b89-c436-3a23-a172-a2d35363ce12",
                                                "text": "Der Wucher kannte keine Grenzen, so dass er als kriminell eingestuft wurde."
                                            },
                                            {
                                                "example_id": "b2404d31-2728-4226-89ad-303f5082302f",
                                                "sense_id": "a2314b89-c436-3a23-a172-a2d35363ce12",
                                                "text": "20 €? Das ist der reinste Wucher!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3385ed6-a8ef-3ddd-9e4a-beb5b23c006c",
                                        "entry_id": "a3caffd5-85bd-3212-ae5b-cec12fdec09b",
                                        "glosses": [
                                            "Zinsen, Verleihen von Geld gegen Zinsen bis hin zu jeglichem gewinnbringendem Geschäft"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05fdc8ab-27fa-41c1-aef9-7817fcb4c552",
                                                "sense_id": "e3385ed6-a8ef-3ddd-9e4a-beb5b23c006c",
                                                "text": "„Was ist Wucher? Im allgemeinen wird jeder übermäsige Gewinn, jede eigennützige Handlung, wodurch das Eigenthum anderer auf - eine empfindliche Art gekränket wird, Wucher genennet.“ (1793)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "105f0bc7-5971-4790-b5b7-b689c0d8f705",
                        "source_entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
