                        "examples": [
                            {
                                "example_id": "12433ca7-566c-4640-86dd-ab6d0142a692",
                                "sense_id": "62f82833-edcb-380d-81d0-0b0b83f37aa1",
                                "text": "De 44-jarige Thaddeus Ma Daqin kondigde zaterdag aan het einde van de mis aan dat hij geen deel meer uit wilde maken van de staatsvariant van het katholicisme. Vlak daarvoor was hij door de paus benoemd tot hulpbisschop. Zondag verscheen hij niet in de kerk en volgens de websites krijgt niemand contact met hem."
                            },
                            {
                                "example_id": "b1f68ea3-6973-4fba-ac0a-e19250822038",
                                "sense_id": "62f82833-edcb-380d-81d0-0b0b83f37aa1",
                                "text": "Van den Hende werd in 2006 hulpbisschop van Breda en een jaar later volgde zijn benoeming tot bisschop. Hij is geboren in Groningen, waar hij in 1991 tot priester werd gewijd."
                            }
                        ]
                    }
