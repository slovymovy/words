                                "target_senses": [
                                    {
                                        "sense_id": "28706fc6-7b2c-3fa6-a606-a08170d8111a",
                                        "entry_id": "434ffa41-fddf-3f7f-97e3-3041eb935bad",
                                        "glosses": [
                                            "One of the appendages of a fish, used to propel itself and to manoeuvre/maneuver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a559d48-07e7-4f4e-8ff1-452c45e338bd",
                                                "sense_id": "28706fc6-7b2c-3fa6-a606-a08170d8111a",
                                                "text": "The fish's fins minimize water flow."
                                            },
                                            {
                                                "example_id": "c6099a67-a465-4fd0-8477-74096289e636",
                                                "sense_id": "28706fc6-7b2c-3fa6-a606-a08170d8111a",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a92899-b1fc-3200-897f-25cc1816007e",
                                        "entry_id": "434ffa41-fddf-3f7f-97e3-3041eb935bad",
                                        "glosses": [
                                            "A similar appendage of a cetacean or other marine animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fe8c5f-0f96-49e8-ba64-65abe5b3dce4",
                                                "sense_id": "38a92899-b1fc-3200-897f-25cc1816007e",
                                                "text": "a dolphin's fin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fade93-881d-34d9-b727-25f9df79b1c6",
                                        "entry_id": "434ffa41-fddf-3f7f-97e3-3041eb935bad",
                                        "glosses": [
                                            "A thin, rigid component of an aircraft, extending from the fuselage and used to stabilise and steer the aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a43f50-d3fd-457d-ab5a-a505c854629e",
                                                "sense_id": "04fade93-881d-34d9-b727-25f9df79b1c6",
                                                "text": "The fin stabilises the plane in flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076805d6-3c13-368b-861e-a5fddd6a4b34",
                                        "entry_id": "434ffa41-fddf-3f7f-97e3-3041eb935bad",
                                        "glosses": [
