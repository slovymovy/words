                    {
                        "sense_id": "0683f0b0-7f8d-32b0-a835-62a5532eaf5f",
                        "entry_id": "dbf34cab-5f23-3cb5-82b6-2c474462724d",
                        "glosses": [
                            "Handhabung eines Ruders: Eintauchen und Bewegen des Ruders, um das Boot anzutreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf2007f-d3a2-4d93-8023-3a6544220d53",
                                "sense_id": "0683f0b0-7f8d-32b0-a835-62a5532eaf5f",
                                "text": "„Ein einziger Ruderschlag war hinlänglich, es weit in den Strom hinauszutreiben.“"
                            },
                            {
                                "example_id": "62f3cce2-9e67-45c5-9b5c-6b6bf13420da",
                                "sense_id": "0683f0b0-7f8d-32b0-a835-62a5532eaf5f",
                                "text": "„Von dem rechten Ufer der Insel schallten jetzt regelmäßige, schnelle Ruderschläge herüber; deutlich konnten die lauschenden Männer hören, wie das nahende Boot mit aller Macht gegen die starke Strömung ankämpfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
