                ],
                "senses": [
                    {
                        "sense_id": "ba20dffc-58a5-399a-b37d-4a3650b8899c",
                        "entry_id": "819bfedb-231e-3949-9ccf-7a81a99d56be",
                        "glosses": [
                            "Atome d’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b7e5cdf-b250-45ef-9402-f84bd2b62f2f",
                                "sense_id": "ba20dffc-58a5-399a-b37d-4a3650b8899c",
                                "text": "Thioacetale sind Derivate der Acetale, bei denen ein Sauerstoffatom durch ein Schwefelatom ersetzt wurde.",
                                "translation": "Les thioacétals sont des dérivés des acétals dans lesquels un atome d’oxygène a été remplacé par un atome de soufre."
                            },
                            {
                                "example_id": "22a2acb6-a8b2-41fe-a373-473666e57762",
                                "sense_id": "ba20dffc-58a5-399a-b37d-4a3650b8899c",
                                "text": "Zwei Wasserstoffatome verbinden sich mit einem Sauerstoffatom zu einem polaren Molekül (H₂O).",
                                "translation": "Deux atomes d’hydrogène s’associent à un atome d’oxygène et forment une molécule polaire (H₂O)."
                            },
                            {
                                "example_id": "3c571941-590d-4f27-b97f-14743c9767a6",
                                "sense_id": "ba20dffc-58a5-399a-b37d-4a3650b8899c",
                                "text": "Wenn das Sauerstoffatom die Bindungselektronen stärker zu sich herüberzieht, dann zieht es damit auch die negative Ladung der Elektronen stärker zu sich herüber und lädt sich daher schwach negativ auf.",
                                "translation": "Si un atome d’oxygène attire les électrons de liaison plus fortement vers lui, alors il attire également la charge négative des électrons plus fortement vers lui et prend ainsi une faible charge négative."
                            }
                        ]
                    }
                ],
