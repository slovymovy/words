                ],
                "senses": [
                    {
                        "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                        "entry_id": "25a6ff12-7af4-36b0-bd31-c4150fb05930",
                        "glosses": [
                            "historisches Kampfspiel mit lebenden Kämpfern oder Spielfiguren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9266d2f0-2137-4483-85ae-88b17084e3cd",
                                "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                                "text": "„Einen schweren Stein zu stoßen und anschließend über den Stein möglichst noch hinaus zu springen, ist ein uraltes Ritterspiel, an dem sich der Heldensage nach schon Siegfried von Xanten und Gunther von Worms beteiligten, als sie die stolze Brunhilde von Island als Braut gewinnen wollten.“"
                            },
                            {
                                "example_id": "62524c86-0bd1-4622-bbaf-f47706a58564",
                                "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                                "text": "„Bei den Ritterspielen in der Jugendherberge Burg Blankenheim werden Schwerter geschmiedet und Gauklerstücke für das große Burgfest einstudiert, im Survivalcamp versucht die ganze Familie, sich mit Knotenkünsten, Kartenlesen und Biwakbauen durch die Wildnis zu schlagen.“"
                            },
                            {
                                "example_id": "1f2e78cb-869e-4169-9381-f58b92c70783",
                                "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                                "text": "„Schmutzig braune Wiesen, mittendrin steht wie die vergessene Reliquie eines Ritterspiels ein einsamer Festungsturm – das Denkmal für die serbischen Gefallenen in der Schlacht gegen die Türken.“"
                            },
                            {
                                "example_id": "dfc50bff-f4f2-4c12-a174-211cc7a62944",
                                "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                                "text": "„Wie die meisten Expertenkollegen und Sammler hat Weis sich die Leidenschaft des kindlichen Ritterspiels in die Erwachsenenwelt hinübergerettet.“"
                            },
                            {
                                "example_id": "cdd411b8-36cd-4b68-b8ea-2e409fcfe4db",
                                "sense_id": "2f822fc6-7c92-3023-92ac-15bf1eec838f",
                                "text": "„Mit diesem Ritterspiel voll von Mord und Totschlag legte er einen Flammenkranz um sein Inselparadies, ein wenig wie Wotan bei Wagner, um seine Tochter zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
