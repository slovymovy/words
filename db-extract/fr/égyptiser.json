                "senses": [
                    {
                        "sense_id": "521f6277-7bd4-3ff6-afb2-2c4c73597aa0",
                        "entry_id": "e915963b-6bf6-365d-b85c-2c8bbc8f44eb",
                        "glosses": [
                            "Donner un caractère égyptien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a77908-710f-4002-8b44-b266ace9f5d4",
                                "sense_id": "521f6277-7bd4-3ff6-afb2-2c4c73597aa0",
                                "text": "Dans le dessin incertain de cette stèle, un seul élément est traité avec une franchise qui trahit le travail d’après nature : la coiffure de l’orant, détail pour lequel la main de l’artiste n’a pas été guindée par le souci d’égyptiser."
                            },
                            {
                                "example_id": "ceff30be-b32f-4599-a496-70163b8a2fb4",
                                "sense_id": "521f6277-7bd4-3ff6-afb2-2c4c73597aa0",
                                "text": "À gauche, la fleur de lotus, au bas de la composition, suffit à égyptiser cette représentation d’une orante."
                            },
                            {
                                "example_id": "80285a8f-4be1-450b-9225-ed900f57136b",
                                "sense_id": "521f6277-7bd4-3ff6-afb2-2c4c73597aa0",
                                "text": "Sa fille Myriam est brune à souhait, une peu égyptisée ici et là."
                            }
                        ]
                    }
