                                        "entry_id": "fcee7119-18a4-35ab-ab7c-777e02f4127b",
                                        "glosses": [
                                            "A statement or claim of questionable accuracy, from no known reliable source, usually spread by word of mouth."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c742ad9f-090e-4960-bf26-6109bb487ed4",
                                                "sense_id": "4196448b-b0f9-35af-a07b-6a6bf476115d",
                                                "text": "There's a rumor going round that he's going to get married."
                                            },
                                            {
                                                "example_id": "6a038345-fcba-4959-85e4-e02e7c1290d8",
                                                "sense_id": "4196448b-b0f9-35af-a07b-6a6bf476115d",
                                                "text": "vile rumor"
                                            },
                                            {
                                                "example_id": "43cf2273-b6c7-48b7-9e66-6d1a99f369a0",
                                                "sense_id": "4196448b-b0f9-35af-a07b-6a6bf476115d",
                                                "text": "a rumor going round"
                                            },
                                            {
                                                "example_id": "6a89b215-f063-4bb3-a429-57b2295428a3",
                                                "sense_id": "4196448b-b0f9-35af-a07b-6a6bf476115d",
                                                "text": "vicious rumors"
                                            },
                                            {
                                                "example_id": "fe18ac9c-7014-4db6-af46-2d4acdbca395",
                                                "sense_id": "4196448b-b0f9-35af-a07b-6a6bf476115d",
                                                "text": "spread a rumor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a6d682-5b29-3b7e-beb0-47d02ba8ae2f",
                                        "entry_id": "fcee7119-18a4-35ab-ab7c-777e02f4127b",
                                        "glosses": [
                                            "Information or misinformation of the kind contained in such claims."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9898804-8e9f-4868-b9bf-805545311ea9",
                                                "sense_id": "92a6d682-5b29-3b7e-beb0-47d02ba8ae2f",
                                                "text": "They say he used to be a thief, but that's just rumor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6563e22e-fae6-3425-ade3-eb711e4ce484",
                                        "entry_id": "fcee7119-18a4-35ab-ab7c-777e02f4127b",
                                        "glosses": [
                                            "Report, news, information in general."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdf78abe-b1c9-4402-a579-ed57e079ba29",
                                                "sense_id": "6563e22e-fae6-3425-ade3-eb711e4ce484",
                                                "text": "It stands a city aloof. There hath been no rumour of it—I alone have dreamed of it, and I may not be sure that my dreams are true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32f3d7a-19e2-344e-8702-8285cf3ae885",
                                        "entry_id": "fcee7119-18a4-35ab-ab7c-777e02f4127b",
