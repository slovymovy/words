                "senses": [
                    {
                        "sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                        "entry_id": "4a7feda4-f319-30cc-8b8f-d55633959a6b",
                        "glosses": [
                            "een amusant, kort verhaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b576cad7-864a-40fd-bb32-0ece32254f29",
                                "sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                                "text": "Het boek bevat leuke verhalen en anekdotes."
                            },
                            {
                                "example_id": "afa9bf56-dca5-4483-9d1c-002afb84c7a6",
                                "sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                                "text": "Tijdens hun afscheid in het café in Amersfoort had hij haar op de valreep nog wat anekdotes verteld over ondernemers die hun steun aan zijn site betuigden."
                            },
                            {
                                "example_id": "0fe07bc4-5842-4746-861c-6748b60f26b3",
                                "sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                                "text": "\" „Dus ik heb je een goede beschrijving van hem gegeven?\" „Mijn oordeel was gebaseerd op de kleine anekdoten die je me over hem hebt verteld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e005722b-c3d7-4181-aa68-1e03c54078f7",
                        "source_entry_id": "4a7feda4-f319-30cc-8b8f-d55633959a6b",
                        "source_sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                        "source_sense_description": "een amusant, kort verhaal",
                        "target_lang_word": "Anekdote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anekdote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                        "entry_id": "97ace95d-c3f3-35d1-97b8-fab7d5f95160",
                                        "glosses": [
                                            "kurze, humorvolle Erzählung, die Typisches, Spezifisches oder auch Enthüllendes einer Person, Geisteshaltung, Epoche betont"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "860c60c2-ef5d-496d-ac54-c423bcefeb89",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "Anekdoten sind oft witzig."
                                            },
                                            {
                                                "example_id": "02752dad-2445-40bd-a6e7-3205a6cccc45",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "6190340c-d230-4190-ae75-a6d06d72f4d5",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "„Ich weiß nur, dass die Geschichte von Narcisse keine schlichte Anekdote ist.“"
                                            },
                                            {
                                                "example_id": "fe901168-278e-4d4e-beda-f94c18bd63e7",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "„Halder schloß seine Anekdote mit einem schallenden Löwengebrüll.“"
                                            },
                                            {
                                                "example_id": "b37e39d8-1404-4c6a-a3b8-d3c9723b3557",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "„Hebel hat diese Anekdote unter einem bestimmten Gesichtspunkt erzählt.“"
                                            },
                                            {
                                                "example_id": "1a50d1e7-9b6d-46ac-80e5-fa5c1df9f564",
                                                "sense_id": "c9a44a7f-4889-3f7d-a590-e7c1aeb89c38",
                                                "text": "„Witz und Anekdote gipfeln in einer Pointe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee40ea00-0f04-4ae1-a24b-386d0860fc40",
                        "source_entry_id": "4a7feda4-f319-30cc-8b8f-d55633959a6b",
                        "source_sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                        "source_sense_description": "een amusant, kort verhaal",
                        "target_lang_word": "anecdote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anecdote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307962c8-4e99-3d36-a246-bb3e718afc62",
                                        "entry_id": "bcd7558c-709b-31d8-8c35-d74a6e9b1f70",
                                        "glosses": [
                                            "A short account of a real incident or person, often humorous or interesting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6553d973-553e-4ec5-b167-a9781516cc5e",
                                                "sense_id": "307962c8-4e99-3d36-a246-bb3e718afc62",
                                                "text": "tell an anecdote"
                                            },
                                            {
                                                "example_id": "d939a00a-6112-453e-824b-45048a8086a6",
                                                "sense_id": "307962c8-4e99-3d36-a246-bb3e718afc62",
                                                "text": "relate a short anecdote"
                                            },
                                            {
                                                "example_id": "d9277647-d5b9-400a-8f6c-57ef4b55d15a",
                                                "sense_id": "307962c8-4e99-3d36-a246-bb3e718afc62",
                                                "text": "Like all travellers, he is full of anecdote, and has at his command the rarest news of the time. […] Generous, convivial, and full of anecdote, the mercantile agent is a good companion, and his conversation never fails to make glad and jocund the society of that otherwise dullest of places, an English stage coach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1bd087-a293-3e5a-9b62-67b0c0706f3a",
                                        "entry_id": "bcd7558c-709b-31d8-8c35-d74a6e9b1f70",
                                        "glosses": [
                                            "An account which supports an argument, but which is not supported by scientific or statistical analysis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a198aba-a8d1-327b-a385-cdd909cbd801",
                                        "entry_id": "bcd7558c-709b-31d8-8c35-d74a6e9b1f70",
                                        "glosses": [
                                            "A previously untold secret account of an incident."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anecdote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20c0c7ec-3e91-3f15-9717-0ed7c7205ffa",
                                        "entry_id": "46822f09-2e37-3731-8190-e11c073a5779",
                                        "glosses": [
                                            "To tell anecdotes (about)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ab933c-823c-44e5-8c4a-f92e06c1f728",
                                                "sense_id": "20c0c7ec-3e91-3f15-9717-0ed7c7205ffa",
                                                "text": "They were all men of the same set, knowing one another intimately, and knowing the same people; so they fell to talking and anecdoting in such pleasant wise that dinner-time approached […]"
                                            },
                                            {
                                                "example_id": "9d4f2576-d85a-4a6a-bd64-23011f0ae404",
                                                "sense_id": "20c0c7ec-3e91-3f15-9717-0ed7c7205ffa",
                                                "text": "Bob anecdoted the circus he and Jimmy had seen that afternoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03e1ed43-6836-4965-984f-333dfbed2830",
                        "source_entry_id": "4a7feda4-f319-30cc-8b8f-d55633959a6b",
                        "source_sense_id": "0cc5da56-d7d8-3465-ab4d-c12c66ee55a7",
                        "source_sense_description": "een amusant, kort verhaal",
                        "target_lang_word": "anecdote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anecdote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b14c1d4f-15b3-3ac0-84ce-4fa4c0d2ca07",
                                        "entry_id": "26a973bb-2b7f-3c98-a5c3-45723bef746f",
                                        "glosses": [
                                            "Particularité historique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c496027-9bd2-4754-a622-2497f0241187",
                                                "sense_id": "b14c1d4f-15b3-3ac0-84ce-4fa4c0d2ca07",
                                                "text": "Pour l’anecdote, la plus ancienne étymologie latine du mot, satura, signifiait « macédoine de légumes ». Sans aucun rapport avec la choucroute, mais avec la farce, le mot a ensuite désigné une danse parodique, une pièce dramatique, puis à l'époque classique un poème servant à dénoncer les travers de la société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                        "entry_id": "26a973bb-2b7f-3c98-a5c3-45723bef746f",
                                        "glosses": [
                                            "Récit d’un petit fait curieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd630cdc-234d-4446-bf07-e18c897c4899",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "Elle sait beaucoup d’anecdotes sur les personnes de distinction qui habitent Paris. Et lorsqu’elle les conte, elle fait comme mon cuisinier Pampaloni quand il sert les œufs sur le plat : il ne les sale pas, mais il met la salière à côté. La langue de Mme Marmet est très douce. Le sel est à côté, dans ses yeux. C’est le plat de Pampaloni, my love : chacun le mange à son goût."
                                            },
                                            {
                                                "example_id": "d82c81dd-7c33-4da1-a904-1557e6745e6e",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "Il songe à tout, aux plus petites choses. Il crayonne de malicieux portraits, raconte avec enjouement des anecdotes spirituelles."
                                            },
                                            {
                                                "example_id": "375fa91d-4621-4b12-871d-eed1ad8d0241",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "L'anecdote est flatteuse pour la gloire de Raschi. Il ne lui manque que d'être vraie."
                                            },
                                            {
                                                "example_id": "f25d0814-fc00-4ca6-b242-384a8eedcc92",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "Le samedi 16 juillet, Michel Le Goffic, archéologue, lui a fait découvrir, ainsi qu’à Léa De Oliveira Costa, étudiante en histoire, les mystères et anecdotes des lieux."
                                            },
                                            {
                                                "example_id": "3a90000f-359f-4e13-8104-94f75699432c",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "Le prince de C. dut raconter sur son prédécesseur quelques sympathiques anecdotes, trop familières toutefois pour avoir pris place dans le discours lu à l’église."
                                            },
                                            {
                                                "example_id": "a9bb9a2b-2eb3-4840-a43f-7397b28f17b0",
                                                "sense_id": "c13495b9-0122-30c1-b67a-1ad4ab5278b7",
                                                "text": "Quand ses potes et lui ne sont pas en train de fumer le shit volé à ses parents, ils parcourent le quartier à vélo en braillant des anecdotes hilarantes sur toutes les fois où ils se sont comportés comme des trous de balle de première catégorie de la terre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
