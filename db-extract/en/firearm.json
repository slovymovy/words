                    {
                        "translation_id": "8a21e982-6305-49fc-b634-88cd748a6c07",
                        "source_entry_id": "1ae38a1d-7e76-3d46-8a4d-4de65f9405a3",
                        "source_sense_id": "b1078e84-b969-3a5f-891d-ddd2f1e32114",
                        "source_sense_description": "personal weapon",
                        "target_lang_word": "Schusswaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schusswaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d68b322c-2cf7-3ff1-b40a-82ae99b6cade",
                                        "entry_id": "44837b02-6724-381f-9615-af227ae8a36a",
                                        "glosses": [
                                            "Waffe zum Schießen (oft synonym mit Feuerwaffe gebraucht)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e466dd19-96d0-4e2f-99b6-3efb1ae12fec",
                                                "sense_id": "d68b322c-2cf7-3ff1-b40a-82ae99b6cade",
                                                "text": "Wer Schusswaffen führen will, bedarf der Erlaubnis der zuständigen Behörde."
                                            },
                                            {
                                                "example_id": "1d7defe8-3b45-4edc-999b-87784b7560d5",
                                                "sense_id": "d68b322c-2cf7-3ff1-b40a-82ae99b6cade",
                                                "text": "„In seiner Tasche wurden zwei selbstgebaute Schusswaffen gefunden.“"
                                            },
                                            {
                                                "example_id": "d3973002-1b43-47fa-97e2-1a915d096255",
                                                "sense_id": "d68b322c-2cf7-3ff1-b40a-82ae99b6cade",
                                                "text": "„Die inneren Kämpfe verstärkten die Abhängigkeiten zu den Europäern, deren Schusswaffen die Indigenen zunehmend brauchten.“"
                                            },
                                            {
                                                "example_id": "4f145a41-dbc4-432f-9941-bb05e73240c6",
                                                "sense_id": "d68b322c-2cf7-3ff1-b40a-82ae99b6cade",
                                                "text": "„Ich jedenfalls war nicht traurig darüber, die Schusswaffen nicht mehr um mich haben zu müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3dabbd82-a570-3f8e-b797-73b8e7aaedee",
                                        "entry_id": "44837b02-6724-381f-9615-af227ae8a36a",
                                        "glosses": [
                                            "Schusswaffe^([1]) mit einem Lauf"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1341a42c-57e9-42f4-a633-8bd490cb3f0a",
                                                "sense_id": "3dabbd82-a570-3f8e-b797-73b8e7aaedee",
                                                "text": "Die Posten machen ohne Vorwarnung von der Schusswaffe Gebrauch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69c4256e-b333-4e02-8856-b4d030cf87e4",
                        "source_entry_id": "1ae38a1d-7e76-3d46-8a4d-4de65f9405a3",
                        "source_sense_id": "b1078e84-b969-3a5f-891d-ddd2f1e32114",
                        "source_sense_description": "personal weapon",
                        "target_lang_word": "Feuerwaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                        "entry_id": "9e804d56-ec9b-31f9-bfaa-7afc5ca4dc2b",
                                        "glosses": [
                                            "Schusswaffe, die mit Schießpulver oder ähnlichen Treibmitteln betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659d144e-8d2b-45ec-b1d9-3d4fd01f0ae3",
                                                "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                                "text": "In Wildwestfilmen spielen Feuerwaffen immer eine große Rolle."
                                            },
                                            {
                                                "example_id": "dd553e6a-4ffb-4304-8d7b-0bdb73b2053c",
                                                "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                                "text": "„Vielleicht hatten sich die feindlichen Heere fürs Erste mit genügend Gewehren, Kugeln und Schießpulver eingedeckt, vielleicht war aber auch Agaja schon zu sehr in die Defensive gedrängt, um sein Heer weiter mit Feuerwaffen versorgen zu können.“"
                                            },
                                            {
                                                "example_id": "5e0379e4-641f-4fea-be1b-9c367d7e1de6",
                                                "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                                "text": "„Vielfach verteidigen die Einheimischen ihr Land, doch gegen die Feuerwaffen der Weißen sind sie mit ihren Speeren machtlos.“"
                                            },
                                            {
                                                "example_id": "a5099403-f360-4997-94a6-34fb39e333d2",
                                                "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                                "text": "„Er war geschickt im Umgang mit Feuerwaffen.“"
                                            },
                                            {
                                                "example_id": "369d7e87-df35-450e-a952-66f96e6e968b",
                                                "sense_id": "a62040cd-7dc2-3f26-a2c0-c2a3cb60cb00",
                                                "text": "„Das war, neben seinen Geschäften mit den Indianern, denen er Feuerwaffen verkaufte, sein Hauptziel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
