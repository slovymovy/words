                                "target_senses": [
                                    {
                                        "sense_id": "38f260ff-ceca-3b21-9df8-aeb9fe406f71",
                                        "entry_id": "3e0b1357-6980-3423-8328-752fdf344b6a",
                                        "glosses": [
                                            "To compose sonnets."
                                        ],
                                        "tags": [
