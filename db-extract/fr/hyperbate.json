                        "entry_id": "ae4b99ab-827a-3304-ab14-6553e3b143e7",
                        "glosses": [
                            "Figure de style qui consiste à intervertir, à renverser l’ordre naturel du discours."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "aeb58627-cba8-44db-973a-6837f8a5665f",
                                "sense_id": "baf623ab-69d7-3d1f-a0e5-eb161bcab602",
                                "text": "L’hyperbate ou inversion est une figure qui transpose l’ordre de la syntaxe ordinaire."
                            },
                            {
                                "example_id": "285c23a8-29cb-4f4d-a42c-522dd691b2ab",
                                "sense_id": "baf623ab-69d7-3d1f-a0e5-eb161bcab602",
                                "text": "« À huit heures la chaleur commence et les fulgurations »"
                            }
                        ]
                    }
                ],
