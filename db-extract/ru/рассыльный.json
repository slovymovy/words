                "senses": [
                    {
                        "sense_id": "fe083264-5eb8-30b7-94fc-4344add4669e",
                        "entry_id": "a88affa4-4c0b-3ee6-b832-cc8e796533ca",
                        "glosses": [
                            "messenger, errand boy (a male employed to run errands)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc4b623-4974-49cc-b98a-c5f7c679f09b",
                                "sense_id": "fe083264-5eb8-30b7-94fc-4344add4669e",
                                "text": "Едва́ просты́л след рассы́льного, увёзшего самозва́нцев, едва́ узна́ли глу́повцы, что они́ оста́лись совсе́м без градонача́льника, как, дви́жимые си́лою начальстволю́бия, неме́дленно впа́ли в ана́рхию.",
                                "translation": "Hardly had the messenger set off with the pretenders, and hardly had the Glupovites realized that they were now left with no governor at all, than, stirred by their ardent love of authority, they promptly lapsed into anarchy.",
                                "english": "Hardly had the messenger set off with the pretenders, and hardly had the Glupovites realized that they were now left with no governor at all, than, stirred by their ardent love of authority, they promptly lapsed into anarchy."
                            }
                        ]
