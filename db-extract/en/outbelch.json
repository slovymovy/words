                "senses": [
                    {
                        "sense_id": "704ce36c-6a24-3a84-846c-77281ac064d6",
                        "entry_id": "df0d066b-9913-3313-9f0e-ffc08117f838",
                        "glosses": [
                            "To belch more or louder than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ef1e5f57-f75d-40e8-b24b-9081bc3a7f06",
                                "sense_id": "704ce36c-6a24-3a84-846c-77281ac064d6",
                                "text": "Hang him, whose verse cannot outbelch the wind, That cannot beard and brave Dan Æolus ; That, when the cloud of his invention breaks, Cannot outcrack the scarecrow thunderbolt."
                            },
                            {
                                "example_id": "b7184d1d-5c71-47ae-9006-61f032492016",
                                "sense_id": "704ce36c-6a24-3a84-846c-77281ac064d6",
                                "text": "He could outeat, outdrink, and outbelch any monk from Tashilhunpo to Kumbum."
                            },
                            {
                                "example_id": "7a86591c-7c30-41d5-8d86-f3a5ede80765",
                                "sense_id": "704ce36c-6a24-3a84-846c-77281ac064d6",
                                "text": "I don't mean he goes off to his club and says proudly, \" Do you know, old man, my little woman can outbelch any cab driver in London.\""
                            },
                            {
                                "example_id": "e4c8e21b-91c2-4a64-9d61-f3b11af98bdf",
                                "sense_id": "704ce36c-6a24-3a84-846c-77281ac064d6",
                                "text": "Why, the way they tried to outbelch each other was downright disgusting."
                            }
                        ]
                    }
                ],
