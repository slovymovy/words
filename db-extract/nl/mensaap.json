                            {
                                "target_word": "ape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0138ba3b-5acd-372b-b935-a7e8342380cf",
                                        "entry_id": "82e5ae40-73bc-3e77-8284-bad9bbf30eca",
                                        "glosses": [
                                            "To behave like an ape."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8fed404-abe6-3fbd-8133-14d5282847fb",
                                        "entry_id": "82e5ae40-73bc-3e77-8284-bad9bbf30eca",
                                        "glosses": [
                                            "To imitate or mimic, particularly to imitate poorly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a34c72f-e2ab-4e32-9ed6-9213f6cfe3e3",
                                                "sense_id": "e8fed404-abe6-3fbd-8133-14d5282847fb",
                                                "text": "And well their dignity it ſuits, / To ape the gravity of brutes."
                                            },
                                            {
                                                "example_id": "645642c4-c603-41f1-9809-57ab0c1b2f0a",
                                                "sense_id": "e8fed404-abe6-3fbd-8133-14d5282847fb",
                                                "text": "But there’s this difference; one is gold put to the use of paving-stones, and the other is tin polished to ape a service of silver."
                                            },
                                            {
                                                "example_id": "2dc88e49-cd5e-4d4b-b451-ce96d2e06e21",
                                                "sense_id": "e8fed404-abe6-3fbd-8133-14d5282847fb",
                                                "text": "It is not conceived as a mere “aping” in externals nor as an enacting in the sense of assuming a foreign role."
                                            },
                                            {
                                                "example_id": "59e87a8a-6acf-42cc-a7a6-7f0197f6536b",
                                                "sense_id": "e8fed404-abe6-3fbd-8133-14d5282847fb",
                                                "text": "Every year a paper or a book appears, bemoaning the fate of economics and complaining about its attempts to ape physics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "132a7783-d1d2-39cb-9782-6fda15bb8d51",
                                        "entry_id": "dde6bf08-8f3a-3b07-9f21-b7a34ee31c13",
                                        "glosses": [
                                            "Wild; crazy."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48031a8-4659-4eba-b00c-bc5d7e438410",
                                                "sense_id": "132a7783-d1d2-39cb-9782-6fda15bb8d51",
                                                "text": "We were ape over the new look."
                                            },
                                            {
                                                "example_id": "f6813170-b9ae-45db-b236-b5afccde704f",
                                                "sense_id": "132a7783-d1d2-39cb-9782-6fda15bb8d51",
                                                "text": "He went ape when he heard the bad news."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
