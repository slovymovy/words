                ],
                "senses": [
                    {
                        "sense_id": "33f9aac8-0523-31ac-bc9c-e66d54ba32e7",
                        "entry_id": "93a9110a-71a1-3e46-8aaa-db3f859203db",
                        "glosses": [
                            "kleiner, pigmentierter Fleck auf der Haut einer meist weiblichen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da10950-4ed2-4ba4-b18b-3fdd5ae3becd",
                                "sense_id": "33f9aac8-0523-31ac-bc9c-e66d54ba32e7",
                                "text": "„Ein ganz markantes Zeichen war bei ihr der Leberfleck oberhalb der rechten Lippe oder auch als Schönheitsfleck bezeichnet, der von Frauen schon immer gern als ganz besondere Waffe eingesetzt wurde.“"
                            },
                            {
                                "example_id": "7f145049-81f8-4374-96f3-8bb9953f3134",
                                "sense_id": "33f9aac8-0523-31ac-bc9c-e66d54ba32e7",
                                "text": "„Die Sonne tauchte das Hotelzimmer in ein goldenes, dunstiges Licht, in dem sie noch schöner aussah als sonst, weil es ihr Gesicht leuchten ließ und den Schönheitsfleck auf ihrer Wange und ihren ausgeprägten Amorbogen betonte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
