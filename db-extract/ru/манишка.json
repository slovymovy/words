                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad88c5e8-d017-3c85-87c9-6ff02b14698b",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "A donkey."
