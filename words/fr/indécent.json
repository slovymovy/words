                },
                {
                    "sense_id": "0f48a9e8-af60-3fa0-845c-b0cc43be4884",
                    "sense_definition": "Qui est excessif, démesuré ou inopportun, particulièrement en parlant d'un horaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin fait du bruit à une heure <w>indécente</w> sans penser aux autres."
                        },
                        {
                            "text": "Elle a décidé de téléphoner à une heure <w>indécente</w> pour régler ce problème."
