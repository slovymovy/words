{
    "word_family": [
        "gas",
        "light"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4d6d4f9-f7fe-3570-a94e-2681787bb337",
                    "sense_definition": "To manipulate someone such that they doubt their own memory, perceptions of reality, or sanity, typically for malevolent reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>gaslight</w> his partner by denying that he ever said those hurtful things.",
                            "target_lang_translations": {
                                "zh": "他否认自己说过那些伤人的话，试图以此<w>煤气灯效应</w>操纵他的伴侣。"
                            }
                        },
                        {
                            "text": "It is difficult to recognize when someone is <w>gaslighting</w> you until you start questioning your own sanity.",
                            "target_lang_translations": {
                                "zh": "当一个人开始怀疑自己的理智时，才意识到自己正在被<w>精神控制</w>，这通常很难察觉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "head-game"
                    ],
                    "common_phrases": [
                        "stop gaslighting"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过心理操纵使某人怀疑自己的记忆、现实感知或理智，通常出于恶意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "煤气灯效应",
                                "target_lang_sense_clarification": "指代这种心理操纵现象的术语。"
                            },
                            {
                                "target_lang_word": "精神控制",
                                "target_lang_sense_clarification": "指通过心理手段对他人进行控制。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30a9c49d-1842-3606-90e4-d5a31cf00143",
                    "sense_definition": "To deceive, trick, or lie to.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychological_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician attempted to <w>gaslight</w> the public about the true state of the economy.",
                            "target_lang_translations": {
                                "zh": "那位政客试图就经济的真实状况<w>欺骗</w>公众。"
                            }
                        },
                        {
                            "text": "Do not let them <w>gaslight</w> you into believing that the mistake was entirely your fault.",
                            "target_lang_translations": {
                                "zh": "不要让他们<w>蒙蔽</w>你，让你以为那个错误完全是你的错。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "欺骗、哄骗或对某人撒谎。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "指用虚假言行掩盖真相。"
                            },
                            {
                                "target_lang_word": "蒙蔽",
                                "target_lang_sense_clarification": "指用手段使人受骗。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a5bad87-f912-3e05-9166-b41151b35921",
                    "sense_definition": "A lamp which operates by burning piped illuminating gas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old street was illuminated by the flickering glow of a <w>gaslight</w>.",
                            "target_lang_translations": {
                                "zh": "古老的街道被一盏闪烁的<w>煤气灯</w>照亮。"
                            }
                        },
                        {
                            "text": "Walking home under the <w>gaslight</w> felt like stepping back into the nineteenth century.",
                            "target_lang_translations": {
                                "zh": "走在<w>煤气灯</w>下回家，感觉就像回到了十九世纪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gas lamp"
                    ],
                    "common_phrases": [
                        "flickering gaslight"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical lighting technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过燃烧管道输送的照明煤气来发光的灯。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "煤气灯",
                                "target_lang_sense_clarification": "指历史上的煤气照明设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8436437-f34f-390d-b479-6695424a5910",
                    "sense_definition": "The light produced by the burning gas in such a lamp.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to read the small print by the dim <w>gaslight</w>.",
                            "target_lang_translations": {
                                "zh": "她借着昏暗的<w>煤气灯光</w>费力地阅读小字。"
                            }
                        },
                        {
                            "text": "The room was filled with the soft, yellow <w>gaslight</w> from the wall fixtures.",
                            "target_lang_translations": {
                                "zh": "房间里充满了从壁灯发出的柔和、黄色的<w>煤气灯光</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dim gaslight"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical lighting technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "由煤气灯发出的光。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "煤气灯光",
                                "target_lang_sense_clarification": "指煤气灯发出的光线。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}