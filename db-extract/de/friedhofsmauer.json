                "senses": [
                    {
                        "sense_id": "ee688ba5-cc42-306f-952b-b60f3fa8e268",
                        "entry_id": "02ca46d8-ebc9-331b-9c69-6873c5816726",
                        "glosses": [
                            "steinerne Umfassung eines Ortes zur Bestattung Verstorbener"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f9bec1-ec0b-4eb7-b48d-5a6169992fc0",
                                "sense_id": "ee688ba5-cc42-306f-952b-b60f3fa8e268",
                                "text": "„Ein altes, gemütliches Schulhaus war da, dicht beim Glockenturm der Kirche, an der Innenseite der Friedhofsmauer.“"
                            },
                            {
                                "example_id": "c6cd4f47-60fb-4d84-99aa-5ebfae4a4966",
                                "sense_id": "ee688ba5-cc42-306f-952b-b60f3fa8e268",
                                "text": "„In den letzten Reihen, die zur Friedhofsmauer führen, liegen auch Soldaten und Offiziere, die deutlich nach Kriegsende gestorben sind, womöglich an den Verletzungen, oder sie wurden den Kameraden zur Ehre hier bestattet.“"
                            },
                            {
                                "example_id": "ad5a5b2b-e581-405f-9d0e-e1e2746fd2c2",
                                "sense_id": "ee688ba5-cc42-306f-952b-b60f3fa8e268",
                                "text": "„Was Mojsche täglich an der Friedhofsmauer macht, weiß der Sprecher nicht zu sagen.“"
                            },
                            {
                                "example_id": "2e535920-bd64-4212-9ec7-db0da7b1c1b3",
                                "sense_id": "ee688ba5-cc42-306f-952b-b60f3fa8e268",
                                "text": "„Die Friedhofsmauer erhob sich wie ein stummer Grenzposten zum Hotel hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
