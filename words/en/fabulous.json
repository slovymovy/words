                                "target_lang_sense_clarification": "ongelooflijk in omvang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd3db1fd-b709-34a6-ba15-6dcfa19ab887",
                    "sense_definition": "Relating to or found in a <w>fable</w>, myth, or legend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unicorn is a <w>fabulous</w> creature that appears in many legends.",
                            "target_lang_translations": {
                                "ru": "Единорог — это <w>мифическое</w> существо, которое встречается во многих легендах.",
                                "nl": "De eenhoorn is een <w>fabelachtig</w> wezen dat in veel legenden voorkomt."
                            }
                        },
                        {
                            "text": "Ancient texts are filled with stories of <w>fabulous</w> beasts and heroes.",
                            "target_lang_translations": {
                                "ru": "Древние тексты полны историй о <w>сказочных</w> зверях и героях.",
                                "nl": "Oude teksten staan vol met verhalen over <w>fabelachtige</w> beesten en helden."
                            }
                        }
                    ],
                    "antonyms": [
                        "real",
                        "factual"
                    ],
                    "common_phrases": [
                        "fabulous creature",
                        "fabulous beast",
                        "fabulous monster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к басням, мифам или легендам или встречающийся в них.",
                        "nl": "Met betrekking tot of voorkomend in een fabel, mythe of legende."
                    },
                    "translations": {
                        "ru": [
