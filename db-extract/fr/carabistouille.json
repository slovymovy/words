                                "target_senses": [
                                    {
                                        "sense_id": "cf041156-7ec1-3a11-bd48-57dfcd48f055",
                                        "entry_id": "aa92560b-9885-3b8b-ace4-6c5080e7e74f",
                                        "glosses": [
                                            "ato de brincar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c74a49-1138-4b4c-88d1-004f685d879d",
                                                "sense_id": "cf041156-7ec1-3a11-bd48-57dfcd48f055",
                                                "text": "As crianças gostaram muito da brincadeira que eles fizeram de tarde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4c5b25-f25e-3e9b-b590-f37fedcb8146",
                                        "entry_id": "aa92560b-9885-3b8b-ace4-6c5080e7e74f",
                                        "glosses": [
                                            "diversão, divertimento"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c2f9b1-562c-41b9-ab02-fc5c203cef39",
                                                "sense_id": "4c4c5b25-f25e-3e9b-b590-f37fedcb8146",
                                                "text": "E você gostou da brincadeiras no parque?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a0486a-17d2-3c21-aff6-e118bb394053",
                                        "entry_id": "aa92560b-9885-3b8b-ace4-6c5080e7e74f",
                                        "glosses": [
                                            "piada, putaria, sacanagem, zombaria, gozação"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b14942-89b1-4508-9a0d-c26df8e93c34",
                                                "sense_id": "32a0486a-17d2-3c21-aff6-e118bb394053",
                                                "text": "Botar fogo no cesto de papéis foi uma brincadeira de muito mau gosto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a3ff83-731c-3a4b-9de7-fec93d558ebc",
                                        "entry_id": "aa92560b-9885-3b8b-ace4-6c5080e7e74f",
                                        "glosses": [
                                            "algo fácil de realizar"
                                        ],
                                        "tags": [
                                            "Brazil",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106be2a1-9e03-434a-ba77-3a5b069c2407",
                                                "sense_id": "89a3ff83-731c-3a4b-9de7-fec93d558ebc",
                                                "text": "Para o país sair do buraco em que se encontra, todos nós teremos que ajudar, não vai ser brincadeira."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
