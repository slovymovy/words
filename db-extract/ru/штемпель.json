                "senses": [
                    {
                        "sense_id": "840c1874-9083-38e7-82dd-b98f0b46b7ff",
                        "entry_id": "8da54115-d237-3263-9845-6b3bcc0b22d5",
                        "glosses": [
                            "печать с выпуклым обратным рисунком или надписью для получения оттиска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c389a71d-45bd-4fa4-9f22-8b411f5bd13b",
                                "sense_id": "840c1874-9083-38e7-82dd-b98f0b46b7ff",
                                "text": "Наше почтовое отделение ввело новые штемпеля."
                            }
                        ]
                    },
                    {
                        "sense_id": "42b70bd5-3d71-3634-857d-4bc89bbb66f9",
                        "entry_id": "8da54115-d237-3263-9845-6b3bcc0b22d5",
                        "glosses": [
                            "оттиск с использованием штемпеля I"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7cac68-d2b8-4a3e-bbee-b4657bed95c9",
                                "sense_id": "42b70bd5-3d71-3634-857d-4bc89bbb66f9",
                                "text": "Я собираю конверты со штемпелями с датой своего рождения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd99772b-5979-4b2f-a856-bd252aa44008",
                        "source_entry_id": "8da54115-d237-3263-9845-6b3bcc0b22d5",
                        "target_lang_word": "Stempel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stempel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1221b5b6-fb02-331c-bd1c-e39f65318be6",
                                        "entry_id": "55d52fef-ac6f-3882-9055-d7a08c5c055b",
                                        "glosses": [
                                            "Gerät zum Drucken eines Namens oder einer kurzen Information"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b27209-cf80-4d9c-a4ac-98e6b42ee019",
                                                "sense_id": "1221b5b6-fb02-331c-bd1c-e39f65318be6",
                                                "text": "In der Bastelstunde haben wir uns aus Kartoffeln Stempel gefertigt."
                                            },
                                            {
                                                "example_id": "57458206-bc5d-466b-846d-d5e41cdea746",
                                                "sense_id": "1221b5b6-fb02-331c-bd1c-e39f65318be6",
                                                "text": "„Von den restlichen Geschenken waren ein Kinderlexikon und ein Stempel mit meinem Namen und meiner Adresse die besten.“"
                                            },
                                            {
                                                "example_id": "e4b9a2e1-e347-4965-b213-e9284b29787b",
                                                "sense_id": "1221b5b6-fb02-331c-bd1c-e39f65318be6",
                                                "text": "„Am 1. November 1849 gab es natürlich noch keine Stempel, die speziell zur Entwertung von Briefmarken gedient hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                        "entry_id": "55d52fef-ac6f-3882-9055-d7a08c5c055b",
                                        "glosses": [
                                            "Abdruck mit Hilfe von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23adb9c7-440c-4198-a4ee-4120832665ec",
                                                "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                                "text": "Am Stempel erkannte ich das Aufgabepostamt."
                                            },
                                            {
                                                "example_id": "cbd0a4bf-8a88-452c-bab1-b68ea47e2446",
                                                "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                                "text": "„Heute würde mich United Airlines mit diesen Stempeln im Pass direkt nach Guantanamo fliegen.“"
                                            },
                                            {
                                                "example_id": "ed11dc00-b7f5-4eb0-b62a-4fd2248cd79f",
                                                "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                                "text": "„Er prüfte das Visum und die Stempel der Ministerien und blätterte lustlos in den Arbeitsproben.“"
                                            },
                                            {
                                                "example_id": "dac9e6c5-53e1-4bc0-97d2-0cdc6e1488e5",
                                                "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                                "text": "„Trotzdem gab es noch jede Menge Stempel und Papierkram zu erledigen, bis ich endlich einreisen konnte.“"
                                            },
                                            {
                                                "example_id": "333a0ca5-5cae-4830-bb63-32b17eac1063",
                                                "sense_id": "9961bef5-3a7e-33d1-8ef8-1ba5151627e9",
                                                "text": "„Wie unbeliebt die Methode war, zeigt sich daran, dass aus den neuen Stempeln mit Inschrift »TIN CAN CANOE MAIL« (deutsch »Blechdosen-Kanu-Post«) der Zusatz »Canoe« wieder entfernt wurde - denn die Postschwimmer hatten mit Streik gedroht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3044597-4b3a-3066-b58f-ef725849d9da",
                                        "entry_id": "55d52fef-ac6f-3882-9055-d7a08c5c055b",
                                        "glosses": [
                                            "Präge- oder Stanzvorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186b4933-f1a8-4052-b2f8-129bb06031a0",
                                                "sense_id": "d3044597-4b3a-3066-b58f-ef725849d9da",
                                                "text": "Der Stempel wird aus besonders hartem Stahl gefertigt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3fee6990-220e-3184-b723-dd3a25f4aa9c",
                                        "entry_id": "55d52fef-ac6f-3882-9055-d7a08c5c055b",
                                        "glosses": [
                                            "Fruchtknoten, Griffel und Narbe einer Blüte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db79c38-b55d-466c-8d2c-faa61bb876d0",
                                                "sense_id": "3fee6990-220e-3184-b723-dd3a25f4aa9c",
                                                "text": "Viele Insekten streifen die Pollen am Stempel ab."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "47400b41-a050-3ba5-83c3-d71e96730780",
                                        "entry_id": "55d52fef-ac6f-3882-9055-d7a08c5c055b",
                                        "glosses": [
                                            "Stütze, Strebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e41678-d417-40b3-8d14-d7a90cda9602",
                                                "sense_id": "47400b41-a050-3ba5-83c3-d71e96730780",
                                                "text": "Vor dem Betonieren der Decke werden starke Stempel aufgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
