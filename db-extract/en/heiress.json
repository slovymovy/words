                    }
                ],
                "translations": [
                    {
                        "translation_id": "de1f97d7-8d81-4146-8345-4deb741258dd",
                        "source_entry_id": "28df60c8-e84e-3d61-9fe5-2351f1d0389d",
                        "source_sense_id": "101c877f-fee4-398b-8bfd-765646ad9c61",
                        "source_sense_description": "allgemein: Nachfolgerin",
                        "target_lang_word": "Nachfolgerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachfolgerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                        "entry_id": "beb12cf2-91bd-3410-9a47-a4d7c2268a6a",
                                        "glosses": [
                                            "weibliche Person, welche künftig die Position einer bestimmten Person einnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18d0089-6bed-4029-8480-c9d06a19132c",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "Er begrüßte seine Nachfolgerin mit herzlichen Worten."
                                            },
                                            {
                                                "example_id": "75522915-99dd-40ce-b884-406193641f35",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "Die Suche nach einer Nachfolgerin gestaltete sich schwieriger als gedacht."
                                            },
                                            {
                                                "example_id": "0bea1bd2-cb42-4d6e-9b52-e2f04542c9bd",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Erst Verteidigungsministerin, demnächst wahrscheinlich Kommissionspräsidentin der EU: Ursula von der Leyen soll Nachfolgerin von Jean-Claude Juncker werden.“"
                                            },
                                            {
                                                "example_id": "4508f86e-ae56-4bb1-ba04-28bf497895ec",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt.“"
                                            },
                                            {
                                                "example_id": "7b2e09d9-4073-4e01-8213-698d0813129a",
                                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                                "text": "„Auch die Beziehung zu ihrer Nachfolgerin Lisa Matthias ist zerbrochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "568b0b3e-7bad-4698-b70f-9934b2fc40bb",
                        "source_entry_id": "28df60c8-e84e-3d61-9fe5-2351f1d0389d",
                        "source_sense_id": "0e02ef0d-1820-34f8-a478-3189dc5182e6",
                        "source_sense_description": "speziell: Thronfolgerin",
                        "target_lang_word": "Thronfolgerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thronfolgerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "838c2df9-6040-351a-ac23-13c89769192c",
                                        "entry_id": "fd7a4bcb-04f3-37ef-96f8-9f7393bcab0f",
                                        "glosses": [
                                            "weibliche Person, die als Nächste den Thron besteigt/besteigen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2763550-5f23-44a5-bb93-4511e8efd77a",
                                                "sense_id": "838c2df9-6040-351a-ac23-13c89769192c",
                                                "text": "„Die Schweden wetten schon auf Name und Geschlecht: Thronfolgerin Victoria ist schwanger. Das Land ist begeistert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94ece3e7-6931-4be4-90fa-a4fbd81c7ede",
                        "source_entry_id": "28df60c8-e84e-3d61-9fe5-2351f1d0389d",
                        "source_sense_id": "7d36079d-3ad8-320d-aa60-88a9e0a4ac7c",
                        "source_sense_description": "speziell: Erbin",
                        "target_lang_word": "Erbin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                        "entry_id": "4681d6fd-8012-387b-9c82-32f49228c657",
                                        "glosses": [
                                            "weibliche Person, der die Güter von Verstorbenen zufallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7471c9c8-2976-4a2d-876b-69dc657a1764",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Als reiche Erbin kann sie ein Leben in Saus und Braus führen."
                                            },
                                            {
                                                "example_id": "f7eecdb6-a307-4675-b061-80b7e8cf4a83",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Die junge Erbin hat jetzt ein sorgenfreies Leben."
                                            },
                                            {
                                                "example_id": "420c0b49-91a7-44f1-984c-5dc4b0968722",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Das Landgericht Köln zweifelt an der Darstellung von Quelle-Erbin Madeleine Schickedanz , dass die Bank Sal. Oppenheim sie zu einer riskanten Anlage ihres Vermögens gedrängt habe."
                                            },
                                            {
                                                "example_id": "3f4a0261-ad24-4d35-b1c8-6fc5709d6683",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Ise Bosch, Stifterin und Erbin der Bosch-Familie, beklagt in ihrem Beitrag die „Reichen-Hetze“. Als kritische Erbin freue sie sich, dass endlich über Ressourcenverteilung geredet werde."
                                            },
                                            {
                                                "example_id": "ce6f80b5-f07c-42ee-95eb-17dc07d1c12f",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Zusammen mit ihrem Bruder Dietrich wäre [Uta] Werner [, die 86-jährige Cousine des verstorbenen Cornelius Gurlitt,] als nächste lebende Verwandte ohne Testament die gesetzliche Erbin gewesen."
                                            },
                                            {
                                                "example_id": "130ad358-23fe-47f6-ad81-5760d1bc1c97",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "„Diese Partie war Julie Karagina, die Tochter angesehener und ordentlicher Eltern, mit der Familie Rostow von Kindesbeinen an bekannt und jetzt, nachdem der letzte ihrer Brüder gefallen war, eine sehr reiche Erbin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
