                    {
                        "sense_id": "f19b14c4-88b3-3bdc-93cc-e58d8d0ca40e",
                        "entry_id": "86d9ede2-d012-3504-91aa-e6332a3449ed",
                        "glosses": [
                            "Streben nach Expansion/einer Vergrößerung des Machtbereichs"
