                        "entry_id": "e0ba9428-848f-305f-9be4-24c7860d5f34",
                        "glosses": [
                            "Fähigkeit/Eigenschaft, rhetorisch begabt zu sein, fähig zu sein, sich angemessen und überzeugend auszudrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3d8ed2a-0de4-48ce-a05b-3a7ce18cd4b0",
                                "sense_id": "6f320e54-e742-30cc-b0ab-980206bb0bae",
                                "text": "„SprachendidaktikerInnen [sic] vermuten, dass durch das extensive Lesen nicht nur das Leseverständnis verbessert, sondern zusammen mit der Wortschatzerweiterung auch die gesamte Sprachfertigkeit erhöht wird […].“"
                            },
                            {
                                "example_id": "fd7e866e-b239-4322-b566-0933d6b0b406",
                                "sense_id": "6f320e54-e742-30cc-b0ab-980206bb0bae",
                                "text": "„Nach zuvor normaler Sprachentwicklung verliert das Kind rezeptive und expressive Sprachfertigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
