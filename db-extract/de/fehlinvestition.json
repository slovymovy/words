                        "target_lang_word": "white elephant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "white elephant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3ec126-c773-36a8-b2dd-3a8ac8f0e7e1",
                                        "entry_id": "b7257b29-6db4-371a-aada-34822326916e",
                                        "glosses": [
                                            "An albino elephant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a900d1f4-893a-39d1-b00f-cf6205a06ec6",
                                        "entry_id": "b7257b29-6db4-371a-aada-34822326916e",
                                        "glosses": [
                                            "A possession that is unwanted or is a financial burden; an unprofitable investment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efb2dfa-07a3-474f-9cb8-bc01d4c00a22",
                                                "sense_id": "a900d1f4-893a-39d1-b00f-cf6205a06ec6",
                                                "text": "South Australia's \"white elephant\" was really going to prove a valuable possession after all!"
                                            },
                                            {
                                                "example_id": "4e10981e-d283-4370-a1a4-c16cc0fed13d",
                                                "sense_id": "a900d1f4-893a-39d1-b00f-cf6205a06ec6",
                                                "text": "Some of the stadiums being built for the World Cup soccer tournament, scheduled for next year, have also been criticized for delays and cost overruns, and have become subjects of derision as protesters question whether they will become white elephants."
                                            },
                                            {
                                                "example_id": "3d56e016-79e9-4f58-ad83-381ccab8ff1e",
                                                "sense_id": "a900d1f4-893a-39d1-b00f-cf6205a06ec6",
                                                "text": "In your story about Chinese success, you spend a lot of time on the shadow side of these big projects. Some of these projects look like white elephants. They look like airports built when there aren’t enough people flying or apartment blocks built that lots of people don’t want to live in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
