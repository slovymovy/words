                "senses": [
                    {
                        "sense_id": "b781c7ac-4275-3a66-b1d7-828290ac559c",
                        "entry_id": "27007309-0b9a-3111-9327-3bb3fab034e1",
                        "glosses": [
                            "École philosophique américaine représentée par un mysticisme panthéiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc097c4-d8b6-4675-bafb-4bf3c4e5b04a",
                                "sense_id": "b781c7ac-4275-3a66-b1d7-828290ac559c",
                                "text": "Ses plus célèbres disciples furent un certain Tuclide, géomètre » (il veut dire Euclide), « et un nommé Kant, un Allemand, inventeur de cette espèce de transcendantalisme qui aujourd’hui porte encore son nom, sauf la substitution du C au K."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd980588-5b1c-439c-b2cb-936c93eb7a5b",
