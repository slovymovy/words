                "senses": [
                    {
                        "sense_id": "1f4e7db9-6026-32d9-9548-28d17655c287",
                        "entry_id": "108ac739-efeb-3a74-840b-346639dfd773",
                        "glosses": [
                            "Étudier d’un point de vue statistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31feaca3-b9ca-45dc-bb28-4600bf7d66ce",
                                "sense_id": "1f4e7db9-6026-32d9-9548-28d17655c287",
                                "text": "L’une des clés de la lutte contre les discrimination serait bien une politique favorisant la mixité sociale qui entraînerait – sans qu’il y ait besoin de classifier, de « statistiser » – une mixité ethnique, ce qui entraînerait un égal accès aux infrastructures culturelles et une mixité scolaire !"
                            },
                            {
                                "example_id": "e1228468-2c33-4dda-9d2c-87705d1d6052",
                                "sense_id": "1f4e7db9-6026-32d9-9548-28d17655c287",
                                "text": "Ca avait l'air super génial, et puis je n'ai pas trouvé où entrer le texte à statistiser."
                            },
                            {
                                "example_id": "779f4520-420c-48b7-b493-04874cdd6d2c",
                                "sense_id": "1f4e7db9-6026-32d9-9548-28d17655c287",
                                "text": "La Taverne des Poètes Il aurait été possible de tout « chiffrer et statistiser » sur les 40 dernières années si l’interêt en valait le temps consacré à le faire, mais le plus important reste l’idée générale."
                            }
                        ]
                    }
