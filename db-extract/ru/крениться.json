                "senses": [
                    {
                        "sense_id": "5b695e71-f85c-34c5-af40-6620e89c4a17",
                        "entry_id": "1cf3c1c4-ec4c-3667-8f1b-6e86df6bf1bd",
                        "glosses": [
                            "наклоняться, клониться набок"
