                        ]
                    },
                    {
                        "translation_id": "85416065-ed02-493c-96ee-697f63043cfc",
                        "source_entry_id": "8bb47e4b-50f7-3ad7-a948-04b488421768",
                        "source_sense_id": "f891cb6b-b2e9-342f-b05d-e419af5c9c1f",
                        "target_lang_word": "Läuferin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Läuferin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26406cc5-b55d-33b4-a136-95af8154fd4e",
                                        "entry_id": "13509712-680b-3562-b486-4b8ea4cacce8",
                                        "glosses": [
                                            "Person, die an einem Wettlauf teilnimmt, die sich laufend vorwärtsbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ce4f9a-4221-4664-ab1e-2338a39bdc26",
                                                "sense_id": "26406cc5-b55d-33b4-a136-95af8154fd4e",
                                                "text": "Sie ist ein gute Läuferin."
                                            },
                                            {
                                                "example_id": "ac2331a7-a227-4c44-9119-dbd49f24aa6b",
                                                "sense_id": "26406cc5-b55d-33b4-a136-95af8154fd4e",
                                                "text": "„Die reizende Läuferin beeilte sich anfänglich nicht besonders, und ich dachte nicht daran, sie zu überholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4e93788-4b8c-3693-9836-e35eaa74c64d",
                                        "entry_id": "13509712-680b-3562-b486-4b8ea4cacce8",
                                        "glosses": [
                                            "Mitglied bei Mannschaftsspielen, steht zwischen Stürmer und Verteidiger, Mittelfeldspieler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef9314f-9693-41e6-aa60-1b20e6ac5f6c",
                                                "sense_id": "c4e93788-4b8c-3693-9836-e35eaa74c64d",
                                                "text": "Diesmal schoss Müller, eine Läuferin, das Tor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d38a919-e001-3b8b-b452-328a9071a172",
                                        "entry_id": "13509712-680b-3562-b486-4b8ea4cacce8",
                                        "glosses": [
                                            "anderes Wort für Fußbotin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d0db047-6f89-4b98-bd26-6faea4fb9437",
                                                "sense_id": "3d38a919-e001-3b8b-b452-328a9071a172",
                                                "text": "Schickt mir die Unterlagen mal mit der Läuferin herüber!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
