                                        "entry_id": "a0482626-a51d-325e-8bb6-f9abfd812999",
                                        "glosses": [
                                            "A mound or heap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
