                "senses": [
                    {
                        "sense_id": "0bdfb777-50a3-3c1a-80a4-fe86efa3f659",
                        "entry_id": "1b5d4f7e-cd1d-303f-963f-90c64c3cbe27",
                        "glosses": [
                            "Attraper, arrêter."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "482f8021-5461-4279-bccd-ac5d53053a69",
                                "sense_id": "0bdfb777-50a3-3c1a-80a4-fe86efa3f659",
                                "text": "Ecoute, répliqua Bob. Parler argot, y a rien d'meilleur pour s'faire poirer et les hommes l'ont compris."
                            },
                            {
                                "example_id": "03691ded-4deb-4f5f-993e-fde032c539ba",
                                "sense_id": "0bdfb777-50a3-3c1a-80a4-fe86efa3f659",
                                "text": "Y a déjà eu des évasions, que j’sais. L’année dernière, deux gars s’sont fait poirer tout de suite à la gare."
                            },
                            {
                                "example_id": "c51c5917-6198-4edd-84f8-473c53217705",
                                "sense_id": "0bdfb777-50a3-3c1a-80a4-fe86efa3f659",
                                "text": "Si on se fait poirer ? il me dit Van der Meersch."
                            },
                            {
                                "example_id": "c5410e6a-faa6-4912-82a2-f3f27bb925d3",
                                "sense_id": "0bdfb777-50a3-3c1a-80a4-fe86efa3f659",
                                "text": "Ils ont fouillé partout et il y a des dizaines de types qui se sont fait poirer."
                            }
                        ]
                    }
                ],
