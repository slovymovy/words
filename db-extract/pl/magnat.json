                "senses": [
                    {
                        "sense_id": "a6377f55-df16-3562-8e26-f78a84cf83a5",
                        "entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "glosses": [
                            "szlachcic z arystokratycznego rodu, który ma wielki majątek"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6bddf629-84e0-31e5-ad6e-965e4386fa31",
                        "entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "glosses": [
                            "właściciel potężnego przedsiębiorstwa, który kontroluje poważną część rynku w określonej branży"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e66a9b64-66ec-437a-952f-c38ebd71a921",
                        "source_entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "source_sense_id": "6bddf629-84e0-31e5-ad6e-965e4386fa31",
                        "target_lang_word": "magnate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "Powerful industrialist; captain of industry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b61bdf-2c06-4bea-99f7-77ac7e569e4d",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "I have decided to become an oil magnate, after spending quite some time reading the dictionary definition of the word magnate."
                                            },
                                            {
                                                "example_id": "05baf57d-bfdf-42f5-b900-872d246fd462",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "With a suitable amount of life experience under her belt, she sat down and conjured up the sexiest, most delicious Italian wine magnate she could imagine, had him make his biggest mistake, and gave him a wife on the run."
                                            },
                                            {
                                                "example_id": "a734716e-d360-4548-a003-edf1478cf126",
                                                "sense_id": "359a496d-af5a-35c3-bcc1-507cab663c4d",
                                                "text": "Sir Richard Branson is an English business magnate, best known as the founder of the multimillion-pound Virgin Group, which consists of more than four hundred companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d635752-4606-3e55-a83f-857c72fed4e3",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "A person of rank, influence or distinction in any sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5a45aa-49e4-4aaf-99be-14630970c878",
                                                "sense_id": "2d635752-4606-3e55-a83f-857c72fed4e3",
                                                "text": "[…] but there is not an illiterate Justice of the Peace, or rural magnate in the form of a country squire, that would not detect such a man as an empirie at once, if he rested his claim to such an appointment on the score of his scholarship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12411fe7-73f7-33a4-b94f-9ee05d1a9b66",
                                        "entry_id": "673a3d02-81bd-3f70-8957-d87c21933061",
                                        "glosses": [
                                            "In medieval and early modern Italy, a member of a legally defined category of especially wealthy patrician families, often deprived of the right to political participation by republican governments."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de28d748-b2dc-42a1-81e0-f9bf6826047c",
                                                "sense_id": "12411fe7-73f7-33a4-b94f-9ee05d1a9b66",
                                                "text": "Those considered politically dangerous could be excluded from office by declaring them magnates, while cancellation of magnate status was a mark of favour, a means of political patronage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "137b11c2-2818-44f6-80e9-3fbef0b8dc88",
                        "source_entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "source_sense_id": "6bddf629-84e0-31e5-ad6e-965e4386fa31",
                        "target_lang_word": "Magnat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Person mit großer wirtschaftlicher Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cf2f47-d323-43a4-8e85-ed4fc6baf646",
                                                "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                                "text": "Es ist nicht immer einfach, sich als Politiker gegen die Magnaten aus Öl- und Automobilindustrie zu stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Adliger"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ea7281-52a4-4ddb-ba92-89ae2ad78f19",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Der größte Teil von ihnen fand jedoch neue Erwerbs- und Niederlassungsmöglichkeiten in den privaten Städten und auf den Ländereien, die die polnischen Magnaten in dieser Zeit gründeten.“"
                                            },
                                            {
                                                "example_id": "5f4b1333-8499-4724-b6b3-09e6900772dd",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Bei den polnischen Magnaten der Umgebung, bei den zum Hofe gehörenden Herren und beim Kaiser selbst hatte bereits eine Unzahl von Bällen und Festlichkeiten stattgefunden; im Juni verfiel einer der polnischen Generaladjutanten auf den Gedanken, sämtliche Generaladjutanten sollten gemeinsam dem Kaiser ein Diner und einen Ball geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abe15e25-d8c1-4f1f-909e-640c0fde5330",
                        "source_entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "source_sense_id": "6bddf629-84e0-31e5-ad6e-965e4386fa31",
                        "target_lang_word": "Potentat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Potentat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                        "entry_id": "33352aba-5438-3816-8048-58c94860c817",
                                        "glosses": [
                                            "Person, die politische oder viel militärische Macht besitzt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57c7d550-ac30-4d86-b214-deb266c404a8",
                                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                                "text": "„Publius Cornelius Scipio kommandierte zwischen 211 und 201 v.Chr. ununterbrochen große Armeen, ähnlich wie Titus Quinctius Flamininus, der zwischen 198 und 183 v.Chr. maßgeblich Einfluss auf die römische Ostpolitik ausübte. Diese herausgehobenen Potentaten von ihrer Ausnahmestellung in das System der senatorischen Gleichheit zurückzuführen, sollte sich zu einem der größten Probleme der republikanischen Adelsgesellschaft entwickeln.“"
                                            },
                                            {
                                                "example_id": "fc2baf7b-abc6-40e5-b84d-6d6f55d0702a",
                                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                                "text": "„Und nach dem Verbot des Sklavenhandels sind es vor allem einheimische Potentaten, die sich neue Geschäftsmodelle einfallen lassen, um mit den Europäern weiter Handel zu treiben.“"
                                            },
                                            {
                                                "example_id": "2ea268c7-0989-4575-b3b1-cda3f98eac02",
                                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                                "text": "„Knapp hundert Jahre früher hätten wir uns hier nicht so frei bewegen können, denn der Khan von Baku war ein mächtiger Potentat.“"
                                            },
                                            {
                                                "example_id": "95e6e9aa-492b-4311-8bf1-5ef7e0450e5d",
                                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                                "text": "„Zunächst aber schüttelten die lokalen Potentaten am Indus die griechische Herrschaft innerhalb weniger Jahre wieder ab; nur in Baktrien und im Kabultal konnten sich die Griechen halten.“"
                                            },
                                            {
                                                "example_id": "d2831f9c-e272-47fc-86e3-7e1ee16dad1d",
                                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                                "text": "„Denn der Aufstieg des Seehandels zwischen Europa und Übersee bedingte den Rückgang des Überlandhandels entlang der Seidenstraße, was zur Folge hatte, dass die Safawiden und Moguln immer weniger Steuern einnahmen und die Stämme und lokalen Potentaten kaum noch bezahlen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3de328e2-8896-4573-8a85-66dbda0cf2c4",
                        "source_entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "source_sense_id": "6bddf629-84e0-31e5-ad6e-965e4386fa31",
                        "target_lang_word": "магнат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магнат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d030cb35-9133-36fd-b9bb-d3f8fbd8ece5",
                                        "entry_id": "0b530e3e-b578-3504-9871-02e1d9f36326",
                                        "glosses": [
                                            "очень богатый и влиятельный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a132d11-2635-418c-9347-9da4febe092e",
                                                "sense_id": "d030cb35-9133-36fd-b9bb-d3f8fbd8ece5",
                                                "text": "Магнаты американской промышленности, занимавшиеся нефтью, в те годы были обеспокоены громадными успехами английских конкурентов на мировых рынках."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf829e9-6cc2-3799-8bfb-844c4c45b48f",
                                        "entry_id": "0b530e3e-b578-3504-9871-02e1d9f36326",
                                        "glosses": [
                                            "истор. родовитый и богатый человек, крупный феодал, имеющий право участвовать в управлении страной (в Западной Европе, преимущественно в Польше и Венгрии)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d565ad-e275-414c-b443-c7e8ce742758",
                                                "sense_id": "bcf829e9-6cc2-3799-8bfb-844c4c45b48f",
                                                "text": "Эта дивизия состояла сплошь из венгерских магнатов, людей лучших венгерских фамилий."
                                            },
                                            {
                                                "example_id": "b2513c71-ddf6-432b-a506-b5b6534bb148",
                                                "sense_id": "bcf829e9-6cc2-3799-8bfb-844c4c45b48f",
                                                "text": "Он был знатнейшим магнатом Польши, более властительным в своих обширных владениях, чем любой король."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b944241b-ee6b-4b9e-8c33-dc8a9841ec3f",
                        "source_entry_id": "3478eba7-db08-3d3c-abcb-35b5f3a254fd",
                        "source_sense_id": "a6377f55-df16-3562-8e26-f78a84cf83a5",
                        "target_lang_word": "Magnat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Person mit großer wirtschaftlicher Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cf2f47-d323-43a4-8e85-ed4fc6baf646",
                                                "sense_id": "df48f91c-6af2-3fab-a688-0cf594ea52da",
                                                "text": "Es ist nicht immer einfach, sich als Politiker gegen die Magnaten aus Öl- und Automobilindustrie zu stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                        "entry_id": "3dfc38ec-1c34-3313-b23a-95c0a4c7164a",
                                        "glosses": [
                                            "Adliger"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ea7281-52a4-4ddb-ba92-89ae2ad78f19",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Der größte Teil von ihnen fand jedoch neue Erwerbs- und Niederlassungsmöglichkeiten in den privaten Städten und auf den Ländereien, die die polnischen Magnaten in dieser Zeit gründeten.“"
                                            },
                                            {
                                                "example_id": "5f4b1333-8499-4724-b6b3-09e6900772dd",
                                                "sense_id": "f2c6b14f-8fe6-3d5c-a103-adb4e1c31e23",
                                                "text": "„Bei den polnischen Magnaten der Umgebung, bei den zum Hofe gehörenden Herren und beim Kaiser selbst hatte bereits eine Unzahl von Bällen und Festlichkeiten stattgefunden; im Juni verfiel einer der polnischen Generaladjutanten auf den Gedanken, sämtliche Generaladjutanten sollten gemeinsam dem Kaiser ein Diner und einen Ball geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
