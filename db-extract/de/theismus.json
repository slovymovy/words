                "translations": [
                    {
                        "translation_id": "5705c566-cfd3-4787-b4d6-105a839c5d7d",
                        "source_entry_id": "04f32e64-51f7-325d-8985-ff264ab71ea1",
                        "source_sense_id": "0926fcdd-7122-30e8-89f0-40db7be15443",
                        "source_sense_description": "der Glaube, dass es (genau) den persönlichen, transzendenten, über alles herrschenden Schöpfergott gibt",
                        "target_lang_word": "theism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ad538b-8a02-3996-bddc-d1f133cffbe3",
                                        "entry_id": "1a9ffdf9-2adb-3be6-b3de-9229ffb6916e",
                                        "glosses": [
                                            "Belief in the existence of at least one deity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5fedf32-2a63-3a15-8c8f-5e63279ed2fa",
                                        "entry_id": "1a9ffdf9-2adb-3be6-b3de-9229ffb6916e",
                                        "glosses": [
                                            "Belief in the existence of a personal creator god, goddess, gods and/or goddesses present and active in the governance and organization of the world and the universe. The God may be known by or through revelation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba99d6e-7f63-4d2e-9650-428f4dcaa302",
                                                "sense_id": "e5fedf32-2a63-3a15-8c8f-5e63279ed2fa",
                                                "text": "The term stands in contradistinction to theism which, in its widest sense, means belief in a personal god, goddess, gods and/or goddesses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "theism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34b5ca04-8b94-3b17-8570-01bec4d8447d",
                                        "entry_id": "a6cfad4d-85e1-33ea-bd3d-556950374179",
                                        "glosses": [
                                            "A morbid condition resulting from excessive consumption of tea."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "044ca5ac-7f58-4dea-8685-9db9e626bee6",
                                                "sense_id": "34b5ca04-8b94-3b17-8570-01bec4d8447d",
                                                "text": "\"Theism\" belongs to that genus of disease in which morphinism, caffeinism, and vanillaism belong."
                                            },
                                            {
                                                "example_id": "dabd740b-eb81-4975-8c54-d3d4bb1abc44",
                                                "sense_id": "34b5ca04-8b94-3b17-8570-01bec4d8447d",
                                                "text": "A single cup of tea may cause excitement and insomnia, while a stronger dose rarely fails to produce acute \"theism,\" characterized by excitement, hyperaesthesia, palpitation, sweats, and frequent micturition; it may occasionally simulate delirium tremens, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e4c126b-cd0d-4d2c-a5fb-d42f2ed5a795",
                        "source_entry_id": "04f32e64-51f7-325d-8985-ff264ab71ea1",
                        "source_sense_id": "0926fcdd-7122-30e8-89f0-40db7be15443",
                        "source_sense_description": "der Glaube, dass es (genau) den persönlichen, transzendenten, über alles herrschenden Schöpfergott gibt",
                        "target_lang_word": "théisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fba738d-1527-3196-a5bf-bcc9f290be0a",
                                        "entry_id": "f9b5a522-eb08-307b-9486-455830bcdb4e",
                                        "glosses": [
                                            "Toute doctrine philosophique qui reconnaît l’existence d’un Dieu personnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb83f849-6742-46a0-a89a-64ec95dc2124",
                                                "sense_id": "1fba738d-1527-3196-a5bf-bcc9f290be0a",
                                                "text": "Ils ont répété avec assez de complaisance les imputations d’athéisme et de matérialisme, parfois fondées, mais parfois aussi un peu légèrement alléguées par le théisme dévot et hypocrite des mandarins."
                                            },
                                            {
                                                "example_id": "ff23e215-7022-49e8-8ebf-dc7d08692349",
                                                "sense_id": "1fba738d-1527-3196-a5bf-bcc9f290be0a",
                                                "text": "Les babys conservent le Coran, mais en l’altérant sensiblement sur plusieurs points ; ainsi ils croient à la métempsycose, ils veulent l’émancipation de la femme, ils remplacent le théisme par un véritable panthéisme […]"
                                            },
                                            {
                                                "example_id": "bfea22c1-5ee4-444d-a75f-984ef0282395",
                                                "sense_id": "1fba738d-1527-3196-a5bf-bcc9f290be0a",
                                                "text": "Après la dissolution de leur Ordre, ces jésuites espagnols avaient pris la campagne et cherchaient à former dans toutes les régions une milice armée pour combattre les idées nouvelles et le théisme."
                                            },
                                            {
                                                "example_id": "67340475-c95e-44ce-88c5-9d2294fe05c0",
                                                "sense_id": "1fba738d-1527-3196-a5bf-bcc9f290be0a",
                                                "text": "Ainsi, Charles Darwin, le père de la théorie de l’évolution et de la sélection naturelle, a oscillé, au cours de sa carrière d’homme de sciences, entre le théisme (le Créateur pourrait être à l’origine des différentes formes de vie) et l’agnosticisme (l’absolu est inaccessible à l’esprit humain qui reste sceptique devant les questions métaphysiques)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "théisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e760c6fb-070d-35dd-b501-68a23bd39bb0",
                                        "entry_id": "cf336816-3edd-3e37-b1fd-5193d96a9efa",
                                        "glosses": [
                                            "Dépendance physique envers la consommation de thé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100c73ab-3bc2-4ab7-a941-dee181c51514",
                                                "sense_id": "e760c6fb-070d-35dd-b501-68a23bd39bb0",
                                                "text": "Il serait superflu de rappeler ici le tableau de l’alcoolisme […] mais nous voulons appeler l’attention sur la ressemblance que présentent avec lui le caféisme, le théisme, le cocaïsme, états pathologiques beaucoup plus rares et beaucoup moins connus, mais pourtant réels."
                                            },
                                            {
                                                "example_id": "168d3025-1edf-45b0-81cd-7cce5a7777ec",
                                                "sense_id": "e760c6fb-070d-35dd-b501-68a23bd39bb0",
                                                "text": "L’abus du thé provoque une toxicomanie, le théisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
