                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf1daf6-63a6-48bf-b1d2-102cfbd823f7",
                                "sense_id": "bd257227-be2e-37d6-a804-7c28f42f6021",
                                "text": "Miljoenenbonus voor topman Air France-KLM ondanks zwaar verlies en miljardensteun."
                            },
                            {
                                "example_id": "29ffacf9-5d28-4afe-942e-7cad5268adbf",
                                "sense_id": "bd257227-be2e-37d6-a804-7c28f42f6021",
                                "text": "Vakantieplatform Booking.com heeft zijn bonusregels aangepast zodat de miljoenenbonussen voor de top van het bedrijf gewoon uitbetaald konden worden, ondanks de teruggelopen financiële prestaties van het bedrijf. De regelverandering om zo alsnog gigabonussen uit te kunnen keren is pijnlijk, omdat Booking.com een van de grootgebruikers is van de steunpakketten van de Nederlandse overheid."
                            }
                        ]
