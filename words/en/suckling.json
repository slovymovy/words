                        "breastfeeding"
                    ],
                    "antonyms": [
                        "weaning"
                    ],
                    "common_phrases": [
                        "suckling young",
                        "suckling kittens"
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord van 'suckle': zogen of de borst/uier geven"
