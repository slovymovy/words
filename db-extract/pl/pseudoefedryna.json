                        "entry_id": "8dda632e-5616-39c7-bdfc-341a6e32abe8",
                        "glosses": [
                            "chemiczny związek organiczny, pochodna fenyloetyloaminy, syntetyczny analog efedryny, substancja stosowana w zapaleniach górnych dróg oddechowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
