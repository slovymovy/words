        "nl-extract.jsonl": [
            {
                "entry_id": "286ce596-a45c-3390-b8e6-520925dec39b",
                "word": "matigend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed750d2f-f76c-373d-beb9-043ee9a0375c",
                        "entry_id": "286ce596-a45c-3390-b8e6-520925dec39b",
                        "glosses": [
                            "van iets dat het zorgt dat iets minder extreem wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a111f7b-f233-40c6-ad0b-71581a015d97",
                                "sense_id": "ed750d2f-f76c-373d-beb9-043ee9a0375c",
                                "text": "De jaren in de periode 2001-2011 behoren tot de warmste die ooit zijn gemeten. Ook de eerste 10 maanden van dit jaar passen binnen die trend, ondanks de matigende invloed van een koude zeestroming bij de evenaar begin dit jaar. Die zorgde in bepaalde delen van de wereld voor iets koeler weer."
                            },
                            {
                                "example_id": "c91aa932-fed5-4fa4-adeb-8c4c82444ce7",
                                "sense_id": "ed750d2f-f76c-373d-beb9-043ee9a0375c",
                                "text": ",,In een bezoek zie ik geen probleem, over Weber verbaas ik mij. Volgens CDA-collega Esther de Lange heeft het EVP-lidmaatschap van Fidesz een matigend effect op Orbán, dan zou ik wel eens willen weten waar Hongarije zou staan zonder dat matigende effect. Maar ik zie gebrek aan steun bij de EVP niet als een gegeven."
                            }
                        ]
                    }
