                "senses": [
                    {
                        "sense_id": "3d271ba8-f046-3b60-a98a-e8e212ddf965",
                        "entry_id": "c725f25d-1e89-37bd-844f-9e018c539dba",
                        "glosses": [
                            "Raum (Breite), in dem sich ein Wert befindet oder befinden darf, wenn er größer oder kleiner als der Zielwert/Durchschnitt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e63595f-015d-4e52-8b63-9cc23628ccc9",
                                "sense_id": "3d271ba8-f046-3b60-a98a-e8e212ddf965",
                                "text": "„Eine geringere Schwankungsbreite ist nur realisierbar, wenn der Spritzbetrieb mechanisch automatisiert wird.“"
                            },
                            {
                                "example_id": "9fc42254-3a59-4002-8ff1-08e8892add49",
                                "sense_id": "3d271ba8-f046-3b60-a98a-e8e212ddf965",
                                "text": "„Eine Aktienkursentwicklung kann man auch anhand ihrer Schwankungsbreite während einer bestimmten Zeitdauer (z.B. eines Monates) untersuchen.“"
                            },
                            {
                                "example_id": "1e3dd46f-ef90-4dea-ba04-16c2bf7b6732",
                                "sense_id": "3d271ba8-f046-3b60-a98a-e8e212ddf965",
                                "text": "„Wird von einer Stichproben-Erhebung ein Schluss auf eine Grundgesamtheit (Population) gezogen, ist stets das Konfidenzintervall („Schwankungsbreite“) zu beachten. Als Standard hat sich hier durchgesetzt, dass die Ergebnisse mit 95%-iger Sicherheit innerhalb des angegebenen Intervalls liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
