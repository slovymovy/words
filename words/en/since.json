            "senses": [
                {
                    "sense_id": "a45cbb9a-76a6-3806-8534-ffa7ff60d72c",
                    "sense_definition": "From the past time when an event occurred until the present.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have loved you <w>since</w> I first met you.",
                            "target_lang_translations": {
                                "ru": "Я люблю тебя <w>с тех пор как</w> впервые встретил тебя.",
                                "nl": "Ik hou van je <w>sinds</w> ik je voor het eerst ontmoette.",
                                "pl": "Kocham cię, <w>odkąd</w> cię po raz pierwszy spotkałem.",
                                "de": "Ich liebe dich, <w>seit</w> ich dich das erste Mal getroffen habe.",
                                "fr": "Je t'aime <w>depuis que</w> je t'ai rencontré pour la première fois.",
                                "it": "Ti amo <w>da quando</w> ti ho incontrata per la prima volta.",
                                "cs": "Miluji tě <w>od té doby, co</w> jsem tě poprvé potkal.",
                                "tr": "Seni ilk gördüğümden <w>beri</w> seviyorum.",
                                "es": "Te he amado <w>desde que</w> te conocí por primera vez."
                            }
                        },
                        {
                            "text": "It has been a long time <w>since</w> we last spoke.",
                            "target_lang_translations": {
                                "ru": "Прошло много времени <w>с тех пор как</w> мы в последний раз разговаривали.",
                                "nl": "Het is lang geleden <w>sinds</w> we elkaar voor het laatst gesproken hebben.",
                                "pl": "Minęło dużo czasu, <w>odkąd</w> rozmawialiśmy po raz ostatni.",
                                "de": "Es ist lange her, <w>seitdem</w> wir das letzte Mal gesprochen haben.",
                                "fr": "Cela fait longtemps <w>depuis que</w> nous avons parlé pour la dernière fois.",
                                "it": "È passato molto tempo <w>da quando</w> abbiamo parlato l'ultima volta.",
                                "cs": "Je to už dlouho <w>od té doby, co</w> jsme spolu mluvili naposledy.",
                                "tr": "Son konuşmamızdan <w>bu yana</w> uzun zaman oldu.",
                                "es": "Ha pasado mucho tiempo <w>desde que</w> hablamos por última vez."
                            }
                        }
