                "senses": [
                    {
                        "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                        "entry_id": "d672c537-f328-3dfa-914c-a31a7a718e5c",
                        "glosses": [
                            "lüftungstechnische Zu- und Abluftführung durch Einbauelemente im Dachfirst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45a1efb-2188-4116-aa42-93a8ab68b3da",
                                "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                                "text": "„Bei Konstruktionen mit Mörtelfirsten ist die Firstlüftung nur über Lüfterpfannen möglich.“"
                            },
                            {
                                "example_id": "f4ea39bf-8661-45ea-849b-6f61712ea655",
                                "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                                "text": "„Dabei gelang es offensichtlich, die Dachdeckung aus gedämpften Hohlfalzziegeln so ästhetisch in die Firstlüftung zu integrieren, dass die beachtliche Firstdimension von außen kaum erkennbar ist.“"
                            },
                            {
                                "example_id": "034ed8f2-d48e-496f-8d15-dbd81ff13ee1",
                                "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                                "text": "„Um bei Anschleppungen eine sinnvolle Lüftung erreichen zu können, ist ein Lichtband mit Lüftungsöffner die bester Alternative zur Firstlüftung.“"
                            },
                            {
                                "example_id": "74cf0261-18d2-42ce-90e1-b083cfcb80a7",
                                "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                                "text": "„Mit Hilfe der Firstlüftung wird die Wärme am schnellsten abgeführt und durch die Stehwandlüftung wird kühle Luft in das Gewächshaus eingeleitet.“"
                            },
                            {
                                "example_id": "2ccbc6af-209b-4011-b954-721816535f6d",
                                "sense_id": "19684c8d-ac1e-3949-bb2f-45c52c7e0ece",
                                "text": "„Die Firstlüftung im Breitschiffgewächshaus ist die optimale Lösung für die meisten Objekte und Anforderungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
