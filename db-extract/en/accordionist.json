                    {
                        "translation_id": "1c00b9f2-e61b-45de-aba1-21f5da555743",
                        "source_entry_id": "4fd3dbf6-d051-3a19-b82b-c6f26a0a488f",
                        "source_sense_id": "dc48c0f9-b1fd-3904-a873-b67f81fbcfda",
