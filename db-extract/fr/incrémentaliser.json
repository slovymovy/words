                "senses": [
                    {
                        "sense_id": "36359971-d03b-3b1b-af5c-c1edc628db0b",
                        "entry_id": "c3bbf488-a781-3479-b5ce-33f03d2fc7af",
                        "glosses": [
                            "Donner un caractère incrémental à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3c6802-f9e9-4799-88fc-f1af3da66fd7",
                                "sense_id": "36359971-d03b-3b1b-af5c-c1edc628db0b",
                                "text": "On voit que le pilotage de l’innovation a ainsi conduit à « incrémentaliser » l’innovation que constitue l’électrification, en confinant la rupture à un périmètre réduit de l’organisation de l’entreprise."
                            },
                            {
                                "example_id": "4ebdcc25-dfcf-4b01-9f5c-478ca07d41af",
                                "sense_id": "36359971-d03b-3b1b-af5c-c1edc628db0b",
                                "text": "Il est clair qu'il est nécessaire « d'incrémentaliser » l'algorithme proposé ci-dessus, c'est-à-dire conserver autant de résultats intermédiaires que possible."
                            },
                            {
                                "example_id": "728acb12-f21d-4d23-8f8a-7b8e76bfd286",
                                "sense_id": "36359971-d03b-3b1b-af5c-c1edc628db0b",
                                "text": "Dans ce contexte, la proposition architecturale ne peut s'imposer, mais doit plutôt se négocier, s'éprouver, s'\"incrémentaliser\"."
                            }
                        ]
                    }
                ],
