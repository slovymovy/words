                                        "sense_id": "e77ca26a-84b2-30d7-8945-a0a7657956b5",
                                        "entry_id": "97cb8453-312c-3e12-b683-abe206a50ce8",
                                        "glosses": [
                                            "Festigkeit/Stärke des Willens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee12642-afb2-4cce-ba60-20b0028902e6",
                                                "sense_id": "e77ca26a-84b2-30d7-8945-a0a7657956b5",
                                                "text": "„So viel Willensstärke hatte sie.“"
                                            },
                                            {
                                                "example_id": "f8b6c233-6655-41b7-ae05-e549670e0885",
                                                "sense_id": "e77ca26a-84b2-30d7-8945-a0a7657956b5",
                                                "text": "„Ich bin nicht verantwortungslos, hoffentlich auch nicht egoistisch, und mangelnde Willensstärke hat man mir noch nie vorgeworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d97dce3-f5f1-47ee-96b4-b16adac61bdb",
                        "source_entry_id": "0d78590d-759a-386a-b69e-00a6244df46a",
                        "source_sense_id": "10ae6f03-e7fb-3abf-a7b3-5b97199ecdad",
