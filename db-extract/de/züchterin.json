                        "entry_id": "56d46904-f72a-3652-8815-fd5c33ce442d",
                        "glosses": [
                            "weibliche Person, die aus wirtschaftlichen oder privaten Gründen für die Vermehrung und das Wohlbefinden von Pflanzen oder Tieren sorgt; weibliche Person, die eine Zucht betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ce25d4-2acd-4d66-8984-0c3fbbd56360",
                                "sense_id": "11c0925c-c6a9-332c-a49c-724da01de8fb",
                                "text": "Die Züchterin achtet darauf, dass die Nahrung nicht verunreinigt ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
