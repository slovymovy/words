                        "glosses": [
                            "het leven van mensen die in afzondering leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6381e1-488c-4afb-a67a-53eeb6c2e825",
                                "sense_id": "700dc8c3-8c3a-3a56-b739-b12804e36de0",
                                "text": "Het bracht meteen het gerucht de wereld in dat er een ander lichaam in zou liggen en dat de tsaar gekozen had voor een kluizenaarsleven in Siberië om boete te doen voor de moord op zijn vader."
                            },
                            {
                                "example_id": "b41aadb4-fa02-4b8b-bef2-cbb6a1910d49",
                                "sense_id": "700dc8c3-8c3a-3a56-b739-b12804e36de0",
                                "text": "De boodschap van God moet niet slechts worden geconsumeerd, maar ook worden gecommuniceerd. „Geloven betekent niet een kluizenaarsleven leiden met een boekje in een hoekje, maar de grote daden Gods vertellen, allereerst in uw eigen omgeving en kleine kring.”"
                            }
                        ]
                    }
