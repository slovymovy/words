                        "glosses": [
                            "Fabricant de flacons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93a7ded-b107-45aa-89e2-2bc89b7d1e09",
                                "sense_id": "6d0fd94a-dc93-3b02-8c52-e0e3b9163860",
                                "text": "En rachetant, en tandem avec le flaconnier Pochet, la celèbre orfèvrerie [Puiforcat], Hermès renforce son pôle arts de la table et se pose une nouvelle fois en sauveteur du patrimoine national. En 1989 déjà, les célèbres cristalleries envisageaient de se vendre à l'américain Brown Foreman. Hermès et Pochet s'interposent et Saint-Louis reste français."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c4e89a9-4149-3b27-b4b0-73faa5118fbc",
                        "entry_id": "a85cf80a-885b-3370-8bdf-67a86f6a5034",
                        "glosses": [
                            "Étui ou meuble contenant des flacons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1ff0ea-e636-4b32-a6ea-bd4daf3ce200",
                                "sense_id": "2c4e89a9-4149-3b27-b4b0-73faa5118fbc",
                                "text": "Meuble sous vasque avec flaconnier constitué de deux tiroirs métalliques et une tablette."
                            },
                            {
                                "example_id": "d707a0d2-b6c6-47be-8034-9f1c3329fed5",
                                "sense_id": "2c4e89a9-4149-3b27-b4b0-73faa5118fbc",
                                "text": "Près d’elle les vitres de la serre étincelaient comme les cristaux à facettes d’un flaconnier, où elle puisait ses fards et ses parfums pour se mettre aux pommettes le rouge d’une touffe d’œillets odorants."
                            }
                        ]
                    }
