                                        "entry_id": "8016e94a-57f0-3c60-8d5a-91e9a6fff4c3",
                                        "glosses": [
                                            "The stratum of the surface of the soil which is filled with the roots of grass, or any portion of that surface; turf; sward."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a785b4c-a8e1-499c-8a67-b691c1879544",
                                                "sense_id": "085483f0-a3d9-3362-90d5-68591443f7d7",
                                                "text": "She there shall dress a sweeter sod / Than Fancy's feet have ever trod."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1b4591-1cd5-3ed6-88ac-cd8c7c87667e",
                                        "entry_id": "8016e94a-57f0-3c60-8d5a-91e9a6fff4c3",
                                        "glosses": [
                                            "Turf grown and cut specifically for the establishment of lawns."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f39fb91-f258-4c1d-ac04-a8113c816e25",
                                                "sense_id": "fc1b4591-1cd5-3ed6-88ac-cd8c7c87667e",
                                                "text": "The landscapers rolled sod onto the bare earth and made a presentable lawn by nightfall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7661db43-6ac8-3759-ab56-66234f17bcac",
                                        "entry_id": "8016e94a-57f0-3c60-8d5a-91e9a6fff4c3",
                                        "glosses": [
                                            "A piece of this."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f0b9be3-a028-47e3-af79-41f6e9c918e8",
                                                "sense_id": "7661db43-6ac8-3759-ab56-66234f17bcac",
                                                "text": "In Walachia, green sods are laid on the window-sills and on the lintels of the doors to avert the uncanny crew [i.e. witches]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcbb5153-a6dd-37da-b888-148b32a0b9ba",
                                        "entry_id": "50dc3251-3bdc-3ddd-8f06-96c0dee7425d",
                                        "glosses": [
                                            "To cover with sod."
