                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birmanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5f53be-f7f2-3f50-9c30-569fce06836a",
                                        "entry_id": "e387846e-6ab0-3195-990f-d113416bd273",
                                        "glosses": [
                                            "den asiatischen Staat Birma (Myanmar) betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56def85d-d022-4ce2-91a0-22f7a4919ceb",
                                                "sense_id": "bd5f53be-f7f2-3f50-9c30-569fce06836a",
                                                "text": "Das Gebiet im Nordwesten Hinterindiens war nach der Einwanderung birmanischer Völker im 9. und 10. nachchristlichen Jahrhundert zumeist von verschiedenen Stämmen und Dynastien beherrscht worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84181a32-2079-3599-a86a-b13bc029638f",
                                        "entry_id": "e387846e-6ab0-3195-990f-d113416bd273",
                                        "glosses": [
                                            "zur Sprache Birmanisch gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9290b8a4-7652-4935-8312-70cfecb2c46b",
                                                "sense_id": "84181a32-2079-3599-a86a-b13bc029638f",
                                                "text": "Die ersten schriftlichen Dokumente in birmanischer Sprache stammen aus dem frühen 12. Jahrhundert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
