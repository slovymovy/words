                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35ba643-5b3e-466c-84d0-bf5b18987f65",
                                "sense_id": "2f44b15b-5996-363e-b061-80d6c3c4e947",
                                "text": "Au côté de Marc Simoncini, Éric Larchevêque, Jean-Pierre Nadir et Anthony Bourbon, l’ex-basketteur décidera d’investir (ou non) dans les différents projets présentés par les entrepreneurs participant au show."
                            }
                        ]
                    }
