                "senses": [
                    {
                        "sense_id": "f4f25242-1fee-3b00-81b7-0e55f764d2c0",
                        "entry_id": "6225ff61-fa32-3626-b60b-4e02ab9bffb3",
                        "glosses": [
                            "тот, кто получает что-либо (обычно - сообщение, почтовое отправление и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67d98f0-ba26-484d-836e-dc8af418780f",
                                "sense_id": "f4f25242-1fee-3b00-81b7-0e55f764d2c0",
                                "text": "«Деньги по договору начнут перечисляться на указанные получателем счета только после того, как чеченская сторона предоставит международные гарантии выполнения своих обязательств»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04706207-6dd1-4a36-aee2-628283e5c98d",
                        "source_entry_id": "6225ff61-fa32-3626-b60b-4e02ab9bffb3",
                        "source_sense_id": "f4f25242-1fee-3b00-81b7-0e55f764d2c0",
                        "target_lang_word": "recipient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recipient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "One who receives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1776b698-9af9-4d9e-b734-5c48a53f6db2",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "the recipient of money or goods"
                                            },
                                            {
                                                "example_id": "bd7701e3-c4de-4166-a161-5aa8de47d14b",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "My e-mail never reached the intended recipient."
                                            },
                                            {
                                                "example_id": "7a79e1ed-38fa-43cf-a748-008dedc802c0",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "And it [bribery and fraud] didn't stop there. Both Sir Winston Churchill and later Labour leader Michael Foot were allegedly regular recipients of private cheques that would have seen them summarily sacked in this present age of transparency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1c3638-e7fe-3dcf-ad4a-02d7497419ef",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "A person receiving donor organs or tissues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4abcdb57-229a-3d88-b4a3-2bc1d8d3e207",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "The portion of an alembic or other still in which the distilled liquid is collected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
