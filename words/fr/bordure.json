                    "frequency": "Low",
                    "semantic_group_id": "extremite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une maisonnette ancienne se dresse en <w>bordure</w> de forêt, loin du village."
                        },
                        {
                            "text": "Les chevreuils évitent de trop s'aventurer en <w>bordure</w> du champ cultivé."
