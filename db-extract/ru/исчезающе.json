                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f642f3cb-42af-4b5e-b48c-cda4081004a3",
                                                "sense_id": "e0f2659c-47ef-3b64-a3a9-af13ecc7c3c6",
                                                "text": "vanishingly rare"
                                            },
                                            {
                                                "example_id": "35cb15ce-db0c-4467-8e68-72f165b89fcc",
                                                "sense_id": "e0f2659c-47ef-3b64-a3a9-af13ecc7c3c6",
                                                "text": "a vanishingly small object on the horizon"
                                            },
                                            {
                                                "example_id": "bca28940-72a2-46dd-aa94-43ac1de5ff31",
                                                "sense_id": "e0f2659c-47ef-3b64-a3a9-af13ecc7c3c6",
                                                "text": "When they weren't running ships, meddling with alien civilisations or planning the future course of the Culture itself, the Minds existed in those fantastic virtual realities, sojourning beyondward into the multi-dimensioned geographies of their unleashed imaginations, vanishingly far away from the single limited point that was reality."
                                            },
                                            {
                                                "example_id": "3e9861d7-ed40-4006-a35d-d94ddefe55f4",
                                                "sense_id": "e0f2659c-47ef-3b64-a3a9-af13ecc7c3c6",
                                                "text": "[Minnesota Senator Steve] Daines isn’t the only example of right-wing politicians who wish to wield anti-Semitism as a convenient cudgel against their political enemies, with scant if any evidence. But Montana’s vanishingly small Jewish population makes it particularly clear that this strategy has little to do with flesh-and-blood Jews at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
