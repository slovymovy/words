{
    "word_family": [
        "contend",
        "contention",
        "contentious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51c0b891-d32f-3590-9c4d-c6fd9d1f4886",
                    "sense_definition": "A person or team with a realistic chance of winning a competition or achieving a high position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After winning three games in a row, the team is now a serious <w>contender</w> for the championship.",
                            "target_lang_translations": {
                                "ru": "После трех побед подряд команда стала серьезным <w>претендентом</w> на чемпионство."
                            }
                        },
                        {
                            "text": "The young athlete proved to be a strong <w>contender</w> during the national trials.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет зарекомендовал себя как <w>сильный</w> <w>соперник</w> во время национальных отборочных соревнований."
                            }
                        }
                    ],
                    "synonyms": [
                        "candidate",
                        "favorite",
                        "challenger"
                    ],
                    "common_phrases": [
                        "strong contender",
                        "serious contender",
                        "title contender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или команда, имеющие реальные шансы на победу в соревновании или на достижение высокого положения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претендент",
                                "target_lang_sense_clarification": "на победу или титул"
                            },
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "на высокое место или должность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "519fa79a-a639-32a2-9724-1efdf2338ad3",
                    "sense_definition": "A person who takes part in a competition or struggle against others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>contender</w> must register at the front desk before the tournament begins.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>участник</w> должен зарегистрироваться на стойке регистрации до начала турнира."
                            }
                        },
                        {
                            "text": "The two <w>contenders</w> faced each other in a final debate to win the voters' support.",
                            "target_lang_translations": {
                                "ru": "Два <w>претендента</w> встретились друг с другом на финальных дебатах, чтобы завоевать поддержку избирателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "competitor",
                        "rival",
                        "opponent"
                    ],
                    "common_phrases": [
                        "chief contender",
                        "lead contender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принимающий участие в соревновании или борьбе против других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "участник состязания"
                            },
                            {
                                "target_lang_word": "конкурент",
                                "target_lang_sense_clarification": "в борьбе за успех"
                            },
                            {
                                "target_lang_word": "участник",
                                "target_lang_sense_clarification": "соревнований"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}