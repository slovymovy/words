{
    "word_family": [
        "onnozel",
        "onnozelheidje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25b54161-ad37-39b8-97eb-73d53fb42dcf",
                    "sense_definition": "De eigenschap van het te gemakkelijk geloven van wat anderen zeggen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naïviteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn extreme <w>onnozelheid</w> zorgde ervoor dat hij in elk verkooppraatje geloofde.",
                            "target_lang_translations": {
                                "en": "His extreme <w>gullibility</w> caused him to believe every sales pitch."
                            }
                        },
                        {
                            "text": "Met een zekere <w>onnozelheid</w> gaf zij haar wachtwoord aan de vreemdeling.",
                            "target_lang_translations": {
                                "en": "With a certain <w>naivety</w>, she gave her password to the stranger."
                            }
                        }
                    ],
                    "synonyms": [
                        "naïviteit",
                        "simpelheid"
                    ],
                    "antonyms": [
                        "achterdocht",
                        "wantrouwen"
                    ],
                    "common_phrases": [
                        "uiterste onnozelheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality of being too willing to believe what others say."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gullibility",
                                "target_lang_sense_clarification": "the tendency to be easily deceived"
                            },
                            {
                                "target_lang_word": "naivety",
                                "target_lang_sense_clarification": "lack of experience or judgment"
                            },
                            {
                                "target_lang_word": "credulity",
                                "target_lang_sense_clarification": "readiness to believe things too quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "737a115b-213a-32f0-87f0-a8b43bcc1114",
                    "sense_definition": "Een gebrek aan verstand of inzicht dat leidt tot domme acties of besluiten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Herman is uitermate verbolgen over zoveel <w>onnozelheid</w> bij de betrokken bestuurders.",
                            "target_lang_translations": {
                                "en": "Herman is extremely indignant about such <w>foolishness</w> among the directors involved."
                            }
                        },
                        {
                            "text": "Ik ben erg geschrokken van de <w>onnozelheid</w> van uw bestuur inzake deze kwestie.",
                            "target_lang_translations": {
                                "en": "I am very shocked by the <w>silliness</w> of your board regarding this matter."
                            }
                        }
                    ],
                    "synonyms": [
                        "domheid",
                        "simpliciteit"
                    ],
                    "antonyms": [
                        "wijsheid",
                        "intelligentie"
                    ],
                    "common_phrases": [
                        "zoveel onnozelheid"
                    ],
                    "target_lang_definitions": {
                        "en": "A lack of sense or insight that leads to foolish actions or decisions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silliness",
                                "target_lang_sense_clarification": "foolishness or lack of seriousness"
                            },
                            {
                                "target_lang_word": "foolishness",
                                "target_lang_sense_clarification": "lack of good sense or judgment"
                            },
                            {
                                "target_lang_word": "stupidity",
                                "target_lang_sense_clarification": "lack of intelligence or common sense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30eda170-0429-34dc-a716-80ffecbe5307",
                    "sense_definition": "Gedrag dat kinderlijk of dwaas overkomt zonder kwade bedoelingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naïviteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>onnozelheid</w> van het kind was aandoenlijk om te zien.",
                            "target_lang_translations": {
                                "en": "The child's <w>innocence</w> was touching to see."
                            }
                        },
                        {
                            "text": "Achter die schijnbare <w>onnozelheid</w> schuilt een heel scherp verstand.",
                            "target_lang_translations": {
                                "en": "Behind that apparent <w>naïveté</w> lies a very sharp mind."
                            }
                        }
                    ],
                    "synonyms": [
                        "kinderlijkheid",
                        "ongekunsteldheid"
                    ],
                    "antonyms": [
                        "volwassenheid",
                        "serieusheid"
                    ],
                    "common_phrases": [
                        "schijnbare onnozelheid"
                    ],
                    "target_lang_definitions": {
                        "en": "Behavior that appears childlike or foolish without malicious intent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naïveté",
                                "target_lang_sense_clarification": "innocent lack of sophistication"
                            },
                            {
                                "target_lang_word": "innocence",
                                "target_lang_sense_clarification": "lack of guile or worldliness"
                            },
                            {
                                "target_lang_word": "artlessness",
                                "target_lang_sense_clarification": "naturalness and sincerity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f12f50b-33e2-3cba-9232-af0122249fc8",
                    "sense_definition": "Iets dat van weinig belang is of een zeer klein bedrag vertegenwoordigt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onbeduidendheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte zich druk om een <w>onnozelheid</w> die niemand anders was opgevallen.",
                            "target_lang_translations": {
                                "en": "He worried about a <w>trifle</w> that no one else had noticed."
                            }
                        },
                        {
                            "text": "Voor een dergelijke <w>onnozelheid</w> ga ik mijn tijd niet verspillen.",
                            "target_lang_translations": {
                                "en": "I am not going to waste my time on such a <w>triviality</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "eenvoud"
                    ],
                    "antonyms": [
                        "belangrijkheid",
                        "hoofdzaak"
                    ],
                    "target_lang_definitions": {
                        "en": "Something of little importance or representing a very small amount."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trifle",
                                "target_lang_sense_clarification": "a thing of little value or importance"
                            },
                            {
                                "target_lang_word": "triviality",
                                "target_lang_sense_clarification": "lack of importance or significance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}