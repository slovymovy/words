                    "sense_id": "b446868e-b4ad-3a12-bce3-fce142258666",
                    "sense_definition": "The American English spelling of <w>labour</w>, referring to physical or mental work, the workforce, or the process of childbirth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction project required months of hard physical <labor>.",
                            "target_lang_translations": {
                                "ru": "Строительный проект потребовал месяцев тяжелого физического <труда>.",
                                "zh": "这项建筑工程需要数月艰苦的体力<w>劳动</w>。"
                            }
                        },
                        {
                            "text": "She went into <labor> early in the morning and gave birth by noon.",
                            "target_lang_translations": {
                                "ru": "У нее начались <роды> рано утром, и к полудню она родила.",
                                "zh": "她清晨开始<w>分娩</w>，中午时分孩子就出生了。"
                            }
                        }
                    ],
