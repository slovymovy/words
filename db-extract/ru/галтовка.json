                                                "text": "rumbling discontent"
                                            },
                                            {
                                                "example_id": "ef2c5a59-d684-4a1b-9586-2e3a7fb8d043",
                                                "sense_id": "679e7057-7f21-36de-ade4-5d01ef8be1d1",
                                                "text": "His rumbling voice suited the solemn occasion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rumbling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "007b5bbc-5b52-3855-ad4e-8524f50e482c",
                                        "entry_id": "ad35a6d1-ef33-3537-b664-8c2c18220f5d",
                                        "glosses": [
                                            "A muted sound of complaint or discontent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a98542-fd11-4f07-ae09-41e308a9c3f0",
                                                "sense_id": "007b5bbc-5b52-3855-ad4e-8524f50e482c",
                                                "text": "The rumblings of the masses precede the crumbling of the state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f6fd0d-87dc-3096-9860-8574a39a208c",
                                        "entry_id": "ad35a6d1-ef33-3537-b664-8c2c18220f5d",
                                        "glosses": [
                                            "A deep low noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9680011c-b389-4dcb-84da-7abc500fd878",
                                                "sense_id": "75f6fd0d-87dc-3096-9860-8574a39a208c",
                                                "text": "The rumbling of distant thunder echoed from the hilltop."
                                            }
