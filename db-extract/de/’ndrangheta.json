                "senses": [
                    {
                        "sense_id": "d79e7597-c924-31cf-ab23-db917faa9958",
                        "entry_id": "9f053f98-bfbe-39c5-a8af-a18c0f5fa910",
                        "glosses": [
                            "kriminelle Vereinigung aus Kalabrien, die auf eine kriminelle Bewegung im 19. Jahrhundert ohne deutliche Kennzeichnung zurückgeht; das kalabrische Analogon zur Mafia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c147575-7c46-435c-bd8e-89de6bd9b150",
                                "sense_id": "d79e7597-c924-31cf-ab23-db917faa9958",
                                "text": "„Die ’Ndrangheta gilt derzeit als mächtigste Mafia-Gruppierung in Europa. Das Eurispes-Institut schätzt, dass die Kalabresen mit Drogen- und Waffenhandel, Prostitution und Erpressung allein 2007 rund 44 Milliarden Euro Umsatz machten.“"
                            },
                            {
                                "example_id": "66035a2a-2ed3-493f-b609-a692e6af4d0d",
                                "sense_id": "d79e7597-c924-31cf-ab23-db917faa9958",
                                "text": "„Wie die italienische Polizei am Sonntag mitteilte, konnte der mutmaßliche Chef eines ’Ndrangheta-Clans in Südkalabrien in einem Bunker gestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
