                        "examples": [
                            {
                                "example_id": "813af011-86fa-4dca-b1a3-680cff1c1fe8",
                                "sense_id": "1d27d27a-7db6-3a1e-a993-1673bd2ce6b8",
                                "text": "„Die Betontreppe vor ihrem Haus war voller Risse.“"
                            },
                            {
                                "example_id": "c0e0e764-975e-43d1-8741-70521b1f16ef",
                                "sense_id": "1d27d27a-7db6-3a1e-a993-1673bd2ce6b8",
                                "text": "„Draußen vor der Staumauer erklomm zum Plärren der Sirenen eine Menschenmasse die zum sicheren Bereich oberhalb des Damms führende Betontreppe.“"
                            },
                            {
                                "example_id": "3183d582-7ef8-4d12-9baa-34623794bf04",
                                "sense_id": "1d27d27a-7db6-3a1e-a993-1673bd2ce6b8",
                                "text": "„Dr. Omar al-Wazir stieg auf dem Gelände der staatlichen Universität für Wissenschaft und Technologie aus seinem Wagen und ging die Betontreppe zu seinem Büro hinauf.“"
                            }
                        ],
