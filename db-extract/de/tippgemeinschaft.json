                                "target_senses": [
                                    {
                                        "sense_id": "0fd322df-1863-33fb-b250-e44cd33aa1c7",
                                        "entry_id": "3b7f7c2b-f10a-366b-8387-950ef4cb6dd9",
                                        "glosses": [
                                            "The act of placing a bet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86947e4b-f090-4811-b96d-80d88fad62eb",
                                                "sense_id": "0fd322df-1863-33fb-b250-e44cd33aa1c7",
                                                "text": "Once the field was prepared, and preliminaries of the game all settled, the bettings all made and goods all “staked,” night came on without the appearance of any players on the ground."
                                            }
