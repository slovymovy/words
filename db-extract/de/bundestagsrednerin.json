                "senses": [
                    {
                        "sense_id": "09d8567e-12be-3785-bf62-903424620f07",
                        "entry_id": "43dc5084-06d3-3d9d-b66b-885326677791",
                        "glosses": [
                            "weibliche Person, die im Bundestag spricht/eine Rede hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c38e234-d21e-4a01-8785-721ba78b3ebf",
                                "sense_id": "09d8567e-12be-3785-bf62-903424620f07",
                                "text": "„Sechs Jahre später ist aus der Anfängerin eine versierte Bundestagsrednerin geworden, nur die Kiekser in der Stimme ist sie noch nicht ganz los.“"
                            },
                            {
                                "example_id": "e92d4234-ba7f-4e9d-a5bd-08c7c1d9805e",
                                "sense_id": "09d8567e-12be-3785-bf62-903424620f07",
                                "text": "„‚Jetzt, mit 18, sind wir volljährig‘, stellte Moderatorin Martina von Ahsen fest, die sich später als kabarettistische Bundestagsrednerin versuchte.“"
                            },
                            {
                                "example_id": "28b4c5f9-6daa-4b93-9bb3-8373424355d4",
                                "sense_id": "09d8567e-12be-3785-bf62-903424620f07",
                                "text": "„Eine besondere Variante Ehrfurcht einflösender politischer Unbestechlichkeit repräsentiert Hildegard Müller, seit Oktober 2008 Hauptgeschäftsführerin des Bundesverbands der Energie- und Wasserwirtschaft, uns allen aber noch als mitreißende Bundestagsrednerin, brillante Analytikerin und exzellente Vordenkerin der Union bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
