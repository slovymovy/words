    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "39e0316e-e1fc-3a84-8a9e-21baa33d170b",
                    "sense_definition": "Of or relating to India, its people, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "india_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves <w>Indian</w> food because of the rich spices.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>индийскую</w> еду из-за обилия специй.",
                                "zh": "她喜欢<w>印度</w>菜，因为香料味很浓。"
                            }
                        },
                        {
                            "text": "The <w>Indian</w> economy has grown significantly in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Индийская</w> экономика значительно выросла за последние годы.",
                                "zh": "<w>印度</w>经济近年来增长显著。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Asian Indian"
                    ],
                    "common_phrases": [
                        "Indian Ocean",
                        "Indian cuisine",
                        "Indian culture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Индии, её народу или культуре.",
                        "zh": "与印度、印度人民或印度文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индийский",
                                "target_lang_sense_clarification": "относящийся к государству Индия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印度的",
                                "target_lang_sense_clarification": "指代与印度国家相关的属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee04636-2ced-364f-9017-17dc068be914",
                    "sense_definition": "Of or relating to the indigenous peoples of the Americas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "native_american_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited an <w>Indian</w> reservation in the southwest.",
                            "target_lang_translations": {
                                "ru": "Мы посетили <w>индейскую</w> резервацию на юго-западе.",
                                "zh": "我们参观了西南部的一个<w>印第安</w>保留地。"
                            }
                        },
                        {
                            "text": "Many <w>Indian</w> tribes have their own distinct languages.",
                            "target_lang_translations": {
                                "ru": "Многие <w>индейские</w> племена имеют свои собственные уникальные языки.",
                                "zh": "许多<w>印第安</w>部落都有自己独特的语言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Native American",
                        "Indigenous American",
                        "American Indian"
                    ],
                    "common_phrases": [
                        "Indian reservation",
                        "Indian territory"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к коренным народам Америки.",
                        "zh": "与美洲原住民有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индейский",
                                "target_lang_sense_clarification": "относящийся к коренному населению Америки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印第安的",
                                "target_lang_sense_clarification": "指代美洲原住民的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f8c19a5-fdb8-3b57-8633-d7ea3f80c652",
                    "sense_definition": "A person from India.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "india_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is an <w>Indian</w> who works in the technology sector.",
                            "target_lang_translations": {
                                "ru": "Он <w>индиец</w>, работающий в технологическом секторе.",
                                "zh": "他是一位在科技行业工作的<w>印度人</w>。"
                            }
                        },
                        {
                            "text": "Millions of <w>Indians</w> live and work abroad.",
                            "target_lang_translations": {
                                "ru": "Миллионы <w>индийцев</w> живут и работают за границей.",
                                "zh": "数百万<w>印度人</w>在国外生活和工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Asian Indian"
                    ],
