                "senses": [
                    {
                        "sense_id": "d5b18180-6008-3e9d-a0af-cb910131b390",
                        "entry_id": "066f6278-239e-31d2-a07a-888385aa743c",
                        "glosses": [
                            "Salir."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "53de551e-e128-4539-881d-c8218078b18b",
                                "sense_id": "d5b18180-6008-3e9d-a0af-cb910131b390",
                                "text": "Ça s’est terminé une fois de plus sur l’enclume, à coups de boucle de ceinture. Peut-être que son père était pas d’accord, question idées politiques, ou peut-être question belle chemise dégueulassée, va savoir."
                            },
                            {
                                "example_id": "58ad719d-0d41-41bb-8684-cbe73e509a06",
                                "sense_id": "d5b18180-6008-3e9d-a0af-cb910131b390",
                                "text": "Comment expliques-tu que cette mise en charpie d’un corps n’ait pas dégueulassé la pièce ? Il n’y a du sang que sur le lit."
                            },
                            {
                                "example_id": "3249b6c5-53ed-4378-959b-3aa318d5798f",
                                "sense_id": "d5b18180-6008-3e9d-a0af-cb910131b390",
                                "text": "Yvon n'a pas perdu de temps pour dégueulasser le décor. Une carcasse de bagnole, des débris variés s'entassent près de l'ancien puits."
                            }
                        ]
                    }
                ],
