                                        "entry_id": "7ba4dc29-a460-3834-86a3-17edd6fd1c68",
                                        "glosses": [
                                            "farmakologicky neaktivní přípravek, který má na pacienta příznivý účinek jen v důsledku vědomí nebo přesvědčení, že tento příznivý účinek může mít"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2340e9-de8f-4dea-974f-2e039b620c35",
                                                "sense_id": "250bf3b7-10a0-3e0f-9b06-80dd43bf0187",
                                                "text": "Ve dvojitě zaslepeném testu dostala třetina pacientů pouze placebo ve formě vitamínu C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e11544-b09e-3be4-90f4-023dd15c0e98",
                                        "entry_id": "7ba4dc29-a460-3834-86a3-17edd6fd1c68",
                                        "glosses": [
                                            "obecněji léčebný postup, u něhož není předpoklad pro jinou léčbu, než pomocí přesvědčení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ae1c00-95fb-49ad-905c-4491c1cd07ba",
                                                "sense_id": "36e11544-b09e-3be4-90f4-023dd15c0e98",
                                                "text": "Tato psychoterapie je čisté placebo."
                                            }
                                        ]
