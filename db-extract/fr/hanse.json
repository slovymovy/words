                                "target_senses": [
                                    {
                                        "sense_id": "57e812eb-3622-3ad6-8202-df3f01da4401",
                                        "entry_id": "6cd5eed3-d37c-3457-915c-b340a037e77d",
                                        "glosses": [
                                            "confederação de certo número de cidades da Alemanha do Norte para fins comercias (séculos XII a XVII)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
