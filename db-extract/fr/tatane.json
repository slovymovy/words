                                                "sense_id": "924f3b80-bba2-38fd-9314-23060389f8f8",
                                                "text": "Der Latschen hier hat aber auch schon mal bessere Zeiten gesehen."
                                            },
                                            {
                                                "example_id": "cd0f0934-6d9e-481a-92cc-d9958523ca41",
                                                "sense_id": "924f3b80-bba2-38fd-9314-23060389f8f8",
                                                "text": "„Doch ich hatte keine Angst vor ihr, auch nicht, als ich ihr die geputzten Silberschuhe ins Schlafzimmer brachte; ich in Latschen, in Krokur gekauft.“"
                                            }
                                        ],
