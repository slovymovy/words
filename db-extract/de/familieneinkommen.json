                            {
                                "example_id": "621df671-ebf0-4874-bb4a-5b61a3a46058",
                                "sense_id": "54eb1d43-36be-365a-b1bf-8d04c845ef9f",
                                "text": "„Rund 3.700 Euro haben deutsche Familien durchschnittlich als Familieneinkommen.“"
                            },
                            {
                                "example_id": "551378e6-f7ca-4c8b-87ad-4824a3b1b43a",
                                "sense_id": "54eb1d43-36be-365a-b1bf-8d04c845ef9f",
                                "text": "„Die Uni Stanford macht jetzt einen radikalen Schnitt: Sie streicht bei einem Familieneinkommen unter 100.000 Dollar pro Jahr sämtliche Studiengebühren.“"
                            },
                            {
                                "example_id": "03849e81-e626-4907-9cd2-bc02420d10fd",
                                "sense_id": "54eb1d43-36be-365a-b1bf-8d04c845ef9f",
                                "text": "„Auch damit trägt er etwas zum Familieneinkommen bei, auch wenn es an allem fehlt.“"
                            }
                        ],
