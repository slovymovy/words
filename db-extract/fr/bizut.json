                                    {
                                        "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                                        "glosses": [
                                            "iemand die uit onvervarenheid nog veel fouten maakt en daar vaak voor geplaagd wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8c02f7-96f2-41a3-84d6-a94662b128d7",
                                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                                "text": "Hij was politiek gezien nog maar een groentje."
                                            },
                                            {
                                                "example_id": "a129def1-2c8a-49a5-9bbf-3f6d507178ab",
                                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                                "text": "Zij rijden voorop in de Volvo, drie agenten in uniform in de auto achter hen: twee groentjes die net hun opleiding hebben afgerond, kerels met spierbundels en een air dat ze alle shit die ze in de maatschappij tegenkomen wel even zullen fiksen."
                                            },
                                            {
                                                "example_id": "f69b87e6-394c-40cd-ab62-a084441cc8f7",
                                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                                "text": "Hardangervidda. De Spoorlijn Bergen. Daar was zijn ingenieursleven begonnen toen hij nog niet meer dan een groentje was en nu tegen het einde van dat beroepsleven was het alsof hij weer opnieuw moest beginnen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50b01ca8-3cd1-33f9-a2cf-4ca620c09d86",
                                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                                        "glosses": [
                                            "Callophrys rubi een dagvlinder uit de familie Lycaenidae, de kleine pages, vuurvlinders en blauwtjes"
                                        ],
                                        "tags": [
                                            "vlinders"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69d99cb-dd41-48a5-9a04-b616e2e718b1",
                                                "sense_id": "50b01ca8-3cd1-33f9-a2cf-4ca620c09d86",
                                                "text": "Het groentje komt in heel Europa algemeen voor op schrale graslanden, heiden en bosgebieden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                                        "glosses": [
                                            "groente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1420b4c4-5002-44e5-b665-97c315337c09",
                                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                                "text": "Tomaat, en wortel, en komkommer, en sla, en erwtjes, en broccoli ja, de groentjes van Frank Fol daarmee eten alle kindjes hun buikje vol."
                                            },
                                            {
                                                "example_id": "27b18ad0-3521-4521-a7a9-176474fd8687",
                                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                                "text": "Bak de kippenreepjes aan in wat olie en voeg er de groentjes aan toe."
                                            },
                                            {
                                                "example_id": "430184f6-71b6-4384-a67f-2fa673cd1c4e",
                                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                                "text": "Snijd de schoongemaakte groentjes in gelijke 'frietjes' van ongeveer 0,5 centimeter dik en 8 centimeter lang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f691bf91-4342-3d38-9fea-edc465c69aaf",
                                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                                        "glosses": [
