                "senses": [
                    {
                        "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                        "entry_id": "ab5fe76f-d1f0-3a17-8ab7-4f96950083a0",
                        "glosses": [
                            "Geisterstadt im Oblast Kiew in der Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a55c570-858e-4b54-bae8-f72ede2e885d",
                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                "text": "„Unweigerlich kommen mir Bilder von Prypjat in den Kopf, der Gemeinde in der Ukraine, die nach dem Reaktorunglück von Tschernobyl 1986 geräumt werden musste und seitdem eine Geisterstadt ist.“"
                            },
                            {
                                "example_id": "567ee1c1-68bd-46f5-9e2e-dfce05775d98",
                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                "text": "„Oberflächlich betrachtet, wirkt Prypjat wie eine hübsche Kleinstadt mit Alleen, Hotels, einem zentralen Platz, einem Krankenhaus, Parks mit Fahrgeschäften, einer Hauptpoststelle, einem Bahnhof.“"
                            },
                            {
                                "example_id": "d5840262-1843-480a-b346-b88f92c845c1",
                                "sense_id": "6c50ec97-f8a8-3041-9314-be99dbe2f7e5",
                                "text": "„In der nur 3 Kilometer entfernten Stadt Prypjat stiegen die Strahlenwerte schnell auf das 600 000fache des zulässigen Strahlenwertes an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
