                        ],
                        "form": "anoas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3758060f-f181-3cb0-826a-7236f4279993",
                        "entry_id": "e5805653-0864-3445-89eb-244d7ce3df6a",
                        "glosses": [
                            "Either of two related species of small Indonesian water buffalo similar in appearance to deer; Bubalus quarlesi or Bubalus depressicornis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed6586e-5ff9-4d16-9aee-7ef63bb24bf3",
                                "sense_id": "3758060f-f181-3cb0-826a-7236f4279993",
                                "text": "Anoas need undisturbed forest and cannot adapt to logged areas. The bad-tempered anoa with its sharp short horns is greatly feared, but in spite of this it is periodically suggested as a potential domestic animal. Anyone who has met with an anoa ridicules this idea."
                            },
                            {
                                "example_id": "3ad5cb01-bfd4-44da-8e53-b525ed37573b",
                                "sense_id": "3758060f-f181-3cb0-826a-7236f4279993",
                                "text": "The Celebes pig and, to a lesser degree, the anoa were the focus of the Wana's large game interests."
                            },
                            {
                                "example_id": "c0b96e6f-ea1c-4f70-92df-198a0ba8877c",
                                "sense_id": "3758060f-f181-3cb0-826a-7236f4279993",
                                "text": "They reported seeing mountain anoa trophies for sale, and also a living captive animal, in the Toraja highlands; probable lowland anoas in the Gunung Tangkoko National Park on the N tip of Sulawesi, and evidence of both kinds of anoas in or near the Dumoga-Bone National Park."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e302188-9af3-4e7c-93ef-ef0b2156c3ec",
                        "source_entry_id": "e5805653-0864-3445-89eb-244d7ce3df6a",
                        "source_sense_id": "3758060f-f181-3cb0-826a-7236f4279993",
                        "source_sense_description": "small Indonesian water buffalo",
