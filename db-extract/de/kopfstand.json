                ],
                "senses": [
                    {
                        "sense_id": "d993c759-129b-3927-aa8d-db5118bbdd29",
                        "entry_id": "199b20a0-a43d-35ef-88f8-d53f9c2435ab",
                        "glosses": [
                            "Übung beim Turnen und beim Yoga, bei der man gestreckt auf seinem Kopf steht und sich dabei mit den Händen seitlich abstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7435531-21d7-4d19-ac61-7f92ef957143",
                                "sense_id": "d993c759-129b-3927-aa8d-db5118bbdd29",
                                "text": "Ich finde, einen Kopfstand zu machen, ist viel einfacher als ein Handstand."
                            },
                            {
                                "example_id": "273c9b63-d8f7-40a9-a0a5-7aff16ef9749",
                                "sense_id": "d993c759-129b-3927-aa8d-db5118bbdd29",
                                "text": "„Herr Ender hatte sogar behauptet, 20 Minuten Kopfstand ersetzten eine komplette Nachtruhe.“"
                            },
                            {
                                "example_id": "73b5b20b-9181-49f1-ab45-f51b3ceb7579",
                                "sense_id": "d993c759-129b-3927-aa8d-db5118bbdd29",
                                "text": "„Kappelsberger sprang auf, eilte zur Mitte des Raums und zirkelte einen Kopfstand auf den Täbris, daß ihm die aufschlaglosen Hosen rutschten und sich ineinanderfalteten und seine sockenlosen Füße und Unterbeine und Waden zuckende Zeichen gaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
