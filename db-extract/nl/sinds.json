                                                "text": "Od wczoraj nie ma wody."
                                            },
                                            {
                                                "example_id": "d19544ad-fd6b-4072-8936-d80477c1bf4e",
                                                "sense_id": "922b2d6a-9adb-3def-9925-4cb15ffb6677",
