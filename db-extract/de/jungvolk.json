                "senses": [
                    {
                        "sense_id": "ebfc9fbd-c220-3f32-932e-e1bce2f3aba4",
                        "entry_id": "0e049883-4135-3d98-a4cc-027f4a80ccfe",
                        "glosses": [
                            "Gesamtheit aller jungen Personen"
                        ],
                        "tags": [
                            "no-plural",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "be7df967-bcb3-491d-b3b5-6c44e1f49a9e",
                                "sense_id": "ebfc9fbd-c220-3f32-932e-e1bce2f3aba4",
                                "text": "„Aber da kam er bei dem aufsässigen Jungvolk schön an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d1e7379-693b-3c01-a564-0534c5eed468",
                        "entry_id": "0e049883-4135-3d98-a4cc-027f4a80ccfe",
                        "glosses": [
                            "Jugendorganisation in Deutschland und Österreich"
                        ],
                        "tags": [
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "98313f10-a25e-4de6-94d4-f9549bab04e1",
                                "sense_id": "7d1e7379-693b-3c01-a564-0534c5eed468",
                                "text": "„Dabei war er es, der meine Mutter zwang, uns zum Dienst zu schicken, mich ins Jungvolk und Henriette in den BDM.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "68cf69ba-e6a0-37fc-aaa3-02fee25d806a",
                        "entry_id": "0e049883-4135-3d98-a4cc-027f4a80ccfe",
                        "glosses": [
                            "neu gebildetes Bienenvolk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696fe607-35c0-4fb2-9a18-b9c16beebc97",
                                "sense_id": "68cf69ba-e6a0-37fc-aaa3-02fee25d806a",
                                "text": "„Im Frühjahr vermehren sich die Bienen enorm, Jungvölker ziehen aus den Bienenkästen aus und suchen sich ein neues Zuhause, zum Beispiel alte Spechthöhlen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
