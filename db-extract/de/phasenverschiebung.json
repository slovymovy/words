                "senses": [
                    {
                        "sense_id": "8d7d9648-2945-3d8d-93ce-83da5bd70b0b",
                        "entry_id": "16545648-aa07-336b-afcd-17d4c1cf614d",
                        "glosses": [
                            "die Differenz der Nulldurchgänge von negativ zu positiv zwischen zwei Sinusschwingungen gleicher Periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "507063a0-f377-4d97-904b-60794c03d520",
                                "sense_id": "8d7d9648-2945-3d8d-93ce-83da5bd70b0b",
                                "text": "Eine Cosinusschwingung hat zu einer Sinusschwingung eine Phasenverschiebung von +90°."
                            },
                            {
                                "example_id": "f0e8bdf3-3523-4f58-812b-807c2f53bfde",
                                "sense_id": "8d7d9648-2945-3d8d-93ce-83da5bd70b0b",
                                "text": "Drehstrom hat eine Phasenverschiebung von jeweils 120° zwischen seinen drei Phasen."
                            },
                            {
                                "example_id": "9c984242-7c2c-4066-b19d-c4e78b6a8ebe",
                                "sense_id": "8d7d9648-2945-3d8d-93ce-83da5bd70b0b",
                                "text": "„Wie sich herausstellte, liess sich die Phasenverschiebung der Radiowellen über die gesamte Dauer der Eruption verfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
