                    {
                        "translation_id": "203b7048-c680-48f1-bb3a-7c8e3d4ee162",
                        "source_entry_id": "c64f55d9-04c1-375a-b311-f2e6fd58553c",
                        "source_sense_id": "f1c0429d-e145-3b83-b39d-aa7f5cd78cba",
