                        "glosses": [
                            "zonder ergens te veel over na te denken; zonder zich veel zorgen te maken; met een licht gemoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "252f17f1-8831-49f2-93ed-dee12a717361",
                                "sense_id": "f1255ae3-4144-3a2c-8a9d-32d22f7352c5",
                                "text": "Ze was nadien nooit meer zo lichthartig, nooit meer zo zorgeloos."
                            },
