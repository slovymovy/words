                        "entry_id": "05f45b86-cd3d-30c6-9b6e-d2b4bc309b8e",
                        "glosses": [
                            "Qui tinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967ae3c0-5b76-4b1b-b55b-69134800f2d1",
                                "sense_id": "54bf713e-3171-3576-8248-dfe229180f28",
                                "text": "Mais, ma foi, je me trouve dépassé tout d’un coup par ces cousines à l’air hardi, à la voix tintante, et je vais boire — boire du bleu et du courage."
                            },
                            {
                                "example_id": "83f469e4-07df-44e2-88eb-2623251ec733",
                                "sense_id": "54bf713e-3171-3576-8248-dfe229180f28",
                                "text": "Fleur Lee faisait une entrée parcourue de frissons : frissons des chaînes de ses bracelets, des billes de son collier, frissons de sa voix toute tintante d'inquiétude, frissons de la soie de ses jupes."
                            }
                        ]
                    }
