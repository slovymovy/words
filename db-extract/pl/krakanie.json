                    {
                        "sense_id": "40ccf1ad-c394-308e-a58b-dadab71d1755",
                        "entry_id": "8bcbf4fe-7421-3f33-be7c-1e8512638773",
                        "glosses": [
                            "Laute von Raben oder Krähen; Krächzen, Gekrächze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a3a74f-bfd5-48b7-ba00-8cf66c6921d9",
                                "sense_id": "40ccf1ad-c394-308e-a58b-dadab71d1755",
                                "text": "„Orły, jastrzębie i kruki jedne widziały, a kto z daleka usłyszał szum skrzydeł i krakanie, kto ujrzał wiry ptasie, nad jednem kołujące miejscem, to wiedział, że tam trupy lub kości niepogrzebione leżą...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31e66b5d-1afb-4d6d-a151-606865c60e35",
                        "source_entry_id": "8bcbf4fe-7421-3f33-be7c-1e8512638773",
                        "source_sense_id": "40ccf1ad-c394-308e-a58b-dadab71d1755",
                        "source_sense_description": "Laute von Raben oder Krähen; Krächzen, Gekrächze",
                        "target_lang_word": "Krächzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krächzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a09c9e48-6aad-38eb-8c54-1a74876318d9",
                                        "entry_id": "1dbf639a-d3e2-3ce0-b7bf-7641cfaca005",
                                        "glosses": [
                                            "krächzendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc485bb7-e636-46e5-a411-17d1c9119b3e",
                                                "sense_id": "a09c9e48-6aad-38eb-8c54-1a74876318d9",
                                                "text": "„Ein Lächeln füllte die Lücke. Das heisere Krächzen eines lachenden Mannes.“"
                                            },
                                            {
                                                "example_id": "7bb88c11-7de0-43cd-b3e2-40f263864dd2",
                                                "sense_id": "a09c9e48-6aad-38eb-8c54-1a74876318d9",
                                                "text": "„Blut sprudelte aus der Wunde, und die Schreie des Ungläubigen verkümmerten zu einem glucksenden Krächzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d8a354a-73ef-4095-b746-9b68eb8b95da",
                        "source_entry_id": "8bcbf4fe-7421-3f33-be7c-1e8512638773",
                        "source_sense_id": "40ccf1ad-c394-308e-a58b-dadab71d1755",
