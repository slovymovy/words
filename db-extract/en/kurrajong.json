                        "glosses": [
                            "Any of a number of species of tree or shrub in the genus Brachychiton."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "59b39b7e-0b2c-45c6-98a2-041687f1e747",
                                "sense_id": "3e541e1e-9bf1-3a9b-ae7a-3d4b43093d30",
                                "text": "My young friend, Master Keith McKeown, now finds this beetle under the stones about the roots of the kurrajong at Wagga, and also sheltering during the winter in the seed-pods on the trees."
                            },
                            {
                                "example_id": "49f70c44-ccdb-400a-9a56-f7d60fd30555",
                                "sense_id": "3e541e1e-9bf1-3a9b-ae7a-3d4b43093d30",
                                "text": "From the mallee and kurrajong trees came a rowdy chatter of parakeets, while queer soughing of air-currents came from the valley top."
                            },
                            {
                                "example_id": "c6a11bc0-96eb-402d-821c-3489f7730a14",
                                "sense_id": "3e541e1e-9bf1-3a9b-ae7a-3d4b43093d30",
                                "text": "The black kurrajong has a fibrous bark that Aboriginal artefact-makers used as a raw material to make string for their lines and carry-bags."
                            },
                            {
                                "example_id": "30c6d4fc-c5c4-40d2-ae17-b1e8d5b292ef",
                                "sense_id": "3e541e1e-9bf1-3a9b-ae7a-3d4b43093d30",
                                "text": "The groves of Kurrajongs along the saddle of Mount Majura were founded last century."
                            }
                        ]
                    },
                    {
                        "sense_id": "d92309c6-6e31-39de-9d40-0aa5190642aa",
                        "entry_id": "a75b9693-f248-3959-aee1-862b56e545bf",
                        "glosses": [
                            "A peanut tree, Sterculia quadrifida, native to eastern coastal Australia; a red- or orange-fruited kurrajong."
                        ],
