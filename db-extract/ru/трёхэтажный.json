                    },
                    {
                        "sense_id": "a36f3125-b41d-33ff-88b1-7561e0eea326",
                        "entry_id": "48012acd-a1be-3ae8-8078-a30ea26d108d",
                        "glosses": [
                            "with swearwords"
                        ],
                        "tags": [
                            "colloquial",
