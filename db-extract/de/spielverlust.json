                "senses": [
                    {
                        "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                        "entry_id": "98e880a1-62d1-392b-9474-0a9e9d3912e0",
                        "glosses": [
                            "Niederlage in einem Wettspiel, Verlieren eines auf Sieg ausgerichteten Spiels in einem Turnier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4c35e1-7e1d-4a3c-b4e5-3d1400272361",
                                "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                                "text": "„Nach einem freien Tag erwischte Serena Williams den besseren Start zum 2:0 im ersten Satz und holte sich nach dem 2:2-Zwischenstand ohne weiteren Spielverlust den Durchgang.“"
                            },
                            {
                                "example_id": "08cef8fd-12c0-4a31-bf7a-d4098aef26f0",
                                "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                                "text": "„Dem sofortigen Break im entscheidenden Satz folgten trotz guter Chancen und Engagement vier Spielverluste zum 1:4.“"
                            },
                            {
                                "example_id": "d83ce2b6-7184-4c82-a042-3da9710f6a03",
                                "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                                "text": "„Und genau darin liegt die Krux des liberalen Schachspiels in diesen Tagen: Alle weißen Figuren stehen so ungünstig zueinander, dass eine einzige voreilige oder unüberlegte Bewegung zum Spielverlust führen könnte.“"
                            },
                            {
                                "example_id": "10eabbe7-c0fd-4580-ad64-0893b6670841",
                                "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                                "text": "„Dabei besagte eine Niederlage unserer Repräsentativelf damals so gut wie gar nichts gegenüber dem Heute, wo es schließlich um den guten Ruf des Weltmeisters geht und ein Spielverlust zumeist eine Blamage bedeutet.“"
                            },
                            {
                                "example_id": "c4fc3cb3-8822-4480-805c-d7b0fbc6670a",
                                "sense_id": "4178020e-08a7-35ed-96fe-ca01cce39b19",
                                "text": "„Das 4:0 gegen Italien war der vierte Sieg des Vizeeuropameisters von 1994 im vierten Gruppenspiel ohne Spielverlust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                        "entry_id": "98e880a1-62d1-392b-9474-0a9e9d3912e0",
                        "glosses": [
                            "Einbuße eines Spieleinsatzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19980e83-22ac-456b-b5b2-2acc44aa408b",
                                "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                                "text": "„Niemand wird verabsäumen, seinen Spielgewinn einzustreichen, aber den Spielverlust zu bezahlen, vergessen so manche.“"
                            },
                            {
                                "example_id": "86acdaf8-a323-4fb2-8fc2-01704f525685",
                                "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                                "text": "„Dein Sohn hat Spielverluste gehabt und erst auf alle Weise versucht, sich das Geld zu leihen.“"
                            },
                            {
                                "example_id": "d63794ac-050d-4a36-9699-57a4e3511ac5",
                                "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                                "text": "„Warum fragt man die Süchtigen nicht nach ihren monatlichen Spielverlusten und kennzeichnet sie ihren wahrheitsgemäßen Angaben nach als großzügige Typen, zumal, wenn man von ihnen profitiert?“"
                            },
                            {
                                "example_id": "7fdec8d0-9034-4e77-9530-c599d12cc30b",
                                "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                                "text": "„Der mit kühlem Kopf geplante Bilanzselbstmord nach Spielverlusten im Kasino oder die mit sicherer Hand zur Ehrenrettung an die Schläfe geführte Pistole gehören wohl eher einer verklärten Vergangenheit an, die so nicht stattgefunden hat.“"
                            },
                            {
                                "example_id": "cddf6922-d7bf-46b6-a15b-ee8619b704f5",
                                "sense_id": "4011cbd4-1593-3ebd-8e60-46f9ef536799",
                                "text": "„Meine hohen Spielverluste und bittere Enttäuschungen in der Liebe, ganz zu schweigen von allem anderen, hatten mich in das alte Haus im Dorf meiner Väter verbannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
