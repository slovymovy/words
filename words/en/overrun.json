{
    "word_family": [
        "run",
        "runner",
        "overrunner",
        "outrun"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ce6c1a4-d77f-32dd-8e26-633b8a511d16",
                    "sense_definition": "To swarm over, spread throughout, or occupy in large numbers, often causing harm or damage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not weed the garden regularly, wild plants will soon <w>overrun</w> the entire yard.",
                            "target_lang_translations": {
                                "zh": "如果你不定期除草，野草很快就会<w>蔓延</w>到整个院子。"
                            }
                        },
                        {
                            "text": "The abandoned building was completely <w>overrun</w> with weeds and insects.",
                            "target_lang_translations": {
                                "zh": "那座废弃的建筑里完全<w>充斥</w>着杂草和昆虫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overrun with weeds",
                        "overrun by pests"
                    ],
                    "target_lang_definitions": {
                        "zh": "指大量蔓延、占据或侵入某处，通常造成损害或破坏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蔓延",
                                "target_lang_sense_clarification": "指植物或害虫等扩散到整个区域。"
                            },
                            {
                                "target_lang_word": "充斥",
                                "target_lang_sense_clarification": "指充满某处，通常带有负面含义。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd12e0e-f8d7-3c04-a76b-cc228d8038d3",
                    "sense_definition": "To exceed the planned time limit or schedule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because the opening speech began late, the entire meeting was forced to <w>overrun</w> the schedule.",
                            "target_lang_translations": {
                                "zh": "由于开幕致辞开始得晚，整个会议不得不<w>超时</w>进行。"
                            }
                        },
                        {
                            "text": "The morning presentation will likely <w>overrun</w> by fifteen minutes.",
                            "target_lang_translations": {
                                "zh": "上午的演讲可能会<w>延时</w>十五分钟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overrun the schedule",
                        "overrun by minutes"
                    ],
                    "target_lang_definitions": {
                        "zh": "指超过预定的时间限制或日程安排。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超时",
                                "target_lang_sense_clarification": "指活动或会议超过了预定时间。"
                            },
                            {
                                "target_lang_word": "延时",
                                "target_lang_sense_clarification": "指时间上的延长。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e75c2f9b-b8a1-3267-bdca-f8f8c3bca5d3",
                    "sense_definition": "To defeat and invade a territory or enemy position quickly and completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military forces managed to <w>overrun</w> the enemy stronghold after hours of intense fighting.",
                            "target_lang_translations": {
                                "zh": "经过数小时的激战，军队成功<w>攻占</w>了敌人的据点。"
                            }
                        },
                        {
                            "text": "Enemy soldiers threatened to <w>overrun</w> the border defenses.",
                            "target_lang_translations": {
                                "zh": "敌军威胁要<w>攻破</w>边境防线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overrun defenses",
                        "overrun enemy lines"
                    ],
                    "target_lang_definitions": {
                        "zh": "指迅速且彻底地击败并侵占领土或敌方阵地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "攻占",
                                "target_lang_sense_clarification": "指通过军事行动占领某地。"
                            },
                            {
                                "target_lang_word": "蹂躏",
                                "target_lang_sense_clarification": "指侵略者对领土的践踏和破坏。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd88968e-9a08-3815-ab2a-858cc1a7ee10",
                    "sense_definition": "To run past or extend beyond a intended stopping point or boundary.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distracted runner failed to stop in time and <w>overran</w> the finish line.",
                            "target_lang_translations": {
                                "zh": "那名分心的选手没能及时停下，<w>冲出</w>了终点线。"
                            }
                        },
                        {
                            "text": "The aircraft <w>overran</w> the runway due to icy landing conditions.",
                            "target_lang_translations": {
                                "zh": "由于着陆时路面结冰，飞机<w>冲出</w>了跑道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overrun the finish line",
                        "overrun the runway"
                    ],
                    "target_lang_definitions": {
                        "zh": "指跑过或延伸超过预定的停止点或边界。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冲出",
                                "target_lang_sense_clarification": "指越过预定的界限。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea000091-cb11-3bc6-b6a2-8b20ddea9432",
                    "sense_definition": "To exceed a specified financial budget or limit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the project managers do not control expenses carefully, costs will <w>overrun</w> the budget.",
                            "target_lang_translations": {
                                "zh": "如果项目经理不仔细控制开支，成本将会<w>超支</w>。"
                            }
                        },
                        {
                            "text": "The construction project threatens to <w>overrun</w> the original estimate.",
                            "target_lang_translations": {
                                "zh": "该建筑项目有<w>超支</w>最初预算的风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overrun the budget"
                    ],
                    "target_lang_definitions": {
                        "zh": "指超过特定的财务预算或限额。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超支",
                                "target_lang_sense_clarification": "指支出超过了预算。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c5c2a87-efe2-3846-8881-0ffc8939d435",
                    "sense_definition": "To carry text or type over into the next line, column, or page.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor adjusted the font size so that the paragraph would not <w>overrun</w> onto the next page.",
                            "target_lang_translations": {
                                "zh": "编辑调整了字体大小，以免段落<w>溢出</w>到下一页。"
                            }
                        },
                        {
                            "text": "Long titles often <w>overrun</w> into the second line of the layout.",
                            "target_lang_translations": {
                                "zh": "长标题经常会<w>溢出</w>到排版的第二行。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指文字或排版内容延伸到下一行、下一栏或下一页。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "溢出",
                                "target_lang_sense_clarification": "指排版内容超出预定范围。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3ffd3a5-01a1-30f0-b7ff-93e48ac79b48",
                    "sense_definition": "To oppress, trample upon, or treat harshly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aggressive rulers sought to <w>overrun</w> the weaker populations of the region.",
                            "target_lang_translations": {
                                "zh": "那些好战的统治者试图<w>践踏</w>该地区的弱势群体。"
                            }
                        },
                        {
                            "text": "No ruthless conqueror shall be allowed to <w>overrun</w> the rights of the citizens.",
                            "target_lang_translations": {
                                "zh": "绝不允许任何残暴的征服者<w>践踏</w>公民的权利。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指压迫、践踏或严酷对待。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "践踏",
                                "target_lang_sense_clarification": "指粗暴地对待或侵犯权利。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4c49e93-5afe-3d4e-aa5d-7efb541d9c0f",
                    "sense_definition": "An instance of exceeding a budget, time limit, or estimated cost.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poor planning and unexpected delays resulted in a major cost <w>overrun</w> for the new highway project.",
                            "target_lang_translations": {
                                "zh": "规划不当和意外延误导致新高速公路项目出现了严重的成本<w>超支</w>。"
                            }
                        },
                        {
                            "text": "The company suffered a severe cost <w>overrun</w> during the development phase.",
                            "target_lang_translations": {
                                "zh": "公司在开发阶段遭受了严重的成本<w>超支</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cost overrun",
                        "budget overrun"
                    ],
                    "target_lang_definitions": {
                        "zh": "指超出预算、时间限制或预估成本的情况。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超支",
                                "target_lang_sense_clarification": "指成本或预算的超出。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6a8c785-57c1-392a-b6a4-5a3eb4580f01",
                    "sense_definition": "The specific amount or extent by which something exceeds a limit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial team calculated a significant <w>overrun</w> at the end of the quarter.",
                            "target_lang_translations": {
                                "zh": "财务团队计算出季度末有显著的<w>超额</w>支出。"
                            }
                        },
                        {
                            "text": "Management worked hard to reduce the financial <w>overrun</w> before the audit.",
                            "target_lang_translations": {
                                "zh": "管理层在审计前努力减少财务<w>超额</w>部分。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指超出限额的具体金额或程度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超额",
                                "target_lang_sense_clarification": "指超出预定额度的部分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecdb1c99-42cd-3530-98ae-11359b9af36f",
                    "sense_definition": "A designated, clear area beyond the end of a runway designed to allow an aircraft to stop safely if it fails to halt in time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot used the paved <w>overrun</w> to bring the aircraft to a safe complete stop.",
                            "target_lang_translations": {
                                "zh": "飞行员利用铺设好的<w>跑道安全区</w>使飞机安全停稳。"
                            }
                        },
                        {
                            "text": "Engineers extended the runway <w>overrun</w> to improve safety standards at the airport.",
                            "target_lang_translations": {
                                "zh": "工程师扩建了<w>跑道安全区</w>以提高机场的安全标准。"
                            }
                        }
                    ],
                    "synonyms": [
                        "runway safety area",
                        "stopway"
                    ],
                    "common_phrases": [
                        "runway overrun"
                    ],
                    "target_lang_definitions": {
                        "zh": "指跑道末端的一块空地，用于飞机在未能及时停下时安全减速。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跑道安全区",
                                "target_lang_sense_clarification": "指机场跑道末端的安全缓冲区域。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcfdc3d9-bb9b-370f-b7e6-240b073ca427",
                    "sense_definition": "The percentage of air incorporated into a frozen dessert, such as ice cream, during manufacturing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High-quality ice cream typically has a low <w>overrun</w>, making it denser and richer.",
                            "target_lang_translations": {
                                "zh": "优质冰淇淋通常具有较低的<w>膨胀率</w>，这使其口感更浓郁扎实。"
                            }
                        },
                        {
                            "text": "Cheaper frozen desserts often contain too much <w>overrun</w>, giving them a fluffy texture.",
                            "target_lang_translations": {
                                "zh": "廉价的冷冻甜点通常含有过高的<w>膨胀率</w>，使其口感松散。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在制造冷冻甜点（如冰淇淋）过程中混入的空气比例。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "膨胀率",
                                "target_lang_sense_clarification": "指冰淇淋生产中空气混入的比例。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}