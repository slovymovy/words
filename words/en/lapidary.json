{
    "word_family": [
        "lapidarist",
        "lapidist",
        "lapidarian",
        "lapidate",
        "lapidation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4706bdec-01b0-36fb-938d-18a6ebd2fd88",
                    "sense_definition": "A person who cuts and polishes, engraves, or deals in gems and precious stones.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gem_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skilled <w>lapidary</w> spent many hours carefully shaping the raw emerald into a beautiful faceted gem.",
                            "target_lang_translations": {
                                "ru": "Умелый <w>огранщик</w> провел много часов, осторожно превращая необработанный изумруд в прекрасный граненый камень."
                            }
                        },
                        {
                            "text": "If you want to turn that rough stone into jewelry, you should take it to a professional <w>lapidary</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите превратить этот необработанный камень в украшение, вам следует отнести его к профессиональному <w>лапидарию</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gemsmith",
                        "lapidarist",
                        "lapidist"
                    ],
                    "common_phrases": [
                        "skilled lapidary",
                        "professional lapidary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который занимается огранкой, полировкой, гравировкой или торговлей драгоценными и поделочными камнями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарий",
                                "target_lang_sense_clarification": "мастер по камню"
                            },
                            {
                                "target_lang_word": "огранщик",
                                "target_lang_sense_clarification": "специалист по огранке камней"
                            },
                            {
                                "target_lang_word": "ювелир",
                                "target_lang_sense_clarification": "в контексте работы с камнями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11b3d17e-9b8d-3e51-b5ee-cfa375462b6f",
                    "sense_definition": "An expert in gems and precious stones; a connoisseur of lapidary work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gem_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an expert <w>lapidary</w>, he was often called upon by museums to authenticate ancient jewelry collections.",
                            "target_lang_translations": {
                                "ru": "Как опытного <w>знатока камней</w>, музеи часто приглашали его для подтверждения подлинности коллекций древних украшений."
                            }
                        },
                        {
                            "text": "The collector consulted a renowned <w>lapidary</w> to determine the true value of the rare sapphire.",
                            "target_lang_translations": {
                                "ru": "Коллекционер проконсультировался с известным <w>геммологом</w>, чтобы определить истинную стоимость редкого сапфира."
                            }
                        }
                    ],
                    "synonyms": [
                        "gemmologist",
                        "gemologist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эксперт или знаток драгоценных камней и искусства их обработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "геммолог",
                                "target_lang_sense_clarification": "специалист по изучению камней"
                            },
                            {
                                "target_lang_word": "знаток",
                                "target_lang_sense_clarification": "в области камнерезного искусства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f33da79-09b5-3ee1-81cb-fba72658b6a3",
                    "sense_definition": "The field in which such a person works, a subfield of gemology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gem_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>lapidary</w> at the technical college to learn the art of diamond cutting.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>камнерезное дело</w> в техническом колледже, чтобы освоить искусство огранки алмазов."
                            }
                        },
                        {
                            "text": "The museum exhibit focused on the history of <w>lapidary</w> and the evolution of stone-cutting tools.",
                            "target_lang_translations": {
                                "ru": "Музейная экспозиция была посвящена истории <w>искусства обработки камня</w> и эволюции камнерезных инструментов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "art of lapidary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область деятельности, связанная с обработкой камней; камнерезное искусство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарное дело",
                                "target_lang_sense_clarification": "искусство обработки камня"
                            },
                            {
                                "target_lang_word": "камнерезное искусство",
                                "target_lang_sense_clarification": "профессиональная сфера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a57f518-1215-3ee8-8ce3-8c6f87aadb90",
                    "sense_definition": "Gems and precious stones collectively; jewellery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gem_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal treasury was filled with exquisite <w>lapidary</w> collected from across the vast empire.",
                            "target_lang_translations": {
                                "ru": "Королевская сокровищница была полна изысканных <w>драгоценных камней</w>, собранных со всей огромной империи."
                            }
                        },
                        {
                            "text": "Her collection of antique <w>lapidary</w> included several pieces from the Victorian era.",
                            "target_lang_translations": {
                                "ru": "Ее коллекция антикварных <w>ювелирных изделий</w> включала несколько предметов викторианской эпохи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used less frequently in modern English to refer to the stones themselves."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Драгоценные камни или ювелирные изделия в совокупности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоценности",
                                "target_lang_sense_clarification": "коллекция камней"
                            },
                            {
                                "target_lang_word": "ювелирные изделия",
                                "target_lang_sense_clarification": "изделия с камнями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e8183d5-d875-3dc5-9900-f700b2a3b258",
                    "sense_definition": "A treatise on (precious) stones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gem_literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>lapidary</w> described not only the physical properties of stones but also their supposed magical powers.",
                            "target_lang_translations": {
                                "ru": "Средневековый <w>лапидарий</w> описывал не только физические свойства камней, но и их предполагаемую магическую силу."
                            }
                        },
                        {
                            "text": "Historians often study an ancient <w>lapidary</w> to understand how different cultures valued various minerals.",
                            "target_lang_translations": {
                                "ru": "Историки часто изучают древние <w>трактаты о камнях</w>, чтобы понять, как разные культуры ценили те или иные минералы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трактат о драгоценных камнях и их свойствах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарий",
                                "target_lang_sense_clarification": "средневековый трактат о камнях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a6dc3d12-1f94-31fd-8585-c59ed2fdd24c",
                    "sense_definition": "Of a piece of writing or a writing style: concise, stately, and precise, as if engraved on a monument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is famous for his <w>lapidary</w> prose, where every single word is chosen with extreme care.",
                            "target_lang_translations": {
                                "ru": "Автор знаменит своей <w>лапидарной</w> прозой, в которой каждое слово выбрано с предельной тщательностью."
                            }
                        },
                        {
                            "text": "The philosopher expressed his complex ideas through a series of <w>lapidary</w> phrases that were easy to remember.",
                            "target_lang_translations": {
                                "ru": "Философ выражал свои сложные идеи через серию <w>чеканных</w> фраз, которые было легко запомнить."
                            }
                        }
                    ],
                    "synonyms": [
                        "brief",
                        "concise",
                        "succinct",
                        "terse",
                        "laconic",
                        "to the point"
                    ],
                    "common_phrases": [
                        "lapidary style",
                        "lapidary prose",
                        "lapidary phrases"
                    ],
                    "target_lang_definitions": {
                        "ru": "О стиле письма: краткий, торжественный и точный, напоминающий надпись на памятнике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарный",
                                "target_lang_sense_clarification": "краткий и выразительный"
                            },
                            {
                                "target_lang_word": "чеканный",
                                "target_lang_sense_clarification": "о стиле или слоге"
                            },
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "лаконичный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617db1b5-a903-313c-bbce-64f53fdc9d88",
                    "sense_definition": "Of or pertaining to gems and precious stones, or the art of working them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gem_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is known for its long history of <w>lapidary</w> arts, especially the cutting of local quartz.",
                            "target_lang_translations": {
                                "ru": "Город известен своей долгой историей <w>камнерезного</w> искусства, особенно огранкой местного кварца."
                            }
                        },
                        {
                            "text": "He used specialized <w>lapidary</w> equipment to polish the stones he found during his hike.",
                            "target_lang_translations": {
                                "ru": "Он использовал специальное <w>ювелирное</w> оборудование для полировки камней, найденных во время похода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapidary arts",
                        "lapidary equipment",
                        "lapidary work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к драгоценным камням или искусству их обработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарный",
                                "target_lang_sense_clarification": "связанный с обработкой камня"
                            },
                            {
                                "target_lang_word": "камнерезный",
                                "target_lang_sense_clarification": "относящийся к резьбе по камню"
                            },
                            {
                                "target_lang_word": "ювелирный",
                                "target_lang_sense_clarification": "в значении обработки камней"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d03b5327-d33c-3142-9024-b4a656adb740",
                    "sense_definition": "Of an inscription: engraved on stone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inscriptions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaeologists discovered a <w>lapidary</w> inscription on the base of the ruined statue.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили <w>высеченную на камне</w> надпись на основании разрушенной статуи."
                            }
                        },
                        {
                            "text": "The museum features a collection of <w>lapidary</w> records from the Roman era.",
                            "target_lang_translations": {
                                "ru": "В музее представлена коллекция <w>лапидарных</w> памятников письменности римской эпохи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lapidary inscription"
                    ],
                    "target_lang_definitions": {
                        "ru": "О надписи: высеченный на камне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапидарный",
                                "target_lang_sense_clarification": "высеченный на камне"
                            },
                            {
                                "target_lang_word": "накаменный",
                                "target_lang_sense_clarification": "редкое, об надписях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7cefd6e-2e16-3b60-8f57-32a18fcb4f61",
                    "sense_definition": "Of or pertaining to stones in general.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stone_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children engaged in a <w>lapidary</w> battle, throwing small pebbles at each other across the stream.",
                            "target_lang_translations": {
                                "ru": "Дети затеяли <w>каменную</w> битву, бросая друг в друга мелкую гальку через ручей."
                            }
                        },
                        {
                            "text": "The geologist examined the <w>lapidary</w> composition of the cliffside to determine its age.",
                            "target_lang_translations": {
                                "ru": "Геолог изучил <w>каменный</w> состав утеса, чтобы определить его возраст."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к камням в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каменный",
                                "target_lang_sense_clarification": "состоящий из камней"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}