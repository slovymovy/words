                        "examples": [
                            {
                                "example_id": "ffd38f4c-ac05-4900-be7d-c9c41d816472",
                                "sense_id": "284fc231-1a46-3fa2-a323-4ea8b230565d",
                                "text": "Elle trouvait à tous ses bibelots chinois des formes « amusantes », et aussi aux orchidées, aux catleyas surtout, qui étaient, avec les chrysanthèmes, ses fleurs préférées, parce qu’ils avaient le grand mérite de ne pas ressembler à des fleurs, mais d’être en soie, en satin."
                            },
                            {
                                "example_id": "7f0e6069-05d4-4807-a831-35871571b3b2",
                                "sense_id": "284fc231-1a46-3fa2-a323-4ea8b230565d",
                                "text": "Oiseaux de paradis, orchidées, roses, anthuriums, catleyas et camélias composent un vrai festival de couleurs auxquels participent les vendeuses en costume traditionnel régional."
                            },
                            {
                                "example_id": "b1407461-1b49-4872-a5de-d6df6e420175",
                                "sense_id": "284fc231-1a46-3fa2-a323-4ea8b230565d",
                                "text": "Va pour ces catleyas, elles feront de l’effet."
                            }
                        ]
                    }
