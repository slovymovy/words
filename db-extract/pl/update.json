                                "target_senses": [
                                    {
                                        "sense_id": "354a53ec-761f-3613-ac81-b517cff6131a",
                                        "entry_id": "9158f3fb-10a4-3d0b-995d-3fac8351bcb3",
                                        "glosses": [
                                            "An advisement providing more up-to-date information than currently known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce353de0-6c22-416e-a367-80b8faab62a9",
                                                "sense_id": "354a53ec-761f-3613-ac81-b517cff6131a",
                                                "text": "He gave me an update on the situation in New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dae2ff8-7949-3c13-b71b-2369574a926e",
                                        "entry_id": "9158f3fb-10a4-3d0b-995d-3fac8351bcb3",
                                        "glosses": [
                                            "A change in information, a modification of existing or known data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb474a6-cf74-43b7-bdf9-2d3455063eae",
                                                "sense_id": "7dae2ff8-7949-3c13-b71b-2369574a926e",
                                                "text": "I just made an update to the Wikipedia article on guerrillas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0f28ef-dbc9-3804-aacb-1067f63978e9",
                                        "entry_id": "9158f3fb-10a4-3d0b-995d-3fac8351bcb3",
                                        "glosses": [
                                            "An additional piece of information, an addition to existing information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4eccb50-77bd-4f97-a6b1-3828bfb6de87",
                                                "sense_id": "bc0f28ef-dbc9-3804-aacb-1067f63978e9",
                                                "text": "I just made an update to my blog about my trip to Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a751b90-a4be-3a6e-b01e-9ecacec7a439",
                                        "entry_id": "9158f3fb-10a4-3d0b-995d-3fac8351bcb3",
                                        "glosses": [
                                            "A modification of something to a more recent, up-to-date version; (in software) a minor upgrade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb80e8d-b0c5-49c4-9cd5-6bde2c0094a5",
                                                "sense_id": "4a751b90-a4be-3a6e-b01e-9ecacec7a439",
                                                "text": "Our database receives an update every morning at 3 AM."
                                            },
                                            {
                                                "example_id": "bce4ebc1-5218-48f4-8f6c-8c50a30c6b89",
                                                "sense_id": "4a751b90-a4be-3a6e-b01e-9ecacec7a439",
                                                "text": "I have a couple of updates to install on your laptop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "880a53a6-b35e-3edf-8f68-95179db81e69",
                                        "entry_id": "9158f3fb-10a4-3d0b-995d-3fac8351bcb3",
                                        "glosses": [
                                            "A version of something which is newer than other versions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "030a6e91-546b-4f44-b0aa-77a00a1ceb38",
                                                "sense_id": "880a53a6-b35e-3edf-8f68-95179db81e69",
                                                "text": "You should try the update: it rocks."
                                            },
                                            {
                                                "example_id": "a2802bb8-9053-4dc9-8f45-6820cd6a71ed",
                                                "sense_id": "880a53a6-b35e-3edf-8f68-95179db81e69",
                                                "text": "The mid-season update for MW3 is here, introducing quite a bit of content across all three of CoD’s modes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "update",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faf24316-74a2-3a3f-8d67-f672a64a545f",
                                        "entry_id": "55e92740-c7d7-3cc0-9c71-e2a652f0db7e",
                                        "glosses": [
                                            "To bring (a thing) up to date."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2273dc5c-cada-43ac-95f8-a94d12c43dd5",
                                                "sense_id": "faf24316-74a2-3a3f-8d67-f672a64a545f",
                                                "text": "I need to update my records to take account of the most recent transaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaed356f-0056-3c8a-9cee-1c14e5b5763c",
                                        "entry_id": "55e92740-c7d7-3cc0-9c71-e2a652f0db7e",
                                        "glosses": [
                                            "To bring (a person) up to date: to inform (a person) about recent developments."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6ec2e3a-7320-40b5-a9bb-56e5b44b4398",
                                                "sense_id": "aaed356f-0056-3c8a-9cee-1c14e5b5763c",
                                                "text": "Update me on what happened while I was away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
