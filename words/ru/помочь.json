{
    "word_family": [
        "помощь",
        "помощник",
        "помогать",
        "беспомощный",
        "вспомогательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c13f28da-eba8-3f19-93cc-0f989a39d50e",
                    "sense_definition": "Содействовать кому-либо в каком-либо деле, облегчать выполнение чего-либо или спасать от чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "help_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу тебе <помочь> с домашним заданием.",
                            "target_lang_translations": {
                                "en": "I want to <help> you with your homework.",
                                "zh": "我想<w>帮助</w>你做家庭作业。"
                            }
                        },
                        {
                            "text": "Друзья всегда готовы <помочь> в трудную минуту.",
                            "target_lang_translations": {
                                "en": "Friends are always ready to <help> in a difficult moment.",
                                "zh": "朋友们总是在困难时刻愿意<w>帮忙</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "посодействовать",
                        "поспособствовать",
                        "оказать помощь",
                        "поддержать",
                        "выручить",
                        "пособить",
                        "подсобить"
                    ],
                    "antonyms": [
                        "помешать"
                    ],
                    "common_phrases": [
                        "помочь другу",
                        "рад помочь",
                        "помочь по дому",
                        "помочь в беде"
                    ],
                    "target_lang_definitions": {
                        "en": "To assist someone in a task, facilitate the execution of something, or save from something.",
                        "zh": "帮助某人做某事，使事情更容易完成，或使某人摆脱困难或危险。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "general term for providing assistance"
                            },
                            {
                                "target_lang_word": "assist",
                                "target_lang_sense_clarification": "slightly more formal than help"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帮助",
                                "target_lang_sense_clarification": "一般说“帮助、协助”别人做某事"
                            },
                            {
                                "target_lang_word": "帮忙",
                                "target_lang_sense_clarification": "较口语，指搭手、出力"
                            },
                            {
                                "target_lang_word": "协助",
                                "target_lang_sense_clarification": "较正式，强调给予协助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66f49ff7-0998-3ef5-86e2-e067a591fe70",
                    "sense_definition": "Оказать нужное действие, принести пользу или желаемый результат (обычно о лекарстве или средстве).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "help_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это лекарство должно быстро <помочь> от головной боли.",
                            "target_lang_translations": {
                                "en": "This medicine should quickly <help> with the headache.",
                                "zh": "这个药治头痛应该很快<w>管用</w>。"
                            }
                        },
                        {
                            "text": "Никакие уговоры не смогли <помочь> в этой ситуации.",
                            "target_lang_translations": {
                                "en": "No amount of persuasion could <help> in this situation.",
                                "zh": "在这种情况下，任何劝说都没能<w>起作用</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "лекарство помогло",
                        "ничем не помочь",
                        "это не поможет"
                    ],
                    "target_lang_definitions": {
                        "en": "To have the desired effect, bring benefit, or produce a result (usually regarding medicine or a remedy).",
                        "zh": "指药物、办法或措施产生预期效果，带来好处或结果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "to alleviate a condition or be useful"
                            },
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "to be effective or produce the desired result"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管用",
                                "target_lang_sense_clarification": "指药物、办法等有效果"
                            },
                            {
                                "target_lang_word": "起作用",
                                "target_lang_sense_clarification": "指产生效果、发生作用"
                            },
                            {
                                "target_lang_word": "奏效",
                                "target_lang_sense_clarification": "较书面，指方法或药物见效"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21849961-5f39-3bd9-ad0c-e24455a1aa46",
                    "sense_definition": "Оказать материальную поддержку, дать денег.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "help_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Родители обещали <помочь> деньгами на покупку квартиры.",
                            "target_lang_translations": {
                                "en": "My parents promised to <help> with money to buy an apartment.",
                                "zh": "父母答应出钱<w>资助</w>我们买房。"
                            }
                        },
                        {
                            "text": "Фонд решил <помочь> пострадавшим от наводнения.",
                            "target_lang_translations": {
                                "en": "The foundation decided to <help> the flood victims.",
                                "zh": "基金会决定<w>救济</w>洪灾灾民。"
                            }
                        }
                    ],
                    "synonyms": [
                        "поддержать"
                    ],
                    "common_phrases": [
                        "помочь деньгами",
                        "помочь материально"
                    ],
                    "target_lang_definitions": {
                        "en": "To provide material support or give money.",
                        "zh": "提供物质上的支持，尤其是给钱帮助别人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help out",
                                "target_lang_sense_clarification": "to provide assistance, often financial"
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "to provide for materially"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "提供金钱上的帮助"
                            },
                            {
                                "target_lang_word": "接济",
                                "target_lang_sense_clarification": "接济生活困难的人"
                            },
                            {
                                "target_lang_word": "救济",
                                "target_lang_sense_clarification": "多指对受灾者或贫困者给予物质帮助"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7bfd3c9-385e-32bc-9e43-b0a11e892ffc",
                    "sense_definition": "Лямки, перекидываемые через плечи, служащие для поддержки брюк; подтяжки.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старик носил широкие штаны на <помочах>.",
                            "target_lang_translations": {
                                "en": "The old man wore wide trousers held up by <suspenders>.",
                                "zh": "老人穿着用<w>背带</w>吊着的宽大裤子。"
                            }
                        },
                        {
                            "text": "Одна из <помочей> оторвалась, и брюки сползли вниз.",
                            "target_lang_translations": {
                                "en": "One of the <suspenders> snapped, and the trousers slid down.",
                                "zh": "一根<w>背带</w>断了，裤子滑了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подтяжка"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "современный термин - подтяжки"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Straps worn over the shoulders to support trousers; suspenders.",
                        "zh": "搭在肩上、用来支撑裤子的带子，即“背带”或“吊裤带”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspenders",
                                "target_lang_sense_clarification": "American English"
                            },
                            {
                                "target_lang_word": "braces",
                                "target_lang_sense_clarification": "British English"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背带",
                                "target_lang_sense_clarification": "吊住裤子的肩带，现代常用说法"
                            },
                            {
                                "target_lang_word": "吊裤带",
                                "target_lang_sense_clarification": "更具体地指吊裤子的带子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86dde3ab-6c65-386a-8047-89b2993df018",
                    "sense_definition": "То же, что помощь; содействие или поддержка.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "help_noun_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пришла неожиданная <помочь> от старого друга.",
                            "target_lang_translations": {
                                "en": "Unexpected <help> came from an old friend.",
                                "zh": "老朋友给了意想不到的<w>帮助</w>。"
                            }
                        },
                        {
                            "text": "Бог тебе в <помочь> в твоём нелёгком деле.",
                            "target_lang_translations": {
                                "en": "God <help> you in your difficult task.",
                                "zh": "愿上天成为你的<w>帮助</w>，助你完成这件艰难的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "помощь"
                    ],
                    "common_phrases": [
                        "Бог в помочь"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Archaic form of help; assistance or support.",
                        "zh": "古旧说法，意思和“帮助”一样，指援助或支持。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "archaic or poetic usage"
                            },
                            {
                                "target_lang_word": "aid",
                                "target_lang_sense_clarification": "formal or archaic assistance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帮助",
                                "target_lang_sense_clarification": "古旧或带书面色彩的“帮助”"
                            },
                            {
                                "target_lang_word": "援助",
                                "target_lang_sense_clarification": "较正式，指援助、支援"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08dc9be2-6308-3ddd-b54a-4736b3213177",
                    "sense_definition": "Старинный обычай взаимопомощи в деревне, когда соседей приглашают для совместной срочной работы.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся деревня собралась на <помочь>, чтобы построить новый дом погорельцам.",
                            "target_lang_translations": {
                                "en": "The whole village gathered for a <working bee> to build a new house for the fire victims.",
                                "zh": "全村人都来参加这场<w>乡邻互助劳动</w>，为火灾受灾户建新房。"
                            }
                        },
                        {
                            "text": "После работы на <помочах> хозяева угощали всех работников.",
                            "target_lang_translations": {
                                "en": "After the work at the <bee>, the hosts treated all the workers.",
                                "zh": "在<w>集体帮工</w>结束后，主人招待了所有干活的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "толока"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "этнографическое"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An old village custom of mutual aid where neighbors are invited for urgent joint work.",
                        "zh": "旧时农村的一种互助习俗：邻居们被请来一起完成紧急的集体劳动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "working bee",
                                "target_lang_sense_clarification": "a gathering of neighbors to accomplish a task"
                            },
                            {
                                "target_lang_word": "communal work",
                                "target_lang_sense_clarification": "collective labor for mutual aid"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乡邻互助劳动",
                                "target_lang_sense_clarification": "旧时乡村邻里为完成急活而一起劳动的活动"
                            },
                            {
                                "target_lang_word": "集体帮工",
                                "target_lang_sense_clarification": "大家一起帮忙干活的集体劳动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}