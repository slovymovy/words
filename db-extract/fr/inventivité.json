        "fr-extract.jsonl": [
            {
                "entry_id": "f938d10a-572b-34e6-8d3c-10176b851d81",
                "word": "inventivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0b74771-2064-4d05-915d-11116578c71d",
                        "entry_id": "f938d10a-572b-34e6-8d3c-10176b851d81",
                        "tags": [
                            "plural"
                        ],
                        "form": "inventivités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                        "entry_id": "f938d10a-572b-34e6-8d3c-10176b851d81",
                        "glosses": [
                            "Capacité à inventer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3267a53e-98d9-465c-a8bc-df3c7b4b6f04",
                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                "text": "L’humour, l’inventivité, dont témoignaient les slogans et affiches d’époque, avaient cannibalisé, « bisounoursisé » toutes les effervescences browniennes d’un événement qui charria tout, le meilleur et le pire, ce que charrient toujours les torrentielles bifurcations, fussent-elles régénératrices."
                            },
                            {
                                "example_id": "6b395be0-2a9f-42e0-a32d-7b32e3a6eb6f",
                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                "text": "Le théoricien est quelqu’un qui aime jouer avec des idées, qui aime déployer son inventivité, son imagination, dans le monde des idées."
                            },
                            {
                                "example_id": "064aea2c-9d14-4e10-a577-a54a9d788743",
                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                "text": "Au-delà de l’aspect émotionnel, l’œuvre fascine par son inventivité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2135277e-8ed5-40e5-b452-12de0142b8b8",
                        "source_entry_id": "f938d10a-572b-34e6-8d3c-10176b851d81",
                        "source_sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                        "target_lang_word": "inventiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                        "entry_id": "c8c35994-0111-3bb5-996d-b15cfa5a99dd",
                                        "glosses": [
                                            "The quality of being inventive; the faculty of inventing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b017a91-77b8-4d58-b22c-4a7e0f698e46",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "Near-synonyms: resourcefulness, creativity, imagination"
                                            },
                                            {
                                                "example_id": "7c535a6e-6917-4727-9a1e-29d601cc8ed4",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "For as was the land, such was the art of it while folk yet troubled themselves about such things; it strove little to impress people either by pomp or ingenuity: not unseldom it fell into commonplace, rarely it rose into majesty; yet was it never oppressive, never a slave’s nightmare or an insolent boast: and at its best it had an inventiveness, an individuality, that grander styles have never overpassed: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c782cf-09d6-4a31-b2ef-a8ec3b7a408a",
