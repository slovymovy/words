                "senses": [
                    {
                        "sense_id": "0ff292f1-cf03-3bb1-9ddc-6a1b09964bce",
                        "entry_id": "b2fb9065-b9e5-33bb-8f12-794eec92fd8a",
                        "glosses": [
                            "fuss, bustle, scurrying, fumbling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92cc887-ce17-4c76-95a5-34f0cbad258f",
                                "sense_id": "0ff292f1-cf03-3bb1-9ddc-6a1b09964bce",
                                "text": "Тюре́мщик Родио́н до́лго отпира́л дверь Цинцинна́товой ка́меры, — не тот ключ, — всегда́шняя возня́. Дверь наконе́ц уступи́ла.",
                                "translation": "Rodion, the jailer, took a long time to unlock the door of Cincinnatus’ cell — it was the wrong key — and there was the usual fuss. At last the door yielded.",
                                "english": "Rodion, the jailer, took a long time to unlock the door of Cincinnatus’ cell — it was the wrong key — and there was the usual fuss. At last the door yielded."
                            }
                        ]
                    },
                    {
                        "sense_id": "494cab3a-c802-3583-9fa8-30b8d45d3346",
                        "entry_id": "b2fb9065-b9e5-33bb-8f12-794eec92fd8a",
                        "glosses": [
                            "trouble, bother"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8a4d5c-bb8e-4e8b-a6f7-4cbec58c471d",
                                "sense_id": "494cab3a-c802-3583-9fa8-30b8d45d3346",
                                "text": "мыши́ная возня́",
                                "translation": "petty intrigues, petty cares",
                                "english": "petty intrigues, petty cares"
                            },
                            {
                                "example_id": "927d2fe9-a21d-4171-ba8c-50c556dbf891",
                                "sense_id": "494cab3a-c802-3583-9fa8-30b8d45d3346",
                                "text": "Ник действи́тельно нужда́лся в о́тдыхе — семь дней доро́ги да ещё до́брый ме́сяц возни́ с подгото́вкой отъе́зда, прода́жей кварти́ры, отпра́вкой конте́йнера с веща́ми.",
                                "translation": "Nik indeed needed a rest — seven days on the road, in addition to a whole month's hassle with preparing for the move, selling the flat, and sending off a container of household goods.",
                                "english": "Nik indeed needed a rest — seven days on the road, in addition to a whole month's hassle with preparing for the move, selling the flat, and sending off a container of household goods."
                            }
                        ]
                    },
                    {
                        "sense_id": "76c07a73-7e2f-34c7-887e-8c02bf762baf",
                        "entry_id": "b2fb9065-b9e5-33bb-8f12-794eec92fd8a",
                        "glosses": [
                            "noise, racket, romp, roughhousing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b241ce6-970f-4da6-8af5-5844487b5f1e",
                                "sense_id": "76c07a73-7e2f-34c7-887e-8c02bf762baf",
                                "text": "По ноча́м он носи́лся с зажжёнными фа́рами ми́мо окре́стных рощ, слы́ша позади́ себя́ пья́ную возню́ и во́пли пассажи́ров, а днём, одуре́в от бессо́нницы, сиде́л у сле́дователей и дава́л свиде́тельские показа́ния.",
                                "translation": "At night he'd be speeding with the headlights ablaze past nearby woods, listening to drunken racket and howls from the passengers in back, and by day, in a stupor from sleeplessness, he'd be sitting in the investigators' office giving testimony.",
                                "english": "At night he'd be speeding with the headlights ablaze past nearby woods, listening to drunken racket and howls from the passengers in back, and by day, in a stupor from sleeplessness, he'd be sitting in the investigators' office giving testimony."
                            }
                        ]
                    }
                ],
