                "senses": [
                    {
                        "sense_id": "7bec3f8c-9c68-3cf0-a436-f5614302e4f1",
                        "entry_id": "291b16ab-4734-3ba4-a79f-264a023f3b28",
                        "glosses": [
                            "rzecz. odczas. od szczytować"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a59bbe0-175c-458b-a24c-083951e861e5",
                                "sense_id": "7bec3f8c-9c68-3cf0-a436-f5614302e4f1",
                                "text": "Niech herosi pobożności cię poganiają, niech kumple się śmieją, żeś dewot, a ty spaceruj po swojej Krynicy z kubkiem w ręku, to znacznie skuteczniejsze niż sinusoida: szczytowanie – zawał – szczytowanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "daf79e50-43eb-3c8d-86a9-836393d7fb71",
                        "entry_id": "291b16ab-4734-3ba4-a79f-264a023f3b28",
                        "glosses": [
                            "przeżywanie orgazmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983f92c0-cfcb-4e0a-89e3-480795b409e4",
                                "sense_id": "daf79e50-43eb-3c8d-86a9-836393d7fb71",
                                "text": "Wspólne szczytowanie było wyrafinowaną muzyką, którą współtworzyli. Kiedy skończyli położyli się na łyżeczkę. Przytulił ją mocno do siebie. Florencja czuła się, jakby ich akt cały czas trwał. Wydała z siebie kilka rozmarzonych westchnień."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
