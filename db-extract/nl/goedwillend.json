                "senses": [
                    {
                        "sense_id": "a234bd78-556a-3a98-9968-f6faf33e1a9f",
                        "entry_id": "7fcfc924-5b76-3914-83ef-4d92280b0ba0",
                        "glosses": [
                            "met een positieve houding, met de intentie behulpzaam te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea18e163-c537-4a7e-8b3d-0810f0dd51ce",
                                "sense_id": "a234bd78-556a-3a98-9968-f6faf33e1a9f",
                                "text": "In commentaren wordt wel gewezen op dit leidmotief: hoe een in principe goedwillend persoon verblind kan raken en met oprechte bedoelingen toch een verkeerde keuze kan maken."
                            },
                            {
                                "example_id": "8f2900bb-c431-4f22-868f-f8f3a554d297",
                                "sense_id": "a234bd78-556a-3a98-9968-f6faf33e1a9f",
                                "text": "Kindleberger, een beminnelijk en goedwillend man, wilde niet inzien dat de wereld een redder nooit dankbaar is."
                            },
                            {
                                "example_id": "2351e809-165c-49ba-8306-1eefddc87111",
                                "sense_id": "a234bd78-556a-3a98-9968-f6faf33e1a9f",
                                "text": "Een kenmerk van beschaving, vind ik, om ook goedwillend tegenover vreemdelingen te staan."
                            }
                        ]
                    }
                ],
