                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multidimensional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7156cfc-e2d7-382d-90a8-3190a1d31d99",
                                        "entry_id": "4e99bab2-ea44-3887-9d75-fe9d50b211d6",
                                        "glosses": [
                                            "Having multiple dimensions (aspects)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706e841c-42c7-4903-b390-0a851dff817a",
                                                "sense_id": "d7156cfc-e2d7-382d-90a8-3190a1d31d99",
                                                "text": "Rosa's whole life as a revolutionary, as a theoretician, as a multidimensional woman, was so preoccupied with the spontaneity of revolution […]"
                                            },
                                            {
                                                "example_id": "7ca643b8-9923-496d-a6c3-03e4200f8014",
                                                "sense_id": "d7156cfc-e2d7-382d-90a8-3190a1d31d99",
                                                "text": "Even for El’s supportive parents, conceiving of gender as a multidimensional sprawl has not been so easy to grasp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310e80fb-4d10-30a6-8ad3-d109137ec205",
                                        "entry_id": "4e99bab2-ea44-3887-9d75-fe9d50b211d6",
                                        "glosses": [
                                            "Having multiple dimensions (aspects).",
                                            "Having more than two dimensions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45148952-f59e-32e7-8180-4932dc1fd0ac",
                                        "entry_id": "4e99bab2-ea44-3887-9d75-fe9d50b211d6",
                                        "glosses": [
                                            "Crossing through or existing in multiple dimensions (spacial planes)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b28f86-9a3e-4699-a37b-ced3ffe31cea",
                                                "sense_id": "45148952-f59e-32e7-8180-4932dc1fd0ac",
                                                "text": "The Cosmic Woman is an integrated, multidimensional woman who has crossed both the Zodiacal and cosmic planes."
                                            }
                                        ]
                                    }
                                ]
                            },
