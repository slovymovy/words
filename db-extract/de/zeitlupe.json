                    {
                        "translation_id": "2a360ecf-96ff-4d1f-9e74-45d816298d45",
                        "source_entry_id": "8d3f4893-e81a-3b67-b0be-8201fe69cbef",
                        "source_sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                        "source_sense_description": "verlangsamte Darstellung einer Filmsequenz",
                        "target_lang_word": "slow motion",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slow motion",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1fa192-0806-3195-b47b-5216d30279bd",
                                        "entry_id": "a222f3bb-ad2e-3b58-bb0f-ab8ce65bde3d",
                                        "glosses": [
                                            "een film die vertraagd wordt afgespeeld, een film die met hoge snelheid wordt opgenomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "911f3be2-7748-46af-8afb-32fc16f181d7",
                                                "sense_id": "ef1fa192-0806-3195-b47b-5216d30279bd",
                                                "text": "Een vlucht flamingo's , een miljoen tegelijk die neerstrijken op een meer, dat beeld, van de televisie, met opspattend water en in slow motion die vleugels en die poten en dat ze allemaal keurig landen en elkaar niet in de weg zitten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c9f633-4d11-3e0b-8145-5f2534381e1d",
                                        "entry_id": "a222f3bb-ad2e-3b58-bb0f-ab8ce65bde3d",
                                        "glosses": [
                                            "met een heel lage snelheid; in een langzaam tempo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a84cee-fc34-46ab-8007-1d9aad2a8747",
                                                "sense_id": "a9c9f633-4d11-3e0b-8145-5f2534381e1d",
                                                "text": "‘Snelheid is relatief. In topvorm zie ik alles heel helder en lijkt elke bocht of obstakel in slow motion op mij af te komen. Pas als ik niet topvorm ben, komt alles in rotvaart op mij af en lijk ik de zaken niet onder controle te hebben’"
                                            },
                                            {
                                                "example_id": "26a09025-a779-4670-860f-32f2ab4415c9",
                                                "sense_id": "a9c9f633-4d11-3e0b-8145-5f2534381e1d",
                                                "text": "\"Wij stonden voor het raam naar het onweer te kijken en we zien de boom heen en weer gaan\", zegt ze tegen Omroep Brabant. Opeens kwam de lindeboom haar kant op. \"Het leek wel slowmotion. We zijn snel naar de achterkant van het huis gelopen, want je weet niet hoe ver hij komt als hij op het huis valt. Het was heel heftig.\""
                                            },
                                            {
                                                "example_id": "d3046e6d-2e35-442a-8aa6-310731371eab",
                                                "sense_id": "a9c9f633-4d11-3e0b-8145-5f2534381e1d",
                                                "text": "Ze waren deze keer alleen in de langzame lift en ze sloeg rustig haar armen om hem heen en kuste hem als in slow motion tot de lift met een ruk en kort gepiep tot stilstand kwam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1afed23-574d-4995-8fa0-36cd4a920954",
