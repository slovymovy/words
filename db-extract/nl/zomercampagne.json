                            {
                                "example_id": "90845b39-2932-4065-b2a8-f3cbd86a78b2",
                                "sense_id": "0b279e79-e402-351a-bff8-267c44cee006",
                                "text": "Salou was doelwit van de jaarlijkse 'zomercampagne' van de Baskische terreurbeweging ETA, die de belangrijkste motor van de Spaanse economie, het toerisme, wilde doen haperen."
                            },
                            {
                                "example_id": "f3ec25b5-c57d-4915-b89a-359a7dd4499f",
                                "sense_id": "0b279e79-e402-351a-bff8-267c44cee006",
                                "text": "De zomerlijn van H&M bestaat onder andere uit naveltruien, korte spijkerbroeken, sneakers en felgekleurde badpakken. Doutzen is niet het eerste bekende model die haar naam verleent aan H&M. De foto's van Beyoncés zomercampagne werden vorige maand al gepubliceerd."
                            },
                            {
                                "example_id": "b9d00797-ae67-4ff8-94f9-067ce442d388",
                                "sense_id": "0b279e79-e402-351a-bff8-267c44cee006",
                                "text": "Toen Adut Akech een paar jaar geleden het gezicht werd van de David Jones-zomercampagne en op de cover van de catalogus kwam te staan, belandde ze ongewild in een kleine storm."
                            }
                        ]
