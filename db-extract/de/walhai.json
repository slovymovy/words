                                        "glosses": [
                                            "A very large spotted shark, Rhincodon typus, of warm marine waters, similar to a whale, that feeds by filtering plankton from the water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b6f852-84d3-4469-a048-cc7930ade66e",
                                                "sense_id": "d9688884-80b4-3a1f-8024-199ace124766",
                                                "text": "The largest fish in the world is a shark. It is a harmless plankton eater, and its name, whale shark has been confusing people for years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
