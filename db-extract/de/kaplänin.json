                "senses": [
                    {
                        "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                        "entry_id": "01e45ade-c0ed-3865-8e57-0d21ce99033f",
                        "glosses": [
                            "leitende Ordensschwester oder (hypothetische) Geistliche, die einer Oberin beziehungsweise einem Pfarrer zugeordnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217a63c7-3280-49b5-a5f9-cf0c76e5698f",
                                "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                                "text": "„Die hier aufgeworfenen Fragen scheinen eine Reaktion auf die dominante Stelle der Kaplänin zu sein, denn aus den Protokollen und der Frage 10 an den Beichtvater ergibt sich, ›daß die Frau Kaplänin allein die Klosterfrauen beherrsche und den Mitschwestern sehr viel Verdruß mache‹.“"
                            },
                            {
                                "example_id": "6de64024-7a8e-4abd-988d-d11793f35a74",
                                "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                                "text": "„Meine Söhne werden jetzt nicht auf einmal ihre Sonntagspflicht erfüllen, nur weil sie dort von einer verständnisvollen Kaplänin bemuttert werden.“"
                            },
                            {
                                "example_id": "ed703dc3-0a07-482a-9f86-c58b5c8e8e03",
                                "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                                "text": "„In Goch am Niederrhein der Diözese hat sich jetzt eine lutherische Pastorin als ‚Kaplänin‘ geoutet (so dortiger Pfarrbrief). Offensichtlich will sich die Pastorin ökumenisch an die katholische Kirche heranschleichen.“"
                            },
                            {
                                "example_id": "d0b80c8a-2ef9-452a-ab33-3fc3f28a3a98",
                                "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                                "text": "„Sue Ann Morrow, methodistische Kaplänin an der Princeton University, zelebrierte in einer Universitätskapelle eine ›Trauung‹ zweier Homosexueller, die zudem bekennende Atheisten waren, und sagte öffentlich, sie wolle auch in Zukunft gleichgeschlechtliche Paare trauen.“"
                            },
                            {
                                "example_id": "ae46986d-b2b8-4d45-ab28-8ca963053112",
                                "sense_id": "7f271bb8-e0b3-3b5f-9c33-8d0a8a6788da",
                                "text": "„Ansonsten speiste sie in der Abtei, zusammen mit der Kastnerin, der Kaplänin und der Köchin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
