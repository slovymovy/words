                "senses": [
                    {
                        "sense_id": "5014b7d7-12a8-34ee-acab-468a749726f8",
                        "entry_id": "dc9f12b1-ea9f-3a51-a6d0-2d4bfaa2d21a",
                        "glosses": [
                            "das im Zuge der nachnapoleonischen Neuordnung Europas auf dem Wiener Kongress geschaffene Königreich Polen als Gliedstaat des Russischen Reiches"
                        ],
                        "tags": [
                            "colloquial",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5780182a-2fcb-4842-85c4-ce36f2e37cd7",
                                "sense_id": "5014b7d7-12a8-34ee-acab-468a749726f8",
                                "text": "„Zwar war die Verfassung Kongresspolens nach dem polnischen Novemberaufstand von 1830/31 suspendiert worden und hatte Nikolaus I. den Ausnahmezustand in den rebellischen Provinzen auf Permanenz gestellt. An der grundlegenden administrativen und rechtlichen Sonderstellung des Königreichs änderte dies jedoch wenig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
