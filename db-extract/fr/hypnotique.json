        "fr-extract.jsonl": [
            {
                "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                "word": "hypnotique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a0f59bda-5ddc-4af3-bbbc-6f54abd6eacf",
                        "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "hypnotiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85c7038f-e33c-3a0b-87ed-cc8c92f5e83c",
                        "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                        "glosses": [
                            "Qui provoque le sommeil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                        "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                        "glosses": [
                            "Qui se rapporte à l’hypnose et à l’hypnotisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d177032-de00-4e7b-96e9-fcc0a93082e4",
                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                "text": "La voix du vieillard avait quelque chose d'hypnotique."
                            },
                            {
                                "example_id": "703e1940-5365-49f6-af0d-f926f1974e65",
                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                "text": "Pour autant, il n'y a pas de signes physiologiques objectifs (fréquence respiratoire, tension artérielle, rythme cardiaque...) de l'état hypnotique ni de critères objectifs sur l'électroencéphalogramme (EEG)."
                            },
                            {
                                "example_id": "b75fc225-1421-40b2-af36-889edbd3451f",
                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                "text": "Nous traversons, plusieurs fois par jour, des épisodes de dissociation spontanée, hypnose naturelle, qui possède une fonction « salvatrice », moments de rêverie spontanée : école, réunion ennuyeuse, voyage en train, émission ou film à la télévision, moment qui permet de se ressourcer, mais de s’évader aussi d’une mémoire traumatique envahissante, qui resurgit avec les émotions, notamment les « flashback », diurnes et nocturnes. Ces épisodes de dissociation spontanée sont autant d’états hypnotiques qui permettent au sujet de suspendre provisoirement la souffrance."
                            },
                            {
                                "example_id": "8f06d510-0d80-429e-bc4d-28be7094c631",
                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                "text": "Suggestion, sommeil, sujet hypnotique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d986cd-6933-4702-b036-87e51c32b802",
                        "source_entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                        "target_lang_word": "hypnotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypnotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c060d0-7cdb-3c5f-ad0a-74c91446e00e",
                                        "entry_id": "e1d8aeb6-98d2-3501-b06b-4457296a225b",
                                        "glosses": [
                                            "auf Hypnose beruhend, durch Hypnose herbeigeführt: auf jemanden einschläfernd wirkend, besonders durch regelmäßige Bewegungen oder Geräusche"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                        "entry_id": "e1d8aeb6-98d2-3501-b06b-4457296a225b",
                                        "glosses": [
                                            "wie unter einem fremden Zwang stehend: willenlos, widerstandslos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44bcdf46-06cd-4c95-a65a-18885e5024e7",
                                                "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                                "text": "„Seine Augen wirkten geradezu hypnotisch auf mich! Ich musste ihn immerzu anschauen.“"
                                            },
                                            {
                                                "example_id": "9de11cef-2c24-4f08-a2c3-ba18b23a6782",
                                                "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                                "text": "Die Flöte untermalt mit hypnotischen Klängen kultische Rituale der Naturvölker […]."
                                            },
                                            {
                                                "example_id": "2782aa0b-c438-4abe-ad3a-38474d47c67e",
                                                "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                                "text": "Ihre [der Band Red Baraat] Musik ist schweißtreibend und hypnotisch."
                                            },
                                            {
                                                "example_id": "a850b146-373c-4847-b5b0-257b0a0161f9",
                                                "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                                "text": "Zar Nikolai war beeindruckt von diesem hageren Mann [Grigori Rasputin] mit dem verwahrlosten, struppigen Bart und den eindringlichen, als \"hypnotisch\" beschriebenen Augen."
                                            },
                                            {
                                                "example_id": "951bfcd3-1228-4342-bf5a-f24949ad2164",
                                                "sense_id": "d3f9a20b-3b3f-3c83-b5f9-522521030eca",
                                                "text": "Wir sind der Künstlerin mit der hypnotischen Aura in New York begegnet […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
