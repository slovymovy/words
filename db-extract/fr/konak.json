                                        "entry_id": "1cb1728e-fccf-36c2-a623-6f7cbfc26ebd",
                                        "glosses": [
                                            "A palace or other large official residence in Turkey or the Ottoman Empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb6404c-558b-4448-ba3d-2413a66cb5d8",
                                                "sense_id": "ec73f827-b517-30e3-87f7-fef67d16c724",
                                                "text": "It was a small pretty town with four minarets and one campanile and the Pasha's konak sprawling across the foothills."
                                            }
                                        ]
                                    }
                                ]
