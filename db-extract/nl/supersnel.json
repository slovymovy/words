                        "sense_id": "b5d30f3d-be1e-3dbc-8e6c-affa89f2ff86",
                        "entry_id": "7c1f4669-9069-3fe6-924b-e0d87d51c690",
                        "glosses": [
                            "met heel grote vaart, in uitermate hoog tempo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88545d6c-4aea-438d-a0f7-e7c5bd0eb569",
                                "sense_id": "b5d30f3d-be1e-3dbc-8e6c-affa89f2ff86",
                                "text": "Supersnelle verbindingen spelen nog steeds een grote rol, maar vooral ook allerlei pogingen om het toekomstige koersverloop op de een of andere manier te voorzien."
                            },
                            {
                                "example_id": "7b67b1c2-a15c-4455-a84a-b399ed30abb1",
                                "sense_id": "b5d30f3d-be1e-3dbc-8e6c-affa89f2ff86",
                                "text": ". Niet supersnel, maar snel genoeg om geluidsbestanden te kunnen mailen. Ze kon correspondent worden voor een van de nationale radiostations, die nauwelijks mensen in het gebied hadden, wat stom en kortzichtig was, want in de Limousin gebeurde genoeg."
                            },
                            {
                                "example_id": "02009e7a-5528-458b-9cae-5e9f7ebfdb51",
                                "sense_id": "b5d30f3d-be1e-3dbc-8e6c-affa89f2ff86",
                                "text": "Tijdens de tweede snelle run reed Sebastian Vettel een supersnel rondje, waarmee de Duitser zijn Ferrari naar een nieuwe ronderecord stuurde. De Duitser was 86 duizendsten sneller dan Max Verstappen die dus als tweede eindigde."
                            }
                        ]
                    }
