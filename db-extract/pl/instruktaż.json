                            {
                                "example_id": "3d713405-eb5d-409c-b3c9-c4a1eed1a7ef",
                                "sense_id": "65a32fa0-8e8d-37ac-8b82-8c632bd99a9e",
                                "text": "Stewardesy przeprowadziły krótki instruktaż na temat zachowania się w przypadku awarii"
