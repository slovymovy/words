                "entry_id": "fe7ddaff-c1fa-3d47-92c7-c431ee1f5e62",
                "word": "Nancy",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e498cdaf-2526-441f-9006-3f0166e18bf0",
                        "entry_id": "fe7ddaff-c1fa-3d47-92c7-c431ee1f5e62",
                        "tags": [
