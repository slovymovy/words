                                    {
                                        "sense_id": "70af923a-e250-3af8-8dd9-3943c3642de3",
                                        "entry_id": "0a4892aa-b7b0-3b2e-94e1-4cf7a3117a8e",
                                        "glosses": [
                                            "All the pundits and commentators of the news media collectively."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c520c7ac-f3a4-40a4-831d-0f8162f9a710",
                                                "sense_id": "70af923a-e250-3af8-8dd9-3943c3642de3",
                                                "text": "From Boston, a man who finally joined the commentariat by making his debut on CNBC’s Hardball, Esquire Magazine writer-at-large, Charlie Pierce!"
                                            },
                                            {
                                                "example_id": "79c02e55-59b0-41ea-a6be-764346be021e",
                                                "sense_id": "70af923a-e250-3af8-8dd9-3943c3642de3",
                                                "text": "The world, of course, is seen by the commentariat as a side issue, yet another diversion from his real work, which is to answer whatever questions they see fit to pose."
                                            },
                                            {
                                                "example_id": "1ef37606-4efd-4d04-a60a-3895f2202a72",
                                                "sense_id": "70af923a-e250-3af8-8dd9-3943c3642de3",
                                                "text": "As the dust settles on the Supreme Court’s cataclysmically destabilizing term, a very persistent question has bubbled up among the law professor commentariat: How the hell are we going to teach all this?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
