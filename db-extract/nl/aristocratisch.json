                                "sense_id": "4b5fb5b0-2b6f-3b50-83ad-8847b9a63305",
                                "text": "Het landhuis was ingericht in een aristocratische stijl.",
                                "translation": "The mansion was decorated in an aristocratic style.",
                                "english": "The mansion was decorated in an aristocratic style."
                            },
                            {
                                "example_id": "e4854931-9e0d-4a70-bf82-45421849b52b",
                                "sense_id": "4b5fb5b0-2b6f-3b50-83ad-8847b9a63305",
                                "text": "Zijn aristocratische afkomst was duidelijk in zijn manieren en spraak.",
                                "translation": "His aristocratic lineage was evident in his manners and speech.",
