                "senses": [
                    {
                        "sense_id": "a4b61c93-b7b5-3303-b28e-e8efd3811736",
                        "entry_id": "c6ab5745-b416-34c6-aa35-d44a24eae288",
                        "glosses": [
                            "Travailler un peu seulement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4beacaa5-9ba9-4545-a9d7-58fecd14fe67",
                                "sense_id": "a4b61c93-b7b5-3303-b28e-e8efd3811736",
                                "text": "Il lisotait, travaillotait, écrivotait, observotait, synthéticotait, transcendentalisotait, jusqu’au déjeuner, recommençait jusqu’au dîner ; puis il s’allait coucher et dormait d’un profond sommeil."
                            },
                            {
                                "example_id": "65ddc13b-cb7e-44c2-9196-2819f685d8e0",
                                "sense_id": "a4b61c93-b7b5-3303-b28e-e8efd3811736",
                                "text": "Je lorulote, je débagote, Je fais quatre repas, Je gorenflote, je travaillote, Je pisse sur mes bottes"
                            }
                        ]
                    }
                ],
