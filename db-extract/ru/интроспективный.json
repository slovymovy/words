                    },
                    {
                        "translation_id": "11c13ca5-bc2c-4248-b967-53d91df2da2e",
                        "source_entry_id": "53b52d0c-9bd3-38f8-aaa9-7daf836c296a",
                        "target_lang_word": "introspettivo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introspettivo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbdf66f-4962-36a8-9bf8-62bda51d3f70",
                                        "entry_id": "1ecca581-781f-3cfb-9cd7-4ee90b37248e",
                                        "glosses": [
                                            "che riguarda l'introspezione"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8f36ad-9247-4023-b3c9-3da06a970b58",
                                                "sense_id": "0fbdf66f-4962-36a8-9bf8-62bda51d3f70",
                                                "text": "”Sofferenza per auto-analisi introspettiva? Di certo peggio il dolore fisico… ma di entrambi si potrebbe morire spontaneamente!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c3d84a0-cd3c-4bf9-b333-b3ef04728d0d",
                        "source_entry_id": "53b52d0c-9bd3-38f8-aaa9-7daf836c296a",
                        "target_lang_word": "introspektiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introspektiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d3786e-3a8b-3dc8-ae45-48814ea25523",
                                        "entry_id": "7eb03cd5-80a2-3e33-976e-c531113ce163",
                                        "glosses": [
                                            "in sich hineinblickend; sich selbst bzw. seine eigene Handlungsweise beobachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4652d692-6f6a-4e4d-95aa-99780498bad3",
                                                "sense_id": "a2d3786e-3a8b-3dc8-ae45-48814ea25523",
                                                "text": "Es war eine introspektive Erkenntnis."
                                            },
                                            {
                                                "example_id": "87224940-ff9d-4f0b-9259-d1f1bfb01ec6",
                                                "sense_id": "a2d3786e-3a8b-3dc8-ae45-48814ea25523",
                                                "text": "„Erwachsene, die sich ihre eidetische Begabung erhalten haben, können gelegentlich über ihre eidetische Begabung introspektiv Aufschlüsse geben, die man dann zur kindlichen Eidetik in Analogie bringen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e523294-6365-49ee-a048-2e04d3fed03d",
                        "source_entry_id": "53b52d0c-9bd3-38f8-aaa9-7daf836c296a",
