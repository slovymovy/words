                "senses": [
                    {
                        "sense_id": "91a66b7d-ba72-304e-acf3-3197cea38798",
                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                        "glosses": [
                            "Turned or thrust inward",
                            "Thinking about internal or spiritual matters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90e409d-226c-46a6-ad93-7567df3d8055",
                                "sense_id": "91a66b7d-ba72-304e-acf3-3197cea38798",
                                "text": "...Self-searching with an introverted eye..."
                            }
                        ]
                    },
                    {
                        "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                        "glosses": [
                            "Turned or thrust inward",
                            "Of or characteristic of the personality of an introvert: thoughtful, reflective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c0d6ed-b3a0-497e-b83b-f24d663155b6",
                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                "text": "An extraverted individual can hardly understand the necessity that forces the introverted to accomplish his adaptation by first formulating a general conception."
                            },
                            {
                                "example_id": "99cb6450-6b3a-4fc6-bf97-fd490977147e",
                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                "text": "The introverted type is characterised by the fact that his libido is turned towards his own personality to a certain extent."
                            },
                            {
                                "example_id": "2a8eae35-5ed3-48ab-94af-9726266a8fbe",
                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                "text": "There is a tendency to equate ‘introverted’ with ‘withdrawn’ or ‘schizoid’."
                            },
                            {
                                "example_id": "7a77e2d7-5049-412d-9853-a73e42f0a2b6",
                                "sense_id": "61f869b5-2a26-3a4d-af8c-40b19ffb801b",
                                "text": "This subtle but important distinction means otroverts can blend into both introverted and extroverted environments without fully belonging to either."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bfffa25-9a89-3913-881c-54c6977cb2d7",
                        "entry_id": "0573ff2b-df70-33e5-b42f-9f410847e4a5",
                        "glosses": [
                            "Turned or thrust inward",
                            "Arranged so that two similar words, lines, etc. form the middle of the structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b75a9e-ab52-4cc0-844c-32269e85cb56",
                                "sense_id": "2bfffa25-9a89-3913-881c-54c6977cb2d7",
                                "text": "In the Quatrain Reversed or Introverted, the first line corresponds with the fourth."
                            }
                        ]
                    }
                ],
                "translations": [
