                        "form": "die Kulturschocke"
                    },
                    {
                        "form_id": "f3cd9c3e-228c-4905-8295-1f75854f0360",
                        "entry_id": "1baa5621-0a1d-3960-a34c-1fb05e4ebcaf",
                        "tags": [
                            "accusative",
