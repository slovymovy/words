{
    "word_family": [
        "countenancer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68819d90-95df-3dac-8604-2e26cac494f7",
                    "sense_definition": "The appearance or expression of a person's face.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facial_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a kind <w>countenance</w> that made everyone feel welcome.",
                            "target_lang_translations": {
                                "de": "Er hatte einen freundlichen <w>Gesichtsausdruck</w>, durch den sich jeder willkommen fühlte."
                            }
                        },
                        {
                            "text": "Her <w>countenance</w> changed from joy to sadness when she heard the news.",
                            "target_lang_translations": {
                                "de": "Ihre <w>Miene</w> wandelte sich von Freude zu Trauer, als sie die Nachricht hörte."
                            }
                        }
                    ],
                    "synonyms": [
                        "face",
                        "visage",
                        "physiognomy"
                    ],
                    "common_phrases": [
                        "stern countenance",
                        "cheerful countenance"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Aussehen, der Ausdruck oder die Züge des menschlichen Gesichts."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gesichtsausdruck",
                                "target_lang_sense_clarification": "momentane Mimik oder Ausdruck"
                            },
                            {
                                "target_lang_word": "Miene",
                                "target_lang_sense_clarification": "Gesichtsausdruck"
                            },
                            {
                                "target_lang_word": "Antlitz",
                                "target_lang_sense_clarification": "gehoben oder literarisch für Gesicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2f2366-4ef3-3cc5-85bc-51bad4f78e44",
                    "sense_definition": "A calm and composed facial expression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She maintained a calm <w>countenance</w> despite the chaos around her.",
                            "target_lang_translations": {
                                "de": "Sie bewahrte trotz des Chaos um sie herum die <w>Fassung</w>."
                            }
                        },
                        {
                            "text": "He kept a steady <w>countenance</w> while delivering the difficult speech.",
                            "target_lang_translations": {
                                "de": "Er wahrte eine ruhige <w>Haltung</w>, während er die schwierige Rede hielt."
                            }
                        }
                    ],
                    "synonyms": [
                        "look"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein ruhiger, beherrschter Gesichtsausdruck; das Wahren der Selbstbeherrschung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fassung",
                                "target_lang_sense_clarification": "Selbstbeherrschung"
                            },
                            {
                                "target_lang_word": "Contenance",
                                "target_lang_sense_clarification": "Haltung, Beherrschtheit in schwierigen Situationen"
                            },
                            {
                                "target_lang_word": "Haltung",
                                "target_lang_sense_clarification": "Beherrschtheit, gefasstes Auftreten"
                            },
                            {
                                "target_lang_word": "Ruhe",
                                "target_lang_sense_clarification": "Gelassenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341aa6cd-ecf5-3cdd-9f25-c3a003feb118",
                    "sense_definition": "Approval, support, or encouragement given to someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project received the <w>countenance</w> of the local authorities.",
                            "target_lang_translations": {
                                "de": "Das Projekt erhielt die <w>Unterstützung</w> der örtlichen Behörden."
                            }
                        },
                        {
                            "text": "They sought the <w>countenance</w> of the board to proceed with the plan.",
                            "target_lang_translations": {
                                "de": "Sie baten um die <w>Zustimmung</w> des Vorstands, um mit dem Plan fortzufahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "support"
                    ],
                    "target_lang_definitions": {
                        "de": "Zustimmung, Unterstützung oder Förderung einer Person oder Sache."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Unterstützung",
                                "target_lang_sense_clarification": "Hilfe, Beistand"
                            },
                            {
                                "target_lang_word": "Zustimmung",
                                "target_lang_sense_clarification": "Billigung, Befürwortung"
                            },
                            {
                                "target_lang_word": "Billigung",
                                "target_lang_sense_clarification": "Gutheißung, Genehmigung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4115cc5-4df0-3f03-bba6-a831099d4d69",
                    "sense_definition": "A superficial appearance or pretense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>countenance</w> of agreement while secretly disagreeing.",
                            "target_lang_translations": {
                                "de": "Er erweckte den <w>Anschein</w> von Zustimmung, während er insgeheim dagegen war."
                            }
                        },
                        {
                            "text": "The false <w>countenance</w> of peace could not hide the underlying tension.",
                            "target_lang_translations": {
                                "de": "Der trügerische <w>Schein</w> von Frieden konnte die unterschwelligen Spannungen nicht verbergen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein oberflächlicher oder trügerischer Anschein; Vortäuschung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Anschein",
                                "target_lang_sense_clarification": "äußerer Schein, Vorspiegelung"
                            },
                            {
                                "target_lang_word": "Schein",
                                "target_lang_sense_clarification": "Täuschung, Fassade"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06dec2b6-d459-34d2-bda0-365212fd0c0d",
                    "sense_definition": "To tolerate, support, or approve of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school will not <w>countenance</w> any form of bullying.",
                            "target_lang_translations": {
                                "de": "Die Schule wird keinerlei Mobbing <w>dulden</w>."
                            }
                        },
                        {
                            "text": "The committee refused to <w>countenance</w> the proposed changes to the rules.",
                            "target_lang_translations": {
                                "de": "Der Ausschuss weigerte sich, die vorgeschlagenen Regeländerungen zu <w>billigen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "approve",
                        "sanction",
                        "support",
                        "tolerate"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas gutheißen, befürworten oder dulden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "billigen",
                                "target_lang_sense_clarification": "befürworten, gutheißen"
                            },
                            {
                                "target_lang_word": "dulden",
                                "target_lang_sense_clarification": "hinnehmen, tolerieren"
                            },
                            {
                                "target_lang_word": "gutheißen",
                                "target_lang_sense_clarification": "Zustimmung erteilen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
