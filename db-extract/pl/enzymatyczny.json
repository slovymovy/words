                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enzymatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34f9f4fa-6bc1-300e-bae9-77108b8e13d8",
                                        "entry_id": "b8e89f71-34dc-3530-9d48-0b7ffe9a0f99",
                                        "glosses": [
                                            "Relatif aux enzymes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "489040bb-bac5-4e0b-982b-5cfaf324dc02",
                                                "sense_id": "34f9f4fa-6bc1-300e-bae9-77108b8e13d8",
                                                "text": "L’acétylcholine n'est qu'un maillon d'une chaîne métabolitique où interviennent divers systèmes enzymatiques sur lesquels les insecticides peuvent aussi agir."
                                            },
                                            {
                                                "example_id": "0d750a10-fa66-493b-86db-72aca36eb053",
                                                "sense_id": "34f9f4fa-6bc1-300e-bae9-77108b8e13d8",
                                                "text": "La molécule mise au point par des chercheurs du Laboratoire de chimie de coordination du centre français de la recherche scientifique et des universités chinoises de Guangdong et Shenzhen a réussi à extraire le cuivre piégé dans les plaques amyloïdes et à le réintroduire dans le circuit enzymatique normal du cerveau."
                                            },
                                            {
                                                "example_id": "43bf05bb-66bb-4a1e-ab8d-0dbd842e04b3",
                                                "sense_id": "34f9f4fa-6bc1-300e-bae9-77108b8e13d8",
                                                "text": "D’autres disposent d’urnes, d’outres avec ou sans clapet, au fond desquelles les insectes sont piégés par des liquides résineux ou enzymatiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
