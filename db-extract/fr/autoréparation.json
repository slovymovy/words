                        "glosses": [
                            "Pratique qui consiste à effectuer des réparations soi-même plutôt que de les faire faire par un spécialiste ou un professionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522d1e6b-3ecb-48b2-a3cd-80be2b8d8e40",
                                "sense_id": "5f46e44b-e29a-334c-91ff-f0b549e9cdd3",
                                "text": "L'autoréparation est une pratique qui consiste à effectuer des réparations par soi-même. C'est une compétence participant à la vélonomie."
                            }
                        ]
                    }
