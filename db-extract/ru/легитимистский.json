                                    {
                                        "sense_id": "99d85b9b-0d57-31f1-97ab-4ecec4ff5200",
                                        "entry_id": "464839a4-3b86-3bbb-bcfc-0c2cb2525e50",
                                        "glosses": [
                                            "A French royalist who believes that the King of France and Navarre must be chosen according to the simple application of the Salic law."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72ede8b8-58d9-49c6-b84e-af57a4a91fb4",
                                                "sense_id": "99d85b9b-0d57-31f1-97ab-4ecec4ff5200",
                                                "text": "Nor does he beat around the bush: Tocqueville’s cousin and confidant Louis de Kergorlay is “a young idiot” and the legitimist insurrectionist the Duchesse de Berry “one of the silliest princesses in all European history.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee928a3-49c0-38d3-a648-7534ebf667a5",
                                        "entry_id": "464839a4-3b86-3bbb-bcfc-0c2cb2525e50",
                                        "glosses": [
                                            "A Carlist"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccc9f4b2-16ba-3a63-a1d2-6833dc72d1cf",
                                        "entry_id": "464839a4-3b86-3bbb-bcfc-0c2cb2525e50",
                                        "glosses": [
                                            "Any proponent for the rule of a legitimate sovereign."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
