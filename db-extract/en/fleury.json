                                                "sense_id": "a4bde06d-ee53-36a2-8ce3-39eb6b6c41c7",
                                                "text": "Il adressait des remerciements à Anthony Fleury, éducateur et à Serge Méchaussie, tout en étant à la recherche de nouveaux éducateurs…"
                                            },
                                            {
                                                "example_id": "7183b5ed-6028-448e-8776-e5a858d47b31",
                                                "sense_id": "a4bde06d-ee53-36a2-8ce3-39eb6b6c41c7",
                                                "text": "L’animateur Augustin Trapenard accueille, entre autres, Pascal Quignard, Cynthia Fleury, Jean-Baptiste Andrea, et Maria Pourchet, pour son livre Western."
                                            }
                                        ]
                                    }
