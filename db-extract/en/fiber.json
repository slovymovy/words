        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                "word": "fiber",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5ef2e30a-c8fd-4ddc-b4c3-a459b7e4366e",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "tags": [
                            "plural"
                        ],
                        "form": "fibers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9bac210-49fa-3835-a111-5e58a7ea5875",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "A single elongated piece of a given material, roughly round in cross-section, often twisted with other fibers to form thread."
                        ],
                        "tags": [
                            "US",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "91907296-c139-442e-add6-52d18df96950",
                                "sense_id": "f9bac210-49fa-3835-a111-5e58a7ea5875",
                                "text": "The microscope showed a single blue fiber stuck to the sole of the shoe."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba85f8a7-79ea-3eac-8a82-f90cdc80a98f",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "A material in the form of fibers."
                        ],
                        "tags": [
                            "US",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2d41b4f2-dd4c-4f8f-8f11-0dbe08c01790",
                                "sense_id": "ba85f8a7-79ea-3eac-8a82-f90cdc80a98f",
                                "text": "The cloth is made from strange, somewhat rough fiber."
                            }
                        ]
                    },
                    {
                        "sense_id": "61c3c7d6-a3f6-37cf-ba4e-c77288a84343",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "A material whose length is at least 1000 times its width."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a7bbec17-ff09-467e-a37f-06477edb9a8c",
                                "sense_id": "61c3c7d6-a3f6-37cf-ba4e-c77288a84343",
                                "text": "Please use polyester fiber for this shirt."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5fab824-fc3a-3621-ad2b-ee2969633ce5",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "Dietary fiber."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d043e8ee-3aa5-4bff-ab4d-354ceb7a061f",
                                "sense_id": "a5fab824-fc3a-3621-ad2b-ee2969633ce5",
                                "text": "Fresh vegetables are a good source of fiber."
                            }
                        ]
                    },
                    {
                        "sense_id": "b29315fc-c807-3877-8fcc-4bc5f003c5fd",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "Moral strength and resolve."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "19e74121-b91c-463b-a26c-4b82dbf33e4e",
                                "sense_id": "b29315fc-c807-3877-8fcc-4bc5f003c5fd",
                                "text": "The ordeal was a test of everyone's fiber."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b1b91dd-6f9b-3f15-bd6f-953911f2e212",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "The preimage of a given point in the range of a map."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1cb05ae0-f8ab-4039-aa60-592e34559755",
                                "sense_id": "1b1b91dd-6f9b-3f15-bd6f-953911f2e212",
                                "text": "Under this map, any two values in the fiber of a given point on the circle differ by 2π."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5ea710-28ae-3c9f-8274-dde40bf70de7",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "The pullback of a morphism along a global element (called the fiber of the morphism over the global element)."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ed0d7ccc-c13f-3f5f-b8d8-445e8ee7a12c",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "A kind of lightweight thread of execution."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd2017d0-104b-4429-a0c9-c77d74a64741",
                                "sense_id": "ed0d7ccc-c13f-3f5f-b8d8-445e8ee7a12c",
                                "text": "We've seen how to create a new fiber and convert the current thread into a fiber (which continues to run after the conversion), but we have yet to focus on how to schedule a new fiber onto the current thread."
                            }
                        ]
                    },
                    {
                        "sense_id": "a157db65-ef1c-3f13-a745-1536471d2190",
                        "entry_id": "65bd502a-f524-3a11-87f6-a7d60ef6523a",
                        "glosses": [
                            "A long tubular cell found in bodily tissue."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
