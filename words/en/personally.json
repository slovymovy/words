{
    "word_family": [
        "person",
        "personal",
        "personality",
        "personalize",
        "impersonal",
        "personalization"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a67b69fb-68dd-3bc6-a7ef-caf0c69c1ef9",
                    "sense_definition": "Used to emphasize that a statement represents one's own opinion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>personally</w> think that we should wait for better weather before leaving.",
                            "target_lang_translations": {
                                "ru": "Я <w>лично</w> считаю, что нам следует подождать лучшей погоды перед отъездом.",
                                "zh": "<w>我个人</w>认为我们应该等天气好转后再出发。"
                            }
                        },
                        {
                            "text": "<w>Personally</w>, I find this kind of music very relaxing.",
                            "target_lang_translations": {
                                "ru": "<w>Лично</w> я нахожу эту музыку очень расслабляющей.",
                                "zh": "<w>就我个人而言</w>，我觉得这种音乐很放松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "for my part",
                        "in my opinion",
                        "to me"
                    ],
                    "common_phrases": [
                        "personally speaking",
                        "personally I think",
                        "personally I believe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы подчеркнуть, что высказывание отражает собственное мнение говорящего.",
                        "zh": "用于强调某项陈述代表说话者个人的观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лично",
                                "target_lang_sense_clarification": "выражение собственного мнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "就我个人而言",
                                "target_lang_sense_clarification": "表达个人观点时使用"
                            },
                            {
                                "target_lang_word": "我个人",
                                "target_lang_sense_clarification": "强调主观意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac2584b7-5a1c-3607-8e65-42376230f011",
                    "sense_definition": "Done by a specific person themselves rather than by someone else or by a machine.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to handle the customer's complaint <w>personally</w>.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил разобраться с жалобой клиента <w>лично</w>.",
                                "zh": "经理决定<w>亲自</w>处理客户的投诉。"
                            }
                        },
                        {
                            "text": "You must sign the document <w>personally</w> rather than sending an agent.",
                            "target_lang_translations": {
                                "ru": "Вы должны подписать документ <w>лично</w>, а не присылать представителя.",
                                "zh": "你必须<w>亲自</w>签署这份文件，而不能派代理人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "in person",
                        "face-to-face",
                        "directly"
                    ],
                    "antonyms": [
                        "remotely",
                        "indirectly"
                    ],
                    "common_phrases": [
                        "personally responsible",
                        "meet personally",
                        "visit personally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершается конкретным человеком самостоятельно, а не кем-то другим или машиной.",
                        "zh": "由某人亲自完成，而非由他人代劳或通过机器处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лично",
                                "target_lang_sense_clarification": "сам, без посредников"
                            },
                            {
                                "target_lang_word": "персонально",
                                "target_lang_sense_clarification": "индивидуально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲自",
                                "target_lang_sense_clarification": "强调动作由本人执行"
                            },
                            {
                                "target_lang_word": "本人",
                                "target_lang_sense_clarification": "强调身份的直接性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff4d7a55-2077-36dc-8c2a-7875f5f51608",
                    "sense_definition": "Regarding a person's character or private life rather than their professional role.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like him <w>personally</w>, but I do not agree with his business methods.",
                            "target_lang_translations": {
                                "ru": "Он мне нравится <w>лично</w>, но я не согласен с его методами ведения бизнеса.",
                                "zh": "我<w>个人</w>很喜欢他，但我不同意他的商业手段。"
                            }
                        },
                        {
                            "text": "Please do not take my comments <w>personally</w>; I am just critiquing the report.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не воспринимайте мои замечания <w>лично</w>; я просто критикую отчет.",
                                "zh": "请不要把我的评论<w>往心里去</w>，我只是在批评这份报告。"
                            }
                        }
                    ],
                    "synonyms": [
                        "privately",
                        "individually"
                    ],
                    "antonyms": [
                        "professionally"
                    ],
                    "common_phrases": [
                        "take personally",
                        "know personally",
                        "like personally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относительно характера или личной жизни человека, а не его профессиональной роли.",
                        "zh": "涉及个人的性格或私生活，而非其职业角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лично",
                                "target_lang_sense_clarification": "как человека, в частном порядке"
                            },
                            {
                                "target_lang_word": "на свой счёт",
                                "target_lang_sense_clarification": "принимать близко к сердцу (об обиде)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "个人",
                                "target_lang_sense_clarification": "指代私下层面"
                            },
                            {
                                "target_lang_word": "往心里去",
                                "target_lang_sense_clarification": "指将批评或言论视为针对个人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}