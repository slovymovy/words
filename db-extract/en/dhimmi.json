                        "glosses": [
                            "A protected and specially taxed non-Muslim subject of a state governed under dhimma, a form of social contract, in accordance with sharia law."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c37b6ab2-bb84-3d45-8db4-be52ef6dc356",
                        "entry_id": "f9370f28-0669-3bc4-b57c-64a4de597160",
                        "glosses": [
                            "A non-Muslim characterized by a conciliatory stance towards Islam, abstaining from articulating opposing beliefs and refraining from criticizing the religion."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "d70063f8-cbe0-4f80-9b44-da2e0556950d",
                                "sense_id": "c37b6ab2-bb84-3d45-8db4-be52ef6dc356",
                                "text": "Dhimmis do not believe that Mohammed was a prophet, but they never say anything that would displease a Muslim. Dhimmis never offend Islam and condemn any analysis that is critical of Islam as being biased."
                            }
                        ]
                    }
