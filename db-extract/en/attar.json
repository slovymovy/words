                        "sense_id": "90fd984d-907e-36d5-b542-fc6a1e93cda0",
                        "entry_id": "f21ac3a5-a2fb-399c-940d-78982744e3b1",
                        "glosses": [
                            "An essential oil extracted from flowers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "681e7b93-a5ce-47bd-b1d4-6dc92d5049f4",
                                "sense_id": "90fd984d-907e-36d5-b542-fc6a1e93cda0",
                                "text": "Now, when orange-flowers are distilled with water, we procure the otto of the blossom, which is known commercially as oil of neroli."
                            },
                            {
                                "example_id": "f4c1ba64-717d-4374-896b-9731c6cb6f3f",
                                "sense_id": "90fd984d-907e-36d5-b542-fc6a1e93cda0",
                                "text": "I bequeath to you my literary work. Useless though these might be commercially, they are the attar-drops distilled from the long and futile ebullience of my life."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd37a1a2-c34b-3011-bd48-bb925a6990fc",
