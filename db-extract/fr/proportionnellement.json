        "fr-extract.jsonl": [
            {
                "entry_id": "0b7d7490-3633-35a4-aaf7-f83472f5b85a",
                "word": "proportionnellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                        "entry_id": "0b7d7490-3633-35a4-aaf7-f83472f5b85a",
                        "glosses": [
                            "En gardant les proportions ; suivant un rapport proportionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6dc638-fa11-4d9c-9740-c8ac5456b1c7",
                                "sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                                "text": "Souvent deux familles prennent une ferme indivise, et les bénéfices sont partagés proportionnellement au nombre d'enfants et aux services qu'ils rendent."
                            },
                            {
                                "example_id": "73f4f5a8-9139-412e-89ad-f165d20918a2",
                                "sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                                "text": "Réduire proportionnellement un grand plan, un grand dessin à un petit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85493f1a-1044-484e-9ed0-bfc8a07293d7",
                        "source_entry_id": "0b7d7490-3633-35a4-aaf7-f83472f5b85a",
                        "source_sense_id": "771d42fb-80c6-3e42-94cc-c7e914f1ee0f",
                        "target_lang_word": "comparatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                        "entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                                        "glosses": [
                                            "In a comparative manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481cfe9c-e71b-408d-b2f1-145d4419b2f0",
                                                "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                                "text": "And yet I suppose that my life has been, comparatively speaking, a happy one."
                                            },
                                            {
                                                "example_id": "5c9860ee-f0d1-45fe-9780-cf6b023d3b17",
                                                "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                                "text": "Railway grouping had caused some peculiarly Scottish phraseology to disappear, though the note \"Stops on timous notice to the guard\" survived until comparatively recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "754161c4-9591-3284-9676-284437b559ef",
                                        "entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                                        "glosses": [
                                            "When compared to other entities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8fe28c-f2a2-48ba-9c10-8317f94395cc",
                                                "sense_id": "754161c4-9591-3284-9676-284437b559ef",
                                                "text": "Never did I see a more dreary and depressing scene. Miles on miles of quagmire, varied only by bright green strips of comparatively solid ground[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
