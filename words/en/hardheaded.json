{
    "word_family": [
        "hardhead",
        "hardheadedness",
        "hardheadedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3d488e2-1359-3d95-b723-cfb5fad43425",
                    "sense_definition": "Practical, realistic, and not influenced by sentiment or wishful thinking.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "pragmatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a <w>hardheaded</w> approach to the company's financial troubles and cut unnecessary costs.",
                            "target_lang_translations": {
                                "nl": "Ze koos voor een <w>nuchtere</w> aanpak van de financiële problemen van het bedrijf en schrapte onnodige kosten."
                            }
                        },
                        {
                            "text": "The project requires a <w>hardheaded</w> assessment of the risks involved before we invest.",
                            "target_lang_translations": {
                                "nl": "Het project vereist een <w>zakelijke</w> beoordeling van de risico's voordat we investeren."
                            }
                        }
                    ],
                    "synonyms": [
                        "hard-nosed",
                        "realistic"
                    ],
                    "antonyms": [
                        "idealistic",
                        "sentimental"
                    ],
                    "common_phrases": [
                        "hardheaded approach",
                        "hardheaded realism",
                        "hardheaded assessment"
                    ],
                    "target_lang_definitions": {
                        "nl": "Praktisch, nuchter en realistisch, zonder zich te laten leiden door emoties of wensdenken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pragmatisch",
                                "target_lang_sense_clarification": "gericht op praktische uitvoerbaarheid"
                            },
                            {
                                "target_lang_word": "nuchter",
                                "target_lang_sense_clarification": "realistisch en niet sentimenteel"
                            },
                            {
                                "target_lang_word": "zakelijk",
                                "target_lang_sense_clarification": "zonder emoties, doelgericht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a39fe18-8c67-3f0e-b496-da412bea7228",
                    "sense_definition": "Refusing to change one's mind or opinion; obstinate and willful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stubborn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was too <w>hardheaded</w> to listen to any advice from his colleagues.",
                            "target_lang_translations": {
                                "nl": "Hij was te <w>koppig</w> om naar advies van zijn collega's te luisteren."
                            }
                        },
                        {
                            "text": "Her <w>hardheaded</w> refusal to compromise ruined the negotiations entirely.",
                            "target_lang_translations": {
                                "nl": "Haar <w>onverzettelijke</w> weigering om een compromis te sluiten verpestte de onderhandelingen volledig."
                            }
                        }
                    ],
                    "synonyms": [
                        "bullheaded",
                        "headstrong",
                        "inflexible",
                        "intractable",
                        "obstinate",
                        "pigheaded",
                        "stubborn",
                        "unyielding",
                        "willful"
                    ],
                    "antonyms": [
                        "flexible",
                        "yielding"
                    ],
                    "common_phrases": [
                        "hardheaded refusal"
                    ],
                    "target_lang_definitions": {
                        "nl": "Weigeren van mening of standpunt te veranderen; koppig en eigenzinnig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "koppig",
                                "target_lang_sense_clarification": "vasthoudend aan het eigen standpunt"
                            },
                            {
                                "target_lang_word": "stijfkop",
                                "target_lang_sense_clarification": "zeer hardnekkig of onbuigzaam"
                            },
                            {
                                "target_lang_word": "eigenwijs",
                                "target_lang_sense_clarification": "niet willen luisteren naar anderen"
                            },
                            {
                                "target_lang_word": "onverzettelijk",
                                "target_lang_sense_clarification": "niet toegevend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}