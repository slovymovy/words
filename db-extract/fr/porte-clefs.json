                "senses": [
                    {
                        "sense_id": "b80400fe-97c7-3f24-b575-4dace37da508",
                        "entry_id": "b30163fc-6c3e-3d3c-936e-824c8cd03abb",
                        "glosses": [
                            "Gardien de prison qui porte les clefs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddb5e22-fc8f-488b-88b5-2d1af40ecf34",
                                "sense_id": "b80400fe-97c7-3f24-b575-4dace37da508",
                                "text": "En ce moment, le porte-clefs vint me prier de rentrer dans ma chambre."
                            },
                            {
                                "example_id": "26c07936-52b5-49ba-8ab5-e27cf73a14d8",
                                "sense_id": "b80400fe-97c7-3f24-b575-4dace37da508",
                                "text": "Un porte-clefs entra et mit fin à ce récit lamentable : il apportait le souper des habitants de la troisième chambre."
                            },
                            {
                                "example_id": "9cb3adf5-2262-4057-88da-a218af2b8d6d",
                                "sense_id": "b80400fe-97c7-3f24-b575-4dace37da508",
                                "text": "Gilbert désigna la comtesse de Charny, et le directeur ordonna à un porte-clefs de conduire le citoyen Gilbert à la chambre de la prisonnière."
                            },
                            {
                                "example_id": "d72c182d-87b6-4343-a979-b9841db104b5",
                                "sense_id": "b80400fe-97c7-3f24-b575-4dace37da508",
                                "text": "Le porte-clefs a l’air plus bourru que méchant, et sa fille, qui est jolie, porte à ravir le bonnet blanc avec la cocarde et les nœuds aux couleurs de la nation."
                            }
                        ]
                    },
                    {
                        "sense_id": "71532382-435a-32c9-af92-2e206ff70a52",
                        "entry_id": "b30163fc-6c3e-3d3c-936e-824c8cd03abb",
                        "glosses": [
                            "Anneau ou étui pour porter les clefs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7626086a-a694-401f-bb90-6b67f731cb18",
                                "sense_id": "71532382-435a-32c9-af92-2e206ff70a52",
                                "text": "Le cadeau ou objet publicitaire de faible valeur est largement utilisé en de nombreuses occasions. […] Les classiques sont les stylos à bille, les briquets, les calendriers, les porte-clefs, les sacs, les pochettes d’allumettes, les cartes à jouer."
                            }
                        ]
                    }
