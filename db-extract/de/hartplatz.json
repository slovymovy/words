                    {
                        "form_id": "108d0cff-f8ab-4dbc-862f-bfcdc1952e4c",
                        "entry_id": "eb61f4e0-d60d-3626-937d-e7c4eff43553",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Hartplatz"
                    },
                    {
                        "form_id": "b66e1c88-cbf4-43bf-9ca0-46f3db1b5c7f",
                        "entry_id": "eb61f4e0-d60d-3626-937d-e7c4eff43553",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hartplätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                        "entry_id": "eb61f4e0-d60d-3626-937d-e7c4eff43553",
                        "glosses": [
                            "Spielfeld, dessen Boden aus einem (meist rötlichen) Belag aus Sand besteht; früher wurden diese Plätze unter anderem mit der Schlacke von Hochöfen errichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77c7f17-39e7-4261-a179-cc1550561f35",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "Am Wochenende hatten wir unser Spiel auf einem Hartplatz."
                            },
                            {
                                "example_id": "f1be082a-089d-4d28-aae3-60c7613e6e00",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "Früher wurden alle Spiele auf Hartplatz gespielt."
                            },
                            {
                                "example_id": "c0c789b7-e7a3-4745-996e-1f820bad626b",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Wir haben in einem Dorf bei meiner Oma gelebt, es gab nicht so viele Möglichkeiten. Deswegen haben wir nach der Schule den ganzen Nachmittag Fußball gespielt. Meistens barfuß auf einem Hartplatz, auf dem auch Scherben lagen.“"
                            },
                            {
                                "example_id": "15f53c47-4614-45cc-9172-4c785f510e3d",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Oft heißt es, Hartplätze stünden für ehrlichen Fußball. Das mag stimmen, noch viel mehr stehen sie aber für Schürfwunden, aus denen man später roten Sand pulen muss.“"
                            },
                            {
                                "example_id": "dc1a7254-199d-468d-bd14-aeedebb38cf5",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Damals hatten wir zwei Plätze zur Auswahl: einen Rasenplatz, auf dem wir auch unsere Punktspiele austrugen, und einen Hartplatz.“"
                            },
                            {
                                "example_id": "124a6e99-b289-4ea1-8db1-5ecb5def950f",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Das Geld soll für den Bau eines neuen Rasenplatzes im Albert-Kuntz-Sportpark gesteckt werden. Der Platz ist gegenwärtig ein Hartplatz, er soll nun mit Naturrasen ausgestattet werden.“"
                            },
                            {
                                "example_id": "6d5f5d01-82c7-4de3-9ac4-6fb7dacb18d4",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Malta – Deutschland 0:0 (0:0), 25. Februar 1979 – EM-Qualifikation: Auf dem Hartplatz in La Valetta reichte es für die deutsche Elf nur zu einem mageren Unentschieden 0:0.“"
                            },
                            {
                                "example_id": "0639bc11-82b0-48e6-8e3f-7f2f254e86b5",
                                "sense_id": "8ce84477-f657-3bd4-93e5-acdb5a03cc8a",
                                "text": "„Auf dem Hartplatz des Gzira-Stadions erspielen sich die Stars aus der Bundesliga zu wenige Chancen gegen die Amateure von der Mittelmeerinsel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                        "entry_id": "eb61f4e0-d60d-3626-937d-e7c4eff43553",
                        "glosses": [
                            "Spielfeld, dessen Boden aus Beton überzogen mit einem Kunststoff besteht"
                        ],
                        "tags": [
                            "Tennis"
                        ],
                        "examples": [
                            {
                                "example_id": "4b61dcaf-4608-485f-bb22-1ad8ecc861c1",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„»Aus körperlicher Sicht ist es für die Spielerinnen und Spieler fast unmöglich, zunächst auf Hartplatz die US Open zu spielen und dann innerhalb einer Woche nach Europa zu fliegen und auf Sand zu trainieren. […]«“"
                            },
                            {
                                "example_id": "c40ec2ae-9d37-45fd-9475-b41e95430e47",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„Doch im dritten Durchgang verlor er seine Konzentration und machte viele leichte Fehler. Frustriert hämmerte Zverev in dieser Phase seinen Schläger auf den blauen Hartplatz.“"
                            },
                            {
                                "example_id": "bdd791c8-1b7f-4777-a751-a56245b6c43b",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„[…] Davis-Cup-Teamchef Michael Kohlmann eilte im Laufschritt davon, weil die Zeit bis zur letzten Bus-Abfahrt drängte, da stand Zverev in sengender Sonne noch immer auf dem blauen Hartplatz. Der 24-Jährige schnappte sich den Pappkarton mit den Tennisbällen und übte Aufschläge.“"
                            },
                            {
                                "example_id": "d259ff59-739e-440e-bed6-00f53ba02c0c",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„Zuletzt spielte der 23-Jährige im Jahr 2018 auf Hartplatz gegen Djokovic. Damals gewann er im Endspiel der ATP Finals 6:4, 6:3.“"
                            },
                            {
                                "example_id": "2f5103a2-7f06-49fb-adba-a32886c25586",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„Am 20. Januar beginnen in Melbourne die Australian Open - eines der vier bedeutendsten Tennis-Turniere der Welt. Aufgeschlagen wird auf insgesamt 22 der berühmten blauen Hartplatz-Courts […].“"
                            },
                            {
                                "example_id": "bfa0e257-72c0-4fcf-a70e-84d1bb6f209f",
                                "sense_id": "78c4450c-2c28-3161-ad69-09dda2b15b44",
                                "text": "„Die beiden [Anmerkung: Roger Federer und Hubert Hurkacz] begegneten sich erst einmal auf der Tour: 2019 beim ATP-1000-Turnier in Indian Wells auf Hartplatz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
