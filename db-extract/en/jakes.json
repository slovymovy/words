                        "form": "jakeses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81c7310b-1e35-3d97-abf7-a8392edf34a2",
                        "entry_id": "15b9b0c8-b2a3-3e7f-a20d-036fb94052b8",
                        "glosses": [
                            "A place to urinate and defecate: an outhouse or lavatory."
                        ],
                        "tags": [
                            "Ireland",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bceb5179-bf37-45db-8961-e5ccb17b587a",
                                "sense_id": "81c7310b-1e35-3d97-abf7-a8392edf34a2",
                                "text": "My lord, if you’ll give me leave, I will tread this unbolted villain into mortar and daub the walls of a jakes with him."
                            },
                            {
                                "example_id": "4bcd59a4-c66c-4c0c-9af7-8cc6c8d334dd",
                                "sense_id": "81c7310b-1e35-3d97-abf7-a8392edf34a2",
                                "text": "[…] Whereas the Truth-finder, having raked out that Jakes his own Mind, and being there capable of tracing no Ray of Divinity, nor any thing virtuous, or good, or lovely, or loving, very fairly, honestly, and logically concludes, that no such things exist in the whole Creation."
                            },
                            {
                                "example_id": "beadd752-1139-4fdc-a81c-3b971d1f8acf",
                                "sense_id": "81c7310b-1e35-3d97-abf7-a8392edf34a2",
                                "text": "And the treasures of the floor and walls went raw into the jakeses from my brush and dustpan: sludges, geodes, hair, dead insects and arachnidae, a rubber glove and tainted paper waste, a mouse's skull and tail, a set of used plasters, […]"
                            }
                        ]
                    }
                ],
