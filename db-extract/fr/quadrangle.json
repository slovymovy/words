                                    {
                                        "sense_id": "bc9a1604-82de-315e-ad12-130bce85700e",
                                        "entry_id": "d0a452bf-450e-3a25-9034-70f6aeea2a94",
                                        "glosses": [
                                            "Fläche mit vier Ecken"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d8dff5e-3a0c-46a7-b803-389b5b4a6c6d",
                                                "sense_id": "bc9a1604-82de-315e-ad12-130bce85700e",
                                                "text": "Ein Tetragon ist eine geschlossene, ebene Figur mit vier Ecken, wobei es völlig egal ist, wie lang die einzelnen Seiten sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
