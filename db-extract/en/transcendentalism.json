                    },
                    {
                        "translation_id": "f3bcab71-3f2e-48ad-8671-01a2c3e9e2bb",
                        "source_entry_id": "09fce0c8-569f-3326-a8f1-95165fe79d86",
                        "source_sense_description": "a philosophy which holds that reasoning is key to understanding reality",
                        "target_lang_word": "Transzendentalismus",
