                "senses": [
                    {
                        "sense_id": "c59f0c81-b64e-3d03-a102-0a3991a19b91",
                        "entry_id": "5acd4a96-81c1-38b4-b136-db15ad83f167",
                        "glosses": [
                            "To move under the force of gravity."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf90fb1-9155-4e9a-b7e2-f5d8eb2bdf1c",
                                "sense_id": "c59f0c81-b64e-3d03-a102-0a3991a19b91",
                                "text": "Theſe, who have nature's ſteps with care purſued,\nThat matter is with active force endued,\nThat all its parts magnetic power exert,\nAnd to each other gravitate, aſſert."
                            }
                        ]
                    },
                    {
                        "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                        "entry_id": "5acd4a96-81c1-38b4-b136-db15ad83f167",
                        "glosses": [
                            "To tend or drift towards someone or something, as though being pulled by gravity."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "88a01293-d2e6-4361-b70b-a6ad7cd0e5c0",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "Children naturally gravitate to such a big, friendly man."
                            },
                            {
                                "example_id": "fa2b3e57-a0ed-4e16-933d-0f4e184f0351",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "The guests slowly gravitated to the kitchen."
                            },
                            {
                                "example_id": "d6d3bf37-8e62-4ecc-b6a9-1e15c7cc58ea",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "The natural price, therefore, is, as it were, the central price, to which the prices of all commodities are continually gravitating."
                            },
                            {
                                "example_id": "892eeeef-1f9d-49a9-a8e9-0aaff34851e5",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "As the presence of any considerable number of priests on an ocean steamer is supposed to bring rough weather, so the addition of a few hundred parsons to the population of Edinburgh is believed to induce rain,—or perhaps I should say, more rain."
                            },
                            {
                                "example_id": "cda36ea1-5fd5-4197-a924-168b6996bc60",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "Responsibilities gravitate to the person who can shoulder them."
                            },
                            {
                                "example_id": "0ebba617-de73-458a-a999-502987e303fe",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "A considerable amount of new rolling stock has been built for the main line services during recent years, and the older stock has gravitated to the secondary and branch lines."
                            },
                            {
                                "example_id": "2b2cde03-3dc7-47e6-abff-c69afdc748b7",
                                "sense_id": "e608cde7-1268-3bb4-b46f-00295045d911",
                                "text": "I lingered with seven new friends from Chicago on a back balcony, where concert attendees waiting to be convinced traditionally congregate. The more we drank, the farther up front we gravitated. I finished the show a few feet from the stage."
                            }
                        ]
                    }
                ],
