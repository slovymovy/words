{
    "word_family": [
        "doom",
        "deemster"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e8fd0fd-211e-3d0a-8ef3-81bbd05f01fc",
                    "sense_definition": "To regard or consider something in a specified way; to judge or believe to be.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will <w>deem</w> the project successful if it meets all the initial requirements.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>сочтет</w> проект успешным, если он будет отвечать всем первоначальным требованиям.",
                                "zh": "如果该项目符合所有初始要求，委员会将<w>认为</w>它是成功的。"
                            }
                        },
                        {
                            "text": "She <w>deemed</w> it necessary to inform the manager about the potential risks immediately.",
                            "target_lang_translations": {
                                "ru": "Она <w>посчитала</w> необходимым немедленно проинформировать менеджера о потенциальных рисках.",
                                "zh": "她<w>认为</w>有必要立即将潜在风险告知经理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consider",
                        "regard as",
                        "view as",
                        "judge",
                        "hold"
                    ],
                    "common_phrases": [
                        "deem it necessary",
                        "deem it appropriate",
                        "deemed to be"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать или считать что-либо определенным образом; судить или полагать.",
                        "zh": "认为；以为；视为"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "считать",
                                "target_lang_sense_clarification": "иметь мнение о чем-либо"
                            },
                            {
                                "target_lang_word": "полагать",
                                "target_lang_sense_clarification": "книжный вариант слова считать"
                            },
                            {
                                "target_lang_word": "расценивать",
                                "target_lang_sense_clarification": "давать оценку чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认为",
                                "target_lang_sense_clarification": "对人或事物作出判断或看法"
                            },
                            {
                                "target_lang_word": "视为",
                                "target_lang_sense_clarification": "看作、当作"
                            },
                            {
                                "target_lang_word": "以为",
                                "target_lang_sense_clarification": "认为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4e8ae5-3a2d-3b06-be66-f45689b28ec3",
                    "sense_definition": "To officially adjudge, decree, or decide, especially in a legal or formal context.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court may <w>deem</w> the contract void if evidence of fraud is discovered.",
                            "target_lang_translations": {
                                "ru": "Суд может <w>признать</w> контракт недействительным, если будут обнаружены доказательства мошенничества.",
                                "zh": "如果发现欺诈证据，法院可能会<w>认定</w>该合同无效。"
                            }
                        },
                        {
                            "text": "The authorities <w>deemed</w> it expedient to establish a new court to handle the backlog.",
                            "target_lang_translations": {
                                "ru": "Власти <w>сочли</w> целесообразным учредить новый суд для рассмотрения накопившихся дел.",
                                "zh": "当局<w>认定</w>设立一个新法庭来处理积压案件是权宜之计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "find",
                        "dub",
                        "interpret"
                    ],
                    "common_phrases": [
                        "deem it expedient",
                        "deemed legally valid"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально выносить решение, постановлять или признавать, особенно в юридическом контексте.",
                        "zh": "（尤用于法律或官方语境中）裁定，判定，认定"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "официально объявлять"
                            },
                            {
                                "target_lang_word": "выносить решение",
                                "target_lang_sense_clarification": "в судебном или формальном порядке"
                            },
                            {
                                "target_lang_word": "считать",
                                "target_lang_sense_clarification": "в контексте юридической оценки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认定",
                                "target_lang_sense_clarification": "官方或法律上确定、认可"
                            },
                            {
                                "target_lang_word": "判定",
                                "target_lang_sense_clarification": "经审查后作出裁决"
                            },
                            {
                                "target_lang_word": "视作",
                                "target_lang_sense_clarification": "法律上按某种情况对待"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2b99c01-19dd-30e7-a5d9-71f82fb3132c",
                    "sense_definition": "An opinion, a judgment, or a surmise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In my humble <w>deem</w>, the plan requires significantly more thought before implementation.",
                            "target_lang_translations": {
                                "ru": "По моему скромному <w>мнению</w>, план требует гораздо более тщательной проработки перед реализацией.",
                                "zh": "依拙<w>见</w>，该计划在付诸实施前还需要更周密的考量。"
                            }
                        },
                        {
                            "text": "His personal <w>deem</w> on the matter was ignored by the rest of the council.",
                            "target_lang_translations": {
                                "ru": "Его личное <w>суждение</w> по этому вопросу было проигнорировано остальными членами совета.",
                                "zh": "他对这件事的个人<w>看法</w>被委员会的其他成员忽视了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consider",
                        "judge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение, суждение или предположение.",
                        "zh": "看法；意见；判断（古旧用法）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "точка зрения"
                            },
                            {
                                "target_lang_word": "суждение",
                                "target_lang_sense_clarification": "результат размышления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对事情的见解"
                            },
                            {
                                "target_lang_word": "见解",
                                "target_lang_sense_clarification": "主观看法或见识"
                            },
                            {
                                "target_lang_word": "判断",
                                "target_lang_sense_clarification": "作出的断定或结论"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "505ee817-54f5-3972-997b-914fcfddbc99",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Arthur <w>Deem</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Артура <w>Дима</w>.",
                                "zh": "当地图书馆以慈善家阿瑟·<w>迪姆</w>的名字命名。"
                            }
                        },
                        {
                            "text": "Several families with the name <w>Deems</w> settled in this valley during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Несколько семей с фамилией <w>Димс</w> поселились в этой долине в девятнадцатом веке.",
                                "zh": "十九世纪期间，有几个姓<w>迪姆斯</w>的家庭定居在这座山谷中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "迪姆（姓氏）"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дим",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迪姆",
                                "target_lang_sense_clarification": "西方姓氏译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}