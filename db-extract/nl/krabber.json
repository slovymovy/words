                                        "glosses": [
                                            "Werkzeug/Gerät, das zum Schaben/Kratzen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341c34ce-c48d-4bc1-8736-3121b82c0941",
                                                "sense_id": "08c7c507-8767-3322-81fb-e8f8d7c592bc",
                                                "text": "„Danach auf Teigstufe 2 Minuten kneten, dabei eventuell den Teig mit dem Schaber nach unten schieben.“"
                                            },
                                            {
                                                "example_id": "0dc6eac0-c538-40c2-92e1-67bc25d0ffef",
                                                "sense_id": "08c7c507-8767-3322-81fb-e8f8d7c592bc",
                                                "text": "„Bearbeiten Sie Ihr Kochfeld mit dem Schaber behutsam, um irreparable Kratzer zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46cc93bf-8f16-32ba-86e7-7af84820d9b1",
                                        "entry_id": "d08334b6-574f-3346-8c5c-4ab2b0e4280c",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b838ddbd-204a-4798-974d-01cb58182132",
                                                "sense_id": "46cc93bf-8f16-32ba-86e7-7af84820d9b1",
                                                "text": "Herr Schaber ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "18b5da01-81f3-47e1-bafa-3dd25721f168",
                                                "sense_id": "46cc93bf-8f16-32ba-86e7-7af84820d9b1",
                                                "text": "Herr Schaber heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "d6300c4d-7d4c-4d03-92c0-168fe873b4bd",
                                                "sense_id": "46cc93bf-8f16-32ba-86e7-7af84820d9b1",
                                                "text": "Frau Schaber liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "9972ff2c-a493-4ba6-94a7-47e0a4d186b5",
                                                "sense_id": "46cc93bf-8f16-32ba-86e7-7af84820d9b1",
                                                "text": "Die Schabers lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
