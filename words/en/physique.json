                {
                    "sense_id": "86a0dcd3-003a-32e9-89f9-5a488a652c58",
                    "sense_definition": "The natural constitution or physical structure of a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was born with a strong <w>physique</w> that helped him excel in many different sports.",
                            "target_lang_translations": {
                                "zh": "他天生有着强健的<w>体格</w>，这使他在许多不同的运动项目中表现出色。",
                                "es": "Nació con una <w>complexión</w> fuerte que le ayudó a destacar en muchos deportes diferentes."
                            }
                        },
                        {
                            "text": "The athlete's natural <w>physique</w> was perfectly suited for long-distance running.",
                            "target_lang_translations": {
                                "zh": "这位运动员天生的<w>体质</w>非常适合长跑。",
                                "es": "La <w>constitución</w> natural del atleta era perfecta para las carreras de larga distancia."
                            }
                        }
                    ],
                    "synonyms": [
                        "body",
                        "frame",
                        "build",
                        "anatomy",
                        "constitution",
                        "figure",
                        "shape"
                    ],
                    "antonyms": [
                        "psyche"
                    ],
                    "common_phrases": [
                        "strong physique",
                        "natural physique"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一个人的自然体质或身体结构。",
                        "es": "Constitución natural o estructura corporal de una persona."
                    },
                    "translations": {
                        "zh": [
                            {
