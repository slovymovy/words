                    "sense_definition": "Versterkte vorm van het wederkerend voornaamwoord 'zich', verwijzend naar de derde persoon enkelvoud of meervoud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_emphatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bekeek <w>zichzelf</w> in de spiegel.",
                            "target_lang_translations": {
                                "en": "He looked at <w>himself</w> in the mirror.",
                                "ru": "Он рассматривал <w>себя</w> в зеркале.",
                                "pl": "Obejrzał <w>samego siebie</w> w lustrze.",
                                "de": "Er betrachtete <w>sich selbst</w> im Spiegel.",
                                "fr": "Il s'est regardé <w>lui-même</w> dans le miroir.",
                                "it": "Si è guardato <w>se stesso</w> allo specchio.",
                                "cs": "Prohlížel <w>sám sebe</w> v zrcadle.",
                                "tr": "Aynada <w>kendine</w> baktı.",
                                "es": "Él se miró <w>a sí mismo</w> en el espejo.",
                                "zh": "他对着镜子看了看<w>他自己</w>。"
                            }
                        },
                        {
                            "text": "De kinderen kunnen <w>zichzelf</w> prima vermaken.",
                            "target_lang_translations": {
                                "en": "The children can entertain <w>themselves</w> very well.",
                                "ru": "Дети могут отлично развлечь <w>себя</w>.",
                                "pl": "Dzieci potrafią świetnie zająć <w>same siebie</w>.",
                                "de": "Die Kinder können <w>sich selbst</w> prima beschäftigen.",
                                "fr": "Les enfants peuvent très bien s'amuser <w>eux-mêmes</w>.",
                                "it": "I bambini sanno divertire <w>se stessi</w> benissimo.",
                                "cs": "Děti se dokážou <w>samy</w> skvěle zabavit.",
                                "tr": "Çocuklar <w>kendilerini</w> gayet iyi eğlendirebilirler.",
                                "es": "Los niños pueden entretenerse <w>a sí mismos</w> muy bien.",
                                "zh": "孩子们完全可以<w>自己</w>玩得很开心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zich",
                        "uzelf"
                    ],
                    "antonyms": [
