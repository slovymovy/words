                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acb3e178-2079-43a5-9c0f-34d8873d6482",
                                "sense_id": "556916a7-73dc-3d0b-a084-d92f7f4f53cf",
                                "text": "„Ein Deckenfluter ist eine Zimmerlampe, die ähnlich einer Stehlampe auf einem nach oben ragenden Metallrohr aufgebaut wird.“"
                            },
                            {
                                "example_id": "59adbf33-26f7-4caf-9169-96fa797b65db",
                                "sense_id": "556916a7-73dc-3d0b-a084-d92f7f4f53cf",
                                "text": "„Als die beiden wie ein Unheil kündendes Dämonenpaar eindrangen, pustete er augenblicklich die Zimmerlampe aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
