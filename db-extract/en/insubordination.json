                    {
                        "translation_id": "a4b530a2-f634-46b3-8060-7d1ad55fd3fd",
                        "source_entry_id": "15df8f7c-0bfb-33b8-a8a9-0360b9db3c3d",
                        "source_sense_id": "34169fcf-04c1-3ba6-8ff8-7eba933c8462",
