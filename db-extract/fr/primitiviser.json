                ],
                "senses": [
                    {
                        "sense_id": "ae68252b-78f6-3267-9e0a-0556b6d3449d",
                        "entry_id": "efa5a3e4-71aa-3872-80c5-7be279ba8482",
                        "glosses": [
                            "Donner un caractère primitif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5389ce71-82dd-44d4-b3ee-a42132289b2d",
                                "sense_id": "ae68252b-78f6-3267-9e0a-0556b6d3449d",
                                "text": "Ce roman, nous avons voulu le primitiviser pour en faire percevoir la sauvagerie immanente."
                            },
                            {
                                "example_id": "f395efd9-20f0-49e8-abf0-3811dc730638",
                                "sense_id": "ae68252b-78f6-3267-9e0a-0556b6d3449d",
                                "text": "En revanche, en traduisant par « sorcellerie », on risque d’amputer, pour ne pas dire « primitiviser », cette vision complexe."
                            },
                            {
                                "example_id": "c84820bb-f3df-415e-b0e4-a75ca5dca8ca",
                                "sense_id": "ae68252b-78f6-3267-9e0a-0556b6d3449d",
                                "text": "Il y a toujours chez le Gauguin des autoportraits une évidente et insistante volonté de souligner son profil inca, de « primitiviser » son visage, de lui faire subir ce que je me risquerais ici à appeler une opération de poterie esthétique, pour le rendre plus sauvage, plus barbare."
                            }
                        ]
                    }
