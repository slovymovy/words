                "senses": [
                    {
                        "sense_id": "e970a3ee-f8c2-3e68-9662-b6f66911e759",
                        "entry_id": "696fb605-6a7e-3a73-baf3-9a1aceb68e5a",
                        "glosses": [
                            "betrekking hebbend op de periode van 1450 - 1800"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba3f6d9c-b578-49e2-bd35-9a12620c62db",
                                "sense_id": "e970a3ee-f8c2-3e68-9662-b6f66911e759",
                                "text": "Sport en lichaamsbeweging golden in vroegmodern Europa niet slechts als aangenaam tijdverdrijf of een manier om status te verwerven: men was zich terdege bewust van de positieve uitwerking van beweging op de gezondheid."
                            },
                            {
                                "example_id": "12e01027-4d4e-4109-b986-5a80394c8dda",
                                "sense_id": "e970a3ee-f8c2-3e68-9662-b6f66911e759",
                                "text": "Zoals dit boek aantoont, zien we regels, stadions (of afgebakende ruimtes voor sportbeoefening), specifieke sportuitrustingen, toeschouwerscultuur en sport als professie al terug in de vroegmoderne tijd en daarvoor."
                            }
                        ]
                    }
