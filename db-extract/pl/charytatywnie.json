                        "target_lang_word": "karitativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karitativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                        "entry_id": "35a688bf-7d2f-3c86-a699-e606be04f380",
                                        "glosses": [
                                            "im Sinne der Karitas, auf der Karitas beruhend: so, dass es armen und kranken Menschen hilft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010e6c3c-2574-4d1f-835b-7f2a6badbd89",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Das gespendete Geld soll karitativen Zwecken zufließen."
                                            },
                                            {
                                                "example_id": "0527c216-f148-4168-9b32-670059fce7c9",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Das Internationale Rote Kreuz ist eine karitative Organisation."
                                            },
                                            {
                                                "example_id": "a8f9c7e1-6836-4bf1-af0b-9990c4d394e5",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Er setzt sich in seiner Freizeit für karitative Projekte, z.B. der Tafel in Deutschland, ein."
                                            },
                                            {
                                                "example_id": "8309f019-ea59-4127-a54c-0128a61a9074",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Es kann nicht sein, dass wir die sozialen Defizite dieses Staates durch karitative Organisationen auffangen lassen und die Bedürftigen damit zu Almosenempfängern machen."
                                            },
                                            {
                                                "example_id": "026a93ee-510f-41e9-b0a8-932cb4d665c2",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Denn im Unterschied zur absoluten Armut, der man auf karitativem Wege, das heißt mit Lebensmitteltafeln, Kleiderkammern und Möbellagern begegnen kann, erfordert die Bekämpfung der relativen Armut, dass man den Reichtum antastet."
                                            },
                                            {
                                                "example_id": "1ed63e69-562c-4631-8467-e54831f15aaf",
                                                "sense_id": "8f7c3010-6be5-30c9-a612-9e1cc0bc9b84",
                                                "text": "Neben geistlichem Beistand macht sie [die katholische Kirche] sich in diesen [afrikanischen] Ländern auch durch humanitäre und karitative Hilfe bei der Bevölkerung beliebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
