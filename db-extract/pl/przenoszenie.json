                    {
                        "translation_id": "7e5cb40b-16c7-4816-8dd3-0d6b311e6f67",
                        "source_entry_id": "168f7994-eb35-3535-9908-f43f1d7c92e6",
                        "source_sense_id": "ec5a4b0a-0e52-389c-8593-6bd26d4b4152",
                        "target_lang_word": "Übertragung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übertragung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e7e720-8d82-330f-b8ea-54ab4fc97c9c",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Sendung, Übermittlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca6f465-0bd2-47c3-a332-a651046b142a",
                                                "sense_id": "d8e7e720-8d82-330f-b8ea-54ab4fc97c9c",
                                                "text": "Die Übertragung des Dokuments dauerte einige Sekunden."
                                            },
                                            {
                                                "example_id": "48a79e02-db6a-44d7-b040-6d0ad6e34651",
                                                "sense_id": "d8e7e720-8d82-330f-b8ea-54ab4fc97c9c",
                                                "text": "„Die Übertragung war zu Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "653420f5-d5b6-33bd-9461-6f3fa20dc8af",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Übersetzung in eine andere Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41a342b-f4a5-4c2c-ad40-f78d258a49a3",
                                                "sense_id": "653420f5-d5b6-33bd-9461-6f3fa20dc8af",
                                                "text": "Der Dolmetscher wurde mit der Übertragung des Texts ins Englische beauftragt."
                                            },
                                            {
                                                "example_id": "05da05ec-de8e-4afe-9628-672f274da575",
                                                "sense_id": "653420f5-d5b6-33bd-9461-6f3fa20dc8af",
                                                "text": "„Die Übertragung des englischen Originals gestaltete sich in mancher Hinsicht schwierig, weil verschiedene grundlegende Begriffe der Kommunikationslehre keine semantisch einwandfreien deutschen Entsprechungen haben.“"
                                            },
                                            {
                                                "example_id": "3b357f9b-46ec-4ec8-8628-a9de39a6bad3",
                                                "sense_id": "653420f5-d5b6-33bd-9461-6f3fa20dc8af",
                                                "text": "„Im Altfranzösischen ist er ein Meister; von den Surrealisten hat er vorzügliche Übertragungen gemacht; aber eine einfache Sache zu sagen, wie: »Zum Teufel, hau doch ab, du alter Hurenbock!« – das bringt er nicht fertig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eec5a43d-4c6e-3c9d-ba90-51e6367ee5bb",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Übergang von Rechten oder Pflichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10dd33d-9509-44e0-8f05-f79780adf271",
                                                "sense_id": "eec5a43d-4c6e-3c9d-ba90-51e6367ee5bb",
                                                "text": "Eine Übertragung dieses Rechts auf andere Personen ist nicht möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1fdfa7e7-8ae2-3cbb-9e83-b70a9088e55d",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Übergabe von Infektionskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05053b2b-f11f-41d3-864f-4330ffe7f657",
                                                "sense_id": "1fdfa7e7-8ae2-3cbb-9e83-b70a9088e55d",
                                                "text": "Die Übertragung dieses Virus erfolgt über die Atemwege."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8652148a-d83d-3ba1-b262-def545f1eeb3",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Schwangerschaftsdauer, die 42 Wochen überschreitet"
                                        ],
                                        "tags": [
                                            "Gynäkologie",
                                            "Geburtshilfe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584f1952-2099-484b-99f8-7059ccd44f3b",
                                                "sense_id": "8652148a-d83d-3ba1-b262-def545f1eeb3",
                                                "text": "Ergibt sich auch nur der Verdacht einer Übertragung, so ist die Gravide als Risikoschwangere und die Geburt als Risikogeburt einzustufen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "097c1699-0874-381c-98ea-34a423f8c12c",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Transport von einem Ort an einen anderen, Transplantation"
                                        ],
                                        "tags": [
                                            "in zusammengesetzten Wörtern",
                                            "häufig auch im Zusammenhang mit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f1eddaa-f44d-40fb-a3de-584b92baf500",
                                                "sense_id": "097c1699-0874-381c-98ea-34a423f8c12c",
                                                "text": "Die eigentliche Übertragung der Hornhaut ist zügig geschehen, der Heilungsprozess dauert jedoch länger."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8dc421ca-f59c-3c95-b2bb-4d5ea9e9a50c",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "Projektion von Kindheitswünschen u.ä. eines Menschen auf einen anderen Menschen"
                                        ],
                                        "tags": [
                                            "Psychoanalyse"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "8cd409dd-5daa-3db0-9e20-162de95fba3f",
                                        "entry_id": "40ce86b1-53eb-33a1-a687-449d558632ec",
                                        "glosses": [
                                            "die Anwendung von etwas auf ein anderes Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c3c01a-c2ce-4085-92a3-052119751fd4",
                                                "sense_id": "8cd409dd-5daa-3db0-9e20-162de95fba3f",
                                                "text": "„Die Übertragung der Prinzipien der darwinistischen Biologie auf gesellschaftliche Verhältnisse führte zur Entwicklung des Sozialdarwinismus, der vor allem durch Ernst Haeckel propagiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
