                "senses": [
                    {
                        "sense_id": "5c75425d-b8ba-3ff9-ad39-ba9e129b3eb6",
                        "entry_id": "ff1f5c5d-5900-3472-9548-07c3581f05bc",
                        "glosses": [
                            "weibliche Person, die für ihre Verdienste um den Weltfrieden mit dem Friedensnobelpreis ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a6f4d7-4991-49ca-832f-679313845b1d",
                                "sense_id": "5c75425d-b8ba-3ff9-ad39-ba9e129b3eb6",
                                "text": "„Die Friedensnobelpreisträgerin [Aung San Suu Kyi], die als eine Art Nelson Mandela Asiens gilt, war von der Militärjunta 15 Jahre unter Hausarrest gehalten worden.“"
                            },
                            {
                                "example_id": "fa7dd1ce-e591-40ac-b477-ee80137605c2",
                                "sense_id": "5c75425d-b8ba-3ff9-ad39-ba9e129b3eb6",
                                "text": "„Für ein Burka-Verbot in Europa hat sich die iranische Friedensnobelpreisträgerin Shirin Ebadi ausgesprochen.“"
                            },
                            {
                                "example_id": "d95b6613-3040-4730-8a71-dcc723327f82",
                                "sense_id": "5c75425d-b8ba-3ff9-ad39-ba9e129b3eb6",
                                "text": "„Friedensnobelpreisträgerin Leymah Roberta Gbowee wurde 1972 in der liberianischen Hauptstadt Monrovia geboren.“"
                            }
                        ],
