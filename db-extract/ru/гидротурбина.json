                                "target_senses": [
                                    {
                                        "sense_id": "4355af90-19e1-3377-85b2-a1e04acc3f88",
                                        "entry_id": "fddd32fa-721f-399e-8afd-eaff2aa493f5",
                                        "glosses": [
                                            "Turbine, die mit der Strömungskraft des Wassers angetrieben wird und diese in mechanische Arbeit (Drehbewegung des Rotors) umwandelt"
                                        ],
                                        "tags": [
                                            "Kraftmaschine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1f156cb-722c-498c-87a5-ca4c64d55975",
                                                "sense_id": "4355af90-19e1-3377-85b2-a1e04acc3f88",
                                                "text": "„Wie bei den Pumpen ist die spezifische Drehzahl n_q die wichtigste Kennzahl für die Wasserturbinen.“"
                                            },
                                            {
                                                "example_id": "3c7c32d0-df17-40c9-adf6-11e149bd8fee",
                                                "sense_id": "4355af90-19e1-3377-85b2-a1e04acc3f88",
                                                "text": "„Um Ihre Wasserturbine optimal betreiben zu können, bieten wir neben dem Turbinenbau auch das gesamte notwendige elektromechanische Zubehör für Ihre Wasserturbine.“"
                                            },
                                            {
                                                "example_id": "fbcf1c63-3907-4a37-ab83-a88bc3e2bcb5",
                                                "sense_id": "4355af90-19e1-3377-85b2-a1e04acc3f88",
                                                "text": "„Die modernen Wasserturbinen in den Wasserkraftwerken bringen heute sehr hohe Leistungen.“"
                                            }
                                        ],
