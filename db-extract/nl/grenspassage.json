                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ed412a-80f4-4b47-8e5e-086f6d358c99",
                                "sense_id": "c1f235a7-4a93-3551-982e-d69dbd31b6f3",
                                "text": "Overigens is niet bij elke illegale grenspassage een smokkelaar betrokken. Maar wie wel tegen betaling de oversteek waagt, betaalt daar grof geld voor. De bedragen kunnen oplopen tot wel 10.000 Britse pond (bijna 12.000 euro)."
                            }
                        ]
                    },
