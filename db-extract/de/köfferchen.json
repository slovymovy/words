                "senses": [
                    {
                        "sense_id": "e2c626f5-d4a7-311d-9664-5eff5c964db5",
                        "entry_id": "41f675d4-296c-3b40-b80b-f24615e1dfd3",
                        "glosses": [
                            "kleiner Koffer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9651fc04-24a4-4c81-9413-2ca3f30fa41b",
                                "sense_id": "e2c626f5-d4a7-311d-9664-5eff5c964db5",
                                "text": "„Auch ich bekam ein Köfferchen für meine Sachen.“"
                            },
                            {
                                "example_id": "069b6557-f5b2-451a-a30c-b64b74810a8d",
                                "sense_id": "e2c626f5-d4a7-311d-9664-5eff5c964db5",
                                "text": "„Er sah sein Köfferchen an.“"
                            },
                            {
                                "example_id": "e64815e7-15a7-426c-a8c2-5b592a96968c",
                                "sense_id": "e2c626f5-d4a7-311d-9664-5eff5c964db5",
                                "text": "„Ich trug mein Köfferchen zum Parnassus.“"
                            },
                            {
                                "example_id": "cd278472-1ddd-464d-ba47-2f4675c76aee",
                                "sense_id": "e2c626f5-d4a7-311d-9664-5eff5c964db5",
                                "text": "„Sie weckten also Miles und Archie Schwert und stahlen sich zehn Minuten später, ihre Köfferchen in der Hand, aus dem »Royal George« davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
