                ],
                "senses": [
                    {
                        "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                        "entry_id": "d08efacf-7683-3457-8a65-020ba0ffebee",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aafbbf5-ef89-43fe-ae83-45b8592214a5",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Frau Winterle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e8408d3b-2b19-4810-8473-d9ccef2dccd3",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Herr Winterle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b72e09c-5e6e-41c0-a47e-af227564707f",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Die Winterles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8fed0b08-c8b9-4c63-8b4f-3754267a7cf7",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Der Winterle trägt nie die Pullover, die die Winterle ihm strickt."
                            },
                            {
                                "example_id": "ac79cbb3-97f8-4e10-afdc-f5291025bea4",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Winterle kommt, geht der Herr Winterle.“"
                            },
                            {
                                "example_id": "b88e075d-b6cf-4d5f-9469-54900eb70603",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Winterle kommt und geht."
                            },
                            {
                                "example_id": "e9146dd6-039f-4f82-917a-e0b856290b5b",
                                "sense_id": "4457d1f8-766b-3df4-8131-5f6011359be3",
                                "text": "Winterles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
