                "senses": [
                    {
                        "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                        "entry_id": "7effa8a4-c51c-3d0d-9120-1372cf092251",
                        "glosses": [
                            "das Nichtvorhandensein von Wissen; das Fehlen von Bildung (in einem bestimmten Bereich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578668e2-7bb9-401e-97b0-f2c4a7a336d3",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "Die Bildungslücken mancher Mitarbeiter freier Projekte sind verheerend."
                            },
                            {
                                "example_id": "79681d1a-8a5a-45be-8e13-a4bf8fd736b1",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "Wer in Deutschland 'Goethe' mit 'ö' schreibt, offenbart eine Bildungslücke."
                            },
                            {
                                "example_id": "40b57c52-7120-42b6-b7d7-394a9e55c763",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "Gravierende Bildungslücken sind der Kollateralschaden der COVID-19-Pandemie und das trotz Distanz- und Wechselunterrichts."
                            },
                            {
                                "example_id": "73fe85b5-79ca-4865-8625-e1d5cc6cd30d",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "[Coronapandemie 2020:] „In normalen Schuljahren gibt es den „Summer Gap“: Bildungslücken bei benachteiligten Schülern und Schülerinnen. Nun komme noch ein „Pandemie-Gap“ dazu, warnen Wiener Forscher.“"
                            },
                            {
                                "example_id": "33b28129-edaf-4778-aa9d-c82a92263422",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "[Alexandra Bosek, Bundes- und AHS-Landesschulsprecherin, sagt,] „dass es im Distance-Learning, trotz der weiterentwickelten Digitalisierung, Bildungslücken gibt und der Unterricht nicht dieselbe Qualität haben kann, wie der Präsenzunterreicht“."
                            },
                            {
                                "example_id": "8a1962d6-e0eb-4ab2-a4c3-4837f86984dc",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Lehrkräfte und Bildungsexperten warnen schon jetzt: Kindern aus sozial schwächeren Familien könnten durch die Corona-Krise noch weiter ins Hintertreffen geraten. So verschärft die Krise die Bildungslücke, die auch in normalen Zeiten schon problematisch ist.“"
                            },
                            {
                                "example_id": "f2c76e29-eff0-4501-b077-ab8b8a436da0",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„[…] 47 Lehrer versuchen nun […] einen kindgerechten Alltag zu ermöglichen und Bildungslücken zu schließen.“"
                            },
                            {
                                "example_id": "ffec1ce1-6fc7-47a3-a858-03ee8dc07486",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Mädchen werden heute häufiger eingeschult und die weltweite Bildungslücke zwischen Jungen und Mädchen hat sich verkleinert.“"
                            },
                            {
                                "example_id": "edceb85d-7ee6-4d0c-a326-449c67aa1fd7",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "Nach einer Präsentation und einer interessanten Diskussion mit Geschäftsführung und Publikum geht's weiter in die Innenstadt – und ich muss gestehen, dass ich eine Bildungslücke hatte: Dresden ist grandios!"
                            },
                            {
                                "example_id": "f96c005d-8e31-4ac3-9e90-f8bfe253de44",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Zwar wehte um sie die Luft der jungen Rebellion, APO oder dergleichen, aber eine richtige Studentin war sie wohl nicht, sie hatte breite Bildungslücken und trumpfte mit ihnen auf.“"
                            },
                            {
                                "example_id": "b69f091b-611a-41ac-862e-0f108d8369f9",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Philosophische Kaffees, Salons und Gesellschaften gibt es in Bayern viele. Zum Teil steht das Interesse an philosophischen Ideen im Vordergrund, zum Teil möchten die Teilnehmer Bildungslücken aus der Schule schließen.“"
                            },
                            {
                                "example_id": "69a42bd5-e18f-4989-ac9f-1f535adb405f",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Wissen Sie eigentlich, was auf dem 100-Euro-Schein abgedruckt ist? Oder einfacher - auf dem 5-Euro-Schein? Auch wenn Sie gerade nicht darauf kommen, die kleine Bildungslücke ist zu verzeihen: Denn nach und nach verschwinden die Geldscheine aus unserem Alltag.“"
                            },
                            {
                                "example_id": "da1782fb-7813-4fa8-a1c8-4105e7ea8fa1",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Tatsächlich sind wir fast alle finanzwirtschaftliche Analphabeten. Denn es gibt kein Fach oder Lernfeld \"Finanzen\" in den allgemein bildenden Schulen. Doch die Bildungslücke lässt sich nicht allein durch finanzielle Allgemeinbildung schließen.“"
                            },
                            {
                                "example_id": "ece7c52f-95d7-43ad-9a00-3ebfee28d673",
                                "sense_id": "90bcaa50-59e6-3aa1-9a6b-55ca36142a26",
                                "text": "„Aus den Bildungslücken über die 'Funktionslogik' des Bundestages resultieren falsche Erwartungen an die Politik und – da diese nicht erfüllt werden – Kritik am parlamentarischen System insgesamt, schließlich Politik- und Systemverdrossenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
