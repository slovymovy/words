                        "cross_references": [
                            {
                                "target_word": "supernatural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                        "entry_id": "dcd417ed-0515-35dc-acc6-c5f5a5f61946",
                                        "glosses": [
                                            "Above nature; beyond or added to nature, often so considered because it is given by a deity or some force beyond that with which humans are born."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee236ad9-bc4b-4a21-b71f-16d621257ed0",
                                                "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                                "text": "Near-synonym: paranatural"
                                            },
                                            {
                                                "example_id": "f2366fa3-1201-4795-8202-eb7c750ffad6",
                                                "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                                "text": "In Roman Catholic theology, sanctifying grace is considered to be a supernatural addition to human nature."
                                            },
                                            {
                                                "example_id": "ffe784aa-ca86-4671-9667-205cddc49ec1",
                                                "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                                "text": "Stephen King's first novel is about a girl named Carrie dealing with supernatural powers."
                                            },
                                            {
                                                "example_id": "ea4b38b0-ee4e-4033-8246-80b89ace75ac",
                                                "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                                "text": "We know from their literature that to our Saxon ancestors waste places of moor and forest and marshes were the resort of a host of supernatural creatures at enmity with mankind."
                                            },
                                            {
                                                "example_id": "b14c319c-e728-4a57-bd63-b5935cfa033b",
                                                "sense_id": "b7d9c691-51a8-3233-b623-b15b9c748780",
                                                "text": "March 14, 2018, Roger Penrose writing in The Guardian, Mind over matter': Stephen Hawking – obituary\nAs with the Delphic oracle of ancient Greece, physical impairment seemed compensated by almost supernatural gifts, which allowed his mind to roam the universe freely, upon occasion enigmatically revealing some of its secrets hidden from ordinary mortal view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "718c083d-a7a5-3924-a406-200e8bb3884a",
                                        "entry_id": "dcd417ed-0515-35dc-acc6-c5f5a5f61946",
                                        "glosses": [
                                            "Not of the usual; not natural; altered by forces that are not understood fully, if at all."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4387a1c-c4f5-4271-9a43-bfe15a785dd1",
                                                "sense_id": "718c083d-a7a5-3924-a406-200e8bb3884a",
                                                "text": "Near-synonym: paranatural"
                                            },
                                            {
                                                "example_id": "09805151-01b1-4f00-96ce-60dfdb73116a",
                                                "sense_id": "718c083d-a7a5-3924-a406-200e8bb3884a",
                                                "text": "The house is haunted by supernatural forces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supernatural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c44300d1-8cc6-3064-a238-9130c0fadadb",
