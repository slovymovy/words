                "senses": [
                    {
                        "sense_id": "a9c434d7-f6cd-3982-9321-47f15c362b25",
                        "entry_id": "be5b050c-e992-3ee4-911d-265200f64abe",
                        "glosses": [
                            "Schmuckgegenstand, dem magische Kräfte nachgesagt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7bb759e-0f3a-4536-a924-72bf76610b6f",
                                "sense_id": "a9c434d7-f6cd-3982-9321-47f15c362b25",
                                "text": "Sie trug ein goldenes Amulett um den Hals."
                            },
                            {
                                "example_id": "a40c5025-9a4d-4cc4-89e0-22d99f3dec48",
                                "sense_id": "a9c434d7-f6cd-3982-9321-47f15c362b25",
                                "text": "„Mit Amuletten, die um den Hals getragen oder im Hause aufgehängt wurden, suchte man sich vor dem Zugriff der Geister zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "790fe02e-fec7-4dc9-9a12-d958b28c311e",
                        "source_entry_id": "be5b050c-e992-3ee4-911d-265200f64abe",
                        "source_sense_id": "a9c434d7-f6cd-3982-9321-47f15c362b25",
                        "source_sense_description": "Schmuckgegenstand, dem magische Kräfte nachgesagt werden",
                        "target_lang_word": "amulet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amulet",
