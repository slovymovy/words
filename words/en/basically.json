                {
                    "sense_id": "9ab4627c-bd1e-33ff-83b4-070a85151c9f",
                    "sense_definition": "Used to introduce the most important point or a simplified explanation of a situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "So <w>basically</w>, we missed the train and had to walk home.",
                            "target_lang_translations": {
                                "ru": "Так что, <w>короче говоря</w>, мы опоздали на поезд, и нам пришлось идти домой пешком.",
                                "zh": "所以<w>简单来说</w>，我们错过了火车，不得不走路回家。",
                                "pl": "Więc <w>krótko mówiąc</w>, spóźniliśmy się na pociąg i musieliśmy wracać do domu pieszo.",
                                "tr": "Yani <w>kısacası</w>, treni kaçırdık ve eve yürümek zorunda kaldık.",
                                "nl": "Dus <w>kort gezegd</w> misten we de trein en moesten we naar huis lopen.",
                                "de": "Also <w>kurz gesagt</w>, wir haben den Zug verpasst und mussten zu Fuß nach Hause gehen.",
                                "fr": "Donc <w>en gros</w>, nous avons raté le train et avons dû rentrer à pied.",
                                "it": "Quindi, <w>in pratica</w>, abbiamo perso il treno e siamo dovuti tornare a casa a piedi.",
                                "cs": "Takže <w>zkrátka</w> nám ujel vlak a museli jsme jít domů pěšky.",
                                "es": "Así que, <w>básicamente</w>, perdimos el tren y tuvimos que caminar a casa."
                            }
                        },
                        {
                            "text": "Well, <w>basically</w>, I do not agree with the decision.",
                            "target_lang_translations": {
                                "ru": "Ну, <w>по сути</w>, я не согласен с этим решением.",
                                "zh": "嗯，<w>其实</w>我并不赞同这个决定。",
                                "pl": "Cóż, <w>tak naprawdę</w>, nie zgadzam się z tą decyzją.",
                                "tr": "Şey, <w>aslında</w> bu karara katılmıyorum.",
                                "nl": "Nou, <w>eigenlijk</w> ben ik het niet eens met de beslissing.",
                                "de": "Nun, <w>im Grunde</w> bin ich mit der Entscheidung nicht einverstanden.",
                                "fr": "Eh bien, <w>au fond</w>, je ne suis pas d'accord avec cette décision.",
                                "it": "Beh, <w>in sostanza</w>, non sono d'accordo con la decisione.",
                                "cs": "No, <w>vlastně</w> s tím rozhodnutím nesouhlasím.",
                                "es": "Bueno, <w>en resumidas cuentas</w>, no estoy de acuerdo con la decisión."
                            }
                        }
