                        "examples": [
                            {
                                "example_id": "cb639e39-0782-48d9-9e78-8dc17621c9c4",
                                "sense_id": "ad198ebc-e8a6-3383-8117-c002d5dfe384",
                                "text": "De International Chamber of Shipping, de internationale redersvereniging, noemt het voorstel gedurfd en prijst de haalbaarheid en controleerbaarheid ervan."
                            },
                            {
                                "example_id": "9e1ce708-4bbd-4071-b8b7-c0fce0dd4e01",
                                "sense_id": "ad198ebc-e8a6-3383-8117-c002d5dfe384",
                                "text": "In sommige steden gelden al strenge regels voor verkamering. Gemeenten moeten hiervoor een vergunning geven. Maar het opkoopverbod moet gemeenten helpen beleggers helemaal te blokkeren. De controleerbaarheid van de maatregel zal volgens Boelhouwer weinig problemen opleveren."
                            },
                            {
                                "example_id": "bb5ab95e-fa87-4dfc-8beb-d6edc597ec05",
                                "sense_id": "ad198ebc-e8a6-3383-8117-c002d5dfe384",
                                "text": "Wel stelt de Vereniging Nederlandse Gemeenten in de Handreiking integriteit van politieke ambtsdragers bij gemeenten, provincies en waterschappen (.pdf) dat waakzaamheid is geboden als politieke ambtsdragers grond of onroerend goed aankopen. \"Zorgvuldigheid, openheid en controleerbaarheid zijn hier sleutelwoorden\", schrijft de vereniging."
                            }
                        ]
