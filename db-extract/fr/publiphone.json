                "translations": [
                    {
                        "translation_id": "eae275cb-893b-4af2-be61-879eca502a26",
                        "source_entry_id": "be5e13b3-646f-313e-8c7f-0f6a2fa65c80",
                        "source_sense_id": "5fcae10c-565c-35cb-ae73-555350c92673",
                        "source_sense_description": "Telekommunikation: öffentliche Telefonzelle mit einem Kartentelefon",
                        "target_lang_word": "Telefonzelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telefonzelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                        "entry_id": "42cb3741-5c3e-33a0-96bd-b919b041ebbd",
                                        "glosses": [
                                            "Überdachung für ein Gemeinschaftshandy an der Schnur mit Münzeinwurf ohne Wischfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0f902c6-8423-4955-bcf5-d75041e4df01",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "Ich rufe aus einer Telefonzelle an."
                                            },
                                            {
                                                "example_id": "828ed82c-85cc-41ca-b06d-db729a396cbd",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "Ich konnte nicht anrufen, da die Telefonzelle besetzt war."
                                            },
                                            {
                                                "example_id": "614c7bdc-8946-4ded-8eaf-cc5990e9e40c",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "„Der Kommissar eilt auf die nächste Telefonzelle zu.“"
                                            },
                                            {
                                                "example_id": "e2e92f98-fb8b-43b0-b773-f5ae05e1be33",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "„Er hielt bei einer Telefonzelle an.“"
                                            },
                                            {
                                                "example_id": "7dc08ad8-4470-4a41-8010-607893cc00ef",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "„Mit raschen Schritten, Münzen in der Hand abwiegend, überquert er die Straße und strebt einer Telefonzelle an der nächsten Ecke zu.“"
                                            },
                                            {
                                                "example_id": "a3ff4faa-65de-415c-b80d-d771e1880815",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "„Wahrscheinlich muss ich bald mit meiner Tochter in ein Museum gehen, um ihr eine Telefonzelle zu zeigen.“"
                                            },
                                            {
                                                "example_id": "ae104a62-f303-4f73-bb2e-aacc528406fe",
                                                "sense_id": "e5c4d10b-ccd7-3ebb-8bf7-44ad0005b3b1",
                                                "text": "„Dort lagert die Deutsche Telekom ihre ausgedienten Telefonzellen. Es sind Tausende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
