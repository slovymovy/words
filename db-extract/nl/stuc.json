                                        "sense_id": "97b1da08-61ab-3c96-9728-e4402bd877e1",
                                        "entry_id": "f7279791-d3be-303c-a82f-97dfae9b9d0c",
                                        "glosses": [
                                            "A small adhesive bandage to cover a minor wound; a sticking plaster."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada",
                                            "New-Zealand",
