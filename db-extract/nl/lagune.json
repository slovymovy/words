                        ],
                        "form": "lagunen"
                    },
                    {
                        "form_id": "27924248-54ed-472a-9ba9-ee387ee03b70",
                        "entry_id": "a2c80840-02e3-3011-b21f-af66d5e40cc5",
                        "tags": [
                            "plural"
                        ],
                        "form": "lagunes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                        "entry_id": "a2c80840-02e3-3011-b21f-af66d5e40cc5",
                        "glosses": [
                            "een ondiep meer aan de kust, dat afgesneden is van de zee door een zandbank, een smalle landtong of iets dergelijks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af548349-4d11-4cca-a3ae-6f6898ee6137",
                                "sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                                "text": "Venetië is via een lagune in verbinding met de Adriatische Zee."
                            },
                            {
                                "example_id": "f46753ed-9cb1-47ce-ae00-3afab493d65c",
                                "sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                                "text": "Daarachter ontvouwde zich het tweede deel van het plein, als een verborgen surprise, geflankeerd door het onwereldse dogepaleis, dat leek te zweven met twee breekbaar ogende, opengewerkte benedenverdiepingen onder een stoere, middeleeuwse bovenbouw, en de twee zuilen waarachter het plaveisel zonder muurtje, hek, verkeersbord of waarschuwing overging in het water van Canal Grande, de lagune en de open zee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5c3a9f4-57a9-4b6d-87bf-a8fef0f75944",
                        "source_entry_id": "a2c80840-02e3-3011-b21f-af66d5e40cc5",
                        "source_sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                        "source_sense_description": "ondiep meer",
                        "target_lang_word": "Lagune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                        "entry_id": "b33781d5-ee14-3f9a-8e0d-b87119dd315e",
                                        "glosses": [
                                            "vom Meer abgetrenntes Gewässer"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fde60bf-b1d3-404b-99a4-6160475ca8fe",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "In der Lagune konnten die Fischer vor kleinen Stürmen sicher sein."
                                            },
                                            {
                                                "example_id": "7940a8fa-6002-4e5d-b272-7651725a66cd",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Oberhalb einer Lagune in einem Talkessel gelegen, scheint hier die Zeit stillzustehen.“"
                                            },
                                            {
                                                "example_id": "b7d0eb4e-579b-4aee-8279-27372184edd7",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Dann waren wir in der Lagune, die im Mondlicht dunkel und ruhig dalag.“"
                                            },
                                            {
                                                "example_id": "c246dca1-bc37-4f1d-b249-9ec8eff593bb",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Wir legten als Ziel die Pforte fest, die auf die Lagune führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "973c2699-bf33-4386-aa2d-2c45593d66bf",
                        "source_entry_id": "a2c80840-02e3-3011-b21f-af66d5e40cc5",
                        "source_sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                        "source_sense_description": "ondiep meer",
                        "target_lang_word": "Haff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b25a940-98fe-386c-b92b-1863775e1817",
                                        "entry_id": "c7766bb2-1c77-3375-9500-8cc54f23f4cb",
                                        "glosses": [
                                            "Brackwasser-Lagune an der Ostsee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c43cc2c-8539-4955-920c-8e2475084f6a",
                                                "sense_id": "7b25a940-98fe-386c-b92b-1863775e1817",
                                                "text": "Die Nehrung trennt das Haff vom Meer."
                                            },
                                            {
                                                "example_id": "28037f1b-d10c-4529-bc1a-7c7a68dbacbf",
                                                "sense_id": "7b25a940-98fe-386c-b92b-1863775e1817",
                                                "text": "„Sein Blick streift über die schmale Nehrung, die das Haff nach Norden hin fast zum Binnensee macht.“"
                                            },
                                            {
                                                "example_id": "a1eadfd0-0061-4001-b15c-c87338743a9a",
                                                "sense_id": "7b25a940-98fe-386c-b92b-1863775e1817",
                                                "text": "„Damit die Fischer in Ruhe ihrer Arbeit nachgehen konnten, schuf sie einen Sandwall, der das fischreiche Gewässer des Haffs vor den Meeresfluten schützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b166af04-3d9d-4a46-8539-73d273c35678",
                        "source_entry_id": "a2c80840-02e3-3011-b21f-af66d5e40cc5",
                        "source_sense_id": "cba69a61-d8e3-30ea-8faa-caf938b45b32",
                        "source_sense_description": "ondiep meer",
                        "target_lang_word": "Botten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
