                    },
                    {
                        "form_id": "06c4339a-c84d-47de-aaf8-45ca0216ecf5",
                        "entry_id": "1045473e-451b-3f49-93e1-d3765092436f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Starkregen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                        "entry_id": "1045473e-451b-3f49-93e1-d3765092436f",
                        "glosses": [
                            "heftiger Niederschlag von mehr als 10 l/m² pro Stunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3149e20-0461-4483-b7d1-c72bafb412b6",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "Starkregen nennt man in der Meteorologie große Mengen an flüssigen oder schnell schmelzenden Niederschlägen, die in kurzer Zeit fallen."
                            },
                            {
                                "example_id": "f133cb19-e439-4de5-ab56-3d0e74224f94",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "„Es wird durch entsprechendes Monitoring nachzuhalten sein, ob in Zukunft die Häufigkeit und Intensität der Starkregen wieder abnimmt oder auf einem hohen Niveau verbleibt.“"
                            },
                            {
                                "example_id": "b04161d3-9985-4838-b73a-ac43883efdfd",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "„Von Starkregen spricht man bei großen Niederschlagsmengen pro Zeiteinheit.“"
                            },
                            {
                                "example_id": "db941df9-cec9-45b7-ab43-112148826617",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "„Am Nachmittag werden schwere Gewitter mit Starkregen und örtlich auch Hagel erwartet.“"
                            },
                            {
                                "example_id": "98753441-9202-4145-8922-7491ba182d35",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "„Eine exakte Vorhersage von Zeitpunkt und Ort eines Starkregens ist derzeit nahezu unmöglich.“"
                            },
                            {
                                "example_id": "f3d605bc-f168-467d-849e-9b02830a5652",
                                "sense_id": "54ccb4ff-dc7e-3aa4-bd96-1c855c694151",
                                "text": "„Die Talsperre drohte aufgrund des stundenlangen Starkregens zeitweise überzulaufen, das Wasser schwappte bereits über die Dammkrone der Staumauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
