        "fr-extract.jsonl": [
            {
                "entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                "word": "insoumission",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6153b037-b561-43f2-9357-096e575a9a61",
                        "entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                        "tags": [
                            "plural"
                        ],
                        "form": "insoumissions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f7002db-40d4-39b6-9a3f-d6cd9a976234",
                        "entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                        "glosses": [
                            "Comportement de ceux qui refusent une soumission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a4ae2e-bfb4-42bd-a294-8d9dcefa89b5",
                                "sense_id": "1f7002db-40d4-39b6-9a3f-d6cd9a976234",
                                "text": "L'individualisme libertaire, l'insoumission aux nécessités fondamentales d'une société la dissolvent."
                            },
                            {
                                "example_id": "11a082b1-c6b4-4f45-bc40-fbf4ae82e0bc",
                                "sense_id": "1f7002db-40d4-39b6-9a3f-d6cd9a976234",
                                "text": "Si des membres du Congrès s’obstinent dans leur insoumission, une procédure pourrait être engagée pour les destituer. Vous pensez que j’exagère ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "cf1c774f-8793-350a-9495-e5f0295b2753",
                        "entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                        "glosses": [
                            "Acte d’un subordonné qui désobéit délibérément à un ordre légal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff263fb-d799-413b-a944-4123a77e2330",
                                "sense_id": "cf1c774f-8793-350a-9495-e5f0295b2753",
                                "text": "Seule planait l’ombre de la Kampétaï, prête à abattre sa lourde main supplicieuse pour étouffer dans l'œuf toute velléité d’insoumission."
                            }
                        ]
                    },
                    {
                        "sense_id": "07a7e3ab-0f62-3f5e-891d-0f50521b0811",
                        "entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                        "glosses": [
                            "refus d'un militaire de rejoindre son unité dans les délais impartis."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "079df47c-5a4b-4b05-a992-44482a1dab91",
                        "source_entry_id": "e02b1f0a-3894-3000-ac30-4f747bd2eeda",
                        "target_lang_word": "verzet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1a964624-7ce9-3584-9391-062c888939e1",
                                        "entry_id": "9afa1aac-4fac-3844-bae0-8d31b823164d",
                                        "glosses": [
                                            "handelingen gericht tegen de heersende macht of de aanvallende vijand alsmede de personen die die handelingen uitvoeren (de verzetsbeweging)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0873f9bb-5562-4353-af65-1c7a934bbf34",
                                                "sense_id": "1a964624-7ce9-3584-9391-062c888939e1",
                                                "text": "Daarmee werd het verzet voorgoed gebroken."
                                            },
                                            {
                                                "example_id": "e21457ba-b72a-432b-9a60-22fee9bbf648",
                                                "sense_id": "1a964624-7ce9-3584-9391-062c888939e1",
                                                "text": "Gedurende het dappere maar zinloze verzet brachten ze drie Duitse kruisers en meerdere torpedojagers tot zinken, vooral in het noorden leden de Duitsers zware verliezen."
                                            },
                                            {
                                                "example_id": "db99938e-e4e7-4cf4-a40e-6f2abc06a391",
                                                "sense_id": "1a964624-7ce9-3584-9391-062c888939e1",
                                                "text": "'De teerling is geworpen en in ons voordeel gevallen, en het verzet van het gepeupel en het kabaal van hun geschreeuw en hun schoten dat je overal hoort, heeft geen enkele zin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5c1670-9604-3b3e-aad6-3f7c7de4f5e2",
                                        "entry_id": "9afa1aac-4fac-3844-bae0-8d31b823164d",
                                        "glosses": [
                                            "weerstand tegen bepaalde psychologische, emotionele inzichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "089bdd17-35fb-4038-8184-dbe5f81012bb",
                                                "sense_id": "6f5c1670-9604-3b3e-aad6-3f7c7de4f5e2",
                                                "text": "Op mijn verzet en verongelijktheid, en mijn schaamte over dat verzet en die verongelijktheid, volgde de berusting."
                                            },
                                            {
                                                "example_id": "280bf7e2-e404-4132-b429-d9aeb7c52eaa",
                                                "sense_id": "6f5c1670-9604-3b3e-aad6-3f7c7de4f5e2",
                                                "text": "'Je weet dat jouw pijn in je verzet zit, hè?' Ze glimlacht en drinkt voorzichtig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d6a11a-f935-35f4-9062-f60ca02dcbb4",
                                        "entry_id": "9afa1aac-4fac-3844-bae0-8d31b823164d",
                                        "glosses": [
                                            "de van de stand van de versnellingen afhangende afstand in meters (verplaatsing) die wordt afgelegd als de pedalen van een fiets één keer rondgaan"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8329de89-9db2-3eec-938e-b506350498ce",
                                        "entry_id": "9afa1aac-4fac-3844-bae0-8d31b823164d",
                                        "glosses": [
                                            "verplaatsing b.v. grondverzet, waterverzet"
                                        ],
                                        "tags": [
                                            "stam van verzetten"
                                        ],
                                        "examples": []
                                    }
                                ]
