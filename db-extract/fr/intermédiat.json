                        "examples": [
                            {
                                "example_id": "09df1f2e-5487-4562-b5af-0f77feaad5c1",
                                "sense_id": "834de6dd-5a01-333e-ab52-a7b4df452738",
                                "text": "Temps intermédiat, intervalle de temps entre deux actions, entre deux termes."
                            },
                            {
                                "example_id": "f7e07a0f-d389-4eb6-89b9-105b3d300111",
                                "sense_id": "834de6dd-5a01-333e-ab52-a7b4df452738",
                                "text": "Lettres d'intermédiat, lettres que le roi accordait pour faire jouir des gages d'un office, depuis la mort du titulaire, jusqu'à ce que le successeur fût pourvu et qu'il eût pris possession."
                            },
                            {
                                "example_id": "27f98c47-ced2-42b2-a447-0cd27eb479c8",
                                "sense_id": "834de6dd-5a01-333e-ab52-a7b4df452738",
                                "text": "Congrégation intermédiate, assemblée qui se tient entre deux chapitres, soit généraux, soit provinciaux."
                            }
                        ]
                    }
