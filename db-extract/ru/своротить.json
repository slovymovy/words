                "senses": [
                    {
                        "sense_id": "8a5fa9f8-fbe8-30d9-bbb8-4dfd91fd4a91",
                        "entry_id": "8f28ef75-effd-3d07-9a9f-2f0f3647ba39",
                        "glosses": [
                            "разг. ворочая, сдвинуть, тронуть с места"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c054ecb-b0c2-442e-9eb6-4d34ed931307",
                                "sense_id": "8a5fa9f8-fbe8-30d9-bbb8-4dfd91fd4a91",
                                "text": "Своротить камень."
                            }
                        ]
                    },
                    {
                        "sense_id": "87a65865-eee2-3ff6-b507-96e9ec28ab2c",
                        "entry_id": "8f28ef75-effd-3d07-9a9f-2f0f3647ba39",
                        "glosses": [
                            "прост. направить вбок, в другую сторону"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5523b1c7-23ee-45eb-8ef5-43c896f121b7",
                                "sense_id": "87a65865-eee2-3ff6-b507-96e9ec28ab2c",
                                "text": "Своротить лошадь."
                            }
                        ]
                    },
                    {
                        "sense_id": "5563aaeb-c7e5-3f31-a042-307fd901478a",
                        "entry_id": "8f28ef75-effd-3d07-9a9f-2f0f3647ba39",
                        "glosses": [
                            "прост. то же, что свернуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c961cf-0c63-4ea9-a7f7-8489d4821c16",
                                "sense_id": "5563aaeb-c7e5-3f31-a042-307fd901478a",
                                "text": "Отсюда свороти влево, да бором иди по тропинке."
                            },
                            {
                                "example_id": "3bb7ee4e-ded4-4a92-9dce-16549c1d112a",
                                "sense_id": "5563aaeb-c7e5-3f31-a042-307fd901478a",
                                "text": "Как ни хитрил, а на то же своротил."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0a8bf6-ce4e-31f0-ab82-0d179e241c03",
                        "entry_id": "8f28ef75-effd-3d07-9a9f-2f0f3647ba39",
                        "glosses": [
                            "прост. свихнуть, вывихнуть, сломать, повредить ударом, побоями, в драке (какой-нибудь орган тела)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c2480d-8e5a-4e9e-af20-49c67f12290b",
                                "sense_id": "1c0a8bf6-ce4e-31f0-ab82-0d179e241c03",
                                "text": "Вышибить зуб, своротить скулу, раскровянить лицо чабану ― то же, что выкурить папиросу."
                            }
                        ]
                    }
