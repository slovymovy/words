    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "508c4eeb-3c50-338e-9c04-d0157120640d",
                    "sense_definition": "Faire des efforts pour parvenir à un résultat ou pour réaliser une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il doit <w>tâcher</w> de finir ses devoirs avant le début du dîner."
                        },
                        {
                            "text": "Nous <w>tâcherons</w> de trouver une solution convenable à cette situation délicate."
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "s'efforcer",
                        "tenter"
                    ],
                    "antonyms": [
                        "renoncer"
                    ],
                    "common_phrases": [
                        "tâcher de"
                    ]
                },
                {
                    "sense_id": "18a13011-9bf6-37d1-ad37-5e928c401d36",
                    "sense_definition": "Veiller à, faire en sorte qu'un événement ou une action ait lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tâche</w> qu'elle arrive à l'heure pour la présentation de demain."
                        },
                        {
                            "text": "Ils doivent <w>tâcher</w> que les invités se sentent parfaitement accueillis ce soir."
                        }
                    ],
                    "synonyms": [
                        "veiller",
                        "s'assurer"
                    ],
                    "common_phrases": [
                        "tâcher que"
                    ]
                },
                {
                    "sense_id": "85d364b5-ce3d-3072-9b55-d1515d280ddd",
                    "sense_definition": "Travailler à la tâche, exécuter un travail assigné à façon.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce grand atelier, chaque artisan <w>tâche</w> à son rythme sans contrainte."
                        },
                        {
                            "text": "Les bûcherons <w>tâchaient</w> sous le soleil sans attendre les ordres du contremaître."
                        }
                    ]
                },
                {
                    "sense_id": "ec751b6a-ffc0-3991-9959-21154e0a1f32",
                    "sense_definition": "Avoir pour objectif, aspirer à atteindre un but.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dramaturge <w>tâchait</w> à renouveler les thèmes traditionnels de la tragédie antique."
                        },
                        {
                            "text": "Certains disciples <w>tâchent</w> à égaler la virtuosité de leur illustre maître."
                        }
                    ],
                    "synonyms": [
                        "viser",
                        "aspirer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi classique ou littéraire avec la préposition à"
                        }
                    ]
                }
            ]
        }
