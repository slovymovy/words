                        "entry_id": "4e4946f4-6dc3-39cb-a9b4-aa4bb8ae87fc",
                        "glosses": [
                            "Beschützer einer Herde von Schweinen"
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b8cfa72-dafb-4ed6-9b3b-06e63c25f0f5",
                                "sense_id": "a2d21225-2bc5-3a6b-a293-185292f673f6",
                                "text": "Wegen des Gewitters wurden die Schweine vom Schweinehirten in die Scheune getrieben."
                            },
                            {
                                "example_id": "be9cbf00-192c-4dcc-95c1-e27f2750b138",
                                "sense_id": "a2d21225-2bc5-3a6b-a293-185292f673f6",
                                "text": "„Der Junker ging mit Ture Narvesen zum Schweinehirten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
