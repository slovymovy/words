    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3599bc5-4ee3-3ed3-ad36-ac29b297287f",
                    "sense_definition": "Avouer une faute, une erreur ou un acte répréhensible.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a fini par <w>confesser</w> son crime après plusieurs heures d'interrogatoire."
                        },
                        {
                            "text": "Elle a préféré <w>confesser</w> sa faute immédiatement pour éviter toute dispute avec ses parents."
                        }
                    ],
                    "synonyms": [
                        "avouer",
                        "reconnaître"
                    ],
                    "antonyms": [
                        "nier",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "confesser sa faute",
                        "confesser son crime"
                    ]
                },
                {
                    "sense_id": "33440532-261e-306a-b4a7-6c69b4e21e39",
                    "sense_definition": "Admettre ou reconnaître un sentiment, une faiblesse ou une réalité difficile à assumer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>confesser</w> que cette tâche dépasse largement mes compétences actuelles."
                        },
                        {
                            "text": "Il n'hésite jamais à <w>confesser</w> la vérité même lorsque la situation devient inconfortable."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "concéder"
                    ],
                    "common_phrases": [
                        "confesser la vérité"
                    ]
                },
                {
                    "sense_id": "24232ab6-8967-3a5e-9243-92c8b90cb60c",
                    "sense_definition": "Déclarer ses péchés à un prêtre pour en recevoir l'absolution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le croyant vient régulièrement <w>confesser</w> ses péchés à l'église avant les célébrations."
                        },
                        {
                            "text": "Il a décidé d'aller se <w>confesser</w> après des années d'absence."
                        }
                    ],
                    "common_phrases": [
                        "confesser ses péchés"
                    ]
                },
                {
                    "sense_id": "a2f41464-7da7-3e78-aaed-94138eb48317",
                    "sense_definition": "Pour un prêtre, recevoir et entendre l'aveu des péchés d'un fidèle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le curé passe son après-midi à <w>confesser</w> les fidèles dans le calme du confessionnal."
                        },
                        {
                            "text": "Ce prêtre âgé a <w>confessé</w> des générations d'habitants dans ce village."
                        }
                    ],
                    "common_phrases": [
                        "confesser les fidèles"
                    ]
                },
                {
                    "sense_id": "5ae396da-34d1-3ea6-9206-f8f7a29bcf66",
                    "sense_definition": "Déclarer et affirmer publiquement sa foi, ses croyances ou ses convictions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "doctrine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a osé <w>confesser</w> sa foi avec fierté malgré les menaces des opposants."
                        },
                        {
                            "text": "Chaque citoyen a le droit légal de <w>confesser</w> sa religion sans crainte de représailles."
                        }
                    ],
                    "synonyms": [
                        "professer",
                        "proclamer"
                    ],
                    "antonyms": [
                        "abjurer",
                        "renier"
                    ],
                    "common_phrases": [
                        "confesser sa foi"
                    ]
                },
                {
                    "sense_id": "ad9a702e-cc75-363f-a071-1b7b76c85c2d",
                    "sense_definition": "Interroger habilement quelqu'un pour lui faire révéler ses secrets ou des confidences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a réussi à <w>confesser</w> le ministre sur ses projets secrets."
                        },
                        {
                            "text": "Elle sait très bien <w>confesser</w> ses amis pour obtenir les dernières nouvelles."
                        }
                    ],
                    "synonyms": [
                        "questionner",
                        "sonder"
                    ],
                    "traits": [
