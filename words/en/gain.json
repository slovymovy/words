{
    "word_family": [
        "gainer",
        "gainful",
        "regain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "901d0b86-f429-3f62-a402-5baad218fee5",
                    "sense_definition": "To get or obtain something that is useful, necessary, or positive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "acquire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked hard to <w>gain</w> the respect of her colleagues.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, чтобы <w>завоевать</w> уважение коллег.",
                                "tr": "Meslektaşlarının saygısını <w>kazanmak</w> için çok çalıştı.",
                                "zh": "她努力工作以<w>赢得</w>同事们的尊重。"
                            }
                        },
                        {
                            "text": "You can <w>gain</w> a lot of experience by volunteering.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>получить</w> большой опыт, занимаясь волонтёрством.",
                                "tr": "Gönüllü olarak çok fazla deneyim <w>edinebilirsiniz</w>.",
                                "zh": "你可以通过志愿服务<w>获得</w>丰富的经验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acquire",
                        "obtain",
                        "get",
                        "earn"
                    ],
                    "common_phrases": [
                        "gain access",
                        "gain control",
                        "gain experience",
                        "gain knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать или приобретать что-то полезное, необходимое или положительное.",
                        "tr": "Yararlı, gerekli veya olumlu bir şeyi elde etmek veya kazanmak.",
                        "zh": "获得或取得有用的、必要的或积极的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приобретать",
                                "target_lang_sense_clarification": "становиться обладателем качества или навыка"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "общий термин для получения чего-либо"
                            },
                            {
                                "target_lang_word": "завоевывать",
                                "target_lang_sense_clarification": "получать с усилием (уважение, доверие)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "saygı, güven veya tecrübe elde etmek"
                            },
                            {
                                "target_lang_word": "edinmek",
                                "target_lang_sense_clarification": "tecrübe veya bilgi elde etmek"
                            },
                            {
                                "target_lang_word": "elde etmek",
                                "target_lang_sense_clarification": "bir şeye sahip olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "得到某物或某种抽象事物"
                            },
                            {
                                "target_lang_word": "赢得",
                                "target_lang_sense_clarification": "通过努力获得尊重或信任"
                            },
                            {
                                "target_lang_word": "积累",
                                "target_lang_sense_clarification": "通过过程获取经验或知识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c64aaa-8fc8-3d18-bbfe-31a48ae1492a",
                    "sense_definition": "To increase in body weight.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>gained</w> ten pounds over the winter holidays.",
                            "target_lang_translations": {
                                "ru": "Он <w>набрал</w> десять фунтов за зимние праздники.",
                                "tr": "Kış tatili boyunca on libre <w>aldı</w>.",
                                "zh": "他在寒假期间<w>增重</w>了十磅。"
                            }
                        },
                        {
                            "text": "The doctor was pleased to see that the baby had <w>gained</w> weight.",
                            "target_lang_translations": {
                                "ru": "Врач был доволен, увидев, что ребёнок <w>набрал</w> вес.",
                                "tr": "Doktor, bebeğin kilo <w>aldığını</w> görmekten memnun oldu.",
                                "zh": "医生很高兴看到婴儿<w>体重增加</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "gain weight",
                        "gain a few pounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в весе (о теле).",
                        "tr": "Vücut ağırlığının artması, kilo almak.",
                        "zh": "体重增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "увеличивать массу тела"
                            },
                            {
                                "target_lang_word": "поправляться",
                                "target_lang_sense_clarification": "становиться полнее"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kilo almak",
                                "target_lang_sense_clarification": "vücut ağırlığını artırmak"
                            },
                            {
                                "target_lang_word": "almak",
                                "target_lang_sense_clarification": "kilo ifadesiyle birlikte kullanılır"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增重",
                                "target_lang_sense_clarification": "体重增加的正式说法"
                            },
                            {
                                "target_lang_word": "长胖",
                                "target_lang_sense_clarification": "变得更胖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "298771d7-3f51-3a8b-b86d-025a0560d981",
                    "sense_definition": "To increase in amount, magnitude, speed, or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>gained</w> speed as it went down the hill.",
                            "target_lang_translations": {
                                "ru": "Машина <w>набирала</w> скорость, спускаясь с холма.",
                                "tr": "Araba yokuş aşağı inerken hız <w>kazandı</w>.",
                                "zh": "汽车下坡时速度<w>加快</w>了。"
                            }
                        },
                        {
                            "text": "The movement has <w>gained</w> momentum in recent weeks.",
                            "target_lang_translations": {
                                "ru": "Движение <w>набрало</w> обороты за последние недели.",
                                "tr": "Hareket son haftalarda ivme <w>kazandı</w>.",
                                "zh": "这项运动在最近几周<w>势头增强</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "increase",
                        "gather",
                        "pick up"
                    ],
                    "common_phrases": [
                        "gain speed",
                        "gain momentum",
                        "gain time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в количестве, величине, скорости или степени.",
                        "tr": "Miktar, büyüklük, hız veya derecede artış göstermek.",
                        "zh": "在数量、程度、速度或规模上增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "о скорости, темпе или высоте"
                            },
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "делать больше по величине"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "hız veya ivme artırmak"
                            },
                            {
                                "target_lang_word": "artırmak",
                                "target_lang_sense_clarification": "miktarını veya derecesini çoğaltmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "使数量或程度变大"
                            },
                            {
                                "target_lang_word": "加快",
                                "target_lang_sense_clarification": "指速度的提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ea06a99-1558-3785-82a6-0a878a050dec",
                    "sense_definition": "To receive an advantage, benefit, or profit from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benefit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is nothing to <w>gain</w> from arguing about the past.",
                            "target_lang_translations": {
                                "ru": "Спорами о прошлом ничего не <w>выиграешь</w>.",
                                "tr": "Geçmiş hakkında tartışmaktan <w>kazanılacak</w> hiçbir şey yok.",
                                "zh": "争论过去的事情没有任何<w>益处</w>。"
                            }
                        },
                        {
                            "text": "Both companies will <w>gain</w> from this new partnership.",
                            "target_lang_translations": {
                                "ru": "Обе компании <w>выиграют</w> от этого нового партнёрства.",
                                "tr": "Her iki şirket de bu yeni ortaklıktan fayda <w>sağlayacak</w>.",
                                "zh": "两家公司都将从这次新的合作中<w>获益</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "benefit",
                        "profit"
                    ],
                    "common_phrases": [
                        "gain from",
                        "gain by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать преимущество, выгоду или прибыль от чего-либо.",
                        "tr": "Bir şeyden avantaj, fayda veya kâr elde etmek.",
                        "zh": "从某事中获得优势、利益或利润。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выигрывать",
                                "target_lang_sense_clarification": "получать преимущество"
                            },
                            {
                                "target_lang_word": "извлекать пользу",
                                "target_lang_sense_clarification": "получать выгоду"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "avantaj veya kâr elde etmek"
                            },
                            {
                                "target_lang_word": "faydalanmak",
                                "target_lang_sense_clarification": "yarar sağlamak"
                            },
                            {
                                "target_lang_word": "kâr sağlamak",
                                "target_lang_sense_clarification": "maddi veya manevi kazanç elde etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获益",
                                "target_lang_sense_clarification": "得到好处"
                            },
                            {
                                "target_lang_word": "获利",
                                "target_lang_sense_clarification": "获得经济上的利润"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa33910c-e188-37e1-bbd6-43ec5f91ce6c",
                    "sense_definition": "To win a competition, battle, or legal case.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "win",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army <w>gained</w> a decisive victory on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Армия <w>одержала</w> решительную победу на поле битвы.",
                                "tr": "Ordu savaş meydanında kesin bir zafer <w>kazandı</w>.",
                                "zh": "军队在战场上<w>赢得</w>了决定性的胜利。"
                            }
                        },
                        {
                            "text": "They hoped to <w>gain</w> the seat in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Они надеялись <w>получить</w> место на предстоящих выборах.",
                                "tr": "Yaklaşan seçimde koltuğu <w>elde etmeyi</w> umuyorlardı.",
                                "zh": "他们希望在即将到来的选举中<w>获得</w>席位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "win"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "gain a victory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выигрывать соревнование, битву или судебное дело.",
                        "tr": "Bir yarışmayı, savaşı veya davayı kazanmak.",
                        "zh": "在竞争、战斗或法律诉讼中获胜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одерживать",
                                "target_lang_sense_clarification": "используется со словом победа"
                            },
                            {
                                "target_lang_word": "выигрывать",
                                "target_lang_sense_clarification": "побеждать в состязании"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "добиваться места или позиции"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "zafer, seçim veya mücadelede üstün gelmek"
                            },
                            {
                                "target_lang_word": "elde etmek",
                                "target_lang_sense_clarification": "makam veya koltuk kazanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赢得",
                                "target_lang_sense_clarification": "在竞争中胜出"
                            },
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "取得职位或席位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5afea2fa-bde7-34ea-a3cd-5d8dea00f658",
                    "sense_definition": "To get closer to someone or something that one is chasing or competing against.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "catch_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police car was <w>gaining</w> on the speeding suspect.",
                            "target_lang_translations": {
                                "ru": "Полицейская машина <w>нагоняла</w> подозреваемого, превысившего скорость.",
                                "tr": "Polis arabası hız yapan şüpheliye <w>yaklaşıyordu</w>.",
                                "zh": "警车正在<w>追上</w>超速行驶的嫌疑人。"
                            }
                        },
                        {
                            "text": "Although he started late, he is <w>gaining</w> ground on the leader.",
                            "target_lang_translations": {
                                "ru": "Хотя он стартовал поздно, он <w>нагоняет</w> лидера.",
                                "tr": "Geç başlamasına rağmen liderle arasındaki arayı <w>kapatıyor</w>.",
                                "zh": "尽管他起步较晚，但他正在<w>赶上</w>领先者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gain on",
                        "gain ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближаться к кому-то или чему-то, кого преследуешь или с кем соревнуешься.",
                        "tr": "Takip edilen veya yarışılan birine/bir şeye yaklaşmak, aradaki mesafeyi kapatmak.",
                        "zh": "靠近正在追赶或竞争的对象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагонять",
                                "target_lang_sense_clarification": "сокращать дистанцию"
                            },
                            {
                                "target_lang_word": "догонять",
                                "target_lang_sense_clarification": "приближаться к лидеру"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaklaşmak",
                                "target_lang_sense_clarification": "aradaki mesafeyi azaltmak"
                            },
                            {
                                "target_lang_word": "yetişmek",
                                "target_lang_sense_clarification": "öndekini yakalamaya başlamak"
                            },
                            {
                                "target_lang_word": "arayı kapatmak",
                                "target_lang_sense_clarification": "farkı azaltmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追上",
                                "target_lang_sense_clarification": "缩短与前者的距离"
                            },
                            {
                                "target_lang_word": "赶上",
                                "target_lang_sense_clarification": "在竞争中缩小差距"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e995dcfd-9b90-3bcb-a9cd-5532a2c5e65a",
                    "sense_definition": "To reach a specific destination, often after significant effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers finally <w>gained</w> the summit after hours of struggle.",
                            "target_lang_translations": {
                                "ru": "Альпинисты наконец <w>достигли</w> вершины после нескольких часов борьбы.",
                                "tr": "Dağcılar saatler süren mücadelenin ardından sonunda zirveye <w>ulaştı</w>.",
                                "zh": "经过数小时的攀登，登山者们终于<w>抵达</w>了顶峰。"
                            }
                        },
                        {
                            "text": "We managed to <w>gain</w> the shore before the storm hit.",
                            "target_lang_translations": {
                                "ru": "Нам удалось <w>добраться до</w> берега до начала шторма.",
                                "tr": "Fırtına vurmadan önce karaya <w>ulaşmayı</w> başardık.",
                                "zh": "我们在暴风雨来临前成功<w>到达</w>了岸边。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reach",
                        "arrive at"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигать определенного места назначения, часто после значительных усилий.",
                        "tr": "Genellikle büyük çaba harcayarak belirli bir hedefe veya yere ulaşmak.",
                        "zh": "到达特定目的地，通常需要付出巨大努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "добираться до труднодоступного места"
                            },
                            {
                                "target_lang_word": "добираться до",
                                "target_lang_sense_clarification": "попадать в место назначения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ulaşmak",
                                "target_lang_sense_clarification": "hedeflenen yere varmak"
                            },
                            {
                                "target_lang_word": "varmak",
                                "target_lang_sense_clarification": "bir noktaya erişmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到达",
                                "target_lang_sense_clarification": "抵达某地"
                            },
                            {
                                "target_lang_word": "抵达",
                                "target_lang_sense_clarification": "经过努力到达目的地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0161f701-6b24-3f19-8580-d40ee864b6c0",
                    "sense_definition": "An advantage, profit, or increase that is acquired or achieved.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_profit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a significant financial <w>gain</w> this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания отчиталась о значительной финансовой <w>прибыли</w> в этом квартале.",
                                "tr": "Şirket bu çeyrekte önemli bir finansal <w>kazanç</w> bildirdi.",
                                "zh": "公司报告称本季度财务<w>收益</w>显著。"
                            }
                        },
                        {
                            "text": "Regular exercise leads to a <w>gain</w> in overall strength and health.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения ведут к <w>приросту</w> общей силы и здоровья.",
                                "tr": "Düzenli egzersiz, genel güç ve sağlıkta bir <w>artışa</w> yol açar.",
                                "zh": "经常锻炼会带来整体力量和健康的<w>增长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "profit",
                        "benefit",
                        "increase",
                        "acquisition",
                        "advantage",
                        "growth"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "capital gain",
                        "personal gain",
                        "net gain",
                        "weight gain"
                    ],
                    "target_lang_definitions": {
