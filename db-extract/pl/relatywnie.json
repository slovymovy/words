                                                "sense_id": "d4efadb1-1fa2-3f71-99bd-156e1b0c80d9",
                                                "text": "Dnes je venku poměrně zima."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52412249-818b-4bb5-aac0-a2db2b71793a",
