                ],
                "senses": [
                    {
                        "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                        "entry_id": "8ed35f41-0525-325a-a97e-0d67e6f54906",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40769f5-8fdf-4786-a746-b663f2b68334",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Frau Feigl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "36c9a1ff-2808-453c-8024-836fd78e17ca",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Herr Feigl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ed6dc8d-fb82-474e-ab83-bbc0514e0b7a",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Die Feigls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ac371729-7f0a-4124-a7fb-f86d68c2d595",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Der Feigl trägt nie die Schals, die die Feigl ihm strickt."
                            },
                            {
                                "example_id": "5cc3d507-6763-4a1c-bc49-c8de72c43c2e",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feigl kommt, geht der Herr Feigl.“"
                            },
                            {
                                "example_id": "5ba3e5c0-c91f-4bde-ae8b-c4f48dbabae6",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Feigl kommt und geht."
                            },
                            {
                                "example_id": "0fef576c-3ad7-426b-90fa-29dccdba91a3",
                                "sense_id": "ccd6bd76-2189-3484-b313-bea3bb6d071b",
                                "text": "Feigls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
