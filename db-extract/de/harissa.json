                        "cross_references": [
                            {
                                "target_word": "harissa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8efb29d5-8f77-3b10-894f-f72140d0b6d6",
                                        "entry_id": "75a2e9d9-c3f2-380b-be5f-a27477362941",
                                        "glosses": [
                                            "A North African spice mix, containing chillis, garlic and salt, used as both a condiment and an ingredient."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae20a8d5-dba3-494d-8f47-4a2c91e00ba6",
                                                "sense_id": "8efb29d5-8f77-3b10-894f-f72140d0b6d6",
                                                "text": "Another sauce, mainly used as a condiment, is harissa, made from pulverised chillies, garlic, salt and olive oil. Harissa is not generically Moroccan, but nevertheless is often found accompanying tajines and couscous."
                                            },
                                            {
                                                "example_id": "ce23e4d9-8f7f-443a-86d7-2087023dd57c",
                                                "sense_id": "8efb29d5-8f77-3b10-894f-f72140d0b6d6",
                                                "text": "Tunisians love spicy food and harissa is the main ingredient used to provide the heat."
                                            },
                                            {
                                                "example_id": "0912e72f-ad97-4d85-8c34-4e8635a99cc9",
                                                "sense_id": "8efb29d5-8f77-3b10-894f-f72140d0b6d6",
                                                "text": "Harissa is a fiery pepper paste that is used as an ingredient in couscous and grilled dishes or as a condiment served on the side of a Moroccan meal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harissa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c87eb5fd-8f1f-3ecc-868e-2b69dbab627d",
                                        "entry_id": "171df3c6-1ba4-399c-bbac-23cf49482c6c",
                                        "glosses": [
                                            "A traditional Armenian dish: a kind of porridge made of previously stewed and boned chicken and coarsely ground soaked wheat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
