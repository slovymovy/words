                "senses": [
                    {
                        "sense_id": "e981af68-4967-3522-a38a-b89f6096a8ab",
                        "entry_id": "e27e5576-2aca-3424-8482-b4409772cab3",
                        "glosses": [
                            "Krankheit, bei der eine Schädigung des Zentralnervensystems entsteht, indem es zu einer Demyelinisation der Nervenzellen bzw. derer Axone kommt, die zu einer Zerstörung der Marksubstanz führt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f5d9e7-c58b-4cc7-8a47-706be3133f00",
                                "sense_id": "e981af68-4967-3522-a38a-b89f6096a8ab",
                                "text": "„Unter einer demyelinisierenden Erkrankung oder Entmarkungskrankheit wird eine Schädigung des Zentralnervensystems verstanden, bei der es zu einer Demyelinisation der Nervenzellen bzw. derer Axone, somit zu einer Zerstörung der Marksubstanz kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
