                    {
                        "translation_id": "4fccc69d-9e2c-482b-8c96-799a7420f934",
                        "source_entry_id": "eaca1ad9-d285-3326-8a8d-af57404be07e",
                        "source_sense_id": "956caada-b8e3-306b-8c70-e1a270c5fa83",
