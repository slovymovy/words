                                "example_id": "3cc860bf-6a9c-44fd-b02c-912c0c622a9f",
                                "sense_id": "aee97cf2-b481-3d54-9cf9-0b197c14ea7d",
                                "text": "Er werden jeugdverhalen en toekomstdromen gedeeld."
