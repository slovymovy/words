                            {
                                "example_id": "72c123f4-9a72-4a0a-baeb-c20269c0fec7",
                                "sense_id": "ed0c7aa7-923a-35b0-b056-badf77ace18f",
                                "text": "Eine der Eisläuferinnen ist gestürzt und hat sich dabei leicht verletzt."
                            },
                            {
                                "example_id": "93acde4c-e03e-4b0d-b3b8-489b88cf9357",
                                "sense_id": "ed0c7aa7-923a-35b0-b056-badf77ace18f",
                                "text": "„Die Anschuldigungen einer anderen Eisläuferin hat er demnach bestritten und außerdem auf ein eingestelltes Verfahren im Jahr 2002 verwiesen.“"
