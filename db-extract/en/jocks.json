                                "example_id": "828dfbb3-1a54-49df-9525-dcba00c4fa37",
                                "sense_id": "80c466c7-7e31-3253-8cb6-628a03b5ef8d",
                                "text": "\"My name's Bill. I'm from Western Australia. I was sleeping in my panel van across the creek in the park, and I guess the flood waters picked up the van. I still can't believe what happened, but at least I'm still alive. All I've got left is what I'm standing in: my jocks.\""
                            },
                            {
                                "example_id": "9a86138a-b5eb-4e01-8c32-7f53202e4a0f",
                                "sense_id": "80c466c7-7e31-3253-8cb6-628a03b5ef8d",
                                "text": "\"Please, Ryan. I don't want to come downstairs every morning and find you lounging around in your jocks on my couch. It's too ... studenty.\""
                            }
                        ]
                    }
