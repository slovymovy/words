                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7248aad-c4e4-4285-8ae9-a0f5a5877c9a",
                                                "sense_id": "f81231b2-02d1-3685-a38f-c3ab2225c11d",
                                                "text": "Do biskupa dołączyli prezbiterzy i diakoni."
                                            },
                                            {
                                                "example_id": "a839af88-3376-4d1c-b1fa-1aa1c906d753",
                                                "sense_id": "f81231b2-02d1-3685-a38f-c3ab2225c11d",
                                                "text": "Prezbiter ubrany był w albę, stułę i czerwony ornat."
                                            },
                                            {
                                                "example_id": "278ad7b5-c5b7-40db-825b-da5e0bec657a",
                                                "sense_id": "f81231b2-02d1-3685-a38f-c3ab2225c11d",
                                                "text": "Kiedy prezbiterowi wolno udzielić bierzmowania?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
