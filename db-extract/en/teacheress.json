                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce019e30-9dec-3f02-8e57-15d82ac31946",
                        "entry_id": "5f09a485-7317-3e08-b0db-8f98fe8a5516",
                        "glosses": [
                            "Lehrerin"
                        ],
                        "tags": [
                            "heute"
                        ],
                        "examples": [
                            {
                                "example_id": "237dd3ae-53aa-4a1b-acb2-b387db8a1f34",
                                "sense_id": "ce019e30-9dec-3f02-8e57-15d82ac31946",
                                "text": "\"The teacheress built her own house, and two little school zayats - one for boys and one for girls, and made me teach them to read. She herself came and taught the girls to sew.\"\""
                            },
                            {
                                "example_id": "31db5eed-c832-4e66-918a-9c4646b72475",
                                "sense_id": "ce019e30-9dec-3f02-8e57-15d82ac31946",
                                "text": "\"I was very much interested to notice the relations which exist between the pastor and his people, and was pleased also with the kind greetings which the newly arrived teacher and teacheress received.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44d04f9b-7fda-35f2-8be2-279080a24dde",
                        "entry_id": "5f09a485-7317-3e08-b0db-8f98fe8a5516",
                        "glosses": [
                            "Ehefrau eines Lehrers"
                        ],
