        "ru-extract.jsonl": [
            {
                "entry_id": "5a56d53c-c6d1-336b-878c-0cabf093d538",
                "word": "согласно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fe3d376a-f9e2-32de-aab3-45534cf93fc4",
                        "entry_id": "5a56d53c-c6d1-336b-878c-0cabf093d538",
                        "glosses": [
                            "наречие к согласный"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "2b82b95b-32c1-4eb8-b55a-8e5c30bbf244",
                                "sense_id": "fe3d376a-f9e2-32de-aab3-45534cf93fc4",
                                "text": "А особливо вражды, ссор и драк между собою отнюдь не иметь под жестоким наказанием; а жить всем согласно и единодушно без всякой зависти во всяком дружелюбии, одному другому во всём вспомоществовать и друг другу быть покорным по закону божию."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f977613-9c07-3ffc-add9-8cacb2a5b2b8",
                        "entry_id": "5a56d53c-c6d1-336b-878c-0cabf093d538",
                        "glosses": [
                            "выражая согласие, в знак согласия"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "9c9c0657-ee62-47a1-a3e8-43a792060542",
                        "source_entry_id": "5a56d53c-c6d1-336b-878c-0cabf093d538",
                        "source_sense_ids": [
                            "8f977613-9c07-3ffc-add9-8cacb2a5b2b8"
