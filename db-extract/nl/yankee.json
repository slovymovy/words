                "translations": [
                    {
                        "translation_id": "1b3ff7a8-94e1-41b0-ac6c-25fdb1e77b53",
                        "source_entry_id": "d9ee73fd-e0bc-3fa8-8070-e20472181c52",
                        "source_sense_id": "3afcfa98-aaca-3c4b-80bf-a16872d160ac",
                        "source_sense_description": "Amerikaan uit het noordelijke deel van de Verenigde Staten",
