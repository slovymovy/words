                "senses": [
                    {
                        "sense_id": "532f33dc-3df0-3e7a-9a20-b2d4e3802e9e",
                        "entry_id": "d43e766e-b26f-3a77-9d60-4242cda972e7",
                        "glosses": [
                            "Que l’on peut classer dans une catégorie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd0922d-a768-400c-a2c8-899a4b37fee4",
                                "sense_id": "532f33dc-3df0-3e7a-9a20-b2d4e3802e9e",
                                "text": "Ce Protée, dessinateur de profession, aujourd'hui comédien, demain écrivain, était si peu classé, si peu classable qu’au début la Revue des Deux Mondes le crut capable d’exposer ses idées sur l’art."
                            },
                            {
                                "example_id": "1741af14-f355-4c51-8c9c-a87e1aed3168",
                                "sense_id": "532f33dc-3df0-3e7a-9a20-b2d4e3802e9e",
                                "text": "Le fait d'être classé (ou classable) constitue la signature de la nominalité. Les noms sont formellement classables selon des propriétés ontologiques (encyclopédiques) de leurs référents."
                            },
                            {
                                "example_id": "fc67b40f-e792-4d51-a811-162e3c3bc892",
                                "sense_id": "532f33dc-3df0-3e7a-9a20-b2d4e3802e9e",
                                "text": "Pierre Kast, né en 1920, est plus difficilement classable et la diversité de sa filmographie – jusqu’à ce qu’il entame en 1957 une estimable carrière de réalisateur de longs métrages - témoigne de celle de ses intérêts."
                            }
                        ]
                    },
                    {
                        "sense_id": "90c82921-2bf4-3410-8b9d-ab9498b25bac",
                        "entry_id": "d43e766e-b26f-3a77-9d60-4242cda972e7",
                        "glosses": [
                            "Auquel on peut donner un rang dans un classement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f369b32-cb5e-450d-8362-27887c153667",
                                "sense_id": "90c82921-2bf4-3410-8b9d-ab9498b25bac",
                                "text": "Pour être classable et marquer des points, l’équipe doit courir sur le circuit du représentant de la catégorie la plus élevée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
