                ],
                "senses": [
                    {
                        "sense_id": "2b590728-9dab-3dbd-a70d-d18dfe562838",
                        "entry_id": "5b05dc0e-0bfc-30bb-9262-795e96ec8a7f",
                        "glosses": [
                            "Enlever son caractère kétaine à."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "e8eda289-a770-4bc6-9235-9e4910644756",
                                "sense_id": "2b590728-9dab-3dbd-a70d-d18dfe562838",
                                "text": "Dans cette perspective, nous avons le devoir de «dékétainiser» notre langue et notre culture en assumant de façon plénière notre héritage occidental et français, au lieu de nous enfoncer dans un régionalisme populacier."
                            },
                            {
                                "example_id": "c8aad42c-51cf-446c-8633-513dfef49d02",
                                "sense_id": "2b590728-9dab-3dbd-a70d-d18dfe562838",
                                "text": "Moi, j'essaie de «dékétainiser» Elvis."
                            },
                            {
                                "example_id": "f130ed45-e963-44cc-ac98-2b790e802f26",
                                "sense_id": "2b590728-9dab-3dbd-a70d-d18dfe562838",
                                "text": "Je suis contente parce qu'on a «dékétainisé» mon idole de jeunesse."
                            }
                        ]
                    }
