                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697848da-bd03-409e-a534-d4c113453be8",
                                                "sense_id": "a33dfde8-ce91-3aa7-8089-3ebb6cf4d822",
                                                "text": "Gracious procedures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d714e8a1-e4c5-38ac-96a6-847719a94e09",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "That which results; issue; product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be730df8-df6d-460f-afeb-a94dee9e2667",
                                                "sense_id": "d714e8a1-e4c5-38ac-96a6-847719a94e09",
                                                "text": "There is not any known Substance, but Earth, and the Procedure of Earth (as Tile, Stone, &c.) that yeeldeth any Moss or Herby Substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d741597-9360-3e5a-a844-a50735b3ba61",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
