                "senses": [
                    {
                        "sense_id": "796156ee-810e-39ff-88cc-168c57f5101a",
                        "entry_id": "20046204-420a-36de-bc9e-a77acac29df4",
                        "glosses": [
                            "Bodensenke vulkanischen Ursprungs, teils trocken, teils mit Wasser gefüllt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "d85779a2-72f3-4ad6-bdd3-f04a1c064c66",
                                "sense_id": "796156ee-810e-39ff-88cc-168c57f5101a",
                                "text": "„Die letzte Aktivität war die Eruption, die zur Bildung des Ulmener Maares vor rund 9.500 Jahren geführt hat.“"
                            },
                            {
                                "example_id": "38eb7c1c-d2ac-4602-82e4-f5c70c0b55d5",
                                "sense_id": "796156ee-810e-39ff-88cc-168c57f5101a",
                                "text": "„Maare sind kraterförmige, durch Gasexplosionen entstandene und mit Seen oder Sümpfen erfüllte Vertiefungen in der Erdoberfläche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
