                                "ru": "Нам нужно сейчас же <w>уходить</w>, иначе мы не успеем вовремя.",
                                "en": "We really have to <w>leave</w> now, otherwise we won't be on time.",
                                "pl": "Naprawdę musimy już <w>wychodzić</w>, inaczej nie zdążymy na czas.",
                                "de": "Wir müssen jetzt wirklich <w>weggehen</w>, sonst kommen wir nicht mehr rechtzeitig.",
                                "fr": "Nous devons vraiment <w>partir</w> maintenant, sinon nous ne serons pas à l'heure.",
                                "it": "Dobbiamo davvero <w>andarcene</w> ora, altrimenti non arriveremo in tempo.",
                                "cs": "Musíme už opravdu <w>odejít</w>, jinak to nestihneme včas.",
                                "tr": "Gerçekten şimdi <w>gitmeliyiz</w>, yoksa vaktinde yetişemeyeceğiz.",
                                "es": "Realmente tenemos que <w>irnos</w> ahora, si no, no llegaremos a tiempo.",
                                "zh": "我们现在真的必须<w>离开</w>了，否则就赶不上了。"
                            }
                        },
                        {
                            "text": "Ik wil hier niet <w>weggaan</w> zonder eerst afscheid te nemen.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>уходить</w> отсюда, не попрощавшись.",
                                "en": "I don't want to <w>leave</w> here without saying goodbye first.",
                                "pl": "Nie chcę stąd <w>odchodzić</w> bez wcześniejszego pożegnania.",
                                "de": "Ich möchte hier nicht <w>weggehen</w>, ohne mich vorher zu verabschieden.",
                                "fr": "Je ne veux pas <w>partir</w> d'ici sans d'abord dire au revoir.",
                                "it": "Non voglio <w>andarmene</w> da qui senza prima salutare.",
                                "cs": "Nechci odsud <w>odejít</w>, aniž bych se nejdřív rozloučil.",
                                "tr": "Önce vedalaşmadan buradan <w>ayrılmak</w> istemiyorum.",
                                "es": "No quiero <w>irme</w> de aquí sin despedirme primero.",
                                "zh": "我不想在没告别之前就从这里<w>离开</w>。"
                            }
