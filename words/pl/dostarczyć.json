            "senses": [
                {
                    "sense_id": "2db072c4-3b96-36fa-93b4-f8b0e2a0ae0c",
                    "sense_definition": "przywieźć lub przynieść coś na wyznaczone miejsce lub do odbiorcy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kurier <w>dostarczył</w> paczkę pod wskazany adres już z samego rana.",
                            "target_lang_translations": {
                                "ru": "Курьер <w>доставил</w> посылку по указанному адресу с самого утра."
                            }
                        },
                        {
                            "text": "Musimy jak najszybciej <w>dostarczyć</w> te dokumenty do biura dyrektora.",
                            "target_lang_translations": {
                                "ru": "Мы должны как можно скорее <w>доставить</w> эти документы в кабинет директора."
                            }
