        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                "word": "sublimity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5cfe863-7f7f-4976-9720-005ce30a5a5b",
                        "entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "sublimities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29e394b1-5a90-3f97-b5ff-8f2ad9a1b9b3",
                        "entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                        "glosses": [
                            "The quality or state of being sublime."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d26205-3982-47c8-802a-7cd53eadfe9b",
                                "sense_id": "29e394b1-5a90-3f97-b5ff-8f2ad9a1b9b3",
                                "text": "The frantic father struts the stage, / And swells with true sublimity of rage / Against his son, who leads a wanton life, / And scorns the offer of a dowried wife."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed8e005b-9779-308d-97c4-8b332caf5613",
                        "entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                        "glosses": [
                            "Something sublime."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8354b74-34a0-48d5-96e9-c8e4ba6c9cd9",
                        "source_entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                        "source_sense_description": "quality or state of being sublime",
                        "target_lang_word": "sublimité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sublimité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                        "entry_id": "da068c59-3a32-3aed-8389-6f237e8c459e",
                                        "glosses": [
                                            "Caractère de ce qui est sublime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74df60c0-2d21-4191-a883-c56cac2ea010",
                                                "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                                "text": "Dans un accès de piété filiale, écrasée par la sublimité de sa mère, elle se mit à genoux devant elle, saisit le bas de sa robe et la baisa, comme de pieux catholiques baisent les saintes reliques d’un martyr."
                                            },
                                            {
                                                "example_id": "5dff4208-afb6-4c08-9446-41e3bc86b48d",
                                                "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                                "text": "Quels termes saurai-je trouver, suffisamment simples dans leur sublimité, — suffisamment sublimes dans leur simplicité, — pour la simple énonciation de mon thème ?"
                                            },
                                            {
                                                "example_id": "352437dc-7890-44b1-9ca5-9d08e92cc933",
                                                "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                                "text": "Et puis, c’est leur accoutrement qu’il faut voir ! on prendrait un morceau d’étoffe, et l’on travaillerait pendant dix ans à le salir, à le râper, à le trouer, à le rapiécer, à lui faire perdre sa couleur primitive, que l’on n’arriverait pas à cette sublimité du haillon !"
                                            },
                                            {
                                                "example_id": "1006b29a-aef6-494b-ac65-4ca15772bcda",
                                                "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                                "text": "Pour sentir la sublimité de cette scène, il n’est pas inutile de penser à ce que Jésus exprime si profondément quand il parle du « Sein d’Abraham »."
                                            },
                                            {
                                                "example_id": "af75c548-aa50-4578-9d8c-48108eed8501",
                                                "sense_id": "039831f6-f5fd-30e5-8ff2-6dd914a924b7",
                                                "text": "« Quand on a vécu quelque temps dans la société de ces petits, c’est extraordinaire combien vite la sublimité des grands vous essouffle. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a77ec5-6c81-3cc7-bd81-b63667ae3457",
                                        "entry_id": "da068c59-3a32-3aed-8389-6f237e8c459e",
                                        "glosses": [
                                            "Action ou parole sublime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d3429b-4e09-4e0a-8617-fa9cf6d804c3",
                                                "sense_id": "59a77ec5-6c81-3cc7-bd81-b63667ae3457",
                                                "text": "C’est pas de la faveur ?… la prison m’achève… eh, eh, eh ! c’est naturel ! 57 années d’héroïsme ! de sublimités de guerre et de Paix… j’en crèverais pas ?"
                                            },
                                            {
                                                "example_id": "ed775455-4990-4fce-b49c-1f0a620c96f1",
                                                "sense_id": "59a77ec5-6c81-3cc7-bd81-b63667ae3457",
                                                "text": "Il est certain que, si ce n’est sa beauté, rien n’égalait la sublimité de ses discours, toujours inspirés : le miel pur des Évangiles s’unissait, sur ses lèvres, à la flamme étincelante des prophéties."
                                            },
                                            {
                                                "example_id": "f94bc669-0555-4b7b-acdf-0f2f302c5feb",
                                                "sense_id": "59a77ec5-6c81-3cc7-bd81-b63667ae3457",
                                                "text": "Au lieu des sublimités qu’il attendait, il ne rencontra que des platitudes, un style très lâche, de froides images et force comparaisons tirées de la boutique des lapidaires."
                                            },
                                            {
                                                "example_id": "1a8719f7-ff93-4e17-b435-21a6d27d4ac6",
                                                "sense_id": "59a77ec5-6c81-3cc7-bd81-b63667ae3457",
                                                "text": "Cela explique toutes les bassesses, en idées et en actes, comme aussi toutes les sublimités, en idées et en actes, de l’humanité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8634a69c-afa4-442e-b2e5-7282b47a1524",
                        "source_entry_id": "e497c798-2839-39ae-847b-4c10f1d5f1d2",
                        "source_sense_description": "quality or state of being sublime",
                        "target_lang_word": "Erhabenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erhabenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64373854-7658-3c0c-aa24-522ae3559bcb",
                                        "entry_id": "15db842f-51ea-3443-ae92-9fbb3379d18a",
                                        "glosses": [
                                            "Eigenschaft/Zustand, würdevoll zu sein und/oder anerkannt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de614b10-0680-41d1-9e0b-be69aa82b8da",
                                                "sense_id": "64373854-7658-3c0c-aa24-522ae3559bcb",
                                                "text": "„Die Erhabenheit des Übermenschen kennzeichnet demzufolge auch das menschliche Vermögen, aktiv zu bewerten und Sinn zu schaffen.“"
                                            },
                                            {
                                                "example_id": "6758fbca-6f40-4891-93ec-d20ba0139835",
                                                "sense_id": "64373854-7658-3c0c-aa24-522ae3559bcb",
                                                "text": "„Die Erhabenheit der Gedanken und Wege Gottes im apostolischen Glaubensbekenntnis, sei der Gegenstand unseres Zeugnisses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "829c8682-3b8b-35b6-90fb-102dadfd0180",
                                        "entry_id": "15db842f-51ea-3443-ae92-9fbb3379d18a",
                                        "glosses": [
                                            "nach oben gewölbte Stelle auf einer Fläche"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32150f6-3729-4ed7-ab29-4e57a869528d",
                                                "sense_id": "829c8682-3b8b-35b6-90fb-102dadfd0180",
                                                "text": "„Es entsteht nach Fick von einem leuchtenden Objectpunkt ein Doppelbild, d. h. ein in zwei oder mehrere Parthien gespaltener Zerstreuungskreis, sobald durch irgend eine Unregelmässigkeit, eine Erhabenheit auf der Oberfläche der Cornea ein Theil des divergirenden Strahlenbüschels eine etwas andere Ablenkung erfährt, als der übrige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
