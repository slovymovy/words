                    {
                        "sense_id": "35c8410d-c297-35bf-87fb-2c18c1534a74",
                        "entry_id": "3388ca3d-78ea-35b6-b10d-3a225a2db82d",
                        "glosses": [
                            "этногр. индеец из североамериканского племени, относящегося к группе ирокезов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9603f3fe-eb94-4bcb-9f57-1be07699920c",
                                "sense_id": "35c8410d-c297-35bf-87fb-2c18c1534a74",
                                "text": "Сейчас я, как старый ирокез, пойду за дровами, а ты, Надюша, доставай мясо из уксуса и насаживай на шампуры."
                            }
                        ]
                    }
                ],
