                        ],
                        "examples": [
                            {
                                "example_id": "883280f0-3a0c-4797-b294-c60450128f8e",
                                "sense_id": "b516965d-b602-3513-b9f3-794d210fb755",
                                "text": "De rupsen van de hyena doen hun naam eer aan: ze eten andere rupsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4538117f-838e-4943-b4c6-676fad776c63",
                        "source_entry_id": "e153458f-6c0c-351d-99c5-98d65bb74b16",
                        "source_sense_id": "6d51d4c2-2049-39a3-99e4-82d00093d72c",
                        "source_sense_description": "benaming voor zoogdieren uit de onderfamilie Hyaeninae",
                        "target_lang_word": "Hyäne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hyäne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c65c4d22-a4c8-35a2-b351-5c06f0d70ea8",
                                        "entry_id": "f2cc3bd1-174e-3a9e-a045-8b62c9a7a65f",
                                        "glosses": [
                                            "in Afrika und Südwestasien beheimatetes, oberflächlich hundeähnliches, systematisch jedoch katzenartiges Raubtier, das sich vor allem von Aas ernährt; ein Vertreter von [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15bc854-e339-455b-bcb4-e43738b55f49",
                                                "sense_id": "c65c4d22-a4c8-35a2-b351-5c06f0d70ea8",
                                                "text": "Hyänen zeichnen sich durch ihren markanten, an Gelächter erinnernden Ruf aus."
                                            },
                                            {
                                                "example_id": "9daf9114-8a48-4877-b335-f3a7eaca7636",
                                                "sense_id": "c65c4d22-a4c8-35a2-b351-5c06f0d70ea8",
                                                "text": "„Neuere Literatur über die Hyäne ist etwas weniger emotionsgeladen, aber nicht weniger furchteinflößend.“"
                                            },
                                            {
                                                "example_id": "152e5ef6-1d57-4873-9187-14e5c326e976",
                                                "sense_id": "c65c4d22-a4c8-35a2-b351-5c06f0d70ea8",
                                                "text": "„Ein nie gesehenes goldgrünes Licht lag über der Landschaft und in der Ferne lachten die Hyänen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "627cb776-e30f-3872-8a1f-2e15a8293ec8",
                                        "entry_id": "f2cc3bd1-174e-3a9e-a045-8b62c9a7a65f",
                                        "glosses": [
                                            "eine ungehemmt egoistische Person ohne jegliche Skrupel"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dff39b8-01db-469c-b151-b652b226a6fd",
                                                "sense_id": "627cb776-e30f-3872-8a1f-2e15a8293ec8",
                                                "text": "Der Geschäftsmann ist die reinste Hyäne."
                                            },
                                            {
                                                "example_id": "501e2d2d-7786-4cc7-ac5a-9cfebab7e907",
                                                "sense_id": "627cb776-e30f-3872-8a1f-2e15a8293ec8",
                                                "text": "„Die Hyäne hatte gelogen und wußte das; sie wußte auch, daß ich in der Klemme saß, da ich ihn nicht als Lügner bezeichnen konnte, ohne sein Gebrüll hervorzurufen.“"
                                            },
                                            {
                                                "example_id": "1cea5944-b40e-4307-91c5-6e732fa19102",
                                                "sense_id": "627cb776-e30f-3872-8a1f-2e15a8293ec8",
                                                "text": "„Er nahm von den Reichen der Besatzungszeit, von den Hyänen der Währungsreform, von den Neureichen des Wirtschaftswunders.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24cd3cab-b129-3c03-a0c1-a7dce6fc1a5c",
                                        "entry_id": "f2cc3bd1-174e-3a9e-a045-8b62c9a7a65f",
                                        "glosses": [
                                            "eine Familie der Ordnung der Raubtiere"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327acd68-32a8-4d45-aada-b7d45afb5460",
                                                "sense_id": "24cd3cab-b129-3c03-a0c1-a7dce6fc1a5c",
                                                "text": "„Die Hyaenidae (Hyänen) sind geologisch jung und leiten sich von den miozänen Schleichkatzen her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "529b949f-acc1-4f91-baff-75b3bc7a2702",
                        "source_entry_id": "e153458f-6c0c-351d-99c5-98d65bb74b16",
                        "source_sense_id": "6d51d4c2-2049-39a3-99e4-82d00093d72c",
                        "source_sense_description": "benaming voor zoogdieren uit de onderfamilie Hyaeninae",
                        "target_lang_word": "hyena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53510ac4-1479-3bc7-abc7-b966dd3c9632",
                                        "entry_id": "baca09a3-12f4-3fa3-a2d5-6d9b6b1c8447",
                                        "glosses": [
                                            "Any of the medium-sized to large feliform carnivores of the family Hyaenidae, native to Africa and Asia and noted for the sound similar to laughter which they can make if excited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba1ce66-4239-4265-bef4-cdb31d2be292",
                                                "sense_id": "53510ac4-1479-3bc7-abc7-b966dd3c9632",
                                                "text": "The udder of the hyena, tied on the left arm, enticed the affection of any desired woman."
                                            },
                                            {
                                                "example_id": "1124e527-7278-481e-983f-ac1b2e19cfb0",
                                                "sense_id": "53510ac4-1479-3bc7-abc7-b966dd3c9632",
                                                "text": "I took no systematic data on the costs to cheetahs and hyenas, but some anecdotes suggest that both parties took numerical advantage and hunger into account."
                                            },
                                            {
                                                "example_id": "20f77cc6-e9a6-4648-87ce-f9f153205251",
                                                "sense_id": "53510ac4-1479-3bc7-abc7-b966dd3c9632",
                                                "text": "Hyenas are scavengers, which means they eat food left behind by other animals and people."
                                            },
                                            {
                                                "example_id": "b4e6257c-7685-411e-8d4f-6dd0d3339cf9",
                                                "sense_id": "53510ac4-1479-3bc7-abc7-b966dd3c9632",
                                                "text": "Hyena biologists often think of spotted hyenas (Crocuta crocuta) as baboons with big teeth and relatively small brains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0a1327-32f6-318a-92e4-6dd9e3be30c7",
                                        "entry_id": "baca09a3-12f4-3fa3-a2d5-6d9b6b1c8447",
                                        "glosses": [
                                            "A man that performs ritualized sex acts with recently widowed women and menarchal girls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779e4a28-b988-4138-94d4-4a32be4e1d58",
                                                "sense_id": "de0a1327-32f6-318a-92e4-6dd9e3be30c7",
                                                "text": "see Citations:hyena"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ac3fe5c-a763-4772-b22b-7f6156eefa6a",
                        "source_entry_id": "e153458f-6c0c-351d-99c5-98d65bb74b16",
                        "source_sense_id": "6d51d4c2-2049-39a3-99e4-82d00093d72c",
                        "source_sense_description": "benaming voor zoogdieren uit de onderfamilie Hyaeninae",
                        "target_lang_word": "hyène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                        "entry_id": "e83b33f4-e3b0-33e1-a49e-1a205976aa4f",
                                        "glosses": [
                                            "Mammifère carnassier digitigrade d’Asie et d’Afrique au pelage gris tacheté de brun. Précédée de de ou de la, l’élision est facultative, on peut donc aussi bien dire la hyène ou de hyène, que l’hyène ou d’hyène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a64d98f-5ab3-4301-95d2-899ce02fd548",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "Quant à la hyène, sa forme étrange, ses allures mystérieuses, son invisibilité le jour et les ricanements sinistres par lesquels elle annonce sa présence la nuit, en font pour l’indigène une espèce de vampire ou de loup-garou."
                                            },
                                            {
                                                "example_id": "b3bcaddf-ae17-496f-9c4a-0e686f941e50",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "L’hyène rayée, la plus connue, a les oreilles longues, la crinière fournie, le dos déclive ou en toit, le pelage gris ou fauve sale, mêlé de brun."
                                            },
                                            {
                                                "example_id": "87468e76-bf71-418b-b103-95acd802e0d9",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "Je contemplai l’hyène au train de derrière surbaissé."
                                            },
                                            {
                                                "example_id": "bbc30b55-79ab-4383-afd8-08561c1c294f",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "Je n’avais jamais entendu rire comme ça. On aurait dit l’une des dix plaies, ou du gin à deux cents degrés, ou quatre cents hyènes courant les rues de Dingueville."
                                            },
                                            {
                                                "example_id": "bc985c47-6d14-4638-8866-27b91e0bec11",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "— Ce n’est pas parce que la hyène hurle de rire, qu’elle n’est pas malheureuse quand le lion lui dévore ses petits."
                                            },
                                            {
                                                "example_id": "04db4c4d-7eca-47c2-be45-cc8efc7bd7ba",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "Contre sa jambe trottinait son chien « Lirot », un fort mâtin à museau aigu, à poil d’hyène, hérissé de piquants noirs de l’échine au panache."
                                            },
                                            {
                                                "example_id": "b2833fb1-cb5b-4f0f-822a-57d2f483b5e4",
                                                "sense_id": "c1c25c21-5c50-36ad-8d01-59659533661b",
                                                "text": "Sans compter qu’il avait également remarqué des crottes de hyènes sur la piste, blanches comme celles d’un chien, et qu’il les avait entendues pousser leur cri railleur la nuit précédente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c97a91-8ed1-38fc-a8ae-1b9ef87bc0f2",
                                        "entry_id": "e83b33f4-e3b0-33e1-a49e-1a205976aa4f",
                                        "glosses": [
                                            "Personne cruelle et sournoise. → voir charognard"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc72f28-bb4b-4e76-964d-4d6e6c8323ef",
                                                "sense_id": "00c97a91-8ed1-38fc-a8ae-1b9ef87bc0f2",
                                                "text": "Le président multiplie les erreurs, les hyènes se déchainent dans la presse !"
                                            },
                                            {
                                                "example_id": "ebf52928-678f-444e-84ae-b414a10c97ed",
                                                "sense_id": "00c97a91-8ed1-38fc-a8ae-1b9ef87bc0f2",
                                                "text": "La vieille cousine changea de système ; elle voulut essayer de prendre Pierrette par la douceur. L’hyène allait se faire chatte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
