                                "target_lang_sense_clarification": "to talk rapidly about trivial matters"
                            },
                            {
                                "target_lang_word": "prattle",
                                "target_lang_sense_clarification": "to talk at length in a foolish or inconsequential way"
                            }
                        ]
                    }
                },
                {
