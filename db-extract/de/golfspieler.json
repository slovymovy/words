                "senses": [
                    {
                        "sense_id": "c3e35c1f-d832-3cc8-b738-79c1b00ec73f",
                        "entry_id": "d0659f3c-0acf-35d9-9fc7-5a97cf3e2908",
                        "glosses": [
                            "Sportler der das Golfspiel ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf394de-38a9-4a67-8dc2-c8ec46878dad",
                                "sense_id": "c3e35c1f-d832-3cc8-b738-79c1b00ec73f",
                                "text": "Beim Platzreifekurs lernen die angehenden Golfspieler die Regeln und die Etikette, die es auf einen Golfplatz zu beachten gilt."
                            },
                            {
                                "example_id": "935962b1-c8ba-4f6c-8db2-d73ae68ea1de",
                                "sense_id": "c3e35c1f-d832-3cc8-b738-79c1b00ec73f",
                                "text": "„Wiesberger ist wie fast alle guten Golfspieler kein großes Muskelpaket, trainiert gezielt, was er braucht.“"
                            },
                            {
                                "example_id": "de9359f0-d7b9-4117-a91c-8d5b9cb6cf62",
                                "sense_id": "c3e35c1f-d832-3cc8-b738-79c1b00ec73f",
                                "text": "„Nach dem Dinner, im sogenannten Salon, saßen einige Golfspieler im Abendanzug beim Bridge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
