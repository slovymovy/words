                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf800957-fcc4-36d5-ad6a-1108bccf2db8",
                        "entry_id": "90942da7-a90a-354b-9201-b8a299412c53",
                        "glosses": [
                            "Relatif à une zone anciennement rurale devenue une banlieue suite au développement urbain."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "1390a8d6-98b3-49f3-9ab8-07440f1b80ce",
                                "sense_id": "cf800957-fcc4-36d5-ad6a-1108bccf2db8",
                                "text": "Enfin, les employés préfèrent nettement la résidence rurbaine à la résidence urbaine, ce qui les rapproche des patrons de l’industrie et du commerce […]."
                            },
                            {
                                "example_id": "b3fe3a76-7e64-475b-95e8-f060e262f9d5",
                                "sense_id": "cf800957-fcc4-36d5-ad6a-1108bccf2db8",
                                "text": "En Béarn, la recherche d’un gentilé est souvent l’affaire de communes rurbaines complètement débéarnisées de telle sorte que des trucs aussi laids que \"Vignois\" pour Vignes passent bien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edbd6ecb-6a14-4805-8352-a8d713fa9345",
                        "source_entry_id": "90942da7-a90a-354b-9201-b8a299412c53",
                        "source_sense_id": "cf800957-fcc4-36d5-ad6a-1108bccf2db8",
                        "target_lang_word": "rurban",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rurban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "605e5ff6-dec0-358c-96aa-97f7407e9561",
                                        "entry_id": "8eabf93f-29bf-3488-bdba-a2350b7916cc",
                                        "glosses": [
                                            "Of or pertaining to a location which has both urban and rural characteristics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae57dc7-e277-4c45-a673-4dd849afe559",
                                                "sense_id": "605e5ff6-dec0-358c-96aa-97f7407e9561",
                                                "text": "The rurban community offers greater possibilities of social stratification than does the open country community."
                                            },
                                            {
                                                "example_id": "ddc04d71-c56c-494c-974c-26222bedcd5d",
                                                "sense_id": "605e5ff6-dec0-358c-96aa-97f7407e9561",
                                                "text": "There exists what has come to be called the \"rurban fringe,\" an area occupied by tar paper shacks and stately estates, large commercial farms and one-acre part-time farms, golf courses and cemeteries, airports and obnoxious industries."
                                            },
                                            {
                                                "example_id": "b889e9e5-d76b-480c-a7aa-cfd6aa329588",
                                                "sense_id": "605e5ff6-dec0-358c-96aa-97f7407e9561",
                                                "text": "In the lands of the Indian Ocean ‘agrarian cities’ and ‘rurban’ settlements of all sizes were the general rule throughout the medieval period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d618b44b-8a7b-4d3c-86a2-0071c6efa3ae",
                        "source_entry_id": "90942da7-a90a-354b-9201-b8a299412c53",
