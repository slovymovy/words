                ],
                "senses": [
                    {
                        "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                        "entry_id": "75f15cbf-3bec-38b1-9dbb-63dd3999d3c5",
                        "glosses": [
                            "große Geduld, Gelassenheit, Zurückhaltung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "a2b9a0f7-5c43-4a9b-85ba-a7d0ee305309",
                                "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                                "text": "Mit Langmut erduldete er die Debatte."
                            },
                            {
                                "example_id": "a295413b-f7ed-4035-8953-16d2862b2626",
                                "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                                "text": "Seine Langmut, sich mit dem nörgelnden Kind zu beschäftigen, war bewundernswert."
                            },
                            {
                                "example_id": "dc10ac1c-151b-4543-a08f-00435db1197e",
                                "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                                "text": "Man muß schon eine Menge Langmut aufbringen, um diesen Film zu Ende zu sehen."
                            },
                            {
                                "example_id": "6b5ab2d8-d800-440d-8232-b4ab83bfe47c",
                                "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                                "text": "Pekings Langmut mit seinem nervigen Verbündeten in Nordkorea könnte Grenzen haben."
                            },
                            {
                                "example_id": "dea747cf-4950-4232-a481-bde0e4703523",
                                "sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                                "text": "„Das Spiel absolvierte sie in seltsamer Langmut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d179b94-2277-49b4-908b-be11daa0b739",
                        "source_entry_id": "75f15cbf-3bec-38b1-9dbb-63dd3999d3c5",
                        "source_sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                        "source_sense_description": "gehoben: große Geduld, Gelassenheit, Zurückhaltung",
                        "target_lang_word": "longanimity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longanimity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4cdc872-383e-3a5d-b273-7c20aa511869",
                                        "entry_id": "e4581bd7-fe6f-35d4-916d-dd9926bc8cd2",
                                        "glosses": [
                                            "Patience or tolerance in the face of adversity; forbearance, long-suffering."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd5c3b0-6ef2-4e51-ba61-46879c6e72b6",
                                                "sense_id": "a4cdc872-383e-3a5d-b273-7c20aa511869",
                                                "text": "It had overcome the patience of Job, as it did the meekness of Moses, and would surely have mastered any, but the longanimity, and lasting sufferance of God [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "223e738b-fcb1-474a-bc1e-72d8be265178",
                        "source_entry_id": "75f15cbf-3bec-38b1-9dbb-63dd3999d3c5",
                        "source_sense_id": "92fd7b78-a9a3-3d9b-8296-dddc1647566c",
                        "source_sense_description": "gehoben: große Geduld, Gelassenheit, Zurückhaltung",
                        "target_lang_word": "longanimité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longanimité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                        "entry_id": "2ce0e44e-3579-329a-9a42-a8948f13e24b",
                                        "glosses": [
                                            "Patience avec laquelle un être puissant et bon endure les fautes, les insultes qu’il pourrait punir."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f268f7ee-43b5-467d-88c8-3ae399932f12",
                                                "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                                "text": "L’adresse et la longanimité de ces jeunes gens du grand monde finiraient par triompher de mon peu d’expérience, se dit-il; il faut partir et mettre un terme à tout ceci."
                                            },
                                            {
                                                "example_id": "8c7bc57a-f7cf-48dc-9e86-0091c9b00544",
                                                "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                                "text": "Il fallut à M. de Morvelle toute la longanimité d’un candidat pour ne rien laisser voir de l’humeur que lui causait cette chicane."
                                            },
                                            {
                                                "example_id": "9d821cc8-b667-412f-89b4-23a2854ab3df",
                                                "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                                "text": "Hélas ! Messieurs, le Dieu de nos pères, qui devait armer d’un papier vengeur la main de l’électeur, s’est montré d’une longanimité, d’une indifférence sans pareille."
                                            },
                                            {
                                                "example_id": "770d6298-fe1d-4e7d-b719-78e149ce9474",
                                                "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                                "text": "Et ils s’en retournent dans leur pays, admirant la longanimité d’Allah qui permet à une race aussi dévergondée d’opprimer les croyants, mais consolés par la certitude qu’au jugement dernier les infidèles n’échapperont pas à leur juste châtiment, qu’ils seront la proie de Chaïtân et brûleront éternellement en enfer."
                                            },
                                            {
                                                "example_id": "aa73ec6d-9e9e-402e-8800-2cfbdec506a7",
                                                "sense_id": "3f2f5b29-4035-3e6e-8d96-118b95531bac",
                                                "text": "On se demande pourquoi Mme Pardoux a l’air si royal : c’est sa politesse et sa bonté, sa longanimité, la qualité supérieure de son hypocrisie, la fleur de son amabilité sans danger d’être dupe, qui lui confère tant de distinction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
