                                        "sense_id": "7ff7362c-aa65-3165-b824-e298554399ac",
                                        "entry_id": "d862364d-ff59-371e-b32b-8ee42c5e625e",
                                        "glosses": [
                                            "trichterförmiges Gerät, das durch bündelung der Schallwellen oder elektrisch akustische Signale verstärkt"
                                        ],
                                        "tags": [],
