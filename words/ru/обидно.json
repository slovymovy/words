{
    "word_family": [
        "обида",
        "обидный",
        "обидеть",
        "обидеться",
        "обидчик",
        "обидчивый"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fe21c60d-1940-36c9-a6d2-1d4806ef765e",
                    "sense_definition": "Вызывает чувство досады, огорчения или обиды (о ситуации, событии).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне очень <w>обидно</w>, что ты не пришел на мой день рождения. ",
                            "target_lang_translations": {
                                "en": "I feel really <w>upset</w> that you didn't come to my birthday party.",
                                "es": "Me <w>da mucha pena</w> que no hayas venido a mi cumpleaños.",
                                "fr": "Je trouve ça très <w>dommage</w> que tu ne sois pas venu à mon anniversaire."
                            }
                        },
                        {
                            "text": "Упустить такой шанс — невероятно <w>обидно</w> для всей нашей команды.",
                            "target_lang_translations": {
                                "en": "Missing such a chance is an incredibly <w>bitter disappointment</w> for our whole team.",
                                "es": "Perder semejante oportunidad es <w>una pena</w> increíble para todo nuestro equipo.",
                                "fr": "Rater une telle opportunité est incroyablement <w>regrettable</w> pour toute notre équipe."
                            }
                        }
                    ],
                    "antonyms": [
                        "необидно"
                    ],
                    "common_phrases": [
                        "очень обидно",
                        "ужасно обидно"
                    ],
                    "target_lang_definitions": {
                        "en": "Causes a feeling of vexation, disappointment, or hurt (about a situation or event).",
                        "es": "Causa sentimiento de molestia, pena o resentimiento (referido a una situación o evento).",
                        "fr": "Provoque un sentiment de vexation, de dommage ou de déception (à propos d'une situation ou d'un événement)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it is a pity",
                                "target_lang_sense_clarification": "unfortunate or disappointing"
                            },
                            {
                                "target_lang_word": "upsetting",
                                "target_lang_sense_clarification": "causing feelings of hurt or sadness"
                            },
                            {
                                "target_lang_word": "shame",
                                "target_lang_sense_clarification": "a regrettable situation"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "una pena",
                                "target_lang_sense_clarification": "para expresar lástima o frustración"
                            },
                            {
                                "target_lang_word": "da rabia",
                                "target_lang_sense_clarification": "causa enfado o impotencia"
                            },
                            {
                                "target_lang_word": "duele",
                                "target_lang_sense_clarification": "causa dolor emocional"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "dommage",
                                "target_lang_sense_clarification": "c'est regrettable"
                            },
                            {
                                "target_lang_word": "vexant",
                                "target_lang_sense_clarification": "qui blesse ou déçoit"
                            },
                            {
                                "target_lang_word": "râlant",
                                "target_lang_sense_clarification": "familiers, provoquant la déception"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed683e3-11b6-3903-8e70-0ec6ed037fae",
                    "sense_definition": "Так, что содержит в себе оскорбление или причиняет огорчение; оскорбительно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>обидно</w> пошутил над своим коллегой перед всеми сотрудниками. ",
                            "target_lang_translations": {
                                "en": "He made a <w>hurtful</w> joke about his colleague in front of all the employees.",
                                "es": "Bromeó de forma <w>hiriente</w> sobre su colega delante de todos los empleados.",
                                "fr": "Il a plaisanté <w>de manière blessante</w> sur son collègue devant tous les employés."
                            }
                        },
                        {
                            "text": "Она <w>обидно</w> улыбнулась и ничего не ответила на предложение.",
                            "target_lang_translations": {
                                "en": "She smiled <w>insultingly</w> and said nothing in response to the offer.",
                                "es": "Sonrió de manera <w>ofensiva</w> y no respondió nada a la propuesta.",
                                "fr": "Elle a eu un sourire <w>vexant</w> et n'a rien répondu à la proposition."
                            }
                        }
                    ],
                    "synonyms": [
                        "оскорбительно"
                    ],
                    "antonyms": [
                        "неоскорбительно",
                        "необидно"
                    ],
                    "common_phrases": [
                        "обидно пошутить",
                        "обидно прозвать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner that contains an insult or causes offense; insultingly.",
                        "es": "De manera que contiene un insulto o causa ofensa; hirientemente.",
                        "fr": "D'une manière qui contient une insulte ou cause de la peine ; vexant ou blessant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offensively",
                                "target_lang_sense_clarification": "in an insulting manner"
                            },
                            {
                                "target_lang_word": "hurtfully",
                                "target_lang_sense_clarification": "causing emotional pain"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hirientemente",
                                "target_lang_sense_clarification": "de forma ofensiva"
                            },
                            {
                                "target_lang_word": "de forma ofensiva",
                                "target_lang_sense_clarification": "haciendo daño a los sentimientos"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "de manière blessante",
                                "target_lang_sense_clarification": "qui blesse moralement"
                            },
                            {
                                "target_lang_word": "de façon vexante",
                                "target_lang_sense_clarification": "qui vexé ou offense"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "82b7b933-a636-3ce2-945b-a4063399fe1d",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>обидный</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это замечание было крайне <w>обидно</w> для молодого артиста.",
                            "target_lang_translations": {
                                "en": "That remark was extremely <w>hurtful</w> to the young artist.",
                                "es": "Ese comentario fue sumamente <w>ofensivo</w> para el joven artista.",
                                "fr": "Cette remarque était extrêmement <w>blessante</w> pour le jeune artiste."
                            }
                        },
                        {
                            "text": "Сказочное поражение было <w>обидно</w> для всех болельщиков.",
                            "target_lang_translations": {
                                "en": "The incredible defeat was <w>painful</w> for all the fans.",
                                "es": "La dolorosa derrota fue <w>penosa</w> para todos los aficionados.",
                                "fr": "Cette défaite incroyable était <w>douloureuse</w> pour tous les supporters."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form neuter singular of the adjective 'обидный' (offensive, painful, insulting).",
                        "es": "Forma corta neutra del adjetivo обидный (ofensivo, penoso).",
                        "fr": "Forme courte du neutre singulier de l'adjectif « обидный » (blessant, vexant)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offensive",
                                "target_lang_sense_clarification": "causing resentment or offense"
                            },
                            {
                                "target_lang_word": "hurtful",
                                "target_lang_sense_clarification": "causing emotional distress"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ofensivo",
                                "target_lang_sense_clarification": "que resulta hiriente"
                            },
                            {
                                "target_lang_word": "doloroso",
                                "target_lang_sense_clarification": "que causa pena o frustración"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "blessant",
                                "target_lang_sense_clarification": "qui fait de la peine"
                            },
                            {
                                "target_lang_word": "vexant",
                                "target_lang_sense_clarification": "qui vexé"
                            }
                        ]
                    }
                }
            ]
        }
    ]
