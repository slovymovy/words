                        "entry_id": "422fac0b-e228-31e7-8fcd-27a62ebeb0bb",
                        "glosses": [
                            "Qualité d'une fonction mathématique quand elle admet une dérivée."
                        ],
                        "tags": [
                            "analytic"
                        ],
                        "examples": [
                            {
                                "example_id": "1e1dcf49-87f3-427e-b8f2-f02fb4a2d1e5",
                                "sense_id": "7bd66b88-6b03-3b69-8c56-57f092ba9665",
                                "text": "La dérivabilité entraîne la continuité, mais la réciproque est fausse."
                            },
                            {
                                "example_id": "b0128893-69e7-40d5-b44f-27cc9a590fd8",
                                "sense_id": "7bd66b88-6b03-3b69-8c56-57f092ba9665",
                                "text": "Comme pour la continuité, la dérivabilité est liée à l’existence d’une limite."
                            }
                        ]
                    }
