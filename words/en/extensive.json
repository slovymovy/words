{
    "word_family": [
        "extend",
        "extension",
        "extensively",
        "extensiveness",
        "extensible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8b093ec7-25e5-32d9-b5bd-98ddad78341c",
                    "sense_definition": "Large in amount, scope, or degree; dealing with a subject in detail.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "scope_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>extensive</w> knowledge of ancient history due to her studies.",
                            "target_lang_translations": {
                                "ru": "Благодаря учебе у нее <w>обширные</w> знания древней истории.",
                                "zh": "由于长期学习，她对古代史有<w>广博</w>的知识。"
                            }
                        },
                        {
                            "text": "The team conducted <w>extensive</w> research before launching the new product.",
                            "target_lang_translations": {
                                "ru": "Команда провела <w>обширное</w> исследование перед запуском нового продукта.",
                                "zh": "团队在推出新产品之前进行了<w>大量</w>研究。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehensive",
                        "thorough",
                        "substantial",
                        "considerable"
                    ],
                    "antonyms": [
                        "limited",
                        "superficial",
                        "slight"
                    ],
                    "common_phrases": [
                        "extensive research",
                        "extensive knowledge",
                        "extensive experience",
                        "extensive collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой по количеству, охвату или степени; подробно рассматривающий предмет.",
                        "zh": "数量、范围或程度很大；也可指对某个主题涉及面广、内容详尽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "о знаниях, исследованиях или опыте"
                            },
                            {
                                "target_lang_word": "широкий",
                                "target_lang_sense_clarification": "об охвате, кругозоре или связях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广泛",
                                "target_lang_sense_clarification": "指知识、经验、研究等范围大、内容多"
                            },
                            {
                                "target_lang_word": "广博",
                                "target_lang_sense_clarification": "指知识很丰富"
                            },
                            {
                                "target_lang_word": "大量",
                                "target_lang_sense_clarification": "指研究、调查等规模大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00ea8aae-7539-366d-a94d-3206e4d3adeb",
                    "sense_definition": "Covering a large physical area or space; vast.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire caused <w>extensive</w> damage to the roof and upper floors.",
                            "target_lang_translations": {
                                "ru": "Пожар нанес <w>значительный</w> ущерб крыше и верхним этажам.",
                                "zh": "火灾对屋顶和上面几层造成了<w>严重</w>损坏。"
                            }
                        },
                        {
                            "text": "The hotel is surrounded by <w>extensive</w> gardens that are open to the public.",
                            "target_lang_translations": {
                                "ru": "Отель окружен <w>обширными</w> садами, открытыми для публики.",
                                "zh": "酒店四周环绕着向公众开放的<w>大片</w>花园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vast",
                        "widespread",
                        "broad",
                        "wide"
                    ],
                    "antonyms": [
                        "small",
                        "narrow",
                        "restricted"
                    ],
                    "common_phrases": [
                        "extensive damage",
                        "extensive grounds",
                        "extensive network",
                        "extensive area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий большую физическую площадь или пространство; огромный.",
                        "zh": "覆盖很大的实际区域或空间；广大的，广阔的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "о территории, пространстве или повреждениях"
                            },
                            {
                                "target_lang_word": "значительный",
                                "target_lang_sense_clarification": "об ущербе или масштабе последствий"
                            }
