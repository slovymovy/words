                        ]
                    },
                    {
                        "translation_id": "c348953a-a8f9-41d0-9e84-ff711b756ddf",
                        "source_entry_id": "7c51a303-2a6e-3ff9-ba9b-2b638927c080",
                        "source_sense_id": "d937590d-8780-3463-a5d7-3711d5a3e49d",
