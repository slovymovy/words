                "senses": [
                    {
                        "sense_id": "dbfc085e-e7d2-3508-8c73-927e3b50ad27",
                        "entry_id": "ac30f489-b9dc-38df-bfde-7dc339a63d4c",
                        "glosses": [
                            "религ. религиозно-моральное предписание, завет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68bdeafa-1b9a-4880-972f-bdb151f60f85",
                                "sense_id": "dbfc085e-e7d2-3508-8c73-927e3b50ad27",
                                "text": "Сия есть заповедь Моя, да любите друг друга, как Я возлюбил вас."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e7e0108-580c-3f90-8d76-ebc4c9adccf7",
                        "entry_id": "ac30f489-b9dc-38df-bfde-7dc339a63d4c",
                        "glosses": [
                            "перен. правило или постулат, которому рекомендуется следовать"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7be2f32-a6ab-468b-bb5a-f22896d63d92",
                        "source_entry_id": "ac30f489-b9dc-38df-bfde-7dc339a63d4c",
                        "target_lang_word": "commandment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "A divinely ordained command, especially one of the Ten Commandments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a1f681-1d76-4903-81b4-bd2203e2add4",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "A new commandement I giue vnto you, That yee loue one another, as I haue loued you, that yee alſo loue one another."
                                            },
                                            {
                                                "example_id": "2c2aa9b1-fc47-45f8-83e5-03db0aa5121d",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "But besides having the bent of the affections towards Him, and desiring His favour, His near presence with us, there is that great rule of His, “This is love, that we walk after His commandments.”"
                                            },
                                            {
                                                "example_id": "6c8c7e02-62dc-483f-963b-db26e051a7c1",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "Even those commandments which have a rational basis are kept by Jews only because that is God's will (Aruch HaShulchan). This lesson is encapsulated in the story of Dama ben Nesina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "Something that must be obeyed; a command or edict."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e78708-0d03-47b3-b521-a5dc83a72323",
                                                "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                                "text": "Pau. Pray you then, / Conduct me to the Queene. / Gao. I may not (Madam) / To the contrary I haue expreſſe commandment."
                                            },
                                            {
                                                "example_id": "5f1f122a-7ae2-4480-9e12-8dcda96d26d6",
                                                "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                                "text": "The HIG delivers Apple's design commandments, the company's definition of what it means to be a good iPhone citizen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57395324-d09c-3862-898e-e6473df73149",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "The offence of commanding or inducing another to violate the law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "The act of commanding; exercise of authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7947b0ae-b4b5-4d9d-ba57-f0a90c3c3ad2",
                                                "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                                "text": "To rule, is vnderſtoode to haue the higheſt and ſupreme authoritie of commaundement."
                                            },
                                            {
                                                "example_id": "4bfa0d0a-0279-4884-9bb0-fa876579571e",
                                                "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                                "text": "Speake you ſo gently? Pardon me I pray you, / I thought that all things had bin ſauage heere, / And therefore put I on the countenance / Of ſterne command'ment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
