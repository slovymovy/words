                "senses": [
                    {
                        "sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                        "entry_id": "289fbfe3-af3b-3e20-b3fe-b84f24b7538e",
                        "glosses": [
                            "een bijzondere hoedanigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485b7468-358a-4bd8-8d31-69a4a024e29d",
                                "sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                                "text": "Vond jij dat ook zo'n eigenaardigheid?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a25db7b-be73-47c5-96c3-9e74370276da",
                        "source_entry_id": "289fbfe3-af3b-3e20-b3fe-b84f24b7538e",
                        "source_sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                        "source_sense_description": "een bijzondere hoedanigheid",
                        "target_lang_word": "Eigenart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                        "entry_id": "57924595-acfb-3edc-ac26-cb6c74088b14",
                                        "glosses": [
                                            "eine einzelne, spezifische Besonderheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72bd186-17f2-4643-bfb8-b7471d357471",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "Eine Eigenart der deutschen Sprache ist die anschauliche Wortprägung."
                                            },
                                            {
                                                "example_id": "da0da4c2-b547-4d4f-a91a-bce8ece70f97",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "„Es gibt in Polen diese wunderbare Eigenart, fremde Menschen nicht mit ihrem Nachnamen anzusprechen.“"
                                            },
                                            {
                                                "example_id": "1e638da6-3bef-4d2f-ae7c-d2e50714d500",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "Der Hund hat die Eigenart, immer im Kreis zu tanzen, sobald er seinen Fressnapf sieht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                        "entry_id": "57924595-acfb-3edc-ac26-cb6c74088b14",
                                        "glosses": [
                                            "summierte Besonderheiten, die ein Charakteristikum ausmachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de937bb-1fda-4b4f-9028-4155d9938dac",
                                                "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                                "text": "Wenn Sie erst einmal die Eigenart unserer Firma kennengelernt haben, werden Sie sich sicher schnell hier sehr wohl fühlen."
                                            },
                                            {
                                                "example_id": "f93d34cd-f13a-4d11-83d2-e0778668b644",
                                                "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                                "text": "„Eine andere und sozusagen berufsmäßige Eigenart Pauls bestand darin, daß seine ganze Teilnahme und Arbeitskraft nur den Verwundeten in seinem Lazarett galt, so daß der sterbende Brussaroff in Gurna ihn weniger interessierte als ein beliebiger Soldat, den er am Tag vorher operiert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5b700d8-9477-4784-b9f9-16e14d7f56cd",
                        "source_entry_id": "289fbfe3-af3b-3e20-b3fe-b84f24b7538e",
                        "source_sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                        "source_sense_description": "een bijzondere hoedanigheid",
                        "target_lang_word": "peculiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peculiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "The quality or state of being peculiar; individuality; singularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bb12eb-65c6-4386-887a-646a360cd813",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "The peculiarity of meeting six people on a usually deserted trail only struck me later on."
                                            },
                                            {
                                                "example_id": "654b88a2-ccc5-44fd-ad41-917a73e521ac",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "“'There is always a moment when the familiar becomes the strange,'” Cora recited, as she stood looking around at the bustling open docking area of Tamayo Point. “'Look at your own hand and you will eventually notice the variation of textures, the growth of nails and the fade of scars, the peculiarity of having five fingers instead of three.'”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "That which is peculiar; a special and distinctive characteristic or habit; particularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77b41d7-c494-4aad-a9a9-914e9a743099",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I had often heard of Miss Marchmont, and of her peculiarities (she had the character of being very eccentric), but till now had never seen her."
                                            },
                                            {
                                                "example_id": "226f8eef-e171-42ca-adf4-e30e0365b60e",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I thought Alice and H. J. P. would have fainted at the full spectacle; but we are fast getting used to the little peculiarities of foreigners and I trust they will forgive us many sins in return."
                                            },
                                            {
                                                "example_id": "f5520c2d-343d-4ad6-97f1-7aaf6a3ce5ec",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "The peculiarity of this invention consists in a means for varying the angle at which the plaiting-blade is held in the plaiter without varying the position of the entire instrument upon the sewing-machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938863ca-cb92-3dad-a0c5-0bfdccbaa01d",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "Exclusive possession or right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f159a49-032d-45c2-b065-b4e515fe9458",
                        "source_entry_id": "289fbfe3-af3b-3e20-b3fe-b84f24b7538e",
                        "source_sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                        "source_sense_description": "een bijzondere hoedanigheid",
                        "target_lang_word": "particularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                        "entry_id": "53a6c37f-6f20-39b8-a24d-b98d07b16b62",
                                        "glosses": [
                                            "Caractère particulier d’un objet, d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf66d3d-4077-474d-af2a-a4b413fd2431",
                                                "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                                "text": "Le lorrain, dont la prononciation reproduit souvent la nôtre dans ses particularités les plus caractéristiques, dit aussi ma, pâ, jemâ pour mais, paix, jamais : si v'piâ z = s'il vous plaît."
                                            },
                                            {
                                                "example_id": "2f98a82b-44d5-4cee-8f01-72cf239a0d88",
                                                "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                                "text": "Ainsi parlait Hérodote des Sassanides, soulignant la particularité du zoroastrisme, culte officiel de l’État perse de l'époque : son monothéisme. Bien avant l’avènement du christianisme et sans doute du judaïsme, les zoroastriens plaçaient leur foi en une divinité unique et abstraite, Ahura Mazda (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                        "entry_id": "53a6c37f-6f20-39b8-a24d-b98d07b16b62",
                                        "glosses": [
                                            "Circonstance particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b788025-0bdd-4ea6-9edf-1239f52e2dcc",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Vous venez de le voir, mon jeune ami, reprit le vieillard, il était impossible que vous restassiez plus longtemps parmi nous sans connaître quelques-unes des affreuses particularités de la vie de cette sainte femme."
                                            },
                                            {
                                                "example_id": "af52b49f-6c90-45f4-ba2e-dbb3b5ada54c",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Particularité essentielle, remarquable, importante, curieuse."
                                            },
                                            {
                                                "example_id": "404e244d-3b60-4266-8c9d-e7b69b814ec7",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Il m’a conté toutes les particularités de cette affaire."
                                            },
                                            {
                                                "example_id": "f61b0669-3c5d-477b-ae31-07200b1ada33",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Il a omis dans son récit plusieurs particularités nécessaires."
                                            },
                                            {
                                                "example_id": "f29c1acc-211f-42f7-8c1d-4be56932a554",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Je ne savais pas cette particularité de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
