                "senses": [
                    {
                        "sense_id": "79619ccd-6184-36d1-b365-76d986c24030",
                        "entry_id": "af6ebb0b-ade8-3815-b9dd-2b9116f3b9ec",
                        "glosses": [
                            "Person, die verdächtigt wird, eine Tat begangen zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bcb882-9c5d-48ce-a6bb-b710b458b3e8",
                                "sense_id": "79619ccd-6184-36d1-b365-76d986c24030",
                                "text": "Herr Schulze gilt im Fall der Körperverletzung an Frau Müller als Tatverdächtiger."
                            },
                            {
                                "example_id": "0942aa88-241e-4c01-94cf-99a15b7e401e",
                                "sense_id": "79619ccd-6184-36d1-b365-76d986c24030",
                                "text": "Der Polizei zufolge beobachtete ein Zeuge, wie ein Tatverdächtiger einen Gegenstand durch ein Fenster der Moschee warf. Daraufhin habe sich das Feuer entzündet. Der mutmaßliche Täter konnte flüchten."
                            },
                            {
                                "example_id": "16f72479-16c6-43a5-904e-c422ea03ec43",
                                "sense_id": "79619ccd-6184-36d1-b365-76d986c24030",
                                "text": "Ein Tatverdächtiger wurde zunächst wegen Mordes verurteilt, aber trotz schwerwiegender Indizien in einem späteren Revisionsverfahren freigesprochen. Nach über 30 Jahren tauchten nun neue Beweise gegen den Täter auf, doch weil sein Freispruch rechtskräftig ist, ist es fast unmöglich, wieder gegen ihn zu ermitteln."
                            },
                            {
                                "example_id": "6261d24b-274a-491b-a440-95b2b02cfba3",
                                "sense_id": "79619ccd-6184-36d1-b365-76d986c24030",
                                "text": "„Am 9. Januar 2017 können sie 17 Tatverdächtige verhaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
