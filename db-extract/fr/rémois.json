                "senses": [
                    {
                        "sense_id": "a4032271-6916-346d-953b-4ea0193c9b97",
                        "entry_id": "f32d6665-b062-35b2-92a4-b196b8dbea02",
                        "glosses": [
                            "Habitant de Reims, commune française située dans le département de la Marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e1c93b-f791-4728-bbb7-f1aeb54d0a75",
                                "sense_id": "a4032271-6916-346d-953b-4ea0193c9b97",
                                "text": "Des éléments de meubles ou de coffrets, des ustensiles pour la conservation, la préparation et la consommation des aliments (bouchons, écuelles, couteaux, baquet), des accessoires de toilette ou de pharmacopée (peignes, pyxides, boîtes), des instruments liés au travail du textile – dont une des plus belles collections d’Europe de brosses à affiner les draps – sont les témoins d’activités artisanales qui offrent une vision très réaliste de la vie quotidienne des Rémois des premiers siècles de notre ère."
                            },
                            {
                                "example_id": "e4fcc41b-85a9-4007-90cc-b75d34652d2c",
                                "sense_id": "a4032271-6916-346d-953b-4ea0193c9b97",
                                "text": "Chalumot s’en éloigna peu à peu, d’autant plus que Lepage manifestait une intolérable suffisance, et fit entre-temps la rencontre d’un autre Rémois, élève de la 2ᵉ section."
                            }
                        ]
                    },
