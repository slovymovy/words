                "senses": [
                    {
                        "sense_id": "083b8b11-ea21-36ba-8e56-f1e8fefc07e8",
                        "entry_id": "18835c98-bbd7-3b4c-8205-6fe3f9befe50",
                        "glosses": [
                            "Quark mit (frischen) Früchten, Fruchtstücken"
