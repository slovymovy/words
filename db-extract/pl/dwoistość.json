                                "target_senses": [
                                    {
                                        "sense_id": "6e532e41-8819-3051-b14b-9fa3c466aec2",
                                        "entry_id": "b6e7f605-e428-362a-b1f3-4eff9a7ccb3d",
                                        "glosses": [
                                            "The state or condition of being two; duality; doubleness."
                                        ],
                                        "tags": [
                                            "countable",
