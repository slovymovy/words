                        "glosses": [
                            "Personne qui écrit des mimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9101871-b0af-4fd0-aaf6-76b28a2f4e1f",
                                "sense_id": "ba78d9f0-a9f8-39a4-b714-152fab8af53e",
                                "text": "Dans les autres genres de poésie, le seul homme qui semble avoir fait preuve alors dʼune certaine faculté dʼinvention est le mimographe Philistion, qui vécut probablement sous Auguste et sous Tibère."
                            },
                            {
                                "example_id": "a0e427db-dfa1-401d-b27c-038fbf91e2f7",
                                "sense_id": "ba78d9f0-a9f8-39a4-b714-152fab8af53e",
                                "text": "Lʼépouse décide alors, sans consulter la mimographe, de passer à un plan plus audacieux et de devenir actrice."
                            }
                        ]
                    }
                ],
