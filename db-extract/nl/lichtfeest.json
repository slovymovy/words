                        "examples": [
                            {
                                "example_id": "f907ed05-497f-4738-9521-e9c0b8402091",
                                "sense_id": "4c1492f4-2144-324a-82d7-637377e9f1ca",
                                "text": "Hij kon koffie bij Starbucks kopen of oprecht en uit volle borst het volkslied zingen als hij met vrienden naar een wedstrijd van de Knicks ging, maar even zo goed de ochtend erna het lichtfeest Dipavali met zijn vrouw vieren alsof ze zich allebei nog in het microscopische dorpje bij Kanrwasi bevonden."
                            },
                            {
                                "example_id": "3297dc52-d3de-4a6b-a821-bdefb9c3d5f5",
                                "sense_id": "4c1492f4-2144-324a-82d7-637377e9f1ca",
                                "text": "Elk jaar trekken zo'n honderdduizend mensen naar Saint Raphael in het zuiden van Frankrijk om met kerstmis het Feest van Licht mee te maken. Het stadje verandert dan in een zee van licht en muziek. Een impressie van het lichtfeest op de kathedraal van Saint Raphael."
                            }
                        ]
                    }
