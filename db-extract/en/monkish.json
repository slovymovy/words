    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9dc2f52d-abf5-38ff-aee0-b5d07e686918",
                "word": "monkish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e157390e-7731-3d8f-bc95-5ee4ca73e99c",
                        "entry_id": "9dc2f52d-abf5-38ff-aee0-b5d07e686918",
                        "glosses": [
                            "Pertaining to, or resembling, a monk or monasticism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f272060b-de83-4017-a44a-46a6cecf252d",
                                "sense_id": "e157390e-7731-3d8f-bc95-5ee4ca73e99c",
                                "text": "Among the most curious, original, and lively of the monkish Latin poems, are those least in harmony with their cold ascetic discipline."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8e55b6b-8ce3-3fac-9e51-dd3d8d31da69",
                        "entry_id": "9dc2f52d-abf5-38ff-aee0-b5d07e686918",
                        "glosses": [
                            "Tending to self-denial; ascetic."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c00af75-bbaf-430f-bb58-1fa953b23252",
                        "source_entry_id": "9dc2f52d-abf5-38ff-aee0-b5d07e686918",
                        "source_sense_description": "pertaining to, or resembling a monk or monasticism",
                        "target_lang_word": "mönchisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mönchisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                        "entry_id": "ad5a6597-13b4-3ac9-8092-d674add69294",
                                        "glosses": [
                                            "von den Sitten und Gebräuchen, der Lebensweise, dem Wesen eines Mönches ausgehend, diesen/dieser/diesem entsprechend, zu diesen/dieser/diesem gehörend; wie ein Mönch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86bef984-5f69-4f66-aca7-1093a248ff66",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Er führt ein Leben von geradezu mönchischer Einfachheit.“"
                                            },
                                            {
                                                "example_id": "5e310504-b03d-486f-b72c-3f5447fa92e9",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„In seiner Existenz schwankte er zwischen überbordender Geselligkeit und fast mönchischem Weltverzicht.“"
                                            },
                                            {
                                                "example_id": "f7d6e7a9-756f-498b-887b-ad80188f76f7",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Aus dem St.Galler Projekt stammen die gewaltigen Ausmasse (die in den Masszahlen auf dem Plan zu finden sind); der Reichenauer Beitrag besteht in der Zeichnung, die ein eher bescheideneres, mönchischeres Gotteshaus empfahl.“"
                                            },
                                            {
                                                "example_id": "3111e9ea-77c0-4758-91ae-1b3191775b6a",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Es war eine mönchische Geißelung, der er sich unterzog, und die Blutentnahme war ein Versuch, wie die Hanteln, die Morgenläufe, die Rumpfbeugen, die Atemübungen, ein Gleichgewicht herzustellen zwischen den Kräften und Forderungen des Körpers und der Seele.“"
                                            },
                                            {
                                                "example_id": "a87c02b7-e0e2-4df8-b380-6456d50c1bda",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Bei Garzón mischen sich mönchisches und mondänes Gehabe.“"
                                            },
                                            {
                                                "example_id": "8b1c51b1-ceaf-48f1-a7ec-0ed009af00af",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Weil die Pagoden der Mittelpunkt der Khmerkultur sind, kommen sowohl dem mönchischen Nachwuchs wie der Ausstrahlung der Mönche auf die Glaubensgemeinschaft große Bedeutung zu. […] Traditionell ist ein buddhistischer Mönch nicht lebenslang an die Robe gebunden. Kim Khanh: ‚Wir begrenzen die Zeit des mönchischen Lebens nicht. […]‘“"
                                            },
                                            {
                                                "example_id": "901b4d40-1d9e-4a78-bd19-bfe52d897d89",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„18 Monate lebte er fast mönchisch in der Wüste.“"
                                            },
                                            {
                                                "example_id": "5b3aeef5-4b2b-44ca-94cb-4377b36adccf",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Konzentration, Askese, Demut, nichts soll ablenken von der Musik - wer zum Philharmonia-Quartett in den Kammermusiksaal geht, bekommt erneut bestätigt, dass Streichquartett wirklich die mönchischste, vergeistigtste, geistvollste aller Gattungen ist.“"
                                            },
                                            {
                                                "example_id": "48f6ad1f-1869-4be4-b2d7-767e20a4586a",
                                                "sense_id": "29272023-5773-3fdd-9795-59513cabccf0",
                                                "text": "„Sie macht nur die kleine Lampe auf ihrem Schreibtisch an. In deren Schein, in der mönchischen Stille, findet sie zur Konzentration ihrer Studienzeit zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
