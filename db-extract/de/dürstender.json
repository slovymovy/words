                ],
                "senses": [
                    {
                        "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                        "entry_id": "e43bc729-9069-39ea-8c5c-905e0e7cd358",
                        "glosses": [
                            "Person, die Durst hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be41077c-694c-411f-8971-09cbe6c33614",
                                "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                                "text": "„Der Dürstende hält sie für Wasser bis er, wenn er hinzutritt, sie als Nichts findet.“"
                            },
                            {
                                "example_id": "cdb50a60-4c90-41f8-94ed-49014c206ada",
                                "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                                "text": "„Den Dürstenden, die zu Jesus kommen und an ihn glauben, wurde verheißen, dass sie genug zu trinken bekommen, ihren Lebensdurst stillen können.“"
                            },
                            {
                                "example_id": "9f682bb9-0228-4fe2-a9df-8c0f8bcbbd6a",
                                "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                                "text": "„Möge Er dir zeitlebens den schönsten Segen gönnen, Hungrige zu speisen, Dürstende zu tränken, Nackende zu kleiden, Fremde zu beherbergen, Kranke zu laben.“"
                            },
                            {
                                "example_id": "127ed0d8-3a0e-42c0-8865-e65295dc3a21",
                                "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                                "text": "„Laut Bibel gehören zu den sieben Werken der Barmherzigkeit: die Hungernden speisen, den Dürstenden zu trinken geben, die Nackten bekleiden, die Fremden aufnehmen, die Kranken besuchen, die Gefangenen besuchen, Tote begraben.“"
                            },
                            {
                                "example_id": "55fb55fe-2ff2-46bf-94b6-57432a71d5ef",
                                "sense_id": "637bae86-11ac-3426-b567-4d0b740d8c8b",
                                "text": "„Hungrigen zu essen geben und Dürstenden zu trinken geben; Fremde und Obdachlose aufnehmen und Nackte bekleiden; Gefangene und Kranke besuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                        "entry_id": "e43bc729-9069-39ea-8c5c-905e0e7cd358",
                        "glosses": [
                            "Person, die stark nach etwas verlangt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "9457dbfb-e675-470b-bfa9-70f1dd5682b8",
                                "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                                "text": "„Selig der Dürstende, der zu den stillen Strömen Meiner Gnade eilt.“"
                            },
                            {
                                "example_id": "0d9af0ec-ceb9-4d17-a57a-ff154cf71c97",
                                "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                                "text": "„Während nach Bier Dürstende und von Stelzen Entwöhnte nach langen, dunklen Monaten ihre ersten zehn, zwanzig Budweiser verinnerlichen werden, wird mitten unter ihnen einer sitzen, der eine Schokotorte isst.“"
                            },
                            {
                                "example_id": "69463704-2593-40d7-8f9b-036dfaf3e9f2",
                                "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                                "text": "„Bis in den September hinein können nach Kultur Hungernde und Dürstende ihr Verlangen auf vielfältige Weise stillen.“"
                            },
                            {
                                "example_id": "9a633798-c08f-48b8-9ec6-a63e5de93810",
                                "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                                "text": "„Und da kam Aims ab 1971 und begann mit seinen Studierenden, mit seinem Orchester mit jungen Sängerinnen und Sängern aus Übersee, die in Graz in Meisterkursen ihren Feinschliff bekommen, die nach Kultur Dürstenden unserer Stadt zu laben.“"
                            },
                            {
                                "example_id": "e59c7b6c-d07f-4b62-8236-b6176b6ed5d0",
                                "sense_id": "bcf7c63c-2e10-3fac-9e1c-096e1bc09d48",
                                "text": "„Auch wenn sich SPD-Spitzenkandidat Schulz lieber um Golffahrer als um Golfspieler kümmern möchte (Suchwort ‚Golf‘) – die nach Antworten Dürstenden beschäftigt vielmehr die wenig schmeichelhafte und ewige Frage nach ‚Alkohol‘ und ‚Alkoholiker‘.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
