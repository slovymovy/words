                    {
                        "sense_id": "a36aa5d3-f967-309b-a307-8c4b929320ef",
                        "entry_id": "fb3e4186-4d41-385b-950b-585f4831a2e6",
                        "glosses": [
                            "Assurer une nouvelle correspondance entre deux objets."
                        ],
                        "tags": [
