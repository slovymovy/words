                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to discontinue or cease an ongoing action"
                            },
                            {
                                "target_lang_word": "suspend",
                                "target_lang_sense_clarification": "to temporarily halt an activity or process"
                            },
                            {
                                "target_lang_word": "break off",
                                "target_lang_sense_clarification": "to abruptly end something ongoing like relations or negotiations"
