{
    "word_family": [
        "salient"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8080617-4e6a-3bc8-96bd-cf42cc141dcd",
                    "sense_definition": "The quality of being particularly noticeable or prominent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prominence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salience</w> of the bright red sign made it impossible to ignore.",
                            "target_lang_translations": {
                                "ru": "<w>Заметность</w> ярко-красного знака делала невозможным не обратить на него внимания."
                            }
                        },
                        {
                            "text": "Researchers studied the visual <w>salience</w> of different colors in advertising.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили визуальную <w>броскость</w> различных цветов в рекламе."
                            }
                        }
                    ],
                    "synonyms": [
                        "prominence",
                        "noticeability",
                        "conspicuousness"
                    ],
                    "antonyms": [
                        "inconspicuousness"
                    ],
                    "common_phrases": [
                        "visual salience",
                        "high salience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть особенно заметным, бросающимся в глаза или выделяющимся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметность",
                                "target_lang_sense_clarification": "свойство привлекать внимание, выделяться"
                            },
                            {
                                "target_lang_word": "выразительность",
                                "target_lang_sense_clarification": "яркость, отчетливость"
                            },
                            {
                                "target_lang_word": "броскость",
                                "target_lang_sense_clarification": "свойство бросаться в глаза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "806fa53c-dec2-335f-954d-49b4e724d93e",
                    "sense_definition": "The state of being important or relevant within a specific context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prominence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salience</w> of this issue has grown significantly during the recent election.",
                            "target_lang_translations": {
                                "ru": "<w>Актуальность</w> этого вопроса значительно возросла в ходе последних выборов."
                            }
                        },
                        {
                            "text": "We must consider the <w>salience</w> of these factors when making our final decision.",
                            "target_lang_translations": {
                                "ru": "Мы должны учитывать <w>значимость</w> этих факторов при принятии окончательного решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "relevance",
                        "importance",
                        "significance"
                    ],
                    "antonyms": [
                        "irrelevance"
                    ],
                    "common_phrases": [
                        "political salience",
                        "issue salience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень важности, актуальности или значимости в определенном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значимость",
                                "target_lang_sense_clarification": "важность, вес чего-либо в контексте"
                            },
                            {
                                "target_lang_word": "актуальность",
                                "target_lang_sense_clarification": "злободневность, насущность вопроса"
                            },
                            {
                                "target_lang_word": "важность",
                                "target_lang_sense_clarification": "существенность для контекста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79aa3dac-0aa0-3448-84ba-20f724693fe7",
                    "sense_definition": "The general state or condition of being salient.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prominence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salience</w> of the argument depends entirely on the evidence provided.",
                            "target_lang_translations": {
                                "ru": "<w>Весомость</w> аргумента полностью зависит от предоставленных доказательств."
                            }
                        },
                        {
                            "text": "He discussed the <w>salience</w> of the theory in modern philosophical debates.",
                            "target_lang_translations": {
                                "ru": "Он обсудил <w>значимость</w> этой теории в современных философских дебатах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее свойство или состояние быть ключевым, выпуклым или основополагающим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весомость",
                                "target_lang_sense_clarification": "убедительность, вескость (напр. аргумента)"
                            },
                            {
                                "target_lang_word": "релевантность",
                                "target_lang_sense_clarification": "применимость и содержательная ценность"
                            },
                            {
                                "target_lang_word": "салиентность",
                                "target_lang_sense_clarification": "специальный научный или философский термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}