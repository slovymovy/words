    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8ae26f4-809d-390a-b834-0180d807031a",
                    "sense_definition": "Фигура, состоящая из двух пересекающихся линий или полос.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На белом флаге был изображён красный <крест>.",
                            "target_lang_translations": {
                                "en": "A red <cross> was depicted on the white flag.",
                                "de": "Auf der weißen Flagge war ein rotes <w>Kreuz</w> abgebildet."
                            }
                        },
                        {
                            "text": "Дороги пересекались, образуя правильный <крест>.",
                            "target_lang_translations": {
                                "en": "The roads intersected, forming a perfect <cross>.",
                                "de": "Die Straßen kreuzten sich und bildeten ein regelmäßiges <w>Kreuz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "крест-накрест"
                    ],
                    "target_lang_definitions": {
                        "en": "A figure consisting of two intersecting lines or strips.",
                        "de": "Eine Figur aus zwei sich schneidenden Linien oder Streifen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "geometric shape"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "geometrische Form; zwei sich kreuzende Linien oder Balken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8936e088-33ae-37aa-88d3-5181a1d32af0",
                    "sense_definition": "Символ христианской веры; предмет культа в такой форме, а также молитвенный жест рукой.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка всегда носила нательный <крест> на цепочке.",
                            "target_lang_translations": {
                                "en": "Grandmother always wore a pectoral <cross> on a chain.",
                                "de": "Meine Großmutter trug immer ein <w>Kreuz</w> an einer Kette."
                            }
                        },
                        {
                            "text": "Священник осенил прихожан <крестом>.",
                            "target_lang_translations": {
                                "en": "The priest made the sign of the <cross> over the parishioners.",
                                "de": "Der Priester segnete die Gemeindemitglieder mit dem <w>Kreuzzeichen</w>."
                            }
                        },
                        {
                            "text": "Золотой <крест> на церкви ярко блестел на солнце.",
                            "target_lang_translations": {
                                "en": "The golden <cross> on the church shone brightly in the sun.",
                                "de": "Das goldene <w>Kreuz</w> auf der Kirche glänzte hell in der Sonne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нательный крест",
                        "вот те крест"
                    ],
                    "target_lang_definitions": {
                        "en": "A symbol of the Christian faith; a religious object in this form, as well as a prayer gesture with the hand.",
                        "de": "Das Symbol des Christentums; ein Kultgegenstand in dieser Form sowie die Gebetsgeste mit der Hand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "religious symbol or object"
                            },
                            {
                                "target_lang_word": "crucifix",
                                "target_lang_sense_clarification": "representation of the cross with Jesus"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "christliches Symbol oder religiöser Gegenstand"
                            },
                            {
                                "target_lang_word": "Kreuzzeichen",
                                "target_lang_sense_clarification": "Gebetsgeste mit der Hand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcc70414-b99a-3276-a8d9-128e1e8644ad",
                    "sense_definition": "Пометка в виде двух пересекающихся черт; часто используется как подпись неграмотного человека или знак отмены.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вместо подписи она поставила в документе <крест>.",
                            "target_lang_translations": {
                                "en": "Instead of a signature, she put a <cross> on the document.",
                                "de": "Anstelle einer Unterschrift setzte sie ein <w>Kreuz</w> auf das Dokument."
                            }
                        },
                        {
                            "text": "Нужно поставить <крест> напротив правильного ответа.",
                            "target_lang_translations": {
                                "en": "You need to put a <cross> next to the correct answer.",
                                "de": "Man muss ein <w>Kreuz</w> neben die richtige Antwort setzen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поставить крест"
                    ],
                    "target_lang_definitions": {
                        "en": "A mark in the form of two intersecting lines; often used as a signature by an illiterate person or a sign of cancellation.",
                        "de": "Eine Markierung in Form zweier sich kreuzender Striche; oft als Zeichen statt einer Unterschrift oder zum Ankreuzen bzw. Streichen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "mark on paper"
                            },
                            {
                                "target_lang_word": "X",
                                "target_lang_sense_clarification": "mark"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "Zeichen auf Papier, z. B. beim Ankreuzen oder statt einer Unterschrift"
                            },
                            {
                                "target_lang_word": "X",
                                "target_lang_sense_clarification": "schriftliches Zeichen in X-Form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1aded26-5473-3aa4-96cf-2125363dee17",
                    "sense_definition": "Тяжёлая судьба, жизненные страдания и испытания (переносное значение).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она безропотно несла свой тяжкий <крест> всю жизнь.",
                            "target_lang_translations": {
                                "en": "She uncomplainingly bore her heavy <cross> all her life.",
                                "de": "Sie trug ihr schweres <w>Kreuz</w> ihr ganzes Leben lang ohne Klage."
                            }
                        },
                        {
                            "text": "Это мой <крест>, и я должен справиться с этим сам.",
                            "target_lang_translations": {
                                "en": "This is my <cross> to bear, and I must deal with it myself.",
                                "de": "Das ist mein <w>Kreuz</w>, und ich muss damit selbst fertigwerden."
                            }
                        }
                    ],
                    "synonyms": [
                        "страдание",
                        "испытание"
                    ],
                    "common_phrases": [
                        "нести свой крест"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage context described as archaic in source, though common in idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A heavy fate, life sufferings and trials (figurative meaning).",
                        "de": "Ein schweres Schicksal, Leiden und Prüfungen des Lebens im übertragenen Sinn."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "burden or trial"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kreuz",
                                "target_lang_sense_clarification": "bildlich: schwere Last, Leid oder Prüfung des Lebens"
                            },
                            {
                                "target_lang_word": "Last",
                                "target_lang_sense_clarification": "allgemeiner, weniger idiomatisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62e22e9a-9f26-303b-9ca4-e771c6e8d5b0",
                    "sense_definition": "Государственная награда или орден, имеющие форму креста.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За храбрость в бою офицер получил Георгиевский <крест>.",
                            "target_lang_translations": {
                                "en": "For bravery in battle, the officer received the St. George <Cross>.",
                                "de": "Für seine Tapferkeit im Kampf erhielt der Offizier das Georgs-<w>Kreuz</w>."
                            }
                        },
                        {
                            "text": "На его мундире висел железный <крест>.",
                            "target_lang_translations": {
                                "en": "An Iron <Cross> hung on his uniform.",
                                "de": "An seiner Uniform hing ein Eisernes <w>Kreuz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Георгиевский крест"
                    ],
                    "target_lang_definitions": {
                        "en": "A state award or order having the shape of a cross.",
                        "de": "Ein staatlicher Orden oder eine Auszeichnung in Form eines Kreuzes."
                    },
                    "translations": {
