{
    "word_family": [
        "color",
        "colorful",
        "colorless",
        "coloring",
        "colorist",
        "coloration",
        "discolor",
        "multicolor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c911ffc-47ef-3b1c-aa3b-3ca6f7b86dd0",
                    "sense_definition": "Having a color; not black, white, or transparent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "literal_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used <w>colored</w> pencils to draw a rainbow.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>цветные</w> карандаши, чтобы нарисовать радугу.",
                                "zh": "她用<w>彩色</w>铅笔画了一道彩虹。"
                            }
                        },
                        {
                            "text": "The bird has brightly <w>colored</w> feathers that attract a mate.",
                            "target_lang_translations": {
                                "ru": "У этой птицы ярко <w>окрашенные</w> перья, которые привлекают партнера.",
                                "zh": "这种鸟有色彩鲜艳的羽毛，用来吸引配偶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colorful"
                    ],
                    "antonyms": [
                        "colorless",
                        "achromatic"
                    ],
                    "common_phrases": [
                        "colored pencils",
                        "brightly colored",
                        "dark-colored",
                        "cream-colored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий цвет; не черно-белый и не прозрачный.",
                        "zh": "具有颜色的；非黑白或透明的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветно́й",
                                "target_lang_sense_clarification": "имеющий окраску"
                            },
                            {
                                "target_lang_word": "окрашенный",
                                "target_lang_sense_clarification": "покрытый краской или цветом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彩色",
                                "target_lang_sense_clarification": "具有颜色的"
                            },
                            {
                                "target_lang_word": "有色",
                                "target_lang_sense_clarification": "带有颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fadd2edf-c515-3479-bfac-07c2472fddd9",
                    "sense_definition": "Biased; pervasively influenced in a particular way by personal feelings or opinions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_bias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His judgment of the situation was <w>colored</w> by his past experiences.",
                            "target_lang_translations": {
                                "ru": "Его суждение о ситуации было <w>окрашено</w> его прошлым опытом.",
                                "zh": "他对局势的判断<w>受到</w>他过去经历的影响。"
                            }
                        },
                        {
                            "text": "The newspaper presented a highly <w>colored</w> account of the political event.",
                            "target_lang_translations": {
                                "ru": "Газета представила сильно <w>приукрашенный</w> отчет о политическом событии.",
                                "zh": "报纸对这一政治事件进行了极具<w>偏见</w>的报道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "colored view",
                        "colored opinion",
                        "colored judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предвзятый; находящийся под сильным влиянием личных чувств или мнений.",
                        "zh": "带有偏见的；受到个人情感或观点强烈影响的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвзятый",
                                "target_lang_sense_clarification": "необъективный"
                            },
                            {
                                "target_lang_word": "искажённый",
                                "target_lang_sense_clarification": "представленный в ложном свете"
                            },
                            {
                                "target_lang_word": "приукрашенный",
                                "target_lang_sense_clarification": "о рассказе или описании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带有偏见",
                                "target_lang_sense_clarification": "不客观的"
                            },
                            {
                                "target_lang_word": "受影响",
                                "target_lang_sense_clarification": "被某种观点左右"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "061516f1-3a2c-3123-b1a5-38a149206c57",
                    "sense_definition": "Of skin color other than white; in particular, Black (often considered offensive in modern contexts).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "race_us",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum exhibit explores the history of <w>colored</w> soldiers during the war.",
                            "target_lang_translations": {
                                "ru": "Музейная экспозиция исследует историю <w>цветных</w> солдат во время войны.",
                                "zh": "博物馆的展览探讨了战争期间<w>有色人种</w>士兵的历史。"
                            }
                        },
                        {
                            "text": "In the mid-20th century, there were separate schools for <w>colored</w> children.",
                            "target_lang_translations": {
                                "ru": "В середине 20-го века существовали отдельные школы для <w>цветных</w> детей.",
                                "zh": "在20世纪中期，有色人种儿童有专门的学校。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "colored people"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in historical contexts, often offensive today"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О цвете кожи, отличном от белого; в частности, о чернокожих (часто считается оскорбительным в современном контексте).",
                        "zh": "指非白人的肤色；特指黑人（在现代语境中通常被视为冒犯）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветно́й",
                                "target_lang_sense_clarification": "о расовой принадлежности (историч.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有色人种",
                                "target_lang_sense_clarification": "指非白人族群（历史用语）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "790b237c-23c0-3304-9bf8-a8615d887036",
                    "sense_definition": "Belonging to a multiracial ethnic group in South Africa with ancestry from African, European, and Asian groups.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "race_sa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>colored</w> community in Cape Town has a rich cultural heritage.",
                            "target_lang_translations": {
                                "ru": "Сообщество <w>цветных</w> в Кейптауне имеет богатое культурное наследие.",
                                "zh": "开普敦的南非有色人社区拥有丰富的文化遗产。"
                            }
                        },
                        {
                            "text": "He identifies as <w>colored</w> within the demographics of South Africa.",
                            "target_lang_translations": {
                                "ru": "Он идентифицирует себя как <w>цветной</w> в рамках демографии Южной Африки.",
                                "zh": "在南非的人口统计中，他认同自己是南非有色人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Eurafrican"
                    ],
                    "common_phrases": [
                        "colored community"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий к смешанной этнической группе в Южной Африке.",
                        "zh": "属于南非一个具有非洲、欧洲和亚洲血统的多种族群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветно́й",
                                "target_lang_sense_clarification": "этническая группа в ЮАР"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南非有色人",
                                "target_lang_sense_clarification": "南非特定族群"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "701a3f61-e0be-381a-98a0-1061972ccf02",
                    "sense_definition": "Simple past and past participle of <w>color</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>colored</w> the drawing with bright red markers.",
                            "target_lang_translations": {
                                "ru": "Она <w>раскрасила</w> рисунок ярко-красными маркерами.",
                                "zh": "她用鲜红色的记号笔给画<w>涂上</w>了颜色。"
                            }
                        },
                        {
                            "text": "The setting sun <w>colored</w> the sky in shades of pink and orange.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>окрасило</w> небо в оттенки розового и оранжевого.",
                                "zh": "落日将天空<w>染成</w>了粉色和橙色。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола color (раскрашивать, окрашивать).",
                        "zh": "color 的过去式和过去分词（给……涂色、着色）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрасил",
                                "target_lang_sense_clarification": "нанес цвет на рисунок"
                            },
                            {
                                "target_lang_word": "окрасил",
                                "target_lang_sense_clarification": "придал цвет чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂色",
                                "target_lang_sense_clarification": "给图画上色"
                            },
                            {
                                "target_lang_word": "着色",
                                "target_lang_sense_clarification": "使呈现某种颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b80f60e-b1ef-3d97-b1b4-413b5baf4f75",
                    "sense_definition": "A colored article of clothing, usually washed separately from white items.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laundry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should separate the whites from the <w>coloreds</w> before doing laundry.",
                            "target_lang_translations": {
                                "ru": "Перед стиркой следует отделить белое от <w>цветного</w>.",
                                "zh": "洗衣服前你应该把白色衣物和<w>彩色衣物</w>分开。"
                            }
                        },
                        {
                            "text": "I accidentally washed a red sock with the <w>coloreds</w>.",
                            "target_lang_translations": {
                                "ru": "Я случайно постирал красный носок с <w>цветным бельем</w>.",
                                "zh": "我不小心把一只红袜子和<w>彩色衣物</w>一起洗了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wash the coloreds",
                        "whites and coloreds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цветное изделие из ткани, которое обычно стирают отдельно от белых вещей.",
                        "zh": "指彩色衣物，通常需要与白色衣物分开洗涤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветное бельё",
                                "target_lang_sense_clarification": "при стирке"
                            },
                            {
                                "target_lang_word": "цветные вещи",
                                "target_lang_sense_clarification": "одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彩色衣物",
                                "target_lang_sense_clarification": "洗涤分类用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cd4512d-a9b2-3504-878d-070ff8486717",
                    "sense_definition": "A person belonging to a multiracial ethnic group in South Africa.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "race_sa_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>coloreds</w> live in the Western Cape province.",
                            "target_lang_translations": {
                                "ru": "Многие <w>цветные</w> живут в провинции Западный Кейп.",
                                "zh": "许多南非有色人居住在西开普省。"
                            }
                        },
                        {
                            "text": "The census collects data on whites, blacks, and <w>coloreds</w>.",
                            "target_lang_translations": {
                                "ru": "Перепись собирает данные о белых, чернокожих и <w>цветных</w>.",
                                "zh": "人口普查收集关于白人、黑人和南非有色人的数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Eurafrican"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принадлежащий к смешанной этнической группе в Южной Африке.",
                        "zh": "属于南非多种族群体的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветно́й",
                                "target_lang_sense_clarification": "житель ЮАР смешанного происхождения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南非有色人",
                                "target_lang_sense_clarification": "南非特定族群成员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
