                            },
                            {
                                "target_word": "unfair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac45b04-dd96-3c8f-b1d3-13480ad59d01",
                                        "entry_id": "2687e34b-e9dd-354f-8462-262c442c8dee",
                                        "glosses": [
                                            "to make ugly"
                                        ],
