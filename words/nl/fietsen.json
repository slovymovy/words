                                "en": "I <w>cycle</w> to work every day.",
                                "pl": "Codziennie <w>jeżdżę rowerem</w> do pracy.",
                                "de": "Ich <w>fahre</w> jeden Tag mit dem Rad zur Arbeit.",
                                "fr": "Je <w>vais à vélo</w> au travail tous les jours.",
                                "it": "Vado al lavoro in <w>bicicletta</w> ogni giorno.",
                                "cs": "Každý den <w>jezdím na kole</w> do práce.",
                                "tr": "Her gün işe <w>bisikletle gidiyorum</w>.",
                                "es": "Voy al trabajo en <w>bicicleta</w> todos los días."
                            }
                        },
                        {
                            "text": "Zullen we morgen samen naar het strand <w>fietsen</w>?",
                            "target_lang_translations": {
                                "ru": "Может, завтра вместе <w>поедем на велосипедах</w> на пляж?",
                                "en": "Shall we <w>cycle</w> to the beach together tomorrow?",
                                "pl": "Pojedziemy jutro razem <w>rowerami</w> na plażę?",
                                "de": "Sollen wir morgen zusammen zum Strand <w>radeln</w>?",
                                "fr": "Et si on allait à la plage <w>à vélo</w> ensemble demain ?",
                                "it": "Andiamo in <w>bicicletta</w> in spiaggia insieme domani?",
                                "cs": "Pojedeme zítra společně na pláž <w>na kole</w>?",
                                "tr": "Yarın plaja birlikte <w>bisikletle gidelim</w> mi?",
                                "es": "¿Vamos mañana juntos a la playa en <w>bicicleta</w>?"
                            }
                        }
