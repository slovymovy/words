                "forms": [],
                "senses": [
                    {
                        "sense_id": "2290b9fd-e893-3c71-8ad2-f37cc1a2604f",
                        "entry_id": "77fd97ec-067e-349a-981f-cf38d656e08f",
                        "glosses": [
                            "Kittel, kurzes Hemd, das beim Arbeiten getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b77300-f1cb-4c1e-aeb0-f1efc218ffb7",
                                "sense_id": "2290b9fd-e893-3c71-8ad2-f37cc1a2604f",
                                "text": "On reconnaissait les serruriers à leurs bourgerons bleus, les maçons à leurs cottes blanches, les peintres à leurs paletots, sous lesquels de longues blouses passaient.",
                                "translation": "Man erkannte die Schlosser an ihren blauen Kitteln, die Maurer an ihren weißen Blusen, die Anstreicher an ihren Überziehern, unter denen die längeren Kittel vorschauten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf6d06a4-5ad5-40e8-9de5-09ef6872ce7f",
                        "source_entry_id": "77fd97ec-067e-349a-981f-cf38d656e08f",
                        "source_sense_id": "2290b9fd-e893-3c71-8ad2-f37cc1a2604f",
                        "source_sense_description": "Kittel, kurzes Hemd, das beim Arbeiten getragen wird",
                        "target_lang_word": "Kittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                        "entry_id": "f2b2b5f6-92b5-3958-8344-5574b6bf9f96",
                                        "glosses": [
                                            "Arbeitsmantel, der zum Schutz vor Verschmutzung oder Beschädigung über anderen Kleidungsstücken getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ee9768-4df1-49b6-9d45-cc1ab61e722b",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "Für Chemiker gehört ein Kittel zur Arbeitsbekleidung."
                                            },
                                            {
                                                "example_id": "33aacafc-12d9-4f5f-bdcc-82778d0868e0",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "Der Hausmeister trägt einen grauen Kittel aus Baumwolle."
                                            },
                                            {
                                                "example_id": "d2aaf7c0-a435-4efa-a0e1-db0779124042",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "„Im Hotelgebäude haben eine Kellnerin mit Dutt und eine Köchin im Kittel geduldig den ganzen Tag auf Kundschaft gewartet.“"
                                            },
                                            {
                                                "example_id": "4454b693-40fb-45c0-9cea-0b79553ea380",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "„Dr. Rosentuch kam aus dem Behandlungszimmer, in seinem weißen Kittel und mit ernstem Gesicht.“"
                                            },
                                            {
                                                "example_id": "f5138a02-5ed3-49ee-ab3c-a621aa1ef2a4",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "„Ich komme am Morgen an dem Haus vorbei, als ein Mädchen in einem rosa Kittel die Fensterläden Zimmer um Zimmer öffnet.“"
                                            },
                                            {
                                                "example_id": "3ba19e59-5dd5-42d5-a99e-c439bae6fff9",
                                                "sense_id": "ded89d2c-cd22-34ec-b540-3f09ae9cfead",
                                                "text": "„An einem Schaltschrank, der die Länge der Rückwand einnahm, saßen in abgewetzten Kitteln etwa zwanzig Frauen, die um die Ohren glänzende Kopfhörer trugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b18c9bf9-cfe9-3ae6-9c17-cc72447f9607",
                                        "entry_id": "f2b2b5f6-92b5-3958-8344-5574b6bf9f96",
                                        "glosses": [
                                            "jegliches Kleidungsstück (abgesehen von der Weste), das über dem Hemd getragen wird"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca4f292-21e5-42b1-a597-c2f46e1b725f",
                                                "sense_id": "b18c9bf9-cfe9-3ae6-9c17-cc72447f9607",
                                                "text": "Mein neuer Kittel hält warm und ist wasserdicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
