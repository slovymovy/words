                {
                    "sense_id": "2ec29a2b-b5d2-3592-acdd-b504d5b80dc3",
                    "sense_definition": "Present participle and gerund of <w>control</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer is responsible for <w>controlling</w> the traffic at this busy intersection.",
                            "target_lang_translations": {
                                "ru": "Полицейский отвечает за <w>регулирование</w> движения на этом оживленном перекрестке.",
                                "zh": "那名警官负责在这个繁忙的十字路口<w>疏导</w>交通。"
                            }
                        },
                        {
                            "text": "She is capable of <w>controlling</w> the situation without any help from her manager.",
                            "target_lang_translations": {
                                "ru": "Она способна <w>контролировать</w> ситуацию без помощи своего менеджера.",
                                "zh": "她有能力在无需经理帮助的情况下<w>控制</w>局面。"
                            }
                        }
                    ],
                    "common_phrases": [
