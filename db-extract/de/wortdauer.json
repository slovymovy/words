                "senses": [
                    {
                        "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                        "entry_id": "527417fa-1cf5-3316-95a3-1c62b1e7d142",
                        "glosses": [
                            "Dauer (zeitliche Länge) eines Wortes"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "64db0cb1-ad02-4e1a-b874-4fb1010ee4d4",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "„Diese Tabelle wird verdeutlicht durch die graphische Darstellung …, bei der wie stets die jeweilige Abscissenhöhe der relativen Wortdauer des betreffenden Worttyps entspricht.“"
                            },
                            {
                                "example_id": "cdb3df57-c1ab-49b3-9f8b-80e2d47fad6c",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "„Dabei erhöhen sich gleichzeitig die Wortdauer und die Aussprachefrequenzen deutlich.“"
                            },
                            {
                                "example_id": "43e46564-db2d-4264-bc38-e9061ee7df25",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "„Eine weitere Möglichkeit besteht darin, die Zeit zu messen, die ein Sprecher/eine Sprecherin benötigt, um ein Wort auszusprechen; man erhält dann als Wortlänge die Wortdauer.“"
                            },
                            {
                                "example_id": "96a02976-f9a1-4ce4-b188-e9cbf8825601",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "Leuninger gibt an, die durchschnittliche Wortdauer betrage 400 Millisekunden, ein einsilbiges Wort benötige „zirka 250 Millisekunden.“"
                            },
                            {
                                "example_id": "fa429292-1eb7-41d8-9841-b0e18c6743d0",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "„Als abhängige Variablen wurden Stotterrate, Inhalationsrate, Pausen, Wortdauer und Dauer einzelner Wortsegmente erhoben.“"
                            },
                            {
                                "example_id": "7f392480-eacf-4e7f-815f-f5bb85d42ba3",
                                "sense_id": "b21b62d2-634c-3738-9e1d-0e3bf1a32e70",
                                "text": "„Diese Methode bringt eine deutlich Verbesserung und korrigiert auch kleinere Fehler der Vorberechnung der Wortdauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
