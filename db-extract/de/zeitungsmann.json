                ],
                "senses": [
                    {
                        "sense_id": "07780d5e-1600-3792-90fa-ebdae753ec08",
                        "entry_id": "b68bb836-2286-3475-aed2-c75f6d9d4a94",
                        "glosses": [
                            "Person, die bei einer Zeitung arbeitet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b52a7b-b09c-4069-be26-0185ee84750b",
                                "sense_id": "07780d5e-1600-3792-90fa-ebdae753ec08",
                                "text": "Zeit seines Lebens war er mit Leib und Seele ein Zeitungsmann."
                            },
                            {
                                "example_id": "1052d2b9-78ac-4a7e-bda9-b1cdd4befb6b",
                                "sense_id": "07780d5e-1600-3792-90fa-ebdae753ec08",
                                "text": "„Die Zeitungsleute und die Radiostation, die die Pressekonferenz übertragen werde, sagten sie, warteten schon über eine Stunde, und das Wochenschau-Team, das sie aufnehmen wollte, ebenfalls.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3caf9b6-ef60-3a69-863d-2d9a1ece2f15",
                        "entry_id": "b68bb836-2286-3475-aed2-c75f6d9d4a94",
                        "glosses": [
                            "Person, die Zeitungen austrägt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "351500ab-4cb7-4157-b74a-35954db528e2",
                                "sense_id": "c3caf9b6-ef60-3a69-863d-2d9a1ece2f15",
                                "text": "Auf den Zeitungsmann warten wir noch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cb71ad19-556c-3ebc-b642-22b15d180309",
                        "entry_id": "b68bb836-2286-3475-aed2-c75f6d9d4a94",
                        "glosses": [
                            "Person, die Zeitungen verkauft"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f77261be-f1cc-4e5a-8d8d-4791899255b1",
                                "sense_id": "cb71ad19-556c-3ebc-b642-22b15d180309",
                                "text": "„Franz schob sich den Hut zurück, sah dem Zeitungsmann ins Gesicht, platzte los, lachte, Linas Hand in seiner.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
