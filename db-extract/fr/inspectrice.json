                        "entry_id": "c5bf3a7e-dd56-3fd0-bb45-f082d1e4b03d",
                        "glosses": [
                            "Celle dont la fonction est d’inspecter, de surveiller quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4ac336-4c65-4ccd-abb8-64f19970e195",
                                "sense_id": "d5bd8e5b-60b2-3269-8653-bd4777356ea5",
                                "text": "Grace à l’équité de la Société royale, inspectrice des prisons, nos tributs ont été devancés par des bienfaits."
                            },
                            {
                                "example_id": "56eeb080-7b4f-4067-9bc6-550382995260",
                                "sense_id": "d5bd8e5b-60b2-3269-8653-bd4777356ea5",
                                "text": "Inspectrice des douanes."
                            },
