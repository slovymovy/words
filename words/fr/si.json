{
    "word_family": [
        "sinon",
        "sitôt"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "ae9ecd86-695b-3e19-9b76-e67e8c978878",
                    "sense_definition": "Introduit une condition ou une supposition dont dépend la réalisation d'un fait.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conjunction_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux venir avec nous ce soir <w>si</w> tu as terminé tes devoirs."
                        },
                        {
                            "text": "Prévenez-moi <w>si</w> vous avez besoin d'une aide particulière pour ce projet."
                        }
                    ],
                    "common_phrases": [
                        "si possible",
                        "si nécessaire"
                    ]
                },
                {
                    "sense_id": "5285b025-d116-32b4-ba7d-089f92a9812c",
                    "sense_definition": "Introduit une interrogation indirecte marquant une alternative, le doute ou l'incertitude.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conjunction_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne sais pas encore <w>si</w> elle viendra à la fête demain."
                        },
                        {
                            "text": "Demande à ton frère <w>si</w> le train est déjà parti de la gare."
                        }
                    ],
                    "common_phrases": [
                        "savoir si",
                        "demander si"
                    ]
                },
                {
                    "sense_id": "cd41d53a-9490-3a9d-b4b2-430f600e52eb",
                    "sense_definition": "Marque une opposition ou une concession entre deux faits avérés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conjunction_contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Si</w> Paul aime le calme, sa sœur préfère l'agitation des grandes villes."
                        },
                        {
                            "text": "<w>Si</w> cette solution présente des avantages, elle comporte aussi des risques importants."
                        }
                    ],
                    "common_phrases": [
                        "même si"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ae1c1b45-a201-3b1f-81fd-520a577f5512",
                    "sense_definition": "Sert à répondre affirmativement ou à contredire une déclaration ou une question négative.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "adverb_affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu prétends que je ne t'écoute jamais, mais <w>si</w>, j'entends tout."
                        },
                        {
                            "text": "Elle pensait que personne ne viendrait, mais <w>si</w>, toute la famille était là."
                        }
                    ],
                    "synonyms": [
                        "si fait"
                    ],
                    "antonyms": [
                        "non"
                    ],
                    "common_phrases": [
                        "mais si"
                    ]
                },
                {
                    "sense_id": "6069771b-a86f-333d-b183-1ad59f12bef9",
                    "sense_definition": "À un tel degré, à un point tellement élevé devant un adjectif ou un adverbe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adverb_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faisait <w>si</w> froid ce matin que le petit lac du parc était gelé."
                        },
                        {
                            "text": "Cette histoire était <w>si</w> passionnante que je n'ai pas pu dormir de la nuit."
                        }
                    ],
                    "common_phrases": [
                        "si bien que"
                    ]
                },
                {
                    "sense_id": "fe49be7f-9420-3d58-983c-29c78ddd3fca",
                    "sense_definition": "Quelque... que ; indique un degré indéfini dans une proposition concessive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adverb_concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Si</w> habile que soit cet artisan, il ne pourra pas réparer cette montre."
                        },
                        {
                            "text": "<w>Si</w> rapide que paraisse cette méthode, elle comporte néanmoins des erreurs fréquentes."
                        }
                    ],
                    "synonyms": [
                        "quelque",
                        "tout"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fbfcd8e-515f-3d11-b32e-fda3509086f0",
                    "sense_definition": "Septième note de la gamme diatonique majeure en solfège.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune violoniste doit jouer un <w>si</w> bémol très précis au début du concert."
                        },
                        {
                            "text": "Cette note aiguë est difficile à chanter car ce <w>si</w> termine le morceau musical."
                        }
                    ],
                    "common_phrases": [
                        "si bémol",
                        "si dièse"
                    ]
                },
                {
                    "sense_id": "c283380b-f375-33e9-9708-d9f8a4fde5dc",
                    "sense_definition": "Condition, réserve ou supposition hypothétique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_supposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec des <w>si</w>, nous pourrions facilement réinventer toute notre histoire passée."
                        },
                        {
                            "text": "Il faut cesser de formuler des <w>si</w> et passer enfin à l'action concrète."
                        }
                    ],
                    "common_phrases": [
                        "avec des si"
                    ]
                }
            ]
        }
    ]
}