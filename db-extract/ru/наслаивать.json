                                                "example_id": "6dd19e42-19ad-4565-b4bb-62d44f082543",
                                                "sense_id": "83485958-0733-3a06-bd66-5670c4b3c6d2",
                                                "text": "\"Les nouvelles découvertes renforcent notre hypothèse selon laquelle il y avait une élite à Timna, attestant d'une société stratifiée\", dit-il."
                                            }
                                        ]
                                    },
