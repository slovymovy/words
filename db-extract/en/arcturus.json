        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "47104ad1-c9ee-3f10-80fe-9e02d971a721",
                "word": "Arcturus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86eac146-00ea-3b8e-8322-01003c0e15e2",
                        "entry_id": "47104ad1-c9ee-3f10-80fe-9e02d971a721",
                        "glosses": [
                            "A bright yellow-orange star in the constellation Boötes; Alpha (α) Boötis. It is the fourth-brightest star in the night sky."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59948ace-fd98-479c-8299-55c5c84e9f2c",
                                "sense_id": "86eac146-00ea-3b8e-8322-01003c0e15e2",
                                "text": "When humanity activated the Charon Mass Relay in 2149, it led to Arcturus, 36 light years from Sol, Earth's sun. Arcturus is the third brightest star seen from Earth. It is an ancient red giant from the generation born before Sol."
                            }
                        ]
                    }
                ],
                "translations": [
