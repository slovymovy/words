                        "examples": [
                            {
                                "example_id": "ad60af6b-825b-4610-854a-85d44591ec44",
                                "sense_id": "7b5cc3dc-2800-338b-b6c2-c8d56400f1e9",
                                "text": "De busrit is voor Stijn geen pretje. Misselijk hangt hij tussen de anderen op de achterbank. De achterbank is voor de stoere jongens."
                            },
                            {
                                "example_id": "e44d49a4-b563-4eca-b668-19f1a3881b8c",
                                "sense_id": "7b5cc3dc-2800-338b-b6c2-c8d56400f1e9",
                                "text": "Voorlopig geldt er een proefperiode van zes maanden. Nadien wordt het project geëvalueerd. Minister Pascal Smet tekende present voor de eerste busrit van de campus richting het stadscentrum."
                            },
                            {
                                "example_id": "f954d6dc-3a91-46bc-8068-1138d998a357",
                                "sense_id": "7b5cc3dc-2800-338b-b6c2-c8d56400f1e9",
                                "text": "Hoek gaat door in de KNVB-beker. De Zeeuwen wonnen na een lange busrit nu wel de strafschoppenserie van FC Lisse. De reeks eindigde op het Lisser sportpark Ter Specke in 6-5 voor de Zeeuwse ploeg."
                            }
                        ]
                    }
