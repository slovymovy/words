                                    },
                                    {
                                        "sense_id": "3315cf26-056e-3bc1-ac9b-bdc7b6e87f6d",
                                        "entry_id": "993d366b-0d1e-38b3-84d7-97e7acf26f54",
                                        "glosses": [
                                            "ein Vertreter einer großen Art von Meeresschnecken (Aplysia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f49a9521-5ec4-4034-9a6d-9e4c15e63133",
                                                "sense_id": "3315cf26-056e-3bc1-ac9b-bdc7b6e87f6d",
                                                "text": "Einige Arten der Seehasen gehören zu den größten bekannten Schnecken."
