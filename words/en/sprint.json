{
    "word_family": [
        "sprinter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d39df440-cf7e-344c-b450-3fa2f41ba37e",
                    "sense_definition": "To run or move at top speed for a short distance or period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>sprint</w> to catch the bus before it left the station.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>рвануть</w>, чтобы успеть на автобус, пока он не уехал со станции.",
                                "zh": "我必须<w>冲刺</w>才能在公交车离开车站前赶上它。"
                            }
                        },
                        {
                            "text": "The players <w>sprint</w> across the field during their warm-up routine.",
                            "target_lang_translations": {
                                "ru": "Игроки <w>спринтуют</w> по полю во время разминки.",
                                "zh": "球员们在热身时在场地上<w>冲刺</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "bolt",
                        "race",
                        "rush",
                        "run fast",
                        "tear"
                    ],
                    "antonyms": [
                        "jog",
                        "plod",
                        "amble"
                    ],
                    "common_phrases": [
                        "sprint to the finish",
                        "sprint away",
                        "sprint for the bus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бежать или двигаться с максимальной скоростью на короткое расстояние или в течение короткого времени.",
                        "zh": "指在短距离或短时间内以最高速度奔跑或移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвануть",
                                "target_lang_sense_clarification": "резко побежать"
                            },
                            {
                                "target_lang_word": "спринтовать",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "быстро двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲刺",
                                "target_lang_sense_clarification": "快速奔跑"
                            },
                            {
                                "target_lang_word": "飞奔",
                                "target_lang_sense_clarification": "极快地跑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "337f1f98-6946-3976-81fd-df7763aad172",
                    "sense_definition": "A short race run at top speed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete won the gold medal in the 100-meter <w>sprint</w>.",
                            "target_lang_translations": {
                                "ru": "Атлет выиграл золотую медаль в <w>спринте</w> на 100 метров.",
                                "zh": "这位运动员赢得了100米<w>短跑</w>的金牌。"
                            }
                        },
                        {
                            "text": "It was an exciting <w>sprint</w> to the finish line between the two runners.",
                            "target_lang_translations": {
                                "ru": "Это был захватывающий <w>спринт</w> к финишной черте между двумя бегунами.",
                                "zh": "两位选手向终点线的<w>冲刺</w>非常精彩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "race"
                    ],
                    "antonyms": [
                        "marathon"
                    ],
                    "common_phrases": [
                        "100-meter sprint",
                        "final sprint",
                        "winning sprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая гонка, которую бегут с максимальной скоростью.",
                        "zh": "一种以最高速度进行的短距离比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спринт",
                                "target_lang_sense_clarification": "вид гонки"
                            },
                            {
                                "target_lang_word": "бег на короткие дистанции",
                                "target_lang_sense_clarification": "спортивная дисциплина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短跑",
                                "target_lang_sense_clarification": "体育竞技项目"
                            },
                            {
                                "target_lang_word": "冲刺赛",
                                "target_lang_sense_clarification": "短距离比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02fb4011-1ab2-3d58-a14c-895f5426a44c",
                    "sense_definition": "A short burst of running, speed, or intense activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a sudden <w>sprint</w> for the door when the alarm went off.",
                            "target_lang_translations": {
                                "ru": "Он сделал внезапный <w>рывок</w> к двери, когда сработала сигнализация.",
                                "zh": "警报响起时，他突然向门口<w>冲刺</w>。"
                            }
                        },
                        {
                            "text": "The team made a final <w>sprint</w> to complete the project on time.",
                            "target_lang_translations": {
                                "ru": "Команда сделала последний <w>рывок</w>, чтобы завершить проект вовремя.",
                                "zh": "团队进行了最后的<w>冲刺</w>以按时完成项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burst",
                        "rush",
                        "dash"
                    ],
                    "common_phrases": [
                        "mad sprint",
                        "sudden sprint",
                        "sprint for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий всплеск бега, скорости или интенсивной деятельности.",
                        "zh": "指短时间的爆发性奔跑、速度或高强度活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое усилие или движение"
                            },
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "стремительное движение к цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲刺",
                                "target_lang_sense_clarification": "爆发性的动作或努力"
                            },
                            {
                                "target_lang_word": "猛冲",
                                "target_lang_sense_clarification": "突然的快速移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeac0e41-0d31-3f35-b7dd-d2030c38aa16",
                    "sense_definition": "A fixed period of time during which specific tasks must be completed, used in Agile software development.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team is planning the tasks for the upcoming two-week <w>sprint</w>.",
                            "target_lang_translations": {
                                "ru": "Наша команда планирует задачи на предстоящий двухнедельный <w>спринт</w>.",
                                "zh": "我们的团队正在规划即将到来的两周<w>冲刺</w>任务。"
                            }
                        },
                        {
                            "text": "We hold a retrospective meeting at the end of every <w>sprint</w> to discuss improvements.",
                            "target_lang_translations": {
                                "ru": "Мы проводим ретроспективное собрание в конце каждого <w>спринта</w>, чтобы обсудить улучшения.",
                                "zh": "我们在每次<w>冲刺</w>结束时都会举行回顾会议，讨论改进措施。"
                            }
                        }
                    ],
                    "synonyms": [
                        "iteration",
                        "cycle"
                    ],
                    "common_phrases": [
                        "sprint planning",
                        "two-week sprint",
                        "current sprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фиксированный период времени, в течение которого должны быть выполнены конкретные задачи (в методологии Agile).",
                        "zh": "在敏捷软件开发中，指必须完成特定任务的固定时间周期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спринт",
                                "target_lang_sense_clarification": "в разработке ПО"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲刺",
                                "target_lang_sense_clarification": "敏捷开发中的迭代周期"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}