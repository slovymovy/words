                                    {
                                        "sense_id": "473051fc-77a5-30de-976e-052dfd156da3",
                                        "entry_id": "c1463b9a-dec6-3ba0-a869-46388d5b15ca",
                                        "glosses": [
                                            "gegen ein Gesetz verstoßend, ohne behördliche Genehmigung, ungesetzlich, gesetzwidrig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b019f181-3149-467e-96e2-6b68e58d3984",
                                                "sense_id": "473051fc-77a5-30de-976e-052dfd156da3",
                                                "text": "Drogen wie Kokain und Heroin sind in Deutschland illegal."
                                            },
                                            {
                                                "example_id": "03b31036-55bb-4b8c-aee1-d26d0cb89143",
                                                "sense_id": "473051fc-77a5-30de-976e-052dfd156da3",
                                                "text": "„Die illegalsten Websites der Welt - Teil 1“"
                                            },
                                            {
                                                "example_id": "6a95ca48-c8ab-4351-8481-3a5ba46c973a",
                                                "sense_id": "473051fc-77a5-30de-976e-052dfd156da3",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            },
                                            {
                                                "example_id": "83e33ff8-44dd-488e-be30-e0b9ecaec92b",
                                                "sense_id": "473051fc-77a5-30de-976e-052dfd156da3",
                                                "text": "„Der Ablauf des riskanten illegalen Tiefflugs der beiden amerikanischen Piloten, die Umstände der Videoaufzeichnung, eine verbreitete Mentalität in der US-Armee, die lebendige internationale Fliegertradition legen es nahe, von einem fehlgeschlagenen Versuch auszugehen, sich mit einem beweisbaren Mutakt, dem Unterfliegen einer Seilbahn, als unverwüstliche Draufgänger auszuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8f7cd7b-190c-46a8-817e-adf847332f5a",
                        "source_entry_id": "109b5147-1c38-3596-9235-bb4ad476ce07",
