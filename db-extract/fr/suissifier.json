                "senses": [
                    {
                        "sense_id": "e939c304-7590-3b79-b959-1c46460a9203",
                        "entry_id": "3c27dffc-5c92-382a-9671-f9203df088f8",
                        "glosses": [
                            "Donner un caractère suisse à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af741b2-b927-4e17-a345-192b696d77d3",
                                "sense_id": "e939c304-7590-3b79-b959-1c46460a9203",
                                "text": "Loin de moi l’idée de « suissifier » la découverte et la définition du baroque littéraire."
                            },
                            {
                                "example_id": "52bad16b-db23-4a73-97ec-766c4570c74d",
                                "sense_id": "e939c304-7590-3b79-b959-1c46460a9203",
                                "text": "La Suisse rêvait en silence d’une neutralité universelle, d’un monde pacifié, suissifié, dans lequel tous les soldats se seraient contentés comme les siens de couvrir la frontière en attendant l’ennemi de pied ferme sans jamais l’aller chercher, de quoi garantir une paix armée propre à conduire un jour au désarmement général à force d’inutile vigilance."
                            },
                            {
                                "example_id": "45072cf7-f944-4784-a846-f3dc49b5198f",
                                "sense_id": "e939c304-7590-3b79-b959-1c46460a9203",
                                "text": "Que la perspective de cette France satisfaite et « suissifiée » séduise ou irrite, la réponse ne dépend guère que des passions et des humeurs de chacun."
                            }
                        ]
                    }
                ],
