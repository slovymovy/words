                        "entry_id": "d2484f41-8bf9-3824-89db-9919b437f8b0",
                        "glosses": [
                            "Espace suffisant pour qu’un navire à l’ancre puisse éviter, puisse tourner librement, lorsque le vent ou la marée change."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d1b3ed-4fd5-495d-b56f-651dc943f4f8",
                                "sense_id": "a040b3e5-11a0-363a-b059-aa7b5148ba07",
                                "text": "Afin de réduire le rayon d’évitage, on peut être amené à immerger plusieurs corps-morts sur lesquels le bateau sera affourché."
                            },
                            {
                                "example_id": "969af6ce-a36f-4ae7-9891-7b411280ada5",
                                "sense_id": "a040b3e5-11a0-363a-b059-aa7b5148ba07",
                                "text": "L’ancre de veille de tribord, empennelée d’une ancre à jet, fut mouillée par bâbord-arrière pour servir d’ancre d’évitage ; elle avait une biture de 80 brasses."
                            }
                        ]
                    }
