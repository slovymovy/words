                "senses": [
                    {
                        "sense_id": "9ecae768-b1a0-33f6-ae2e-07615e8eed7c",
                        "entry_id": "5c480eb0-612b-313f-9f50-906a0020c775",
                        "glosses": [
                            "op analyse berustend, daarmee werkend, daaruit bestaand, ontledend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd22006-fcd8-4548-9e7a-e8038a69785f",
                                "sense_id": "9ecae768-b1a0-33f6-ae2e-07615e8eed7c",
                                "text": "Uit analytisch onderzoek komt naar voren dat het ego veeleer lijkt op iets waarop het boeddhisme al sinds lange tijd zinspeelt: een kunstige illusie, een flakkerende, grillige vlam die nauwelijks een idee heeft van zichzelf, een entiteit die volkomen versmolten is met en doortrokken is van de buitenwereld, een 'ik' dat is voorbestemd om na een korte tijdspanne op te lossen en opnieuw op te gaan in een kosmisch geheel waarvan het zich nooit afgescheiden had moeten wanen."
                            },
                            {
                                "example_id": "2eb95e45-8dff-45d5-8250-694807ede031",
                                "sense_id": "9ecae768-b1a0-33f6-ae2e-07615e8eed7c",
                                "text": "'Ja, graag,' zeg ik, blij dat hij meteen ter zake wil komen en dat we op de analytische golflengte verder kunnen."
                            }
                        ]
                    },
