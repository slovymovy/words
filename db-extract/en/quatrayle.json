                ],
                "senses": [
                    {
                        "sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
                        "entry_id": "ffebebf3-5046-37f4-8d31-efa9e58662ff",
                        "glosses": [
                            "A great-great-great-grandfather; the grandfather of the grandfather of one's father."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9e4f21ef-05e2-4e23-bab6-eec2cd5393b9",
                                "sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
                                "text": "He was the quatrayle of Zaccheus Gould, the New England immigrant."
                            },
                            {
                                "example_id": "ee9680f6-b4fc-4dd7-8d67-8ef67afe4fba",
                                "sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
                                "text": "This means that two individuals A and B whose most recent common ancestor C is the quatrayle (or great-great-great-grandfather) of the former and the quatrayle of the latter cannot belong to the same lineage, because the genealogical chain linking A to B contains ten degrees of kinship."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a18b3fe8-f450-4378-bbef-4adb1f4da5a2",
                        "source_entry_id": "ffebebf3-5046-37f4-8d31-efa9e58662ff",
                        "source_sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
                        "source_sense_description": "grandfather of one's great-grandparent",
                        "target_lang_word": "praprapradědeček",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praprapradědeček",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e82df8a7-def4-3a5d-a1f9-1ef7a8be6bf3",
                                        "entry_id": "63d8e65c-0f35-39cd-b1e8-e4f3e3898d12",
                                        "glosses": [
                                            "otec prapradědečka nebo praprababičky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67fb9ed-8809-4e23-8843-42640bb67d5c",
                                                "sense_id": "e82df8a7-def4-3a5d-a1f9-1ef7a8be6bf3",
                                                "text": "Praprapradědeček mého pravnoučete byl za první republiky ředitelem pobočky Legiobanky v jednom krajském městě."
                                            },
                                            {
                                                "example_id": "92ecd0aa-88ad-434f-a079-cdfaf1150d24",
                                                "sense_id": "e82df8a7-def4-3a5d-a1f9-1ef7a8be6bf3",
                                                "text": "Jejího praprapradědečka prý zamlada zmrzačili napoleonští vojáci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4def0f7-4092-4fa7-80f3-38a3a6fbe63d",
                        "source_entry_id": "ffebebf3-5046-37f4-8d31-efa9e58662ff",
                        "source_sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
                        "source_sense_description": "grandfather of one's great-grandparent",
                        "target_lang_word": "quadrisaïeul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrisaïeul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                        "entry_id": "1d6a2afa-027e-3d56-a222-206659bcd60f",
                                        "glosses": [
                                            "Père du trisaïeul ou de la trisaïeule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2392a2-f44f-4d5d-a594-f8d661f8ff49",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Mon père, mon aïeul, mon bisaïeul, mon trisaïeul, mon quadrisaïeul, mon quinquisaïeul ont toujours mangé, comme les rats, à la table d'autrui."
                                            },
                                            {
                                                "example_id": "a84836aa-e220-403a-afe7-aedb4b988f0d",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Enfin, saisissant l'importance des parentés, le comte Roland de Montrichard a écrit Trois siècles de parentés , dont le texte, publié en 1953, présente la descendance complète, en ligne masculine et féminine, des 32 quadrisaïeuls de son père Louis de Montrichard."
                                            },
                                            {
                                                "example_id": "f9bb668d-234a-46e3-82ef-6a2a2db1699c",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Du côté paternel, le seul qui m'occupe ici, quatre arrière-grands-parents en 1850, seize quadrisaïeuls vers l'An II, cinq cent douze à l'époque de la jeunesse de Louis XIV, quatre mille quatre-vingt-seize sous François Ier, un million plus ou moins à la mort de Saint Louis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c715466-853c-4445-8fac-27c146a4213f",
                        "source_entry_id": "ffebebf3-5046-37f4-8d31-efa9e58662ff",
                        "source_sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
