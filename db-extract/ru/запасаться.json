                        ],
                        "form": "запаса́вшись"
                    },
                    {
                        "form_id": "3c1ee3f4-2b7c-4688-a803-941d4af33f6c",
                        "entry_id": "7e215b45-81ad-3004-a7a3-4f9266a11d66",
