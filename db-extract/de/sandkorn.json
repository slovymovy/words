                ],
                "senses": [
                    {
                        "sense_id": "83c4ba46-1fa1-3d6d-ab55-8de59806cd53",
                        "entry_id": "f972e17f-88c8-30a5-8209-47306f9e1014",
                        "glosses": [
                            "einzelnes, sehr kleines Stück verwittertes Gestein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35ece92-3689-4f8a-bb07-9869782711d0",
                                "sense_id": "83c4ba46-1fa1-3d6d-ab55-8de59806cd53",
                                "text": "Der Wind treibt die Sandkörner in alle Ritzen des Autos."
                            },
                            {
                                "example_id": "0111ff8c-b552-44e0-a6ab-e517f89e7e95",
                                "sense_id": "83c4ba46-1fa1-3d6d-ab55-8de59806cd53",
                                "text": "„Eine flache Landzunge und drei Sandkörner: dies ist die häufigste Art, die Erde beziehungsweise das Land zu bezeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "625e3129-6a3f-486d-9b25-11047e8da335",
                        "source_entry_id": "f972e17f-88c8-30a5-8209-47306f9e1014",
                        "source_sense_id": "83c4ba46-1fa1-3d6d-ab55-8de59806cd53",
                        "source_sense_description": "einzelnes, sehr kleines Stück verwittertes Gestein",
                        "target_lang_word": "grain of sand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dc386ff2-039d-4ae9-88f9-193484c68d09",
                        "source_entry_id": "f972e17f-88c8-30a5-8209-47306f9e1014",
                        "source_sense_id": "83c4ba46-1fa1-3d6d-ab55-8de59806cd53",
                        "source_sense_description": "einzelnes, sehr kleines Stück verwittertes Gestein",
                        "target_lang_word": "grain de sable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grain de sable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b3263e-d545-302a-93ca-26035322cc87",
                                        "entry_id": "74cc16a2-9ebf-35e6-b40e-aa7454e50f53",
                                        "glosses": [
                                            "Particule de petite taille provenant de la désagrégation des roches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d87e14-e391-4194-b9ce-feeed0d1930b",
                                                "sense_id": "f7b3263e-d545-302a-93ca-26035322cc87",
                                                "text": "Sur la plage, les grains de sable, projetés par le vent, nous piquaient le visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f606e05-f49d-371a-bc58-06ce4ee14a1e",
                                        "entry_id": "74cc16a2-9ebf-35e6-b40e-aa7454e50f53",
                                        "glosses": [
                                            "Problème ou dégât causé par le coté abrasif d’un grain de sable dans un mécanisme ou un engrenage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "719da962-6984-3664-a7b0-d91880f05b4c",
                                        "entry_id": "74cc16a2-9ebf-35e6-b40e-aa7454e50f53",
                                        "glosses": [
                                            "Élément imprévu qui entrave la réalisation d’un projet."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f6a6fd-2ca4-4231-8424-bc4f89deea47",
                                                "sense_id": "719da962-6984-3664-a7b0-d91880f05b4c",
                                                "text": "Mais si tu vas mettre ton grain de sable chez les autres, nous sommes sûrs d'arriver les premiers!"
                                            },
                                            {
                                                "example_id": "6a59afbe-4cb4-4871-b8ba-d741200b241e",
                                                "sense_id": "719da962-6984-3664-a7b0-d91880f05b4c",
                                                "text": "Plusieurs grains de sable ont grippé une chaîne logistique mondiale jusqu’ici bien huilée, mise sous tension par un fort redémarrage de la demande. Jusqu’à la faire dérailler."
                                            },
                                            {
                                                "example_id": "5cbfa859-a49e-4291-98ae-69b82b37914b",
                                                "sense_id": "719da962-6984-3664-a7b0-d91880f05b4c",
                                                "text": "Tout se serait déroulé normalement si nous n’avions pas rencontré un grain de sable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
