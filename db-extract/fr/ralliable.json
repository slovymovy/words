                        "glosses": [
                            "Qui peut être rallié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a090ce-06b1-466c-91d7-a673807fde43",
                                "sense_id": "d7f56f8f-4821-3a44-bc04-aecf35250cc6",
                                "text": "Ainsi, l’harmonie, à mesure qu’elle étend les liens, rallie dans un degré supérieur ce qui n’était pas ralliable dans un inférieur."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecc3f44e-a22a-33a2-badd-47d617d4e0c5",
                        "entry_id": "9a40eaf5-f046-303b-8463-4f8a5a4bdb7d",
                        "glosses": [
                            "Que l’on peut rallier à sa cause."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "706ae3e2-3681-4aa5-b18e-17ddffcdd04b",
                                "sense_id": "ecc3f44e-a22a-33a2-badd-47d617d4e0c5",
                                "text": "Quelques changements de préfets, quelques avances faites aux gens ralliables auraient peut-être empêché bien des tracas."
                            },
                            {
                                "example_id": "27dc546b-b012-4cb8-afb8-deb49cd67e9e",
                                "sense_id": "ecc3f44e-a22a-33a2-badd-47d617d4e0c5",
                                "text": "Pas dupe, Sarnez tient à lever le doute sur un éventuel ralliement. « Ils pensent sans doute que je suis bonne à cueillir comme la romaine et toute cabossée. Mais je ne suis pas ralliable », conclut-elle."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb4db03e-e5bd-3c62-9881-2f2e76c1c45e",
                        "entry_id": "9a40eaf5-f046-303b-8463-4f8a5a4bdb7d",
                        "glosses": [
                            "Que l’on peut rejoindre (en parlant d’un lieu)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b4f2bf92-fef3-4be6-b2b2-eee0736e7b0e",
                                "sense_id": "eb4db03e-e5bd-3c62-9881-2f2e76c1c45e",
                                "text": "Située à une heure en avion de Nouméa, elle est aussi ralliable en bateau avec le betico (attention pas de transport bateau tous les jours)."
                            },
                            {
                                "example_id": "a79029bc-f73d-45e2-9564-1ac6c2f03fda",
                                "sense_id": "eb4db03e-e5bd-3c62-9881-2f2e76c1c45e",
                                "text": "Pour une échappée citadine, Nantes est ralliable à vélo (26 km) ou en train."
                            }
                        ]
                    }
