        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec04b60b-724c-3dd5-af89-47c43685f1a2",
                    "sense_definition": "A word derived from a verb that functions as another part of speech, such as a gerund or infinitive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatical_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must learn to distinguish a main verb from a <w>verbal</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты должны научиться отличать основной глагол от <w>неличной формы глагола</w>.",
                                "zh": "学生必须学会区分主要动词和<w>非谓语动词</w>。",
                                "es": "Los estudiantes deben aprender a distinguir un verbo principal de una <w>forma no personal</w>."
                            }
                        },
                        {
                            "text": "Participles are a type of <w>verbal</w> used to modify nouns.",
                            "target_lang_translations": {
                                "ru": "Причастия — это тип <w>неличной формы глагола</w>, используемый для определения существительных.",
                                "zh": "分词是一种用于修饰名词的<w>非谓语动词</w>。",
                                "es": "Los participios son un tipo de <w>forma no personal</w> utilizada para modificar sustantivos."
                            }
                        }
                    ],
                    "synonyms": [
                        "non-finite verb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, образованное от глагола, но выступающее в роли другой части речи (например, герундий или инфинитив).",
                        "zh": "由动词派生但充当其他词性的词，如动名词或不定式。",
                        "es": "Forma no personal del verbo que funciona como otra parte de la oración, como un gerundio o infinitivo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нели́чная фо́рма глаго́ла",
                                "target_lang_sense_clarification": "grammar term"
                            },
                            {
                                "target_lang_word": "отглаго́льное образова́ние",
                                "target_lang_sense_clarification": "word derived from verb"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非谓语动词",
                                "target_lang_sense_clarification": "grammar term"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "forma no personal del verbo",
                                "target_lang_sense_clarification": "término gramatical"
                            }
                        ]
                    }
                },
                {
