                "senses": [
                    {
                        "sense_id": "0ed9bbbd-b623-3f46-86ea-303442c9504c",
                        "entry_id": "c646451b-2f0c-3b67-b1b1-f37069c07500",
                        "glosses": [
                            "Razzia, deren Ziel die Sicherstellung von Drogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3f6793-6d57-4913-b511-e0817239f565",
                                "sense_id": "0ed9bbbd-b623-3f46-86ea-303442c9504c",
                                "text": "„Drogenrazzien waren nur dann als Nachricht von Interesse, wenn berühmte Leute erwischt wurden, und da war es immer gut, wenn man schon vorher darüber Bescheid wusste.“"
                            },
                            {
                                "example_id": "47206b89-c0cc-4b12-8546-8769023eba8a",
                                "sense_id": "0ed9bbbd-b623-3f46-86ea-303442c9504c",
                                "text": "„Auch der Junkie, der Marty Ward umbrachte, ihm bei einer aus dem Ruder gelaufenen Drogenrazzia in die Brust geschossen hatte, wurde nur wegen Totschlags verurteilt.“"
                            },
                            {
                                "example_id": "3f3a3d36-87c1-4243-ad81-9031daa07797",
                                "sense_id": "0ed9bbbd-b623-3f46-86ea-303442c9504c",
                                "text": "„Hinter dem Büro befand sich ein Wohnwagen, den das Department bei einer Drogenrazzia einkassiert hatte und nun gelegentlich als Büro benutzte.“"
                            },
                            {
                                "example_id": "99a18b6e-b278-4614-9bd8-616059151262",
                                "sense_id": "0ed9bbbd-b623-3f46-86ea-303442c9504c",
                                "text": "„Je schneller wir handeln, umso besser. So wie bei Drogenrazzien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
