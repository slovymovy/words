                    ]
                },
                {
                    "sense_id": "b0c6fec6-678d-32e5-956f-5553fbfe92c0",
                    "sense_definition": "En parlant d'un mouillage ou d'une rade, situé en dehors d'un port et exposé aux vents du large.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voilier a dû s'abriter dans un mouillage <w>forain</w> pendant la tempête."
                        },
                        {
                            "text": "Cette rade <w>foraine</w> offre peu de protection contre les vagues du large."
                        }
                    ],
                    "common_phrases": [
                        "mouillage forain",
                        "rade foraine"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5e6fafc-841f-37d3-bf9f-e3f9d94dcd08",
                    "sense_definition": "Personne qui tient une attraction, un stand ou un manège dans une fête foraine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metier_foire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>forain</w> vérifie soigneusement la sécurité de son manège avant l'ouverture."
                        },
                        {
                            "text": "De nombreux <w>forains</w> parcourent le pays pour installer leurs stands de jeux."
                        }
                    ],
                    "common_phrases": [
                        "monde des forains"
                    ]
                },
                {
                    "sense_id": "31f78143-2833-383f-84dd-96a81bc43c70",
                    "sense_definition": "Personne qui agit de manière brusque, grossière ou sans délicatesse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grossier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a défoncé la porte comme un vrai <w>forain</w> au lieu de sonner."
                        },
                        {
                            "text": "Ne te comporte pas comme un <w>forain</w> avec ces verres en cristal."
