                                "sense_id": "754b7a9d-5622-37b6-b626-815ba07da3b6",
                                "text": "Exploring, I found another short gallery running transversely to the first."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "318bd57b-eedc-4217-b679-b69c7681f5a3",
