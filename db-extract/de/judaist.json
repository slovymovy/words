                        "glosses": [
                            "Wissenschaftler, der sich mit der Judaistik beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb54f0f9-ad33-4cdc-8156-075740fa7f7e",
                                "sense_id": "aa55ade4-32f1-3b62-9d37-0a7e12d2849b",
                                "text": "„Inmitten von Grün liegt der Jüdische Friedhof in Altona, ein wenig verwittert und vielen Hamburgern kaum bekannt. […] Rechtzeitig zu diesem Jubiläum kommt nun Bewegung in die Pläne, den Friedhof als Unesco-Weltkulturerbe vorzuschlagen. Wissenschaftler und Judaisten halten die größte Besonderheit des Gräberfelds, das Nebeneinander von sephardischen und aschkenasischen Juden nämlich, schon lange für auszeichnungswürdig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
