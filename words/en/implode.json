{
    "word_family": [
        "implosion",
        "implosive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "889abd20-bfc6-3b06-acef-98714c9406be",
                    "sense_definition": "To collapse or burst inward violently due to external pressure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine <w>imploded</w> as it sank below its crush depth.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка <w>схлопнулась</w>, когда опустилась ниже предельной глубины погружения."
                            }
                        },
                        {
                            "text": "If the pressure becomes too great, the glass container will <w>implode</w> instantly.",
                            "target_lang_translations": {
                                "ru": "Если давление станет слишком высоким, стеклянный контейнер мгновенно <w>взорвется внутрь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "collapse",
                        "cave in"
                    ],
                    "antonyms": [
                        "explode"
                    ],
                    "common_phrases": [
                        "implode under pressure",
                        "suddenly implode"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушиться или взорваться внутрь из-за внешнего давления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схлопнуться",
                                "target_lang_sense_clarification": "о физическом объекте под давлением"
                            },
                            {
                                "target_lang_word": "взорваться внутрь",
                                "target_lang_sense_clarification": "направленный внутрь взрыв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3613da3f-1559-3445-8797-534ff06a01ca",
                    "sense_definition": "To suddenly fail or lose support in all areas of a campaign, organization, or system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ragusa's campaign <w>imploded</w> after she confused coal mining with oil drilling during a speech.",
                            "target_lang_translations": {
                                "ru": "Кампания Рагузы <w>развалилась</w> после того, как она перепутала добычу угля с бурением нефтяных скважин во время выступления."
                            }
                        },
                        {
                            "text": "The company's stock price fell as the entire business model began to <w>implode</w>.",
                            "target_lang_translations": {
                                "ru": "Цена акций компании упала, когда вся бизнес-модель начала <w>рушиться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disintegrate",
                        "fall apart",
                        "crumble"
                    ],
                    "common_phrases": [
                        "campaign imploded",
                        "economy began to implode"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно потерпеть неудачу или лишиться поддержки во всех сферах деятельности организации или системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалиться",
                                "target_lang_sense_clarification": "о системе, кампании или бизнесе"
                            },
                            {
                                "target_lang_word": "потерпеть крах",
                                "target_lang_sense_clarification": "о внезапном провале"
                            },
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "о планах или экономике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52de6aef-0e5e-33cf-b499-9cd8d1af852b",
                    "sense_definition": "To cause something to collapse or burst inward violently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers had to <w>implode</w> the old stadium to make room for the new park.",
                            "target_lang_translations": {
                                "ru": "Инженерам пришлось <w>взорвать внутрь</w> старый стадион, чтобы освободить место для нового парка."
                            }
                        },
                        {
                            "text": "The controlled demolition was designed to <w>implode</w> the building safely.",
                            "target_lang_translations": {
                                "ru": "Контролируемый снос был спланирован так, чтобы безопасно <w>обрушить</w> здание внутрь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "implode the building"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать разрушение или взрыв чего-либо, направленный внутрь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взорвать внутрь",
                                "target_lang_sense_clarification": "произвести направленный внутрь взрыв"
                            },
                            {
                                "target_lang_word": "обрушить",
                                "target_lang_sense_clarification": "путем направленного взрыва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87d26281-4635-34d9-b210-72259fe817a5",
                    "sense_definition": "To compress data using a specific algorithm or to join array elements into a string.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm looking for some code that will <w>implode</w> data using the PKZIP method.",
                            "target_lang_translations": {
                                "ru": "Я ищу код, который будет <w>сжимать</w> данные методом PKZIP."
                            }
                        },
                        {
                            "text": "In some programming languages, you use a function to <w>implode</w> an array into a single string.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках программирования используется функция, чтобы <w>объединить</w> массив в одну строку."
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "join"
                    ],
                    "antonyms": [
                        "explode"
                    ],
                    "common_phrases": [
                        "implode data",
                        "implode an array"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать данные с помощью алгоритма или объединять элементы массива в строку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "данные"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "элементы массива в строку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}