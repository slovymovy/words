                        "sense_id": "1337f7f7-f7d5-329f-9569-2840bcec56af",
                        "entry_id": "3ae389ea-3ef7-319a-804e-543519bf192d",
                        "glosses": [
                            "to listen (to); to hear; to hark (to); to hearken; to heed, to pay heed"
                        ],
                        "tags": [
                            "literary",
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "237357cf-0686-4c7d-a841-6287132c457f",
                                "sense_id": "1337f7f7-f7d5-329f-9569-2840bcec56af",
                                "text": "вня́ть моли́тве",
                                "translation": "to hear the/a prayer",
                                "english": "to hear the/a prayer"
                            },
                            {
                                "example_id": "6ac24648-51ad-4f0e-8fec-819b72e147c6",
                                "sense_id": "1337f7f7-f7d5-329f-9569-2840bcec56af",
                                "text": "Почему́ ты не внял мои́м сове́там?",
                                "translation": "Why didn't you pay heed to my advice?",
                                "english": "Why didn't you pay heed to my advice?"
                            }
                        ]
                    }
