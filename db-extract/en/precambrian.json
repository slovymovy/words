                        "entry_id": "2c168686-ece7-3a9b-9e2a-296bba71cabc",
                        "glosses": [
                            "Relating to the time and geology dated before the Phanerozoic"
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc7aa82c-db41-4cee-8f04-8ebaa594d66a",
                                "sense_id": "c09933c0-752c-3140-8deb-44604717463b",
                                "text": "When you look at a Precambrian trilobite in the lobby of a New York bank, it is difficult to speculate about its primeval environment."
                            }
                        ]
                    }
                ],
