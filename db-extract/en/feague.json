            {
                "entry_id": "6b96356f-8a28-3b0d-bc51-b6f4411bb5c8",
                "word": "feague",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c68340bc-c564-447c-baff-d3c48ec76dcc",
                        "entry_id": "6b96356f-8a28-3b0d-bc51-b6f4411bb5c8",
                        "tags": [
