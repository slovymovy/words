                "senses": [
                    {
                        "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                        "entry_id": "43963e6d-197c-3c2c-af9b-82746da69bd9",
                        "glosses": [
                            "Großunternehmen, das verschiedene Anwendungen der Elektrotechnik verkauft (beispielsweise Züge/Schienentechnik, Turbinen/Kraftwerke, weiße Ware)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e2bb49-f4d0-4686-9b5a-8afb33579bde",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Welche Krise? Der Elektrokonzern Samsung hat so viel Geld verdient wie noch nie in einem Quartal.“"
                            },
                            {
                                "example_id": "c32be7e3-530f-45de-a720-26050ba87c70",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Der Elektrokonzern Siemens will mit einwöchigen Betriebsschließungen die Kosten in seiner schwächelnden Kraftwerkssparte drücken.“"
                            },
                            {
                                "example_id": "ff7288fb-dcb0-4268-b955-8d0a5b997d70",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„So schlossen gestern bereits der Elektrokonzern Siemens und den Energieversorger E.ON Aufträge in Milliardenhöhe mit dem russischen Staat ab.“"
                            },
                            {
                                "example_id": "63c58a75-860a-42d2-b34b-4378cc7137f2",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Im Oktober 1928 gab die Deutsche Reichspost dem Elektrokonzern Telefunken den Auftrag, einen Kurzwellensender in Zeesen zu bauen.“"
                            },
                            {
                                "example_id": "0043c5b7-64fd-4e16-b16f-0ecb69c065ea",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Im Juni 2009 wurde Saeco schließlich von dem niederländischen Elektrokonzern Philips für rund 200 Millionen Euro aufgekauft.“"
                            },
                            {
                                "example_id": "cfdd7979-560d-4f52-ad62-ba4afb62e5ae",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "[Finanzkrise 1982:] „Während des letzten Jahres sind die Banken plötzlich auf die Titelseiten der Zeitungen gerückt.“ […] „Die monatelange Unfähigkeit, den zahlungsunfähigen Elektrokonzern AEG wieder auf die Beine zu stellen, die spektakulären Verluste im Polen-Geschäft und die Unsicherheit vieler Dritte-Welt-Kredite lösen Besorgnis aus.“"
                            },
                            {
                                "example_id": "102cccc1-d7d2-4c79-8176-6dbc8265face",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Europas größter Elektrokonzern steigerte Umsatz und Betriebsergebnis deutlich“ […]."
                            },
                            {
                                "example_id": "ab8af768-85c1-42c7-8804-c6c93f16b1b8",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "[Peter von Siemens:] „Unter seiner Leitung wuchs die Siemens AG zum fünftgrößten Elektrokonzern der Welt.“"
                            },
                            {
                                "example_id": "39584c1c-da99-46b9-b085-0ea34428b800",
                                "sense_id": "4cb83453-88b7-38fd-86dd-11e60ce59836",
                                "text": "„Beim Gespräch von Bundeswirtschaftsministerin Brigitte Zypris mit der Siemens-Personalchefin Janina Kugel sollte es um den Stellenabbau in den deutschen Werken des Elektrokonzerns gehen.“"
                            }
                        ],
