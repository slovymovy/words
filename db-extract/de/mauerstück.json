                "senses": [
                    {
                        "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                        "entry_id": "9475047b-20ca-3852-91fc-e5ad457619d3",
                        "glosses": [
                            "Teil einer Mauer; Bruchstücke einer zerborstenen Mauer"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "8bfcd87a-02d0-4170-9142-92ff98a0af23",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Düren:] „Von der Dürener Stadtbefestigung sind mehrere Türme und einige Mauerstücke erhalten.“"
                            },
                            {
                                "example_id": "5fb4e900-53e1-446f-bbfd-361d516f07fb",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "„Aus dieser Zeit stammen auch die ältesten Mauerstücke der Kapelle.“"
                            },
                            {
                                "example_id": "4559c964-5a23-43d3-b541-e741df61c473",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Jena:] „Vom Johannistor verläuft ein kurzes Mauerstück, auf dem das so genannte Haus auf der Mauer steht, bis zum ehemaligen Pulverturm im Nordwesten des Stadtkerns.“"
                            },
                            {
                                "example_id": "6531548c-2f21-4ee7-b50b-4af0eefa74a4",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Brandenburger Tor:] „Beiderseits des Tores schlossen sich ursprünglich kurze Mauerstücke mit Nischen für die Skulpturen von Mars und Minerva an, die somit vom Quarrée (heute Pariser Platz) aus gesehen rechts und links das Tor flankierten.“"
                            },
                            {
                                "example_id": "6189e75f-019e-4f31-b3b8-447fe62fdc0b",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Zwickau:] „Pulverturm: Er gehört mit einem erhaltenen Mauerstück zur ehemaligen Stadtbefestigung aus dem Mittelalter.“"
                            },
                            {
                                "example_id": "3b961d75-bfea-4848-9172-3431e22a97d2",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "„Ein Arbeiter ist auf einer Baustelle in Braunschweig vom Teil einer eingestürzten Gebäudewand eingeklemmt worden. Laut Feuerwehr hatte das herabgefallene Mauerstück den 24-Jährigen zunächst lebensbedrohlich unter sich begraben.“"
                            },
                            {
                                "example_id": "6c2f93a0-f647-456c-9327-8991e0bf341e",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Kölner Dom:] „Bereits im März 2012 war ein Mann durch herabfallende Steine am Hauptportal des Doms verletzt worden. Über ihm hatte sich ein Mauerstück gelöst, so groß wie ein Schuhkarton.“"
                            },
                            {
                                "example_id": "4279878b-7324-4fd2-aeb9-172366e7fed0",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "„Ein kleiner Klecks Mörtel landet auf der schmalen Seite des Steins, ein großer Klecks auf dem darunterliegenden Mauerstück. Noch etwas zaghaft setzt Kevin Meier einen Stein auf den nächsten.“"
                            },
                            {
                                "example_id": "e9ceaebe-71b7-485e-90fc-635c1d2a3e02",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Wirkung einer Detonation:] „Mauerstücke flogen bis auf den Gehweg und in den Wänden des Hauses bildeten sich Risse.“"
                            },
                            {
                                "example_id": "eee6702d-7964-4ee6-a308-7a7a1195bce1",
                                "sense_id": "7b7f0d70-127d-300d-88ea-08ac084a2971",
                                "text": "[Unwetter über Venedig:] „Am berühmten Markusdom im Zentrum brachen laut Ansa Mauerstücke vom Kirchturm ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                        "entry_id": "9475047b-20ca-3852-91fc-e5ad457619d3",
                        "glosses": [
                            "kurzer Abschnitt/Teil der Berliner Mauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab74398-e994-4991-a6db-f9402547bb3f",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Auch an der Bernauer Straße stehen einige Mauerstücke.“"
                            },
                            {
                                "example_id": "8403b6c2-235e-49cd-a5e6-ae1e900e5985",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Ich wohne nahe der Bernauer Straße, wo eines der wenigen originalen Mauerstücke die Zeit überdauert hat.“"
                            },
                            {
                                "example_id": "cd35ff39-92a0-4767-8b3c-c45637506954",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Christa Wolfs DDR-Erzählung \"Der geteilte Himmel\" haben wir vor einem der letzten Mauerstücke in Berlin gedreht.“"
                            },
                            {
                                "example_id": "52465cb8-4f4e-4a73-8d93-c978ad8f74ee",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Besonders beeindruckend ist aber - ähnlich dem 200 Meter langen Mauerstück in der Bernauer Straße - der Tränenpalst am Bahnhof Friedrichstraße.“"
                            },
                            {
                                "example_id": "63a2abf2-b445-4787-83a3-fddcd0ca998d",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Als die Mauer hochgezogen wurde, lag die Häuserfront der Straße im Osten, der Bürgersteig im Westen. Heute wird dort mit einer großen Open-Air-Ausstellung, zu der auch ein original erhaltenes Mauerstück gehört, an die Opfer der Teilung erinnert.“"
                            },
                            {
                                "example_id": "50db7198-091b-47a6-b836-f0d9a3a16a46",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Aufgrund der Coronamaßnahmen mussten die Veranstalter die Gedenkfeier absagen. Stattdessen legten fünf Leute gemeinsam Kränze am noch erhaltenen Mauerstück ab.“"
                            },
                            {
                                "example_id": "26216d36-787f-43b9-8026-99235daee045",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Auch am Deutschen Eck in Koblenz befinden sich drei Mauerstücke der Berliner Mauer.“"
                            },
                            {
                                "example_id": "1d24d0c9-94bd-4f74-ab42-f72c0e3fcc4b",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Seit 2009 steht ein ein Meter breites Mauerstück an der Berliner Straße in Herford.“"
                            },
                            {
                                "example_id": "fe62eefb-3dd7-4267-8dea-fc1c62501282",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„In vielen deutschen Städten stehen heute noch einzelne Mauerstücke als Erinnerungsorte an die Teilung.“"
                            },
                            {
                                "example_id": "7320064d-a5db-413a-87c3-d4fdc1137912",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Zahlreiche Mauerstücke wurden außerdem weltweit verkauft.“"
                            },
                            {
                                "example_id": "f550d7dd-f53e-44c1-a623-dcffcfa174dd",
                                "sense_id": "c9ebf121-4b35-3a62-90cc-c8a194426828",
                                "text": "„Der Zerfall der DDR bedeutet auch das Ende des VEB Limex-Bau. Dessen Gewinne aus dem Verkauf der Berliner Mauerstücke sind bis heute verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
