                        ],
                        "examples": [
                            {
                                "example_id": "081e5842-5c68-4852-8016-444caca7efc3",
                                "sense_id": "85bb4579-f387-3bf0-adc5-574a6f72ca4c",
                                "text": "Es ist umstritten, ob es sich bei der Telematik um ein eigenständiges Fachgebiet handelt oder ob sie ein Teilgebiet der Informatik ist."
                            }
