                    {
                        "sense_id": "65849ea9-a40b-36a7-abc6-3f0437ecb8d6",
                        "entry_id": "c305a6f0-3288-30fd-a68a-c39acadbef6c",
                        "glosses": [
                            "screw-up"
                        ],
