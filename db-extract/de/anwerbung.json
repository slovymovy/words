                    {
                        "sense_id": "5fbe9d49-cd01-39b8-bcb8-a26222abd54a",
                        "entry_id": "419b0e4b-d5c7-3978-876f-47b2dfe59644",
                        "glosses": [
                            "Bemühung, jemand für eine bestimmte Arbeitsleistung zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d044a242-6154-4cb5-a490-1851a2181b9f",
                                "sense_id": "5fbe9d49-cd01-39b8-bcb8-a26222abd54a",
                                "text": "„Die Anwerbung türkischer Gastarbeiter hatte gerade begonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0169c3a8-d82a-401e-9b9d-8d5d58f5e10d",
                        "source_entry_id": "419b0e4b-d5c7-3978-876f-47b2dfe59644",
                        "source_sense_id": "5fbe9d49-cd01-39b8-bcb8-a26222abd54a",
                        "source_sense_description": "Bemühung, jemand für eine bestimmte Arbeitsleistung zu gewinnen",
                        "target_lang_word": "recrutement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recrutement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                        "entry_id": "51c543a0-a47b-3f2a-854c-3bbf66008152",
                                        "glosses": [
                                            "Action de recruter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245dfc4e-c057-4f9d-96bf-287ce8186887",
                                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                                "text": "Tout ce monde achète, vend, brocante. Des prélats spéculent sur les terrains et les constructions, des lazaristes sur les agences de recrutement militaire, etc., etc."
                                            },
                                            {
                                                "example_id": "c41ad57a-855b-4ef0-b85e-7bdbce0a6b38",
                                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                                "text": "Le recrutement se fait à proximité : 70 % des munitionnettes de chez Panhard résident à Paris, 49 % dans le seul XIII^(ème) arrondissement où est localisée l'usine, et 28,7 % dans la banlieue sud […]."
                                            },
                                            {
                                                "example_id": "d6649b5d-6b5f-4467-ab23-2693332c4b06",
                                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                                "text": "- Quoique le recrutement se fasse en entier par engagemens volontaires, et sous la direction du commandant en chef de l’armée, ce sont les Magistrats qui reçoivent et constatent l’engagement des recrues; […]."
                                            },
                                            {
                                                "example_id": "3913ff72-abee-4299-a725-7319e218188e",
                                                "sense_id": "e5ae47b5-e468-304c-8950-1ce4a8713347",
                                                "text": "Les situations où les semenciers sont trop rares pour opter pour une régénération naturelle sont plus fréquentes, notamment dans des secteurs d’anciens taillis-sous-futaie où le recrutement des baliveaux était contraint par la dynamique du charme, ce qui a conduit à un appauvrissement en chêne des peuplements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
