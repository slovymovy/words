                                "target_senses": [
                                    {
                                        "sense_id": "cd4812f8-2d29-3634-86e4-8bef6b67b5d3",
                                        "entry_id": "de38132f-07e8-3d51-943f-9c31679b8bb2",
                                        "glosses": [
                                            "Relatif à la gériatrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e362cd03-9ffa-4ee2-81ff-eb93a83f8aa8",
                                                "sense_id": "cd4812f8-2d29-3634-86e4-8bef6b67b5d3",
                                                "text": "La prévalence de l'incontinence fécale en institution gériatrique était de 33 à 54 % selon la durée de l'étude."
                                            },
                                            {
                                                "example_id": "eb87a694-0f94-4ba8-ae95-44a529119d68",
                                                "sense_id": "cd4812f8-2d29-3634-86e4-8bef6b67b5d3",
                                                "text": "Le gériatre de secteur doit être une médecin qualifié en gérontologie. Ceci implique une formation médicale gériatrique d'une part, et médico-sociale d'autre part."
                                            },
                                            {
                                                "example_id": "4985fc8b-75a9-4af0-812b-541a94a08ebc",
                                                "sense_id": "cd4812f8-2d29-3634-86e4-8bef6b67b5d3",
                                                "text": "Lundi, la santé publique a officiellement reçu ses 4000 premières doses. Elles serviront à vacciner les résidents et des travailleurs de la santé du Centre d’hébergement Saint-Antoine, à Québec, et du Centre gériatrique Maimonides, dans l’ouest de l’île de Montréal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
