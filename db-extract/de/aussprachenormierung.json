                ],
                "senses": [
                    {
                        "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                        "entry_id": "403c4670-ec85-3eab-983d-4323f0b4c1b3",
                        "glosses": [
                            "Festlegung einer Norm für die Aussprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc6ca99-05a8-464e-887d-159eae8d1234",
                                "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                                "text": "„Die Projektarbeit zeitigt somit ganz praktische Konsequenzen für eine adäquate Aussprachenormierung des Deutschen.“"
                            },
                            {
                                "example_id": "9481e587-7ac5-4663-9b07-cc4520c5b802",
                                "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                                "text": "„Die deutschländischen Aussprachenormierungen, die im Wesentlichen auf den Germanisten Theodor Siebs (1862–1941) zurückgehen, haben sich in der Schweiz offenbar nicht durchgesetzt.“"
                            },
                            {
                                "example_id": "6ca03742-0ed5-480a-a2ab-b9103b2efa21",
                                "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                                "text": "„Ein Hindernis für einen solchen Ansatz können zum Beispiel unterschiedliche Aussprachenormierungen wie etwa für amerikanisches und britisches Englisch oder durch die L1 geprägte Aussprache- und Wahrnehmungsmuster seitens der Lernenden darstellen.“"
                            },
                            {
                                "example_id": "dc1f6488-6ca0-47f9-b209-bc481fc96205",
                                "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                                "text": "„Bei medial mündlichen Aspekten wurde in der Tradition von Theodor Siebs’ Aussprachenormierungen auf artikulatorische Ausdrucksmittel ein besonderer Schwerpunkt gelegt.“"
                            },
                            {
                                "example_id": "8acdabb9-6595-43f9-9a47-b4f85a895d37",
                                "sense_id": "e070eeef-b699-3388-8b16-68fa23e31d9c",
                                "text": "„In Zeiten gesteigerter Mobilität und massenmedialer Aussprachenormierung stirbt der Dialekt selbst aus. So zumindest eine weit verbreitete Meinung. Welcher der Dialektforscher Hubert Klausmann entschieden widerspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
