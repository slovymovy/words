                            "comment": "This verb usage is rare in modern Dutch."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доводить дело до конца или до совершенства.",
                        "en": "To do something until the intended result is fully achieved.",
                        "fr": "Mener quelque chose à bien jusqu'à ce que le résultat souhaité soit pleinement atteint."
                    },
