                        "cross_references": [
                            {
                                "target_word": "tetrahedral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4a48f95-0c25-3f7c-83b9-626769327f55",
                                        "entry_id": "fafd9e07-a53b-3d16-85cf-4babd077f95e",
                                        "glosses": [
                                            "Of, relating to, or having the shape of a tetrahedron."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0380ba28-8a51-4e75-8482-3bd4a0c7e845",
                                                "sense_id": "b4a48f95-0c25-3f7c-83b9-626769327f55",
                                                "text": "Of the convex polyhedra with regular faces, the only ones that have tetrahedral, octahedral, or icosahedral symmetry are the Platonic and Archimedean solids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
