    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a751802-1414-3916-a975-eabb0dfa45e0",
                    "sense_definition": "Avertir d'un danger imminent ou d'une menace en donnant l'alerte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un témoin a immédiatement appelé pour <w>alerter</w> les secours après l'accident de voiture."
                        },
                        {
                            "text": "Dès les premiers signes de fumée suspecte, les résidents ont <w>alerté</w> les pompiers du quartier."
                        }
                    ],
                    "synonyms": [
                        "avertir",
                        "prévenir"
                    ],
                    "common_phrases": [
                        "alerter les secours",
                        "alerter la police",
                        "alerter les autorités"
                    ]
                },
                {
                    "sense_id": "f36dfbc7-673f-3c03-b6c6-323112c7a9ea",
                    "sense_definition": "Éveiller l'attention, la méfiance ou l'inquiétude de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit étrange dans la nuit a tout de suite <w>alerté</w> les propriétaires de la maison."
                        },
                        {
                            "text": "Les scientifiques tentent d'<w>alerter</w> le public sur les conséquences dramatiques du réchauffement climatique."
                        }
                    ],
                    "synonyms": [
                        "alarmer",
                        "inquiéter"
                    ],
                    "antonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "alerter le public",
                        "alerter les esprits",
                        "alerter les populations"
                    ]
                },
                {
                    "sense_id": "19ff44d0-da99-3fdc-8776-18faa986df56",
                    "sense_definition": "Signaler un contenu inapproprié ou abusif aux modérateurs d'une plateforme en ligne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les utilisateurs d'un forum peuvent <w>alerter</w> la modération lorsqu'un message enfreint les règles fixées."
                        },
                        {
                            "text": "Si vous constatez des propos haineux en ligne, pensez à <w>alerter</w> les modérateurs du site."
                        }
                    ],
                    "synonyms": [
                        "signaler"
                    ],
                    "common_phrases": [
                        "alerter la modération",
                        "alerter les modérateurs"
                    ]
                }
            ]
        }
    ]
