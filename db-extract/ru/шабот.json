                "translations": [
                    {
                        "translation_id": "83462dfb-b319-41cc-875c-96b4533b2e99",
                        "source_entry_id": "3c773b6d-46be-34d3-ae6f-16870b301f00",
                        "source_sense_id": "9d5f5a13-b307-3639-ba8b-3a6e4a15eca0",
