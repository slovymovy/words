                "senses": [
                    {
                        "sense_id": "fc96392c-a1c3-3b74-babe-697405fc2f61",
                        "entry_id": "e8fa5af5-9209-32b2-826b-2462d07d1013",
                        "glosses": [
                            "Nom vernaculaire de Blighia sapida, arbre moyen de la famille des Sapindaceae (Sapindacées), originaire d’Afrique occidentale et cultivé dans les régions tropicales pour son fruit. C’est une espèce proche du litchi."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fc6a6ff-1850-4bfa-b6eb-de7fe350aabf",
                        "source_entry_id": "e8fa5af5-9209-32b2-826b-2462d07d1013",
                        "source_sense_id": "fc96392c-a1c3-3b74-babe-697405fc2f61",
                        "target_lang_word": "ackee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ackee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3381d0-9fc4-35b7-93a7-1ec2c3dc94d8",
                                        "entry_id": "7c9a92c9-41da-3c48-956f-698837d7bd48",
                                        "glosses": [
                                            "A tropical evergreen tree, Blighia sapida, related to the lychee and longan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb75a542-105e-4e93-9ca7-df304dc7806a",
                                                "sense_id": "1c3381d0-9fc4-35b7-93a7-1ec2c3dc94d8",
                                                "text": "The beautiful Akee (Blighia sapida), originally brought from the West Coast of Africa by slave ships, is now a common tree in the West Indies, and I noticed several fine specimens in Belize."
                                            },
                                            {
                                                "example_id": "168feb34-7b71-4e47-9515-a1ab5780eb1c",
                                                "sense_id": "1c3381d0-9fc4-35b7-93a7-1ec2c3dc94d8",
                                                "text": "Delano and I are sprawled out under the ackee tree watching the black ants march from one rotten ackee pod to the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619bdad1-92bb-3326-8cff-a9e90c566a04",
                                        "entry_id": "7c9a92c9-41da-3c48-956f-698837d7bd48",
                                        "glosses": [
                                            "The fruit of the tree, of which only the arils are edible, the remainder being poisonous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba97897f-9126-4896-80cf-d18f34b5cbf5",
                                                "sense_id": "619bdad1-92bb-3326-8cff-a9e90c566a04",
                                                "text": "Ackee and saltfish is a traditional Jamaican dish."
                                            },
                                            {
                                                "example_id": "9d362227-6a56-4206-ac7b-8de1cc45c454",
                                                "sense_id": "619bdad1-92bb-3326-8cff-a9e90c566a04",
                                                "text": "The fleshy sacks that dangled down between his legs, like rotting ackees, wobbled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
