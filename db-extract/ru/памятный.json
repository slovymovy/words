                                        "glosses": [
                                            "Something interesting enough to be remembered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe2b08e-250d-47c6-a502-eda57d8f42b4",
                                                "sense_id": "0d3eb92f-b51b-3210-b52a-aaf900ae5496",
                                                "text": "These were all the memorables of our visit to Dumbarton Castle, which is a most interesting spot, and connected with a long series of historical events."
