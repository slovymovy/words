                                        "examples": [
                                            {
                                                "example_id": "a3c27ef1-2417-4bbf-bf41-dbdf6e90d6be",
                                                "sense_id": "e64aa444-e92d-3819-a59e-9aa58a7154fc",
                                                "text": "„Elisabeth ließ jedoch den bisherigen Titel \"Supreme Head\" in \"Supreme Governor\" umformulieren.“"
                                            },
                                            {
                                                "example_id": "89498533-6044-4837-a151-82c5208ea8e9",
                                                "sense_id": "e64aa444-e92d-3819-a59e-9aa58a7154fc",
                                                "text": "„Entwickler müssen ihren Code jedoch nicht komplett händisch umformulieren, Xcode 8.0 enthält einen Code-Migrator, der einen Großteil der benötigten Änderungen automatisieren soll.“"
                                            },
                                            {
                                                "example_id": "f51a27b4-8928-43fb-9966-4ac43a69570f",
                                                "sense_id": "e64aa444-e92d-3819-a59e-9aa58a7154fc",
                                                "text": "„Deswegen können wir auch den aufklärerischen Kantischen Imperativ »Man muss wollen können« in »Du muss wollen können« umformulieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
