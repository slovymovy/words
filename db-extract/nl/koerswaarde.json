                        "sense_id": "5985570b-4f41-3564-b3f1-f4d7120a220f",
                        "entry_id": "79b35203-0fe6-358c-93f1-389af841b382",
                        "glosses": [
                            "de door de koers op de aandelenmarkt bepaalde waarde van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6e6f3b-7ef1-4e3b-934a-a345a9446739",
                                "sense_id": "5985570b-4f41-3564-b3f1-f4d7120a220f",
                                "text": "Maar wat gebeurt er zodra wij, gezaghebbende heren, dat honderdste tegen de gangbare borg van tien procent op onze naam reserveren, en enkel door dat blijk van belangstelling ook de belangstelling van andere heren gaande maken? De koerswaarde van het schip zal stijgen, die van het honderdste en ook die van ons recht."
                            },
                            {
                                "example_id": "7e49b5d2-a96a-447b-b911-cb55a35c8cbe",
                                "sense_id": "5985570b-4f41-3564-b3f1-f4d7120a220f",
                                "text": "Het aandeel Tesla op de beurs van New York bereikte gisteren met een koerswaarde van meer dan 1000 dollar een recordhoogte."
                            }
                        ]
                    }
