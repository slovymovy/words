                        "cross_references": [
                            {
                                "target_word": "biplace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adefa7e2-8ebd-31e9-8e5b-da548405cfc1",
                                        "entry_id": "eda5ca11-74a7-33df-bbed-7f71bb98c217",
                                        "glosses": [
                                            "Qui comprend deux places en parlant d’un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c582a91-e491-43d2-bcf4-b6eccd95b173",
                                                "sense_id": "adefa7e2-8ebd-31e9-8e5b-da548405cfc1",
                                                "text": "Par exemple, la responsabilité liée aux phases de décollage et atterrissage d’un parapente biplace relève de l’obligation de moyen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "biplace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3e4cc7-4aa9-355e-9af9-53dbaece055c",
                                        "entry_id": "37121bfd-e82a-37db-a2b1-ea2b746abbec",
                                        "glosses": [
                                            "Avion biplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "117e0ab5-bc77-46d2-bd5b-d81a65fe4bd3",
                                                "sense_id": "0b3e4cc7-4aa9-355e-9af9-53dbaece055c",
                                                "text": "Son rôle de pilote d’essais est mis plus particulièrement en lumière sur les biplaces d’entraînement à réaction, Morane-Saulnier 755 « Fleuret » et Fouga 170 « Magister »."
                                            },
                                            {
                                                "example_id": "14b3e409-1877-421e-a6a3-8359a848b5e6",
                                                "sense_id": "0b3e4cc7-4aa9-355e-9af9-53dbaece055c",
                                                "text": "Les Curtiss et Vought-CorsmV employés furent plus tard remplacés par un biplace biplan léger, le Martin 125, susceptible de bombarder en piqué à la vitesse limite de 620 kmh."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "biplace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8bc654-8d3b-3d71-a81c-76f6135030d1",
                                        "entry_id": "c91c11fd-fa42-3b4a-94b8-aa8bdaaaf8b0",
                                        "glosses": [
                                            "Automobile biplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4667085e-73eb-4b2a-83f7-0dc34b6a6c40",
                                                "sense_id": "0c8bc654-8d3b-3d71-a81c-76f6135030d1",
                                                "text": "Baptisé eXasis, le cru 2007 consiste en une biplace entièrement transparente, fonctionnant au bioéthanol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
