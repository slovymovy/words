                "senses": [
                    {
                        "sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
                        "entry_id": "d177c60f-9888-3653-8537-b62e2f87eb58",
                        "glosses": [
                            "Se dit de toute chose ou personne privée de sexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40fa2111-5858-4e58-bfeb-3db70b0407f6",
                                "sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
                                "text": "La reproduction asexuée ne permet pas le brassage des gènes."
                            },
                            {
                                "example_id": "14ccaddf-8fa2-440c-a5e4-1ef55c2cff90",
                                "sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
                                "text": "[…] une voix asexuée, filtrée par les litanies, blutée par les oraisons, passée aux cribles des adorations et des pleurs"
                            },
                            {
                                "example_id": "a2ed1fb2-51cb-4cd7-836f-80f87d0a8f9f",
                                "sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
                                "text": "Un corps pauvre et amaigri fascine en plus de rebuter l’autre : au lieu de collaborer avec un régime donné de consommation, il devient asexué et se défait des codes qui prescrivent une féminité au modèle unique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaf5d17b-0225-4cde-bc70-39c958aab49a",
                        "source_entry_id": "d177c60f-9888-3653-8537-b62e2f87eb58",
                        "source_sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
                        "target_lang_word": "geschlechtslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschlechtslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52784bf8-d140-3087-bd22-14525cb95dae",
                                        "entry_id": "a8a61923-b4af-3b35-b080-3d7890197091",
                                        "glosses": [
                                            "ohne ein bestimmtes Geschlecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac99af3e-12c6-4ba9-9fea-2b5fa31b9340",
                                                "sense_id": "52784bf8-d140-3087-bd22-14525cb95dae",
                                                "text": "„Kritiker stellen dabei heraus, dass die Madonna als geschlechtsloses Wesen gezeigt werde, was wiederum an das patriarchalische Prinzip anknüpfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55537245-5745-4171-ba92-58f8ec892f08",
                        "source_entry_id": "d177c60f-9888-3653-8537-b62e2f87eb58",
                        "source_sense_id": "82e8da02-ba26-33a9-965e-2e9889b234b2",
