                    "semantic_group_id": "evaluate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na lang wikken en <w>wegen</w> hebben we besloten om te verhuizen.",
                            "target_lang_translations": {
                                "en": "After much <w>deliberation</w>, we decided to move.",
                                "ru": "После того как мы всё обдумали и <w>взвесили</w>, мы решили переехать.",
                                "pl": "Po długim namyśle i <w>rozważeniu</w> wszystkich za i przeciw zdecydowaliśmy się na przeprowadzkę.",
                                "de": "Nach langem Hin- und <w>Herüberlegen</w> haben wir uns entschieden umzuziehen.",
                                "fr": "Après mûre <w>réflexion</w>, nous avons décidé de déménager.",
                                "it": "Dopo aver a lungo <w>ponderato</w> la decisione, abbiamo deciso di traslocare.",
                                "cs": "Po dlouhém váhání a <w>zvažování</w> jsme se rozhodli přestěhovat.",
                                "tr": "Uzun süre ince eleyip sık <w>dokuduktan</w> sonra taşınmaya karar verdik.",
                                "es": "Después de mucho <w>sopesar</w> las cosas, decidimos mudarnos."
                            }
                        },
                        {
                            "text": "De rechter moet alle bewijzen zorgvuldig <w>wegen</w> voor het vonnis.",
                            "target_lang_translations": {
                                "en": "The judge must carefully <w>weigh</w> all the evidence before the verdict.",
                                "ru": "Судья должен тщательно <w>взвесить</w> все доказательства перед вынесением приговора.",
                                "pl": "Sędzia musi dokładnie <w>rozważyć</w> wszystkie dowody przed wydaniem wyroku.",
                                "de": "Der Richter muss alle Beweise vor dem Urteil sorgfältig <w>abwägen</w>.",
                                "fr": "Le juge doit soigneusement <w>peser</w> toutes les preuves avant le verdict.",
                                "it": "Il giudice deve <w>soppesare</w> attentamente tutte le prove prima della sentenza.",
                                "cs": "Soudce musí před vynesením rozsudku pečlivě <w>zvážit</w> všechny důkazy.",
                                "tr": "Hâkim, karardan önce tüm delilleri dikkatle <w>tartmalıdır</w>.",
                                "es": "El juez debe <w>sopesar</w> cuidadosamente todas las pruebas antes de la sentencia."
                            }
                        }
                    ],
