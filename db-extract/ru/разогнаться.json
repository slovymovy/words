                "senses": [
                    {
                        "sense_id": "47073ea9-dc6a-32e8-98bb-67cfc2ea0349",
                        "entry_id": "c1f39ea9-255f-3475-8682-d834b9a3439b",
                        "glosses": [
                            "набрать, увеличить скорость (при беге, езде и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13784e3d-c710-4818-a4d8-83f8a4bdd7ce",
                        "source_entry_id": "c1f39ea9-255f-3475-8682-d834b9a3439b",
                        "source_sense_id": "47073ea9-dc6a-32e8-98bb-67cfc2ea0349",
                        "target_lang_word": "accélérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accélérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                                        "entry_id": "2e12bd79-f47c-3e7a-98b3-b8d917ec730a",
                                        "glosses": [
                                            "Rendre plus rapide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea17448f-94b0-4829-84c8-4b989481d96e",
                                                "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                                                "text": "Les machinistes prenaient leurs postes, les figurants se massaient en reculant vers le troisième plan, et le régisseur gesticulait pour accélérer la manœuvre."
                                            },
                                            {
                                                "example_id": "5e2c931c-ea60-4ff0-9146-0f7aab8294c4",
                                                "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                                                "text": "L'espèce humaine elle-même, par ses déboisements acharnés au cours des siècles, a fini par créer des conditions telle que l'œuvre aveugle de la destruction de la montagne s'est trouvée accélérée."
                                            },
                                            {
                                                "example_id": "061af520-f23b-4b27-9784-4249afea7daa",
                                                "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                                                "text": "La gravité d’un corps qui tombe en accélère le mouvement. — Accélérer la marche d’une armée."
                                            },
                                            {
                                                "example_id": "8109fcc7-43da-42c4-b5d2-8611fa37a0e0",
                                                "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                                                "text": "Il faut accélérer ce travail. — Accélérer la décision d’une affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90532104-0527-309d-810b-c0a067d63735",
                                        "entry_id": "2e12bd79-f47c-3e7a-98b3-b8d917ec730a",
                                        "glosses": [
                                            "Augmenter la vitesse, la célérité."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "586f3ecc-15e6-4d65-9a46-a8764ede376a",
                                                "sense_id": "90532104-0527-309d-810b-c0a067d63735",
                                                "text": "Je distinguai des blouses blanches, un brancard. J’accélérai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f547d43b-0f1f-3553-a97a-908c9ef2377d",
                                        "entry_id": "2e12bd79-f47c-3e7a-98b3-b8d917ec730a",
                                        "glosses": [
                                            "Relancer"
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "381e0822-028a-315e-8c72-2773fc284d70",
                                        "entry_id": "2e12bd79-f47c-3e7a-98b3-b8d917ec730a",
                                        "glosses": [
                                            "Devenir plus rapide."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda35597-fa88-4c25-8445-c8bf45ea6673",
                                                "sense_id": "381e0822-028a-315e-8c72-2773fc284d70",
                                                "text": "Pendant les premiers jours de l’établissement de mon vannier, je ne passais point devant sa boutique sans que les battements de mon cœur ne s’accélérassent."
                                            },
                                            {
                                                "example_id": "416a1031-e6e3-4878-b3e6-1f115a43ffe4",
                                                "sense_id": "381e0822-028a-315e-8c72-2773fc284d70",
                                                "text": "Le train s’ébranle en ce moment, les roues de la locomotive patinent sur le rail, puis la vitesse s’accélère…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
