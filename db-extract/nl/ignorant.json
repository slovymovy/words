                                        "sense_id": "13141bb2-4782-3f3f-8934-4b730376788d",
                                        "entry_id": "79d195dd-fcf1-38dc-b9a2-bdbf94fde8d9",
                                        "glosses": [
                                            "unwissend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f59680e7-8925-4aeb-ae34-953c66ecc94c",
                                                "sense_id": "13141bb2-4782-3f3f-8934-4b730376788d",
                                                "text": "Was den Umgang mit Computern betrifft, ist meine Großmutter vollkommen ignorant."
                                            },
                                            {
                                                "example_id": "98094fc2-e825-4501-8a2c-3f2db9b229f6",
                                                "sense_id": "13141bb2-4782-3f3f-8934-4b730376788d",
                                                "text": "„Ein Pope ignorantester Sorte, welcher ausser des Walachischen keiner anderen Sprache mächtig, nicht einmal mit seinem eigenen Consul, viel weniger mit den türkischen oder bulgarischen Autoritäten ohne Dolmetsch verkehren konnte.“ (1877)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d48cf90-23ce-4e05-ba64-afbe846a1940",
                        "source_entry_id": "5fc02624-434d-3493-9108-d68708d3631f",
                        "source_sense_id": "82b9c079-9cf8-35a3-a7be-d8c959d0a468",
                        "target_lang_word": "unwissend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwissend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57b384f5-f3e3-3ada-9dca-51e93a0c8ff9",
                                        "entry_id": "31a26a9c-e0fa-317c-96cc-e46f9321058d",
                                        "glosses": [
                                            "kein (hinreichendes) Wissen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35095dc4-7c4b-46e3-a20e-d8150a00be3c",
                                                "sense_id": "57b384f5-f3e3-3ada-9dca-51e93a0c8ff9",
                                                "text": "„Die deutsche Revolution fand ein unwissendes Volk, eine Führerschicht bürokratischer Biedermänner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "829cda13-53ab-4cc0-af6a-5a23da7a6fa0",
                        "source_entry_id": "5fc02624-434d-3493-9108-d68708d3631f",
                        "source_sense_id": "82b9c079-9cf8-35a3-a7be-d8c959d0a468",
                        "target_lang_word": "ignorant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’est pas instruit de certaines choses, qui ignore certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0deb71-ad43-456c-bb4a-d0b8ee687e59",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Puis la gravure de cette dalle, l’inscription, sont tracées par un faussaire ignorant et inhabile."
                                            },
                                            {
                                                "example_id": "bb242436-ac89-414a-972c-cddfd1c9d178",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Il sait beaucoup de choses, mais il est fort ignorant en géographie."
                                            },
                                            {
                                                "example_id": "1c3eb748-bf06-4689-aeda-0e626c6b3d2b",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "Il est ignorant sur ces matières-là, en ces matières-là, de ces matières-là."
                                            },
                                            {
                                                "example_id": "fe121f66-947a-41a4-8af0-9454a2b1d15c",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "C’est un homme fort ignorant des choses du monde."
                                            },
                                            {
                                                "example_id": "b9774b61-1229-479e-9faf-7f5a8a47040e",
                                                "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                                                "text": "En termes de Palais, Être ignorant du fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d28b98a-0d38-3276-bf1f-04e48ed078f7",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "J’en suis aussi ignorant que l’enfant qui vient de naître, se dit pour marquer qu’on ne sait rien de quelque chose qui est arrivé."
                                        ],
                                        "tags": [
                                            "Proverbial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’est pas instruit de ce qu’il doit savoir."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0532ffa-ea21-46cf-b516-d0e395480928",
                                                "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                                "text": "Élève ignorant."
                                            },
                                            {
                                                "example_id": "45167c20-d10e-47a4-854e-88a4a4da7031",
                                                "sense_id": "049343c0-f031-3522-9057-af51cbe867f8",
                                                "text": "Institutrice ignorante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                        "entry_id": "3f29b2bf-f557-316d-ad90-673c9f5d98c3",
                                        "glosses": [
                                            "Qui n’a aucun savoir, qui est sans lettres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0097909-aa12-47ea-a916-ddb7bd7aff9f",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il est si ignorant qu’il ne sait pas lire."
                                            },
                                            {
                                                "example_id": "5f94d9e7-c7ce-474f-8e18-7ddafa2f2c7b",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Tous ces peuples-là sont très ignorants."
                                            },
                                            {
                                                "example_id": "57c1e5ea-7f49-49fe-9768-24f1d3f927f4",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il a le sens droit, mais du reste il est fort ignorant."
                                            },
                                            {
                                                "example_id": "34438b7c-d1d3-4803-be57-fa4f8ffe8a59",
                                                "sense_id": "86b149db-03e8-37ce-be3d-5899a9b6ba0f",
                                                "text": "Il s’avoue ignorant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                        "entry_id": "c653bca9-5f90-39d9-89f1-2b67bc242984",
                                        "glosses": [
                                            "Personne ignorante (dans tous les sens de l’adjectif)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3776c0b9-d86f-4e90-85e3-b5ce566f15ec",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "C’est un ignorant."
                                            },
                                            {
                                                "example_id": "de62527d-c42f-437b-8172-5cbecf5de8e1",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "C’est un franc ignorant."
                                            },
                                            {
                                                "example_id": "52f44b1f-5988-447b-aefc-0fda5b00a1c8",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "Il n’y a que des ignorants qui puissent parler de la sorte."
                                            },
                                            {
                                                "example_id": "dcb05600-e6cd-46ba-9c71-92d29cb51a2b",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "Il fait l’ignorant là-dessus, mais personne n’est mieux informé que lui."
                                            },
                                            {
                                                "example_id": "32949439-8690-4423-abd1-2763d88b0ad9",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "L’ignorant absolu ne sais pas qu'il ignore."
                                            },
                                            {
                                                "example_id": "498b605d-ea10-4505-8bda-5813fc580f7b",
                                                "sense_id": "257f3639-1383-35a8-9aa8-37d91ddcdf59",
                                                "text": "Dites le mot franchement, je passerai pour un ignorant, un niais..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "255c3b3f-f1e7-312c-9301-fc340082eb67",
                                        "entry_id": "fb606288-7fee-30c2-b935-fbe00b18be7f",
                                        "glosses": [
                                            "Participe présent de ignorer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f24a268-7744-4d0e-8ec2-cedd23ea19ce",
                                                "sense_id": "255c3b3f-f1e7-312c-9301-fc340082eb67",
                                                "text": "On peut aisément juger que n’ignorant pas ce qui devoit s’y passer, il ne prenoit pas plaisir à voir que la Réformation de l’Église, qui avait été le principal but du concile, aboutît à si peu de chose, et qu'on l’eût empêchée en prématurant l’élection du pape, contre ses intentions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
