                                "target_senses": [
                                    {
                                        "sense_id": "38f2914f-b649-337b-8faf-f84d07c386dd",
                                        "entry_id": "17ec8658-1a6a-344d-9150-4c53adc9dac1",
                                        "glosses": [
                                            "in der Art eines Professors, sich wie ein Professor verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82fcec57-40b9-4bc2-a0a1-930236694b92",
                                                "sense_id": "38f2914f-b649-337b-8faf-f84d07c386dd",
                                                "text": "„Er war von kleiner Statur, leicht vornübergebeugt, von professoralem Äußeren, hatte einen gepflegten grauen Bart, und hinter der Goldrandbrille funkelten graublaue Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6deaf059-bbea-4d81-801b-7a18f8188eb0",
                        "source_entry_id": "2003f0a6-60ef-3d4b-b221-8dae19f99e7d",
                        "source_sense_id": "6adca8e0-bc2f-3481-aa79-4bea5c211c74",
                        "target_lang_word": "professorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49caa5a8-315c-3065-95fd-4bfd6fc4b3c7",
                                        "entry_id": "b9b363cf-17eb-3b69-b7b2-d00c337a7c4c",
                                        "glosses": [
                                            "Of, relating to, or characteristic of a professor or professors, or of a professorship or professorships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a5396b-cb9c-4c41-9c31-efe9d3bfe9c9",
                                                "sense_id": "49caa5a8-315c-3065-95fd-4bfd6fc4b3c7",
                                                "text": "David and I were not \"intimate\" friends. There was always a certain old-worldly formality about our interchanges. There was something professorial and distant about David, something that commanded respect, partially, I think, because he was so respectful himself."
                                            },
                                            {
                                                "example_id": "f5b51ab9-d7e4-4145-9d9f-fb1a87343565",
                                                "sense_id": "49caa5a8-315c-3065-95fd-4bfd6fc4b3c7",
                                                "text": "Adamant that women could not enter the professorial fraternity, [[w:Cornell University|Cornell [University]]] did not appoint any women professors until 1911 and then only in home economics. Comstock regained her professorial title only in 1913, after working for many years as a lecturer (Conable 127, 130)."
                                            },
                                            {
                                                "example_id": "98015714-1dd8-4408-a13c-b0bd81d0ee86",
                                                "sense_id": "49caa5a8-315c-3065-95fd-4bfd6fc4b3c7",
                                                "text": "Professorial, downright dorktastic African-American NBA [National Basketball Association] stars are defying the expectation that they wear an intimidating hood facade, which is changing how we view black athletes—and how they view themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
