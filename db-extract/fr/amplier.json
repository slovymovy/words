                        "glosses": [
                            "Différer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7f7377a6-4548-4c34-84ad-780736f085b1",
                                "sense_id": "8711c618-32a0-396d-912d-ebbcc04cc429",
                                "text": "Ainsi, amplier le terme d'un payement, c'est donner du temps au débiteur ; amplier un criminel, c'est différer le jugement de son procès ; amplier un prisonnier, c'est lui rendre sa prison plus supportable, en lui donnant plus d'aisance & de liberté."
                            }
                        ]
