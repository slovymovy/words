                        "entry_id": "93ce14ef-2e9a-3a53-8f93-96d717df5ce0",
                        "glosses": [
                            "o człowieku świnia, łajdak, szubrawiec"
                        ],
                        "tags": [
                            "dated",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "457768b1-f4d8-45bf-a0c2-f51f1a8fee28",
                                "sense_id": "aa70ebb3-c4a9-37c3-95f6-8c0868032e0e",
                                "text": "Chodzi, szołdra, po wybrzeżu i gwiżdże, i kobiecie sromotne rzeczy gada. A on jakie prawo ma?"
                            },
                            {
                                "example_id": "4bd147b7-09ae-43ca-883d-a4179796d8f1",
                                "sense_id": "aa70ebb3-c4a9-37c3-95f6-8c0868032e0e",
                                "text": "Poczekajże ty szołdro pruski! Takiś ty żołnierz! Uciekać umiesz tylko, heretycki oberwańcze!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
