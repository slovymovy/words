                        "examples": [
                            {
                                "example_id": "eabe0e4d-f4f0-46d9-8289-a79a5d3e2b9d",
                                "sense_id": "6e76f285-109c-3dd1-aedf-1e7ec5fefe26",
                                "text": "Thayer Healey, un « base-jumpeur » américain, a filmé à l’aide d’une caméra embarquée une chute qui a bien failli être mortelle."
                            },
                            {
                                "example_id": "698c97d6-b700-4292-a4c5-f530355bb824",
                                "sense_id": "6e76f285-109c-3dd1-aedf-1e7ec5fefe26",
                                "text": "Confrontés au danger, les base-jumpeurs cherchent précisément à neutraliser cette part de hasard qui demeure dans l’issue de toute tentative, conscients de l’absence d’un droit à l’essai qui ne coûte rien et de la présence de son corollaire : le risque."
                            }
                        ]
                    }
