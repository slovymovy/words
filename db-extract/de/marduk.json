                                        "glosses": [
                                            "A late-generation god from ancient Mesopotamia and patron deity of the city of Babylon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "937034b8-f7e1-4ffb-997f-9cd07dee0e10",
                                                "sense_id": "a0b3aa14-769c-3bc4-aa06-3701263414d2",
                                                "text": "He gave a copy to his son Marduk, who passed it on to Hammurabi."
                                            }
                                        ]
