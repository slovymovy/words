                        "examples": [
                            {
                                "example_id": "147dfd87-1692-4662-ac46-5454101b7abb",
                                "sense_id": "f79fe865-bdbe-35a6-a8bb-26c4638f6310",
                                "text": "HELLENDOORN - Avonturenpark Hellendoorn gaat de rest van deze zomer af en toe werken met verschillende tijdvakken. Op vier woensdagen moeten bezoekers kiezen tussen een dag- en een avondbezoek."
                            },
                            {
                                "example_id": "a2eedb46-bd6b-4800-ae5e-52a1e22da1ee",
                                "sense_id": "f79fe865-bdbe-35a6-a8bb-26c4638f6310",
                                "text": "In Venlo had het ziekenhuis Vie Curi veel overlast. Een tijdje mocht er van de brandweer niemand meer in en uit. Het avondbezoek werd afgelast. Er waren diverse lekkages in het gebouw. In Limburg kreeg de brandweer ruim honderd meldingen van wateroverlast."
                            }
                        ]
                    }
