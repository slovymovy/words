                ],
                "senses": [
                    {
                        "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                        "entry_id": "15383f1e-92c5-3ce3-8d7c-8df28ef91dab",
                        "glosses": [
                            "durchgängige Betrachtung des Güter- und Informationsflusses in der gesamten Kette zwischen Lieferant, Unternehmen und Kunde"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "f4dc99ef-11c3-44e8-987e-45e91d65baa8",
                                "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                                "text": "„Das Flussdenken zielt darauf ab, den Güter- und Informationsfluss zwischen Lieferant und Abnehmer nicht zu unterbrechen, weil ungeplante Unterbrechungen Kosten durch Umschlagoperationen sowie Bestandskosten durch Lagern und Verlängerung der Durchlaufzeiten verursachen.“"
                            },
                            {
                                "example_id": "ae759b62-e397-483d-8590-ad5dfe9abfe1",
                                "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                                "text": "„Das Flussdenken als Ausprägung des Systemdenkens betont die Dimension der Zeit gegenüber der Dimension der Kapazität im Logistiksystem.“"
                            },
                            {
                                "example_id": "8da97a8f-7cd1-484e-bd37-7a47eb71b608",
                                "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                                "text": "„Gerade durch das wachsende Flussdenken und die Prozessorientierung führt die Koordination zu starkem Zuspruch, was zwangsläufig zu einer stärkeren Betrachtung der Schnittstellen führt.“"
                            },
                            {
                                "example_id": "86587a41-e242-462d-97c6-5f8634e7c918",
                                "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                                "text": "Das Flussdenken macht einen Teil des Systemdenkens der Logistik aus, ist alleine aber nicht ausreichend wirksam, da bei Gesamtkostenbetrachtungen in vernetzten Systemen Bestände insgesamt gesehen durchaus wirtschaftlicher sein können als der Aufbau anderer Bestandteile der Logistikkosten."
                            },
                            {
                                "example_id": "b12b8787-1006-468a-8fc2-37c686094091",
                                "sense_id": "0c39a442-4b24-34a9-8caf-7e26cc9219c9",
                                "text": "Damit ist eine Funktion angesprochen, die dem System- und Flussdenken der Logistik entspricht (Klaus & Kille, 2006. S. 27)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
