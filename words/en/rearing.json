{
    "word_family": [
        "rear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea463ecf-a3c0-38b5-9437-048f8f9125df",
                    "sense_definition": "The process of bringing up or caring for young animals or children until they are fully grown.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "upbringing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rearing</w> of livestock requires significant time and dedication from the farmer.",
                            "target_lang_translations": {
                                "pl": "<w>Chów</w> zwierząt gospodarskich wymaga od rolnika znacznego nakładu czasu i poświęcenia."
                            }
                        },
                        {
                            "text": "Proper <w>rearing</w> of the chicks is essential for their survival during the cold winter months.",
                            "target_lang_translations": {
                                "pl": "Właściwa <w>hodowla</w> piskląt jest niezbędna dla ich przetrwania podczas mroźnych zimowych miesięcy."
                            }
                        }
                    ],
                    "synonyms": [
                        "upbringing",
                        "raising",
                        "breeding"
                    ],
                    "common_phrases": [
                        "animal rearing",
                        "child rearing"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces wychowywania dzieci lub opieki nad młodymi zwierzętami do momentu osiągnięcia przez nie dorosłości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wychowanie",
                                "target_lang_sense_clarification": "w odniesieniu do dzieci"
                            },
                            {
                                "target_lang_word": "hodowla",
                                "target_lang_sense_clarification": "w odniesieniu do zwierząt"
                            },
                            {
                                "target_lang_word": "chów",
                                "target_lang_sense_clarification": "w odniesieniu do zwierząt gospodarskich"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c67bb9ca-28bb-3556-99e0-0f40e773d724",
                    "sense_definition": "The present participle and gerund of <w>rear</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "upbringing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>rearing</w> three children on her own while working full time.",
                            "target_lang_translations": {
                                "pl": "Obecnie sama <w>wychowuje</w> troje dzieci, pracując jednocześnie na pełen etat."
                            }
                        },
                        {
                            "text": "The horse was <w>rearing</w> up on its hind legs because it was frightened by the loud noise.",
                            "target_lang_translations": {
                                "pl": "Koń <w>stawał dęba</w> na tylnych nogach, ponieważ przestraszył się głośnego hałasu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb rear."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od czasownika 'rear' (wychowywać, hodować, stawać dęba)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wychowujący",
                                "target_lang_sense_clarification": "jako imiesłów"
                            },
                            {
                                "target_lang_word": "stający dęba",
                                "target_lang_sense_clarification": "w odniesieniu do konia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
