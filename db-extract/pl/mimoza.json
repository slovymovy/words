                                        "entry_id": "f3b06d69-02fd-3f3a-bf48-a4e4dd63ee8e",
                                        "glosses": [
                                            "A plant belonging to the genus Mimosa usually found in tropical climates, their leaves are usually prickly and sensitive to touch or light, and have small white or pink flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7022da-b919-4389-a66c-b7a4eef04301",
                                                "sense_id": "6e20b7d9-6064-3f0b-830c-0573699bc017",
                                                "text": "A Guardia Civil spokesperson said that ayahuasca, San Pedro, toad poison, wild rue and mimosa pudica were prohibited substances in Spain, adding that their consumption was not authorised because, while they were natural substances, they could be highly dangerous to human health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b1babf-bd1c-3a16-8024-1a19a8db44c0",
                                        "entry_id": "f3b06d69-02fd-3f3a-bf48-a4e4dd63ee8e",
                                        "glosses": [
                                            "Certain plants of the genus Albizia (silk tree, pink siris)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c42b855-8afe-4f77-a60d-f27ecb0ef7c4",
                                                "sense_id": "f9b1babf-bd1c-3a16-8024-1a19a8db44c0",
                                                "text": "Ya find yrself in the fret / of reclamation via musks all motherland-misty / (coconut milk, marine accord, mimosa tree)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27a7b28-d3f8-3bf4-aa34-f7f89c3590c5",
                                        "entry_id": "f3b06d69-02fd-3f3a-bf48-a4e4dd63ee8e",
