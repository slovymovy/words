                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bbbb09a-1f84-34d2-8b76-38840fef8222",
                                        "entry_id": "f190cc3f-405e-3847-bdd0-36a3ab8b8583",
