                    },
                    {
                        "sense_id": "a47ce89b-5d18-3f10-b222-28077fa1cdfb",
                        "entry_id": "73436987-fe53-33b8-9f4d-b9de6b2607a8",
                        "glosses": [
                            "прост., перен., наговаривать, навязчиво неотступно повторять, убеждая в чём-нибудь"
                        ],
                        "tags": [
                            "со словами «в уши» или без них, без дополнения"
                        ],
                        "examples": [
                            {
                                "example_id": "192fc3bb-bb56-4649-8a7e-ec95907819b3",
                                "sense_id": "a47ce89b-5d18-3f10-b222-28077fa1cdfb",
                                "text": "Он давно на меня напевает начальству."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "462e198d-95eb-452f-9ce2-7e2e3c99e37f",
                        "source_entry_id": "73436987-fe53-33b8-9f4d-b9de6b2607a8",
                        "target_lang_word": "fredonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fredonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b30af282-d442-399f-a2fe-a36c0a90ef19",
                                        "entry_id": "d853138b-9a23-3da2-8dde-57d615c8b5de",
                                        "glosses": [
                                            "Faire des fredons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fae90546-9149-3c72-bdc8-c87ad430b2f0",
                                        "entry_id": "d853138b-9a23-3da2-8dde-57d615c8b5de",
                                        "glosses": [
                                            "Chanter entre ses dents, sans articuler d’une manière distincte et sans y apporter d’attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86d5b1a-4e94-4d7a-8c40-57d565ade0dc",
                                                "sense_id": "fae90546-9149-3c72-bdc8-c87ad430b2f0",
                                                "text": "Voilà l'image de ma vie :je devrais fredonner gaiement sous la douche, tout à la joie de ce jour nouveau, et je m'engonce dans l’amère moiteur de maussades ruminements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a787cdd-9fd1-38d9-96e2-3f32be78cbdb",
                                        "entry_id": "d853138b-9a23-3da2-8dde-57d615c8b5de",
                                        "glosses": [
                                            "Chanter entre ses dents."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcaaa8b7-f7e3-42dc-8b72-a512b481a8ba",
                                                "sense_id": "3a787cdd-9fd1-38d9-96e2-3f32be78cbdb",
                                                "text": "Lorsqu’il est au piano, il fredonne tout ce qu’il joue. Les ingénieurs le prient de ne pas fredonner ainsi, de peur que cela ne s’entende dans le disque. Il cesse pendant quelques instants puis oublie la recommandation et recommence. Nouvelles plaintes des ingénieurs. Finalement, Basie s’enfonce dans la bouche un mouchoir pour se mettre à l’abri des distractions."
                                            },
                                            {
                                                "example_id": "0a6666c4-aad7-4d8c-8ffd-0811d99bb4df",
                                                "sense_id": "3a787cdd-9fd1-38d9-96e2-3f32be78cbdb",
                                                "text": "Dans son coin, Paul Hans fredonnait une chanson en s’épongeant le cou, chassant à grands gestes les nuées de moute-moute qui s’acharnaient sur la peau ruisselante de son visage."
                                            },
                                            {
                                                "example_id": "2d51c1f4-46a7-4a25-97fd-1969c202ef86",
                                                "sense_id": "3a787cdd-9fd1-38d9-96e2-3f32be78cbdb",
                                                "text": "Étant des guerriers du vieux jeu,\nPrêts à combattre pour Hélène,\nChez nous on fredonne assez peu\nLes airs venus de Mitylène^([sic])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3bf3b4-800d-3a66-b841-6d31a15e0875",
                                        "entry_id": "d853138b-9a23-3da2-8dde-57d615c8b5de",
                                        "glosses": [
                                            "Chanter, en parlant de la fauvette."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8107a84c-dd90-4677-9fa3-c48a814baff4",
                                                "sense_id": "5a3bf3b4-800d-3a66-b841-6d31a15e0875",
                                                "text": "Tout ſe r’anime, & les Chantres des airs\nDonnent ſans Art d’harmonieux Concerts,\nDans un Bocage on entend la Fauvette,\nSur les guérêts fredonner l’Aloüette :\nEn embuſcade, épiant un Mouton,\nPrès d’une Haye, un fils de Lycaon,\nDont par tes Chiens l’odeur eſt pourſuivie,\nAtteint d’un Plomb, perd ſon ſang & la vie."
                                            },
                                            {
                                                "example_id": "d3dd86d4-10c6-45b1-a241-1087a3cef8d4",
                                                "sense_id": "5a3bf3b4-800d-3a66-b841-6d31a15e0875",
                                                "text": "L’étourneau pisote (—pusitat).\nLe faon râle.\nLa fauvette fredonne.\nLe geai cajole (—fringulit).\nLa grenouille coasse."
                                            },
                                            {
                                                "example_id": "98d870c3-a1a9-4c45-a74f-56114f8d91c7",
                                                "sense_id": "5a3bf3b4-800d-3a66-b841-6d31a15e0875",
                                                "text": "Le latin le suit dans tous ses progrès. Le sens de minurire serait mitoner, dont on a détourné la signification ; on pourrait aussi bien créer le terme de mirliter, par honneur pour le mirliton. Tinnire appellerait tinter, ou peut-être tinrelintiner. Fringulire a trouvé son équivalent dans fringotter. Tous les autres verbes peuvent se partager entre fredonner et gazouiller qui n’annoncent que des essais, que des études, et qui sont au ramage ce que la chantonnerie est au chant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
