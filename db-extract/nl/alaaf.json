                        "examples": [
                            {
                                "example_id": "8fa0a1b2-3ae4-469a-8d0b-8cc3e82b14eb",
                                "sense_id": "7247820e-1cdf-3db5-906a-e7fa33d9cffb",
                                "text": "Anita sloot een intensieve week carnaval vieren woensdag af met het haring happen. „De carnavalsweek heeft wel een mooi beeld van het carnaval en de veelzijdigheid”, aldus Anita. ALAAF!"
                            },
                            {
                                "example_id": "6d95511f-ebf3-4ff8-b786-05e8bc4768af",
                                "sense_id": "7247820e-1cdf-3db5-906a-e7fa33d9cffb",
                                "text": "Alaaf! Carnaval staat voor de deur. Voor de één betekent dat een weekeinde lang de gordijnen dicht, voor de ander drie, vier of vijf dagen feesten. Behoor jij tot die laatste categorie? Met deze vijf tips houd jij het ook op Rosenmontag en carnavalsdinsdag nog vol!"
                            },
                            {
                                "example_id": "1e454267-06e1-4797-9ac4-9bf6d6ac7073",
                                "sense_id": "7247820e-1cdf-3db5-906a-e7fa33d9cffb",
                                "text": "Foto's van Guus Meeuwis en zijn vriendin Manon Meijers zijn uiterst zeldzaam. Maar vandaag werden hun volgers toch weer eens getrakteerd op een romantisch ogend kiekje met de tekst 'alaaf you'. Zo te zien is het stel ergens carnaval aan het vieren."
                            }
                        ]
                    }
