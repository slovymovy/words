                            {
                                "example_id": "db57c19f-a534-475a-9614-1c5e13d290f1",
                                "sense_id": "6c60496c-e5b3-3d9a-b7dd-4ff9dfec336b",
                                "text": "Il n’y a pas une maladie plus asthénisante que le choléra."
                            },
                            {
