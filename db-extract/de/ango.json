                "senses": [
                    {
                        "sense_id": "c18a8456-2db6-34d8-b6f2-4c405de218ac",
                        "entry_id": "4bd1cb27-04cf-31b4-8071-4069a09bfbf0",
                        "glosses": [
                            "Speer mit besonders langer eiserner Spitze mit Widerhaken"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b7c797d9-d617-4451-9e20-c71b3dbbdaf9",
                                "sense_id": "c18a8456-2db6-34d8-b6f2-4c405de218ac",
                                "text": "„Der Ango darf als vorzugsweise fränkische und zwar ripuarische Waffe betrachtet werden, […] Die Spitze mit den Widerhacken hat eine durchschnittliche Länge von 8 Cm., nur die etwas schlankeren Spitzen der belgischen Angonen haben 11 Cm.“"
                            },
                            {
                                "example_id": "5e2feb3b-07b9-44dc-a161-fe4314d488c9",
                                "sense_id": "c18a8456-2db6-34d8-b6f2-4c405de218ac",
                                "text": "„[…] Agathias [beschreibt] im Rahmen der Entscheidungsschlacht zwischen einem fränkisch-alemannischen Heer und den oströmischen Truppen unter Narses Hakenlanzen, die er Angonen nennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
