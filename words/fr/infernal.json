                        "cercle infernal",
                        "spirale infernale",
                        "rythme infernal"
                    ]
                },
                {
                    "sense_id": "013967a7-f459-3333-8ab4-39c75b7b1696",
                    "sense_definition": "Relatif ou propre à l'enfer, au séjour des morts ou aux puissances du mal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion_mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la mythologie romaine, Pluton régnait en maître sur les divinités <w>infernales</w>."
                        },
                        {
                            "text": "Le prêtre avertissait les fidèles contre les ruses des esprits <w>infernaux</w>."
                        }
                    ],
                    "synonyms": [
