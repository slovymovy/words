                ],
                "senses": [
                    {
                        "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                        "entry_id": "5c6fd7e0-93fb-31c7-aff4-7a192e0de10f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f8ae19-99ac-40cc-b71f-576b0170c514",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Aumeiers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "8d5d93f2-ce02-4cfd-b514-f69356bec19a",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Frau Aumeier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "02c7f405-1b64-4204-bb3f-147e33f000b2",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Herr Aumeier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "65042f9b-8ff8-43cd-9710-d4581215c372",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Die Aumeiers kommen heute vom Chiemsee."
                            },
                            {
                                "example_id": "4c59b318-1bdd-4256-9559-6d0f98138df9",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Der Aumeier trägt nie die Schals, die die Aumeier ihm strickt."
                            },
                            {
                                "example_id": "0a2ab82b-3d74-4272-b04b-92904a29fdeb",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aumeier kommt, geht der Herr Aumeier.“"
                            },
                            {
                                "example_id": "32e650b2-93be-472e-bb6a-3168f6a5711a",
                                "sense_id": "07f5d2ba-faac-3895-a7ea-5a65142ec3bb",
                                "text": "Aumeier kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
