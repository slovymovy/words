                ],
                "senses": [
                    {
                        "sense_id": "0c38b0cb-969a-36dd-a14c-fd5a7f3917a1",
                        "entry_id": "a0fe7c6e-d3e8-3866-87f1-343aadd9ed38",
                        "glosses": [
                            "Particularité génétique d’un individu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca46871-c934-43a9-a88b-2ed5e7b5e91d",
                                "sense_id": "0c38b0cb-969a-36dd-a14c-fd5a7f3917a1",
                                "text": "Les allotypes sont des déterminants antigéniques des Ig différents d’un sujet à l’autre, indépendants de la fonction anticorps et déterminés génétiquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b5b0b43-cd6f-4e7f-950d-d397d9c5c669",
                        "source_entry_id": "a0fe7c6e-d3e8-3866-87f1-343aadd9ed38",
                        "source_sense_id": "0c38b0cb-969a-36dd-a14c-fd5a7f3917a1",
                        "target_lang_word": "allotype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allotype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f11ffe84-f695-37cd-880f-943a2a1fd527",
                                        "entry_id": "a518d061-3548-386e-be0c-0def781f7726",
                                        "glosses": [
                                            "A designated paratype of a species (or lower-order taxon) that is the opposite sex of the holotype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e740fae-f91b-4674-9dd3-85757509c4e1",
                                                "sense_id": "f11ffe84-f695-37cd-880f-943a2a1fd527",
                                                "text": "2007, Ivana Karanovic, Candoninae (Ostracoda) from the Pilbara Region in Western Australia, Koninklijke Brill, page 182,\nThe allotype female has one T2 deformed (fig. 75D), while the other one is normally developed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6360cc8c-5e55-3076-8c96-88885b3d0959",
                                        "entry_id": "a518d061-3548-386e-be0c-0def781f7726",
                                        "glosses": [
                                            "A genetically determined variant of the amino acid sequence of a protein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940f3d68-06f6-423b-8441-c631a3f8b4f3",
                                                "sense_id": "6360cc8c-5e55-3076-8c96-88885b3d0959",
                                                "text": "2007, I. D. Walker, G. Winter, D. J. Worthington, Chapter 2: Structural Investigations of Peptides and Proteins: I: Primary Structure and Chemical Modification, R. C. Sheppard, Amino Acids, Peptides and Proteins, Volume 8, The Chemical Society, page 145,\nUntil recently, different C-region allotypes were explained by allelic genes which each encoded a different but closely related protein sequence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb564d6-7f5b-3215-a4d2-fc569b90dbbb",
                                        "entry_id": "a518d061-3548-386e-be0c-0def781f7726",
                                        "glosses": [
                                            "An immunoglobulin allotype; the allele of the antibody chains found in an individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afab34d2-7ab7-4e47-969b-feea58a6f8e6",
                                                "sense_id": "3cb564d6-7f5b-3215-a4d2-fc569b90dbbb",
                                                "text": "The products of allelic forms of the same gene are known as allotypes. Allotypes are now known for all mouse heavy chains (Stall, 1995). There are no known serologically detectable allotypes of mouse κ chains."
                                            },
                                            {
                                                "example_id": "a959ac29-b369-48ed-8a59-3b2eb400a210",
                                                "sense_id": "3cb564d6-7f5b-3215-a4d2-fc569b90dbbb",
                                                "text": "Since different individuals of the same species may have different allotypes, these determinants can be used as genetic markers.\nThe most common technique used for allotype determination is hemagglutination-inhibition."
                                            },
                                            {
                                                "example_id": "76e657c2-b7c4-401d-8fea-a8745dea904e",
                                                "sense_id": "3cb564d6-7f5b-3215-a4d2-fc569b90dbbb",
                                                "text": "Allotypes were originally defined by antisera that differentiated allelic variants of immunoglobulin (Ig) subclasses. The allotype is due to the existence of different alleles at the genetic locus that determines the expression of a given determinant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
