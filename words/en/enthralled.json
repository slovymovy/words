{
    "word_family": [
        "enthrall",
        "enthralling",
        "enthrallment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f92ddfc-9547-3aa8-bab0-81a842823e1d",
                    "sense_definition": "Feeling very interested and excited by something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was <w>enthralled</w> by the beautiful performance.",
                            "target_lang_translations": {
                                "ru": "Зрители были <w>очарованы</w> прекрасным выступлением."
                            }
                        },
                        {
                            "text": "The children sat <w>enthralled</w> as their grandfather told stories about the war.",
                            "target_lang_translations": {
                                "ru": "Дети сидели <w>завороженные</w>, пока дедушка рассказывал истории о войне."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivated",
                        "fascinated",
                        "mesmerized"
                    ],
                    "antonyms": [
                        "bored"
                    ],
                    "common_phrases": [
                        "enthralled by",
                        "enthralled with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сильный интерес и восторг от чего-либо, очарованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очарованный",
                                "target_lang_sense_clarification": "находящийся под сильным впечатлением, плененный чем-то"
                            },
                            {
                                "target_lang_word": "увлеченный",
                                "target_lang_sense_clarification": "полностью поглощенный каким-либо занятием или объектом"
                            },
                            {
                                "target_lang_word": "завороженный",
                                "target_lang_sense_clarification": "находящийся в состоянии, близком к гипнотическому, из-за сильного интереса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fbbfd4f-af3f-3b8b-91e6-fbd0869b01f7",
                    "sense_definition": "Simple past and past participle of <w>enthrall</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician <w>enthralled</w> the children with his clever tricks.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>очаровал</w> детей своими ловкими трюками."
                            }
                        },
                        {
                            "text": "The speaker <w>enthralled</w> the crowd for over an hour.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>заворожил</w> толпу более чем на час."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола «очаровывать» или «пленять»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровал",
                                "target_lang_sense_clarification": "привлек внимание, вызвал восхищение"
                            },
                            {
                                "target_lang_word": "заворожил",
                                "target_lang_sense_clarification": "приковал внимание, лишил возможности отвлечься"
                            },
                            {
                                "target_lang_word": "пленял",
                                "target_lang_sense_clarification": "удерживал внимание, вызывал глубокий интерес"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}