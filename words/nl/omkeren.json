{
    "word_family": [
        "keer",
        "omkering",
        "terugkeren",
        "omkeerbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47173af1-22f1-345f-b203-95a1151bd795",
                    "sense_definition": "je lichaam omdraaien om de andere kant op te kijken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "omdraaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik zijn naam riep, <w>keerde</w> hij zich langzaam <w>om</w>.",
                            "target_lang_translations": {
                                "en": "When I called his name, he slowly <w>turned around</w>."
                            }
                        },
                        {
                            "text": "Je moet je <w>omkeren</w> om de prachtige zonsondergang achter je te zien.",
                            "target_lang_translations": {
                                "en": "You have to <w>turn around</w> to see the beautiful sunset behind you."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdraaien"
                    ],
                    "common_phrases": [
                        "zich omkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn your body around to look in the other direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn around",
                                "target_lang_sense_clarification": "physically rotate one's body"
                            },
                            {
                                "target_lang_word": "turn round",
                                "target_lang_sense_clarification": "physically rotate one's body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96e7da31-8c3a-3571-8f3e-4a714b504b9a",
                    "sense_definition": "van richting veranderen en teruggaan naar waar je vandaan kwam",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "terugkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De weg was geblokkeerd, dus we moesten met de auto <w>omkeren</w>.",
                            "target_lang_translations": {
                                "en": "The road was blocked, so we had to <w>turn around</w> with the car."
                            }
                        },
                        {
                            "text": "Daarna was hij maar <w>omgekeerd</w> omdat het te laat begon te worden.",
                            "target_lang_translations": {
                                "en": "After that, he just <w>turned back</w> because it was starting to get too late."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugkeren",
                        "omdraaien"
                    ],
                    "antonyms": [
                        "doorrijden",
                        "doorgaan"
                    ],
                    "common_phrases": [
                        "met de auto omkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to change direction and go back to where you came from"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn around",
                                "target_lang_sense_clarification": "reverse direction while traveling"
                            },
                            {
                                "target_lang_word": "turn back",
                                "target_lang_sense_clarification": "return to a previous point"
                            },
                            {
                                "target_lang_word": "u-turn",
                                "target_lang_sense_clarification": "perform a 180-degree turn in a vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "075f6f0b-9de2-312b-89c4-934bd54cba7e",
                    "sense_definition": "iets zo draaien dat de andere kant boven of voor komt te liggen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de pannenkoek voorzichtig <w>omkeren</w> in de pan.",
                            "target_lang_translations": {
                                "en": "You have to <w>flip</w> the pancake carefully in the pan."
                            }
                        },
                        {
                            "text": "Hij <w>keerde</w> het blad <w>om</w> om de tekst op de achterkant te lezen.",
                            "target_lang_translations": {
                                "en": "He <w>turned</w> the page <w>over</w> to read the text on the back."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdraaien",
                        "omwentelen"
                    ],
                    "common_phrases": [
                        "het blad omkeren",
                        "een pannenkoek omkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn something so that the other side is facing up or forward"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flip",
                                "target_lang_sense_clarification": "turn over quickly, like a pancake"
                            },
                            {
                                "target_lang_word": "turn over",
                                "target_lang_sense_clarification": "show the other side of an object"
                            },
                            {
                                "target_lang_word": "flip over",
                                "target_lang_sense_clarification": "turn something to its opposite side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddf4e81d-2e92-34ab-abcb-fc8e4734e0a1",
                    "sense_definition": "iets ondersteboven zetten of draaien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dieven <w>keerden</w> het hele huis <w>om</w> op zoek naar geld.",
                            "target_lang_translations": {
                                "en": "The thieves <w>turned</w> the whole house <w>upside down</w> looking for money."
                            }
                        },
                        {
                            "text": "Als je de doos <w>omkeert</w>, valt alle inhoud eruit.",
                            "target_lang_translations": {
                                "en": "If you <w>turn</w> the box <w>upside down</w>, all the contents will fall out."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondersteboven keren"
                    ],
                    "common_phrases": [
                        "het huis omkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn or set something upside down"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn upside down",
                                "target_lang_sense_clarification": "invert something completely"
                            },
                            {
                                "target_lang_word": "tip over",
                                "target_lang_sense_clarification": "empty by turning"
                            },
                            {
                                "target_lang_word": "upturn",
                                "target_lang_sense_clarification": "turn something upwards or over"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58bb33bb-cbf3-3fff-bde6-65a0be83d7d7",
                    "sense_definition": "een situatie of volgorde veranderen in het tegenovergestelde",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstracte verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe directeur wil de rollen <w>omkeren</w> binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "The new director wants to <w>reverse</w> the roles within the company."
                            }
                        },
                        {
                            "text": "We kunnen de bewijslast <w>omkeren</w> om onze onschuld aan te tonen.",
                            "target_lang_translations": {
                                "en": "We can <w>reverse</w> the burden of proof to demonstrate our innocence."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdraaien",
                        "reverseren"
                    ],
                    "antonyms": [
                        "handhaven"
                    ],
                    "common_phrases": [
                        "de rollen omkeren",
                        "de bewijslast omkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to change a situation or order into the opposite"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reverse",
                                "target_lang_sense_clarification": "change to the opposite state or order"
                            },
                            {
                                "target_lang_word": "turn around",
                                "target_lang_sense_clarification": "drastically change a situation"
                            },
                            {
                                "target_lang_word": "invert",
                                "target_lang_sense_clarification": "reverse the order or position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}