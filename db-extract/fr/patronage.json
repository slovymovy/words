                                        "glosses": [
                                            "The state or practice of being a sponsor."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31230610-0c2e-4e1d-9ca1-70c22f1442c6",
                                                "sense_id": "dd858286-9ebc-389f-a60a-43adde0a2a56",
                                                "text": "I find that for me, my sponsorship of a child via a charitable NGO provides a sense of great satisfaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f807815-d38c-3ab6-bbfa-bc7b368dc38b",
