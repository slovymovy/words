                "senses": [
                    {
                        "sense_id": "3e96b73f-4c9c-388e-8248-c03eb6558f9e",
                        "entry_id": "c755d25a-bdc5-3a2b-a27b-11a58038d3ed",
                        "glosses": [
                            "nördlicher Teil des Landes Niedersachsen in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28606d2-91e3-4626-85ca-4687b7c71188",
                                "sense_id": "3e96b73f-4c9c-388e-8248-c03eb6558f9e",
                                "text": "„Nordniedersachsen, Bremen, Hamburg, Schleswig-Holstein oder Mecklenburg-Vorpommern, überall sieht es ein wenig anders aus. Ostfriesische Inseln sind nicht wie Sylt oder Rügen.“"
                            },
                            {
                                "example_id": "f7422bf8-1032-4acc-b503-b8afa573d1f6",
                                "sense_id": "3e96b73f-4c9c-388e-8248-c03eb6558f9e",
                                "text": "„Orbiculargesteine treten als Ferngeschiebe auch in Norddeutschland auf. Drei Beispiele sind allein aus Nordniedersachsen bekannt.“"
                            },
                            {
                                "example_id": "35517832-bfa6-4b02-9d55-6bd1ed538601",
                                "sense_id": "3e96b73f-4c9c-388e-8248-c03eb6558f9e",
                                "text": "„Seit September [2018] sind auf den Regionalzugstrecken in Nordniedersachsen zwischen Bremervörde, Cuxhaven, Bremerhaven und Buxtehude die beiden weltweit einzigen Wasserstoffzüge unterwegs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
