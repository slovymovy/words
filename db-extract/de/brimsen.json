                ],
                "senses": [
                    {
                        "sense_id": "edb7a3cf-7d70-3996-a1c5-756e8291234c",
                        "entry_id": "b3dd1d5a-4f76-3707-9795-e158b4f7654f",
                        "glosses": [
                            "ein Weichkäse aus Schafmilch, der ursprünglich aus den Karpaten kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d60b241-03fb-4eac-a400-60d035d9bfa9",
                                "sense_id": "edb7a3cf-7d70-3996-a1c5-756e8291234c",
                                "text": "„Der intensiv schmeckende Brimsen aus 100 Prozent Schafsmilch eignet sich hervorragend als Grundzutat für Liptauer, schmeckt aber auch köstlich im Salat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be5f8790-23cf-4ec7-99c1-3e658fcdfa74",
                        "source_entry_id": "b3dd1d5a-4f76-3707-9795-e158b4f7654f",
                        "source_sense_id": "edb7a3cf-7d70-3996-a1c5-756e8291234c",
                        "source_sense_description": "Gastronomie: ein Weichkäse aus Schafmilch, der ursprünglich aus den Karpaten kommt",
                        "target_lang_word": "брынза",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брынза",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                        "entry_id": "f49f7bb0-8f60-3fab-920a-8ea27411c8c4",
                                        "glosses": [
                                            "кулин. рассольный сыр из овечьего молока или смеси овечьего с козьим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850276f5-368f-4276-8b63-cadba56fde57",
                                                "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                                "text": "В числе больших лакомств, славился в Кирьяковке овечий сыр, именуемый «брынзой». Слегка прожаренный на сковородке, он подавался к столу в виде закуски."
                                            },
                                            {
                                                "example_id": "c6667e11-eac8-4bb4-bd61-73d44e46b90a",
                                                "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                                "text": "— Драгоценный мой! Брынза не бывает зелёного цвета, это вас кто-то обманул. Ей полагается быть белой."
                                            },
                                            {
                                                "example_id": "0a7eb0dd-9946-44c8-b107-5f74cab66e62",
                                                "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                                "text": "Выпив стакан чаю и съев бутерброд с брынзой, я шёл в другие места театра."
                                            },
                                            {
                                                "example_id": "32eebfe1-7787-4629-93a7-b83e3b792376",
                                                "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                                "text": ".. у бабушки были помидоры. И ещё был сыр, очень белый и мягкий. Бабушка сказала, что это овец доят и из этого молока делают сыр. И что это — брынза."
                                            },
                                            {
                                                "example_id": "314511a5-93b1-472b-98a6-4661e2475429",
                                                "sense_id": "bd28afd2-6733-38f6-ae14-9632b4dc3a7f",
                                                "text": "В чайной нам подали чай и чудесную острую брынзу, завёрнутую в мокрую полотняную тряпочку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ee366f-c3f0-4a70-b3a6-a5771e8cdba5",
                        "source_entry_id": "b3dd1d5a-4f76-3707-9795-e158b4f7654f",
                        "source_sense_id": "edb7a3cf-7d70-3996-a1c5-756e8291234c",
