{
    "word_family": [
        "adversity",
        "adversary",
        "adversely",
        "adversarial"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                    "sense_definition": "Preventing success or development; harmful, unfavorable, or hostile to one's interests.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unfavorable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flight was delayed for several hours due to <w>adverse</w> weather conditions.",
                            "target_lang_translations": {
                                "ru": "Рейс был задержан на несколько часов из-за <w>неблагоприятных</w> погодных условий."
                            }
                        },
                        {
                            "text": "The new medication was pulled from the market after patients reported an <w>adverse</w> effect.",
                            "target_lang_translations": {
                                "ru": "Новое лекарство было снято с продажи после того, как пациенты сообщили о <w>побочном</w> эффекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfavorable",
                        "disadvantageous",
                        "hostile",
                        "detrimental"
                    ],
                    "antonyms": [
                        "proverse"
                    ],
                    "common_phrases": [
                        "adverse weather",
                        "adverse effect",
                        "adverse conditions",
                        "adverse reaction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствующий успеху или развитию; вредный, неблагоприятный или враждебный чьим-либо интересам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неблагоприятный",
                                "target_lang_sense_clarification": "о погодных условиях или обстоятельствах"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "о негативном эффекте лекарств"
                            },
                            {
                                "target_lang_word": "вредный",
                                "target_lang_sense_clarification": "оказывающий негативное влияние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                    "sense_definition": "Acting in a contrary or opposing direction; being on the opposite side.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opposite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adverse</w> party in the lawsuit refused to settle out of court.",
                            "target_lang_translations": {
                                "ru": "<w>Противоположная</w> сторона в судебном процессе отказалась от досудебного урегулирования."
                            }
                        },
                        {
                            "text": "The two families were <w>adverse</w> to one another for many generations.",
                            "target_lang_translations": {
                                "ru": "Эти две семьи были <w>враждебны</w> друг другу на протяжении многих поколений."
                            }
                        }
                    ],
                    "synonyms": [
                        "opposing",
                        "contrary",
                        "conflicting"
                    ],
                    "common_phrases": [
                        "adverse party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий в противоположном или противодействующем направлении; находящийся на противоположной стороне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "о стороне в споре или направлении"
                            },
                            {
                                "target_lang_word": "враждебный",
                                "target_lang_sense_clarification": "настроенный против кого-либо"
                            },
                            {
                                "target_lang_word": "противоборствующий",
                                "target_lang_sense_clarification": "активно выступающий против"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}