                                                "example_id": "269e43bd-7813-4607-957a-aac9de37289c",
                                                "sense_id": "56c862ed-8da7-34e4-98ae-910202c93a93",
                                                "text": "Then, he must misphase two klystrons, adjusting by equal and opposite amounts until the beam energy is correct."
                                            }
                                        ]
                                    }
                                ]
