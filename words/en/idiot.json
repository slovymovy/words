{
    "word_family": [
        "idiocy",
        "idiotic",
        "idiotically",
        "idiotism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                    "sense_definition": "A person who makes stupid decisions or behaves in a foolish way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such an <w>idiot</w> and put your coat on before you freeze.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>идиотом</w>, надень пальто, пока не замерз.",
                                "zh": "别当<w>笨蛋</w>了，在冻僵之前把外套穿上。"
                            }
                        },
                        {
                            "text": "He felt like a complete <w>idiot</w> after forgetting his own birthday.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя полным <w>идиотом</w>, забыв о собственном дне рождения.",
                                "zh": "忘了自己的生日后，他觉得自己简直是个<w>傻瓜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "buffoon",
                        "clown",
                        "nitwit",
                        "blockhead",
                        "ass"
                    ],
                    "antonyms": [
                        "genius"
                    ],
                    "common_phrases": [
                        "acting like an idiot",
                        "complete idiot",
                        "what an idiot",
                        "stop being an idiot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который принимает глупые решения или ведет себя глупо.",
                        "zh": "指做出愚蠢决定或行为愚蠢的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨蛋",
                                "target_lang_sense_clarification": "指行为愚蠢的人"
                            },
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "指愚蠢的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                    "sense_definition": "A person of low general intelligence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only an <w>idiot</w> would fail to understand such simple instructions.",
                            "target_lang_translations": {
                                "ru": "Только <w>идиот</w> не смог бы понять такие простые инструкции.",
                                "zh": "只有<w>白痴</w>才听不懂这么简单的说明。"
                            }
                        },
                        {
                            "text": "The movie portrays the main character as a lovable <w>idiot</w> who succeeds by luck.",
                            "target_lang_translations": {
                                "ru": "Фильм изображает главного героя как симпатичного <w>дурачка</w>, которому везет.",
                                "zh": "电影把主角刻画成一个靠运气成功的可爱<w>傻瓜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moron",
                        "imbecile",
                        "simpleton",
                        "dunce",
                        "dullard",
                        "dimwit",
                        "fool"
                    ],
                    "antonyms": [
                        "genius",
                        "intelligent person"
                    ],
                    "common_phrases": [
                        "village idiot",
                        "useful idiot",
                        "blithering idiot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с низким уровнем интеллекта.",
                        "zh": "指智力低下的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "тупица"
                            },
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "неумный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白痴",
                                "target_lang_sense_clarification": "指智力低下的人"
                            },
                            {
                                "target_lang_word": "蠢货",
                                "target_lang_sense_clarification": "指愚笨的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                    "sense_definition": "A person with a severe intellectual disability, historically defined in medicine as having a mental age below three.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the 19th century, the term <w>idiot</w> was a formal medical classification for specific cognitive impairments.",
                            "target_lang_translations": {
                                "ru": "В XIX веке термин <w>идиот</w> был официальной медицинской классификацией для определенных когнитивных нарушений.",
                                "zh": "在19世纪，“<w>白痴</w>”一词是针对特定认知障碍的正式医学分类。"
                            }
                        },
                        {
                            "text": "Historical census records often categorized people with mental disabilities as insane or <w>idiots</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические записи переписи часто классифицировали людей с умственными отклонениями как сумасшедших или <w>идиотов</w>.",
                                "zh": "历史人口普查记录常将有智力障碍的人归类为疯子或<w>白痴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cretin",
                        "imbecile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "formerly a medical and legal term, now offensive"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с тяжелой умственной отсталостью (устаревший медицинский термин).",
                        "zh": "指患有严重智力障碍的人（医学上的过时术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白痴",
                                "target_lang_sense_clarification": "医学上的过时术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0127799-8070-3334-8862-1992c58ded7c",
                    "sense_definition": "A proponent of the pseudoscientific argument of intelligent design.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The online forum was filled with debates between evolutionary biologists and an <w>IDiot</w>.",
                            "target_lang_translations": {
                                "ru": "Онлайн-форум был полон споров между эволюционными биологами и <w>идиотом</w>.",
                                "zh": "在线论坛上充斥着进化生物学家与那些<w>白痴</w>（智能设计论者）之间的争论。"
                            }
                        },
                        {
                            "text": "He wrote a blog post mocking the <w>IDiots</w> who refuse to accept scientific evidence.",
                            "target_lang_translations": {
                                "ru": "Он написал пост в блоге, высмеивающий <w>идиотов</w>, отказывающихся принимать научные доказательства.",
                                "zh": "他写了一篇博客文章，嘲笑那些拒绝接受科学证据的<w>白痴</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory pun on 'Intelligent Design'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник псевдонаучной теории «разумного замысла» (игра слов: ID + idiot).",
                        "zh": "指“智能设计论”的拥护者（贬义的双关语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«идиот»",
                                "target_lang_sense_clarification": "уничижит.: сторонник «разумного замысла» (игра слов ID + idiot)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白痴",
                                "target_lang_sense_clarification": "针对智能设计论者的贬义称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d199d7ae-0277-3c21-9db9-d05f42baf0ce",
                    "sense_definition": "Idiotic; characterized by stupidity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a wide, <w>idiot</w> grin plastered across his face.",
                            "target_lang_translations": {
                                "ru": "У него на лице застыла широкая <w>идиотская</w> ухмылка.",
                                "zh": "他脸上挂着一副<w>傻里傻气</w>的笑容。"
                            }
                        },
                        {
                            "text": "That was an <w>idiot</w> thing to do in front of the boss.",
                            "target_lang_translations": {
                                "ru": "Это был <w>идиотский</w> поступок перед начальником.",
                                "zh": "在老板面前做那种事真是太<w>愚蠢</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "idiotic",
                        "stupid",
                        "foolish"
                    ],
                    "common_phrases": [
                        "idiot box",
                        "idiot light",
                        "idiot proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идиотский; характеризующийся глупостью.",
                        "zh": "愚蠢的；表现出愚蠢特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идиотский",
                                "target_lang_sense_clarification": "свойственный идиоту"
                            },
                            {
                                "target_lang_word": "дурацкий",
                                "target_lang_sense_clarification": "глупый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愚蠢的",
                                "target_lang_sense_clarification": "形容行为或想法愚笨"
                            },
                            {
                                "target_lang_word": "傻里傻气的",
                                "target_lang_sense_clarification": "形容样子或行为显得愚笨"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}