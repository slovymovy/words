                    {
                        "sense_id": "d898709d-31cf-3914-9c1d-651c9630e856",
                        "entry_id": "9257791d-8d93-3133-8f62-a9c07d2029a5",
                        "glosses": [
                            "Type de musique vocale et sacrée né chez les esclaves noirs des États-Unis au XVIIᵉ siècle qui sera à l’origine du mouvement gospel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b6eaf2-dc49-482f-8838-4c82389129ce",
                                "sense_id": "d898709d-31cf-3914-9c1d-651c9630e856",
                                "text": "Le negro-spiritual plonge ses racines dans la culture musicale africaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4528682-153a-31fe-a34d-0cf6eaabf81e",
                        "entry_id": "9257791d-8d93-3133-8f62-a9c07d2029a5",
                        "glosses": [
                            "Œuvre, chant appartenant à ce courant musical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a830f62-7fc9-4429-84ea-3458bc1c4c59",
                                "sense_id": "c4528682-153a-31fe-a34d-0cf6eaabf81e",
                                "text": "Les Fisk Jubilee Singers étaient composé d'étudiants et de professeurs qui chantaient des negro-spirituals, mais également des ballades irlandaises et des hymnes sacrées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ca7bc17-c5cb-450b-837a-8cc2b49708f9",
