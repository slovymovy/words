                "senses": [
                    {
                        "sense_id": "46b67f0e-b43a-35fc-a534-5d176d7af007",
                        "entry_id": "94cb143d-143c-3221-9abd-39a365606c1d",
                        "glosses": [
                            "erste, einführende Vorlesung eines Professors an seinem neuen Lehrstuhl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce81066-c18a-48a1-9db6-1a791387d5ab",
                                "sense_id": "46b67f0e-b43a-35fc-a534-5d176d7af007",
                                "text": "Seine Antrittsvorlesung war gut besucht."
                            },
                            {
                                "example_id": "da7ac1d7-11f1-4d8a-82e8-d107127db8a0",
                                "sense_id": "46b67f0e-b43a-35fc-a534-5d176d7af007",
                                "text": "Privatdozentinnen und Privatdozenten halten eine Antrittsvorlesung."
                            },
                            {
                                "example_id": "06b925ce-3d62-4e87-be2b-0ce916e059dc",
                                "sense_id": "46b67f0e-b43a-35fc-a534-5d176d7af007",
                                "text": "Etwa 100 Gäste versammelten sich am vergangenen Montagnachmittag zur Antrittsvorlesung von Professor Dr. Tilo Böhmann."
                            },
                            {
                                "example_id": "912f235b-abb2-4bee-bc9d-1269848f24fa",
                                "sense_id": "46b67f0e-b43a-35fc-a534-5d176d7af007",
                                "text": "„Allerdings lässt er seine Antrittsvorlesung als Professor der Geschichte in Jena »Was heißt und zu welchem Ende studiert man Universalgeschichte« im »Teutschen Merkur« drucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
