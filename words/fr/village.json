                    "frequency": "VeryLow",
                    "semantic_group_id": "oenologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vigneron produit un vin d'appellation <w>village</w> fort apprécié des connaisseurs."
                        },
                        {
                            "text": "La carte proposait plusieurs côtes-du-rhône <w>villages</w> pour accompagner le rôti."
