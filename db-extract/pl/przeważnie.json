                                            {
                                                "example_id": "c21ceef1-7dd3-47f4-8bd2-84e0dbfff6e3",
                                                "sense_id": "6fbf7c1b-92ab-3c27-b719-11bd5114bbcc",
                                                "text": "Im Winter ist es meistens kalt, nur in diesem Jahr nicht."
                                            },
