                        "sense_id": "256a57bf-eaf0-317d-9108-c703e0ef762c",
                        "entry_id": "1021a4cf-6727-3896-a8e0-4f2023d02835",
                        "glosses": [
                            "strengthening; supporting; corroborating"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea6fbd0a-8dd8-482e-b25e-b56bd092c318",
                                "sense_id": "256a57bf-eaf0-317d-9108-c703e0ef762c",
                                "text": "There be divers sorts of bracelets fit to comfort the spirits ; and they be of three intentions ; refrigerant, corroborant, and aperient"
                            }
                        ]
                    }
