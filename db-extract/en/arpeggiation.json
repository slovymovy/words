                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b475f9-fb51-4a5e-9ffa-9d76011c1428",
                                "sense_id": "59aad95c-cfb6-35a9-9b73-19994d704c4c",
                                "text": "Alternated between arpeggiation of the chord outlines and some chord scale runs."
                            },
                            {
                                "example_id": "5147d4b9-61db-4fb5-a338-e38b5a770fc7",
                                "sense_id": "59aad95c-cfb6-35a9-9b73-19994d704c4c",
                                "text": "A later composition, the Fantasia in C minor (BWV 906) moves closer to the sonata-allegro form and challenges the performer with rapid arpeggiation, florid ornamentation and hand-crossings reminiscent of the sonatas by Domenico Scarlatti."
                            },
                            {
                                "example_id": "4dc49fab-5ac8-4c5c-abb1-7776178af1a5",
                                "sense_id": "59aad95c-cfb6-35a9-9b73-19994d704c4c",
                                "text": "As Klaus G. Roy puts it, Mozart \"exhausts the possibilities of one theme without at all exhausting the listener.\" Swirling scale passages, brilliant arpeggiation and lots of trills contribute to the festive air."
                            }
                        ]
                    }
