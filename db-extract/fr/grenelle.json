                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ba7de6-f7fd-4578-a2a3-701289df2f65",
                                "sense_id": "1cbfd6a6-dba5-3110-bc0b-b578583d0747",
                                "text": "Le pont de Grenelle, construit en bois en 1828, met en communication l’ancien Auteuil et l’ancien Grenelle."
                            },
                            {
                                "example_id": "41539628-ed2c-4521-830f-c3d38a644b0a",
                                "sense_id": "1cbfd6a6-dba5-3110-bc0b-b578583d0747",
                                "text": "Exception faite pour le coucou qu’ils prenaient pour aller à Grenelle ou à Brévannes, c’est la première fois qu’il dépense."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca63173e-00b2-35db-8c7b-3d00a12c5c3f",
                        "entry_id": "76917ffc-232b-3335-a821-869382ca6c15",
                        "glosses": [
                            "Le 59ᵉ quartier administratif de Paris, situé dans le 15ᵉ arrondissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9687f26-c0b6-44cd-8fcd-12ebd0e219aa",
                                "sense_id": "ca63173e-00b2-35db-8c7b-3d00a12c5c3f",
                                "text": "Mais pour que vous pigiez l’histoire, faut que j’remonte à 1919, au temps qu’Milo-la-Graisse terrorisait le quartier. C’est à Grenelle qu’il habitait."
                            }
                        ]
                    }
