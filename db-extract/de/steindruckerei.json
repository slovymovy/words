                "senses": [
                    {
                        "sense_id": "7ca5d310-11dd-3240-b4f8-8e688aaec277",
                        "entry_id": "6428e76a-96b7-320b-b0a2-1c2f9039f595",
                        "glosses": [
                            "Betrieb, der Steindrucke (Lithografien) herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79114826-b061-4db9-9cc8-a73343d15257",
                                "sense_id": "7ca5d310-11dd-3240-b4f8-8e688aaec277",
                                "text": "„Meine Mutter nahm in Paris einen Job als Aushilfskraft in der Steindruckerei von Fernand Mourlot an – in erster Linie, um in Kontakt mit Künstlern und an deren Adressen zu gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed5337f5-14e9-4fe9-a4d8-4afa188dc0c6",
                        "source_entry_id": "6428e76a-96b7-320b-b0a2-1c2f9039f595",
                        "source_sense_id": "7ca5d310-11dd-3240-b4f8-8e688aaec277",
                        "source_sense_description": "Betrieb, der Steindrucke (Lithografien) herstellt",
                        "target_lang_word": "lithographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lithographie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2017258-7e35-3b4e-a87b-2594e7b3a6a2",
                                        "entry_id": "2d53197f-0970-365b-9119-7e15400ed190",
                                        "glosses": [
                                            "Procédé par lequel on obtient sur du papier, au moyen de la presse, l’empreinte de ce qui a été dessiné ou écrit, sur une pierre d’une espèce particulière, avec un crayon ou avec une encre d’une certaine composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab984b4-621c-492c-b229-c4421c1d1328",
                                                "sense_id": "c2017258-7e35-3b4e-a87b-2594e7b3a6a2",
                                                "text": "La lithographie est une invention de la fin du dix-huitième siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4e10a12-cd4d-39b7-bf78-ccd6946c8d5a",
                                        "entry_id": "2d53197f-0970-365b-9119-7e15400ed190",
                                        "glosses": [
                                            "Image imprimée par ce procédé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "679b24b6-00a7-43cd-bf8f-c8ab7909e7f0",
                                                "sense_id": "a4e10a12-cd4d-39b7-bf78-ccd6946c8d5a",
                                                "text": "Madame Matifat, qui connaît les Arts, achetait des lithographies, des lithochromies, des dessins coloriés, tout ce qu’il y avait de meilleur marché."
                                            },
                                            {
                                                "example_id": "510b1235-161c-43a3-9803-0fe22c72c5d3",
                                                "sense_id": "a4e10a12-cd4d-39b7-bf78-ccd6946c8d5a",
                                                "text": "La jeune femme entra dans le magasin, y marchanda des albums, des collections de lithographies ; elle en acheta pour plusieurs pièces d’or qui étincelèrent et sonnèrent sur le comptoir."
                                            },
                                            {
                                                "example_id": "a0ab8b1f-17dc-41c6-accb-f9f707e91431",
                                                "sense_id": "a4e10a12-cd4d-39b7-bf78-ccd6946c8d5a",
                                                "text": "Ce garçon regardait Modeste comme il aurait examiné une lithographie à deux sous."
                                            },
                                            {
                                                "example_id": "1884d9d1-fb16-4b3c-9d96-fa8a730f52d8",
                                                "sense_id": "a4e10a12-cd4d-39b7-bf78-ccd6946c8d5a",
                                                "text": "Cet appartement de luxe est crépi en plâtre et badigeonné de bleu ; pendus aux murs, il y a les portraits du prince et de la princesse du Monténégro, dans de gros cadres dorés, et puis des lithographies allemandes avec des légendes slaves."
                                            }
                                        ]
                                    }
                                ]
                            },
