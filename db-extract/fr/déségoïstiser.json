                ],
                "senses": [
                    {
                        "sense_id": "d8f23b35-a0c2-3892-a099-1350b7444e42",
                        "entry_id": "8f28433c-38ce-3459-a11a-acb3f41f3a20",
                        "glosses": [
                            "Perdre son caractère égoïste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5b1e70-bde5-440c-a474-140aae66f0e8",
                                "sense_id": "d8f23b35-a0c2-3892-a099-1350b7444e42",
                                "text": "Conformément à ceci Le Parfait en s’éclipsant, s’impose, en se gaspillant, s’éternise, en se déségoïstisant, s’individualise."
                            },
                            {
                                "example_id": "f9dcabfd-50ec-4a83-bc53-21a62b268727",
                                "sense_id": "d8f23b35-a0c2-3892-a099-1350b7444e42",
                                "text": "Nous avons besoin de nous \"déségoïstiser\" pour \"nous individualiser\" ; mais à celui qui croit posséder l’Individualité, il est impossible de se \"déségoïstiser\"."
                            },
                            {
                                "example_id": "0e90355e-9683-4bf5-8967-17931c0ed194",
                                "sense_id": "d8f23b35-a0c2-3892-a099-1350b7444e42",
                                "text": "Si nous voulons nous individualiser, nous devons nous « déségoïstiser » ; l’individualisation n'est possible qu’au moyen de la « déségoïstisation »."
                            },
                            {
                                "example_id": "65009290-d569-4f23-b5fd-a67c347684d1",
                                "sense_id": "d8f23b35-a0c2-3892-a099-1350b7444e42",
                                "text": "De quelle façon pourrons-nous nous « déségoïstiser » ?"
                            }
                        ]
                    }
                ],
