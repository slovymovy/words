                "senses": [
                    {
                        "sense_id": "1ec55f75-f27e-3381-bdda-5308cd0652d9",
                        "entry_id": "4d6837cf-6b45-304a-9b0a-33e868dfb185",
                        "glosses": [
                            "Arthropode myriapode dont chaque segment porte une paire de pattes, sauf le premier dont la paire d’appendices est transformée en paire de crochets à venin appelés forcipules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae53b0b7-b7ca-45ec-b443-8b8749bc088b",
                                "sense_id": "1ec55f75-f27e-3381-bdda-5308cd0652d9",
                                "text": "La scutigère véloce est un chilopode très utile car elle débarrasse la maison de nombreux nuisibles pour l’homme, tels les moustiques, les punaises des lits, les fourmis, les termites, les blattes ou les poissons d’argent."
                            },
                            {
                                "example_id": "9f3997f4-3c29-410e-b6a9-8c20baceed6e",
                                "sense_id": "1ec55f75-f27e-3381-bdda-5308cd0652d9",
                                "text": "Seuls les chilopodes sont dangereux pour l’homme : ces mille-pattes possèdent des crochets venimeux entraînant une réaction inflammatoire très douloureuse et parfois d’évolution nécrotique."
                            }
                        ]
                    }
                ],
