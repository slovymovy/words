                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock exchange is often described as a <w>temple</w> of commerce.",
                            "target_lang_translations": {
                                "ru": "Фондовую биржу часто называют <w>храмом</w> коммерции."
                            }
