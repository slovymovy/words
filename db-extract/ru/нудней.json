        "ru-extract.jsonl": [
            {
                "entry_id": "33b4f67d-456a-3fa8-b54a-4441c3335763",
                "word": "нудней",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d424cc7-f236-3f57-9db7-55ad96d64fad",
                        "entry_id": "33b4f67d-456a-3fa8-b54a-4441c3335763",
                        "glosses": [
                            "сравн. ст. к нареч. нудно; более нудно"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "5601284d-e103-4d9a-b49b-eff678a4aae9",
                                "sense_id": "7d424cc7-f236-3f57-9db7-55ad96d64fad",
                                "text": "Некому было Дудину жаловаться, а жена, сама хирея день ото дня, замечать стала, что кашлять стал глуше и нудней .."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef511be-5471-34c4-99c6-bf3bebf4a602",
                        "entry_id": "33b4f67d-456a-3fa8-b54a-4441c3335763",
                        "glosses": [
                            "сравн. ст. к прил. нудный; более нудный"
                        ],
                        "tags": [
                            "comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "079046e3-ed1a-4d8b-8252-4d71953782e0",
                                "sense_id": "3ef511be-5471-34c4-99c6-bf3bebf4a602",
                                "text": "И сразу / дорога / нудней и нудней, // в туннель, / тормозами тужась."
                            },
                            {
                                "example_id": "a15d22e8-a180-4fe8-8c14-246512c8a149",
                                "sense_id": "3ef511be-5471-34c4-99c6-bf3bebf4a602",
                                "text": "О, этот миг тревожный и щемящий, // Души отрада среди серых дней, // Утеха в нашей жизни настоящей… // Без кофе станет жизнь ещё нудней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea282ba5-672f-411c-99ac-e03d1d8d224c",
                        "source_entry_id": "33b4f67d-456a-3fa8-b54a-4441c3335763",
