                        "source_sense_description": "Person, die Tiere mag",
                        "target_lang_word": "dierenvriend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dierenvriend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "05d68eb6-3736-33d5-879d-66182720f807",
                                        "entry_id": "0684857a-7468-3ce5-8325-b15914c089a2",
                                        "glosses": [
                                            "persoon die veel van dieren houdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e86a80d-bdde-4cca-913f-993ed19f9038",
                                                "sense_id": "05d68eb6-3736-33d5-879d-66182720f807",
                                                "text": "Dierenvriend Jan Blokhuijsen: \"Ik wilde even mijn hart luchten. Het dierenwelzijn gaat me aan het hart, maar achteraf gezien was dat niet het juiste moment.\""
                                            },
                                            {
                                                "example_id": "8d046365-de45-4532-961f-3262b3a531e9",
                                                "sense_id": "05d68eb6-3736-33d5-879d-66182720f807",
                                                "text": "Een echte dierenvriend bestuurde vanochtend een trein van Breda naar Rotterdam. Toen de machinist een gewonde zwaan op het spoor zag, besloot hij de trein te stoppen en het dier te redden. Op station Rotterdam Centraal werd de zwaan overgedragen aan de Dierenambulance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "185cb5fd-c32d-4788-99ec-a03b828c49b6",
                        "source_entry_id": "781a8814-f179-385f-a1e6-ddb64bd272c4",
                        "source_sense_id": "5168256e-01e5-3d73-b35e-6a70ae5ff676",
                        "source_sense_description": "Person, die Tiere mag",
                        "target_lang_word": "dierenliefhebber",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dierenliefhebber",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbb6fad-80da-3830-afb9-40b79bd54162",
                                        "entry_id": "066bd06f-8e0f-3465-b973-4634ef88ed8e",
                                        "glosses": [
                                            "persoon die veel van dieren houdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754af8c2-8668-4778-ac5f-db823656dbe3",
                                                "sense_id": "cbbb6fad-80da-3830-afb9-40b79bd54162",
                                                "text": "Op de website van J.J. Cale staat dat hij een grote dierenliefhebber was. Daarom wordt fans gevraagd om als eerbetoon aan hun idool een bedrag over te maken naar een lokaal goed doel dat zich inzet voor dieren."
                                            },
                                            {
                                                "example_id": "5f4dab93-d223-412e-bf41-67d8d97f4081",
                                                "sense_id": "cbbb6fad-80da-3830-afb9-40b79bd54162",
                                                "text": "'Kleine' kanttekening: van de totaal 7000 respondenten noemt 96 procent zichzelf dierenliefhebber. Het onderzoek gaat dus wel over mensen die van zichzelf al van katten houden. Kattenhaters zullen dus nog even verder moeten zoeken naar nuttig uitstelgedrag op het internet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
