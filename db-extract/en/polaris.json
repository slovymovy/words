                        "entry_id": "8c37e8af-cd8c-34a7-b0ef-3eea1a8b8063",
                        "glosses": [
                            "α Ursae Minoris, a trinary star in the constellation Ursa Minor located near the north celestial pole for the last 1500 years."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "86377dab-7933-35da-bc7b-5ed762fed397",
                        "entry_id": "8c37e8af-cd8c-34a7-b0ef-3eea1a8b8063",
                        "glosses": [
                            "A type of U.S. ballistic missile, capable of carrying a nuclear warhead and designed to be launched from a submarine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41495090-5c0a-4c34-9e45-b07108c7854c",
                                "sense_id": "86377dab-7933-35da-bc7b-5ed762fed397",
                                "text": "Tremble, you weaklings, cower in fear / I am your ruler — land, sea, and air / Immense in my girth, erect I stand tall / I am a nuclear murderer, I am Polaris\""
                            }
                        ]
                    }
                ],
