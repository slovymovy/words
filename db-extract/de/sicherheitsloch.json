                "senses": [
                    {
                        "sense_id": "b4af2c01-ec56-3c45-b4c0-486724d7f641",
                        "entry_id": "23ea5a46-4fe0-32ab-89bc-830388180fa3",
                        "glosses": [
                            "Schwachstelle in einer Software, durch die ein schädliches Programm oder ein Hacker in den Rechner eindringen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37fb9a3c-b0f9-4c4e-bbf3-4467c7bfbfaa",
                                "sense_id": "b4af2c01-ec56-3c45-b4c0-486724d7f641",
                                "text": "\"Unser Analyseverfahren ist zwar aufwendiger als Standard-Prüfmethoden, dafür entgeht uns aber garantiert kein Sicherheitsloch\""
                            },
                            {
                                "example_id": "d28fd6d4-0ffe-444b-baa3-57b1bf8f476b",
                                "sense_id": "b4af2c01-ec56-3c45-b4c0-486724d7f641",
                                "text": "\"Vor einem Jahr rüttelte Bill Gates mit einem Rundschreiben die Mitarbeiter von Microsoft auf: Es müsse endlich ein Ende haben mit den vielen Sicherheitslöchern im Windows-Betriebssystem.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
