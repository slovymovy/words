                        "examples": [
                            {
                                "example_id": "c0f6ce87-db99-43e3-be19-57e9604ebf2c",
                                "sense_id": "7ce4e476-7867-3afd-a692-b5ce35da2c38",
                                "text": "Hij liep uren achtereen door het bos."
                            },
                            {
                                "example_id": "9fc6374d-baa9-4e8e-ba6d-62db132f439c",
                                "sense_id": "7ce4e476-7867-3afd-a692-b5ce35da2c38",
                                "text": "Hij heeft 7 dagen achtereen gewerkt."
                            },
                            {
                                "example_id": "fe633a1e-c243-41a6-8716-69c4cfb03b8f",
                                "sense_id": "7ce4e476-7867-3afd-a692-b5ce35da2c38",
                                "text": "We komen hier al vijf jaar achtereen."
                            },
                            {
                                "example_id": "5a1d4ec8-d5b3-4e1c-96f6-4b32ac6234e6",
                                "sense_id": "7ce4e476-7867-3afd-a692-b5ce35da2c38",
                                "text": "Eens in de zoveel tijd wint zijn ijdelheid het van zijn kieskeurige alcoholisme en laat hij zich verleiden tot het kopen van een jas, een horloge, een overhemd. Die draagt hij dan weken achtereen om ze vervolgens terug te leggen in de kast en in zijn oude, vertrouwde kledingstukken te kruipen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
