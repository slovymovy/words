                        "sense_id": "3da61e0e-7be6-3b5e-9548-98b1918ba32d",
                        "entry_id": "8b6000cc-ad46-3771-be96-296d7054f041",
                        "glosses": [
                            "osad na metalu, tworzący się przy spalaniu paliwa (np. benzyny, oleju itd.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "892c0971-7c93-4337-b8ca-8b75af999ae5",
                                "sense_id": "3da61e0e-7be6-3b5e-9548-98b1918ba32d",
                                "text": "Zgromadzenie nagaru w kolektorze dolotowym jest poważnym problemem, który może wpłynąć na wydajność i długowieczność naszego silnika"
