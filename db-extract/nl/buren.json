                        "sense_id": "bf427456-3d0d-3520-9e96-531c7e9b8fbc",
                        "entry_id": "a5be4372-9c8f-331e-a590-6194ef582343",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord buur"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d425e4bd-c8e3-48e8-bdde-e7512a3dc6de",
                                "sense_id": "bf427456-3d0d-3520-9e96-531c7e9b8fbc",
                                "text": "Ze had ook geruchten gehoord over socialisten die anarchisten ervan langs gaven omdat ze hadden geprobeerd de plaatselijke kerk in brand te steken en die zelfs hun rechtse buren in hun broodovens verborgen om ze voor een gewisse dood te behoeden wanneer de radicalen opdoken."
                            },
                            {
                                "example_id": "475af6a4-3084-4b6f-9b79-5f43b7b19d5d",
                                "sense_id": "bf427456-3d0d-3520-9e96-531c7e9b8fbc",
                                "text": "Met veel hulp van de plaatselijke thuiszorg, haar buren en van mijn broer en mij kon ze er ondanks haar beperkingen nog zelfstandig blijven wonen."
                            }
                        ]
                    }
