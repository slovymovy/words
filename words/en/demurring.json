{
    "word_family": [
        "demur",
        "demurral"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67735e7b-f716-3956-8080-c51ef767e6ad",
                    "sense_definition": "present participle and gerund of <w>demur</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accepted the promotion without <w>demurring</w> at the increased responsibility.",
                            "target_lang_translations": {
                                "fr": "Elle a accepté la promotion sans <w>rechigner</w> face au surcroît de responsabilités."
                            }
                        },
                        {
                            "text": "Several board members were <w>demurring</w> over the proposed budget cuts.",
                            "target_lang_translations": {
                                "fr": "Plusieurs membres du conseil d'administration <w>soulevaient des objections</w> concernant les réductions budgétaires proposées."
                            }
                        }
                    ],
                    "synonyms": [
                        "objecting",
                        "hesitating"
                    ],
                    "antonyms": [
                        "agreeing",
                        "assenting"
                    ],
                    "common_phrases": [
                        "without demurring"
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent ou gérondif de « demur » : manifester de la réticence, hésiter ou soulever une objection."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "hésiter",
                                "target_lang_sense_clarification": "montrer de l'indécision ou de la réserve"
                            },
                            {
                                "target_lang_word": "rechigner",
                                "target_lang_sense_clarification": "montrer de la mauvaise grâce ou de la répugnance"
                            },
                            {
                                "target_lang_word": "objecter",
                                "target_lang_sense_clarification": "émettre des réserves ou s'opposer poliment"
                            },
                            {
                                "target_lang_word": "faire des objections",
                                "target_lang_sense_clarification": "soulever des arguments contraires"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96f29162-f102-378f-a3c7-66449edde73a",
                    "sense_definition": "Expressing hesitation, reluctance, or mild objection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered a <w>demurring</w> smile before declining the unexpected invitation.",
                            "target_lang_translations": {
                                "fr": "Elle a esquissé un sourire <w>hésitant</w> avant de décliner cette invitation inattendue."
                            }
                        },
                        {
                            "text": "His <w>demurring</w> tone suggested that he was not entirely comfortable with the plan.",
                            "target_lang_translations": {
                                "fr": "Son ton <w>réticent</w> laissait entendre qu'il n'était pas tout à fait à l'aise avec ce projet."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitant",
                        "reluctant"
                    ],
                    "common_phrases": [
                        "demurring smile"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui exprime de l'hésitation, de la réticence ou une légère objection."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "hésitant",
                                "target_lang_sense_clarification": "qui manifeste de la retenue ou du doute"
                            },
                            {
                                "target_lang_word": "réticent",
                                "target_lang_sense_clarification": "qui montre peu d'enthousiasme ou de la réserve"
                            },
                            {
                                "target_lang_word": "dubitatif",
                                "target_lang_sense_clarification": "qui exprime une réserve polie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1e6412c-1ed8-3ffd-9169-bbd9a3ad316c",
                    "sense_definition": "The act of objecting, hesitating, or raising an objection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a brief <w>demurring</w> from the defence, the judge admitted the evidence.",
                            "target_lang_translations": {
                                "fr": "Après une brève <w>objection</w> de la défense, le juge a admis la preuve."
                            }
                        },
                        {
                            "text": "There was no <w>demurring</w> from the committee regarding the new rules.",
                            "target_lang_translations": {
                                "fr": "Il n'y a eu aucune <w>réticence</w> de la part du comité concernant le nouveau règlement."
                            }
                        }
                    ],
                    "synonyms": [
                        "demurral",
                        "objection",
                        "hesitation"
                    ],
                    "target_lang_definitions": {
                        "fr": "Action d'objecter, d'hésiter ou de formuler une réserve."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "objection",
                                "target_lang_sense_clarification": "argument ou contestation soulevée"
                            },
                            {
                                "target_lang_word": "réticence",
                                "target_lang_sense_clarification": "expression de réserve ou d'hésitation"
                            },
                            {
                                "target_lang_word": "hésitation",
                                "target_lang_sense_clarification": "état ou manifestation de doute"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}