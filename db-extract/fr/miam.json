                    {
                        "translation_id": "dcb499d5-5857-4a30-9a3f-b91e590b826e",
                        "source_entry_id": "54df2727-f4ec-35bc-a256-b5f03b9282c1",
                        "target_lang_word": "うまい",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "うまい",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "2925da72-94b8-377c-aa68-2b8675798acf",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "【旨い・美味い・甘い・甘美い】 味が良い。おいしい。おいしく感じられる。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4091c031-3398-4222-ab61-80b0f9d1d84f",
                                                "sense_id": "2925da72-94b8-377c-aa68-2b8675798acf",
                                                "text": "もともと、自分は、うまい鮨を食わせる店というところに、ひとに連れられて行って食っても、うまいと思った事は、いちどもありませんでした。"
                                            },
                                            {
                                                "example_id": "e15464f5-9e6c-4f53-ae53-7b8bc11e3a04",
                                                "sense_id": "2925da72-94b8-377c-aa68-2b8675798acf",
                                                "text": "おかあさんが女中に牛乳で煮たおかゆを持って来させた。ポチは喜んでそれを食べてしまった。火事の晩から三日の間ポチはなんにも食べずにしんぼうしていたんだもの、さぞおかゆがうまかったろう。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bfd4e8-7ad1-3b61-970e-31ef3e4f1392",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "【巧い・上手い・巧妙い】 能力が優れる。巧みである。上手だ。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711ff9d6-6f9f-4fb8-a04f-97e7f664b0ac",
                                                "sense_id": "70bfd4e8-7ad1-3b61-970e-31ef3e4f1392",
                                                "text": "すると狸の子は棒をもってセロの駒の下のところを拍子をとってぽんぽん叩きはじめました。それがなかなかうまいので弾いているうちにゴーシュはこれは面白いぞと思いました。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b13858-e9c6-3faf-bc40-152742cdda82",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "言葉が的を射ている。冗談が気が利いていて面白い。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "858506d8-a72a-4701-ae2b-1183a46d0851",
                                                "sense_id": "63b13858-e9c6-3faf-bc40-152742cdda82",
                                                "text": "鴎外がうまい事を言っています。/「酒を傾けて酵母を啜るに至るべからず。」"
                                            },
                                            {
                                                "example_id": "bcb3cb00-25cf-4fd1-860f-4dfc9d6d193e",
                                                "sense_id": "63b13858-e9c6-3faf-bc40-152742cdda82",
                                                "text": "誰がうまいことを言えと言った。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d538f3a9-02ee-3bf9-86e7-ff4ff2f4e0f5",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "【美い】好いぐあいだ、ちょうどよい。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e543707c-b36b-460e-9c33-80027e5baca7",
                                                "sense_id": "d538f3a9-02ee-3bf9-86e7-ff4ff2f4e0f5",
                                                "text": "紫でちょっと切れた図面が、二三寸の間隔をとって、振り返る男の体（たい）のこなし具合で、うまい按排につながれている。不即不離とはこの刹那の有様を形容すべき言葉と思う。"
                                            },
                                            {
                                                "example_id": "d59ed057-f522-4a87-b488-69c5406c8060",
                                                "sense_id": "d538f3a9-02ee-3bf9-86e7-ff4ff2f4e0f5",
                                                "text": "野中兼山が「椋鳥には千羽に一羽の毒がある」と教えた（略）これが「百羽に一羽」というのではまずい。もし一プロセントの中毒率があるとすればその実例が一つや二つぐらいそこいらにありそうな気がするであろう。また「万羽に一羽」でもうまくない。万人に一人では恐ろしさがだいぶ希薄になる。"
                                            },
                                            {
                                                "example_id": "c995aed9-8994-4bbc-93a2-83d5666f3ae0",
                                                "sense_id": "d538f3a9-02ee-3bf9-86e7-ff4ff2f4e0f5",
                                                "text": "みなで三人乗ってゐる/一人はともに膝をかゝへて座ってゐるし/二人はじろじろこっちを見ながら立ってゐる/じつにうまくないそのつら"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1286cd-3433-3cc2-ac05-bfdaaaacfb50",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "一見よさそうに見える。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fc07cd-b89e-4052-912d-ff043d6e1191",
                                                "sense_id": "6f1286cd-3433-3cc2-ac05-bfdaaaacfb50",
                                                "text": "だが、あんまり棚からボタ餅のうまい話に、なんだか狐につままれたような変な気がして、なんと返事していいかまごついた。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908693b4-c4a0-38ef-8938-e5ec0c95c804",
                                        "entry_id": "940b98d6-3fa5-31b5-a19c-8b6ac7a9389e",
                                        "glosses": [
                                            "上首尾で。成功して。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdab328-4a25-418b-b276-eefb48a51331",
                                                "sense_id": "908693b4-c4a0-38ef-8938-e5ec0c95c804",
                                                "text": "「そんなに、うまくいくといいけどねえ。」"
                                            }
                                        ]
                                    }
                                ]
                            },
