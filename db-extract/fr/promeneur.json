                ],
                "senses": [
                    {
                        "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                        "entry_id": "3af3bafc-5eed-3ba9-8b5f-9de687853237",
                        "glosses": [
                            "Personne qui se promène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aaa3f85-6a61-4779-b955-032c8d626809",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "Les Rêveries du promeneur solitaire."
                            },
                            {
                                "example_id": "b67b41f2-1a9d-4361-b4ca-112fbc314cd3",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "Dès le matin, une longue file de promeneurs arrivait par la grande rue de Passy, et par les avenues du bois de Boulogne: …."
                            },
                            {
                                "example_id": "232653f8-ece6-4dcb-bbef-e872a7f5b140",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "Aussi, plus d'un promeneur dépassa-t-il le couple pour admirer ou pour revoir la jeune figure autour de laquelle se jouaient quelques rouleaux de cheveux bruns."
                            },
                            {
                                "example_id": "88c74202-177e-42fb-8832-ffb6d64a4504",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "Ces messieurs passèrent devant la façade de la Madeleine, en causant, à bâtons rompus, comme on peut causer sur une voie publique, encombrée de promeneurs."
                            },
                            {
                                "example_id": "98a04ae0-07a9-4fd5-970e-0ba86304ac80",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "La traversée du village, de l'église à la gare ou inversement, prenait un temps considérable pour les promeneurs parce qu'il fallait s'arrêter tout le temps pour dire bonjour à chacun."
                            },
                            {
                                "example_id": "f0a4083f-b2a9-4817-a10b-b0d516a6776c",
                                "sense_id": "e3f5407e-ab54-35af-8b7f-a5965a9d6a87",
                                "text": "La promenade fut aménagée pour le bonheur des promeneurs : piste cyclable, crottoirs pour toutous à sa mémère, bancs nombreux et propres permettant de s'extasier devant l’ire des marées."
                            }
                        ]
                    },
                    {
                        "sense_id": "e96ea4d0-7c30-34f6-9191-c856c5bf85d2",
                        "entry_id": "3af3bafc-5eed-3ba9-8b5f-9de687853237",
                        "glosses": [
                            "Personne qui aime à se promener."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6831842-d6d8-4b63-888c-241b07d9d43f",
                                "sense_id": "e96ea4d0-7c30-34f6-9191-c856c5bf85d2",
                                "text": "Je ne suis pas promeneur."
                            },
                            {
                                "example_id": "17f0b450-0c7f-4929-b6b3-de24efeb7632",
                                "sense_id": "e96ea4d0-7c30-34f6-9191-c856c5bf85d2",
                                "text": "C’est un grand promeneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9699e33-34b7-3468-8c37-42cd3e4ca488",
                        "entry_id": "3af3bafc-5eed-3ba9-8b5f-9de687853237",
                        "glosses": [
                            "Personne qui promène une autre."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "431727fa-539a-4a90-8aab-e304e983c234",
                        "source_entry_id": "3af3bafc-5eed-3ba9-8b5f-9de687853237",
                        "target_lang_word": "stroller",
