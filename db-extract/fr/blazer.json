                                    {
                                        "sense_id": "82a656a5-77b4-3656-9f4a-cc810c26026f",
                                        "entry_id": "06171539-ca97-3aab-9551-5f61c3f1db85",
                                        "glosses": [
                                            "One who spreads news, or blazes matters abroad."
                                        ],
