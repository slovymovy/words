                                "target_senses": [
                                    {
                                        "sense_id": "22146cfc-399d-318b-8494-92eba2c98f6a",
                                        "entry_id": "d5878caa-0527-3681-9618-834e3bb92e21",
                                        "glosses": [
                                            "acido organico formato da nuclei eterociclici e benzenici con azoto, che permette le reazioni di sintesi, riparazione e metilazione del DNA, e che si usa in farmacologia contro le anemie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79212265-6c6b-42a6-972d-a1f34c1ebe3b",
                                                "sense_id": "22146cfc-399d-318b-8494-92eba2c98f6a",
                                                "text": "L'acido folico è una vitamina idrosolubile del gruppo B"
                                            },
                                            {
                                                "example_id": "cb89c91c-cc49-4892-a432-15fe9337a12f",
                                                "sense_id": "22146cfc-399d-318b-8494-92eba2c98f6a",
                                                "text": "L'acido folico è presente nelle frattaglie, come folati nelle verdure a foglia verde, nei legumi e nelle uova"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214e9da3-0e09-4b05-ae89-f2336ce045e1",
                        "source_entry_id": "66c3b23b-7f4f-3a27-8985-f5a01b335997",
                        "source_sense_id": "20702115-3d6e-3607-a51c-44effc74f255",
                        "target_lang_word": "foliumzuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foliumzuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc88089f-9f91-35ce-87a5-08189552d004",
                                        "entry_id": "db7b421b-243a-3ad1-bdcc-5cb05eda96d8",
                                        "glosses": [
                                            "in wateroplosbaar vitamine dat o.a. wordt voorgeschreven aan zwangeren ter preventie van geboorteafwijkingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c46e49c-146c-46b5-b948-65c3e6744f5e",
                                                "sense_id": "fc88089f-9f91-35ce-87a5-08189552d004",
                                                "text": "Poels deed haar promotieonderzoek in Zeist. Onderdeel van haar onderzoek was een voorlichtingscampagne. \"We zagen dat door die campagne vrouwen vaker hun voedingspatroon veranderden, eerder een gesprek aangingen met een zorgverlener, sneller stopten met roken of drinken en eerder begonnen met foliumzuur slikken.\" Dat laatste verkleint de kans op geboorteafwijkingen als een open ruggetje, open gehemelte of hazenlip."
                                            },
                                            {
                                                "example_id": "4d8b38b1-fd99-48aa-aef8-e3946b42b297",
                                                "sense_id": "fc88089f-9f91-35ce-87a5-08189552d004",
                                                "text": "De oppositie in de Tweede Kamer vindt dat foliumzuur en zware paracetamol in het basispakket van de zorgverzekeraars moeten blijven. Ze zeggen dat deze middelen op zich goedkoop zijn, maar dat de kosten voor reumapatiënten toch hoog kunnen oplopen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
