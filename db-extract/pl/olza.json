                ],
                "senses": [
                    {
                        "sense_id": "243cf084-1fc0-3c76-9485-8d16a815c014",
                        "entry_id": "8c53323b-c436-38cf-a618-5a14ba8f69e2",
                        "glosses": [
                            "rzeka w Czechach i Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80138e41-fa00-42d4-84b7-303faeca34f8",
                                "sense_id": "243cf084-1fc0-3c76-9485-8d16a815c014",
                                "text": "Karlik siedział nad Olzą i łowił pstrągi."
                            },
                            {
                                "example_id": "68f85a83-3aa1-444f-a805-3ff9ccab0313",
                                "sense_id": "243cf084-1fc0-3c76-9485-8d16a815c014",
                                "text": "Harcerze cały ranek kąpali się w Olzie."
                            },
                            {
                                "example_id": "b6f1a541-b382-4772-b61e-14c8ac972e93",
                                "sense_id": "243cf084-1fc0-3c76-9485-8d16a815c014",
                                "text": "Głównymi rzekami Śląska Cieszyńskiego są: Olza, Wisła, Ostrawica, Odra i Biała."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "42281baf-5289-3f9e-a35e-a46e594e2212",
                        "entry_id": "8c53323b-c436-38cf-a618-5a14ba8f69e2",
                        "glosses": [
                            "wieś w Polsce w województwie śląskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04fdc04-e46e-452c-887f-672a2fe9241e",
                                "sense_id": "42281baf-5289-3f9e-a35e-a46e594e2212",
                                "text": "W herbie Olzy widnieje rybak z wędką w żółtej łódce."
                            },
                            {
                                "example_id": "8e462c6b-0e99-4486-bffc-f98151e650f4",
                                "sense_id": "42281baf-5289-3f9e-a35e-a46e594e2212",
                                "text": "Odra wraz z Olzą silnie ucierpiały w czasie tzw. powodzi tysiąclecia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
