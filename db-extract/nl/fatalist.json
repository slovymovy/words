                            {
                                "example_id": "878b4242-c38f-4d5e-a7bc-28506e2cecbe",
                                "sense_id": "95a47b45-cba1-330a-b3f2-62d76589dab3",
                                "text": "Dylan Borlée zette de vijfde tijd neer (47.16) na Antoine Gillet (47.02) en Robin Vanderbemden (47.06). “Deze week had ik nog last aan de hamstrings. Na 200 meter stak de pijn de kop op. Maar ik ben geen fatalist, morgen ga ik tot het uiterste.”"
                            },
                            {
                                "example_id": "595fca51-eb30-4212-a61c-231f2164ae15",
                                "sense_id": "95a47b45-cba1-330a-b3f2-62d76589dab3",
                                "text": "Ik ben een enorme hypochonder en fatalist. Ik durf nog geen griezelfilm te kijken.'"
                            },
                            {
                                "example_id": "4b5d031c-8164-4853-bbfb-83863fc50031",
                                "sense_id": "95a47b45-cba1-330a-b3f2-62d76589dab3",
                                "text": "De elftallen staan klaar. Bruno applaudisseert. „Wij Italianen zijn fatalisten. Maar we spelen goed combinatievoetbal. Tegen Engeland hadden we een record aan passes op dit WK. Vai, vai” Ik laat hem alleen."
                            }
                        ]
                    }
