                                        "sense_id": "32b33bf8-3973-3269-9a51-2a07252c485e",
                                        "entry_id": "304a3f00-6690-3fa0-b956-b3a74a75a78f",
                                        "glosses": [
                                            "sich im gleichen Verhältnis ändernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ea5766-a1a9-4346-bb4f-18333bbb1439",
                                                "sense_id": "32b33bf8-3973-3269-9a51-2a07252c485e",
                                                "text": "„Die Varianz der Driftzeit ist direkt proportional zum Driftweg bzw. zur Driftzeit.“"
