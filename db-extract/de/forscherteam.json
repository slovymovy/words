                "senses": [
                    {
                        "sense_id": "a53a87d6-57c8-3572-b531-e085129377f8",
                        "entry_id": "87412037-8783-3e92-a528-d36b741db22b",
                        "glosses": [
                            "Gruppe aus Wissenschaftlern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798aa124-5175-4bdb-99e6-f247984e22f0",
                                "sense_id": "a53a87d6-57c8-3572-b531-e085129377f8",
                                "text": "„Ein internationales Forscherteam hat eine potenziell bewohnbare \"Super-Erde\" in einem nahen Sternsystem aufgespürt.“"
                            },
                            {
                                "example_id": "0c53123b-9f91-4fe3-b3e8-a4d9a630a47d",
                                "sense_id": "a53a87d6-57c8-3572-b531-e085129377f8",
                                "text": "„Das Forscherteam habe mit dem Beginn der Datensammlung einen kollektiven \"Seufzer der Erleichterung\" ausgestoßen, sagte Chefwissenschaftlerin Maria Zuber.“"
                            },
                            {
                                "example_id": "3151cd5d-550b-4c79-88e9-12e16ebdf018",
                                "sense_id": "a53a87d6-57c8-3572-b531-e085129377f8",
                                "text": "„Mehr als 200 Porträts solcher »Hofmohren« hat ein Forscherteam um die Bremer Historikerin Rebekka von Mallinckrodt für ein Projekt zu Sklaven im Heiligen Römischen Reich in Archiven entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
