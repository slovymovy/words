                    "sense_definition": "Op een moment in de nabije toekomst; later vandaag of zo dadelijk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "future_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zullen <w>straks</w> de vragen doorlopen.",
                            "target_lang_translations": {
                                "ru": "Мы <w>позже</w> разберем вопросы.",
                                "en": "We will go through the questions <w>later</w>.",
                                "pl": "Przejdziemy przez pytania <w>później</w>.",
                                "de": "Wir gehen die Fragen <w>gleich</w> durch.",
                                "fr": "Nous passerons en revue les questions <w>tout à l'heure</w>.",
                                "it": "Esamineremo le domande <w>più tardi</w>.",
                                "cs": "Otázky projdeme <w>později</w>.",
                                "tr": "Soruları <w>birazdan</w> gözden geçireceğiz.",
                                "es": "Repasaremos las preguntas <w>luego</w>.",
                                "zh": "我们<w>待会儿</w>再过一遍这些问题。"
                            }
                        },
                        {
                            "text": "Ik kom <w>straks</w> even bij je langs om te praten.",
                            "target_lang_translations": {
                                "ru": "Я <w>позже</w> загляну к тебе поговорить.",
                                "en": "I'll drop by <w>later</w> to talk.",
                                "pl": "Wpadnę do ciebie <w>później</w> porozmawiać.",
                                "de": "Ich komme <w>später</w> kurz bei dir vorbei, um zu reden.",
                                "fr": "Je passerai te voir <w>tout à l'heure</w> pour discuter.",
                                "it": "Passo da te <w>tra poco</w> per parlare.",
                                "cs": "Stavím se za tebou <w>za chvíli</w> si promluvit.",
                                "tr": "Konuşmak için <w>birazdan</w> sana uğrayacağım.",
                                "es": "Pasaré a verte <w>luego</w> para hablar.",
                                "zh": "我<w>一会儿</w>顺便过去找你聊聊。"
                            }
                        },
                        {
                            "text": "Tot <w>straks</w>, ik zie je over een uurtje!",
                            "target_lang_translations": {
                                "ru": "<w>До скорого</w>, увидимся через час!",
                                "en": "See you <w>later</w>, I'll see you in an hour!",
                                "pl": "<w>Do zobaczenia wkrótce</w>, do zobaczenia za godzinę!",
                                "de": "Bis <w>später</w>, wir sehen uns in einer Stunde!",
                                "fr": "<w>À tout à l'heure</w>, on se voit dans une heure !",
                                "it": "<w>A dopo</w>, ci vediamo tra un'ora!",
                                "cs": "<w>Na viděnou později</w>, uvidíme se za hodinu!",
                                "tr": "<w>Görüşmek üzere</w>, bir saat içinde görüşürüz!",
                                "es": "<w>Hasta luego</w>, ¡nos vemos en una hora!",
                                "zh": "<w>待会儿见</w>，一小时后见！"
                            }
                        }
