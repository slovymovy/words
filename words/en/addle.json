{
    "word_family": [
        "addle-brained",
        "addle-headed",
        "addle-pated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12e533d3-ea1a-3cc6-85b4-0a7a62c67ee2",
                    "sense_definition": "To confuse, muddle, or impair someone's mind or thinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Too many complex instructions at once will only <w>addle</w> the young students.",
                            "target_lang_translations": {
                                "ru": "Слишком много сложных инструкций одновременно лишь <w>собьют с толку</w> юных учеников."
                            }
                        },
                        {
                            "text": "Working under the hot sun for several hours began to <w>addle</w> his thoughts.",
                            "target_lang_translations": {
                                "ru": "Работа под палящим солнцем в течение нескольких часов начала <w>затуманивать</w> его мысли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "addle someone brain",
                        "addle the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбивать с толку, приводить в замешательство или затуманивать рассудок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "дезориентировать, путать мысли"
                            },
                            {
                                "target_lang_word": "затуманивать",
                                "target_lang_sense_clarification": "о мыслях, разуме"
                            },
                            {
                                "target_lang_word": "дурманить",
                                "target_lang_sense_clarification": "затруднять ясность восприятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab17462-2e01-3142-a45f-08d37287d160",
                    "sense_definition": "To render an egg sterile or nonviable without breaking its shell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "egg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wildlife officers decided to <w>addle</w> the goose eggs to control the local bird population.",
                            "target_lang_translations": {
                                "ru": "Сотрудники природоохранной службы решили <w>сделать болтунами</w> гусиные яйца, чтобы контролировать популяцию местных птиц."
                            }
                        },
                        {
                            "text": "Farmers often shake or coat the clutch with oil to <w>addle</w> unwanted nests.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто встряхивают или покрывают кладку маслом, чтобы <w>испортить</w> нежелательные гнезда."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать яйцо бесплодным или непригодным для высиживания без повреждения скорлупы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать болтуном",
                                "target_lang_sense_clarification": "о яйце: лишать способности к развитию"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "яйцо, препятствуя вылуплению птенца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8238c11-346c-390a-80a3-99c370c661da",
                    "sense_definition": "To earn through physical or mental labor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>addle</w> a modest living through hard work in the fields.",
                            "target_lang_translations": {
                                "ru": "Ему удавалось <w>зарабатывать</w> на скромную жизнь тяжелым трудом на полях."
                            }
                        },
                        {
                            "text": "In the old northern village, laborers would <w>addle</w> just enough coins to buy bread.",
                            "target_lang_translations": {
                                "ru": "В старой северной деревне работники <w>добывали</w> ровно столько монет, сколько хватало на покупку хлеба."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зарабатывать физическим или умственным трудом (диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарабатывать",
                                "target_lang_sense_clarification": "тяжелым трудом"
                            },
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "средства к существованию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2edbe6f6-ae9c-3ebb-8d2a-134fe4806294",
                    "sense_definition": "To grow, thrive, or ripen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper sunlight and moisture, the saplings will <w>addle</w> no more.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего солнечного света и влаги саженцы больше не будут <w>разрастаться</w>."
                            }
                        },
                        {
                            "text": "The gardener pruned the dead branches so the orchard could <w>addle</w> again.",
                            "target_lang_translations": {
                                "ru": "Садовник обрезал сухие ветви, чтобы фруктовый сад мог снова <w>пышно расти</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти, пышно развиваться или созревать (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "о растениях: пышно цвести или расти"
                            },
                            {
                                "target_lang_word": "процветать",
                                "target_lang_sense_clarification": "о растительности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4c92a2e0-0fee-36f4-8ad4-d94f940ce42b",
                    "sense_definition": "Confused, muddled, or lacking clear understanding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of sleep left her in an <w>addle</w> state throughout the entire morning.",
                            "target_lang_translations": {
                                "ru": "Из-за недостатка сна она все утро пребывала в <w>затуманенном</w> состоянии."
                            }
                        },
                        {
                            "text": "He scratched his <w>addle</w> head while attempting to solve the tricky riddle.",
                            "target_lang_translations": {
                                "ru": "Он почесал свою <w>дурную</w> голову, пытаясь разгадать каверзную загадку."
                            }
                        }
                    ],
                    "synonyms": [
                        "addled"
                    ],
                    "common_phrases": [
                        "addle brains",
                        "addle head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбитый с толку, озадаченный, с затуманенной головой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затуманенный",
                                "target_lang_sense_clarification": "о разуме, мыслях"
                            },
                            {
                                "target_lang_word": "дурной",
                                "target_lang_sense_clarification": "о голове, спутанный"
                            },
                            {
                                "target_lang_word": "бестолковый",
                                "target_lang_sense_clarification": "растерянный, путающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d582566d-5ffa-3ab1-b927-87672a98ca7a",
                    "sense_definition": "Having become rotten, putrid, or incapable of hatching.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "egg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foul stench in the pantry came from a single <w>addle</w> egg.",
                            "target_lang_translations": {
                                "ru": "Ужасное зловоние в кладовой исходило от единственного <w>тухлого</w> яйца."
                            }
                        },
                        {
                            "text": "She carefully sorted the clutch to remove every <w>addle</w> egg before incubation.",
                            "target_lang_translations": {
                                "ru": "Она тщательно перебрала кладку, чтобы убрать каждое яйцо-<w>болтун</w> перед инкубацией."
                            }
                        }
                    ],
                    "synonyms": [
                        "addled"
                    ],
                    "common_phrases": [
                        "addle egg"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Протухший, гнилой или непригодный для высиживания (о яйце)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тухлый",
                                "target_lang_sense_clarification": "испорченный, гнилой"
                            },
                            {
                                "target_lang_word": "болтун",
                                "target_lang_sense_clarification": "в значении «яйцо-болтун», неоплодотворенное или погибшее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd1a2f3a-7e0b-37c3-84c8-280f18371a62",
                    "sense_definition": "A foolish or intellectually impaired individual.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was considered a hopeless <w>addle</w> by those who did not understand his humor.",
                            "target_lang_translations": {
                                "ru": "Те, кто не понимал его юмора, считали его безнадежным <w>дураком</w>."
                            }
                        },
                        {
                            "text": "Do not dismiss the quiet boy as an <w>addle</w> simply because he speaks slowly.",
                            "target_lang_translations": {
                                "ru": "Не списывайте тихого мальчика со счетов как <w>пустоголового</w> только потому, что он говорит медленно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, слабоумный или бестолковый человек (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупец"
                            },
                            {
                                "target_lang_word": "пустоголовый",
                                "target_lang_sense_clarification": "бестолковый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2b136e1-d3b1-3052-ba46-7563e965734b",
                    "sense_definition": "Liquid filth, muck, or mire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rainfall turned the farmyard road into a trench of thick <w>addle</w>.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь превратил дорогу на скотном дворе в траншею из густой <w>жижи</w>."
                            }
                        },
                        {
                            "text": "The carriage wheels sank deep into the foul smelling <w>addle</w> beside the ditch.",
                            "target_lang_translations": {
                                "ru": "Колеса кареты глубоко увязли в зловонной <w>грязи</w> около канавы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкая грязь, слякоть или помои (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жижа",
                                "target_lang_sense_clarification": "жидкая грязь"
                            },
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "слякоть, месиво"
                            },
                            {
                                "target_lang_word": "помои",
                                "target_lang_sense_clarification": "гнилостная зловонная жижа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}