                    {
                        "translation_id": "e8335453-798d-4e29-9a9c-05460a910f96",
                        "source_entry_id": "4038373b-d303-3a9f-9de8-139d91d2b901",
                        "source_sense_id": "120c1328-9402-3885-a929-548b14d78017",
                        "target_lang_word": "Promoter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Promoter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "155bb229-f8ed-3a9a-af8f-a5df1636ee61",
                                        "entry_id": "b716d255-8507-36d0-b88a-7f1ca9889be2",
                                        "glosses": [
                                            "jemand, der sportliche Wettkämpfe veranstaltet, organisiert"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b3d731-b432-465e-b164-875c22176aa6",
                                                "sense_id": "155bb229-f8ed-3a9a-af8f-a5df1636ee61",
                                                "text": "„‚[…] Er stand immer für das Beste, was Boxen zu bieten hat‘, sagte Promoter Bob Arum, der seit den 1980er Jahren mit ihm befreundet war.“"
                                            },
                                            {
                                                "example_id": "12d3eeb6-9bf1-4c86-a689-29bbdcb4f143",
                                                "sense_id": "155bb229-f8ed-3a9a-af8f-a5df1636ee61",
                                                "text": "„Promoter Klaus-Peter-Kohl verliert seine letzten beiden Attraktionen im Ring und den Fernsehvetrag mit dem ZDF. Seinem Unternehmen wird die wirtschaftliche Basis entzogen.“"
                                            },
                                            {
                                                "example_id": "e5a47c48-15f2-4e7d-97bd-c488cd6d4806",
                                                "sense_id": "155bb229-f8ed-3a9a-af8f-a5df1636ee61",
                                                "text": "„Jerry Perrenchio war der Promoter dieses Spiels, 1971 hatte er schon den großen Boxkampf zwischen Muhammad Ali und Joe Frazier vermarktet, er entdeckte auch Elton John.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49f5b79e-2f52-3eb1-9922-af968ce7bc35",
                                        "entry_id": "b716d255-8507-36d0-b88a-7f1ca9889be2",
                                        "glosses": [
                                            "jemand, der Veranstaltungen (wie etwa Tourneen oder Festivals) vorbereitet, organisiert"
                                        ],
                                        "tags": [
                                            "Unterhaltungsindustrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1140e9a8-9e1e-43e3-86a7-10d0e55d34c2",
                                                "sense_id": "49f5b79e-2f52-3eb1-9922-af968ce7bc35",
                                                "text": "„Wieder sind dafür in Zusammenarbeit mit amerikanischen Promotern in Nashville junge Musiker ausgewählt worden, die modernen Country spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "feab3623-40fe-3e50-87c9-d943844e8055",
                                        "entry_id": "b716d255-8507-36d0-b88a-7f1ca9889be2",
                                        "glosses": [
                                            "Geschäftsmann, der sich auf die Verkaufsförderung spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa25ade-cfb6-4d64-9c51-b134479a4097",
                                                "sense_id": "feab3623-40fe-3e50-87c9-d943844e8055",
                                                "text": "„Laut Arbeitsvertrag soll der Promoter für Nintendo eigentlich Kunden beraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
