                "senses": [
                    {
                        "sense_id": "f01f7711-13ee-37f5-b3d3-ba63883a55ba",
                        "entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "glosses": [
                            "The currency of Greece in ancient times and again from 1832 until 2001, with the symbol ₯, since replaced by the euro."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22de5ee-d6ca-4856-a93b-dd4a528471af",
                                "sense_id": "f01f7711-13ee-37f5-b3d3-ba63883a55ba",
                                "text": "'Who is he, and where does he come from?' said I, 'and what does he charge?' 'Evenus of Paros, Socrates,' said he, 'and his fee is 500 drachmae.' I felt that Evenus was to be congratulated if he really was a master of this art and taught it at such a moderate fee."
                            },
                            {
                                "example_id": "775debf0-32d2-4aee-9865-bc45be5af063",
                                "sense_id": "f01f7711-13ee-37f5-b3d3-ba63883a55ba",
                                "text": "2008, Philip Matyszak, Ancient Athens on Five Drachmas a Day (title of the book)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a65760a2-7cf7-39e4-af14-557dba172383",
                        "entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "glosses": [
                            "A coin worth one drachma."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c5e9e7f1-a657-3cb4-80bd-5a1d2ade6ef4",
                        "entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "glosses": [
                            "An Ancient Greek weight of about 66.5 grains, or 4.3 grams."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "75425712-1fc0-3cd2-85f8-193c790e6899",
                        "entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "glosses": [
                            "A later Greek weight equal to a gram."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b058c222-f842-4ede-93ad-edc317daa450",
                        "source_entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "source_sense_description": "currency",
                        "target_lang_word": "drachma",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drachma",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "aa4a5b62-542b-3f80-9267-8da6e0ac6c8c",
                                        "entry_id": "dfdad80d-8cd6-34cd-bd56-8a9a01c7606e",
                                        "glosses": [
                                            "bývalá měnová jednotka novověkého i starověkého Řecka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a2a43e-311e-492a-bdc6-1eba61854aa5",
                                                "sense_id": "aa4a5b62-542b-3f80-9267-8da6e0ac6c8c",
                                                "text": "Drachma korinthská stála k attické 5:3; na onu se počítalo 10, na tuto 6 obolů; byla rovna drachmě aiginetské, a tak i talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4acaf7ad-1e62-3c5b-af5f-fa0e9aad3302",
                                        "entry_id": "dfdad80d-8cd6-34cd-bd56-8a9a01c7606e",
                                        "glosses": [
                                            "starořecká váhová jednotka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f51ed3e-da48-4b37-884e-7f8cbc036434",
                                                "sense_id": "4acaf7ad-1e62-3c5b-af5f-fa0e9aad3302",
                                                "text": "Bych Virgilu řek’: „Drachmu krve stěží bys našel ve mně, jež se nezachvěla, tak staré lásky žár zas cítím svěží.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a2b712e-aba1-48b3-9737-e53e00ab4123",
                        "source_entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "source_sense_description": "currency",
                        "target_lang_word": "drachme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drachme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c293375-18dc-3850-8fd4-387b523da942",
                                        "entry_id": "7201c0a7-d04e-3e92-85ce-77dc39d41593",
                                        "glosses": [
                                            "Poids grec équivalant à 4 grammes 36 centigrammes."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eb1c396-cf10-391f-9b21-e01968504691",
                                        "entry_id": "7201c0a7-d04e-3e92-85ce-77dc39d41593",
                                        "glosses": [
                                            "Nom donné à plusieurs monnaies grecques et proche-orientales antiques."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fd533a4-0740-48d5-94d6-f487e6964d87",
                                                "sense_id": "4eb1c396-cf10-391f-9b21-e01968504691",
                                                "text": "L’obole de deux drachmes que les Juifs de la diaspora avaient à cœur d’envoyer chaque année à Jérusalem pour l’entretien du Temple, il a été décidé qu'ils la paieraient toujours mais qu’elle serait désormais affectée à l’entretien du Capitole, c'est-à-dire au culte des dieux païens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518d64ef-bd63-39b1-a08b-49e5fd32ddc1",
                                        "entry_id": "7201c0a7-d04e-3e92-85ce-77dc39d41593",
                                        "glosses": [
                                            "Monnaie grecque avant l’euro. Son symbole est ₯ (Unicode U+20AF)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8780752c-9eac-4337-91a9-97c980201e95",
                                                "sense_id": "518d64ef-bd63-39b1-a08b-49e5fd32ddc1",
                                                "text": "Fin février, et pour la première fois là aussi, un sondage montrait que 55 % des Grecs préféreraient une rupture des négociations avec les créanciers et un retour à la drachme, plutôt que de nouvelles mesures d’austérité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff49118-1c6a-3ecf-bddd-ce62281c2648",
                                        "entry_id": "7201c0a7-d04e-3e92-85ce-77dc39d41593",
                                        "glosses": [
                                            "Huitième partie de l’once, ou gros, dans les anciennes mesures de pharmacie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857a8b09-d261-4333-87b0-a9d00e1fc78f",
                        "source_entry_id": "1a95e940-43c2-36fe-9536-89cfc585e81c",
                        "source_sense_description": "currency",
                        "target_lang_word": "Drachme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drachme",
