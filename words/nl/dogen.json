        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b9ee397-6161-39fa-a883-93d14c5d7ea2",
                    "sense_definition": "iets oogluikend toelaten of verdragen wat eigenlijk niet mag; synoniem van <w>gedogen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente besloot de tijdelijke kraampjes op het plein te <w>dogen</w>.",
                            "target_lang_translations": {
                                "en": "The municipality decided to <w>tolerate</w> the temporary stalls on the square."
                            }
                        },
                        {
                            "text": "We kunnen dit soort gedrag in onze gemeenschap niet langer <w>dogen</w>.",
                            "target_lang_translations": {
                                "en": "We can no longer <w>condone</w> this kind of behavior in our community."
                            }
                        }
                    ],
                    "synonyms": [
                        "gedogen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vaak vervangen door gedogen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to tolerate, condone, or turn a blind eye to something that is officially not allowed; synonym of 'gedogen'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tolerate",
                                "target_lang_sense_clarification": "to allow something unauthorized"
                            },
                            {
                                "target_lang_word": "condone",
                                "target_lang_sense_clarification": "to tacitly approve or overlook"
                            },
                            {
                                "target_lang_word": "permit",
                                "target_lang_sense_clarification": "to allow or tolerate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4ebee9b-9c68-36ef-a5e5-4c49e17d8e5e",
                    "sense_definition": "moeilijke omstandigheden of pijn verdragen; doorstaan",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moesten veel leed <w>dogen</w> tijdens hun lange reis door de woestijn.",
                            "target_lang_translations": {
                                "en": "They had to <w>endure</w> much suffering during their long journey through the desert."
                            }
                        },
                        {
                            "text": "De arme boeren moesten de strenge winter zonder morren <w>dogen</w>.",
                            "target_lang_translations": {
                                "en": "The poor farmers had to <w>bear</w> the harsh winter without grumbling."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "in deze betekenis zeer verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to endure, bear, or suffer through difficult circumstances or pain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "endure",
                                "target_lang_sense_clarification": "to suffer patiently"
                            },
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to tolerate or put up with hardship"
                            },
                            {
                                "target_lang_word": "suffer",
                                "target_lang_sense_clarification": "to undergo pain or hardship"
                            }
                        ]
