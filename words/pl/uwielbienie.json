                                "target_lang_sense_clarification": "extreme devotion or reverence"
                            },
                            {
                                "target_lang_word": "idolization",
                                "target_lang_sense_clarification": "treating someone with excessive admiration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cae64fb0-964e-3eea-aa6a-0665d2b76c07",
                    "sense_definition": "czynność polegająca na otoczeniu kogoś lub czegoś czcią i miłością; rzeczownik odczasownikowy od <w>uwielbić</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uroczyste nabożeństwo miało na celu <w>uwielbienie</w> Boga za otrzymane łaski.",
                            "target_lang_translations": {
                                "en": "The solemn service was intended for the <w>praise</w> of God for the graces received."
                            }
                        },
                        {
                            "text": "Wierni zebrali się w świątyni na wspólne <w>uwielbienie</w> stwórcy poprzez śpiew.",
                            "target_lang_translations": {
                                "en": "The faithful gathered in the temple for communal <w>worship</w> of the creator through singing."
                            }
                        }
                    ],
                    "synonyms": [
                        "wielbienie"
                    ],
                    "common_phrases": [
                        "pieśń uwielbienia"
                    ],
                    "target_lang_definitions": {
