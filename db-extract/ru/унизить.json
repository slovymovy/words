                        "source_sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                        "target_lang_word": "let down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b328f27f-86ba-3059-a25e-a19845ac40d9",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see let, down."
                                        ],
