                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eeb8fb8-bb97-4a98-8cae-40f028bb65ec",
                                "sense_id": "a5845a45-a79c-3774-8449-898bc17900b5",
                                "text": "„Ein guter Ort, um das zu begreifen, war das Dach meines Hostels.“"
                            },
                            {
                                "example_id": "9ca5bad1-e133-419b-af3a-a22155392baa",
                                "sense_id": "a5845a45-a79c-3774-8449-898bc17900b5",
                                "text": "„Keine hundert Meter von ihrem Hostel entfernt lag Sungs Laden, wo sie morgens Kaffee tranken, denn dieser Laden machte früher auf als die Cafés.“"
                            },
                            {
                                "example_id": "d4cf1619-8a2e-4903-bd9c-cf03e8ca17ab",
                                "sense_id": "a5845a45-a79c-3774-8449-898bc17900b5",
                                "text": "„An jeder Ecke schießen neue Hostels wie Pilze aus dem Boden, in unserer Straße haben sich gleich mehrere Hostels eingenistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
