                        "examples": [
                            {
                                "example_id": "c78314cc-1a62-4f6e-a466-9aaa11d243e0",
                                "sense_id": "ff4a84a9-0a42-32c3-95fb-e94070939826",
                                "text": "A Djibouti, la callipygie est appréciée, si l’on en juge par la mise en valeur de cette particularité morphologique encore accentuée par le port de plusieurs jupons superposés, que l’on devine sous le voile drapant […]."
                            }
                        ]
                    },
