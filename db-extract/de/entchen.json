                "senses": [
                    {
                        "sense_id": "6e939406-21f7-39c4-a644-d8e2e3fab114",
                        "entry_id": "45777d2a-8dfd-3b4b-aaf7-3a87f863a1ea",
                        "glosses": [
                            "kleine Ente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b7cd78-5be8-48d6-83d5-08825a65c2f1",
                                "sense_id": "6e939406-21f7-39c4-a644-d8e2e3fab114",
