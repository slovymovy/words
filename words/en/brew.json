                        "ru": [
                            {
                                "target_lang_word": "плести",
                                "target_lang_sense_clarification": "заговоры или интриги"
                            },
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "коварный план или заговор"
                            },
                            {
                                "target_lang_word": "затевать",
                                "target_lang_sense_clarification": "недоброе дело"
                            }
