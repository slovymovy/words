                        "entry_id": "c4922b51-7349-3dbd-ade1-320b7b2582ab",
                        "glosses": [
                            "Consonne, plus couramment appelée occlusive."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "e83b7937-41bf-497c-967e-04bf07bc04d1",
                                "sense_id": "5e2aa445-2319-33b4-a8e1-ac23fd4b0597",
                                "text": "Les classes retenus et décrites plus bas sont plosive, nasale, vibrante, battue, fricative, fricative latérale, approximante et approximante latérale."
                            },
                            {
                                "example_id": "91a06000-5126-4694-9ff9-b186d4b39fc4",
                                "sense_id": "5e2aa445-2319-33b4-a8e1-ac23fd4b0597",
                                "text": "On désigne du terme de plosive (on disait autrefois explosive) un son non nasal produit par la fermeture complète et momentanée du chenal expiratoire résultant du contact entre deux articulateurs."
                            }
                        ]
                    }
