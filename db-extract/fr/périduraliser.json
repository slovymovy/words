                "senses": [
                    {
                        "sense_id": "36d6f613-f34f-3ed1-8e11-5f9ffc51874b",
                        "entry_id": "38ba8e6d-b350-30aa-967b-07300a4b1e6b",
                        "glosses": [
                            "Pratiquer une péridurale sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cded2ea-9032-4081-b1cb-beabf7c797a9",
                                "sense_id": "36d6f613-f34f-3ed1-8e11-5f9ffc51874b",
                                "text": "Pourquoi continuer à vouloir les périduraliser, les anesthésier pour ne plus qu'elles pensent, qu'elles prennent conscience de leur corps?"
                            },
                            {
                                "example_id": "60197d0d-a91c-4e8f-acec-08345dcb4468",
                                "sense_id": "36d6f613-f34f-3ed1-8e11-5f9ffc51874b",
                                "text": "Merci de ton témoignage Valine: neutre, direct \"de la source\"... si seulement il pouvait faire réflécchir un peu plus les mamans qui font aveuglément confiance à leur entourage médical que ça arrange bien de périduraliser pour mieux maitriser !"
                            },
                            {
                                "example_id": "29472b5b-f5c4-4fe8-99a6-c8f979109d06",
                                "sense_id": "36d6f613-f34f-3ed1-8e11-5f9ffc51874b",
                                "text": "Demandons des actes et ne nous ne laissons plus anesthésier, périduraliser par des promesses."
                            }
                        ]
                    }
