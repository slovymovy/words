                                    {
                                        "sense_id": "d375a6f3-486e-3672-91ab-c394de9dd2ed",
                                        "entry_id": "a29c3612-28b4-3b97-9975-fd794d056e45",
                                        "glosses": [
                                            "An immensely strong love or sexual attraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc790e3d-32ed-4817-9007-4fe0bc74af4a",
                                                "sense_id": "d375a6f3-486e-3672-91ab-c394de9dd2ed",
                                                "text": "As to the former, he is under a singular species of infatuation, to render himself thus subservient to the plans of Melliphant. Happily, however, we have effected our escape from them, and are on the road to our peaceful dwelling."
                                            }
                                        ]
                                    },
