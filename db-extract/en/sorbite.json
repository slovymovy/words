                        "examples": [
                            {
                                "example_id": "2e7912f7-5589-4b94-9713-0a9d4b821944",
                                "sense_id": "1cca270e-c101-39c2-905b-e4da6f2e82c0",
                                "text": "Sorbite is isomeric with mannite and dulcite, and forms with oxalic acid at 75° sorbite-formamide, with evolution of carbonic anhydride. It is a colourless odourless syrup."
                            }
                        ]
