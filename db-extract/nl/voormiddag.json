                "senses": [
                    {
                        "sense_id": "4773a5e8-6e1f-3fe9-945e-4c663c7f7ba5",
                        "entry_id": "a6f7df0d-ec6f-319d-a576-d3f5a196efcc",
                        "glosses": [
                            "late morning, part of the day before noon (before the 12th hour of the day)"
                        ],
                        "tags": [
                            "Belgium",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "1326adfe-4022-440e-8a03-c5010b4c2ed6",
                                "sense_id": "4773a5e8-6e1f-3fe9-945e-4c663c7f7ba5",
                                "text": "Ik heb een vergadering op dinsdag voormiddag.",
                                "translation": "I have a meeting on Tuesday late morning.",
                                "english": "I have a meeting on Tuesday late morning."
                            },
                            {
                                "example_id": "6c1d5906-35cf-442e-b5f5-f5440c3fc934",
                                "sense_id": "4773a5e8-6e1f-3fe9-945e-4c663c7f7ba5",
                                "text": "De winkels zijn open op zaterdag voormiddag.",
                                "translation": "The shops are open on Saturday late morning.",
                                "english": "The shops are open on Saturday late morning."
                            },
                            {
                                "example_id": "9d4a7e4b-e06c-41df-9bb5-50548e47d2a4",
                                "sense_id": "4773a5e8-6e1f-3fe9-945e-4c663c7f7ba5",
                                "text": "Het beste moment om te joggen is in de voormiddag.",
                                "translation": "The best time to jog is in the late morning.",
                                "english": "The best time to jog is in the late morning."
                            }
                        ]
                    },
                    {
                        "sense_id": "89ac190d-bd1c-301b-b19e-a0fe21289fba",
                        "entry_id": "a6f7df0d-ec6f-319d-a576-d3f5a196efcc",
                        "glosses": [
                            "midday, early afternoon (around the 12th to the 14th hour in the afternoon)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8c24f955-4849-4c60-830d-9a7df44d1ad8",
                                "sense_id": "89ac190d-bd1c-301b-b19e-a0fe21289fba",
                                "text": "We zullen lunchen rond voormiddag.",
                                "translation": "We will have lunch around midday.",
                                "english": "We will have lunch around midday."
                            },
                            {
                                "example_id": "ebb8d80d-236a-4269-ae29-a1dcc771b2f8",
                                "sense_id": "89ac190d-bd1c-301b-b19e-a0fe21289fba",
                                "text": "De zon is het sterkst rond voormiddag.",
                                "translation": "The sun is strongest around midday.",
                                "english": "The sun is strongest around midday."
                            },
                            {
                                "example_id": "350ea045-031a-4021-acf2-c8ee5d5889f1",
                                "sense_id": "89ac190d-bd1c-301b-b19e-a0fe21289fba",
                                "text": "Ik neem meestal een korte pauze rond voormiddag.",
                                "translation": "I usually take a short break around midday.",
                                "english": "I usually take a short break around midday."
                            }
                        ]
                    }
                ],
