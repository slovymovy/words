{
    "word_family": [
        "prostration"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ea4d297-2492-3a23-8699-a7f9b3e66be1",
                    "sense_definition": "Lying flat on the ground with the face downwards.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted runner lay <w>prostrate</w> on the grass after the race.",
                            "target_lang_translations": {
                                "ru": "Измученный бегун лежал <w>распростёртый</w> на траве после забега.",
                                "zh": "赛后，精疲力竭的跑步者<w>俯卧</w>在草地上。"
                            }
                        },
                        {
                            "text": "Worshippers fell <w>prostrate</w> on the floor during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Верующие падали <w>ниц</w> на пол во время церемонии.",
                                "zh": "仪式期间，信众们纷纷<w>拜倒</w>在地上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prone"
                    ],
                    "antonyms": [
                        "supine"
                    ],
                    "common_phrases": [
                        "lie prostrate",
                        "fall prostrate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лежащий плашмя на земле лицом вниз.",
                        "zh": "俯卧的，脸朝下平卧在地的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распростёртый",
                                "target_lang_sense_clarification": "лежащий на земле"
                            },
                            {
                                "target_lang_word": "лежащий ничком",
                                "target_lang_sense_clarification": "лицом вниз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "俯卧的",
                                "target_lang_sense_clarification": "脸朝下趴着"
                            },
                            {
                                "target_lang_word": "趴着的",
                                "target_lang_sense_clarification": "平躺于地"
                            },
                            {
                                "target_lang_word": "拜倒的",
                                "target_lang_sense_clarification": "伏地敬拜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47013da3-de40-3858-ad2f-ac75682232f8",
                    "sense_definition": "Physically weak or unable to stand due to illness, exhaustion, or extreme conditions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "incapacitated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers were <w>prostrate</w> from the intense desert heat.",
                            "target_lang_translations": {
                                "ru": "Туристы были <w>обессилены</w> сильной жарой в пустыне.",
                                "zh": "徒步旅行者因沙漠的酷热而变得<w>精疲力竭</w>。"
                            }
                        },
                        {
                            "text": "He remained <w>prostrate</w> in bed for days due to the fever.",
                            "target_lang_translations": {
                                "ru": "Он лежал <w>пластом</w> в постели несколько дней из-за лихорадки.",
                                "zh": "由于发烧，他好几天都<w>卧床不起</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически слабый или неспособный стоять из-за болезни или истощения.",
                        "zh": "因疾病、极度疲劳或恶劣环境而极其虚弱、精疲力竭卧床不起的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обессиленный",
                                "target_lang_sense_clarification": "лишённый сил"
                            },
                            {
                                "target_lang_word": "лежащий пластом",
                                "target_lang_sense_clarification": "идиома: неспособный встать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精疲力竭的",
                                "target_lang_sense_clarification": "极度疲惫"
                            },
                            {
                                "target_lang_word": "衰竭的",
                                "target_lang_sense_clarification": "体力耗尽"
                            },
                            {
                                "target_lang_word": "卧床不起的",
                                "target_lang_sense_clarification": "病重无力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f124ea72-dbc5-39a6-9423-c73b3131b738",
                    "sense_definition": "Overwhelmed by strong emotion, such as grief or shock.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "incapacitated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family was <w>prostrate</w> with grief after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "Семья была <w>раздавлена</w> горем после трагической аварии.",
                                "zh": "惨剧发生后，全家人都<w>悲痛欲绝</w>。"
                            }
                        },
                        {
                            "text": "She was <w>prostrate</w> with shock when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Она была <w>сражена</w> шоком, когда услышала новости.",
                                "zh": "听到这个消息时，她震惊得整个人都<w>垮了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prostrate with grief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охваченный сильными эмоциями, такими как горе или шок.",
                        "zh": "因极度悲痛、震惊等强烈情绪而垮掉的、不知所措的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражённый",
                                "target_lang_sense_clarification": "перен. о горе или новости"
                            },
                            {
                                "target_lang_word": "раздавленный",
                                "target_lang_sense_clarification": "перен. угнетённый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悲痛欲绝的",
                                "target_lang_sense_clarification": "常用于形容极度悲伤"
                            },
                            {
                                "target_lang_word": "被打垮的",
                                "target_lang_sense_clarification": "精神上承受不住打击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0cdab5e-10e0-343b-851b-17d431ab02d5",
                    "sense_definition": "Growing flat along the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>prostrate</w> shrub is excellent for covering rocky ground.",
                            "target_lang_translations": {
                                "ru": "Этот <w>стелющийся</w> кустарник отлично подходит для покрытия каменистой почвы.",
                                "zh": "这种<w>匍匐</w>灌木非常适合覆盖多石的地面。"
                            }
                        },
                        {
                            "text": "The plant has a <w>prostrate</w> habit and spreads quickly across the soil.",
                            "target_lang_translations": {
                                "ru": "Растение имеет <w>стелющуюся</w> форму и быстро разрастается по почве.",
                                "zh": "该植物具有<w>平卧</w>生长的习性，能在地面上迅速蔓延。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растущий горизонтально по поверхности земли.",
                        "zh": "（植物）匍匐的，沿地面平卧生长的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стелющийся",
                                "target_lang_sense_clarification": "ботаника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匍匐的",
                                "target_lang_sense_clarification": "植物贴地生长"
                            },
                            {
                                "target_lang_word": "平卧的",
                                "target_lang_sense_clarification": "植物学用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d861fe1c-7056-333f-a29f-38c5fdf211d1",
                    "sense_definition": "To throw oneself flat on the ground, usually as a sign of respect, submission, or worship.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subjects had to <w>prostrate</w> themselves before the king.",
                            "target_lang_translations": {
                                "ru": "Подданные должны были <w>падать ниц</w> перед королём.",
                                "zh": "臣民们必须在国王面前<w>俯伏</w>下拜。"
                            }
                        },
                        {
                            "text": "You should <w>prostrate</w> yourself to show humility in the temple.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>простереться</w>, чтобы проявить смирение в храме.",
                                "zh": "在寺庙中，你应该<w>跪拜</w>以示谦卑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prostrate oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросаться на землю плашмя, обычно в знак уважения или поклонения.",
                        "zh": "（尤指为表示尊敬、顺从或崇拜而）俯卧，拜倒，趴在地上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать ниц",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            },
                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "俯伏",
                                "target_lang_sense_clarification": "趴在地上"
                            },
                            {
                                "target_lang_word": "跪拜",
                                "target_lang_sense_clarification": "伏地敬拜"
                            },
                            {
                                "target_lang_word": "拜倒",
                                "target_lang_sense_clarification": "跪下俯首"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "992e6689-7e8b-38be-925f-cecea7d1f77f",
                    "sense_definition": "To make someone extremely weak, helpless, or exhausted.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "causative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe flu <w>prostrated</w> him for over a week.",
                            "target_lang_translations": {
                                "ru": "Тяжёлый грипп <w>свалил</w> его с ног на неделю.",
                                "zh": "严重的流感让他整整一个多星期都<w>卧床不起</w>。"
                            }
                        },
                        {
                            "text": "She was completely <w>prostrated</w> by the long journey.",
                            "target_lang_translations": {
                                "ru": "Она была совершенно <w>истощена</w> долгим путешествием.",
                                "zh": "漫长的旅途彻底让她<w>筋疲力尽</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-либо крайне слабым, беспомощным или истощённым.",
                        "zh": "使极度衰弱，使精疲力竭，使卧床不起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать сил",
                                "target_lang_sense_clarification": "истощать"
                            },
                            {
                                "target_lang_word": "валить с ног",
                                "target_lang_sense_clarification": "о болезни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使筋疲力尽",
                                "target_lang_sense_clarification": "耗尽体力"
                            },
                            {
                                "target_lang_word": "使卧床不起",
                                "target_lang_sense_clarification": "因病致虚弱"
                            },
                            {
                                "target_lang_word": "击垮",
                                "target_lang_sense_clarification": "使崩溃或病倒"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}