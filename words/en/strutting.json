            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "071816b9-d605-3044-be6f-e1945d4bbdc7",
                    "sense_definition": "An act or behavior of walking in an arrogant, conceited, or ostentatious manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strutting_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His arrogant <w>strutting</w> annoyed everyone at the meeting.",
                            "target_lang_translations": {
                                "ru": "Его высокомерное <w>позерство</w> раздражало всех на собрании."
                            }
                        },
                        {
                            "text": "The rivals engaged in stiff-legged <w>struttings</w> before the fight began.",
                            "target_lang_translations": {
                                "ru": "Перед началом схватки соперники <w>важно прохаживались</w> друг перед другом на прямых ногах."
                            }
