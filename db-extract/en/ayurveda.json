                                        "entry_id": "051c6bdc-e351-38d1-8e9b-1dcc218a92ff",
                                        "glosses": [
                                            "system medycyny indyjskiej rozwinięty w starożytności"
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c24342e-5843-49fe-9bd2-b096f4849a5c",
                                                "sense_id": "7ea02f7d-c07d-3002-8b7b-eefe66c5ceda",
                                                "text": "System ajurwedy jest przez medycynę konwencjonalną (zachodnią) uznawany za medycynę komplementarną lub pseudonaukę, w związku z łączeniem zjawisk empirycznych z koncepcjami metafizycznymi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cdac943-3e82-4baf-a211-64fe9e01c973",
                        "source_entry_id": "c129b942-76ef-3bc4-b85d-60188b014728",
                        "source_sense_description": "traditional Hindu alternative medicine",
                        "target_lang_word": "аюрве́да",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аюрве́да",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2301afff-14fc-34a6-af7a-28db7857b6a9",
                                        "entry_id": "ae5e74bd-30f3-3057-93aa-34e874725e7d",
                                        "glosses": [
                                            "истор., мед., филос. древнейшая система медицинских знаний, широко практикуемая в Индии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11eb3739-ce0a-4b55-968f-06559307932d",
                                                "sense_id": "2301afff-14fc-34a6-af7a-28db7857b6a9",
                                                "text": "Целью своей аюрведа ставит гармонию души, тела и окружающей действительности."
                                            },
                                            {
                                                "example_id": "215f8366-380f-4f5f-a622-e13ac87699fa",
                                                "sense_id": "2301afff-14fc-34a6-af7a-28db7857b6a9",
                                                "text": "Если простуда вконец одолела, сопровождается головной болью, насморком, воспалительными процессами в горле и повышенной температурой, аюрведа советует дважды в день съедать стручковый перец, закусывая его мёдом и запивая тёплым молоком."
                                            },
                                            {
                                                "example_id": "bf600c77-77e7-4efd-b05e-64c77f53582a",
                                                "sense_id": "2301afff-14fc-34a6-af7a-28db7857b6a9",
                                                "text": "Только оглянитесь вокруг, всюду найдутся поклонники китайской и индийской медицины, тибетских и кельтских врачебных практик, аюрведы и акупунктуры, хатхи-йоги и шиацу, гимнастики цигун и рэйки."
                                            },
                                            {
                                                "example_id": "61d2fd99-e840-40b0-bb02-c39040a9e9c3",
                                                "sense_id": "2301afff-14fc-34a6-af7a-28db7857b6a9",
                                                "text": "Кирилла Николаевна тихонько всхлипывала и размазывала двумя руками слёзы от уха до уха. Ни о каком индийском ресторане с его аюрведой, пряной курятиной и жареными сластями речи больше не шло."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
