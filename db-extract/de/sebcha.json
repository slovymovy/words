                "senses": [
                    {
                        "sense_id": "c1852cbe-6687-3e4f-8be5-1a4430939918",
                        "entry_id": "2861bdd0-917b-3502-837a-53bc959936ad",
                        "glosses": [
                            "Gebiet der Sahara, in dem durch kapillar aufsteigendes Grundwasser Ton-, Silt-, aber auch Sandsedimente zu Salzabscheidungen inkrustiniert sind; Salztonwüste und Salzsumpf in der Sahara"
                        ],
                        "tags": [
                            "geography",
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "7b444bc4-5c61-4bdc-b8e9-b3672c8ff93e",
                                "sense_id": "c1852cbe-6687-3e4f-8be5-1a4430939918",
                                "text": "„Es sind die Salztonebenen, die Sebchas der Sahara, die Bayire oder Schalas des Tarim-Beckens, die Takyre Turans, die Kewire Persiens, die Salare der nordargentinisch-chilenischen Hochanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
