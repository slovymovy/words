                {
                    "sense_id": "70950d14-28c0-3b06-853c-e5b61c8b274d",
                    "sense_definition": "A practice of communicating with one's God, or with some spiritual entity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found great comfort in silent <w>prayer</w> during the difficult times.",
                            "target_lang_translations": {
                                "ru": "Она находила большое утешение в тихой <w>молитве</w> в трудные времена.",
                                "zh": "在困难时期，她从静默的<w>祈祷</w>中获得了极大的慰藉。",
                                "nl": "Ze vond veel troost in stil <w>gebed</w> tijdens de moeilijke tijden.",
                                "pl": "W trudnych chwilach znajdowała wielkie ukojenie w cichej <w>modlitwie</w>.",
                                "de": "Sie fand in schwierigen Zeiten großen Trost im stillen <w>Gebet</w>.",
                                "fr": "Elle a trouvé un grand réconfort dans la <w>prière</w> silencieuse pendant les périodes difficiles.",
                                "it": "Ha trovato grande conforto nella <w>preghiera</w> silenziosa durante i momenti difficili.",
                                "cs": "V těžkých časech našla velkou útěchu v tiché <w>modlitbě</w>.",
                                "tr": "Zor zamanlarında sessiz <w>dua</w> etmekte büyük bir teselli buldu.",
                                "es": "Encontró un gran consuelo en la <w>oración</w> silenciosa durante los tiempos difíciles."
                            }
                        },
                        {
                            "text": "The community gathered in the hall for a moment of <w>prayer</w>.",
                            "target_lang_translations": {
                                "ru": "Община собралась в зале для краткой <w>молитвы</w>.",
                                "zh": "社区成员聚集在大厅里进行片刻的<w>祈祷</w>。",
                                "nl": "De gemeenschap kwam samen in de zaal voor een moment van <w>gebed</w>.",
                                "pl": "Społeczność zebrała się w sali na chwilę <w>modlitwy</w>.",
                                "de": "Die Gemeinschaft versammelte sich im Saal für einen Moment des <w>Gebets</w>.",
                                "fr": "La communauté s'est rassemblée dans la salle pour un moment de <w>prière</w>.",
                                "it": "La comunità si è riunita nella sala per un momento di <w>preghiera</w>.",
                                "cs": "Komunita se shromáždila v sále k chvíli <w>modlitby</w>.",
                                "tr": "Topluluk, bir anlık <w>dua</w> için salonda toplandı.",
                                "es": "La comunidad se reunió en el salón para un momento de <w>oración</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "orison",
                        "devotion",
                        "communion"
                    ],
                    "common_phrases": [
                        "in prayer",
                        "answer a prayer",
                        "power of prayer",
                        "call to prayer"
