    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a45be75-c594-3d95-83e1-404d6dce9b7e",
                    "sense_definition": "Conforming to a standard, regular pattern, or common type; not unusual or strange.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>normal</w> to feel nervous before a big exam.",
                            "target_lang_translations": {
                                "ru": "Это <w>нормально</w> — нервничать перед важным экзаменом.",
                                "tr": "Büyük bir sınavdan önce heyecanlı hissetmek <w>normaldir</w>."
                            }
                        },
                        {
                            "text": "The weather has been warmer than <w>normal</w> for this time of year.",
                            "target_lang_translations": {
                                "ru": "Погода была теплее <w>обычного</w> для этого времени года.",
                                "tr": "Hava yılın bu zamanı için <w>normalden</w> daha sıcak seyretti."
                            }
                        }
                    ],
                    "synonyms": [
                        "usual",
                        "standard",
                        "regular",
                        "typical",
                        "ordinary",
                        "common",
                        "conventional",
                        "average",
                        "expected",
                        "everyday",
                        "routine",
                        "customary"
                    ],
                    "antonyms": [
                        "unusual",
                        "strange",
                        "exceptional",
                        "unique",
                        "unconventional",
                        "nonstandard",
                        "special",
                        "remarkable"
                    ],
                    "common_phrases": [
                        "normal life",
                        "normal behavior",
                        "normal range",
                        "normal conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий стандарту, обычный или типичный; не странный.",
                        "tr": "Bir standarta, belirli bir düzene veya yaygın bir tipe uyan; olağan dışı veya garip olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "соответствующий норме"
                            },
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "привычный, повседневный"
                            },
                            {
                                "target_lang_word": "обыкновенный",
                                "target_lang_sense_clarification": "ничем не выделяющийся"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "normal",
                                "target_lang_sense_clarification": "alışılagelmiş, kurala uygun"
                            },
                            {
                                "target_lang_word": "olağan",
                                "target_lang_sense_clarification": "sık sık olan, doğal"
                            },
                            {
                                "target_lang_word": "sıradan",
                                "target_lang_sense_clarification": "her zamanki gibi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a197ca86-4025-316d-a9af-993ccd897390",
                    "sense_definition": "Physically and mentally healthy; not sick, ill, or in an altered state.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a few days of rest, she finally felt <w>normal</w> again.",
                            "target_lang_translations": {
                                "ru": "После нескольких дней отдыха она наконец снова почувствовала себя <w>нормально</w>.",
                                "tr": "Birkaç günlük dinlenmeden sonra nihayet tekrar <w>normal</w> hissetti."
                            }
                        },
                        {
                            "text": "The doctor said his heart rate is <w>normal</w> and he can go home.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что его пульс <w>нормальный</w>, и он может идти домой.",
                                "tr": "Doktor, kalp atış hızının <w>normal</w> olduğunu ve eve gidebileceğini söyledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "healthy",
                        "well",
                        "fine",
                        "fit"
                    ],
                    "antonyms": [
                        "sick",
                        "ill",
                        "unwell",
                        "poorly"
                    ],
                    "common_phrases": [
                        "feel normal",
                        "look normal",
                        "act normal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически и психически здоровый; не больной.",
                        "tr": "Bedensel ve zihinsel olarak sağlıklı; hasta veya bozulmuş bir durumda olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "здоровый, в хорошем состоянии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "normal",
                                "target_lang_sense_clarification": "sağlıklı, iyi durumda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa094be8-f709-39bd-bd91-7e0ccfb53d30",
                    "sense_definition": "Relating to or having a specific bell-shaped probability distribution (Gaussian distribution).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The test scores followed a <w>normal</w> distribution across the student population.",
                            "target_lang_translations": {
                                "ru": "Результаты тестов соответствовали <w>нормальному</w> распределению среди студентов.",
                                "tr": "Test puanları, öğrenci nüfusu genelinde <w>normal</w> bir dağılım izledi."
                            }
                        },
                        {
                            "text": "In statistics, many natural phenomena can be modeled using a <w>normal</w> curve.",
                            "target_lang_translations": {
                                "ru": "В статистике многие природные явления можно смоделировать с помощью <w>нормальной</w> кривой.",
                                "tr": "İstatistikte birçok doğal olgu <w>normal</w> bir eğri kullanılarak modellenebilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "Gaussian"
                    ],
                    "common_phrases": [
                        "normal distribution",
                        "normal curve"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (statistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к нормальному распределению (распределению Гаусса).",
                        "tr": "İstatistikle ilgili olan ve çan eğrisi şeklinde bir olasılık dağılımı (Gauss dağılımı) gösteren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "статистика"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "normal",
                                "target_lang_sense_clarification": "istatistiksel Gauss dağılımı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43267f76-6c3e-3036-aa24-3a2425a7d6d5",
                    "sense_definition": "Perpendicular to a tangent of a curve or a tangent plane of a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>normal</w> force acts perpendicular to the surface the object rests on.",
                            "target_lang_translations": {
                                "ru": "<w>Нормальная</w> сила действует перпендикулярно поверхности, на которой покоится объект.",
                                "tr": "<w>Normal</w> kuvvet, nesnenin üzerinde durduğu yüzeye dik olarak etki eder."
                            }
                        },
                        {
                            "text": "You need to calculate the <w>normal</w> vector to determine the orientation of the plane.",
                            "target_lang_translations": {
                                "ru": "Вам нужно вычислить <w>нормальный</w> вектор, чтобы определить ориентацию плоскости.",
                                "tr": "Düzlemin yönelimini belirlemek için <w>normal</w> vektörü hesaplamanız gerekir."
                            }
                        }
                    ],
                    "synonyms": [
                        "perpendicular",
                        "orthogonal"
                    ],
                    "antonyms": [
                        "tangential"
                    ],
                    "common_phrases": [
                        "normal vector",
                        "normal force"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (geometry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перпендикулярный касательной или касательной плоскости.",
                        "tr": "Bir eğrinin teğetine veya bir yüzeyin teğet düzlemine dik olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "геометрия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dik",
                                "target_lang_sense_clarification": "geometride teğete dik olan"
                            },
                            {
                                "target_lang_word": "normal",
                                "target_lang_sense_clarification": "dik kuvvet veya vektör"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74afbf53-2204-33cd-8693-eca6d0ab92e4",
                    "sense_definition": "Relating to a school created for the purpose of training teachers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother attended the state <w>normal</w> school to become a teacher.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка посещала государственную <w>нормальную</w> школу, чтобы стать учителем.",
                                "tr": "Babaannem öğretmen olmak için devlet <w>öğretmen okuluna</w> gitti."
                            }
                        },
                        {
                            "text": "Many modern universities began as <w>normal</w> colleges in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Многие современные университеты начинались как <w>нормальные</w> колледжи в девятнадцатом веке.",
                                "tr": "Birçok modern üniversite, on dokuzuncu yüzyılda <w>öğretmen okulu</w> olarak başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "normal school"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к учебному заведению для подготовки учителей (исторический термин).",
                        "tr": "Öğretmen yetiştirmek amacıyla kurulan okullarla ilgili (tarihsel terim)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "в названиях школ"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öğretmen okulu",
                                "target_lang_sense_clarification": "tarihi öğretmen yetiştiren kurumlar için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "795375a6-3064-3e65-ae2b-980ab756bf10",
                    "sense_definition": "The usual, average, or typical state or condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took weeks for life to return to <w>normal</w> after the flood.",
                            "target_lang_translations": {
                                "ru": "Потребовались недели, чтобы жизнь вернулась в <w>норму</w> после наводнения.",
                                "tr": "Selden sonra hayatın <w>normale</w> dönmesi haftalar aldı."
                            }
                        },
                        {
                            "text": "Working from home has become the new <w>normal</w> for many employees.",
                            "target_lang_translations": {
                                "ru": "Работа из дома стала новой <w>нормой</w> для многих сотрудников.",
                                "tr": "Evden çalışmak, birçok çalışan için yeni <w>normal</w> haline geldi."
                            }
                        }
