                ],
                "senses": [
                    {
                        "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                        "entry_id": "220b1be4-3473-36fa-b1e0-89e0f94b9337",
                        "glosses": [
                            "лицо, посылаемое религиозной организацией, церковью для пропаганды своих религиозных взглядов и обращения иноверных в свою веру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998329bf-a954-452e-9cb5-5073bd60b550",
                                "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                                "text": "Молодым скрытным семинаром он мечтал о многом — думал стать миссионером, городским священником."
                            },
                            {
                                "example_id": "8b63612b-e3a6-48c4-af86-772e689216fb",
                                "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                                "text": "Разговор шёл о русском христианском миссионерстве: собеседники сравнивали относительно малые успехи наших миссионеров с большим числом приобретений римской церкви и соболезновали об очевидных преимуществах, какие имеют последние."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9c928a8-e7f9-4886-aad8-ab24b8fc6e1a",
                        "source_entry_id": "220b1be4-3473-36fa-b1e0-89e0f94b9337",
                        "source_sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                        "target_lang_word": "missionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aad5277c-b5f7-3fce-9e22-c3a11778e13f",
                                        "entry_id": "492b0792-db94-33e1-9a9c-983bc4789db9",
                                        "glosses": [
                                            "One who is sent on a mission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec261027-2e2d-45c1-a46b-cd28fc82b2da",
                                                "sense_id": "aad5277c-b5f7-3fce-9e22-c3a11778e13f",
                                                "text": "Near-synonym: emissary"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be2947f-74d4-32e3-9e55-84ebc48c480b",
                                        "entry_id": "492b0792-db94-33e1-9a9c-983bc4789db9",
                                        "glosses": [
                                            "A person who travels attempting to spread a religion or creed (Particularly used in context of Christianity)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94402b7-5f66-4582-a7e9-e840180191d9",
                                                "sense_id": "3be2947f-74d4-32e3-9e55-84ebc48c480b",
                                                "text": "A missionary was just trying to convert me to his religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b521db19-a3bd-3242-8bc8-ab955cc6007c",
                                        "entry_id": "492b0792-db94-33e1-9a9c-983bc4789db9",
                                        "glosses": [
                                            "A religious messenger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "061e6a83-0e0f-33c6-91a5-09443a9b98fc",
                                        "entry_id": "492b0792-db94-33e1-9a9c-983bc4789db9",
                                        "glosses": [
                                            "The missionary position for sexual intercourse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911d0b89-48e9-4d29-b40f-8e57be2e0fa9",
                                                "sense_id": "061e6a83-0e0f-33c6-91a5-09443a9b98fc",
                                                "text": "My boyfriend only cums during missionary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "179285ae-3c23-3ee9-85b1-5aa58bd61503",
                                        "entry_id": "492b0792-db94-33e1-9a9c-983bc4789db9",
