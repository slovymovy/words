                "senses": [
                    {
                        "sense_id": "464d29e4-8794-3b8a-a5a3-5d5f2f3548f5",
                        "entry_id": "56783265-a37d-33ff-9a2c-dcd46e8fb2c7",
                        "glosses": [
                            "bekritiseren op een beledigende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a8908e-54dc-4b85-ab50-f030058c3d86",
                                "sense_id": "464d29e4-8794-3b8a-a5a3-5d5f2f3548f5",
                                "text": "De voormalige voorzitter van het Europees Parlement maakte verder duidelijk hoe hij tegenover Europa staat. \"Van mij hoef je geen Europa-bashen te verwachten.\""
                            },
                            {
                                "example_id": "18e606cc-6221-426e-8715-215ea8e0853d",
                                "sense_id": "464d29e4-8794-3b8a-a5a3-5d5f2f3548f5",
                                "text": "Dat bashen van de elite slaat helemaal nergens op, terwijl het ook heel goed te begrijpen is. Want de elite is schuw geworden."
                            },
                            {
                                "example_id": "5343ed52-feea-4c75-8db6-0b31fdcd03b1",
                                "sense_id": "464d29e4-8794-3b8a-a5a3-5d5f2f3548f5",
                                "text": "Wilders is woedend over deze uitspraken. \"Rutte laat zien niet de minister-president van alle Nederlanders te zijn. 1 miljoen PVV-kiezers laat hij keihard in de kou staan met zijn PVV-bashen.\""
                            },
                            {
                                "example_id": "379edfed-4c02-4910-ad3b-219158d7bd50",
                                "sense_id": "464d29e4-8794-3b8a-a5a3-5d5f2f3548f5",
                                "text": "De Japanners blijven vasthouden aan het zelfbeeld van het zielige Japan dat belaagd wordt door een boze buitenwereld. In het bijzonder de VS probeert Japan te „bashen\" en te beroven van zijn cultuur."
                            }
                        ]
                    }
