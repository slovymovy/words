{
    "word_family": [
        "waterpassen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4cfcfef-af8a-3101-8b9c-435680086235",
                    "sense_definition": "een instrument met een vloeistof en een luchtbel om te controleren of een oppervlak precies horizontaal is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meetinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman gebruikt een <w>waterpas</w> om te controleren of de vloer recht ligt.",
                            "target_lang_translations": {
                                "en": "The carpenter uses a <w>spirit level</w> to check if the floor is straight."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>waterpas</w> kun je deze plank niet recht ophangen.",
                            "target_lang_translations": {
                                "en": "Without a good <w>level</w>, you cannot hang this shelf straight."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een digitale waterpas"
                    ],
                    "target_lang_definitions": {
                        "en": "an instrument containing a liquid and an air bubble used to check if a surface is perfectly horizontal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spirit level",
                                "target_lang_sense_clarification": "the most common term for the tool with a bubble"
                            },
                            {
                                "target_lang_word": "level",
                                "target_lang_sense_clarification": "a general term for the measuring tool"
                            },
                            {
                                "target_lang_word": "bubble level",
                                "target_lang_sense_clarification": "specifically referring to the bubble mechanism"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c7889f22-7fe2-31a4-83d2-24059cb9d25b",
                    "sense_definition": "precies horizontaal uitgelijnd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horizontaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk dat de fundering van het huis volledig <w>waterpas</w> staat.",
                            "target_lang_translations": {
                                "en": "It is important that the foundation of the house is completely <w>level</w>."
                            }
                        },
                        {
                            "text": "Niets is erger dan een niet <w>waterpasse</w> vloer in de woonkamer.",
                            "target_lang_translations": {
                                "en": "Nothing is worse than a floor in the living room that isn't <w>level</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "horizontaal",
                        "vlak"
                    ],
                    "antonyms": [
                        "scheef"
                    ],
                    "common_phrases": [
                        "precies waterpas staan"
                    ],
                    "target_lang_definitions": {
                        "en": "perfectly aligned horizontally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "level",
                                "target_lang_sense_clarification": "perfectly horizontal"
                            },
                            {
                                "target_lang_word": "flush",
                                "target_lang_sense_clarification": "even or level with another surface"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "268543e3-ee6f-3174-8a48-51360eb0a3d0",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>waterpassen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>waterpas</w> de muur voordat ik begin met het metselen van de stenen.",
                            "target_lang_translations": {
                                "en": "I <w>level</w> the wall before I start laying the bricks."
                            }
                        },
                        {
                            "text": "Terwijl ik de vloer <w>waterpas</w>, kun jij de tegels alvast klaarleggen.",
                            "target_lang_translations": {
                                "en": "While I <w>check the level</w> of the floor, you can already lay out the tiles."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'waterpassen' (to level/check with a level)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "level",
                                "target_lang_sense_clarification": "to make or check if something is horizontal"
                            },
                            {
                                "target_lang_word": "check the level of",
                                "target_lang_sense_clarification": "using a tool to verify horizontal alignment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
