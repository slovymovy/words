{
    "word_family": [
        "adamantine"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                    "sense_definition": "Refusing to be persuaded or to change one's mind; firm and unyielding.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "firmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>adamant</w> that the project must be finished by Friday."
                        },
                        {
                            "text": "Despite the evidence, he remained <w>adamant</w> about his innocence."
                        }
                    ],
                    "synonyms": [
                        "inflexible",
                        "uncompromising",
                        "stubborn"
                    ],
                    "antonyms": [
                        "flexible",
                        "yielding"
                    ],
                    "common_phrases": [
                        "remain adamant",
                        "adamant about"
                    ]
                },
                {
                    "sense_id": "4a4a743f-f79d-3015-ab32-52e650d02315",
                    "sense_definition": "Extremely hard and impossible to break or pierce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient shield was made of an <w>adamant</w> material that resisted all blows."
                        },
                        {
                            "text": "Nothing could scratch the <w>adamant</w> surface of the mysterious artifact."
                        }
                    ],
                    "synonyms": [
                        "impenetrable",
                        "indestructible"
                    ],
                    "antonyms": [
                        "fragile",
                        "brittle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or historical contexts."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de95536b-8334-3908-9c46-f25001aa3787",
                    "sense_definition": "A legendary stone or mineral of extreme, impenetrable hardness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old myths, the hero's armor was forged from <w>adamant</w>."
                        },
                        {
                            "text": "The castle walls were said to be as strong as <w>adamant</w>."
                        }
                    ],
                    "synonyms": [
                        "diamond"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in mythology and literature."
                        }
                    ]
                },
                {
                    "sense_id": "e6092bf1-97a6-380b-bba4-1a551330cba2",
                    "sense_definition": "A symbolic representation of something that is completely unbreakable or unyielding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His resolve was an <w>adamant</w> that no pressure could crack."
                        },
                        {
                            "text": "She stood as an <w>adamant</w> against the tide of public opinion."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary contexts."
                        }
                    ]
                },
                {
                    "sense_id": "968f12ae-3c88-326d-a01f-ba0b085934f1",
                    "sense_definition": "A magnetic stone used to attract iron.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compass needle was pulled by the <w>adamant</w> hidden in the box."
                        },
                        {
                            "text": "He felt drawn to her like iron to an <w>adamant</w>."
                        }
                    ],
                    "synonyms": [
                        "lodestone",
                        "magnet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an old term for a lodestone."
                        }
                    ]
                },
                {
                    "sense_id": "18f37eca-06bb-3484-8622-5adfd1d16997",
                    "sense_definition": "A mythical substance believed to neutralize the power of a magnet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient texts claimed that <w>adamant</w> could stop a magnet from working."
                        },
                        {
                            "text": "The alchemist sought the <w>adamant</w> to break the magnetic bond."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to obsolete scientific beliefs."
                        }
                    ]
                }
            ]
        }
    ]
}