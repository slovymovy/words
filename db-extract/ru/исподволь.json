        "ru-extract.jsonl": [
            {
                "entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                "word": "исподволь",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c4a70a55-7e5d-38fb-bc59-0f2e05d34bc1",
                        "entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "glosses": [
                            "разг. понемногу, постепенно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773f059d-985d-4ea7-832b-89780dafc5ee",
                                "sense_id": "c4a70a55-7e5d-38fb-bc59-0f2e05d34bc1",
                                "text": "Анна терпеливо выносила все причуды тётки, исподволь занималась воспитанием сестры и, казалось, уже примирилась с мыслию увянуть в глуши…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e75bcd5b-1c7b-351a-a830-1a071540c8ae",
                        "entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "glosses": [
                            "незаметно для окружающих; украдкой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e94a46a2-5a34-4fb8-a9f3-e607b2168ef6",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "little by little",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little by little",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                        "entry_id": "e26f6f72-a2d5-3d57-8be2-0da540b66c9d",
                                        "glosses": [
                                            "A small amount at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf96de4-5e0e-4d44-84f8-218a580455b2",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "\"[…]Everything else has gone from me, little by little, but I have kept this.[…]\""
                                            },
                                            {
                                                "example_id": "e5efcccc-ac06-432b-a08f-fb8d2d846ea8",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Little by little his head cleared, and he began once more to take a personal interest in the battle."
                                            },
                                            {
                                                "example_id": "7b7dcc75-b754-4bad-97d0-4179f46a50b7",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Cos little by little / We gave you everything / You ever dreamed of. / Little by little / The wheels of your life / Have slowly fallen off."
                                            },
                                            {
                                                "example_id": "9d0f0796-1320-498e-b021-11c36c91b5c0",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Iraq's government has been removing blast walls little by little since late 2008, trying to restore a semblance of normalcy to this bunker city."
                                            },
                                            {
                                                "example_id": "d908bc45-7a7b-4565-b66f-9f296830913d",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "What came instead over the following years were many of the same projects delivered individually to little-by-little add capacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98bcdf1b-e21a-402f-808d-fbdc9c6cf8bb",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "gradually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gradually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "In a gradual manner; making slow progress; slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3386cf-1314-417c-98e4-c47b4e80980f",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The most likely conclusion, the researchers say, is that the Levallois method was not taken to Eurasia by African migrants, but evolved there gradually and independently."
                                            },
                                            {
                                                "example_id": "8e59594e-b4da-44f4-879f-a59203f643f4",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The instrument of this dumbing down in Nineteen Eighty-Four was Newspeak, the official language of the English Socialist Party (Ingsoc). Newspeak was a sort of Totalitarian Esperanto that sought gradually to diminish the range of what was thinkable by eliminating, contracting and manufacturing words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "by degrees"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291a7cab-11fc-4167-afc0-f69d0bf0d090",
                                                "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                                "text": "Horns, upon the due accession of Moisture, doth gradually become Soft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "816cf74c-299a-4cdd-ab8d-5aa23baae84c",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "by degrees",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by degrees",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2697f82f-c337-3775-80d4-a227d7cacf95",
                                        "entry_id": "2fc5f8dc-e789-373c-9b8b-18f4a8f555b3",
                                        "glosses": [
                                            "In gradual steps; bit by bit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d59a94-e426-4631-b997-abd1fc154cca",
                                                "sense_id": "2697f82f-c337-3775-80d4-a227d7cacf95",
                                                "text": "She came to us snappish and suspicious, but when she found what sort of place ours was, it all went off by degrees; […]"
                                            },
                                            {
                                                "example_id": "fe4a2fe3-4364-444e-9098-b2a92c8ee584",
                                                "sense_id": "2697f82f-c337-3775-80d4-a227d7cacf95",
                                                "text": "By degrees the libraries which were unendowed fell behind the age, and were consequently neglected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc49f92-be10-4697-a627-2599e94d9fdf",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "petit à petit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit à petit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                        "entry_id": "9dfb7417-5f54-3ec1-afbe-3257e8440318",
                                        "glosses": [
                                            "En avançant lentement par petites étapes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b5f6e0-4e1c-4f91-ab19-369fca2c84e6",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "Leurs familles très nombreuses leur permirent, petit à petit, d'augmenter leur nombre, de telle sorte, que […], ils forment aujourd'hui, 200 ans après leur séparation de la mère patrie, un bloc de six millions de Français groupés principalement dans la province de Québec. Étonnante résurrection d'une nation qui a gagné la guerre des berceaux […]."
                                            },
                                            {
                                                "example_id": "211f5276-6e97-4299-9405-a17bba613461",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "[…], et, petit à petit, sans bien sûr interrompre leur feu qui cependant faiblissait, les fascistes ont pris la poudre d’escampette, et les derniers assez vite pour que l’envie de courir après ne nous prît pas."
                                            },
                                            {
                                                "example_id": "fe65b370-1607-4cfe-9375-a6a29148a756",
                                                "sense_id": "811677ee-e33a-30e5-9784-07965ec1879c",
                                                "text": "La deuxième chaîne, inaugurée trois ans auparavant, ouvre le bal, elle est la première à abandonner le noir et blanc. Petit à petit, les Français vont s'équiper des téléviseurs ad hoc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95bdf9c6-4fbb-48a8-b2d7-69d2b89634c4",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "peu à peu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peu à peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c253a8c7-a1d4-3999-8d0e-70fd65cf9645",
                                        "entry_id": "e04e11f4-19bd-3e23-8be9-5e6dc97c2c70",
                                        "glosses": [
                                            "En avançant lentement, progressivement, par un progrès presque imperceptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d7b598-e304-42d6-b33d-47bf1e0149a6",
                                                "sense_id": "c253a8c7-a1d4-3999-8d0e-70fd65cf9645",
                                                "text": "Ces derniers avaient quasiment disparu, leurs pittoresques cabanes appelées « crampottes » se transformaient peu à peu en boutiques, et la principale activité du porte était la plaisance."
                                            },
                                            {
                                                "example_id": "ac4bd258-596d-45c0-9384-5e3c61c9cd2e",
                                                "sense_id": "c253a8c7-a1d4-3999-8d0e-70fd65cf9645",
                                                "text": "Parti des steppes mongoles, un courant humain déferlait en Sibérie, gagnait l’Alaska, envahissait peu à peu l’Amérique du Nord."
                                            },
                                            {
                                                "example_id": "908585ef-f80f-4f59-8ed7-6178475369bc",
                                                "sense_id": "c253a8c7-a1d4-3999-8d0e-70fd65cf9645",
                                                "text": "Arrive le dernier réchauffement, coïncidant avec le recul, la fonte des glaciers. Il a peu à peu conduit à un climat plus chaud et plus sec que le climat actuel : le climat xérothermique."
                                            },
                                            {
                                                "example_id": "5b72d488-d49e-424a-a00e-536ba9870651",
                                                "sense_id": "c253a8c7-a1d4-3999-8d0e-70fd65cf9645",
                                                "text": "Et les camarades bien divers d'agir en sourdine, de miner peu à peu les résolutions les plus vaillantes, prêcheurs d’oubli, de laisser-courre, d’exutoires !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "178fb5b8-d67f-4e94-a1ac-b0659657849a",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "progressivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progressivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c11aadf-7b20-3a93-921f-32aa5334e0dc",
                                        "entry_id": "c6ebd78f-be68-39f6-9507-409a9ea17374",
                                        "glosses": [
                                            "D’une manière progressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0342964d-1204-495d-b1d6-c0fce6c95acc",
                                                "sense_id": "0c11aadf-7b20-3a93-921f-32aa5334e0dc",
                                                "text": "Les citoyens dont les revenus n’excèdent point ce qui est nécessaire à leur subsistance doivent être dispensés de contribuer aux dépenses publiques ; les autres doivent le supporter progressivement, selon l'étendue de leur fortune."
                                            },
                                            {
                                                "example_id": "d18beb06-9faf-40e6-af56-1f093e0eade6",
                                                "sense_id": "0c11aadf-7b20-3a93-921f-32aa5334e0dc",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            },
                                            {
                                                "example_id": "45983936-68ce-4ebe-8698-c0a9ed0028c6",
                                                "sense_id": "0c11aadf-7b20-3a93-921f-32aa5334e0dc",
                                                "text": "On y trouve des appareils, tantôt mis en mouvement par le pied ou la main du blessé, tantôt mobilisant le membre supérieur ou le membre inférieur, mais progressivement, sans à-coup, sans secousse, massant les muscles, y provoquant une circulation plus active, désenraidissant les articulations, les gaines tendineuses, dissipant les œdèmes et, en définitive, rétablissant la fonction compromise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                        "entry_id": "c6ebd78f-be68-39f6-9507-409a9ea17374",
                                        "glosses": [
                                            "Avec le mouvement de progression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27722853-1aa4-4541-b731-8f6b94c7be9d",
                                                "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                                "text": "Les animaux qui ont la faculté de se mouvoir progressivement, comme de marcher, de voler, de nager,"
                                            },
                                            {
                                                "example_id": "0f0b4d2d-abcd-4dc6-9c43-0840f740311c",
                                                "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                                "text": "Les mâchoires seront serrées automatiquement et progressivement jusqu'à ce qu'elles s'approchent des tambours peigneurs."
                                            },
                                            {
                                                "example_id": "61d400d2-1abc-4fd8-a704-3383e26f6490",
                                                "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                                "text": "Les limites sont extrêmement vagues et le mélange de médioeuropéennes avec les atlantiques, qui existe dès les côtes de l'Océan, s’enrichit progressivement en médioeuropéennes."
                                            },
                                            {
                                                "example_id": "20da0f24-c6ef-49d7-be07-07f4531d684e",
                                                "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                                "text": "On conçoit aisément l’énormité de la tâche si l'on songe au nombre de populations qui ont pu depuis le Néogène être progressivement insularisées chorologiquement et surtout écologiquement autour de la Méditerranée."
                                            },
                                            {
                                                "example_id": "914aa79a-161f-459b-85c3-9206972122cf",
                                                "sense_id": "5937df2b-f993-3930-b551-4c417651a5c6",
                                                "text": "Pendant qu'elles discutent, le blond pisseux disparaît progressivement sous le produit que la coiffeuse étale sur la chevelure à l'aide d'un pinceau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d29a03c-52c3-47db-bbb8-196f0a8caf65",
                        "source_entry_id": "c6b695dd-2cc8-3766-bf31-a44f43ea7160",
                        "target_lang_word": "graduellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graduellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                        "entry_id": "411fd645-2e30-3b5a-8995-d580d203d3d5",
                                        "glosses": [
                                            "D’une manière graduelle, par gradation, étape par étape, petit à petit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d9afc2f-e6fe-429d-b905-251e42886a9b",
                                                "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                                "text": "[…], elle en frissonna violemment, et lui plus encore ; car tous deux étaient graduellement arrivés à une de ces inexplicables crises où le calme communique aux sens une perception si fine, […]."
                                            },
                                            {
                                                "example_id": "bfe72379-ee03-4815-a760-00deb56070ba",
                                                "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                                "text": "J'estimais qu'il fallait graduellement substituer à un système, qui paraissait calqué sur des institutions politiques périmées, un régime plus souple en accord avec les formules modernes de gouvernement."
                                            },
                                            {
                                                "example_id": "83635d41-893d-4017-8165-aa7dd3d7c8b3",
                                                "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                                "text": "[…] , on procède à l'incubation des œufs en les exposant à une température artificielle qui doit être élevée lentement et graduellement depuis 12° jusqu'à 25° ou 30°."
                                            },
                                            {
                                                "example_id": "90a27d89-1928-4c11-bc40-187f5b202f7a",
                                                "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                                "text": "Au cours de l'année 1915, le blé, après avoir été pendant les premiers mois à 11 fr. 50 et 12 fr. 50 le moud d'environ 21 kilos, baissait graduellement jusqu'à 8 fr. 10 et même 7 fr. 30 en juillet et en août."
                                            },
                                            {
                                                "example_id": "faab2996-9ceb-44ab-a26c-3e7822d56205",
                                                "sense_id": "1127edcc-699e-34a6-9acd-933a185182a8",
                                                "text": "Le vent est tombé graduellement pendant la journée du 22."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
