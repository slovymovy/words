                "senses": [
                    {
                        "sense_id": "f5829aff-7cc9-3e01-b2f8-5449b3e082e4",
                        "entry_id": "29abd4eb-bca9-3210-8cae-9a125e826e13",
                        "glosses": [
                            "Öffnen des Untergrundes durch Graben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c7c386-1289-40cd-92aa-475f5c986f71",
                                "sense_id": "f5829aff-7cc9-3e01-b2f8-5449b3e082e4",
                                "text": "„Zwischen Aufgrabung und Neuasphaltierung muss dabei ein längerer Zeitraum abgewartet werden, damit sich der verfüllte Untergrund setzen und stabilisieren kann.“"
                            },
                            {
                                "example_id": "b1477ad3-1fa5-40ce-9441-8101b40c82ba",
                                "sense_id": "f5829aff-7cc9-3e01-b2f8-5449b3e082e4",
                                "text": "„Bei der Aufgrabung habe man festgestellt, dass die Stadtmauer in dem Bereich früher vielleicht weiter außen stand und wegen des instabilen Hangs zurückgebaut wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a8cec5b-55e9-3484-a4cd-52d062f55a14",
                        "entry_id": "29abd4eb-bca9-3210-8cae-9a125e826e13",
                        "glosses": [
                            "zum Verlegen von Abflussrohren angelegter Graben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1de66ed-ae71-4b38-bf36-5674a0f3f1d0",
                                "sense_id": "6a8cec5b-55e9-3484-a4cd-52d062f55a14",
                                "text": "„Bei Aufgrabungen für Rohrlegungen sind alle zur Sicherheit des Verkehrs erforderlichen Maßregeln sorgfältig zu beachten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
