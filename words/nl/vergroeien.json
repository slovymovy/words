{
    "word_family": [
        "groei",
        "groeien",
        "vergroeidheid",
        "vergroeiing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84440e85-6ab8-3a0b-a4a6-a1770265a2d4",
                    "sense_definition": "Aan elkaar vastgroeien tijdens het groeiproces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee takken van de boom zijn na verloop van tijd helemaal met elkaar <w>vergroeid</w>.",
                            "target_lang_translations": {
                                "en": "Over time, the two branches of the tree have completely <w>grown together</w>."
                            }
                        },
                        {
                            "text": "De gebroken botten moeten eerst goed <w>vergroeien</w> voordat het gips eromweg mag.",
                            "target_lang_translations": {
                                "en": "The broken bones must first <w>fuse</w> properly before the cast can be removed."
                            }
                        }
                    ],
                    "synonyms": [
                        "samengroeien",
                        "aangroeien"
                    ],
                    "common_phrases": [
                        "met elkaar vergroeien",
                        "samen vergroeien"
                    ],
                    "target_lang_definitions": {
                        "en": "To grow together or fuse during the growth process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow together",
                                "target_lang_sense_clarification": "of plants, bones, or tissues fusing"
                            },
                            {
                                "target_lang_word": "fuse",
                                "target_lang_sense_clarification": "to join together organically"
                            },
                            {
                                "target_lang_word": "knit",
                                "target_lang_sense_clarification": "of healing bones joining together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827758a5-cb7c-32a9-bb65-5c643f0160e0",
                    "sense_definition": "Door een onnatuurlijk of gebrekkig groeiproces misvormd raken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door een slechte houding kan de ruggengraat op den duur helemaal <w>vergroeien</w>.",
                            "target_lang_translations": {
                                "en": "Due to poor posture, the spine can <w>become deformed</w> over time."
                            }
                        },
                        {
                            "text": "Haar voeten waren van het dragen van slecht schoeisel helemaal <w>vergroeid</w>.",
                            "target_lang_translations": {
                                "en": "Her feet had become completely <w>deformed</w> from wearing bad footwear."
                            }
                        }
                    ],
                    "synonyms": [
                        "misvormen",
                        "vervormen"
                    ],
                    "common_phrases": [
                        "helemaal vergroeien",
                        "scheef vergroeien"
                    ],
                    "target_lang_definitions": {
                        "en": "To become deformed through an unnatural or defective growth process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become deformed",
                                "target_lang_sense_clarification": "through unnatural growth or bad posture"
                            },
                            {
                                "target_lang_word": "grow crooked",
                                "target_lang_sense_clarification": "to grow out of shape"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}