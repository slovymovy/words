{
    "word_family": [
        "alleyway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4442e618-75fb-3034-980e-8147ba7a88b9",
                    "sense_definition": "A narrow street or passageway, especially one through the middle of a block giving access to the rear of buildings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "passageway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to escape through a dark <w>alley</w> behind the shops.",
                            "target_lang_translations": {
                                "ru": "Вор попытался скрыться через темный <w>переулок</w> позади магазинов.",
                                "tr": "Hırsız, dükkanların arkasındaki karanlık bir <w>dar sokaktan</w> kaçmaya çalıştı."
                            }
                        },
                        {
                            "text": "Garbage trucks usually collect trash from the back <w>alley</w>.",
                            "target_lang_translations": {
                                "ru": "Мусоровозы обычно забирают мусор из заднего <w>переулка</w>.",
                                "tr": "Çöp kamyonları genellikle çöpleri arka <w>geçitten</w> toplar."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleyway",
                        "lane",
                        "passage",
                        "laneway"
                    ],
                    "common_phrases": [
                        "blind alley",
                        "back alley",
                        "dark alley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая улица или проход, особенно между зданиями или позади них.",
                        "tr": "Binaların arasında veya arkasında kalan dar sokak veya geçit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переулок",
                                "target_lang_sense_clarification": "узкая улица"
                            },
                            {
                                "target_lang_word": "улочка",
                                "target_lang_sense_clarification": "маленькая улица"
                            },
                            {
                                "target_lang_word": "подворотня",
                                "target_lang_sense_clarification": "проход между домами"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dar sokak",
                                "target_lang_sense_clarification": "genel anlamda dar yol"
                            },
                            {
                                "target_lang_word": "geçit",
                                "target_lang_sense_clarification": "iki bina arasındaki dar geçiş yolu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0abe21cb-9b9c-31d1-9028-f5040ad9c2f5",
                    "sense_definition": "An establishment where bowling is played.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bowling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the <w>alley</w> on Friday night for a few games.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти в <w>боулинг</w> в пятницу вечером, чтобы сыграть несколько партий.",
                                "tr": "Cuma gecesi birkaç oyun oynamak için <w>bowling salonuna</w> gitmeye karar verdik."
                            }
                        },
                        {
                            "text": "The local bowling <w>alley</w> rents out shoes and sells snacks.",
                            "target_lang_translations": {
                                "ru": "Местный <w>боулинг-клуб</w> сдает в аренду обувь и продает закуски.",
                                "tr": "Yerel <w>bowling salonu</w> ayakkabı kiralıyor ve atıştırmalık satıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "bowling alley",
                        "lanes",
                        "bowling center"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заведение, где играют в боулинг.",
                        "tr": "Bowling oynanan yer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боулинг",
                                "target_lang_sense_clarification": "место для игры"
                            },
                            {
                                "target_lang_word": "кегельбан",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bowling salonu",
                                "target_lang_sense_clarification": "bowling oynanan tesis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b333268-7b73-33ea-8771-26601da47edb",
                    "sense_definition": "The extra area between the sidelines on a tennis court that is used for doubles matches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The serve landed wide in the <w>alley</w>, so the point was lost.",
                            "target_lang_translations": {
                                "ru": "Мяч при подаче ушел в <w>коридор</w>, поэтому очко было потеряно.",
                                "tr": "Servis <w>koridora</w> düştü, bu yüzden sayı kaybedildi."
                            }
                        },
                        {
                            "text": "In singles matches, any ball that lands in the <w>alley</w> is considered out.",
                            "target_lang_translations": {
                                "ru": "В одиночных матчах любой мяч, попавший в <w>коридор</w>, считается аутом.",
                                "tr": "Tekler maçlarında <w>koridora</w> düşen her top dışarıda kabul edilir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tennis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительная полоса по бокам теннисного корта, используемая в парных матчах.",
                        "tr": "Tenis kortunda çiftler maçında kullanılan yanlardaki ek alan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коридор",
                                "target_lang_sense_clarification": "в теннисе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "koridor",
                                "target_lang_sense_clarification": "tenis kortundaki yan alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb95ebb8-f303-3ae8-bc8a-663af2f7edf4",
                    "sense_definition": "The area between the outfielders in baseball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hit the ball deep into the <w>alley</w> for a double.",
                            "target_lang_translations": {
                                "ru": "Он отбил мяч глубоко в <w>коридор</w> и сделал дабл.",
                                "tr": "Topu <w>boşluğa</w> derin bir şekilde vurarak iki sayılık vuruş yaptı."
                            }
                        },
                        {
                            "text": "The center fielder ran into the <w>alley</w> to catch the fly ball.",
                            "target_lang_translations": {
                                "ru": "Центрфилдер побежал в <w>коридор</w>, чтобы поймать летящий мяч.",
                                "tr": "Orta saha oyuncusu havadan gelen topu yakalamak için <w>boşluğa</w> koştu."
                            }
                        }
                    ],
                    "synonyms": [
                        "gap"
                    ],
                    "common_phrases": [
                        "power alley"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "baseball"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство между игроками внешнего поля в бейсболе.",
                        "tr": "Beyzbolda dış saha oyuncuları arasındaki boşluk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коридор",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "между игроками"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boşluk",
                                "target_lang_sense_clarification": "oyuncular arasındaki alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14c4cd2a-c0b3-391e-b71a-903f2f194f54",
                    "sense_definition": "A walk or passage in a garden or park, bordered by rows of trees or bushes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "passageway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They strolled hand in hand down the shady <w>alley</w> of oak trees.",
                            "target_lang_translations": {
                                "ru": "Они прогуливались рука об руку по тенистой дубовой <w>аллее</w>.",
                                "tr": "Meşe ağaçlarıyla çevrili gölgeli <w>allede</w> el ele yürüdüler."
                            }
                        },
                        {
                            "text": "The estate features a beautiful green <w>alley</w> leading to the fountain.",
                            "target_lang_translations": {
                                "ru": "В поместье есть красивая зеленая <w>аллея</w>, ведущая к фонтану.",
                                "tr": "Malikanede çeşmeye giden güzel ve yeşil bir <w>alle</w> bulunuyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дорожка в саду или парке, обсаженная по обеим сторонам деревьями или кустарником.",
                        "tr": "Bahçe veya parkta iki yanı ağaçlarla çevrili yol."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аллея",
                                "target_lang_sense_clarification": "в парке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alle",
                                "target_lang_sense_clarification": "ağaçlı yol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb37043-a778-308d-800a-249e40903975",
                    "sense_definition": "A marble (small ball used in games), often a larger or more valuable one used as a shooter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He polished his lucky <w>alley</w> before starting the game.",
                            "target_lang_translations": {
                                "ru": "Он натер свой счастливый <w>шарик</w> перед началом игры.",
                                "tr": "Oyuna başlamadan önce şanslı <w>misketini</w> parlattı."
                            }
                        },
                        {
                            "text": "The boy kept his best <w>alley</w> in a separate pocket to keep it safe.",
                            "target_lang_translations": {
                                "ru": "Мальчик хранил свой лучший <w>шарик</w> в отдельном кармане для сохранности.",
                                "tr": "Çocuk, en iyi <w>misketini</w> güvende tutmak için ayrı bir cebinde sakladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "children's games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стеклянный или каменный шарик для игры.",
                        "tr": "Çocuk oyunlarında kullanılan misket."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шарик",
                                "target_lang_sense_clarification": "игрушка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "misket",
                                "target_lang_sense_clarification": "oyun topu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "082bf39d-95d5-3524-9efd-e0c0e6641768",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Alley</w> will be joining the meeting shortly.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Элли</w> скоро присоединится к собранию.",
                                "tr": "Bay <w>Alley</w> kısa süre içinde toplantıya katılacak."
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Alley</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Элли</w>.",
                                "tr": "Daha önce soyadı <w>Alley</w> olan kimseyle tanışmamıştım."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Элли",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Alley",
                                "target_lang_sense_clarification": "soyisim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "502c0754-6a3e-3ac9-ab9f-73400517c1e5",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My cousin <w>Alley</w> is coming to visit us this summer.",
                            "target_lang_translations": {
                                "ru": "Моя кузина <w>Элли</w> приедет навестить нас этим летом.",
                                "tr": "Kuzenim <w>Alley</w> bu yaz bizi ziyarete geliyor."
                            }
                        },
                        {
                            "text": "<w>Alley</w> wrote her name clearly at the top of the paper.",
                            "target_lang_translations": {
                                "ru": "<w>Элли</w> четко написала свое имя в верхней части листа.",
                                "tr": "<w>Alley</w> adını kağıdın en üstüne net bir şekilde yazdı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "tr": "Kadın ismi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Элли",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Alley",
                                "target_lang_sense_clarification": "isim"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}