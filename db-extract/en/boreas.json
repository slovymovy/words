                                    {
                                        "sense_id": "9da6f723-92f3-3cb0-b32c-0ab87b90edc2",
                                        "entry_id": "ff136e25-15df-321a-bd7c-f7c337b9ae2f",
                                        "glosses": [
                                            "Dieu personnifiant le vent du nord."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f799ce-4f01-4228-8dc4-f955e11bfb57",
                                                "sense_id": "9da6f723-92f3-3cb0-b32c-0ab87b90edc2",
                                                "text": "Ô muse de mon cœur, amante des palais,\nAuras-tu, quand Janvier lâchera ses Borées,\nDurant les noirs ennuis des neigeuses soirées,\nUn tison pour chauffer tes deux pieds violets ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
