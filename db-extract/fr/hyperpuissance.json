                "translations": [
                    {
                        "translation_id": "ab462362-c3ad-49f7-80cc-b8e9167613b1",
                        "source_entry_id": "df3e6db6-14d2-37db-8eb3-d88f63a1a1c3",
                        "source_sense_id": "af0658ca-0c21-3e16-900e-6ef7099187b3",
                        "source_sense_description": "Politik: Supermacht in hegemonialer Stellung; Hypermacht",
                        "target_lang_word": "Hypermacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8661a427-5af5-42d2-b1fa-1114cc1155a2",
                        "source_entry_id": "df3e6db6-14d2-37db-8eb3-d88f63a1a1c3",
                        "source_sense_id": "df58eca2-2b14-3d66-901a-756cd877e409",
                        "source_sense_description": "veraltet, Philosophie: Allmacht",
                        "target_lang_word": "Allmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                        "entry_id": "36b5841d-9b0b-359e-ae17-15040a0cc428",
                                        "glosses": [
                                            "unbegrenzte Macht; die Fähigkeit, alles zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b83c2ff-d4f0-4064-9fdb-101438164e6d",
                                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                                "text": "Kombiniert man die Allmacht und Allgüte Gottes vor dem Hintergrund der Schlechtigkeit in der Welt, so ergibt sich ein Rechtfertigungsproblem."
                                            },
                                            {
                                                "example_id": "b3d1aedc-d571-4eb0-8d18-f6e03cc0e32d",
                                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                                "text": "„Ein letztes Mal bäumen sich lokale Fürsten nun noch gegen Tafaris klar erkennbaren Weg zur Allmacht auf.“"
                                            },
                                            {
                                                "example_id": "5424e1e2-14be-45de-8cab-6617d46f34a3",
                                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                                "text": "„Denn da ist etwas, was er zu sagen hat, was er erlebt, gesehn, erforscht hat – etwas durchaus nicht Naives, sondern Furchtbares, wovon er weiß, daß es allem sentimentalen und idealen Geschwätz zum Trotz die tiefere, die echtere Wahrheit ist – die Allmacht der Geschlechtlichkeit, der Begierde, des Egoismus, der Lieblosigkeit unter Menschen, der Verderbtheit mit einem Wort, die die angebliche Welt Gottes in ein Mörder- und Lusthaus verwandelt.“"
                                            },
                                            {
                                                "example_id": "70b7343c-9be5-4467-a8e0-b504fb164a1e",
                                                "sense_id": "ab6fd184-64e1-30fc-9186-f73f1a996dd3",
                                                "text": "„Weißt du noch, Luzifer ist ein gefallener Engel, der Rebell, der sich mit der Allmacht des Himmels nicht abfinden wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
