                ],
                "senses": [
                    {
                        "sense_id": "dcefffb2-a99d-3403-94f7-f3a780063391",
                        "entry_id": "5ad6aeb6-bb60-354f-89cb-7a91d386f04e",
                        "glosses": [
                            "die Annahme, dass mentale Eigenschaften eines Lebewesens letztlich physische Eigenschaften oder auf solche rückführbar sind"
                        ],
                        "tags": [
                            "Philosophie des Geistes"
                        ],
                        "examples": [
                            {
                                "example_id": "3c05d304-e425-46dc-91aa-9f9da81c85c5",
                                "sense_id": "dcefffb2-a99d-3403-94f7-f3a780063391",
                                "text": "„Skeptisch bin ich allerdings, ob ein Eigenschaftsmonismus als Überwindungsstrategie des vielgeschmähten Dualismus überhaupt erstrebenswert ist.“"
                            },
                            {
                                "example_id": "e804e161-2c36-473d-b378-36c041c3b713",
                                "sense_id": "dcefffb2-a99d-3403-94f7-f3a780063391",
                                "text": "„Trotzdem erhält die Naturkausalität nicht das letzte Wort. Obwohl sich in der Kritik für die Welt von Natur und Erkenntnis ein doppelter Leib-Seele-Monismus, sowohl ein Substanz-, als auch ein primärer Eigenschaftsmonismus abzeichnet, vertritt Kant insgesamt einen Dualismus, nämlich den von Natur und Freiheit […] „"
                            },
                            {
                                "example_id": "792c16e7-e587-44cb-9afd-01f1f8d9bd67",
                                "sense_id": "dcefffb2-a99d-3403-94f7-f3a780063391",
                                "text": "„Dementsprechend ist der Vertreter des Eigenschaftsdualismus davon überzeugt, dass es zwei eigenständige Bereiche gibt, die unabhängig voneinander existieren können – das Mentale und der materielle Körper. Und dementsprechend ist der Vertreter des Eigenschaftsmonismus bzw. des Eigenschaftsphysikalismus davon überzeugt, dass es nur einen eigenständigen Bereich gibt – den Körper bzw. das Physische; und dass es deswegen keinen vom Körper unabhängigen Mentalen Bereich geben kann.“"
                            },
                            {
                                "example_id": "6226caa5-6aed-4f0f-9ec9-4b91a3b26789",
                                "sense_id": "dcefffb2-a99d-3403-94f7-f3a780063391",
                                "text": "Die Identitätstheorie nach Ullin Place und John Smart vertritt einen Substanz- und Eigenschaftsmonismus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
