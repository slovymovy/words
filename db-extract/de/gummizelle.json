                        "entry_id": "acb1e813-d70e-3365-8b97-2ceb13a09be2",
                        "glosses": [
                            "Cellule matelassée, cellule capitonnée, chambre dans un hôpital psychiatrique tapissée de matériaux mous, afin d’éviter des blessures aux patients."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ba771577-0e33-4c80-bad5-8826654c3008",
                                "sense_id": "758217ff-8a46-3052-b00d-b99595435e5f",
                                "text": "Falls du dich nicht beruhigst, sperren wir dich in eine Gummizelle ein!",
                                "translation": "Si tu ne te calmes pas, nous t’enfermons dans une cellule capitonnée !"
                            }
                        ]
                    }
                ],
