                ],
                "senses": [
                    {
                        "sense_id": "ad169cd2-25ff-3e9b-be49-8d6c7a426799",
                        "entry_id": "c532a10d-88ff-3d95-9b14-3f93022ad2ae",
                        "glosses": [
                            "Any of a number of small insectivorous passerine birds, of the genus Vireo, that have grey-green plumage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f2bac8-57e1-46e7-9bfb-b1bbd019de4b",
                                "sense_id": "ad169cd2-25ff-3e9b-be49-8d6c7a426799",
                                "text": "The voices of male vireos are a constant in the spring woodland, providing background music to the longer, prettier songs of tanagers and thrushes. Vireos tend to sing in bursts interrupted by short or long pauses."
                            },
                            {
                                "example_id": "dd1efca0-1d73-4d59-82b8-ce583553edb0",
                                "sense_id": "ad169cd2-25ff-3e9b-be49-8d6c7a426799",
                                "text": "Uniquely American, the vireos are a group of some 46 foliage-gleaning forest birds with uncertain family connections. Vireo species are about equally divided between North and South America, with one, the Black-whiskered Vireo, largely restricted to the West Indies. Several vireos make long migratory journeys; all are nocturnal migrants."
                            },
                            {
                                "example_id": "6ca58187-3c4d-4c3a-aa6f-dcba77defa39",
                                "sense_id": "ad169cd2-25ff-3e9b-be49-8d6c7a426799",
                                "text": "2012, Eloise Potter, Birds of the Carolinas, Easyread Large Edition, page 94,\nThis is our only vireo that has two white wing bars, yellow spectacles, and yellow sides."
                            }
                        ]
                    },
                    {
                        "sense_id": "42f4eb19-afe9-305c-806e-43638a4ef614",
                        "entry_id": "c532a10d-88ff-3d95-9b14-3f93022ad2ae",
                        "glosses": [
                            "Any bird of the family Vireonidae, which includes vireos, shrike-vireos, greenlets, and peppershrikes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b175b9-c073-4f09-a292-e71b373c194e",
                                "sense_id": "42f4eb19-afe9-305c-806e-43638a4ef614",
                                "text": "Family Vireonidae\nVireos\nThe vireos are slim grayish green birds that stay high up in the trees most of the time."
                            }
                        ]
                    }
                ],
