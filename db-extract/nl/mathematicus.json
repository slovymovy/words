                    {
                        "sense_id": "c7eedc34-3062-3e5f-aedf-64c7ec3b467a",
                        "entry_id": "b98c1bd7-4021-38ab-b0c2-090f4f5165df",
                        "glosses": [
                            "een wetenschapper die de wiskunde beoefent"
                        ],
