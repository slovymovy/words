                                "example_id": "f3a4238b-1520-47e8-9d10-004dcce8b267",
                                "sense_id": "54b16edd-ee3f-3b3d-9bcc-dae20171dfd7",
                                "text": "„Liegt ein Reitbetrieb in einem Ballungsraum beziehungsweise in der Nähe einer Großstadt, so besteht darin ein entscheidender Vorteil […].“"
                            },
                            {
                                "example_id": "8b3e9f69-9fa8-419e-84d6-d476aaf754da",
                                "sense_id": "54b16edd-ee3f-3b3d-9bcc-dae20171dfd7",
                                "text": "„Kurz betraten sie die kleine Reiterklause, von der aus man durch Sprossenfenster den Reitbetrieb in der Halle beobachten konnte.“"
                            }
                        ],
