                        "sense_id": "3d61552d-a97d-357b-9b72-9da404d76b93",
                        "entry_id": "10c40f5a-d75a-3231-91fc-f3021de93450",
                        "glosses": [
                            "S’abuser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02dc3834-bf1e-4560-aaab-7ec36a7d2205",
                                "sense_id": "3d61552d-a97d-357b-9b72-9da404d76b93",
                                "text": "Mais ils ne fonctionnent que si le terrain est favorable : on se laisse abuser parce qu'on passe son temps à s'auto-abuser."
                            },
                            {
                                "example_id": "aff7e095-5f4d-454b-9243-5722636db92b",
                                "sense_id": "3d61552d-a97d-357b-9b72-9da404d76b93",
                                "text": "Segel, je ne sais pas si l'on peut \"s'auto-abuser\"."
                            },
                            {
                                "example_id": "2b4e0ffb-7a3d-404b-8c42-be5f3890e651",
                                "sense_id": "3d61552d-a97d-357b-9b72-9da404d76b93",
                                "text": "Il convient de vous ouvrir à vous-mêmes, de ne pas vous auto-abuser et de réfléchir au sujet de vos objectifs dans la vie."
                            }
                        ]
                    }
