                        "tags": [],
                        "examples": [
                            {
                                "example_id": "918f364e-e006-4707-8fdc-00bd42f3fd6b",
                                "sense_id": "d12d342e-151c-391a-89b3-ad5b825299e3",
                                "text": "All over asia, one sees disease and bodily injury so untended, or what is worse, mistended, that the resultant condition is as dreadfu as it is intolerable.·"
                            },
                            {
                                "example_id": "1d9e6e81-1449-4166-8815-ae0779a79a69",
                                "sense_id": "d12d342e-151c-391a-89b3-ad5b825299e3",
                                "text": "In the R. G. Winslow the vessel was being loaded with grain from an elevator, the grain flowing into the ship by its own gravity through a pipe which was mistended on board the vessel by the mate, as a result of which mistending some of the grain was lost."
                            },
                            {
                                "example_id": "fe272f1c-fb32-4399-9bbc-b286d3f973dd",
                                "sense_id": "d12d342e-151c-391a-89b3-ad5b825299e3",
                                "text": "They freely employed the techniques of the carnival and the stage, with accomplices planted in the crowd, prearranged mistending of the fire to darken the scene at the crucial moment, and so on."
                            },
                            {
                                "example_id": "cbfdec40-8b9d-44e0-aab1-63006e44bf7a",
                                "sense_id": "d12d342e-151c-391a-89b3-ad5b825299e3",
                                "text": "The long view of the place as tended and mistended by generations of precursors allows him to inhabit it with awareness and care."
                            }
                        ]
                    }
