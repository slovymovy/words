                        "examples": [
                            {
                                "example_id": "74516cf3-7066-4241-bf43-45ab71e3dd3d",
                                "sense_id": "baca57d1-9b20-3caa-811f-e117e45f0408",
                                "text": "Dlatego specjaliści z choroszczańskiej spółki komunalnej kalkulują właśnie koszty zainstalowania agregatu podtrzymującego pracę przepompowni"
                            },
                            {
                                "example_id": "db6c11ce-0c70-4120-adbb-e016094aee9d",
                                "sense_id": "baca57d1-9b20-3caa-811f-e117e45f0408",
                                "text": "Prokuraturę o sprawie zawiadomił koncern medyczny, który w choroszczańskim szpitalu testował lek na schizofrenię"
                            }
                        ],
