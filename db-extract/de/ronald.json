                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740e514e-4987-4e8a-a7a5-b3b90d24e5a0",
                                                "sense_id": "9ab2f310-c57c-3083-be92-4d3e3631af96",
                                                "text": "Bridey says if she had a son which please God she will some day she'll call him Ronald because she's mad about Ronald Colman that you see in the Coliseum Cinema. Or Errol, now that's another lovely name, Errol Flynn. ---\nRonald, says Bridey, Ronald. He's gorgeous.\nNo, says Mam, it has to be Irish. Isn't that what we fought for all these years? What's the use of fighting the English for centuries if we're going to call our children Ronald?"
                                            }
                                        ]
                                    }
                                ]
