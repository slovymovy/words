                                "target_senses": [
                                    {
                                        "sense_id": "dfc3f6bd-dd7f-3090-8d17-77db26839409",
                                        "entry_id": "67b59fdc-1284-3443-b229-3414d2e9542f",
                                        "glosses": [
                                            "Einstellung und Umgangsform zwischen kollegial nett und freundschaftlich privat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce36497e-5b34-4202-8c98-fba40d5d07b5",
                                                "sense_id": "dfc3f6bd-dd7f-3090-8d17-77db26839409",
                                                "text": "„Zu den Charaktereigenschaften der Sufis gehören Freundschaftlichkeit, herzliche Verbundenheit, Harmonie mit den Brüdern und Absage an die Unverträglichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e4ef22c-8c8d-4f53-a547-0f2fb6dc1897",
                        "source_entry_id": "cde4a626-c121-3b4b-8b72-b22c967be6dc",
                        "source_sense_id": "f9759543-6ba4-323c-aef2-5ec51cb6615f",
                        "source_sense_description": "Freundschaftlichkeit",
                        "target_lang_word": "Abneigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abneigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                        "entry_id": "6bc95e84-9464-31ba-b609-95a693d2ee47",
                                        "glosses": [
                                            "leichter Widerwille gegen etwas oder eine Person, oft ohne das genau begründen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007e3645-b387-4017-8f48-a553e18fcbc3",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung der Polen gegen ihre Neureichen steht der der Westeuropäer in nichts nach.“"
                                            },
                                            {
                                                "example_id": "9e908d4a-da7f-44fc-92d3-6dc694654ec1",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "Ich hatte sofort eine Abneigung gegen den neuen Mitschüler, obwohl er mir angeboten hatte, mir bei den Hausaufgaben zu helfen."
                                            },
                                            {
                                                "example_id": "1e632a8c-d46a-4e41-93fd-f561aec769d6",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Daher waren Christenfeinde in der frühen Kaiserzeit weniger von Hass gegen die neue Lehre erfüllt; ihre Abneigung entsprang vielmehr ihrer affirmativen Haltung zum Imperium.“"
                                            },
                                            {
                                                "example_id": "ae6664e8-23bf-4e40-9bf1-6dfe833af7af",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung gegen alles Nützliche verdichtete sich von Tag zu Tag.“"
                                            },
                                            {
                                                "example_id": "2222c42d-22a3-4082-80dc-1e21e8fa2f1e",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Vom ersten Augenblick des Kennenlernens an faßte er gegen diesen glatten Hübschling Abneigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
