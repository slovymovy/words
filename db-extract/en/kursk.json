                                        "glosses": [
                                            "große Verwaltungseinheit (Oblast) innerhalb Russlands, deren Zentrum [1] darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e301d56e-aeda-4771-81e5-07a9b0c71924",
                                                "sense_id": "abe30167-dc8a-3ec6-8023-e5ce11e094aa",
                                                "text": "„Wegen ihrer Reportage aus der russischen Region Kursk geht Russland gegen eine Kriegsreporterin und einen Kriegsreporter aus Italien vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
