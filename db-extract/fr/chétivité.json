                        "entry_id": "22604685-a602-3648-a8f2-cac5f72310ab",
                        "glosses": [
                            "Caractère chétif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96465abd-108e-42f1-8ca7-73dcb48f9b8c",
                                "sense_id": "821a95e8-64d4-374c-86d2-1d4b1e0461ca",
                                "text": "Decosse, tailleur, agé de 26 ans, est d’une chétivité déplorable ; petit, imperceptible, rond, trappu ^([sic : trapu]), bossu, il semble près de rendre l’âme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7529a747-ab7d-4727-8944-192489b6949f",
                        "source_entry_id": "22604685-a602-3648-a8f2-cac5f72310ab",
                        "source_sense_id": "821a95e8-64d4-374c-86d2-1d4b1e0461ca",
                        "target_lang_word": "sickliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sickliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1493fcc9-7e39-3bcf-90c9-0f50ce4675f3",
                                        "entry_id": "701abac0-c5e6-39f2-9550-61abad3def04",
                                        "glosses": [
                                            "The state or characteristic of weakness, incapacity, or physical distress due to poor health, especially of a chronic nature."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b94f38-9702-4aba-be21-ed816dfcaba2",
                                                "sense_id": "1493fcc9-7e39-3bcf-90c9-0f50ce4675f3",
                                                "text": "I do beseech your majesty, impute his words\nTo wayward sickliness and age in him."
                                            },
                                            {
                                                "example_id": "ae7042a0-7b4b-4dee-885c-a1ae2027696a",
                                                "sense_id": "1493fcc9-7e39-3bcf-90c9-0f50ce4675f3",
                                                "text": "Gradually it gave place to a smile; a feeble, helpless, melancholy smile; bland, almost to sickliness."
                                            },
                                            {
                                                "example_id": "1ea64f16-b19b-41ef-a331-75ace0fca587",
                                                "sense_id": "1493fcc9-7e39-3bcf-90c9-0f50ce4675f3",
                                                "text": "My devotions were disturbed with a feeling of languor and sickliness, and the tormenting fear of its becoming worse: and a depressing headache was generally my companion throughout the day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
