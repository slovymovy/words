        "fr-extract.jsonl": [
            {
                "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                "word": "porche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cbcea28-03c2-41ee-abfa-64677b9771fb",
                        "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                        "tags": [
                            "plural"
                        ],
                        "form": "porches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                        "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                        "glosses": [
                            "Portique, lieu couvert à l’entrée d’un temple, d’une église, ou même d’un palais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff297353-d017-4672-afd2-2dff7848e8cd",
                                "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                                "text": "Un soir, sous le porche de Saint-Benoît-le-Bétourné, qui est garni de bancs de pierre, elle m’apprit ce que je ne savais pas encore et qu’elle savait depuis longtemps."
                            },
                            {
                                "example_id": "004d255d-29a3-4023-8952-c8dbfa2502fa",
                                "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                                "text": "Des porches cintrés s'exhale parfois une odeur enivrante; […], et l'on surprend souvent dans l'air, le puissant arôme des distillations qui s'opèrent."
                            }
                        ]
                    },
                    {
                        "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                        "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                        "glosses": [
                            "Construction abritant une porte d'entrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5989483e-2426-4bf9-9865-334d0c4e0190",
                                "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                                "text": "La voiture passa devant la grande porte de la cour de la ferme, continua son chemin le long d’une épaisse charmille et s’arrêta en face d’un petit porche de bois rustique à demi caché sous un vigoureux cep de vigne aux feuilles empourprées par l’automne."
                            },
                            {
                                "example_id": "10268da1-ba7b-4070-8f12-c5cc5b446bde",
                                "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                                "text": "Sous le porche, un boueux attendait l'arrivée de la voiture en songeant que, par un temps pareil, elle ne viendrait sans doute pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8510a28a-bc6f-452d-a019-170f90c82adc",
                        "source_entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                        "source_sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                        "source_sense_description": "Construction abritant une porte d'entrée",
                        "target_lang_word": "Vorhalle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhalle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                        "entry_id": "eca10cc0-8e8f-3d7a-b687-957a963edff1",
                                        "glosses": [
                                            "großer Raum, der in einem Anwesen zuerst betreten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8df24c4-5461-4390-883d-0210b4112f83",
                                                "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                                "text": "„Die Vorhalle mündete auf einen dunklen Gang, von dem eine steinerne Wendeltreppe nach oben führte.“"
                                            },
                                            {
                                                "example_id": "a22ba3aa-c3bc-4f1b-80c4-f03a3a86ccae",
                                                "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                                "text": "„Als wir die große Vorhalle betraten, roch es sehr merkwürdig und stark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "783dba5a-2d06-3c12-93dd-e3bf5518c4cb",
                                        "entry_id": "eca10cc0-8e8f-3d7a-b687-957a963edff1",
                                        "glosses": [
                                            "vorgelagerte Halle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab006d9-a0e1-4a86-80e8-7f0070763b6e",
                                                "sense_id": "783dba5a-2d06-3c12-93dd-e3bf5518c4cb",
                                                "text": "„Dort befand sich auf der Westseite eine dreiräumige Vorhalle, in der man die dort harrenden Leute mit Tee zu bewirten pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "510e24fa-bade-44a0-86e0-e82887eb06b7",
                        "source_entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                        "source_sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                        "source_sense_description": "Construction abritant une porte d'entrée",
                        "target_lang_word": "Veranda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veranda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                        "entry_id": "eae5b624-d9d3-3c40-90af-7fafa39679f9",
                                        "glosses": [
                                            "ein offener Hausan- oder Aufbau, auch mit Überdachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5511ce7-7619-4806-9a46-8d9f60e0fc7f",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Lass uns bei dem schönen Wetter raus auf die Veranda gehen."
                                            },
                                            {
                                                "example_id": "7198627a-7a1a-4865-96c4-70ca76fa86a4",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Um der Zugluft nicht ausgesetzt zu sein, wird die Veranda zwischen Gebäudeflügeln eingerückt oder an den Schmalseiten durch Holz- oder Glaswände geschlossen.\""
                                            },
                                            {
                                                "example_id": "76e735cb-4a21-404f-ad67-c92661ea078b",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Jack saß auf der Veranda und schrieb einen Brief an seine Frau.“"
                                            },
                                            {
                                                "example_id": "aa4e343b-931c-4dee-ab15-8ccdb2bbe512",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Als ich nach dem Mittagessen allein auf der Veranda saß und rauchte, kam der Offizier auch heraus und direkt auf mich zu.“"
                                            },
                                            {
                                                "example_id": "dac699f3-d3c1-4b78-8340-1c2f3960d157",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Die Veranda war leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e84a755-1a34-4fd3-b213-92402fa234e4",
                        "source_entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
