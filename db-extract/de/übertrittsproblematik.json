                "senses": [
                    {
                        "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                        "entry_id": "aa351a9d-ef2e-387b-a454-b1336c9d0cc9",
                        "glosses": [
                            "mit dem Wechsel der Schulform verbundene Schwierigkeit"
                        ],
                        "tags": [
                            "Ausbildung",
                            "Schule"
                        ],
                        "examples": [
                            {
                                "example_id": "4288fafd-c750-4f24-ad3f-de2dddb69915",
                                "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                                "text": "„Die Übertrittsproblematik sei nicht neu, sagt sie, habe sich aber verschärft.“"
                            },
                            {
                                "example_id": "f84c15bc-882b-4e76-b4a7-a50e1145350f",
                                "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                                "text": "„Ziel der Befragung war es, das individuelle Erleben und Wahrnehmen durch Förderung der Auseinandersetzung mit der Übertrittsproblematik festzuhalten.“"
                            },
                            {
                                "example_id": "5fd7e317-8202-4c46-8376-7a5f1ecfd2e1",
                                "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                                "text": "„Für die Eltern und Schüler bzw. Schülerinnen bedeutet dieser Prozess eine wesentliche Entschärfung der Übertrittsproblematik von der Volksschule in die Sekundarstufe 1, der gleichzeitig einen wesentlich emotionalen Druck auf mehreren Seiten nimmt.“"
                            },
                            {
                                "example_id": "884b5022-475f-4504-8bef-f24d4c57c48f",
                                "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                                "text": "„Nicht ausgeklammert in der Diskussion zwischen der Schulleitung, den sechs Bürgermeistern des Schulverbandes, Kultusminister Spaenle und Manfred Ländner war auch die Tatsache der zurückgehenden Schülerzahlen, der Übertrittsproblematik in Baden-Württemberg.“"
                            },
                            {
                                "example_id": "76c28eaa-cf31-4ac0-967c-c69ee32c9819",
                                "sense_id": "6a77908a-e796-3283-a7ee-dd0bb444bc06",
                                "text": "„Ihnen ist es gelungen, diese Übertrittsproblematik nach Klasse 4 dadurch zu umgehen, dass sie eben andere pädagogische Einheiten hatten, nämlich 1 bis 3, 4 bis 6 und dann 7/8.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
