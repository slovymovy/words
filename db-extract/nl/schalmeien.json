                "senses": [
                    {
                        "sense_id": "2b1c6e74-9ee8-3479-a26e-8032b5c46adc",
                        "entry_id": "3e640585-49e4-3310-8256-902b2400649a",
                        "glosses": [
                            "een schalmei bespelen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "56f00484-dc05-4cfe-9323-1823eb45a2c3",
                                "sense_id": "2b1c6e74-9ee8-3479-a26e-8032b5c46adc",
                                "text": "⧖ Want nu wist Tistje, opeens, met één woord, dat de Paus die blije uren niet vergeten was, van over zóóvele jaren, toen ze saamzaten, de Paus nog een kind, tegen den heuvel, en schalmeiende saam, schalmeiende of 't plezier niet meer op kon!..."
                            }
                        ]
                    },
                    {
                        "sense_id": "3781d821-3f10-348e-bca7-9ff2051f0ac9",
                        "entry_id": "3e640585-49e4-3310-8256-902b2400649a",
                        "glosses": [
                            "hard blazen of luid klinken"
                        ],
                        "tags": [
                            "figuratively",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "1cdf52e2-1cc7-4140-8d33-a925d0f63e84",
                                "sense_id": "3781d821-3f10-348e-bca7-9ff2051f0ac9",
                                "text": "Hoor het jonge bloed schalmeien,\nnu de bekers ledig zijn:\nzoeter min brengt zoeter pijn!"
                            },
                            {
                                "example_id": "1f671c48-fb00-4396-ae84-7326f7a36d67",
                                "sense_id": "3781d821-3f10-348e-bca7-9ff2051f0ac9",
                                "text": "Nu zagen zij hem lachen, juichen en stralen: zij hoorden zijne kreten schalmeien!"
                            }
                        ]
                    }
                ],
