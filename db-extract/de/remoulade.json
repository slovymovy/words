                "senses": [
                    {
                        "sense_id": "6af5066e-d504-3ab3-b646-1d45410fd676",
                        "entry_id": "e0919d3a-9a93-351a-97e3-07346b74365c",
                        "glosses": [
                            "eine mit Kräutern gewürzte Mayonnaise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95bc0213-41c0-49bc-bd1f-bdd677e5a626",
                                "sense_id": "6af5066e-d504-3ab3-b646-1d45410fd676",
                                "text": "Remoulade gehört zu jedem Roastbeef."
                            },
                            {
                                "example_id": "3a363c94-c407-417a-bf9a-700e5d0501df",
                                "sense_id": "6af5066e-d504-3ab3-b646-1d45410fd676",
                                "text": "„Seine Uhrkette aus Haaren und die Art, wie er die Remoularde rührte, offenbarte den erfahrenen Lebemann, und er aß, den Zipfel seiner Serviette unter die Achsel geklemmt, und ließ dabei allerhand Witze vom Stapel, die Pécuchet zum Lachen brachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
