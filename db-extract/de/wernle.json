                ],
                "senses": [
                    {
                        "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                        "entry_id": "416efc10-7b9e-39a7-909f-cb0b705321de",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b14dbc-16e7-4885-a7fb-79118113f3bd",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Frau Wernle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "790c1f74-4960-4de1-b853-7af67d4d6309",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Herr Wernle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4274ebad-d93d-4403-b4df-ecbb3ddce552",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Die Wernles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "031029c7-b131-4376-baab-ee28be9c7d30",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Der Wernle trägt nie die Pullover, die die Wernle ihm strickt."
                            },
                            {
                                "example_id": "2a71484f-9a27-4926-9668-d01021ae68a0",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wernle kommt, geht der Herr Wernle.“"
                            },
                            {
                                "example_id": "2be1ad66-3847-4f9e-ab03-275e6987907b",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Wernle kommt und geht."
                            },
                            {
                                "example_id": "ff532be9-ea2a-4f4f-9fda-8fa30bbb43db",
                                "sense_id": "c12d56ad-4a35-355d-80ae-389fb006c2d4",
                                "text": "Wernles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
