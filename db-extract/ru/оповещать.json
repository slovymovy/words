                        ]
                    },
                    {
                        "translation_id": "a7ec590e-db1e-46e4-8ddd-50d2ccdf9523",
                        "source_entry_id": "92dc33f7-c123-3163-bb37-ec3914f6fe5e",
                        "source_sense_id": "e5c6b4cb-68fd-378a-9e78-e8467cfcb39b",
                        "target_lang_word": "announce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                        "entry_id": "31811f87-61a2-3101-8a62-e5e6adbe7493",
                                        "glosses": [
                                            "To give public notice of, especially for the first time; to make known."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb5d1f6-0cde-49f4-9dc5-9ac6e9eca757",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "Her [Queen Elizabeth’s] arrival was announced through the country by a peal of cannon from the ramparts."
                                            },
                                            {
                                                "example_id": "375c1a33-ff98-4530-96a7-1f594f961b91",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "Soon after the arrival of Mrs. Campbell, dinner was announced by Abboye. He came into the drawing room resplendent in his gold-and-white turban. […] His cummerbund matched the turban in gold lines."
                                            },
                                            {
                                                "example_id": "6e601948-3dc7-4117-9618-db0323ef2016",
                                                "sense_id": "2f59fdab-ae57-3a9c-803c-b1ed37dba0fe",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
