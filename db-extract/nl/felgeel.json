                ],
                "senses": [
                    {
                        "sense_id": "17e5cade-6c0b-3073-b3c7-f2db05aa75af",
                        "entry_id": "79e50790-ec2d-3ce6-af64-13d528090e85",
                        "glosses": [
                            "helder, fluoriserend geel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99cb7f8-6582-49d1-8b64-f1bc56a7e2d8",
                                "sense_id": "17e5cade-6c0b-3073-b3c7-f2db05aa75af",
                                "text": "Blogger Anna Nooshin voelt zich thuis in Noorwegen, waar ze zich liet vastleggen in verschillende creaties. Een felgeel jasje van een berg nepbont geeft ze de passende bijnaam Pino."
                            },
                            {
                                "example_id": "5c51c388-84a5-42f8-a5c7-7c20fedba7e4",
                                "sense_id": "17e5cade-6c0b-3073-b3c7-f2db05aa75af",
                                "text": "Máxima kreeg een draaiend bedrijf te zien, zegt eigenaar en directeur Toine Brock. \"Tijdens het bezoek werken we gewoon door.\" Dat betekende dat de koningin een felgeel veiligheidshesje aan moest tijdens de rondleiding."
                            },
                            {
                                "example_id": "8049b140-b93e-49ba-9d69-b19b1dc6e29b",
                                "sense_id": "17e5cade-6c0b-3073-b3c7-f2db05aa75af",
                                "text": "Acht vrijwel nieuwe rensters vormen dit jaar het vrouwenteam, dat aan het derde jaar in het peloton begint. Het traditionele felgeel/groene wielertricot is vervangen door een iets minder fluoriserend tenue, de hoofdsponsors staan garant voor een driejarige ondersteuning. \"De basis is goed om mee verder te werken.\""
                            }
                        ]
                    }
