                "translations": [
                    {
                        "translation_id": "94b9a933-1040-4166-96c2-7eaf627a5633",
                        "source_entry_id": "a11c280f-5eaf-3845-bc55-569bb057d012",
                        "source_sense_id": "24fff9c2-ac21-3f74-b509-0567b76650f4",
                        "target_lang_word": "explicitness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicitness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "681e9e9e-2d21-3fc9-a6bf-e053cf82195f",
                                        "entry_id": "22123a36-b5d4-343f-a70e-1fc496754c3d",
                                        "glosses": [
                                            "The state or characteristic of being explicit."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66b6ced-9d95-4f34-a140-82f69aa440c3",
                                                "sense_id": "681e9e9e-2d21-3fc9-a6bf-e053cf82195f",
                                                "text": "Despite their careless scholarship and a less tangible quality that some would call a tin ear for poetry, Morris Halle and S. J. Keyser, as metrists, have the considerable virtue of explicitness."
                                            },
                                            {
                                                "example_id": "58c4b046-5ee0-456c-be3a-f7c11b3a8996",
                                                "sense_id": "681e9e9e-2d21-3fc9-a6bf-e053cf82195f",
                                                "text": "It furthermore confirms, as James A. Davies has shown, that when drawn to contemporaries, Forster did not preimpose ideas upon his material as he did with those of the past, but presented 'honest revelation' bordering on explicitness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e86ba6b4-3bcd-40d1-ae34-c67b8b33b4f0",
                        "source_entry_id": "a11c280f-5eaf-3845-bc55-569bb057d012",
                        "source_sense_id": "24fff9c2-ac21-3f74-b509-0567b76650f4",
                        "target_lang_word": "Nachdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                        "entry_id": "88693a53-8801-30c0-9c13-ef4468bdebc5",
                                        "glosses": [
                                            "eine begeisterte, die eigene innere Bewegung und Zustimmung widerspiegelnde Ausdrucksweise"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e75134-e1b2-4d82-b029-ae92069ed027",
                                                "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                                "text": "„Die Gewerkschaft Vereinigung Cockpit (VC) hat ihre Piloten zu dem Streik aufgerufen, um ihrer Forderung im laufenden Tarifkonflikt Nachdruck zu verleihen.“"
                                            },
                                            {
                                                "example_id": "5d62ea67-98ac-48bf-95eb-0fb249ee86a3",
                                                "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                                "text": "„Vor einem so wichtigen Treffen ist es üblich, dass die Länder ihre Standpunkte mit Nachdruck deutlich machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                        "entry_id": "88693a53-8801-30c0-9c13-ef4468bdebc5",
                                        "glosses": [
                                            "unveränderter Abdruck eines schon einmal veröffentlichten Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d44eab8-20c9-4a1e-b6b1-39e2fcf89939",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Rund 160 Geburtstagsgäste gratulierten Prill, der von seinen Mitarbeitern den Nachdruck einer Gutenberg-Bibel geschenkt bekam.“"
                                            },
                                            {
                                                "example_id": "ee92245f-315e-47ce-a560-6487321504d2",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Noch bedenklicher aber war die Tatsache, daß sehr früh willkürliche Nachdrucke und vor allem Bearbeitungen mit teilweise eigenmächtigen Änderungen oder Auslassungen und Auswahlausgaben entstanden, die sich um der Wirksamkeit willen auf die besonders galanten Abenteuer beschränkten.“"
                                            },
                                            {
                                                "example_id": "638566f6-ca75-49a7-83d9-034c6352067b",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Ein Problem sind die Raubdrucker, die gleich nach den ersten Heften verbilligte Nachdrucke auf den Markt bringen.“"
                                            },
                                            {
                                                "example_id": "6883e784-d911-4bc2-bf9e-b4f6c7edd0be",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Bereits zu Luthers Zeiten gelangten Hunderttausende von Exemplaren unter die Leute: Drucke aus Wittenberg, Nachdrucke aus Augsburg, Leipzig oder Basel, Teildrucke im Kleinformat, einspaltige und zweispaltige, einbändige und mehrbändige Drucke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
