                    "semantic_group_id": "detruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la vieille cave humide, ils ont découvert un vieux tonneau <w>défoncé</w>.",
                            "target_lang_translations": {
                                "en": "In the old, damp cellar, they found an old barrel <w>stove in</w>.",
                                "ru": "В старом сыром погребе они нашли старую бочку с <w>проломленным</w> дном.",
                                "de": "Im alten, feuchten Keller entdeckten sie ein altes Fass mit <w>eingeschlagenem</w> Boden.",
                                "es": "En el viejo sótano húmedo encontraron un tonel viejo <w>desfondado</w>.",
                                "zh": "在潮湿陈旧的地窖里，他们发现了一只底部<w>破裂</w>的旧木桶。"
                            }
                        },
                        {
                            "text": "La police a inspecté la porte <w>défoncée</w> au fond du couloir.",
                            "target_lang_translations": {
