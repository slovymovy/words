                                        "entry_id": "615819bf-d388-3d7b-b675-a4825e31e1f8",
                                        "glosses": [
                                            "driedimensionale afbeelding in hard materiaal in de vorm van een vlak waaruit de personen en voorwerpen met minstens de helft naar voren komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea9a7bb-6e91-4a64-af83-2013fbc7332b",
                                                "sense_id": "4695fa0f-c87d-3d7a-bf08-ae4b4a04c6f5",
                                                "text": "De mummie van de heilige was door de strijders van Zadar uit Venetië ontvoerd, en werd te Zadar bijgezet in een grote zilveren kist, versierd met een twaalftal taferelen in haut-reliëf."
                                            }
                                        ]
