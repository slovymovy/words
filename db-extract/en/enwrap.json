                                "target_senses": [
                                    {
                                        "sense_id": "8673ac98-92b9-33a7-a122-1ad9ace6cc3e",
                                        "entry_id": "166cec01-d89d-3e13-8f8d-edda80cf422a",
                                        "glosses": [
                                            "um jemanden, sich oder etwas eine Hülle, Verpackung, Bedeckung legen; wie eine Hülle umgeben"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d7cf1fd-e28f-4a38-82f9-9ce5aed7e19e",
                                                "sense_id": "8673ac98-92b9-33a7-a122-1ad9ace6cc3e",
                                                "text": "„Während die Messerschmidt 262, das Serien-Kampfflugzeug aus dem Zweiten Weltkrieg, mit einigen anderen Maschinen in die Flugwerft Schleißheim umzieht, wird die alte Tante Ju während der Bauarbeiten eingehüllt: Sie ist für einen Transport schlichtweg zu groß.“"
                                            },
                                            {
                                                "example_id": "d30fdfca-7273-402c-a9b8-9cb8fc268b51",
                                                "sense_id": "8673ac98-92b9-33a7-a122-1ad9ace6cc3e",
                                                "text": "„Ich bin süchtig nach der Natur. Für mich ist das Bergwandern wie eine Therapie. Es gibt einen Punkt, an dem man still wird und die Einsamkeit einen einhüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "826985c6-ec10-4899-a9ea-dad95671d3ce",
                        "source_entry_id": "72011fdd-4b44-3ce0-b080-b94cd029d46f",
                        "source_sense_description": "To wrap around, surround",
                        "target_lang_word": "einwickeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einwickeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf63c986-d1e1-3cd1-a6d8-3025d79557f9",
                                        "entry_id": "4e4f8c7e-bbc3-33cd-ae1b-6fabab9c8954",
                                        "glosses": [
                                            "etwas einpacken, indem man es mit etwas umhüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82ca1f3-d80a-4681-a1c0-dfd8f2285f39",
                                                "sense_id": "cf63c986-d1e1-3cd1-a6d8-3025d79557f9",
                                                "text": "Ich wickelte das Glas in Plastikfolie ein, damit es nicht zerbräche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b13c54e6-e961-387e-9b9b-e1f95e420076",
                                        "entry_id": "4e4f8c7e-bbc3-33cd-ae1b-6fabab9c8954",
                                        "glosses": [
                                            "jemandem etwas vorspielen, so dass dieser manipuliert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "172acd9a-adc1-41ac-89d5-f2cc12a205aa",
                                                "sense_id": "b13c54e6-e961-387e-9b9b-e1f95e420076",
                                                "text": "Lass dich nicht von seinen leeren Versprechungen einwickeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
