                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a17fe11-e1fa-31e2-a159-e9fbeb047f4e",
                        "entry_id": "affc6186-b765-380b-b5ff-f7f75449663c",
                        "glosses": [
                            "спец. необязательная, опциональная возможность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58576425-8c27-43f5-9393-3cfab6a9121a",
                                "sense_id": "8a17fe11-e1fa-31e2-a159-e9fbeb047f4e",
                                "text": "А в качестве опций предлагают оборудование, которому позавидуют многие автомобили более высоких классов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7417e0d-da43-4d27-abf6-f176276163a8",
                        "source_entry_id": "affc6186-b765-380b-b5ff-f7f75449663c",
                        "source_sense_id": "8a17fe11-e1fa-31e2-a159-e9fbeb047f4e",
                        "target_lang_word": "option",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "option",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcff310c-d338-3f6a-9e51-706afdd519a3",
                                        "entry_id": "60346ac8-08c9-35f4-85bd-7fdf19f4bf44",
                                        "glosses": [
                                            "One of a set of choices that can be made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a60210-a6ea-4262-adf0-908cffca94c4",
                                                "sense_id": "dcff310c-d338-3f6a-9e51-706afdd519a3",
                                                "text": "Luiz struggled with the movement of Helguson in the box, as he collected a long ball and the Spaniard barged him over, leaving referee Chris Foy little option but to point to the spot."
                                            },
                                            {
                                                "example_id": "ab3aeae3-6714-4052-a425-d017c2fe3c7f",
                                                "sense_id": "dcff310c-d338-3f6a-9e51-706afdd519a3",
                                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29eb01a4-0d74-3129-9741-3f431a4f20fb",
                                        "entry_id": "60346ac8-08c9-35f4-85bd-7fdf19f4bf44",
                                        "glosses": [
                                            "The freedom or right to choose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ec36ab5-a90a-3081-b152-c169af014499",
                                        "entry_id": "60346ac8-08c9-35f4-85bd-7fdf19f4bf44",
                                        "glosses": [
                                            "A contract giving the holder the right to buy or sell an asset at a set strike price; can apply to financial market transactions, or to ordinary transactions for tangible assets such as a residence or automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062d9b35-fe16-438e-bca0-3d568904f1da",
                                                "sense_id": "8ec36ab5-a90a-3081-b152-c169af014499",
                                                "text": "There's a book out on us and there's gonna be a movie based on the book. ABC has bought the option for a movie to be made specially for T.V."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0961f4-4ccb-3d69-b6ab-59f41b45adec",
                                        "entry_id": "60346ac8-08c9-35f4-85bd-7fdf19f4bf44",
                                        "glosses": [
                                            "The acquiring or retention of a nationality through personal choice as a right, bypassing selective legal mechanisms for naturalization, especially in cases where a territory is transferred or passed on from one state to another."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2d0ff85-c0b1-4a60-a046-7306a67ce35f",
                                                "sense_id": "8f0961f4-4ccb-3d69-b6ab-59f41b45adec",
                                                "text": "At that time every emigrant who was made aware of such a notification submitted his application for option to the British Consuls within the period prescribed."
                                            },
                                            {
                                                "example_id": "f73b9779-4909-4200-842f-743d7ed3da90",
                                                "sense_id": "8f0961f4-4ccb-3d69-b6ab-59f41b45adec",
                                                "text": "A right of option, mostly in favour of the nationality of the predecessor State, has been accorded in most cases of partial State succession, either by treaty or by domestic legislation."
                                            },
                                            {
                                                "example_id": "84bceb2e-1aa3-4aed-b62a-ad1eb5dab28c",
                                                "sense_id": "8f0961f4-4ccb-3d69-b6ab-59f41b45adec",
                                                "text": "This group constitutes around 9 percent of the total number of acquisitions of Dutch nationality through option."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "option",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd0b55f-e733-362b-8615-5dae634a009b",
                                        "entry_id": "f9701fc5-ec53-3384-aca0-f121a123ca84",
                                        "glosses": [
                                            "To purchase an option on something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff3b98c-0e59-4a34-aafe-b965566e4a1b",
                                                "sense_id": "6cd0b55f-e733-362b-8615-5dae634a009b",
                                                "text": "The new novel was optioned by the film studio, but they'll probably never decide to make a movie from it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c110c8f-93b0-36cf-95d7-7523103f43a1",
                                        "entry_id": "f9701fc5-ec53-3384-aca0-f121a123ca84",
                                        "glosses": [
                                            "To configure, by setting an option."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de5ed9d6-2a9f-40a0-ae63-4fcdb10cb5f3",
                                                "sense_id": "9c110c8f-93b0-36cf-95d7-7523103f43a1",
                                                "text": "The device that is to echo the characters should be optioned for echoplexing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de25fe14-492a-40ba-baf8-70c4cb6e98d6",
                        "source_entry_id": "affc6186-b765-380b-b5ff-f7f75449663c",
                        "source_sense_id": "8a17fe11-e1fa-31e2-a159-e9fbeb047f4e",
                        "target_lang_word": "Option",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Option",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                        "entry_id": "30e1070b-cb16-3b34-a797-b7052b327774",
                                        "glosses": [
                                            "Auswahlmöglichkeit, Alternative: die Möglichkeit eine Auswahl zwischen verschiedenen Angeboten treffen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fd47a8-80c9-409f-8d50-a47b77a9cd6f",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "Du hast jetzt zwei Optionen: Ihn fragen, oder es sein lassen."
                                            },
                                            {
                                                "example_id": "6f34c587-22b6-456e-992a-de74e45492c5",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "Wir hatten auch einen extremen Segeltörn im Oktober im Auge. Aber davon haben uns die Experten wegen des Wetters abgeraten. Auch Wandern auf dem Montblanc war eine Option."
                                            },
                                            {
                                                "example_id": "57ff8bc0-dae8-4dff-8150-1ce6e810ca38",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Es ist keine Option, den Nazis und Völkischen nun einfach das Feld zu überlassen, weil sie gewaltvoller sind. Es ist auch keine Option, sie zu umwerben und zu verharmlosen und dann jedes Mal wieder überrascht zu sein, wenn sie schießen.“"
                                            },
                                            {
                                                "example_id": "606647bc-dd29-4838-957b-954e20f93e81",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Sie plädierten für eine zweite Option, und Truman schloss sich ihnen an: die Invasion.“"
                                            },
                                            {
                                                "example_id": "9e67c158-e5ab-4f91-9e36-ad90ad960576",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Eine solche Option hatten Juden nicht.“"
                                            },
                                            {
                                                "example_id": "b011e232-37fb-4444-a77a-360c338d2ddb",
                                                "sense_id": "872b53d8-0731-3de4-8029-58c78a9227b2",
                                                "text": "„Die Option war ihr noch gar nicht in den Sinn gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                        "entry_id": "30e1070b-cb16-3b34-a797-b7052b327774",
                                        "glosses": [
                                            "bedingtes Termingeschäft: das Recht, eine bestimmte Sache zu einem späteren Zeitpunkt zu einem vereinbarten Preis zu kaufen oder zu verkaufen"
                                        ],
                                        "tags": [
                                            "Finanzwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8544345c-d52b-4b3b-b6fc-a0a265d9e4d0",
                                                "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                                "text": "Für den geregelten Handel mit Optionen ist es Voraussetzung, dass die Basiswerte an liquiden Märkten gehandelt werden, um jederzeit den Wert der Option ermitteln zu können."
                                            },
                                            {
                                                "example_id": "c83ac810-cea3-45ee-b0af-0c4dd4033c4c",
                                                "sense_id": "f1ecd586-24bb-3f44-bfc2-e41f2c26abb4",
                                                "text": "Für etwas Bewegung sorgte indes der auch \"Hexensabbat\" genannte dreifache Verfallstermin, an dem viermal im Jahr der letzte Handelstag aller vier Derivate-Typen, also der Optionen und Futures auf Indizes und einzelne Aktien, auf den gleichen Tag fällt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd6b4412-7f24-400d-872e-3231d688d922",
