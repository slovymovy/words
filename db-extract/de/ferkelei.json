                        ],
                        "examples": [
                            {
                                "example_id": "e15ff6ee-28dc-46a4-8788-dd10c63c2f69",
                                "sense_id": "31a64ae5-9273-3ef6-8f03-0052dcde6403",
                                "text": "„Ferkeleien am Strand“: Sex am hellen Tag in der Öffentlichkeit empört die Bürger einer Ostseegemeinde."
                            },
                            {
                                "example_id": "1bea6ec7-3ba6-4060-9c27-9b79971edc6d",
                                "sense_id": "31a64ae5-9273-3ef6-8f03-0052dcde6403",
                                "text": "Horst-Kevin erzählt auf dem Pausenhof immer Ferkeleien und wird deswegen von den Mädchen seiner Klasse nicht sehr gemocht."
                            },
                            {
                                "example_id": "6138bf23-bed8-4284-bfc8-4bc54fbac0bc",
                                "sense_id": "31a64ae5-9273-3ef6-8f03-0052dcde6403",
                                "text": "„Da kam Mama rein und fing an zu motzen, daß wir solche liederlichen Ferkeleien zu unterlassen hätten.“"
                            },
                            {
                                "example_id": "e12d6797-b629-44a3-848d-7d77139c95da",
                                "sense_id": "31a64ae5-9273-3ef6-8f03-0052dcde6403",
                                "text": "„Noch zu meiner Gymnasialzeit gab es eine Unzahl ebenfalls alphabetisch geordneter pubertärer Ferkeleien nach diesem großen Vorbild.“"
                            }
                        ],
