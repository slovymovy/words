                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                        "entry_id": "d36816ba-58b2-3430-85ce-6cf451f58500",
                                        "glosses": [
                                            "An idle person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3bc6e66-a5df-4d67-a2b4-3417e89d8460",
                                                "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                                "text": "The garden was bounded by a three-foot brick wall with a fringe of wood rails upon the top, and against this wall was leaning a stalwart police constable, surrounded by a small knot of loafers, who craned their necks and strained their eyes in the vain hope of catching some glimpse of the proceedings within."
                                            },
                                            {
                                                "example_id": "61cbcbbf-2ea9-41c7-b0cc-f825756eb5b5",
                                                "sense_id": "a28bbff5-a523-3260-aff9-5b867d48d9f2",
                                                "text": "Along this unequal way, where loafers sat on whittled benches, lounged in doorways, leaned against porch props, Dan Gustin went pegging in his high-heeled boots like a mule in a Mexican chain hobble, holding a straight course for the hotel, past the doors of temptation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8258c49-74a9-3d72-9fae-f3b657cfa5a0",
                                        "entry_id": "d36816ba-58b2-3430-85ce-6cf451f58500",
                                        "glosses": [
                                            "A shoe with no laces, resembling a moccasin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf26aa1-feba-4470-a274-e6e21917f16a",
                                                "sense_id": "d8258c49-74a9-3d72-9fae-f3b657cfa5a0",
                                                "text": "Someone must explain to Sunak about the time bomb ticking beneath his £1,000 loafers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1970608-1efe-39ae-a66a-cd2b6c56fa7d",
