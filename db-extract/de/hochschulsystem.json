                "senses": [
                    {
                        "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                        "entry_id": "3a198d3d-c292-3621-b08b-684528881bc6",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Hochschulbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81da779-05fc-4364-86ec-f6352dd67dea",
                                "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                                "text": "„Geistige Unabhängigkeit, Selbstzweck des Wissens, Hochschätzung der Geisteswissenschaften: Das deutsche Hochschulsystem könnte in vielem ein Vorbild für die Vereinigten Staaten sein.“"
                            },
                            {
                                "example_id": "4fd8b7be-4fa9-4053-ad01-7740726beff5",
                                "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                                "text": "„Das deutsche Hochschulsystem leidet unter einer unfassbaren personellen Asymmetrie.“"
                            },
                            {
                                "example_id": "6dcb9561-bd6a-4b60-ac62-8024fc96d43c",
                                "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                                "text": "„Studentenwerks-Präsident Dieter Timmermann sagte: ‚Der Zugang zum deutschen Hochschulsystem ist sozial nach wie vor selektiv - auch wenn das Bildungsniveau der Gesellschaft insgesamt gestiegen ist.‘“"
                            },
                            {
                                "example_id": "6d19fd98-bfd2-4049-8169-7a0137dba7ec",
                                "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                                "text": "„Sie sind, verglichen mit ihrem Nutzen, die teuersten Einrichtungen des deutschen Hochschulsystems: Die Akkreditierungsagenturen.“"
                            },
                            {
                                "example_id": "ccb31fe9-06df-4015-bfcf-3983ad228095",
                                "sense_id": "fbe63526-35cf-31d1-99dc-0644f1ae4228",
                                "text": "„Die Vergleichbarkeit und Kompatibilität der nationalen Hochschulsysteme sollte gesteigert werden, insbesondere um Studieren in Europa weltweit attraktiv zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
