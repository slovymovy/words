                "senses": [
                    {
                        "sense_id": "e28b4f0e-d1e6-349a-b47f-196b5d852023",
                        "entry_id": "87a737b0-fcb6-3fdb-ac16-b58e3779ec38",
                        "glosses": [
                            "Gas, das durch eine Pipeline gepumpt wird; das mit Hilfe einer Pipeline transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87336180-2e34-48a2-a05e-4b45f34fccb8",
                                "sense_id": "e28b4f0e-d1e6-349a-b47f-196b5d852023",
                                "text": "„Im Gegensatz aber zu Deutschland, Frankreich, Italien und Österreich, die so stark auf russisches Pipelinegas gesetzt haben, ist Japan aufgrund der Insellage stark von Flüssiggaslieferungen abhängig, hat dafür aber einen breiten Strauß an Lieferanten an der Hand.“"
                            },
                            {
                                "example_id": "e98155ac-62c5-4986-b69e-e0bac8a56946",
                                "sense_id": "e28b4f0e-d1e6-349a-b47f-196b5d852023",
                                "text": "„Ein Wechsel von Pipelinegas zu Flüssigerdgas, das mit riesigen Tankschiffen importiert werden muss, kam für die Bundesregierung nicht in Betracht.“"
                            },
                            {
                                "example_id": "7c8bb961-3db2-453b-a40a-71e42aa9710c",
                                "sense_id": "e28b4f0e-d1e6-349a-b47f-196b5d852023",
                                "text": "„Die Umstellung von russischem Pipelinegas auf Flüssiggas aus anderen Ländern nimmt Fahrt auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
