                "senses": [
                    {
                        "sense_id": "44a70356-0c68-3fdb-930c-d2bb076077c9",
                        "entry_id": "08af53a6-e3b6-3dfd-a6fc-43cdf3480fd9",
                        "glosses": [
                            "ein meist mit einem übersättigten Luft-Alkohol-Gemisch gefüllter Teilchendetektor, der dem Nachweis und der Sichtbarmachung von ionisierender Strahlung dient"
                        ],
                        "tags": [
                            "historical",
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "2fe9b9b3-0251-4a83-b349-32a3377dcb55",
                                "sense_id": "44a70356-0c68-3fdb-930c-d2bb076077c9",
                                "text": "„Die Bahnen ionisierender geladener Strahlungsteilchen kann man in einer Nebelkammer als Nebelspuren beobachten.“"
                            },
                            {
                                "example_id": "1c724cf3-0a55-4377-bf92-664e14d2eea0",
                                "sense_id": "44a70356-0c68-3fdb-930c-d2bb076077c9",
                                "text": "„In einer Nebelkammer sehen deshalb die durch Alphastrahlung erzeugten Bahnspuren, verglichen mit denen von Betastrahlen ähnlicher Energie, kürzer und dicker aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
