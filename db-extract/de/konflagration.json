                ],
                "senses": [
                    {
                        "sense_id": "093f6de6-c521-3df5-815d-b53ce4ef1641",
                        "entry_id": "7ed7e28f-2728-34e3-9171-7577169dba54",
                        "glosses": [
                            "besonders großer und verheerender Brand"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3b7e31e5-ee28-42e7-92e9-4970c8ea5370",
                                "sense_id": "093f6de6-c521-3df5-815d-b53ce4ef1641",
                                "text": "„Dies beschränkt die Rückversicherung auf Fälle von Konflagration (Großfeuern, bei denen ein Feuer von einem versicherten Objekt auf ein anderes übergreift).“"
                            },
                            {
                                "example_id": "bfee40db-f2c5-4e72-9318-341f89cc06ae",
                                "sense_id": "093f6de6-c521-3df5-815d-b53ce4ef1641",
                                "text": "„Trockenheit und häufige Stürme können selbst einen kleinen Brandherd zur Quelle größter Konflagrationen machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14fab137-27ec-3999-b8a2-1357fc99a959",
                        "entry_id": "7ed7e28f-2728-34e3-9171-7577169dba54",
                        "glosses": [
                            "das Aufkommen/Entstehen von (meist militärischen) Auseinandersetzungen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "8617fbaf-2a44-45eb-a054-7576182394ac",
                                "sense_id": "14fab137-27ec-3999-b8a2-1357fc99a959",
                                "text": "„Das Verhältnis der Monarchie zu Serbien wurde in den folgenden Monaten fortgesetzt gespannter und spitzte sich im Februar bis zur militärischen Konflagration zu.“"
                            },
                            {
                                "example_id": "55880bc2-aee7-4ec2-9661-2e52aacea9f9",
                                "sense_id": "14fab137-27ec-3999-b8a2-1357fc99a959",
                                "text": "„Aber auch im Westen stand Europa dauernd vor der Gefahr einer neuen Konflagration.“"
                            },
                            {
                                "example_id": "231a706e-c4a8-4cd6-b2e4-fb2f7e3723ec",
                                "sense_id": "14fab137-27ec-3999-b8a2-1357fc99a959",
                                "text": "„‚Worst case‘-Szenarien waren keine öffentliche Anleitung zur Brandstiftung, sondern Warnung vor Konflagrationen.“"
                            },
                            {
                                "example_id": "6066eb4a-f0f9-4901-b09f-503455a647bf",
                                "sense_id": "14fab137-27ec-3999-b8a2-1357fc99a959",
                                "text": "„Bismarck nahm diesen Nachteil hin, weil es ihm nicht darauf ankam, die beste Ausgangslage für den Krieg zu schaffen, sondern weil er darum bemüht war, durch eine Politik der austarierten Gegengewichte gerade den Ausbruch militärischer Konflagrationen zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
