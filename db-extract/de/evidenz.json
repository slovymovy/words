                        ]
                    },
                    {
                        "translation_id": "4cfd47ec-83bc-4dff-b7c8-bef29bfbac7d",
                        "source_entry_id": "d2a27a18-41c2-348a-8507-7f009e6c7c2b",
                        "source_sense_id": "3d3a2279-cc9e-38d2-851a-dfe3f99f13b9",
                        "source_sense_description": "empirisch erbrachter Nachweis der Wirksamkeit einer Maßnahme oder Behandlung",
                        "target_lang_word": "evidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                        "entry_id": "ab81b476-285c-35be-88aa-3a07e944c955",
                                        "glosses": [
                                            "Facts or observations presented in support of an assertion."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2c6d02-f7b5-4251-bc58-7937fb43a61b",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "There is no evidence that anyone was here earlier."
                                            },
                                            {
                                                "example_id": "560254cc-1b60-4a58-89af-17e8a5f9377e",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "We have enough cold hard evidence in that presentation which will make a world of pain for our parasitic friends at Antarctica."
                                            },
                                            {
                                                "example_id": "a1334ef2-4885-4d79-8ae6-ba8019c8af18",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "In our reasonings concerning matter of fact, there are all imaginable degrees of assurance, from the highest certainty to the lowest species of moral evidence. A wise man, therefore, proportions his belief to the evidence."
                                            },
                                            {
                                                "example_id": "1f592ff5-fa11-4202-b693-c3d12f00377d",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "We find material evidences of magical practices in the European caves of the Palæolithic age[.]"
                                            },
                                            {
                                                "example_id": "d009c109-11ec-46e0-ae28-1cadb13aaf6c",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            },
                                            {
                                                "example_id": "1dd11a5c-357a-49ea-b6a0-4ab56f599856",
                                                "sense_id": "3f41ad4d-bead-31dc-b06b-98bbf0a45a2a",
                                                "text": "The Supreme Court, in an order that no justice publicly opposed last week, said the administration needs to “facilitate” Mr. Ábrego García’s release from Salvadoran custody. There has been no evidence that the Trump administration has been making that effort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14fdee0-f77d-351b-894a-a67867b8b864",
                                        "entry_id": "ab81b476-285c-35be-88aa-3a07e944c955",
                                        "glosses": [
                                            "Anything admitted by a court to prove or disprove alleged matters of fact in a trial."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140983ae-aebb-4654-a89d-65734915b2d6",
                                                "sense_id": "d14fdee0-f77d-351b-894a-a67867b8b864",
                                                "text": "For Lothian and Borders Police, the early-morning raid had come at the end one of biggest investigations carried out by the force, which had originally presented a dossier of evidence on the murder of Jodi Jones to the Edinburgh procurator-fiscal, William Gallagher, on 25 November last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e53f5da-cae3-3ca1-9917-db52b7951e6b",
                                        "entry_id": "ab81b476-285c-35be-88aa-3a07e944c955",
                                        "glosses": [
                                            "One who bears witness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b81bc9-6fab-42ca-ba01-9a89d1b74e64",
                                                "sense_id": "8e53f5da-cae3-3ca1-9917-db52b7951e6b",
                                                "text": "infamous and perjured evidences"
                                            },
                                            {
                                                "example_id": "1ccd49e3-9a69-43c8-abbd-cc90dcba9b1e",
                                                "sense_id": "8e53f5da-cae3-3ca1-9917-db52b7951e6b",
                                                "text": "He recapitulated the Sybil’s story word by word, with the air of a man who is cross-examining an evidence, and trying to make him contradict himself."
                                            },
                                            {
                                                "example_id": "82438df0-a13f-41d7-b54b-513830e97856",
                                                "sense_id": "8e53f5da-cae3-3ca1-9917-db52b7951e6b",
                                                "text": "In the mean time, Cluffe had arrived. He was a little bit huffed and grand at being nailed as an evidence, upon a few words carelessly, or, if you will, confidentially dropped at his own mess-table, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0296d77c-1546-3f68-a19b-00ab4a4eb180",
                                        "entry_id": "ab81b476-285c-35be-88aa-3a07e944c955",
                                        "glosses": [
                                            "A body of objectively verifiable facts that are positively indicative of, and/or exclusively concordant with, that one conclusion over any other."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "evidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                                        "entry_id": "0df514e2-480b-33f4-91b8-5b1caa0ef3d7",
                                        "glosses": [
                                            "To provide evidence for, or suggest the truth of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76bcf2e-021f-4c1d-ad98-558b09438487",
                                                "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                                                "text": "She was furious, as evidenced by her slamming the door."
                                            },
                                            {
                                                "example_id": "c8dbb2e5-6f95-46a4-9906-f409ab36460f",
                                                "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                                                "text": "That he was a great locomotive engineer, it would be foolish to deny or even to qualify; that he was also extremely pig-headed is fairly evidenced by David Joy, who in his 'Diaries' said that Stroudley always wanted his way 'to the last nut and bolt.'"
                                            },
                                            {
                                                "example_id": "995d3f94-d2f9-414b-8c49-917e578ce203",
                                                "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                                            },
                                            {
                                                "example_id": "8994aa88-acaf-47e8-9cdb-f52be9de4907",
                                                "sense_id": "f3075a6a-8396-3af3-8789-d718e9ac5686",
                                                "text": "\"And I think we can do better, and we have to do better, because we need to evidence why public ownership of the railways is going to work for the people who use it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
