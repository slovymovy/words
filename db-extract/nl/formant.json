                                        "entry_id": "94e6c512-26e8-3495-b704-4e86aaec7fc2",
                                        "glosses": [
                                            "Resonanzfrequenz des Vokaltraktes"
                                        ],
                                        "tags": [
                                            "Phonetik",
                                            "speziell akustische Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0274f5-dcc8-4507-a8e2-77453313f872",
                                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                                "text": "„Die absolute Lage der Formanten ist von der Gesamtlänge des Ansatzrohres abhängig (invers proportional)…“"
                                            },
                                            {
                                                "example_id": "e3cf6414-0dd0-44c9-a1bc-ac95d78dfd2c",
                                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                                "text": "„Vor allem die drei untersten Formanten sind im Allgemeinen deutlich ausgeprägt und sind verschieden für verschiedene Vokale.“"
                                            },
                                            {
                                                "example_id": "da357a22-7837-45cb-9e96-ebbfd42b16b8",
                                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                                "text": "„Wie Sie sehen, sind die Vokale durch die unterschiedlich gelagerten Formanten und Formantenkombinationen voneinander abgehoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
