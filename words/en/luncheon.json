                    "sense_definition": "A formal meal served in the middle of the day.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hosted a formal <w>luncheon</w> to celebrate the new partnership.",
