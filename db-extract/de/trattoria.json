                                                "example_id": "16ae0c1a-100c-4268-ad10-7d2cbcf13fdf",
                                                "sense_id": "ab70f57a-6bfa-3132-af67-15cbc37c063e",
                                                "text": "Au rez-de-chaussée de l’immeuble, il y avait une vieille trattoria qui fermait tard, et les voix des clients traversaient la fenêtre fermée."
                                            }
