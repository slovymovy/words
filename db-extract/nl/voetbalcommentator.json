                        "examples": [
                            {
                                "example_id": "9eff9b3a-779d-405d-8dc5-8604a10452c8",
                                "sense_id": "a133fae5-bef9-35e0-ad26-7e2dbf941fff",
                                "text": "In het Sportforum bij Langs de Lijn En Omstreken op NPO Radio 1 zijn voetbaljournalist Willem Vissers (de Volkskrant), tenniscoach Tjerk Bogtstra en voetbalcommentator Frank Snoeks van de NOS te gast om de actuele sportzaken te bespreken."
                            },
                            {
                                "example_id": "b87ab4e9-9dcc-47d5-ac17-1fc399a591e2",
                                "sense_id": "a133fae5-bef9-35e0-ad26-7e2dbf941fff",
                                "text": "\"Het is een behoorlijk dramatisch rijtje\", constateert NOS-voetbalcommentator Arno Vermeulen. \"Afellay heeft niet gespeeld, Boscagli bijna niet, de dure Bruma is geen basisspeler, Baumgartl is een ordinaire centrale verdediger van wie er in Nederland genoeg rondlopen en van Doan en Mitroglou val ik ook nog niet van mijn stoel. PSV heeft zijn geld niet goed besteed.\""
                            },
                            {
                                "example_id": "ef3fd967-c146-4048-a3a4-52143f146580",
                                "sense_id": "a133fae5-bef9-35e0-ad26-7e2dbf941fff",
                                "text": "Waarom lijkt De Telegraaf tegenstander van Erik ten Hag bij Ajax? NOS-voetbalcommentator Frank Wielaard en FOX Sports-commentator Leo Driessen proberen antwoord te geven."
                            }
                        ]
                    }
