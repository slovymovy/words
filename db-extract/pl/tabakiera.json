                    {
                        "sense_id": "f65d7d90-3765-3701-a3a7-7747d445b1b7",
                        "entry_id": "e06b6e22-4bc7-3569-b72f-e80397b4e0e6",
                        "glosses": [
                            "pudełeczko na tabakę"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "121943fd-cd17-4c37-8848-b898b9b98b54",
                                "sense_id": "f65d7d90-3765-3701-a3a7-7747d445b1b7",
                                "text": "Czy nos dla tabakiery, czy ona dla nosa? / Była wielka dysputa ze starym młokosa"
                            },
                            {
                                "example_id": "38c0cc41-5e24-408e-8349-3d0e3be9bd52",
                                "sense_id": "f65d7d90-3765-3701-a3a7-7747d445b1b7",
                                "text": "On milczał, szczyptę wziętą z tabakiery ważył / W palcach i długo dumał, nim ją w końcu zażył"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
