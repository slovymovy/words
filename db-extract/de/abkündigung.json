                ],
                "senses": [
                    {
                        "sense_id": "23b69ad2-bc7f-3b15-be82-d2e89538af47",
                        "entry_id": "5eea8a9b-1e1f-3050-8ced-424af036e846",
                        "glosses": [
                            "Bekanntmachung von der Kanzel herab vor oder nach der Predigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16108b5b-1870-435d-a8fe-1d35e8a54aa6",
                                "sense_id": "23b69ad2-bc7f-3b15-be82-d2e89538af47",
                                "text": "Nachdem die Gemeinde die Abkündigung gehört hatte, folgte noch das abschließende Lied und der Segen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                        "entry_id": "5eea8a9b-1e1f-3050-8ced-424af036e846",
                        "glosses": [
                            "Ankündigung des Endes der Lieferbarkeit eines Produkts durch einen Lieferanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101c1446-7c6c-4e17-a539-f525b786ada0",
                                "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                                "text": "„In der Produktionsphase durchläuft das Produkt wieder verschiedene Änderungsversionen bis zur Abkündigung.“"
                            },
                            {
                                "example_id": "0ab06e0a-74f4-4cad-8cc7-d02794f6ee61",
                                "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                                "text": "„Auf Basis der hier gewonnenen Informationen werden dann Projekte ausgelöst, die zur Entwicklung, Weiterentwicklung oder der Abkündigung von Produkten führen.“"
                            },
                            {
                                "example_id": "f04b0d6b-62f5-4828-a8af-427f2b9b9130",
                                "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                                "text": "„Ebenso fordern Automobilhersteller, dass die Halbleiterhersteller frühzeitige Aussagen bezüglich genereller Verfügbarkeit bzw. frühzeitiger Abkündigung treffen.“"
                            },
                            {
                                "example_id": "eae0a831-6dc9-469a-8d45-437f3dfbc761",
                                "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                                "text": "„Die Vorgaben der IEC 61508 umfassen den kompletten Produktlebenszyklus von der Idee bis zur Abkündigung eines Produktes.“"
                            },
                            {
                                "example_id": "5802e1dc-26be-4868-b04b-739652946d10",
                                "sense_id": "93969b3f-b9e0-3cf7-a01d-cee6a6a48693",
                                "text": "„Im Falle der Fertigungseinstellung ohne funktional kompatibles Nachfolgeprodukt muss die Abkündigung in einem festen, bekannten Zeitrahmen zuvor erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b5d8383-9518-4c11-bf70-3ad011794ae5",
