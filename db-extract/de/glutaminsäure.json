                        "examples": [
                            {
                                "example_id": "ed735e40-7245-46e4-b574-ecec3ed7691b",
                                "sense_id": "afe2f1e0-b10b-3120-a9f2-c2a787ae7b17",
                                "text": "Die Salze und Ester der Glutaminsäure werden als Glutamate bezeichnet."
                            },
                            {
                                "example_id": "1eec198d-a4a5-40b1-b91c-f15fe73d63b4",
                                "sense_id": "afe2f1e0-b10b-3120-a9f2-c2a787ae7b17",
                                "text": "Durch Insertion von 8 Glutaminsäuren und einem Cystein in den HI-loop von VP1 steht ein universeller Adapter an der Oberfläche der Partikel zur Kopplung von Liganden, die komplementär geladene Peptide enthalten, zur Verfügung."
                            }
                        ],
