                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Qualen",
                                "target_lang_sense_clarification": "seelische Belastung oder innerer Kampf"
                            },
                            {
                                "target_lang_word": "Gewissensbisse",
                                "target_lang_sense_clarification": "spezifisch bei moralischen oder inneren Konflikten"
