                            {
                                "example_id": "5faac30a-ea50-41fd-9a89-b3bb5ed1b237",
                                "sense_id": "d00f530a-cabb-3d6e-8930-5478dea8be93",
                                "text": "„Ein Fundgebiet nach dem anderen wurde besucht. 14 Tage meist rollte der Landrover von Farm zu Farm, von Fundstelle zu Fundstelle.“"
                            },
                            {
                                "example_id": "76ef8ac8-393a-472b-8a21-b6f84e0a0532",
                                "sense_id": "d00f530a-cabb-3d6e-8930-5478dea8be93",
                                "text": "„Bei den folgenden Betrachtungen ist zu beachten, daß die einstige geographische Verbreitung der Belemniten auf die Fundgebiete innerhalb heutiger Ländergrenzen bezogen wird.“"
                            }
