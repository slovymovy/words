                                                "example_id": "508b92d4-a33a-4da9-87b2-0de4a9ed0b51",
                                                "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5cb23e-6b7f-3786-8baf-5c585cac730f",
