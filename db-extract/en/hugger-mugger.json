                        ],
                        "examples": [
                            {
                                "example_id": "4fcef41b-9b83-4960-96ab-4ce330a77741",
                                "sense_id": "d26d4285-0bc8-329b-826a-18bade6888d8",
                                "text": "[…]; and we haue done but greenly\n In hugger mugger to interre him."
                            },
                            {
                                "example_id": "c3fb1bb5-c061-4be5-9177-502676ebb483",
                                "sense_id": "d26d4285-0bc8-329b-826a-18bade6888d8",
                                "text": "Many things have been done in Hugger mugger in our Age, prophane perſons conceited that their privacy protected them from divine inſpection."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e8f3d8b-670d-37fd-8bd0-ea43778c4480",
                        "entry_id": "a0bed2ea-9bc6-35f9-9e21-3cc55b25afbb",
                        "glosses": [
                            "Disorder."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "107b24c2-20d6-48e1-bffa-a6cb4e57c3a7",
                                "sense_id": "4e8f3d8b-670d-37fd-8bd0-ea43778c4480",
                                "text": "As we passed through the quadrangle the church was glowing more brightly than a pearl, like a lily in strong sunlight, in spite of all the scaffolding and hugger-mugger."
                            },
                            {
                                "example_id": "68498a67-2bfe-42d8-a766-3d598cc094cb",
                                "sense_id": "4e8f3d8b-670d-37fd-8bd0-ea43778c4480",
                                "text": "Portentous events and lots of huggermugger quickly proliferate, as they always in Pynchon-land: a dead body turns up near the pool in a famous Upper West Side building; […]"
                            }
                        ]
                    }
                ],
