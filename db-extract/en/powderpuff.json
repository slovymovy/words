                        "glosses": [
                            "Being or relating to a division of a traditionally male sport that is reserved for females."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "874704dd-6263-41fe-a80c-3dcd3ed02d36",
                                "sense_id": "8f565239-ed1d-3926-8cd5-67cfd27deed0",
                                "text": "In response to a hypothetical question, the psychiatrist stated that quite probably Miss Lynch's abnormal brainwave pattern and behavioral difficulties were caused by the head injury she received in the powderpuff football game."
                            },
                            {
                                "example_id": "eb7a3a2e-8c16-4a01-83a9-7fde878447da",
                                "sense_id": "8f565239-ed1d-3926-8cd5-67cfd27deed0",
                                "text": "A new field on the 110-acre campus has provided the opportunity for a softball team, and a new sports complex and a student center are planned. Intramurals, with the exception of powderpuff football, suffer."
                            },
                            {
                                "example_id": "fb8a0dd0-6879-4b34-877f-10dbc55be8db",
                                "sense_id": "8f565239-ed1d-3926-8cd5-67cfd27deed0",
                                "text": "I know for a fact there would still be sports because women are competitive as hell. At my high school they brought an end to the annual powderpuff game because of the mounting number of severe injuries."
                            }
                        ]
                    }
