                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b413f3df-9096-38a9-b8c2-f7ed333d0f48",
                                        "entry_id": "0ad47db4-8193-3bc4-a6f7-625a071c22f4",
                                        "glosses": [
                                            "von geringer Wassertiefe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12fdeed-6c93-43b7-85bb-51252c29cc38",
                                                "sense_id": "b413f3df-9096-38a9-b8c2-f7ed333d0f48",
                                                "text": "Das Wasser ist zu seicht, um darin zu schwimmen."
                                            },
                                            {
                                                "example_id": "f145f739-d43a-4640-bca1-81d0afdd3a57",
                                                "sense_id": "b413f3df-9096-38a9-b8c2-f7ed333d0f48",
                                                "text": "Falls man in seichtem Wasser schwimmt, soll man keine Angst haben."
                                            },
                                            {
                                                "example_id": "e6f0636c-547d-45c5-9bf1-c0cd39462f8c",
                                                "sense_id": "b413f3df-9096-38a9-b8c2-f7ed333d0f48",
                                                "text": "[Das Gehirn ist zufrieden damit] immer wieder diesen Mann zu beobachten, wie er bedächtig die Barschnetze aufhängt, wie er das Boot im Zickzackkurs durch das seichte Gewässer nahe am Ufer führt und das Maschenwerk in großen Schwüngen auslegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81fee131-8d14-3f90-9911-4122517df304",
                                        "entry_id": "0ad47db4-8193-3bc4-a6f7-625a071c22f4",
                                        "glosses": [
                                            "wenig anspruchsvoll (von geringem Tiefgang)"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7d7198-6044-4656-bfe5-62e80ccf0408",
                                                "sense_id": "81fee131-8d14-3f90-9911-4122517df304",
                                                "text": "„Eine frivole oder seichte Beziehung zu Menschen war ihr unmöglich.“"
                                            },
                                            {
                                                "example_id": "798790ba-a2dc-4b78-a902-db3787a29fcf",
                                                "sense_id": "81fee131-8d14-3f90-9911-4122517df304",
                                                "text": "\"In den Köpfen vieler wird unter Comic immer noch die seichte Unterhaltung verstanden. Aber das ändert sich Schritt für Schritt\", sagt Dietrich Grünewald."
                                            },
                                            {
                                                "example_id": "a6a2cfb5-3b24-4d4a-9d05-070fe41b78bf",
                                                "sense_id": "81fee131-8d14-3f90-9911-4122517df304",
                                                "text": "„Sie genierte sich für ihren seichten Versuch, ein Gespräch anzuknüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
