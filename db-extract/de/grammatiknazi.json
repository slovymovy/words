                "senses": [
                    {
                        "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                        "entry_id": "1895ce51-eb12-309a-ae0c-119b1abcf1fa",
                        "glosses": [
                            "nervige Person, die andere Person(en) ständig pingelig grammatikalisch korrigiert und sich auch teils darüber echauffiert beziehungsweise profiliert"
                        ],
                        "tags": [
                            "colloquial",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "84f70255-0f5e-45c5-a70c-e75ac0354d6c",
                                "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                                "text": "„Sie korrigieren Freunde und Kollegen und können sich stundenlang über ein falsch gesetztes Komma aufregen – und es gibt einen Begriff für sie: »Grammatiknazi«.“"
                            },
                            {
                                "example_id": "d0741be9-a273-4ac6-9cae-45c9ece2c2e4",
                                "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                                "text": "„Auch die Rechtschreibung bietet Anlass für Streitigkeiten; für Wächter, die die Einhaltung der Rechtschreibregeln reklamieren, haben Forumsteilnehmer/-innen den Ausdruck Grammatiknazi geprägt, [das ist] ein Nutzer oder eine Nutzerin, welche die Rechtschreibung anderer Nutzer/-innen gerne kritisiert.“"
                            },
                            {
                                "example_id": "2c17da27-3198-4326-bc41-022ea54ed50e",
                                "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                                "text": "„Wie viele Gamer ist Scruff ein echter Grammatiknazi und stresst bei Chatsprache und schlechter Rechtschreibung [he]rum.“"
                            },
                            {
                                "example_id": "80e1cb9f-7b7a-4757-b06f-a40b29ebf7b5",
                                "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                                "text": "„Zudem bin ich Deutschlehrer und ein ‚Grammatiknazi‘ sondergleichen.“"
                            },
                            {
                                "example_id": "22718110-cb0b-429b-988d-65568421cc1f",
                                "sense_id": "b10bc46b-e21d-35de-8bda-dfd3316c9ea1",
                                "text": "„Wenn, dann bitte nicht »Grammarnazi«, sondern »Grammatiknazi«, denn ein wahrer Grammatiknazi lehnt unnötige Anglizismen konsequent ab, schon gar wenn um die Beleidigung der eigenen Personen geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
