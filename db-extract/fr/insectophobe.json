                        "glosses": [
                            "Qualifie une personne atteinte d’insectophobie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3a2836b6-4eec-486e-9ff6-4892b92dc144",
                                "sense_id": "28d95ed4-6ada-309a-bc50-af665107508a",
                                "text": "Horreur, grosse peur, il y a une bestiole, pendant que je m'étiole, qui rigole, t'es pas drôle, j’me sens toute molle, presque folle, moi qui suis insectophobe, sous moi le sol se dérobe, me voilà en alerte, au secours, c’est quoi ce machin noir qui grimpe aux rideaux de ma chambre à coucher ?"
                            },
                            {
                                "example_id": "953e884d-bd2c-44db-9781-a7faf44bcdf1",
                                "sense_id": "28d95ed4-6ada-309a-bc50-af665107508a",
                                "text": "Il laisse échapper un petit ricanement.\n— « Insectophobe », tu veux dire, corrige Tony d'un air de dégoût. Je les déteste ces petites bêtes avec leurs petites pattes velues."
                            }
                        ]
                    }
