                        "entry_id": "858edaed-43ec-340e-a5e9-b1dcf3421acf",
                        "glosses": [
                            "Qui a la forme d'un trèfle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1bcb92-4f4d-4e70-9ff1-ae93a49de819",
                                "sense_id": "535e3224-5b82-36cb-ac5b-ddbad3f17980",
                                "text": "On remarque, à l’est, une latrine et une fenêtre tréflée avec un coussiège et un étroit petit couloir aboutissant à une meurtrière."
                            },
                            {
                                "example_id": "761b3f71-8bf0-4d0b-82ed-501cc10e0f9d",
                                "sense_id": "535e3224-5b82-36cb-ac5b-ddbad3f17980",
                                "text": "Sebastian se leva du coussiège, se distinguant de l’obscurité à la lumière du clair de lune."
                            }
                        ]
                    },
                    {
                        "sense_id": "b472b65a-1064-3430-bb1f-f3d9cb93cc83",
                        "entry_id": "858edaed-43ec-340e-a5e9-b1dcf3421acf",
                        "glosses": [
                            "Se dit d'une pièce ou d'un meuble dont les extrémités se terminent en trèfle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d14939-f188-4699-af00-f0fa512108e5",
                                "sense_id": "b472b65a-1064-3430-bb1f-f3d9cb93cc83",
                                "text": "De gueules à la croix tréflée vidée d’argent, à la filière du même → voir illustration « croix tréflée »"
                            }
                        ]
                    }
