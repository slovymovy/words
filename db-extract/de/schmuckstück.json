                ],
                "senses": [
                    {
                        "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                        "entry_id": "79633e49-d14f-32fa-9b48-91a8d1c84cc3",
                        "glosses": [
                            "kostbarer (zur Zierde am Körper getragener) Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdee7f2-b1e8-4c20-b2e1-a2f2be86c593",
                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                "text": "Pass auf auf dieses Schmuckstück."
                            },
                            {
                                "example_id": "217f0147-b6f5-4f55-95d0-bb8a3e0bd3d8",
                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                "text": "„Lässt man die Wissenschaft außer Acht, dann handelt es sich bei Perlen um die wohl schönsten, zeitlosesten Schmuckstücke, die die Natur hervorbringt.“"
                            },
                            {
                                "example_id": "5e2a9d4b-070b-4b20-8919-4f2d9b232ab6",
                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                "text": "„Insgesamt erbeuten sie 20 Schmuckstücke im Wert von mehr als 6,1 Millionen Dollar.“"
                            },
                            {
                                "example_id": "19e9a6df-5be2-41bd-8f97-9b2f6ac7e9ab",
                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                "text": "„Sie holte hierauf aus ihrer Stube zwei Schmuckstücke und reichte sie dem blinden Schelm.“"
                            },
                            {
                                "example_id": "dce011bb-8494-4db1-b323-18aa5fde1ed4",
                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                "text": "„Er kam gegen Mitte Juni an, und da ich in der Zwischenzeit dem Bassettespiel verfiel, hatte ich bis zu diesem Zeitpunkt mein ganzes Geld verloren und alle meine Schmuckstücke verkauft oder verpfändet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4590eec-29aa-33c5-abf4-a7b3c6e40d7c",
                        "entry_id": "79633e49-d14f-32fa-9b48-91a8d1c84cc3",
                        "glosses": [
                            "besonders gelungener oder geschätzter Gegenstand (unter anderen)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6b59b254-1ecb-4645-9801-34775f16fbe5",
                                "sense_id": "e4590eec-29aa-33c5-abf4-a7b3c6e40d7c",
                                "text": "Dieses Haus ist ja ein wahres Schmuckstück!"
                            }
                        ],
