                    {
                        "sense_id": "93912c49-e764-3892-9155-1e1f4f1bc302",
                        "entry_id": "ee170e2c-cfab-37f1-ad02-852d18cf4f8c",
                        "glosses": [
                            "пригородный лес, расчищенный и используемый как парк"
                        ],
                        "tags": [],
