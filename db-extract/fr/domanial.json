                    {
                        "sense_id": "c2faefb7-5829-3c7a-a361-8723b72b1ad2",
                        "entry_id": "21d74139-f1b2-3e8b-9ab8-a3183d1599e9",
                        "glosses": [
                            "Qui est du domaine privé de l’État."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b96711-39e1-4796-8ec3-5b0e13f174f4",
                                "sense_id": "c2faefb7-5829-3c7a-a361-8723b72b1ad2",
                                "text": "Vaste de 9000 Ha ^([sic : ha]) de terrains domaniaux situés entre 900 et 2800 m d’altitude, la réserve du Mont-Vallier abrite une population d’isards, de densité moyenne supérieure à 18 têtes pour 100 ha."
                            },
                            {
                                "example_id": "9238b023-e64c-4e5b-8075-1754e0fec332",
                                "sense_id": "c2faefb7-5829-3c7a-a361-8723b72b1ad2",
                                "text": "Raoul, déjà, avait rendu en matière forestière des règlements très sages ; maintes ordonnances de ses successeurs ont réprimé les dégâts commis dans les bois domaniaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "112d6ac4-d157-3384-907a-5d1474b35bac",
                        "entry_id": "21d74139-f1b2-3e8b-9ab8-a3183d1599e9",
                        "glosses": [
                            "Qui concerne un domaine privé, généralement de grande taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e60dc0-838a-4240-90ac-b7dbedfbeb3d",
                                "sense_id": "112d6ac4-d157-3384-907a-5d1474b35bac",
                                "text": "Dans cette maison domaniale, bien des visiteurs illustres se sont arrêtés."
                            }
                        ]
                    }
