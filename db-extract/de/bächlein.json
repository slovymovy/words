                "senses": [
                    {
                        "sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                        "entry_id": "ce317430-bf69-3e6a-93b1-0575e2242cea",
                        "glosses": [
                            "kleiner Bach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d913a8b2-36d5-43ca-8233-8c0937edef24",
                                "sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                                "text": "Das Wasser des Bächleins ist kristallklar und man kann kleine Fischchen im Wasser erkennen."
                            },
                            {
                                "example_id": "5a8ffa38-a4db-4252-b058-61922c343b3b",
                                "sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                                "text": "„Jetzt kam sie an ein kleines Bächlein und setzte sich am Ufer auf einen Stein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16e1afff-01b6-470d-b3f0-214eebc09c1e",
                        "source_entry_id": "ce317430-bf69-3e6a-93b1-0575e2242cea",
                        "source_sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                        "source_sense_description": "kleiner Bach",
                        "target_lang_word": "rill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                        "entry_id": "6486ea0b-62a2-3b9e-ad12-9a8e8f3aee8b",
                                        "glosses": [
                                            "A very small brook; a streamlet; a creek, rivulet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ffb94b-9ddb-470f-a472-063d22300cef",
                                                "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                                "text": "[N]or yet beside the rill / Nor up the lawn, nor at the wood was he"
                                            },
                                            {
                                                "example_id": "112cbf8e-a915-4e11-922f-7962a57859cf",
                                                "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                                "text": "So twice five miles of fertile ground / With walls and towers were girdled round: / And here were gardens bright with sinuous rills, / Where blossom'd many an incense-bearing tree; / And here were forests ancient as the hills, / And folding sunny spots of greenery."
                                            },
                                            {
                                                "example_id": "2e63b44b-de8a-4a51-8c24-58142df3e1a7",
                                                "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                                "text": "The secret of success lies never in the amount of money, but in the relation of income to outgo; as if, after expense has been fixed at a certain point, then new and steady rills of income, though never so small, being added, wealth begins."
                                            },
                                            {
                                                "example_id": "15878f5c-c5df-4a74-a4a5-18d0ea1f45e0",
                                                "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                                "text": "\"Most of them don't wash. Those who do usually plunge their head into some brook or rill, if there happens to be one about.\""
                                            },
                                            {
                                                "example_id": "9449f2ba-f025-42e6-be26-a0d57c5a061c",
                                                "sense_id": "9caddeb7-def3-3b4a-a1e7-f16018441364",
                                                "text": "Light grew, and lo! the Company passed through another gateway, high-arched and broad, and a rill ran out beside them; and beyond, going steeply down, was a road between sheer cliffs, knife-edged against the sky far above."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "045eb7e8-a0f4-3fc2-b83b-e540cf48c4eb",
                                        "entry_id": "6486ea0b-62a2-3b9e-ad12-9a8e8f3aee8b",
                                        "glosses": [
                                            "Alternative form of rille."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c92ee6-dd55-38cc-b608-89be9ba636d7",
                                        "entry_id": "4edc751c-77e2-3ac9-88d8-e7273478d672",
                                        "glosses": [
                                            "To trickle, pour, or run like a small stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dff9730-09d6-4118-89d6-39fd74923ce5",
                                                "sense_id": "d2c92ee6-dd55-38cc-b608-89be9ba636d7",
                                                "text": "And fainter, finer, trickle far\nTo where the listening uplands are;\nTo pause—then from his gurgling bill\nLet the warbled sweetness rill,\nAnd down the welkin, gushing free,\nHark the molten melody;"
                                            },
                                            {
                                                "example_id": "0c81d330-74a8-434d-9f82-2b0485eaa9b4",
                                                "sense_id": "d2c92ee6-dd55-38cc-b608-89be9ba636d7",
                                                "text": "Alladad Khan was panting hard, soaked in sweat, and his rolled-up sleeve was all blood, blood rilling down his arm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0634e062-0b83-42b8-bc5f-1f544f83c938",
                        "source_entry_id": "ce317430-bf69-3e6a-93b1-0575e2242cea",
                        "source_sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                        "source_sense_description": "kleiner Bach",
                        "target_lang_word": "rivulet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivulet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                        "entry_id": "bec49355-1b89-3f30-946e-acfb91c8ac72",
                                        "glosses": [
                                            "A small stream; a streamlet; a gill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069adbd0-9239-4c76-b732-cf2df1c80836",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "A rivulet of tears ran down his face."
                                            },
                                            {
                                                "example_id": "f0c1662e-d1b7-44d2-966a-04afc9c465c3",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "Yes Madam I think you will like them—when you shall see in a beautiful Quarto Page how a neat rivulet of Text shall meander thro' a meadow of margin—'fore Gad, they will be the most elegant Things of their kind—"
                                            },
                                            {
                                                "example_id": "2fdde431-0dcd-4239-b448-779b58c56f60",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "The struggle with ways and means had recommenced, more difficult now a hundredfold than it had been before, because of their increasing needs. Their income disappeared as a little rivulet that is swallowed by the thirsty ground."
                                            },
                                            {
                                                "example_id": "1b782cbc-9ede-403d-9d6f-1dd35f50f8d1",
                                                "sense_id": "abaf58e5-db13-3b6d-b1a2-0991d2c694fe",
                                                "text": "Rills running down the steepest slopes develop into rivulets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f07d441d-f844-3c4b-8994-6387f569e59b",
                                        "entry_id": "bec49355-1b89-3f30-946e-acfb91c8ac72",
                                        "glosses": [
                                            "Perizoma affinitatum, a geometrid moth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a09c6e-9d18-4320-bd7d-85428339e9d4",
                        "source_entry_id": "ce317430-bf69-3e6a-93b1-0575e2242cea",
                        "source_sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                        "source_sense_description": "kleiner Bach",
                        "target_lang_word": "streamlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streamlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                        "entry_id": "8d3b0113-20ef-3087-a315-02ea829466cc",
                                        "glosses": [
                                            "A small stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e22d4035-76b2-4a01-9514-ead16e1f3446",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "Then the river Medway, branching it selfe into five streamlets, is joyned with as many stone Bridges […]"
                                            },
                                            {
                                                "example_id": "b6b7ba32-96d8-466c-8fc4-7f2b00e819e5",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[A] ſtreamlet inviting repoſe / Soft-murmuring vvanders avvay, […]"
                                            },
                                            {
                                                "example_id": "bb80ed02-f049-4a1b-b687-68a23a9f40dd",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[…] the eye, after poring over the unbounded expanse of the ocean, is releaved and delighted by a streamlet and a dell."
                                            },
                                            {
                                                "example_id": "a12fabb7-9f72-46da-8122-5661046f12a2",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "I wanted to jog in leisurely fashion through the green fields and chestnut avenues, over the rushing bubbling streamlets, to join Sylvie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9f2f868-9266-4cfd-af58-89bbd2806c35",
                        "source_entry_id": "ce317430-bf69-3e6a-93b1-0575e2242cea",
                        "source_sense_id": "e1c331bf-c358-3ea3-b351-ba0138859e73",
                        "source_sense_description": "kleiner Bach",
                        "target_lang_word": "ruisselet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruisselet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                        "entry_id": "4bda0501-a18e-31f0-ab9f-ce6e3a41df35",
                                        "glosses": [
                                            "Petit ruisseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d042a76-d3c5-4f08-a29a-2456ecb6affc",
                                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                                "text": "La Ferté-Loupière, agreste village resserré entre deux collines couronnées de bois, assis en pente sur l'une d'elles, ayant à ses pieds une étroite prairie arrosée par le Vrin , ce ruisselet qui prend sa source au Buisson-Saint-Vrin , près de Merry-la-Vallée, pour aller bientôt se perdre dans l'Yonne à Césy, […]."
                                            },
                                            {
                                                "example_id": "6faadeb3-db94-4208-a5b9-ac90582d8381",
                                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                                "text": "Par intervalles, un hibou ricanait et, continus, en sourdine, susurraient le glouglou des ruisselets, la chanterelle des pisselottes, le chuchotis des goutelles."
                                            },
                                            {
                                                "example_id": "a4aeab16-25a1-4b01-b193-f9f79a1380ec",
                                                "sense_id": "4593eee3-af7e-378d-9797-6f2303507121",
                                                "text": "Trois couloirs de perspective s’ouvraient en éventail, chacun avec son groupe, ses jets et ses goulottes, ses descentes d’eau en ruisselets et cascades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
