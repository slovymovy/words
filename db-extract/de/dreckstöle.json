                "senses": [
                    {
                        "sense_id": "e384ae42-6709-3d44-aaf8-544c7e338722",
                        "entry_id": "6ac2aa5b-7fb4-3b77-8478-636c2cdc28fd",
                        "glosses": [
                            "Kraftausdruck für einen verabscheuten Hund"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ba5e7597-6860-4ab3-a505-b02a71479bbd",
                                "sense_id": "e384ae42-6709-3d44-aaf8-544c7e338722",
                                "text": "„Ich bin vielleicht etwas sauer, weil diese Dreckstölen wieder mal den ganzen Kudamm flächendeckend vollgeschissen haben und ich heimtänzeln muss wie Fred Astaire, aber sonst ist eigentlich alles wie immer.“"
                            },
                            {
                                "example_id": "fb762798-e2b9-48ce-9ccd-de1d7a8e12a2",
                                "sense_id": "e384ae42-6709-3d44-aaf8-544c7e338722",
                                "text": "„Vorher hatte er immer nur auf Rufnamen wie Dreckstöle, Mistköter oder Scheißviech reagiert – und zwar mit Flucht.“"
                            },
                            {
                                "example_id": "73bb23c2-bbed-4402-afc1-df43dd67cca1",
                                "sense_id": "e384ae42-6709-3d44-aaf8-544c7e338722",
                                "text": "„Der einzige Ausländer im Dorf ist integriert, der Nazi hat eine Thai-Frau und die Dreckstöle in der Nachbarschaft wurde vom Auto überfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
