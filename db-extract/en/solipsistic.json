                    {
                        "translation_id": "69a4f9ad-bff8-4350-9806-abaf39717a69",
                        "source_entry_id": "45532c65-8485-3657-99c7-cf3c7588e059",
                        "source_sense_description": "self-centered, selfish",
                        "target_lang_word": "egozentrisch",
