                ],
                "translations": [
                    {
                        "translation_id": "c7d3913f-05c4-4b74-ab61-64bf15751102",
                        "source_entry_id": "172240e0-95f7-3148-909b-30bf7121ad75",
                        "source_sense_id": "530c6c14-8610-3b97-852a-5eb49d5bdede",
                        "source_sense_description": "een zeer groot brok ijs dat in de zee drijft",
                        "target_lang_word": "iceberg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iceberg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54cd678b-45e6-3221-b810-52233875e470",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "The seaward end of a glacier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ab1778b-300b-3ef2-849b-34fa04a1431b",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "A huge mass of ocean-floating ice which has broken off a glacier or ice shelf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56143164-04b4-4608-981b-c030d1a454fe",
                                                "sense_id": "2ab1778b-300b-3ef2-849b-34fa04a1431b",
                                                "text": "The Titanic hit an iceberg and sank."
                                            },
                                            {
                                                "example_id": "66e9454b-edb8-4083-9231-93cdb81f36c9",
                                                "sense_id": "2ab1778b-300b-3ef2-849b-34fa04a1431b",
                                                "text": "Clissold the excellent cook, who should have gone with the motor party, tumbled off a small iceberg and concussed himself while posing or 'ponting' as it had come to be known- Griffith Taylor, with his usual wit, had defined 'to pont' as 'to spend a deuce of a time posing in an uncomfortable position'."
                                            },
                                            {
                                                "example_id": "43d376d7-e8e0-42b2-a777-839a6749ccbc",
                                                "sense_id": "2ab1778b-300b-3ef2-849b-34fa04a1431b",
                                                "text": "The passengers still on board were keen to watch as Tessa's crew scrambled for their positions, and she heard jokes about icebergs and devil's triangles, and anxious childish queries answered by soothing adult tones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdc6c3b-1eb2-30e4-8e53-49af7b690ed2",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "An aloof person."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dc8dbaa-7b64-3a20-bf9b-178757606869",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "An impending disastrous event whose adverse effects are only beginning to show."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c9ff2cc-3245-46eb-a8d4-e731db6d417d",
                                                "sense_id": "5dc8dbaa-7b64-3a20-bf9b-178757606869",
                                                "text": "He has little to lose: at present he will go down in history, alongside George W. Bush, as a skipper who ignored the looming fiscal iceberg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a6a369-4ed9-33a1-8820-bc274899aa9e",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "A topic that is more convoluted and fractal than it may seem."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4aede2-a237-4965-b748-ff14328f8a78",
                                                "sense_id": "79a6a369-4ed9-33a1-8820-bc274899aa9e",
                                                "text": "Near-synonym: rabbit hole"
                                            },
                                            {
                                                "example_id": "72cbd39a-e65e-4a4b-b8bd-867ca8c50d51",
                                                "sense_id": "79a6a369-4ed9-33a1-8820-bc274899aa9e",
                                                "text": "Do some digging into that politician's past life and associates, and you'll see that the iceberg runs deep."
                                            },
                                            {
                                                "example_id": "2972bbf0-a4c1-40d9-ae5c-08cb4aa76499",
                                                "sense_id": "79a6a369-4ed9-33a1-8820-bc274899aa9e",
                                                "text": "There's a massive iceberg of increasingly crazy fanfics out there based around those two characters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef8a54c-8049-39cf-a99c-00cbd682f051",
                                        "entry_id": "721ae79c-2f79-3392-9c9b-c113fa162b33",
                                        "glosses": [
                                            "A topic that is more convoluted and fractal than it may seem.",
                                            "A list, infographic, or other enumeration of such a topic and its subcomponents, often ordered into groups sorted by obscurity and bizarreness."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd7c34f8-2f0c-41b2-8627-628bb58b5f73",
                                                "sense_id": "2ef8a54c-8049-39cf-a99c-00cbd682f051",
                                                "text": "Check out the gaming iceberg on this post! There's some really freaky titles there that I've never heard of."
                                            },
                                            {
                                                "example_id": "0168e066-6cfa-416c-b393-942533567e46",
                                                "sense_id": "2ef8a54c-8049-39cf-a99c-00cbd682f051",
                                                "text": "Today we're gonna talk about the Star Wars iceberg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2824232d-c9cb-4751-97d9-f2224463b413",
                        "source_entry_id": "172240e0-95f7-3148-909b-30bf7121ad75",
                        "source_sense_id": "530c6c14-8610-3b97-852a-5eb49d5bdede",
