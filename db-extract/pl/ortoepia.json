                                        "glosses": [
                                            "Manière de prononcer correctement un mot dans une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a16992-99e2-4bbd-9e37-0b8f39801b37",
                                                "sense_id": "1eaa7996-321c-3c13-bbe0-fbf7f2774b5e",
                                                "text": "L’auteur reconnaît dans toute grammaire moderne six parties : l’orthographe, l’étymologie, la syntaxe, la ponctuation, la prosodie et l’orthoépie (recta dictio), qui n’est autre chose que la prononciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1ccab0-f680-3cc4-8154-764630ff2714",
                                        "entry_id": "9d94b5fc-4bac-3a69-8808-3d50b2262b47",
                                        "glosses": [
                                            "Étude de la prononciation correcte des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9de1331-8a70-4851-a20e-0268e9f384a8",
                                                "sense_id": "3e1ccab0-f680-3cc4-8154-764630ff2714",
                                                "text": "L'histoire de cette orthoépie du latin au XVIᵉ siècle est encore mal connue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb421076-0a0c-4880-a5d5-7a628e8462c7",
