                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "15bd966e-035e-3765-8e86-c62121b84d85",
                        "entry_id": "c14b302f-b0fe-344d-890a-07ff84fa594a",
                        "glosses": [
                            "met kracht losmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2251de47-5f13-4e8d-8c98-85528a0ca038",
                                "sense_id": "15bd966e-035e-3765-8e86-c62121b84d85",
                                "text": "Als die dromen ook nog eens volkomen indruisen tegen de lokale mores van bier, bokslessen en opgekropte boosheid, wacht een 12-jarig schoffie een harde strijd om zich te ontrukken aan zijn groezelige geboortegrond."
                            },
                            {
                                "example_id": "b4264744-b7b3-4f5f-9e54-abfd4cd183d7",
                                "sense_id": "15bd966e-035e-3765-8e86-c62121b84d85",
                                "text": "De regisseur is het ermee eens dat ‘Detroit’ een schandvlek in de Amerikaanse geschiedenis is die nooit vergeten mag worden. ,,De film laat deels zien dat racisme in bepaalde Amerikaanse politiekorpsen kennelijk onuitroeibaar is. Daarom is het relevant om het verhaal nu aan de vergetelheid te ontrukken.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee09c9db-c6a1-4949-a4ed-373b0f6f934d",
                        "source_entry_id": "c14b302f-b0fe-344d-890a-07ff84fa594a",
                        "source_sense_id": "15bd966e-035e-3765-8e86-c62121b84d85",
                        "target_lang_word": "extort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                        "entry_id": "50218275-fd22-3d44-91e4-57cac7ac76c8",
                                        "glosses": [
                                            "To take or seize from an unwilling person by physical force, menace, duress, torture, or any undue or illegal exercise of power or ingenuity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfccf09e-c9bd-450a-aff8-1c1799915909",
                                                "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                                "text": "to extort contributions from the vanquished"
                                            },
                                            {
                                                "example_id": "fbdba3a0-8393-4a41-900f-4ede035ab0f5",
                                                "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                                "text": "to extort confessions of guilt"
                                            },
                                            {
                                                "example_id": "63128197-4679-49de-94db-1abd62b9e386",
                                                "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                                "text": "to extort a promise"
                                            },
                                            {
                                                "example_id": "daffd1e1-24c1-4964-807b-ab2886d050c9",
                                                "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                                "text": "to extort payment of a debt"
                                            },
                                            {
                                                "example_id": "77278101-c7c0-4eae-a600-96f5db0f8f91",
                                                "sense_id": "5519b416-244f-3161-baa8-a58d915b48a8",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f7adc1-c43b-3b0a-981f-f6245c86fcbe",
                                        "entry_id": "50218275-fd22-3d44-91e4-57cac7ac76c8",
                                        "glosses": [
                                            "To obtain by means of the offense of extortion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b405f7d-24c7-4f06-9ddb-0f692f5b79ab",
                                                "sense_id": "12f7adc1-c43b-3b0a-981f-f6245c86fcbe",
                                                "text": "Weirdly, Renton doesn’t look too much older and the same also goes for Sick Boy (Jonny Lee Miller), who has exchanged heroin for cocaine and nowadays runs an escort-and-blackmail business, secretly videoing clients and extorting money, working with his female business partner, Veronika (Anjela Nedyalkova)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eaa6fb9-15d2-3e68-a9b9-f68bafe7bba0",
                                        "entry_id": "50218275-fd22-3d44-91e4-57cac7ac76c8",
                                        "glosses": [
                                            "To twist outwards."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "extort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2099e59c-2927-3ed4-889c-a5c62a6be4d9",
                                        "entry_id": "a11331f6-9804-3067-be37-9e816e4c00a0",
                                        "glosses": [
                                            "extorted; obtained by extortion."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9900fcf0-5805-405d-8568-ef288f56936c",
                                                "sense_id": "2099e59c-2927-3ed4-889c-a5c62a6be4d9",
                                                "text": "Hauing great Lordships got and goodly farmes,\nThrough strong oppression of his powre extort."
                                            }
