                "senses": [
                    {
                        "sense_id": "49cbd967-91f5-3fe1-a516-161e473a1a2a",
                        "entry_id": "e8379af7-f8ec-392c-832b-d4737dad1775",
                        "glosses": [
                            "Postérité, tous ceux qui sont venus après une certaine époque, ou qui sont à venir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73613bfe-1b77-4e3f-9311-1e799c34959a",
                                "sense_id": "49cbd967-91f5-3fe1-a516-161e473a1a2a",
                                "text": "Als Li Rui 2019 mit 101 Jahren verstarb, hinterliess der frühere Privatsekretär von Mao Zedong der Nachwelt eine Vielzahl von Tagebüchern und Aufzeichnungen.",
                                "translation": "Lorsque Li Rui est décédé en 2019 à l’âge de 101 ans, l’ancien secrétaire privé de Mao Zedong a laissé à la postérité une multitude de journaux et de notes."
                            },
                            {
                                "example_id": "0d695ae0-0b20-4d61-b081-6f6dcc6a6210",
                                "sense_id": "49cbd967-91f5-3fe1-a516-161e473a1a2a",
                                "text": "Eigentlich muss in den USA jede Korrespondenz des Präsidenten archiviert und für die Nachwelt aufgehoben werden.",
                                "translation": "En fait, aux Etats-Unis, toute la correspondance du président doit être archivée et conservée pour la postérité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
