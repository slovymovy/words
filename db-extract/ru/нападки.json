                        "cross_references": [
                            {
                                "target_word": "attaques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7788977-6106-3ad0-9cc8-3be9a9deab89",
                                        "entry_id": "374f7b81-a2b2-33b2-a6d7-00df5673c7de",
                                        "glosses": [
                                            "Pluriel de attaque."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe90563-50b1-4f9f-add8-9798a3d37d99",
                                                "sense_id": "c7788977-6106-3ad0-9cc8-3be9a9deab89",
                                                "text": "Il y est question de mes oraisons, de mes répétitions, de mes contradictions, de ma prose, de mes jeux de mots, du malheur de ceux qui sont contraints de m’entendre, de mes insinuations, de mes attaques contre les lithotriteurs, etc., mais des objections que je lui ai faites, pas un mot."
                                            },
                                            {
                                                "example_id": "28f43bd1-1c14-4aff-97a3-e32899d6cc3e",
                                                "sense_id": "c7788977-6106-3ad0-9cc8-3be9a9deab89",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune."
                                            }
                                        ]
                                    }
                                ]
                            },
