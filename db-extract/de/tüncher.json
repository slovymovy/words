                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903fae4c-6f7a-4751-81b5-3977ad631d78",
                                "sense_id": "02f15df2-7f19-30e0-92dc-d80540a9cd78",
                                "text": "„Greser, Sohn eines Tünchers, ist mit 13 Jahren der Freiwilligen Dorffeuerwehr beigetreten, wo er heute noch Mitglied ist.“"
                            },
                            {
                                "example_id": "89458cdf-18d6-4a71-8039-8d8a6b939efa",
                                "sense_id": "02f15df2-7f19-30e0-92dc-d80540a9cd78",
                                "text": "„Das Suchen und die Herstellung dieser brauchbaren Materialien nahmen die Maler, Tüncher und andere Handwerker meist selbst vor.“"
                            },
                            {
                                "example_id": "393dbec8-94d1-4e93-a8e3-ecc856217c67",
                                "sense_id": "02f15df2-7f19-30e0-92dc-d80540a9cd78",
                                "text": "„Bereits in der Woche darauf macht sich der Tüncher ans Werk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
