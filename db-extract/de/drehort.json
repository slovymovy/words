                "senses": [
                    {
                        "sense_id": "7b3ef089-5673-38fc-bf6c-15882468c178",
                        "entry_id": "4c4d22e3-8920-377c-920f-4f881b529be8",
                        "glosses": [
                            "Lokation, an der Filmaufnahmen gemacht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420dd645-dc7f-44af-9d6e-e4e116e37e9c",
                                "sense_id": "7b3ef089-5673-38fc-bf6c-15882468c178",
                                "text": "„Der Productiondesigner bzw. Artdesigner konzipiert den visuellen Stil des Sets (Drehort).“"
                            },
                            {
                                "example_id": "9a9ef1d8-ddd3-4f19-8e7b-d44c145c2a9b",
                                "sense_id": "7b3ef089-5673-38fc-bf6c-15882468c178",
                                "text": "„Wenn sich die von Tolkien vorgeschriebenen Schauplätze nicht an realen Drehorten finden ließen, baute man mit unglaublicher Liebe zum Detail 68 Miniatur-Sets.“"
                            },
                            {
                                "example_id": "1ccc4be0-03b5-48f9-8903-49eaa5b6966b",
                                "sense_id": "7b3ef089-5673-38fc-bf6c-15882468c178",
                                "text": "„Immer neue Busse brachten Invaliden, blonde Studentinnen und kampferprobte junge Männer an den Drehort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db27a88c-e3ea-40f7-a685-1e2dba7e45cf",
                        "source_entry_id": "4c4d22e3-8920-377c-920f-4f881b529be8",
                        "source_sense_id": "7b3ef089-5673-38fc-bf6c-15882468c178",
                        "source_sense_description": "Lokation, an der Filmaufnahmen gemacht werden",
                        "target_lang_word": "location",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "location",
