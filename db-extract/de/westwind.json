                        ],
                        "form": "den Westwind"
                    },
                    {
                        "form_id": "b269621d-42a3-4c9f-8068-f8de1bfe98d7",
                        "entry_id": "ef272f3d-5e82-3dbb-9d04-f1ef7f1581ff",
                        "tags": [
                            "accusative",
