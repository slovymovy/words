                ],
                "senses": [
                    {
                        "sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                        "entry_id": "ab6b15be-028e-3147-8e81-4725e7dd383c",
                        "glosses": [
                            "Händler, der auf einem Markt lauthals, in aufdringlicher, unangenehmer Art für seine Waren wirbt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "247377fc-9fa2-4ce8-934b-24589d6bec94",
                                "sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                                "text": "„Es gibt nichts Komischeres als diese Marktschreier. Bis zur Raserei steigert sich ihr Geschäftseifer, es scheint, als ob sich ein Kampf auf Leben und Tod zwischen den verschiedenen Konkurrenten entwickle. Die ruhigen, kalten Engländer kennt man nicht wieder, man glaubt betrunkene Italiener oder Franzosen zu sehen, welche sich untereinander erdolchen wollen; […].“"
                            },
                            {
                                "example_id": "140386e6-4067-4514-ac22-1f7da45d3b7e",
                                "sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                                "text": "„Noch bis zum Sonntag macht der Hamburger Fischmarkt in München Station. Die Marktschreier aus dem Norden sorgen mit Fischbrötchen und Küstennebel für Waterkantgefühl auf dem Wittelsbacher Platz.“"
                            },
                            {
                                "example_id": "52bf4c43-a790-4315-82fc-b75d89e46aac",
                                "sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                                "text": "„Man vergisst dies im Licht der sich überschlagenden Ereignisse gern, aber lange, bevor er in die Politik ging, hatte Trump als Marktschreier bereits das Millionenpublikum erobert, das nun Basis seiner Macht ist.“"
                            },
                            {
                                "example_id": "53d67052-ba4b-4f1b-8161-8496012de1ef",
                                "sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                                "text": "„Nachdem Johann Georg Hamann sich in einem Gasthaus eingemietet und eine Kanne schwarzen Tee getrunken hatte, nahm er eine Kutsche und fuhr hinaus zu einem Marktschreier in Islington, der, wie er von einem Reisenden gehört hatte, sämtliche Sprachfehler zu beheben in der Lage sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "907c3fe2-c0b4-4497-ba69-7404fd1ed6bd",
                        "source_entry_id": "ab6b15be-028e-3147-8e81-4725e7dd383c",
                        "source_sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
                        "source_sense_description": "Händler, der auf einem Markt lauthals, in aufdringlicher, unangenehmer Art für seine Waren wirbt",
                        "target_lang_word": "barker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6025235-b3ff-38de-b2d9-46a31acebdd6",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "Someone or something who barks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76fed877-aaef-4871-bf42-26d052718df7",
                                                "sense_id": "d6025235-b3ff-38de-b2d9-46a31acebdd6",
                                                "text": "My neighbor's dog is a constant barker that keeps me awake at night."
                                            },
                                            {
                                                "example_id": "b127fac9-13de-4edb-925e-e5660a2f3ae1",
                                                "sense_id": "d6025235-b3ff-38de-b2d9-46a31acebdd6",
                                                "text": "Edmund was barker on sight, like foolish stay-at-home dogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab7078f3-8f7b-3fe9-b01d-7d13b4296d78",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "A person employed to solicit customers by calling out to passersby, e.g. at a carnival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae09d54d-00d3-4203-ae1b-8bfff9a86bbb",
                                                "sense_id": "ab7078f3-8f7b-3fe9-b01d-7d13b4296d78",
                                                "text": "Bob had amassed a considerable stockpile of double entendres from his days working as a barker for a strip joint."
                                            },
                                            {
                                                "example_id": "e3680355-c5ed-4011-a127-4595587c4456",
                                                "sense_id": "ab7078f3-8f7b-3fe9-b01d-7d13b4296d78",
                                                "text": "[…"
                                            },
                                            {
                                                "example_id": "0db79d17-e854-4ddf-8d74-b0ee1b05dee5",
                                                "sense_id": "ab7078f3-8f7b-3fe9-b01d-7d13b4296d78",
                                                "text": "For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae86b889-cdb8-33d7-a2da-c05bd4f90953",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "A shelf-talker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d28502f3-218b-36c6-a339-7308056068d0",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "A video game mode where the action is demonstrated to entice someone to play the game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23dcd503-eb4d-4019-bfd1-2798f9da9a6d",
                                                "sense_id": "d28502f3-218b-36c6-a339-7308056068d0",
                                                "text": "The barker looks action-packed, but actually playing the game is rather dull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a113558-c718-3210-bc4c-c96b1bf78e62",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "A pistol."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6652d47d-e1a0-44fc-88bb-58c031db028e",
                                                "sense_id": "2a113558-c718-3210-bc4c-c96b1bf78e62",
                                                "text": "Barney, opening a cupboard, brought forth several articles, which he hastily crammed into the pockets.\n“Barkers for me, Barney,\" said Toby Crackit.\n“Here they are,” replied Barney, producing a pair of pistols."
                                            },
                                            {
                                                "example_id": "0e0fd8d1-4a80-4c04-b9ca-686edccb018e",
                                                "sense_id": "2a113558-c718-3210-bc4c-c96b1bf78e62",
                                                "text": "Parkin, the Oxford Street gunmaker, sent me a brace of barkers in silver mountings, with my initials engraved—good for trade, I imagine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee17ae22-0385-33e5-a2e4-bcdc46dcd20a",
                                        "entry_id": "25a6ecb7-f2bf-3105-9e38-7d90e4a091dc",
                                        "glosses": [
                                            "The spotted redshank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "barker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66611ce4-701f-32e9-8ea2-c30a072994c2",
                                        "entry_id": "58040de8-aa00-3eae-9cad-54388e4518da",
                                        "glosses": [
                                            "A person who removes needed or valuable tree bark, as on a cinnamon or cinchona plantation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1f4b48-82a1-4b07-a20f-1855fb335516",
                                                "sense_id": "66611ce4-701f-32e9-8ea2-c30a072994c2",
                                                "text": "The profession of barker has been made largely obsolete by the realization that in most cases saplings can be cultivated far more profitably."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b158aeb0-9dd4-30d5-81c8-247ce597a881",
                                        "entry_id": "58040de8-aa00-3eae-9cad-54388e4518da",
                                        "glosses": [
                                            "A tanner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38fc94c2-3588-4e93-a7a9-0009ef3e5efb",
                                                "sense_id": "b158aeb0-9dd4-30d5-81c8-247ce597a881",
                                                "text": "The profession of barker has been made largely obsolete by the introduction of more effective tanning agents, but it lives on as a surname."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170863f4-bf0e-3b2c-87a3-9bc8b5a85792",
                                        "entry_id": "58040de8-aa00-3eae-9cad-54388e4518da",
                                        "glosses": [
                                            "A machine used to remove unneeded bark from wood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337555e7-0b99-404c-8a4a-944881695413",
                                                "sense_id": "170863f4-bf0e-3b2c-87a3-9bc8b5a85792",
                                                "text": "Run these logs through the barker so we can use them as fence posts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f9f7d8-ea38-4104-88cf-751de928b879",
                        "source_entry_id": "ab6b15be-028e-3147-8e81-4725e7dd383c",
                        "source_sense_id": "0cafb42e-0d85-3422-8274-63f8e7a3eff1",
