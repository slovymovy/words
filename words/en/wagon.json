                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "магазинная корзина на колесах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d1ae14-2b93-3908-ae3e-08f663b03f80",
                    "sense_definition": "A police van used for transporting prisoners.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspects were handcuffed and led into the back of the <w>wagon</w>.",
                            "target_lang_translations": {
                                "ru": "На подозреваемых надели наручники и отвели в заднюю часть <w>автозака</w>."
                            }
                        },
                        {
                            "text": "A paddy <w>wagon</w> waited outside the building to take the protesters away.",
                            "target_lang_translations": {
                                "ru": "Снаружи здания ждал <w>воронок</w>, чтобы увезти протестующих."
                            }
                        }
                    ],
                    "synonyms": [
                        "paddy wagon",
                        "police van"
                    ],
                    "common_phrases": [
                        "police wagon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'paddy wagon'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский фургон, используемый для перевозки заключенных."
