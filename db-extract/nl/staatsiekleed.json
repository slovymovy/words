                        "examples": [
                            {
                                "example_id": "3e43c96a-0b40-4805-bffc-1168952992a7",
                                "sense_id": "9d7c2b89-e52a-3ff9-bfe5-3708cbf1c455",
                                "text": "De Merlijn, gekleed in zijn witte staatsiekleed, kwam naar voren; naast de eerbiedwaardige Bisschop van Glastonbury zag hij er mild en vriendelijk uit."
                            },
                            {
                                "example_id": "6bbbedd5-af21-4728-9e56-fc0bf572fa94",
                                "sense_id": "9d7c2b89-e52a-3ff9-bfe5-3708cbf1c455",
                                "text": "De keizer vroeg hem ter plaatse de wapenrusting af te leggen en deed hem een staatsiekleed omhangen dat met goud en parels bestikt was en tot aan de grond reikte om hem voor een verkoudheid te behoeden."
                            }
                        ]
                    }
