                "senses": [
                    {
                        "sense_id": "832bb623-cfb5-348f-b3f7-540678a4e4c0",
                        "entry_id": "7b49fd72-95fb-3011-a33c-d353bc088e64",
                        "glosses": [
                            "maszyna rozdrabniająca wykorzystująca proces kruszenia do wytwarzania kruszywa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8544ded-e8c7-4bbf-83a1-38b08e813025",
                                "sense_id": "832bb623-cfb5-348f-b3f7-540678a4e4c0",
                                "text": "Kruszarki można podzielić na cztery główne rodzaje."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c49fc5b-0c38-4eda-870d-a56711106f6a",
                        "source_entry_id": "7b49fd72-95fb-3011-a33c-d353bc088e64",
                        "source_sense_id": "832bb623-cfb5-348f-b3f7-540678a4e4c0",
                        "target_lang_word": "crusher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crusher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a18836-1aeb-304a-8cf8-1e0fc2a4a8b5",
                                        "entry_id": "78891a22-34a6-37eb-9d3d-2bd3c08b1397",
                                        "glosses": [
                                            "Someone or something that crushes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148df623-fb66-4a4d-934f-38c84d777bff",
                                                "sense_id": "e1a18836-1aeb-304a-8cf8-1e0fc2a4a8b5",
                                                "text": "[…] for unless a matter be true enough to stand a good deal of misrepresentation, its truth is not of a very robust order, and the blame will rather lie with its own delicacy than with the carelessness of the crusher."
                                            },
                                            {
                                                "example_id": "fad9d4b1-6a5f-467f-acc5-444ea5458c09",
                                                "sense_id": "e1a18836-1aeb-304a-8cf8-1e0fc2a4a8b5",
                                                "text": "Woe unto every backbiter, slanderer, who has gathered riches and counted them over thinking his riches have made him immortal! ¶ No indeed, he shall be thrust into the Crusher, and what shall teach thee what is the Crusher?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7186e0d8-26be-31c5-9415-174593e2b1b8",
                                        "entry_id": "78891a22-34a6-37eb-9d3d-2bd3c08b1397",
                                        "glosses": [
                                            "A machine designed to crush rocks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "571a14e6-f720-341d-a857-525614c65e3f",
                                        "entry_id": "78891a22-34a6-37eb-9d3d-2bd3c08b1397",
                                        "glosses": [
                                            "A policeman."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7290cb9-6bc7-41de-a901-3f6ed0f7373a",
                                                "sense_id": "571a14e6-f720-341d-a857-525614c65e3f",
                                                "text": "Anything about the police sets them a talking at once. […] 'The blessed crushers are everywhere,' shouted one. 'I wish I'd been there to have had a shy at the eslops,' said another. And then a man sung out: 'O, don't I like the Bobbys?'"
                                            },
                                            {
                                                "example_id": "5215465a-e123-4c15-b2ad-73f91108991f",
                                                "sense_id": "571a14e6-f720-341d-a857-525614c65e3f",
                                                "text": "Back in the lobby he bought a copy of Time but didn't like the way the plain-clothes crushers looked at him, and left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9bbaa97-7fd8-3182-a45f-b86227c4f4b4",
                                        "entry_id": "78891a22-34a6-37eb-9d3d-2bd3c08b1397",
                                        "glosses": [
                                            "Something overwhelming."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf234f2-3bfe-4668-be93-aafa0b74fc1f",
                                                "sense_id": "b9bbaa97-7fd8-3182-a45f-b86227c4f4b4",
                                                "text": "“She is a crusher, ain’t she now!” Mr. Foker asked of his companion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7df12d6a-4008-42da-bd87-f1a14257f2ab",
                        "source_entry_id": "7b49fd72-95fb-3011-a33c-d353bc088e64",
                        "source_sense_id": "832bb623-cfb5-348f-b3f7-540678a4e4c0",
                        "target_lang_word": "Brecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "681fe0c7-e3d4-3514-bb32-d98594f3d5bb",
                                        "entry_id": "d8afc046-af70-3836-8070-6e90bbae1563",
                                        "glosses": [
                                            "hohe, starke Welle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57124575-8ca3-4e43-bb0e-3689c7102980",
                                                "sense_id": "681fe0c7-e3d4-3514-bb32-d98594f3d5bb",
                                                "text": "„Ohne diese Sicherung hätten uns die Brecher, die unablässig an unserem Boot zerrten und uns manchmal sogar überrollten, wie Strohhalme über Bord gespült.“"
                                            },
                                            {
                                                "example_id": "8b9da54f-e5ee-4351-8f9f-f8f279d03302",
                                                "sense_id": "681fe0c7-e3d4-3514-bb32-d98594f3d5bb",
                                                "text": "„Er trat in den Morgendunst hinaus und ließ seine Augen über die Bucht schweifen, wo jetzt 15 Schiffe in der relativ ruhigen Dünung jenseits der Brecher dümpelten.“"
                                            },
                                            {
                                                "example_id": "d3a86e59-6b7d-4410-87b0-b49677168a8f",
                                                "sense_id": "681fe0c7-e3d4-3514-bb32-d98594f3d5bb",
                                                "text": "„Eine Minute oder länger ging alles einigermaßen gut, doch dann erfasste ein Brecher den Bug der Jolle, richtete sie fast senkrecht auf und drehte sie anschließend mit dem Kiel nach oben.“"
                                            },
                                            {
                                                "example_id": "e720faca-f814-4a5d-90db-47396d6678f8",
                                                "sense_id": "681fe0c7-e3d4-3514-bb32-d98594f3d5bb",
                                                "text": "„Die Küste war schroff, felsig, hatte nichts Liebliches und stand in voller Konzentration zu den heranrollenden Brechern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1489a90c-0cce-3b50-a6ae-48a994d27cf2",
                                        "entry_id": "d8afc046-af70-3836-8070-6e90bbae1563",
                                        "glosses": [
                                            "Maschine zum Zerkleinern von harten Materialien, meist Gestein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04fede6-3670-4dd1-9573-2276e5629ac4",
                                                "sense_id": "1489a90c-0cce-3b50-a6ae-48a994d27cf2",
                                                "text": "Ein Brecher wird dazu benutzt, um grobes Gestein in Schotter von gleichmäßiger Größe umzuwandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8892cd1-15ac-4429-b13f-a5586b90ea2b",
                        "source_entry_id": "7b49fd72-95fb-3011-a33c-d353bc088e64",
                        "source_sense_id": "832bb623-cfb5-348f-b3f7-540678a4e4c0",
                        "target_lang_word": "дробилка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дробилка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "65b37ff2-6fdf-3471-afba-41282d301d01",
                                        "entry_id": "7781ce1e-e152-37c7-872e-f0f98fa0e8a5",
                                        "glosses": [
                                            "машина для дробления твёрдых материалов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74ca0e2-3fa0-4cf5-9ac2-51dd9ba2f9a4",
                                                "sense_id": "65b37ff2-6fdf-3471-afba-41282d301d01",
                                                "text": "Какая-нибудь дробилка для камня или костей тогда только действует правильно и выгодно, когда движется сильным, а не слабым двигателем и требует поэтому для выгодности действия громадной массы сырья, так что дробить переделку на мелкие заводы оказывается весьма невыгодным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
