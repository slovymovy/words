                        "glosses": [
                            "Spiel, bei dem es etwas zu gewinnen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92310ee8-b053-4d50-ae0b-0344126edcad",
                                "sense_id": "34db43db-439c-3fa1-8f61-d2abc175750d",
                                "text": "Er hat 500 Euro bei einem Gewinnspiel im Fernsehen gewonnen."
                            }
                        ],
