                    {
                        "translation_id": "97e7b692-53bf-4e4a-86bd-ed4a762320d5",
                        "source_entry_id": "b023aa88-3cc4-3460-8f47-c5e034386d9c",
                        "source_sense_id": "f1616712-a6fc-3b50-b771-5184fdb46d81",
                        "target_lang_word": "Defekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Defekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52103eb0-4215-301f-aed5-1d5384c87f08",
                                        "entry_id": "6dda9fef-9aeb-371c-84a9-68463c2d12ea",
                                        "glosses": [
                                            "fehlerhafte Stelle, Funktionsfehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "575372ea-0102-4b60-90ee-06ef32812dae",
                                                "sense_id": "52103eb0-4215-301f-aed5-1d5384c87f08",
                                                "text": "Das Gerät hat einen Defekt."
                                            },
                                            {
                                                "example_id": "65092c61-43db-4e62-8ee3-1c56225f2748",
                                                "sense_id": "52103eb0-4215-301f-aed5-1d5384c87f08",
                                                "text": "Der Defekt in der Oberfläche hat den Schaden ausgelöst."
                                            },
                                            {
                                                "example_id": "279c562c-bcf7-45ae-9e9d-37dd4d3367c6",
                                                "sense_id": "52103eb0-4215-301f-aed5-1d5384c87f08",
                                                "text": "„Zusammen mit Reichtum und Landgewinn brachte ihnen das jede Menge genetischer Defekte ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2238c3c-1f62-47fe-ae63-30532283ab2f",
                        "source_entry_id": "b023aa88-3cc4-3460-8f47-c5e034386d9c",
                        "source_sense_id": "f1616712-a6fc-3b50-b771-5184fdb46d81",
                        "target_lang_word": "defect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8c64dc-456e-38c1-b2bf-99a83db8dac7",
                                        "entry_id": "3b614aac-e97b-308d-bd7c-73ff311540e1",
                                        "glosses": [
                                            "A fault or malfunction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537caf5b-5f61-4d86-a2f8-7d8bc75be4b8",
                                                "sense_id": "cd8c64dc-456e-38c1-b2bf-99a83db8dac7",
                                                "text": "a defect in the ear or eye; a defect in timber or iron; a defect of memory or judgment"
                                            },
                                            {
                                                "example_id": "e2a994ef-26c0-4b1b-b451-b80615ea12d0",
                                                "sense_id": "cd8c64dc-456e-38c1-b2bf-99a83db8dac7",
                                                "text": "Among boys little tenderness is shown to personal defects."
                                            },
                                            {
                                                "example_id": "c4617c8f-30bd-429e-ab5d-fb8d356dff6d",
                                                "sense_id": "cd8c64dc-456e-38c1-b2bf-99a83db8dac7",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            },
                                            {
                                                "example_id": "1a293f41-f1a8-4acc-b14e-179252ae30d1",
                                                "sense_id": "cd8c64dc-456e-38c1-b2bf-99a83db8dac7",
                                                "text": "Another major defect of the current literature dealing with the nomenclature of hybrid forms of English is the scant attention paid to the question of frequency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a13f27a-d75d-348f-9ebb-2662419e1431",
                                        "entry_id": "3b614aac-e97b-308d-bd7c-73ff311540e1",
                                        "glosses": [
                                            "The quantity or amount by which anything falls short."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28989c31-21ca-426d-a7a6-f8858f80b736",
                                                "sense_id": "4a13f27a-d75d-348f-9ebb-2662419e1431",
                                                "text": "and the indefatigable application with which they have supplied the defects of early culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29deff3a-12f6-3bea-8361-3fcd73d4862b",
                                        "entry_id": "3b614aac-e97b-308d-bd7c-73ff311540e1",
                                        "glosses": [
                                            "A part by which a figure or quantity is wanting or deficient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "defect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2a4ce2-6aa7-366e-b9a6-3dbdc4f0485b",
                                        "entry_id": "29a16a4f-cb29-3b44-938b-dfddb1bbca40",
                                        "glosses": [
                                            "To abandon or turn against; to cease or change one's loyalty, especially from a military organisation or political party."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17dac673-cb7f-4a52-86d9-76593fcbd771",
                                                "sense_id": "1c2a4ce2-6aa7-366e-b9a6-3dbdc4f0485b",
                                                "text": "Capitalizing on the restive mood, Mr. Farage, the U.K. Independence Party leader, took out an advertisement in The Daily Telegraph this week inviting unhappy Tories to defect. In it Mr. Farage sniped that the Cameron government — made up disproportionately of career politicians who graduated from Eton and Oxbridge — was “run by a bunch of college kids, none of whom have ever had a proper job in their lives.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9d02a05-14c5-3c77-9013-fe5675315383",
                                        "entry_id": "29a16a4f-cb29-3b44-938b-dfddb1bbca40",
                                        "glosses": [
                                            "To desert one's army, to flee from combat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce63c161-ba21-38c1-80bd-865c43141094",
                                        "entry_id": "29a16a4f-cb29-3b44-938b-dfddb1bbca40",
                                        "glosses": [
                                            "To join the enemy army."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a638397b-e07f-3776-9152-a9d28905f2e3",
                                        "entry_id": "29a16a4f-cb29-3b44-938b-dfddb1bbca40",
                                        "glosses": [
                                            "To flee one's country and seek asylum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c31174-bb02-4e22-a9c3-1468a34ed3aa",
                                                "sense_id": "a638397b-e07f-3776-9152-a9d28905f2e3",
                                                "text": "Passing through Thailand, she submitted a handwritten statement agreeing to defect, a requirement for North Korean refugees to be allowed to enter the South."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec4dba9f-a324-48f6-a395-c9b4fb1475c9",
                        "source_entry_id": "b023aa88-3cc4-3460-8f47-c5e034386d9c",
                        "source_sense_id": "f1616712-a6fc-3b50-b771-5184fdb46d81",
                        "target_lang_word": "défaillance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défaillance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "788865f5-5903-3834-8947-9739fb0c8aaa",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Perte momentanée des forces physiques accompagnée souvent d’une perte de connaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef923f9a-2922-4929-bfa9-af2e6585b903",
                                                "sense_id": "788865f5-5903-3834-8947-9739fb0c8aaa",
                                                "text": "Tomber en défaillance."
                                            },
                                            {
                                                "example_id": "f6683afb-84a9-4819-b25e-6d069d0a4f9c",
                                                "sense_id": "788865f5-5903-3834-8947-9739fb0c8aaa",
                                                "text": "Il lui a pris une défaillance."
                                            },
                                            {
                                                "example_id": "86769d7d-b67e-4b69-bd88-260245409535",
                                                "sense_id": "788865f5-5903-3834-8947-9739fb0c8aaa",
                                                "text": "Avoir de fréquentes défaillances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21ae2a9f-46e2-3fd0-9f5a-6eba7dad714c",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Perte momentanée des forces morales."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d91eb55-cdf3-4af9-b7f2-ccbae3695b5d",
                                                "sense_id": "21ae2a9f-46e2-3fd0-9f5a-6eba7dad714c",
                                                "text": "Céline Thiébault était alors une jeune fille « bienfaisante », une de ces grandes filles brunes qui paraissent vingt ans au lieu de quinze, […]. Autour de ces créatures, trop vite aoûtées, ce qu'il peut roder d'appétits et combien le péché les guette à la moindre défaillance, je le sais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca25df2-a723-3914-a376-b967a60150d8",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Fait de faire défaut."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c068df-81a6-4428-a952-5d43f0a0572d",
                                                "sense_id": "6ca25df2-a723-3914-a376-b967a60150d8",
                                                "text": "Celui-ci voit dans les causes profondes de ce malaise la défaillance des politiques publiques : moyens « notoirement insuffisants », réformes « insuffisamment pensées de façon systémique », trop souvent envisagées comme « des rustines visant à gérer les flux dans un contexte de sous-dotation », comme la déjudiciarisation de certains contentieux qui « ne saurait constituer le socle d’une politique judiciaire » et qui a aujourd’hui « atteint ses limites »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8968f9-9a02-3b6f-9d4f-e85b11f68a24",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Éclipse, en parlant d'un astre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "949e7e7c-9a3b-31d5-880d-da5f0620b436",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Cessation de l’aptitude d’une unité fonctionnelle, d'un organe à accomplir une fonction requise."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158b54c2-40a1-4c0f-9c13-5800ba606e42",
                                                "sense_id": "949e7e7c-9a3b-31d5-880d-da5f0620b436",
                                                "text": "Le phosphure de zinc employé comme rodenticide puissant produit en général des lésions nécrotiques ou rénales et entraîne la mort par défaillance cardiaque."
                                            },
                                            {
                                                "example_id": "712d8bbf-f3cf-4d91-b55e-02a976ec6750",
                                                "sense_id": "949e7e7c-9a3b-31d5-880d-da5f0620b436",
                                                "text": "Il a dû abandonner la course suite à la défaillance de la boîte de vitesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef31100-ce8e-37c2-9e28-6fdba26194c7",
                                        "entry_id": "d5caeb7b-d0a6-3c79-9f2a-b5080ed319d9",
                                        "glosses": [
                                            "Cessation d’activité ou difficulté en cours d’exécution d’un contrat."
                                        ],
                                        "tags": [
                                            "Marché public"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e21a1b-df90-4ea3-ab27-745277d06d17",
                                                "sense_id": "9ef31100-ce8e-37c2-9e28-6fdba26194c7",
                                                "text": "L’entreprise peut anticiper ce risque commercial en présentant un prix plus élevé, ou, au contraire, si elle sous-estime le risque, proposer un prix qui n’absorbera pas durablement la charge financière induite ce qui peut entraîner, à terme, la défaillance de l’entreprise ou une diminution de la qualité des prestations en dessous du minimum acceptable au titre du marché."
                                            },
                                            {
                                                "example_id": "4a91f609-da21-4e8d-b021-63ee15cfc921",
                                                "sense_id": "9ef31100-ce8e-37c2-9e28-6fdba26194c7",
                                                "text": "Pour assurer la poursuite de l’exécution des marchés publics touchés par ces difficultés et éviter le risque de défaillance de leurs titulaires, vous demanderez à vos services de veiller à aménager les conditions d’exécution des contrats en cours conformément aux principes rappelés ci-après."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
