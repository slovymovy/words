                    {
                        "translation_id": "a149698f-866a-4ac4-a082-b1fd33e03157",
                        "source_entry_id": "c15d1d68-d591-3d09-a8e5-b1c563743ce8",
                        "source_sense_id": "11189c13-10c9-3955-bc99-4a34d347802f",
                        "target_lang_word": "Popularität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Popularität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                        "entry_id": "0e0bb8a7-5644-3659-a5ce-f58e0018bfb6",
                                        "glosses": [
                                            "die Eigenschaft, bekannt und beliebt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635bdb46-10f4-4127-a65f-068ea2b766bb",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "Fußball erfreut sich großer Popularität."
                                            },
                                            {
                                                "example_id": "cde4faf2-4c3a-4caf-bcff-43ed81757ddf",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                                            },
                                            {
                                                "example_id": "38deec6d-5118-4a73-a99b-a89433eca0c2",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Die ungebrochene Popularität Buschs beruht darauf, dass seine geflügelten Worte bei denen, für die sie gemeint waren, auf behagliche Zustimmung stoßen, bei allen anderen auf das erwartete satirische Vergnügen am Spießigen.“"
                                            },
                                            {
                                                "example_id": "120ad519-5eaf-4631-aa54-e1347d0d0183",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Teneriffa gab Janosch die Möglichkeit, sich von seiner Popularität zu erholen.“"
                                            },
                                            {
                                                "example_id": "7696d953-8509-46bc-966c-1e4f89906eb0",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Dahlerup genoss bei weitem nicht die Popularität seines Vorgängers Pløyen, eher im Gegenteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "917892d5-5523-493e-a52f-605634149506",
                        "source_entry_id": "c15d1d68-d591-3d09-a8e5-b1c563743ce8",
