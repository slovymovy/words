                    "sense_id": "3eae68c9-3e58-3976-97da-52c722e9d1ac",
                    "sense_definition": "sich unsicher oder hin und her bewegen, ohne festen Halt stehen oder gehen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der langen Fahrt mit dem Boot <w>schwankte</w> der Fischer noch auf dem festen Steg."
                        },
                        {
                            "text": "Die hohen Bäume <w>schwankten</w> während des heftigen Sturms gefährlich hin und her."
                        }
                    ],
                    "synonyms": [
                        "taumeln",
                        "wanken",
                        "pendeln"
                    ],
                    "antonyms": [
                        "stillstehen"
                    ],
                    "common_phrases": [
