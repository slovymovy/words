                ],
                "senses": [
                    {
                        "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                        "entry_id": "c3726a8d-91f6-3002-b80c-89249b066286",
                        "glosses": [
                            "widerliche, erbärmliche Person"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d3e9843b-c576-444c-ada8-d6a4dfdd4c88",
                                "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                                "text": "„Aber da sich diese Schweinehunde gegenseitig nicht trauen, können wir davon ausgehen, dass er nicht alle Informationen, die er über uns hatte, an die anderen Scheißtypen weiterleitete, und dass die noch irgendwo sein müssen.“"
                            },
                            {
                                "example_id": "f0684678-99b8-4898-b6ec-e7fca36ae00e",
                                "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                                "text": "„›Der beste Stoff, klar, Mann? Und wer sagt dir, wo die Scheißtypen in Accra hängen?‹“"
                            },
                            {
                                "example_id": "fee58505-0b91-4d0e-af64-94e3da20abe1",
                                "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                                "text": "„Dort rutschte er herab und rief ihr - sein Mund hörte sich geschwollen an - lauthals zu: ›Z! Erschieß den Scheißtyp! Jetzt!‹“"
                            },
                            {
                                "example_id": "adb784a5-dc77-4566-80a5-9b48195a33b9",
                                "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                                "text": "„Normalerweise hätte er mit einem gegrummelten Jissis! diese irren Urlauber verwünscht, vor allem die Scheißtypen aus Gauteng, die mit ihren dicken Portemonnaies im nagelneuen BMW so schnell wie möglich hinunter ans Kap jagten, um dort ihr Weihnachtsgeld zu verbraten.“"
                            },
                            {
                                "example_id": "55932ec6-7d46-44ce-8578-4400c1d4e51f",
                                "sense_id": "b5977631-e8af-3a0a-bc98-6c8ada3de4f0",
                                "text": "„›Das gibt es doch nicht, du Scheißtyp.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
