        "nl-extract.jsonl": [
            {
                "entry_id": "4d5fbf07-0f01-34b0-a558-f7cdc272279e",
                "word": "afkappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a59497b-3852-3880-a09b-0fe8fe50db61",
                        "entry_id": "4d5fbf07-0f01-34b0-a558-f7cdc272279e",
                        "glosses": [
                            "op een heldere duidelijke manier ergens een einde aan maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "340e51fb-bf96-44e7-9cc3-3976dab2b80f",
                                "sense_id": "5a59497b-3852-3880-a09b-0fe8fe50db61",
                                "text": "Denk aan hoe Stolpersteine, bronzen gedenkstenen in de stoep, je onverwacht even wijzen op afgevoerde Joden in de Tweede Wereldoorlog. Of kijk hoe oude spoorrails uit industriële tijden in stadswijken herinneren hoe anders deze buurt ooit was. Dat zijn effectieve methodes: het gewone leven ineens - pats - afkappen door herinneringen aan vroeger. Dat kan bij kunst op straat, en het kan ook binnen."
                            },
                            {
                                "example_id": "031c07ee-f7d8-4fd9-83f1-3b16153e78c8",
                                "sense_id": "5a59497b-3852-3880-a09b-0fe8fe50db61",
                                "text": "Dan zou ze het snel hebben afgekapt en tot de orde van de dag zijn overgegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "b25a19a8-0d7c-3755-80bd-c52349560883",
                        "entry_id": "4d5fbf07-0f01-34b0-a558-f7cdc272279e",
                        "glosses": [
                            "ergens een stuk van af hakken zodat het kleiner wordt en een duidelijke grens heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07690408-0aaf-45e0-b4e4-4f59e6f6ec2f",
                                "sense_id": "b25a19a8-0d7c-3755-80bd-c52349560883",
                                "text": "Toen Portegies Zwart rekening ging houden met de broertjes en zusjes van de zon, kon hij één deel van die complexe toestand direct verklaren - het feit dat de Kuipergordel eindigt op zo’n veertigmaal de afstand van de aarde tot de zon. Of zoals astronomen het zeggen: op een afstand van 40 Astronomische Eenheden (AE). Al in 2009 publiceerde Portegies Zwart in het vakblad The Astronomical Journal zijn oplossing. „Ik denk dat een ander planetenstelsel het zonnestelsel op 40 AE heeft afgekapt”, zegt hij."
                            }
                        ]
                    }
                ],
