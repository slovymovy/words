                "senses": [
                    {
                        "sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                        "entry_id": "a85204c2-7b3f-32c9-883f-339e68474f3f",
                        "glosses": [
                            "oberer Teil eines Anschreibens, in dem Informationen zu Absender und Empfänger stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2b5422-3b99-429f-8726-6d1bb67b9aa8",
                                "sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                                "text": "Im 19. Jahrhundert kamen dekorativ gestaltete Briefköpfe in Mode."
                            },
                            {
                                "example_id": "f675d4fe-e91b-4150-a57d-7cf664251131",
                                "sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                                "text": "„Anfang Januar war unter dem Briefkopf der Polizeidirektion Passau von einem ‚Familiendrama‘ die Rede, doch die Schreiben an Redaktionen erwiesen sich als gefälscht.“"
                            },
                            {
                                "example_id": "1f7c3ed0-b0db-424d-9065-a660892cbe57",
                                "sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                                "text": "„Im Briefkopf steht zwischen Orts- und Datumsangabe im Allgemeinen ein Komma.“"
                            },
                            {
                                "example_id": "75679417-0549-463e-97fa-51be9e7eba06",
                                "sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                                "text": "„Dieser verschickte als Vorsitzender vereinsinterne Einladungen mit dem Briefkopf des Bürgermeisters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
