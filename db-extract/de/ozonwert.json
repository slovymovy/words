                                "example_id": "9b8c6d70-6157-48d0-b44a-061e6dd5f760",
                                "sense_id": "27f764e4-388e-31eb-a3ed-ab2fbaad7d39",
                                "text": "„Die Stadt Genf leidet unter hohen Ozonwerten.“"
                            }
                        ],
