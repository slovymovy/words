                ],
                "senses": [
                    {
                        "sense_id": "ed02f4b6-7f34-379e-acab-590f2ce99c66",
                        "entry_id": "1254dde3-0735-31e6-a86d-362236491ec4",
                        "glosses": [
                            "eine Sorte von Wein; eine Art von Wein, die sich durch bestimmte einheitliche Merkmale von anderen Arten unterscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52943751-29cf-43de-a054-3e6ec4a67efb",
                                "sense_id": "ed02f4b6-7f34-379e-acab-590f2ce99c66",
                                "text": "Das kleine Bistrot hatte nur zwei Weinsorten im Angebot."
                            },
                            {
                                "example_id": "cc8960fa-747f-4462-a120-af24b2f336e7",
                                "sense_id": "ed02f4b6-7f34-379e-acab-590f2ce99c66",
                                "text": "„Auf einem angebundenen Zettel aber stand: ‚Herrn Major von Stechlin. Dreimal täglich zehn Tropfen.‘ Dubslav hielt die kleine Flasche gegen das Licht und tröpfelte die vorgeschriebene Zahl in einen Löffel Wasser. Als er sie genommen hatte, bewegte er die Lippen hin und her, etwa wie wenn ein Kenner eine neue Weinsorte probt. Dann nickte er und sagte: ‚Ja, Engelke, nu geht es los. Fingerhut.‘“"
                            },
                            {
                                "example_id": "581ecab5-65e2-4adf-a053-c3542e9a03c5",
                                "sense_id": "ed02f4b6-7f34-379e-acab-590f2ce99c66",
                                "text": "„Auf etwa 1,5 km Länge erfährt man Genaues über die Beschaffenheit der Böden und des Gesteins, über die verschiedenen Weinsorten.“"
                            },
                            {
                                "example_id": "eb9a81fa-9305-46f7-a930-b94a15a35717",
                                "sense_id": "ed02f4b6-7f34-379e-acab-590f2ce99c66",
                                "text": "„Auch ich stimmte herzlich in das Lachen des dicken Pascha ein, als er die fest versperrten Schränke öffnete und ich an Stelle der Bücher Flaschen mit allen möglichen Weinsorten entdeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
