                        "target_lang_word": "carbine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                                        "entry_id": "c4df872c-539d-34f6-8b3e-0dca87651995",
                                        "glosses": [
                                            "A rifle with a short barrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036e3b4d-4136-4bd7-9a51-9f26938e45cb",
                                                "sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                                                "text": "\"Caught at last, and by those rascally Roundheads, whom you call patriots and saints, in a few minutes more I shall be shot—that is, if their clumsy carbines take good aim—to be sure they can fire near enough their mark not to miss..."
                                            },
                                            {
                                                "example_id": "3d57cade-3a61-46f3-a4c7-1c6bb42f9691",
                                                "sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                                                "text": "The lock-up was upstairs, a cage surrounded by six-inch wooden bars, guarded by a constable armed with a carbine."
                                            },
                                            {
                                                "example_id": "f0f5f264-dd96-4ad9-8c3e-8ae983c83934",
                                                "sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                                                "text": "Inside the wall they found \"a small cannon aimed at the entrance of the gate, and all along the street soldiers were stationed and a few on horseback were riding up and down. One of these had his carbine strapped on his back, and swung under his arm was a three-foot beheading sword wrapped in red cloth. That section had been terrorized by robbers, and they were prepared.\""
                                            },
                                            {
                                                "example_id": "fe15e889-a2fc-424b-ac2c-272f792d3d67",
                                                "sense_id": "15a87b03-c272-3f96-a62a-3db92aaf6061",
                                                "text": "The man who fired the carbine, who fired the gun with the scope, who brought the lead horse down, was discovered sitting cross-legged in a cargo van."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
