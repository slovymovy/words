                "forms": [
                    {
                        "form_id": "6b504202-a268-4d16-ab7a-398d8ea95efa",
                        "entry_id": "8df1c4a9-4c13-3a72-b5b8-f82ce3569e35",
                        "tags": [
                            "plural"
                        ],
                        "form": "petroglyphs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                        "entry_id": "8df1c4a9-4c13-3a72-b5b8-f82ce3569e35",
                        "glosses": [
                            "A rock carving, especially one made in prehistoric times."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9de9c86-4e3d-4be9-8ef7-25ccd2dacc7e",
                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                "text": "The petroglyphs of Central Asia form a long sequence from the Neolithic onwards."
                            },
                            {
                                "example_id": "6788382c-cea7-426d-9b0f-94c5256439e1",
                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                "text": "Ninety-six petroglyph sites were reported in the original study (DiazGranados 1993). The majority of the petroglyphs are worn."
                            },
                            {
                                "example_id": "13594e9e-31da-482e-89e1-2ebde20f01a6",
                                "sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
                                "text": "The islands of Tonga are not known for petroglyphs; however, one of the frontal stones of a langi called Mala'e Lahi on 'Uiha Island has one petroglyph of a human foot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bab13eb-0b06-42d0-bb49-1f2f0b058196",
                        "source_entry_id": "8df1c4a9-4c13-3a72-b5b8-f82ce3569e35",
                        "source_sense_id": "1afe8eb7-0fa4-3713-ae14-90261040cac9",
