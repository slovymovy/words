                "senses": [
                    {
                        "sense_id": "9f236518-940c-38e6-bcdf-0a0929034df1",
                        "entry_id": "d712fc8b-35f0-3715-ad71-29e84c53ff32",
                        "glosses": [
                            "Remplir les fonctions de vicaire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f5dcefc3-a46c-470c-a623-d363ddcc6cfc",
                                "sense_id": "9f236518-940c-38e6-bcdf-0a0929034df1",
                                "text": "Il vicaria à la campagne jusqu'au mois de Janvier 1692, époque où il fut pourvu de la cure d’Étrépigny et de But, sa succursale."
                            }
                        ]
                    },
                    {
                        "sense_id": "91c27682-81b7-3f1b-ad55-4216c0233fa8",
                        "entry_id": "d712fc8b-35f0-3715-ad71-29e84c53ff32",
                        "glosses": [
                            "Être réduit à un emploi subalterne."
                        ],
                        "tags": [
                            "broadly",
                            "dated",
                            "figuratively",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9b400837-4b9c-3b3e-907b-d5613da80b13",
                        "entry_id": "d712fc8b-35f0-3715-ad71-29e84c53ff32",
                        "glosses": [
                            "Aller de ville en ville, pour offrir ses services temporaires, en parlant des musiciens d'église."
                        ],
                        "tags": [
                            "broadly",
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6dfbc701-7e51-4f72-8862-650facda5838",
                                "sense_id": "9b400837-4b9c-3b3e-907b-d5613da80b13",
                                "text": "Perrine prend sa lanterne, descend, ouvre : un jeune homme entre avec elle [Venture], monte, se présente d’un air aisé, et fait à M. le Maître un compliment court et bien tourné, se donnant pour un musicien français que le mauvais état de ses finances forçait de vicarier pour passer son chemin."
                            }
                        ]
                    }
