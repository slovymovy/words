{
    "word_family": [
        "jog",
        "jogging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4d6cb31-199d-39b8-9e4d-8e9925642fda",
                    "sense_definition": "A pair of soft, comfortable trousers often worn for exercise or relaxation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to put on my <w>joggers</w> and a sweatshirt to relax at home.",
                            "target_lang_translations": {
                                "ru": "Я решил надеть свои <w>джоггеры</w> и толстовку, чтобы отдохнуть дома."
                            }
                        },
                        {
                            "text": "She bought a new pair of <w>grey</w> <w>joggers</w> for her morning runs in the park.",
                            "target_lang_translations": {
                                "ru": "Она купила новую пару серых <w>спортивных штанов</w> для утренних пробежек в парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "tracksuit"
                    ],
                    "common_phrases": [
                        "grey joggers",
                        "pair of joggers",
                        "comfortable joggers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкие, удобные брюки, которые часто носят для занятий спортом или отдыха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джоггеры",
                                "target_lang_sense_clarification": "вид спортивных штанов"
                            },
                            {
                                "target_lang_word": "спортивные штаны",
                                "target_lang_sense_clarification": "общий термин для спортивных брюк"
                            },
                            {
                                "target_lang_word": "тренировочные штаны",
                                "target_lang_sense_clarification": "брюки для тренировок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6994fceb-d985-3b53-8cb2-a335c266b1b2",
                    "sense_definition": "The plural form of <w>jogger</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park is always full of <w>joggers</w> early in the morning.",
                            "target_lang_translations": {
                                "ru": "Рано утром парк всегда полон <w>бегунов</w>."
                            }
                        },
                        {
                            "text": "Many <w>joggers</w> prefer to run on the grass rather than the hard pavement.",
                            "target_lang_translations": {
                                "ru": "Многие <w>любители бега</w> предпочитают бегать по траве, а не по твердому тротуару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning joggers",
                        "group of joggers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа слова «бегун» (человек, занимающийся бегом трусцой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегуны",
                                "target_lang_sense_clarification": "люди, занимающиеся бегом"
                            },
                            {
                                "target_lang_word": "любители бега",
                                "target_lang_sense_clarification": "те, кто бегает для здоровья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}