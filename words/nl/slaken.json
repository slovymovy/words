                    "sense_id": "098b1b70-a2d8-3179-a2a3-8b2565e2e3cd",
                    "sense_definition": "het uiten van een geluid, woord of kreet, vaak onvrijwillig of als uiting van een sterke emotie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiten van geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij hoorde dat hij geslaagd was voor zijn eindexamen <w>slaakte</w> hij een kreet van vreugde en verbazing.",
                            "target_lang_translations": {
                                "en": "When he heard that he had passed his final exam, he <w>uttered</w> a cry of joy and surprise."
                            }
                        },
                        {
                            "text": "De hele klas <w>slaakte</w> een zucht van verlichting toen de leraar de toets uitstelde.",
                            "target_lang_translations": {
                                "en": "The whole class <w>heaved</w> a sigh of relief when the teacher postponed the test."
                            }
                        }
                    ],
                    "synonyms": [
                        "uiten",
                        "uitstoten",
                        "slaken"
                    ],
                    "common_phrases": [
                        "een zucht slaken",
                        "een kreet slaken",
                        "een kreet van vreugde slaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to utter a sound, word, or cry, often involuntarily or as an expression of strong emotion"
                    },
                    "translations": {
