                                        "sense_id": "8e59f2c4-027e-3499-8627-7b7da42b4fc9",
                                        "entry_id": "95a1e26a-08f1-313d-a820-1a1269dd6c31",
                                        "glosses": [
                                            "Dieu-fleuve associé à ce fleuve dans la mythologie gréco-romaine, fils de Pontôs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
