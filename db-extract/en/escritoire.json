                "translations": [
                    {
                        "translation_id": "58cc2349-6840-46db-8589-71b55af1f0d0",
                        "source_entry_id": "b0494feb-9ff3-35f8-a874-5043852e69e7",
                        "source_sense_id": "5757e6ce-dfc7-3833-b2d4-a0b02c227d86",
                        "source_sense_description": "Tisch zum Schreiben, meist mit Schubfächern zur Aufbewahrung von Schreibmaterialien und Akten",
                        "target_lang_word": "Schreibpult",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibpult",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bed9b653-ed3b-3b2b-91f3-11c417f785e5",
                                        "entry_id": "d66e1814-c17d-3e46-bb55-43df23b89603",
                                        "glosses": [
                                            "Tisch mit schräger Fläche zum Schreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2683c96-687a-4047-92ab-4a768dad20fb",
                                                "sense_id": "bed9b653-ed3b-3b2b-91f3-11c417f785e5",
                                                "text": "„Er schloß ein Schreibpult auf und gab mir zehn Stanzen zu lesen, die von ihm handelten.“"
                                            },
                                            {
                                                "example_id": "a09543cb-ae72-4a02-90c9-549280e76015",
                                                "sense_id": "bed9b653-ed3b-3b2b-91f3-11c417f785e5",
                                                "text": "„Robert beugte sich über das Blatt, das auf dem Schreibpult des Gehilfen im Licht einer hellen Lampe lag.“"
                                            },
                                            {
                                                "example_id": "d78f4282-dd0a-46b5-a8e3-2fbbd1b33054",
                                                "sense_id": "bed9b653-ed3b-3b2b-91f3-11c417f785e5",
                                                "text": "„Bouvard, der mit weit abgespreizten Ellbogen auf sein Schreibpult hingeflegelt lag, um seine Bastardschrift recht schwungvoll abzurunden, pustete seinen Pfeifton vor sich hin und kniff dabei die schweren Augenlider listig zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
