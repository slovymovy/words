                    {
                        "form_id": "19302c5a-cfe5-4aa4-b95b-f7e2df4d6b83",
                        "entry_id": "2017fadd-ce93-363d-b85f-1d49818741a1",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "удо́бствах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20f0a215-d409-39fa-af95-b01c96f09791",
                        "entry_id": "2017fadd-ce93-363d-b85f-1d49818741a1",
                        "glosses": [
                            "свойство по значению прилагательного удобный; удобность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c547b985-d8d2-4992-8248-44f0b91c6af7",
                                "sense_id": "20f0a215-d409-39fa-af95-b01c96f09791",
                                "text": "У Форда красивость машины возникает как следствие удобства и прочности этой машины."
                            }
                        ]
                    },
                    {
                        "sense_id": "8646d5c1-b246-33b4-84ed-4dea2de19fe7",
                        "entry_id": "2017fadd-ce93-363d-b85f-1d49818741a1",
                        "glosses": [
                            "наличие условий, возможностей для лёгкого, приятного, необременительного пользования чем-либо или удовлетворения каких-нибудь нужд, потребностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "180a73e6-eba9-418e-8539-b33deeb42890",
                                "sense_id": "8646d5c1-b246-33b4-84ed-4dea2de19fe7",
                                "text": "За удобство также приходилось платить: экипаж, имеющий резиновые шины, обходился «вдвое против установленной таксы»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91be9b7f-9d14-4238-af66-47ec1decc9a0",
                        "source_entry_id": "2017fadd-ce93-363d-b85f-1d49818741a1",
                        "source_sense_description": "свойство по значению прилагательного удобный",
                        "target_lang_word": "convenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "217234be-4d61-35b2-acec-5edaf002a6d3",
                                        "entry_id": "433d9816-49e9-38fa-84b2-f43b9a1ab0e9",
                                        "glosses": [
                                            "The quality of being convenient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed1e60f4-e687-41d0-91a0-2e53f183641e",
                                                "sense_id": "217234be-4d61-35b2-acec-5edaf002a6d3",
                                                "text": "Fast food is popular because of its cost and convenience."
                                            },
                                            {
                                                "example_id": "3ae689c0-6e3a-42e2-8079-0ad31d54c74c",
                                                "sense_id": "217234be-4d61-35b2-acec-5edaf002a6d3",
                                                "text": "Let's further think of this; / Weigh what convenience both of time and means / May fit us to our shape."
                                            },
                                            {
                                                "example_id": "bc8fca78-f38c-4bc5-b636-3618127630df",
                                                "sense_id": "217234be-4d61-35b2-acec-5edaf002a6d3",
                                                "text": "Thus first Necessity invented stools, / Convenience next suggested elbow-chairs[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                                        "entry_id": "433d9816-49e9-38fa-84b2-f43b9a1ab0e9",
                                        "glosses": [
                                            "Any object that makes life more convenient; a helpful item."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace559dd-b92b-4957-8900-ed6ab820aa20",
                                                "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                                                "text": "A pair of spectacles[…] and several other little conveniences."
                                            },
                                            {
                                                "example_id": "60c4f5e9-36a7-4910-a92e-6ac1b89a6576",
                                                "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                                                "text": "...let Fanchette come in a hackney-coach in the morning, and I will direct the housekeeper to send you something of every thing—plate, candlesticks, lamps, damask—and you won't take it amiss if we should happen to have game or poultry come up that I put that amongst the conveniences;..."
                                            },
                                            {
                                                "example_id": "0d5c3107-e88d-4f02-b4c6-d2774133d434",
                                                "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                                                "text": "There was a bookshelf with a number of tattered volumes, and a few conveniences in the way of cupboards, which appeared to have been contrived out of a packing case by a hasty man, with a blunt axe."
                                            },
                                            {
                                                "example_id": "5657384b-0547-48ae-9b63-0b7626631398",
                                                "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                                                "text": "It's over there, it's over there / My building has every convenience / It's gonna make life easy for me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c32fcdd-009b-372a-9182-97fce69089dc",
                                        "entry_id": "433d9816-49e9-38fa-84b2-f43b9a1ab0e9",
                                        "glosses": [
                                            "A convenient time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe3b9fd3-9599-42de-b786-932f123f3753",
                                                "sense_id": "6c32fcdd-009b-372a-9182-97fce69089dc",
                                                "text": "We will come over and begin the work at your convenience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bda211f-9bb7-3405-83a9-22b5e1afe851",
                                        "entry_id": "433d9816-49e9-38fa-84b2-f43b9a1ab0e9",
                                        "glosses": [
                                            "Ellipsis of public convenience (“a public lavatory”)."
                                        ],
                                        "tags": [
                                            "British",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "convenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae34f91-6ba9-3de3-8ad5-82ccdac7fa1d",
                                        "entry_id": "5fdbf98e-7e03-3556-bb5e-2962f5a51d2b",
                                        "glosses": [
                                            "To make convenient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a758672c-83a7-4e8f-a595-de1b8a680e57",
                                                "sense_id": "9ae34f91-6ba9-3de3-8ad5-82ccdac7fa1d",
                                                "text": "These are equally viable times and I propose we alternate between the two times in order to convenience as many people as possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fe7a43e-c011-4b6b-a6ce-45a423c854af",
                        "source_entry_id": "2017fadd-ce93-363d-b85f-1d49818741a1",
                        "source_sense_description": "наличие условий для лёгкого пользования чем-либо",
