{
    "word_family": [
        "strict",
        "strictness",
        "strictly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fe726e3-2dda-3ac3-9894-8dd81977c459",
                    "sense_definition": "A rule or condition that limits or restricts behavior or action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Religious <w>strictures</w> dictated almost every detail of their everyday lives."
                        },
                        {
                            "text": "Many businesses struggled to operate under the harsh <w>strictures</w> imposed by the new regulations."
                        }
                    ],
                    "synonyms": [
                        "constraint",
                        "restriction",
                        "restraint"
                    ],
                    "common_phrases": [
                        "traditional strictures",
                        "legal strictures"
                    ]
                },
                {
                    "sense_id": "e87e60a7-d071-36e3-998e-bb76e481ff2c",
                    "sense_definition": "An expression of severe criticism or disapproval.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author faced severe <w>strictures</w> from reviewers regarding the historical accuracy of his book."
                        },
                        {
                            "text": "Despite her <w>strictures</w> about modern art, she attended the exhibition with great interest."
                        }
                    ],
                    "common_phrases": [
                        "severe strictures",
                        "pass strictures"
                    ]
                },
                {
                    "sense_id": "0aa32909-cffb-3e04-8174-c0442516381a",
                    "sense_definition": "An abnormal narrowing of a canal or duct in the body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon performed a procedure to widen the urethral <w>stricture</w>."
                        },
                        {
                            "text": "A chronic inflammation had caused an esophageal <w>stricture</w> that made swallowing difficult."
                        }
                    ],
                    "common_phrases": [
                        "urethral stricture",
                        "esophageal stricture"
                    ]
                },
                {
                    "sense_id": "ea0c1cc4-50da-339e-bc15-f5fd71f96f54",
                    "sense_definition": "A general state of restrictiveness or tightness on behavior, action, or thought.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt suffocated by the moral <w>stricture</w> of the small town in which he lived."
                        },
                        {
                            "text": "She left the organization because she could no longer bear the <w>stricture</w> of its hierarchy."
                        }
                    ],
                    "synonyms": [
                        "restraint"
                    ]
                },
                {
                    "sense_id": "6f3b5119-8628-3306-98d9-83b8ef4ab65c",
                    "sense_definition": "The degree or manner of closure or narrowing of the vocal tract in the articulation of consonants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fricatives involve a type of <w>stricture</w> that causes audible turbulence in the airflow."
                        },
                        {
                            "text": "The phonologist analyzed the degree of <w>stricture</w> present during the stop consonant."
                        }
                    ],
                    "common_phrases": [
                        "degree of stricture"
                    ]
                },
                {
                    "sense_id": "a7233fdf-b330-3096-9079-d91f9be10085",
                    "sense_definition": "The quality or condition of being strict; strictness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk lived a life marked by extreme <w>stricture</w> and self-denial."
                        },
                        {
                            "text": "He was renowned across the district as a judge of exceptional <w>stricture</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English for strictness"
                        }
                    ]
                },
                {
                    "sense_id": "d49fb412-5fe8-3db2-b923-04154508690f",
                    "sense_definition": "A stroke, glance, or light touch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author provided mere <w>strictures</w> of the overarching philosophy rather than a full treatise."
                        },
                        {
                            "text": "In his opening pages, he offered a brief <w>stricture</w> upon the ancient texts."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in current use"
                        }
                    ]
                }
            ]
        }
    ]
