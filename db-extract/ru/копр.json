                "senses": [
                    {
                        "sense_id": "45fe6adb-23e1-3aca-8adb-25c9fb0a36e2",
                        "entry_id": "3e609310-795b-38c2-87ee-77d1545fbf40",
                        "glosses": [
                            "устар. то же, что укроп"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2563d250-dd12-4e12-baac-bf195938f6ff",
                                "sense_id": "45fe6adb-23e1-3aca-8adb-25c9fb0a36e2",
                                "text": "Копёр песню (или нагал) любит."
                            },
                            {
                                "example_id": "247ba460-bc5d-4725-bae3-3fcb4bbec592",
                                "sense_id": "45fe6adb-23e1-3aca-8adb-25c9fb0a36e2",
                                "text": "Вдобавок ко всему везде, где только было местечко, росли подсолнечники и укроп, который там называли «копром», наконец, на лощине, заливаемой весенней водой, зеленело страшное количество капусты."
                            }
                        ]
                    },
