                            },
                            {
                                "target_lang_word": "оштрафован",
                                "target_lang_sense_clarification": "наказан материально или начислением штрафных очков"
                            },
                            {
                                "target_lang_word": "оштрафовали",
                                "target_lang_sense_clarification": "в форме прошедшего времени"
                            }
