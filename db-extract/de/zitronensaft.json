                ],
                "senses": [
                    {
                        "sense_id": "04cc7428-8fbf-3eef-9281-a2f6852e0867",
                        "entry_id": "0296c776-f7f4-3741-89a7-e6d6599d9102",
                        "glosses": [
                            "Jus de citron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e24572a-cf4e-4e80-8755-27ac2943d818",
                                "sense_id": "04cc7428-8fbf-3eef-9281-a2f6852e0867",
                                "text": "Schmecken Sie den Salat vor dem Servieren mit Salz, Pfeffer und eventuell etwas Zitronensaft ab.",
                                "translation": "Avant de servir, assaisonnez la salade avec du sel, du poivre et éventuellement un peu de jus de citron."
                            },
                            {
                                "example_id": "29f33223-1319-4be6-88c6-c1129e3a6842",
                                "sense_id": "04cc7428-8fbf-3eef-9281-a2f6852e0867",
                                "text": "Um die Füllung für einen Apfelstrudel zuzubereiten, schält man Äpfel, schneidet sie in dünne Spalten und beträufelt sie mit etwas Zitronensaft. Danach (...)",
                                "translation": "Pour préparer la farce d’un strudel aux pommes, il faut éplucher les pommes, les couper en fines tranches et les arroser d’un peu de jus de citron. Ensuite, (...)"
                            }
                        ]
                    }
                ],
