                                        "entry_id": "3393c057-d9dc-3d8c-b5d0-fa0910567b85",
                                        "glosses": [
                                            "eine nicht so ertragreiche, aber qualitativ sehr hochwertige rote französische Rebsorte, die ursprünglich nur im Rhonetal kultiviert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b95572c-47d8-404c-8dcd-c06a6091a9aa",
                                                "sense_id": "13b1699c-c47c-3a3f-a040-60c3bb371c4a",
                                                "text": "„Die Syrah-Rebe hat so hohe Bedeutung erlangt und ist so begehrt, dass sie in die Nobilität der Weinwelt aufrückte und als Edelrebe bezeichnet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c439a77-8965-3bec-8d66-771642840473",
                                        "entry_id": "3393c057-d9dc-3d8c-b5d0-fa0910567b85",
                                        "glosses": [
                                            "ein Wein aus Trauben der Rebsorte Syrah"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129ce3a2-1099-4772-8102-01fd04fa5f49",
                                                "sense_id": "6c439a77-8965-3bec-8d66-771642840473",
                                                "text": "„Syrah-Weine haben meist ein kräftiges Johannisbeer-Aroma.“"
                                            }
                                        ],
