                    }
                ],
                "translations": [
                    {
                        "translation_id": "25ba3091-7bcb-49f4-98e8-094d97458097",
                        "source_entry_id": "ee488e98-f367-3ac9-b6f0-481416212dc3",
                        "source_sense_id": "3885c89c-7382-3df6-bacb-96da04696395",
                        "target_lang_word": "Ballerina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballerina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                        "entry_id": "9a834a89-f3ee-3544-b33d-bd25f1b1d7b5",
                                        "glosses": [
                                            "weibliche Person, die in einem Ballett tanzt"
                                        ],
                                        "tags": [
                                            "Tanz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56b789f-702f-48a1-a3f4-042980c2823b",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "Sie möchte Ballerina werden."
                                            },
                                            {
                                                "example_id": "057d24a0-7fa3-43cd-a1db-3f21d6480aa3",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "Damit eine Frau später eine gute Ballerina wird, sollte möglichst früh mit dem Balletttanz begonnen werden."
                                            },
                                            {
                                                "example_id": "9800cfaa-e68e-4ef6-bffe-cce96a607e9b",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "Dass Ballerinen nur in Tutu tanzen, ist ein bekanntes Klischee."
                                            },
                                            {
                                                "example_id": "fcfd6cae-69c0-449a-a6f1-68008b65bdc8",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "Die Ausbildung zur professionellen Ballerina besteht in den meisten Fällen in einem Hochschulstudium."
                                            },
                                            {
                                                "example_id": "48402ba1-58a8-469b-a424-fc477c078f22",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "„Die Biene flog mit ihrer Fracht zwischen den Narzissen hin und her und eine Katze schlug mit den Krallen nach Blumensamen, die wie winzige Ballerinen in eleganten Pirouetten durch die Luft wirbelten.“"
                                            },
                                            {
                                                "example_id": "b40a8bab-1d13-45ba-aa09-a6905bac92bf",
                                                "sense_id": "ee6db229-b6ec-3e40-b5d2-8f6b41203788",
                                                "text": "„Ganz unten liegt Hanna Lewisohn aus Berlin, die Ballerina.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ballerina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54952213-14b2-3fb3-8fd7-946ccd8fc87c",
                                        "entry_id": "64a56e88-97f7-35d3-a859-112e9640d472",
                                        "glosses": [
                                            "ballerinaartiger Damenschuh"
                                        ],
                                        "tags": [
                                            "Kleidung, meist im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c182b49-1aae-4247-8883-643dde25fdca",
                                                "sense_id": "54952213-14b2-3fb3-8fd7-946ccd8fc87c",
                                                "text": "Meine Frau hat sich ein Paar neue Ballerinas gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6db05ce-9534-4fa2-b015-e1bb8523a370",
                        "source_entry_id": "ee488e98-f367-3ac9-b6f0-481416212dc3",
                        "source_sense_id": "3885c89c-7382-3df6-bacb-96da04696395",
                        "target_lang_word": "балетка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "балетка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed66ffd-9b71-3a3e-8dab-5b69d41abb84",
                                        "entry_id": "7db87706-7586-3312-b888-a03be9ef5b89",
                                        "glosses": [
                                            "устар. балетная коробка, чемоданчик для балетных принадлежностей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a6e1f0d-024b-42cf-a460-5a0c27774749",
                                                "sense_id": "8ed66ffd-9b71-3a3e-8dab-5b69d41abb84",
                                                "text": "Тогда, в шестьдесят первом, он уже не был для меня так притягателен, поскольку в моду вошли чешские пузатые портфели и чемоданы из толстой красноватой кожи, а черный лакированный как раз и остался провинциальным щеголям, вроде флотского, наверняка добирающегося до столиц из Севастополя, фасоня по дороге белым кителем и лакированной балеткой (так тогда назывались маленькие чемоданы) ― но все же я отметил про себя эту блестящую, хотя и старомодную роскошь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4454c631-f6ec-32da-9c90-8c9c936ee902",
                                        "entry_id": "7db87706-7586-3312-b888-a03be9ef5b89",
                                        "glosses": [
                                            "мн. ч., разг. балетные туфли"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81481582-bfe1-3b3a-a0e8-c3ef6147808e",
                                        "entry_id": "7db87706-7586-3312-b888-a03be9ef5b89",
                                        "glosses": [
                                            "разг., спорт. в спортивной гимнастике — самодельные мягкие кожаные тапочки без задника, прикрывающие только переднюю часть ноги"
                                        ],
