                        "entry_id": "9198d0a0-d795-302c-a42c-fd157d71520c",
                        "glosses": [
                            "Phénomène de résistivité variant en fonction de la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df1100b-2d40-456a-8391-e311226d5f78",
                                "sense_id": "fba98abd-eed8-3a3c-addb-572616f40bff",
                                "text": "Effet de photorésistance aux basses températures pour les pellicules métalliques obtenues par projection cathodique."
                            }
                        ]
                    },
                    {
                        "sense_id": "39b84996-3e3c-346a-a9da-fcc7f1680a53",
                        "entry_id": "9198d0a0-d795-302c-a42c-fd157d71520c",
                        "glosses": [
                            "Résistance dont la résistivité varie en fonction de la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a4726fb-564c-4bd2-9cd2-4a769b8fe642",
                                "sense_id": "39b84996-3e3c-346a-a9da-fcc7f1680a53",
                                "text": "Une photorésistance est composée d’un semi-conducteur à haute résistivité qui, sous l’effet de la lumière absorbe les photons et donne aux électrons liés assez d’énergie pour sauter dans la bande de conduction, les électrons libres (avec leurs trous d’électrons) ainsi produits abaissant la résistance de l’ensemble."
                            }
                        ]
                    }
