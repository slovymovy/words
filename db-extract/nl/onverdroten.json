                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unablässig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                        "entry_id": "8753f42c-ede0-30e9-b48a-2d54d88d482e",
                                        "glosses": [
                                            "nicht ablassend, ohne Unterbrechung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe422dce-7ec3-4dfd-9a53-f4aeaf326f07",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Diese unablässigen Wiederholungen im Fernsehen stören mich sehr."
                                            },
                                            {
                                                "example_id": "042f9407-51db-4469-9187-d9b8a7f37c90",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Er beobachtete ihn unablässig."
                                            },
                                            {
                                                "example_id": "a51685de-3f1e-41e5-b10f-74db61f5868d",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Meine Nachbarn streiten sich unablässig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0bc9b19-8943-4d1d-bffb-a6537fd822db",
