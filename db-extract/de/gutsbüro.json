                        "examples": [
                            {
                                "example_id": "9319c9c1-963c-44df-81ea-8a91d4d3384a",
                                "sense_id": "8c9780bd-8ba4-36f7-91f5-5329df784139",
                                "text": "„Dort war das Gutsbüro, in dem der Rentmeister Rodemerk regierte.“"
                            },
                            {
                                "example_id": "0ea86691-2532-4f04-8815-6510ce5ed832",
                                "sense_id": "8c9780bd-8ba4-36f7-91f5-5329df784139",
                                "text": "„Für eine selbständige Erkundung des Parks erhalten Sie im Gutsbüro der Gutsverwaltung oder an Wochenenden und Feiertagen im Parkcafe einen Parkplan mit Beschreibungen der Sehenswürdigkeiten.“"
                            },
                            {
                                "example_id": "1fea5c35-2408-47f0-8c04-7c5f67bba6cc",
                                "sense_id": "8c9780bd-8ba4-36f7-91f5-5329df784139",
                                "text": "„Sie birgt das Gutsbüro.“"
                            }
                        ],
