                                        "examples": [
                                            {
                                                "example_id": "0d4314ec-4d67-466a-a545-1df21867306d",
                                                "sense_id": "83e6a68c-8a4b-30ae-9a0f-333de18656e8",
                                                "text": "When \"God save the King!\" resounded meow meow through the stately abbey, the banners vibrating with the mighty music, I felt quite enthusiastic in my loyalty."
                                            },
                                            {
                                                "example_id": "0b1a3d55-16ce-42a2-adc5-134f8d99d344",
                                                "sense_id": "83e6a68c-8a4b-30ae-9a0f-333de18656e8",
                                                "text": "The tender roared along vibrating vigorously; braking had resulted in \"flats\" on most of its tyres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea25452f-4baf-3141-9643-c9e5f45e2c26",
