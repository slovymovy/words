                {
                    "sense_id": "36b36e42-a37e-3f52-9169-a71ac2f1804e",
                    "sense_definition": "Qui a des bornes ou des restrictions ; qui ne dépasse pas une certaine mesure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accès à cette zone reste <w>limité</w> aux personnes autorisées.",
                            "target_lang_translations": {
                                "en": "Access to this area remains <w>restricted</w> to authorised personnel.",
                                "ru": "Доступ в эту зону остаётся <w>ограниченным</w> только для уполномоченных лиц.",
                                "de": "Der Zugang zu diesem Bereich bleibt auf autorisierte Personen <w>beschränkt</w>.",
                                "es": "El acceso a esta zona sigue <w>restringido</w> a las personas autorizadas.",
                                "zh": "该区域的进入仍<w>受限</w>，只对获得授权的人员开放。"
                            }
                        },
                        {
                            "text": "Nous devons terminer ce projet dans un temps <w>limité</w>.",
                            "target_lang_translations": {
                                "en": "We have to finish this project in <w>limited</w> time.",
                                "ru": "Нам нужно завершить этот проект за <w>ограниченное</w> время.",
                                "de": "Wir müssen dieses Projekt in <w>begrenzter</w> Zeit abschließen.",
                                "es": "Debemos terminar este proyecto en un plazo <w>limitado</w>.",
                                "zh": "我们必须在<w>有限</w>的时间内完成这个项目。"
                            }
                        }
                    ],
                    "synonyms": [
