                        ],
                        "examples": [
                            {
                                "example_id": "5372ab5f-539c-4bf3-b6f8-96577a978a4c",
                                "sense_id": "d3b7c236-cb46-3b7d-a1b2-91aad9b1664d",
                                "text": "Quel puritain !"
                            },
                            {
                                "example_id": "a2e1aa55-20e6-4816-803f-b2bc67e2fafa",
                                "sense_id": "d3b7c236-cb46-3b7d-a1b2-91aad9b1664d",
                                "text": "Ce n’est pas un puritain, répliqua-t-elle en lui faisant face malgré l’embarras qui lui rosissait les joues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b2d018b-d56d-4d4b-9c8b-caedf2cb8713",
                        "source_entry_id": "e8e948af-bd32-3603-a93f-3899143fcf13",
                        "target_lang_word": "Puritaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puritaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                        "entry_id": "2f965147-ccda-3068-9065-421b4630f631",
                                        "glosses": [
                                            "Anhänger des Puritanismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4982db1-24c3-48b5-8557-49e24546232f",
                                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                                "text": "„Der Puritaner wollte Berufsmensch sein, – wir müssen es sein.“"
                                            },
                                            {
                                                "example_id": "adf886a7-7df9-4529-828e-6a4925fa47a8",
                                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                                "text": "„Digbys Privatbibliothek wurde unter dem parlamentarischen Regime Oliver Cromwells vermutlich beschlagnahmt und verbrannt, denn solches war bei den Puritanern die übliche Praxis.“"
                                            },
                                            {
                                                "example_id": "021b0e30-f216-4ba4-b8f8-1dfd7852034f",
                                                "sense_id": "7c2c7833-7c9b-3ff5-8c55-8f36ff71c830",
                                                "text": "„Für die Puritaner war er eine Quelle lüsterner Faszination.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "541b1760-7d54-4869-b3c1-a53f0bf3d1c3",
                        "source_entry_id": "e8e948af-bd32-3603-a93f-3899143fcf13",
