                "senses": [
                    {
                        "sense_id": "51677797-a411-37eb-a860-f97166cc1cdb",
                        "entry_id": "6576cbd1-299c-316b-88d7-60bb3dfc7a84",
                        "glosses": [
                            "a car that has been affected by an accident"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e4439058-8aa4-4231-a756-09822d54c894",
                                "sense_id": "51677797-a411-37eb-a860-f97166cc1cdb",
                                "text": "Die Firma kauft Unfallwagen auf und verteibt die Einzelteile.",
                                "translation": "The company buys up damaged cars and sells the components.",
                                "english": "The company buys up damaged cars and sells the components."
                            }
                        ]
                    },
                    {
                        "sense_id": "81886fa3-4612-34b4-bbc4-e06bde0fdc8f",
                        "entry_id": "6576cbd1-299c-316b-88d7-60bb3dfc7a84",
                        "glosses": [
                            "the car that caused the accident"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "fa74b1c6-5e17-40c5-8c7f-40e051d67396",
                                "sense_id": "81886fa3-4612-34b4-bbc4-e06bde0fdc8f",
                                "text": "Der Unfallwagen kam von der Fahrbahn ab und stieß frontal in anderes Fahrzeug.",
                                "translation": "The responsible car ran off the road and crashed frontally into another vehicle.",
                                "english": "The responsible car ran off the road and crashed frontally into another vehicle."
                            }
                        ]
                    }
