                        "entry_id": "eb65cbe9-2d2c-387e-bc30-5474f09b1e49",
                        "glosses": [
                            "Désigne une quantité supérieure ou égale à tous les éléments d’un ensemble spécifié."
                        ],
                        "tags": [],
                        "note": "La « quantité » est comprise comme nombre entier ou nombre réel dans l’exemple suivant. La définition se généralise aux ensembles partiellement ordonnés",
                        "examples": [
                            {
                                "example_id": "ed99e9dd-a602-4a12-80a0-8e0773e5cbb2",
                                "sense_id": "081105e6-506a-3f47-92df-c84699d5105d",
                                "text": "294 est un majorant de {3, 45, 57}."
                            },
                            {
                                "example_id": "59134c42-f548-4033-bb01-c93e15daf318",
                                "sense_id": "081105e6-506a-3f47-92df-c84699d5105d",
                                "text": "On a donc l’alternative suivante : une suite est ou bien majorée et dans ce cas admet une infinité de majorants, ou bien non majorée et dans ce cas n’admet aucun majorant."
                            }
                        ]
                    }
