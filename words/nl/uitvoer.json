                    "frequency": "Middle",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitvoer</w> van het project heeft wat vertraging opgelopen door de regen.",
                            "target_lang_translations": {
                                "en": "The <w>execution</w> of the project has suffered some delays due to the rain."
                            }
                        },
                        {
                            "text": "Het is essentieel om dit plan ten <w>uitvoer</w> te brengen voor het einde van het jaar.",
                            "target_lang_translations": {
                                "en": "It is essential to <w>carry out</w> this plan before the end of the year."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ten uitvoer brengen",
                        "uitvoer van een plan"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of realizing or completing a plan, task, or assignment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "execution",
                                "target_lang_sense_clarification": "carrying out a plan or task"
                            },
                            {
                                "target_lang_word": "implementation",
                                "target_lang_sense_clarification": "putting a decision or plan into effect"
                            },
                            {
                                "target_lang_word": "performance",
                                "target_lang_sense_clarification": "the carrying out of an action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2738fe-dbbe-3767-bf63-348de8575620",
                    "sense_definition": "Informatie of gegevens die door een computer of programma worden geproduceerd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitvoer</w> van het programma was niet wat ik verwachtte na de update.",
                            "target_lang_translations": {
                                "en": "The <w>output</w> of the program was not what I expected after the update."
                            }
                        },
                        {
                            "text": "Kun je de digitale <w>uitvoer</w> van dat script controleren op fouten?",
                            "target_lang_translations": {
                                "en": "Can you check the digital <w>output</w> of that script for errors?"
                            }
                        }
                    ],
                    "synonyms": [
                        "output"
                    ],
                    "antonyms": [
                        "invoer"
                    ],
                    "common_phrases": [
                        "digitale uitvoer",
                        "onverwachte uitvoer"
                    ],
                    "target_lang_definitions": {
                        "en": "Information or data produced by a computer or program."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "output",
                                "target_lang_sense_clarification": "data produced by a computer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d15c0d1-c385-30b7-932c-80453a8ab58c",
                    "sense_definition": "Een fysieke leiding of opening die een vloeistof of gas naar buiten geleidt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitvoer</w> van het afwaswater zat verstopt, wat tot een kleine overstroming leidde.",
                            "target_lang_translations": {
                                "en": "The <w>outlet</w> for the dishwater was clogged, which led to a small flood."
                            }
                        },
                        {
                            "text": "Controleer of de <w>uitvoer</w> van de machine vrij is van obstakels.",
                            "target_lang_translations": {
                                "en": "Check if the <w>discharge</w> of the machine is free of obstacles."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A physical pipe or opening that conducts a liquid or gas outward."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outlet",
                                "target_lang_sense_clarification": "an opening or passage for release"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "a place where liquid flows out"
                            },
                            {
                                "target_lang_word": "exhaust",
                                "target_lang_sense_clarification": "an outlet for waste gases"
                            }
                        ]
                    }
                }
            ]
        },
        {
