                "senses": [
                    {
                        "sense_id": "fb8911df-56b4-3381-b14c-6ab7058225fb",
                        "entry_id": "58d41109-bbe6-3087-8dda-f042bd7a1e0c",
                        "glosses": [
                            "Schüler, der die dritte Klasse besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6daeba1-0b70-400d-a3f3-fa5145f47fdc",
                                "sense_id": "fb8911df-56b4-3381-b14c-6ab7058225fb",
                                "text": "„Die Schweiz machte einen sehr ordentlichen Auftakt – mit einem winzigen, dafür reichlich verzierten Akkordeon, auf dem ein Drittklässler, herausgeputzt mit Bortenhemd und Hirtenhut, ziemlich verlegen eine kleine Melodie spielte, nachdem er das schmucke Ding als ein »original Schwyzer Handörgeli« vorgestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
