                "senses": [
                    {
                        "sense_id": "9a10896b-ff50-32a2-a2ce-1f26b15ddf87",
                        "entry_id": "9c947dfe-69ce-338e-85ad-19d899172ef1",
                        "glosses": [
                            "Qui a neuf angles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a4e8e1-7b59-4eae-bacd-547bfa28b82f",
                                "sense_id": "9a10896b-ff50-32a2-a2ce-1f26b15ddf87",
                                "text": "Lors d'un sauvetage, c'est un temple ennéagonal à cella circulaire qui a été découvert à Landeronde (Vendée), entouré d'une clôture. Depuis le recensement de 1992, plusieurs sanctuaires de ce type ont été mis au jour : […]."
                            },
                            {
                                "example_id": "adb4f823-40ae-4149-8a66-be4e65fc649e",
                                "sense_id": "9a10896b-ff50-32a2-a2ce-1f26b15ddf87",
                                "text": "Rien qu'en Europe centrale, Heinrich Gruger a identifié des plans carrés, hexagonaux, octogonaux et ennéagonaux, en plus de quelques structures allongées dont les extrémités prennent une forme d'abside."
                            }
                        ]
                    },
                    {
                        "sense_id": "65e944c5-81fc-3511-9c17-0c3cb260c2d7",
                        "entry_id": "9c947dfe-69ce-338e-85ad-19d899172ef1",
                        "glosses": [
                            "Qualifie un nombre figuré qui peut être représenté graphiquement par un ennéagone."
                        ],
