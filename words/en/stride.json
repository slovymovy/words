{
    "word_family": [
        "strider"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2a62d09-075c-35bc-aa1d-2f96a8886aae",
                    "sense_definition": "To walk with long, decisive steps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>stride</w> across the room to greet his guest.",
                            "target_lang_translations": {
                                "zh": "他开始<w>大步</w>穿过房间去迎接客人。",
                                "ru": "Он начал <w>широко шагать</w> по комнате, чтобы поприветствовать гостя."
                            }
                        },
                        {
                            "text": "The athlete <w>strode</w> confidently toward the finish line.",
                            "target_lang_translations": {
                                "zh": "运动员自信地向终点线<w>阔步</w>走去。",
                                "ru": "Спортсмен уверенно <w>вышагивал</w> к финишной черте."
                            }
                        }
                    ],
                    "synonyms": [
                        "march",
                        "pace"
                    ],
                    "common_phrases": [
                        "stride across",
                        "stride along"
                    ],
                    "target_lang_definitions": {
                        "zh": "大步流星地走。",
                        "ru": "Идти широкими, решительными шагами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大步走",
                                "target_lang_sense_clarification": "形容步伐大而有力的行走方式。"
                            },
                            {
                                "target_lang_word": "阔步",
                                "target_lang_sense_clarification": "形容迈大步走，通常带有自信或果断的意味。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шагать",
                                "target_lang_sense_clarification": "идти широкими шагами"
                            },
                            {
                                "target_lang_word": "вышагивать",
                                "target_lang_sense_clarification": "идти важно или решительно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30827fa6-00d0-3a74-843a-a1349dac1217",
                    "sense_definition": "To step over or across something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker had to <w>stride</w> over the fallen tree trunk.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者不得不<w>跨过</w>倒下的树干。",
                                "ru": "Туристу пришлось <w>перешагнуть</w> через упавший ствол дерева."
                            }
                        },
                        {
                            "text": "The bridge <w>strides</w> over the deep valley below.",
                            "target_lang_translations": {
                                "zh": "这座桥<w>横跨</w>在下方的深谷之上。",
                                "ru": "Мост <w>перекинут</w> через глубокую долину внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "step over"
                    ],
                    "common_phrases": [
                        "stride over"
                    ],
                    "target_lang_definitions": {
                        "zh": "跨过某物。",
                        "ru": "Перешагнуть через что-либо."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跨过",
                                "target_lang_sense_clarification": "迈大步越过障碍物。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перешагивать",
                                "target_lang_sense_clarification": "переступать через препятствие"
                            },
                            {
                                "target_lang_word": "перешагнуть",
                                "target_lang_sense_clarification": "совершить действие перешагивания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c878cd4-2ff3-313a-bf37-29a6455710e0",
                    "sense_definition": "To stand with the legs wide apart.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "standing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>strode</w> firmly in the doorway, blocking the path.",
                            "target_lang_translations": {
                                "zh": "他<w>叉开双腿</w>稳稳地站在门口，挡住了去路。",
                                "ru": "Он <w>стоял враскоряку</w> в дверном проеме, преграждая путь."
                            }
                        },
                        {
                            "text": "The guard <w>strides</w> with legs apart to maintain balance.",
                            "target_lang_translations": {
                                "zh": "警卫<w>叉开双腿</w>站立以保持平衡。",
                                "ru": "Охранник <w>стоит, широко расставив ноги</w>, чтобы сохранять равновесие."
                            }
                        }
                    ],
                    "synonyms": [
                        "straddle"
                    ],
                    "target_lang_definitions": {
                        "zh": "双腿叉开站立。",
                        "ru": "Стоять, широко расставив ноги."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叉开双腿站立",
                                "target_lang_sense_clarification": "形容双脚分开站立的姿势。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "стоять враскоряку",
                                "target_lang_sense_clarification": "стоять с широко расставленными ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "028682d5-d23a-3dde-9742-e56f63f2fcd4",
                    "sense_definition": "To sit or stand with one leg on each side of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "standing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider <w>strode</w> his horse with ease.",
                            "target_lang_translations": {
                                "zh": "骑手轻松地<w>跨坐</w>在马上。",
                                "ru": "Всадник легко <w>сидел верхом</w> на своей лошади."
                            }
                        },
                        {
                            "text": "She <w>strides</w> the fence to get to the other side.",
                            "target_lang_translations": {
                                "zh": "她<w>跨坐</w>在栅栏上以便到另一边去。",
                                "ru": "Она <w>перелезает через забор</w>, сидя на нем верхом, чтобы попасть на другую сторону."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestride",
                        "straddle"
                    ],
                    "target_lang_definitions": {
                        "zh": "跨坐在某物上。",
                        "ru": "Сидеть или стоять, охватив что-либо ногами с двух сторон."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跨坐",
                                "target_lang_sense_clarification": "双腿分置于物体两侧。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сидеть верхом",
                                "target_lang_sense_clarification": "сидеть, расставив ноги по обе стороны"
                            },
                            {
                                "target_lang_word": "оседлать",
                                "target_lang_sense_clarification": "сесть на что-либо верхом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffdb9cc9-1a81-393f-85c5-525723a21935",
                    "sense_definition": "A long, purposeful step in walking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked with a long <w>stride</w> that kept her ahead of the group.",
                            "target_lang_translations": {
                                "zh": "她以一种<w>大步</w>的姿态走着，这使她一直走在队伍前面。",
                                "ru": "Она шла таким <w>широким шагом</w>, что оставалась впереди группы."
                            }
                        },
                        {
                            "text": "The team made a significant <w>stride</w> toward completing the project.",
                            "target_lang_translations": {
                                "zh": "团队在完成项目方面取得了重大<w>进展</w>。",
                                "ru": "Команда сделала значительный <w>шаг вперед</w> в завершении проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "pace",
                        "step"
                    ],
                    "common_phrases": [
                        "long stride",
                        "make a stride"
                    ],
                    "target_lang_definitions": {
                        "zh": "大步；进展。",
                        "ru": "Длинный, целеустремленный шаг; значительный прогресс."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大步",
                                "target_lang_sense_clarification": "指迈出的大步。"
                            },
                            {
                                "target_lang_word": "进展",
                                "target_lang_sense_clarification": "指在某项事业或任务中取得的显著进步。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "широкий шаг",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "прогресс",
                                "target_lang_sense_clarification": "значительное продвижение в деле"
                            },
                            {
                                "target_lang_word": "шаг вперед",
                                "target_lang_sense_clarification": "метафорическое обозначение успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f82b18b8-f9aa-3a25-bee8-fbaa19a97f8b",
                    "sense_definition": "The physical distance covered by a single long step.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gap was only one <w>stride</w> wide.",
                            "target_lang_translations": {
                                "zh": "那道缝隙只有一步<w>步幅</w>那么宽。",
                                "ru": "Проем был шириной всего в один <w>шаг</w>."
                            }
                        },
                        {
                            "text": "He measured the room in <w>strides</w>.",
                            "target_lang_translations": {
                                "zh": "他用<w>步幅</w>测量了房间的长度。",
                                "ru": "Он измерил комнату <w>шагами</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一步的距离。",
                        "ru": "Физическое расстояние, покрываемое одним шагом."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "步幅",
                                "target_lang_sense_clarification": "指迈出一步的物理长度。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "длина шага",
                                "target_lang_sense_clarification": "расстояние одного шага"
                            },
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "мера длины, равная одному шагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5699ad4b-03ea-3713-bb1d-3d2252d1bfa6",
                    "sense_definition": "A style of jazz piano playing characterized by a rhythmic left-hand pattern.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played a classic piece of <w>stride</w> jazz.",
                            "target_lang_translations": {
                                "zh": "钢琴家演奏了一首经典的<w>跨步爵士乐</w>曲目。",
                                "ru": "Пианист исполнил классическую пьесу в стиле <w>страйд</w>."
                            }
                        },
                        {
                            "text": "He is known for his mastery of the <w>stride</w> piano style.",
                            "target_lang_translations": {
                                "zh": "他以精通<w>跨步爵士乐</w>钢琴风格而闻名。",
                                "ru": "Он известен своим мастерством игры на фортепиано в стиле <w>страйд</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stride piano"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种爵士钢琴风格，左手以跳跃的节奏演奏。",
                        "ru": "Стиль джазовой фортепианной игры с ритмичным рисунком левой руки."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跨步爵士乐",
                                "target_lang_sense_clarification": "一种特定的爵士钢琴演奏风格。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "страйд",
                                "target_lang_sense_clarification": "джазовый стиль игры на фортепиано"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2737b6-1377-332b-b862-8f0b6fa6c9c2",
                    "sense_definition": "The number of memory locations between successive elements in a data structure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The image processing algorithm requires a specific <w>stride</w> for the bitmap.",
                            "target_lang_translations": {
                                "zh": "图像处理算法要求位图具有特定的<w>步长</w>。",
                                "ru": "Алгоритм обработки изображений требует определенного <w>шага</w> для растрового изображения."
                            }
                        },
                        {
                            "text": "Adjusting the <w>stride</w> can improve memory access performance.",
                            "target_lang_translations": {
                                "zh": "调整<w>步长</w>可以提高内存访问性能。",
                                "ru": "Настройка <w>шага</w> может улучшить производительность доступа к памяти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "memory stride"
                    ],
                    "target_lang_definitions": {
                        "zh": "数据结构中相邻元素之间的内存地址间隔。",
                        "ru": "Количество ячеек памяти между последовательными элементами в структуре данных."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "步长",
                                "target_lang_sense_clarification": "计算机科学中指内存访问的间隔。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "интервал между элементами в памяти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1504a615-6588-3a03-b426-0e11fcd24ce2",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named <w>Stride</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>斯特莱德</w>。",
                                "ru": "Автора книги зовут <w>Страйд</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Stride</w> will be joining the meeting later today.",
                            "target_lang_translations": {
                                "zh": "<w>斯特莱德</w>先生今天晚些时候会参加会议。",
                                "ru": "Мистер <w>Страйд</w> присоединится к собранию позже сегодня."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。",
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯特莱德",
                                "target_lang_sense_clarification": "作为姓氏的音译。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Страйд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}