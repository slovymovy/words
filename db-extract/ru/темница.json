                        "sense_id": "7a0d5330-d9cf-3198-bd08-b1f0a1ac99e5",
                        "entry_id": "836079a0-1e9e-3203-9859-1479def350f7",
                        "glosses": [
                            "устар., поэт. или высок. то же, что тюрьма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e3f015-dcda-4956-a0ee-ded803f29aab",
                                "sense_id": "7a0d5330-d9cf-3198-bd08-b1f0a1ac99e5",
                                "text": "Но подождите: сядут они за стол; — и тогда потребуют отвести в темницу всякого, кто им помешает положить и ноги на стол."
                            }
                        ]
                    }
                ],
