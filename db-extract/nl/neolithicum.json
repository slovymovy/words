                        "tags": [],
                        "form": "Vóór 2006 was de spelling Neolithicum."
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f57b420-eaa1-3170-847d-910264b76aa7",
                        "entry_id": "d4bfb6bd-5ba2-38c5-a4dc-f82be0e0fdc7",
                        "glosses": [
                            "laatste periode van de steentijd, beginnend met de overgang naar landbouw en het gebruik van gepolijste stenen, waar vanaf 11.000 v.Chr. voorbeelden van zijn, tot aan het eerste gebruik van brons, met eerste voorbeelden vanaf 3.000 v. Chr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8462aaec-bfeb-4b67-ba74-c6f8f157900f",
                                "sense_id": "8f57b420-eaa1-3170-847d-910264b76aa7",
                                "text": "Toch zijn we boeren sinds het neolithicum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84e4b286-bd0b-4334-a22d-86d448f0e0d9",
                        "source_entry_id": "d4bfb6bd-5ba2-38c5-a4dc-f82be0e0fdc7",
