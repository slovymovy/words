{
    "word_family": [
        "waarom",
        "daaromheen",
        "daaromtrent"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                    "sense_definition": "om die reden; geeft een gevolg of conclusie aan",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het regende heel hard en <w>daarom</w> deed ik snel het raam dicht.",
                            "target_lang_translations": {
                                "en": "It was raining very hard and <w>therefore</w> I quickly closed the window.",
                                "ru": "Шел сильный дождь, и <w>поэтому</w> я быстро закрыл окно.",
                                "pl": "Padał bardzo mocny deszcz i <w>dlatego</w> szybko zamknąłem okno."
                            }
                        },
                        {
                            "text": "Ik was gisteren erg moe en ben <w>daarom</w> vroeg naar bed gegaan.",
                            "target_lang_translations": {
                                "en": "I was very tired yesterday and <w>so</w> I went to bed early.",
                                "ru": "Вчера я очень устал и <w>поэтому</w> рано лег спать.",
                                "pl": "Byłem wczoraj bardzo zmęczony i <w>dlatego</w> wcześnie poszedłem spać."
                            }
                        }
                    ],
                    "synonyms": [
                        "dus"
                    ],
                    "common_phrases": [
                        "en daarom",
                        "juist daarom"
                    ],
                    "target_lang_definitions": {
                        "en": "for that reason; indicates a consequence or conclusion",
                        "ru": "по этой причине; указывает на следствие или вывод",
                        "pl": "z tego powodu; wskazuje na skutek lub wniosek"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "therefore",
                                "target_lang_sense_clarification": "consequently; for that reason"
                            },
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "as a result"
                            },
                            {
                                "target_lang_word": "that's why",
                                "target_lang_sense_clarification": "indicating the reason for something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "поэтому",
                                "target_lang_sense_clarification": "указывает на причину"
                            },
                            {
                                "target_lang_word": "по этой причине",
                                "target_lang_sense_clarification": "более формальный вариант"
                            },
                            {
                                "target_lang_word": "оттого",
                                "target_lang_sense_clarification": "указывает на следствие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dlatego",
                                "target_lang_sense_clarification": "wskazuje na przyczynę lub skutek"
                            },
                            {
                                "target_lang_word": "dlatego też",
                                "target_lang_sense_clarification": "bardziej formalne połączenie"
                            },
                            {
                                "target_lang_word": "stąd",
                                "target_lang_sense_clarification": "wskazuje na wniosek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e573258-909a-3016-8c5e-e90a0becb469",
                    "sense_definition": "voornaamwoordelijk bijwoord gevormd uit <w>om</w> en <w>dat</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij trok een gek gezicht en <w>daarom</w> moest ik heel hard lachen.",
                            "target_lang_translations": {
                                "en": "He made a funny face and <w>that's why</w> I had to laugh very hard.",
                                "ru": "Он скорчил смешную гримасу, <w>из-за чего</w> я очень сильно рассмеялся.",
                                "pl": "Zrobił śmieszną minę, <w>przez co</w> zacząłem się bardzo głośno śmiać."
                            }
                        },
                        {
                            "text": "Dat is de reden <w>daarom</w> we dit plan hebben gekozen.",
                            "target_lang_translations": {
                                "en": "That is the reason <w>for which</w> we chose this plan.",
                                "ru": "Это причина, <w>почему</w> мы выбрали этот план.",
                                "pl": "To jest powód, <w>dla którego</w> wybraliśmy ten plan."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pronominal adverb"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "pronominal adverb formed from 'om' and 'dat', referring to a previously mentioned reason",
                        "ru": "местоименное наречие, образованное от 'om' и 'dat', отсылающее к ранее упомянутой причине",
                        "pl": "zaimek przysłowny utworzony z 'om' i 'dat', odnoszący się do wcześniej wspomnianej przyczyny"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for which",
                                "target_lang_sense_clarification": "referring to a reason"
                            },
                            {
                                "target_lang_word": "because of which",
                                "target_lang_sense_clarification": "indicating causality"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "из-за чего",
                                "target_lang_sense_clarification": "отсылка к причине"
                            },
                            {
                                "target_lang_word": "почему",
                                "target_lang_sense_clarification": "в значении 'по причине которого'"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "z tego powodu",
                                "target_lang_sense_clarification": "odniesienie do przyczyny"
                            },
                            {
                                "target_lang_word": "przez co",
                                "target_lang_sense_clarification": "wskazuje na skutek wcześniejszego zdarzenia"
                            },
                            {
                                "target_lang_word": "dlaczego",
                                "target_lang_sense_clarification": "w znaczeniu 'z powodu którego'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "75eabcd2-7d3a-3659-8adf-129be503e784",
                    "sense_definition": "gezegd als ontwijkend antwoord op een vraag naar de reden",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "antwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom moet ik mijn kamer opruimen? Gewoon <w>daarom</w>!",
                            "target_lang_translations": {
                                "en": "Why do I have to clean my room? Just <w>because</w>!",
                                "ru": "Почему я должен убираться в комнате? Просто <w>потому что</w>!",
                                "pl": "Dlaczego muszę posprzątać swój pokój? Po prostu <w>bo tak</w>!"
                            }
                        },
                        {
                            "text": "Als een kind vraagt waarom iets moet, antwoorden ouders vaak met <w>daarom</w>.",
                            "target_lang_translations": {
                                "en": "When a child asks why something must be done, parents often answer with '<w>because</w>'.",
                                "ru": "Когда ребенок спрашивает, почему что-то нужно сделать, родители часто отвечают «<w>потому что</w>».",
                                "pl": "Kiedy dziecko pyta, dlaczego trzeba coś zrobić, rodzice często odpowiadają „<w>bo tak</w>”."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daarom is geen reden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by children or as a non-answer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "said as an evasive answer to a question about the reason",
                        "ru": "используется как уклончивый ответ на вопрос о причине",
                        "pl": "używane jako wymijająca odpowiedź na pytanie o przyczynę"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just because",
                                "target_lang_sense_clarification": "evasive answer to 'why?'"
                            },
                            {
                                "target_lang_word": "because",
                                "target_lang_sense_clarification": "short non-answer"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "потому что",
                                "target_lang_sense_clarification": "краткий ответ без объяснения"
                            },
                            {
                                "target_lang_word": "просто так",
                                "target_lang_sense_clarification": "уклончивый ответ"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bo tak",
                                "target_lang_sense_clarification": "wymijająca odpowiedź na pytanie 'dlaczego?'"
                            },
                            {
                                "target_lang_word": "dlatego",
                                "target_lang_sense_clarification": "krótka odpowiedź bez podawania powodu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d205088c-a146-31e1-a04f-fa4e96ea85e8",
                    "sense_definition": "gezegd om volledige instemming of bevestiging uit te drukken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Daarom</w> juist! Dat is precies wat ik bedoelde te zeggen.",
                            "target_lang_translations": {
                                "en": "<w>Exactly</w>! That is precisely what I meant to say.",
                                "ru": "<w>Вот именно</w>! Это как раз то, что я хотел сказать.",
                                "pl": "<w>No właśnie</w>! To jest dokładnie to, co miałem na myśli."
                            }
                        },
                        {
                            "text": "Je hebt helemaal gelijk, <w>daarom</w> moeten we nu actie ondernemen.",
                            "target_lang_translations": {
                                "en": "You are completely right, <w>that's why</w> we must take action now.",
                                "ru": "Ты совершенно прав, <w>именно поэтому</w> мы должны действовать сейчас.",
                                "pl": "Masz całkowitą rację, <w>dlatego właśnie</w> musimy teraz podjąć działania."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daarom juist"
                    ],
                    "target_lang_definitions": {
                        "en": "said to express full agreement or confirmation",
                        "ru": "используется для выражения полного согласия или подтверждения",
                        "pl": "używane do wyrażenia pełnej zgody lub potwierdzenia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "expressing agreement"
                            },
                            {
                                "target_lang_word": "precisely",
                                "target_lang_sense_clarification": "confirming a point"
                            },
                            {
                                "target_lang_word": "that's it",
                                "target_lang_sense_clarification": "confirming what was said"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вот именно",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "в том-то и дело",
                                "target_lang_sense_clarification": "подтверждение мысли"
                            },
                            {
                                "target_lang_word": "именно поэтому",
                                "target_lang_sense_clarification": "акцентированное подтверждение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "otóż to",
                                "target_lang_sense_clarification": "wyrażenie pełnej zgody"
                            },
                            {
                                "target_lang_word": "właśnie dlatego",
                                "target_lang_sense_clarification": "podkreślenie i potwierdzenie argumentu"
                            },
                            {
                                "target_lang_word": "no właśnie",
                                "target_lang_sense_clarification": "potwierdzenie słów rozmówcy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
