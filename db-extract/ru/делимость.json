                                                "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                                "text": "Les cas de divisibilité des nombres."
                                            },
                                            {
                                                "example_id": "4d78d19e-8dc1-4ad4-ab1a-f9a6a4bca3a0",
                                                "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                                "text": "La divisibilité d’un nombre par 3, par 5."
