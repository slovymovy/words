                        "entry_id": "797978d2-38d8-389c-bd4e-355828b73d4c",
                        "glosses": [
                            "Items thrown overboard from a ship or boat in distress in order to lighten its load."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70dafcef-abf4-4905-95ce-65854da351f9",
                                "sense_id": "e37646a8-5761-3599-9d28-2bac55529988",
                                "text": "There she was, floating amongst the jetsam, like so much debris."
                            }
                        ]
                    },
                    {
                        "sense_id": "63769b0f-966f-346e-94c0-1febb48c83ab",
                        "entry_id": "797978d2-38d8-389c-bd4e-355828b73d4c",
                        "glosses": [
                            "Discarded or leftover odds and ends."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c3e3076-6774-4a8d-92cc-474ff391ab61",
                                "sense_id": "63769b0f-966f-346e-94c0-1febb48c83ab",
                                "text": "They were the jetsam of the dot-com bust."
                            },
                            {
                                "example_id": "bbee1778-bc67-4c45-8f39-6caf4613f686",
                                "sense_id": "63769b0f-966f-346e-94c0-1febb48c83ab",
                                "text": "STORAGE boxes -- catchalls for flotsam, jetsam, whatnots and thingamajigs -- are gaining new interest as decorative objects for the home."
                            }
                        ]
                    }
                ],
