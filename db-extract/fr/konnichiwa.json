                    {
                        "sense_id": "7206d1ba-582e-33c4-909f-ebdddb5a8781",
                        "entry_id": "4b7e8ce6-7139-3dd4-9a73-f95ad5a71a78",
                        "glosses": [
                            "Bonjour !"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "note": "S’utilise principalement dans les commuanutés otaku",
                        "examples": [
                            {
                                "example_id": "cb0a55f2-0a07-473e-91de-51e4eeb6def9",
                                "sense_id": "7206d1ba-582e-33c4-909f-ebdddb5a8781",
                                "text": "Konnichiwa !\nSuite des live sur l'histoire du jeu Vidéo accompagné de professeur Douglas avec ce Jeudi 17 Aout a 21h sur Twitch, Facebook, Twitter et Youtube. A toute !"
                            },
                            {
                                "example_id": "ddb2d71b-f7d8-4ef1-9093-6fc491056435",
                                "sense_id": "7206d1ba-582e-33c4-909f-ebdddb5a8781",
                                "text": "Konnichiwa Vero 👋. Ça a l'air très amusant. Passez un bon moment. Je viens de faire une belle promenade autour du château 🤗😘"
                            },
                            {
                                "example_id": "a623860f-8026-44f8-be1e-4f9763da151f",
                                "sense_id": "7206d1ba-582e-33c4-909f-ebdddb5a8781",
                                "text": "🤗\nMinasan konnichiwa 😊\nBonne journée à celles et ceux qui le méritent ❤️ 😘"
                            }
                        ]
                    }
                ],
