{
    "word_family": [
        "caveator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "786112f5-b1cb-3b62-8716-8bcf34ef24bf",
                    "sense_definition": "A qualification or exemption that limits a more general statement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his daughter some hyacinth bulbs with the <w>caveat</w> that she plant them in the shade."
                        },
                        {
                            "text": "The report was positive, but it included a <w>caveat</w> regarding the potential for future budget cuts."
                        }
                    ],
                    "synonyms": [
                        "stipulation",
                        "proviso",
                        "condition"
                    ],
                    "common_phrases": [
                        "important caveat",
                        "major caveat",
                        "with the caveat"
                    ]
                },
                {
                    "sense_id": "5bef78f5-e9c0-35e0-8271-a3a62c294d56",
                    "sense_definition": "A warning or caution to prevent misunderstanding or to discourage a specific behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is at least one <w>caveat</w> in cultivation: you will have to stick to only one discipline."
                        },
                        {
                            "text": "The investment advice came with a <w>caveat</w> about the high volatility of the current market."
                        }
                    ],
                    "common_phrases": [
                        "word of caveat",
                        "necessary caveat"
                    ]
                },
                {
                    "sense_id": "f3351165-c3c2-3843-85b6-4d977bb21211",
                    "sense_definition": "A formal notice of interest in land or a legal objection to prevent certain actions until a hearing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The purpose of a <w>caveat</w> is to give a person with an unregistered interest the ability to protect it."
                        },
                        {
                            "text": "The lawyer advised his client to <w>lodge</w> a <w>caveat</w> against the property to prevent its sale."
                        }
                    ],
                    "common_phrases": [
                        "lodge a caveat",
                        "enter a caveat",
                        "remove a caveat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2caaf99-b389-3af9-bde2-6158fa18a963",
                    "sense_definition": "To qualify a statement or agreement by adding a warning or specific conditions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "qualification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I want to <w>caveat</w> everything I say with the disclaimer that I was working from old photos."
                        },
                        {
                            "text": "The spokesperson <w>caveated</w> that the data was still preliminary and subject to change."
                        }
                    ],
                    "common_phrases": [
                        "caveat a response",
                        "caveat the findings"
                    ]
                },
                {
                    "sense_id": "67b43459-7696-3be0-b967-c10cf05f5f06",
                    "sense_definition": "To formally object or to lodge a legal notice of interest in property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unclear whether a purchaser will be regarded as guilty of conduct if failing to <w>caveat</w>."
                        },
                        {
                            "text": "The defendant <w>caveated</w> against the granting of probate on the ground that the will was not duly executed."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ]
                }
            ]
        }
    ]
}