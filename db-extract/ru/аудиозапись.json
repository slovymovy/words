                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c520a111-f05d-33db-af8e-3ad75f78a70c",
                                        "entry_id": "d34770f1-8216-33ea-89a0-d7d148a9f194",
                                        "glosses": [
                                            "Alternative form of soundtrack."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8b49117-bdcb-4542-9bec-b56657be7b22",
                                                "sense_id": "c520a111-f05d-33db-af8e-3ad75f78a70c",
                                                "text": "As the rest of the film was made on location in the railway yards of Havre and not in a studio, and was given a sound-track of penetrating vividness, this whole production gives the closest possible ring of truth of any film about railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cfffc96-331e-4ca0-8e7f-d4dcafc4fe1f",
                        "source_entry_id": "76c687c5-02d8-3c9f-ac62-6175c32e4906",
                        "source_sense_id": "ea2b166e-4053-30bd-a2e2-a2a007c34bc3",
                        "target_lang_word": "soundtrack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soundtrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1da7ab0d-1291-3d50-8ac3-33df3e9396e2",
                                        "entry_id": "2edc10b7-fc27-3b7b-bd98-8b5601ec20d2",
                                        "glosses": [
                                            "A narrow strip running down a movie film that carries the recorded sound in synchronization with the pictures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbb36c23-1562-3bf4-b639-b7d86155a68e",
                                        "entry_id": "2edc10b7-fc27-3b7b-bd98-8b5601ec20d2",
                                        "glosses": [
                                            "The sound (especially the music) component of a movie, video game, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43b0f9bb-9558-3f3c-93c1-478f4676ea66",
                                        "entry_id": "2edc10b7-fc27-3b7b-bd98-8b5601ec20d2",
                                        "glosses": [
                                            "A recording of such music for sale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "729b5363-cade-3aae-aded-dadce0ed6db8",
                                        "entry_id": "2edc10b7-fc27-3b7b-bd98-8b5601ec20d2",
                                        "glosses": [
                                            "A background sound that is part of a larger event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e6d050-7e1c-46a6-9837-907baab7b89e",
                                                "sense_id": "729b5363-cade-3aae-aded-dadce0ed6db8",
                                                "text": "There was a startling lack of creativity and if Van Gaal had listened closely he would have made out the mocking chants from the away end, as the visiting fans embarked on the repertoire of songs that formed the soundtrack to David Moyes’s time in the job."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soundtrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32d96541-a1cb-3040-b11d-d085d7f0ac3e",
                                        "entry_id": "9e2d2026-d303-3acb-afd1-f068089bcf77",
                                        "glosses": [
                                            "To provide, or to act as the sound or music component of a film."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2ae0f6-ee83-4a9d-8358-f4b95c554979",
                                                "sense_id": "32d96541-a1cb-3040-b11d-d085d7f0ac3e",
                                                "text": "The world, in turn, watched, clicked, cried, danced, sang along, swooned, caravanned to stadiums and movie theaters, let her work soundtrack their lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6a55b53-0b76-43bf-9686-c87d44798bb7",
                        "source_entry_id": "76c687c5-02d8-3c9f-ac62-6175c32e4906",
                        "source_sense_id": "ea2b166e-4053-30bd-a2e2-a2a007c34bc3",
                        "target_lang_word": "audio recording",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15359a09-26b9-492d-b21e-1b4ae88d1e0e",
                        "source_entry_id": "76c687c5-02d8-3c9f-ac62-6175c32e4906",
                        "source_sense_id": "ea2b166e-4053-30bd-a2e2-a2a007c34bc3",
                        "target_lang_word": "Tonaufnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonaufnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                        "entry_id": "699ff481-e894-3a47-a384-77fcdb65efb4",
                                        "glosses": [
                                            "Aufzeichnung eines hörbaren Ereignisses (Musik, gesprochener Text, Naturgeräusch, …) und deren Ergebnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7013bcf9-4b96-4259-a4f9-e892470f38b4",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "„Unser großen Glück sind die wenigen Tonaufnahmen, die mit Johnson gemacht wurden.“"
                                            },
                                            {
                                                "example_id": "0d9fb805-57af-4673-b600-17e3fc5e6cf9",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "Das Gespräch [zwischen Radovan Karadzic und Ratko Mladic] haben auch andere aufgezeichnet. Die Tonaufnahme und andere Beweise liegen dem Haager Kriegsverbrechertribunal vor."
                                            },
                                            {
                                                "example_id": "4a217253-7e20-4d31-9369-5138d2a9ed16",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "Am späten Mittag standen Messner und Habeler auf dem höchsten Punkt der Erde, 8850 Meter hoch. Eine Umarmung, ein paar Fotos, eine Tonaufnahme, zu viel mehr waren beide nicht mehr fähig."
                                            },
                                            {
                                                "example_id": "13b1324a-a3bf-418d-b616-ff909fed06f7",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "[New York Philharmonic Orchestra:] Fast 2.000 Tonaufnahmen – und bis 1999 13.000 Aufführungen: Das sind Zahlen, an die kein anderes Orchester der Welt herankommt."
                                            },
                                            {
                                                "example_id": "0af52f43-5310-4dd7-a399-6636aa35f5f7",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "Allerdings konnten die Experten nicht alles entschlüsseln. Mit der Walze, auf der eine deutsche Stimme zu hören war, wendeten sie sich daher an den Berliner Restaurator Stephan Puille, einen international anerkannten Experten für Tonaufnahmen."
                                            },
                                            {
                                                "example_id": "6da2617e-6063-46b3-9131-74086d844ed9",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "[…] veröffentlicht wurde nun eine Tonaufnahme, die von einer verdeckten Ermittlung der New Yorker Polizei von 2015 stammen soll."
                                            },
                                            {
                                                "example_id": "e0fb63a4-b0a1-4706-af20-4ecda53b1fc9",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "Er [Stephen Manning] erwartet im Mai eine zweimonatige Haftstrafe. Angeblich hat er einen Richter im Saal beschimpft. Der Abschnitt der Tonaufnahme, die das beweisen soll, ist gelöscht. Warum? – darauf gibt die Justiz auf Nachfrage keine Antwort."
                                            },
                                            {
                                                "example_id": "d02f9f1a-0c43-471c-b8fa-8980611b1f44",
                                                "sense_id": "f5604f30-575f-336f-a529-e4c636953b66",
                                                "text": "Richard Huelsenbeck liest aus seinen „Phantastischen Gebeten“. Zu Beginn des Ersten Weltkriegs entstanden, hielten sie der absurd gewordenen Welt den Spiegel vor. Die Tonaufnahme stammt aus den 50er-Jahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
