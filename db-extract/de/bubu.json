                    {
                        "sense_id": "0e7b4af2-a4a1-3c37-a6ec-b82798a4ea8d",
                        "entry_id": "682c2700-47a5-3ef5-88c4-7ab7fa33d254",
                        "glosses": [
                            "in Westafrika verbreitetes weites, fließendes Gewand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665c0ae9-efe1-48db-940c-60e3ae227d86",
                                "sense_id": "0e7b4af2-a4a1-3c37-a6ec-b82798a4ea8d",
                                "text": "„In der Ecke erhob sich eine Gestalt und trat ins Licht, und ich erkannte eine Frau in Bubu und Umschlagtuch; ein Schal verhüllte fast ihr ganzes Gesicht.“"
                            },
                            {
                                "example_id": "eaee1fc8-8b45-4f03-aee5-b239ac2bf461",
                                "sense_id": "0e7b4af2-a4a1-3c37-a6ec-b82798a4ea8d",
                                "text": "„Ich bin nicht gerade passend angezogen, um Gäste zu empfangen - ich trage einen Bubu und einen Turban -, aber wer es auch ist, wird mich so nehmen müssen, wie ich bin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
