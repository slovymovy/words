                {
                    "sense_id": "1ce296ee-f404-3c39-bcbe-1d65e57fe3bf",
                    "sense_definition": "Petit pieu taillé en pointe que l'on enfonce en terre pour tendre des cordes, soutenir des plantes ou fixer des limites.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons enfoncé chaque <w>piquet</w> dans le sol pour bien stabiliser la grande tente."
                        },
                        {
                            "text": "Il a attaché une ficelle solide à un <w>piquet</w> en bois pour délimiter les rangs de salades."
                        }
                    ],
                    "synonyms": [
                        "poteau"
                    ],
                    "common_phrases": [
                        "piquet de tente",
                        "planter un piquet"
                    ]
                },
                {
                    "sense_id": "377d6001-f29c-32b8-b45b-a026df9f4798",
                    "sense_definition": "Punition scolaire traditionnelle imposant à un enfant de demeurer debout et immobile, souvent dans le coin d'une classe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour avoir bavardé pendant le cours, l'écolier a été envoyé au <w>piquet</w> près du tableau."
