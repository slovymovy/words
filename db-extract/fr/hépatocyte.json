                ],
                "senses": [
                    {
                        "sense_id": "98361ad4-e1b9-3e68-a280-d410762fcd75",
                        "entry_id": "31d9c811-03a2-30f1-a390-9da83b6dc738",
                        "glosses": [
                            "Cellule du foie, assurant de nombreuses fonctions métaboliques dont la glycogénogénèse et la phosphorolyse (ou glycogénolyse) du glycogène, la néoglucogenèse à partir des lipides, la dégradation de l'hémoglobine et la sécrétion exocrine de bile, le traitement de nombreuses substances toxiques dont l'alcool."
                        ],
                        "tags": [
                            "Hépatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6a6d86a8-5063-4460-9673-bfb66fba2658",
                                "sense_id": "98361ad4-e1b9-3e68-a280-d410762fcd75",
                                "text": "L’histologie de la cirrhose montre une fibrose en pont délimitant des nodules de régénération, fait de travées bicellulaires d’hépatocytes parfois dysplasiques."
                            },
                            {
                                "example_id": "5fa9a4a5-6521-45f5-8ea3-e2ce93b75166",
                                "sense_id": "98361ad4-e1b9-3e68-a280-d410762fcd75",
                                "text": "Ils sont souvent bordés en partie par un hépatocyte et en partie par des cellules épithéliales aplaties d’apparence banale."
                            }
                        ]
                    }
                ],
