                                                "sense_id": "15ecb43a-948e-3473-b31a-6d6df9bf9f64",
                                                "text": "„Wenn du einmal im Monat ein wahres Ekel bist, hast du zumindest eine gute Entschuldigung dafür.“"
                                            },
                                            {
                                                "example_id": "5227d9cd-0586-4584-835a-8ea91973308d",
                                                "sense_id": "15ecb43a-948e-3473-b31a-6d6df9bf9f64",
                                                "text": "Das „Ekel Alfred“ wurde vom Schauspieler Heinz Schubert gegeben."
                                            },
                                            {
                                                "example_id": "285aa85c-ae08-429e-b035-5eaead89a9f2",
                                                "sense_id": "15ecb43a-948e-3473-b31a-6d6df9bf9f64",
                                                "text": "„Pécuchet entsann sich eines seiner Bürochefs, eines wahren Ekels, und er faßte den Plan, sich durch ein Buch an ihm zu rächen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
