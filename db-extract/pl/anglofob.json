                        "cross_references": [
                            {
                                "target_word": "Anglophobe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8cea755-dc46-32f5-9585-97b82f1f330f",
                                        "entry_id": "b6aeff38-4455-3e1d-b0e4-d7e78d559959",
                                        "glosses": [
                                            "A person who dislikes or fears England, its people or anything English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df5ef3f4-622e-428c-aef1-292439638834",
                                                "sense_id": "e8cea755-dc46-32f5-9585-97b82f1f330f",
                                                "text": "Not surprisingly, in view of their country's defeat in the Crimean War, they were Anglophobes to a man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0416fd17-67f5-4a0b-a218-c85d11911343",
                        "source_entry_id": "df51f445-f22f-3d1f-a69d-56111d8b6d3a",
                        "source_sense_id": "1eeef066-b6dd-33c6-9ca9-ad1f6526608b",
                        "target_lang_word": "anglophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b1ec80a-8413-3136-96b9-b7fa2c4c80a3",
                                        "entry_id": "53d8179b-34b1-3c60-8676-df080054e914",
                                        "glosses": [
                                            "Qui concerne l’anglophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba028fc0-cec4-4b97-ae67-711e33f3c640",
                                                "sense_id": "6b1ec80a-8413-3136-96b9-b7fa2c4c80a3",
                                                "text": "Sentiments anglophobes."
                                            },
                                            {
                                                "example_id": "772ae964-810a-4180-b7f1-b248660d108e",
                                                "sense_id": "6b1ec80a-8413-3136-96b9-b7fa2c4c80a3",
                                                "text": "Les effets pernicieux de cette violente campagne anglophobe se feront sentir plus tard : pendant la drôle de guerre, lors de l’évacuation de Dunkerque et du drame de Mers-el-Kébir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anglophobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5076fa-5a8c-39a0-b18d-78e6c575e179",
                                        "entry_id": "22502762-6ee1-39ad-98a7-c7bbeb785d46",
                                        "glosses": [
                                            "Personne qui manifeste de l’anglophobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e7338ef-0571-4732-8d97-5b98642a4e9c",
                                                "sense_id": "ec5076fa-5a8c-39a0-b18d-78e6c575e179",
                                                "text": "Il est tombé dans une embuscade et il semblerait, d’après nos anglophobes, que les soldats de Sa Majesté britannique ne se soient pas portés promptement à son secours."
                                            },
                                            {
                                                "example_id": "dbd2fbe0-0458-4029-a140-826259f7040d",
                                                "sense_id": "ec5076fa-5a8c-39a0-b18d-78e6c575e179",
                                                "text": "Ajoutez à cela un phrasé ultralent à ravir l’anglophobe recalé au TOEIC, mais à inquiéter qui l’imaginait en bredouilleuse compliquée et très second degré, et vous aurez un panorama assez exact de l’étrangeté de la situation."
                                            }
                                        ]
                                    }
                                ]
                            }
