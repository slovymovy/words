                                        "glosses": [
                                            "speziell für das Schlachtfeld konzipiertes Schneidewerkzeug mit Griff und Klinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b79fee1-dfb5-4828-a1b7-d73892887752",
                                                "sense_id": "d868d6b2-34af-3fec-8647-76f41192dde5",
                                                "text": "Ein typisches Feldmesser ist etwa 15-20 Zentimeter lang."
                                            },
                                            {
                                                "example_id": "d10cf82f-deb3-4991-a34f-a8ff5f9c7acc",
                                                "sense_id": "d868d6b2-34af-3fec-8647-76f41192dde5",
                                                "text": "„Von Zeitler bis Glock 1975 erhielt die Wiener Firma Zeitler den Auftrag, ein Mehrzweckmesser zu entwerfen, das sowohl als Feldmesser und bei Bedarf auch als Seitengewehr zu verwenden sein sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "574da2ce-3160-494b-9344-ceeb12f0820e",
