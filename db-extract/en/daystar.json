                        "entry_id": "a146a064-195b-3f01-a47e-7c01eafd53d2",
                        "glosses": [
                            "The planet Venus as the morning star."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc12bf9-2d2d-4eb4-aa22-ed7f43c15146",
                                "sense_id": "d1b7a691-01e1-3a19-b71a-f85f308591be",
                                "text": "Near-synonyms: Vesper, Hesperus, evening star, Venus"
                            },
                            {
                                "example_id": "e9bc0213-df6b-4aa5-a2d7-97b60173e312",
                                "sense_id": "d1b7a691-01e1-3a19-b71a-f85f308591be",
                                "text": "Here dawn'd the daystar of Hesperia's fame, / Here herald glory first emblazed her name;"
                            },
                            {
                                "example_id": "d8655c0a-8b8e-4c2a-ad26-e98dd5e2dd30",
                                "sense_id": "d1b7a691-01e1-3a19-b71a-f85f308591be",
                                "text": "And we have more sure the prophetic word; to which ye do well that ye take heed, as to a lamp shining in a dark place, until the day dawn, and the daystar arise in your hearts;"
                            }
                        ]
                    },
                    {
                        "sense_id": "3305fce0-6937-32c4-85e9-6555c0b5c38b",
                        "entry_id": "a146a064-195b-3f01-a47e-7c01eafd53d2",
                        "glosses": [
                            "The Sun."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "3ff51df4-7a8e-4e41-8323-a3063cdeec6f",
                                "sense_id": "3305fce0-6937-32c4-85e9-6555c0b5c38b",
                                "text": "I only go outdoors at night, away from the daystar's burning glare."
                            }
                        ]
                    }
