                                        "glosses": [
                                            "One of a class of teachers of rhetoric, philosophy, and politics in ancient Greece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f0d8fa2-353b-39c8-8abf-436549ee2171",
                                        "entry_id": "e08e1ce5-43d3-35cc-a128-2849e40c32ac",
                                        "glosses": [
                                            "A teacher who uses plausible but fallacious reasoning."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "370af941-7970-37c9-bbd3-e0a4f4676f0f",
                                        "entry_id": "e08e1ce5-43d3-35cc-a128-2849e40c32ac",
                                        "glosses": [
                                            "One who is captious, fallacious, or deceptive in argument."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a8cb5c2-bc2d-48cf-808a-554aa570da7f",
                                                "sense_id": "370af941-7970-37c9-bbd3-e0a4f4676f0f",
                                                "text": "[T]hey have acted in this Calumny both the injuſtice of the Tyrant, and the forgery of the Sophiſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a062d5-e9b7-3f92-bd0c-d9a5f4156afa",
