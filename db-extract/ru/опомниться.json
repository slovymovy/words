                    {
                        "translation_id": "31f5f70d-65a8-49c4-8d11-6c39fcb8386a",
                        "source_entry_id": "993eddd6-c3e4-3c8c-b96c-53e74ce3f216",
                        "source_sense_description": "поняв ошибочность своего поведения, своих намерений, отказаться от них",
                        "target_lang_word": "come to one's senses",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "come to one's senses",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2903985c-785a-36d2-98c4-546ca5ecfb82",
                                        "entry_id": "035ffd3a-7187-3fb0-b491-ffe9a0139ad6",
                                        "glosses": [
                                            "To reawaken after having lost consciousness."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e7beb9-7444-4652-9fb0-e382f07b12c6",
                                                "sense_id": "2903985c-785a-36d2-98c4-546ca5ecfb82",
                                                "text": "[H]e dropped from his seat at my side, like a man struck dead. The stifling heat in the theater had proved too much for him. We carried him out at once into the fresh air. When he came to his senses, my friend entreated me to leave him, and see the end of the play."
                                            },
                                            {
                                                "example_id": "e6f1f193-f985-43e4-bbb2-e1e4c4b4436a",
                                                "sense_id": "2903985c-785a-36d2-98c4-546ca5ecfb82",
                                                "text": "He turned toward the door, plunged forward, fell unconscious. . . . When he came to his senses he was in his bed—comfortable, weak, lazy."
                                            },
                                            {
                                                "example_id": "deb7f9c3-cacb-457a-b065-01fd699c0250",
                                                "sense_id": "2903985c-785a-36d2-98c4-546ca5ecfb82",
                                                "text": "The accident sent Bahutule into coma straight away. When he came to his senses, he lay in bed with a fractured right femur bone and a crushed left elbow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fedd4d9e-eea8-372e-b5ad-1819c448366b",
                                        "entry_id": "035ffd3a-7187-3fb0-b491-ffe9a0139ad6",
                                        "glosses": [
                                            "To become reasonable, comprehending, or responsible, especially after having behaved in an unreasonable, confused, uncomprehending, or irresponsible manner."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "099d7a49-7cc1-413c-b529-dc45f4df8242",
                                                "sense_id": "fedd4d9e-eea8-372e-b5ad-1819c448366b",
                                                "text": "Dick had not been altogether in his right senses. . . . He found his mother weeping as though her heart would break; whereat his own heart smote him so that he came to his senses there and then, and knelt in humility and shame at her feet."
                                            },
                                            {
                                                "example_id": "5cf34236-7782-422a-9297-ffcd18b90a32",
                                                "sense_id": "fedd4d9e-eea8-372e-b5ad-1819c448366b",
                                                "text": "\"I shall never divorce you,\" he said, as if a nail had been driven in. . . .\nShe went upstairs and told Hilda the upshot.\n\"Better get away tomorrow,\" said Hilda, \"and let him come to his senses.\""
                                            },
                                            {
                                                "example_id": "7eff245c-cc9c-49cf-a85e-f84c12f0d9e6",
                                                "sense_id": "fedd4d9e-eea8-372e-b5ad-1819c448366b",
                                                "text": "Thus, after eighteen months of fantastic and ruinous warfare, the companies had come to their senses and agreed to do what they might have done at the start; the only gainers were the passengers who had been carried at ridiculously uneconomic fares."
                                            },
                                            {
                                                "example_id": "92e38c5f-1e1f-4af5-86e9-a7c893b05064",
                                                "sense_id": "fedd4d9e-eea8-372e-b5ad-1819c448366b",
                                                "text": "\"She is mad with sorrow, but maybe after a few days she will come to her senses,\" says one man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22c3af39-41b2-4eff-9cce-48986b7346a9",
                        "source_entry_id": "993eddd6-c3e4-3c8c-b96c-53e74ce3f216",
                        "source_sense_description": "поняв ошибочность своего поведения, своих намерений, отказаться от них",
                        "target_lang_word": "se remettre",
                        "target_lang_code": "fr",
