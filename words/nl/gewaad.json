        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89a76d4f-19af-3002-957f-ddc1ec9af1f3",
                    "sense_definition": "voltooid deelwoord van <w>waden</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zijn voorzichtig door de ondiepe beek <w>gewaad</w> om de overkant te bereiken.",
                            "target_lang_translations": {
                                "en": "They carefully <w>waded</w> through the shallow stream to reach the other side."
                            }
                        },
                        {
                            "text": "Nadat hij urenlang door het moeras had <w>gewaad</w>, waren zijn schoenen volledig vernield.",
                            "target_lang_translations": {
                                "en": "After he had <w>waded</w> through the swamp for hours, his shoes were completely ruined."
                            }
                        }
                    ],
                    "target_lang_definitions": {
