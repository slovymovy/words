                    },
                    {
                        "translation_id": "4f356aaf-5e03-49b5-bfce-3514a12b6222",
                        "source_entry_id": "6e9588f9-d955-3bac-925a-a17428e76c61",
                        "source_sense_id": "b1524c28-841f-3fbc-8f4c-c57514ca7573",
                        "source_sense_description": "iemand die een levensbedreigende situatie overleefd heeft",
                        "target_lang_word": "survivant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2afa6c3f-c4eb-3453-817a-3ab52bb0703c",
                                        "entry_id": "4d8cecf9-a9c5-381f-9f4b-ba452779f486",
                                        "glosses": [
                                            "Qui survit à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558babb7-9348-48cb-8934-b615d7b28802",
                                                "sense_id": "2afa6c3f-c4eb-3453-817a-3ab52bb0703c",
                                                "text": "Lorsque le conjoint survivant recueille la totalité ou les trois quarts des biens, les ascendants du défunt, autres que les père et mère, qui sont dans le besoin bénéficient d'une créance d'aliments contre la succession du prédécédé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19fc443b-dad1-30b3-b010-5ca7f2b46ca7",
                                        "entry_id": "4d8cecf9-a9c5-381f-9f4b-ba452779f486",
                                        "glosses": [
                                            "Qui survit à un accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8916db-22f6-43c4-af76-e0f9c743b485",
                                                "sense_id": "19fc443b-dad1-30b3-b010-5ca7f2b46ca7",
                                                "text": "Nous nous réunîmes une dernière fois, mes quelques hommes survivants et moi, et décidâmes de tenter notre chance suivant la règle du « chacun pour soi »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "survivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93e22485-e85b-3de2-acd2-5e5386dfd3e5",
                                        "entry_id": "98a0a26e-df78-3f2a-9819-8c6664329064",
                                        "glosses": [
                                            "Celui qui a survécu à une autre personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6c02fd-8849-4f27-9a3c-80f4b6dc599f",
                                                "sense_id": "93e22485-e85b-3de2-acd2-5e5386dfd3e5",
                                                "text": "Le survivant des époux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae50bd7-29ee-3c0b-bd45-7632bb4ad494",
                                        "entry_id": "98a0a26e-df78-3f2a-9819-8c6664329064",
                                        "glosses": [
                                            "Celui qui a survécu à un événement traumatique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a0ca63-86ca-4e6a-a793-a199bafaba3e",
                                                "sense_id": "1ae50bd7-29ee-3c0b-bd45-7632bb4ad494",
                                                "text": "L’altérité permet de reconnaître cet autre dans sa valeur, dans la singularité des épreuves qu’il a endurées et permet de réinscrire à sa juste place tout survivant dans une humanité partagée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264f8163-0866-395a-b058-bf730e2ce758",
                                        "entry_id": "98a0a26e-df78-3f2a-9819-8c6664329064",
                                        "glosses": [
                                            "Celui qui a survécu à un événement traumatique.",
                                            "Celui qui a survécu à un accident, à une catastrophe, à une maladie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8d1dfe-f649-46fe-b7ed-54148aef6023",
                                                "sense_id": "264f8163-0866-395a-b058-bf730e2ce758",
                                                "text": "Selon une étude de 1995 qui est toujours citée par les professionnels de la santé mentale et les avocats spécialisés dans les accidents de la route, 39,2% des survivants d’accidents de voiture développent un trouble de stress post-traumatique, et ce ne sont pas seulement ceux dont les voitures sont percutées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "116d5123-65ed-3af9-b498-d799fdd278aa",
                                        "entry_id": "98a0a26e-df78-3f2a-9819-8c6664329064",
                                        "glosses": [
                                            "Celui qui a survécu à un événement traumatique.",
                                            "Celui qui a survécu à une guerre, à un crime de masse, à un attentat, à un génocide."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03011945-2588-489a-ac47-46cdb4e6d529",
                                                "sense_id": "116d5123-65ed-3af9-b498-d799fdd278aa",
                                                "text": "Ce fut peut-être avec cet état d’esprit que les mobilisables amiénois, et les survivants de Milejgany, acceptèrent cette médaille. D’anciens prisonniers ne purent la recevoir de leur vivant."
                                            },
                                            {
                                                "example_id": "e6d32a8b-3812-41fb-951e-c1f656542224",
                                                "sense_id": "116d5123-65ed-3af9-b498-d799fdd278aa",
                                                "text": "Il y a 77 ans, le 9 août 1945, trois jours après Hiroshima, Nagasaki était à son tour frappée par la bombe atomique. À l’époque les caméras filmaient déjà l’horreur, mais ce sont les mots des survivants qui, des années plus tard, exprimaient le mieux l’inhumanité de cette arme de destruction massive."
                                            },
                                            {
                                                "example_id": "f6d758bd-ab1b-414f-9eec-5f66a4ab8da1",
                                                "sense_id": "116d5123-65ed-3af9-b498-d799fdd278aa",
                                                "text": "Les survivants affirment également que des sous-traitants blancs travaillant à la concession se sont rendus aux conteneurs à plusieurs reprises, essayant, en vain, de leur donner de la nourriture et de l’eau provenant de la cantine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10b4469-f396-3bd2-b240-1b4a2e504cf0",
                                        "entry_id": "98a0a26e-df78-3f2a-9819-8c6664329064",
                                        "glosses": [
                                            "Celui qui a survécu à un événement traumatique.",
                                            "Celui qui a survécu à un viol, à des violences sexuelles ou maltraitances, à la prostitution."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340535f3-9cf6-45c1-8855-27c3ead32902",
                                                "sense_id": "c10b4469-f396-3bd2-b240-1b4a2e504cf0",
                                                "text": "À Alexandra. À Armel, Louison. Aux survivantes et survivants de violences dans leur enfance. Pour tous les enfants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "survivant",
                                "target_lang_code": "fr",
                                "target_senses": [
