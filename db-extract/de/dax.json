                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                        "entry_id": "11daf95a-5e43-31ed-ba72-8d6f4e069e17",
                        "glosses": [
                            "abgetrennter Zweig eines Nadelbaums"
                        ],
                        "tags": [
                            "Bavarian",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "698ea8ec-babd-45ee-9e5a-d2a1bee57d3d",
                                "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                                "text": "„Mit rot gefrorenem Gesicht kam die Zenzi ins Möselholz, wohin sie der Bauer bestellt hatte, damit sie Daxen zusammenklauben sollte.“"
                            },
                            {
                                "example_id": "d2c26df0-253c-40ec-aa64-53b618abff7f",
                                "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                                "text": "„[…] zum Glück duftete draußen der tröstliche milde Markt mit Heilkräutern, Weidenzweigen, Vogelbeeren und Daxen […].“"
                            },
                            {
                                "example_id": "1f793aa9-5606-42a9-92f6-509951d758c0",
                                "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                                "text": "„So etwa bekommen Chrysanthemen ein paar Daxen als Schutz vor der ‚aperen Gfrier‘, d. h. gegen den schneelosen Frost.“"
                            },
                            {
                                "example_id": "272c33b1-d8f6-4ad9-a57b-c0ab750aa968",
                                "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                                "text": "„Wie die Polizei berichtet, soll der ältere Herr zwischen 13.20 und 13.30 Uhr zwei Bündel Daxen, also für Adventsschmuck verwendete Fichten- oder Tannenzweige, gestohlen haben, die vor dem Geschäft auslagen.“"
                            },
                            {
                                "example_id": "6d292a20-f81a-4f7e-a287-81f0e975458e",
                                "sense_id": "ff558edc-1b79-3823-9d56-6a9fd5939c65",
                                "text": "„Die Leonhardifahrt ist eine traditionelle Veranstaltung, welche alljährlich im November zelebriert wird. Der Festzug besteht aus in liebevoller Kleinarbeit mit Almrausch, Erika, Daxen und vielen weiteren Almpflanzen geschmückten Tafelwagen, aufwändig bemalten Truhenwagen und Reitern, deren Rösser, vom Pony bis zum Kaltblüter, mit kunstvollen Bändern und Gebinden verziert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
