                                                "sense_id": "aa0cceb2-bfb3-3182-b1c8-d36e6723597f",
                                                "text": "Il y avait autrefois des piquiers dans l’infanterie."
                                            },
                                            {
                                                "example_id": "22cce896-88fd-470d-a935-ec7c07c37042",
                                                "sense_id": "aa0cceb2-bfb3-3182-b1c8-d36e6723597f",
                                                "text": "L’équipement complet du piquier était donc constitué du “pot”, de la cuirasse, des “tassettes”, de l’épée et de la pique de plus de 5 mètres."
                                            }
                                        ]
                                    }
