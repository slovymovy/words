                                "target_senses": [
                                    {
                                        "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                        "entry_id": "c688f838-e953-3641-9735-2490d28b0b9a",
                                        "glosses": [
                                            "Bundesland in der Bundesrepublik Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351a1877-1064-456a-8668-5358a5268795",
                                                "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                                "text": "Hessen liegt zwischen Rhein, Neckar und Weser."
                                            },
                                            {
                                                "example_id": "39bc3469-03d3-4c48-961c-df0e5d8c3881",
                                                "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                                "text": "Hessen liegt in der Mitte Deutschlands."
                                            },
                                            {
                                                "example_id": "f4eb6a04-2481-4691-9a14-c6b6ec8007ea",
                                                "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                                "text": "„Deshalb sehe Amnesty ‚mit Sorge, dass mehr und mehr Bundesländer repressive Versammlungsgesetze erlassen, die das Recht auf friedlichen Protest einschränken und die Befugnisse der Polizei ausweiten, etwa in Nordrhein-Westfalen, Bayern und zuletzt in Hessen‘.“"
                                            },
                                            {
                                                "example_id": "8d6f2a4e-fc8b-44ea-a696-a31618f293fe",
                                                "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                                "text": "„Der Mord an Walter Lübcke, die Schüsse auf einen Eritreer in Wächtersbach, auch der Mord an Halit Yozgat in Kassel, die rassistischen Ermittlungen der westdeutschen Polizei im NSU-Komplex – gerade in Hessen gibt es knallharte rechtsextreme Strukturen, wahrscheinlich nach Ostdeutschland die gefährlichsten.“"
                                            },
                                            {
                                                "example_id": "dc187bc8-0953-43d1-9ee3-40327431d085",
                                                "sense_id": "d44d7cd9-c2c7-3ec3-95ed-0c75145f78ea",
                                                "text": "„Nach Bayern muss auch Hessen sein Verfassungsschutzgesetz nachbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
