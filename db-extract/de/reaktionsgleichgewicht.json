                "senses": [
                    {
                        "sense_id": "f5336766-6160-3000-94d6-1163caeef578",
                        "entry_id": "a5f72df4-3113-3747-9e5b-6ab2a6afce0f",
                        "glosses": [
                            "Zustand einer umkehrbaren chemischen Reaktion, wenn die Hin- und Rückreaktion sich ausbalanciert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f95a651-6a6f-444e-a992-14765c2d8aae",
                                "sense_id": "f5336766-6160-3000-94d6-1163caeef578",
                                "text": "„Das System vermindert diesen Zwang, indem die Wärme (Reaktionsenthalpie Δ_RH) verbraucht wird und das Reaktionsgleichgewicht zu den Produkten verschoben wird.“"
                            },
                            {
                                "example_id": "73d1d1f8-0670-41f8-a84c-4b79bf6603fa",
                                "sense_id": "f5336766-6160-3000-94d6-1163caeef578",
                                "text": "„Ihre Umsetzungen werden thermodynamisch nur in syntropher Assoziation mit methanogenen Archaeen möglich, wenn diese die Reaktionsprodukte (i.e. H₂ oder andere Zwischenprodukte) dem Reaktionsgleichgewicht mit CH₄-Bildung entziehen.“"
                            },
                            {
                                "example_id": "7478f6ec-e589-4e38-9c45-5373399e5648",
                                "sense_id": "f5336766-6160-3000-94d6-1163caeef578",
                                "text": "„Ziel war es auch, durch Extraktion mit diesen ionischen Flüssigkeiten Reaktionsprodukt(e) aus dem Reaktionsgemisch zu entfernen und ähnlich wie bei der Reaktivdestillation das Reaktionsgleichgewicht zu stören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
