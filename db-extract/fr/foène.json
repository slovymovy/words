                        "sense_id": "8f122e13-9ab0-39f0-80b4-13ad015f3e95",
                        "entry_id": "51c59291-a950-3785-ad00-acd796e36ac7",
                        "glosses": [
                            "ou Fourche pour manipuler le foin ou la paille."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f8472ae1-4aed-3955-92d3-e2774251c3d1",
                        "entry_id": "51c59291-a950-3785-ad00-acd796e36ac7",
                        "glosses": [
                            "Trident destiné à harponner le poisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d20c40-9ebe-4ae6-a1e0-6f1af31ed9b9",
                                "sense_id": "f8472ae1-4aed-3955-92d3-e2774251c3d1",
                                "text": "Se présentant ainsi comme une personne « sans tache », elle chercherait à obtenir la possibilité de quitter le pays, car il devenait nécessaire de multiplier les contacts, en tirant avantage des bases d’infiltration offertes par le régime marxiste du Mozambique dirigé par Samora Machel et établi sur une frontière que des citoyens d’Afrique du Sud, pourvus également de passeports, avaient coutume de franchir pour déguster les crevettes et pratiquer la pêche à la foène."
                            }
                        ]
                    },
                    {
                        "sense_id": "b67977de-f2cb-3a8c-bb19-835bed490873",
                        "entry_id": "51c59291-a950-3785-ad00-acd796e36ac7",
                        "glosses": [
                            "Harpon muni d’une pointe située entre deux bâtons recourbés qui retiennent le poisson ou l’anguille, une fois embrochée."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "note": "Les peuples des Premières Nations d'Amérique utilisaient ce genre d'outil pour pêcher l'anguille, notamment dans les anses de Sillery, près de Québec",
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faabde84-5777-403b-8df2-78a1c813d802",
                        "source_entry_id": "51c59291-a950-3785-ad00-acd796e36ac7",
                        "source_sense_description": "(Pêche)",
                        "target_lang_word": "Harpune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harpune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                        "entry_id": "d10a75ba-6743-391d-a048-880e11d19e13",
                                        "glosses": [
                                            "Speer mit Widerhaken für den Fischfang oder Walfang"
                                        ],
                                        "tags": [
                                            "Fischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d6bd42-f9c5-40b8-802e-74a1fa2db2d1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Wie die Umweltschutzorganisation mitteilte, feuerte ein Walfänger beim Schuss auf einen Zwergwal eine Harpune nur einen Meter über ein Greenpeace-Schlauchboot.“"
                                            },
                                            {
                                                "example_id": "6149e4c5-7706-4227-a125-c51d10ccf919",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Besser wäre es natürlich, die Harpune mitzunehmen, einen Riesenfisch zu harpunieren und ihn an Land zu ziehen.“"
                                            },
                                            {
                                                "example_id": "d87e4873-b967-469e-89cd-5382647ee7e9",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Er legt ein unvermutetes Talent für das Wattfischen - mit einer kleinen selbst gefertigten Harpune - an den Tag.“"
                                            },
                                            {
                                                "example_id": "eefc5ace-d84f-43ea-8cc3-77ffef11c5c1",
                                                "sense_id": "f9760dd3-732e-3831-ae0a-697b27979683",
                                                "text": "„Nach vier erfolglosen Versuchen warf er die Harpune ins Boot, zog sich an Bord und setze sich schweigend ins Heck, um das Paddel wieder aufzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
