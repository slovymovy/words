                "senses": [
                    {
                        "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                        "entry_id": "10db583f-b371-3075-a9a0-7126ac2b4572",
                        "glosses": [
                            "Personenkreis von miteinander verwandten Roma; einer Ethnie in Südosteuropa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efaf6543-a429-438b-a303-19ed1533280c",
                                "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                                "text": "„Im Juli 2012 wurde der Lebensunterhalt von etwa 800 Roma-Familien gefährdet, als die Polizei von Tirana einen Verwaltungsakt umsetzte, der das Sammeln von Abfall und anderen wiederverwendbaren Materialien verbot, und ihre Fahrzeuge und andere Ausrüstungsgegenstände beschlagnahmte.“"
                            },
                            {
                                "example_id": "5b433865-d673-4dd4-b516-d4f7265b8420",
                                "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                                "text": "„Roma-Familien leben oftmals ohne Strom und fließend Wasser.“"
                            },
                            {
                                "example_id": "ed71f66b-c334-4405-8158-316a9e30249d",
                                "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                                "text": "„Die Polizei in Irland hatte am Montag ein blondes Mädchen im Alter von sieben Jahren einer Roma-Familie entzogen und in staatliche Pflege gegeben.“"
                            },
                            {
                                "example_id": "3c1ac184-9de2-4eaa-884c-2f316d39e8d0",
                                "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                                "text": "„Seit Ende November 1993 gewährt die evangelische Kirche in Köln einer weiteren Roma-Familie aus Makedonien Kirchenasyl.“"
                            },
                            {
                                "example_id": "e06ceadb-353a-459a-8621-e98498670999",
                                "sense_id": "4267ff47-e32c-3b58-bfcf-fba63c2cf0f8",
                                "text": "„Dieser Ausschnitt zeigt sehr gut, daß die Roma-Familie als Einheit aufgefaßt wird. Anforderungen an das Kind sind gleichzeitig Anforderungen an die Familie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
