                "senses": [
                    {
                        "sense_id": "8dc2a3ec-ca6b-38bf-9c50-9992b7566980",
                        "entry_id": "690f639e-6bf3-39b1-bc16-a8d8edc45e1c",
                        "glosses": [
                            "flaches Blech, mit dem man Kehricht vom Boden aufnehmen, einsammeln kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bd5385-b477-48c2-8823-b06166bc56b0",
                                "sense_id": "8dc2a3ec-ca6b-38bf-9c50-9992b7566980",
                                "text": "„Ich kniete auf dem Boden mit der Müllschippe in der rechten und dem Handfeger in der linken Hand.“"
                            },
                            {
                                "example_id": "b63ed1d7-6824-4617-8510-4354d6fa68dc",
                                "sense_id": "8dc2a3ec-ca6b-38bf-9c50-9992b7566980",
                                "text": "„In der B - Straße konnte man beobachten das Mitarbeiter der beauftragten Reinigungsfirma das was diese so im Hausflur zusammengefegt und nun mit der Müllschippe aufgenommen hatten nicht etwa in einen Eimer sammeln , sondern frei von der Leber weg im Rasengrün vor unseren Häusern entsorgen , so als handelte es sich um eine Düngemaßnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
