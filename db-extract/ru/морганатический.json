                            }
                        ]
                    },
                    {
                        "translation_id": "d58e2796-5b49-46eb-ac1b-abe1d9623c12",
                        "source_entry_id": "277fc3df-c3ff-3a59-af7b-39a3250e3dc5",
                        "source_sense_id": "35bb26cf-e893-3a87-9ed0-1ab15657cd75",
                        "target_lang_word": "morganatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morganatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58baf0cd-c0c9-376d-adf2-8c5f71e5b2df",
                                        "entry_id": "958fa506-6425-3af9-9f17-cb3b17b1ecc5",
                                        "glosses": [
                                            "nicht standesgemäß"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b04a1e-11de-4f8a-a6b5-13a91ea6a15c",
                                                "sense_id": "58baf0cd-c0c9-376d-adf2-8c5f71e5b2df",
                                                "text": "Eine morganatische Ehe wird auch als Ehe zur linken Hand bezeichnet, da die Frau an der linken – statt wie sonst üblich – rechten Seite des Ehemannes gehen muss."
                                            },
                                            {
                                                "example_id": "faf1d640-d0ea-4500-a092-8eaa791570de",
                                                "sense_id": "58baf0cd-c0c9-376d-adf2-8c5f71e5b2df",
                                                "text": "Seine gelegentlichen kleinen Eskapaden mit den Damen vom Theater, mit einer ehemaligen Wäscherin, ja selbst seine beiden morganatischen Ehen mit der Hofdame Amalie Elisabeth von Voß (erhoben zur Gräfin Ingenheim) und der Gräfin Sophie Juliane Dönhoff können an der innigen Verbindung zwischen dem König und seiner Mätresse nichts ändern."
                                            },
                                            {
                                                "example_id": "46e3d1ee-6699-46bc-8a01-ca2a29c75be1",
                                                "sense_id": "58baf0cd-c0c9-376d-adf2-8c5f71e5b2df",
                                                "text": "„Um drei Uhr verließ ich die drei nach den zärtlichsten Umarmungen und fuhr die ganze Nacht hindurch; in Monte Cassino, das ich noch nie gesehen hatte, machte ich halt und traf dort zu meiner Freude den Prinzen Xaver von Sachsen, der den Namen Graf von der Lausitz führte, in Begleitung von Signora Spinucci aus Fermo, die der Prinz in morganatischer Ehe geheiratet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
