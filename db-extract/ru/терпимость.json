                    },
                    {
                        "translation_id": "de7d1052-d057-4edf-b0b7-493cb0ff0353",
                        "source_entry_id": "2521975e-b313-308a-8681-938f3d365d8f",
                        "target_lang_word": "Duldsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Duldsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e35c10ce-a974-3298-9ed8-ffc19a9e744e",
                                        "entry_id": "662a40af-307c-3ebe-8e3b-11b6a5b00ed1",
                                        "glosses": [
                                            "Eigenschaft/Einstellung einer Person, voller Geduld oder Toleranz anderen Menschen gegenüber zu sein"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893b70e9-cff5-4ada-8865-f750be9d522b",
                                                "sense_id": "e35c10ce-a974-3298-9ed8-ffc19a9e744e",
                                                "text": "„Michael sah sie fest an – nein, das war keine boshafte Anspielung auf seine Duldsamkeit.“"
                                            },
                                            {
                                                "example_id": "682261a8-1873-4cc6-9062-7024def09308",
                                                "sense_id": "e35c10ce-a974-3298-9ed8-ffc19a9e744e",
                                                "text": "„Tiefes Wort Jesu von der Entschiedenheit findet seine Ergänzung in dem Worte von der reeitherzigen Duldsamkeit.“"
                                            },
                                            {
                                                "example_id": "697147e6-d6be-44e2-b2b3-e35fde3c1c1f",
                                                "sense_id": "e35c10ce-a974-3298-9ed8-ffc19a9e744e",
                                                "text": "„Die Ausdauer hängt mit Geduld und Duldsamkeit zusammen, mit der Fähigkeit, Widriges länger ertragen zu können, ohne sich durch Flucht der Bedrängnis entziehen zu müssen.“"
                                            },
                                            {
                                                "example_id": "eb4d030f-8f04-45e4-8caa-63c9522479f4",
                                                "sense_id": "e35c10ce-a974-3298-9ed8-ffc19a9e744e",
                                                "text": "„Der Verfasser ermahnt in der Einleitung zur Duldsamkeit gegenüber wissenschaftlichen Ausichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b90787-eb8c-4239-8ad2-afdc329a4b81",
                        "source_entry_id": "2521975e-b313-308a-8681-938f3d365d8f",
                        "target_lang_word": "Toleranz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Toleranz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                        "entry_id": "81923a80-d6aa-3b6e-9d9f-aff81326f51e",
                                        "glosses": [
                                            "nur Singular gebräuchlich: Eigenschaft, etwas dulden, ertragen oder zulassen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c6546f-a35e-4f52-ba1c-1f5b320315e2",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "Die Toleranz gegenüber Andersgläubigen macht es Peter leicht, den Dialog der Religionen zu führen."
                                            },
                                            {
                                                "example_id": "1b75fdcc-940b-4f66-818f-13b0dc497949",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "Die Situation erfordert Respekt und Toleranz sowie eine gehörige Portion Fingerspitzengefühl."
                                            },
                                            {
                                                "example_id": "300fda7c-cf81-40e0-a26e-3474b1ae2ad5",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "„Die schmale Grenze kirchlicher Toleranz verlief irgendwo zwischen Wein und Schnaps, zwischen Russendisko und Gruftifestival.“"
                                            },
                                            {
                                                "example_id": "b05f5716-8634-4aad-adfe-c585df31e5c0",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "„Seit den Terroranschlägen in New York werden Freiheit und Toleranz wieder heftig diskutiert.“"
                                            },
                                            {
                                                "example_id": "2b3d2200-5866-445d-acf6-cfd4cc46c1e8",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "„Toleranz heißt, andere Ansichten gelten zu lassen, ohne die eigenen zu verraten.“"
                                            },
                                            {
                                                "example_id": "a527a27a-bbe1-4916-836d-38f80d895b2f",
                                                "sense_id": "6150e0fc-ad51-395a-8e41-f18446406de0",
                                                "text": "„Immerhin bin ich keine Abenteuerreisende oder Forscherin, sondern Restauratorin, und meine Toleranz gegenüber Aufregung und Überraschung ist auch nicht gerade die größte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce57b41c-a860-348d-a4f1-731180001476",
                                        "entry_id": "81923a80-d6aa-3b6e-9d9f-aff81326f51e",
                                        "glosses": [
                                            "zulässige Abweichung von einem vorgeschriebenen, verbindlichen Maß oder Wert"
