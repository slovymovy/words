                    },
                    {
                        "translation_id": "38454e6c-0a5b-42e3-9e2c-19987e776756",
                        "source_entry_id": "53925645-9cc8-3391-aaf1-b66b62d81978",
                        "source_sense_id": "49e66b08-b6e3-3222-af18-7e45471bb7dd",
                        "source_sense_description": "according to or using mathematics",
                        "target_lang_word": "wiskundig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiskundig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "26447eb2-14d6-3a50-b84a-353abf129d91",
                                        "entry_id": "9d6f627f-6843-3070-b1ea-104273c3717c",
                                        "glosses": [
                                            "op wiskunde betrekking hebbend of er gebruik van makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d6147b-9a30-47c3-9b59-0b8295a9947a",
                                                "sense_id": "26447eb2-14d6-3a50-b84a-353abf129d91",
                                                "text": "De fysische chemie tracht chemische verschijnselen met wiskundige modellen te verklaren."
                                            },
                                            {
                                                "example_id": "8fea3973-2365-4ee2-b846-cda6fbcb8487",
                                                "sense_id": "26447eb2-14d6-3a50-b84a-353abf129d91",
                                                "text": "De hele schouderpartij was een soort modernistische improvisatie, heel ver verwijderd van de wiskundige regelmaat van de lokale kunst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "081434f6-f34b-47f0-a642-7c4958a1b32a",
                        "source_entry_id": "53925645-9cc8-3391-aaf1-b66b62d81978",
                        "source_sense_id": "49e66b08-b6e3-3222-af18-7e45471bb7dd",
                        "source_sense_description": "according to or using mathematics",
                        "target_lang_word": "mathématiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mathématiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27410214-973a-30a9-9542-25a308ef4ade",
                                        "entry_id": "dadbc790-291f-3df7-82dd-c07b3817c3d1",
                                        "glosses": [
                                            "Selon les règles des mathématiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6769eace-684e-4bd9-9cd0-5b645f753afe",
                                                "sense_id": "27410214-973a-30a9-9542-25a308ef4ade",
                                                "text": "Je le trouverais encore assez bien partagé, quand il serait à M. Euler (pour parler mathématiquement) en même proportion que Descartes et Newton sont à Bayle."
                                            },
                                            {
                                                "example_id": "8e60d13c-49e0-487b-b7e4-27f0bc91bccd",
                                                "sense_id": "27410214-973a-30a9-9542-25a308ef4ade",
                                                "text": "Puis, chiffrant ce résultat et celui de l'observation de la veille, il détermina mathématiquement la longitude du lieu."
                                            },
                                            {
                                                "example_id": "264ea835-1d4f-4b7f-9337-ca3a8fd57248",
                                                "sense_id": "27410214-973a-30a9-9542-25a308ef4ade",
                                                "text": "Il est parti du principe qu’il était mathématiquement impossible pour Madoff d’offrir à ses investisseurs des rendements presque constants au fil des ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f077755-ec71-3835-a634-59ed2b334fdf",
                                        "entry_id": "dadbc790-291f-3df7-82dd-c07b3817c3d1",
                                        "glosses": [
                                            "Rigoureusement, exactement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10606b63-9013-4929-88f7-a1e85dab6457",
                                                "sense_id": "6f077755-ec71-3835-a634-59ed2b334fdf",
                                                "text": "Son fils [du chancelier] [était] aussi universellement abhorré qu’il était mathématiquement détestable."
                                            },
                                            {
                                                "example_id": "ac0184bf-188e-4948-9375-76c392b4c570",
                                                "sense_id": "6f077755-ec71-3835-a634-59ed2b334fdf",
                                                "text": "Le livre qui suit explique simplement, raisonnablement, mathématiquement, pour ainsi dire, les divers sentiments qui se succèdent les uns aux autres, et dont l'ensemble s'appelle la passion de l'amour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35604a32-5a93-45cf-a0c2-8abd1be0135f",
                        "source_entry_id": "53925645-9cc8-3391-aaf1-b66b62d81978",
