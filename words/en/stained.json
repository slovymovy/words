{
    "word_family": [
        "stain",
        "stainless",
        "stainer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4cb0ead3-f445-33da-b190-a0a19bb11dd7",
                    "sense_definition": "Having a dirty mark or discoloration on the surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discoloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpet was <w>stained</w> after the coffee spill.",
                            "target_lang_translations": {
                                "nl": "Het tapijt was <w>bevlekt</w> nadat de koffie was gemorst."
                            }
                        },
                        {
                            "text": "He tried to clean his <w>stained</w> shirt before the meeting.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn <w>bevlekte</w> overhemd schoon te maken voor de vergadering."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirty",
                        "soiled"
                    ],
                    "antonyms": [
                        "unstained"
                    ],
                    "common_phrases": [
                        "heavily stained",
                        "badly stained"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een vuile vlek of verkleuring op het oppervlak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevlekt",
                                "target_lang_sense_clarification": "met vlekken"
                            },
                            {
                                "target_lang_word": "besmeurd",
                                "target_lang_sense_clarification": "vuil gemaakt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45845946-9d1b-3b45-bc5a-03dfd641d9e4",
                    "sense_definition": "Colored or treated with a pigment or dye to change its appearance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discoloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used <w>stained</w> glass to create a beautiful window.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar gebruikte <w>gebrandschilderd</w> glas om een prachtig raam te maken."
                            }
                        },
                        {
                            "text": "The wooden table was <w>stained</w> a dark oak color.",
                            "target_lang_translations": {
                                "nl": "De houten tafel was donker eikenkleurig <w>gebeitst</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dyed",
                        "colored"
                    ],
                    "common_phrases": [
                        "stained glass",
                        "darkly stained"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekleurd of behandeld met een beits, verfstof of pigment om het uiterlijk te veranderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gebeitst",
                                "target_lang_sense_clarification": "behandeld met beits, bij hout"
                            },
                            {
                                "target_lang_word": "gekleurd",
                                "target_lang_sense_clarification": "van kleur voorzien, bijv. glas"
                            },
                            {
                                "target_lang_word": "in-lood",
                                "target_lang_sense_clarification": "zoals in 'glas in lood'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "209d2c16-84cc-3896-947b-b51e31251af9",
                    "sense_definition": "Simple past and past participle of <w>stain</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ink <w>stained</w> the paper permanently.",
                            "target_lang_translations": {
                                "nl": "De inkt <w>bevlekte</w> het papier permanent."
                            }
                        },
                        {
                            "text": "She has <w>stained</w> her hands while painting the fence.",
                            "target_lang_translations": {
                                "nl": "Ze heeft haar handen <w>vuilgemaakt</w> tijdens het schilderen van het hek."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb stain."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van stain (vlekken maken, beitsen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevlekte",
                                "target_lang_sense_clarification": "verleden tijd van bevlekken"
                            },
                            {
                                "target_lang_word": "bevlekt",
                                "target_lang_sense_clarification": "voltooid deelwoord van bevlekken"
                            },
                            {
                                "target_lang_word": "beitste",
                                "target_lang_sense_clarification": "verleden tijd van beitsen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}