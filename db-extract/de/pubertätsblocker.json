                "senses": [
                    {
                        "sense_id": "acb72957-702a-3bc5-94bd-2fe1366301ee",
                        "entry_id": "883f94ca-71ac-37fb-8f81-0bbe6c4bd40e",
                        "glosses": [
                            "Medikament, das die physiologisch angelegte Geschlechtsreifung (von Jugendlichen) stoppt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "80717d50-d9c3-4f7e-9421-c3e51718a7e0",
                                "sense_id": "acb72957-702a-3bc5-94bd-2fe1366301ee",
                                "text": "„Der Gesundheitsdienst in England hat die Verschreibung von Pubertätsblockern an Kinder gestoppt.“"
                            },
                            {
                                "example_id": "2bfd1d37-cfb0-4739-80a4-8508679596dd",
                                "sense_id": "acb72957-702a-3bc5-94bd-2fe1366301ee",
                                "text": "„Die Bundesregierung empfiehlt nicht die Einnahme von Pubertätsblockern.“"
                            },
                            {
                                "example_id": "8539e8b2-6d27-4be6-95f5-4be28c90f71e",
                                "sense_id": "acb72957-702a-3bc5-94bd-2fe1366301ee",
                                "text": "„Im Sommer gab der National Health Service (NHS) in England bekannt, dass Pubertätsblocker nur noch in Ausnahmefällen Minderjährigen verschrieben werden sollen, weil die Evidenz in puncto Sicherheit und klinische Wirksamkeit fehle.“"
                            },
                            {
                                "example_id": "99f8ee5f-63b1-4c42-930f-49e1ed9cec46",
                                "sense_id": "acb72957-702a-3bc5-94bd-2fe1366301ee",
                                "text": "„Anders ist es bei Patienten, deren Pubertät angehalten wurde. Die setzen in der Regel die Transition fort, zunächst durch Hormone und gegebenenfalls durch Operationen. Also sind Pubertätsblocker frühe Weichensteller. Man kann auch sagen, ein Homosexualitätsverhinderer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
