                "senses": [
                    {
                        "sense_id": "bbff10fb-7128-3450-9668-d9a52a3570eb",
                        "entry_id": "7b9eda07-ef75-39cf-b36b-99eecc5599f7",
                        "glosses": [
                            "Verdachtsstufe in Deutschland, bei der die Strafverfolgungsbehörden zur Aufnahme von Ermittlungen verpflichtet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a55e38-9627-4994-b3b4-5aa0a258b123",
                                "sense_id": "bbff10fb-7128-3450-9668-d9a52a3570eb",
                                "text": "„Die Generalstaatsanwaltschaft erklärt auf Nachfrage, für den Anfangsverdacht der kriminellen Vereinigung \"spielten konkrete Gewaltdelikte von Anhängern des Vereins Chemie Leipzig keine Rolle\".“"
                            },
                            {
                                "example_id": "9796ae84-9496-4df5-a8b7-a3a9011fe7ac",
                                "sense_id": "bbff10fb-7128-3450-9668-d9a52a3570eb",
                                "text": "„Bisher bestand gegen Ernst bei Abrechnungen von drei Reisen ein Anfangsverdacht auf Untreue und Betrug.“"
                            },
                            {
                                "example_id": "377e0e80-2037-4616-bf0e-a701272ef490",
                                "sense_id": "bbff10fb-7128-3450-9668-d9a52a3570eb",
                                "text": "„Kriminalpolizei und Staatsanwaltschaft sind im Rahmen ihrer Aufgaben verpflichtet, jeden ihnen zur Kenntnis gelangten Anfangsverdacht einer Straftat, die nicht bloß auf Verlangen einer hiezu berechtigten Person zu verfolgen ist, in einem Ermittlungsverfahren von Amts wegen aufzuklären.“"
                            },
                            {
                                "example_id": "12862640-ddff-46e0-a5e8-d9da6814fe7f",
                                "sense_id": "bbff10fb-7128-3450-9668-d9a52a3570eb",
                                "text": "„Unterschieden wird im Gesetz zwischen Anfangsverdacht, hinreichendem und dringendem Tatverdacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
