                    {
                        "translation_id": "3ee81016-e0a2-445d-b664-f319b3738455",
                        "source_entry_id": "c9f38e9f-f711-38ca-b6d2-2399dfa15fb3",
                        "source_sense_id": "0427a3d5-267b-3b38-94c0-2dc00335a284",
                        "target_lang_word": "Blutspender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutspender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "835742fe-d7f7-302e-ab6d-c2b104bffbcf",
                                        "entry_id": "a6e37bc1-29eb-3db7-80c0-eb6fa6886537",
                                        "glosses": [
                                            "Person, die eine bestimmte Blutmenge aus dem eigenen Körper zur weiteren Verwendung entnehmen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b46f42-b2e2-4f9f-93df-171a63380874",
                                                "sense_id": "835742fe-d7f7-302e-ab6d-c2b104bffbcf",
                                                "text": "Der Blutspender kann notfalls mit Eigenblut behandelt werden."
                                            },
                                            {
                                                "example_id": "b6c53eb9-aaf5-421b-b755-97df4300fb8a",
                                                "sense_id": "835742fe-d7f7-302e-ab6d-c2b104bffbcf",
                                                "text": "Blutspender helfen Leben zu retten."
                                            },
                                            {
                                                "example_id": "036d1886-a4fe-47d9-b33b-bfe2a984d44b",
                                                "sense_id": "835742fe-d7f7-302e-ab6d-c2b104bffbcf",
                                                "text": "„Jeder potenzielle Blutspender sollte über Möglichkeiten von anonymen HIV-Tests aufgeklärt werden und Informationen über regionale Test- und Beratungseinrichtungen erhalten.“"
                                            },
                                            {
                                                "example_id": "7047bc07-fb35-4ac6-bf0c-b56ff2251bbe",
                                                "sense_id": "835742fe-d7f7-302e-ab6d-c2b104bffbcf",
                                                "text": "„Die Identifikation mit den Kranken motiviert die Mehrzahl der jährlich etwa zwei Millionen Blutspender in Deutschland, sich den Lebenssaft ohne unmittelbaren Nutzen für sich selbst abzapfen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
