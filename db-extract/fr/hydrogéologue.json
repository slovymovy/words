                "senses": [
                    {
                        "sense_id": "5792ab3c-cb95-3ff3-8a4f-11a3a41e3bf2",
                        "entry_id": "752976d4-ef86-3509-9e00-07c93f7ff42d",
                        "glosses": [
                            "Spécialiste en hydrogéologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def4a77e-bd1c-4753-90fd-6d776a64708c",
                                "sense_id": "5792ab3c-cb95-3ff3-8a4f-11a3a41e3bf2",
                                "text": "À leur initiative, un comité de pilotage est créé, regroupant le Siaep et la DDASS, l’Agence de l’eau, le conseil général, la chambre d’agriculture et un hydrogéologue agréé."
                            },
                            {
                                "example_id": "b4998347-4477-437e-8bbc-f0601fb392fa",
                                "sense_id": "5792ab3c-cb95-3ff3-8a4f-11a3a41e3bf2",
                                "text": "On devait réfléchi à tous les impacts des lotissements, notamment sur la circulation de l’eau. On s’est adapté et on a recruté des urbanistes et des hydrogéologues."
                            }
                        ]
                    }
