                        "examples": [
                            {
                                "example_id": "8200fb71-6db1-483a-abc7-d1ab6238bb1d",
                                "sense_id": "f631069b-fb82-3324-8a94-ae628ce44567",
                                "text": "„Die schwebenden Lichtpünktchen vor seinen an die Finsternis gewöhnten Augen schienen sich auf seltsame Weise symmetrisch zu bewegen und entsprechende Muster zu bilden.“"
                            },
                            {
                                "example_id": "97438eb7-556c-4071-a987-c63adc786ac1",
                                "sense_id": "f631069b-fb82-3324-8a94-ae628ce44567",
                                "text": "„Die Lampe zwischen den Felsen am Hang des Hügels war kaum mehr als ein Lichtpünktchen, und nach einer Weile gingen sie zurück.“"
                            }
