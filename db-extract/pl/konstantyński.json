                        "entry_id": "1e23f7b6-d0bd-3b8b-adac-757a05080dc4",
                        "glosses": [
                            "związany z osobą o imieniu Konstantyn, w szczególności władcą, np. Konstantynem I Wielkim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b1fb9b-0d87-4292-a3db-ae5dd3e520de",
                                "sense_id": "1b4841f7-2955-33ff-8238-cff4de7bb78d",
                                "text": "Model takiego układu nazywany jest niekiedy katolicyzmem konstantyńskim, od imienia rzymskiego cesarza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f80e8d11-09c8-3e89-867a-43ac75e85db1",
                        "entry_id": "1e23f7b6-d0bd-3b8b-adac-757a05080dc4",
                        "glosses": [
                            "związany z Konstantyną, dotyczący Konstantyny (miasta w Algierii)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253942bf-dda0-4970-9c94-16725209d5be",
                                "sense_id": "f80e8d11-09c8-3e89-867a-43ac75e85db1",
                                "text": "W czasach kolonialnych językami berberskimi mówiło 27 proc. ludności w departamencie konstantyńskim, 34 w algierskim i tylko 1 proc. w departamencie orańskim"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
