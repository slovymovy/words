                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdb0ddf1-f7e4-42da-94de-b0259a325c19",
                        "source_entry_id": "1137b3c7-e059-3271-8d07-94ce15887987",
                        "source_sense_id": "dd2e9b93-2d91-3e9c-a6d1-2e216229d49c",
                        "source_sense_description": "Bedachtsein auf den eigenen Vorteil",
                        "target_lang_word": "self interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d0f0808-19ba-47ed-b489-055d2a3164c9",
                        "source_entry_id": "1137b3c7-e059-3271-8d07-94ce15887987",
                        "source_sense_id": "dd2e9b93-2d91-3e9c-a6d1-2e216229d49c",
                        "source_sense_description": "Bedachtsein auf den eigenen Vorteil",
                        "target_lang_word": "self-interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                        "entry_id": "0754b173-1534-391a-8780-0c907494bd4f",
                                        "glosses": [
                                            "One's personal interest or advantage, especially when pursued without regard for others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a05622b-d627-4d8c-b5f1-56f31463789f",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "I cannot abandon my husband for the sake of self-interest and personal gain."
                                            },
                                            {
                                                "example_id": "9b15dd4a-9c94-4b86-bd6a-88774804d32d",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "And so he reasoned until the first generous impulse to proclaim the truth and relinquish his titles and his estates to their rightful owner was forgotten beneath the mass of sophistries which self-interest had advanced."
                                            },
                                            {
                                                "example_id": "4f1b27c1-b536-4a0b-baa9-fb4fdcd90214",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Corruption becomes fatal when those in power are no longer able to distinguish the difference between self-interest and the national interest."
                                            },
                                            {
                                                "example_id": "2a50f168-1741-4273-b227-5cff7ea39279",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Government standards of decency and honesty were quite low, and decision-makers were tainted with self-interest and corruption at the very highest level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcb2a2ed-7cb8-4882-8c50-6fbd89b49af2",
                        "source_entry_id": "1137b3c7-e059-3271-8d07-94ce15887987",
                        "source_sense_id": "dd2e9b93-2d91-3e9c-a6d1-2e216229d49c",
                        "source_sense_description": "Bedachtsein auf den eigenen Vorteil",
                        "target_lang_word": "intérêt personnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6986783c-003f-4fc8-8310-81fd672266f5",
                        "source_entry_id": "1137b3c7-e059-3271-8d07-94ce15887987",
                        "source_sense_id": "dd2e9b93-2d91-3e9c-a6d1-2e216229d49c",
                        "source_sense_description": "Bedachtsein auf den eigenen Vorteil",
                        "target_lang_word": "égoïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égoïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                        "entry_id": "2c0b940b-13cf-35a2-bf6f-33c0158ea03c",
                                        "glosses": [
                                            "Tendance a décider et agir en privilégiant son intérêt propre aux dépens de celui du reste du monde en général, ou d'autrui en particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65692614-4d8a-4f6c-9c6e-cbd45ff275aa",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "L’histoire retiendra le préjudice causé […] Elle jugera sévèrement l’égoïsme borné dont firent preuve en la circonstance les classes possédantes ou du moins ceux qui les représentaient."
                                            },
                                            {
                                                "example_id": "67d33b66-78bb-4675-b311-6fca0b98f552",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "C’était enfin une de ces âpres soirées qui arrachent à notre égoïsme une plainte stérile en faveur du pauvre ou du voyageur, et nous rendent le coin du feu si voluptueux."
                                            },
                                            {
                                                "example_id": "32ca0549-e7a5-4707-acd7-452ef4c4a93a",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "Cet enfant unique est d’ailleurs élevé très mal : un enfant gâté, dorloté, pourri d’égoïsme."
                                            },
                                            {
                                                "example_id": "4196ee0d-2186-4c8d-b125-bbb6063fda1a",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "Elle avait déjà entendu parler de l’égoïsme sensuel des hommes, toujours à l’affût d’une aventure."
                                            },
                                            {
                                                "example_id": "508926b4-8026-4d47-8daf-0b808428e3a5",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "La psychorigidité forme un couple bien assorti avec l’égocentrisme qui peut se définir comme un rapport privilégié, voire univoque à soi, à ses préoccupations, différent de ce que l'on entend communément par égoïsme."
                                            },
                                            {
                                                "example_id": "94189158-16b6-404f-b0a1-50e131e70a02",
                                                "sense_id": "00634848-87fd-3468-9e47-961c05dbd3eb",
                                                "text": "Il ne faut pas confondre « amour de soi » ou, pour être plus précis, « vouloir son propre bien » et égoïsme. Comme l'explique le philosophe Ronald Milo, l'amour de soi conduit à souhaiter son propre bien, tandis que l'amour égoïste conduit à ne souhaiter que celui-ci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
