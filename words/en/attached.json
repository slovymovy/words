{
    "word_family": [
        "attach",
        "attachment",
        "detach",
        "detachable",
        "reattach",
        "unattached"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97906748-f0d9-33e2-bcee-ff5b2d385ee8",
                    "sense_definition": "Connected or joined to something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house comes with a large <w>attached</w> garage.",
                            "target_lang_translations": {
                                "ru": "В доме есть большой <w>пристроенный</w> гараж.",
                                "zh": "这栋房子带有一个大型<w>附建</w>车库。"
                            }
                        },
                        {
                            "text": "Make sure the label is securely <w>attached</w> to the package.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что этикетка надежно <w>прикреплена</w> к посылке.",
                                "zh": "确保标签已牢固地<w>贴</w>在包裹上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "connected",
                        "joined",
                        "fastened",
                        "fixed"
                    ],
                    "antonyms": [
                        "detached",
                        "separate"
                    ],
                    "common_phrases": [
                        "attached garage",
                        "attached to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединённый или скреплённый с чем-либо.",
                        "zh": "连接或固定在某物上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикреплённый",
                                "target_lang_sense_clarification": "физически зафиксированный"
                            },
                            {
                                "target_lang_word": "присоединённый",
                                "target_lang_sense_clarification": "соединённый с чем-то"
                            },
                            {
                                "target_lang_word": "пристроенный",
                                "target_lang_sense_clarification": "о зданиях или сооружениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附着的",
                                "target_lang_sense_clarification": "物理上连接在一起的"
                            },
                            {
                                "target_lang_word": "连接的",
                                "target_lang_sense_clarification": "与某物相连的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35cb9fc3-00cd-397c-8e90-ee1743602dce",
                    "sense_definition": "Included as a file sent with an email or electronic message.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please fill out the <w>attached</w> form and return it to us.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, заполните <w>вложенную</w> форму и верните её нам.",
                                "zh": "请填写<w>附带</w>的表格并寄回给我们。"
                            }
                        },
                        {
                            "text": "I have sent the photos you requested in the <w>attached</w> folder.",
                            "target_lang_translations": {
                                "ru": "Я отправил запрошенные вами фотографии во <w>вложенной</w> папке.",
                                "zh": "我已经把您要求的照片放在<w>附件</w>文件夹里发给您了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosed",
                        "included"
                    ],
                    "common_phrases": [
                        "see attached",
                        "attached file",
                        "attached document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включённый в виде файла, отправленного с электронным письмом.",
                        "zh": "作为文件随电子邮件或电子信息发送。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложенный",
                                "target_lang_sense_clarification": "о файлах в письме"
                            },
                            {
                                "target_lang_word": "прикреплённый",
                                "target_lang_sense_clarification": "добавленный к сообщению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附件",
                                "target_lang_sense_clarification": "随信发送的文件"
                            },
                            {
                                "target_lang_word": "附带的",
                                "target_lang_sense_clarification": "随信息一同发送的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6896313-23f9-3af3-adf3-b028fdd5bf89",
                    "sense_definition": "Feeling a strong emotional connection or liking for someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_bond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child became very <w>attached</w> to her new puppy.",
                            "target_lang_translations": {
                                "ru": "Ребёнок очень <w>привязался</w> к своему новому щенку.",
                                "zh": "那个孩子非常<w>依恋</w>她的小狗。"
                            }
                        },
                        {
                            "text": "He is deeply <w>attached</w> to the house where he grew up.",
                            "target_lang_translations": {
                                "ru": "Он глубоко <w>привязан</w> к дому, где вырос.",
                                "zh": "他对他长大的那栋房子有着深厚的<w>感情</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fond",
                        "devoted",
                        "connected",
                        "close"
                    ],
                    "antonyms": [
                        "indifferent",
                        "unattached"
                    ],
                    "common_phrases": [
                        "attached to",
                        "deeply attached",
                        "emotionally attached"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сильную эмоциональную связь или симпатию к кому-либо или чему-либо.",
                        "zh": "对某人或某物有强烈的感情联系或喜爱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привязанный",
                                "target_lang_sense_clarification": "эмоционально"
                            },
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "верный, любящий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "依恋",
                                "target_lang_sense_clarification": "情感上的深厚联系"
                            },
                            {
                                "target_lang_word": "钟情的",
                                "target_lang_sense_clarification": "对某事物有深厚感情的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9b9a82-3c1e-3215-b25b-30751ff920f8",
                    "sense_definition": "In a committed romantic relationship and not single.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>attached</w>, so she will not be at the singles event.",
                            "target_lang_translations": {
                                "ru": "Она сейчас <w>несвободна</w>, поэтому не пойдет на вечеринку знакомств.",
                                "zh": "她目前已经<w>有对象</w>了，所以不会参加单身派对。"
                            }
                        },
                        {
                            "text": "He is happily <w>attached</w> and plans to get married next year.",
                            "target_lang_translations": {
                                "ru": "Он счастлив в <w>отношениях</w> и планирует жениться в следующем году.",
                                "zh": "他目前感情生活很幸福，并计划明年结婚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taken",
                        "spoken for"
                    ],
                    "antonyms": [
                        "single",
                        "unattached"
                    ],
                    "common_phrases": [
                        "happily attached",
                        "romantically attached"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий в романтических отношениях, не одинокий.",
                        "zh": "处于恋爱关系中，非单身。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несвободный",
                                "target_lang_sense_clarification": "состоящий в отношениях"
                            },
                            {
                                "target_lang_word": "занятый",
                                "target_lang_sense_clarification": "разговорное, о статусе отношений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有对象的",
                                "target_lang_sense_clarification": "处于恋爱关系中"
                            },
                            {
                                "target_lang_word": "名花有主",
                                "target_lang_sense_clarification": "形容已有伴侣（常用语）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c08f511-7826-3fbf-ab79-4152f90ed953",
                    "sense_definition": "Sharing one or more walls with another building.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Living in an <w>attached</w> house can sometimes mean hearing your neighbors.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>смежном</w> доме иногда означает, что вы слышите соседей.",
                                "zh": "住在<w>联排</w>住宅里有时意味着能听到邻居的声音。"
                            }
                        },
                        {
                            "text": "The complex consists of several <w>attached</w> dwellings surrounding a courtyard.",
                            "target_lang_translations": {
                                "ru": "Комплекс состоит из нескольких <w>сблокированных</w> домов, окружающих внутренний двор.",
                                "zh": "这个建筑群由几栋环绕庭院的<w>相连</w>住宅组成。"
                            }
                        }
                    ],
                    "antonyms": [
                        "freestanding",
                        "detached"
                    ],
                    "common_phrases": [
                        "attached house",
                        "attached dwelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий общие стены с другим зданием.",
                        "zh": "与另一建筑物共用一面或多面墙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смежный",
                                "target_lang_sense_clarification": "имеющий общую границу"
                            },
                            {
                                "target_lang_word": "сблокированный",
                                "target_lang_sense_clarification": "архитектурный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联排的",
                                "target_lang_sense_clarification": "建筑结构上相连的"
                            },
                            {
                                "target_lang_word": "相连的",
                                "target_lang_sense_clarification": "建筑间有共用墙体的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0119d666-3bd4-3a8a-86ec-cd801592fe0d",
                    "sense_definition": "Broadly joined to a stem or stalk, specifically regarding fungi or plants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gills of this mushroom are <w>attached</w> to the stem rather than running down it.",
                            "target_lang_translations": {
                                "ru": "Пластинки этого гриба <w>приросли</w> к ножке, а не спускаются по ней.",
                                "zh": "这种蘑菇的菌褶是<w>连生</w>在菌柄上的，而不是向下延伸的。"
                            }
                        },
                        {
                            "text": "Identify the species by checking if the cap is <w>attached</w> or free.",
                            "target_lang_translations": {
                                "ru": "Определите вид, проверив, <w>приросла</w> ли шляпка или она свободна.",
                                "zh": "通过检查菌盖是<w>附着</w>还是分离的来识别物种。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко приросший к стеблю или ножке (о грибах или растениях).",
                        "zh": "指真菌或植物的部位与茎或柄相连。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приросший",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附生的",
                                "target_lang_sense_clarification": "生物学上连接的"
                            },
                            {
                                "target_lang_word": "连生的",
                                "target_lang_sense_clarification": "植物学中指器官相连"
                            }
                        ]
                    }
                }
            ]
        },
        {
