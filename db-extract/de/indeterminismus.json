                        ]
                    },
                    {
                        "translation_id": "405f499b-eb01-4a33-982b-9615c598230e",
                        "source_entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                        "source_sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                        "target_lang_word": "indeterminism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indeterminism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c302865-4155-3f0b-b790-852ad4a0fb21",
                                        "entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                                        "glosses": [
                                            "The doctrine that all human actions are not so much determined by the preceding events, conditions, causes or karma as by deliberate choice or free will."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12705e1b-b665-395a-82c9-c773a91c8380",
                                        "entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                                        "glosses": [
                                            "A case in which the uncertainty principle applies; a case in which certain pairs of physical properties such as the position and momentum of a particle cannot be known simultaneously."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4459cee-9da6-4e3c-a506-1d34f1da225a",
                                                "sense_id": "12705e1b-b665-395a-82c9-c773a91c8380",
                                                "text": "The classic examples in physics involve relativity theory and quantum theory and the recognition of the indeterminisms underlying those required the genius of Einstein and of Heisenberg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e285e6e4-1424-3f49-976c-719aa356401b",
                                        "entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                                        "glosses": [
                                            "Any situation in which the outcome cannot be completely predicted in advance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b88ef2c-bafe-4f30-b8f3-e7e1a0413436",
                                                "sense_id": "e285e6e4-1424-3f49-976c-719aa356401b",
                                                "text": "There is a whole gradation of more or less rigid determinisms and more or less free indeterminisms, as they have been given in various theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37022ac-768b-352b-b64c-dfbf9120a309",
                                        "entry_id": "7bab935b-8703-327c-9e8f-818bd6c0d468",
                                        "glosses": [
                                            "A situation in which there are multiple valid options for next step in a process."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89e3e0cf-3d91-4e8e-ace3-89bd4a3fe658",
                                                "sense_id": "b37022ac-768b-352b-b64c-dfbf9120a309",
                                                "text": "In detail, an inference strategy has to deal with the following three kinds of indeterminisms: 1. the selection of the initial path, 2. the selection of the next branch B to be expanded, 3. the selection of the next linking step to be performed on B."
                                            },
                                            {
                                                "example_id": "7608197e-8a06-4893-b0d4-7a3c5c541fcc",
                                                "sense_id": "b37022ac-768b-352b-b64c-dfbf9120a309",
                                                "text": "These indeterminisms confuse a regular bus arbiter in deciding whether a transaction should be aborted or resumed."
                                            },
                                            {
                                                "example_id": "1a574c78-915e-4669-9d12-c866e018fccb",
                                                "sense_id": "b37022ac-768b-352b-b64c-dfbf9120a309",
                                                "text": "This parallelism brings in conflicts and directional indeterminisms which cannot be solved by the CU."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a7a0952-a639-4476-90f2-252b6a68c60c",
                        "source_entry_id": "a74a0558-d7a7-3df5-93e3-698f63db00bd",
                        "source_sense_id": "525d2ada-13e7-38f1-93e4-a04fdce0d413",
                        "target_lang_word": "indéterminisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéterminisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1796086c-02cb-3f02-be08-3b137019baf3",
                                        "entry_id": "decc52de-a73d-3336-890f-68b6e0d5ab92",
                                        "glosses": [
                                            "Système opposé au déterminisme, c’est-à-dire système qui admet la liberté de la volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98e6019-eea0-46f4-afc2-165520ee1777",
                                                "sense_id": "1796086c-02cb-3f02-be08-3b137019baf3",
                                                "text": "Le libertarisme : nous avons un libre arbitre véritable, et c’est pourquoi le déterminisme doit être faux ; seul l’indéterminisme est vrai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
