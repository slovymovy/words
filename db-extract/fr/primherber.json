                "senses": [
                    {
                        "sense_id": "d4f2c82c-0326-350a-9587-db7c339d4bfc",
                        "entry_id": "9abf23de-5d48-354c-a4d6-a47022d86b59",
                        "glosses": [
                            "Utiliser en tant que pâturage avant la saison normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd0f396-5f98-4936-b7a4-6af7cc9ea91d",
                                "sense_id": "d4f2c82c-0326-350a-9587-db7c339d4bfc",
                                "text": "On aura ainsi des prés hâtifs, très recherchés dans quelques fermes, parce qu'on peut, en cas de besoin, les primherber, c'est-à-dire les faire pâturer prématurément alors que les réserves en grenier sont épuisées, et en attendant que les animaux puissent être envoyés dans les herbages."
                            },
                            {
                                "example_id": "ba6e53d4-3056-467e-b4e7-46e02b36875e",
                                "sense_id": "d4f2c82c-0326-350a-9587-db7c339d4bfc",
                                "text": "On fait aussi primer ou primherber une prairie lorsque l'exploitation manque de fourrage vert, et que l'on spécule sur le lait ou les produits, et quand on vent éviter la verse de l'herbe et la pourriture de sa base."
                            }
                        ]
                    }
                ],
