                "senses": [
                    {
                        "sense_id": "f2b33700-e966-3f96-a564-0a410c099e51",
                        "entry_id": "16fcc149-00ec-3886-a7b8-83eeba020a10",
                        "glosses": [
                            "gemeinschaftliches, vor allem auch intimes Zusammenleben als Ehepaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142c513c-57b9-42fd-a4a8-c4eef1239e01",
                                "sense_id": "f2b33700-e966-3f96-a564-0a410c099e51",
                                "text": "„Aber ihr Eheleben verändert sich, es wird eine Art vorgetäuschter Kameradschaftsehe, die eine große Leere umschließt.“"
                            },
                            {
                                "example_id": "9621997d-4ea3-4738-b040-0f8b07126fa6",
                                "sense_id": "f2b33700-e966-3f96-a564-0a410c099e51",
                                "text": "„Lucie und Hermann nahmen, obgleich geschieden, ihr normales Eheleben wieder auf.“"
                            },
                            {
                                "example_id": "ed9d1488-2e89-4f7c-a146-8f4279291af0",
                                "sense_id": "f2b33700-e966-3f96-a564-0a410c099e51",
                                "text": "„An einer Erzählung über das Eheleben, die Perez in zwei Varianten schreibt, schauen wir uns jetzt an, wie sein Witz sich entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
