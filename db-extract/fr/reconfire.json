                "senses": [
                    {
                        "sense_id": "06a021ec-2024-3f3b-a5d3-03394da3d8f1",
                        "entry_id": "f79ff93a-556f-3f90-9045-4ecf17f2ab36",
                        "glosses": [
                            "Confire à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50bad547-c3b0-4129-879f-98bfc137a6f5",
                                "sense_id": "06a021ec-2024-3f3b-a5d3-03394da3d8f1",
                                "text": "On la fait macérer dans l'eau, puis bouillir légérement, ensuite on la coupe en travers par grosses rouelles qu'on confit au vinaigre, que l'on fait sécher au soleil, et que l'onreconfit une seconde fois dans du vinaigre salé pour mêler dans l'atsjar, qui est une espèce d'assaisonnement de salades aussi délicat que celui qu'on apporte de Siam ;"
                            },
                            {
                                "example_id": "9fb91e25-409f-4879-9eaf-ea50cfee7fcb",
                                "sense_id": "06a021ec-2024-3f3b-a5d3-03394da3d8f1",
                                "text": "J'ai fini par le reconfire dans des vins et spiritueux."
                            }
                        ]
                    }
