                        "карие глаза",
                        "открыть глаза",
                        "закрыть глаза"
                    ],
                    "target_lang_definitions": {
                        "en": "Paired organ of vision located on the human face or on the front of an animal's head",
                        "zh": "位于人脸或动物头部前方的成对视觉器官"
