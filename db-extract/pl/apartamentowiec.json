                "senses": [
                    {
                        "sense_id": "290518fc-be6a-35de-b4c8-4c416e93bfbc",
                        "entry_id": "9ab8d120-2d44-3464-a43a-fbd9e5c90746",
                        "glosses": [
                            "nowoczesny budynek z drogimi ekskluzywnymi mieszkaniami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d7b8ac0-ebcc-4965-97a1-276f0370840f",
                                "sense_id": "290518fc-be6a-35de-b4c8-4c416e93bfbc",
                                "text": "Obok lasu postawili trzy nieduże apartamentowce."
                            },
                            {
                                "example_id": "627c1b1b-4cc7-4909-b866-7342fa6b6cad",
                                "sense_id": "290518fc-be6a-35de-b4c8-4c416e93bfbc",
                                "text": "W owym czasie w całym Manhattanie wznosiły się już pięcio- i sześciopiętrowe eleganckie apartamentowce – nazywane czasem „mieszkaniami w stylu francuskim”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "074a75fc-e11c-4708-90d3-5f9d15ee35ec",
                        "source_entry_id": "9ab8d120-2d44-3464-a43a-fbd9e5c90746",
                        "source_sense_id": "290518fc-be6a-35de-b4c8-4c416e93bfbc",
                        "target_lang_word": "edificio residencial",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "20e1389e-0201-4d52-be12-2d0703774085",
                        "source_entry_id": "9ab8d120-2d44-3464-a43a-fbd9e5c90746",
                        "source_sense_id": "290518fc-be6a-35de-b4c8-4c416e93bfbc",
                        "target_lang_word": "Apartmenthaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apartmenthaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c25a524c-6ea5-3d6c-af55-0cf257af717c",
                                        "entry_id": "35f21233-2bf0-39a5-8f7f-af21bc7b85c0",
                                        "glosses": [
                                            "Haus, in dem sich vorwiegend Apartments befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f7d8ff-b7a7-496f-a6d6-3c0419e4ca71",
                                                "sense_id": "c25a524c-6ea5-3d6c-af55-0cf257af717c",
                                                "text": "„Ich glaube, meinen letzten Selbstmordversuch habe ich 1954 unternommen. Ich wohnte damals in einem Apartmenthaus an der North Mariposa Avenue.“"
                                            },
                                            {
                                                "example_id": "1cb35116-021a-49e7-a819-2463ee26e2c8",
                                                "sense_id": "c25a524c-6ea5-3d6c-af55-0cf257af717c",
                                                "text": "„Neben kleinen Einzelunternehmern wie etwa Bixin Liu, einem in Tirol aufgewachsenen und perfekt Deutsch und Englisch sprechenden Chinesen, der nahe beim Wiener Augarten ein kleines Apartmenthaus betreibt, sind hier vor allem größere Unternehmen aktiv.“"
                                            },
                                            {
                                                "example_id": "2213ee06-76c6-4e04-ab65-b85fd7836a10",
                                                "sense_id": "c25a524c-6ea5-3d6c-af55-0cf257af717c",
                                                "text": "„Fuchsbau nennen die Münchner das pyramidenförmige Apartmenthaus neben der Erlöserkirche.“"
                                            },
                                            {
                                                "example_id": "11a237be-8283-4e15-b9e6-1facc7aa85ef",
                                                "sense_id": "c25a524c-6ea5-3d6c-af55-0cf257af717c",
                                                "text": "„Ich wohne in einem dieser anonymen Apartmenthäuser in Daimler-City.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
