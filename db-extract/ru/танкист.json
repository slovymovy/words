                        ]
                    },
                    {
                        "translation_id": "5584e35c-aee3-41a1-a4f3-785190c82937",
                        "source_entry_id": "4e1bab29-7ae8-3928-a50f-df34b7e82961",
                        "target_lang_word": "tanker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tanker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb708b66-c821-3e5f-9a7e-66dd08dcdcd5",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "A tankship, a vessel used to transport large quantities of fluid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d5877b-99a1-4e51-b3a3-98ed0965a1aa",
                                                "sense_id": "cb708b66-c821-3e5f-9a7e-66dd08dcdcd5",
                                                "text": "The channel at Chan-chiang is being dredged to a depth of 50 feet enabling tankers of 70,000 tons to call."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e15f5aee-05b4-328b-a209-65d9a72f0792",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "A motor truck with a tank to hold bulk liquid (with or without internal baffles)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21d134f9-db15-3b0c-a9fa-b35b15571aed",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "A fuel tanker, petrol tanker, road tanker."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0966e3af-44e9-4538-a7cb-ce49fcca1206",
                                                "sense_id": "21d134f9-db15-3b0c-a9fa-b35b15571aed",
                                                "text": "Nor is the government facing a strike by tanker drivers, as was the case in early 1979 during the winter of discontent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f64af205-81ac-33b1-9b25-10f9d25a239f",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "An aircraft carrying a large supply of jet fuel or avgas for aerial refueling of other aircraft, plus equipment allowing the in-air transfer of fuel."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcdebc8-6140-4e53-8f6f-731072ed02b7",
                                                "sense_id": "f64af205-81ac-33b1-9b25-10f9d25a239f",
                                                "text": "Without the KC-46 tankers orbiting in friendly airspace, our fighters would've run out of fuel long before reaching the combat zone."
                                            },
                                            {
                                                "example_id": "6e9254ae-8622-4fe6-882f-eeb9e4d9b7fb",
                                                "sense_id": "f64af205-81ac-33b1-9b25-10f9d25a239f",
                                                "text": "On Friday night, eight US Air Force KC-135 Stratotankers took off from Altus, Oklahoma, according to data from FlightRadar24. Over Kansas the tankers refueled two groups of planes, identified on air traffic control audio by their callsigns MYTEE11 FLT and MYTEE21 FLT. The callsign MYTEE has previously been associated with special activity flights by B-2 bombers, and multiple flight trackers on social media said the planes being refueled were B-2 bombers out of Whiteman Air Force Base in Missouri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68dfb94e-2220-32d8-ae24-4496cb6b7049",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "An aircraft built or modified to carry water and/or fire retardant for dropping on wildfires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5693b8e-9fcd-427f-b5dd-46fac71e25d8",
                                                "sense_id": "68dfb94e-2220-32d8-ae24-4496cb6b7049",
                                                "text": "While our ground teams cut firebreaks in the brush, the tankers kept the fire in the mountains at bay with frequent drops of water and retardant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df513d1e-2b35-3670-9a02-f0757e0f0fb3",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "A tank car."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8c37cef-c35c-3fc7-8df8-3cd86229a4fc",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "Member of a tank crew, or of an armoured unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89de2e83-1d57-449d-abb0-08a47f77adde",
                                                "sense_id": "f8c37cef-c35c-3fc7-8df8-3cd86229a4fc",
                                                "text": "On February 19, 1943, American tankers felt the full wrath of the German Army in North Africa when its tank-led spearhead punched a 2-mile-wide hole through American lines at Faid Pass in Tunisia, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404cdfa0-be07-3739-b460-53f6b7ce8900",
                                        "entry_id": "1ec9214c-4c48-3330-9a93-bde94959ea79",
                                        "glosses": [
                                            "A longboard."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1962ad3-f40a-47e7-b1f5-61ce7729c17a",
                                                "sense_id": "404cdfa0-be07-3739-b460-53f6b7ce8900",
                                                "text": "I swung the tanker around just in time to take off with the lip."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tanker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8733f8-8385-320d-95aa-9dd834b6bfde",
                                        "entry_id": "10b70aab-8318-34f4-81c6-a92a163e0930",
                                        "glosses": [
                                            "To transport (oil, etc.) in a tanker."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c3173e3-1757-3c90-8db3-e1044d5112d4",
                                        "entry_id": "10b70aab-8318-34f4-81c6-a92a163e0930",
                                        "glosses": [
