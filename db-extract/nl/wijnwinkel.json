                "senses": [
                    {
                        "sense_id": "984fd713-54ad-3af7-9ad7-c3e622f4ddf8",
                        "entry_id": "9d1828d3-aa45-39df-b781-d3ff71eaab3d",
                        "glosses": [
                            "winkel waar men wijn en andere alcoholische dranken verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "273b3ca9-6921-497b-be52-a60d7ec6b2aa",
                                "sense_id": "984fd713-54ad-3af7-9ad7-c3e622f4ddf8",
                                "text": "In Berlijn zou hij een ex-manager zijn, op zoek naar zichzelf, en net een wijnwinkel hebben gekocht."
                            },
                            {
                                "example_id": "236b5fef-c488-4d47-b137-e70ba3a307ad",
                                "sense_id": "984fd713-54ad-3af7-9ad7-c3e622f4ddf8",
                                "text": "De aanval op oud-spion Skripal heeft de Russische oppositie in Londen flink opgeschrikt. Zo ook Yevgeni Chichvarkin, ooit schatrijk geworden in de mobiele telefonie in Rusland en tegenwoordig eigenaar van een exclusieve wijnwinkel."
                            },
                            {
                                "example_id": "a625e496-415a-4e0f-93ba-4cd94a984bd3",
                                "sense_id": "984fd713-54ad-3af7-9ad7-c3e622f4ddf8",
                                "text": "Van Harten geeft niet alleen cursussen en proeverijen, maar werkt ook bij een wijnwinkel. \"Ja, het cliché is wel waar: maak van je hobby je werk en geen enkele dag zal meer als een werkdag voelen. Nou, bijna geen enkele dag dan. Iedere baan heeft wel iets wat energie geeft, maar bij deze baan is mijn passie de basis, waardoor eindelijk alles samenkomt.\""
                            }
                        ]
                    }
