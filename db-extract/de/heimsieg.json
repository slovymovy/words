                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad76c92e-3cf6-47f6-b977-528148cd0d18",
                                "sense_id": "7f3eb6b8-ab56-3426-a655-34bbb74cddaa",
                                "text": "Sie feierten ihren fünften Heimsieg in Folge."
                            },
                            {
                                "example_id": "8c821366-cf27-45f1-ab6c-fff5835c800d",
                                "sense_id": "7f3eb6b8-ab56-3426-a655-34bbb74cddaa",
                                "text": "„Mit dem 3:1-Heimsieg gegen den rumänischen Vizemeister FCSB haben sich die Hütteldorfer eine gute Ausgangsposition für das Rückspiel am kommenden Donnerstag in Bukarest verschafft.“"
                            },
                            {
                                "example_id": "04766ad0-74a6-4533-8d72-ab58d6d9ee3d",
                                "sense_id": "7f3eb6b8-ab56-3426-a655-34bbb74cddaa",
                                "text": "„In einem umkämpften Freitagsspiel ist Borussia Mönchengladbach ein 3:1 (1:0)-Heimsieg gegen den Hamburger SV gelungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
