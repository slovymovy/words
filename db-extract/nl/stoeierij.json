                    }
                ],
                "senses": [
                    {
                        "sense_id": "98b966ea-da2f-3a49-a1cb-1dbf9543a033",
                        "entry_id": "10275be9-a284-33c5-abdc-1a74c59bb201",
                        "glosses": [
                            "ruw spelen; spelende vechtpartij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7e034e-7c18-4a4a-b38e-3e69bb24ad69",
                                "sense_id": "98b966ea-da2f-3a49-a1cb-1dbf9543a033",
                                "text": "Stoeierij was dan weer typerend voor vaders en hun kleuterzonen. Ook het taalgebruik was anders: woorden die het vaakst gebruikt worden bij zonen hebben betrekking tot prestaties en succes. ‘Trots’, ‘winnen’ en ‘top’ waren maar enkele voorbeelden."
                            },
                            {
                                "example_id": "8d148e34-6838-453b-ae3c-3988f46bd656",
                                "sense_id": "98b966ea-da2f-3a49-a1cb-1dbf9543a033",
                                "text": "De schilder Hugo Claus duldt in zijn atelier geen pottekijkers. Achter een ijzeren deur moeten de twee kamers liggen waar hij zijn 'stoeierijen' maakt. De vraag om er een kijkje te nemen, verbaast hem. “Beschrijft u het maar als iets tussen het atelier van Francis Bacon en een kippenhok,” zegt hij luid, duidelijk en lacherig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1919f89c-d1ba-46c7-9a67-6b9ffaa5638e",
                        "source_entry_id": "10275be9-a284-33c5-abdc-1a74c59bb201",
                        "source_sense_id": "98b966ea-da2f-3a49-a1cb-1dbf9543a033",
                        "target_lang_word": "game of rough-and-tumble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1e9f8281-c0fa-4f5c-ab9a-6ddc431900e2",
                        "source_entry_id": "10275be9-a284-33c5-abdc-1a74c59bb201",
                        "source_sense_id": "98b966ea-da2f-3a49-a1cb-1dbf9543a033",
                        "target_lang_word": "fight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa79f06b-fb0c-3654-8e37-06cc090b4627",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Senses relating to physical conflict:",
                                            "To engage in combat with; to oppose physically, to contest with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf50373-a1be-466b-8241-19fa4b349f46",
                                                "sense_id": "fa79f06b-fb0c-3654-8e37-06cc090b4627",
                                                "text": "My grandfather fought the Nazis in World War II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Senses relating to physical conflict:",
                                            "To conduct or engage in (battle, warfare, a cause, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9b2550-d07f-4199-bc26-2a6e7a15c2f4",
                                                "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                                "text": "Our soldiers fought the battle just over that hill."
                                            },
                                            {
                                                "example_id": "8319a629-1f3d-4648-bc6f-de84ad1000e9",
                                                "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                                "text": "I have fought a good fight."
                                            },
                                            {
                                                "example_id": "e6843ec7-baa0-4f56-a96c-be4315b2c394",
                                                "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                                "text": "Fight the good fight of faith, lay hold on eternal life, whereunto thou art also called, and hast professed a good profession before many witnesses."
                                            },
                                            {
                                                "example_id": "05539b41-73bb-4d59-a72e-4859e2c787c1",
                                                "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                                "text": "His Suff’rings ſhine, and ſpread a Glory round him;\nGreatly unfortunate, he fights the Cauſe\nOf Honour, Virtue, Liberty, and Rome."
                                            },
                                            {
                                                "example_id": "f4cd2bca-f453-4294-80b1-58da9183d6a5",
                                                "sense_id": "abfacf05-f748-36bb-991b-df1928b45fd8",
                                                "text": "was left to fight his way through the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "443ed92f-0d7a-3d24-a0c7-c53b6e5efa1f",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Senses relating to physical conflict:",
                                            "To contend in physical conflict, either singly or in war, battle etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794e45cc-ea18-4c7e-afa6-5c538d644fb8",
                                                "sense_id": "443ed92f-0d7a-3d24-a0c7-c53b6e5efa1f",
                                                "text": "A wounded animal will fight tooth and nail; relentless, savage and murderous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c8f5c4e-75d8-3f11-85f5-d127bdf9e220",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Senses relating to physical conflict:",
                                            "To contend in physical conflict with each other, either singly or in war, battle etc."
                                        ],
                                        "tags": [
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f358aa61-4c90-495a-adef-d31f04f3b33c",
                                                "sense_id": "8c8f5c4e-75d8-3f11-85f5-d127bdf9e220",
                                                "text": "The two boxers have been fighting for more than half an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e81e1a-643b-3371-866f-9ceb2ba6888f",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Senses relating to physical conflict:",
                                            "To cause to fight; to manage or manoeuvre in a fight."
                                        ],
                                        "tags": [
                                            "causative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "486f85ab-bdda-41dd-9bb8-adfc307bf572",
                                                "sense_id": "56e81e1a-643b-3371-866f-9ceb2ba6888f",
                                                "text": "And so we made their grave where they should lie\nClose side by side, as they had fought their tank\nThrough every fight, arm touching arm.\nWe made it deep, that nothing of the conflict they had left above\nShould break into their peace."
                                            },
                                            {
                                                "example_id": "404a1704-3e75-4f14-99c8-485d625bb8c4",
                                                "sense_id": "56e81e1a-643b-3371-866f-9ceb2ba6888f",
                                                "text": "to fight cocks; to fight one’s ship"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a8c58c-5350-3bc9-8f37-9148307b9849",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "To strive for something; to campaign or contend for success."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187a3831-0fcb-4523-993e-4242765598a2",
                                                "sense_id": "87a8c58c-5350-3bc9-8f37-9148307b9849",
                                                "text": "He fought for the Democrats in the last election."
                                            },
                                            {
                                                "example_id": "fee6f934-0e4b-47d3-9362-78cc9e9f2f3a",
                                                "sense_id": "87a8c58c-5350-3bc9-8f37-9148307b9849",
                                                "text": "Old Applegate, in the stern, just set and looked at me, and Lord James, amidship, waved both arms and kept hollering for help. I took a couple of everlasting big strokes and managed to grab hold of the skiff's rail, close to the stern. Then, for a jiffy, I hung on and fought for breath."
                                            },
                                            {
                                                "example_id": "280c7b51-7d1a-45d7-a43f-d0ed43406657",
                                                "sense_id": "87a8c58c-5350-3bc9-8f37-9148307b9849",
                                                "text": "[Edmund] Burke continued to fight for liberty later on in life. He backed Americans in their campaign for freedom from British taxation. He supported Catholic freedoms and freer trade with Ireland, in spite of his constituents’ ire. He wanted more liberal laws on the punishment of debtors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a9e28e3-d5ee-3bd7-a5c2-a1a3148428e0",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "To try to overpower; to fiercely counteract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4086b2-46d8-4d5e-b0cd-fe37584481a2",
                                                "sense_id": "0a9e28e3-d5ee-3bd7-a5c2-a1a3148428e0",
                                                "text": "The government pledged to fight corruption."
                                            },
                                            {
                                                "example_id": "2a845e06-35ea-4acf-9070-63c6d39a18e3",
                                                "sense_id": "0a9e28e3-d5ee-3bd7-a5c2-a1a3148428e0",
                                                "text": "I fought a sneeze as Max took my hand and led me into the chapel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69efcf5e-cc4b-38a0-9be7-85dd621fb4a4",
                                        "entry_id": "800de467-c02d-313a-a132-a76bd42a0677",
                                        "glosses": [
                                            "Of colours or other design elements: to clash; to fail to harmonize."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e165cf2-50ba-4a5e-ba3f-d9010ee4854e",
                                                "sense_id": "69efcf5e-cc4b-38a0-9be7-85dd621fb4a4",
                                                "text": "The higher the saturation, the more the colors fight, and the more users will be looking at your design instead of your content."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "169a11db-63a0-3501-9136-ec7029ced34c",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "An occasion of fighting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108b95fc-1f39-46d3-b2ab-b215db7ff5f1",
                                                "sense_id": "169a11db-63a0-3501-9136-ec7029ced34c",
                                                "text": "One of them got stuck in a chokehold and got stabbed to death during the fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e9957f-80fa-321b-a5fa-be550cd1d056",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "A battle between opposing armies."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dddfef22-5524-3185-998e-679d2d1cefc2",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "A physical confrontation or combat between two or more people or groups."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "163cb965-533e-4118-8d75-2ce021b59caa",
                                                "sense_id": "dddfef22-5524-3185-998e-679d2d1cefc2",
                                                "text": "Watch your language! Are you looking for a fight?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0774c79c-1fbc-3c86-861b-dd8ec1dd9b60",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "A boxing or martial arts match."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f28c505-9d49-4558-8b7e-72e14d0f37dd",
                                                "sense_id": "0774c79c-1fbc-3c86-861b-dd8ec1dd9b60",
                                                "text": "I’m going to Nick’s to watch the big fight tomorrow night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7315526-6e44-3104-8b83-823f819f902e",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "A conflict, possibly nonphysical, with opposing ideas or forces; strife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cccd911-362c-496b-99b1-e42ffd45569c",
                                                "sense_id": "d7315526-6e44-3104-8b83-823f819f902e",
                                                "text": "I’ll put up a fight to save this company."
                                            },
                                            {
                                                "example_id": "31c8c629-2383-4e50-8d9c-ba507a2381e2",
                                                "sense_id": "d7315526-6e44-3104-8b83-823f819f902e",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police […]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            },
                                            {
                                                "example_id": "d57f63b0-5957-4df6-ae1e-f25ffdfa92fe",
                                                "sense_id": "d7315526-6e44-3104-8b83-823f819f902e",
                                                "text": "As the world's drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants. But even that Sisyphean task looks easy next to the fight against synthetic drugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e944d70-7611-375a-9aff-963e4b3f63ef",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "The will or ability to fight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd10ebdb-b2e0-459c-8529-cf9396383382",
                                                "sense_id": "9e944d70-7611-375a-9aff-963e4b3f63ef",
                                                "text": "That little guy has a bit of fight in him after all. As soon as he saw the size of his opponent, all the fight went out of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ff2425-0ba3-334d-9de9-a3ab7ab5cc54",
                                        "entry_id": "248a1c57-9f76-3809-80c9-04306e3dc57b",
                                        "glosses": [
                                            "A screen for the combatants in ships; an arming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47bc75f4-e47f-43e3-a1ee-3ec0fc27acef",
                                                "sense_id": "76ff2425-0ba3-334d-9de9-a3ab7ab5cc54",
                                                "text": "Who ever ſaw a noble ſight, / That never view'd a brave Sea Fight: / Hang up your bloody Colours in the Aire, / Up with your Fights, and your Nettings prepare, / Your Merry Mates chear, with a luſty bold ſpright, / Now each Man his brindice, and then to the Fight, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
