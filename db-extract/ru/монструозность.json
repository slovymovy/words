                        "form": "монструо́зности"
                    },
                    {
                        "form_id": "3da6f9cf-9cf3-4146-8c61-88f0b6ec7eab",
                        "entry_id": "f228ed99-9248-3338-b976-feb615b23a3a",
                        "tags": [
