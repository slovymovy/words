                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8cfbdeb-1290-4647-b625-2b54492335ba",
                                "sense_id": "eb2aaaa6-143d-3c6e-bae7-9d88b3a910a4",
                                "text": "„Dabei handelt es sich um eine Lavendelart, die aus einer Kreuzung zwischen Echtem Lavendel und Speiklavendel entstanden ist.“"
                            },
                            {
                                "example_id": "879f9753-45e0-4320-a776-214d6ab66509",
                                "sense_id": "eb2aaaa6-143d-3c6e-bae7-9d88b3a910a4",
                                "text": "„Da diese Lavendelart über kleinere Blüten verfügt, ist die Ausbeute entsprechend geringer als bei kultiviertem Lavendelarten im Tal.“"
                            },
                            {
                                "example_id": "f5a42094-d445-4c58-9e9d-1b3ef77cb167",
                                "sense_id": "eb2aaaa6-143d-3c6e-bae7-9d88b3a910a4",
                                "text": "„[…] als gute Nahrungsquellen für Bienen gelten die beiden Lavendelarten Lavandula angustifolia (Echter Lavendel) und Lavandula stoechas (Schopflavendel).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
