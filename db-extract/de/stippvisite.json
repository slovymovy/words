                                "target_senses": [
                                    {
                                        "sense_id": "010dff60-e8fb-354e-b0f1-e2916a19f408",
                                        "entry_id": "ba9c5182-eaa0-3017-bee2-c6c6785b9609",
                                        "glosses": [
                                            "een zeer kort durend bezoek dat vaak ook onverwacht is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570f5e77-653d-47ef-94a6-74f5fbc59517",
                                                "sense_id": "010dff60-e8fb-354e-b0f1-e2916a19f408",
                                                "text": "Als het aan de correspondenten van buitenlandse media ligt, die de laatste weken in drommen een bliksembezoek aan ons land brachten, gaat het bij de verkiezingen tussen blikvangers Geert Wilders en Jesse Klaver. „Au Pays-Bas, Wilders domine la campagne”, kopte Le Monde. Heb ik iets gemist? Flink wat journalisten stuurden mails en belden met vragen over de onstuitbare opmars van de PVV. Het Angelsaksische jongerenmagazine Vice stuurde speciaal iemand naar Nederland om het „fenomeen” Klaver te duiden."
                                            },
                                            {
                                                "example_id": "23bf4276-6de7-431b-ad43-a56de18ae159",
                                                "sense_id": "010dff60-e8fb-354e-b0f1-e2916a19f408",
                                                "text": "Nadat ze waren teruggekomen van hun bliksembezoek aan het Las Vegas was het gevoel van machteloosheid aan haar opgebouwde zelfvertrouwen gaan knagen."
                                            }
                                        ]
                                    }
                                ]
                            }
