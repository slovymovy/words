                "translations": [
                    {
                        "translation_id": "7fb78488-8549-49aa-890e-951506af95a2",
                        "source_entry_id": "8aded204-58b7-347d-9b5d-a46758868f31",
                        "source_sense_description": "overlap in a regular pattern",
                        "target_lang_word": "imbriquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbriquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98735ac0-2c1d-3de9-bc57-d47917cad84a",
                                        "entry_id": "2c49ba71-c225-33ca-bb6a-ba6231353dcd",
                                        "glosses": [
                                            "Disposer des éléments (par exemple, des tuiles, des blocs dans un programme informatique, etc.) de façon qu’ils se chevauchent ou soient les uns dans les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd589df2-6ce2-4c1c-950f-8946c6c9d825",
                                                "sense_id": "98735ac0-2c1d-3de9-bc57-d47917cad84a",
                                                "text": "Une animale et commune chaleur pouvait seule rassurer. Chaque voyageur cherchait à imbriquer davantage son ossature dans celle du voisin."
                                            },
                                            {
                                                "example_id": "8da1bb06-b8a8-4eec-9ee1-6e11695b9f3f",
                                                "sense_id": "98735ac0-2c1d-3de9-bc57-d47917cad84a",
                                                "text": "[…] : au premier plan, la Provence à plateaux, les Alpes à l'horizon, et en même temps, dans le même regard, on voit l'attrait qu'elles exercent l'une sur l'autre, on pressent le duel, la force qu'il leur a fallu, à l'une et à l'autre, et sans démission ni de l'une ni de l'autre, pour s’interpénétrer de façon si distincte et convulsive à la fois, pour se fricasser sans se confondre, pour se marier d'un amour rustique et sauvage, pour s'entr’aimer, s’entrefriquer comme disait Brantôme, s’imbriquer sans aucun renoncement."
                                            },
                                            {
                                                "example_id": "5dcca02a-a967-4b4b-8f66-e72f5dc2ce43",
                                                "sense_id": "98735ac0-2c1d-3de9-bc57-d47917cad84a",
                                                "text": "Ce dernier exemple permet de mettre en évidence la possibilité d’imbriquer les instructions CASE les unes dans les autres."
                                            },
                                            {
                                                "example_id": "5ff867de-f1e0-491d-b2e9-bd72146b04ee",
                                                "sense_id": "98735ac0-2c1d-3de9-bc57-d47917cad84a",
                                                "text": "Je ne connais rien de plus captivant que de faire des images… Quand tous les éléments de la nature s’ajustent, s’ordonnent, s’imbriquent… C’est une émotion sans pareille…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f85399-b3da-32c3-b6a6-9b8bee1b8597",
                                        "entry_id": "2c49ba71-c225-33ca-bb6a-ba6231353dcd",
                                        "glosses": [
                                            "Joindre de façon à ce que les divers éléments se lient mutuellement les uns aux autres pour former un tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8367f9aa-f382-4aa8-ada6-01d9c80b5d23",
                                                "sense_id": "43f85399-b3da-32c3-b6a6-9b8bee1b8597",
                                                "text": "Pour une approche plus objective et compréhensive du site, nous l’avons ainsi enrichi d’une longue interview avec Walid el-Assaad, dont l’histoire familiale est imbriquée avec celle de Palmyre depuis des générations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
