        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1f5fefbb-5165-31f3-977c-4d7d8e815f9c",
                "word": "susurrus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cab8ac7c-ccfc-4287-974a-238b2348e73c",
                        "entry_id": "1f5fefbb-5165-31f3-977c-4d7d8e815f9c",
                        "tags": [
                            "plural"
                        ],
                        "form": "susurruses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                        "entry_id": "1f5fefbb-5165-31f3-977c-4d7d8e815f9c",
                        "glosses": [
                            "A whispering or rustling sound; a murmur."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "a130e9a9-f2ca-46e9-b555-2ab1599a057c",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "[Johann Heinrich Pestalozzi was] pelted with buckets of water by firemen, and, finally, currycombed and rubbed down by two grooms, keeping a sharp susurrus between them, so as to soothe his wounded feelings; […]"
                            },
                            {
                                "example_id": "25f7cda5-da2b-40fa-8972-a0d63f67813e",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "The soft susurrus and sighs of the branches."
                            },
                            {
                                "example_id": "d630bb08-feb0-4fd7-b533-bb882bf32ac7",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "They heard the Green Fork before they saw it, an endless susurrus, like the growl of some great beast."
                            },
                            {
                                "example_id": "81fb1ca1-dfed-473f-942f-5613e3408a95",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "I sipped at a drink and smoked cigarettes in a silence so profound that I could hear the susurrus of the blindfold's soft fabric rustle and slip between my fingers."
                            },
                            {
                                "example_id": "fd76c035-8a80-4abb-8ac6-35482923740a",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "I walked steadily toward the pennant pole amid a sea of susurrus murmurings."
                            },
                            {
                                "example_id": "3d20d1e1-8457-4473-89b8-f31853547242",
                                "sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                                "text": "Bod could feel the Sleer listening to Jack's words, could feel a low susurrus of excitement building in the chamber."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4146153-e035-4a94-9e4d-2f291eeff600",
                        "source_entry_id": "1f5fefbb-5165-31f3-977c-4d7d8e815f9c",
                        "source_sense_id": "f7d87b41-bc84-3c5c-b493-997d0fe37197",
                        "source_sense_description": "whispering or rustling sound",
                        "target_lang_word": "susurrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "susurrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1348984e-9178-3802-afc6-a82ddc3c1320",
                                        "entry_id": "0c875370-36dc-32c8-bd61-d03f018db90e",
                                        "glosses": [
                                            "Action de susurrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57cf5ad-6491-497c-870b-c1e65cf5cf36",
                                                "sense_id": "1348984e-9178-3802-afc6-a82ddc3c1320",
                                                "text": "[…] dont les allées ont entendu tant de gazouillements et de susurrements qui n’étaient pas seulement des gazouillements d’oiseaux, des susurrements de feuilles agitées par le vent."
                                            },
                                            {
                                                "example_id": "0e84ab5d-018f-4e72-9496-82ff7e813ec4",
                                                "sense_id": "1348984e-9178-3802-afc6-a82ddc3c1320",
                                                "text": "Je marchais sur les levées, et je ne sais comment je me rappelai qu’à cet endroit-là même autrefois, dans de froides nuits pareilles, j’avais chassé des canards. J’entendais au-dessus de ma tête le susurrement rapide et singulier que font ces oiseaux en volant très-vite. Un coup de fusil retentit."
                                            },
                                            {
                                                "example_id": "a7902c29-62b3-491e-9a0b-1d2a10eb248c",
                                                "sense_id": "1348984e-9178-3802-afc6-a82ddc3c1320",
                                                "text": "Rien ne lui échappait : le susurrement sucré de la jeune vedette héroïne, le parler guttural du caïd sans scrupules, les nasillements du faux-frère, les jacassements de la commère, le jargon du bellâtre amoureux, […]"
                                            },
                                            {
                                                "example_id": "ff1a31f8-a2bc-4ebf-8b5c-d9ba18e3d5b7",
                                                "sense_id": "1348984e-9178-3802-afc6-a82ddc3c1320",
                                                "text": "[…] il écoutait ces bruits qui se propagent à la surface des hauts plateaux, ces murmures inquiétants, qui tiennent à la fois du susurrement, du gémissement et du soupir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
