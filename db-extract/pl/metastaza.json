                                    {
                                        "sense_id": "faf8130a-d535-394c-b980-7fed088dd12b",
                                        "entry_id": "1c55ed04-645d-3300-9fa6-7d9043df33ab",
                                        "glosses": [
                                            "auf Grund der Verschleppung von Materie innerhalb eines Organismus neu entstandener, zusätzlicher Krankheitsherd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83020c8f-3415-4862-b26c-46725ac1dae1",
                                                "sense_id": "faf8130a-d535-394c-b980-7fed088dd12b",
                                                "text": "Metastasen entstehen durch die Verschleppung belebter Materie, wie körpereigener Zellen oder Bakterien, aber auch durch die Verschleppung unbelebter Stoffe wie Pigmenten oder Kalk."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                        "entry_id": "1c55ed04-645d-3300-9fa6-7d9043df33ab",
                                        "glosses": [
                                            "durch Verschleppung von Tumorzellen neu entstandener, bösartiger Tumor"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3854ad-9f8a-4a4a-95c8-c2b8f74a0dc3",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "Da der Tumor bereits Metastasen gebildet hat, ist die Heilungschance erheblich verschlechtert."
                                            },
                                            {
                                                "example_id": "828accf8-204a-49a3-9ab2-1bd54e3c58d8",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "Mit bildgebenden Verfahren wurde nach Metastasen in der Leber gesucht."
                                            },
                                            {
                                                "example_id": "d2e7b23b-cecc-4c6f-a207-ad7592b864fd",
                                                "sense_id": "b96de19d-7922-393b-a6d5-4cfc9cf386f6",
                                                "text": "„Der Blasenkrebs war bereits ins letzte Stadium getreten, als Herd und Metastasen von Doktor Aaron entdeckt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
