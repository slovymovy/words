                ],
                "senses": [
                    {
                        "sense_id": "3976dad2-810b-3ddc-9993-79b115bb374b",
                        "entry_id": "ec16fcdb-d0cd-3420-8e86-96239bee3439",
                        "glosses": [
                            "Vendre (quelque chose) avant que ce qu’on vend soit disponible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca1dff61-8a0f-4484-a6af-c67f25182592",
                                "sense_id": "3976dad2-810b-3ddc-9993-79b115bb374b",
                                "text": "Concernant le financement de ton projet de livre, il est possible, à certains conditions, de “prévendre un projet”."
                            },
                            {
                                "example_id": "b21ef99e-0de9-4cae-8756-153e4e68044f",
                                "sense_id": "3976dad2-810b-3ddc-9993-79b115bb374b",
                                "text": "La publicité a comme intérêt principal de contribuer à prévendre les produits, et de faciliter le travail de la force de vente, car son objectif principal est soit de lancer un produit pour inciter les clients à l’achat, soit pour se faire connaître, car il ne faut pas oublier que nouveauté et réactivité sont de rigueur dans la communication."
                            },
                            {
                                "example_id": "873f9e79-cd91-4b98-bf36-833e188b8792",
                                "sense_id": "3976dad2-810b-3ddc-9993-79b115bb374b",
                                "text": "Les organisateurs lui avaient prévendu près de 400 places."
                            }
                        ]
                    }
                ],
