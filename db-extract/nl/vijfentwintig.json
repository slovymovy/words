                                "example_id": "8ce3a994-9a54-4612-be8c-1950c547a30c",
                                "sense_id": "0c10fc48-3c44-35da-94d8-78948a44b728",
                                "text": "Haar zesentwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vijfentwintig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
