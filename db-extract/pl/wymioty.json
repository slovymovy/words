                                "target_senses": [
                                    {
                                        "sense_id": "299bd3f2-4f87-3eb8-be0d-92814b815daa",
                                        "entry_id": "91d1ef93-a8ef-3dd9-9a54-cdec9bea9caf",
                                        "glosses": [
                                            "The act of one who vomits, or the matter that is vomited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb17c6c5-6ae0-433e-9151-e9a7a361c5d5",
                                                "sense_id": "299bd3f2-4f87-3eb8-be0d-92814b815daa",
                                                "text": "Epilepsies, or fallings and reelings, and beastly vomitings. The least of these, even when the tongue begins to be untied, is a degree of drunkenness."
                                            },
                                            {
                                                "example_id": "079c884f-99f8-44c1-a56c-1cdd074ca7ab",
                                                "sense_id": "299bd3f2-4f87-3eb8-be0d-92814b815daa",
                                                "text": "It is certainly probable that these black vomitings and stools may be absent, and in that case it would be extremely difficult to diagnose between simple ulcer of the stomach and non-ulcerative gastritis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
