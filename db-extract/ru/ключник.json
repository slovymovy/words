                                        "entry_id": "aaea5a7f-6d9c-39e8-a75d-45fe2a62f12e",
                                        "glosses": [
                                            "A flight attendant, especially male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff1c721-e131-4548-aea8-3863a453e415",
                                                "sense_id": "c156de4a-7def-388f-a30e-8ce5712227b3",
                                                "text": "The gay Kibbutzniks I met were all ex-Kibbutzniks who were curretly holding jobs as El-Al stewards or in some similarly classic gay professions."
                                            }
                                        ]
                                    },
