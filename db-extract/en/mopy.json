                ],
                "senses": [
                    {
                        "sense_id": "74481eb6-c779-38fd-aabc-142feb92eff0",
                        "entry_id": "1b70b199-5419-3866-b0b7-dacf1f861d71",
                        "glosses": [
                            "To print more than one copy of a document using a computer printer rather than printing one original and copying it with a separate machine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ce79d5-a673-4187-9f2b-45362262fc54",
                                "sense_id": "74481eb6-c779-38fd-aabc-142feb92eff0",
                                "text": "Mopy is a term HP [Hewlett-Packard] has coined to talk about a new paradigm to address the current printing/coping^([sic]) trend. Mopying is a term describing the process of creating multiple original prints, or \"mopies\" on a laser printer."
                            },
                            {
                                "example_id": "c82dc370-211e-414c-8899-3ad3e204b767",
                                "sense_id": "74481eb6-c779-38fd-aabc-142feb92eff0",
                                "text": "[…] \"mopying\" - making a document and copying it many times - had become common."
                            },
                            {
                                "example_id": "9059e1c7-d7b3-434e-970f-0e15d0ea083a",
                                "sense_id": "74481eb6-c779-38fd-aabc-142feb92eff0",
                                "text": "Some offer a function called mopying. Instead of printing one original and then making copies on a copying machine, you get several originals of the document (or high-quality copies)."
                            }
                        ]
                    }
                ],
