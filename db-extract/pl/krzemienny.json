                                        "examples": [
                                            {
                                                "example_id": "f610c955-9a0a-4fe5-880c-b644744ee33b",
                                                "sense_id": "5246d448-81e6-3f88-80c5-506321a6d55f",
                                                "text": "Public opinion has turned flintier in recent years on welfare spending."
                                            },
                                            {
                                                "example_id": "e20f6b0b-83b7-4fdd-8d9d-3d96d4800e56",
                                                "sense_id": "5246d448-81e6-3f88-80c5-506321a6d55f",
                                                "text": "While the texture of his playing was often flinty, his licks and leads were flush with feeling."
                                            }
