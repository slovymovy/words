                    "sense_id": "96faae46-3eaa-3468-a56a-ec3688303ae8",
                    "sense_definition": "iets met een touw of kabel in opwaartse richting trekken, al dan niet middels een katrol",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "omhoog trekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>hesen</w> de zeilen en voeren hoog aan de wind naar het westen.",
                            "target_lang_translations": {
                                "en": "They <w>hoisted</w> the sails and sailed close-hauled to the west."
                            }
                        },
                        {
                            "text": "De bouwvakkers moesten de zware balken naar de bovenste verdieping <w>hijsen</w>.",
                            "target_lang_translations": {
                                "en": "The construction workers had to <w>hoist</w> the heavy beams to the top floor."
                            }
