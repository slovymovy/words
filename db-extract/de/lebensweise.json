                    },
                    {
                        "form_id": "a4c51a4c-7ff2-4b85-9848-33623bf360c1",
                        "entry_id": "3a0f7fde-f4d5-3a60-a0ed-c33808582e5a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Lebensweise"
                    },
                    {
                        "form_id": "7a196e68-1089-4c54-a596-5eda344e725a",
                        "entry_id": "3a0f7fde-f4d5-3a60-a0ed-c33808582e5a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lebensweisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                        "entry_id": "3a0f7fde-f4d5-3a60-a0ed-c33808582e5a",
                        "glosses": [
                            "die Art und Weise, wie man lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9275acf-96bb-4248-9498-2b59fc87881b",
                                "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                                "text": "Max hat eine gesunde Lebensweise. Er joggt jeden Morgen."
                            },
                            {
                                "example_id": "a1dc4278-b61b-43a0-83a9-b9ede46bdbf0",
                                "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                                "text": "„In ihrem Salon sammelte sie Menschen um sich, die unkonventionell dachten und die Lebensweise der Gastgeberin achteten, wenn nicht gar bewunderten.“"
                            },
                            {
                                "example_id": "8af3fa74-fd98-4483-a65d-4c14b1a78f7a",
                                "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                                "text": "„Obwohl nur Knochen- und Zahnfragmente der Urmenschen erhalten geblieben sind, bieten sich Möglichkeiten, ihre Lebensweise zu interpretieren und zu rekonstruieren.“"
                            },
                            {
                                "example_id": "ef1cf628-608b-4c9f-a9df-87f6633515b1",
                                "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                                "text": "„Die Neuankömmlinge haben sich im Bewusstsein der Einheimischen ihren Platz erobert, sie ändern die hiesige Lebensweise und Sprache.“"
                            },
                            {
                                "example_id": "3903619b-5689-49ab-8de2-5b0fc8c081d7",
                                "sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                                "text": "„Gleichzeitig waren viele Ostjuden auf der Flucht vor der Verfolgung und vor den engen Verhältnissen, welche die dortige meist vorindustrielle Lebensweise ihnen bot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "179f2692-4315-4c19-9c47-3d8a5259c23b",
                        "source_entry_id": "3a0f7fde-f4d5-3a60-a0ed-c33808582e5a",
                        "source_sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                        "source_sense_description": "die Art und Weise, wie man lebt",
                        "target_lang_word": "way of life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "way of life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a86d7c-8850-375c-8941-93da9d88d5d9",
                                        "entry_id": "1ec19465-fbdd-3584-9ffc-0ab2179078b8",
                                        "glosses": [
                                            "A style of living that reflects the attitudes of a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b601a92-6847-40c1-aa24-b78ed6e672dc",
                                                "sense_id": "d9a86d7c-8850-375c-8941-93da9d88d5d9",
                                                "text": "My fellow citizens: I want to talk to you about Korea, about why we are there, and what our objectives are. It is your liberty and mine which is involved. What is at stake is the free way of life- the right to worship as we please, the right to express our opinions, the right to raise our children in our own way, the right to choose our jobs, the right to plan our future and the right to live without fear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88999891-cf19-4884-8ab3-c79f741d40bf",
                        "source_entry_id": "3a0f7fde-f4d5-3a60-a0ed-c33808582e5a",
                        "source_sense_id": "47ac1d07-661b-3813-9226-014a15052c71",
                        "source_sense_description": "die Art und Weise, wie man lebt",
                        "target_lang_word": "mode de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mode de vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                        "entry_id": "d2eebe92-c3ab-3508-a386-e7eb193850f5",
                                        "glosses": [
                                            "Ensemble des pratiques, des comportements, des besoins et des aspirations inhérent à une personne ou à un groupe d’individu. Et ceci d’un point de vue économique, social et culturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec0f3f8-1823-4fbc-bb77-3edf199194fb",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "L’Europe occidentale est profondément marquée par le mode de vie d’Outre-Atlantique qui semble être porteur de valeur universelle comme la réalisation de soi et le succès, l’activité, l’efficacité et l’esprit pratique, le progrès, le confort matériel, l’individualité, la liberté, le conformisme externe, l’humanisme, la jeunesse, la forme physique et la santé."
                                            },
                                            {
                                                "example_id": "0f3070c3-dcbd-47bd-a73c-28936dede5bd",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Le terme de \"petite-bourgeoisie\" a longtemps fonctionné comme notion stigmatisante, à savoir une accusation portée sur un groupe social qui dans son mode de vie tendait beaucoup à copier le mode de vie \"bourgeois\"."
                                            },
                                            {
                                                "example_id": "8f398572-7f47-4e4b-9658-74cd0f9c9a4f",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Il m'a tout d'un coup semblé préférable d'examiner comment certains peuples répondaient, dans leurs modes de vie, plutôt que dans un discours théorique, aux questions que nous nous posons tous."
                                            },
                                            {
                                                "example_id": "1019b2ad-fe8d-42ea-a251-52d9a42c40f7",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Si certaines industries du Maroc sont technologiquement proches de l'Oldowayen, en l'absence de fouille de sols d'habitat, on ne peut rien dire sur le plan palethnologique du mode de vie de leurs auteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                        "entry_id": "d2eebe92-c3ab-3508-a386-e7eb193850f5",
                                        "glosses": [
                                            "Comportement biologique ou écologique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fa0682-7aba-4160-9fe4-b8512c4e839f",
                                                "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                                "text": "Des zoocécidies peuvent se former, suivant le mode de vie (aérien, souterrain, etc.) du parasite qui les provoque, dans tous les organes (racines, tiges, feuilles, fleurs) de nombreux Végétaux supérieurs."
                                            },
                                            {
                                                "example_id": "3201b559-98dd-418e-b4c8-826b4148c718",
                                                "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                                "text": "Ces minuscules algues peuvent se décolorer par perte - réversible ou non - de leur chlorophylle. Sous l'influence de l'obscurité ou de mauvaises conditions de nutrition, elles cessent d'effectuer la photosynthèse et adoptent un mode de vie typiquement animal : elles se nourrissent d'aliments organiques solides ou liquides.,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
