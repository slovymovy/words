                                        "entry_id": "0f579e3a-961c-35b0-bb9e-8bec24c6ba70",
                                        "glosses": [
                                            "Participe passé masculin singulier de élire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0635a0b8-4c9c-460f-86ce-e8115c9a60bc",
                                                "sense_id": "b5c18f7b-ab01-3602-98f2-f4ad6ff939d6",
                                                "text": "Le Lay et Mougeotte ont donné l’ordre à Houzelot de \"lobbyer\" pour que Bourges soit élu."
                                            }
