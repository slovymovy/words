                        "glosses": [
                            "Sortir d’un conteneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fdee75c-b6f0-41ce-932f-c015b6e16664",
                                "sense_id": "e36b9c0d-9be0-380b-8ae9-7be4201cc388",
                                "text": "Ce matériel est déconteneurisé lors des installations à bord des navires."
                            },
                            {
                                "example_id": "d8a5b953-411f-4ba8-95f1-50070f9638a8",
                                "sense_id": "e36b9c0d-9be0-380b-8ae9-7be4201cc388",
                                "text": "La marchandise est mise en conteneur au port de départ (LCL/...) et/ou \"déconteneurisée\" au port d'arrivée (.../LCL)."
                            },
                            {
                                "example_id": "4eac0fe8-6f3b-4cab-99e3-aa28b8e7aafe",
                                "sense_id": "e36b9c0d-9be0-380b-8ae9-7be4201cc388",
                                "text": "On peut récupérer les fichiers HD sur l’optex, ils sont au format .trp mais on peut facilement les \"déconteneuriser\" avec h264ts_cutter pour avoir des fichiers en .ts, une fois ceci effectué on en fait ce que bon nous semble..."
                            }
                        ]
