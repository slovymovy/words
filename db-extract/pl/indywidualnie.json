                                    {
                                        "sense_id": "4ccca5b1-f21f-3128-b93a-24fdcca080a0",
                                        "entry_id": "322bc079-b673-3aa3-b0d7-7fbc8c1e94a9",
                                        "glosses": [
                                            "Uno a uno."
