                    {
                        "translation_id": "0a77dcf6-e00d-47a9-9a73-17b89b339b22",
                        "source_entry_id": "072cde7b-e883-3f0e-8b31-c93f329d1ef2",
                        "target_lang_word": "Bifurkation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bifurkation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86d829d3-1ccf-3e79-8319-4a97aba33bb5",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Gabelung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d6ab49-1b62-4b06-9bc2-bb5e31c0ccf2",
                                                "sense_id": "86d829d3-1ccf-3e79-8319-4a97aba33bb5",
                                                "text": "Nichts, was kommuniziert werden kann, entzieht sich dieser harten Bifurcation – mit einer einzigen Ausnahme: der Welt (im Sinne der Phänomenologie) als dem letzten Sinnhorizont, in dem all dies sich abspielt und der selbst weder positiv noch negativ qualifiziert, weder angenommen noch abgelehnt werden kann, sondern in aller sinnhaften Kommunikation als Bedingung der Zugänglichkeit weiterer Kommunikation mitproduziert wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c81d4a59-f481-3e00-af55-14f8852c064c",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Aufteilung in zwei Äste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e8c21c-dd1c-4763-b432-5d97c6c01123",
                                                "sense_id": "c81d4a59-f481-3e00-af55-14f8852c064c",
                                                "text": "Sodann wird ein dünner Katheter in die Aorta abdominalis eingeführt und bis über die Bifurkation der Bauchaorta hinaus in die linke A.ilica communis vorgeschoben, in die er fest eingebunden wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5cf5a25c-0ad0-3558-9f47-f8d4a3dfe7a6",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Spaltung des Penis von beiden Seiten"
                                        ],
                                        "tags": [
                                            "Körpermodifikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f990a31-8f70-476e-8e2e-dc5452c9fbd8",
                                                "sense_id": "5cf5a25c-0ad0-3558-9f47-f8d4a3dfe7a6",
                                                "text": "Eine Bifurkation ist eine Körpermodifikation des Penis, bei der dieser in unterschiedlichem Ausmaß von der Eichel her geteilt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7be4cc7d-1e80-336d-89cb-bd4441d8c6f5",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Aufteilungsstelle der Zahnwurzeln beim Menschen bei zweiwurzeligen Zähnen, wie den unteren Molaren und dem ersten oberen Prämolaren"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75732c48-d47b-4a60-8d46-0c71a42a0aae",
                                                "sense_id": "7be4cc7d-1e80-336d-89cb-bd4441d8c6f5",
                                                "text": "Bei einer Hemisektion (Prämolarisierung) wird die Zahnkrone bis zur Bifurkation in zwei Teile durchtrennt, die dann in etwa die Größe (nicht aber die Form) zweier Prämolaren haben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4538fe3f-f3a0-3661-bec7-d3ed3cfca22b",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Aufteilungsstelle der Zahnwurzeln beim Hund an den zweiten und dritten Prämolaren im Oberkiefer sowie an allen Unterkieferbackenzähnen ab dem zweiten Prämolaren"
                                        ],
                                        "tags": [
                                            "Tiermedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef12b0bc-482d-4289-be84-a14cf12d1680",
                                                "sense_id": "4538fe3f-f3a0-3661-bec7-d3ed3cfca22b",
                                                "text": "Bei einer Hemisektion (Prämolarisierung) wird die Zahnkrone bis zur Bifurkation in zwei Teile durchtrennt, die dann in etwa die Größe (nicht aber die Form) zweier Prämolaren haben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "8e254128-b5ac-3c07-9d18-cdb099ebadd2",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "qualitative Zustandsänderung in nichtlinearen Systemen unter Einfluss eines Parameters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c55ce3-4ef0-49f1-90b8-3718262a6825",
                                                "sense_id": "8e254128-b5ac-3c07-9d18-cdb099ebadd2",
                                                "text": "Ein typisches Beispiel einer Bifurkation ist das Knicken eines Stabes unter Druckbelastung."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "0531044e-952a-3f81-bbaa-2a6d58318a3d",
                                        "entry_id": "8253b877-5b44-306a-869a-23dce5109fef",
                                        "glosses": [
                                            "Aufteilung eines Flusses"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bd81bf-bd00-465c-918b-cf4370fb506f",
                                                "sense_id": "0531044e-952a-3f81-bbaa-2a6d58318a3d",
                                                "text": "Sehr selten ist die Bifurkation von zwei Flüssen so, dass sie in verschiedene Meere münden."
                                            },
                                            {
                                                "example_id": "ad6b204e-a44b-4b3f-a97c-05dab45cf008",
                                                "sense_id": "0531044e-952a-3f81-bbaa-2a6d58318a3d",
                                                "text": "Alexander von Humboldt entdeckte die Bifurkation des Orinoco."
