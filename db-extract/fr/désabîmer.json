                "senses": [
                    {
                        "sense_id": "7d85c4ef-0327-39d3-a01e-bc6bd35cf5fc",
                        "entry_id": "6f75d919-5965-3a6f-a9fb-515d1e090e51",
                        "glosses": [
                            "Remettre en état ce qui avait été abîmé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ccf7b47-8cba-47d9-aec4-77545270f0ff",
                                "sense_id": "7d85c4ef-0327-39d3-a01e-bc6bd35cf5fc",
                                "text": "La tendance moderne à désabîmer l’âme vise aussi à désabîmer le ciel."
                            },
                            {
                                "example_id": "23b70bad-9de7-4858-b016-cc367b33f036",
                                "sense_id": "7d85c4ef-0327-39d3-a01e-bc6bd35cf5fc",
                                "text": "J’écris des articles dans des blogs à propos des repas que je prépare tandis que j’essaie de mieux prendre soin de moi, et avec chaque nouveau post je me rends compte que je suis en train de me désabîmer après des années de laisser-aller."
                            },
                            {
                                "example_id": "ed08e55b-f6f1-4a0c-ad31-6b9e496675dd",
                                "sense_id": "7d85c4ef-0327-39d3-a01e-bc6bd35cf5fc",
                                "text": "Madame, Gudot va bien, il se « désabîme »."
                            }
                        ]
                    }
