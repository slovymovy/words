                "senses": [
                    {
                        "sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
                        "entry_id": "1fee7e5e-e16c-37bb-b89c-7068296869a0",
                        "glosses": [
                            "Se dit d'une sorte de poésie grossière et licencieuse, qui, usitée à Fescennie en Étrurie, passa de là à Rome et fut employée dans les divertissements dramatiques."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "32986be4-fd44-4a49-8f4a-53aa409b95a9",
                                "sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
                                "text": "Les vers fescennins, une fois bannis du théâtre, ne furent plus en usage que dans les triomphes, les mariages."
                            },
                            {
                                "example_id": "a76ae653-9dca-46cd-b662-a3e4e6d240c8",
                                "sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
                                "text": "Il est curieux – il est presque fescennin – que promontoire, langue, problème, mort soient le même."
                            },
                            {
                                "example_id": "f923d15d-9e34-44fe-a576-c6a40f0382dd",
                                "sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
                                "text": "Elle imita pour lui la cordace rapide, avec le geste libre et le chant fescennin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a8cd3a4-6b25-42c4-bad9-a7fdf278957a",
                        "source_entry_id": "1fee7e5e-e16c-37bb-b89c-7068296869a0",
                        "source_sense_id": "8945a431-0602-300b-8c6f-fd861ba479fd",
