                                                "sense_id": "1b5fe27f-0044-3650-b9ea-a4dd97bf3920",
                                                "text": "Die Wand muss genau in der Vertikalen stehen."
                                            },
                                            {
                                                "example_id": "41a148fc-9591-4577-b7fe-ca5a760efd44",
                                                "sense_id": "1b5fe27f-0044-3650-b9ea-a4dd97bf3920",
                                                "text": "„Im Gegensatz zum veräußerlichten Gipfelsammler fasziniert den beschaulichen Berggeher mehr das Auf-dem-Weg-Sein in der Vertikalen.“"
                                            }
