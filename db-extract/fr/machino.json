                        "examples": [
                            {
                                "example_id": "5bcc0151-81cd-4dd0-8252-ae0cecc33664",
                                "sense_id": "78430fad-7f4b-34b2-a0fb-3a5aa202b18a",
                                "text": "On me tendait un fil, attaché en haut dans les cintres à mi-chemin de l’autre côté de la scène et, tel Tarzan dans la jungle,je me laissais emporter côté jardin où un machino me réceptionnait au vol."
                            },
                            {
                                "example_id": "1a1c3cd5-f49c-4d20-842a-54616a158f1b",
                                "sense_id": "78430fad-7f4b-34b2-a0fb-3a5aa202b18a",
                                "text": "Un électro, c’est un machino qui a fait des études, expliqua Dédé à Maurice qui venait faire la connaissance des nouveaux. — Et un machino, c’est un électro qui n’est pas allé à l’école, ajouta Alain Schiltz en trinquant."
                            }
                        ]
                    }
