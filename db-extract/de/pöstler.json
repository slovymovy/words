                "senses": [
                    {
                        "sense_id": "30c5ddd7-45db-3424-8e48-c6b61c0473c8",
                        "entry_id": "083b74d9-96c6-3004-bee1-f400f731dc3a",
                        "glosses": [
                            "Mitarbeiter der Post"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "eba3c5e6-6d74-4f6e-8a1b-c0c7efacee19",
                                "sense_id": "30c5ddd7-45db-3424-8e48-c6b61c0473c8",
                                "text": "„Im Mietvertrag festzuhalten ist auch die Pflicht der Schneeräumung im Winter, damit der Pöstler Zugang zum Briefkasten hat.“"
                            },
                            {
                                "example_id": "0c55a739-702f-4071-a110-23d724f8ee91",
                                "sense_id": "30c5ddd7-45db-3424-8e48-c6b61c0473c8",
                                "text": "„Seit Wochen streiten sich die Politiker in Deutschland darüber, wie viele Pöstler es eigentlich im Land gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
