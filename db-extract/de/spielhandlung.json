                ],
                "senses": [
                    {
                        "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                        "entry_id": "a49dbc3a-a7ee-338d-a511-6488ec70f877",
                        "glosses": [
                            "zielorientierte, strukturierte Betätigung im Rahmen eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72c3bc9-8fb7-462f-b357-b361d73cc5ad",
                                "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                                "text": "„Danach ist es möglich, willkürlich Lage, Umfang, Ausdehnung von Spielhandlungen je nach Spielverlauf zu ändern oder bisher gelernte Gebrauchsanweisungen für bestimmte Materialien und Werkzeuge völlig neu zu deuten.“"
                            },
                            {
                                "example_id": "e40b3a36-69cb-4c37-becc-17e413191412",
                                "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                                "text": "„Solche Spielhandlungen sind durch kein akutes biologisches Bedürfnis bestimmt.“"
                            },
                            {
                                "example_id": "f7d8f4ab-4720-4121-970b-d565ac3d26ce",
                                "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                                "text": "„Die beliebten Spielformen, die Körper und Spielgeräte in relativ intensiven Spielhandlungen zum Einsatz bringen, sollten schon wegen ihrer anregenden Wirkung, ihrer Freisetzung von Emotionen und ihrer sozialen Bindekraft bei keinem Spielfest fehlen.“"
                            },
                            {
                                "example_id": "f2a836a1-b2d7-4da5-a894-1f2e6cba3c25",
                                "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                                "text": "„In dem Abschlussprotokoll heißt es, die Innenminister sähen es als erforderlich an, für Spiele, bei denen ein wesentlicher Bestandteil der Spielhandlung die virtuelle Ausübung von wirklichkeitsnah dargestellten Tötungshandlungen oder anderen grausamen oder sonst unmenschlichen Gewalttätigkeiten gegen Menschen oder menschenähnliche Wesen ist (Killerspiele), ein ausdrückliches Herstellungs- und Verbreitungsverbot so schnell wie möglich umzusetzen.“"
                            },
                            {
                                "example_id": "d350bb23-2e8c-4989-81ad-1133584fa557",
                                "sense_id": "a8090517-201b-324f-be30-fafd45f7708b",
                                "text": "„Im Spiel, so ist bei Huizinga nachzulesen, geht es nicht um das materielle Ergebnis der Spielhandlung, sondern um die ideelle Tatsache, daß das Spiel geglückt oder aufgegangen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                        "entry_id": "a49dbc3a-a7ee-338d-a511-6488ec70f877",
                        "glosses": [
                            "Ablauf der Ereignisse in einem Bühnenstück, bei einer Theateraufführung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e5afd6-8d20-447f-ab8c-1ccc97d4d5bd",
                                "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                                "text": "„Die Spielhandlung des ARD-Films fußt auf Anne Franks berühmtem Tagebuch, das in der Amsterdamer Prinsengracht 263 im Hinterhaus einer Marmeladenfabrik entstand.“"
                            },
                            {
                                "example_id": "b9c9fa8a-ab54-47f4-968a-44bb5afc67bf",
                                "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                                "text": "„Inspiriert durch ihren Mann und erfolgreichen Filmproduzenten Ilan Goldman, der als Enkel polnischer und russischer Juden in Montmartre aufwuchs, inszenierte sie die Ereignisse jenes Sommers 1942 in einer dramatischen Spielhandlung nach, die bereits drei Millionen Franzosen ins Kino zog.“"
                            },
                            {
                                "example_id": "d62fc359-6493-40da-bca6-16679a9abc93",
                                "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                                "text": "„Hier wagte es einer, wie in Salvatore Giuliano (Wer erschoss Salvatore G.?, 1962), seinem dritten Film, mit der Legende um den vermeintlichen Robin Hood Siziliens aufzuräumen und in einer Melange aus Spielhandlung, Zeitungsberichten und Interviews dessen Kollaboration mit der Mafia aufzudecken.“"
                            },
                            {
                                "example_id": "6a9bfd05-b95e-4c68-a78a-8f97a9636b0f",
                                "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                                "text": "„Dabei ist die Verschränkung von Dokumentarmaterial und nachgestellten Szenen, von Dialogen und Interviews, die Verknüpfung also von Geschichte und Spielhandlung, von Rekonstruktion und Kommentar so perfekt gelungen, daß nicht einmal die kleinste Nahtstelle sichtbar wird und man den Schauspieler Manfred Zapatka um so williger als Helmut-Schmidt-Darsteller akzeptiert, als er dem Altkanzler überhaupt nicht ähnelt.“"
                            },
                            {
                                "example_id": "1ba26c84-ba29-43ff-b76d-af6491fc4121",
                                "sense_id": "e7779d88-71a9-331b-b616-9fb66b49f124",
                                "text": "„Auslöser der Spielhandlung war ein Spiegel-Interview von Wolfgang Nowak über den seiner Ansicht nach desolaten Zustand der Schulpolitik Nordrhein-Westfalens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
