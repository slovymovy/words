                "senses": [
                    {
                        "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                        "entry_id": "521c9729-d9de-37b2-bd43-94dafe792316",
                        "glosses": [
                            "Wand aus Ziegeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c6c7f0-ac97-45fe-83fc-524408d8bd30",
                                "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                                "text": "Im Garten haben wir eine Ziegelwand errichtet."
                            },
                            {
                                "example_id": "18dcc958-1820-40d7-a20b-e6abe763395d",
                                "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                                "text": "Die Ziegelwand an der Frontseite wurde durch Graffitis verunstaltet."
                            },
                            {
                                "example_id": "c5c8dcf5-6c90-4686-9a62-7d6f61b054e8",
                                "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                                "text": "Das Auto raste durch drei Ziegelwände, bevor es zum Stehen kam."
                            },
                            {
                                "example_id": "5cad8c6e-9a81-4458-ac66-fc9e06716b3b",
                                "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                                "text": "Hat das Haus Beton- oder Ziegelwände?"
                            },
                            {
                                "example_id": "8f1659cf-53fa-407b-b81d-a12bcc55711e",
                                "sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                                "text": "„Das schicke italienische Lokal mit unverputzten Ziegelwänden und rot-weiß karierten Tischdecken, in dem wir uns ein paar Tage später trafen, war bekannt für seine hausgemachte Pasta.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24752728-4035-4137-b919-db45caf12010",
                        "source_entry_id": "521c9729-d9de-37b2-bd43-94dafe792316",
                        "source_sense_id": "416ac5d0-a5a9-3278-a270-4f5cad361cf4",
                        "source_sense_description": "Wand aus Ziegeln",
                        "target_lang_word": "brick wall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brick wall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70182e27-12f5-3fc4-bfeb-0d7ee012eff2",
                                        "entry_id": "3c56c0eb-9067-348c-9153-5c8368844561",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see brick, wall. A wall made of bricks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eca29c2-6ef0-3678-8b16-cc02e41ba05d",
                                        "entry_id": "3c56c0eb-9067-348c-9153-5c8368844561",
                                        "glosses": [
                                            "An obstacle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8b35dd-99dd-471f-9e19-309312825f74",
                                                "sense_id": "6eca29c2-6ef0-3678-8b16-cc02e41ba05d",
                                                "text": "The investigators came up against a brick wall in their search for the missing money when they discovered it had been transferred overseas."
                                            },
                                            {
                                                "example_id": "da147b62-46b3-4c2d-8244-1775d48a8db2",
                                                "sense_id": "6eca29c2-6ef0-3678-8b16-cc02e41ba05d",
                                                "text": "They all ran up against the brick wall of high cost until the cryogenic option was proven feasible in 1973."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6a7b50-5354-3342-aa3f-072397c5cbb7",
                                        "entry_id": "3c56c0eb-9067-348c-9153-5c8368844561",
                                        "glosses": [
                                            "A type of anti-aliasing filter with a steep cutoff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2828c2c3-0eae-408e-a3b2-52acefd6193d",
                                                "sense_id": "3f6a7b50-5354-3342-aa3f-072397c5cbb7",
                                                "text": "One of the first problems with the digital audio process is the use of brick wall filters with very steep slopes for anti-aliasing and anti-imaging purposes."
                                            },
                                            {
                                                "example_id": "4c6c5405-ed7d-4df5-8064-997ef765a444",
                                                "sense_id": "3f6a7b50-5354-3342-aa3f-072397c5cbb7",
                                                "text": "To reconstruct the sampled signal, an ideal brick wall filter is demanded to remove the output of band signal."
                                            },
                                            {
                                                "example_id": "0d5d0914-a30a-48e6-b5a6-0c145bc52630",
                                                "sense_id": "3f6a7b50-5354-3342-aa3f-072397c5cbb7",
                                                "text": "For example, a first order filter can be converted to a brick wall filter by multiplying by the brick wall factor 1.57."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f8af4dd-3f68-34e2-88b8-a32ab515e085",
                                        "entry_id": "3c56c0eb-9067-348c-9153-5c8368844561",
                                        "glosses": [
                                            "Someone who is silent or unresponsive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ad88ed1-a04f-4517-99a4-19ab4be50493",
                                                "sense_id": "2f8af4dd-3f68-34e2-88b8-a32ab515e085",
                                                "text": "When mama says she doesn't talk, she means it. She's a brick wall."
                                            },
                                            {
                                                "example_id": "94666a58-10a9-489d-8397-90c983834d19",
                                                "sense_id": "2f8af4dd-3f68-34e2-88b8-a32ab515e085",
                                                "text": "\"Does he talk much? I mean, does he initiate conversation?\"\n\"No. He's a brick wall,\" I said."
                                            },
                                            {
                                                "example_id": "05a0ec0a-610b-40de-a2b1-738ecc03183a",
                                                "sense_id": "2f8af4dd-3f68-34e2-88b8-a32ab515e085",
                                                "text": "Having uttered these benign assurances, Mr Burner III became a brick wall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brick wall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fef85c84-6a6b-3ce1-b692-215251c53107",
                                        "entry_id": "cda1e493-0610-31bc-a827-8335df4f1638",
                                        "glosses": [
                                            "To build a brick wall around."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2bc1fe-a38c-4748-9a23-811bb33d123a",
                                                "sense_id": "fef85c84-6a6b-3ce1-b692-215251c53107",
                                                "text": "They forcefully imprisoned her in a decorative room and brick walled it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7699606c-4818-3460-8927-a363a550fade",
                                        "entry_id": "cda1e493-0610-31bc-a827-8335df4f1638",
                                        "glosses": [
                                            "To filter using a brick wall filter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f947c59c-521a-46f6-be49-e000bc382b80",
                                                "sense_id": "7699606c-4818-3460-8927-a363a550fade",
                                                "text": "Audio recorded too quietly means that there is more opportunity for noise, even in today's digital workflow. Audio recorded too loud will distort in the analog world, and will simply \"brick wall\" in digital terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e6bfd0-5dd2-3221-9404-9ae8ee18b474",
                                        "entry_id": "cda1e493-0610-31bc-a827-8335df4f1638",
                                        "glosses": [
                                            "To halt or limit abruptly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93141fe-b20a-4569-99a7-458d09a7608b",
                                                "sense_id": "09e6bfd0-5dd2-3221-9404-9ae8ee18b474",
                                                "text": "The driver stopped the cab on the spot, brick-walled it then and there."
                                            },
                                            {
                                                "example_id": "e02adf74-f341-40d5-b51e-a83c29318946",
                                                "sense_id": "09e6bfd0-5dd2-3221-9404-9ae8ee18b474",
                                                "text": "Baseball's unstoppable force -- the 2017 Los Angeles Dodgers -- ran smack into peak-form Verlander, who brick-walled their six-game winning streak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0914eb62-d081-38da-a1a4-109566aa3e89",
                                        "entry_id": "cda1e493-0610-31bc-a827-8335df4f1638",
                                        "glosses": [
                                            "To be uncooperative and unresponsive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecca503-dbd4-494a-8b70-a4ed483e0817",
                                                "sense_id": "0914eb62-d081-38da-a1a4-109566aa3e89",
                                                "text": "They wanted to know how successful the attack had been. But you brick-walled them."
                                            },
                                            {
                                                "example_id": "22fdc4f9-5696-438d-bd85-c8f67aad612c",
                                                "sense_id": "0914eb62-d081-38da-a1a4-109566aa3e89",
                                                "text": "My rapid dial wouldn't work, and when I was finally able to get a Homeland Security office phone number to reach you, the receptionist brick walled me."
                                            },
                                            {
                                                "example_id": "dd32d57b-c62e-4a46-8dc9-4032035ac5ed",
                                                "sense_id": "0914eb62-d081-38da-a1a4-109566aa3e89",
                                                "text": "But he'd brick-walled her on something that obviously caused him pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
