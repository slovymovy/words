                                "target_senses": [
                                    {
                                        "sense_id": "3107dbf5-5fa0-3f1b-bbad-67090cc7d31c",
                                        "entry_id": "dcd80f97-393e-38bd-a8ab-1b4433ecdbde",
                                        "glosses": [
                                            "Pertaining to the asp or aspen tree."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db635135-3433-3c25-8f32-ed14168dd70d",
                                        "entry_id": "dcd80f97-393e-38bd-a8ab-1b4433ecdbde",
                                        "glosses": [
                                            "Tremulous, trembling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30fdcdd7-b4cf-4470-a3ff-a91af78a9022",
                                                "sense_id": "db635135-3433-3c25-8f32-ed14168dd70d",
                                                "text": "And then poore Aspen wretch, neglected thou / Bath'd in a cold quicksilver sweat wilt lye / A veryer ghost than I […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7638aad3-59ae-37c1-8753-7d4164dea14a",
                                        "entry_id": "dcd80f97-393e-38bd-a8ab-1b4433ecdbde",
                                        "glosses": [
                                            "Of a woman's tongue: wagging, gossiping."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aspen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                                        "entry_id": "3c8f6fff-eabc-32b3-89f5-771895e7ce75",
                                        "glosses": [
                                            "A poplar tree, especially of section Populus sect. Populus, of medium-size trees with thin, straight trunks of a greenish-white color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3bb04f-99e9-4f6e-a0dc-b7a2c8fe211c",
                                                "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                                                "text": "Above a certain elevation, the aspens gave way to scrubby, gnarled pines."
                                            },
                                            {
                                                "example_id": "e0db1fad-dfc7-4e4e-ae32-c6c06fee9919",
                                                "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                                                "text": "ſtaggering like a quiuering Aſpen leafe,\nFearing the force of Boreas boiſtrous blaſts."
                                            },
                                            {
                                                "example_id": "c002f73d-ac04-4be5-85cd-a2eed8a75a43",
                                                "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                                                "text": "Instead there were the white of aspens, streaks of branch and slender trunk glistening from the green of leaves[…]."
                                            },
                                            {
                                                "example_id": "d0cd7bb7-07e8-44f8-b723-524bdc80e5f2",
                                                "sense_id": "760c9b85-54f1-3234-808f-83ecd2919436",
                                                "text": "The beloved aspen forests that shimmer across mountainsides of the American West could be doomed if emissions of greenhouse gases continue at a high level, scientists warned on Monday. […] The new paper analyzed the drought and heat that killed millions of aspens in Colorado and nearby states a decade ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "302f6197-8583-34fa-8739-33d3fb1e47b7",
                                        "entry_id": "3c8f6fff-eabc-32b3-89f5-771895e7ce75",
                                        "glosses": [
                                            "The wood of such a tree; usually pale, lightweight and soft."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51498842-a44c-49fc-b0dc-aec4ad2e0a95",
                                                "sense_id": "302f6197-8583-34fa-8739-33d3fb1e47b7",
                                                "text": "She claimed that aspen was the only \"proper\" material from which to make a wicker basket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a399197a-79af-4380-b9b4-765ac2b6de2f",
                        "source_entry_id": "598b311a-488f-3f50-8f64-80f00518eb99",
