                ],
                "senses": [
                    {
                        "sense_id": "57d88b2d-9f34-37e4-a6f1-f5f19d0a29ad",
                        "entry_id": "a6404eea-9806-33f1-a4f5-715840c7f2ab",
                        "glosses": [
                            "Erlaubnis, die mit Einschränkungen verbunden ist oder nur eingeschränkt erteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6781f3f-bff9-40b9-91e8-2063d9093777",
                                "sense_id": "57d88b2d-9f34-37e4-a6f1-f5f19d0a29ad",
                                "text": "„Folgende Fahrzeuge können abweichend von den Abs. 1 und 3 anstelle von Topplicht (Buglicht), Seitenlichtern und Hecklicht ein weißes Rundumlicht führen: […] c) Vergnügungsfahrzeuge und Fahrzeuge der Berufsfischer mit Zulassungsbeschränkung für die Strecke zwischen Stein am Rhein (Brücke) und Schaffhausen, deren Maschinenleistung nicht mehr als 30 kW beträgt.“"
                            },
                            {
                                "example_id": "0908a3c2-7d08-43ee-bc7d-86e787ae7ccc",
                                "sense_id": "57d88b2d-9f34-37e4-a6f1-f5f19d0a29ad",
                                "text": "„Vereinzelt mögliche, wirtschaftlich ganz unvernünftige Entschlüsse von Apothekern dürfe der Gesetzgeber nicht zur Grundlage einer generellen Zulassungsbeschränkung machen.“"
                            },
                            {
                                "example_id": "5fc4c031-8879-4df1-989c-86c92d63ba1f",
                                "sense_id": "57d88b2d-9f34-37e4-a6f1-f5f19d0a29ad",
                                "text": "„Also für Studien, bei denen es in Österreich auch Zulassungsbeschränkungen gibt.“"
                            },
                            {
                                "example_id": "9f931aa9-3a40-487d-ba45-9c93d17e6d88",
                                "sense_id": "57d88b2d-9f34-37e4-a6f1-f5f19d0a29ad",
                                "text": "„Für alle Sportler gelten strikte Zulassungsbeschränkungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
