                "senses": [
                    {
                        "sense_id": "5e9adb70-c3ae-3263-bb8f-4a8783e33163",
                        "entry_id": "d4ca6011-4ff8-33ba-b1b7-214aab5605e5",
                        "glosses": [
                            "suche odchody ptaków morskich lub nietoperzy, stosowane jako nawóz"
                        ],
                        "tags": [],
