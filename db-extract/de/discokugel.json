                "senses": [
                    {
                        "sense_id": "d05dbb0e-865d-3b25-9f74-4b224f53b55b",
                        "entry_id": "25e7aef1-2801-3653-a473-67ec792fab1a",
                        "glosses": [
                            "rotierender, mit kleinen Spiegelplatten beklebter Ball, der meist als Lichteffekt in Diskotheken verwendet, indem er mit einem Punktstrahler beleuchtet wird und Punkte in den Raum reflektiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0287cf5-1c89-445b-a9bb-aba5a01fcab5",
                                "sense_id": "d05dbb0e-865d-3b25-9f74-4b224f53b55b",
                                "text": "Die Discokugel erzielt einen lustigen Lichteffekt."
                            },
                            {
                                "example_id": "b4dd55e7-32b6-4660-9b35-5a8902bc6b59",
                                "sense_id": "d05dbb0e-865d-3b25-9f74-4b224f53b55b",
                                "text": "„Dazu bewegten sich eine Tänzerin und ein Tänzer, beide mit Stiermasken, wie man sich einst bewegte in den Achtzigern unter der Discokugel.“"
                            },
                            {
                                "example_id": "63a5983e-ea2b-460a-8c17-149aa2fdd44f",
                                "sense_id": "d05dbb0e-865d-3b25-9f74-4b224f53b55b",
                                "text": "„Die Discokugel zählt zu den Ikonen der Clubkultur, wie kein anderes Interieur symbolisiert sie den Hedonismus der Disco-Ära.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
