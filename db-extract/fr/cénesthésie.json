                ],
                "senses": [
                    {
                        "sense_id": "79077b5e-a5d8-3023-a9e6-d412790270ef",
                        "entry_id": "84d06c32-b4fa-3d68-8971-7184bde2c4f7",
                        "glosses": [
                            "Impression générale d’aise ou de malaise, résultant d’un ensemble de sensations provenant du corps à l’exclusion des données des appareils sensoriels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec2fb0f-a105-4f71-9540-70eb5b62e649",
                                "sense_id": "79077b5e-a5d8-3023-a9e6-d412790270ef",
                                "text": "Ces divers accès, conséquences d’une cénesthésie par trop cultivée, s’étaient évanouis tout d’un coup sous l’effet de la nécessité."
                            },
                            {
                                "example_id": "70741cc8-924c-4308-a934-413feda8dd93",
                                "sense_id": "79077b5e-a5d8-3023-a9e6-d412790270ef",
                                "text": "Je n’ai pas de cou. Je me suis souvent demandé, dans une nocturne cénesthésie anticipatrice du pire, où le couperet, pour m’étêter proprement, devrait s’abattre."
                            },
                            {
                                "example_id": "34cb3421-638f-4417-9cf7-ea8c4539d70c",
                                "sense_id": "79077b5e-a5d8-3023-a9e6-d412790270ef",
                                "text": "L'association synesthésique, avec ses perceptions simultanées, peut être ressentie sur un mode parfois vague, reposant sur la conscience obscure que nous avons de l'ensemble de nos sensations (la cénesthésie). Elle est néanmoins la règle générale."
                            }
                        ]
                    }
                ],
