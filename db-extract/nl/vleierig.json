                "senses": [
                    {
                        "sense_id": "a6bb0e2c-3b7b-3322-81fb-b86174da8f79",
                        "entry_id": "70d67eaf-7b91-3648-b6df-0d3f59e3d890",
                        "glosses": [
                            "vriendelijk en onderdanig"
