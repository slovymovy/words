                                "example_id": "306dde22-8860-43d0-8a4a-b1a789af2e13",
                                "sense_id": "2bd42ecb-dc24-3748-aa7b-372ea72ee137",
                                "text": "Będą one zawierać komunikaty o wpływie pogody na samopoczucie, wiadomości dla alergików, sercowców, informacje dla żeglarzy czy narciarzy, ciekawostki pogodowe i oczywiście prognozę pogody"
                            },
                            {
                                "example_id": "108ff001-dee6-41dd-b80c-81609abef4bf",
                                "sense_id": "2bd42ecb-dc24-3748-aa7b-372ea72ee137",
                                "text": "Źle wysoką temperaturę znoszą sercowcy, osoby starsze, ale też ludzie ogólnie wyczuleni na zmiany klimatyczne"
                            }
                        ],
