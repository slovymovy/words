                                        "examples": [
                                            {
                                                "example_id": "045b2ea7-5043-4627-a96f-b798193dc38d",
                                                "sense_id": "6ab2bc9c-a12d-3569-bd83-1ee4dc7707b3",
                                                "text": "The main guest on the show just kept plugging his latest movie: it got so tiresome."
                                            },
