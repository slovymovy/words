                "senses": [
                    {
                        "sense_id": "a24689ab-8d56-3899-9bb4-47b74b974c27",
                        "entry_id": "9c976416-68ee-3a9e-a0aa-4d05c25bb7f0",
                        "glosses": [
                            "Biscuit sec de forme rectangulaire ou carrée et à bords dentelés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afb7dce-34c2-4e24-971c-6c2d14ec2886",
                                "sense_id": "a24689ab-8d56-3899-9bb4-47b74b974c27",
                                "text": "Des célébrités comme Sarah Bernhardt, Anatole France, Sacha Guitry, Alphonse Mucha, Sempé ou Fernandel ont contribué à la notoriété de la marque LU et de son « véritable petit-beurre »."
                            },
                            {
                                "example_id": "4281c3ff-0aa3-40c6-8f6b-5610fc5cc089",
                                "sense_id": "a24689ab-8d56-3899-9bb4-47b74b974c27",
                                "text": "Impatient de connaître ces premières nouvelles, Lepage se dépêcha de ramasser les vivres qu’il destinait à Chalumot, et les quatre petits-beurre ramollis de leur dessert."
                            },
                            {
                                "example_id": "7d2374d7-09fd-4b3a-9c16-e715f451055a",
                                "sense_id": "a24689ab-8d56-3899-9bb4-47b74b974c27",
                                "text": "Je posai à côté de moi une bouteille Thermos pleine de café et une boîte de petits-beurre ; la voix de M. Lalande annonça : « Liberté et contingence » ; les regards scrutèrent le plafond, les stylos se mirent à bouger ; je couvris des pages et j’eus l’impression que ça avait bien marché."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0edb3931-50cd-42df-955b-0d58ad473a77",
                        "source_entry_id": "9c976416-68ee-3a9e-a0aa-4d05c25bb7f0",
                        "source_sense_id": "a24689ab-8d56-3899-9bb4-47b74b974c27",
                        "target_lang_word": "Butterkeks",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Butterkeks",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                        "entry_id": "62e507e5-9ae2-3012-bd49-f65c65b39233",
                                        "glosses": [
                                            "ein aus Weizenmehl mit einem hohen Butteranteil hergestelltes Gebäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b22a26-cf2f-440b-a819-5773c19500e7",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "Zum Teil mit Schokoladenglasur überzogene Butterkekse sind lecker."
                                            },
                                            {
                                                "example_id": "13ff0355-3c0b-45fc-a642-b6c662fa7096",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Nach dem Diebstahl eines überdimensionierten Metall-Butterkekses von der Bahlsen-Firmenzentrale in Hannover ist am Dienstag ein kurioses Erpresserschreiben aufgetaucht - unterzeichnet mit \"Krümelmonster\".“"
                                            },
                                            {
                                                "example_id": "58f0fef5-f58b-45ce-9327-32afe1c84e15",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Butterkeks enthält auf 100 Teile Getreideerzeugnisse mindestens 10 Teile Butter (oder entsprechende Mengen Butterreinfett oder Butterfett).“"
                                            },
                                            {
                                                "example_id": "e5e38611-b512-426a-96e3-d3ae24af2f09",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Val kochte Tee und füllte einen Teller mit Butterkeksen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
