                        "examples": [
                            {
                                "example_id": "1eb1a6eb-2363-42d5-8fc4-6d3a90b42da5",
                                "sense_id": "0d658aaf-0bb8-3d44-964b-d002aab62b26",
                                "text": "Kensington heeft dit jaar met Control het beste album uitgebracht en is bovendien de beste podiumact."
                            },
                            {
                                "example_id": "7464f1de-d6bd-44c0-b6c7-a4c530f7035a",
                                "sense_id": "0d658aaf-0bb8-3d44-964b-d002aab62b26",
                                "text": "'Ze hebben fantastische stemmen, goeie muziek en een uitstekende podiumact met een prima regie. Het is een goed jong koppel, zei de oude baas', aldus Will Luikinga (70) Hij is de schrijver van de tekst van Ding-a-dong, het liedje waarmee Nederland in 1975 voor de laatste keer de eerste plaats behaalde bij het Eurovisiesongfestival."
                            },
                            {
                                "example_id": "ee44b698-86db-4c5d-bf3f-d1ab5a4da987",
                                "sense_id": "0d658aaf-0bb8-3d44-964b-d002aab62b26",
                                "text": "Liberace werd als pianist ook beschimpt door critici en zijn praalzucht en kitscherige podiumact lokken onverminderd hoongelach uit, maar Soderbergh en LaGravenese slagen er uitstekend in de balans tussen empathie en ironie te bewaren."
                            },
                            {
                                "example_id": "a9315508-d4f7-45dc-88a6-ea326201a28f",
                                "sense_id": "0d658aaf-0bb8-3d44-964b-d002aab62b26",
                                "text": "Festival Down The Rabbit Hole Deze vierde DTRH bood een mooie doorsnee van prima podiumacts. Hoogtepunten: My Baby, Benjamin Clementine en de elektronica van Sohn en Moderat."
                            }
                        ]
                    }
