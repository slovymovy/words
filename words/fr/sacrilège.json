{
    "word_family": [
        "sacrilégement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de078313-04da-3c46-a8c7-3b6b0a45c47d",
                    "sense_definition": "Profanation délibérée d'une chose, d'un lieu ou d'une personne sacrée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voler les objets du culte dans ce sanctuaire ancien constitue un véritable <w>sacrilège</w>."
                        },
                        {
                            "text": "Les pillages répétés dans la chapelle ont été vécus par les fidèles comme un odieux <w>sacrilège</w>."
                        }
                    ],
                    "synonyms": [
                        "profanation",
                        "blasphème"
                    ],
                    "antonyms": [
                        "vénération",
                        "dévotion"
                    ],
                    "common_phrases": [
                        "commettre un sacrilège"
                    ]
                },
                {
                    "sense_id": "a4732130-0724-3cb4-bed8-0b7d7a0405de",
                    "sense_definition": "Action qui enfreint gravement une tradition respectée, une règle esthétique ou un principe établi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour les puristes, ajouter de la crème dans cette recette traditionnelle est un véritable <w>sacrilège</w>."
                        },
                        {
                            "text": "Repeindre cette commode ancienne du dix-huitième siècle a fait crier au <w>sacrilège</w> tous les antiquaires."
                        }
                    ],
                    "synonyms": [
                        "hérésie"
                    ],
                    "common_phrases": [
                        "véritable sacrilège",
                        "crier au sacrilège"
                    ]
                },
                {
                    "sense_id": "84130a52-c3fc-361b-91ee-8f8636fc470e",
                    "sense_definition": "Personne qui commet un sacrilège, qui profane ce qui est saint.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a condamné cet homme en le désignant comme un <w>sacrilège</w> dangereux."
                        },
                        {
                            "text": "L'auteur a été traité de <w>sacrilège</w> après avoir publiquement tourné en dérision les textes sacrés."
                        }
                    ],
                    "synonyms": [
                        "profanateur"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e3620a4-b7ea-3ca4-afe0-0370522bff59",
                    "sense_definition": "Qui constitue une profanation ou viole le respect dû aux choses saintes ou respectées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere_sacrilege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vandales ont crié des paroles <w>sacrilèges</w> avant de renverser les statues."
                        },
                        {
                            "text": "Il a osé poser un acte <w>sacrilège</w> en détruisant ce manuscrit inestimable."
                        }
                    ],
                    "synonyms": [
                        "blasphématoire",
                        "profanateur"
                    ],
                    "antonyms": [
                        "pieux",
                        "respectueux"
                    ],
                    "common_phrases": [
                        "acte sacrilège",
                        "paroles sacrilèges"
                    ]
                },
                {
                    "sense_id": "5e22bd1a-4c84-3dc2-8c1a-b58b5674cbfc",
                    "sense_definition": "Qui se rend coupable d'une profanation, en parlant d'un être humain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caractere_sacrilege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des mains <w>sacrilèges</w> ont dérobé les précieuses reliques conservées derrière l'autel."
                        },
                        {
                            "text": "Le roi <w>sacrilège</w> s'est emparé des trésors de l'abbaye pour financer sa guerre."
                        }
                    ],
                    "synonyms": [
                        "profanateur"
                    ],
                    "antonyms": [
                        "dévot"
                    ],
                    "common_phrases": [
                        "mains sacrilèges"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "50a7c6b1-16e9-3bfe-acdb-8f18384fdbd9",
                    "sense_definition": "Exclamation exprimant la réprobation outrée face à un manquement aux règles ou aux convenances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Couper les spaghettis avec un couteau devant des invités, quel <w>sacrilège</w> !"
                        },
                        {
                            "text": "Il a jeté ces livres rares à la poubelle : <w>sacrilège</w> !"
                        }
                    ]
                }
            ]
        }
    ]
}