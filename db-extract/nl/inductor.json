                    {
                        "sense_id": "a36e7d19-44fe-374b-b120-9314903629e0",
                        "entry_id": "ec44ce7d-eeb9-3612-a204-0d25b458c28b",
                        "glosses": [
                            "wikkeling van stroomdraad die leidt tot een wisselwerking tussen elektrische stroom en een magnetisch veld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539aa275-d47d-4e80-938f-95e2eac7935e",
                                "sense_id": "a36e7d19-44fe-374b-b120-9314903629e0",
                                "text": "Elke inductor heeft bepaalde speciale eigenschappen waardoor hij nuttig is in een elektronische schakeling."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b3f1bbf-e202-3872-874a-47e6fb2754a4",
                        "entry_id": "ec44ce7d-eeb9-3612-a204-0d25b458c28b",
                        "glosses": [
                            "apparaat waarin twee spoelen worden gebruikt om hoge spanningen op te wekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02068f6-b8a1-4750-a882-6751074119fe",
                                "sense_id": "6b3f1bbf-e202-3872-874a-47e6fb2754a4",
                                "text": "Daar nog een schroefje in, die draden moeten wat verder uit elkaar, zouden er nergens windingen losgeraakt zijn, vooruit jongens, laten we de boel nog even goed nakijken anders slaat het zaakje zo dadelijk kapot.... Na een zorgvuldige inspectie werd de inductor met vijf in serie geschakelde accu's verbonden en kon het proefstomen beginnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "57a50384-ade8-3e8f-9c76-5b08543ad00d",
                        "entry_id": "ec44ce7d-eeb9-3612-a204-0d25b458c28b",
                        "glosses": [
                            "stof die het aflezen van de genetische informatie beïnvloedt en er zo voor zorgt dat lichaamscellen zich in een bepaalde richting ontwikkelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ea1a4b-24ee-47aa-8587-5d9e9a2299ab",
                                "sense_id": "57a50384-ade8-3e8f-9c76-5b08543ad00d",
                                "text": "Zonder inductor verhindert de repressor aflezing van het operon; de inductor verhindert, indien toegevoegd, op zijn beurt de repressor de aflezing te blokkeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff4d4b30-5ab9-3497-9f03-d6a2f416b475",
                        "entry_id": "ec44ce7d-eeb9-3612-a204-0d25b458c28b",
                        "glosses": [
                            "specifiek voorwerp of situatie dat bij iemand bepaalde gedachten of mentale vermogens oproept"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72703529-2aef-4bc6-93a1-29da2e39596c",
                                "sense_id": "ff4d4b30-5ab9-3497-9f03-d6a2f416b475",
                                "text": "Diverse paragnosten kregen verder ook de indruk van een bunker. (…) De politie, die samenwerkte met het instituut, heeft deze mensen verder nooit iets gevraagd. Men heeft deze mensen nooit in de gelegenheid gesteld om de gegevens via een duidelijke inductor (persoonlijk iets) van Heijn of van de familie van Heijn uit te werken."
                            }
                        ]
                    }
