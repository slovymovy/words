                ],
                "senses": [
                    {
                        "sense_id": "731e430a-8432-3907-aecf-a5137f3d34fd",
                        "entry_id": "bf992ed6-8a85-3c45-9de7-5cc1a8636e27",
                        "glosses": [
                            "Unterricht, der jemandem das Klavierspielen vermitteln soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e2e9e5-4ce3-42d5-862a-d30ee1236c86",
                                "sense_id": "731e430a-8432-3907-aecf-a5137f3d34fd",
                                "text": "„Renate war schon zum Klavierunterricht angemeldet.“"
                            },
                            {
                                "example_id": "3401bf70-1fa7-4033-b585-7cb470c6bfca",
                                "sense_id": "731e430a-8432-3907-aecf-a5137f3d34fd",
                                "text": "„Wenigstens gelang es ihr, täglich einige Stunden Klavierunterricht zu geben.“"
                            },
                            {
                                "example_id": "4f8a5960-1bf7-4a4c-8c3c-82982e107aff",
                                "sense_id": "731e430a-8432-3907-aecf-a5137f3d34fd",
                                "text": "„Der Klavierunterricht war ein Geschenk, das ich mir zum fünfundsechzigsten Geburtstag dafür gemacht habe, dass ich endlich über Consuela hinweggekommen war.“"
                            },
                            {
                                "example_id": "d9b4260d-ef91-4e2c-84d4-017288a21376",
                                "sense_id": "731e430a-8432-3907-aecf-a5137f3d34fd",
                                "text": "„Seine Eltern schickten ihn zum Klavierunterricht, [Anm.: Shai] Maestro erhielt eine klassische Ausbildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
