                        "examples": [
                            {
                                "example_id": "dd24c779-085b-4185-8e76-02bed47a0179",
                                "sense_id": "b8dca815-1a95-33c8-8b5d-0059c25ff1d0",
                                "text": "„Die Vortragszeit beträgt insgesamt bis zu 15 Minuten in normaler Redegeschwindigkeit.“"
                            },
                            {
                                "example_id": "a16e2305-54ef-4234-b15f-3e5d070f03fa",
                                "sense_id": "b8dca815-1a95-33c8-8b5d-0059c25ff1d0",
                                "text": "„Mit zunehmendem Alter steigern die Kinder außer ihrem Wortschatz auch ihre Redegeschwindigkeit.“"
                            },
                            {
                                "example_id": "4e730676-df2f-43ef-8708-0c30bfee6fbb",
                                "sense_id": "b8dca815-1a95-33c8-8b5d-0059c25ff1d0",
                                "text": "„Dem Unterricht folgen zu wollen war bei normaler Redegeschwindigkeit zwecklos.“"
                            }
                        ],
