                "senses": [
                    {
                        "sense_id": "ef4d70e6-7238-35fd-adb2-abc7e50aca64",
                        "entry_id": "610e93a9-ada3-37c7-8a0d-8af569dacd4b",
                        "glosses": [
                            "Transformer un composé chimique pour y faire apparaître un groupement (NO₂) unique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7162e617-c298-41fa-bd5b-536f3886f273",
                                "sense_id": "ef4d70e6-7238-35fd-adb2-abc7e50aca64",
                                "text": "'On n'emploie que la moitié de l'agent de nitration nécessaire pour mononitrer; — (Comptes rendus hebdomadaires des séances de l'Académie des sciences, 1942)"
                            },
                            {
                                "example_id": "e4cef5a7-40af-4b9f-9854-a85c30fe54a2",
                                "sense_id": "ef4d70e6-7238-35fd-adb2-abc7e50aca64",
                                "text": "'(...) par contre, est mononitré instantanément par l'acide nitrique de densité 1,49 à 50, et la solution nitrique doit être immédiatement jetée sur de la glace si l'on veut éviter la formation quantitative du dérivé (...) — (Annales de chimie, 1957)"
                            }
                        ]
                    }
