                "senses": [
                    {
                        "sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                        "entry_id": "76a2ace8-3302-3e30-89de-11c7c1422554",
                        "glosses": [
                            "een eenheid van warmte, gelijk aan de warmte benodigd om een gram water een graad (kelvin of Celsius) in temperatuur te doen stijgen, weergegeven met symbool cal"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e13d2dc1-7699-463f-802b-1265500c79ef",
                                "sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                                "text": "Later bleek een calorie aan warmte overeen te komen met 4,2 joules aan arbeid en werd de eenheid overbodig."
                            },
                            {
                                "example_id": "557110a0-12b2-45c6-b625-b2310adf9dd9",
                                "sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                                "text": "Ik moet van de diëtiste alle calorieën tellen die ik opeet."
                            },
                            {
                                "example_id": "bc518ab6-8783-408e-a2cb-fc7ecfb10165",
                                "sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                                "text": "Ze hadden een ontbijt voor me klaargezet dat ik snel en zo stil mogelijk opat. Eigenlijk had ik totaal geen honger, maar het was noodzakelijk zo veel mogelijk calorieën binnen te krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "161ae8c9-24f1-4240-9726-58e13d2dda46",
                        "source_entry_id": "76a2ace8-3302-3e30-89de-11c7c1422554",
                        "source_sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                        "source_sense_description": "een eenheid van warmte, gelijk aan de warmte benodigd om een gram water een graad C in temperatuur te doen stijgen",
                        "target_lang_word": "Kalorie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ffbfa65-7276-39e7-9216-a94a3830225b",
                                        "entry_id": "fb590db3-52ed-36c8-804a-d6a2b3c00a2e",
                                        "glosses": [
                                            "Wärmemenge, die nötig ist, um die Temperatur von einem Gramm Wasser (unter bestimmten Bedingungen) um ein Grad Celsius zu erhöhen (etwa 4,2 Joule)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "623634e9-55c6-42da-9a1b-f0cd460fbcc3",
                                                "sense_id": "4ffbfa65-7276-39e7-9216-a94a3830225b",
                                                "text": "In der Physik misst man nicht mehr in Kalorien, sondern in Joule."
                                            },
                                            {
                                                "example_id": "b55e326b-6664-4346-8656-a894c7df0f9b",
                                                "sense_id": "4ffbfa65-7276-39e7-9216-a94a3830225b",
                                                "text": "Nahrungsmittelproduzenten geben den Brennwert oft zusätzlich in der Einheit Kilokalorie an, die dem Tausendfachen einer Kalorie entspricht."
                                            },
                                            {
                                                "example_id": "6e3a2d4c-f5a9-49d2-8cef-2d466740d03f",
                                                "sense_id": "4ffbfa65-7276-39e7-9216-a94a3830225b",
                                                "text": "Meine Oma kocht so lecker, das ist mir jede Kalorie wert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ddfd1278-b277-30d9-a256-2ef20e7e5418",
                                        "entry_id": "fb590db3-52ed-36c8-804a-d6a2b3c00a2e",
                                        "glosses": [
                                            "Wärmemenge, die nötig ist, um die Temperatur von einem Kilogramm Wasser (unter bestimmten Bedingungen) um ein Grad Celsius zu erhöhen (1000 Kalorien_([1]))"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b4b1fa-eb95-497c-b897-8a9e322ff3c6",
                                                "sense_id": "ddfd1278-b277-30d9-a256-2ef20e7e5418",
                                                "text": "Der Müsliriegel hat 231 Kalorien."
                                            },
                                            {
                                                "example_id": "d214fb4e-969c-40ec-ac07-679260c86ffb",
                                                "sense_id": "ddfd1278-b277-30d9-a256-2ef20e7e5418",
                                                "text": "„Die tägliche Ration des Normalverbrauchers belief sich auf 1200 Kalorien.“"
                                            },
                                            {
                                                "example_id": "93b54a29-2867-452c-8a37-9f8549f71501",
                                                "sense_id": "ddfd1278-b277-30d9-a256-2ef20e7e5418",
                                                "text": "„Gott gab den Menschen mageres Rindfleisch, mit dem sie weniger Kalorien zu sich nahmen und doch ihren Appetit stillen konnten.“"
                                            },
                                            {
                                                "example_id": "7164418c-c7a5-445e-b6eb-50149713e5cf",
                                                "sense_id": "ddfd1278-b277-30d9-a256-2ef20e7e5418",
                                                "text": "„Nur 800 Kalorien konnten im Juni 1946 im Ruhrgebiet an »Normalverbraucher« ausgegeben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "643555cc-e384-459c-92da-8c1036339486",
                        "source_entry_id": "76a2ace8-3302-3e30-89de-11c7c1422554",
                        "source_sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                        "source_sense_description": "een eenheid van warmte, gelijk aan de warmte benodigd om een gram water een graad C in temperatuur te doen stijgen",
                        "target_lang_word": "calorie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calorie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6885bdff-a15c-3e47-97bb-ca6c395fce63",
                                        "entry_id": "2b61d0ac-38c1-3bc3-a667-cacfde7ecedc",
                                        "glosses": [
                                            "A non-SI unit of energy, equivalent to 4.184 kilojoules, that can raise the temperature of a kilogram of water by one degree Celsius. This is the unit normally used in food labeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "983beb87-0593-4309-96bc-268add7d0386",
                                                "sense_id": "6885bdff-a15c-3e47-97bb-ca6c395fce63",
                                                "text": "Holonyms: megacalorie < gigacalorie"
                                            },
                                            {
                                                "example_id": "f2d1b115-7f36-42c1-b60b-fe76605d2574",
                                                "sense_id": "6885bdff-a15c-3e47-97bb-ca6c395fce63",
                                                "text": "Meronyms: calorie (small-calorie sense), small calorie, gram calorie, thermochemical calorie"
                                            },
                                            {
                                                "example_id": "30b27247-2f83-4f76-b87b-b298330bb29d",
                                                "sense_id": "6885bdff-a15c-3e47-97bb-ca6c395fce63",
                                                "text": "Biotics possess extraordinary abilities, but they must live with minor inconveniences. The most obvious issue is getting adequate nutrition. Creating biotic mass effects takes such a toll on metabolism that active biotics develop ravenous appetites. The standard Alliance combat ration for a soldier is 3000 calories per day; biotics are given 4500, as well as a canteen of potent energy drink for quick refreshment after hard combat."
                                            },
                                            {
                                                "example_id": "b2d6f842-2808-4787-a299-f6b734c7d418",
                                                "sense_id": "6885bdff-a15c-3e47-97bb-ca6c395fce63",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48181e09-8a90-3dd7-86c2-9f015814e8cc",
                                        "entry_id": "2b61d0ac-38c1-3bc3-a667-cacfde7ecedc",
                                        "glosses": [
                                            "A non-SI unit of energy, equivalent to 4.184 joules, that can raise the temperature of a gram of water by one degree Celsius. This unit was formerly widely used in chemistry and physics."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57922d11-ca3a-4675-ab70-15e4ad3fd77d",
                                                "sense_id": "48181e09-8a90-3dd7-86c2-9f015814e8cc",
                                                "text": "Holonyms: kilocalorie, calorie (large-calorie sense), large calorie, Calorie (capital C) < megacalorie < gigacalorie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "604861de-e474-4fc6-aac9-14d6bf1625ec",
                        "source_entry_id": "76a2ace8-3302-3e30-89de-11c7c1422554",
                        "source_sense_id": "0557757a-30c3-3cc1-af7c-c4f1a4a64e55",
                        "source_sense_description": "een eenheid van warmte, gelijk aan de warmte benodigd om een gram water een graad C in temperatuur te doen stijgen",
                        "target_lang_word": "calorie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calorie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e294ef-5138-3ab1-994f-a736c4f430cc",
                                        "entry_id": "daa3cc32-75fd-3baa-aad5-b4cb97e22dd8",
                                        "glosses": [
                                            "Unité de mesure historiquement définie comme la quantité de chaleur nécessaire pour élever de 1 °C la température de 1 gramme d’eau. Environ 4,2 joules. Il y a plusieurs définitions précises. Petite calorie. Le symbole : cal."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b031be-3fb2-43c9-8108-7380c03316a8",
                                                "sense_id": "b5e294ef-5138-3ab1-994f-a736c4f430cc",
                                                "text": "Dans un but d'unification, la tendance actuelle est d'abandonner la calorie et de n'employer que l'unité internationale d'énergie, le joule, ou plutôt, le kilojoule (kj ), mieux adapté à l'ordre de grandeur des phénomènes étudiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c79e666-c230-3b9f-8825-a27a03736002",
                                        "entry_id": "daa3cc32-75fd-3baa-aad5-b4cb97e22dd8",
                                        "glosses": [
                                            "Unité de mesure historiquement définie comme la quantité de chaleur nécessaire pour élever de 1 °C la température de 1 kilogramme d’eau, donc mille fois la définition précédente. Environ 4,2 kilojoules. Grande calorie. Le symbole : Cal."
                                        ],
                                        "tags": [
                                            "Diététique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797a24b8-c7b1-403b-b258-fad8c1d9617b",
                                                "sense_id": "7c79e666-c230-3b9f-8825-a27a03736002",
                                                "text": "La culture traditionnelle du riz aux Philippines produisait seize calories digestibles pour une calorie apportée. Dans son ensemble, l'agriculture traditionnelle fournit entre cinq et cinquante calories alimentaires à partir d'une seule calorie investie."
                                            },
                                            {
                                                "example_id": "afed1614-d6a8-4643-a636-ccf59caba517",
                                                "sense_id": "7c79e666-c230-3b9f-8825-a27a03736002",
                                                "text": "On évalue ce pouvoir en déterminant le poids d'eau que le combustible amène à une certaine température, et l'on prend pour base d'évaluation la calorie, quantité de chaleur nécessaire pour élever la température d un kilogramme d'eau de un degré."
                                            },
                                            {
                                                "example_id": "c1d36599-fece-4f6e-a26d-67f7533085b9",
                                                "sense_id": "7c79e666-c230-3b9f-8825-a27a03736002",
                                                "text": "En effet, ces aliments sont très riches en calories car ils sont à la fois gras et sucrés : un pain au chocolat ou un croissant vous apportent plus de calories qu’une demi-baguette ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
