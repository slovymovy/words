                                    {
                                        "sense_id": "28f33b72-a520-3348-9e32-ec722c23c24b",
                                        "entry_id": "26098340-c633-3216-9970-e2e4820f0ea4",
                                        "glosses": [
                                            "rechtliche Annahme eines nicht leiblichen Kindes als eigenes Kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15aacf67-37bc-49fd-9454-8ae02de5bf6a",
                                                "sense_id": "28f33b72-a520-3348-9e32-ec722c23c24b",
                                                "text": "„Er war Anfang 20, als die Adoption durch seinen Onkel ihn in die Familienverantwortung zwang.“"
                                            },
                                            {
                                                "example_id": "a6bbe568-c16b-41b1-8652-3c73f8a3fc84",
                                                "sense_id": "28f33b72-a520-3348-9e32-ec722c23c24b",
                                                "text": "„Homosexuellen Paaren das Recht auf Adoption zu verweigern zeugt von einem Weltbild, nach dem eine gleichgeschlechtliche Beziehung immer noch ‚schlechter‘ sei als eine gegengeschlechtliche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c23cedb7-1497-453a-8fea-48ef28e0a749",
                        "source_entry_id": "1f59515c-6d0c-363c-8016-5fc9b43da511",
