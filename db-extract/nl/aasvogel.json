                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f8b4ec37-8e9e-4ace-84b5-aa53b3e192df",
                        "entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "tags": [
                            "plural"
                        ],
                        "form": "aasvogels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b9fcadb-c5e8-3c26-a35f-bbe38eae7a4e",
                        "entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "glosses": [
                            "vogel die leeft van dode dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4155aeec-9276-49e8-a7ff-c4984640a740",
                                "sense_id": "7b9fcadb-c5e8-3c26-a35f-bbe38eae7a4e",
                                "text": "Wanneer Jezus'lichaam enkele dagen later van het kruis wordt gehaald, hebben aasvogels zijn ogen en delen van zijn ingewanden uitgepikt. (Een verwijzing naar Prometheus, die zijn diefstal van het vuur uit de hemel moest bekopen met een straf waarbij dagelijks zijn lever door een adelaar werd opgegeten.) Van een wederopstanding in bijbelse zin is geen sprake, hooguit van visioenen of hallucinaties waarin Malchus en de zijnen Jezus zien optreden."
                            },
                            {
                                "example_id": "88c18438-98c7-47ca-9503-5cad412d4890",
                                "sense_id": "7b9fcadb-c5e8-3c26-a35f-bbe38eae7a4e",
                                "text": "‘Als we te lang op één plaats bleven, kregen de gieren belangstelling. Langer dan een uur in de zon slapen betekende gegarandeerd dat de aasvogels kwamen aanvliegen en we moesten voortdurend oplettend zijn om te voorkomen dat de vogels al naar ons begonnen te pikken terwijl we nog leefden.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "36e7beb3-eb44-31fc-883f-5f9f2d359361",
                        "entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "glosses": [
                            "iemand die profiteert van het leed van anderen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "168f03fa-f0bf-3180-ad31-ac9d78c7c44a",
                        "entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "glosses": [
                            "schelm, kwajongen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ead152bf-8c4c-4861-be3f-f176aab892e0",
                        "source_entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "source_sense_id": "7b9fcadb-c5e8-3c26-a35f-bbe38eae7a4e",
                        "target_lang_word": "carrion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carrion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "Rotting flesh of a dead animal or person."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1383b6-f9db-443b-b9d5-ce846d3e11f3",
                                                "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                                "text": "Vultures feed on carrion."
                                            },
                                            {
                                                "example_id": "02c9a913-a34d-43a5-bc2a-a706fc1dc415",
                                                "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                                "text": "[W]ee ſee by experience, that ſome [brute beasts] feedeth on yͤ graſſe in yͤ fyelds ſome liues in the ayre eating flyes, others vpon yͤ wormes in carin, others wͭ [with] that they fynd vnder the water."
                                            },
                                            {
                                                "example_id": "f7df84c6-9177-43d8-9e43-335bf1b5cd52",
                                                "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                                "text": "[W]hat disordered slippery decks of a whale-ship are comparable to the unspeakable carrion of those battle-fields from which so many soldiers return to drink in all ladies' plaudits?"
                                            },
                                            {
                                                "example_id": "e272eacb-ecb6-4379-93ca-e0247960d9db",
                                                "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                                "text": "He brought down with him to our haunted house a little cask of salt beef; for, he is always convinced that all salt beef not of his own pickling, is mere carrion, and invariably, when he goes to London, packs a piece in his portmanteau."
                                            },
                                            {
                                                "example_id": "38767e2c-03ca-48f9-b340-dda7da688e4b",
                                                "sense_id": "7b8bacec-df63-3af5-813f-306eb9480de7",
                                                "text": "And the butterflies are flaunting across the rides in the Forest. Perhaps the Purple Emperor is feasting, as Morris says, upon a mass of putrid carrion at the base of an oak tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0d021a8-734b-3049-82ce-af260251419b",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "Corrupt or horrid matter."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec7df6f-93eb-46b4-8f00-3593453b2b0a",
                                                "sense_id": "c0d021a8-734b-3049-82ce-af260251419b",
                                                "text": "[T]here are melancholy sceptics with a taste for carrion who batten on the hideous facts in history,—persecutions, inquisitions, St. Bartholomew massacres, devilish lives, […]"
                                            },
                                            {
                                                "example_id": "a4f78a0a-480e-43e9-871a-3572e8ae0399",
                                                "sense_id": "c0d021a8-734b-3049-82ce-af260251419b",
                                                "text": "Roman fashionable society hated Cæsar, and any carrion was welcome to them which would taint his reputation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378f9602-3b46-38fb-9563-91464eb7cf5a",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "Filth, garbage."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57ccc307-3231-30d1-86f9-e15c94091712",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "The flesh of a living human body; also (Christianity), sinful human nature."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e348d20-eb9d-4640-905a-a447827e3a0e",
                                                "sense_id": "57ccc307-3231-30d1-86f9-e15c94091712",
                                                "text": "Shy[lock]. My ovvne fleſh and blood to rebell. / Salan[io]. Out vpon it old carrion, rebels it as theſe yeares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0596d44d-8346-37e7-838d-9d92a590fbb6",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "A dead body; a carcass, a corpse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d3005e-34ab-4615-9dcf-6659f781644c",
                                                "sense_id": "0596d44d-8346-37e7-838d-9d92a590fbb6",
                                                "text": "[T]hey looked like anatomies of death, they spake like ghosts crying out of their graves; they did eate the dead carrions, happy where they could finde them, yea, and one another soone after, insomuch as the very carcasses they spared not to scrape out of their graves; […]"
                                            },
                                            {
                                                "example_id": "0a7d6187-f2b6-413a-90ca-050fcc16c2d6",
                                                "sense_id": "0596d44d-8346-37e7-838d-9d92a590fbb6",
                                                "text": "[T]here is here a perpetual Garriſon of Engliſh, but they are of Engliſh Dogs, vvhich are let out in the night to guard the Ships, and eat the Carrens up and dovvn the Streets, and ſo they are ſhut up again in the Morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4c91a5-08bc-383b-824f-44ab2267cc73",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "An animal which is in poor condition or worthless; also, an animal which is a pest or vermin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7086e110-50d4-40d4-94be-f6e61d2f5f7f",
                                                "sense_id": "9d4c91a5-08bc-383b-824f-44ab2267cc73",
                                                "text": "[L]ords will by their wils / Rather haue one wodcock, than a thouſand dawſe. / Wodcocks ar meate, daws ar carren, wey this clauſe. / In dede ſir (ſaid the daw) I muſt needes agree, / Lords loue to eate you, and not to eate mee."
                                            },
                                            {
                                                "example_id": "6bc31478-4193-4305-9293-65369ea567b7",
                                                "sense_id": "9d4c91a5-08bc-383b-824f-44ab2267cc73",
                                                "text": "Let carren and barren, be ſhifted awaie, / for beſt is the beſt, whatſoeuer ye paie."
                                            },
                                            {
                                                "example_id": "ef17ee02-b4d5-4453-a502-ccbb93e16023",
                                                "sense_id": "9d4c91a5-08bc-383b-824f-44ab2267cc73",
                                                "text": "Having ſhevved you the moſt deſireable, uſefull, and beneficiall creatures, vvith the moſt offenſive carrions that belong to our VVilderneſſe, it remaines in the next place, to ſhevv you ſuch kinds of Fovvle as the Countrey affoords: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafe35a6-baad-3b96-99c7-c9a4fb6d0272",
                                        "entry_id": "683e502e-840f-35f9-a271-097a7001970c",
                                        "glosses": [
                                            "A contemptible or worthless person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "figuratively",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8dc949-1a73-4501-b598-5f08e763dff2",
                                                "sense_id": "bafe35a6-baad-3b96-99c7-c9a4fb6d0272",
                                                "text": "And vvhat other Oath, / Then Honeſty to Honeſty ingag'd, / That this ſhall be, or vve vvill fall for it. / Svveare Prieſts and Covvards, and men Cautelous / Old feeble Carrions, and ſuch ſuffering Soules / That vvelcome vvrongs: […]"
                                            },
                                            {
                                                "example_id": "386a3f1f-d7ab-4073-a751-ce9b8a69bb8c",
                                                "sense_id": "bafe35a6-baad-3b96-99c7-c9a4fb6d0272",
                                                "text": "[…] Pegg Kite, […] will be, I doubt, a troublesome carrion to us executors; but if she will not be ruled, I shall fling up my executorship."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carrion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e85a5c16-4d84-3b3f-a16a-28d796fb3e15",
                                        "entry_id": "6cb2cb24-b045-3e18-8673-de10ec1e3e97",
                                        "glosses": [
                                            "Pertaining to, or made up of, rotting flesh."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63460b4b-8515-48cc-943b-77eb859dce31",
                                                "sense_id": "e85a5c16-4d84-3b3f-a16a-28d796fb3e15",
                                                "text": "Theſe glotõs daily kil thẽſelf their own handes, ⁊ no man findeth fault, but carieth his cariẽ corſe into yͤ quere, and wͭ much ſolẽne ſeruice, burieth yͤ body boldly at the hie alter, whẽ thei haue at their life (as thapoſtle ſaith) made theyr belly their god, ⁊ liked to know none other: […]",
                                                "translation": "These gluttons daily kill themselves [with] their own hands, and no man finds fault, but carries his carrion [indicated as carien] corse into the choir [of the church], and with much solemn service, buries the body boldly at the high altar, when they have at their life (as the apostle says) made their belly their god, and liked to know none other: […]",
                                                "english": "These gluttons daily kill themselves [with] their own hands, and no man finds fault, but carries his carrion [indicated as carien] corse into the choir [of the church], and with much solemn service, buries the body boldly at the high altar, when they have at their life (as the apostle says) made their belly their god, and liked to know none other: […]"
                                            },
                                            {
                                                "example_id": "ccbfbba4-5c0f-444d-b28e-fff1f3f828b0",
                                                "sense_id": "e85a5c16-4d84-3b3f-a16a-28d796fb3e15",
                                                "text": "This coouie [i.e., covey of harpies] rauenouſe, and ſwift with a deſperat onſet, / They gripte in tallants the meat, and foorth ſpourged a ſtincking / Foule carrayne ſauoure: […]"
                                            },
                                            {
                                                "example_id": "311a3625-e3a6-43b3-98c2-982b44124a21",
                                                "sense_id": "e85a5c16-4d84-3b3f-a16a-28d796fb3e15",
                                                "text": "You'l aske me vvhy I rather chooſe to haue / A vveight of carrion fleſh, then to receiue / Three thouſand Ducats?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2843edaa-fcee-3ae3-ae11-979e24278c6a",
                                        "entry_id": "6cb2cb24-b045-3e18-8673-de10ec1e3e97",
                                        "glosses": [
                                            "Disgusting, horrid, rotten."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e4e303-c35d-45e0-9272-7ab3fdb7e64a",
                                                "sense_id": "2843edaa-fcee-3ae3-ae11-979e24278c6a",
                                                "text": "[T]he baseness, the foul, the stinking, the carrion baseness, of the fellows that call themselves \"country gentlemen,\" is, […] that, while they are thus bold with regard to the working and poor people, they never even whisper a word against pensioners, placemen, soldiers, parsons, fundholders, tax-gatherers, or tax-eaters! They say not a word against the prolific dead-weight, to whom they GIVE A PREMIUM FOR BREEDING, while they want to check the population of labourers!"
                                            },
                                            {
                                                "example_id": "a535e06c-50e5-4a2d-b37d-03408cc101c5",
                                                "sense_id": "2843edaa-fcee-3ae3-ae11-979e24278c6a",
                                                "text": "'But as for you, ye carrion rogues,' turning to the three men in the rigging—'for you, I mean to mince ye up for the try-pots;' and, seizing a rope, he applied it with all his might to the backs of the two traitors, till they yelled no more, but lifelessly hung their heads sideways, as the two crucified thieves are drawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c019ba5c-5d84-32de-9d35-c4b02134f6ce",
                                        "entry_id": "6cb2cb24-b045-3e18-8673-de10ec1e3e97",
                                        "glosses": [
                                            "Of the living human body, the soul, etc.: fleshly, mortal, sinful."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c817c5a-7b22-4547-82eb-6d3c49306a7e",
                                                "sense_id": "c019ba5c-5d84-32de-9d35-c4b02134f6ce",
                                                "text": "Shees bitter to her country, heare me Paris, / For euery falſe drop in her bavvdy veines, / A Grecians life hath ſunke: for euery ſcruple / Of her contaminated carrion vvaight, / A Troyan hath beene ſlaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3406c28-d507-38d8-8ef5-0d27d16b8772",
                                        "entry_id": "6cb2cb24-b045-3e18-8673-de10ec1e3e97",
                                        "glosses": [
                                            "Very thin; emaciated, skeletonlike."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f480b3a1-2f21-3cf8-be34-4282842288f4",
                                        "entry_id": "6cb2cb24-b045-3e18-8673-de10ec1e3e97",
                                        "glosses": [
                                            "Of or pertaining to death."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62bbe043-ee5c-4f58-91de-403ba948be25",
                                                "sense_id": "f480b3a1-2f21-3cf8-be34-4282842288f4",
                                                "text": "O hell! vvhat haue vve heere, a carrion death? / VVithin vvhoſe empty eye there is a vvritten ſcroule, / Ile reade the vvriting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3de988f-84ba-45c5-ba1a-18b7fdac4147",
                        "source_entry_id": "fbcbf6cf-621a-3faf-b48d-7512a6b3e22a",
                        "source_sense_id": "7b9fcadb-c5e8-3c26-a35f-bbe38eae7a4e",
                        "target_lang_word": "vulture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7feac6aa-2b9f-3909-85fa-175abec193bb",
                                        "entry_id": "8a1e1936-3a93-32d8-82ec-cf658666f097",
                                        "glosses": [
                                            "Any of several carrion-eating birds of the families Accipitridae and Cathartidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8350d20-7c68-470d-adc5-b96d8b0d2deb",
                                                "sense_id": "7feac6aa-2b9f-3909-85fa-175abec193bb",
                                                "text": "The outer third of the wing of a vulture consists of the wing tips. The inner two-thirds of the wing are cambered (when the wing is extended), and are concerned with lifting effort in unsoarable air and with lifting and tractive effort in soarable air."
                                            },
                                            {
                                                "example_id": "9c20f5a7-def0-4291-a763-30e4f3f75963",
                                                "sense_id": "7feac6aa-2b9f-3909-85fa-175abec193bb",
                                                "text": "In clusters on the plain, like cowlless monks at matins, sat the vultures that had settled on the corpse of the hyena impaled by the female rhino […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "707b1c77-a1ca-37b4-85c0-07db5db329ba",
                                        "entry_id": "8a1e1936-3a93-32d8-82ec-cf658666f097",
                                        "glosses": [
                                            "A person who profits from the suffering of others."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0154ecfe-efb3-44c4-bdc7-e3f574555395",
                                                "sense_id": "707b1c77-a1ca-37b4-85c0-07db5db329ba",
                                                "text": "Within ten minutes of the accident, the vultures appeared and were organizing lawsuits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vulture",
                                "target_lang_code": "en",
