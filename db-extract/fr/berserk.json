                                    {
                                        "sense_id": "9fa8757b-b5ff-342a-9268-4b2d9a09d628",
                                        "entry_id": "993eff5b-5c8e-36b2-be2d-eb1afc2bf5e3",
                                        "glosses": [
                                            "mittelalterlicher skandinavischer Krieger, der im Rausch kämpft, ohne Schmerzen wahrzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18cd82e8-95a3-46e0-96a0-69f02f9fe7a7",
                                                "sense_id": "9fa8757b-b5ff-342a-9268-4b2d9a09d628",
                                                "text": "Auf welche Weise sich die Berserker berauscht haben, ist nicht bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "971972a0-4752-3db8-a7e6-99df09f80bac",
                                        "entry_id": "993eff5b-5c8e-36b2-be2d-eb1afc2bf5e3",
                                        "glosses": [
                                            "brutaler, ungestümer, rücksichtsloser Mensch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
