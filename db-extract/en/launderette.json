                    {
                        "translation_id": "a4284acc-2611-473d-98df-7db35840c04a",
                        "source_entry_id": "8a48f4c5-c8dc-36dc-bc07-f8e52738cefa",
                        "source_sense_description": "place with facilities for washing that public may use",
                        "target_lang_word": "buanderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buanderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18dfdca5-f7e5-33a4-ab43-17016549ad3d",
                                        "entry_id": "4756423e-428f-3ad9-b384-3284ef437e6f",
                                        "glosses": [
                                            "Pièce aménagée pour faire la lessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ef545c1-bc31-4487-8bec-325de47fda2e",
                                                "sense_id": "18dfdca5-f7e5-33a4-ab43-17016549ad3d",
                                                "text": "Au côté de la cour, à droite, sont les remises et les écuries ; à gauche, la cuisine, le bûcher et la buanderie."
                                            },
                                            {
                                                "example_id": "f8f33cc4-050c-4c27-8bd4-407b51656fed",
                                                "sense_id": "18dfdca5-f7e5-33a4-ab43-17016549ad3d",
                                                "text": "Comme mon guide me conduit à la buanderie commune, une rougeaude aux manches retroussées l’interpelle, élève la voix, dénonce des injustices."
                                            },
                                            {
                                                "example_id": "edd08086-fa53-4deb-9cff-1baa8ea9643b",
                                                "sense_id": "18dfdca5-f7e5-33a4-ab43-17016549ad3d",
                                                "text": "Elle l’avait mené à gauche, près de la cuisine, dans une pièce qui servait de buanderie. Un cuvier y était plein d’eau savonneuse, pendant que le linge, jeté sur des barres de bois, ruisselait."
                                            },
                                            {
                                                "example_id": "4e08dacd-d327-4cae-a15f-b3cad8a1045b",
                                                "sense_id": "18dfdca5-f7e5-33a4-ab43-17016549ad3d",
                                                "text": "Je gagnai le vestibule à tâtons, entre la cuisine et la buanderie. Je cherchais toujours. Disparue, l’essoreuse à linge, remplacé, l’ancien lavoir. À la place, un évier moderne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35915b14-1f9d-3918-9c84-782cd03d0c1b",
                                        "entry_id": "4756423e-428f-3ad9-b384-3284ef437e6f",
                                        "glosses": [
                                            "Pressing, laverie."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ade0a9-0d55-41b0-a7e5-8fb481f96167",
                                                "sense_id": "35915b14-1f9d-3918-9c84-782cd03d0c1b",
                                                "text": "Les faits que voici sont établis : l'appelante exploite une buanderie automatique dans la ville de Montréal, où, par le paiement d'une somme de $0.25, une lessiveuse est mise en marche …."
                                            },
                                            {
                                                "example_id": "f1242f88-1a81-44b1-a6d0-df7f0c8a8aeb",
                                                "sense_id": "35915b14-1f9d-3918-9c84-782cd03d0c1b",
                                                "text": "Pour le service des passagers à proprement parler, on observe une diversification, avec la présence d'une nurserie, d’une buanderie (pressing) ou d’un salon de coiffure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
