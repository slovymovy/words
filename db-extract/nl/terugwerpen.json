                                "target_senses": [
                                    {
                                        "sense_id": "5a1e9a39-96da-31c6-a578-6acc80aceeda",
                                        "entry_id": "9d980574-80c9-3010-8cd7-67502ab730e2",
                                        "glosses": [
                                            "To hinder the development of something."
                                        ],
