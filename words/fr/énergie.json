                    "frequency": "High",
                    "semantic_group_id": "physique_et_industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pays investit massivement dans l'<w>énergie</w> solaire afin de réduire ses émissions polluantes."
