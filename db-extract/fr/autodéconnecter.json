                ],
                "senses": [
                    {
                        "sense_id": "f9a26fb6-fa5c-360c-8724-87ee8ec4e033",
                        "entry_id": "81be5f78-2da2-3c81-b9e4-b44a7005e59e",
                        "glosses": [
                            "Régler pour provoquer une déconnexion automatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba89792-66a9-44e7-a220-1f32f329b296",
                                "sense_id": "f9a26fb6-fa5c-360c-8724-87ee8ec4e033",
                                "text": "Sur le net, j'ai trouvé un article parlant de la modification d'un paramètre Windows sur le serveur via la commande: net config server /autodisconnect:30 pour autodéconnecter les ressources inactives depuis 30 minutes..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad5612ac-57fe-3e8b-8f33-4518a99fe65a",
                        "entry_id": "81be5f78-2da2-3c81-b9e4-b44a7005e59e",
                        "glosses": [
                            "Se déconnecter de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363cbef4-0d4c-47c6-a0e8-45ed5012e9e8",
                                "sense_id": "ad5612ac-57fe-3e8b-8f33-4518a99fe65a",
                                "text": "Il y a un nouveau problème chez moi : ça s'autodéconnecte et je suis obligé de me reconnecter tout le temps."
                            },
                            {
                                "example_id": "5c6aea18-ee45-40a5-beec-6264f01159b1",
                                "sense_id": "ad5612ac-57fe-3e8b-8f33-4518a99fe65a",
                                "text": "En fait, quand l'agression morale devient trop importante le cerveau s'autodéconnecte lui-même pour passer en phase zizi-garou."
                            }
                        ]
                    }
                ],
