                                "example_id": "d83afe0c-2d7e-4d15-84ab-a13afbcd2f6f",
                                "sense_id": "47e1b802-c8ec-34ec-9e58-38b8ea6d7bdb",
                                "text": "Wir stiegen glücklicherweise in den richtigen Zug."
