                                        "entry_id": "a7b7f8f4-6436-324b-961f-545a19c20610",
                                        "glosses": [
                                            "het te pakken krijgen van wilde dieren of mensen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b744e31-38b0-473d-8931-b1c0e1e9ff8c",
                                                "sense_id": "78e6cbc3-571d-3c59-a548-4bbaf9b95f3f",
                                                "text": "Zij besloten een paar olifanten te vangen om deze over te brengen naar een ander reservaat."
                                            },
                                            {
                                                "example_id": "2fd68651-327f-4f85-9f1d-dd4d973b5d4b",
                                                "sense_id": "78e6cbc3-571d-3c59-a548-4bbaf9b95f3f",
                                                "text": "Ik wilde dolgraag een keer verse vis vangen en op een kampvuurtje grillen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0190b10a-c502-30e7-b05c-5a1d8aae01ad",
                                        "entry_id": "a7b7f8f4-6436-324b-961f-545a19c20610",
                                        "glosses": [
                                            "in de lucht onderscheppen (bijv. van een bal)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce73a8a8-6d07-4d97-b35b-8d3fe8eabade",
                                                "sense_id": "0190b10a-c502-30e7-b05c-5a1d8aae01ad",
                                                "text": "In honkbal is het kunnen vangen van de bal een belangrijke vaardigheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1487219a-677f-3dc3-8a69-f043d80495b1",
                                        "entry_id": "a7b7f8f4-6436-324b-961f-545a19c20610",
                                        "glosses": [
                                            "verdienen van geld"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93d7afa0-f96f-486a-b024-4d20ff93b674",
                                                "sense_id": "1487219a-677f-3dc3-8a69-f043d80495b1",
                                                "text": "Wat vangt het?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265c064d-869a-3443-be40-01cc79a85359",
                                        "entry_id": "a7b7f8f4-6436-324b-961f-545a19c20610",
                                        "glosses": [
                                            "in één begrip samen te vatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffcf52b-c4cd-4d66-a356-3f0d0b591c32",
                                                "sense_id": "265c064d-869a-3443-be40-01cc79a85359",
                                                "text": "Nationale eenheid is nou eenmaal makkelijker te vangen in termen als democratie en vrijheid, dan in de persoon van een bolwangige veertiger."
                                            }
                                        ]
                                    }
