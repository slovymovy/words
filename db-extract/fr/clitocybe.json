                        "entry_id": "550dbbef-3f30-3601-bf0a-6690549885b5",
                        "glosses": [
                            "Espèce de champignons généralement en forme d’entonnoir, à lames décurrentes, au pied central cylindrique sans anneau et à spores blanches ou pâles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a04aa4-26f4-4032-a48a-2f3eb9e9bfbf",
                                "sense_id": "fcd8ff52-4c80-3278-b87f-377c1857f747",
                                "text": "Une colonie de clitocybes, aux chapeaux bistre à peine nuancés d’un reflet améthyste, interdisait le passage dans la grande allée."
                            },
                            {
                                "example_id": "3a598df4-9480-48d0-9b73-6db5d233ecad",
                                "sense_id": "fcd8ff52-4c80-3278-b87f-377c1857f747",
                                "text": "Cette fois, il s’agissait d’un Clitocybe, en vérité un Clitocybe superbe."
                            },
                            {
                                "example_id": "00d792fa-a540-4121-a955-2f94a26ae7ca",
                                "sense_id": "fcd8ff52-4c80-3278-b87f-377c1857f747",
                                "text": "Les clitocybes blancs ou grisâtres contiennent relativement beaucoup de muscarine."
                            }
                        ]
                    }
