                        "examples": [
                            {
                                "example_id": "778612ec-f1c5-4bca-9025-5d214c5b138e",
                                "sense_id": "b535358e-9e83-3d5f-80c0-612438e6d1c7",
                                "text": "Het ongeval gebeurde rond 7 uur in de Koningin Astridlaan in deelgemeente Bottelare. De 24-jarige man reed met zijn bestelwagen richting centrum en verloor de controle over het stuur. De wagen kwam in aanrijding met een afsluitingsmuur van een woning en botste daarna tegen de hoek van de gevel van een huis."
                            }
