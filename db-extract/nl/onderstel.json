                                        "sense_id": "cb2c3992-e870-346f-a403-3502921fd1b1",
                                        "entry_id": "722e7eac-61a9-3880-a15c-7f481c0a302c",
                                        "glosses": [
                                            "das Fahrgestell oder der Rahmen eines Fahrzeuges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70cf360-329d-40ce-b742-1b6263abf4ff",
                                                "sense_id": "cb2c3992-e870-346f-a403-3502921fd1b1",
                                                "text": "„Immer wenn das Chassis über den nackten Fels schleifte oder gegen hervorstehendes Gestein schlug, dröhnte das ganze Wagengehäuse.“"
                                            },
                                            {
                                                "example_id": "8093b7a1-ee4b-4b25-8077-a1eb59ff3c37",
                                                "sense_id": "cb2c3992-e870-346f-a403-3502921fd1b1",
                                                "text": "„Zweitens sollte die betreffende Ladung im vorderen Teil des Chassis eingebaut werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8592388e-28ad-32f0-b35a-a71ae43ebe03",
                                        "entry_id": "722e7eac-61a9-3880-a15c-7f481c0a302c",
                                        "glosses": [
                                            "Rahmen, Gestell oder Grundplatte zur Aufnahme und Befestigung von Bauteilen und Baugruppen"
                                        ],
                                        "tags": [],
                                        "examples": [
