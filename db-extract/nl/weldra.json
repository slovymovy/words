                "translations": [
                    {
                        "translation_id": "b06e78bb-853e-4804-96f7-c89c405fb4e4",
                        "source_entry_id": "88d123f6-fb09-3962-b918-7866f4065c85",
                        "source_sense_id": "35fb817c-4f0b-3838-adb9-fb430334be2b",
                        "source_sense_description": "niet ver in de toekomst, spoedig",
                        "target_lang_word": "bald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "kurze Zeit danach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c951e3b-7a65-4280-92da-9ea062303ae6",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Bald nun ist Weihnachtszeit."
                                            },
                                            {
                                                "example_id": "cd2019b2-f2f8-4138-b103-c5bd27781503",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Komm bald! Nein, komm eher; komm, sobald es irgendwie geht!"
                                            },
                                            {
                                                "example_id": "e79864bb-c18d-4b1c-a8f7-ef091c2c57f4",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Er ruft am ehesten an, wenn du ihn nicht drängst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "beinahe, fast"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656872e5-679d-4795-aa3a-8e92cd4ed938",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Ich hätte bald dazu einen Kommentar abgegeben."
                                            },
                                            {
                                                "example_id": "f15232ac-eca7-4315-a1c1-448f3b1b4c7c",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Das ist bald zwei Jahre her, dass die beiden geheiratet haben."
                                            },
                                            {
                                                "example_id": "2661a03f-307a-4d3a-98bf-ba2a95ce6619",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Ach, ich hätt bald vergessen zu fragen: sehen wir uns heute Abend?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "ohne große Verzögerung, schnell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f76227e-77f0-4c48-b31a-805c07186077",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Sie hat bald begriffen, was die meisten Männer nicht verstehen."
                                            },
                                            {
                                                "example_id": "8955c635-5fd5-4955-90ed-8624c2e10cf7",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Hoffentlich geht dieser Lockdown bald vorbei."
                                            },
                                            {
                                                "example_id": "b5203fca-8257-4b7c-9371-6da15e7d68dc",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Du kriegst eher einen Pudding an die Wand genagelt, als von dem Typen eine Aussage zu eurer Beziehung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5093abf6-2778-42c3-949b-ff7912ebe6fe",
                        "source_entry_id": "88d123f6-fb09-3962-b918-7866f4065c85",
                        "source_sense_id": "35fb817c-4f0b-3838-adb9-fb430334be2b",
                        "source_sense_description": "niet ver in de toekomst, spoedig",
                        "target_lang_word": "presently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "420af075-eb50-35c6-9cfe-6c14cf5ec5b5",
                                        "entry_id": "4c20039f-4af4-3b79-b5c7-de5d0eddcbfc",
                                        "glosses": [
                                            "Immediately, at once; quickly."
                                        ],
                                        "tags": [
                                            "British",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e177f6b-fe63-4dba-b0f7-f6cf33a394a5",
                                                "sense_id": "420af075-eb50-35c6-9cfe-6c14cf5ec5b5",
                                                "text": "Polonius: My lord, the queen would speak with you, and presently."
                                            },
                                            {
                                                "example_id": "f5774e23-b08e-4762-9a63-c5d41b47a74e",
                                                "sense_id": "420af075-eb50-35c6-9cfe-6c14cf5ec5b5",
                                                "text": "And presently the fig tree withered away."
                                            },
                                            {
                                                "example_id": "9e6e8105-a9d5-4523-b09f-1a2d0497a61b",
                                                "sense_id": "420af075-eb50-35c6-9cfe-6c14cf5ec5b5",
                                                "text": "the butler supposing the Wine had beene so carefully commended unto him for the goodnesse of it, imediately presented some unto the Pope, who whilest he was drinking, his sonne came in and never imagining his bottles had beene toucht, tooke the cup and pledged his father, so that the Pope died presently; and the sonne, after he had long time beene tormented with sicknesse, recovered to another worse fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                        "entry_id": "4c20039f-4af4-3b79-b5c7-de5d0eddcbfc",
                                        "glosses": [
                                            "Before long; soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5ad9cc-83cf-435b-abbc-782ff46eec4d",
                                                "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                                "text": "Presently all was quiet again."
                                            },
                                            {
                                                "example_id": "bd0de1f0-ff31-4f01-bb5e-c5c54148746a",
                                                "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                                "text": "It[…]is the greatest example of lenity in our Saviour, when he desired of God forgiveness unto those, who having one day brought him into the City in triumph, did presently after, act all dishonour upon him, and nothing could be heard but, Crucifige, in their Courts."
                                            },
                                            {
                                                "example_id": "6a28c8e6-9213-4977-b31d-a39bc09da4ed",
                                                "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                                "text": "But they had already discovered that he could be bullied, and they had it their own way; and presently Selwyn lay prone upon the nursery floor, impersonating a ladrone while pleasant shivers chased themselves over Drina, whom he was stalking."
                                            },
                                            {
                                                "example_id": "4b4935dc-43a2-473b-8524-55da163b7125",
                                                "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                                "text": "I shall forget you presently, my dear, / So make the most of this, your little day, / Your little month, your little half a year, / Ere I forget, or die, or move away,"
                                            },
                                            {
                                                "example_id": "34768e36-3491-4a5c-a9ac-62de4bbdafb6",
                                                "sense_id": "d969003b-d918-3913-960d-1ba356ef3a38",
                                                "text": "‘I shall presently be getting a call to tell me of that.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a39c762-d892-357d-b8da-18faef21f414",
                                        "entry_id": "4c20039f-4af4-3b79-b5c7-de5d0eddcbfc",
                                        "glosses": [
                                            "At present; now; currently."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d603df-eec5-492a-9ba3-fd2c77bc8a8e",
                                                "sense_id": "5a39c762-d892-357d-b8da-18faef21f414",
                                                "text": "The towns and forts you presently have.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "e3c9cb45-d571-42ec-821e-85a66b1c2d38",
                                                "sense_id": "5a39c762-d892-357d-b8da-18faef21f414",
                                                "text": "To all of you, therefore, who call Wales your motherland, whether you presently inhabit some other portion of the globe or breathe the air of your cloud-kissed country […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b17eae8-818e-38a0-b316-081454e2485c",
                                        "entry_id": "4c20039f-4af4-3b79-b5c7-de5d0eddcbfc",
                                        "glosses": [
                                            "With actual presence; in actuality."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8faea5e9-fcfb-4ec5-a771-0677e7e5dd42",
                                                "sense_id": "9b17eae8-818e-38a0-b316-081454e2485c",
                                                "text": "March 27 1545, Stephen Gardiner, letter to Thomas Smith and MAtthew PArker\nif they perceyve not presently, it shal be wel doon to bringe them to conformite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e71d858-581d-4171-a4cb-c0087adcb64b",
                        "source_entry_id": "88d123f6-fb09-3962-b918-7866f4065c85",
                        "source_sense_id": "35fb817c-4f0b-3838-adb9-fb430334be2b",
