                "senses": [
                    {
                        "sense_id": "13513082-cf71-378e-905b-89f78bc5c876",
                        "entry_id": "74016f4f-7064-3f60-94d8-3ad766df1208",
                        "glosses": [
                            "A diminutive of the female given name Dorothy, also spelled Dottie."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "58ea9e5b-6563-49e9-adc0-ea6259982c9f",
                                "sense_id": "13513082-cf71-378e-905b-89f78bc5c876",
                                "text": "If you really believed and if you waited ever so quietly, you would see Dotty the witch pottering around in her kitchen or picking herbs to put in her potato stew."
                            },
                            {
                                "example_id": "bbbfcc8e-234d-49bb-853d-f536e4268f83",
                                "sense_id": "13513082-cf71-378e-905b-89f78bc5c876",
                                "text": "“It's Dotty!” As if there were only one Dotty in the world. “Dotty who?” a voice asked from behind the door. “Why, Dotty Fickett!” she replied. The door opened and a woman stood there, her face gaunt and filled with sadness. “Mrs. Doherty?”"
                            }
                        ]
                    }
                ],
