                        "examples": [
                            {
                                "example_id": "af9b5fe9-b350-4a40-938f-e65728ae10a8",
                                "sense_id": "c1add5e2-9ba6-3175-a860-8fa126d50ed4",
                                "text": "Marloes Keetels beëindigt na dit seizoen haar hockeyloopbaan. De 169-voudig international zal komende zomer tijdens het WK in Nederland en Spanje haar laatste wedstrijden spelen."
                            },
                            {
                                "example_id": "a66d03fb-2214-405e-a6dc-11d011c9042b",
                                "sense_id": "c1add5e2-9ba6-3175-a860-8fa126d50ed4",
                                "text": "Op jacht naar haar derde gouden WK-medaille, De Goede had het niet durven dromen toen ze ruim zeven maanden geleden de voorste kruisband van haar rechterknie afscheurde. Weg WK, vreesde de toenmalige aanvoerster van Oranje. En misschien zelfs wel einde hockeyloopbaan op het hoogste niveau."
                            }
                        ]
