                        "glosses": [
                            "The primary beam of a roof; the ridgepole; hence, the roof itself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6401f531-8566-4efb-b2db-e8e2c7319e04",
                                "sense_id": "a0664c90-bc27-3776-8973-b8103f5e10b7",
                                "text": "Howsoever these things be, a long farewell to Locksley Hall! / Now for me the woods may wither, now for me the rooftree fall."
                            },
                            {
                                "example_id": "553e1034-cefe-42d0-a3b0-82e3759afea7",
                                "sense_id": "a0664c90-bc27-3776-8973-b8103f5e10b7",
                                "text": "there an Annunciation that annihilates time by showing a rooftree throw the shadow of a cross between the Virgin and the angel […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "aef5899e-25d1-3d01-9d46-c33a5d01c9a8",
                        "entry_id": "dfd55dae-00b1-33f3-96d1-cc505c9b1b0b",
                        "glosses": [
                            "A home; a household."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e267fee9-27f2-4d51-ab9e-bebef1301c83",
                                "sense_id": "aef5899e-25d1-3d01-9d46-c33a5d01c9a8",
                                "text": "[T]he merry company flocked into the King's House, to dance again and drink tea, and make more love, and play round games, and joke, and sing songs, and eat supper under old Colonel Stafford's snug and kindly roof-tree."
                            },
                            {
                                "example_id": "1e572e7e-e706-4ff0-b0ac-7c533969fda2",
                                "sense_id": "aef5899e-25d1-3d01-9d46-c33a5d01c9a8",
                                "text": "With the idea, presumably, of inducing the doctor's wife to leave her husband's roof-tree for some habitation which would be run at my expense, I had crammed my pockets with a store of banknotes, which represented a good deal of my immediate worldly wealth."
                            },
                            {
                                "example_id": "b652fd69-3cb3-4bbd-b674-8ca8d7faa255",
                                "sense_id": "aef5899e-25d1-3d01-9d46-c33a5d01c9a8",
                                "text": "He had forgotten that a prophet is without honor under his own rooftree."
                            }
                        ]
                    }
