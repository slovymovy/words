                                "target_senses": [
                                    {
                                        "sense_id": "6b91cd83-704e-3f9c-96dd-3d8417ec257b",
                                        "entry_id": "1f2ec43f-4bc0-3144-bde0-b37cf7e49fde",
                                        "glosses": [
                                            "Having no worth or use; without value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2040cee-6960-455a-8b58-ea3f8e991809",
                                                "sense_id": "6b91cd83-704e-3f9c-96dd-3d8417ec257b",
                                                "text": "Don’t be a worthless slouch! Go get yourself a job."
                                            },
                                            {
                                                "example_id": "ca56af1c-ca19-43e5-99ab-27267c1fb202",
                                                "sense_id": "6b91cd83-704e-3f9c-96dd-3d8417ec257b",
                                                "text": "Lies are as important as truth, for without lies, the truth is worthless."
                                            },
                                            {
                                                "example_id": "e5f4086b-7b0b-4e73-ae7e-aea0413b3460",
                                                "sense_id": "6b91cd83-704e-3f9c-96dd-3d8417ec257b",
                                                "text": "The committee’s decision is worthless and not going to be acted upon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
