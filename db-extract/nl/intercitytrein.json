                        "examples": [
                            {
                                "example_id": "5775e428-2cd3-487e-a528-ae930a146333",
                                "sense_id": "60dcf185-15fc-36e9-8f9a-cd2ff76ba578",
                                "text": "Op het spoor bij Meteren, in de buurt van Geldermalsen, is afgelopen nacht een spoorwerker doodgereden door een intercitytrein. ProRail bevestigt dat de man om het leven is gekomen. Het is niet bekend hoe het ongeluk kon gebeuren."
                            },
                            {
                                "example_id": "3b9e146d-0db5-49cc-b35a-6d40d52a8478",
                                "sense_id": "60dcf185-15fc-36e9-8f9a-cd2ff76ba578",
                                "text": "De intercitytrein reed door een stootblok en kwam naast het spoor terecht. Waardoor dat kon gebeuren is nog niet bekend."
                            }
                        ]
                    }
