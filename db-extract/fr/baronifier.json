                ],
                "senses": [
                    {
                        "sense_id": "b31695ea-42bb-3cf4-bf2a-8aac64d7bc31",
                        "entry_id": "c855ce45-51ff-357a-8bf3-79084acc0cc8",
                        "glosses": [
                            "Accorder le titre de baron à (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dfbe855-3b3a-433d-a42c-5b6ead597acb",
                                "sense_id": "b31695ea-42bb-3cf4-bf2a-8aac64d7bc31",
                                "text": "Les gens logiques s’étonneront d’avoir vu le vieux Vendéen donnant sa première fille à un receveur-général qui possédait bien, à la vérité, quelques anciennes terres seigneuriales, mais dont le nom n’était pas précédé de cette particule à laquelle le trône dut tant de défenseurs, et la seconde à un magistrat trop récemment baronifié pour faire oublier que le père avait vendu des fagots."
                            },
                            {
                                "example_id": "cb0efbd0-b3eb-48a6-b109-35722a5892dc",
                                "sense_id": "b31695ea-42bb-3cf4-bf2a-8aac64d7bc31",
                                "text": "D’Aldriger fut alors baronifié par S. M. l’Empereur et Roi, car sa fortune se doubla ; mais il se passionna pour le grand homme qui l’avait titré."
                            },
                            {
                                "example_id": "17de9a08-d1fe-48af-a835-e456b71366bb",
                                "sense_id": "b31695ea-42bb-3cf4-bf2a-8aac64d7bc31",
                                "text": "C’est alors qu’on avait vu l’empereur baronifier le valet de chambre Locatelli et comtifier le palefrenier Luxenstein."
                            }
                        ]
                    }
                ],
