                                        "examples": [
                                            {
                                                "example_id": "943d3dab-fed1-4b4d-8ce3-c138324f5dfc",
                                                "sense_id": "34662a9f-5599-3848-a391-ec04e148813f",
                                                "text": "with neither house nor clothes to cover them from the inclemencies of the weather"
                                            },
                                            {
                                                "example_id": "cf7a6c66-8b72-4cc8-8194-aa7df78ea09d",
                                                "sense_id": "34662a9f-5599-3848-a391-ec04e148813f",
                                                "text": "They are built of rough sticks, covered with bulrushes or grass, in such a manner as to completely protect the inhabitants from all the inclemencies of the weather."
                                            },
                                            {
                                                "example_id": "4967852c-a1ba-487d-ac50-a7bf0115cf8e",
                                                "sense_id": "34662a9f-5599-3848-a391-ec04e148813f",
                                                "text": "There had been rain, squalls mingled with snow, hailstorms, gusts of wind, but these inclemencies did not last."
                                            },
                                            {
                                                "example_id": "ae5008e8-cc38-4bf7-b7f0-371726cd3a8e",
                                                "sense_id": "34662a9f-5599-3848-a391-ec04e148813f",
                                                "text": "The cry of the suffering and dying rings in our ears, as they are dragged from their beds, to be exposed to the inclemencies of the ice-covered sea in an open boat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
