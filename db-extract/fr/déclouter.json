                        "examples": [
                            {
                                "example_id": "78a3ce60-b7cd-4f0a-8a98-62e6bccbce1c",
                                "sense_id": "9d0e36f7-f3ad-3f99-879c-e1bb1539581a",
                                "text": "On en a déclouté, des vieilles planches, déclouté, déclouté à n’en plus finir !… Déclouter ! Arracher encore !…"
                            },
                            {
                                "example_id": "1daf8512-f1c8-4e45-85f4-1efa591afd71",
                                "sense_id": "9d0e36f7-f3ad-3f99-879c-e1bb1539581a",
                                "text": "Tu vas me déclouter toutes les planches de ce couvercle qui est là et tu le mettras là-dessus, sur sa caisse."
                            }
                        ]
