                    ],
                    "common_phrases": [
                        "rechte hoek",
                        "scherpe hoek"
                    ],
                    "target_lang_definitions": {
                        "en": "the size of the rotation between two lines that meet at a single point, measured in degrees",
                        "ru": "величина поворота между двумя линиями, сходящимися в одной точке, измеряемая в градусах"
