                "senses": [
                    {
                        "sense_id": "ae1878fc-a3dd-3f8f-9cbf-dc062ee1ad2d",
                        "entry_id": "2d73de32-3681-397c-82f1-2571a42a0806",
                        "glosses": [
                            "To paint anew or again, especially if recently painted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5414977a-7087-4f87-a8fb-fa6ac33f4077",
                                "sense_id": "ae1878fc-a3dd-3f8f-9cbf-dc062ee1ad2d",
                                "text": "to repaint a house; to repaint the ground of a picture"
                            },
                            {
                                "example_id": "b8916804-53b5-4980-a472-b3521c9860c9",
                                "sense_id": "ae1878fc-a3dd-3f8f-9cbf-dc062ee1ad2d",
                                "text": "Nearly all of their locomotives have never been repainted, which is as much as 24 years in the case of some of the DB Cargo units."
                            }
                        ]
                    },
                    {
                        "sense_id": "32fd6d79-862c-3787-a601-5e5f34903a2a",
                        "entry_id": "2d73de32-3681-397c-82f1-2571a42a0806",
                        "glosses": [
                            "To draw or render again on the display."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0a5c6b3c-2049-4a44-af1a-39cf38e07f95",
                                "sense_id": "32fd6d79-862c-3787-a601-5e5f34903a2a",
                                "text": "To force a window to repaint itself programmatically, you call the inherited Invalidate() method[…]"
                            }
                        ]
                    }
                ],
