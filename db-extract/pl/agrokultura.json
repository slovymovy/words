                "senses": [
                    {
                        "sense_id": "443b542a-8ef8-3a98-a1c2-b0284d7e34c6",
                        "entry_id": "e8835575-5b98-3208-a2e8-be2f277fd8e4",
                        "glosses": [
                            "Kunst, Felder zu bebauen und Pflanzen zu züchten; Agrikultur, Ackerbau, Landwirtschaft"
                        ],
                        "tags": [],
                        "examples": [],
