                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "impavides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c084f19f-27b5-3fa6-997b-deea6de4b784",
                        "entry_id": "4ff3c1c7-4e95-3958-aa4f-55db2eea214c",
                        "glosses": [
                            "Qui ne ressent pas ou n’exprime pas la peur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8947e773-dae3-45d3-9ff3-8cd8750166bb",
                                "sense_id": "c084f19f-27b5-3fa6-997b-deea6de4b784",
                                "text": "À l’aise devant la vie, séduisant, nonchalant, souriant, au-dessus des mesquineries et des jalousies, impavide devant l’hypocrisie, la discourtoisie, la vulgarité d’âme."
                            },
                            {
                                "example_id": "a2946048-9786-41f7-abcd-fc192218a076",
                                "sense_id": "c084f19f-27b5-3fa6-997b-deea6de4b784",
                                "text": "Corbeau était un dur de première, impavide devant le danger."
                            },
                            {
                                "example_id": "b60b198b-7449-4d9a-9ff7-eb4594118d24",
                                "sense_id": "c084f19f-27b5-3fa6-997b-deea6de4b784",
                                "text": "Vidock, impavide, fait les cent pas."
                            },
                            {
                                "example_id": "12c4e56f-6038-4331-a472-bb198e354eab",
                                "sense_id": "c084f19f-27b5-3fa6-997b-deea6de4b784",
                                "text": "À cinquante mètres, des yacks broutaient, impavides."
                            }
                        ]
                    },
                    {
                        "sense_id": "059274b9-970a-39cf-8204-d25d2f521319",
                        "entry_id": "4ff3c1c7-4e95-3958-aa4f-55db2eea214c",
                        "glosses": [
                            "Inébranlable."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1f84d999-97f7-4250-8059-71ece7da051c",
                                "sense_id": "059274b9-970a-39cf-8204-d25d2f521319",
                                "text": "Maxence défigurait, impavide, ces prochaines équipées."
                            },
                            {
                                "example_id": "e4abcbf8-b07d-4c10-b368-98e3cb71288d",
                                "sense_id": "059274b9-970a-39cf-8204-d25d2f521319",
                                "text": "La Hyène remonte le Paseo Maritimo, voie hérissée de béton, de sculptures subventionnées, et de palmiers impavides."
                            },
                            {
                                "example_id": "935fc6fe-c69c-425f-bf86-5d7ca1fb57d4",
                                "sense_id": "059274b9-970a-39cf-8204-d25d2f521319",
                                "text": "Sachez ici qu’impavide est la jument quand l’étalon la pénètre, impavide et, pourtant, nous n’ignorons pas que la verge de l’étalon est digne d’estime lorsqu’elle sort de son fourreau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6e0ad5e-15a8-4c5a-9c07-147c9f79cfa5",
                        "source_entry_id": "4ff3c1c7-4e95-3958-aa4f-55db2eea214c",
                        "target_lang_word": "furchtlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furchtlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                        "entry_id": "4047c970-aa68-30f8-8e8f-05af1b9b87fc",
                                        "glosses": [
                                            "unerschrocken, ohne Furcht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f774c73-c52c-437f-87bf-c38795a77708",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "Furchtlos zog er in die Schlacht."
                                            },
                                            {
                                                "example_id": "1dadcb82-50d1-4f0a-a172-4df81525b57c",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Unermüdlich ging er von Zelle zu Zelle […] stets sein eigenes Leid vergessend, völlig furchtlos, was die eigene Person anging.“"
                                            },
                                            {
                                                "example_id": "aaf6dc5d-a998-41eb-9593-cfcf6d150e71",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Damals, als er diese Barbara geheiratet hatte, das Bürgermädchen, da war Juliette zuversichtlich und furchtlos geblieben: sie hatte gewußt, daß er zu ihr, zu seiner Schwarzen Venus zurückkehren würde.“"
                                            },
                                            {
                                                "example_id": "5f8ffa48-968d-46a2-b2e4-be08f0311b0f",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Ich liebe die Männer, welche furchtlos sind, und darum will ich dir deine Bitte erfüllen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14370589-543e-4ae5-8351-5ba2506df9a8",
                        "source_entry_id": "4ff3c1c7-4e95-3958-aa4f-55db2eea214c",
                        "target_lang_word": "fearless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
