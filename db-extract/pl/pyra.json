        "pl-extract.jsonl": [
            {
                "entry_id": "5d94d16d-81b5-31d8-a533-c83488d91bd0",
                "word": "pyra",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b01c6f86-4b3e-37ff-945b-c263c88aa7d7",
                        "entry_id": "5d94d16d-81b5-31d8-a533-c83488d91bd0",
                        "glosses": [
                            "gw. (Poznań) ziemniak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bceeb89-c4a1-4f09-822b-38d71a7b8a1c",
                                "sense_id": "b01c6f86-4b3e-37ff-945b-c263c88aa7d7",
                                "text": "W sobotę zawsze odbywał się tam targ rolny, na którym swoje towary sprzedawali rolnicy z podpoznańskich wiosek. Zamożniejsi bambrzy przyjeżdżali tu swoimi wozami, które natychmiast zamieniały się w stragany na kołach, oferujące mieszkańcom miasta drób, jajka, warzywa i pyry w workach albo w mniejszych ilościach na wymborki."
                            },
                            {
                                "example_id": "bed7bd3f-bb39-47a4-9716-7cde0132b41c",
                                "sense_id": "b01c6f86-4b3e-37ff-945b-c263c88aa7d7",
                                "text": "Do schabowego musiały być pyry pokrychane z masłem i odrobiną mleka oraz z zasmażaną, też na smalcu, kiszoną kapustą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "11bbd4a5-881a-3389-a77c-e5312de43c7b",
                        "entry_id": "5d94d16d-81b5-31d8-a533-c83488d91bd0",
                        "glosses": [
                            "mieszkaniec Poznania"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "326514e7-9d18-4a1b-9ba2-c3762b66ec81",
                                "sense_id": "11bbd4a5-881a-3389-a77c-e5312de43c7b",
                                "text": "Pan młody z Poznania, to się na wesele tych pyrów najechało."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7bf34feb-2616-3ba8-8f76-8ff5bd9c9a3a",
                        "entry_id": "5d94d16d-81b5-31d8-a533-c83488d91bd0",
                        "glosses": [
                            "miłośnik ziemniaków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5003105c-ef70-4859-947a-df30b326c690",
                                "sense_id": "7bf34feb-2616-3ba8-8f76-8ff5bd9c9a3a",
                                "text": "Z mojego teścia to straszna pyra jest. Mięsa może nie jeść, ale kartofle do obiadu zawsze muszą być."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
