                                        "sense_id": "564e72a7-af1b-35de-90f1-79028bdec7e5",
                                        "entry_id": "8ad5f23a-5333-36af-9a69-9f7717802a0c",
                                        "glosses": [
                                            "deutsche Bezeichnung für Konsonant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85215a0d-3202-4ab9-8183-a2e69086fdd2",
                                                "sense_id": "564e72a7-af1b-35de-90f1-79028bdec7e5",
                                                "text": "Mit Mitlaut sind alle Konsonanten gemeint. Der Ausdruck Mitlaut wird besonders im Anfangsunterricht in Grammatik verwendet."
                                            },
                                            {
                                                "example_id": "7420d45b-81a4-49a3-a818-2218440e372a",
                                                "sense_id": "564e72a7-af1b-35de-90f1-79028bdec7e5",
                                                "text": "„Es gefiel mir, daß die Selbstlaute nicht ohne die Mitlaute, die Mitlaute nicht ohne die Selbstlaute auskamen, daß jeder auf jeden angewiesen war, wenn er etwas darstellen wollte.“"
                                            },
                                            {
                                                "example_id": "bc33844f-776a-4ebd-b7c1-482e3bfcaf1a",
                                                "sense_id": "564e72a7-af1b-35de-90f1-79028bdec7e5",
                                                "text": "„Hierbei sind die Mitlaute und Selbstlaute so angegeben, wie sie nach Auffassung des Verfassers im späten Neuen Reich am wahrscheinlichsten gesprochen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42373937-b416-41e3-b1a3-cdd340f867c2",
                        "source_entry_id": "aac0387d-89cc-35e1-8146-2a0cc8a81f15",
                        "source_sense_id": "25df9da1-3b13-3d2a-8032-b644981503d1",
                        "source_sense_description": "Linguistik: Konsonant, Mitlaut",
                        "target_lang_word": "consonant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consonant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5160a313-ba13-3537-a0af-483b463284c9",
                                        "entry_id": "340229e4-1a82-32dd-ad76-0b078e1332ac",
                                        "glosses": [
                                            "A sound that results from the passage of air through restrictions of the oral cavity; any sound that is not the dominant sound of a syllable, the dominant sound generally being a vowel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                        "entry_id": "340229e4-1a82-32dd-ad76-0b078e1332ac",
                                        "glosses": [
                                            "A letter representing the sound of a consonant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a6c459-5e86-400c-9691-e260a59d8143",
                                                "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            },
                                            {
                                                "example_id": "42f812b6-55b7-4971-86a9-32be381926ff",
                                                "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                                "text": "“Tell me, has right anything to do with the law?” I asked. “You have used the wrong initial consonant,” he smiled in answer. “Might?” I queried; and he nodded his head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consonant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Consistent, harmonious, compatible, or in agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5431be5d-234d-41e8-9a81-bd014e916558",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "Each one pretends that his opinion […] is consonant to the words there used."
                                            },
                                            {
                                                "example_id": "94b80e69-fb7b-471f-a6de-02361b703345",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "Cheerfulness, even gaiety, is consonant with every species of virtue and practice of religion, and I think it inconsistent only with impiety and vice."
                                            },
                                            {
                                                "example_id": "0202e40e-1bcc-4a5e-9e00-718b143545c5",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "This essential right of the courts to be free of intimidation and coercion was held to be consonant with a recognition that freedom of the press must be allowed in the broadest scope compatible with the supremacy of order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caea22e6-9589-3fc1-9a57-fca136a1edb9",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Having the same sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04543379-20f4-4ecb-8920-5d4b0d19219d",
                                                "sense_id": "caea22e6-9589-3fc1-9a57-fca136a1edb9",
                                                "text": "1645-1650, James Howell, Epistolae Ho-Elianae\nconsonant words and syllables"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51135789-bda1-3be6-8dd5-5b7b734705fc",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Harmonizing together; accordant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b135e90-384c-4dea-8bde-ab36cd9297f4",
                                                "sense_id": "51135789-bda1-3be6-8dd5-5b7b734705fc",
                                                "text": "consonant tones; consonant chords"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e967bab-1c95-396f-acc1-0eddcd91b762",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Of or relating to consonants; made up of, or containing many, consonants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1cc5d0b-fb9a-43fb-9cb6-a346b3a77fda",
                                                "sense_id": "0e967bab-1c95-396f-acc1-0eddcd91b762",
                                                "text": "No Russian whose dissonant consonant name / Almost shatters to fragments the trumpet of fame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
