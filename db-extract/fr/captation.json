                                        "sense_id": "c929b99a-3f92-3653-baba-71753104f1f8",
                                        "entry_id": "ef94df19-be78-3be2-b70a-0e072c2e2c5a",
                                        "glosses": [
                                            "het aftappen van water uit een waterloop"
