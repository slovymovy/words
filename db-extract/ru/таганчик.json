                "senses": [
                    {
                        "sense_id": "a056102a-ad32-3fde-91bb-1e175c14547f",
                        "entry_id": "44911c1d-8f64-37ff-831a-3c12ddae2308",
                        "glosses": [
                            "разг. уменьш.-ласк. к таган; треножник, к которому подвешивается котел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91dc188d-2872-4c5b-9551-b7076bc30cb0",
                                "sense_id": "a056102a-ad32-3fde-91bb-1e175c14547f",
                                "text": "Смотришь, уж он опять тут, опять где-нибудь около забора под таганчик щепочки украдкой подкладывает."
                            },
                            {
                                "example_id": "1d5ae40e-559f-40bc-9389-1786d300610d",
                                "sense_id": "a056102a-ad32-3fde-91bb-1e175c14547f",
                                "text": "Запьяневшая, раскрасневшаяся хозяйка поддувала пламя под таганчиком и с ласковой улыбкой останавливалась, рассматривая Турбина."
                            },
                            {
                                "example_id": "2d198102-d899-4b36-abb7-d48a6d3c8cfb",
                                "sense_id": "a056102a-ad32-3fde-91bb-1e175c14547f",
                                "text": "Пар был самый реальный, потому что большой чайник с утра до вечера кипел на таганчике в русской печке."
                            }
                        ]
                    }
