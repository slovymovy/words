                                    {
                                        "sense_id": "e6d2d996-13bc-3185-bb73-8e37c159cb38",
                                        "entry_id": "58e0680c-b707-3cf6-978f-829fee1bf5b2",
                                        "glosses": [
                                            "verschiedene Dingen, Sachverhalte oder Personen vollkommen gleich behandelnd; keine Unterschiede aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396dbab0-23aa-40b8-a424-dd7daa6efaaa",
                                                "sense_id": "e6d2d996-13bc-3185-bb73-8e37c159cb38",
                                                "text": "„Auf diese Weise wird das eigentliche Problem gar nicht adressiert, das in beiden Büchern hinter der unterschiedslosen Verwendung von Neoliberalismus, Kapitalismus und Austeritätspolitik versteckt bleibt.“"
                                            },
                                            {
                                                "example_id": "6e5b6ea1-263b-4027-a1e0-9241a07cc52d",
                                                "sense_id": "e6d2d996-13bc-3185-bb73-8e37c159cb38",
                                                "text": "„Die Steuern, die alle Einkommensarten unterschiedslos treffen sollen, sind Kopfsteuern und Steuern auf Konsumgüter.“"
                                            },
                                            {
                                                "example_id": "1f528c4d-f248-4100-9adf-1f95b07228fe",
                                                "sense_id": "e6d2d996-13bc-3185-bb73-8e37c159cb38",
                                                "text": "„Die Kugel ist der unterschiedsloseste Körper. Da ist nicht einmal eine Ecke, eine Kante, die das Kind zur anstrengenden Unterscheidung aufforderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
