                ],
                "senses": [
                    {
                        "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                        "entry_id": "b1f6dfcf-fb24-37e0-bf06-3a86682e6d58",
                        "glosses": [
                            "Angehöriger eines antiken, keltischen Stammes, der im Bereich von Böhmen bis zu den Karpaten ansässig war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49842cda-71c2-4fc6-b32f-b9d83419d387",
                                "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                                "text": "„Als das Jahr darauf ein anderer Stamm, die Boier, einfielen, wurde er ohne Mühe zurückgeschlagen.“"
                            },
                            {
                                "example_id": "bd13d878-e7d5-419f-ae4e-b18264a31884",
                                "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                                "text": "„Die Boier waren schon in vorrömischer Zeit ein weitverzweigtes Keltenvolk, das vor allem Böhmen beherrschte.“"
                            },
                            {
                                "example_id": "977bda79-88fb-448f-881f-764b89638db8",
                                "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                                "text": "„Der Grund dafür, daß sich 32000 Boier erneut auf Wanderschaft begeben mußten, waren diesmal aus dem Nordosten einfallende germanische Stämme.“"
                            },
                            {
                                "example_id": "0474af34-5017-489d-9a0e-ce80f2aa7f78",
                                "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                                "text": "„Aus der Zeit der Eroberung kennen wir nun auch die Selbstbezeichnungen der hier lebenden Nationen oder »Stämme« – der Treverer in der Eifel, im Hunsrück und an der Mosel, der Nemeter in der Pfalz, der Helvetier in Baden und Schwaben, der Vindeliker und Boier in Bayern.“"
                            },
                            {
                                "example_id": "e40883a7-cf5c-4210-ae88-077971555bf2",
                                "sense_id": "1252ea2d-2ba9-39dd-ae92-b6536664a080",
                                "text": "„Der inschriftliche Nachweis eines Boiers zeigt die Präsenz von Personen ostkeltischer Herkunft in diesem Raum bereits vor Beginn der Landnahmephase an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
