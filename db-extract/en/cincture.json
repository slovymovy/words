                "senses": [
                    {
                        "sense_id": "1941e88f-976c-3213-b6c0-0c9008985d30",
                        "entry_id": "59775549-27c6-33bd-bf97-b201d09eea52",
                        "glosses": [
                            "An enclosure, or the act of enclosing, encircling or encompassing"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fd1d220b-7b33-31be-91ac-dcb09d22f8c2",
                        "entry_id": "59775549-27c6-33bd-bf97-b201d09eea52",
                        "glosses": [
                            "A girdle or belt, especially as part of a vestment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c0d9c3-c1f4-41af-8a10-fb3a33b4cc3b",
                                "sense_id": "fd1d220b-7b33-31be-91ac-dcb09d22f8c2",
                                "text": "In one, dated eighteen years ago, he appeared, wearing only sandals and a cincture of vine leaves, between two classical garden statues."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0e0a5c4-317e-3f3d-b092-66fa5dc1e135",
                        "entry_id": "59775549-27c6-33bd-bf97-b201d09eea52",
                        "glosses": [
                            "The fillet, listel, or band next to the apophyge at the extremity of the shaft of a column."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7fdf23-8331-4002-a76f-8ffddc437bb8",
                        "source_entry_id": "59775549-27c6-33bd-bf97-b201d09eea52",
                        "source_sense_description": "girdle or belt",
                        "target_lang_word": "Zingulum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zingulum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                        "entry_id": "e49b1884-8b9d-355d-9cd0-7177666ce565",
                                        "glosses": [
                                            "Gürtel am Gewand eines Klerikers oder Mitglieds einer Ordensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3aea0d2-ac7b-4559-aca9-25bcb6399882",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„In unserem Kirchenjahr gibt es verschiedene Feste und Feiern. Dabei ist immer eins zu beobachten: Die Farben der Messgewänder und die Zingulen (Kordeln) der Minis ändern ihre Farben.“"
                                            },
                                            {
                                                "example_id": "2bd8b359-34c0-4ba1-9374-47c132a5add2",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„In den ersten Jahrzehnten der Protokolle finden wir auch Mitteilungen, daß der Weihbischof Kelche und Patenen, Ziborien und Monstranzen, Lunulen und Kustodien, Pallen, Korporalien und Altartücher, Kaseln und Dalmatike mit Stolen und Manipeln, Alben, Schultertücher und Zingulen geweiht hat.“"
                                            },
                                            {
                                                "example_id": "feb90e5a-e498-4bb6-a510-c2b5a103e552",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Hinzu kommen vereinzelt Bruderschaftsutensilien wie einige Zingulen, Rosenkränze und Skapuliere (jeweils mit Kupferstich) oder etliche Bruderschaftszettel.“"
                                            },
                                            {
                                                "example_id": "7ea49910-084c-4add-95b1-f61bebabc1cc",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Bemerkenswert ist die aufwendig ausgestattete Kapelle im Erdgeschoß, in der sich außer einem gotischen Altar ein Betstuhl, ein Lesepult, ein Meßbuch, 4 Meßgewänder, zwei Alben und drei Zingulen befanden.“"
                                            },
                                            {
                                                "example_id": "7f721427-5863-4d59-a1ae-5e2e257f6ff2",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Dazu kommen 3 Bursen und ebenso viele erstklassige Pallae mit Zingulen und Schultertüchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
