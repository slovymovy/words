                "senses": [
                    {
                        "sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
                        "entry_id": "abb72f0d-f99c-3144-8ccc-3e1fde63b52d",
                        "glosses": [
                            "Anlage, die dem Trocknen von Getreide, Gemüse, Hanf, Torf oder Nüssen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f5db6c-0e97-43dc-9ad9-fcef94a73ab5",
                                "sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
                                "text": "„[…] Nichts blieb mehr vom frischen, verführerisch in die Nase steigenden Duft draußen auf dem Hopfenfeld, kein Vergleich zum zwar beißenden, aber saftig-kühlen Wohlgeruch an der Pflückmaschine - hier droben vor der Darre stinkt es zum Gotterbarmen.“"
                            },
                            {
                                "example_id": "46fb95ae-db7f-47aa-82a3-7d76a687eea0",
                                "sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
                                "text": "„Unter dem pyramidenförmigen Dach der Darre, wo die gekeimten Getreidekörner durch Erhitzen getrocknet werden, verströmt das Eichengebälk einen schweren, würzigen und malzigen Duft.“"
                            },
                            {
                                "example_id": "6f285128-2dff-429b-9ac1-bd2477539411",
                                "sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
                                "text": "„Doch meist brachte neue Technik auch größeren Profit. … Das galt für die so genannte englische Darre, die das Trocknen und Rösten des Malzes verbesserte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9011c5c7-5b4e-45e6-bbc3-3eecdb7eabe9",
                        "source_entry_id": "abb72f0d-f99c-3144-8ccc-3e1fde63b52d",
                        "source_sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
                        "source_sense_description": "Anlage, die dem Trocknen von Getreide, Gemüse, Hanf, Torf oder Nüssen dient",
                        "target_lang_word": "kiln",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiln",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b7906a-baff-3c8b-9f7a-d88430de7b48",
                                        "entry_id": "a16bdedb-1f17-3b2a-a511-9d75b22c9cc1",
                                        "glosses": [
                                            "An oven or furnace or a heated chamber, for the purpose of hardening, burning, calcining or drying anything; for example, firing ceramics, curing or preserving tobacco, or drying grain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c60c51-7d1c-4141-a09d-39358de8535b",
                                                "sense_id": "49b7906a-baff-3c8b-9f7a-d88430de7b48",
                                                "text": "One typical Grecian kiln engorged one thousand muleloads of juniper wood in a single burn. Fifty such kilns would devour six thousand metric tons of trees and brush annually."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kiln",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ef5465-698c-331e-af33-fa42b7453197",
                                        "entry_id": "30f74b17-65dd-386a-8181-5ad32b1f6182",
                                        "glosses": [
                                            "To bake in a kiln; to fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "511cc643-76d6-40f6-8947-88007dd67af5",
                                                "sense_id": "28ef5465-698c-331e-af33-fa42b7453197",
                                                "text": "When making pottery we need to allow the bisque to dry before we kiln it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87331ddd-f73f-44df-84b2-34f8a1c580fc",
                        "source_entry_id": "abb72f0d-f99c-3144-8ccc-3e1fde63b52d",
                        "source_sense_id": "2048b1ed-9218-32f2-a5e5-267076d004ce",
