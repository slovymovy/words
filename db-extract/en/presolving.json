                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d22a4aeb-b0cc-421d-8a7e-0eca50696f45",
                                "sense_id": "f32ad8d2-28d8-348a-9d78-4a341eb9d09e",
                                "text": "Presolving is beneficial regardless of what algorithm is used to solve the linear program; it is used both in simplex and interior-point codes."
                            },
                            {
                                "example_id": "8799497a-63c5-4058-af45-d374d46739d2",
                                "sense_id": "f32ad8d2-28d8-348a-9d78-4a341eb9d09e",
                                "text": "When presolving does detect infeasibility, but provides a poor explanation of its cause, it is often a good idea to re-run the solution with the presolver turned off so that one of the more advanced IIS isolation routines described later in this chapter can run instead."
                            },
                            {
                                "example_id": "118fe2da-00c3-4f7a-bc09-28533ce1f539",
                                "sense_id": "f32ad8d2-28d8-348a-9d78-4a341eb9d09e",
                                "text": "In CPLEX, presolving capabilities were added with version 2.1 in 1993."
