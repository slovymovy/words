                                        "glosses": [
                                            "лингв. грубое или непристойное обозначение изначально нейтрального понятия с целью придания ему негативной смысловой нагрузки или для усиления экспрессивности речи"
                                        ],
                                        "tags": [],
                                        "examples": [
