                "senses": [
                    {
                        "sense_id": "b771a3f1-40ca-32a5-94a9-53b38203830d",
                        "entry_id": "4a79a769-9896-3ae4-8a99-e79508b52a76",
                        "glosses": [
                            "Person, die anderen (zum Beispiel Gefangenen in einem Lager) Aufgaben zuweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d06ceee-ed1a-44da-86d0-4e31fafa0710",
                                "sense_id": "b771a3f1-40ca-32a5-94a9-53b38203830d",
                                "text": "„Eines Tages beorderte mich der Arbeitseinteiler Voss, die Betten aus den Quartieren der Russenmädchen zu entwanzen.“"
                            },
                            {
                                "example_id": "eb17a722-acae-4b9d-a609-6a07192503a8",
                                "sense_id": "b771a3f1-40ca-32a5-94a9-53b38203830d",
                                "text": "„Es erschienen der Arbeitseinteiler und der Aufseher.“"
                            },
                            {
                                "example_id": "64ac3724-5975-42b1-ba05-f8532fb297b3",
                                "sense_id": "b771a3f1-40ca-32a5-94a9-53b38203830d",
                                "text": "„Der Arbeitseinteiler ist ja bereit dazu, natürlich, unbedingt, morgen machen wir's ganz sicher, es vergeht eine Woche und noch eine, und wir sind noch immer ohne Licht. Ich kann leider so eine Lampe nicht aufhängen, das ist Facharbeit.“"
                            },
                            {
                                "example_id": "5e0862b2-b56d-478d-aa38-876e1cc56034",
                                "sense_id": "b771a3f1-40ca-32a5-94a9-53b38203830d",
                                "text": "„Der Arbeitseinteiler rief die Brigade auf, und die Gefangenen dieser Brigade lösten sich aus der Menge und gingen zum Tor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
