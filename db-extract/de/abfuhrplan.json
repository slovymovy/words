                "senses": [
                    {
                        "sense_id": "665047de-2d50-39c3-b127-35c62748b7bd",
                        "entry_id": "12276109-18f9-3eaa-84f9-bf5fcc1a2c2a",
                        "glosses": [
                            "Plan, der Informationen über die (Müll-)Abfuhr enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8637ccea-bf63-4d14-a6d6-053044be8ea3",
                                "sense_id": "665047de-2d50-39c3-b127-35c62748b7bd",
                                "text": "„Die Symbole im Abfuhrplan wurden aktualisiert, dass diese teilweise als zu blass empfunden wurden, zu Missverständnissen in den Abfuhrterminen führten.“"
                            },
                            {
                                "example_id": "860bbb8f-24ba-4138-bafa-b59c8e15ea4d",
                                "sense_id": "665047de-2d50-39c3-b127-35c62748b7bd",
                                "text": "„Eine kleine Auflage von Druckexemplaren der Abfallinfo und der Abfuhrpläne liegen zur Selbstabholung bei den Ämtern bzw. Bürgerbüros der Städte und Gemeinden und beim Bürgerservice im Kreishaus.“"
                            }
                        ],
