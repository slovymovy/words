                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "to drop downwards"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to fall or let something fall"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "836f381a-810f-33cd-a2ff-acf3b44656d9",
                    "sense_definition": "Płynąć lub ciec strumieniem (o cieczach).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z kranu w kuchni <leci> tylko zimna woda.",
                            "target_lang_translations": {
                                "ru": "Из крана на кухне <течет> только холодная вода.",
                                "en": "Only cold water is <running> from the kitchen tap."
                            }
                        },
                        {
                            "text": "Krew <leci> mi z nosa, muszę usiąść i odpocząć.",
                            "target_lang_translations": {
                                "ru": "У меня из носа <идет> кровь, мне нужно сесть и отдохнуть.",
                                "en": "My nose is <bleeding>; I need to sit down and rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "spływać",
                        "kapać"
