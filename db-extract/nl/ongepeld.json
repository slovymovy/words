                                                "sense_id": "45e3c522-02af-3cfd-b8b9-a0794b23e684",
                                                "text": "At every table on the baseball field Friday night there were glass vases filled with unshelled peanuts, Cracker Jack and toy baseballs, with miniature bats rising like stems and capped by University of Miami batting helmets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28abaf9-4c18-3d25-ba4f-b7957bbbf8bf",
                                        "entry_id": "5957bd1b-1c88-3adc-ae08-30cc86aa433a",
                                        "glosses": [
                                            "Not bombarded with military shells."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
