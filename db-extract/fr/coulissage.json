                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff442671-9d28-4eb4-884d-f4981cf32ddb",
                                "sense_id": "cfb66ca4-29e7-3606-b2b5-2540fec78771",
                                "text": "Le coulissage d’un tiroir, quel que soit le système adapté, impose un parallélisme rigoureux en largeur comme en hauteur avec un jeu minimum pour en garantir le bon fonctionnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "58ea5261-7579-372f-bfc8-baa52933c702",
                        "entry_id": "57dd6adc-3fb5-3425-968d-c56da00a7224",
                        "glosses": [
                            "Phénomène observé lorsque deux zones de plaques tectoniques en contact coulissent en sens inverse l’une par rapport à l’autre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "16ac63e5-2428-4db6-b6ea-5d2e35a503fa",
                                "sense_id": "58ea5261-7579-372f-bfc8-baa52933c702",
                                "text": "La surrection des orogènes calédoniens, fait exclusivement laurasien, rive pour longtemps l’Amérique du Nord à l’Europe, encore qu’un coulissage demeure actif le long de la faille du Glen et de son prolongement en Amérique du Nord."
                            },
                            {
                                "example_id": "4ac185b6-d5e9-4303-abde-9d663e1ea5d4",
                                "sense_id": "58ea5261-7579-372f-bfc8-baa52933c702",
                                "text": "Le coulissage des plaques se produit lorsque deux plaques en contact pivotent en sens inverse ou à des vitesses différentes."
                            }
                        ]
                    }
