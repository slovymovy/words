                        "glosses": [
                            "rope, chain, or band that crosses the saddle of a horse to support the attachment of a cart."
                        ],
                        "tags": [
                            "Scotland",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9844d058-cf65-46d9-88b2-968b0abed1ad",
                                "sense_id": "0ce7c7f2-39d1-385f-9faf-5d19a5b62ffa",
                                "text": "But even this will not answer, as both the outside Horses must have distinct rigwoodies, and would seldom or never, have equal weight upon their backs."
                            },
                            {
                                "example_id": "31e6b7aa-7ed2-449b-bfdc-9b2edf483f8f",
                                "sense_id": "0ce7c7f2-39d1-385f-9faf-5d19a5b62ffa",
                                "text": "...polished Scotch cart rigwoodie, with shaft rings, draught chains, &c,"
                            },
                            {
                                "example_id": "ad5c8e8c-bd8e-4c2e-8d94-abf4d9565e20",
                                "sense_id": "0ce7c7f2-39d1-385f-9faf-5d19a5b62ffa",
                                "text": "According to his statement, the accident was due to the rigwoodie getting loose while he was going downhill, in consequence of which the cart came upon the horse's hindquarters, and so startled it as to cause it to bolt."
                            }
                        ]
