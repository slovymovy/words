                                                "sense_id": "ad8cc3bf-2abf-347f-9ae2-ccbd6929f3d8",
                                                "text": "En Allemagne, la durée moyenne d’un salarié à temps plein est passée de 1663 à 1682 heures annuelles entre 2003 et 2006."
                                            },
                                            {
                                                "example_id": "c1e3b1ae-ef8c-4811-9788-39375a1473ca",
                                                "sense_id": "ad8cc3bf-2abf-347f-9ae2-ccbd6929f3d8",
                                                "text": "Un ranch pratiquant le naissage aura besoin d’un homme à temps plein pour 400-500 têtes en raison des soins à donner aux veaux à la naissance."
                                            }
                                        ]
                                    }
