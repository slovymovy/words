                                        "entry_id": "f850aba7-3db4-36ec-94a3-f929a2fe19ac",
                                        "glosses": [
                                            "One who believes that it is possible to realize a cognition or concept of the Absolute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b5493e-8a77-4179-91b4-68f3d4c53a9e",
                                                "sense_id": "230c327b-16bc-3769-9ea7-2c044d350e06",
                                                "text": "the unitarian — whether materialist, idealist, or absolutist"
                                            },
                                            {
                                                "example_id": "2b986c52-23cd-4e7a-93ee-0fc40b3dbb71",
                                                "sense_id": "230c327b-16bc-3769-9ea7-2c044d350e06",
                                                "text": "When absolutists reject humanism because they feel it to be untrue, that means that the whole habit of their mental needs is wedded already to a different view of reality, in comparison with which the humanistic world seems but the whim of a few irresponsible youths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e184bb0-62f1-3a4a-8fe9-a5d28c297edb",
                                        "entry_id": "f850aba7-3db4-36ec-94a3-f929a2fe19ac",
                                        "glosses": [
                                            "An uncompromising person; one who maintains certain principles to be absolute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf362da4-97af-42ef-b82d-ed6e7c363da9",
                                                "sense_id": "6e184bb0-62f1-3a4a-8fe9-a5d28c297edb",
                                                "text": "The billionaire tech mogul, who has described himself as a free speech absolutist, introduced a new red line this week after he claimed that a car carrying one of his children was accosted by a “crazy stalker.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4faced39-89a5-313d-94fb-ded7d7af0171",
                                        "entry_id": "620bb1f5-ed37-38d6-b398-a44b061f1fb6",
                                        "glosses": [
                                            "Of or pertaining to absolutism; arbitrary; despotic; uncompromising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4639d0be-300e-4c04-aeb3-8b6e2055126c",
                                                "sense_id": "4faced39-89a5-313d-94fb-ded7d7af0171",
                                                "text": "The best and the worst features of the communal regime are illustrated in the resistance of the Lombard cities to Frederic Barbarossa, the first Emperor who formulated and applied to Italy a scheme of absolutist government."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
