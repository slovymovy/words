                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                        "entry_id": "f18ba246-99bf-33b2-b7f0-5005a1541985",
                        "glosses": [
                            "Relatif à l’audition ou à l’ouïe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c153129-c0a9-4505-86a4-3d28f8fdfd8a",
                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                "text": "Cette différence entre la sensibilité auditive chez les deux batraciens tient, suivant les auteurs, à ce que, pour le crapaud, animal terrestre, le bruit a plus d’importance que pour la grenouille, animal aquatique."
                            },
                            {
                                "example_id": "21b89b07-4d97-452f-bd88-1c1a8f29f0c0",
                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                "text": "Il a été prouvé que la privation de sommeil entraîne une baisse de la résistance aux distractibilités visuelle et auditive (Harrison et Horne, 2000b)."
                            },
                            {
                                "example_id": "9bd4689c-ce52-48ce-acf2-cfd2e2561039",
                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                "text": "L'oreille coupée de Van Gogh est probablement l'effet d'un rituel qui devait le protéger contre des hallucinations auditives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82ee3ef4-461c-4dfb-acd2-64256425dc3c",
                        "source_entry_id": "f18ba246-99bf-33b2-b7f0-5005a1541985",
                        "source_sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                        "target_lang_word": "aural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eed0cc90-2ca2-3c1d-857f-376b06ccaa2a",
                                        "entry_id": "f8b9b1e9-4320-3fef-aa0d-1cdee4246a91",
                                        "glosses": [
                                            "Of or pertaining to the ear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3987297-eeb0-4757-81f2-ece1e18237b1",
                                                "sense_id": "eed0cc90-2ca2-3c1d-857f-376b06ccaa2a",
                                                "text": "The aural surgeon attends Mondays and Thursdays, at half-past one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690fb376-29f5-321b-8755-44df48235f8a",
                                        "entry_id": "f8b9b1e9-4320-3fef-aa0d-1cdee4246a91",
                                        "glosses": [
                                            "Of or pertaining to sound or hearing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42d5cc4-b187-4aa5-a243-b0306971e625",
                                                "sense_id": "690fb376-29f5-321b-8755-44df48235f8a",
                                                "text": "This is Radio Clash using aural ammunition"
                                            },
                                            {
                                                "example_id": "6a431465-a910-4e6c-9d8f-2880c6d653cb",
                                                "sense_id": "690fb376-29f5-321b-8755-44df48235f8a",
                                                "text": "The meaning of the songs transcended their subject matter; for me they are an aural history that speaks more clearly than any book ever could, not just about dancing and having sex but about being alive in the late '70s."
                                            },
                                            {
                                                "example_id": "c676b8b2-0456-45da-8f05-a4e01f6811ea",
                                                "sense_id": "690fb376-29f5-321b-8755-44df48235f8a",
                                                "text": "Clark made the album with producer Jack Antonoff, current collaborator of choice for Taylor Swift and Lorde. His involvement didn’t have a huge aural impact – the thrillingly disjointed but melodically gorgeous St Vincent sound remained intact – but his inclination for taking real-life trauma and fashioning it into pop took the album a step beyond Clark’s previous work."
                                            },
                                            {
                                                "example_id": "0f8c5f69-bd09-48e2-81df-980ebd5f6b72",
                                                "sense_id": "690fb376-29f5-321b-8755-44df48235f8a",
                                                "text": "He was alive to every creak and dunt, the thinness of the walls, as if the tenement block was a kind of aural panopticon that funnelled every sound to the other residents, let everyone eavesdrop on their business."
                                            }
                                        ]
                                    }
                                ]
                            },
