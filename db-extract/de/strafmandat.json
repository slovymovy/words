                        "source_entry_id": "8f1e8007-52eb-3a91-941d-b260aab728dd",
                        "source_sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                        "source_sense_description": "schriftliche Verfügung in einem abgekürzten Verfahren; auch deren Inhalt und die Höhe der Verfügung",
                        "target_lang_word": "procès-verbal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procès-verbal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d79f3743-e0e2-3140-81d6-615f9f5e5293",
                                        "entry_id": "7c619eb3-7894-3dc1-82e3-2791b8fadd57",
                                        "glosses": [
                                            "Acte par lequel un gendarme, un policier, un garde champêtre, etc., constate une contravention, un délit."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a6d2b0-cc98-4307-9962-15dc20aae9b9",
                                                "sense_id": "d79f3743-e0e2-3140-81d6-615f9f5e5293",
                                                "text": "Il assura sa table, s’assit devant, demanda la chandelle, que le docteur lui apporta, en enjambant par-dessus le cadavre, tira de sa poche un encrier, des plumes, du papier, et commença son procès-verbal."
                                            },
                                            {
                                                "example_id": "0c4d9966-b308-4ceb-852c-921c7c0fcc95",
                                                "sense_id": "d79f3743-e0e2-3140-81d6-615f9f5e5293",
                                                "text": "Il se leva laborieusement, posa un fragment de corail sur son procès-verbal pour que l’alizé ne l'emportât point et, de la galerie, passa dans la maison, qu’il traversa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44b9dc3-aff5-3d76-a9ed-5d1131fd2e3d",
                                        "entry_id": "7c619eb3-7894-3dc1-82e3-2791b8fadd57",
                                        "glosses": [
                                            "Relation par laquelle une personne qualifiée constate un fait."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c40462f-ae7c-418f-98db-7b17f1272480",
                                                "sense_id": "c44b9dc3-aff5-3d76-a9ed-5d1131fd2e3d",
                                                "text": "A l'égard des interlopes qui demandent à entrer dans les ports sur le prétexte d'une relâche forcée, il faudroit les assujettir à une visite préalable de la part des officiers de la patache, dont il seroit dressé un procès-verbal signé par eux & par les officiers des vaisseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fb47d4-34fe-37bc-963e-7badf559ae8f",
                                        "entry_id": "7c619eb3-7894-3dc1-82e3-2791b8fadd57",
                                        "glosses": [
                                            "Compte-rendu d’un fait par une personne qualifiée, de la séance d’une assemblée, d’une réunion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a9eacd9-c89a-4f24-87d3-15ae6052b976",
                                                "sense_id": "82fb47d4-34fe-37bc-963e-7badf559ae8f",
                                                "text": "Il en sera fait mention au procès-verbal. - La lecture du procès-verbal. - Le procès-verbal est approuvé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
