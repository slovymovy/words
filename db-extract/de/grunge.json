                    },
                    {
                        "sense_id": "7ed69336-19c7-31f5-a908-4bec117a96f0",
                        "entry_id": "098a6a65-d0ae-38b7-bc8d-94e7e78e0611",
                        "glosses": [
                            "Mode, die bewusst schmuddelig und ungepflegt aussieht und mit [1] in Verbindung steht"
                        ],
