            "senses": [
                {
                    "sense_id": "0f9a957b-7ec3-36c4-93fe-de30bc4d233c",
                    "sense_definition": "A grammatical mood or construction indicating fear of an undesired outcome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some languages, the <w>apprehensive</w> is used to warn the listener of potential danger.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках <w>аппрегензив</w> используется для предупреждения слушателя о потенциальной опасности.",
                                "de": "In einigen Sprachen wird der <w>Apprehensiv</w> verwendet, um den Zuhörer vor potenzieller Gefahr zu warnen."
                            }
                        },
                        {
                            "text": "The linguist analyzed the use of the <w>apprehensive</w> in indigenous Australian languages.",
                            "target_lang_translations": {
                                "ru": "Лингвист проанализировал использование <w>аппрегензива</w> в языках коренных народов Австралии.",
                                "de": "Der Linguist analysierte den Gebrauch des <w>Apprehensivs</w> in indigenen australischen Sprachen."
                            }
                        }
                    ],
                    "synonyms": [
