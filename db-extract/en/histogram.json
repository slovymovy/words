                                "target_senses": [
                                    {
                                        "sense_id": "41010439-5ad7-3976-b5f3-9153216f23c9",
                                        "entry_id": "76f0dbd0-7ec1-3db4-b903-ba5adfa5c9a8",
                                        "glosses": [
                                            "Diagramme représentant une série de fréquences statistiques d’un phénomène donné par des rectangles juxtaposés à base constante et dont la hauteur est proportionnelle à la quantité exprimée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b51f790-c4d4-45f5-a30f-4776697ca2a6",
                                                "sense_id": "41010439-5ad7-3976-b5f3-9153216f23c9",
                                                "text": "Le résultat sur chaque histogramme se lit comme le différentiel de croissance annuelle des quantités vendues par marché, en points de pourcentage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c029ed6d-547a-4c65-8859-cc0174c017c1",
                        "source_entry_id": "f13cb117-3a8c-3d1b-8e40-6bb2aacdab0d",
