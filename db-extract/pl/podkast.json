                    {
                        "sense_id": "0e46ba33-140d-36ed-8cde-b8d611d60207",
                        "entry_id": "7f5bcda4-c0a8-3de6-a343-835b750a1112",
                        "glosses": [
                            "audycja w formie radiowej umieszczona w internecie z kanałem RSS umożliwiającym subskrybowanie przez słuchaczy"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "5430f7d1-f486-4227-acca-8e12677e95b6",
                                "sense_id": "0e46ba33-140d-36ed-8cde-b8d611d60207",
                                "text": "Lubię słuchać podkastów."
                            },
                            {
                                "example_id": "38161990-678b-4bfe-b008-4c0c221aef9e",
                                "sense_id": "0e46ba33-140d-36ed-8cde-b8d611d60207",
                                "text": "Z podkastów można się wiele nauczyć."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86eb9ef9-df01-44aa-a324-fe3ac32b0e3a",
                        "source_entry_id": "7f5bcda4-c0a8-3de6-a343-835b750a1112",
                        "source_sense_id": "0e46ba33-140d-36ed-8cde-b8d611d60207",
                        "target_lang_word": "podcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                        "entry_id": "686815b3-5d92-3343-abb2-c255eb052b8e",
                                        "glosses": [
                                            "A program, especially an audio program, produced on a regular basis, delivered over the Internet in a compressed digital format and designed for playback on computers or portable devices such as mobile phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa6db37-0b3f-4d09-91f2-7dc2b4b9af4f",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "There's no restriction for what a podcast should and should not be. Of course, if you cover all these topics and more, you may find it harder to find an audience than if you focus on a narrower range and cover it well. Finding listeners is simpler if your podcast can be summarized in a sentence. More people will sample your show if it fits in a category in a podcast directory—like that found in the iTunes Store—than if it ends up lumped in a generic catch-all list."
                                            },
                                            {
                                                "example_id": "91521821-5437-40c3-b128-568dc17c8ce0",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "Try listening to a mix of well-known podcasts. You'll soon find that the best always feature hosts that have their own unique voice."
                                            },
                                            {
                                                "example_id": "a68d554a-8dec-46f3-b5f0-95526b62cb12",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "Yet some Monday-morning quarterbacks also noted that, just as 1960 was the first TV election and 2016 was the first social-media election, the 2024 Presidential campaign was the first to be conducted largely on live streams and long-form podcasts, media that happen to be thoroughly dominated by MAGA bros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99593d27-593a-368a-b31f-ecae0a1c1d18",
                                        "entry_id": "686815b3-5d92-3343-abb2-c255eb052b8e",
                                        "glosses": [
                                            "An individual episode of such a program."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "podcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63acd7bc-af3d-399e-a9cc-01078d536709",
                                        "entry_id": "d593d2a3-155c-3ea9-bc47-ffa386d06eb1",
                                        "glosses": [
                                            "To deliver (information) in the form of a program, especially an audio program, over the Internet on a regular basis for playback on computers or portable devices such as mobile phones."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
