        "nl-extract.jsonl": [
            {
                "entry_id": "09315b7a-6610-3188-bfd9-e3cfbc0f6bc2",
                "word": "gezanik",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6edd2562-553f-32cb-98a5-4d7493431bcf",
                        "entry_id": "09315b7a-6610-3188-bfd9-e3cfbc0f6bc2",
                        "glosses": [
                            "op een hinderlijke manier aanhoudend, nutteloos en ongefundeerd geklaag"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5bfab590-fac2-43ea-95fc-79e861511ac3",
                                "sense_id": "6edd2562-553f-32cb-98a5-4d7493431bcf",
                                "text": "Maar wat me verbaasde, was dat mijn zus de grappen kalm over zich heen liet komen, beleefd lachte, en iedereen liet uitspreken. Ze ging met niemand in discussie en onderging alles zo gelaten dat ik haar er even van verdacht dat ze laxeermiddel in de schaal bowl had gedaan. Een massale race naar de wc bleef uit en ik, moe van al het gezanik over de liefste zoogdiertjes ter wereld, pakte mijn jas."
                            },
                            {
                                "example_id": "c5129972-52b2-4c67-a2ac-eb4079485f92",
                                "sense_id": "6edd2562-553f-32cb-98a5-4d7493431bcf",
                                "text": "— Het is diefstal, u zult zich hiervoor moeten verantwoorden, waarde heer! zei de infanterieofficier nogmaals met stemverheffing.\n— En waarom zit u zo achter me aan? Hè? schreeuwde Denisov ineens woest. Ik moet verantwoording afleggen en niet u, hou op met dat gezanik, anders zult u wat beleven! Mars! schreeuwde hij tegen de officieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "87d5cafb-e73d-3e9b-9a3f-d20d2b73631c",
                        "entry_id": "09315b7a-6610-3188-bfd9-e3cfbc0f6bc2",
                        "glosses": [
                            "iets waar iemand een groot probleem van maakt"
                        ],
