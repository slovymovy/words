                                    {
                                        "sense_id": "851340fb-66cc-3a06-b026-38c443e3e92c",
                                        "entry_id": "355c9f08-0ea8-376f-b5ad-9bb717e1a8a3",
                                        "glosses": [
                                            "Of, from or relating to Catalonia, Spain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25948301-600f-4b67-a21c-705533f280d7",
                                                "sense_id": "851340fb-66cc-3a06-b026-38c443e3e92c",
                                                "text": "The PSOE leader, who once promised to bring Puigdemont back to Spain to face justice, risked considerable political capital two years ago by pardoning nine of the Catalan leaders behind the drive for secession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214735d6-d954-42fc-a9bd-f9e7cb1f4118",
                        "source_entry_id": "c7754d6b-8fa5-3cc4-9059-f856f504c8e9",
                        "source_sense_id": "e0a161fc-cba2-3c57-92a4-b33a9b831e36",
                        "target_lang_word": "Catalan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
