                "forms": [],
                "senses": [
                    {
                        "sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
                        "entry_id": "04eec803-077e-35aa-a134-2643cd3298a4",
                        "glosses": [
                            "die Kardinalzahl zwischen 99.999 und 100.001; zehn hoch fünf (100 000)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e56fdff-863d-46c8-9985-9654e1ca53ff",
                                "sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
                                "text": "Einhundert Kilometer sind hunderttausend Meter."
                            },
                            {
                                "example_id": "6a1ef4e6-ee79-435a-b0eb-b204b565ce55",
                                "sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
                                "text": "„Ein Teil davon fehlt. Ungefähr hunderttausend Dollar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6025da98-64d0-4f73-9a70-71bf2dc1952d",
                        "source_entry_id": "04eec803-077e-35aa-a134-2643cd3298a4",
                        "source_sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
                        "target_lang_word": "hundred thousand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hundred thousand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ea1144-d19b-3766-94fc-c06b07eee434",
                                        "entry_id": "06680b64-7cde-3fea-9458-5cc20b2ea4b8",
                                        "glosses": [
                                            "The cardinal number 100,000."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f61abfa-a925-42b1-87be-9f66461d3344",
                                                "sense_id": "22ea1144-d19b-3766-94fc-c06b07eee434",
                                                "text": "Madame Chevalier, who with a word could have caused her aged mother to have been brought in triumph to Petersburg, and supported there in ease and abundance; who reckoned her fortune by hundred thousands of rubles, sent her indigent parent two hundred rubles."
                                            },
                                            {
                                                "example_id": "e127a643-749f-4c3f-80d7-228d6d88ea8e",
                                                "sense_id": "22ea1144-d19b-3766-94fc-c06b07eee434",
                                                "text": "Mr. Greenshields was the contractor selected to build the embankment, and over a hundred thousand tons of marl and moss compacted with brushwood were used in its construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d58e2b02-63a6-4cb5-b6b2-2d4bf208d536",
                        "source_entry_id": "04eec803-077e-35aa-a134-2643cd3298a4",
                        "source_sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
                        "target_lang_word": "cent mille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cent mille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28c3a52f-7e27-32bf-917c-457fbe26bfdc",
                                        "entry_id": "ce23edb7-883c-39eb-a957-312c79b72efa",
                                        "glosses": [
                                            "Cent fois mille unités, 10⁵."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "173b4e2f-24a1-41a1-9404-e895502ba027",
                                                "sense_id": "28c3a52f-7e27-32bf-917c-457fbe26bfdc",
                                                "text": "[…]: Stendhal a montré, dans Lucien Leuwen, qu'en 1835, la monarchie parlementaire et bourgeoise de Louis-Philippe, pratiquait avec un art consommé toutes les turpitudes imaginables : on achetait l'élection d'un député avec cent mille francs, quelques nominations, quelques bureaux de tabac, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea4d07f-d4cf-3d47-8a55-92b96ee33070",
                                        "entry_id": "ce23edb7-883c-39eb-a957-312c79b72efa",
                                        "glosses": [
                                            "Quantité indéfinie mais fort grande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa939bdf-3536-438b-b808-25a36f8cb403",
                                                "sense_id": "1ea4d07f-d4cf-3d47-8a55-92b96ee33070",
                                                "text": "Il se promettait à lui-même, sur ses grands dieux, de ne jamais retomber dans un second guet-apens d’ascension, prétendant que les montagnes sont plus curieuses d’en bas que d’en haut, et qu’il fallait être enragé pour s’exposer à se rompre les os cent mille fois, et se faire geler le nez et les oreilles en plein mois d’août, en Andalousie, en vue de l’Afrique."
                                            },
                                            {
                                                "example_id": "c5329d6b-a8bd-4393-87f7-72d54e720d36",
                                                "sense_id": "1ea4d07f-d4cf-3d47-8a55-92b96ee33070",
                                                "text": "Il monta, cent mètres au-dessus de la roue, détourna le canal dans le torrent et, avec ses deux Piémontais, il se mit à faucarder soigneusement les herbes et à pelleter de gros gâteaux de cette boue noire qui puait comme cent mille diables."
                                            },
                                            {
                                                "example_id": "98ff8599-b1ea-44d9-ac3f-7b14ce7277ef",
                                                "sense_id": "1ea4d07f-d4cf-3d47-8a55-92b96ee33070",
                                                "text": "[…] ; enfin, elle était venue se mettre au seuil devant le village endormi, devant les tilleuls de la place qui murmuraient comme un ruisseau frais, face à face avec les cent mille étoiles."
                                            },
                                            {
                                                "example_id": "98385bc6-2182-4609-be38-2f948e131829",
                                                "sense_id": "1ea4d07f-d4cf-3d47-8a55-92b96ee33070",
                                                "text": "– Il y a bien une raison !\n– Il y en a cent mille, balbutia Françoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f78b83b1-89fa-46f7-b696-3c316fbabc9f",
                        "source_entry_id": "04eec803-077e-35aa-a134-2643cd3298a4",
                        "source_sense_id": "050f7276-3d9a-322f-8929-97cd0cb3dd0f",
