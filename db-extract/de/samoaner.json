                    {
                        "sense_id": "cea7b42e-bf66-3873-9457-4f406d2eed17",
                        "entry_id": "ccdc918b-d013-35ad-b51a-5052cbb53639",
                        "glosses": [
                            "Bewohner der Samoainseln (Staat Samoa (Westsamoa) und Amerikanisch-Samoa (Ostsamoa))"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9d0d4e-8780-46b2-acd3-e6824f10e133",
                                "sense_id": "cea7b42e-bf66-3873-9457-4f406d2eed17",
                                "text": "Wir trafen nachmittags einen Samoaner, der uns seine Tätowierung zeigte."
                            },
                            {
                                "example_id": "ced96c50-d474-4592-bd90-e5a9d31e22fa",
                                "sense_id": "cea7b42e-bf66-3873-9457-4f406d2eed17",
                                "text": "„Ein Farbphoto: Joan Crawford beim Bumsen mit einem für sein ungewöhnliches Gehänge bekannten, als Statist arbeitenden Samoaner namens ›O.K. Freddy‹.“"
                            },
                            {
                                "example_id": "a5f475da-ff3e-4ee4-8b92-38a52f79cbec",
                                "sense_id": "cea7b42e-bf66-3873-9457-4f406d2eed17",
                                "text": "„Die Samoaner mussten sich verpflichten, eine gewisse Anzahl von Kokospalmen pro Jahr zu pflanzen und Kopfsteuer zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
