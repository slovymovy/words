                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "herencia",
                                "target_lang_sense_clarification": "uso cotidiano, bienes heredados"
                            },
                            {
                                "target_lang_word": "sucesión",
                                "target_lang_sense_clarification": "ámbito jurídico y notarial"
                            },
                            {
                                "target_lang_word": "caudal hereditario",
                                "target_lang_sense_clarification": "lenguaje jurídico formal"
                            }
                        ],
                        "zh": [
