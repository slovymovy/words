                        "source_sense_id": "d41c7e9e-880a-3a16-9364-15feba51d005",
                        "source_sense_description": "als iets meer baten dan kosten heeft",
                        "target_lang_word": "lukrativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lukrativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                        "entry_id": "7ee1e333-ab7a-3029-8749-b9db0b8b7b6f",
                                        "glosses": [
                                            "finanziell einen hohen Gewinn versprechend/abwerfend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed69e8e3-627b-4064-96e1-a6fd4282306c",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Für Trump und seine Familie ist die Präsidentschaft ein lukratives Geschäft.“"
                                            },
                                            {
                                                "example_id": "ac0b3d1a-93ff-4091-b95f-db3bb37d539a",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "Dies ist ein überaus lukratives Angebot."
                                            },
                                            {
                                                "example_id": "14855129-aab5-4ffb-bd65-42a2d12a8a4c",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Nach Drogen und Waffen zähle der internationale Kunst-Schwarzmarkt zu den lukrativsten Geschäften der Welt.“"
                                            },
                                            {
                                                "example_id": "029523fb-dc7d-439e-9ce3-ecbac30d6746",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Nach nur zwei Bewerbungen bekam er einen lukrativen Job bei einer Versicherung.“"
                                            },
                                            {
                                                "example_id": "f3ebbe99-9190-49d0-8503-cfca5eab981e",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            },
                                            {
                                                "example_id": "963ca935-07ff-465d-b0d6-3dc4dc2c8547",
                                                "sense_id": "6685bd7b-c1aa-310b-8801-1551f06e41fd",
                                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner. Und die Studenten, die es gibt, spezialisieren sich lieber und übernehmen eine lukrative Facharztpraxis in einem Ballungsgebiet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
