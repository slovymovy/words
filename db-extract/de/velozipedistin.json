                        "examples": [
                            {
                                "example_id": "6de9bf44-fb64-4098-b9ef-42744554f60c",
                                "sense_id": "a8a317d9-034e-3fba-8f5a-055a98af4d3d",
                                "text": "Als Velozipedistin legt Frau Schmidt bei der Auswahl ihres Urlaubsorts gesteigerten Wert auf ein gut ausgebautes Netz von Fahrradwegen."
                            },
                            {
                                "example_id": "609f76a3-f839-4b86-8bab-e0c627cead47",
                                "sense_id": "a8a317d9-034e-3fba-8f5a-055a98af4d3d",
                                "text": "Zur großen Erleichterung der Velozipedistin ging ihr Sturz im Kreisverkehr glimpflich aus."
                            }
                        ],
