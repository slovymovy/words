                "senses": [
                    {
                        "sense_id": "9ba7240e-3739-3b02-b12e-c55480e0c102",
                        "entry_id": "3bf0a948-3238-39b0-889b-f6a14f4a2ec8",
                        "glosses": [
                            "Lupinus L., rodzaj roślin z rodziny bobowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09126aeb-1a0a-4565-b78a-16cfcf8551f9",
                                "sense_id": "9ba7240e-3739-3b02-b12e-c55480e0c102",
                                "text": "Do głównych surowców wysokobiałkowych pochodzenia roślinnego zaliczamy rzepak i strączkowe gruboziarniste: bobik, łubin, groch."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b136dae9-1b0f-3c93-a017-8c2f9987df6c",
