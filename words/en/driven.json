{
    "word_family": [
        "drive",
        "driver",
        "driveway",
        "overdrive",
        "screwdriver",
        "drivetrain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "571e7820-04bd-3768-834d-67203ff43e20",
                    "sense_definition": "The past participle of <w>drive</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have <w>driven</w> all night to reach the coast by morning.",
                            "target_lang_translations": {
                                "ru": "Мы <w>ехали</w> всю ночь, чтобы добраться до побережья к утру.",
                                "zh": "我们<w>驾驶</w>了一整夜，终于在清晨到达了海岸。"
                            }
                        },
                        {
                            "text": "The cattle were <w>driven</w> into the barn before the storm started.",
                            "target_lang_translations": {
                                "ru": "Скот был <w>загнан</w> в сарай до начала шторма.",
                                "zh": "暴风雨开始前，牛群被<w>驱赶</w>进了谷仓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have driven",
                        "be driven",
                        "had driven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола drive (водить, гнать).",
                        "zh": "动词 drive 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загнанный",
                                "target_lang_sense_clarification": "о животных или людях, принужденных двигаться куда-то"
                            },
                            {
                                "target_lang_word": "ведомый",
                                "target_lang_sense_clarification": "управляемый кем-то (об автомобиле или механизме)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾驶",
                                "target_lang_sense_clarification": "指操作车辆行驶"
                            },
                            {
                                "target_lang_word": "驱赶",
                                "target_lang_sense_clarification": "指迫使动物或人移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c66a194a-a945-30ab-a9d3-593baf3913a1",
                    "sense_definition": "Passionately motivated to achieve goals and succeed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>driven</w> student who studies hard every single day.",
                            "target_lang_translations": {
                                "ru": "Она <w>целеустремленная</w> студентка, которая усердно учится каждый день.",
                                "zh": "她是一位<w>有进取心</w>的学生，每天都刻苦学习。"
                            }
                        },
                        {
                            "text": "He is <w>driven</w> by a strong desire to help his community.",
                            "target_lang_translations": {
                                "ru": "Он <w>движим</w> сильным желанием помочь своему сообществу.",
                                "zh": "他受到帮助社区的强烈愿望所<w>驱动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambitious",
                        "motivated",
                        "determined"
                    ],
                    "antonyms": [
                        "non-driven"
                    ],
                    "common_phrases": [
                        "highly driven",
                        "driven by success",
                        "driven person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страстно мотивированный на достижение целей и успех.",
                        "zh": "指一个人充满动力，渴望实现目标并取得成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целеустремленный",
                                "target_lang_sense_clarification": "настойчивый в достижении целей"
                            },
                            {
                                "target_lang_word": "мотивированный",
                                "target_lang_sense_clarification": "имеющий сильное побуждение к действию"
                            },
                            {
                                "target_lang_word": "одержимый",
                                "target_lang_sense_clarification": "страстно увлеченный идеей или целью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有进取心的",
                                "target_lang_sense_clarification": "形容人积极向上，渴望成功"
                            },
                            {
                                "target_lang_word": "目标明确的",
                                "target_lang_sense_clarification": "形容人做事有清晰的目标和动力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be6645f-4563-321d-98eb-6222feecc7b5",
                    "sense_definition": "Piled into drifts or heaps by the wind, especially referring to snow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>driven</w> snow piled up against the door, trapping them inside.",
                            "target_lang_translations": {
                                "ru": "<w>Наметенный</w> снег скопился у двери, заперев их внутри.",
                                "zh": "被风吹<w>积聚</w>的雪堆在门口，把他们困在了里面。"
                            }
                        },
                        {
                            "text": "Walking through the deep, <w>driven</w> snow was exhausting work.",
                            "target_lang_translations": {
                                "ru": "Идти по глубокому, <w>наметенному</w> снегу было изнурительной работой.",
                                "zh": "在深厚且被风吹<w>积聚</w>的雪地里行走是一项极其耗费体力的工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "driven snow",
                        "wind-driven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наметенный ветром в сугробы или кучи (особенно о снеге).",
                        "zh": "指被风吹积成堆的，尤指雪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наметенный",
                                "target_lang_sense_clarification": "принесенный ветром (о снеге)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积聚的",
                                "target_lang_sense_clarification": "指被风吹到一起堆积起来的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}