                "senses": [
                    {
                        "sense_id": "654a07e2-9747-35cd-a29c-3cf69d4c3a92",
                        "entry_id": "1a0ea7e4-7142-3c1a-a96b-035958021355",
                        "glosses": [
                            "Person, die bei einem Unternehmen der Post im Beamtenverhältnis beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1829811-5607-4995-940a-101ec9183c9a",
                                "sense_id": "654a07e2-9747-35cd-a29c-3cf69d4c3a92",
                                "text": "„Nicht von ungefähr sind es, zumindest in Deutschland, vor allem unterbeschäftigte Postbeamte, die durch die Zusammenstellung und private Publikation von Eisenbahnkursbüchern ihr schmales Salär aufbessern.“"
                            },
                            {
                                "example_id": "7eddd339-a85f-482d-adf5-4f20cf077c13",
                                "sense_id": "654a07e2-9747-35cd-a29c-3cf69d4c3a92",
                                "text": "„Als Sohn eines Postbeamten in einem abgelegenen Alpental aufgewachsen, war er dazu bestimmt, das Amt seines Vaters zu übernehmen.“"
                            },
                            {
                                "example_id": "957a9ec7-1927-4062-9b36-ac32058ce3e3",
                                "sense_id": "654a07e2-9747-35cd-a29c-3cf69d4c3a92",
                                "text": "„Gleichzeitig brachten Postbeamte die Telegrafendrähte zum Glühen, indem sie die Proklamation so schnell wie möglich im gesamten Reich verbreiteten.“"
                            },
                            {
                                "example_id": "ba43d380-5db2-43b9-893a-a69551840443",
                                "sense_id": "654a07e2-9747-35cd-a29c-3cf69d4c3a92",
                                "text": "„Nicht nur, dass ein großer Teil der Postbeamten abgezogen wurde, um die Aufgaben der Feldpost zu erledigen, sondern auch unter den verbliebenen Postbediensteten in den Städten wurden erhebliche Lücke gerissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
