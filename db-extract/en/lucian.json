                                            {
                                                "example_id": "36efbe5c-d4dd-47be-aae2-a52578c68163",
                                                "sense_id": "cc1791a6-4708-36b6-9f5b-7a6ecaec4c12",
                                                "text": "Tout ça me fait penser à une vieille blague de Lucien Boyer."
                                            },
                                            {
                                                "example_id": "17ac86ba-bcb1-413b-9bf0-b29d5e199eb8",
                                                "sense_id": "cc1791a6-4708-36b6-9f5b-7a6ecaec4c12",
                                                "text": "J’ai résumé les refus de Lucien par son invective hautaine de mari fidèle et d’honnête homme : « Garde l’Europe, j’ai ma femme ! » et pour le reste j’ai théàtrifié la scène de mon mieux."
                                            },
                                            {
                                                "example_id": "8e6fed90-36ea-4706-81b9-ad328ef5262e",
                                                "sense_id": "cc1791a6-4708-36b6-9f5b-7a6ecaec4c12",
                                                "text": "Lucien Decourcelle ne perd pas la main sous l’œil d’Émile Riou et de Jean-Luc Riou, ce 28 juillet."
                                            }
                                        ]
                                    }
