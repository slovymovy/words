                    },
                    {
                        "translation_id": "a72ae333-5153-422a-b04d-b4da9aa423c7",
                        "source_entry_id": "fb767920-08cc-30ce-99e3-424e2a8df678",
                        "source_sense_id": "8bf96d46-1d5a-344c-be35-c40affb06b11",
                        "source_sense_description": "Kufe an einem Schlitten",
                        "target_lang_word": "patin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef705bc2-f843-3b10-aa5f-78b0580ad028",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Sorte de semelle fort épaisse que l’on porte pour faire certains travaux de ménage ou pour se préserver de l’humidité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cde3dee9-0f10-3430-8805-8c943202e9eb",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Pantoufle."
                                        ],
                                        "tags": [
                                            "Régional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b7c49f-5009-46e3-9504-a8dd8abebafb",
                                                "sense_id": "cde3dee9-0f10-3430-8805-8c943202e9eb",
                                                "text": "Mets des patins, tu vas attraper froid !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f704dd5-f2ec-3c7b-b17b-5312dcd118e9",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Objet plat, en feutre ou autre matière, de forme rectangulaire épousant ou non la forme d'un pied, utilisé pour se déplacer sur le parquet en gardant ses chaussures et en patinant pour avancer, afin d'éviter les rayures au sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ba5d65-d4c2-4fce-b8f8-eb2b959b675d",
                                                "sense_id": "0f704dd5-f2ec-3c7b-b17b-5312dcd118e9",
                                                "text": "Dans la croisée la plus rapprochée de la porte, se trouvait une chaise de paille dont les pieds étaient montés sur des patins, afin d’élever madame Grandet à une hauteur qui lui permit de voir les passants."
                                            },
                                            {
                                                "example_id": "3a08eb5f-ba9b-44a1-a27c-f8597e5bb8f6",
                                                "sense_id": "0f704dd5-f2ec-3c7b-b17b-5312dcd118e9",
                                                "text": "La mère idéale était une bourgeoise d’intérieur qui veillait sur l’intégrité de ses enfants et de son papier-peint, possédait un lave-vaisselle, concoctait des plats en sauce aux parfums subtils, traquait la poussière à longueur de journée et exigeait, à l’entrée de l’appartement, que l’on enfilât des patins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09de52f9-19cf-343b-930c-00993491c2be",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Tout type de chaussure qui permet de se déplacer en glissant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd17dd7f-836f-47a3-8fc2-4ce06e764bba",
                                                "sense_id": "09de52f9-19cf-343b-930c-00993491c2be",
                                                "text": "Un traîneau monté sur patins."
                                            },
                                            {
                                                "example_id": "aa2c0622-b6d1-4d64-ae4f-28e4d80366e7",
                                                "sense_id": "09de52f9-19cf-343b-930c-00993491c2be",
                                                "text": "Glisser sur des patins à roulettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c894ab2d-65ca-3ea5-bfcf-23b18535a559",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Coin de bois ou pièce en métal dont on se sert pour arrêter la roue d’une voiture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bb6fc87-3255-309d-8aef-91bb31c9400b",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Frein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78f6fcd-fecd-4388-a19e-77731f048445",
                                                "sense_id": "7bb6fc87-3255-309d-8aef-91bb31c9400b",
                                                "text": "Patin de freins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33fc17d-8bdd-30d8-9309-94d270f7c1a2",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Pièce de bois posé de niveau sous la charpente d’un escalier, pour la porter et lui servir de base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a50485e-744b-4b7f-8c0d-ff885b32b809",
                                                "sense_id": "f33fc17d-8bdd-30d8-9309-94d270f7c1a2",
                                                "text": "Le patin d’un escalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e34b7e-d3c7-3a24-8af7-c881a6c5382e",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Fer mis au pied d’un cheval, dans certains cas, pour le forcer à s’appuyer sur le pied opposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b0c84b-cfec-45d3-a1f2-5546f0c19730",
                                                "sense_id": "f7e34b7e-d3c7-3a24-8af7-c881a6c5382e",
                                                "text": "Fer à patin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afba6942-a3c4-3fb4-9c0a-51594fddd34c",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Partie médiane d’un ski correspondant à l’emplacement où le skieur fixe son pied."
                                        ],
                                        "tags": [
                                            "Sports d’hiver"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d05e4ba-b720-3728-951f-37728d413771",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Baiser lingual prolongé, pelle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1600ab-a51f-40d2-988a-acd510645f3f",
                                                "sense_id": "3d05e4ba-b720-3728-951f-37728d413771",
                                                "text": "Rouler un patin."
                                            },
                                            {
                                                "example_id": "db963ede-f0c9-4b38-bc80-13cb43c7a718",
                                                "sense_id": "3d05e4ba-b720-3728-951f-37728d413771",
                                                "text": "César (…) lui roula un patin. Cette fois, la frangine se laissa faire"
                                            },
                                            {
                                                "example_id": "7bfd0d0c-011c-4e22-975b-c56e3af4a027",
                                                "sense_id": "3d05e4ba-b720-3728-951f-37728d413771",
                                                "text": "Elle s’est tirée, mutine, en me filant un patin (…) en façon de m'assurer de son dévouement"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff6ad81-5555-3916-aabc-cfc8aad0d2ca",
                                        "entry_id": "5454fb9c-30b3-3a87-b34c-c48c421bfe3d",
                                        "glosses": [
                                            "Chaussure munie d’une épaisse semelle de bois."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9d6e8e-e861-430f-a52e-7148e3a455d7",
                                                "sense_id": "cff6ad81-5555-3916-aabc-cfc8aad0d2ca",
                                                "text": "Des feux s’allumèrent partout. C’étaient d’abord, tout proches, de hauts brasiers dont on voyait se tordre les flammes. Elles claquaient comme une danse de paysannes en patins sur un parquet de bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
