    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35a2a0e8-438b-3b74-865f-96404522e1e4",
                    "sense_definition": "Het eerste begin van een plant die uit een zaadje groeit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een paar dagen in de vochtige aarde kwam de eerste <w>kiem</w> al boven de grond.",
                            "target_lang_translations": {
                                "en": "After a few days in the moist soil, the first <w>sprout</w> already appeared above the ground."
                            }
                        },
                        {
                            "text": "De jonge <w>kiem</w> van de boon is erg kwetsbaar voor vorst.",
                            "target_lang_translations": {
                                "en": "The young <w>germ</w> of the bean is very vulnerable to frost."
                            }
                        }
                    ],
                    "synonyms": [
                        "spruit",
                        "uitloper"
                    ],
                    "common_phrases": [
                        "jonge kiem"
                    ],
                    "target_lang_definitions": {
                        "en": "The very first beginning of a plant growing from a seed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "germ",
                                "target_lang_sense_clarification": "biological embryo of a seed"
                            },
                            {
                                "target_lang_word": "sprout",
                                "target_lang_sense_clarification": "a young shoot from a seed"
                            },
                            {
                                "target_lang_word": "shoot",
                                "target_lang_sense_clarification": "new growth from a plant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82edc6af-cfcf-36c9-96cd-d408bc44024d",
                    "sense_definition": "Een microscopisch klein organisme, zoals een bacterie, dat een ziekte kan veroorzaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water was besmet met de <w>kiemen</w> van een dodelijke ziekte.",
                            "target_lang_translations": {
                                "en": "The water was contaminated with the <w>germs</w> of a deadly disease."
                            }
                        },
                        {
                            "text": "Goede hygiëne is essentieel om de verspreiding van schadelijke <w>kiemen</w> te voorkomen.",
                            "target_lang_translations": {
                                "en": "Good hygiene is essential to prevent the spread of harmful <w>germs</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ziektekiem",
                        "bacterie",
                        "microbe"
                    ],
                    "common_phrases": [
                        "besmet met kiemen"
                    ],
                    "target_lang_definitions": {
                        "en": "A microscopic organism, such as a bacterium, that can cause disease."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "germ",
                                "target_lang_sense_clarification": "pathogenic microorganism"
                            },
                            {
                                "target_lang_word": "bacterium",
                                "target_lang_sense_clarification": "single-celled organism"
                            },
                            {
                                "target_lang_word": "microbe",
                                "target_lang_sense_clarification": "microscopic life form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c73827fe-92c6-3728-b4c5-b6d8b60df3a5",
                    "sense_definition": "Het allereerste begin of de oorsprong van iets abstracts, zoals een idee of een conflict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat korte gesprek lag de <w>kiem</w> van hun latere ruzie.",
                            "target_lang_translations": {
                                "en": "In that short conversation lay the <w>seed</w> of their later argument."
                            }
                        },
                        {
                            "text": "De politie probeerde de opstand in de <w>kiem</w> te smoren voordat het uit de hand liep.",
                            "target_lang_translations": {
                                "en": "The police tried to nip the uprising in the <w>bud</w> before it got out of hand."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginsel",
                        "oorsprong",
                        "aanzet"
                    ],
                    "common_phrases": [
                        "in de kiem smoren"
                    ],
                    "target_lang_definitions": {
                        "en": "The very first beginning or origin of something abstract, such as an idea or a conflict."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "germ",
                                "target_lang_sense_clarification": "the initial stage of an idea"
                            },
                            {
                                "target_lang_word": "seed",
                                "target_lang_sense_clarification": "the source or origin of a feeling or situation"
                            },
                            {
                                "target_lang_word": "nucleus",
                                "target_lang_sense_clarification": "the core or starting point"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81de9fbc-f23d-3c77-ad11-cb0d912d3b4a",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>kiemen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kiem</w> de zaden in een speciale bak voordat ik ze in de tuin plant.",
                            "target_lang_translations": {
                                "en": "I <w>germinate</w> the seeds in a special tray before I plant them in the garden."
                            }
                        },
                        {
                            "text": "Als ik de bonen nu <w>kiem</w>, kunnen ze volgende week de grond in.",
                            "target_lang_translations": {
                                "en": "If I <w>sprout</w> the beans now, they can go into the ground next week."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to germinate' or 'to sprout'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "germinate",
                                "target_lang_sense_clarification": "to begin to grow"
                            },
                            {
                                "target_lang_word": "sprout",
                                "target_lang_sense_clarification": "to produce shoots"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a57b2ca-e67c-3e0a-a656-7bdb300accc0",
                    "sense_definition": "De gebiedende wijs van <w>kiemen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kiem</w> de zaden eerst op een warme plek voor het beste resultaat.",
                            "target_lang_translations": {
                                "en": "<w>Germinate</w> the seeds in a warm place first for the best result."
                            }
                        },
                        {
                            "text": "<w>Kiem</w> niet te veel zaden tegelijk als je weinig ruimte hebt.",
                            "target_lang_translations": {
                                "en": "Do not <w>sprout</w> too many seeds at once if you have little space."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'to germinate' or 'to sprout'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "germinate",
                                "target_lang_sense_clarification": "command to start growth"
                            },
                            {
                                "target_lang_word": "sprout",
                                "target_lang_sense_clarification": "command to produce shoots"
                            }
                        ]
                    }
                }
            ]
