                ],
                "senses": [
                    {
                        "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                        "entry_id": "8599d7d2-ea3a-30f9-96f7-27208987c748",
                        "glosses": [
                            "Bodenbelag, der aus Zement besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3ec1ea-e357-43c8-82b4-811a9f1979bb",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Unten bogen sie um eine Ecke und betraten einen dunklen, heißen Gang mit nacktem Zementboden.“"
                            },
                            {
                                "example_id": "8bfc79c6-04dd-4a85-a0b0-53310b73d0d5",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Auch der Zementboden und sogar die Eisentür waren weiß gestrichen.“"
                            },
                            {
                                "example_id": "3430e303-3027-420c-a109-3cc971f83653",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Ihr Licht leuchtete den Mitgliedern der Unit Eagle 01 direkt ins Gesicht, sodass sie nicht mehr als die nächsten sechs Meter leeren Zementboden vor sich erkennen konnten.“"
                            },
                            {
                                "example_id": "60b7e2a5-d26c-40bd-aad1-aac957fb1469",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Schulter, Hüfte und Knie taten ihr davon weh, gegen den Zementboden gepresst zu sein, auf dem sie lag.“"
                            },
                            {
                                "example_id": "e1aa6f05-e4cf-4f9c-8067-8e0a733bd944",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Er nahm den Teleskoparm und senkte den Spiegel zum staubigen Zementboden hinab, kurz vor der hinteren Wagentür.“"
                            },
                            {
                                "example_id": "11247609-44cc-41f4-80d9-3cab75505057",
                                "sense_id": "5817a997-96a2-33b5-80c5-4ac6544ef496",
                                "text": "„Zu Anfang saß er zusammen mit den anderen Taliban auf dem Zementboden, jetzt sitzt er auf einem Diwan, während sich die anderen auf dem Boden um ihn scharen - was seinen Status als Führer hervorheben soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
