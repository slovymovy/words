                    {
                        "translation_id": "7e427666-3461-48b4-8652-d74739b92846",
                        "source_entry_id": "cf0d2c2b-0328-386e-a4b3-3d3ab457e8d3",
                        "source_sense_id": "2d417d1d-e249-3540-9efd-ad6bca2045d2",
                        "source_sense_description": "linguistics, sociolinguistics: a specific form of a language or language cluster: a language or a dialect",
                        "target_lang_word": "Lekt",
                        "target_lang_code": "de",
