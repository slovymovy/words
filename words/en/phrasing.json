{
    "word_family": [
        "phrase",
        "phrasal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffa4388d-5f39-302d-9f6b-dc6eb8abb18a",
                    "sense_definition": "The specific way in which words are chosen and arranged to express a thought or statement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>phrasing</w> of the contract was confusing and led to a legal dispute.",
                            "target_lang_translations": {
                                "zh": "这份合同的<w>措辞</w>令人困惑，导致了一场法律纠纷。"
                            }
                        },
                        {
                            "text": "Careful <w>phrasing</w> can help you avoid offending people during a difficult conversation.",
                            "target_lang_translations": {
                                "zh": "在艰难的谈话中，谨慎的<w>措辞</w>可以帮助你避免冒犯他人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wording"
                    ],
                    "common_phrases": [
                        "careful phrasing",
                        "awkward phrasing"
                    ],
                    "target_lang_definitions": {
                        "zh": "表达思想或陈述时所选择和排列词语的具体方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "指说话或写作时选择词语的方式。"
                            },
                            {
                                "target_lang_word": "表达方式",
                                "target_lang_sense_clarification": "指陈述观点或思想的整体方式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1443ea47-4ed5-3a68-a795-aa3510a4884f",
                    "sense_definition": "The artistic way musical notes are grouped and performed, involving variations in tempo, volume, or emphasis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist's <w>phrasing</w> brought a new emotional depth to the classical piece.",
                            "target_lang_translations": {
                                "zh": "这位钢琴家对<w>乐句的处理</w>为这首古典乐曲带来了新的情感深度。"
                            }
                        },
                        {
                            "text": "Good <w>phrasing</w> is essential for making a melody sound natural and expressive.",
                            "target_lang_translations": {
                                "zh": "良好的<w>分句</w>对于使旋律听起来自然且富有表现力至关重要。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "音乐演奏中对乐句的处理方式，涉及速度、力度或强调的变化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乐句处理",
                                "target_lang_sense_clarification": "音乐术语，指对乐句的艺术性演绎。"
                            },
                            {
                                "target_lang_word": "分句",
                                "target_lang_sense_clarification": "指音乐中对乐句的划分与表现。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba078db3-7595-31e5-8794-b23ffdee21f8",
                    "sense_definition": "The present participle and gerund of <w>phrase</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "language_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>phrasing</w> his request politely to ensure he gets a positive response.",
                            "target_lang_translations": {
                                "zh": "他正在礼貌地<w>措辞</w>他的请求，以确保能得到积极的回应。"
                            }
                        },
                        {
                            "text": "She spent the whole afternoon <w>phrasing</w> her apology to her friend.",
                            "target_lang_translations": {
                                "zh": "她花了一整个下午来<w>斟酌措辞</w>，向朋友道歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wording"
                    ],
                    "target_lang_definitions": {
                        "zh": "表达或措辞（phrase的现在分词或动名词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "指选择词语来表达意思的过程。"
                            },
                            {
                                "target_lang_word": "表达",
                                "target_lang_sense_clarification": "指用语言将想法呈现出来。"
                            },
                            {
                                "target_lang_word": "斟酌措辞",
                                "target_lang_sense_clarification": "指仔细挑选并安排词语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}