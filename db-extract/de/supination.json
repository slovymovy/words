                    {
                        "translation_id": "fc6505f1-fabc-4d45-8fd2-482adcf85299",
                        "source_entry_id": "a627b14c-1a02-3bba-b53b-d08f0c8a5d8a",
                        "source_sense_id": "9dfa1147-1302-3022-999a-373c01839b67",
