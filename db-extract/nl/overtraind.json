                        "glosses": [
                            "uitgeput door teveel trainingsarbeid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef12793-3e91-434e-a505-ed7073f99e5e",
                                "sense_id": "2f79046d-a181-335e-a214-78d0eda78510",
                                "text": "\"Ik heb goed getraind. Misschien wel té goed. In trainingen ben ik nu eenmaal niet af te remmen. Daardoor voel ik me al een tijd supermoe. Ik hoop maar één ding en dat is dat ik niet overtraind ben.\""
                            },
                            {
                                "example_id": "5e535a36-9646-4f10-8710-88edc329271b",
                                "sense_id": "2f79046d-a181-335e-a214-78d0eda78510",
                                "text": "Visser werd in 2018 verrassend olympisch kampioene op de 5.000 meter en is de op één na snelste Nederlandse ooit op de 3.000 meter. Maar de laatste jaren worstelde ze; ze raakte overtraind, had het mentaal lastig en haar niveau van jaren geleden haalde ze niet meer."
                            }
                        ]
                    }
