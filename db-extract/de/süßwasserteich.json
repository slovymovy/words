                "senses": [
                    {
                        "sense_id": "547da45e-6efd-3684-b56a-886cb16530e4",
                        "entry_id": "085e0539-97dc-3b06-a127-d0eef4dba05e",
                        "glosses": [
                            "kleines, meist stehendes Gewässer, dessen Salzgehalt niedrig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40e372a-a4b5-4fd2-b132-eacf1f8bcdbb",
                                "sense_id": "547da45e-6efd-3684-b56a-886cb16530e4",
                                "text": "„Da die natürlichen Fischbestände in den letzten Jahrzehnten immer weiter geschrumpft sind, wird neben der traditionellen Fischzucht in Süßwasserteichen in zunehmendem Maße auch die Zucht von Meeresfischen, Krebsen, Muscheln oder Algen betrieben – die sog. Aquakultur.“"
                            },
                            {
                                "example_id": "5f270bec-de65-4a8a-8044-838818999795",
                                "sense_id": "547da45e-6efd-3684-b56a-886cb16530e4",
                                "text": "„Statt in den Tiefen der Ozeane hätte das Leben seine ersten Schritte vielmehr in kleinen Süßwasserteichen versucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
