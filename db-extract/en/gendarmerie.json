                        "source_sense_id": "f5829992-e02d-3cd1-b2d8-b35718b53060",
                        "source_sense_description": "military body charged with police duties",
                        "target_lang_word": "rijkswacht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
