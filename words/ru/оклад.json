{
    "word_family": [
        "окладистый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78c51932-386d-3d31-ae0c-01a8f8e6fa56",
                    "sense_definition": "Фиксированный размер заработной платы или денежного вознаграждения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сотрудникам повысили <w>оклад</w> в начале нового финансового года.",
                            "target_lang_translations": {
                                "en": "Employees received a raise in their <w>salary</w> at the beginning of the new fiscal year."
                            }
                        },
                        {
                            "text": "Размер ежемесячного <w>оклада</w> прописан в трудовом договоре каждого работника.",
                            "target_lang_translations": {
                                "en": "The amount of the monthly <w>base pay</w> is specified in each employee's labor contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "зарплата",
                        "жалованье"
                    ],
                    "common_phrases": [
                        "месячный оклад",
                        "повысить оклад"
                    ],
                    "target_lang_definitions": {
                        "en": "A fixed amount of salary or monetary compensation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "salary",
                                "target_lang_sense_clarification": "General term for fixed regular payment."
                            },
                            {
                                "target_lang_word": "base pay",
                                "target_lang_sense_clarification": "The fixed portion of compensation before bonuses."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a00b0c9-2d72-3455-abf3-5dc3fcd52614",
                    "sense_definition": "Установленная сумма денежного сбора или налога.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В древности подати собирались строго по установленному <w>окладу</w>.",
                            "target_lang_translations": {
                                "en": "In ancient times, tributes were collected strictly according to the established <w>tax rate</w>."
                            }
                        },
                        {
                            "text": "Каждый крестьянин обязан был платить налог согласно государственному <w>окладу</w>.",
                            "target_lang_translations": {
                                "en": "Every peasant was required to pay tax according to the state <w>levy</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Используется в историческом контексте."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An established amount of a monetary levy or tax."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tax rate",
                                "target_lang_sense_clarification": "The established level or amount of a tax."
                            },
                            {
                                "target_lang_word": "levy",
                                "target_lang_sense_clarification": "A sum of money demanded by an authority."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff783358-1f59-3db9-b781-56c510ef85a6",
                    "sense_definition": "Металлическое покрытие, украшающее икону.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древняя икона была украшена драгоценным серебряным <w>окладом</w>.",
                            "target_lang_translations": {
                                "en": "The ancient icon was decorated with a precious silver <w>riza</w>."
                            }
                        },
                        {
                            "text": "Мастер бережно очистил <w>оклад</w> от многолетней пыли и копоти.",
                            "target_lang_translations": {
                                "en": "The master carefully cleaned the <w>icon cover</w> of years of dust and soot."
                            }
                        }
                    ],
                    "synonyms": [
                        "риза"
                    ],
                    "common_phrases": [
                        "иконный оклад"
                    ],
                    "target_lang_definitions": {
                        "en": "A metal covering or frame decorating an icon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "riza",
                                "target_lang_sense_clarification": "The specific term for an icon cover."
                            },
                            {
                                "target_lang_word": "icon cover",
                                "target_lang_sense_clarification": "Descriptive term for the metal casing."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4cce74c-c105-38f6-b07b-f529a7e10494",
                    "sense_definition": "Декоративное покрытие на переплете книги.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старинная книга была заключена в тяжелый кожаный переплет с золотым <w>окладом</w>.",
                            "target_lang_translations": {
                                "en": "The antique book was encased in a heavy leather binding with a gold <w>cover</w>."
                            }
                        },
                        {
                            "text": "На полке стояло Евангелие в богато украшенном <w>окладе</w>.",
                            "target_lang_translations": {
                                "en": "On the shelf stood a Gospel in a richly decorated <w>binding</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A decorative covering on a book binding."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "book cover",
                                "target_lang_sense_clarification": "General term for the outer part of a book."
                            },
                            {
                                "target_lang_word": "binding",
                                "target_lang_sense_clarification": "The physical structure holding the pages together."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fd0ec0-e069-3f61-891c-b5b14a6ffaf8",
                    "sense_definition": "Внешнее очертание или контур чего-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В сумерках едва угадывался <w>оклад</w> его сурового лица.",
                            "target_lang_translations": {
                                "en": "In the twilight, the <w>outline</w> of his stern face was barely discernible."
                            }
                        },
                        {
                            "text": "Художник мастерски передал <w>оклад</w> фигуры на фоне заката.",
                            "target_lang_translations": {
                                "en": "The artist masterfully captured the <w>contour</w> of the figure against the sunset."
                            }
                        }
                    ],
                    "synonyms": [
                        "контур",
                        "очертание"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее употребление слова."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The external outline or contour of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outline",
                                "target_lang_sense_clarification": "The line by which a figure or object is defined."
                            },
                            {
                                "target_lang_word": "contour",
                                "target_lang_sense_clarification": "The shape or outline of a body or surface."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}