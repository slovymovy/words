                "senses": [
                    {
                        "sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                        "entry_id": "9c7e887a-e8e8-3d4b-957f-f87a8c4f8be9",
                        "glosses": [
                            "oft für Flugzeuge verwendetes Triebwerk, bei dem eine Gasturbine den Vortrieb nach dem Prinzip des Rückstoßantriebs erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a316816e-d94d-4912-9f09-d0c6658f7ddb",
                                "sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                                "text": "Die Heinkel He 178 war weltweit das erste Flugzeug, das von einem Strahltriebwerk angetrieben wurde."
                            },
                            {
                                "example_id": "18ea0579-8b0b-4dac-9080-185e869c782c",
                                "sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                                "text": "„Das erste Strahltriebwerk, das Mach 2 ermöglichte, trieb sowohl den Starfighter als auch die Phantom an.“"
                            },
                            {
                                "example_id": "726bb9c2-1f66-494e-92e6-c8717ecf1d8f",
                                "sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                                "text": "„Unbemannte Flieger mit Strahltriebwerk und Stealth-Eigenschaften sind deshalb der nächste logische Schritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b28be6fc-3bec-4d0c-bbd4-02b2b49d0c69",
                        "source_entry_id": "9c7e887a-e8e8-3d4b-957f-f87a8c4f8be9",
                        "source_sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                        "target_lang_word": "jet engine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jet engine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45738259-8c65-399c-96b5-e218a160b0fb",
                                        "entry_id": "c0006f64-f6a8-33ae-aac0-c21d0a7472a0",
                                        "glosses": [
                                            "An engine that obtains thrust by taking in air at the front, using it to burn fuel, then ejecting the hot combustion products at the rear through a propulsive nozzle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d946d6df-b8ae-3d00-836e-d3297756ff32",
                                        "entry_id": "c0006f64-f6a8-33ae-aac0-c21d0a7472a0",
                                        "glosses": [
                                            "Any engine propelled by expelling a high speed fluid jet (jet propulsion), such as a rocket, turbojet, turbofan, ramjet, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9c7a314-9c5f-4323-be46-11a2517c7ea5",
                        "source_entry_id": "9c7e887a-e8e8-3d4b-957f-f87a8c4f8be9",
                        "source_sense_id": "5fc065dd-fe2f-3ada-8307-550356205001",
                        "target_lang_word": "moteur à réaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur à réaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50dc8099-b7c8-3018-bfc4-08d369588d7a",
                                        "entry_id": "12d6877c-7d35-3e51-8642-5d8facef4f1e",
                                        "glosses": [
                                            "Moteur exerçant une poussée dans une direction grâce à l’éjection en sens inverse d’un fluide liquide ou gazeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241885e0-eedc-48a2-8832-fa67df2060e4",
                                                "sense_id": "50dc8099-b7c8-3018-bfc4-08d369588d7a",
                                                "text": "Que l’on se garde surtout de confondre les turbines réhabilitées par M. Fourneyron, et dites très improprement machines à réaction, avec le système de moteur à réaction, que nous venons de condamner plus haut."
                                            },
                                            {
                                                "example_id": "94902656-abad-4329-aa3a-a56d6648085e",
                                                "sense_id": "50dc8099-b7c8-3018-bfc4-08d369588d7a",
                                                "text": "Lorsqu’un moteur à réaction fonctionne, il crée à l’entrée une zone de basse pression d’air, explique sur son site le constructeur Boeing. Cette zone fait entrer dans la turbine une grande quantité d’air, qui se déplace à une vitesse de plus en plus élevée à mesure que l’on s’approche du moteur."
                                            },
                                            {
                                                "example_id": "52ac1e50-9d64-49cf-9b58-9c9762fa7d06",
                                                "sense_id": "50dc8099-b7c8-3018-bfc4-08d369588d7a",
                                                "text": "Comme les moteurs à pistons ne sont pas très puissants, les industriels planchent alors dès la fin de la Seconde Guerre mondiale sur une nouvelle technologie : le moteur à réaction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
