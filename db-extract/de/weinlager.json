                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaaaa0fc-eca8-48ff-b93e-6f4450104792",
                                "sense_id": "60710f5f-4c4c-3f18-a6bd-76536b849e45",
                                "text": "„Er mußte das fast vollständig zerstörte Weinlager sorgfältig wieder aufbauen und gleichzeitig seine anspruchsvollen Kunden bei der Stange halten.“"
                            },
                            {
                                "example_id": "2b72c681-49c7-49fd-ba0f-15a4a189b979",
                                "sense_id": "60710f5f-4c4c-3f18-a6bd-76536b849e45",
                                "text": "„Ich verließ den Palazzo Bovino und ging ganz allein zu Panagiottis Weinlager, um das Fäßchen Muskateller zu holen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
