                ],
                "senses": [
                    {
                        "sense_id": "064afb08-2692-3c66-a3fa-4317e754592e",
                        "entry_id": "c0258ff4-07d2-3e10-87be-ddcf01ecb2f3",
                        "glosses": [
                            "istotka; człowieczek, dzieciątko, zwierzątko"
                        ],
                        "tags": [
                            "endearing"
                        ],
                        "examples": [
                            {
                                "example_id": "5ade2ec9-453c-40b5-9bf9-e14000ac1eb1",
                                "sense_id": "064afb08-2692-3c66-a3fa-4317e754592e",
                                "text": "Cóż w tym wszystkim zawinił synek, stworzonko maleńkie, kruszynka urocza."
                            },
                            {
                                "example_id": "6a8446fb-8f4e-43ec-9c98-af34ab2c4ca3",
                                "sense_id": "064afb08-2692-3c66-a3fa-4317e754592e",
                                "text": "Nagle z krzaków wysunęło się małe, różowożółte stworzonko ze spiczastymi uszami i kusym, grajcarkowatym ogonkiem."
                            },
                            {
                                "example_id": "8583e879-65c0-4595-bf9f-6395f419e8e8",
                                "sense_id": "064afb08-2692-3c66-a3fa-4317e754592e",
                                "text": "A co by to była za satysfakcja, panie, mieć w domu takie miluchne stworzonko, taką … taką dzierlateczkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
