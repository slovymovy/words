                "senses": [
                    {
                        "sense_id": "3dd02b2d-5fb0-3bf1-a0ca-595f771cd83d",
                        "entry_id": "3a7f361a-286f-3bb2-8e8e-05999cd9aab5",
                        "glosses": [
                            "tijdelijke verschaffing van geld, dat later weer wordt terugbetaald, vaak met vergoeding van rente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fcb983-8637-4ce2-9de7-b9f225600fdb",
                                "sense_id": "3dd02b2d-5fb0-3bf1-a0ca-595f771cd83d",
                                "text": "Hij heeft een lening afgesloten bij de bank."
                            }
                        ]
                    },
                    {
                        "sense_id": "5233d204-ee5a-3d42-8cf7-b0f9900aa4df",
                        "entry_id": "3a7f361a-286f-3bb2-8e8e-05999cd9aab5",
                        "glosses": [
                            "bedrag dat geleend wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e948525-61fe-42ef-a7f9-bd4c9bb13302",
                                "sense_id": "5233d204-ee5a-3d42-8cf7-b0f9900aa4df",
                                "text": "De lening bedraagt tienduizend euro."
                            },
                            {
                                "example_id": "96bed253-7910-4466-9067-5b9e26b20ca8",
                                "sense_id": "5233d204-ee5a-3d42-8cf7-b0f9900aa4df",
                                "text": "In 2009 steunt hij de club opnieuw met een lening, op voorwaarde dat hij de overige aandelen ook in handen krijgt als de club niet aan zijn betalingsplicht voldoet. Dat blijkt in 2010 aan de orde, waardoor Schouten voor 99 procent eigenaar wordt van Vitesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1881e9c1-0ef7-4eb2-80e3-408c55042e75",
                        "source_entry_id": "3a7f361a-286f-3bb2-8e8e-05999cd9aab5",
                        "target_lang_word": "Darlehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Darlehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2747f2-19c3-3063-a3e0-2467748b6ec9",
                                        "entry_id": "e5494d2b-34f4-34a9-b062-0421c780ca65",
                                        "glosses": [
                                            "Geldbetrag, den eine Person oder Institution einer anderen Personen oder Institution für eine gewisse Zeit zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a49dba9-a727-4144-a51e-b1dadd869164",
                                                "sense_id": "cf2747f2-19c3-3063-a3e0-2467748b6ec9",
                                                "text": "Die Bank hat Herrn Karl das Darlehen verweigert."
                                            },
                                            {
                                                "example_id": "462d6192-6cce-4c16-900e-11b66ac0848d",
                                                "sense_id": "cf2747f2-19c3-3063-a3e0-2467748b6ec9",
                                                "text": "Morgen wird das Darlehen ausgezahlt."
                                            },
                                            {
                                                "example_id": "81179f72-e719-4d76-8112-360479a3dbe8",
                                                "sense_id": "cf2747f2-19c3-3063-a3e0-2467748b6ec9",
                                                "text": "„Die Targobank aber holt alles raus: Einer der Ex-Mitarbeiter erzählt, dass Kreditkunden zum Beispiel mit günstigeren Zinskonditionen in neue Darlehen gelockt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37fe442d-d7d9-37ca-a9ed-309636e041fc",
                                        "entry_id": "e5494d2b-34f4-34a9-b062-0421c780ca65",
                                        "glosses": [
                                            "Vertrag mit dem Inhalt, dass die eine Partei der anderen einen bestimmten Geldbetrag für eine bestimmte Zeit zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f7025d-c259-473c-a306-ac1b41a2981c",
                                                "sense_id": "37fe442d-d7d9-37ca-a9ed-309636e041fc",
                                                "text": "Im deutschen Zivilrecht finden sich die Regelungen über das Darlehen in den §§ 488 ff. BGB."
                                            },
                                            {
                                                "example_id": "28895d62-dece-4f17-ae65-19701d617401",
                                                "sense_id": "37fe442d-d7d9-37ca-a9ed-309636e041fc",
                                                "text": "Die Herren Müller und Möller schlossen ein Darlehen ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b3913d3-b701-45f8-b8e9-527a8d5fb7f7",
                        "source_entry_id": "3a7f361a-286f-3bb2-8e8e-05999cd9aab5",
                        "target_lang_word": "loan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e08774-c3c3-3b9b-8945-98a2a7e09599",
                                        "entry_id": "d7bb2a8c-5bb2-37f0-927f-3f6f7354e2ef",
                                        "glosses": [
                                            "An act or instance of lending, an act or instance of granting something for temporary use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fd4607-0dae-4879-94a9-a80534d0d546",
                                                "sense_id": "a7e08774-c3c3-3b9b-8945-98a2a7e09599",
                                                "text": "Because of the loan that John made to me, I was able to pay my tuition for the upcoming semester."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9867c952-42f5-39fe-944c-72460455ce68",
                                        "entry_id": "d7bb2a8c-5bb2-37f0-927f-3f6f7354e2ef",
                                        "glosses": [
                                            "A sum of money or other property that a natural or legal person borrows from another with the condition that it be returned or repaid over time or at a later date (sometimes with interest)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822ba83c-ea1b-4566-bd05-c1c72375dfda",
                                                "sense_id": "9867c952-42f5-39fe-944c-72460455ce68",
                                                "text": "All loans from the library, whether books or audio material, must be returned within two weeks."
                                            },
                                            {
                                                "example_id": "47c4b097-00ec-4d45-99f4-28645b63d870",
                                                "sense_id": "9867c952-42f5-39fe-944c-72460455ce68",
                                                "text": "He got a loan of five thousand pounds."
                                            },
                                            {
                                                "example_id": "757fe149-89c9-4ed6-b168-cb2fc54e3aa4",
                                                "sense_id": "9867c952-42f5-39fe-944c-72460455ce68",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafca070-a24c-3366-94d8-9f25f16cd242",
                                        "entry_id": "d7bb2a8c-5bb2-37f0-927f-3f6f7354e2ef",
                                        "glosses": [
                                            "The contract and array of legal or ethical obligations surrounding a loan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b638020a-d8ec-4a33-807d-0f8fba3c2723",
                                                "sense_id": "aafca070-a24c-3366-94d8-9f25f16cd242",
                                                "text": "He made a payment on his loan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81564672-c109-3d17-a679-f2465457e9d6",
                                        "entry_id": "d7bb2a8c-5bb2-37f0-927f-3f6f7354e2ef",
                                        "glosses": [
                                            "The permission to borrow any item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97c8316-0b48-4ef4-b0c6-c6077094f1aa",
                                                "sense_id": "81564672-c109-3d17-a679-f2465457e9d6",
                                                "text": "Thank you for the loan of your lawn mower."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c8fec15-e715-31dc-bbbf-db958cb6c7cd",
                                        "entry_id": "0cac774d-f159-3b78-84e9-2d321ad2d98d",
                                        "glosses": [
                                            "To lend (something) to (someone)."
                                        ],
                                        "tags": [
                                            "US",
                                            "ditransitive",
                                            "informal",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c25240b-f04f-4763-b3f0-0f0645151d11",
                                                "sense_id": "6c8fec15-e715-31dc-bbbf-db958cb6c7cd",
                                                "text": "In the course of a correspondence that passed between us at this period, he mentioned, to my utter astonishment, the fact of his having loaned Neilson 81000 to buy my bill on Maryland; and stated that he could not proceed to make the payment until Neilson refunded the money."
                                            },
                                            {
                                                "example_id": "c7cdac93-9eae-41f0-9d29-bc522de809e5",
                                                "sense_id": "6c8fec15-e715-31dc-bbbf-db958cb6c7cd",
                                                "text": "All the rest—six out of eleven, more than half—were loaned to him."
                                            },
                                            {
                                                "example_id": "5bb58da6-5f48-4402-b1c2-9abb6c120fa6",
                                                "sense_id": "6c8fec15-e715-31dc-bbbf-db958cb6c7cd",
                                                "text": "Upon maturity of the debt, the investment bank returns the loaned shares.\nOn the date of issuance, the entity should record the loaned shares at their fair value and recognize them as an issuance cost, with an offset to additional paid-in capital."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                                        "entry_id": "d2e89f07-48cf-38ad-9d82-e33b8e063e4c",
                                        "glosses": [
                                            "An area of uncultivated ground near a village or farmhouse."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a6b87d-b324-417b-9a83-067430a91653",
                                                "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                                                "text": "the Loan of Turchloy, the Black Loan"
                                            },
                                            {
                                                "example_id": "6f501e29-4cff-4fda-ad8c-cc47c00841f7",
                                                "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                                                "text": "[...] The herds upon the loan, As if a sheep had fled, wi' speed, At Grumphy tykes hound on Wi' loud huzza!"
                                            },
                                            {
                                                "example_id": "b7120107-1028-46d2-9c96-99eff81a2b99",
                                                "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                                                "text": "[...] meeting in the loan above the house his own great plough with the six oxen, which were the pride of his heart."
                                            },
                                            {
                                                "example_id": "a5a8e36d-70e4-4325-a710-c9ee316c15c4",
                                                "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                                                "text": "When the dews begin to fauld the flowers, and the gloaming shades draw on, When the star comes stealing through the sky, and the kye are in the loan, He whistles[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "743aca9c-78e1-4101-9a57-f7265b5e609f",
                        "source_entry_id": "3a7f361a-286f-3bb2-8e8e-05999cd9aab5",
                        "target_lang_word": "mortgage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortgage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a08e9f-4414-3ffc-996f-c8ec30765bc3",
                                        "entry_id": "02ad905d-6ad5-3600-ad2d-5196a932c8a6",
                                        "glosses": [
                                            "A special form of secured loan where the purpose of the loan must be specified to the lender, to purchase assets that must be fixed (not movable) property, such as a house or piece of farm land. The assets are registered as the legal property of the borrower but the lender can seize them and dispose of them if they are not satisfied with the manner in which the repayment of the loan is conducted by the borrower. Once the loan is fully repaid, the lender loses this right of seizure and the assets are then deemed to be unencumbered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a671e0d-d01e-45d5-b20f-ac26a237f511",
                                                "sense_id": "95a08e9f-4414-3ffc-996f-c8ec30765bc3",
                                                "text": "We're renting a property in the city centre because we can't afford to get a mortgage yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8e689f-c9ab-3bb8-bf43-747a5d593977",
                                        "entry_id": "02ad905d-6ad5-3600-ad2d-5196a932c8a6",
                                        "glosses": [
                                            "State of being pledged."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c587310-c2a2-4f09-9a17-fb68b8354f5e",
                                                "sense_id": "ed8e689f-c9ab-3bb8-bf43-747a5d593977",
                                                "text": "lands given in mortgage"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mortgage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                        "entry_id": "16f3ad02-1ea2-36c8-b748-bda419dfe4e7",
                                        "glosses": [
                                            "To borrow against a property, to obtain a loan for another purpose by giving away the right of seizure to the lender over a fixed property such as a house or piece of land; to pledge a property in order to get a loan."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d428e921-46f5-44cf-9772-587e726616b6",
                                                "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                                "text": "to mortgage a property, an estate, or a shop"
                                            },
                                            {
                                                "example_id": "259af901-85c5-4125-9cd9-f21b7746686d",
                                                "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                                "text": "We mortgaged our house in order to start a company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                        "entry_id": "16f3ad02-1ea2-36c8-b748-bda419dfe4e7",
                                        "glosses": [
                                            "To pledge and make liable; to make subject to obligation; to achieve an immediate result by paying for it in the long term."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1ccc97-82ff-41a3-8d69-adae0bcf00ab",
                                                "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                                "text": "She mortgaged her future for the pleasures of the relationship with the sculptor, a relationship she knew would be short."
                                            },
                                            {
                                                "example_id": "6ab0503b-026e-428f-a8dc-30ab65e71833",
                                                "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                                "text": "Like a latter-day Faustus who has mortgaged his soul to the pursuit of his art, Harrison now desperately craves the paternal love from which his learning has estranged him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
