{
    "word_family": [
        "generous",
        "generously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                    "sense_definition": "The quality of being willing to give money, resources, or time to others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community was moved by the <w>generosity</w> of the local business owners during the crisis.",
                            "target_lang_translations": {
                                "ru": "Общество было тронуто <w>ще́дростью</w> местных предпринимателей во время кризиса."
                            }
                        },
                        {
                            "text": "Her <w>generosity</w> with her time helped many students succeed in their studies.",
                            "target_lang_translations": {
                                "ru": "Её <w>ще́дрость</w> в отношении своего времени помогла многим студентам добиться успехов в учёбе."
                            }
                        }
                    ],
                    "synonyms": [
                        "liberality"
                    ],
                    "antonyms": [
                        "stinginess"
                    ],
                    "common_phrases": [
                        "show great generosity",
                        "act of generosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество человека, готового делиться деньгами, ресурсами или временем с другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ще́дрость",
                                "target_lang_sense_clarification": "готовность делиться материальными благами или временем"
                            },
                            {
                                "target_lang_word": "великоду́шие",
                                "target_lang_sense_clarification": "высокие душевные качества, готовность жертвовать своими интересами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                    "sense_definition": "A specific act of giving or kindness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity was built on the <w>generosity</w> of many anonymous donors.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация была построена на <w>ще́дрости</w> многих анонимных жертвователей."
                            }
                        },
                        {
                            "text": "We are grateful for the <w>generosity</w> shown by our neighbors during our move.",
                            "target_lang_translations": {
                                "ru": "Мы благодарны за <w>ще́дрость</w>, проявленную нашими соседями во время нашего переезда."
                            }
                        }
                    ],
                    "synonyms": [
                        "beau geste"
                    ],
                    "common_phrases": [
                        "unexpected act of generosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный поступок, проявление доброты или готовности помочь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ще́дрость",
                                "target_lang_sense_clarification": "проявление щедрого отношения в конкретной ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6596a999-1ebb-3e79-8a1d-c8c2147ede36",
                    "sense_definition": "The quality of being abundant or more than enough.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>generosity</w> of the harvest ensured that no one in the village went hungry.",
                            "target_lang_translations": {
                                "ru": "<w>Ще́дрость</w> урожая гарантировала, что никто в деревне не остался голодным."
                            }
                        },
                        {
                            "text": "The chef was known for the <w>generosity</w> of his portions.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар был известен <w>ще́дростью</w> своих порций."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество изобилия или избыточности чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изоби́лие",
                                "target_lang_sense_clarification": "большое количество, богатство ресурсов"
                            },
                            {
                                "target_lang_word": "ще́дрость",
                                "target_lang_sense_clarification": "обильность, богатство (например, урожая или порций)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094aa45d-7608-3f25-8e90-21f61d857e91",
                    "sense_definition": "The quality of having high moral character or noble birth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted with the <w>generosity</w> expected of a man of his noble standing.",
                            "target_lang_translations": {
                                "ru": "Он действовал с тем <w>благоро́дством</w>, которого ожидали от человека его высокого положения."
                            }
                        },
                        {
                            "text": "The story highlights the <w>generosity</w> of spirit found in the ancient royal family.",
                            "target_lang_translations": {
                                "ru": "История подчёркивает <w>великоду́шие</w>, присущее древней королевской семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "nobility"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to nobility of stock or breeding."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество обладания высокими моральными принципами или благородным происхождением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоро́дство",
                                "target_lang_sense_clarification": "высокие моральные качества, достоинство"
                            },
                            {
                                "target_lang_word": "великоду́шие",
                                "target_lang_sense_clarification": "высокая нравственность и благородство души"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}