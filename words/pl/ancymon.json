    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81b2ca06-0046-34eb-bdbc-92521f139e8f",
                    "sense_definition": "osoba, zwłaszcza dziecko, która zachowuje się niegrzecznie lub psoci",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "osoba niegrzeczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały <w>ancymon</w> znowu nabrudził w całym pokoju.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>озорник</w> снова нагрязнил во всей комнате."
                            }
                        },
                        {
                            "text": "Nie bądź takim <w>ancymonem</w> i posłuchaj wreszcie rodziców.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>проказником</w> и послушайся наконец родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "łobuz",
                        "psotnik",
                        "rozrabiaka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "słowo używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, особенно ребенок, который ведет себя непослушно или проказничает"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорник",
                                "target_lang_sense_clarification": "тот, кто любит шалить и проказничать"
                            },
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "тот, кто совершает мелкие шалости"
                            },
                            {
                                "target_lang_word": "сорванец",
                                "target_lang_sense_clarification": "непоседливый, шумный ребенок"
                            }
                        ]
                    },
                    "common_phrases": [
                        "mały ancymon"
                    ]
                },
                {
                    "sense_id": "c17876cf-dd9d-34c0-bf03-f4b5dcfc14fa",
                    "sense_definition": "osoba, która udaje niewinną, mimo że robi psoty",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "osoba niegrzeczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patrzy na mnie jak aniołek, a to prawdziwy <w>ancymon</w>.",
                            "target_lang_translations": {
                                "ru": "Смотрит на меня как ангелочек, а на самом деле — настоящий <w>негодник</w>."
                            }
                        },
                        {
                            "text": "Wszyscy myśleli, że jest grzeczny, ale ten <w>ancymon</w> znowu coś zmalował.",
                            "target_lang_translations": {
                                "ru": "Все думали, что он послушный, но этот <w>хитрец</w> снова что-то натворил."
                            }
                        }
                    ],
                    "synonyms": [
                        "wisus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "słowo używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который притворяется невинным, хотя на самом деле проказничает"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негодник",
                                "target_lang_sense_clarification": "разговорное обозначение озорника, часто с оттенком иронии"
                            },
                            {
                                "target_lang_word": "хитрец",
                                "target_lang_sense_clarification": "тот, кто умеет скрывать свои истинные намерения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}