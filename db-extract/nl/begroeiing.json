                        "examples": [
                            {
                                "example_id": "7e2afdb3-30a6-4ff0-ad21-c3581ad9d705",
                                "sense_id": "bba4a81d-ab5c-3df3-8b27-3f6e92625c85",
                                "text": "Er moest iemand langskomen om de begroeiing te verwijderen."
                            },
                            {
                                "example_id": "92b5c9ac-87ba-4ecc-800a-1ef4cb3a4ba2",
                                "sense_id": "bba4a81d-ab5c-3df3-8b27-3f6e92625c85",
                                "text": "De forse begroeiing ontnam namelijk elk vergezicht."
                            },
                            {
                                "example_id": "1a74170e-8148-4171-afcd-0503e2852e39",
                                "sense_id": "bba4a81d-ab5c-3df3-8b27-3f6e92625c85",
                                "text": "De glooiende velden in Calabrië bijvoorbeeld waren voor moderne, grootschalige landbouw ongeschikt geworden, vertelt Cusani. Hennepplanten, die zo kostbaar zijn dat ze sowieso met de hand bewerkt moeten worden, vormen wel een ideale begroeiing."
                            }
                        ]
                    }
