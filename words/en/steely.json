{
    "word_family": [
        "steel"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                    "sense_definition": "Having qualities resembling those of steel, especially hardness and resoluteness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete maintained a <w>steely</w> focus throughout the entire championship match.",
                            "target_lang_translations": {
                                "ru": "Спортсмен сохранял <w>стальной</w> фокус на протяжении всего чемпионского матча."
                            }
                        },
                        {
                            "text": "He stared at his opponent with a <w>steely</w> gaze that showed no fear.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на своего противника <w>стальном</w> взглядом, в котором не было страха."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steely gaze",
                        "steely resolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий качествами, напоминающими сталь, особенно твердостью, решительностью и непреклонностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стальной",
                                "target_lang_sense_clarification": "в переносном значении: твердый, решительный, непреклонный"
                            },
                            {
                                "target_lang_word": "непреклонный",
                                "target_lang_sense_clarification": "о характере или взгляде, выражающем твердость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a563849-7a00-3d60-841a-13e5e880f007",
                    "sense_definition": "Made of steel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight held a <w>steely</w> blade in his hand during the duel.",
                            "target_lang_translations": {
                                "ru": "Во время дуэли рыцарь держал в руке <w>стальной</w> клинок."
                            }
                        },
                        {
                            "text": "The <w>steely</w> points of their spears glittered in the morning sun.",
                            "target_lang_translations": {
                                "ru": "<w>Стальные</w> наконечники их копий сверкали в утреннем солнце."
                            }
                        }
                    ],
                    "synonyms": [
                        "steelen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из стали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стальной",
                                "target_lang_sense_clarification": "сделанный из стали"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary; modern English says 'steel'"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
