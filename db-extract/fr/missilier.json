                        "glosses": [
                            "Fabricant ou marchand de missiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "657ca625-6593-4fa3-8d5a-f3db70906573",
                                "sense_id": "2bf053f7-3fd4-3c7a-b9b5-fd0bd615f8c3",
                                "text": "Commandé à 200 exemplaires au missilier européen MBDA, ce nouvel armement apportera à la marine française une capacité de tir à longue distance."
                            },
                            {
                                "example_id": "5ef88d05-dca9-4ac3-9a53-545c37d8507f",
                                "sense_id": "2bf053f7-3fd4-3c7a-b9b5-fd0bd615f8c3",
                                "text": "Les deux pays ont également confirmé un accord sur l’achat de missiles anti-navire léger (ANL) développé par le missilier européen MBDA, une coentreprise du britannique BAE Systems, de l’européen Airbus Group et de l’italien Finmeccanica."
