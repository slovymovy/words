                "senses": [
                    {
                        "sense_id": "29e5c730-762d-3884-8d21-d1c9f1b869d5",
                        "entry_id": "0b3c7143-833a-3899-9add-0862f1da3831",
                        "glosses": [
                            "verziertes Brett mit Inschriften und Malereien, auf dem die Leiche vorm Begräbnis gelegen hat und zum Gedächtnis am Grab, Haus oder Todesort aufgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673db0f1-1649-415d-b3a1-7d8448d8064d",
                                "sense_id": "29e5c730-762d-3884-8d21-d1c9f1b869d5",
                                "text": "„Ein Totenbrett diente früher zum Aufbahren der Verstorbenen und war damit die erste Form des Sarges.“"
                            },
                            {
                                "example_id": "fd06286c-bdcf-4aeb-9f99-b71f2ae80318",
                                "sense_id": "29e5c730-762d-3884-8d21-d1c9f1b869d5",
                                "text": "„Nur wenige Totenbretter stehen heute noch im Landkreis am Wegesrand.“"
                            },
                            {
                                "example_id": "5939aab5-351e-4043-86c5-caf2d6d0ce8f",
                                "sense_id": "29e5c730-762d-3884-8d21-d1c9f1b869d5",
                                "text": "„Zu den auffälligsten, heute wieder eifrig geübten Bräuchen gehört das Aufstellen von Totenbrettern.“"
                            },
                            {
                                "example_id": "dd4a79e6-a03e-4300-ae0d-b2369be8d26a",
                                "sense_id": "29e5c730-762d-3884-8d21-d1c9f1b869d5",
                                "text": "„Der fromme Brauch Totenbretter aufzustellen geht weit zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
