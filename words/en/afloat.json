{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "72da0118-b03c-3c72-bc8a-ddc8c83d7a1d",
                    "sense_definition": "Floating on the surface of water or another liquid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small yellow rubber duck was <w>afloat</w> in the bath.",
                            "target_lang_translations": {
                                "zh": "一只黄色小橡皮鸭<w>漂浮</w>在浴缸里。"
                            }
                        },
                        {
                            "text": "The wooden toy was <w>afloat</w> in the pool after the storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨过后，那个木制玩具<w>漂浮</w>在泳池里。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ashore"
                    ],
                    "common_phrases": [
                        "remain afloat",
                        "keep afloat"
                    ],
                    "target_lang_definitions": {
                        "zh": "漂浮在水面或液体表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漂浮",
                                "target_lang_sense_clarification": "指物体在水面或空中浮动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb00dccd-2681-3c66-9837-15e16eb6c068",
                    "sense_definition": "Having enough money or resources to stay out of financial difficulty or continue operating.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A generous loan helped to keep the company <w>afloat</w> during the crisis.",
                            "target_lang_translations": {
                                "zh": "一笔慷慨的贷款帮助公司在危机期间<w>维持生存</w>。"
                            }
                        },
                        {
                            "text": "They struggled to stay <w>afloat</w> as monthly expenses kept rising.",
                            "target_lang_translations": {
                                "zh": "随着每月开支不断增加，他们努力<w>维持生存</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solvent",
                        "on one's feet"
                    ],
                    "antonyms": [
                        "bankrupt",
                        "insolvent"
                    ],
                    "common_phrases": [
                        "keep afloat",
                        "stay afloat"
                    ],
                    "target_lang_definitions": {
                        "zh": "拥有足够的资金或资源以维持运营，避免陷入财务困境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "维持生存",
                                "target_lang_sense_clarification": "指企业或个人在经济困难中勉强维持。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b319fe95-dc29-3fdf-9203-82aba570a0b4",
                    "sense_definition": "Aboard a ship or vessel at sea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors spent many long months <w>afloat</w> before returning home.",
                            "target_lang_translations": {
                                "zh": "水手们在回家前度过了许多<w>在海上</w>的漫长岁月。"
                            }
                        },
                        {
                            "text": "Life <w>afloat</w> requires discipline and constant cooperation among the crew.",
                            "target_lang_translations": {
                                "zh": "<w>在海上</w>的生活需要船员们保持纪律并不断协作。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ashore"
                    ],
                    "common_phrases": [
                        "life afloat"
                    ],
                    "target_lang_definitions": {
                        "zh": "在海上航行或在船上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "在海上",
                                "target_lang_sense_clarification": "指在船上或海上生活、工作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14484592-2905-30ce-bce6-377da782135d",
                    "sense_definition": "Covered or flooded with water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waterlogged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy rainstorm, the wooden deck was completely <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "暴雨过后，木制甲板完全被<w>淹没</w>了。"
                            }
                        },
                        {
                            "text": "The entire garden was <w>afloat</w> following the sudden flood.",
                            "target_lang_translations": {
                                "zh": "突如其来的洪水过后，整个花园都被<w>淹没</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awash",
                        "flooded"
                    ],
                    "target_lang_definitions": {
                        "zh": "被水覆盖或淹没。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "淹没",
                                "target_lang_sense_clarification": "指被水覆盖的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "640214c9-0061-32bf-b949-ec1a87a3d2d5",
                    "sense_definition": "Floating in the air or hanging loose and unconfined, such as hair or clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her long hair was <w>afloat</w> in the gentle summer breeze.",
                            "target_lang_translations": {
                                "zh": "她的长发在夏日的微风中<w>飘动</w>。"
                            }
                        },
                        {
                            "text": "The dancer moved gracefully with her silk dress <w>afloat</w> around her.",
                            "target_lang_translations": {
                                "zh": "舞者优雅地移动着，丝绸裙摆在她身边<w>飘动</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在空中飘动或松散地悬挂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "飘动",
                                "target_lang_sense_clarification": "指轻盈地在空中摆动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e5402ac-4281-3d3d-b8b1-5d54bfb6ccd3",
                    "sense_definition": "Circulating or being passed around, as rumors or news.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "circulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several rumors about the manager were <w>afloat</w> in the office.",
                            "target_lang_translations": {
                                "zh": "办公室里关于经理的几则谣言正在<w>流传</w>。"
                            }
                        },
                        {
                            "text": "Stories about the old house being haunted were constantly <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "关于那座老房子闹鬼的故事一直在<w>流传</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circulating",
                        "in circulation",
                        "current"
                    ],
                    "target_lang_definitions": {
                        "zh": "流传或传播，如谣言或新闻。"
