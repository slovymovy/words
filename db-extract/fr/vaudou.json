                        "tags": [],
                        "form": "vodou"
                    },
                    {
                        "form_id": "d1ffd3d2-2014-47fc-840a-af14813649f4",
                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                        "tags": [],
                        "form": "vodoun"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a523bd3c-2342-3465-b75a-b1eb5c5a6de8",
                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                        "glosses": [
                            "Religion animiste originaire de l’ancien royaume du Dahomey, répandue au Bénin et au Togo, aux Antilles et en Amérique latine, principalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "439d663d-2c10-4f86-a824-3d01b0592e61",
                                "sense_id": "a523bd3c-2342-3465-b75a-b1eb5c5a6de8",
                                "text": "En Haïti, le vaudou mélange vaudou d’Afrique de l’Ouest et folklore religieux chrétien."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6ae0c48-da9c-3c50-aef1-27fb549aaf76",
                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                        "glosses": [
                            "Dieu de cette religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3cb547-5de0-4df5-a3b9-114c27579517",
                                "sense_id": "d6ae0c48-da9c-3c50-aef1-27fb549aaf76",
                                "text": "Un vaudou trônant en divinité principale dans un sanctuaire n’est plus qu’une divinité secondaire dans le temple voisin."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                        "entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                        "glosses": [
                            "Adepte de ce culte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47391a0c-7fbf-4cfd-bf27-d34bc7cbbf92",
                                "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                                "text": "Les vaudous forment parmi les noirs [des États-Unis] une société secrète, une sorte de franc-maçonnerie placée sous l’invocation d’un être tout-puissant et surnaturel qui gouverne toutes les choses d’ici-bas."
                            },
                            {
                                "example_id": "8bfac53c-a71f-40da-b7c6-81d083db69d9",
                                "sense_id": "f9c15192-4c10-377a-ae08-b5b148835798",
                                "text": "Les vaudoux parurent subitement pris de vertige et ils furent à l’instant agités de mouvements convulsifs dans lesquels la partie supérieure du corps, la tête et les épaules semblèrent se disloquer ; une exaltation fiévreuse s’empara de tous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dc1869d-7758-44f9-80a5-cdb4a53d5298",
                        "source_entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
                        "target_lang_word": "voodoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voodoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "Any of a group of related religious practices found chiefly in and around the Caribbean, particularly in Haiti and Louisiana."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b0eccc-7005-4d99-9b13-bd3b7101e0e5",
                                                "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                                                "text": "You cannot understand Haitian Vodou as it is practised today without first knowing something about the culture from which it sprang, and the ways history has shaped religion, and vice versa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69ba231a-200b-3492-836e-a64c2fcd52e8",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "The spiritual beliefs of the Ewe/Fon of West Africa, practiced chiefly in Benin and in the south of Togo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "Any sort of magical or irrational approach to a problem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc47e8a-5d2d-46ed-a5df-2723fc9ede2f",
                                                "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                                                "text": "I want a real explanation, not this statistical voodoo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                                        "glosses": [
                                            "One who practices voodoo; a native sorcerer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fa26685-3ad7-4f4a-a4bc-975dfb0538e0",
                                                "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                                                "text": "So a reporter of the Boston Herald (U.S.) has 'interviewed' a few local Voodoos. He has seen a dance round a boiling pot, seen some tomfoolery with spiders, and heard a lot of superstitious stories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voodoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a851d6ee-f061-3554-bc4c-3b46c771edb5",
                                        "entry_id": "f71a051d-3ceb-3faa-84bb-563f268b7e40",
                                        "glosses": [
                                            "To bewitch someone or something using voodoo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bca3023-cb01-4dc5-973d-ff0981f28532",
                                                "sense_id": "a851d6ee-f061-3554-bc4c-3b46c771edb5",
                                                "text": "He claimed his neighbor had voodooed him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeb49f1f-6e95-4efc-a043-c4e41041d074",
                        "source_entry_id": "94edfb57-a58c-32c0-a8f5-a6b08e96fd9b",
