                    },
                    {
                        "translation_id": "aae9667c-6efc-4e21-8b7d-54e26581d99e",
                        "source_entry_id": "21b0953e-691c-345a-a02d-334bbc76efc7",
                        "source_sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                        "target_lang_word": "bleak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b22efe7-57ba-3d3c-8eca-7f90601bb072",
                                        "entry_id": "7aaca514-932a-3f26-b656-00230c00be31",
                                        "glosses": [
                                            "Without color; pale; pallid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4370fd9d-74a5-4ef1-9368-a950a52c0e1e",
                                                "sense_id": "2b22efe7-57ba-3d3c-8eca-7f90601bb072",
                                                "text": "When she came out she looked as pale and as bleak as one that were laid out dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                        "entry_id": "7aaca514-932a-3f26-b656-00230c00be31",
                                        "glosses": [
                                            "Desolate and exposed; swept by cold winds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4303f3b-956e-4519-b38c-73a54d6313a7",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "a bleak and bare rock"
                                            },
                                            {
                                                "example_id": "3beb8dba-bdf7-435a-b310-5b9ae9c232d7",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "a bleak, crater-pocked moonscape"
                                            },
                                            {
                                                "example_id": "d14880e7-c6d7-4065-95ca-edc4803418a8",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "They escaped across the bleak landscape."
                                            },
                                            {
                                                "example_id": "61e83dd9-d6fd-463f-ae23-6e034f75f518",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "We hiked across open meadows and climbed bleak mountains."
                                            },
                                            {
                                                "example_id": "1a0a1cc6-f78e-4d6d-9c78-6f1d6263929e",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "Wastes too bleak to rear / The common growth of earth, the foodful ear."
                                            },
                                            {
                                                "example_id": "331f6add-6efa-4a55-9ad2-4358e14c0d9e",
                                                "sense_id": "2e2d9c42-226a-3567-867e-60442ed86416",
                                                "text": "At daybreak, on the bleak sea-beach, / A fisherman stood aghast, / To see the form of a maiden fair, / Lashed close to a drifting mast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                        "entry_id": "7aaca514-932a-3f26-b656-00230c00be31",
                                        "glosses": [
                                            "Unhappy; cheerless; miserable; emotionally desolate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8fba57-ade1-4bc2-b927-3604a662bcd3",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "Downtown Albany felt bleak that February after the divorce."
                                            },
                                            {
                                                "example_id": "a4810d54-590c-4d5e-b16b-ff9a2872d1ed",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "A bleak future is in store for you."
                                            },
                                            {
                                                "example_id": "573ae8b9-70dd-47cf-89b1-a5d3ff81a1c8",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "The news is bleak."
                                            },
                                            {
                                                "example_id": "80ffe3aa-b6b2-4acb-875b-1b1c9cb82768",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "The survey paints a bleak picture."
                                            },
                                            {
                                                "example_id": "786eb9c1-a232-4695-82bf-e08a63b2009d",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "But the bleakest Utopia of all, the very first of the Unutopias, had come from Wells long before that."
                                            },
                                            {
                                                "example_id": "67c2b436-b52a-4446-aa41-b6afddee2af4",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "The industrial shitscape of Los Angeles gave way to something even bleaker as I passed out of lonely Riverside into the wide-open range of horse stables and twisted trees and spinning giant wind turbines outside of Indio."
                                            },
                                            {
                                                "example_id": "1ceba322-9e3d-4aef-9070-a1456e108617",
                                                "sense_id": "2d03d356-eaf4-33fd-94a7-7e1c2027598a",
                                                "text": "Dany didn’t necessarily have to die, but letting her live would’ve been an assessment of humanity so bleak that even George R.R. Martin, it seems, wants to hope for something better."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleak",
                                "target_lang_code": "en",
                                "target_senses": [
