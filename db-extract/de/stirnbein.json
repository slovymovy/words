                ],
                "senses": [
                    {
                        "sense_id": "4006e2c2-fa8e-3d82-9715-e40e20e25c91",
                        "entry_id": "93843ea0-de75-3ee6-9f13-0bee4627a25f",
                        "glosses": [
                            "unpaariger, zwischen Nasen-, Joch- und Scheitelbein gelegener, den vorderen Teil des Schädeldaches sowie die Grundlage der Stirn bildender Schädelknochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41bb2483-29a3-47ce-8eef-23a5b05e4a25",
                                "sense_id": "4006e2c2-fa8e-3d82-9715-e40e20e25c91",
                                "text": "„Im Zuge der Evolution aus einem gemeinsamen Vorfahren haben sich Gehirnstrukturen von Affen und Menschen unterschiedlich entwickelt: So liegt bei den großen Primaten heute der untere Teil des Sulcus praecentralis, einer auffälligen Furche des Großhirns, im Schädel eindeutig vor der Koronarnaht, der von außen sichtbaren Naht zwischen vorderem Stirnbein und dem sich nach hinten anschließenden Scheitelbein des Schädels. Beim modernen Menschen ist das anders, denn die Hirnwindung wich im Lauf der Menschwerdung nach hinten aus, um Teilen des Frontallappens Platz zu machen, der offenbar wichtiger wurde und zunehmend mehr Platz einnahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7993080f-2414-4356-bf25-f6f15cf1e566",
                        "source_entry_id": "93843ea0-de75-3ee6-9f13-0bee4627a25f",
                        "source_sense_id": "4006e2c2-fa8e-3d82-9715-e40e20e25c91",
                        "source_sense_description": "unpaariger, zwischen Nasen-, Joch- und Scheitelbein gelegener, den vorderen Teil des Schädeldaches sowie die Grundlage der Stirn bildender Schädelknochen",
                        "target_lang_word": "frontal bone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontal bone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25c30573-7316-3375-ba9c-e3c65eee990e",
                                        "entry_id": "f7d49544-ce3b-3b16-a8b8-c10af5c17058",
                                        "glosses": [
                                            "The bone which forms the front part of the skull and the upper part of the eye sockets and nasal cavity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450c5ca6-642d-4ae3-8262-44f10bb1c59b",
                                                "sense_id": "25c30573-7316-3375-ba9c-e3c65eee990e",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue.[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcc1dbd-4d5f-3fc4-a746-d5c7eaa71591",
                                        "entry_id": "f7d49544-ce3b-3b16-a8b8-c10af5c17058",
                                        "glosses": [
                                            "Either of the pair of bones from which the frontal bone is formed by fusion in infancy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
