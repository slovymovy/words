                                        "sense_id": "37fb47fb-e37c-3098-95c6-a23f9edc7d3b",
                                        "entry_id": "ba8c2328-63b8-3050-a7e6-781db2dbe28f",
                                        "glosses": [
                                            "Any of several large food and game yellowtail fishes of the genus Seriola, found in warm waters of all oceans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b0bd5c-8b42-4701-be5c-f4c0c40dfabd",
                                                "sense_id": "37fb47fb-e37c-3098-95c6-a23f9edc7d3b",
                                                "text": "It was an amberjack, and twice as large as any I had ever seen before. As I drew up the captain's snapper this amberjack came to the surface, and I certainly yelled."
                                            },
                                            {
                                                "example_id": "3982e3eb-a89b-4483-87e9-be66b4715f65",
                                                "sense_id": "37fb47fb-e37c-3098-95c6-a23f9edc7d3b",
                                                "text": "Greater amberjacks have 11-19 gill rakers, a long anal fin base, 7 dorsal fin spines, and 30-34 dorsal fin rays."
                                            },
                                            {
                                                "example_id": "c947241a-9881-454c-a94f-d6ae90351ae0",
                                                "sense_id": "37fb47fb-e37c-3098-95c6-a23f9edc7d3b",
                                                "text": "The greater amberjack is the largest of the jacks, the most important amberjack to anglers, and, like most of its brethren, a strong fighter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
