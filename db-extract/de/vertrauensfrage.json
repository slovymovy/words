                                "target_senses": [
                                    {
                                        "sense_id": "359b486d-423f-383c-b5f6-ea64c76b418a",
                                        "entry_id": "57eb578d-df28-3f7e-bf54-82226b79e0bd",
                                        "glosses": [
                                            "A motion proposed in a parliament or other assembly to give members the chance to express their confidence in a government; sometimes proposed by a government to counter a vote of no confidence proposed by the opposition; defeat would lead to the resignation of the government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bacf609-fcf4-3d73-85ea-8dcea1ba7fed",
                                        "entry_id": "57eb578d-df28-3f7e-bf54-82226b79e0bd",
                                        "glosses": [
                                            "Any indication of confidence in another."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ae64cb-f766-4741-8f0b-8a79b7f88d23",
                                                "sense_id": "3bacf609-fcf4-3d73-85ea-8dcea1ba7fed",
                                                "text": "\"I don't find you unduly piggish,\" she said.",
                                                "translation": "\"Wow,\" I said. \"Thanks for the vote of confidence.\"",
                                                "english": "\"Wow,\" I said. \"Thanks for the vote of confidence.\""
                                            }
                                        ]
                                    }
