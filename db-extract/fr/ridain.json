                                    },
                                    {
                                        "sense_id": "5f1a2227-6249-3af3-ac83-504d824cef83",
                                        "entry_id": "1bea9e14-b864-3c59-bc4c-68bb304dcad8",
                                        "glosses": [
                                            "To tear up for search or disclosure, or for alteration; to search to the bottom; to discover; to disclose; usually with up."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c296d0-9260-4684-82fd-be0a388a9d5a",
                                                "sense_id": "5f1a2227-6249-3af3-ac83-504d824cef83",
                                                "text": "They ripped up all that had been done from the beginning of the rebellion."
                                            },
                                            {
                                                "example_id": "7d4b9d4e-8003-46be-9478-db9cde815c5b",
                                                "sense_id": "5f1a2227-6249-3af3-ac83-504d824cef83",
                                                "text": "For brethren to debate and rip up their falling out in the ear of a common enemy […] is neither wise nor comely."
                                            }
