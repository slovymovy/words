                        "glosses": [
                            "Enough to fill a sleeve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e745bb-ce97-49c1-ae8e-f333d81fb6d5",
                                "sense_id": "5c86a06c-9d26-33da-acd9-c69aeaf397cd",
                                "text": "The pros are out strong with whole sleevesful of arguments and not a few stunts."
                            },
                            {
                                "example_id": "078f502b-1865-4f3b-b259-d8d81797480c",
                                "sense_id": "5c86a06c-9d26-33da-acd9-c69aeaf397cd",
                                "text": "Whole sleevesful of sly little tricks that work figure magic . . ."
                            },
                            {
                                "example_id": "6951ca33-c385-4dc2-aa02-71e8804c58d1",
                                "sense_id": "5c86a06c-9d26-33da-acd9-c69aeaf397cd",
                                "text": "He gives you a smooth long look with sleevesful of flowers, just for seasoning."
                            },
                            {
                                "example_id": "05eb91b1-b947-4e87-b4f5-1ffd8fba23d4",
                                "sense_id": "5c86a06c-9d26-33da-acd9-c69aeaf397cd",
                                "text": "I never saw a cross, or indifferent, or bad-tempered nurse, and never left the unit without sleevesful of damp Kleenex."
                            },
                            {
                                "example_id": "e51b40b0-2602-448a-8dbe-0fa526bab465",
                                "sense_id": "5c86a06c-9d26-33da-acd9-c69aeaf397cd",
                                "text": "Paula had a secretary, and when Conchita had used up both sleevesful of tissues, she could finish the damn filing."
                            }
                        ]
                    }
