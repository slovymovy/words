                        "glosses": [
                            "Qui a approximativement la même prononciation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f1e5cb-7589-4975-abc4-917f5ebcf118",
                                "sense_id": "f28c9560-ca03-3dd3-80b9-25ff09bb8fb1",
                                "text": "(…) et sa relation à l’enfant est totalement placée sous le signe d’une ambivalence que peuvent résumer deux phrases quasi-homophones : « Maman m’aime » (p. 38) et « Maman, maître » (p. 36)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ce888ea-109f-424a-bcf7-7e35c5ef400a",
                        "source_entry_id": "329cd098-b052-306a-a02f-4ba84982cf8e",
                        "source_sense_id": "f28c9560-ca03-3dd3-80b9-25ff09bb8fb1",
                        "target_lang_word": "Quasi-Homophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quasi-Homophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                        "entry_id": "47dba5cc-67cb-393f-9ade-46f2723b7a00",
                                        "glosses": [
                                            "Lexem, das sich zu anderen Lexemen mit gleicher Phonemzahl nur in einzelnen Phonemen unterscheidet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633754df-bc4b-4acf-b3c6-4ea855314088",
                                                "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                                "text": "Auch die Zahl der Homophone und Quasi-Homophone, also gleichklingender oder fast gleichklingender Laute in einer Sprache, ist ausschlaggebend dafür, wieviele Kapazitäten auf das genaue Zuhören und eventuell sogar Inferenzieren der gemeinten Bedeutung verwendet werden müssen."
                                            },
                                            {
                                                "example_id": "1ae289f7-e00b-4ddc-a048-285a29e660c1",
                                                "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                                "text": "Dazu zählen dann Quasi-Homophone (Substitution eines Phonems oder mehrerer Phoneme in Sequenzen gleicher Phonemanzahl, z.B. fric/flic) und partielle Homophone (Substitution eines Lexems durch ein Lexem unterschiedlicher Phonemzahl, dessen zahlengleiche Phonemsequenz homonym, homophon oder quasi-homophon ist, z.B. marché coma für comun)."
                                            },
                                            {
                                                "example_id": "f24e41e4-3f02-4964-aa98-f4cfbf93d1fa",
                                                "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                                "text": "Wir nennen a) und b) Quasi-Homonyme und verzichten somit auf eine terminologische Differenzierung in Quasi-Homonyme (remarquable vs remorquable) und Quasi-Homophone (mai vs mie)."
                                            },
                                            {
                                                "example_id": "e206ed40-e3ec-44fd-981b-b04d205a9943",
                                                "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                                "text": "In der Etymologie, insbesondere in der Onomastik, ist paronymische Anziehung die verzerrende Wirkung, die ein Wort auf eines seiner Paronyme (d. h. ein Quasi-Homophon) ausübt."
                                            },
                                            {
                                                "example_id": "ae2095fc-9d3b-4472-b11d-1d3a0a2cc925",
                                                "sense_id": "db9700c1-3c85-35fd-a12c-98fd3a4ce1ef",
                                                "text": "… während das Wort selbst ein ‚Quasi-Homophon‘ zu 'pulverisation' darstellt, und so der Text gleichzeitig einen Kommentar auf sein Vorgehen liefert, …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
