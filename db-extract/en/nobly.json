                ],
                "senses": [
                    {
                        "sense_id": "cc0fb651-3fdf-3e8f-8cc2-78cdb9a1feef",
                        "entry_id": "1112cfee-7122-3e7c-ab7f-18dd0d3ee53a",
                        "glosses": [
                            "In a noble manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf548bd0-2a78-4b52-8058-e3eb153fd5ba",
                                "sense_id": "cc0fb651-3fdf-3e8f-8cc2-78cdb9a1feef",
                                "text": "In the end he died nobly, trying to save the lives of others."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40a7a6a6-90e8-40b7-9772-bb50f6a2c039",
                        "source_entry_id": "1112cfee-7122-3e7c-ab7f-18dd0d3ee53a",
                        "source_sense_id": "cc0fb651-3fdf-3e8f-8cc2-78cdb9a1feef",
                        "source_sense_description": "in a noble manner",
                        "target_lang_word": "noblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                                        "glosses": [
                                            "D’une manière noble ; avec noblesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8985476-af51-4507-83e0-1cb71c313e69",
                                                "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                                                "text": "L'Allemagne a donné à la Tchéquie des sciences, des beaux-arts et l'industrie, et la Tchéquie a noblement répondu à ce magnifique cadeau, en produisant le hussitisme, cet immortel précurseur de Martin Luther."
                                            },
                                            {
                                                "example_id": "5664a39e-b708-46da-90dc-4e3ab68b35f6",
                                                "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                                                "text": "Les courtisanes, pour embrasser tout le sexe féminin qu’on baptise, qu’on débaptise et rebaptise à chaque quart de siècle, conservent toutes au fond de leur cœur un florissant désir de recouvrer leur liberté, d’aimer purement, saintement et noblement un être auquel elles sacrifient tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1452dce2-4395-3b75-b4a8-11b3385377ff",
                                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                                        "glosses": [
                                            "Selon la manière de vivre sur sa terre, ou à la ville, sans exercer aucune profession, ou sans en avoir d’autre que celle des armes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974ad261-c324-46bf-a19c-2c0cf5346600",
                                                "sense_id": "1452dce2-4395-3b75-b4a8-11b3385377ff",
                                                "text": "Ses ancêtres n’ont jamais dérogé, ils ont toujours vécu noblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f9f285-ea7a-3375-a7ce-09578fe8416b",
                                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                                        "glosses": [
                                            "Avec aisance, comme un rentier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628e85dc-a153-421d-8c93-1ae5bb1e5731",
                                                "sense_id": "49f9f285-ea7a-3375-a7ce-09578fe8416b",
                                                "text": "Il n’est pas noble, mais il vit noblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "830aed04-71b1-383d-94f5-88757b5162be",
                                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                                        "glosses": [
                                            "En fief, en parlant de mode de tenure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbf44d4-1713-4abe-97a4-2542eac89cbb",
                                                "sense_id": "830aed04-71b1-383d-94f5-88757b5162be",
                                                "text": "Tenir noblement une terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
