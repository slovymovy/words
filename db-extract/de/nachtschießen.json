                "senses": [
                    {
                        "sense_id": "7260161b-c386-358d-b45e-df23e7fddae3",
                        "entry_id": "67543873-3c7c-38d8-ab9e-81b98b2d6bd9",
                        "glosses": [
                            "Schießtraining, das im Dunkeln durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19c1d27-fee0-45ec-81f3-86ef58088e64",
                                "sense_id": "7260161b-c386-358d-b45e-df23e7fddae3",
                                "text": "„Die größte Herausforderung war das scharfe Nachtschießen mit der großen Panzerartillerie-Haubitze.“"
                            },
                            {
                                "example_id": "209845c7-db4e-42e5-870a-07c82a393abb",
                                "sense_id": "7260161b-c386-358d-b45e-df23e7fddae3",
                                "text": "„Der Soldat sei bei einem Nachtschießen am Mittwochabend gegen 19 Uhr von einem Geschoss tödlich verletzt worden, sagte ein Sprecher des Wehrbereichs IV am Donnerstag in München.“"
                            },
                            {
                                "example_id": "83f097bc-2cb7-479a-b88e-e35c5b61fa90",
                                "sense_id": "7260161b-c386-358d-b45e-df23e7fddae3",
                                "text": "„Schießzeiten wurden wie folgt festgelegt: Montag bis Donnerstag von 6 bis 22 Uhr. Für das Nachtschießen im Sommer Dienstag bis Donnerstag 22 bis 2 Uhr und im Winter von 18 bis 22 Uhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
