                ],
                "translations": [
                    {
                        "translation_id": "2f09634d-fa5d-452f-9a2a-d99b2d9cb54c",
                        "source_entry_id": "27387673-1c98-3464-970d-b0ab2ce1bbeb",
                        "source_sense_id": "05debc7e-e24b-349f-8ea1-cf455acc11a2",
                        "source_sense_description": "Tennis: Spielstand nach einem Punkt, der nach einem Einstand (40:40) erzielt wurde",
                        "target_lang_word": "advantage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Any condition, circumstance, opportunity or means, particularly favorable or chance to success, or to any desired end."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6117e9d-473d-46d2-ac55-79f9785dc9ef",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "The enemy had the advantage of a more elevated position."
                                            },
                                            {
                                                "example_id": "a4b0660a-86b5-4ebb-9e3f-2b9a520bc6b3",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "Give me advantage of some brief discourse."
                                            },
                                            {
                                                "example_id": "843dc575-c0fd-497f-9e42-3b81883a15fd",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "the advantages of a close alliance"
                                            },
                                            {
                                                "example_id": "d82fa7c1-24fa-4868-87db-5868daa8d6d4",
                                                "sense_id": "fdcdc1bf-4848-3d86-9d46-42fbe17edf0e",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07b974a-d714-30d4-9abf-409d70f7c15b",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Superiority; mastery; — used with of to specify its nature or with over to specify the other party."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d0e1b0-3247-4ddc-a184-241fa201abb3",
                                                "sense_id": "a07b974a-d714-30d4-9abf-409d70f7c15b",
                                                "text": "Lest Satan should get an advantage of us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Superiority of state, or that which gives it; benefit; gain; profit"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977d2df2-9d31-4c4d-b343-970cd1e2e063",
                                                "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                                "text": "the advantage of a good constitution"
                                            },
                                            {
                                                "example_id": "4363f239-135e-4a06-8be9-1ea0289c3657",
                                                "sense_id": "2175d6a8-9b0c-3bde-b127-ddc27198d58d",
                                                "text": "Having the faster car is of little advantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08356c00-8691-3d3f-b75f-dcaf97f42d8f",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "The score where one player wins a point after deuce but needs the next to carry the game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73f70fdb-daef-3f26-b32c-9082c0497f73",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "The continuation of the game after a foul against the attacking team, because the attacking team are in an advantageous position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26559267-9297-4b60-9d7e-307b259fbc71",
                                                "sense_id": "73f70fdb-daef-3f26-b32c-9082c0497f73",
                                                "text": "Webb played an advantage that enabled Cazorla to supply a low cross from the left for Giroud to sweep home first time, despite Gallas and Vertonghen being in close attendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a40c87d-3e4e-35e0-a4d6-2fd8683b5320",
                                        "entry_id": "51ad47bb-b61d-3854-b009-4815ebb39610",
                                        "glosses": [
                                            "Interest of money; increase; overplus (as the thirteenth in the baker's dozen)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94664b2b-a3f1-4730-926b-61054d0b88e7",
                                                "sense_id": "3a40c87d-3e4e-35e0-a4d6-2fd8683b5320",
                                                "text": "And with advantage means to pay thy love."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advantage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3202a13c-f008-325d-9313-19251273639f",
                                        "entry_id": "14e542fd-66f2-33b1-bbf1-7ce99c568793",
                                        "glosses": [
                                            "to provide (someone) with an advantage, to give an edge to"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853c848d-e79f-485b-b91d-0ff0c3e2ffbc",
                                                "sense_id": "3202a13c-f008-325d-9313-19251273639f",
                                                "text": "I had almoſt forgotten to acquaint your honor, that one major Alford (who was in mr. Love's conſpiracy) was of the graund inqueſt at Saliſbury, and was very zealous in his highneſſe ſervice here, and his good affection and wiſe carriage here, did much advantage the buſſineſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f64b8d-6ec5-3229-bf6e-c4264356938e",
                                        "entry_id": "14e542fd-66f2-33b1-bbf1-7ce99c568793",
                                        "glosses": [
                                            "to do something for one's own benefit; to take advantage of"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857f1246-01ef-4c2c-85bb-d8f6cdb6d2df",
                                                "sense_id": "13f64b8d-6ec5-3229-bf6e-c4264356938e",
                                                "text": "No man of courage vouchsafeth to advantage himselfe [translating s'avantager] of that which is common unto many."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
