        "fr-extract.jsonl": [
            {
                "entry_id": "58cfc309-14f5-322b-8fd6-c6461b53f9a6",
                "word": "incommodité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71a23a23-61e6-4f7f-9005-e5c3101c530a",
                        "entry_id": "58cfc309-14f5-322b-8fd6-c6461b53f9a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "incommodités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                        "entry_id": "58cfc309-14f5-322b-8fd6-c6461b53f9a6",
                        "glosses": [
                            "État de gêne, de malaise physique ou moral, causé par une chose qui fatigue, qui importune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb9f3b8-ac15-49e2-a779-44cab0c3037b",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Le seul moyen de se garantir d’oignons, & même de toute incommodité aux pieds, c'est d'être absolument en garde contre les chaussures trop courtes."
                            },
                            {
                                "example_id": "8cfc395a-c2a7-4f0b-83e3-39eaf262dd50",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "C’est une grande incommodité que d’être mal logé."
                            },
                            {
                                "example_id": "66726a84-f77b-44dd-a96c-fc7a491aba68",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Je serais fâché de vous causer la moindre incommodité."
                            },
                            {
                                "example_id": "6924e414-c5ab-4741-a9bc-6aa37919a650",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Il n’y a rien gui n’ait ses incommodités."
                            },
                            {
                                "example_id": "b72b24cd-dbe4-4fa3-b9a1-db5db5648cb2",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Il en souffre, il en ressent déjà l’incommodité."
                            },
                            {
                                "example_id": "657d4160-b1e5-4dfd-8a90-c97f44f9f51a",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Les incommodités de l’âge, de la vieillesse."
                            },
                            {
                                "example_id": "c33a0472-c237-4dc2-9fd5-6b9dec6de530",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Il commence à ressentir de grandes incommodités."
                            },
                            {
                                "example_id": "71ed9d18-3abe-435f-b922-69ee54763753",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Il est sujet à beaucoup d’incommodités."
                            },
                            {
                                "example_id": "2ddee98f-2423-4742-a83f-644e00043075",
                                "sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                                "text": "Signal d’incommodité, signal par lequel un bâtiment fait connaître qu’il a besoin d’aide ou qu’il est gêné dans sa manœuvre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4de381dd-eae0-4e5c-afbb-0df6da4beb9c",
                        "source_entry_id": "58cfc309-14f5-322b-8fd6-c6461b53f9a6",
                        "source_sense_id": "3168b055-e336-341f-9bf5-1e7671ca18a1",
                        "target_lang_word": "inconvenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconvenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce970598-380f-3241-81ec-850a51512c3b",
                                        "entry_id": "5dc563a2-27ec-3e15-9e73-13d0ae89f984",
                                        "glosses": [
                                            "The quality of being inconvenient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde8fdac-5033-4212-9e96-f2e928c611e1",
                                                "sense_id": "ce970598-380f-3241-81ec-850a51512c3b",
                                                "text": "They plead against the inconvenience, not the unlawfulness, […] of ceremonies in burial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                        "entry_id": "5dc563a2-27ec-3e15-9e73-13d0ae89f984",
                                        "glosses": [
                                            "Something that is not convenient, something that bothers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9e191b-7f83-4560-adea-142cf0c01330",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "[Man] is liable to a great many inconveniences."
                                            },
                                            {
                                                "example_id": "2cd8da19-92e5-4fa2-a9f7-0089a60ff36f",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "The inconveniences that must be endured before the modernisation plan can come into action may be seen at Coventry, where since August the station has been in the throes of rebuilding."
                                            },
                                            {
                                                "example_id": "a8c8c1e9-3326-4f1d-a25f-8267efa3d93c",
                                                "sense_id": "8729b5a9-581b-39f2-9443-154508943127",
                                                "text": "An artificial kidney […] can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inconvenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c202815-51d5-3c3e-9b15-b631ec05ac5d",
                                        "entry_id": "30ea56cf-35cb-3e38-a92e-08e0a80c8372",
                                        "glosses": [
                                            "To bother; to discomfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358da721-c7a2-424e-9d9b-7e5b9167a1a8",
                                                "sense_id": "7c202815-51d5-3c3e-9b15-b631ec05ac5d",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
