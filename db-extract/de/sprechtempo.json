                "senses": [
                    {
                        "sense_id": "d72c1168-a2ba-3811-bf25-160aba5c8890",
                        "entry_id": "8e3cb501-61ed-3bb8-bf0f-c3c5f6610f7f",
                        "glosses": [
                            "Linguistik, Logopädie, Geschwindigkeit, mit der jemand spricht"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "f877c3cf-39a6-44b8-b4f3-e834d5ab9475",
                                "sense_id": "d72c1168-a2ba-3811-bf25-160aba5c8890",
                                "text": "„In Frankreich steigt das Sprechtempo mit der Spannung.“"
                            },
                            {
                                "example_id": "625f9964-6101-40f6-840c-60e20a915f9d",
                                "sense_id": "d72c1168-a2ba-3811-bf25-160aba5c8890",
                                "text": "Das Sprechtempo beträgt normalerweise zwischen 4-6 Silben pro Sekunde beziehungsweise um 20 Laute."
                            },
                            {
                                "example_id": "b958b282-0442-4d3f-ab59-d4b89797595c",
                                "sense_id": "d72c1168-a2ba-3811-bf25-160aba5c8890",
                                "text": "„Sprechtempo ist der Spiegel des Ablaufs innerer Bewegung.“"
                            },
                            {
                                "example_id": "998870db-4e59-4c7e-8913-c89a340dc266",
                                "sense_id": "d72c1168-a2ba-3811-bf25-160aba5c8890",
                                "text": "„Er trägt ein offenes Hemd, ist energisch und hemdsärmelig und könnte vom Sprechtempo her auch ein Fußballspiel kommentieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
