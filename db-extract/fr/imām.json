                ],
                "translations": [
                    {
                        "translation_id": "ce38b1ea-a02b-430f-958d-9359a89a8699",
                        "source_entry_id": "228e75ff-a75b-31b2-be67-714020f1a333",
                        "target_lang_word": "Imam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "jemand, der ein Gebet (der Gemeinde) vorträgt oder Teile davon im Wechsel mit der Gemeinde spricht; jemand, der das rituelle Gebet in der Moschee leitet"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bedeef8f-ab57-4f3e-82be-73129e6e8976",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Laßt uns ‚unserem‘ Gott in Kirche, Synagoge und Moschee huldigen, damit wir uns um so besser im gemeinsamen Raum der Demokratie verständigen können. Und dessen Regeln bestimmen nicht Rabbi, Imam oder Pfarrer, sondern Grundgesetz und Verfassungsgericht.“"
                                            },
                                            {
                                                "example_id": "933c1969-8e4b-4584-afb7-0e027e7fd1ed",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Der Berliner Imam Kadir Sanci, der dem geplanten Lehr- und Gebetshaus von Muslimen, Christen und Juden ‚House of One‘ angehört, begrüßte die Solidaritätskundegebungen mit der Kippa.“"
                                            },
                                            {
                                                "example_id": "c0d151b3-2775-4bf1-897f-30a269bf4882",
                                                "sense_id": "5ad2deca-dd2f-3d65-a76f-ce858dc8cd69",
                                                "text": "„Der Wunsch, ein Imam zu werden, wuchs in mir heran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "967df4a1-d50f-3c29-a0a5-f5208a968c49",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "Ehrentitel, mit dem verdiente islamische Gelehrte (vor allem Theologen und Juristen) angesprochen werden (insbesondere die Begründer der vier orthodoxen Gesetzesschulen: Abū Ḥanīfa, aš-Šāfiʿī, Aḥmad ibn Ḥanbal, Mālik ibn Anas)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5456f88-4a9d-45b2-886b-7cb39a3f584e",
                                                "sense_id": "967df4a1-d50f-3c29-a0a5-f5208a968c49",
                                                "text": "„Persien wurde neben dem Irak das Kerngebiet der Schiiten, nicht zuletzt, weil die Perser als Nicht-Araber ähnlich wie die von ihnen verehrten Imame Ali und Hussein im Ränkespiel um die Führerschaft die Verlierer waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "393cc816-f81d-3df5-9766-c37d2414b4a0",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "religiöses Oberhaupt der gesamten islamischen Gemeinde, das als Nachfahr aus der Familie des Propheten stammt"
                                        ],
                                        "tags": [
                                            "Islam",
                                            "Schiismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72b3de6-1f7a-4c7e-b38e-4309893ede02",
                                                "sense_id": "393cc816-f81d-3df5-9766-c37d2414b4a0",
                                                "text": "„Die britische Times ist ähnlicher Ansicht und schreibt zum achten Jahrestag der iranischen Morddrohung gegen Salman Rushdie: ‚Nach fünf Jahren eines »kritischen Dialogs« mit Teheran ist es an der Zeit, zu akzeptieren, daß die Fatwa wohl solange nicht aufgehoben wird, wie der Iran ein von fundamentalistischen Imams geführter Staat religiöser Ausrichtung ist…‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b577d4fe-19ec-3ee5-b7e7-eb5baf402bf2",
                                        "entry_id": "b12e348e-78cc-35ed-9520-fd2f7a639bf5",
                                        "glosses": [
                                            "Titel ehemaliger jemenitischer Herrscher"
                                        ],
                                        "tags": [
                                            "Islam",
                                            "Jemen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f222f3dc-2bf2-473e-bbff-3c49801873b5",
                                                "sense_id": "b577d4fe-19ec-3ee5-b7e7-eb5baf402bf2",
                                                "text": "„Imam Yahia, der 71jährige Herrscher von Yemen, wollte von den Amerikanern nicht viel wissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1850de1c-5ac1-45ae-bfd5-6d95d25bfca9",
                        "source_entry_id": "228e75ff-a75b-31b2-be67-714020f1a333",
                        "target_lang_word": "imam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab28485-ea0c-3716-b7be-9452d6d8217e",
                                        "entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                                        "glosses": [
                                            "One who leads the salat prayers in a mosque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205f919e-7a08-47e8-a742-7fa69efac6fa",
                                                "sense_id": "1ab28485-ea0c-3716-b7be-9452d6d8217e",
                                                "text": "Now it chanced that in one of the mosques was an Imam. (footnote: The person specially appointed to lead the prayers of the congregation and paid out of the endowed revenues of the mosque to which he is attached)"
                                            },
                                            {
                                                "example_id": "f3be0fa9-aad0-4d0b-83e4-213a069a1376",
                                                "sense_id": "1ab28485-ea0c-3716-b7be-9452d6d8217e",
                                                "text": "But then there's a Christian cleric and an imam on each of the country's three regional censorship boards, in Kaduna, Lagos and Onitsha, although more than one producer told me that the brown envelope worked the same magic here as in any other Nigerian Government department."
                                            },
                                            {
                                                "example_id": "eab5d919-1023-4e1b-afe0-6feefb90f1b0",
                                                "sense_id": "1ab28485-ea0c-3716-b7be-9452d6d8217e",
                                                "text": "In the 1980s, roughly six hundred young Algerian men, many of them protégés of Muslim Brothers from Egypt and Wahhabi imams from Saudi Arabia, went to Afghanistan to join the anti-Soviet jihad."
                                            },
                                            {
                                                "example_id": "4af23242-0d56-4b33-a755-83bde663d7ed",
                                                "sense_id": "1ab28485-ea0c-3716-b7be-9452d6d8217e",
                                                "text": "The critically low level of rainfall in the second half of 2020 – approaching 50% year on year for November – led the religious affairs directorate to instruct imams and their congregations to pray for rain last month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905eb953-e257-3ed6-b0fd-1e72a845e576",
                                        "entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                                        "glosses": [
                                            "A Shi'ite Muslim leader descended from the prophet Muhammad and functioning as his spiritual successor."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8328d62-d496-3420-aefc-a927519cd3bb",
                                        "entry_id": "5ad2e2ee-70a9-30d8-b7a6-f23c07e1295f",
                                        "glosses": [
                                            "A Shi'ite Muslim leader descended from the prophet Muhammad and functioning as his spiritual successor.",
                                            "One of the Twelve imams, descendants of Muhammad from the seventh to ninth centuries CE who lived exemplary lives."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
