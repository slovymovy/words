{
    "word_family": [
        "confinement",
        "unconfined"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "779e945a-b9cb-329f-a14b-bb4745515baa",
                    "sense_definition": "Unable to leave a particular place, often due to illness, disability, or imprisonment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "restriction_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mia was <w>confined</w> to her bedroom after suffering a broken leg.",
                            "target_lang_translations": {
                                "ru": "Мия была <w>прикована</w> к своей спальне после того, как сломала ногу.",
                                "de": "Mia war nach ihrem Beinbruch an ihr Schlafzimmer <w>gefesselt</w>."
                            }
                        },
                        {
                            "text": "The prisoner remained <w>confined</w> in his cell for twenty-three hours a day.",
                            "target_lang_translations": {
                                "ru": "Заключенный оставался <w>заточённым</w> в своей камере двадцать три часа в сутки.",
                                "de": "Der Gefangene blieb dreiundzwanzig Stunden am Tag in seiner Zelle <w>eingesperrt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "restricted",
                        "captive"
                    ],
                    "antonyms": [
                        "free",
                        "liberated"
                    ],
                    "common_phrases": [
                        "confined to bed",
                        "confined to a wheelchair",
                        "confined to barracks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный покинуть определенное место, часто из-за болезни, инвалидности или тюремного заключения.",
                        "de": "Nicht in der Lage, einen bestimmten Ort zu verlassen, oft aufgrund von Krankheit, Behinderung oder Inhaftierung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикованный",
                                "target_lang_sense_clarification": "к месту или постели из-за болезни"
                            },
                            {
                                "target_lang_word": "заточённый",
                                "target_lang_sense_clarification": "находящийся в заключении"
                            },
                            {
                                "target_lang_word": "запертый",
                                "target_lang_sense_clarification": "не имеющий возможности выйти"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ans Bett gefesselt",
                                "target_lang_sense_clarification": "aufgrund von Krankheit oder Verletzung"
                            },
                            {
                                "target_lang_word": "eingesperrt",
                                "target_lang_sense_clarification": "in einem Raum oder einer Zelle festgehalten"
                            },
                            {
                                "target_lang_word": "gefangen",
                                "target_lang_sense_clarification": "in seiner Bewegungsfreiheit eingeschränkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "323b5f69-6bea-3b16-a56d-1882c135e905",
                    "sense_definition": "Very small, narrow, or enclosed, offering little space to move.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction_spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Working in a <w>confined</w> space can be dangerous without proper ventilation.",
                            "target_lang_translations": {
                                "ru": "Работа в <w>замкнутом</w> пространстве может быть опасна без надлежащей вентиляции.",
                                "de": "Das Arbeiten in einem <w>beengten</w> Raum kann ohne ausreichende Belüftung gefährlich sein."
                            }
                        },
                        {
                            "text": "They lived in a <w>confined</w> apartment with barely enough room for a bed.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>тесной</w> квартире, где едва хватало места для кровати.",
                                "de": "Sie lebten in einer <w>engen</w> Wohnung, in der kaum Platz für ein Bett war."
                            }
                        }
                    ],
                    "synonyms": [
                        "cramped",
                        "narrow",
                        "restricted",
                        "enclosed"
                    ],
                    "antonyms": [
                        "spacious",
                        "roomy",
                        "open"
                    ],
                    "common_phrases": [
                        "confined space",
                        "confined area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький, узкий или замкнутый, предлагающий мало места для движения.",
                        "de": "Sehr klein, eng oder umschlossen, bietet wenig Platz zum Bewegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замкнутый",
                                "target_lang_sense_clarification": "о пространстве"
                            },
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "о помещении"
                            },
                            {
                                "target_lang_word": "ограниченный",
                                "target_lang_sense_clarification": "о пространстве или площади"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beengt",
