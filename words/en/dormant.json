    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ea11a8f-e879-3ce3-9f5e-c7b8ff3714ed",
                    "sense_definition": "Temporarily inactive or in a state of deep sleep, often waiting for the right conditions to become active again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dormant</w> volcano has not erupted for centuries, but scientists still monitor it closely.",
                            "target_lang_translations": {
                                "ru": "<w>Спящий</w> вулкан не извергался веками, но ученые по-прежнему внимательно следят за ним."
                            }
                        },
                        {
                            "text": "Many plants remain <w>dormant</w> during the winter to survive the freezing temperatures.",
                            "target_lang_translations": {
                                "ru": "Многие растения остаются в состоянии <w>покоя</w> зимой, чтобы пережить морозы."
                            }
                        },
                        {
                            "text": "The bank decided to close the <w>dormant</w> account because there were no transactions for years.",
                            "target_lang_translations": {
                                "ru": "Банк решил закрыть <w>неактивный</w> счет, так как по нему годами не проводилось никаких операций."
                            }
                        }
                    ],
                    "synonyms": [
                        "inactive",
                        "quiescent"
                    ],
                    "antonyms": [
                        "active",
                        "extinct"
                    ],
                    "common_phrases": [
                        "dormant volcano",
                        "dormant account",
                        "lie dormant",
                        "dormant state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно неактивный или находящийся в состоянии глубокого сна, часто в ожидании подходящих условий для возобновления активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спящий",
                                "target_lang_sense_clarification": "о вулканах, растениях или почках"
                            },
                            {
                                "target_lang_word": "неактивный",
                                "target_lang_sense_clarification": "о банковских счетах или процессах"
                            },
                            {
                                "target_lang_word": "бездействующий",
                                "target_lang_sense_clarification": "находящийся в состоянии покоя"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "о латентных стадиях или талантах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45e25e44-5baa-31bf-8fdb-b82c71cb8009",
                    "sense_definition": "Depicted in a sleeping posture, especially in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's shield featured a lion <w>dormant</w> to symbolize peace and rest.",
                            "target_lang_translations": {
                                "ru": "На щите рыцаря был изображен <w>спящий</w> лев, символизирующий мир и покой."
                            }
                        },
                        {
                            "text": "In heraldic art, a <w>dormant</w> animal is shown with its head resting on its forepaws.",
                            "target_lang_translations": {
                                "ru": "В геральдическом искусстве <w>спящее</w> животное изображается с головой, лежащей на передних лапах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lion dormant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображенный в спящей позе, особенно в геральдике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спящий",
                                "target_lang_sense_clarification": "в геральдике, о животном с головой на лапах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
