                    {
                        "translation_id": "ea1a2f14-3f51-44b3-b484-a547ab36cddb",
                        "source_entry_id": "419cf002-2a6a-312b-9aae-1aa5a40b9b8f",
                        "source_sense_id": "3b6dc1b7-fe75-3d24-bb78-cd10f081d31a",
                        "source_sense_description": "(biologie) het transportsysteem van vaatplanten",
                        "target_lang_word": "Gefäß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefäß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9cbe51-3184-38e4-ad77-69c85e99b1c4",
                                        "entry_id": "5b3186cc-c160-3593-a661-5f656dbbb77e",
                                        "glosses": [
                                            "ein Behälter, in dem Stoffe verschiedener Beschaffenheit aufbewahrt und transportiert werden können"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddc355da-6fe7-4790-b35e-cd66e9c82979",
                                                "sense_id": "9f9cbe51-3184-38e4-ad77-69c85e99b1c4",
                                                "text": "Schnell, irgendein Gefäß, um das Wasser aufzufangen!"
                                            },
                                            {
                                                "example_id": "1afceefe-31fc-4670-85e3-2800e8b08ec6",
                                                "sense_id": "9f9cbe51-3184-38e4-ad77-69c85e99b1c4",
                                                "text": "„Der letzte Rest der Kraft rann aus ihm wie Wasser aus einem Gefäß.“"
                                            },
                                            {
                                                "example_id": "dda4b57b-2492-41d9-ad5f-4c9bedce7079",
                                                "sense_id": "9f9cbe51-3184-38e4-ad77-69c85e99b1c4",
                                                "text": "„Hamid nahm das Gefäß und öffnete es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0ba395b-8402-3872-a8e5-0bb8d9f5ea05",
                                        "entry_id": "5b3186cc-c160-3593-a661-5f656dbbb77e",
                                        "glosses": [
                                            "schlauchförmiger Leitungsabschnitt für Körperflüssigkeiten wie Blut oder Lymphflüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe161726-9a1f-4120-a7f7-c474657586aa",
                                                "sense_id": "a0ba395b-8402-3872-a8e5-0bb8d9f5ea05",
                                                "text": "Ihre Gefäße machen mir Sorgen."
                                            },
                                            {
                                                "example_id": "d8ae3ba5-df1a-4926-994b-dd6197b102b8",
                                                "sense_id": "a0ba395b-8402-3872-a8e5-0bb8d9f5ea05",
                                                "text": "„Das ist nach wie vor nicht machbar, ein verkalktes Gefäß so hinzubekommen, dass es wieder gesund ist.“"
                                            },
                                            {
                                                "example_id": "a6122e07-7fbe-422c-a0f0-aa96c5ab6a38",
                                                "sense_id": "a0ba395b-8402-3872-a8e5-0bb8d9f5ea05",
                                                "text": "„Unter dem Mikroskop zeigen sich dabei sogar kleine Gefäße, durch die Saurierherzen einst das Blut pumpten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "674015f3-1efc-3d10-a4c1-3c275c48db75",
                                        "entry_id": "5b3186cc-c160-3593-a661-5f656dbbb77e",
                                        "glosses": [
                                            "eine röhrenförmige Leitungsbahn, die dem Transport von Wasser und Nährsalzen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da6b952-481e-42c4-8152-be08c40efa8e",
                                                "sense_id": "674015f3-1efc-3d10-a4c1-3c275c48db75",
                                                "text": "Gefäßbündel bestehen aus Gefäßen und langgestreckten, röhrigen, prismatischen oder spindeligen Zellen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "940fb18d-35fa-3377-8dfd-7c086851d882",
                                        "entry_id": "5b3186cc-c160-3593-a661-5f656dbbb77e",
                                        "glosses": [
                                            "der Griff einer Blankwaffe wie Schwert, Degen oder Säbel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93aa29c8-91a6-4b46-a9a2-4670bb7bbfff",
                                                "sense_id": "940fb18d-35fa-3377-8dfd-7c086851d882",
                                                "text": "Die Form des Gefäßes (Griffes) ist dagegen nicht Bestandteil der Spatha-Definition."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
