                    {
                        "sense_id": "178dfc44-5332-3029-8482-68cf913ac303",
                        "entry_id": "1d49f2de-0c69-3542-a3ca-2a49c646c3c6",
                        "glosses": [
                            "A set of spiritual practices and traditions created and concealed from slave-owners by enslaved Africans in North America, based on traditional African beliefs."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "190964fe-1378-3f1c-b3d3-93b0a0ab1b5c",
                        "entry_id": "1d49f2de-0c69-3542-a3ca-2a49c646c3c6",
                        "glosses": [
                            "A practitioner of voodoo."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c90bd7d8-6b8f-39b6-9008-9aef6fda7cf2",
                        "entry_id": "1d49f2de-0c69-3542-a3ca-2a49c646c3c6",
                        "glosses": [
                            "Supernatural bad luck, or something or someone believed to bring bad luck."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6aa00df3-279d-4e6a-afc4-d9cf3747dc62",
                                "sense_id": "c90bd7d8-6b8f-39b6-9008-9aef6fda7cf2",
                                "text": "The three men wondered whether they would find Colson at Taylor's Creek. They felt that a hoodoo hung over the place."
                            }
                        ]
                    },
                    {
                        "sense_id": "28e78b6f-cf22-36ae-8953-a443842b6f10",
                        "entry_id": "1d49f2de-0c69-3542-a3ca-2a49c646c3c6",
                        "glosses": [
                            "A tall thin spire of rock that protrudes from the bottom of arid basins and badlands."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb30f772-7798-4569-9cf9-962a76f895ba",
                                "sense_id": "28e78b6f-cf22-36ae-8953-a443842b6f10",
                                "text": "It was even larger than the mirage made it look—a dozen miles across and a thousand feet deep, with fins and towers and hoodoos like observation posts, mesas and minor buttes, springs flowing brightly in the red rock."
                            },
                            {
                                "example_id": "c03cec74-7bd3-43f5-80a0-cccca51e5889",
                                "sense_id": "28e78b6f-cf22-36ae-8953-a443842b6f10",
                                "text": "This park’s strange and beautiful rock formations were formed by the Yellowstone River and various streams that have cut through the rock over millions of years, carving out hoodoos, spires and caprocks. The name Makoshika comes from a Lakota word for badlands."
                            }
                        ]
                    }
                ],
