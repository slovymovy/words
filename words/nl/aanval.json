                    "sense_id": "d8e544af-ba09-3d2e-9379-e759a5cc9eb0",
                    "sense_definition": "Een gewelddadige handeling of militaire actie met als doel een vijand te verslaan of schade toe te brengen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aggression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten bereidden zich in stilte voor op de <w>aanval</w>.",
                            "target_lang_translations": {
                                "en": "The soldiers prepared silently for the <w>attack</w>.",
                                "ru": "Солдаты молча готовились к <w>атаке</w>.",
                                "fr": "Les soldats se préparaient en silence à l'<w>attaque</w>."
                            }
                        },
                        {
                            "text": "Soms is de <w>aanval</w> de beste verdediging in een conflict.",
                            "target_lang_translations": {
                                "en": "Sometimes <w>attack</w> is the best defense in a conflict.",
                                "ru": "Иногда <w>нападение</w> — это лучшая защита в конфликте.",
                                "fr": "Parfois, l'<w>attaque</w> est la meilleure défense dans un conflit."
                            }
                        }
                    ],
                    "synonyms": [
