                        "cross_references": [
                            {
                                "target_word": "chapeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Coiffe d’homme ou de femme, plus ou moins rigide, avec des bords."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d48684-7c9b-472b-8f5c-07ac6aa70f2e",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Notre ami, fabricant de drap, a découvert le moyen de retrouver l’indigo des vieux habits bleus, et il voulait vous voir comme un grand phénomène, car vous avez dit : Le chapeau, c’est l’homme."
                                            },
                                            {
                                                "example_id": "efcf160b-efba-4ac8-9484-975a81a40968",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Soit prudence ou hasard, le fugitif avait le front entièrement couvert par un chapeau qui lui tombait sur les yeux."
                                            },
                                            {
                                                "example_id": "3a4ca0f9-0a71-4489-9df0-e73dc967472c",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Leur costume consistait en une grossière vareuse de laine noire […] un chapeau à vastes bords, un pantalon à lisère rouge et un morceau de cuir replié en manière de chaussure."
                                            },
                                            {
                                                "example_id": "d045ef3a-eb6f-4a23-a717-65522fbfbc42",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Voyait-il d’autres femmes, des roumia qui sortent sans voile et qui ont des robes de soie et des chapeaux comme celles qui venaient visiter les ruines ?"
                                            },
                                            {
                                                "example_id": "099f4c71-ca39-4de5-af92-22f053ed686b",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Elle prend un chapeau, en ébouriffe un peu le ruban, puis tient la garniture de roses de ce chapeau près de sa figure, devant la glace […]"
                                            },
                                            {
                                                "example_id": "301a6333-e493-4577-8ead-f509b25d0f9d",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Que ne trouve-t-on pas dans les greniers ? […] ; des chapeaux gigantesques à la Maupin ; des chapeaux minuscules à la Récamier […]"
                                            },
                                            {
                                                "example_id": "cd88b5dd-a0b4-47a7-bbf3-4de3f64cdc8c",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Il fallait la voir regarder, de ses yeux bordés de rouge, les étalages des bas de soie brodés, et les chapeaux joliment chiffonnés, qui, chez les modistes, se dressent fièrement au haut des champignons de palissandre !"
                                            },
                                            {
                                                "example_id": "99c98c78-0c69-4427-ab7c-47283e0c245e",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Le parfait gentleman qu’est mon vieil ami Jacques arborait ce soir-là une suave écharpe de soie, d’impeccables chaussures vernies, un pardessus du bon faiseur et un chapeau d’au moins vingt louis."
                                            },
                                            {
                                                "example_id": "449fe3df-d1c2-454d-b8db-c8ec73854d2a",
                                                "sense_id": "76a5c121-0506-3a39-9a18-b02e10b85152",
                                                "text": "Je me souviens vaguement des traits de la gamine, une blondine coiffée d’un chapeau de paille orné de cerises artificielles, avec une robe en lingerie blanche, percée de trou-trous ourlés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b099d574-f7a6-3f42-a21a-ef88db407496",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Partie supérieure ronde de certains types de champignons appelée aussi tête ou carpophore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d54ea3-0346-4593-9fb2-8c468d4075d7",
                                                "sense_id": "b099d574-f7a6-3f42-a21a-ef88db407496",
                                                "text": "Bolet (d’un mot grec qui veut dire boule). Ce nom a été appliqué à ces plantes parce que leur chapeau est souvent globuleux."
                                            },
                                            {
                                                "example_id": "591aa598-578c-4c4e-afe7-c7df3ee3f364",
                                                "sense_id": "b099d574-f7a6-3f42-a21a-ef88db407496",
                                                "text": "Ripartites helomorphus se distingue de ses congénères par le chapeau gibbeux et charnu, beaucoup plus épais que la largeur des lamelles, par l'absence de cils marginaux et par ses spores très petites à verrues basses et arrondies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8448ba3e-d0ed-3436-ac85-8c9d8dcd69d5",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Lignes de texte, mises en valeur, qui introduisent un article de journal ou de magazine, ou un texte dans un manuel scolaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4b6b33-fed6-4368-9009-c6b9934f402b",
                                                "sense_id": "8448ba3e-d0ed-3436-ac85-8c9d8dcd69d5",
                                                "text": "Denissov exultait. La réaction de ses chefs de service validait son intuition. Il baissa les bras, chaussa de grosses lunettes d’écaille et entreprit de lire à haute voix le chapeau de l’article."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aeb6355-8554-38f4-944b-b68a9ecb91c9",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Chose qui a un rapport de forme ou de destination avec un chapeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da421d7-c51e-439e-868e-2104122487e9",
                                                "sense_id": "5aeb6355-8554-38f4-944b-b68a9ecb91c9",
                                                "text": "La bouche d’incendie est terminée par un pas de vis destiné à recevoir, soit un chapeau couvert, soit la virole du tuyau de cuir qui alimente les pompes à incendie."
                                            },
                                            {
                                                "example_id": "b2a36e82-e214-4ca4-bb7a-608a20907ec7",
                                                "sense_id": "5aeb6355-8554-38f4-944b-b68a9ecb91c9",
                                                "text": "Chapeau d’escalier. Chapeau de lucarne. Le chapeau d’une presse, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c56acb-4fce-3b20-b015-4606a2dfa742",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Coiffe d’un axe, d’une extrémité d’une pièce mécanique."
                                        ],
