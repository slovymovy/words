                "translations": [
                    {
                        "translation_id": "2e2a3ac5-ac13-471c-bdb0-58663fbc8582",
                        "source_entry_id": "d8bec97f-f94b-3f7b-8acd-312028242ea0",
                        "target_lang_word": "régulièrement",
