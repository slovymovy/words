                    },
                    {
                        "form_id": "aaf01e7e-eb2a-4389-aae6-6e9c11635922",
                        "entry_id": "512c02e0-65e8-346f-a205-f899ef9515c6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "неисповеди́мей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "029e166f-67e9-3cf1-ae44-edaf72794500",
                        "entry_id": "512c02e0-65e8-346f-a205-f899ef9515c6",
                        "glosses": [
                            "устар., высок. не поддающийся пониманию; непостижимый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd51d76a-1a8e-48de-9aed-45ae7ced3d26",
                                "sense_id": "029e166f-67e9-3cf1-ae44-edaf72794500",
                                "text": "Зрелище порабощения девушки было неисповедимо таинственно и беззастенчиво откровенно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b73ee29d-5775-4261-8254-7c0de66152fa",
                        "source_entry_id": "512c02e0-65e8-346f-a205-f899ef9515c6",
                        "source_sense_id": "029e166f-67e9-3cf1-ae44-edaf72794500",
                        "target_lang_word": "unsearchable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsearchable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0873ce1-3bee-3d2a-bfb7-2b9665de1be5",
                                        "entry_id": "a951b1ea-f71a-318e-ad4c-526b299ada2f",
                                        "glosses": [
                                            "That cannot be searched or investigated into; inscrutable, unknowable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db005a5-b542-47f2-a236-2f389a062db1",
                                                "sense_id": "c0873ce1-3bee-3d2a-bfb7-2b9665de1be5",
                                                "text": "He chastiseth and corrects, as to Him seems best, in His deep, unsearchable, and secret judgment, and all for our good."
                                            },
                                            {
                                                "example_id": "826e32de-b008-493a-ae7f-71b75652fa39",
                                                "sense_id": "c0873ce1-3bee-3d2a-bfb7-2b9665de1be5",
                                                "text": "So intricate, ſo anfractuous, ſo unſearchable are the vvays of Providence."
                                            },
                                            {
                                                "example_id": "3c5c0e92-b4e5-48e4-b4bb-9af9e622609f",
                                                "sense_id": "c0873ce1-3bee-3d2a-bfb7-2b9665de1be5",
                                                "text": "Preachers warned […] that although God might sometimes make the meaning of his judgements clear they were normally unsearchable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9612169-8fa9-3b25-8a19-c20dd5acd563",
                                        "entry_id": "a951b1ea-f71a-318e-ad4c-526b299ada2f",
                                        "glosses": [
                                            "That cannot be sought out or looked for."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25ff7afc-6110-370f-b4a2-7a8bd15c35be",
                                        "entry_id": "a951b1ea-f71a-318e-ad4c-526b299ada2f",
                                        "glosses": [
                                            "Not capable of being searched; on which one cannot perform a search."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f565145-a0cc-489f-bd0d-25ed5569a431",
                                                "sense_id": "25ff7afc-6110-370f-b4a2-7a8bd15c35be",
                                                "text": "\"Having a band name like that makes me totally unsearchable,\" says Rhode Island artist Λ, explaining that his name is pronounced \"arc\", \"but I like how using symbols means favouring an aesthetic choice over a more practical one.[…]\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unsearchable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "783c45c6-fde3-3b1c-a242-b9082170bc74",
                                        "entry_id": "84be5219-9eca-3e2c-b8b2-f01d9cc90093",
                                        "glosses": [
                                            "That which is unknowable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "298e2038-a69b-448a-b534-512655b9e78a",
                                                "sense_id": "783c45c6-fde3-3b1c-a242-b9082170bc74",
                                                "text": "That there should be two unsearchables in the universe, that God should be one and man the other, would confer great dignity and honour upon us men were it not for the humiliating fact that it is our deceitfulness that renders us an inscrutable problem to all but God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94bd51bb-b84d-4c00-a0b1-6eb668ffcdef",
                        "source_entry_id": "512c02e0-65e8-346f-a205-f899ef9515c6",
                        "source_sense_id": "029e166f-67e9-3cf1-ae44-edaf72794500",
                        "target_lang_word": "inscrutable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inscrutable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                        "entry_id": "721596fe-e922-37fb-b5a9-5bf0195b711a",
                                        "glosses": [
                                            "Difficult or impossible to comprehend, fathom, or interpret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf604419-de3d-4566-aaf8-89a4ba7b4469",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "His inscrutable theories would years later become the foundation of a whole new science."
                                            },
                                            {
                                                "example_id": "06ade488-6c09-4419-956e-2a0123d5bf1d",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "The pale, inscrutable determinateness, and flinchless intrepidity of Pierre, now began to domineer upon them; for any social unusualness or greatness is sometimes most impressive in the retrospect."
                                            },
                                            {
                                                "example_id": "de5def77-e3c3-464b-b997-5972a96898ab",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "It was unconscious, this smile was, though just after he had said something it got intensified for an instant. It came at the end of his speeches like a seal applied on the words to make the meaning of the commonest phrase appear absolutely inscrutable."
                                            },
                                            {
                                                "example_id": "98f6ab16-5fb8-4f86-bad7-f9e68d54148b",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "She called my vanity license plate inscrutable! 'ICU81MI'? Hilarious!"
                                            },
                                            {
                                                "example_id": "e56580a9-410d-448d-814a-f4d9e4517ae4",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "The writer Juan Rulfo, whose 1955 novel, “Pedro Páramo,” still stands as the central monument of modern Mexican literature, grew up in Jalisco and vividly depicted its arid, sun-blasted landscapes in his writing, while the architect Luis Barragán, who moved from Guadalajara to Mexico City in the 1930s, carried with him an appreciation for his home state’s cloisters, haciendas and humble country buildings, which he translated in his own work as austere, inscrutable volumes of stucco."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inscrutable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a97a8ef0-12d7-3c28-9cfa-46701e43f0a5",
                                        "entry_id": "5ecfa31a-3789-30d6-938a-a6a5bc58655c",
                                        "glosses": [
                                            "One who or that which is inscrutable; a person, etc. that cannot be comprehended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
