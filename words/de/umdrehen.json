                    ]
                },
                {
                    "sense_id": "5376b13c-3ab6-304e-af07-a55fc87ad2ed",
                    "sense_definition": "Eine Situation, eine Reihenfolge oder ein Verhältnis ins Gegenteil verkehren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "umkehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der zweiten Halbzeit konnte die Mannschaft das Spiel noch völlig <w>umdrehen</w>."
                        },
                        {
                            "text": "In der Diskussion wollte sie den Spieß <w>umdrehen</w> und die anderen kritisieren."
                        }
                    ],
                    "synonyms": [
