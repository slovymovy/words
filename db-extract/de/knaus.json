                ],
                "senses": [
                    {
                        "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                        "entry_id": "24180685-6f79-31cb-9851-4065ebc0d03c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17ccd88e-ea1b-4f07-9c77-b11a6f9bd588",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Frau Knaus ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cde3bb83-a20b-47d2-b053-d05e8399a029",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Herr Knaus wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c4fc5e99-cdca-4d27-ab42-d03a23fbb799",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Die Knausens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b35dff30-d5db-441e-9478-db49e1624c25",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Der Knaus trägt nie die Schals, die die Knaus ihm strickt."
                            },
                            {
                                "example_id": "377d80f4-2f74-4c66-8282-168795a90a81",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knaus kommt, geht der Herr Knaus.“"
                            },
                            {
                                "example_id": "92d97811-6721-473f-b64a-de7aa4b0a9f4",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Knaus kommt und geht."
                            },
                            {
                                "example_id": "f78ab70d-b1c2-4453-81ef-c99b30a8f355",
                                "sense_id": "1a7032b7-22ad-30d7-b91b-7693cff5abb4",
                                "text": "Knaus’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
