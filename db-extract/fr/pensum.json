                "senses": [
                    {
                        "sense_id": "9f51fa62-c2dc-3a8b-a76b-97ebdacc2ece",
                        "entry_id": "587499c0-c5d2-396e-beef-fe00b9f47154",
                        "glosses": [
                            "pensum (at school); lines (UK)"
                        ],
                        "tags": [
                            "archaic",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "f765dc57-2168-423a-8902-850b00d5cd65",
                                "sense_id": "9f51fa62-c2dc-3a8b-a76b-97ebdacc2ece",
                                "text": "Cependant, sous la pluie des pensums, l’ordre peu à peu se rétablit dans la classe, et le professeur, parvenu à saisir le nom de Charles Bovary, se l’étant fait dicter, épeler et relire, commanda tout de suite au pauvre diable d’aller s’asseoir sur le banc de paresse, au pied de la chaire. Il se mit en mouvement, mais, avant de partir, hésita."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2bc2a6f-192b-35f6-adc2-a81022610c03",
                        "entry_id": "587499c0-c5d2-396e-beef-fe00b9f47154",
                        "glosses": [
                            "chore"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b4e04682-6006-40d4-a065-32e905576aa8",
                                "sense_id": "a2bc2a6f-192b-35f6-adc2-a81022610c03",
                                "text": "Mais ne perdez pas votre temps à ce pensum. C'est inutile.",
                                "translation": "But do not waste your time on this extra task. It is unnecessary.",
                                "english": "But do not waste your time on this extra task. It is unnecessary."
                            }
                        ]
                    }
