                        ]
                    },
                    {
                        "translation_id": "5e7278cf-0258-4292-bf5d-130a910f4353",
                        "source_entry_id": "9a33a845-3f69-3632-a028-80c6351e8f33",
                        "source_sense_id": "48f4281a-4730-38c1-a73d-494513aa096b",
                        "target_lang_word": "Perse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                        "entry_id": "7c0f37e3-a53e-3d4b-8082-7f2a47b943ba",
                                        "glosses": [
                                            "Iran antique ou historique."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30531bcd-5996-4f0c-93f6-d3b546efb3a0",
                                                "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                                "text": "Il serait absurde de donner maintenant à la Perse les 40 millions qu’elle pouvait à peine nourrir à l’époque de Chardin."
                                            },
                                            {
                                                "example_id": "46d3d5db-d389-4ce3-9654-bb5a2e79625e",
                                                "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                                "text": "La Perse n’a point de caste. Tous sont égaux chez elle au point de vue religieux."
                                            },
                                            {
                                                "example_id": "c30e9668-88da-4a85-8140-b18af87fe2ce",
                                                "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                                "text": "Celles que je viens d’entrevoir ont l’aspect de villas avec balustrades et toits à l’italienne. Singulier effet en Turkestan et dans le voisinage de la Perse."
                                            },
                                            {
                                                "example_id": "7b0f9a84-2440-4d5d-bbef-2bed6b839bdd",
                                                "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                                "text": "Le monde musulman put alors s’enorgueillir de quatre États célèbres : L’Égypte des Mamelouks, la Turquie ottomane, la Perse séfévide et l’Inde moghole."
                                            },
                                            {
                                                "example_id": "6e140790-1649-48cb-9987-d1ad0ec963f8",
                                                "sense_id": "0a16beaf-2ca9-3ef8-a2a7-82f1553ecc04",
                                                "text": "À l'origine du bahaïsme, mouvement religieux qui apparaît en Perse dans la deuxième moitié du XIXᵉ siècle, se trouve le babisme fondé par Seyed Ali Mohammad Shirazi (1819-1850)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Perse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebe8f3f9-e4b1-3e51-a5c7-09ee52e01876",
                                        "entry_id": "122473ff-d2d1-39ac-bf45-e6af5850a21a",
                                        "glosses": [
                                            "Habitant de la Perse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58eb54fe-b08f-409a-ab89-d144604fee28",
                                                "sense_id": "ebe8f3f9-e4b1-3e51-a5c7-09ee52e01876",
                                                "text": "Ils prirent la résolution de décamper la nuit, à la seconde veille, de crainte que les Perses venant à s'appercevoir ^([sic]) de leur départ ne les suivissent et ne les inquiétassent dans leur marche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fd791cd-7bdb-4975-abbf-d2e7b616233b",
                        "source_entry_id": "9a33a845-3f69-3632-a028-80c6351e8f33",
                        "source_sense_id": "48f4281a-4730-38c1-a73d-494513aa096b",
