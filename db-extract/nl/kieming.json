                        "sense_id": "8ac59702-2eca-3df2-a912-3d41f0970519",
                        "entry_id": "f32dbc2a-8153-3960-ba1b-5c4cf3ef150a",
                        "glosses": [
                            "het proces, waarbij het in een zaad aanwezige embryo of kiem door de zaadhuid heenbreekt en vervolgens tot een kiemplant uitgroeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa9d4b1-49c0-4df2-af64-9e1022b2081a",
                                "sense_id": "8ac59702-2eca-3df2-a912-3d41f0970519",
                                "text": "Na kieming moeten de planten ook nog ontsnappen aan de vraatzucht van slakken, want die lusten ze erg graag. Vaak zijn jonge plantjes te vinden tussen andere planten, waar het een beetje vochtig is."
                            },
                            {
                                "example_id": "cdc94503-d962-404e-8de9-bf7344c310ff",
                                "sense_id": "8ac59702-2eca-3df2-a912-3d41f0970519",
                                "text": "Ook het zaaien van orchideeën in grond levert meestal niets op. In de eerste plaats is het zaad maar kort kiemkrachtig en gunstige omstandigheden voor kieming en eerste groei ontbreken vaak."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bf03868-5194-37e9-9302-ad89a4ac30e3",
                        "entry_id": "f32dbc2a-8153-3960-ba1b-5c4cf3ef150a",
                        "glosses": [
                            "tot groei en ontwikkeling komen"
                        ],
