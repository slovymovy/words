                "senses": [
                    {
                        "sense_id": "45871e4c-fc5b-3a20-bb1c-64cad1bac3a3",
                        "entry_id": "727e5ff1-34cd-38b4-a304-cc15794deae7",
                        "glosses": [
                            "gewollter oder auch ungewollter Verzicht auf etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e7388f-2f01-43a9-832a-0ba05d4b9130",
                                "sense_id": "45871e4c-fc5b-3a20-bb1c-64cad1bac3a3",
                                "text": "Diese Generation war gekennzeichnet durch Rohheit infolge der Entsagungen während des Krieges."
                            },
                            {
                                "example_id": "1aa5d4a2-3674-4871-bcd2-3e23f7870e11",
                                "sense_id": "45871e4c-fc5b-3a20-bb1c-64cad1bac3a3",
                                "text": "„Das war eine Gegnerin, die mir gegenüberstand; und daß ich hinter Sophies Entsagung immer Haß gewittert hatte, zeigte mir wenigstens, wie hellsichtig ich war.“"
                            }
                        ],
