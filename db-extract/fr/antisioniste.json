                "senses": [
                    {
                        "sense_id": "be9b48fa-0a8d-3b52-8191-4944e79ddb54",
                        "entry_id": "b315a866-d39c-391b-89c4-1eab2406a2f7",
                        "glosses": [
                            "Adversaire du sionisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a10ee9-24e5-433b-9193-85941307aa53",
                                "sense_id": "be9b48fa-0a8d-3b52-8191-4944e79ddb54",
                                "text": "Issu d'une famille de juifs chassés d’Espagne en 1492, Abraham Serfaty, restait un antisioniste convaincu."
                            },
                            {
                                "example_id": "c7f748fa-98d7-4fe5-986c-e3cce4df7c7a",
                                "sense_id": "be9b48fa-0a8d-3b52-8191-4944e79ddb54",
                                "text": "Bernard-Henri Levy ou Alain Finkielkraut sont connus pour être des défenseurs de la cause israélienne, on ne peut les suspecter d’être des antisionistes radicaux."
                            }
                        ]
                    }
                ],
