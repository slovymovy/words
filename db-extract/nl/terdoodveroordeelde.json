                            {
                                "example_id": "5af5fbdc-9e3c-44e6-9aeb-2e9dd74fb3b5",
                                "sense_id": "e436bb08-a56a-396d-a58c-28b490fe2307",
                                "text": "De schoonzus van een terdoodveroordeelde beklaagt zich over de aanstaande executies."
                            },
                            {
                                "example_id": "b6044be7-fd0f-4ad9-9c9b-3c116e9a825c",
                                "sense_id": "e436bb08-a56a-396d-a58c-28b490fe2307",
                                "text": "Vorig jaar april mislukte een executie toen een nieuwe combinatie gifstoffen werd gebruikt. De terdoodveroordeelde overleed aan een hartaanval, drie kwartier nadat hem de dodelijke cocktail was toegediend. Volgens getuigen bewoog en kreunde Clayton Lockett terwijl hij rustig had moeten inslapen."
                            }
