                "translations": [
                    {
                        "translation_id": "7642eba4-4981-4865-83b3-d6fbaad063e2",
                        "source_entry_id": "787a2bd6-c0a2-3bf6-8114-96e3b3685661",
                        "source_sense_id": "fe881390-d04b-3dc1-8b94-201f47770bd9",
                        "source_sense_description": "een speciaal brood gebakken voor de kerst gevuld met noten, vruchten en spijs",
                        "target_lang_word": "Christstollen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christstollen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                        "entry_id": "55e15aca-7981-316d-8ea7-6202d84f5e2a",
                                        "glosses": [
                                            "traditionell in der Weihnachtszeit gebackener länglicher, brotförmiger Weihnachtskuchen aus Hefeteig, Rosinen, Mandeln sowie Zitronat und verschiedenen Gewürzen"
                                        ],
                                        "tags": [
                                            "Backkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000359c5-26f6-48e9-9e12-1ca5af8af602",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "Auf dem festlichen Tisch stand der Christstollen."
                                            },
                                            {
                                                "example_id": "9cc7d6fd-453f-4408-9bee-192f66f85d14",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Den Christstollen auf das vorbereitete Backblech legen und im heißen Ofen etwa 50 Minuten backen.“"
                                            },
                                            {
                                                "example_id": "e8fdeb3d-5104-4c87-b8fa-9c58fe7e3e3c",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Was gibt es in der Weihnachtszeit Traditionelleres, als einen schönen saftigen Christstollen?“"
                                            },
                                            {
                                                "example_id": "5d6ead03-362c-415c-9dc8-2ef0df6e3428",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Jonas und Troll seufzten gleichzeitig, und dann nahm Jonas einen Christstollen, eine Flasche Saft und eine Gitarre aus seinem grünen Rucksack.“"
                                            },
                                            {
                                                "example_id": "8b3d3dc8-4b33-4904-8ca3-d16c8ec37001",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Weihnachten ohne den »Dresdner Christstollen« konnte sich niemand in der Familie vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb2f402-3aae-4d87-bfce-73a7f2c44e2a",
                        "source_entry_id": "787a2bd6-c0a2-3bf6-8114-96e3b3685661",
                        "source_sense_id": "fe881390-d04b-3dc1-8b94-201f47770bd9",
                        "source_sense_description": "een speciaal brood gebakken voor de kerst gevuld met noten, vruchten en spijs",
                        "target_lang_word": "Stollen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stollen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "524b2f12-fe07-317f-9e90-fd72c3b41aa3",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "unterirdischer, waagerechter Gang"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "777466e4-a853-43a4-9206-3fea34edbb29",
                                                "sense_id": "524b2f12-fe07-317f-9e90-fd72c3b41aa3",
                                                "text": "Taubes Gestein wurde im Stollen rechts und links abgelagert."
                                            },
                                            {
                                                "example_id": "da975128-6705-4bf7-9181-dc6900b14745",
                                                "sense_id": "524b2f12-fe07-317f-9e90-fd72c3b41aa3",
                                                "text": "„Wenn der Hauer die Erzbrocken aus dem Stollen geklopft hat, sind sie noch lange nicht aus dem Berg.“"
                                            },
                                            {
                                                "example_id": "f4ed0fe7-087c-42d3-bc11-3b6cec855985",
                                                "sense_id": "524b2f12-fe07-317f-9e90-fd72c3b41aa3",
                                                "text": "„Der Bergwerksdirektor, ein Mann namens Helmut Landmann, und der örtliche Güterdirektor Hans Feyerabend weigerten sich, die Stollen zu öffnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0191a25c-1632-3828-b734-da634edcdf2e",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "traditionell in der Weihnachtszeit gebackener länglicher, brotförmiger Weihnachtskuchen aus Hefeteig, Rosinen, Mandeln sowie Zitronat und verschiedenen Gewürzen"
                                        ],
                                        "tags": [
                                            "Backkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ab8399-0c07-41cc-ba2e-6d956d0f607d",
                                                "sense_id": "0191a25c-1632-3828-b734-da634edcdf2e",
                                                "text": "Unser Stollen war mit Rosinen und kandierten Früchten im Teig gebacken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9428664e-2d74-3a97-93b9-40a7ec6b7a5f",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "Zapfen im Hufeisen"
                                        ],
                                        "tags": [
                                            "Schmiedehandwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb66ef1-48d0-458b-8239-846cd00b956f",
                                                "sense_id": "9428664e-2d74-3a97-93b9-40a7ec6b7a5f",
                                                "text": "Die Stollen waren so stark abgenutzt, dass das Pferd kaum Halt hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2760ef10-ebcf-379d-8e61-a848c6620ed6",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "Zapfen, der ein Ausrutschen verhindern soll"
                                        ],
                                        "tags": [
                                            "Sportschuh"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1dc074e-873d-4fa4-8f35-3c94169d6389",
                                                "sense_id": "2760ef10-ebcf-379d-8e61-a848c6620ed6",
                                                "text": "Um den Rasen zu schonen, durften die Spieler keine Spikes tragen, sondern nur Stollen aus Plastik."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "55403425-0db6-3135-81c9-b2d27049b80a",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "Strophe des Aufgesanges"
                                        ],
                                        "tags": [
                                            "Gesang",
                                            "Verslehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d934fe1b-302e-421e-8e62-f07f4d408415",
                                                "sense_id": "55403425-0db6-3135-81c9-b2d27049b80a",
                                                "text": "Der Meistersinger musste auf Grund des Beifalls den Stollen wiederholen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "8e171f30-ea4d-3460-befc-c6b97bdb32a2",
                                        "entry_id": "12ae1632-a01f-3de0-83f6-0936d469990e",
                                        "glosses": [
                                            "Pfosten an einem Möbelstück"
                                        ],
                                        "tags": [
                                            "Tischlerei"
                                        ],
                                        "examples": [
                                            {
