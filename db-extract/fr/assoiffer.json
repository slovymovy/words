                "senses": [
                    {
                        "sense_id": "5036eee2-98f8-3220-8250-ca8005e9f299",
                        "entry_id": "8fb32fd0-6037-3018-b854-05b8eec4af8b",
                        "glosses": [
                            "Priver d’eau à boire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c71075-74b1-496d-8041-ae0945a9ece0",
                                "sense_id": "5036eee2-98f8-3220-8250-ca8005e9f299",
                                "text": "Le manque d'eau douce limitera le développement du port et en fera une proie facile pour les éventuels ennemis qui pourraient l'assoiffer en cas de siège."
                            }
                        ]
                    },
                    {
                        "sense_id": "03aceb12-cfa4-32f3-a24a-dd5b20d36f57",
                        "entry_id": "8fb32fd0-6037-3018-b854-05b8eec4af8b",
                        "glosses": [
                            "Être assoiffé."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7b5fe2f0-adf7-4657-ba70-650b57bed378",
                                "sense_id": "03aceb12-cfa4-32f3-a24a-dd5b20d36f57",
                                "text": "Par-delà toute macération, toute tristesse, j’imaginais, je pressentais une autre joie pure, mystique, séraphique et dont mon âme déjà s’assoiffait."
                            }
                        ]
                    }
                ],
