                                                "sense_id": "f0c1dafa-fa8a-364e-8151-af932b7759f2",
                                                "text": "Der Parkettleger verlegt am Boden Leisten als Abschluss zur Wand."
                                            },
                                            {
                                                "example_id": "4052413a-3e7f-4f8d-911d-66282adb79c8",
                                                "sense_id": "f0c1dafa-fa8a-364e-8151-af932b7759f2",
                                                "text": "„Es war eine Renaissance-Truhe mit einer gedrechselten Leiste am unteren Rand und Weinranken in den Ecken; kleine Säulen teilten die Vorderseite in fünf Felder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52272d96-d0c0-3cf6-895d-0ef5409b63fb",
                                        "entry_id": "745918ed-946b-311e-b01f-5ccb18b443b8",
                                        "glosses": [
                                            "ein Heroldsbild"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ec8d6f-18af-47dd-9e18-2c8949bf0e1c",
                                                "sense_id": "52272d96-d0c0-3cf6-895d-0ef5409b63fb",
                                                "text": "Eine Leiste teilt das Wappenschild in zwei Flächen auf, die gewöhnlich die gleiche heraldische Farbe besitzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2240e3d-0d3f-3be4-9da5-320f057b3f78",
                                        "entry_id": "745918ed-946b-311e-b01f-5ccb18b443b8",
                                        "glosses": [
                                            "Region des menschlichen Körpers, die beidseits den Übergang der Bauchwand zum Oberschenkel markiert"
                                        ],
                                        "tags": [],
                                        "examples": [
