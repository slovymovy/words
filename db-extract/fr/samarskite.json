                        "glosses": [
                            "Minéral radioactif contenant une terre rare, le samarium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3b473a-0afe-4b76-9d85-503ade29d053",
                                "sense_id": "3cea15bd-b370-3253-af52-2aae65c4c20d",
                                "text": "En 1879, Lecoq de Boisbaudran isole une nouvelle terre, le samarium [à partir] du didymium extrait de la samarskite."
                            },
                            {
                                "example_id": "649d8c0a-56f1-4cd6-aff5-6fdd299b2010",
                                "sense_id": "3cea15bd-b370-3253-af52-2aae65c4c20d",
                                "text": "Octave n’indiquait en réalité rien que la nature particulière du substratum traversé : jaune, brun, argenté, ne serait-ce pas une sorte de samarskite ? Chic de mince ! pensent-ils certainement : le cas échéant, on se partage la prime !… — (Robert Darvel, L’Homme qui traversa la Terre, Les Moutons électriques, 2016, page 99.)"
                            }
                        ]
                    }
