                    "sense_id": "d2882ba5-873d-3d82-841f-47e67bd1f448",
                    "sense_definition": "Sensation pénible et désagréable ressentie dans une partie du corps, causée par une blessure, une maladie ou un dysfonctionnement physique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a prescrit un médicament pour calmer la <w>douleur</w> au dos.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed me a medicine to ease the <w>pain</w> in my back.",
                                "ru": "Врач выписал лекарство, чтобы унять <w>боль</w> в спине.",
                                "nl": "De arts heeft me een medicijn voorgeschreven om de <w>pijn</w> in mijn rug te verzachten.",
                                "de": "Der Arzt hat mir ein Medikament verschrieben, um die <w>Schmerzen</w> im Rücken zu lindern.",
                                "pl": "Lekarz przepisał mi lek, żeby uśmierzyć <w>ból</w> pleców.",
                                "it": "Il medico mi ha prescritto un farmaco per calmare il <w>dolore</w> alla schiena.",
                                "cs": "Lékař mi předepsal lék, který má zmírnit <w>bolest</w> zad.",
                                "tr": "Doktor, sırtımdaki <w>ağrıyı</w> dindirmek için bana bir ilaç yazdı.",
                                "es": "El médico me recetó un medicamento para calmar el <w>dolor</w> de espalda.",
                                "zh": "医生给我开了一种药，用来缓解背部的<w>疼痛</w>。"
                            }
                        },
                        {
                            "text": "Il a ressenti une vive <w>douleur</w> après être tombé dans les escaliers hier.",
                            "target_lang_translations": {
                                "en": "He felt a sharp <w>pain</w> after falling down the stairs yesterday.",
                                "ru": "Вчера, упав с лестницы, он почувствовал резкую <w>боль</w>.",
                                "nl": "Hij voelde gisteren een hevige <w>pijn</w> nadat hij van de trap was gevallen.",
                                "de": "Gestern hat er nach dem Sturz auf der Treppe einen heftigen <w>Schmerz</w> empfunden.",
                                "pl": "Wczoraj po upadku ze schodów poczuł silny <w>ból</w>.",
                                "it": "Ieri è caduto dalle scale e ha provato un forte <w>dolore</w>.",
                                "cs": "Včera spadl ze schodů a pocítil silnou <w>bolest</w>.",
                                "tr": "Dün merdivenlerden düştükten sonra şiddetli bir <w>ağrı</w> hissetti.",
                                "es": "Ayer, después de caerse por las escaleras, sintió un fuerte <w>dolor</w>.",
                                "zh": "他昨天从楼梯上摔下来后，感到一阵剧烈的<w>疼痛</w>。"
                            }
                        }
                    ],
