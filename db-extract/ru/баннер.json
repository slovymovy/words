                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41ef459a-300a-3fc0-8fb2-4e6eb77cf617",
                                        "entry_id": "3a4bf093-6f01-3bf9-ab22-d9688ff561ff",
                                        "glosses": [
                                            "Any large sign, especially when made of soft material or fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4142a473-1585-4edd-8926-878796be52a7",
                                                "sense_id": "41ef459a-300a-3fc0-8fb2-4e6eb77cf617",
                                                "text": "The mayor hung a banner across Main Street to commemorate the town's 100th anniversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64b12f4-8b3b-3958-a218-75e7a190abc5",
                                        "entry_id": "3a4bf093-6f01-3bf9-ab22-d9688ff561ff",
                                        "glosses": [
                                            "A large piece of cloth with a slogan, motto, or emblem carried in a demonstration or other procession or suspended in some conspicuous place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff5810ac-b711-36d4-8ff2-a9d16f6fd862",
                                        "entry_id": "3a4bf093-6f01-3bf9-ab22-d9688ff561ff",
                                        "glosses": [
                                            "A cause or purpose; a campaign or movement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe8dd8d-911d-4fcc-afb7-308426f51c25",
                                                "sense_id": "ff5810ac-b711-36d4-8ff2-a9d16f6fd862",
                                                "text": "They usually make their case under the banner of environmentalism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf67488-0275-3c4f-b154-853ba640db4c",
