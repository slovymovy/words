                                        "entry_id": "e1b824dc-eb1e-37d4-887b-1ae3a9e7e7f6",
                                        "glosses": [
                                            "A place full of wonder or marvels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
