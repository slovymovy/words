                ],
                "senses": [
                    {
                        "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                        "entry_id": "d59116fa-298e-3039-a2a2-c3446a6ca16d",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae90085-e411-4f64-ade3-368f46c9d0b0",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Frau Ebart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5223e7e0-1032-423f-a539-24c26ddf7cec",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Herr Ebart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "922fa5fd-8808-4b3f-84da-bda7f8270d30",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Die Ebarts kommen heute von Borkum."
                            },
                            {
                                "example_id": "a74f2648-76c2-4eff-bc49-4a8ac0589801",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Der Ebart trägt nie die Schals, die die Ebart ihm strickt."
                            },
                            {
                                "example_id": "8cd9fd13-8d92-43bb-a2a1-af761158abb9",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ebart kommt, geht der Herr Ebart.“"
                            },
                            {
                                "example_id": "f2d9f1b4-7cd7-405c-893e-3dd632ce8f55",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Ebart kommt und geht."
                            },
                            {
                                "example_id": "dbedb676-f576-476a-b833-7af95afe2ad2",
                                "sense_id": "992f8b75-5231-334f-a17b-cefed6f398dd",
                                "text": "Ebarts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
