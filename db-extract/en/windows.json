                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c52b1dc5-071e-473b-9921-669af12ca33f",
                                                "sense_id": "1acd49b5-b3fe-3ab8-acf3-f093ac7dbc8f",
                                                "text": "Auf dem PC läuft Windows."
                                            },
                                            {
                                                "example_id": "537e19b8-a85a-400a-8192-577e4af5947a",
                                                "sense_id": "1acd49b5-b3fe-3ab8-acf3-f093ac7dbc8f",
                                                "text": "Welche Version von Windows hat Stefan eigentlich?"
                                            },
                                            {
                                                "example_id": "63152761-1f2f-48a1-8060-8c1400416c22",
                                                "sense_id": "1acd49b5-b3fe-3ab8-acf3-f093ac7dbc8f",
                                                "text": "„Gerade aus der Linux-Welt gab es über die Jahre viel Spott dafür, dass man sich unter Windows mit solchen Dingen herumschlagen muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
