                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59e2791d-0c5d-3302-97b2-ac266b9e9076",
                                        "entry_id": "a152ff44-ef14-3b80-a9c1-7c3cd30d2485",
                                        "glosses": [
                                            "etwas, was durch Vermischen von festen, flüssigen oder gasförmigen Stoffen entsteht; Mischung aus zwei oder mehreren verschiedenen Stoffen, deren Bestandteile zumeist sehr fein verteilt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdd5d6e-af0a-4848-8df6-ef8dcb12fc00",
                                                "sense_id": "59e2791d-0c5d-3302-97b2-ac266b9e9076",
                                                "text": "Die Flüssigkeit enthält ein unbekanntes Gemisch von Substanzen."
                                            },
                                            {
                                                "example_id": "45321c87-3144-40c8-b4f8-a8c28c74a812",
                                                "sense_id": "59e2791d-0c5d-3302-97b2-ac266b9e9076",
                                                "text": "„Der Brennstoff in modernen Feuerzeugen ist meist ein Gemisch aus den Gasen Propan und Butan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60b28c1e-da7a-47f8-9ddd-82d69b0911f0",
                        "source_entry_id": "79503af3-3f57-3599-a372-7a884d3fe2f4",
