                "senses": [
                    {
                        "sense_id": "5272721a-17e6-3bd6-b40f-860b6480f18c",
                        "entry_id": "1c865c63-37ef-37b5-a527-984f8183234d",
                        "glosses": [
                            "związany ze stacją, dotyczący stacji, właściwy stacji, znajdujący się w obrębie stacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9a1b36-5ff6-4dc2-be9f-72421d5ff451",
                                "sense_id": "5272721a-17e6-3bd6-b40f-860b6480f18c",
                                "text": "Stacja posiadała bocznicę kolejową oraz budynek stacyjny z kasą biletową"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7ebcc879-5579-3e35-a3c3-5caf982912a1",
                        "entry_id": "1c865c63-37ef-37b5-a527-984f8183234d",
                        "glosses": [
                            "stanowiący stację"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5a7e35-4ec4-4ac5-bf08-28d1ad4b7fa8",
                                "sense_id": "7ebcc879-5579-3e35-a3c3-5caf982912a1",
                                "text": "Do rzymskich kościołów stacyjnych należy m.in. Bazylika św. Jana na Lateranie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "604960ac-2ddb-3247-b4e1-52c50383f9c8",
                        "entry_id": "1c865c63-37ef-37b5-a527-984f8183234d",
                        "glosses": [
                            "odbywający się stacjami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "437d2aee-4cc0-45e3-81c3-ac8502b551fb",
                                "sense_id": "604960ac-2ddb-3247-b4e1-52c50383f9c8",
                                "text": "W Środę Popielcową zapraszamy wszystkich diecezjan na nabożeństwo stacyjne, któremu przewodniczyć będą biskupi opolscy"
                            },
                            {
                                "example_id": "75257dc4-1ff8-47bf-904b-eacbbc1440ba",
                                "sense_id": "604960ac-2ddb-3247-b4e1-52c50383f9c8",
                                "text": "Na początku XIV w. nastąpił (…) zanik liturgii stacyjnej, której przewodniczył biskup Rzymu"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
