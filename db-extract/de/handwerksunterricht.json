                        "glosses": [
                            "Unterricht(-sfach), in dem man die Herstellung manuell gefertigter Gegenstände lernt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b3f878-b179-435d-9c3a-e2fcdbf7067c",
                                "sense_id": "74f3c812-b43e-3e21-a25f-db1fe73e0891",
                                "text": "„Er trägt die ausgeblichene karierte Schürze, die ich in der Grundschule im Handwerksunterricht für ihn genäht habe.“"
                            },
                            {
                                "example_id": "c37c333e-1eda-4ee7-98aa-c8c6efce2435",
                                "sense_id": "74f3c812-b43e-3e21-a25f-db1fe73e0891",
                                "text": "„Der Täter bedient sich bestimmter Knotentechniken, die man nicht gerade im Handwerksunterricht aufschnappt.“"
                            },
                            {
                                "example_id": "673ddfb8-e0ae-4eb0-ab96-87d825f083e7",
                                "sense_id": "74f3c812-b43e-3e21-a25f-db1fe73e0891",
                                "text": "„Als Teenager mit großer Begeisterung für den Handwerksunterricht in der Schule verbrachte ich viele Stunden in der Garage meiner Eltern, um Opas Schreibtisch herzurichten.“"
                            }
