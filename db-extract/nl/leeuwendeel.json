                                        "entry_id": "5803275b-c2cf-3e60-85e8-dd6120877912",
                                        "glosses": [
                                            "Grandes beneficios que se consiguen abusando del poder que se tiene."
                                        ],
                                        "tags": [
                                            "Argentina"
                                        ],
