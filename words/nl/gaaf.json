                        "ru": "Очень приятный, хороший или впечатляющий."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cool",
                                "target_lang_sense_clarification": "informal, fashionable or impressive"
                            },
                            {
                                "target_lang_word": "awesome",
                                "target_lang_sense_clarification": "informal, extremely good"
                            },
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "general positive term"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "разговорное, впечатляющий"
