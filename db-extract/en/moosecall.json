                "forms": [
                    {
                        "form_id": "82e6d2c9-e69d-4f74-9e43-be78bac21250",
                        "entry_id": "9ac1ec29-51ba-33b3-bb0b-798037f1906c",
                        "tags": [
                            "plural"
                        ],
                        "form": "moosecalls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57ea272a-a07f-38fc-b54a-c5d5aa449c1c",
                        "entry_id": "9ac1ec29-51ba-33b3-bb0b-798037f1906c",
                        "glosses": [
                            "A horn, for example of birchbark, which imitates the bellow of a moose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c920a943-519b-4ff5-91e8-1050b34add71",
                                "sense_id": "57ea272a-a07f-38fc-b54a-c5d5aa449c1c",
                                "text": "A moosecall is a horn of birch bark used by hunters to imitate the roar and bellow of the bull moose. Hunters themselves disagree as to whether the moose is ever fooled by a moosecall."
                            },
                            {
                                "example_id": "834166ad-fa9b-4416-93c5-d6da01c95c32",
                                "sense_id": "57ea272a-a07f-38fc-b54a-c5d5aa449c1c",
                                "text": "Mister MacNab said he had just the thing in mind for his own wife. “'Tis a moosecall,” he announced happily, \"which gives an excellent rendition of a female cow in the th-r-roes of r-r-romantic ecstacy.\""
                            },
                            {
                                "example_id": "e1aba3ba-0605-4854-90a9-e166b3df5ed4",
                                "sense_id": "57ea272a-a07f-38fc-b54a-c5d5aa449c1c",
                                "text": "I'm in danger of losing my mind, listening to Larry blow on that moosecall. I'm sorry I ever let him have it. He is my nephew, by the way."
                            }
                        ]
                    },
                    {
                        "sense_id": "a88aae75-d50a-38e3-a4c4-19542bc9e7f0",
                        "entry_id": "9ac1ec29-51ba-33b3-bb0b-798037f1906c",
                        "glosses": [
                            "The noise made by this device."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824e4e33-e28c-4f95-9b35-ea856d2099b7",
                                "sense_id": "a88aae75-d50a-38e3-a4c4-19542bc9e7f0",
                                "text": "First of all, I could hear the handful of boos and moosecalls underneath the cheers as I took my place among the other Giants."
                            },
                            {
                                "example_id": "1ca86988-424b-485e-bc9f-c75a6a4abd15",
                                "sense_id": "a88aae75-d50a-38e3-a4c4-19542bc9e7f0",
                                "text": "Once I was just walking along innocently with Richie when all of a sudden, from down the hallway and around the corner, I hear this moosecall. I didn't even think. I just moosecalled back."
                            }
                        ]
                    }
                ],
