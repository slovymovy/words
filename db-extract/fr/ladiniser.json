                        "glosses": [
                            "Faire parler une langue latine à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3119b028-c1e9-45e7-85fe-d991b7b38d4f",
                                "sense_id": "ef29dab1-d5b0-3230-aa31-3b74cec9e0e9",
                                "text": "L’escale devient incontournable non seulement pour se procurer les fameux pagnes (panos) institués en monnaie d’échange, mais aussi pour « ladiniser » (ladinizar) les esclaves avant de les exporter vers d’autres destinations."
                            },
                            {
                                "example_id": "829b3611-08a2-4477-856a-4b997be587dd",
                                "sense_id": "ef29dab1-d5b0-3230-aa31-3b74cec9e0e9",
                                "text": "Malgré leur passé de résistance à la colonisation [rébellion de Lempira en 1537], ils tendent à se ladiniser."
                            }
                        ]
                    }
