{
    "word_family": [
        "ingave",
        "ingever",
        "ingeving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fce0621d-af98-37fe-b96b-e4ece31df359",
                    "sense_definition": "Voedsel of medicijnen in de mond van iemand (bijvoorbeeld een baby of zieke) brengen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige moet de medicatie voorzichtig <w>ingeven</w> bij de patiënt.",
                            "target_lang_translations": {
                                "fr": "L'infirmière doit <w>administrer</w> prudemment les médicaments au patient."
                            }
                        },
                        {
                            "text": "Je moet de baby voorzichtig een <w>lepel</w> <w>ingeven</w> tijdens het eten.",
                            "target_lang_translations": {
                                "fr": "Tu dois prudemment <w>donner</w> une cuillère à soupe au bébé pendant le repas."
                            }
                        }
                    ],
                    "synonyms": [
                        "voeren",
                        "voeden"
                    ],
                    "common_phrases": [
                        "een lepel ingeven",
                        "medicijnen ingeven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Donner de la nourriture ou des médicaments dans la bouche de quelqu'un (par exemple un bébé ou un malade)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire prendre",
                                "target_lang_sense_clarification": "pour des médicaments"
                            },
                            {
                                "target_lang_word": "donner à manger",
                                "target_lang_sense_clarification": "pour la nourriture"
                            },
                            {
                                "target_lang_word": "administrer",
                                "target_lang_sense_clarification": "un médicament à un patient"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e38426cf-b777-3e44-86f5-d41ba779afbd",
                    "sense_definition": "Iemand een idee, gedachte of gevoel bezorgen; inspireren of dicteren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedachte_inspiratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>gevoel</w> <w>geeft</w> me <w>in</w> dat we de verkeerde kant op gaan.",
                            "target_lang_translations": {
                                "fr": "Mon intuition me <w>souffle</w> que nous allons dans la mauvaise direction."
                            }
                        },
                        {
                            "text": "Dat besluit werd volledig <w>ingegeven</w> door angst voor het onbekende.",
                            "target_lang_translations": {
                                "fr": "Cette décision a été entièrement <w>dictée</w> par la peur de l'inconnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspireren",
                        "suggereren",
                        "inboezemen"
                    ],
                    "common_phrases": [
                        "gevoel ingeven",
                        "gedachte ingeven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Inspirer, dicter ou susciter une idée, une pensée ou un sentiment chez quelqu'un."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "inspirer",
                                "target_lang_sense_clarification": "susciter une pensée ou une action"
                            },
                            {
                                "target_lang_word": "dicter",
                                "target_lang_sense_clarification": "imposer un comportement ou une décision"
                            },
                            {
                                "target_lang_word": "souffler",
                                "target_lang_sense_clarification": "suggérer à l'esprit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfa81925-de30-3737-9a35-f50394589875",
                    "sense_definition": "Iets in de gedachte of het bewustzijn van iemand laten opkomen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedachte_inspiratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het plan is <w>ingegeven</w> door de recente veranderingen in de samenleving.",
                            "target_lang_translations": {
                                "fr": "Le plan a été <w>inspiré</w> par les récents changements dans la société."
                            }
                        },
                        {
                            "text": "De docent wilde de studenten een nieuw <w>idee</w> <w>ingeven</w> voor hun project.",
                            "target_lang_translations": {
                                "fr": "L'enseignant voulait <w>suggérer</w> une nouvelle idée aux étudiants pour leur projet."
                            }
                        }
                    ],
                    "synonyms": [
                        "suggereren"
                    ],
                    "common_phrases": [
                        "idee ingeven"
                    ],
                    "target_lang_definitions": {
                        "fr": "Faire venir une idée ou une pensée à l'esprit de quelqu'un."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "suggérer",
                                "target_lang_sense_clarification": "faire penser à"
                            },
                            {
                                "target_lang_word": "inspirer",
                                "target_lang_sense_clarification": "faire naître une idée"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}