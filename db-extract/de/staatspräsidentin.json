                                        "entry_id": "83aa5849-9e98-3bc4-88d0-c815cc03e852",
                                        "glosses": [
                                            "To act as president; to do presidential duties."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc2e6162-e39b-40e6-8141-337fe9398ce0",
                        "source_entry_id": "b30a5c79-7ba5-37f8-8f7c-d719cb4201b4",
