                        "glosses": [
                            "S’armer de sa propre initiative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddcc416b-93cd-4ac9-b6a9-3f465daa9b10",
                                "sense_id": "db17600c-aabe-32d7-a6b0-09f5963c5488",
                                "text": "On avait l'impression que le monde politique y trouvait son compte. Les simples citoyens ne voyaient pas d'autres solutions que de s'auto-armer pour faire face à l'insécurité sans cesse croissante."
                            },
                            {
                                "example_id": "fb709c09-22c8-4902-a0c8-ea9771eca9c6",
                                "sense_id": "db17600c-aabe-32d7-a6b0-09f5963c5488",
                                "text": "Sans les masses, elle n'aurait pas de force, la Révolution avait besoin de s'auto-armer."
                            }
                        ]
                    }
