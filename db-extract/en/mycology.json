        "de-extract.jsonl": [
            {
                "entry_id": "da15f624-a1a9-3252-8f6f-503e574ed379",
                "word": "mycology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9213c047-d096-3ffd-97aa-c8962cd550ed",
                        "entry_id": "da15f624-a1a9-3252-8f6f-503e574ed379",
                        "glosses": [
                            "Pilzkunde, Mykologie, die Wissenschaft von Pilzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60122f1b-6d16-4176-8f7c-122c3d025d36",
                                "sense_id": "9213c047-d096-3ffd-97aa-c8962cd550ed",
                                "text": "„Mycology (…) is the branch of biology concerned with the study of fungi, including their genetic and biochemical properties, their taxonomy and their use to humans as a source for tinder, medicinals (e.g., penicillin), food (e.g., beer, wine, cheese, edible mushrooms) and entheogens, as well as their dangers, such as poisoning or infection.“",
                                "translation": "Die Mykologie ist der Teil der Biologie, der sich mit der Erforschung von Pilzen (fungi) beschäftigt, einschließlich ihrer genetischen und biochemischen Eigenschaften, ihrer Taxonomie [Klassifizierungslehre] und ihrem Nutzen für die Menschen als Quelle für Zunder, Medizinen (z. B. Penizillin), Nahrung (z. B. Bier, Wein, Käse, essbare Pilze) und Entheogenen [psychoaktive Stoffe, die halluzinogen wirken], ebenso wie ihre Gefahren wie Vergiftung oder Ansteckung [Infektion]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
