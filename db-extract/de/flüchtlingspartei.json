                "senses": [
                    {
                        "sense_id": "0f377268-6c75-3501-b0d6-4067a5c6a660",
                        "entry_id": "2c3ddcb7-fd7c-337b-a463-23ad5a7abd69",
                        "glosses": [
                            "Partei, die die besonderen Interessen der Flüchtlinge nach dem Ende des Zweiten Weltkrieges vertrat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd3c273-55ac-4259-9ef7-313b0c76b604",
                                "sense_id": "0f377268-6c75-3501-b0d6-4067a5c6a660",
                                "text": "„Seine im Januar gegründete Flüchtlingspartei bekam bei den Landtagswahlen in Schleswig-Holstein fast ein Viertel aller Stimmen.“"
                            },
                            {
                                "example_id": "53dd7b02-6b47-424f-9fa4-d499bcf28389",
                                "sense_id": "0f377268-6c75-3501-b0d6-4067a5c6a660",
                                "text": "„Mit dem Erstarken der Flüchtlingsvereine und -verbände und der Gründung einer Flüchtlingspartei nach der Konstituierung der Bundesrepublik hatten die Vertrauensleute ihre Funktion verloren. Die Vertrauensleutewahlen fanden 1949 zum letzten Mal statt.“"
                            },
                            {
                                "example_id": "ba135989-ab3c-4af1-b6dd-b2551df85e37",
                                "sense_id": "0f377268-6c75-3501-b0d6-4067a5c6a660",
                                "text": "„Ein starkes Indiz für ihren Erfolg bildet der seit der zweiten Hälfte der 1950er Jahre zu beobachtende Niedergang der eigenen Flüchtlingspartei „Block der Heimatvertriebenen und Entrechteten“ (BHE).“"
                            },
                            {
                                "example_id": "6e9d63ba-fdbc-42d3-9ec0-0c5114dfe614",
                                "sense_id": "0f377268-6c75-3501-b0d6-4067a5c6a660",
                                "text": "„Haupttreiber dieses Engagements der Flüchtlingspartei in Bonn war BHE-Chef Waldemar Kraft, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
