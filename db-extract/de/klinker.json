                "senses": [
                    {
                        "sense_id": "eb2b45d3-db63-34b0-8247-0b455935f2a6",
                        "entry_id": "47827b7e-d70a-3372-93b3-caff74685470",
                        "glosses": [
                            "bis an die Schmelzgrenze hartgebrannter, „klingender“ Ziegelstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd073322-2480-463d-9185-2323371ea9e5",
                                "sense_id": "eb2b45d3-db63-34b0-8247-0b455935f2a6",
                                "text": "Klinker mit ihrem schönen Farbenspiel sind weit über die Grenzen Oldenburgs bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2200f9b4-df8b-440c-ae01-223eb9bcc326",
                        "source_entry_id": "47827b7e-d70a-3372-93b3-caff74685470",
                        "source_sense_id": "eb2b45d3-db63-34b0-8247-0b455935f2a6",
                        "source_sense_description": "bis an die Schmelzgrenze hartgebrannter, „klingender“ Ziegelstein",
                        "target_lang_word": "clinker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99f815f5-9835-311d-937a-358c1b54a20b",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "A very hard brick used for paving customarily made in the Netherlands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60b27d7d-89eb-4433-bce9-c7680d2ae8eb",
                                                "sense_id": "99f815f5-9835-311d-937a-358c1b54a20b",
                                                "text": "She left the road at the little shed where he whom she still regarded as her father used to keep his tricycle, and walked up the clinker path towards the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f4f37c2-f291-3278-a58f-4787704cc95b",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "A mass of bricks fused together by intense heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bda51ba-562b-3a38-988e-bca1084c1639",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "Slag or ash produced by intense heat in a furnace, kiln or boiler that forms a hard residue upon cooling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feda40de-2a7f-4a80-82de-7ede080a19f1",
                                                "sense_id": "3bda51ba-562b-3a38-988e-bca1084c1639",
                                                "text": "The coal was terrible stuff—Indian, Abdul told me. The \"dart\" was used often and I saw some monster clinkers."
                                            },
                                            {
                                                "example_id": "ca422c1a-4bde-49ec-8e58-ded35208c5c3",
                                                "sense_id": "3bda51ba-562b-3a38-988e-bca1084c1639",
                                                "text": "Cold and grim sat that malevolent brute the furnace, greedy, bottomless—its grate bars clenched over clinkers which no shaker could dislodge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21be01a5-3281-3fc0-bb0a-09e40862af36",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "An intermediate product in the manufacture of Portland cement, obtained by sintering limestone and alumino-silicate materials such as clay into nodules in a cement kiln."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78f1fb62-4583-30e2-bf79-0e164802fd01",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "Hardened volcanic lava."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f444b456-01d9-456a-af9b-3cfc8ed62683",
                                                "sense_id": "78f1fb62-4583-30e2-bf79-0e164802fd01",
                                                "text": "This wall of rock, which had no doubt once formed the lip of the crater, was about a mile and a half thick, and still covered with clinker."
                                            },
                                            {
                                                "example_id": "781272bb-c947-4dd0-a2fc-6b550c974a37",
                                                "sense_id": "78f1fb62-4583-30e2-bf79-0e164802fd01",
                                                "text": "Nobody could pretend that a huge slope of clinker is aesthetically pleasing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea739343-80b5-3257-9657-6517fc89da92",
                                        "entry_id": "fde71e12-7248-36b9-a280-8ebf96ab181a",
                                        "glosses": [
                                            "A scum of oxide of iron formed in forging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a4b665b-0355-3ba8-acc9-b6ecb17f2541",
                                        "entry_id": "c933cdd9-4a9a-30df-a3ec-4a08f408f539",
                                        "glosses": [
                                            "To convert or be converted into clinker."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb983ae-f1ed-4506-a926-5e2fa55e4ed8",
                                                "sense_id": "1a4b665b-0355-3ba8-acc9-b6ecb17f2541",
                                                "text": "This burning has baked and clinkered the adjacent strata, producing a very resistant formation, which rises with conspicuous abruptness from the flat terrace underlain by the soft Lebo shale member."
                                            },
                                            {
                                                "example_id": "9a56f644-b052-41ed-9bb9-908ca7d06f69",
                                                "sense_id": "1a4b665b-0355-3ba8-acc9-b6ecb17f2541",
                                                "text": "The use of coal with a low ash fusion temperature (1204°C, or 2200°F) caused frequent clinkering on the grate during initial tests. The clinkering stopped when the coal was replaced with one having a higher fusion temperature […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79b4acb1-a75c-3b91-a651-3ef824437ee6",
                                        "entry_id": "d5b83774-8fa3-3962-bc20-c9bd6c7169e9",
                                        "glosses": [
                                            "Someone or something that clinks."
                                        ],
