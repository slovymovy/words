                "senses": [
                    {
                        "sense_id": "2b5af5a8-628c-31c4-baa7-4449eada27aa",
                        "entry_id": "506391e0-a7a3-3436-af30-de61fd71111e",
                        "glosses": [
                            "Perdre son caractère de consonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57905f1a-9163-4b82-a7f9-e2a605d61930",
                                "sense_id": "2b5af5a8-628c-31c4-baa7-4449eada27aa",
                                "text": "La consonne se déconsonantise (donc devient Ø) et devient satellite du noyau précédent."
                            },
                            {
                                "example_id": "30ecfa19-67a9-4116-88d4-5f3aab6e5ad1",
                                "sense_id": "2b5af5a8-628c-31c4-baa7-4449eada27aa",
                                "text": "N tend alors, comme dans le passage du latin au français moderne, à se ”déconsonantiser” et à disparaître, laissant comme seule trace la nasalisation de la voyelle (VN -> V)."
                            }
                        ]
                    }
