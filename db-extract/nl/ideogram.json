                            {
                                "example_id": "4c45be75-4c55-4aeb-922d-f170f4497be5",
                                "sense_id": "3200a143-819e-3f9b-a1e9-f8070b14dfb2",
                                "text": "Veel computericonen zijn ideogrammen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d193dd6d-da0f-340e-b0ad-4f7e659b92b8",
                        "entry_id": "27254d74-5e50-3ef3-a503-1fd7ffd64e10",
