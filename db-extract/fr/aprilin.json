                "senses": [
                    {
                        "sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                        "entry_id": "9b4feed9-fe3b-3275-b51d-9041970d5061",
                        "glosses": [
                            "D’avril."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "bd7bfefc-94c5-46ed-8a76-afad284218aa",
                                "sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                                "text": "Les chamaillis sont sans offenses\nQui rient au taillis aprilin."
                            },
                            {
                                "example_id": "b054e94b-8b91-492e-98a0-ad23e51112bc",
                                "sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                                "text": "Et ma lèvre eut quêté\nDe la tienne le miel aprilin de ton rêve…"
                            },
                            {
                                "example_id": "7e4ae38d-92c8-46ce-9aa8-2219601982da",
                                "sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                                "text": "Par un soir plus vert qu’un fleuve aprilin, le geôlier entra, dans un grincement de fer rouillé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf17cca6-b93f-46fd-9415-b2531c6227fa",
                        "source_entry_id": "9b4feed9-fe3b-3275-b51d-9041970d5061",
                        "source_sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                        "target_lang_word": "April",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "April",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b19e3c61-6be4-3614-8152-8cc44f3806e8",
                                        "entry_id": "38b15af4-a304-38d0-ba1e-02cb7bec8e27",
                                        "glosses": [
                                            "der vierte Monat des Gregorianischen Kalenders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292d3350-62ed-4bd9-a82b-4b3f86e2307e",
                                                "sense_id": "b19e3c61-6be4-3614-8152-8cc44f3806e8",
                                                "text": "Der April folgt auf den März."
                                            },
                                            {
                                                "example_id": "0f3a4491-2200-44de-a88e-14fd1cf93ca5",
                                                "sense_id": "b19e3c61-6be4-3614-8152-8cc44f3806e8",
                                                "text": "„Seit Mitte April wurden allen vier Milliarden Dollar aus Anleihenfonds der Schwellenländer abgezogen.“"
                                            },
                                            {
                                                "example_id": "2f32ee1d-51f1-4d01-aaa1-074cd4981ecb",
                                                "sense_id": "b19e3c61-6be4-3614-8152-8cc44f3806e8",
                                                "text": "„Die Marillenbäume verwandeln das Tal jedes Jahr im April in ein rosa-weißes Blütenmeer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "April",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                        "entry_id": "7076b46b-76ec-3aef-bca4-10616c2f2b52",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445935fb-d948-40b6-8d28-4baa5deb2d1d",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Frau April ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "fe1252a2-1ec8-4fdb-b0f9-d966dc5e46ca",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Herr April wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c534c7e0-87f6-4a50-aa2e-751e2000578d",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Die Aprils kommen heute von Mallorca."
                                            },
                                            {
                                                "example_id": "b395c63c-9e26-4f93-ab48-1483868f8370",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Der April trägt nie die Schals, die die April ihm strickt."
                                            },
                                            {
                                                "example_id": "836c8b10-9334-467d-be57-69455aedcd1e",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau April kommt, geht der Herr April.“"
                                            },
                                            {
                                                "example_id": "223a7664-4209-4166-abbc-1e4154c09992",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "April kommt und geht."
                                            },
                                            {
                                                "example_id": "90aa6797-ce26-45e2-b835-875ff64dcff1",
                                                "sense_id": "5e1aa4f9-b34d-3610-9480-01add063329d",
                                                "text": "Aprils kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "142d5ed5-f068-4916-8a45-82d8b6fa907a",
                        "source_entry_id": "9b4feed9-fe3b-3275-b51d-9041970d5061",
                        "source_sense_id": "2ceb2e18-1f65-350b-bb6b-6847f9c04181",
                        "target_lang_word": "Frühling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frühling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                        "entry_id": "300ef251-7640-3af1-8980-02b191c34300",
                                        "glosses": [
                                            "eine der vier Jahreszeiten der gemäßigten Zonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daeb6d0f-75f6-48f2-9007-2c236eee6b3c",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "Im Frühling blüht die Natur auf."
                                            },
                                            {
                                                "example_id": "cf325d72-28b0-47da-8d9b-93574096d222",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "Dagegen \"belohnen\" die heimischen Singvögel die Futtergaben, wenn es Frühling wird, mit ihrem Gesang und machen sich besonders während der Brutzeit als emsige Insektenjäger nützlich."
                                            },
                                            {
                                                "example_id": "cbf13632-42e7-47b7-8299-51d5af83dbde",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "„Im Frühling zum Beispiel verweile ich gern auf einer der zahlreichen Obstplantagen der Fahnerschen Höhen und lasse mich vom Duft der Blüten betören.“"
                                            },
                                            {
                                                "example_id": "b76c259b-9eab-4407-9c12-281887898f51",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "„Sie hatten seinen Tod, als sie von ihm erfuhren, beweint und seither viele Frühlinge und Herbste ohne ihn durchlebt.“"
                                            },
                                            {
                                                "example_id": "ed69f4df-43cf-46a4-a62d-9a8b99717f55",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "Nach dem Herbst 2006 und dem Winter 2006/07 hat auch der Frühling einen neuen Temperaturrekord aufgestellt."
                                            },
                                            {
                                                "example_id": "de41d54c-591c-4b0f-9c6b-080be83ef507",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "Der Frühling auf der Nordhalbkugel der Erde wird durch die sogenannte Tag-und-Nacht-Gleiche bestimmt. Mit den heutigen Methoden der Astronomie kann dieser Zeitpunkt sehr genau berechnet werden."
                                            },
                                            {
                                                "example_id": "96c2119e-9bd4-49fd-9f82-6b1f0c116fac",
                                                "sense_id": "253f7656-fab3-35cd-93df-45a3c319b3e0",
                                                "text": "Für die Kinder in der Dresdener Friedrichstadt steht im Frühling ein neuer Spielplatz zur Verfügung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Frühling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
