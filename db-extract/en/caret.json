                    },
                    {
                        "translation_id": "0c184bed-ed21-4d75-8bca-c731926e6296",
                        "source_entry_id": "34fc0723-0443-3413-9afa-a04229334701",
                        "source_sense_description": "symbol",
                        "target_lang_word": "Zirkumflex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zirkumflex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "380f1616-a161-302c-a075-31f10122b6b0",
                                        "entry_id": "48f9741d-4da5-304e-b260-390fcca39c84",
                                        "glosses": [
                                            "diakritisches Zeichen verschiedener Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dcdb920-2725-4549-92ca-84b1e949cdda",
                                                "sense_id": "380f1616-a161-302c-a075-31f10122b6b0",
                                                "text": "„Im Walisischen wird das W sowohl als Konsonant (vor Vokalen und am Wortanfang) als auch als Vokal gebraucht und kann entsprechend den Vokalverlängerungsregeln daher auch mit einem Zirkumflex (ˆ) versehen werden.“"
                                            },
                                            {
                                                "example_id": "74e07646-2429-4107-9bbd-ee59964b9bbb",
                                                "sense_id": "380f1616-a161-302c-a075-31f10122b6b0",
                                                "text": "„[Der Hatschek] ist ein nach oben offener Winkel (umgekehrtes Dach) über dem Buchstaben, das optische Gegenstück zum Zirkumflex.“"
                                            },
                                            {
                                                "example_id": "25025bb0-c285-4309-907f-a093c01f3ac7",
                                                "sense_id": "380f1616-a161-302c-a075-31f10122b6b0",
                                                "text": "„Der Felsen erhob sich auf dem Rasen einem Gebirge gleich, das Grabmal wirkte wie ein Würfel mitten auf den Spinatbeeten, die venetianische Brücke spannte sich wie ein Zirkumflex über die Bohnen – und die Hütte weiter hinten machte einen großen schwarzen Fleck, denn sie hatten ihr Strohdach abgebrannt, um ihr ein poetischeres Aussehen zu verleihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c015c85-757f-4ccb-81d7-9438790bdbc7",
                        "source_entry_id": "34fc0723-0443-3413-9afa-a04229334701",
                        "source_sense_description": "symbol",
                        "target_lang_word": "Dach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                        "entry_id": "cc3f4e7b-a3ca-35eb-be63-5c6da7c6a60b",
                                        "glosses": [
                                            "obere Abdeckung eines Gebäudes, eines Fahrzeugs oder eines Zeltes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c10ab8a0-abec-46da-8d45-36558ec778b8",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "Unser Dach muss neu gedeckt werden."
                                            },
                                            {
                                                "example_id": "a2081c0c-d9c9-4eaf-8edb-c2c186a1497c",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "Das Dach leckt, es ist undicht."
                                            },
                                            {
                                                "example_id": "c58e55ec-3e30-4afb-87d1-72d1a38f739e",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "Der Dachdecker meint, dass wir das Dach komplett sanieren sollten."
                                            },
                                            {
                                                "example_id": "57d87e4a-7e3b-4acc-b564-fed4fe294b39",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "Unzählige Dächer wurden durch den Sturm abgedeckt."
                                            },
                                            {
                                                "example_id": "205781e3-272a-4cd9-9fbd-113350457d14",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Zerstörte Dächer und umgestürzte Bäume sind im gesamten Stadtgebiet zu sehen.“"
                                            },
                                            {
                                                "example_id": "ec245ab1-b974-47de-b096-5d47e998e15f",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„In London zerstörte der Sturm das Dach des Millenium Dome“"
                                            },
                                            {
                                                "example_id": "30ba24e0-8d36-4d1a-8618-ea1d5973fa49",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„In Edwardsville in Illinois stürzte das Dach eines Verteilzentrums des Online-Händlers Amazon teilweise ein.“"
                                            },
                                            {
                                                "example_id": "058b3b67-214d-4db3-b9bf-790719ed4a5d",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "[Al Bayt Stadion/Katar:] „Das Stadion besitzt ein schließbares Dach und soll von außen an ein traditionelles Beduinen-Zeltlager erinnern.“"
                                            },
                                            {
                                                "example_id": "8a363842-fffe-42dc-9d2b-e21681c45ff1",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Er hat vor kurzem eine Solaranlage aufs Dach gebaut, das macht ihn etwas unabhängiger von den Stromanbietern.“"
                                            },
                                            {
                                                "example_id": "173964c4-e43e-41b5-833c-d2ef8903623f",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Im vergangenen Jahr hat \"Grid Alternatives\" mehr als 1.300 Familien mit geringem Einkommen in Kalifornien Solaranlagen aufs Dach gebaut - völlig umsonst.“"
                                            },
                                            {
                                                "example_id": "968a2e73-7b17-4b05-90d6-f4f50db217cb",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Auf Deutschlands Dächern sollen künftig weit mehr Photovoltaikanlagen Strom erzeugen, als Ersatz für fossile Brennstoffe.“"
                                            },
                                            {
                                                "example_id": "038a1906-7443-4b37-886f-21ad10bf70b2",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "[…] „auf dem begrünten Dach wird Regenwasser für die Toilettenspülung gesammelt.“"
                                            },
                                            {
                                                "example_id": "cbd8e11a-825c-44e4-b1be-ba09eb1fa56c",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„In Skandinavien gehören grüne Dächer zum Erscheinungsbild.“"
                                            },
                                            {
                                                "example_id": "57fe7732-cce2-4655-9039-d3a2605d5270",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Würden in den deutschen Städten alle Dächer nachträglich bepflanzt, könnten der Natur bis zu zwei Drittel der versiegelten Flächen zurückgegeben werden,“ […]."
                                            },
                                            {
                                                "example_id": "70fa6563-16b0-4c85-a491-155023d42462",
                                                "sense_id": "875d2982-d7c0-3c99-afa5-e514baed85f6",
                                                "text": "„Sie haben auf dem Dach einen Wasserstofftank und die Brennstoffzelle sowie Batterien im Boden des Zugs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f06c883b-ffc4-3faf-9bf5-01a611084b58",
