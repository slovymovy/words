                "senses": [
                    {
                        "sense_id": "c8ce243f-9ccc-35e6-b9a2-3be313936a9d",
                        "entry_id": "6148019f-f29e-3c90-990b-7e9ab57cf2f8",
                        "glosses": [
                            "iemand of iets met vergelijkbare functie of eigenschappen aan gene zijde van een scheidslijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2b4819-9c81-4e9a-8062-9e3ff86e86d3",
                                "sense_id": "c8ce243f-9ccc-35e6-b9a2-3be313936a9d",
                                "text": "De Australische mierenegel en de Zuid-Amerikaanse miereneter zijn elkaars tegenhangers: ze hebben een vergelijkbare levenswijze, maar ze zijn nauwelijks aan elkaar verwant."
                            },
                            {
                                "example_id": "304ab976-5fb9-4c4c-9f16-1e083fd60b33",
                                "sense_id": "c8ce243f-9ccc-35e6-b9a2-3be313936a9d",
                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a59124b9-dac6-495d-99b3-bb12eeab74eb",
                        "source_entry_id": "6148019f-f29e-3c90-990b-7e9ab57cf2f8",
                        "source_sense_id": "c8ce243f-9ccc-35e6-b9a2-3be313936a9d",
                        "source_sense_description": "iemand of iets met vergelijkbare functie of eigenschappen aan gene zijde van een scheidslijn",
                        "target_lang_word": "Gegenstück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenstück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d206e2cf-e688-3724-9494-aeb99b71a3de",
                                        "entry_id": "ea0868cc-faef-3335-bf5c-e1cf80e27f5b",
                                        "glosses": [
                                            "das zweite Teil (Stück), das einem ersten Teil ähnlich ist (und es zu einem Ganzen ergänzt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31cca0fd-427c-4a81-afc6-5fe6d0afd25e",
                                                "sense_id": "d206e2cf-e688-3724-9494-aeb99b71a3de",
                                                "text": "„Riesige Amphoren auf grazilen Eisenständern begrüßen die LGS-Ankömmlinge vom Bahnhof her. Als Gegenstück finden sich am entgegengesetzten Ende des Geländes am Boden liegende Amphoren.“"
                                            },
                                            {
                                                "example_id": "dfba95d5-c8f3-4963-b5f6-77d7c7b606b1",
                                                "sense_id": "d206e2cf-e688-3724-9494-aeb99b71a3de",
                                                "text": "„Über der Wandtäfelung dagegen hing das Pastellbildnis einer Dame in Louis–XV.–Tracht und bildete das Gegenstück zum Porträt von Bouvards Vater.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00e5715e-4774-316d-8f1c-fdca55b41e77",
                                        "entry_id": "ea0868cc-faef-3335-bf5c-e1cf80e27f5b",
                                        "glosses": [
                                            "Teil, das deutlich/diametral anders ist als ein Teil, mit dem man es vergleicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6cd51f6-8d00-4fd3-bb26-ea79b4b94cb0",
                                                "sense_id": "00e5715e-4774-316d-8f1c-fdca55b41e77",
                                                "text": "Das Gegenstück zu ›Speichern‹ ist ›Laden‹."
                                            },
                                            {
                                                "example_id": "ea0c14f1-a9e3-4fd6-b832-938b2336c806",
                                                "sense_id": "00e5715e-4774-316d-8f1c-fdca55b41e77",
                                                "text": "„Der Raum wird greifbar, ein Gegenstück, ein Negativ des soliden Objekts, das gegen ihn presst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b478b1b6-5b9c-4690-9ce9-dd9c25ce33fc",
                        "source_entry_id": "6148019f-f29e-3c90-990b-7e9ab57cf2f8",
                        "source_sense_id": "c8ce243f-9ccc-35e6-b9a2-3be313936a9d",
                        "source_sense_description": "iemand of iets met vergelijkbare functie of eigenschappen aan gene zijde van een scheidslijn",
                        "target_lang_word": "Gegenteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c84ddaa3-16c8-349b-ae75-7052b7b679d1",
                                        "entry_id": "d19ac30c-6a08-37e5-a67f-78aa733a296e",
                                        "glosses": [
                                            "Wort, welches in entgegengesetzter Bedeutung zu einem andren Wort steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8961e4b0-7864-4319-a802-8b6b6a9cb947",
                                                "sense_id": "c84ddaa3-16c8-349b-ae75-7052b7b679d1",
                                                "text": "„Ja“ ist das Gegenteil von „nein“; „schnell“ ist das Gegenteil von „langsam“, „Freund“ ist das Gegenteil von „Feind“."
                                            },
                                            {
                                                "example_id": "e38ab122-5358-44ce-b7f3-f31ddd3255ed",
                                                "sense_id": "c84ddaa3-16c8-349b-ae75-7052b7b679d1",
                                                "text": "„Für Claudine war das Gegenteil von egoistisch ein Verhalten, das die Interessen anderer stets mitberücksichtigt.“"
                                            },
                                            {
                                                "example_id": "d1f6cbfb-a15b-4784-8109-225cb157adcf",
                                                "sense_id": "c84ddaa3-16c8-349b-ae75-7052b7b679d1",
                                                "text": "„Trotz unserer Fürsorge machen wir ständig das Gegenteil von dem, was gut für die Zukunft unserer Kinder wäre [: schnelle Autos fahren, häufig Reisen, Kohle noch lange verbrennen].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50898ac0-fd1c-3275-83a9-f9d7c71452cb",
                                        "entry_id": "d19ac30c-6a08-37e5-a67f-78aa733a296e",
                                        "glosses": [
                                            "etwas oder jemand, was resp. welcher in seiner Handlung oder Beschaffenheit etwas oder jemand andrem vollkommen entgegengesetzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbef946-150d-4977-b44c-6226c77212da",
                                                "sense_id": "50898ac0-fd1c-3275-83a9-f9d7c71452cb",
                                                "text": "„Wer etwas wagt, lebt gefährlich, sollte man meinen. Doch Erkenntnisse aus der Wagnisforschung legen das Gegenteil nahe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
