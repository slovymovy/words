                "senses": [
                    {
                        "sense_id": "cdb28617-7153-3a87-98b3-3c97e50214c4",
                        "entry_id": "ad8e6ae3-291b-333e-b6e2-67eee2391b34",
                        "glosses": [
                            "listenmäßige Beschreibung von Lieferungen und Leistungen als Kalkulationsgrundlage und Vertragsgrundlage; Vertragsangebot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ba3620-896d-4504-97b2-5566712a89de",
                                "sense_id": "cdb28617-7153-3a87-98b3-3c97e50214c4",
                                "text": "Im Leistungsverzeichnis werden die einzelnen Bedarfspositionen so beschrieben, das man diesen Bedarf kalkulieren und anbieten kann."
                            },
                            {
                                "example_id": "c36d9b8f-87df-4e48-b9f9-38560be302fd",
                                "sense_id": "cdb28617-7153-3a87-98b3-3c97e50214c4",
                                "text": "Leistungsverzeichnisse werden zum Beispiel von Staatsbauämtern, Architekturbüros oder Ingenieurbüros erstellt und als Anfrage ausgeschrieben."
                            },
                            {
                                "example_id": "8287fb76-8ea6-4e3a-b1d0-d0c28510d6ae",
                                "sense_id": "cdb28617-7153-3a87-98b3-3c97e50214c4",
                                "text": "„ In Paragraph 9 der Verdingungsordnung für Bauleistungen (VOB), Teil A, wird erläutert, was ein Leistungsverzeichnis in der Praxis enthalten sollte.“"
                            },
                            {
                                "example_id": "da12170c-c7ec-4d6e-86b6-17c4bd2082b7",
                                "sense_id": "cdb28617-7153-3a87-98b3-3c97e50214c4",
                                "text": "„Ein entsprechendes Leistungsverzeichnis ist spurlos verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf220c6a-60bd-3531-a050-24c76438bad0",
                        "entry_id": "ad8e6ae3-291b-333e-b6e2-67eee2391b34",
                        "glosses": [
                            "Auflistung von entgeltlichen Leistungen nach denen abgerechnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71224b44-eaf9-45d8-9023-2ebcc0b7c55b",
                                "sense_id": "bf220c6a-60bd-3531-a050-24c76438bad0",
                                "text": "„Ein entsprechendes Leistungsverzeichnis ist spurlos verschwunden.“"
                            },
                            {
                                "example_id": "3f163fdf-4d50-46fb-a2a2-a0acc5606bae",
                                "sense_id": "bf220c6a-60bd-3531-a050-24c76438bad0",
                                "text": "„Für die in diesem Preis- und Leistungsverzeichnis nicht aufgeführten Leistungen, die im Auftrag des Kunden oder in dessen mutmaßlichem Interesse erbracht werden und die nach den Umständen nur gegen eine Vergütung zu erwarten sind, kann die […] die Höhe der Entgelte nach billigem Ermessen (§ 315 BGB) bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
