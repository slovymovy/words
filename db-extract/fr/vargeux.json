                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "7ced9cac-b1c9-402b-a637-0f25fda002e6",
                                "sense_id": "c1414db3-2587-3d33-bacb-ac219e116c8c",
                                "text": "Tiens, ça devrait être le slogan de la CAQ : « C’est pas vargeux, on vous l’accorde, mais c’est mieux qu’un coup de pied dans le cul ! »"
                            },
                            {
                                "example_id": "eb55b4f3-5f10-40da-a17b-6940b44bf8be",
                                "sense_id": "c1414db3-2587-3d33-bacb-ac219e116c8c",
                                "text": "Ouin, s'en prendre à ses amis, c'est pas vargeux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b33f8c1-096b-476a-86a2-1b0e5a8ac168",
