                "senses": [
                    {
                        "sense_id": "c98cb8d3-0ab1-3074-982c-a53b5b289dd1",
                        "entry_id": "ed363635-b486-3c5e-83fc-f31198cd78fe",
                        "glosses": [
                            "Kino unter freiem Himmel mit großer Leinwand, in dem man die Filme im Auto sitzend ansieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce918473-a7b1-4203-b9a9-7980c8799212",
                                "sense_id": "c98cb8d3-0ab1-3074-982c-a53b5b289dd1",
                                "text": "Die große Zeit der Autokinos ist vorbei."
                            },
                            {
                                "example_id": "08c28046-386f-4722-8c50-38e0f8ed7a7b",
                                "sense_id": "c98cb8d3-0ab1-3074-982c-a53b5b289dd1",
                                "text": "„Am Autobahnring löst der Stau sich auf, und hinter dem Autokino beginnt das Land - flach und weit, unter hohem Himmel, reich an neuen Lichtverhältnissen und alten Gasthöfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd5dc62-467c-4fa3-8fcb-93c1f7af67d0",
                        "source_entry_id": "ed363635-b486-3c5e-83fc-f31198cd78fe",
                        "source_sense_id": "c98cb8d3-0ab1-3074-982c-a53b5b289dd1",
                        "source_sense_description": "Kino unter freiem Himmel mit großer Leinwand, in dem man die Filme im Auto sitzend ansieht",
                        "target_lang_word": "drive-in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drive-in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea310602-a55c-33f8-b181-42cf09ed766c",
                                        "entry_id": "372c5145-b97a-3aeb-b306-ff926d87f2e5",
                                        "glosses": [
                                            "Providing service to patrons who remain in their automobiles and partake while parked."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effdf326-c4bc-4430-8e7e-3a2775971483",
                                                "sense_id": "ea310602-a55c-33f8-b181-42cf09ed766c",
                                                "text": "drive-in church; drive-in funeral parlor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7878396-3c30-3061-a5af-6bb6b17800a5",
                                        "entry_id": "372c5145-b97a-3aeb-b306-ff926d87f2e5",
                                        "glosses": [
                                            "motel; motor inn"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "drive-in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ef21a2-00d2-322f-8cd4-2735750691a5",
                                        "entry_id": "08cb62f3-eb89-38b0-ae08-a15d4eef2503",
                                        "glosses": [
                                            "An outdoor cinema where movies are projected onto a large screen and patrons watch from inside their vehicles, listening either by a speaker or a designated radio frequency."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2eb892-683f-400d-913e-59f6c689e983",
                                                "sense_id": "96ef21a2-00d2-322f-8cd4-2735750691a5",
                                                "text": "Owners and sponsors of the drive-ins feel that in three-quarters of their patrons they have tapped a practically prehistoric strain of human—the hitherto non-movie-goer."
                                            },
                                            {
                                                "example_id": "76498b22-86ba-4632-815b-45cd0e1af31c",
                                                "sense_id": "96ef21a2-00d2-322f-8cd4-2735750691a5",
                                                "text": "This fact may seem surprising since the major movie studios, reluctant to risk cheapening their images by releasing first-run films to drive-ins, made only older movies affordable to drive-in operators."
                                            },
                                            {
                                                "example_id": "b7bf0199-c5d6-47b1-9d2a-09bdd34da575",
                                                "sense_id": "96ef21a2-00d2-322f-8cd4-2735750691a5",
                                                "text": "At the end of June 1997, there were 325 cinema sites and 28 drive-in sites in Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c5b0e8-5f2e-3b88-ab19-276496a88f64",
                                        "entry_id": "08cb62f3-eb89-38b0-ae08-a15d4eef2503",
                                        "glosses": [
                                            "A restaurant where patrons remain in their vehicles to consume their meals; the meal may be ordered and delivered to one's vehicle by a carhop waiter; or may require patrons to use a service counter. The cars in the parking lot serve as the patrons' dining room, there being a lack of dining rooms and tables."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df9792e-d8ac-43bc-a874-0d14c8ada5e6",
                                                "sense_id": "c7c5b0e8-5f2e-3b88-ab19-276496a88f64",
                                                "text": "The teenagers went down to the drive-in to order some hamburgers and fries."
                                            },
                                            {
                                                "example_id": "76243cb8-e5ff-450b-b872-9c5312fa7a52",
                                                "sense_id": "c7c5b0e8-5f2e-3b88-ab19-276496a88f64",
                                                "text": "1965 May 7, Don Moser, The nightmare of life with Billy, LIFE, page 101,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a1d138-0d81-31c0-8870-17ee7911324c",
                                        "entry_id": "08cb62f3-eb89-38b0-ae08-a15d4eef2503",
                                        "glosses": [
                                            "A drive-through restaurant where patrons remain in their vehicles and order food and beverages via a speaker phone; the meal is delivered by a service window accessible by car."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05121a93-1da7-435b-ba99-7e1f3a201f1b",
                                                "sense_id": "b0a1d138-0d81-31c0-8870-17ee7911324c",
                                                "text": "Even before franchising genius Ray A. Kroc approached Mac and Dick McDonald to become the licensing agent for their small San Bernardino (Calif.) restaurant, scores of drive-in operators had begun copying McDonald′s speedy burger-fries-and-shake menus. Love contends that Kroc′s success came largely from his commitment to automating the preparation of drive-in meals."
                                            },
                                            {
                                                "example_id": "fbee3af4-3a61-4e40-a31c-7000b56b07d0",
                                                "sense_id": "b0a1d138-0d81-31c0-8870-17ee7911324c",
                                                "text": "For during the fabled Indiana blizzard of ′78, Tom found himself trapped inside the kitchen of the drive-in for three days before his family, and—more to the point—his customers, could reach him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
