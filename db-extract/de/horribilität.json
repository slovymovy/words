                "senses": [
                    {
                        "sense_id": "a7fd0426-69f3-3701-9d1b-9e9d09b49397",
                        "entry_id": "cc03ae4b-de9d-3fa0-96a4-b032e5d61918",
                        "glosses": [
                            "Eigenschaft/Handlung, die in deutlichem Maße schreckliches (horribles) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b438a1-5055-40ee-a9d0-64c37caab760",
                                "sense_id": "a7fd0426-69f3-3701-9d1b-9e9d09b49397",
                                "text": "„Illustriert wird die Horribilität der Idee durch Borges' Geschichte El inmortal.“"
                            },
                            {
                                "example_id": "96d7b99c-a633-4bb1-8c22-b5c2cd227606",
                                "sense_id": "a7fd0426-69f3-3701-9d1b-9e9d09b49397",
                                "text": "„Für all jene Leser, die an dieser Geschichte wie vielleicht überhaupt an der Horribilität der Ehe ein gewisses Interesse besitzen, möchte ich die Ereignisse im folgenden näher beschreiben.“"
                            },
                            {
                                "example_id": "793ad96f-c3be-4559-a3eb-6f4baadaf00f",
                                "sense_id": "a7fd0426-69f3-3701-9d1b-9e9d09b49397",
                                "text": "„Zum dritten Mal musste die Öffentlichkeit derlei Horribilitäten erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
