                ],
                "senses": [
                    {
                        "sense_id": "207e3e0b-d001-3cb5-940e-2936198273bf",
                        "entry_id": "0d2e14f2-86e1-353f-aa85-b48864c093a4",
                        "glosses": [
                            "Regierungssystem in verschiedenen Staatsformen, bei dem das Volk anstatt Selbstausübung von staatlicher Gewalt [2] durch politische Körperschaften vertreten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9965c7-efc8-486c-8cfc-49dae14aab9a",
                                "sense_id": "207e3e0b-d001-3cb5-940e-2936198273bf",
                                "text": "„Das parlamentarische Repräsentativsystem hat in der Geschichte aber nie bedeutet, daß die Parlamentarier auch soziologisch repräsentativ für die Wählerschaft sein müßten.“"
                            },
                            {
                                "example_id": "b7e64923-d0e2-4f9d-a703-510c6ff0538c",
                                "sense_id": "207e3e0b-d001-3cb5-940e-2936198273bf",
                                "text": "„Namentlich in Demokratien mit parlamentarischem Repräsentativsystem und geringen plebiszitären Mitwirkungsrechten hat die Versammlungsfreiheit die Bedeutung eines grundlegenden und unentbehrlichen Funktionselementes (VG Lüneburg, Aktenzeichen 7 A 50/95).“"
                            },
                            {
                                "example_id": "4f8023d8-cacd-4ba0-b447-a7bc85d5faf5",
                                "sense_id": "207e3e0b-d001-3cb5-940e-2936198273bf",
                                "text": "„\"Das Repräsentativsystem errichtete man in vollem Bewusstsein, dass die gewählten Vertreter angesehene Bürger sein würden und sein sollten, die sich sozial von ihren Wählern abhoben.\"“"
                            },
                            {
                                "example_id": "bf237872-1cfe-4b5e-b2a2-3288b7cf519d",
                                "sense_id": "207e3e0b-d001-3cb5-940e-2936198273bf",
                                "text": "„Sind Volksabstimmungen sinnvoll, oder unterhöhlen sie das Repräsentativsystem?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd8c2673-4677-3769-9da1-74ebdc61a051",
                        "entry_id": "0d2e14f2-86e1-353f-aa85-b48864c093a4",
                        "glosses": [
                            "Regierungssystem, in dem verschiedene Parteien und Verbände die Interessensgruppen der Gesellschaft vertreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b72b948-c53a-46b2-93b6-000edf0542ac",
                                "sense_id": "cd8c2673-4677-3769-9da1-74ebdc61a051",
                                "text": "„wohl, weil den eher radikal-demokratisch eingestellten Schülern die Vorteile des Repräsentativsystems und Parteienstaates nicht ohne weiteres einsichtig waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
