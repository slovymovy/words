{
    "word_family": [
        "nul",
        "punt",
        "nulpuntenergie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb65f469-abfe-3e0b-a405-688cb2ccc812",
                    "sense_definition": "Het referentiepunt op een schaal of meetinstrument van waaruit metingen worden verricht.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op een thermometer is het <w>nulpunt</w> de temperatuur waarop water bevriest.",
                            "target_lang_translations": {
                                "en": "On a thermometer, the <w>zero point</w> is the temperature at which water freezes."
                            }
                        },
                        {
                            "text": "We moeten eerst het <w>nulpunt</w> bepalen voordat we de exacte hoogte kunnen berekenen.",
                            "target_lang_translations": {
                                "en": "We must first determine the <w>zero point</w> before we can calculate the exact height."
                            }
                        }
                    ],
                    "synonyms": [
                        "referentiepunt",
                        "oorsprong"
                    ],
                    "common_phrases": [
                        "het nulpunt bepalen",
                        "onder het nulpunt"
                    ],
                    "target_lang_definitions": {
                        "en": "The reference point on a scale or measuring instrument from which measurements are made."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zero point",
                                "target_lang_sense_clarification": "on a scale or measuring instrument"
                            },
                            {
                                "target_lang_word": "zero",
                                "target_lang_sense_clarification": "the point on a thermometer or scale"
                            },
                            {
                                "target_lang_word": "origin",
                                "target_lang_sense_clarification": "starting point of measurement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b96fca8-438f-3978-b3f0-22ae0211cb99",
                    "sense_definition": "Het laagst mogelijke niveau of punt van waardering, moreel of succes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_dieptepunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De populariteit van deze politicus heeft nu wel het <w>nulpunt</w> bereikt.",
                            "target_lang_translations": {
                                "en": "The popularity of this politician has now reached <w>rock bottom</w>."
                            }
                        },
                        {
                            "text": "Na de zoveelste ruzie was de sfeer in het team gedaald tot het <w>nulpunt</w>.",
                            "target_lang_translations": {
                                "en": "After yet another argument, the morale in the team had dropped to <w>zero</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dieptepunt",
                        "diepte"
                    ],
                    "common_phrases": [
                        "het nulpunt bereiken",
                        "dalen tot het nulpunt"
                    ],
                    "target_lang_definitions": {
                        "en": "The lowest possible level or point of appreciation, morale, or success."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rock bottom",
                                "target_lang_sense_clarification": "lowest possible level of morale or success"
                            },
                            {
                                "target_lang_word": "all-time low",
                                "target_lang_sense_clarification": "lowest point of popularity or success"
                            },
                            {
                                "target_lang_word": "zero",
                                "target_lang_sense_clarification": "figurative point of no morale or energy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52db0f63-28c4-3e3c-84bc-f4772c07978b",
                    "sense_definition": "Een waarde van een onafhankelijke variabele waarvoor de bijbehorende functiewaarde gelijk is aan nul.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de wiskundeles leerden we hoe je het <w>nulpunt</w> van een tweedegraads functie berekent.",
                            "target_lang_translations": {
                                "en": "In math class, we learned how to calculate the <w>zero</w> of a quadratic function."
                            }
                        },
                        {
                            "text": "De grafiek snijdt de x-as precies in het <w>nulpunt</w>.",
                            "target_lang_translations": {
                                "en": "The graph intersects the x-axis exactly at the <w>x-intercept</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nulwaarde",
                        "wortel"
                    ],
                    "common_phrases": [
                        "nulpunt van een functie"
                    ],
                    "target_lang_definitions": {
                        "en": "A value of an independent variable for which the corresponding function value is equal to zero."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zero",
                                "target_lang_sense_clarification": "of a mathematical function"
                            },
                            {
                                "target_lang_word": "root",
                                "target_lang_sense_clarification": "of a mathematical function"
                            },
                            {
                                "target_lang_word": "x-intercept",
                                "target_lang_sense_clarification": "where a graph crosses the x-axis"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}