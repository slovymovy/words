                        "sense_id": "dff3efd0-f12d-3514-b627-ed9014e70554",
                        "entry_id": "119222a9-7c6f-39ee-bed7-ce40bb5503ab",
                        "glosses": [
                            "The quality of being pleasant or agreeable, whether in respect to situation, climate, manners, disposition etc."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "ea296ffd-0b0b-478d-aee1-7feab1697be5",
                                "sense_id": "dff3efd0-f12d-3514-b627-ed9014e70554",
                                "text": "\"I trust that you are as comfortable as circumstances permit,\" said Holmes, when the final arrangements were made. \"Should I be guilty of a liberty if I lit a cigar and placed it between your lips?\"\nBut all amenities were wasted upon the angry German."
                            },
                            {
                                "example_id": "bccff0c7-ae75-445e-baa7-86710bb2091d",
                                "sense_id": "dff3efd0-f12d-3514-b627-ed9014e70554",
                                "text": "When we got to Sullivan Street Mrs. Ricci was waiting in front with a glare in her eye that made me decide not to stop for any amenities."
                            }
                        ]
                    }
                ],
