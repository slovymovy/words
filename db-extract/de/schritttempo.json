                ],
                "senses": [
                    {
                        "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                        "entry_id": "ea386eb0-8094-3585-ad55-e081bfdb52c3",
                        "glosses": [
                            "sehr niedrige Geschwindigkeit, ungefähr die eines Fußgängers beziehungsweise eines Pferdes in der Gangart \\\"Schritt\\\" (laut der deutsch Straßenverkehrsordnung deutlich unterhalb von 20 km/h)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b8c789-a160-43ba-8a20-c56339c96f38",
                                "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                                "text": "In Spielstraßen muss man Schritttempo fahren."
                            },
                            {
                                "example_id": "180ac99e-0533-487d-9ead-fd18d7236b16",
                                "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                                "text": "„Im Schritttempo bahnen wir uns einen Weg durch Mensch und Tier.“"
                            },
                            {
                                "example_id": "714c7327-7d86-457c-abc9-174629f5058a",
                                "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                                "text": "„Wir steuern, obschon das Schiff jetzt sehr langsam in Schritttempo fährt, gegen eine starke Strömung.“"
                            },
                            {
                                "example_id": "827735d9-3204-4fcc-a822-3a0ae6d35f4b",
                                "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                                "text": "„Ein Auto überfährt einen Anar im Schritttempo, der Saft spritzt nach allen Seiten.“"
                            },
                            {
                                "example_id": "35de6711-096c-4e38-8a9d-feb57b4a5d06",
                                "sense_id": "ba265de3-bd65-3e57-8e1e-6d83dc26fbae",
                                "text": "„Alle bewegten sich im Schritttempo der Asphaltiermaschine, als würden sie ehrfurchtsvoll einem Trauerzug folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
