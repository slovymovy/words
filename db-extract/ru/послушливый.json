                        ],
                        "form": "послу́шливей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                        "entry_id": "93777748-2f5f-3316-88cd-25016e1fa8ac",
                        "glosses": [
                            "устар. то же, что послушный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89b1ed1-6b07-4d75-91f1-20b6bbcb0b3d",
                                "sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                                "text": "А царь тем ядом напитал // Свои послушливые стрелы // И с ними гибель разослал // К соседям в чуждые пределы."
                            },
                            {
                                "example_id": "4ed14f5c-2191-4001-8a86-0382552bbce0",
                                "sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                                "text": "Ты, Федька, будь послушлив, а уж я тебя не обижу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f71f8e1a-071d-41ad-86d7-94023ba296ff",
                        "source_entry_id": "93777748-2f5f-3316-88cd-25016e1fa8ac",
                        "source_sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                        "target_lang_word": "obedient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obedient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e63bbe4c-c5da-3c8c-aa26-a410a46f502a",
                                        "entry_id": "cfde940d-e245-36a4-9cb5-6866050062c4",
                                        "glosses": [
                                            "Willing to comply with the commands, orders, or instructions of those in authority; biddable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cec5ad2-fe91-4fd8-84e1-f25fcb367d10",
                                                "sense_id": "e63bbe4c-c5da-3c8c-aa26-a410a46f502a",
                                                "text": "Jessica was so intensely obedient of her parents that her brother sometimes thought she was a robot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obedient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1092f8ab-a332-331f-90fa-9b18d20e8e2d",
                                        "entry_id": "e10b6515-a8a1-37cc-9dd9-8cde55928cca",
                                        "glosses": [
                                            "One who obeys."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14168ab-e3e8-4d4f-9f58-4397fa3669ea",
                                                "sense_id": "1092f8ab-a332-331f-90fa-9b18d20e8e2d",
                                                "text": "Damn the obedients and hail the defiants if you will; the experiment does not motivate confidence about how particular subjects would behave in markedly dissimilar situations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "393d1278-cb7a-401d-aaf7-f54874f73262",
                        "source_entry_id": "93777748-2f5f-3316-88cd-25016e1fa8ac",
                        "source_sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                        "target_lang_word": "obsequious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obsequious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Excessively eager and attentive to please or to obey instructions; fawning, subservient, servile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ae36b4-d9b1-4d19-9152-132ddb7a1f7a",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "[S]he complained pettishly of the heat and the flies and at length of the walk, and reduced Robert to the antics of an obsequious dog."
                                            },
                                            {
                                                "example_id": "ee160842-eab4-4824-a327-7d34abc50b5c",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "Personally I felt shy and uncomfortable at this obsequious adoration, and I read the same feeling in the faces of Lord John and Summerlee, but Challenger expanded like a flower in the sun."
                                            },
                                            {
                                                "example_id": "b937c1a1-a58d-4c13-b13c-5972a7ea7762",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "Translation falls especially short of this conceit which carries the whole flamboyance of the Spanish language. It was intended as an obsequious flattery of the Condesa, and was untrue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a352d4e-739b-36cd-ba5f-1483c1053d73",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Obedient; compliant with someone else's orders or wishes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74c0b81a-0ce4-4c2c-8ebd-dc322451b5c5",
                                                "sense_id": "4a352d4e-739b-36cd-ba5f-1483c1053d73",
                                                "text": "Our ladies were situated as well as it was possible; they had good servants, splendid rooms, obsequious attendants, and had become habituated to the country, so that the loss of the Count was not any thing of moment beyond the pleasure of his society;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a7cde0-a3d9-3d8b-af06-7f4187b704ca",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Of or pertaining to obsequies, funereal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8439cb5c-ccdf-46cc-93de-651f72aa3b55",
                                                "sense_id": "41a7cde0-a3d9-3d8b-af06-7f4187b704ca",
                                                "text": "[…] the ſuruiuer bound / In filliall obligation for ſome tearme\n To doe obſequious ſorrowe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f041a1-6464-4dd7-8f1c-661888d30e74",
                        "source_entry_id": "93777748-2f5f-3316-88cd-25016e1fa8ac",
                        "source_sense_id": "7514dd8b-6b18-39ac-abf8-3707d7b9042c",
                        "target_lang_word": "submissive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "submissive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                        "entry_id": "77108184-2047-317e-8874-cdfb24b619ce",
                                        "glosses": [
                                            "Meekly obedient or passive; obsequious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8941785-9b55-4aca-96fd-74f49f033de2",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "The powerful managers for government were not sufficiently submissive to the pleasure of the possessors of immediate and personal favour, sometimes from a confidence in their own strength natural and acquired; sometimes from a fear of offending their friends, and weakening that lead in the country, which gave them a consideration independent of the court."
                                            },
                                            {
                                                "example_id": "569f9d0c-e818-4a3d-8c04-7a248c2946a9",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "If the human being who answers these tendencies assumes a submissive behavior, in essence a lowering of head and shoulders, wavering glance, absence of all preparations for attack, general weakening of muscle tonus, and hesitancy in movement, the movements of attempt at mastery become modified into attempts at the more obvious swagger, strut and glare of triumph."
                                            },
                                            {
                                                "example_id": "3cc8e007-7dea-48e3-9edc-529fbc4c7522",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "Once oppression has been internalised, little force is needed to keep us submissive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "submissive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc07878-28bd-3cdb-962c-d75076441b9a",
                                        "entry_id": "2c15a054-0796-3203-beb5-1b5a92abf428",
                                        "glosses": [
                                            "One who submits to a dominating partner in BDSM practices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dc99ce3-a06f-309b-b759-a5580d1209f5",
                                        "entry_id": "2c15a054-0796-3203-beb5-1b5a92abf428",
                                        "glosses": [
                                            "One who submits."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628c636a-fdf0-4059-aed8-7d9c04669e8e",
                                                "sense_id": "2dc99ce3-a06f-309b-b759-a5580d1209f5",
                                                "text": "These \"submissives\" continued to go along as near as possible following the old routine of their lives and did no overt act to annoy any of the parties of whites that persisted in traveling through their country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
