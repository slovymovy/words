                "senses": [
                    {
                        "sense_id": "3fe1eee0-38d2-398a-8551-6c31cc55dcca",
                        "entry_id": "b653509d-823e-3118-bf5f-abdc446e34e2",
                        "glosses": [
                            "stinginess"
                        ],
