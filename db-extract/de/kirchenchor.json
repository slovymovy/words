                "senses": [
                    {
                        "sense_id": "45c7a8eb-76a5-38e2-a841-8600131c9bb9",
                        "entry_id": "84883300-438d-3cbe-b6e7-2970ad92d992",
                        "glosses": [
                            "Gesangsensemble, das die Gottesdienste in einer Kirchengemeinde mit sakralen Chorwerken umrahmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff01ea2-dab7-4b90-8236-35da214afa12",
                                "sense_id": "45c7a8eb-76a5-38e2-a841-8600131c9bb9",
                                "text": "Der Kirchenchor sang am Ende des Gottesdienstes das Lied »Meinen Jesum lass ich nicht« von Johann Sebastian Bach."
                            },
                            {
                                "example_id": "1f0c863b-127f-4af3-b525-e96aa7539fdf",
                                "sense_id": "45c7a8eb-76a5-38e2-a841-8600131c9bb9",
                                "text": "„Nachwuchsmangel haben allenfalls traditionelle Kirchenchöre auf dem Land.“"
                            },
                            {
                                "example_id": "821cd311-c6f0-475b-8e41-a4d739272e4a",
                                "sense_id": "45c7a8eb-76a5-38e2-a841-8600131c9bb9",
                                "text": "„Jetzt aber ging ich auf in den Stimmen des Kirchenchors, der seinem langjährigen Mitglied Maria diesen Tag zum Traum machen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
