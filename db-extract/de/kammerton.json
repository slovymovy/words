                        "entry_id": "12e53c81-5be9-313f-886a-27a0bf36c61d",
                        "glosses": [
                            "der gemeinsame Ton, auf den die Instrumente einer Musikgruppe eingestimmt werden"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f4936419-492f-4e05-b3ef-d3343467e5a5",
                                "sense_id": "30ef7574-0484-3fd5-9df8-e42dd2c996e0",
                                "text": "Die Frequenz für den Kammerton a' wurde 1939 auf 440 Hz festgelegt."
                            },
                            {
                                "example_id": "8cee1ebe-750e-4b9a-9921-3178dda161c8",
                                "sense_id": "30ef7574-0484-3fd5-9df8-e42dd2c996e0",
                                "text": "Im Orchester gibt die Oboe beim Stimmen den Kammerton a' vor, da sie die reinsten Obertöne aller Instrumente aufweist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "234b3e62-cf16-48a9-8064-ae6e9b3ebb9b",
                        "source_entry_id": "12e53c81-5be9-313f-886a-27a0bf36c61d",
                        "source_sense_id": "30ef7574-0484-3fd5-9df8-e42dd2c996e0",
