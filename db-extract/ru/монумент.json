                "senses": [
                    {
                        "sense_id": "4d332417-194f-3323-8046-da447c504a75",
                        "entry_id": "fb5ec0d6-4f5b-322f-83fe-c7531163c267",
                        "glosses": [
                            "значительный по размерам памятник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff70c888-43b3-49de-b268-0a5bfae58fc0",
                                "sense_id": "4d332417-194f-3323-8046-da447c504a75",
                                "text": "Есть два памятника Ленину и монумент «Слава труду» — металлический штырь двадцатиметровой высоты, на который вперемешку насажены чугунные ученые, сварщики и комсомолки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65ff9b66-45c2-471c-bbdd-9bfe0b13cccc",
                        "source_entry_id": "fb5ec0d6-4f5b-322f-83fe-c7531163c267",
                        "source_sense_id": "4d332417-194f-3323-8046-da447c504a75",
                        "target_lang_word": "monument",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monument",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00e3ebe3-f925-3874-be53-9a83aa0e8482",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A structure built for commemorative or symbolic reasons, or as a memorial; a commemoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e119b-8e60-4e3c-a3d8-a9281a4e228d",
                                                "sense_id": "00e3ebe3-f925-3874-be53-9a83aa0e8482",
                                                "text": "There is a monument on the town green to the soldiers who died in World War I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eacde1b-2116-354c-8d6e-37b982e96ab3",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "An important site owned by the community as a whole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7619eab7-92d5-35c4-97d9-b919f50808be",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "a registered archaeological site or other structure, deemed historic or otherwise worthy of protection."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "760260e3-24a4-3091-a6d8-488e83d5cc8b",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A sign of exceptional achievement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ade11c-3654-463a-a824-e3bfaf885b6a",
                                                "sense_id": "760260e3-24a4-3091-a6d8-488e83d5cc8b",
                                                "text": "The cab pulled up in front of a tumbledown cheap ‘villa’ in an unfinished cheap neighbourhood, — the whole place a living monument of the defeat of the speculative builder."
                                            },
                                            {
                                                "example_id": "0aac744d-f1f2-4a82-bcef-d905c7c03ea9",
                                                "sense_id": "760260e3-24a4-3091-a6d8-488e83d5cc8b",
                                                "text": "The line became a monument to his drive and imagination — and a hard training course for the future chief of the Great Central."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c1788d-0f4b-32e2-bcbf-36341e9464a1",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "An important burial vault or tomb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aab31730-0785-3e74-9df9-5c4755f86460",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "Any grave marker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3de3696c-7ad3-3aa4-94a8-51da29d6ba8c",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A legal document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "798e272e-9bcd-3482-bb94-2c3d60cbe176",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A surveying reference point marked by a permanently fixed marker (a survey monument)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06b5c0ca-c96a-3c9b-bfcc-7368571db09e",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A pile of stones left by a prospector to claim ownership of ore etc. found in a mine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4cf286d-f079-35e8-8f94-68b81797debb",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A natural or artificial object used as a reference point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9196744c-fa6d-3191-905e-b733e393d09d",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "A surviving record."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de842b49-26f2-430f-8de9-12c45c7b3ce8",
                                                "sense_id": "9196744c-fa6d-3191-905e-b733e393d09d",
                                                "text": "This linguistic fragment, rough as it may appear, is of the highest interest; for it is the first written monument of the French language, eleven hundred years old."
                                            },
                                            {
                                                "example_id": "91e79bb3-3d5d-414d-96d2-200589bea7dd",
                                                "sense_id": "9196744c-fa6d-3191-905e-b733e393d09d",
                                                "text": "Czech was long used as a written language also by the Slovaks; the earliest existing Slovak monument is the Žilina Town Book from the late 15ᵗʰ century"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d40bc531-1060-3ac5-b1e7-1baf8a42b7b2",
                                        "entry_id": "9792614e-4ab1-3b56-9dd5-808a2ab0db12",
                                        "glosses": [
                                            "Alternative spelling of Monument (“prestigious one-day race”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monument",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527251d1-a11b-30e0-9197-a15391bff1b4",
                                        "entry_id": "754cc96f-3d65-3757-bd74-f948d4f4cd72",
                                        "glosses": [
                                            "To mark or memorialize with a monument."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d4bed66-d1b4-3ad1-84ba-205a76d45dfc",
                                        "entry_id": "754cc96f-3d65-3757-bd74-f948d4f4cd72",
                                        "glosses": [
                                            "To place a surveyor's monument at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "457a91a2-64e3-4cde-94dd-4af2d744b086",
                                                "sense_id": "9d4bed66-d1b4-3ad1-84ba-205a76d45dfc",
                                                "text": "Enter the year the marker was monumented. If the year cannot be determined , enter \" UNK \" ."
                                            },
                                            {
                                                "example_id": "749fb272-60ef-4f37-a33a-ffbedf77e65a",
                                                "sense_id": "9d4bed66-d1b4-3ad1-84ba-205a76d45dfc",
                                                "text": "Having chosen and monumented the initial point, the surveyor established the \"principal meridian\" by traversing north and south from the initial point."
                                            },
                                            {
                                                "example_id": "f6afa81b-7bef-4d2c-90b7-74c693b02d96",
                                                "sense_id": "9d4bed66-d1b4-3ad1-84ba-205a76d45dfc",
                                                "text": "The first-order network is usually monumented on the roofs of buildings; ground stations are used only in suburban districts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a77642e-d50f-48e7-a475-cefe96091601",
                        "source_entry_id": "fb5ec0d6-4f5b-322f-83fe-c7531163c267",
                        "source_sense_id": "4d332417-194f-3323-8046-da447c504a75",
