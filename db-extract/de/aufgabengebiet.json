                ],
                "senses": [
                    {
                        "sense_id": "c4d65e28-8769-30a3-a07d-84cda7036815",
                        "entry_id": "8a65ed0c-ef90-3f05-b379-c7b19b806b01",
                        "glosses": [
                            "ein Fach- oder Aufgabenbereich (meist im Zusammenhang mit dem Arbeitsplatz), in dem Aufgaben und/oder Aufträge bestimmten Types zu erledigen sind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35eb953-f8b6-4f82-80a6-5b8174113525",
                                "sense_id": "c4d65e28-8769-30a3-a07d-84cda7036815",
                                "text": "Er machte sich mit seinem neuen Aufgabengebiet vertraut."
                            },
                            {
                                "example_id": "6a39284b-5e6b-4283-9169-0c3bf7aae719",
                                "sense_id": "c4d65e28-8769-30a3-a07d-84cda7036815",
                                "text": "Die Aufgabengebiete der Schülerpraktikantin beschränkten sich für die ersten Tage auf das Kaffeekochen und Schreiben von Mahnbriefen."
                            },
                            {
                                "example_id": "4a0c47c7-6a6f-45b1-810d-f447d89cec20",
                                "sense_id": "c4d65e28-8769-30a3-a07d-84cda7036815",
                                "text": "„Er verabschiedete sich dann aber mit der Bemerkung, dass die beiden Tom nun in sein neues Aufgabengebiet einweisen würden, warf aber noch einen interessierten Blick auf einen Monitor voller Messwerte, bevor er davoneilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
