                "senses": [
                    {
                        "sense_id": "98deeb1b-e674-343b-bc68-170e2c81d156",
                        "entry_id": "8dd94a29-2709-3b43-a23c-8918d2dfcc08",
                        "glosses": [
                            "het gemoed en de stemming ondersteunend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419d1c22-81a1-46b5-b19f-05fdddb6b64d",
                                "sense_id": "98deeb1b-e674-343b-bc68-170e2c81d156",
                                "text": "\"Rood, hartverwarmend en hartversterkend, met een beetje houtlagering en lekker dik."
                            },
                            {
                                "example_id": "2d18cec4-a50a-4c4e-8b9a-380281d528b1",
                                "sense_id": "98deeb1b-e674-343b-bc68-170e2c81d156",
                                "text": "De keizer en de heelmeesters drongen er echter bij hem op aan dat hij minstens een hartversterkend middel zou innemen en vleesnat drinken waarmee hij voldoende krachten zou opdoen om de strijd aan te binden."
                            },
                            {
                                "example_id": "93a72ebf-b754-4d34-83ba-e4112946e088",
                                "sense_id": "98deeb1b-e674-343b-bc68-170e2c81d156",
                                "text": "Terstond werd zij daar vandaan gehaald en door de heelmeesters met hartversterkende middelen weer tot bewustzijn gebracht."
                            }
                        ]
                    },
