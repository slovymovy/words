{
    "word_family": [
        "mortality",
        "mortally",
        "immortal",
        "immortality",
        "immortalize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4c0bfc8-773a-3c1d-a697-922892a8cb9a",
                    "sense_definition": "Subject to death; capable of dying and not living forever.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "subject_to_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All <w>mortal</w> beings must eventually face the end of their lives.",
                            "target_lang_translations": {
                                "ru": "Все <w>смертные</w> существа должны в конце концов встретить конец своей жизни.",
                                "zh": "所有<w>终有一死的</w>生物最终都必须面对生命的终结。"
                            }
                        },
                        {
                            "text": "He realized that he was <w>mortal</w> and would not live to see the next century.",
                            "target_lang_translations": {
                                "ru": "Он осознал, что <w>смертен</w>, и не доживет до следующего столетия.",
                                "zh": "他意识到自己只是个<w>凡人</w>，活不到下一个世纪了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "immortal",
                        "everlasting"
                    ],
                    "common_phrases": [
                        "mere mortal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подверженный смерти; способный умереть и не живущий вечно.",
                        "zh": "指注定会死亡的；无法永生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертный",
                                "target_lang_sense_clarification": "подверженный смерти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终有一死的",
                                "target_lang_sense_clarification": "注定会死亡的"
                            },
                            {
                                "target_lang_word": "凡人",
                                "target_lang_sense_clarification": "指人类的有限性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ea19205-5637-3302-9153-9a730470d439",
                    "sense_definition": "Causing death; fatal or lethal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "causing_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier received a <w>mortal</w> wound during the fierce battle.",
                            "target_lang_translations": {
                                "ru": "Солдат получил <w>смертельное</w> ранение в ходе ожесточенной битвы.",
                                "zh": "那名士兵在激战中受了<w>致命</w>伤。"
                            }
                        },
                        {
                            "text": "The collapse of the bank dealt a <w>mortal</w> blow to the local economy.",
                            "target_lang_translations": {
                                "ru": "Крах банка нанес <w>смертельный</w> удар по местной экономике.",
                                "zh": "银行倒闭对当地经济造成了<w>致命</w>打击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fatal",
                        "lethal"
                    ],
                    "common_phrases": [
                        "mortal wound",
                        "mortal blow",
                        "mortal combat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводящий к смерти; фатальный или летальный.",
                        "zh": "导致死亡的；致命的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельный",
                                "target_lang_sense_clarification": "приводящий к смерти"
                            },
                            {
                                "target_lang_word": "фатальный",
                                "target_lang_sense_clarification": "роковой, губительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致命的",
                                "target_lang_sense_clarification": "导致死亡的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                    "sense_definition": "Extreme and intense, often implying a threat to life or deep hostility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have been <w>mortal</w> enemies ever since the argument began.",
                            "target_lang_translations": {
                                "ru": "Они были <w>заклятыми</w> врагами с тех пор, как начался спор.",
                                "zh": "自从那次争吵开始，他们就成了<w>死敌</w>。"
                            }
                        },
                        {
                            "text": "She lived in <w>mortal</w> fear that her secret would be discovered.",
                            "target_lang_translations": {
                                "ru": "Она жила в <w>смертельном</w> страхе, что ее секрет будет раскрыт.",
                                "zh": "她生活在担心秘密被发现的<w>极度</w>恐惧中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mortal enemy",
                        "mortal fear",
                        "mortal danger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайний и интенсивный, часто подразумевающий угрозу жизни или глубокую враждебность.",
                        "zh": "极端的、强烈的，常暗示生命威胁或深仇大恨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельный",
                                "target_lang_sense_clarification": "крайний, сильный (о страхе, опасности)"
                            },
                            {
                                "target_lang_word": "заклятый",
                                "target_lang_sense_clarification": "непримиримый (о враге)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死敌",
                                "target_lang_sense_clarification": "指不共戴天的敌人"
                            },
                            {
                                "target_lang_word": "极度的",
                                "target_lang_sense_clarification": "形容恐惧或危险的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85bad0f9-98ed-3d13-87fe-ce5b08a620ed",
                    "sense_definition": "Of or relating to human beings as opposed to divine or supernatural entities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "human",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such magnificent beauty is not meant for <w>mortal</w> eyes to see.",
                            "target_lang_translations": {
                                "ru": "Такая великолепная красота не предназначена для <w>смертных</w> глаз.",
                                "zh": "如此壮丽的美景并非<w>凡人</w>之眼所能窥见。"
                            }
                        },
                        {
                            "text": "The mystery was far beyond the limits of <w>mortal</w> understanding.",
                            "target_lang_translations": {
                                "ru": "Эта тайна была далеко за пределами <w>смертного</w> понимания.",
                                "zh": "这个谜团远远超出了<w>凡人</w>的理解范畴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mortal man",
                        "mortal eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям, в отличие от божественных или сверхъестественных сущностей.",
                        "zh": "属于人类的，与神圣或超自然存在相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертный",
                                "target_lang_sense_clarification": "человеческий, земной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凡人的",
                                "target_lang_sense_clarification": "人类的，非神圣的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "410999a7-8a56-3d48-b517-f55b68159cac",
                    "sense_definition": "In theology, causing spiritual death or separation from divine grace.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He feared that he had committed a <w>mortal</w> sin by lying under oath.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что совершил <w>смертный</w> грех, солгав под присягой.",
                                "zh": "他担心自己因在宣誓后撒谎而犯下了<w>大罪</w>。"
                            }
                        },
                        {
                            "text": "The priest explained the difference between a venial sin and a <w>mortal</w> one.",
                            "target_lang_translations": {
                                "ru": "Священник объяснил разницу между простительным грехом и <w>смертным</w>.",
                                "zh": "牧师解释了轻罪与<w>大罪</w>之间的区别。"
                            }
                        }
                    ],
                    "antonyms": [
                        "venial"
                    ],
                    "common_phrases": [
                        "mortal sin"
                    ],
                    "target_lang_definitions": {
                        "ru": "В теологии: вызывающий духовную смерть или отлучение от божественной благодати.",
                        "zh": "在神学中，指导致灵魂死亡或与神恩隔绝的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертный",
                                "target_lang_sense_clarification": "в религиозном контексте (о грехе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大罪",
                                "target_lang_sense_clarification": "宗教语境下严重的罪行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6acb4641-e684-3ff3-9d84-ed3306b9d609",
                    "sense_definition": "Extremely long, tedious, or wearisome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tedious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat there waiting for three <w>mortal</w> hours before the train finally arrived.",
                            "target_lang_translations": {
                                "ru": "Мы просидели там в ожидании три <w>битых</w> часа, прежде чем поезд наконец прибыл.",
                                "zh": "我们在那里等了<w>整整</w>三个小时，火车才终于到站。"
                            }
                        },
                        {
                            "text": "The lecture went on for two <w>mortal</w> hours without a break.",
                            "target_lang_translations": {
                                "ru": "Лекция продолжалась два <w>битых</w> часа без перерыва.",
                                "zh": "讲座持续了<w>整整</w>两个小时，中间没有休息。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно долгий, утомительный или скучный.",
                        "zh": "极其漫长、乏味或令人厌烦的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "битый",
                                "target_lang_sense_clarification": "целый (о времени, разг.)"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "долгий (о времени)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整整",
                                "target_lang_sense_clarification": "强调时间漫长"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f38f324-0062-3fd4-805a-d4a0caed0192",
                    "sense_definition": "A human being subject to death, often contrasted with gods or spirits.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "subject_to_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient myths tell stories of gods interacting with ordinary <w>mortals</w>.",
                            "target_lang_translations": {
                                "ru": "Древние мифы рассказывают истории о богах, взаимодействующих с обычными <w>смертными</w>.",
                                "zh": "古老的神话讲述了神灵与普通<w>凡人</w>交往的故事。"
                            }
                        },
                        {
                            "text": "As a mere <w>mortal</w>, I cannot predict the future with certainty.",
                            "target_lang_translations": {
                                "ru": "Как простой <w>смертный</w>, я не могу с уверенностью предсказать будущее.",
                                "zh": "作为一个普通的<w>凡人</w>，我无法确定地预知未来。"
                            }
                        }
                    ],
                    "antonyms": [
                        "immortal"
                    ],
                    "common_phrases": [
                        "mere mortal",
                        "lesser mortal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, подверженный смерти, часто противопоставляемый богам или духам.",
                        "zh": "注定会死亡的人类，常与神灵或精灵相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертный",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凡人",
                                "target_lang_sense_clarification": "指普通人类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3474e078-c74e-306f-8538-3e1918ddf330",
                    "sense_definition": "Extremely or excessively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>mortal</w> cold outside when we left the house.",
                            "target_lang_translations": {
                                "ru": "На улице было <w>смертельно</w> холодно, когда мы вышли из дома.",
                                "zh": "我们离开家时，外面<w>极其</w>寒冷。"
                            }
                        },
                        {
                            "text": "The work was <w>mortal</w> hard, but we finished it before sunset.",
                            "target_lang_translations": {
                                "ru": "Работа была <w>смертельно</w> тяжелой, но мы закончили ее до заката.",
                                "zh": "这项工作<w>极其</w>艰苦，但我们在日落前完成了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно или чрезмерно.",
                        "zh": "极其或过度地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смертельно",
                                "target_lang_sense_clarification": "крайне, очень"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "разговорное усиление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "程度副词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}