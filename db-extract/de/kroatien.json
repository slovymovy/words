                "translations": [
                    {
                        "translation_id": "4d362fb2-0690-4fae-96fc-de5dd84bfc84",
                        "source_entry_id": "3b33ec8a-f274-3fa0-b8cd-66457c8cde00",
                        "source_sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
