                "entry_id": "77030c38-be70-3651-9119-945e3a03bb5c",
                "word": "quatuor",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df71b29b-0786-4a91-96ca-f26fae83a5d4",
                        "entry_id": "77030c38-be70-3651-9119-945e3a03bb5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "quatuors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87bbb739-ea78-34b8-9c77-2d4286a74b07",
                        "entry_id": "77030c38-be70-3651-9119-945e3a03bb5c",
                        "glosses": [
                            "Morceau de musique vocale ou instrumentale qui est à quatre parties, parfois quartette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e2087a-19f6-42d7-9b1e-cc5fc59aadea",
                                "sense_id": "87bbb739-ea78-34b8-9c77-2d4286a74b07",
                                "text": "Exécuter un quatuor."
                            },
                            {
                                "example_id": "0f875564-98d9-4878-b025-b53de6df1cf1",
                                "sense_id": "87bbb739-ea78-34b8-9c77-2d4286a74b07",
                                "text": "Les quatuors de Beethoven."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f15f939-fd5b-35f1-a0cb-04d2b14d3712",
                        "entry_id": "77030c38-be70-3651-9119-945e3a03bb5c",
                        "glosses": [
                            "Ensemble des quatre chanteurs ou instrumentistes qui jouent les différentes parties d’un même morceau ; appelé quartette dans la musique de jazz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00052a6b-e996-4138-8471-2fd868ee44d7",
                                "sense_id": "2f15f939-fd5b-35f1-a0cb-04d2b14d3712",
                                "text": "Quatuor vocal."
                            },
                            {
                                "example_id": "9dcd584f-48bc-4400-a512-b1735fb81fb3",
                                "sense_id": "2f15f939-fd5b-35f1-a0cb-04d2b14d3712",
                                "text": "Quatuor à cordes."
                            },
                            {
                                "example_id": "ee68f02e-33fc-44c9-b301-1bbd093a59d7",
                                "sense_id": "2f15f939-fd5b-35f1-a0cb-04d2b14d3712",
                                "text": "On ne peut pas, sans blesser les lois de l’harmonie, introduire un cinquième exécutant dans un quatuor ; autrement ça cesse d’être quatuor."
                            },
                            {
                                "example_id": "4ef030f8-7ccf-428f-8b07-2c14543d6303",
                                "sense_id": "2f15f939-fd5b-35f1-a0cb-04d2b14d3712",
                                "text": "Le quatuor à cordes européen.\nQuatre hommes en noir, avec des nœuds papillons autour du cou, s’échinent sur des arcs en bois, avec des crins de cheval, sur des boyaux de mouton."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                        "entry_id": "77030c38-be70-3651-9119-945e3a03bb5c",
                        "glosses": [
                            "Ensemble de quatre personnes, voire de quatre choses."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f9320c36-eee4-4ae6-b693-393bcd777c54",
                                "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                                "text": "Le quatuor, c’est une bonne formation pour orchestre, mais pour un braquage, c’est un peu trop."
                            },
                            {
                                "example_id": "6d6b3a6a-5d7c-48a4-bc67-d81cd5e4f68c",
                                "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                                "text": "Le charme du film vient de ce quatuor de « bras-cassés », de branquignols pas très brillants mais sympathiques et finalement débrouillards et attachants."
                            },
                            {
                                "example_id": "8e176843-b605-4467-a23a-a0bedf71f3f7",
                                "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                                "text": "Le plus burlesque et le plus déjanté des quatuors de music-hall débarque avec la ferme intention de vous présenter des numéros de haute voltige."
                            },
                            {
                                "example_id": "be467743-2c4a-4b48-a416-0e0371557aef",
                                "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                                "text": "Hamelin, Pascal Dion, Steve Dubois et Jordan Pierre-Gilles formaient le quatuor canadien en finale qui a devancé la Corée et la Hongrie."
                            },
                            {
                                "example_id": "5563986f-aae8-4a1d-bf35-f8ed0916a33b",
                                "sense_id": "6f9e57db-eac5-3d9b-ade6-1ba2c3b31be2",
                                "text": "Le quatuor fila à travers les jardins."
                            }
                        ]
                    }
                ],
