                "senses": [
                    {
                        "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                        "entry_id": "3016aa50-dca1-3e48-8349-47fcc454f1af",
                        "glosses": [
                            "een ophoping van pus in het lichaam, daarbij een onnatuurlijke holte vormend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ce1108-bde4-4e3a-8ecf-049c817cf2d7",
                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                "text": "Als je door een lokale ontsteking niet meer kunt slapen is er meestal sprake van een abces."
                            },
                            {
                                "example_id": "3e1c441b-4375-4413-970d-48ff882bc6a4",
                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                "text": "Als een abces doorbreekt is de pijn meestal direct verdwenen."
                            },
                            {
                                "example_id": "3337581c-4a17-4315-891e-e214e17c28d5",
                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                "text": "De behandeling van een abces is incisie en drainage."
                            },
                            {
                                "example_id": "920eb99a-7376-4cb3-a6c8-28f98b94c814",
                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                "text": "Jonge zeehonden: Ollie en Brandy zijn allebei nog jonge zeehonden. Ollie werd half januari gevonden op Schiermonnikoog, pas tien dagen oud, met een abces op zijn rug. Brandy kwam begin maart van Terschelling, met diepe wonden aan zijn flippers. Beiden waren na weken van verzorging gisteren weer fit genoeg om terug te keren naar zee. Ze werden uit hun bassin in Pieterburen gehaald, in kisten gedaan en naar Lauwersoog vervoerd. Vanaf daar voeren ze met de boot naar een zandplaat bij Schiermonnikoog."
                            }
                        ]
                    }
                ],
