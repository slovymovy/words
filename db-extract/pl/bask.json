                        "entry_id": "52eb2e02-6f3e-3e5c-b8e9-e3b378516eb1",
                        "glosses": [
                            "członek narodu zamieszkującego tereny na granicy Hiszpanii i Francji nad Zatoką Biskajską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56e3324-26ed-4f92-a851-bfcc1c5352cd",
                                "sense_id": "03367d05-6251-397d-acd2-4f6cf833d01a",
                                "text": "i jego szczególna unikatowość sprawiają, że Basków przedstawia się jako lud oryginalny, prawdopodobnie najstarszy współcześnie żyjący lud europejski, a niekiedy nawet jako „aborygenów półwyspu”"
                            },
                            {
                                "example_id": "3d179def-ba9a-4f89-a0f4-e38365e98369",
                                "sense_id": "03367d05-6251-397d-acd2-4f6cf833d01a",
                                "text": "Ze Szwajcarem Ciriaco Sforzą również w Bayernie są spore kłopoty natury wychowawczej, krewki charakter ma też francuski Bask, Bixente Lizarazu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
