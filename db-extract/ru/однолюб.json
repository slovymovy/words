                ],
                "senses": [
                    {
                        "sense_id": "45d6e619-10f6-3218-8be1-3ba29c281b7c",
                        "entry_id": "9239c93e-242c-3959-98f6-5d7ba29e2dfd",
                        "glosses": [
                            "мужчина, который всю жизнь любит только одну женщину"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f065c514-e2a5-4901-8432-ced3e269cb72",
                                "sense_id": "45d6e619-10f6-3218-8be1-3ba29c281b7c",
                                "text": "Есть однолюбы: влюбившись один раз, они до конца пронесут своё чувство к раз и навсегда выбранной спутнице жизни."
                            }
                        ]
                    },
                    {
                        "sense_id": "11850b43-63fd-39de-8280-fcb534de3355",
                        "entry_id": "9239c93e-242c-3959-98f6-5d7ba29e2dfd",
                        "glosses": [
                            "человек, постоянный в своих интересах, склонностях, привязанностях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c137c1-dd6a-43b0-93f0-9f21d9c9e737",
                                "sense_id": "11850b43-63fd-39de-8280-fcb534de3355",
                                "text": "Мне очень хотелось показать, что у меня есть твёрдость характера и сила воли, что я однолюб и моя любовь ― это химия…"
                            },
                            {
                                "example_id": "107849f4-3f91-49c8-a24a-df7d29e18f0b",
                                "sense_id": "11850b43-63fd-39de-8280-fcb534de3355",
                                "text": "Вихорев ― однолюб, из всех времён года он любит осень."
                            }
                        ]
                    }
                ],
