                "senses": [
                    {
                        "sense_id": "bc3629d9-1d41-3a85-94e1-976fbce2e9c5",
                        "entry_id": "98a680c6-0ca7-3554-9091-0a4f33adc95a",
                        "glosses": [
                            "A mental or physical effort to attain a specific goal; a striving."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "06648cb1-19dc-4943-8676-46a5d4ba2cb7",
                                "sense_id": "bc3629d9-1d41-3a85-94e1-976fbce2e9c5",
                                "text": "The godly personality of a higher order, as the telos of the nisus of moral categoriality, is the sensus plenior of the nisus to a universal communalization of perspectives."
                            },
                            {
                                "example_id": "f66d71d2-b036-4f31-9b1f-bc81dab623bf",
                                "sense_id": "bc3629d9-1d41-3a85-94e1-976fbce2e9c5",
                                "text": "The immanent nisus to completion, therefore, drives the complex to the explication of its internal relations so that they become recognizable as such."
                            }
                        ]
                    },
                    {
                        "sense_id": "1274deef-42bf-34d4-aa12-beb3a2df72df",
                        "entry_id": "98a680c6-0ca7-3554-9091-0a4f33adc95a",
                        "glosses": [
                            "The periodic procreative desire manifested in the spring by birds, etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2157ca15-bfcc-3cbd-b16e-5f0cb7207a69",
                        "entry_id": "98a680c6-0ca7-3554-9091-0a4f33adc95a",
                        "glosses": [
                            "The contraction of the diaphragm and abdominal muscles to evacuate faeces or urine."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f04c7388-a509-42c5-aa3d-a90d9db6617a",
                                "sense_id": "2157ca15-bfcc-3cbd-b16e-5f0cb7207a69",
                                "text": "1833, James O' Beirne, New Views on the Process of Defecation, and Their Application to the Pathology and Treatment of Diseases of the Stomach, Bowels, and Other Organs, quoted in 1833, John Johnson (editor), The Medico-Chirurgical Review, New Series: Volume 19 (Volume 23 of the Analytical Series), page 7,\nThe evacuation of the rectum and bladder being completed, immediately the nisus ceases, the rectum and the sphincters return to their former state of contraction, the diaphragm reascends, carrying with it and restoring to their proper situations the liver, the stomach, the spleen, the small intestines, the cæcum, and the ascending, transverse and descending portions of the colon."
                            }
                        ]
                    }
