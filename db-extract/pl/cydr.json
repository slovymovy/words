                        "translation_id": "05cd2b38-20e7-4681-82e2-0da4526d81f0",
                        "source_entry_id": "88cb40d5-053c-3424-ad54-8789016903ff",
                        "source_sense_id": "29db1bd2-0f0e-34c5-84b4-6b84be71e1d1",
                        "target_lang_word": "Apfelwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3a008b-e7f0-3a92-8f35-44c11fa92abc",
                                        "entry_id": "a8641476-4b3a-3480-9a33-b22de576d98b",
                                        "glosses": [
                                            "aus vergorenen Äpfeln hergestellter Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c098e3de-355c-4790-97eb-812fc2e0ff0d",
                                                "sense_id": "aa3a008b-e7f0-3a92-8f35-44c11fa92abc",
                                                "text": "„Er wollte noch weiter sprechen, aber im selben Augenblicke kam Lene mit einem Kaffeebrett zurück, auf dem eine Karaffe mit Wasser samt Apfelwein stand, Apfelwein, für den der Baron, weil er ihm wunderbare Heilkraft zuschrieb, eine sonst schwer begreifliche Vorliebe hatte.“"
                                            },
                                            {
                                                "example_id": "3d2d37bc-97ed-47d7-ab64-118400e24381",
                                                "sense_id": "aa3a008b-e7f0-3a92-8f35-44c11fa92abc",
                                                "text": "„Wenn man Fotografien der oft dunkel getäfelten Gasträume sieht, dann wirkt zwar alles friedlich und still, scheinbar ruhige Menschen sitzen bewegungslos auf der Bank, und der Apfelwein leuchtet golden in seinem Glas.“"
                                            },
                                            {
                                                "example_id": "755e0ddd-46e0-4974-bf10-5ecc63962cd9",
                                                "sense_id": "aa3a008b-e7f0-3a92-8f35-44c11fa92abc",
                                                "text": "„Sie sahen sich einige Sehenswürdigkeiten an, probierten in einem Gasthaus den berühmten säuerlichen Apfelwein und fuhren danach zum Tierpark, den Laura Leonore unbedingt besuchen wollte.“"
                                            },
                                            {
                                                "example_id": "f1d1fdb3-1543-4867-9ba7-5dac235600e4",
                                                "sense_id": "aa3a008b-e7f0-3a92-8f35-44c11fa92abc",
                                                "text": "„Er stellte Bier her aus den Blättern des Gamander und gab es den Erntearbeitern anstelle von Apfelwein zu trinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19916730-8ab9-4d10-9d1f-99802f543649",
                        "source_entry_id": "88cb40d5-053c-3424-ad54-8789016903ff",
                        "source_sense_id": "29db1bd2-0f0e-34c5-84b4-6b84be71e1d1",
                        "target_lang_word": "сидр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сидр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "465f1909-35bf-3508-a311-0e51a37adacf",
                                        "entry_id": "4cbbdc6a-a149-358c-820a-e9136d4e0fe6",
                                        "glosses": [
                                            "редк. нефильтрованный яблочный сок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3e9fd5-46e8-42b5-8a9a-c23f11fd6ffd",
                                                "sense_id": "465f1909-35bf-3508-a311-0e51a37adacf",
                                                "text": "Интересно, что в США и в некоторых провинциях Канады сидром называют обычный свежевыжатый яблочный сок, а соответствующий алкогольный именуют «крепким сидром» (hard cider)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8244472f-a256-33ec-b9c5-fe028a37dfa0",
                                        "entry_id": "4cbbdc6a-a149-358c-820a-e9136d4e0fe6",
                                        "glosses": [
                                            "лёгкое плодово-ягодное вино"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3eb6a7d-5399-4665-b0c1-c9da7a928a60",
                                                "sense_id": "8244472f-a256-33ec-b9c5-fe028a37dfa0",
                                                "text": "Чего не скажешь о некоторых странах Европы, где непрерывная нить традиций приготовления сидра ― а именно такое название получило «яблочное вино» ― тянется из глубины веков к современности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
