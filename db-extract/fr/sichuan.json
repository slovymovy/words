        "fr-extract.jsonl": [
            {
                "entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                "word": "Sichuan",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b7d5af7-56ad-4b61-8119-9a8f81bb9f73",
                        "entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                        "tags": [
                            "Critiqué"
                        ],
                        "form": "Sechuan"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                        "entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                        "glosses": [
                            "Province du sud-ouest de la Chine, dont le chef-lieu est Chengdu, et qui, historiquement, comprenait aussi la ville de Chongqing."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "c96a0c8b-e566-4dec-9f24-d4294aa141bb",
                                "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                                "text": "Du groupe des langues lolo, apparentées au birman, relèvent celles parlées par les Yi du Sichuan et du Yunnan."
                            },
                            {
                                "example_id": "b09be899-ba9d-4345-b82d-5b50d2ce214a",
                                "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                                "text": "Le Sichuan, très montagneux et connu dans le monde entier pour ses réserves de pandas, est généralement frappé plusieurs fois par mois par des séismes d’intensités variables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cd2ca34-c16e-448c-a18b-5eb53c69a82e",
                        "source_entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                        "source_sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                        "target_lang_word": "Sichuan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sichuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                        "entry_id": "58a5bb9a-fc91-39b5-bd52-a6170706d5a2",
                                        "glosses": [
                                            "A province in central China. Capital: Chengdu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3c41f6-7715-4952-a236-4a481698c39d",
                                                "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                                "text": "In Suchue, on Mount Tiexe, the ſtones that grow there being burnt in the fire, drop Iron, which is very fit for the making Swords."
                                            },
                                            {
                                                "example_id": "bcb929fa-fdfd-459f-af45-870f252a36f0",
                                                "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                                "text": "SUchuen, which ſignifies Four Waters, is a great Countrey, ſeparated by the River Kiang, into a Northern and Southern part ; Bordering in the Eaſt upon Huquang ; in the South-Eaſt upon Queicheu ; and hath in the North-Eaſt and North Xenſi ; in the North-Weſt, the People Koningguangi and Kiang ; or the Countreys which Paulus Venetus makes to be Preſter John's, which the Chineſes by one general Name call'd Sifan ; and in the Weſt, Tibet, and the moſt Southern part of the Province of Junnan."
                                            },
                                            {
                                                "example_id": "a8d3e4d0-14bd-4b56-8f42-e6cba3a7dc31",
                                                "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                                "text": "Such was the argument of three highly placed gentlemen of Hubei, graduates of the Japanese military academy and losers in Hubei’s internal conflicts who appeared in Changsha in early 1921. It was also the argument of Xiong Ke-wu, a former military governor of Sichuan whose June visit was concealed behind layers of lies and half truths (he said he was in Changsha to study self-government; gossips in the know said that he was secretly a spokesman for Wang Zhan-yuan)."
                                            },
                                            {
                                                "example_id": "fc54edca-e963-45f4-b788-a5366fda4b04",
                                                "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                                "text": "China’s agriculture ministry said on Wednesday two new African swine fever outbreaks were confirmed in Sichuan and Qinghai provinces.\nThe new case in the city of Bazhong in Sichuan killed 19 of 117 pigs present on a farm, the Ministry of Agriculture and Rural Affairs said in a statement on its website."
                                            },
                                            {
                                                "example_id": "00304146-0c54-4093-8ec8-7c38ec896af6",
                                                "sense_id": "b1faf3ec-ed7a-312c-889a-748eeab9764f",
                                                "text": "About 80 percent of wild giant pandas live in Sichuan province. The rest are in Gansu and Shaanxi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3d6b2a5-bdff-4488-acf3-440241e463a8",
                        "source_entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                        "source_sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                        "target_lang_word": "Szechuan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Szechuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                        "entry_id": "ef252436-9f33-37fc-8ac3-b29629b77c97",
                                        "glosses": [
                                            "Alternative form of Sichuan."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e985958d-bc7b-45fe-9fe1-895fcc1cce1c",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "THE plain of Chengtu is the only large expanse of level ground in the great province of Szechuan; it is also one of the richest, most fertile, and thickly populated areas in the whole of China."
                                            },
                                            {
                                                "example_id": "ce7f9d93-f3fc-4988-b628-9ad2a6a3afdd",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "There is a portrait of Confucius at Ch’ü-fu attributed to Wu and another striking picture representing the struggle of a tortoise with a serpent, kuei she t’u, which is in the Prefect's official residence at Ch’êng-tu, Sze-ch’uan."
                                            },
                                            {
                                                "example_id": "3c4a7de1-bc7c-41f7-add9-7a4c9bb57546",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "Li Po is also the author of this poem. Pai-ti is on a mountain in eastern Feng-chieh county in Szechuan Province."
                                            },
                                            {
                                                "example_id": "41044657-b1a9-4cba-80e5-50c5e98c763b",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "The highway is one that was built to enable the Chiang Kai-shek government to evacuate to Chungking in the War of Resistance days, and Huayuan, our objective, is a county town in the middle of a high mountain plateau, only 25 kilometres from the Szechuan border.",
                                                "translation": "Travels in China, 1966-71",
                                                "english": "Travels in China, 1966-71"
                                            },
                                            {
                                                "example_id": "585b65e9-b7ba-4dec-9548-622f5e0a287d",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "In far-off southern Szechuan province last summer, while helping the peasants to effect the land reform, I saw group after group of young peasants, men and women, volunteer to help the aggressors away from our border and help neighboring Korea."
                                            },
                                            {
                                                "example_id": "fb19de15-c95c-444b-a89a-dfbcbcdbe4ef",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "Szechuan Province in southeastern China is well endowed with natural resources, fine landscapes and a long rich history. In early times, the several states which made Szechuan their home produced a line of famous generals whose lives have become the subject of myth, literary works and operas. Szechuan opera is one of the most classical of all Chinese opera styles."
                                            },
                                            {
                                                "example_id": "f3751e55-d32f-41b9-b6c5-dd0e49325fd8",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "But long before that, Parisians will have had ample chance to familiarize themselves with Chinese culture. From Oct. 14 to Jan. 28, the Hôtel de Ville,[…]showcases recent Bronze Age excavations in the Szechuan Province, in western China, including artifacts from the Jinsha site (1200-1000 B.C.) discovered in February 2001."
                                            },
                                            {
                                                "example_id": "831e086d-9a31-4d0a-a1da-108449ab45ad",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "This gargantuan population and the city’s strategic importance led to Chongqing’s separation from its parent province, Szechuan, in 1997, and it was designated as a “specially administered municipality,” controlled directly by the central government."
                                            },
                                            {
                                                "example_id": "0939687d-fa2d-4ead-b6c5-d4baff778567",
                                                "sense_id": "ebc8f5a9-6598-3478-bf09-a5c59552a31f",
                                                "text": "Despite this aerial assistance, the Chinese were again forced to withdraw westward, this time to Chongqing in the mountains of Szechuan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27e9b233-c30b-468b-9890-8d5d2461ab8b",
                        "source_entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
