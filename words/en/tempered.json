{
    "word_family": [
        "temper",
        "temperance",
        "temperate",
        "temperature"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "228bf589-fdea-365d-b3f2-ad6fb735e3fc",
                    "sense_definition": "Moderated or balanced by other considerations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moderated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His enthusiasm was <w>tempered</w> by the realization of the immense work ahead.",
                            "target_lang_translations": {
                                "tr": "Coşkusu, önündeki devasa işin farkına varmasıyla <w>yumuşadı</w>."
                            }
                        },
                        {
                            "text": "The harsh criticism was <w>tempered</w> by a <w>moderate</w> tone.",
                            "target_lang_translations": {
                                "tr": "Sert eleştiri, <w>ılımlı</w> bir tonla <w>yumuşatıldı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moderate",
                        "temperate",
                        "measured"
                    ],
                    "antonyms": [
                        "untempered"
                    ],
                    "common_phrases": [
                        "tempered by reflection",
                        "tempered by experience"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başka etkenlerle dengelenmiş, yumuşatılmış veya ölçülü hale getirilmiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dengelenmiş",
                                "target_lang_sense_clarification": "Bir durumun aşırılığının başka bir etkenle azaltılması."
                            },
                            {
                                "target_lang_word": "yumuşatılmış",
                                "target_lang_sense_clarification": "Sert bir ifadenin veya duygunun daha ılımlı hale getirilmesi."
                            },
                            {
                                "target_lang_word": "ölçülü",
                                "target_lang_sense_clarification": "Aşırıya kaçmayan, kontrollü."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10d1a0c8-3ec5-3987-9e01-57944f25c5bf",
                    "sense_definition": "Having a specified disposition or temper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>even-tempered</w> teacher remained calm despite the noisy classroom.",
                            "target_lang_translations": {
                                "tr": "<w>Sakin huylu</w> öğretmen, gürültülü sınıfa rağmen soğukkanlılığını korudu."
                            }
                        },
                        {
                            "text": "She is a sweet-tempered person who always helps others.",
                            "target_lang_translations": {
                                "tr": "O, her zaman başkalarına yardım eden <w>tatlı dilli</w> biridir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "even-tempered",
                        "sweet-tempered"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir mizaç veya huy sahibi olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "huylu",
                                "target_lang_sense_clarification": "Belirli bir mizaç yapısına sahip olma durumu."
                            },
                            {
                                "target_lang_word": "mizaçlı",
                                "target_lang_sense_clarification": "Kişilik yapısını tanımlayan sıfatlar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "003f429f-cb16-38c0-bf6f-3b8987322c00",
                    "sense_definition": "Pertaining to the metallurgical process for finishing metals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tempered</w> steel blade was incredibly strong and durable.",
                            "target_lang_translations": {
                                "tr": "<w>Su verilmiş</w> çelik bıçak inanılmaz derecede güçlü ve dayanıklıydı."
                            }
                        },
                        {
                            "text": "Blacksmiths use heat to create <w>tempered</w> metal tools.",
                            "target_lang_translations": {
                                "tr": "Demirciler, <w>tavlanmış</w> metal aletler yapmak için ısı kullanırlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Metallerin dayanıklılığını artırmak için uygulanan ısıl işlem süreci."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "su verilmiş",
                                "target_lang_sense_clarification": "Metalurjide çeliğin sertleştirilmesi işlemi."
                            },
                            {
                                "target_lang_word": "tavlanmış",
                                "target_lang_sense_clarification": "Isıl işlem görmüş metal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb08844-d939-3cdd-88cd-37a372ab0fd2",
                    "sense_definition": "Pertaining to the industrial process for toughening glass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shower door is made of <w>tempered</w> glass for safety.",
                            "target_lang_translations": {
                                "tr": "Duş kapısı güvenlik için <w>temperli</w> camdan yapılmıştır."
                            }
                        },
                        {
                            "text": "Modern skyscrapers use <w>tempered</w> glass to withstand high winds.",
                            "target_lang_translations": {
                                "tr": "Modern gökdelenler, şiddetli rüzgarlara dayanmak için <w>temperli</w> cam kullanır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Camın dayanıklılığını artırmak için uygulanan endüstriyel işlem."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "temperli",
                                "target_lang_sense_clarification": "Isıl işlemle güçlendirilmiş cam."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc77a374-ed57-3e86-9b6c-245e0ff77fd6",
                    "sense_definition": "Pertaining to a musical tuning system that allows playing in any key.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piano is tuned using a <w>tempered</w> scale.",
                            "target_lang_translations": {
                                "tr": "Piyano, <w>tamperli</w> bir dizi kullanılarak akort edilir."
                            }
                        },
                        {
                            "text": "Bach wrote music specifically for the well-tempered keyboard.",
                            "target_lang_translations": {
                                "tr": "Bach, müziği özellikle iyi <w>tamperli</w> klavye için yazmıştır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "well-tempered scale"
                    ],
                    "target_lang_definitions": {
                        "tr": "Müzikte her tonda çalmaya olanak tanıyan akort sistemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tamperli",
                                "target_lang_sense_clarification": "Müzik teorisinde akort sistemi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be1932f3-c1aa-329e-8bbc-3d54bbc75a4a",
                    "sense_definition": "Simple past and past participle of <w>temper</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>tempered</w> his anger before speaking to the group.",
                            "target_lang_translations": {
                                "tr": "Gruba konuşmadan önce öfkesini <w>yatıştırdı</w>."
                            }
                        },
                        {
                            "text": "The steel was <w>tempered</w> to increase its hardness.",
                            "target_lang_translations": {
                                "tr": "Çeliğe, sertliğini artırmak için <w>su verildi</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Temper fiilinin geçmiş zaman veya ortaç hali; yumuşatmak, dengelemek veya sertleştirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yumuşattı",
                                "target_lang_sense_clarification": "Duygusal veya davranışsal bir durumu hafifletmek."
                            },
                            {
                                "target_lang_word": "su verdi",
                                "target_lang_sense_clarification": "Metali ısıl işlemle sertleştirmek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}