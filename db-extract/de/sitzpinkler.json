                        "examples": [
                            {
                                "example_id": "fbd8346d-fb91-4753-9b74-cb91759bfef1",
                                "sense_id": "e4718dac-84ba-3506-b349-a061fd168f8c",
                                "text": "Ich pinkle doch nicht im Stehen! Ich bin Sitzpinkler."
                            }
                        ],
                        "sense_index_json": "\"1\""
