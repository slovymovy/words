                    {
                        "sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                        "entry_id": "5735c4cc-c415-3385-8936-d22d105469e7",
                        "glosses": [
                            "Unterschied zwischen Hoch- und Niedrigwasser bei den Gezeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e510000-d886-4549-b6ae-79b831a91a1c",
                                "sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                                "text": "Der Tidenhub ist in England höher als im deutschen Wattenmeer."
                            },
                            {
                                "example_id": "d37cd3ec-e714-4394-bb22-133cb7e989ec",
                                "sense_id": "b99fda74-6663-3973-b68f-e4ffda310faf",
                                "text": "„In den Fjordarmen hing oft dichter Nebel, und der Tidenhub betrug bis zu 16 Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
