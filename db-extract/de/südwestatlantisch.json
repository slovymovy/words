                        "form": "sie sind südwestatlantisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c016eb45-1438-3e39-acae-20af4f60eb66",
                        "entry_id": "a239830d-369f-3dd4-8344-ffa034b77599",
                        "glosses": [
                            "den südwestlichen Teil des Atlantischen Ozeans betreffend"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0b855683-d00e-4768-b5af-122785d5f855",
                                "sense_id": "c016eb45-1438-3e39-acae-20af4f60eb66",
                                "text": "„Etwas Licht kommt in die Sache, wenn man die Strömungsverhältnisse des südwestatlantischen Ozeans in Betracht zieht.“"
                            },
                            {
                                "example_id": "cacf5783-5440-4a23-bd1a-ee6842138d80",
                                "sense_id": "c016eb45-1438-3e39-acae-20af4f60eb66",
                                "text": "„Die auf der Rückreise des ersteren Schiffs durch den südwestatlantischen Ocean angestellten Beobachtungen konnten leider noch nicht benutzt werden.“"
                            },
                            {
                                "example_id": "19ac74c0-b118-46a6-a37d-f01e6c449976",
                                "sense_id": "c016eb45-1438-3e39-acae-20af4f60eb66",
                                "text": "„Nur in dem südwestatlantischen Gebiet finden sich mehrere Abweichungen.“"
                            },
                            {
                                "example_id": "fc0e2f08-eac8-462f-8e07-db293853926d",
                                "sense_id": "c016eb45-1438-3e39-acae-20af4f60eb66",
                                "text": "„Daher geben seine Karten eine viel zu geringe Bewölkung für die höheren Breiten des südwestatlantischen Ozeans, der unrichtiger Weise viel heiterer als der Nordatlantische erscheint.“"
                            },
                            {
                                "example_id": "1aecbc21-4e83-40a2-a629-3b92300a944b",
