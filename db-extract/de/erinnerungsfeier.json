                "senses": [
                    {
                        "sense_id": "a1782bb4-13fe-35ae-a4ca-a3e650ce7103",
                        "entry_id": "71342900-2b2c-3910-8d67-e0753e5c29fa",
                        "glosses": [
                            "Festlichkeit als Erinnerung an jemanden oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a904c548-60c1-4843-be45-d432053666c2",
                                "sense_id": "a1782bb4-13fe-35ae-a4ca-a3e650ce7103",
                                "text": "„Aus Anlass der Erinnerungsfeier des dritten Garderegiments zu Fuß an den Sturm auf St. Privat im deutsch-französischen Krieg von 1870 hält Wilhelm II. eine Rede, die voller Siegesgewißheit ist: \"Unsere Lage ist eine günstige, obwohl wir, das dürfen wir ruhig gestehen, in der letzten Zeit auch einen Misserfolg erlitten haben. Der Erfolg ist mit uns…\"“"
                            },
                            {
                                "example_id": "0d739994-d97a-475c-a47d-36b4847d7608",
                                "sense_id": "a1782bb4-13fe-35ae-a4ca-a3e650ce7103",
                                "text": "„Unter einem Jubiläum […] versteht man eine Erinnerungsfeier bei der Wiederkehr eines besonderen Datums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
