                                    {
                                        "sense_id": "26d98dbf-91b5-30b2-a2ea-0811a201e8c0",
                                        "entry_id": "264a5a42-de40-3299-a87d-3bf3eeebd91f",
                                        "glosses": [
                                            "ein starkes Verlangen nach Genussmitteln habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1c1032-3a31-4c99-ad46-23d886178ac8",
                                                "sense_id": "26d98dbf-91b5-30b2-a2ea-0811a201e8c0",
                                                "text": "Die genusssüchtige Gesellschaft von heute kann sich ein Leben wie nach dem Krieg meist überhaupt nicht vorstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
