                        "glosses": [
                            "Mouvement artistique né au Royaume-Uni au milieu du XIXe siècle qui tient la peinture des primitifs italiens, prédécesseurs de Raphaël, comme le modèle à imiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea20c715-6ea5-40ca-9757-77889e04471a",
                                "sense_id": "3d2f72f4-f57d-3691-8484-d55f72668db7",
                                "text": "Cet art précieux qui fut baptisé préraphaélisme, sous prétexte que l’art devait chercher sa tradition avant l’époque de Raphaël, chez les maîtres du XVe siècle."
                            }
                        ]
                    }
                ],
