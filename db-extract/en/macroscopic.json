                        "glosses": [
                            "Visible to the unassisted eye."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca2b2566-5c41-4067-9d16-9025b7cd2ee3",
                                "sense_id": "79991d21-d89d-3552-94f7-d2d8bd472a63",
                                "text": "The direct, evident, and macroscopic effects of freezing on foods are the phase transition of liquid components, which crystallize and solidify."
                            }
                        ]
                    },
                    {
                        "sense_id": "229fe7c9-10e4-3b09-b7da-11babf729b76",
                        "entry_id": "f7ca5b14-10be-31a3-a6c0-804e615eb21d",
                        "glosses": [
                            "Having an appreciable mass."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfcaffc2-b7f7-4daa-9283-ae0dc4c61f27",
                                "sense_id": "229fe7c9-10e4-3b09-b7da-11babf729b76",
                                "text": "...it appears to be a small step from (1) and (2) to the identification of a sufficiently large mass with a macroscopic mass and, by analogy, to the consideration as macroscopic any system having sufficiently large quantum numbers associated with it..."
                            }
                        ]
