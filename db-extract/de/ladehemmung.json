                "senses": [
                    {
                        "sense_id": "75ec7189-668e-3798-8bde-91b2c85b48e6",
                        "entry_id": "d76fa436-0b57-3a34-8a56-a603550bbeaf",
                        "glosses": [
                            "Defekt beim Abfeuern einer Schusswaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b4b2f9-b5ea-43ab-be66-32e5fc65ceab",
                                "sense_id": "75ec7189-668e-3798-8bde-91b2c85b48e6",
                                "text": "„Schließlich kosten auch Fehlzündungen und Ladehemmungen wertvolle Sekunden.“"
                            },
                            {
                                "example_id": "fd91cb9f-8ede-4b0a-85b9-843f02cfeb9e",
                                "sense_id": "75ec7189-668e-3798-8bde-91b2c85b48e6",
                                "text": "„Während der Ausbildung an den neuen Waffen sei es vermehrt zu Ladehemmungen gekommen, hieß es.“"
                            },
                            {
                                "example_id": "ece905f7-0c90-4121-a92b-41670511570b",
                                "sense_id": "75ec7189-668e-3798-8bde-91b2c85b48e6",
                                "text": "„Als in einer Schießübung bei einem Afghanen eine Ladehemmung auftrat, da habe der Soldat die Störung durch kräftiges Schlagen des Gewehrs gegen den nächsten Baum zu beheben versucht - die Mündung in Richtung der nahen Kameraden schlenkernd.“"
                            },
                            {
                                "example_id": "39c2f210-3050-48e8-bc7a-e8b8dc2a8131",
                                "sense_id": "75ec7189-668e-3798-8bde-91b2c85b48e6",
                                "text": "„Es ist die zivile Variante des Sturmgewehrs M16, das im Vietnamkrieg für Aufsehen sorgte, wegen seines ungewohnten Aussehens und zunächst auch wegen seiner berüchtigten Ladehemmungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
