                        "entry_id": "da7a028b-42c1-314a-9126-ae001413d77b",
                        "glosses": [
                            "Qui suborne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f7f9a78-52d0-4ea4-897d-5369d7fb40dd",
                                "sense_id": "87e4a1c9-fcc1-377e-96c9-c7a48e36e710",
                                "text": "Des discours, des conseils suborneurs."
                            },
                            {
                                "example_id": "22453cac-55b8-43fc-bacb-328444df54bd",
                                "sense_id": "87e4a1c9-fcc1-377e-96c9-c7a48e36e710",
                                "text": "Il ne fallait pas écouter ce juif suborneur mais rester dans les frais alpages et les verts bocages."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3c77cdcf-e533-387c-ad27-181d2ccd3f8e",
                "word": "suborneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f0d69ef2-8a5e-4a5b-87e4-0d1b3aa87e91",
                        "entry_id": "3c77cdcf-e533-387c-ad27-181d2ccd3f8e",
                        "tags": [
