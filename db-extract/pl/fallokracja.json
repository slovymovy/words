                                    {
                                        "sense_id": "b74d62b3-0250-3bdb-b1df-964248ec1863",
                                        "entry_id": "d2b2bd0f-780c-33b4-ba6b-2b0d4972bbb1",
                                        "glosses": [
                                            "A society or government of, or dominated by, men."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f994bf4-1b36-45ba-a748-6bd8cf2255b8",
                                                "sense_id": "b74d62b3-0250-3bdb-b1df-964248ec1863",
                                                "text": "Therefore, despite its political patriarchy, Athens cannot be considered—horrid word—a phallocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "841d2a5f-30b0-460d-bf46-94b4d5b9fcc5",
                        "source_entry_id": "368d760d-21f2-3542-8131-350d4757e778",
                        "source_sense_id": "b4b487c7-17a4-36b2-a78b-3c6d7d45c753",
