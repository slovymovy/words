                        "source_sense_id": "9308f146-ab56-3709-b257-7e03d4f3cbf6",
                        "target_lang_word": "connection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c86c3298-bbb4-39eb-9a64-9ed145d7528a",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "The act of connecting."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3f23d84-53a1-33ad-a807-5007bf47bd73",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "The point at which two or more things are connected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f50b529e-81cd-44a7-9b94-fb424e046123",
                                                "sense_id": "e3f23d84-53a1-33ad-a807-5007bf47bd73",
                                                "text": "the connection between overeating and obesity"
                                            },
                                            {
                                                "example_id": "81057806-54c9-4ddd-bb23-4ebc5c7666bb",
                                                "sense_id": "e3f23d84-53a1-33ad-a807-5007bf47bd73",
                                                "text": "My headache has no connection with me going out last night."
                                            },
                                            {
                                                "example_id": "983b37a1-c611-4a57-a2e7-03e6c7ff7427",
                                                "sense_id": "e3f23d84-53a1-33ad-a807-5007bf47bd73",
                                                "text": "A spokesman for Lothian and Borders Police said: \"We can confirm that a 15-year-old boy has been arrested and charged in connection with the murder of Jodi Jones. A 45-year-old has also been arrested in connection with allegations of attempting to pervert the course of justice. A report on this has been sent to the procurator fiscal.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a707e69-0b57-32f5-b623-41a8f41af56a",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A feeling of understanding and ease of communication between two or more people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f20398-d123-437d-a7d3-15f42dc56040",
                                                "sense_id": "3a707e69-0b57-32f5-b623-41a8f41af56a",
                                                "text": "As we were the only people in the room to laugh at the joke, I felt a connection between us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17bfa5fa-ba07-380c-8f00-623f0da1c005",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "An established communications or transportation link."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb8b2ac-3f45-4c10-b5df-a5a776fdd621",
                                                "sense_id": "17bfa5fa-ba07-380c-8f00-623f0da1c005",
                                                "text": "computers linked by a network connection"
                                            },
                                            {
                                                "example_id": "7056fb78-4725-4899-ad1b-fd90a60392dc",
                                                "sense_id": "17bfa5fa-ba07-380c-8f00-623f0da1c005",
                                                "text": "I was talking to him, but there was lightning and we lost the connection."
                                            },
                                            {
                                                "example_id": "a81e190f-b4c6-4497-9957-f239fafd1ea3",
                                                "sense_id": "17bfa5fa-ba07-380c-8f00-623f0da1c005",
                                                "text": "The Route 4 bus will arrive on 5th St. at Robinson Ave at 3:30. The northbound number 14 is scheduled to arrive on Robinson at 3:31. That means you have to run across the street once you arrive, it's a spot connection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59563fca-491d-3ba2-bb5a-332ec9916181",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A transfer from one transportation vehicle to another in scheduled transportation service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e92e9f-3729-42ca-93df-3703e83062c3",
                                                "sense_id": "59563fca-491d-3ba2-bb5a-332ec9916181",
                                                "text": "The bus was late so he missed his connection at Penn Station and had to wait six hours for the next train."
                                            },
                                            {
                                                "example_id": "7056431e-a001-4dcf-94c3-0fdff506f1bb",
                                                "sense_id": "59563fca-491d-3ba2-bb5a-332ec9916181",
                                                "text": "It is kept super-clean by helpful staff who still find the time to help customers with tight connections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "628c27a8-f909-3fac-943b-2d7815ef079e",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A kinship relationship between people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1fdc8ff-aaef-3eb6-b92f-f56bccb50fbf",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A person related to oneself, through either family or business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78d7e7db-9bc7-446c-8fbc-9d7d29c2b378",
                                                "sense_id": "b1fdc8ff-aaef-3eb6-b92f-f56bccb50fbf",
                                                "text": "I have some connections in Lancashire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0dae93-2b74-3e8f-8026-b8ea1e6ea76a",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A set of sets that contains the empty set, all one-element sets for any element that is included in any of the sets, and the union of any group of sets that are elements where the intersections of those sets is non-empty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aeafc87a-31c6-35d1-82f8-85b1084d1628",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "Coherence; lack of disjointedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d657f8b5-81b9-3cd0-b922-d34d0d5acca3",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A Methodist denomination as a whole, as opposed to its constituent churches, circuits, districts and conferences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83e73811-cde1-37aa-a17d-7648fd365f92",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c030adf5-279e-49ca-b7fe-3e91a8aa73f8",
                                                "sense_id": "83e73811-cde1-37aa-a17d-7648fd365f92",
                                                "text": "The exact nature of the relations between the boy-wife and his protector are doubtful; they certainly have connection, but the natives repudiate with horror and disgust the idea of sodomy."
                                            },
                                            {
                                                "example_id": "65fc266d-03ee-4e55-b82b-271cb70b879c",
                                                "sense_id": "83e73811-cde1-37aa-a17d-7648fd365f92",
                                                "text": "At the town of Mendes, in the principal temple, there was a living male goat, with which, if the statement of Herodotus is to be accepted, naked female worshippers actually had carnal intercourse. Male worshippers similarly had connexion with she-goats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5864bfe-e95b-361f-b403-43df0d717fc0",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e3eafd-9c4e-4667-a38a-4385c12ec183",
                                                "sense_id": "f5864bfe-e95b-361f-b403-43df0d717fc0",
                                                "text": "Now the final study was the drug habit. He was now in New Orleans, slipping along the streets with shady characters and haunting connection bars."
                                            }
                                        ]
                                    }
                                ]
