                        "entry_id": "0c674eda-d1fc-31ec-8c82-e59e7dcac0ed",
                        "glosses": [
                            "Ouvrière qui fabrique du béton, qui coule du béton."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                        "entry_id": "0c674eda-d1fc-31ec-8c82-e59e7dcac0ed",
                        "glosses": [
                            "Variante de bétonnière."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e2c87a6d-6623-49fe-9c5f-51197ee4fd6e",
                                "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                                "text": "Les dernières parcelles d’air immobile sont absorbées par la charge des machines du chantier, compresseuses, bétonneuses, défonceuses, scies mécaniques, mâchent et mastiquent l’air qui n’en peut plus."
                            },
                            {
                                "example_id": "6a2db928-a8d6-4495-b7c3-c6aa7a82f1b1",
                                "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                                "text": "Mais il y a pire… Si tu l’imaginais ! Les bétonneuses ! Ces cons-là se sont mis à voler des bétonneuses sur nos chantiers !"
                            }
                        ]
                    }
