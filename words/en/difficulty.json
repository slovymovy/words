{
    "word_family": [
        "difficult"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "286266fc-e894-3f22-9851-9da1bca781d7",
                    "sense_definition": "The state of being difficult, or hard to do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mom is old and has a lot of <w>difficulty</w> remembering all her grandchildren's names.",
                            "target_lang_translations": {
                                "ru": "Моя мама старенькая, и она с большим <w>трудом</w> вспоминает имена всех своих внуков.",
                                "zh": "我妈妈年纪大了，记所有孙辈的名字都很<w>费劲</w>。"
                            }
                        },
                        {
                            "text": "He learned to walk again with great <w>difficulty</w> after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии он с большим <w>трудом</w> заново научился ходить.",
                                "zh": "事故发生后，他<w>艰难</w>地重新学会了走路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble",
                        "struggle",
                        "effort"
                    ],
                    "antonyms": [
                        "ease"
                    ],
                    "common_phrases": [
                        "have difficulty",
                        "with difficulty",
                        "without difficulty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть трудным или тяжелым для выполнения; состояние, требующее усилий.",
                        "zh": "指做某事很困难或需要付出很大努力的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тру́дность",
                                "target_lang_sense_clarification": "свойство, тяжесть выполнения"
                            },
                            {
                                "target_lang_word": "сло́жность",
                                "target_lang_sense_clarification": "запутанность, непростое устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困难",
                                "target_lang_sense_clarification": "做某事费力"
                            },
                            {
                                "target_lang_word": "费劲",
                                "target_lang_sense_clarification": "形容需要耗费精力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79cce43b-aedc-3ff8-877b-1ceb522cd5cf",
                    "sense_definition": "An obstacle that hinders achievement of a goal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We faced a <w>difficulty</w> in trying to book a flight so late.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись с <w>трудностью</w> при попытке забронировать рейс так поздно.",
                                "zh": "这么晚才订机票，我们遇到了<w>困难</w>。"
                            }
                        },
                        {
                            "text": "The team overcame every <w>difficulty</w> to win the championship.",
                            "target_lang_translations": {
                                "ru": "Команда преодолела каждую <w>трудность</w>, чтобы выиграть чемпионат.",
                                "zh": "团队克服了重重<w>困难</w>，最终赢得了冠军。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble"
                    ],
                    "antonyms": [
                        "advantage",
                        "aid"
                    ],
                    "common_phrases": [
                        "technical difficulty",
                        "overcome a difficulty",
                        "face difficulties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствие или помеха, мешающая достижению цели.",
                        "zh": "阻碍目标实现的问题或障碍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тру́дность",
                                "target_lang_sense_clarification": "помеха, проблема"
                            },
                            {
                                "target_lang_word": "затрудне́ние",
                                "target_lang_sense_clarification": "препятствие, заминка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困难",
                                "target_lang_sense_clarification": "阻碍目标的障碍"
                            },
                            {
                                "target_lang_word": "难题",
                                "target_lang_sense_clarification": "难以解决的问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86df4ef2-9e8c-3abf-8a40-a88421f83bf9",
                    "sense_definition": "An awkward situation or quarrel, often referring to financial problems.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business is in serious financial <w>difficulties</w> and may need to close.",
                            "target_lang_translations": {
                                "ru": "Бизнес испытывает серьезные финансовые <w>трудности</w> и, возможно, закроется.",
                                "zh": "这家企业正陷入严重的财务<w>困境</w>，可能需要倒闭。"
                            }
                        },
                        {
                            "text": "He found himself in a <w>difficulty</w> with the landlord over the unpaid rent.",
                            "target_lang_translations": {
                                "ru": "У него возникли <w>сложности</w> с арендодателем из-за неоплаченной аренды.",
                                "zh": "因为没交房租，他和房东之间产生了<w>麻烦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble"
                    ],
                    "common_phrases": [
                        "financial difficulties",
                        "in difficulties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неловкая ситуация или ссора, часто относящаяся к финансовым проблемам.",
                        "zh": "尴尬的处境或纠纷，常指财务问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затрудне́ние",
                                "target_lang_sense_clarification": "финансовое или неловкое положение"
                            },
                            {
                                "target_lang_word": "пробле́ма",
                                "target_lang_sense_clarification": "неприятность, сложная ситуация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "艰难的处境"
                            },
                            {
                                "target_lang_word": "麻烦",
                                "target_lang_sense_clarification": "棘手的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66e559b4-a6e2-3dca-9bf0-bc8b7ada33a3",
                    "sense_definition": "Physical danger from the environment, especially with risk of drowning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The three teenagers were playing by the river when they got into <w>difficulty</w>.",
                            "target_lang_translations": {
                                "ru": "Трое подростков играли у реки и попали в <w>беду</w>.",
                                "zh": "三个少年在河边玩耍时陷入了<w>险境</w>。"
                            }
                        },
                        {
                            "text": "A swimmer in <w>difficulty</w> was rescued by the lifeguards near the pier.",
                            "target_lang_translations": {
                                "ru": "Пловец, попавший в <w>беду</w>, был спасен спасателями возле пирса.",
                                "zh": "一名在码头附近陷入<w>危难</w>的游泳者被救生员救起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble"
                    ],
                    "antonyms": [
                        "safety"
                    ],
                    "common_phrases": [
                        "get into difficulty",
                        "in difficulty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая опасность, исходящая от окружающей среды, особенно риск утонуть.",
                        "zh": "来自环境的身体危险，尤指溺水风险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда́",
                                "target_lang_sense_clarification": "опасная ситуация"
                            },
                            {
                                "target_lang_word": "опа́сное положе́ние",
                                "target_lang_sense_clarification": "угроза жизни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "险境",
                                "target_lang_sense_clarification": "危险的处境"
                            },
                            {
                                "target_lang_word": "危难",
                                "target_lang_sense_clarification": "处于危险之中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dafecf60-e89f-39a7-9f4c-d1cec990b507",
                    "sense_definition": "An objection or point of disagreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He raised no <w>difficulty</w> regarding the proposed changes to the plan.",
                            "target_lang_translations": {
                                "ru": "Он не высказал никаких <w>возражений</w> по поводу предложенных изменений в плане.",
                                "zh": "他对于计划的拟议变更没有提出任何<w>异议</w>。"
                            }
                        },
                        {
                            "text": "They accepted the offer without making any <w>difficulty</w>.",
                            "target_lang_translations": {
                                "ru": "Они приняли предложение, не чиня никаких <w>препятствий</w>.",
                                "zh": "他们接受了提议，没有制造任何<w>阻碍</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make no difficulty",
                        "raise a difficulty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возражение или пункт разногласий.",
                        "zh": "反对意见或分歧点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возраже́ние",
                                "target_lang_sense_clarification": "несогласие"
                            },
                            {
                                "target_lang_word": "препя́тствие",
                                "target_lang_sense_clarification": "чинимые помехи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "反对的意见"
                            },
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "人为设置的障碍"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}