                            }
                        ]
                    }
                },
                {
                    "sense_id": "c213e456-5d15-373f-87e1-c0d25a742ab2",
                    "sense_definition": "Mythologisch of fantasiewezen dat vaak in bergen of mijnen leeft.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgens de legendes bewaakt de <w>kobold</w> een schat die diep in de bergen verborgen ligt.",
                            "target_lang_translations": {
                                "en": "According to legends, the <w>kobold</w> guards a treasure hidden deep in the mountains."
                            }
                        },
                        {
                            "text": "In moderne fantasieverhalen wordt een <w>kobold</w> vaak afgebeeld als een sluw en klein wezen.",
                            "target_lang_translations": {
                                "en": "In modern fantasy stories, a <w>goblin</w> is often depicted as a cunning and small creature."
                            }
