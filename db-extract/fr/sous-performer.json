                ],
                "senses": [
                    {
                        "sense_id": "3340703a-0e3d-3a33-9821-57a6bd46b4b3",
                        "entry_id": "99086795-4f18-3050-9d46-0bbc9b297153",
                        "glosses": [
                            "Avoir une moins bonne performance que ce qui est habituel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbadc155-7d36-447f-80fe-c357ba4b47da",
                                "sense_id": "3340703a-0e3d-3a33-9821-57a6bd46b4b3",
                                "text": "Et alors que les taux à long terme ne devraient a priori pas retrouver leurs niveaux pré-Covid, La Banque Postale asset Management estime que les valeurs technologiques et de croissance pourraient continuer à durablement “sous-performer” (faire moins bien en Bourse que) les valeurs dites “value” (les secteurs d’activité traditionnellement décotés)."
                            },
                            {
                                "example_id": "0bd1db1f-f49b-49cf-b7f9-8e38bec9f5c4",
                                "sense_id": "3340703a-0e3d-3a33-9821-57a6bd46b4b3",
                                "text": "Et d’ajouter pour preuve que parmi les 10 groupes les plus actifs sur les rachats d’actions depuis 2012, 6 ont sous-performé le CAC 40."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c660a17-7af5-4f5b-8a7c-577e850e5e61",
                        "source_entry_id": "99086795-4f18-3050-9d46-0bbc9b297153",
                        "source_sense_id": "3340703a-0e3d-3a33-9821-57a6bd46b4b3",
                        "target_lang_word": "underperform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underperform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7da84b4b-92d5-3c2e-b045-94e3cfc7fb02",
                                        "entry_id": "21c772a1-3f11-3cda-b274-a1c3998bef9f",
                                        "glosses": [
                                            "To underachieve; to fail to reach standards or expectations, especially with respect to a financial investment."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc172d91-e0eb-4f4d-a9eb-13f3863fd585",
                                                "sense_id": "7da84b4b-92d5-3c2e-b045-94e3cfc7fb02",
                                                "text": "Even outside the Anglo-Saxon world, underperforming public companies have become vulnerable to hostile takeover."
                                            },
                                            {
                                                "example_id": "d876d37c-24aa-476f-88d4-9364d6b886b9",
                                                "sense_id": "7da84b4b-92d5-3c2e-b045-94e3cfc7fb02",
                                                "text": "She inhabits the prose’s terrible serenity and glacial horror — the translator’s hand never overwhelms or underperforms."
                                            },
                                            {
                                                "example_id": "73f8de01-6202-4aa0-8317-fa9a82bacc9a",
                                                "sense_id": "7da84b4b-92d5-3c2e-b045-94e3cfc7fb02",
                                                "text": "Jesus' finishing has been one of the main concerns - since the start of last season the 23-year-old has underperformed his Premier League expected goals tally by 6.97goals (in short, he has scored seven fewer goals than would be expected from the chances presented to him)."
                                            },
                                            {
                                                "example_id": "58c9f8ba-8b32-4078-9133-d6536a5bd93f",
                                                "sense_id": "7da84b4b-92d5-3c2e-b045-94e3cfc7fb02",
                                                "text": "Former HS2 Ltd chairman Sir David Higgins provided a timely reminder of why Britain needs HS2 in a letter to The Times on September 25, in which he asked: \"Why are so few FTSE 100 companies based outside the South East? Why is there such a brain drain of graduates from the North? Why do northern cities underperform compared with their European counterparts?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
