                            },
                            {
                                "target_lang_word": "лживый",
                                "target_lang_sense_clarification": "неискренний, намеренно скрывающий правду"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "скрывающий злой умысел"
                            }
                        ],
                        "pl": [
