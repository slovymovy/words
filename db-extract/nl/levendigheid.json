                        "glosses": [
                            "vol met leven zijnde, enthousiast, dartel, vitaliteit, animo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df768136-bfdd-4939-9bf1-a09f046e1b4f",
                                "sense_id": "f86cf866-3f17-3830-bd52-633e0423fadb",
                                "text": "Met veel levendigheid praatte de 100 jarige vrouw over haar jeugd en toen ze haar man had ontmoet."
                            },
                            {
                                "example_id": "2c56eb8c-c0a0-4ae2-a05d-790d029a5c9a",
                                "sense_id": "f86cf866-3f17-3830-bd52-633e0423fadb",
                                "text": "Ook boer Henk Koster kwam afscheid nemen. \"Ik heb de hele ontwikkeling meegemaakt, vanaf het begin. Lenie 't Hart kwam vroeger bij ons spullen lenen om zeehondenpups groot te krijgen. Wat hier is opgebouwd, is een succes voor Pieterburen én voor de zeehonden. Voor de levendigheid in het dorp was het beter geweest als het hier was gebleven\", zei hij."
                            },
                            {
                                "example_id": "7fb82390-eebc-463d-bbc8-139fad1e7bac",
                                "sense_id": "f86cf866-3f17-3830-bd52-633e0423fadb",
                                "text": "Allegro assai is een muziekterm die 'met grote levendigheid' betekent"
                            }
                        ]
                    }
