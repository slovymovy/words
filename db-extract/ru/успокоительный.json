                        "sense_id": "d727d1f0-1bf5-3906-9755-520b01eebe2d",
                        "entry_id": "8b8c5dfe-a400-3819-8a86-583ec136f3c1",
                        "glosses": [
                            "способствующий успокоению, дающий успокоение; успокаивающий"
