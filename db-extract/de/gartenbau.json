                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "digital gardening"
                                            },
                                            {
                                                "example_id": "7d9b323b-4781-4992-8c39-692a6108424d",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "Several special pages help with the wiki gardening task:¶ ❑ Uncategorized pages (Special:Uncategorizedpages): These are pages that do not have one or more categories assigned. Use this page to ensure that all pages are categorized."
                                            },
                                            {
                                                "example_id": "db98885e-72eb-44a2-8f0b-b51c5aee1100",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "Tom Critchlow, a consultant who has been cultivating his digital garden for years, spells out the main difference between old-school blogging and digital gardening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed2f14e-8cc9-3588-b121-e15408e5112f",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
