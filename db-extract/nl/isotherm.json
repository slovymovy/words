                "senses": [
                    {
                        "sense_id": "0e93af03-0748-3531-b2c0-059b4e4c773a",
                        "entry_id": "d365b7a0-fcca-3f47-a275-1717100fbaf9",
                        "glosses": [
                            "een verzameling punten constante temperatuur gemeten of waar de temperatuur dezelfde waarde heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0212160d-7d4f-4de8-b346-8865c65643fd",
                                "sense_id": "0e93af03-0748-3531-b2c0-059b4e4c773a",
                                "text": "De isothermen voor 25, 26 en 27ᵒC zijn respectievelijk in rood, groen en blauw aangegeven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f59f5c06-7482-4c5f-bc0a-ac1dea390044",
