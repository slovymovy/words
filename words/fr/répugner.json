{
    "word_family": [
        "répugnance",
        "répugnant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc9ab568-186e-3d20-8c0d-cf828edafc64",
                    "sense_definition": "Inspirer du dégoût, une vive répulsion ou une forte aversion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette odeur de poisson avarié me <w>répugne</w> depuis mon enfance."
                        },
                        {
                            "text": "Il lui <w>répugnait</w> profondément d'assister à une telle injustice sans intervenir."
                        }
                    ],
                    "synonyms": [
                        "dégoûter",
                        "rebuter",
                        "déplaire"
                    ],
                    "common_phrases": [
                        "répugner profondément"
                    ]
                },
                {
                    "sense_id": "18e4af4f-6ace-3798-81ac-9dc665f1c3a8",
                    "sense_definition": "Éprouver une grande répulsion ou de la réticence à faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reticence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet honnête homme <w>répugnait</w> à mentir pour protéger les erreurs de ses collègues."
                        },
                        {
                            "text": "Bien qu'il manquât d'argent, il <w>répugne</w> à accepter de l'aide financière."
                        }
                    ],
                    "synonyms": [
                        "rebuter"
                    ],
                    "common_phrases": [
                        "répugner à mentir"
                    ]
                },
                {
                    "sense_id": "982b22cf-7291-3dfc-8a15-f441704bdae0",
                    "sense_definition": "Être en contradiction avec la raison, les faits ou la logique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incompatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle conclusion <w>répugne</w> à tous les principes fondamentaux de la physique moderne."
                        },
                        {
                            "text": "L'idée même d'une sanction rétroactive <w>répugnait</w> au bon sens des juges."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "littéraire ou vieilli dans ce sens"
                        }
                    ]
                }
            ]
        }
    ]
