                    {
                        "sense_id": "31043926-6215-3e75-bda4-8775b19e5460",
                        "entry_id": "d33a9e0f-cf2d-3bed-8707-b459e64dc908",
                        "glosses": [
                            "Organisationseinheit der jüdischen Militärseelsorge in den Streitkräften eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d7bf75-3da8-4b49-860c-8fdf72c73f76",
                                "sense_id": "31043926-6215-3e75-bda4-8775b19e5460",
                                "text": "„Ein Jahr nach Gründung des Militärrabbinats und nach Amtseinführung des Militärbundesrabbiners Zsolt Balla arbeiten die Mitarbeiterinnen und Mitarbeiter am Interims-Standort auf der Oberspreestraße in Berlin am weiteren Aufbau einer der jüngsten Bundeswehr-Dienststellen.“"
                            },
                            {
                                "example_id": "03db64e1-ccff-4c46-b423-04d6357dc1ac",
                                "sense_id": "31043926-6215-3e75-bda4-8775b19e5460",
                                "text": "„Der als Vertreter des israelischen Militärrabbinats mit nach Deutschland gereiste Schay Vagner sagte: ‚Das Gefühl, als wir mit genau dieser Tora in Deutschland gelandet sind, kann ich einfach nicht beschreiben.‘“"
                            }
                        ],
