                        "glosses": [
                            "Without any mistake or misunderstanding; unmistakably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd941e0b-734a-4ed4-87c2-41e2d2c89697",
                                "sense_id": "4d31cc1b-4eb1-376a-94db-2c54f7522a89",
                                "text": "The writing was unmistakingly that of Liza Mary—the sentiment as unmistakingly that of Violet Rose. For a moment Miss Car'line twisted the note between fingers which no longer trembled."
                            },
                            {
                                "example_id": "082f1b8d-334b-4040-80cb-4df0f5f05015",
                                "sense_id": "4d31cc1b-4eb1-376a-94db-2c54f7522a89",
                                "text": "And in the canto this mind will be characterised very thoroughly: a sense of ambiguity and duality will run throughout it, unobtrusively but unmistakingly underlining the essence of Dante's poetic vision of Guido."
                            }
                        ]
                    }
