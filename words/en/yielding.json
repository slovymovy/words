{
    "word_family": [
        "yield",
        "unyielding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bb0c820-cb13-3fd7-aaea-996073993921",
                    "sense_definition": "present participle and gerund of <w>yield</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tree was <w>yielding</w> a large harvest of apples this autumn.",
                            "target_lang_translations": {
                                "nl": "De boom <w>leverde</w> dit najaar een grote appeloogst <w>op</w>."
                            }
                        },
                        {
                            "text": "After hours of difficult negotiation, neither side was <w>yielding</w> ground.",
                            "target_lang_translations": {
                                "nl": "Na uren van moeilijke onderhandelingen <w>week</w> geen van beide partijen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord van yield; opleveren, opbrengen of toegeven, wijken"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opleverend",
                                "target_lang_sense_clarification": "een opbrengst genererend"
                            },
                            {
                                "target_lang_word": "wijkend",
                                "target_lang_sense_clarification": "meegevend, terugtrekkend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "345c2ca8-c13d-3bac-b770-09e9bff37e88",
                    "sense_definition": "Inclined to submit or give way to pressure; submissive or flexible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>yielding</w> nature made it hard for him to stand up to his manager.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>toegeeflijke</w> karakter maakte het moeilijk voor hem om tegen zijn manager in te gaan."
                            }
                        },
                        {
                            "text": "She walked across the soft, <w>yielding</w> grass near the edge of the river.",
                            "target_lang_translations": {
                                "nl": "Ze liep over het zachte, <w>meegevende</w> gras bij de oever van de rivier."
                            }
                        }
                    ],
                    "synonyms": [
                        "submissive",
                        "compliant",
                        "docile",
                        "pliant"
                    ],
                    "antonyms": [
                        "unyielding",
                        "stubborn",
                        "rigid"
                    ],
                    "common_phrases": [
                        "yielding nature"
                    ],
                    "target_lang_definitions": {
                        "nl": "geneigd om toe te geven of onder druk mee te buigen; meegaand, inschikkelijk of veerkrachtig meeverend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "toegeeflijk",
                                "target_lang_sense_clarification": "inschikkelijk, makkelijk zwichtend"
                            },
                            {
                                "target_lang_word": "meegaand",
                                "target_lang_sense_clarification": "niet snel weerstand biedend"
                            },
                            {
                                "target_lang_word": "meegevend",
                                "target_lang_sense_clarification": "zacht of buigzaam bij druk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0ae2074-5413-3266-849a-318983ea501e",
                    "sense_definition": "An act of surrendering, conceding, or giving way; a concession.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sudden <w>yielding</w> surprised everyone who expected a fierce argument.",
                            "target_lang_translations": {
                                "nl": "Haar plotselinge <w>toegeven</w> verraste iedereen die een felle ruzie had verwacht."
                            }
                        },
                        {
                            "text": "Such continuous <w>yieldings</w> to aggressive demands only weakened their position.",
                            "target_lang_translations": {
                                "nl": "Dergelijke voortdurende <w>concessies</w> aan agressieve eisen verzwakten hun positie alleen maar."
                            }
                        }
                    ],
                    "synonyms": [
                        "concession",
                        "surrender",
                        "submission"
                    ],
                    "antonyms": [
                        "resistance"
                    ],
                    "target_lang_definitions": {
                        "nl": "de handeling van het opgeven, toegeven of buigen voor druk; een concessie"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het toegeven",
                                "target_lang_sense_clarification": "concessie, het capituleren"
                            },
                            {
                                "target_lang_word": "capitulatie",
                                "target_lang_sense_clarification": "overgave of buigen voor eisen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "69c1b3bc-3072-3c70-8d56-d7c2c85f9c3f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We scheduled an afternoon interview with Mr. <w>Yielding</w> to discuss the project.",
                            "target_lang_translations": {
                                "nl": "We hebben 's middags een gesprek gepland met de heer <w>Yielding</w> om het project te bespreken."
                            }
                        },
                        {
                            "text": "The <w>Yielding</w> family has lived in this village for generations.",
                            "target_lang_translations": {
                                "nl": "De familie <w>Yielding</w> woont al generaties lang in dit dorp."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "een achternaam"
                    },
                    "translations": {
                        "nl": []
                    }
                }
            ]
        }
    ]
