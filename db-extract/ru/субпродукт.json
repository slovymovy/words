                    {
                        "translation_id": "5c9f0b74-3d78-49aa-9398-b85f56ae6b7f",
                        "source_entry_id": "815fab9e-fc72-3ed9-8b86-12fb0822cd8c",
                        "source_sense_id": "9ffe6d1f-092b-3260-81c2-145346d6e121",
                        "target_lang_word": "Kuttel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuttel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23038b8c-14cb-3529-8073-42526cc58c04",
                                        "entry_id": "64880006-3182-3c3b-a165-1adb50410daf",
                                        "glosses": [
                                            "süddeutsch, oft Plural, landsmannschaftlich oder umgangssprachlich: Gedärm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb91550-365f-4bb8-b583-78c821305ea9",
                                                "sense_id": "23038b8c-14cb-3529-8073-42526cc58c04",
                                                "text": "Ich habe gestern ein Reizker-Gericht gegessen, seitdem rumort's mir gewaltig in der Kuttel."
                                            },
                                            {
                                                "example_id": "077b8d4f-f7a6-4ce1-8a29-d5e4f1e3fcb0",
                                                "sense_id": "23038b8c-14cb-3529-8073-42526cc58c04",
                                                "text": "Ach Herr Doktor, wenn die Kuttel nur noch weh tut und die Beiner auch, dann sollte man eigentlich sterben."
                                            },
                                            {
                                                "example_id": "4fe89cf1-a114-40eb-8c17-a4367cc7cdfa",
                                                "sense_id": "23038b8c-14cb-3529-8073-42526cc58c04",
                                                "text": "Ich habe so ein Gefühl in der Kuttel, als bekämen wir bald anderes Wetter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57a5b526-b118-349d-8644-2e518d7e992b",
                                        "entry_id": "64880006-3182-3c3b-a165-1adb50410daf",
                                        "glosses": [
                                            "süddeutsch, Plural, speziell zu [1]: Gericht aus dem in Streifen geschnittenen Wiederkäuermagen des Rindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a0f958-4d59-4b43-8a94-0f8d6b97f6e2",
                                                "sense_id": "57a5b526-b118-349d-8644-2e518d7e992b",
                                                "text": "Viele mögen keine Kutteln, weil sie schon alleine den Anblick der Zotteln des Wiederkäuermagens nicht ertragen und ihnen der immer etwas anhaftende saure Geruch den Rest gibt."
                                            },
                                            {
                                                "example_id": "9c21d081-04fa-4b0a-be62-93f0bcd42ff5",
                                                "sense_id": "57a5b526-b118-349d-8644-2e518d7e992b",
                                                "text": "Zu Sauren Kutteln gehören Bratkartoffeln als Beilage."
                                            },
                                            {
                                                "example_id": "43fcccde-0948-4233-b4c0-0ae43fa8cd88",
                                                "sense_id": "57a5b526-b118-349d-8644-2e518d7e992b",
                                                "text": "„Und die Gäste haben wieder Appetit auf Delikatessen wie Herz, Nierchen oder Kutteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
