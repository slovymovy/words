                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>fouetter</w> la crème énergiquement jusqu'à ce qu'elle devienne bien ferme."
                        },
                        {
                            "text": "Le chef nous a montré comment <w>fouetter</w> les œufs pour obtenir une mousse légère."
                        }
                    ],
                    "common_phrases": [
                        "fouetter la crème",
                        "fouetter les blancs en neige"
                    ]
                },
                {
