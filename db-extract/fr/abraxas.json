            {
                "entry_id": "eee7e6c8-2237-3564-9864-7882b3582b68",
                "word": "abraxas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d6254120-faa4-4df2-9e50-df731b12df84",
                        "entry_id": "eee7e6c8-2237-3564-9864-7882b3582b68",
                        "tags": [],
                        "form": "abrac"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93825a78-ca87-3b43-843d-d235f95ceaf6",
                        "entry_id": "eee7e6c8-2237-3564-9864-7882b3582b68",
                        "glosses": [
                            "Mot aux vertus magiques adopté par les gnostiques des basilidiens et représentant les trois cent soixante cinq émanations du Dieu tout-puissant Archon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1784c62-52e1-447f-b81d-d9c742e5b0f2",
                                "sense_id": "93825a78-ca87-3b43-843d-d235f95ceaf6",
                                "text": "Le mot abraxas ayant la vertu d’attirer puissamment les influences de l’intelligence productive du monde, on fit graver sur des pierres qu’on nomma des abraxas, dont les cabinets d’Europe contiennent un nombre prodigieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e1afd37-89c1-3527-84af-12ab91cd4964",
                        "entry_id": "eee7e6c8-2237-3564-9864-7882b3582b68",
                        "glosses": [
                            "Classe d’objets, tels que statuettes, plaques métalliques et surtout pierres gravées, sur lesquels on lit plusieurs lettres grecques, dont la réunion forme le mot abraxas ou abrasax, qui n’appartient à aucune langue."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "879640e3-56b7-4c3a-968f-8fcf1c1f106f",
                                "sense_id": "0e1afd37-89c1-3527-84af-12ab91cd4964",
                                "text": "L’abraxas se portait comme une amulette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b93384e1-9682-4916-988d-8f7810e789ed",
                        "source_entry_id": "eee7e6c8-2237-3564-9864-7882b3582b68",
                        "target_lang_word": "Abraxas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abraxas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58dfc96b-44cc-3266-ae9a-a026637b22b2",
                                        "entry_id": "e9f4fb5c-5f0c-3b4f-9f88-3e15b768fe6e",
                                        "glosses": [
                                            "(in der Gnosis) Geheimname Gottes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91210dd5-19db-4054-bbf1-af72b31bb8ff",
                                                "sense_id": "58dfc96b-44cc-3266-ae9a-a026637b22b2",
                                                "text": "Abraxas war ein mystisches Wort der Gnostiker, ursprünglich vielleicht der wahre Name Gottes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae029d93-ef7a-380c-9e04-f19542b04a5c",
                                        "entry_id": "e9f4fb5c-5f0c-3b4f-9f88-3e15b768fe6e",
                                        "glosses": [
                                            "Zauberspruch (auf Steinen, die auch als Amulette getragen wurden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9293ceaf-736f-4c61-b702-3c0388bdc6e4",
                                                "sense_id": "ae029d93-ef7a-380c-9e04-f19542b04a5c",
                                                "text": "„Darüber hinaus gibt es unzählige andere Schutzformeln: Abraxas, Jod-He-Vau-He und Tetragammatron [sic] sind nur einige wenige Beispiele.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
