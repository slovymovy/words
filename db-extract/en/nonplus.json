                    {
                        "sense_id": "382655aa-d009-3a7a-b7ab-cdc06dc7131a",
                        "entry_id": "1323bfb9-0514-3ece-850e-e033d6ea0c01",
                        "glosses": [
                            "To bewilder or perplex (someone); to confound, to flummox."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d5398ac0-7a99-43d7-8b35-a82465f032e5",
                                "sense_id": "382655aa-d009-3a7a-b7ab-cdc06dc7131a",
                                "text": "You couldn’t have told it from my manner, but I was feeling more than a bit nonplussed. The spectacle before me was enough to nonplus anyone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fab1171-b5b0-4e0a-a571-0a70d45ab097",
                        "source_entry_id": "1323bfb9-0514-3ece-850e-e033d6ea0c01",
                        "source_sense_id": "382655aa-d009-3a7a-b7ab-cdc06dc7131a",
                        "source_sense_description": "to bewilder or perplex (someone)",
                        "target_lang_word": "zaskočit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zaskočit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a5c858-041d-3a56-b509-b3932c43ca0b",
                                        "entry_id": "dd3069fc-c726-3c79-b942-765aba658139",
                                        "glosses": [
                                            "zajít na přechodný časový úsek někam, krátce navštívit"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb362a7-2786-4461-bd2a-988de8003b3f",
                                                "sense_id": "c8a5c858-041d-3a56-b509-b3932c43ca0b",
                                                "text": "Až budeš mít chvíli času, zaskoč na kus řeči."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea77a6e5-3dfa-313b-b8f2-c07367f0e735",
                                        "entry_id": "dd3069fc-c726-3c79-b942-765aba658139",
                                        "glosses": [
                                            "velmi překvapit, zejména nemile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7b24ad-a197-40af-bae9-724948fb58a2",
                                                "sense_id": "ea77a6e5-3dfa-313b-b8f2-c07367f0e735",
                                                "text": "Jako manažer státem vlastněné firmy jsem počítal s tím, že může dojít k mému odvolání. To je právo vlastníka a já ho v žádném případě nezpochybňuji. Zaskočil mě však způsob, jakým byla výměna managementu v dozorčí radě provedena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0bb32bf-d59a-38d0-b0b9-1116b2e96c2e",
                                        "entry_id": "dd3069fc-c726-3c79-b942-765aba658139",
                                        "glosses": [
                                            "(zaskočit za + akuzativ) nahradit, zastoupit, zpravidla na poslední chvíli"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3dbcc4-5ef2-4a8d-9f35-696bb79db107",
                                                "sense_id": "a0bb32bf-d59a-38d0-b0b9-1116b2e96c2e",
                                                "text": "„Pokud by výpovědi nestáhli ještě další členové ND - ať už opery či baletu, zaskočí za ně odboráři. V baletu by mohl krátce hostovat i prezident, protože prý nohy necítí,“ navrhuje Kraus řešení personální krize ve Zlaté kapličce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a167bdf5-cb83-3b2d-8857-fdfa0f5c68e6",
                                        "entry_id": "dd3069fc-c726-3c79-b942-765aba658139",
                                        "glosses": [
                                            "(o jídle) dostat se do dýchacích cest, např. vinou nesoustředěné konzumace, leknutí apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40463fe3-3eef-43d5-bc86-5b00eb26c932",
                                                "sense_id": "a167bdf5-cb83-3b2d-8857-fdfa0f5c68e6",
                                                "text": "Dejte pozor, aby vám nezaskočilo nedělní jídlo, ale na tohle video se rozhodně mrkněte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55a616eb-6a9b-4bf1-ac13-91cc57190927",
                        "source_entry_id": "1323bfb9-0514-3ece-850e-e033d6ea0c01",
