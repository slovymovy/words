                "senses": [
                    {
                        "sense_id": "caaa07e0-7761-371c-b303-f48fd9daeda5",
                        "entry_id": "b2638479-1a43-3ef4-ae2c-bd07eabb39cf",
                        "glosses": [
                            "Haltung, die sich als positiv erweisen kann, aber nicht zu den Kardinaltugenden gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca2a0ef-0832-4b31-b7aa-38f28dbdf218",
                                "sense_id": "caaa07e0-7761-371c-b303-f48fd9daeda5",
                                "text": "„Im Gegensatz dazu hat man die sogenannten bürgerlichen Tugenden – wie Pünktlichkeit, Reinlichkeit und Ordnungssinn – als »Sekundärtugenden« bezeichnet, da sie ihre Legitimation nicht aus sich heraus erhalten: Erst im Lichte der Zwecke oder der Idee, der sie sich unterordnen, wird erkennbar, ob sie zum Guten oder zum Bösen ausschlagen.“"
                            }
                        ],
