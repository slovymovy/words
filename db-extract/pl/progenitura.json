                        ]
                    },
                    {
                        "translation_id": "1ceeecdc-ff7c-4d8c-b819-c0d7b4ea93e5",
                        "source_entry_id": "ca022ef4-ac10-38ee-874c-8528a0554765",
                        "source_sense_id": "27abb8ee-c786-3404-8b5b-0c6ef076b076",
                        "target_lang_word": "progeny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progeny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "Offspring or descendants considered as a group."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d68f04-a7f2-4028-84f2-027c435616bc",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "I treasure this five-generation photograph of my great-great grandmother and her progeny."
                                            },
                                            {
                                                "example_id": "1020f544-7028-4c00-bc42-f9e0a0fabfd5",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "I should premise that I use the term Struggle for Existence in a large and metaphorical sense, including dependence of one being on another, and including (which is more important) not only the life of the individual, but success in leaving progeny."
                                            },
                                            {
                                                "example_id": "614665bd-be97-4cb2-8e3d-693395abea7d",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "One worm on a single plate can give rise to thousands of progeny after just a week or so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1c6113-dbd8-3287-b143-b504d6f1a949",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "Descent, lineage, ancestry."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2533a51-9772-4528-b896-d523217ad9d3",
                                                "sense_id": "ea1c6113-dbd8-3287-b143-b504d6f1a949",
                                                "text": "Beſides, all French and France exclaimes on thee, / Doubting thy Birth and lawfull Progenie. / Who ioyn’ſt thou with, but with a Lordly Nation, / That will not truſt thee, but for profits ſake ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a46009d-e5f4-343e-877d-cef73d3ac55b",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "A result of a creative effort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f99eac49-498f-4bd4-87c2-c9421e43ef21",
                                                "sense_id": "8a46009d-e5f4-343e-877d-cef73d3ac55b",
                                                "text": "His dissertation is his most important intellectual progeny to date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bafb972-4bfa-489b-a2de-102ea7bf41bb",
                        "source_entry_id": "ca022ef4-ac10-38ee-874c-8528a0554765",
                        "source_sense_id": "27abb8ee-c786-3404-8b5b-0c6ef076b076",
                        "target_lang_word": "progéniture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progéniture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                        "entry_id": "cdb24e73-2b7b-39d2-ad86-21652ebcabd6",
                                        "glosses": [
                                            "ou Ce qu’un homme, une femme, ce qu’un animal a engendré."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "174d27d6-6b18-415b-8c33-2ad2a10f218e",
                                                "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                                "text": "Je suis pour Hélène ce que, dans l’ordre naturel, une mère doit être pour sa progéniture."
                                            },
                                            {
                                                "example_id": "b7e078d6-e1af-4b4b-9b5d-607eb8b517c4",
                                                "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                                "text": "Ainsi, j’observe parmi mes patients des parents qui donnent beaucoup à leurs enfants et à leur conjoint(e), comme ces mères ultraorganisées qui gèrent les agendas de miniministres de leur progéniture, font de nombreux allers-retours pour les activités des uns et des autres, tout en assurant la bonne tenue de la maison avec les tâches ménagères."
                                            },
                                            {
                                                "example_id": "5f044d22-740c-40a9-9b11-d5bcfab4bcc4",
                                                "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                                "text": "Misère, c’était le nom de ma chienne qui n’avait que trois pattes. L’autre, le destin la lui avait mise de côté pour les olympiades de la bouffe et des culs semestriels qu’elle accrochait dans les buissons pour y aller de sa progéniture."
                                            },
                                            {
                                                "example_id": "1d7caa50-72fb-4d9d-a43f-86c58fbeee82",
                                                "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                                "text": "C’est bien, faire des activités avec les enfants. Mais pourquoi j’ai l’impression qu’on doit sans cesse animer, distraire et stimuler notre progéniture avec des activités à 50 piasses la tête de pipe ? L’ennui n’est-il pas le tremplin vers la créativité ?"
                                            },
                                            {
                                                "example_id": "ef78acbc-1fb3-4b60-9df2-292c78d1e9d8",
                                                "sense_id": "42e2f9c8-7dac-3b52-ae07-43a3c2d94cdd",
                                                "text": "Sa joie ne vient pas de ce ménage sans reproche mais de sa progéniture. Elle compte lentement, pointant du doigt ses enfants: Mamadou, Ali, Awa … «plus ceux qui sont dehors ou à l'école». Neuf en tout. Un chiffre qui au Niger n'a rien d'exceptionnel. On frise même la norme. Le pays affiche le plus haut taux de fertilité de la planète, 7,6 enfants par femme, selon les Nations unies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576f55b0-91bd-39c2-b6fc-3bd6af5b356e",
                                        "entry_id": "cdb24e73-2b7b-39d2-ad86-21652ebcabd6",
                                        "glosses": [
                                            "Produit de l’évolution d’une chose que l’on a créée."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c8ef6f-131b-42ba-94d0-d0b0a48f27ab",
                                                "sense_id": "576f55b0-91bd-39c2-b6fc-3bd6af5b356e",
                                                "text": "Ah ! Théophraste Renaudot, triste novateur, pâle nigaud, viens donc contempler ta pullulante progéniture !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
