                "translations": [
                    {
                        "translation_id": "1e490322-4612-483e-9f05-0e7f13916d8d",
                        "source_entry_id": "178cb025-f332-3400-b66f-cf4684fbf64f",
                        "source_sense_id": "2be27146-9a84-33c9-ae65-25ee78f6cfd7",
                        "target_lang_word": "sektoral",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sektoral",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                        "entry_id": "aa174b7b-cbbe-3c83-88e5-62a0241b2bfa",
                                        "glosses": [
                                            "auf einen Sektor bezogen, einen Sektor, einen bestimmten Bereich betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681c8ded-2c49-46a8-ad52-16561a113b93",
                                                "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                                "text": "Die Finanzkrise war zunächst regional und sektoral begrenzt."
                                            },
                                            {
                                                "example_id": "2b2d9a59-d500-45db-9bea-60b509d60c70",
                                                "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                                "text": "Sicher ist nur, dass die Kosten einer Klimaschutzpolitik entscheidend von der angestrebten CO2-Konzentrationsobergrenze in der Erdatmosphäre und den sektoralen und räumlichen Ansatzpunkten der Reduktionspolitik abhängen."
                                            },
                                            {
                                                "example_id": "43e5a52e-4310-4a8f-8b04-f5621ea15095",
                                                "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                                "text": "Es werde schwierig für Deutschland, den Chinesen sektorale Klimaziele für die Stahlindustrie vorzuschlagen, wenn Deutschland seine eigene Stahlindustrie völlig ausklammere."
                                            },
                                            {
                                                "example_id": "628439af-53fe-434e-9b1d-7dd7ac4cc39d",
                                                "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                                "text": "Die eigentlichen Felder der Baukultur - Stadt- und Landschaftsplanung, Architektur und Ingenieurbau - werden nur noch sektoral betrachtet, kaum noch zusammengedacht."
                                            },
                                            {
                                                "example_id": "91d83c87-7502-447f-9b35-ce83b4b8f81d",
                                                "sense_id": "c992c8a4-803c-36db-9c95-76e079af02d8",
                                                "text": "Alle Maßnahmen haben eines gemeinsam: Man will punktgenau und sektoral fördern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
