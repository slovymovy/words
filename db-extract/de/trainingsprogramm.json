                        "examples": [
                            {
                                "example_id": "4a9c984e-e3c3-4724-9aea-f885fad7d1c8",
                                "sense_id": "d42fe33f-5ded-3957-b7ba-2cb611a8ab7f",
                                "text": "„Sie riefen das Programm „Rotterdam Peloton“ ins Leben, ein mehrmonatiges Trainingsprogramm für ambitionierte Amateurfahrerinnen.“"
                            }
