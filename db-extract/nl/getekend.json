                "senses": [
                    {
                        "sense_id": "e3fd6f81-6f40-33c4-896e-04b54450b486",
                        "entry_id": "97c6b213-2ee3-3d0e-82b1-d6859e58dbd9",
                        "glosses": [
                            "door tekenen ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d71b57d6-1bed-46c6-986c-da180e3c3a11",
                                "sense_id": "e3fd6f81-6f40-33c4-896e-04b54450b486",
                                "text": "Het prachtig getekende portret van de koning is de basis van de nieuwe postzegel."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef80da43-59d2-35c2-bf5b-1f4b2a324680",
                        "entry_id": "97c6b213-2ee3-3d0e-82b1-d6859e58dbd9",
                        "glosses": [
                            "beschadigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09048853-090f-4906-81a6-5e4b6316429c",
                                "sense_id": "ef80da43-59d2-35c2-bf5b-1f4b2a324680",
                                "text": "De door het leven getekende vrouw ging toch moedig door met haar leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "80064d8f-3777-3184-ae3a-10487d79c214",
                        "entry_id": "97c6b213-2ee3-3d0e-82b1-d6859e58dbd9",
                        "glosses": [
                            "ondertekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde00757-972e-49ff-9d9c-efdf5e357293",
                                "sense_id": "80064d8f-3777-3184-ae3a-10487d79c214",
                                "text": "Het getekende contract is nu rechtsgeldig."
                            },
                            {
                                "example_id": "e2b8b82e-baed-460a-8e16-af51497ebbb7",
                                "sense_id": "80064d8f-3777-3184-ae3a-10487d79c214",
                                "text": "Tentamenweek of niet, studenten, promovendi en andere medewerkers van de afdeling Aardwetenschappen aan de Vrije Universiteit in Amsterdam voeren vandaag actie. Ze proberen het voorgenomen besluit om hun studie en banen weg te bezuinigen tegen te houden. En niet alleen zij maken zich zorgen: ook het werkveld luidt de noodklok. Een petitie tegen het plan is al meer dan 8000 keer getekend."
                            }
                        ]
                    }
