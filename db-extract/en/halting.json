                                        "entry_id": "41a9bcfb-6d6c-3dbe-8625-5539409df7a9",
                                        "glosses": [
                                            "actie ondernemen om een in gang zijnd proces tot staan te brengen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07963c9f-1113-43e1-af19-6c173f7bb264",
                                                "sense_id": "53c10447-3206-3d22-a68e-11c3d0631100",
                                                "text": "De voorzitter onderbrak de verhitte discussie met een verwijzing naar de beperkte tijd die beschikbaar was."
                                            },
                                            {
                                                "example_id": "aba8c40f-fd2d-42f1-b18d-5abf196b8cb2",
                                                "sense_id": "53c10447-3206-3d22-a68e-11c3d0631100",
                                                "text": "Als er niet zo veel herrie was geweest, had hij kunnen nadenken over wat hem dwarszat, maar de krijsende fluittonen volgden elkaar op, onderbroken door explosies die je van hoofd tot voeten door elkaar schudden."
                                            },
                                            {
                                                "example_id": "46bcb1ec-75ba-4556-b332-d8afbf9653ef",
                                                "sense_id": "53c10447-3206-3d22-a68e-11c3d0631100",
                                                "text": "'s Nachts droomde hij ook af en toe van het leven op de Hardangervidda en soms wanneer hij half slapend zijn voeten op de ijskoude plankenvloer zette om uit bed te komen voor een activiteit die mannen van zijn leeftijd dwong om de diepste slaap of de aangenaamste dromen te onderbreken, voelde het alsof hij er nog steeds was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
