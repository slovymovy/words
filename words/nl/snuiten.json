    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01047efe-0aff-30b1-9139-456bb7b343e5",
                    "sense_definition": "Slijm uit de neusholte verwijderen door krachtig lucht door de neus te blazen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "neus_reinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je neus <w>snuiten</w> als je verkouden bent.",
                            "target_lang_translations": {
                                "en": "You should <w>blow</w> your nose when you have a cold.",
                                "ru": "Тебе нужно <w>сморкаться</w>, когда ты простужен."
                            }
                        },
                        {
                            "text": "Hij pakte een zakdoek om zijn neus te <w>snuiten</w>.",
                            "target_lang_translations": {
                                "en": "He grabbed a handkerchief to <w>blow</w> his nose.",
                                "ru": "Он взял платок, чтобы <w>высморкаться</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neus snuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove mucus from the nasal cavity by forcefully blowing air through the nose.",
                        "ru": "Удаление слизи из носовой полости путем сильного выдувания воздуха через нос."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow one's nose",
                                "target_lang_sense_clarification": "to clear the nose of mucus"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сморкаться",
                                "target_lang_sense_clarification": "очищать нос от слизи"
                            },
                            {
                                "target_lang_word": "высморкаться",
                                "target_lang_sense_clarification": "однократное действие по очистке носа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e9d3ad-fa31-33dd-8683-8f95ff1bc435",
                    "sense_definition": "De verbrande lont van een kaars korter maken om walmen te voorkomen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kaars_onderhoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger moest men regelmatig de kaarsen <w>snuiten</w> met een speciale schaar.",
                            "target_lang_translations": {
                                "en": "In the past, people had to <w>snuff</w> the candles regularly with special scissors.",
                                "ru": "Раньше приходилось регулярно <w>подрезать фитили</w> свечей специальными ножницами."
                            }
                        },
                        {
                            "text": "De bediende kwam langs om de brandende kaars te <w>snuiten</w>.",
                            "target_lang_translations": {
                                "en": "The servant came by to <w>trim</w> the burning candle.",
                                "ru": "Слуга подошел, чтобы <w>снять нагар</w> с горящей свечи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kaars snuiten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "voornamelijk gebruikt in historische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To shorten the burnt wick of a candle to prevent smoking or flickering.",
                        "ru": "Укорачивание обгоревшего фитиля свечи для предотвращения копоти."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snuff",
                                "target_lang_sense_clarification": "to trim the wick of a candle"
                            },
                            {
                                "target_lang_word": "trim",
                                "target_lang_sense_clarification": "to cut the burnt part of a wick"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подрезать фитиль",
                                "target_lang_sense_clarification": "укорачивать обгоревшую часть фитиля"
                            },
                            {
                                "target_lang_word": "снимать нагар",
                                "target_lang_sense_clarification": "удалять обгоревшую часть со свечи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41ef454a-b004-383e-91dd-0340caa36f0f",
                    "sense_definition": "Iemand op een oneerlijke manier geld afhandig maken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bedriegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oplichter heeft de oude vrouw voor duizenden euro's <w>gesnoten</w>.",
                            "target_lang_translations": {
                                "en": "That scammer <w>fleeced</w> the old woman out of thousands of euros.",
                                "ru": "Этот мошенник <w>обобрал</w> старушку на тысячи евро."
                            }
                        },
                        {
                            "text": "Pas op dat ze je niet <w>snuiten</w> bij die dubieuze transactie.",
                            "target_lang_translations": {
                                "en": "Watch out that they don't <w>rip</w> you <w>off</w> during that dubious transaction.",
                                "ru": "Смотри, чтобы они тебя не <w>надули</w> при этой сомнительной сделке."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzetten",
                        "bedriegen",
                        "belazeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel en verouderend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To dishonestly deprive someone of money; to swindle or cheat.",
                        "ru": "Нечестным путем лишать кого-либо денег; обманывать или обсчитывать."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fleece",
                                "target_lang_sense_clarification": "to deprive of money by fraud"
                            },
                            {
                                "target_lang_word": "rip off",
                                "target_lang_sense_clarification": "to overcharge or cheat someone"
                            },
                            {
                                "target_lang_word": "swindle",
                                "target_lang_sense_clarification": "to obtain money through deception"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обобрать",
                                "target_lang_sense_clarification": "лишить денег путем обмана"
                            },
                            {
                                "target_lang_word": "обпотрошить",
                                "target_lang_sense_clarification": "сленг, выманить все деньги"
                            },
                            {
                                "target_lang_word": "надуть",
                                "target_lang_sense_clarification": "обмануть, часто на деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9cef223-247d-317a-8985-15dad3289e0d",
                    "sense_definition": "Een scherpe hoek of rand van een voorwerp wegnemen of afschuinen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman besloot de randen van de tafel te <w>snuiten</w> voor een zachtere afwerking.",
                            "target_lang_translations": {
                                "en": "The carpenter decided to <w>bevel</w> the edges of the table for a softer finish.",
                                "ru": "Плотник решил <w>снять фаску</w> с краев стола для более гладкой отделки."
                            }
                        },
                        {
                            "text": "Door de hoeken te <w>snuiten</w> oogt het meubelstuk minder massief.",
                            "target_lang_translations": {
                                "en": "By <w>chamfering</w> the corners, the piece of furniture looks less massive.",
                                "ru": "Благодаря тому, что углы <w>скошены</w>, предмет мебели выглядит менее массивным."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuinen",
                        "afsnuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove a sharp corner or edge from an object or to bevel it.",
                        "ru": "Удаление острого угла или края предмета или придание ему скошенной формы."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bevel",
                                "target_lang_sense_clarification": "to cut at a sloping angle"
                            },
                            {
                                "target_lang_word": "chamfer",
                                "target_lang_sense_clarification": "to cut away a right-angled edge"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "снимать фаску",
                                "target_lang_sense_clarification": "стачивать острый край или угол"
                            },
                            {
                                "target_lang_word": "скашивать",
                                "target_lang_sense_clarification": "делать край наклонным"
                            }
                        ]
                    }
                }
            ]
        },
