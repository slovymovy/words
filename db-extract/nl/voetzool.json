                "translations": [
                    {
                        "translation_id": "f2216aeb-3851-40c5-8564-05532d2ed2bf",
                        "source_entry_id": "a7e8df3a-6986-32b5-b4ce-48eb76f916a7",
                        "source_sense_id": "094e873f-c874-3b70-92f9-f1b7bb249e86",
                        "source_sense_description": "de onderzijde van de voet",
                        "target_lang_word": "Fußsohle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußsohle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                        "entry_id": "40745089-05a0-3ce9-a68f-4313cce1f030",
                                        "glosses": [
                                            "die Unterseite des Fußes, mit der man beim Gehen auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b44c69-a2a1-45b0-b074-e89abc875917",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "Meine Fußsohle ist von Blasen übersät."
                                            },
                                            {
                                                "example_id": "d6d9170c-1e4e-4b85-ac17-a5637c8ca50b",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "Von der langen Wanderung tun mir die Fußsohlen weh."
                                            },
                                            {
                                                "example_id": "a3cd0160-5cfb-46d4-a6e6-790b1e7a85dd",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "„Lamm begann es zu schwindeln, und mich strengte das Anziehen der Fußspitze immer mehr an, und ich fühlte das Blut an der Fußsohle klopfen.“"
                                            },
                                            {
                                                "example_id": "1dfc1ce3-1812-47e7-9d8b-583763d4ceb4",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "„Bei jedem Schritt klatschten die Badeschlappen an seine Fußsohlen.“"
                                            },
                                            {
                                                "example_id": "72ed5686-1227-4434-a350-564ec327e905",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "„Die Slipper klatschen beim Gehen gegen ihre Fußsohlen.“"
                                            },
                                            {
                                                "example_id": "342f8939-8636-4828-9771-c9b728d65e39",
                                                "sense_id": "2971a552-ae9d-30c0-989f-fe1df77cf2e3",
                                                "text": "„Man kann Jón Hreggvidssons Fußsohlen von unten sehen, wie er da oben auf dem Dach sitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edac8ba7-a072-486e-a91b-74d13f06bccb",
                        "source_entry_id": "a7e8df3a-6986-32b5-b4ce-48eb76f916a7",
