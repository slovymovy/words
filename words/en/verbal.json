                    "sense_definition": "Aggressive speech or abuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player gave the referee a bit of <w>verbal</w> after the foul was called.",
                            "target_lang_translations": {
                                "ru": "Игрок высказал судье порцию <w>ругани</w> после того, как был зафиксирован фол.",
                                "zh": "犯规判罚后，球员对裁判进行了一番<w>辱骂</w>。",
                                "es": "El jugador le dedicó unos cuantos <w>insultos</w> al árbitro después de que se pitara la falta."
                            }
                        },
                        {
                            "text": "I don't want any <w>verbal</w> from you, just do as you are told.",
                            "target_lang_translations": {
                                "ru": "Я не хочу слышать от тебя никаких <w>пререканий</w>, просто делай, что тебе говорят.",
                                "zh": "我不想听你<w>顶嘴</w>，照我说的做就行。",
                                "es": "No quiero <w>discusiones</w> de tu parte, solo haz lo que se te dice."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give it the verbal"
