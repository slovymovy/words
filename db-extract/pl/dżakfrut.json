                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3178fde-dbca-4471-9626-5c788f1fb20b",
                        "source_entry_id": "69d03133-4951-319a-8d10-811e14e0cf3b",
                        "source_sense_id": "59e639ea-8204-3269-9d43-e52a1826ca00",
                        "target_lang_word": "jackfruit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jackfruit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c32def40-ab50-37b5-8dbd-3a9872077ace",
                                        "entry_id": "60d16e01-bc69-3e77-8266-4fb51de9b675",
                                        "glosses": [
                                            "A tree, Artocarpus heterophyllus, of the Moraceae family, which produces edible fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e11a45c7-9be3-4c58-a0f9-5edef1b90351",
                                                "sense_id": "c32def40-ab50-37b5-8dbd-3a9872077ace",
                                                "text": "On our return we stopped at Mr. Wijeysakera's home, quaffed the juice of King Cocoanut, looked through his extensive grounds, and saw several kinds of palm, the breadfruit-tree, the jackfruit-tree, the nux-vomica-tree, pimento or allspice shrub, nutmeg-tree, pineapples of different varieties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97447757-1366-31e4-986f-16dd5604a79e",
                                        "entry_id": "60d16e01-bc69-3e77-8266-4fb51de9b675",
                                        "glosses": [
                                            "The large fruit from this tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6bc7759-c5fb-4565-a12b-7e8c69c90772",
                                                "sense_id": "97447757-1366-31e4-986f-16dd5604a79e",
                                                "text": "The fruit grows on the branches from the axil of the leaves, and attains the size of a cantaloupe melon, but more oval, and generally eight to ten inches long; it has a stalk proportioned to its size, and exactly resembles the jackfruit, which is known to all those who have journeyed to the Indies."
                                            },
                                            {
                                                "example_id": "69e072e7-9f71-482d-b0d0-735312c7c4e9",
                                                "sense_id": "97447757-1366-31e4-986f-16dd5604a79e",
                                                "text": "Some fun meatless recipes include jackfruit sandwiches in place of pulled pork; black bean meatless balls or eggplant and shiitake “meatballs.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c920429-025b-43ec-86ac-af0ad23a29a7",
                        "source_entry_id": "69d03133-4951-319a-8d10-811e14e0cf3b",
                        "source_sense_id": "59e639ea-8204-3269-9d43-e52a1826ca00",
                        "target_lang_word": "jacquier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jacquier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                        "entry_id": "7eb6336f-3737-303a-8d72-1834c1c008ee",
                                        "glosses": [
                                            "Variante de jaquier par rapprochement populaire avec Jacques."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3511bf3a-3188-4610-b913-6aef2b432b60",
                                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                                "text": "Le mandarin admira les serpents et les liserons sculptés qui s’enroulaient autour des colonnes en bois de jacquier devant l’entrée des demeures."
                                            },
                                            {
                                                "example_id": "039f5b3e-3fad-48d4-83e2-57c01b03e487",
                                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                                "text": "Les plantes cultivées dans ces vergers sont variées ; bananiers, manguiers, sapotilliers, papayers, jacquiers, goyaviers, cocotiers, aréquiers, citronniers, pamplemoussiers, selon l’étude du géographe Jean Delvert."
                                            },
                                            {
                                                "example_id": "6289bb8b-af5d-493c-962c-12bdaafe7f6b",
                                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                                "text": "Le jacquier, ou pomme de Jacque, est employé dans la cuisine végétarienne indienne. Au-delà de l’Asie, sa commercialisation connait une forte augmentation dans les pays occidentaux depuis peu."
                                            },
                                            {
                                                "example_id": "f7ae5d6e-9027-4e35-a90f-e0b7c2325233",
                                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                                "text": "Ce jour-là, le père transporte Sin sur son vélo, ainsi que des blocs de latex empilés, un grand fruit du jacquier et quelques corossols qu’il n’a pas eu le cœur de jeter, il compte les échanger en ville contre du riz et de la viande."
                                            },
                                            {
                                                "example_id": "a2d0cc5b-f968-4b66-9841-36537760b6ac",
                                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                                "text": "Je me suis mise incontinent à rêver que les jardins de la Tour, jusqu’ici inexplorés, se réservaient à l’arbre exotique, à la mangue et au chérimoya ou anone —, qui sait ? au gigantesque fruit du jacquier…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31be70b3-085c-4c53-bb88-24632b94520c",
                        "source_entry_id": "69d03133-4951-319a-8d10-811e14e0cf3b",
                        "source_sense_id": "59e639ea-8204-3269-9d43-e52a1826ca00",
                        "target_lang_word": "Jackfrucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jackfrucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39b9bac0-6466-3bf9-91fb-72e01d18cd08",
                                        "entry_id": "2d91c62e-6460-3800-befe-25d0d7ebbf72",
                                        "glosses": [
                                            "essbare Frucht des aus Indien stammenden Jackfruchtbaums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40031091-12e3-4735-9888-d9bfe28edd1a",
                                                "sense_id": "39b9bac0-6466-3bf9-91fb-72e01d18cd08",
                                                "text": "„Er mariniert rohen Fisch zu köstlichen Salaten, schnipselt die süße Kartoffel der Insel, zaubert würzige Garnelencurrys und preist die süße Jackfrucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
