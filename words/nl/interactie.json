            "senses": [
                {
                    "sense_id": "78389228-cb07-35c5-ab17-765a62870550",
                    "sense_definition": "De manier waarop mensen of dingen op elkaar reageren en elkaar beïnvloeden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wisselwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>interactie</w> tussen de leraar en de leerlingen was erg positief tijdens de les.",
                            "target_lang_translations": {
                                "en": "The <w>interaction</w> between the teacher and the students was very positive during the lesson."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>interactie</w> tussen de spelers zal een voetbalploeg nooit scoren.",
                            "target_lang_translations": {
                                "en": "Without good <w>interaction</w> between the players, a football team will never score."
                            }
                        }
                    ],
                    "synonyms": [
                        "wisselwerking"
                    ],
                    "common_phrases": [
                        "sociale interactie",
                        "interactie tussen mensen"
                    ],
                    "target_lang_definitions": {
