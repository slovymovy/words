                    "sense_definition": "opnieuw <w>schatten</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schatting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De expert moest de waarde van het antieke meubelstuk nog een keer <w>overschatten</w>.",
                            "target_lang_translations": {
                                "en": "The expert had to <w>re-evaluate</w> the value of the antique piece of furniture once more."
                            }
                        },
                        {
                            "text": "Na de verbouwing liet de eigenaar het huis <w>overschatten</w> voor de verzekering.",
                            "target_lang_translations": {
                                "en": "After the renovation, the owner had the house <w>re-appraised</w> for insurance purposes."
                            }
                        }
                    ],
                    "synonyms": [
                        "herschatten"
                    ],
                    "target_lang_definitions": {
