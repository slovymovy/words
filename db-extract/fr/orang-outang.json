                "senses": [
                    {
                        "sense_id": "54d2ee48-4255-3de9-9f3b-a161b37907a3",
                        "entry_id": "33fc08c5-d33d-30e8-954e-68723658fb28",
                        "glosses": [
                            "Grand singe sans queue, dont la taille et la conformation se rapprochent de celles de l’homme."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e6cba7dd-9f5d-4384-b49b-5073fe520af4",
                                "sense_id": "54d2ee48-4255-3de9-9f3b-a161b37907a3",
                                "text": "L’orang-outang est, de tous les grands singes, celui qui interroge le plus les fondements de l’humanisme moderne, autrement dit des Lumières."
                            },
                            {
                                "example_id": "a16cc43d-1618-427f-a19e-528152eb7dab",
                                "sense_id": "54d2ee48-4255-3de9-9f3b-a161b37907a3",
                                "text": "Des orangs-outangs."
                            },
                            {
                                "example_id": "1b9c8862-60aa-4199-b8ad-2fadb45671e3",
                                "sense_id": "54d2ee48-4255-3de9-9f3b-a161b37907a3",
                                "text": "Un gros caillou pris dans la cour vola sur un grand camion noir garni d’orangs-outangs vachards."
                            }
                        ]
                    }
                ],
