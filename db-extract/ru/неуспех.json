                        "examples": [
                            {
                                "example_id": "e35f9b93-3e50-4ef3-8729-ca8fddfe1806",
                                "sense_id": "91668a87-8359-3f7a-a6c0-cc025702fc30",
                                "text": "Вам не дались чины, по службе неуспех?"
