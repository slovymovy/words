                "senses": [
                    {
                        "sense_id": "f72fb674-c924-3e6f-97c1-1b5e62ec4b25",
                        "entry_id": "c61aa1a4-da6a-3c14-816e-cc05725cb3e6",
                        "glosses": [
                            "weibliche Person, die zu Fuß unterwegs ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8091272-505e-4d4a-858f-4b4f94081719",
                                "sense_id": "f72fb674-c924-3e6f-97c1-1b5e62ec4b25",
                                "text": "Die Fußgängerin lief die Straße bis zur Kreuzung entlang."
                            },
                            {
                                "example_id": "3474ede2-9a9d-4ede-99a1-4735a83ab537",
                                "sense_id": "f72fb674-c924-3e6f-97c1-1b5e62ec4b25",
                                "text": "„Die Fahrerin hätte jedoch auf Grund des außergewöhnlichen Verhaltens der Fußgängerin ihre Geschwindigkeit reduzieren und bremsbereit sein müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aefcc09f-9162-45ef-8b8b-2e759459f73f",
                        "source_entry_id": "c61aa1a4-da6a-3c14-816e-cc05725cb3e6",
                        "source_sense_id": "f72fb674-c924-3e6f-97c1-1b5e62ec4b25",
                        "source_sense_description": "weibliche Person, die zu Fuß unterwegs ist",
                        "target_lang_word": "piétonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piétonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b61ecec2-6ce0-3725-a768-db80443be8d6",
                                        "entry_id": "15ab537c-a57f-30e4-ab97-9b3c463bc644",
                                        "glosses": [
                                            "Femme piéton ou fille piétonne. Piéton de sexe féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ad98cd-f194-4668-b907-d94cc40e1cf2",
                                                "sense_id": "b61ecec2-6ce0-3725-a768-db80443be8d6",
                                                "text": "Le conducteur au volant d'un véhicule qui a renversé une piétonne, X; demeurant à lllkirch-Graffenstaden, dans la nuit de dimanche à lundi, rue du Général Leclerc, à Strasbourg, il a échangé quelques mots avec la victime avant de prendre la fuite, […]."
                                            },
                                            {
                                                "example_id": "e3a667db-976e-4437-b4ad-9edffe23f822",
                                                "sense_id": "b61ecec2-6ce0-3725-a768-db80443be8d6",
                                                "text": "Je ne dormais plus, ne m'alimentais plus, et me surprenais à soupçonner toutes les piétonnes foulant l'asphalte, en les imaginant dans les bras de Jonathan."
                                            },
                                            {
                                                "example_id": "90353f3c-c11e-4e65-9786-b3091b0d2dc6",
                                                "sense_id": "b61ecec2-6ce0-3725-a768-db80443be8d6",
                                                "text": "Edmonton, qui a adopté dès 2015 une stratégie de sécurité routière Vision zéro, a observé une tendance à la baisse constante de toutes les formes de blessures et décès de la route. Depuis l’adoption de Vision zéro, la ville a connu une baisse de 50 % des collisions routières mortelles. Chez les piétonnes et piétons, les blessures graves ont diminué de 32 % et les décès de 27 %."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piétonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bdbc531-196a-310f-b722-80020ca72237",
                                        "entry_id": "37d6ddf3-4eb1-3b29-b566-7049e6822e1f",
                                        "glosses": [
                                            "Féminin singulier de piéton."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84717d7-0620-491f-88c6-13df9a85c04b",
                                                "sense_id": "8bdbc531-196a-310f-b722-80020ca72237",
                                                "text": "Dans cette ruelle piétonne, jonchée de pavés, quelques rares réverbères anciens procurent une faible lueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f290c4c1-1b0c-400f-916b-04731075b415",
                        "source_entry_id": "c61aa1a4-da6a-3c14-816e-cc05725cb3e6",
