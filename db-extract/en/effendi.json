                                            {
                                                "example_id": "ee0d54b8-c823-4e7f-8de5-4ce23ba5cf90",
                                                "sense_id": "d8a2e0d1-cad3-3cab-8b44-b5691400ab5d",
                                                "text": "„Ein liebenswürdiger Türke, der Effendi genannt wurde, weil er Minister für auswärtige Angelegenheiten gewesen war, berichtete, er habe in Rom einen Freund in der Person des venezianischen Gesandten, und war voll des Lobes über ihn.“"
                                            },
                                            {
                                                "example_id": "ab08b2ae-ac83-42a9-a7b6-4e9ffa22968d",
                                                "sense_id": "d8a2e0d1-cad3-3cab-8b44-b5691400ab5d",
                                                "text": "„Nun kam einer, der mir gefiel, ein Effendi mit dunkelgrünem Tarbusch auf dem Kopf, dem osmanischen Fez.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
