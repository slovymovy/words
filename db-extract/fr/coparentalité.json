                        "entry_id": "b7740615-584c-3b3f-9294-89c80aca1ed9",
                        "glosses": [
                            "Parentalité partagée par des parents non-mariés, pacsés, divorcés ou homosexuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1e2eee-702d-41b0-80d3-3e136b2d9cf9",
                                "sense_id": "073aa42f-82fa-3452-95ce-1603c44b7a0a",
                                "text": "La coparentalité est une formule de parentalité par laquelle une femme et un homme décident d’avoir un enfant ensemble, sans pour autant former un couple."
                            },
                            {
                                "example_id": "66e7abda-d500-4a64-85cb-711542e737c4",
                                "sense_id": "073aa42f-82fa-3452-95ce-1603c44b7a0a",
                                "text": "Comme pour tout couple homosexuel, trois moyens de devenir parents se présentent à mes interlocuteurs : la coparentalité, l’adoption et l’assistance médicale à la procréation (AMP)."
                            }
                        ]
                    }
                ],
