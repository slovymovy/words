                        "examples": [
                            {
                                "example_id": "1d2888a6-f40a-4b3a-a619-edba84b388f8",
                                "sense_id": "461bd653-deca-3167-916e-2affd1f15626",
                                "text": "De galoppas is hetzelfde als een chassee. Voortbewegen met een sprongetje waarbij telkens het zelfde been ‘voorop’ blijft. Met het achterste been wordt het voorste ‘weggeschopt’"
                            },
