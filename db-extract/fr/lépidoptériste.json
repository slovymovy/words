                    {
                        "sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                        "entry_id": "f9112c18-ff78-30a5-9dc9-6916693ae334",
                        "glosses": [
                            "Entomologiste spécialisé dans les lépidoptères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9ca763-5af0-4281-baf7-1c144426d3e8",
                                "sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                                "text": "M. Henri Menier, lépidoptériste très distingué."
                            },
                            {
                                "example_id": "bab26e07-da58-48c3-bb3e-5b98fb5bddc3",
                                "sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                                "text": "Au mitan du siècle, le nombre d’“auréliens” – ainsi que les lépidoptéristes se qualifient eux-mêmes en usant d’un latinisme désignant la chrysalide – explose ; il n’est pas une ville qui ne compte un club, pas un comté qui n’ait sa revue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd37d1fb-6065-4be2-94d2-ee67bdd82a7e",
                        "source_entry_id": "f9112c18-ff78-30a5-9dc9-6916693ae334",
                        "source_sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                        "target_lang_word": "Lepidopterologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lepidopterologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d858988c-6d83-3b77-aff8-0827ef79eb51",
                                        "entry_id": "2ae1fe84-58b2-3cca-b61d-d0d9e9d375c7",
                                        "glosses": [
                                            "Experte für Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4336f701-deae-44ea-8cac-e48b8a8bbb06",
                                                "sense_id": "d858988c-6d83-3b77-aff8-0827ef79eb51",
                                                "text": "„Die Arten, die meiner Sammlung fehlten, habe ich durch Tausch mit verschiedenen Lepidopterologen aus dem In- und Ausland ergänzt.“"
                                            },
                                            {
                                                "example_id": "f3018fe0-f56e-4677-aafc-43b227ca732e",
                                                "sense_id": "d858988c-6d83-3b77-aff8-0827ef79eb51",
                                                "text": "„Er sammelte die Krankheiten seiner Patienten wie ein Lepidopterologe Schmetterlinge sammelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d015cb5-445e-4577-9a40-86625a3d46ff",
                        "source_entry_id": "f9112c18-ff78-30a5-9dc9-6916693ae334",
                        "source_sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                        "target_lang_word": "Lepidopterologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lepidopterologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a43e69-9c5d-389f-941b-14eb9b5b36d9",
                                        "entry_id": "b1ccd03b-0b9a-3730-b579-c04eff5d4239",
                                        "glosses": [
                                            "Expertin für Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f64a23-d90d-42cf-92a9-1ef38fc91b91",
                                                "sense_id": "e2a43e69-9c5d-389f-941b-14eb9b5b36d9",
                                                "text": "Die Zoologin hatte sich schon früh entschlossen, als forschende Lepidopterologin tätig zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba482cd9-b00d-46ca-9fc6-1d513f832a53",
                        "source_entry_id": "f9112c18-ff78-30a5-9dc9-6916693ae334",
                        "source_sense_id": "1a58f71c-2536-3a4d-ae86-bf4a11974e48",
                        "target_lang_word": "Schmetterlingskundler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmetterlingskundler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                        "entry_id": "9373a6af-c50f-3127-9903-5318fde1004b",
                                        "glosses": [
                                            "Experte für Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2208324e-ffac-421a-8913-e04fdb31177f",
                                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                                "text": "„Der Schmetterlingskundler Robert Trusch, Kurator Naturkundemuseum in Karlsruhe, sieht wie viele seiner Fachkollegen die Agrargifte, besonders die Neonicotinoide, als einen der Hauptfaktoren für das Insektensterben.“"
                                            },
                                            {
                                                "example_id": "18ced1b1-024d-40e5-abfd-613a33fe4cea",
                                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                                "text": "„Sieben Jahre lang arbeitete er als Schmetterlingskundler an der Universität Harvard im Institut für vergleichende Zoologie.“"
                                            },
                                            {
                                                "example_id": "b1fc6d78-479d-49ac-8599-a7dbef448c40",
                                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                                "text": "„Dass Schmetterlingskundler und Ornithologen sich grämen, wenn der Bestand einer Art nicht mehr gesichert ist oder sie gänzlich aus ihrem Lebensraum verschwindet, will man ja gerne zugestehen.“"
                                            },
                                            {
                                                "example_id": "602b713f-5dd1-4073-a819-c2b7f2b84c19",
                                                "sense_id": "fdb51dd6-443a-32dc-870f-a05803eaab23",
                                                "text": "„Der Schmetterlingskundler Jim Miller vom American Museum of Natural History beschrieb Pseudoricia flavizoma, eine verblüffend hübsche Motte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
