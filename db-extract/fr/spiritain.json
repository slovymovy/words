                    {
                        "sense_id": "7db6ecf8-3b17-3e7e-b96f-e47e0a89d4f5",
                        "entry_id": "97dd9025-2d4b-37ab-8fc9-693abe8e6429",
                        "glosses": [
                            "Relatif, qui appartient à la congrégation du Saint-Esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59881931-8596-48a8-9ed3-8683a10aca07",
                                "sense_id": "7db6ecf8-3b17-3e7e-b96f-e47e0a89d4f5",
                                "text": "La communauté spiritaine."
                            },
                            {
                                "example_id": "1640c5df-a285-4e75-9386-929baf6676e0",
                                "sense_id": "7db6ecf8-3b17-3e7e-b96f-e47e0a89d4f5",
                                "text": "D'abord médecin puis curé de campagne en Normandie, le bienheureux Jacques-Désiré Laval (1803-1864) fut, pendant les vingt-trois dernières années de sa vie, missionnaire spiritain à l’Île Maurice."
                            },
                            {
                                "example_id": "4d7e6f64-19c0-41aa-88d1-837fe9831059",
                                "sense_id": "7db6ecf8-3b17-3e7e-b96f-e47e0a89d4f5",
                                "text": "Notre case avait un sol en terre, aucun meuble, mais une paix tranquille. Au centre du village, la maison des pères spiritains, des missionnaires français. J’allais à la messe tous les matins."
                            }
                        ]
                    },
