                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеченный",
                                "target_lang_sense_clarification": "о листьях или поверхностях с глубокими разрезами"
                            },
                            {
                                "target_lang_word": "раздвоенный",
                                "target_lang_sense_clarification": "имеющий форму с двумя расходящимися частями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4606782d-a9a4-359b-8a98-f9f5ff26dc1a",
                    "sense_definition": "Having a specific number of sections or divisions",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>parted</w> structure of the essay made it easier to read.",
                            "target_lang_translations": {
                                "ru": "<w>Разделенная</w> на части структура эссе облегчила его чтение."
                            }
                        },
                        {
                            "text": "He designed a <w>parted</w> container to hold different types of seeds.",
                            "target_lang_translations": {
                                "ru": "Он спроектировал <w>разделенный</w> на отсеки контейнер для хранения разных видов семян."
                            }
                        }
                    ],
                    "synonyms": [
                        "divided",
                        "segmented"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из нескольких секций или отделений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделенный",
