                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e45590-2e55-4c76-9858-03808d85d250",
                                                "sense_id": "780f29c7-bac9-3597-8ea9-cbb88e071ca9",
                                                "text": "You know, we got Russian subs creepin' around; anythin' goes wrong they can say whatever they want happened! Give their folks medals!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a2cabc-fd10-3527-8228-a43457dd3dd5",
                                        "entry_id": "00cba8d9-c51e-3d9f-94a6-9105100353c2",
                                        "glosses": [
                                            "Clipping of submarine sandwich: a sandwich made on a long bun."
                                        ],
                                        "tags": [
