                "senses": [
                    {
                        "sense_id": "6ad88f05-582e-3148-aaf2-5c43226463f6",
                        "entry_id": "9ad4396e-4c1f-3cf5-8135-c6e103c47b2c",
                        "glosses": [
                            "Action de superviser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad08f5c9-4018-44f2-8c3d-fe9b8e4043cd",
                                "sense_id": "6ad88f05-582e-3148-aaf2-5c43226463f6",
                                "text": "L'organisation et la supervision du référendum et des élections sont assurées par une Commission indépendante dans les conditions prévues par la loi."
                            },
                            {
                                "example_id": "fac67a85-5dfb-463a-802e-1d0c5550fdb0",
                                "sense_id": "6ad88f05-582e-3148-aaf2-5c43226463f6",
                                "text": "La maîtrise d'œuvre d'une chaufferie hybride suppose une formation préalable minimum de thermodynamicien permettant d'assurer une supervision efficace lors de la réalisation, puis de la mise en service."
                            },
                            {
                                "example_id": "25066d10-e5b7-4416-9bc9-315f85068a24",
                                "sense_id": "6ad88f05-582e-3148-aaf2-5c43226463f6",
                                "text": "Ce n’est pas l’aspect plagiat, mais celui de « supervision » qui sera le pire. Lorsque le fédéral en profitera pour imposer des normes, des objectifs, etc., et menacera de retenir des sommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e24b5a53-6858-3420-b994-912190ad0cc9",
                        "entry_id": "9ad4396e-4c1f-3cf5-8135-c6e103c47b2c",
                        "glosses": [
                            "Technique de suivi et de pilotage informatique de procédés de fabrication automatisés."
