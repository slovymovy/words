    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac83ce14-46b4-3e81-880e-480dad656dc7",
                    "sense_definition": "grap die men met iemand uithaalt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hadden hem een flinke <w>poets</w> gebakken.",
                            "target_lang_translations": {
                                "it": "Gli hanno giocato un brutto <w>scherzo</w>."
                            }
                        },
                        {
                            "text": "Het was een gemene <w>poets</w> om de sleutels te verstoppen.",
                            "target_lang_translations": {
                                "it": "È stato un <w>tiro mancino</w> cattivo nascondere le chiavi."
                            }
                        }
                    ],
                    "synonyms": [
                        "prank"
                    ],
                    "common_phrases": [
                        "iemand een poets bakken"
                    ],
                    "target_lang_definitions": {
                        "it": "Scherzo o burla giocata a qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scherzo",
                                "target_lang_sense_clarification": "azione fatta per divertimento o per ingannare qualcuno"
                            },
                            {
                                "target_lang_word": "tiro mancino",
                                "target_lang_sense_clarification": "un'azione dispettosa o un inganno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc4d0d8-a1a8-3a67-abc0-0904c19ea240",
                    "sense_definition": "vloeibaar hulpmiddel om iets mee te poetsen",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "middel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Breng de <w>poets</w> erop aan voor een glanzend resultaat.",
                            "target_lang_translations": {
                                "it": "Applica il <w>lucidante</w> per un risultato brillante."
                            }
                        },
                        {
                            "text": "Deze <w>poets</w> werkt uitstekend op zilveren voorwerpen.",
                            "target_lang_translations": {
                                "it": "Questo <w>detergente</w> funziona benissimo sugli oggetti d'argento."
                            }
                        }
                    ],
                    "synonyms": [
                        "poetsmiddel"
                    ],
                    "target_lang_definitions": {
                        "it": "Prodotto liquido o sostanza usata per pulire o lucidare superfici."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lucidante",
                                "target_lang_sense_clarification": "prodotto per rendere lucide le superfici"
                            },
                            {
                                "target_lang_word": "detergente",
                                "target_lang_sense_clarification": "prodotto generico per la pulizia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d58c3f6-16d4-3032-aef1-53507f2b0740",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>poetsen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>poets</w> elke avond mijn tanden voor het slapengaan.",
                            "target_lang_translations": {
                                "it": "Ogni sera, prima di andare a dormire, mi <w>pulisco</w> i denti."
                            }
                        },
                        {
                            "text": "Ik <w>poets</w> de schoenen voordat ik naar buiten ga.",
                            "target_lang_translations": {
                                "it": "Prima di uscire, <w>spazzolo</w> le scarpe."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prima persona singolare del verbo pulire o spazzolare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pulisco",
                                "target_lang_sense_clarification": "forma verbale di pulire"
                            },
                            {
                                "target_lang_word": "spazzolo",
                                "target_lang_sense_clarification": "forma verbale di spazzolare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1172847-8f76-318f-ba9b-0e197207c52f",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>poetsen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Poets</w> jij ook altijd je tanden na het eten?",
                            "target_lang_translations": {
                                "it": "<w>Pulisci</w> sempre i denti dopo aver mangiato?"
                            }
                        },
                        {
                            "text": "Waarom <w>poets</w> jij je auto zo vaak?",
                            "target_lang_translations": {
                                "it": "Perché <w>pulisci</w> così spesso la tua auto?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Seconda persona singolare del verbo pulire o spazzolare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pulisci",
                                "target_lang_sense_clarification": "forma verbale di pulire"
                            },
                            {
                                "target_lang_word": "spazzoli",
                                "target_lang_sense_clarification": "forma verbale di spazzolare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5320ddb9-af49-300a-96d3-936179413198",
                    "sense_definition": "gebiedende wijs van <w>poetsen</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Poets</w> nu je tanden en ga naar bed.",
                            "target_lang_translations": {
                                "it": "<w>Pulisci</w> i denti adesso e vai a letto."
                            }
                        },
                        {
                            "text": "<w>Poets</w> de tafel goed schoon met dit doekje.",
                            "target_lang_translations": {
                                "it": "<w>Pulisci</w> bene il tavolo con questo panno."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma imperativa del verbo pulire o spazzolare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pulisci",
                                "target_lang_sense_clarification": "imperativo del verbo pulire"
                            },
                            {
                                "target_lang_word": "spazzola",
                                "target_lang_sense_clarification": "imperativo del verbo spazzolare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
