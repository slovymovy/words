                ],
                "senses": [
                    {
                        "sense_id": "236f1b78-d4b4-3879-b0ca-e23ca10a85d3",
                        "entry_id": "ba53bf5a-6a06-3259-ab94-8b77f22ae410",
                        "glosses": [
                            "wichtigste Aussagekraft, Bedeutung unter mehreren"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "435f02e1-9c56-434b-8cc9-e59af75c4a74",
                                "sense_id": "236f1b78-d4b4-3879-b0ca-e23ca10a85d3",
                                "text": "Bei den Beratungen lag der Hauptakzent naturgemäß auf dem Aspekt der Finanzierbarkeit."
                            },
                            {
                                "example_id": "37826f0f-aad3-49ee-ab39-19aadc88ff86",
                                "sense_id": "236f1b78-d4b4-3879-b0ca-e23ca10a85d3",
                                "text": "„Ohne Zweifel lag der Hauptakzent der karolingischen Bildungsreform auf dem religiösen Sektor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96869421-66e4-3626-aab4-ccf1ade0da4d",
                        "entry_id": "ba53bf5a-6a06-3259-ab94-8b77f22ae410",
                        "glosses": [
                            "die am stärksten betonte Stelle in einem komplexen Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d9127e-1472-4644-9f90-fc08a57fbeee",
                                "sense_id": "96869421-66e4-3626-aab4-ccf1ade0da4d",
                                "text": "„Noch heute bedingt ein relativ starkes akzentuelles Gefälle zwischen Hauptakzent und unbetonten Silben, daß diese ausfallen können.“"
                            },
                            {
                                "example_id": "d1652b08-8d4c-431c-91a5-8f7c8b549977",
                                "sense_id": "96869421-66e4-3626-aab4-ccf1ade0da4d",
                                "text": "„Wie die Beispiele zeigen, liegt der Hauptakzent dabei im zweiten Wort.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
