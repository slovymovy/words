                                                "sense_id": "a677dfed-8f6d-3bfc-b7fc-ed9de1a67dc6",
                                                "text": "Tonight is the night."
                                            },
                                            {
                                                "example_id": "1c0ad61c-ef44-4f5d-8fa1-d3aea60cdb1c",
                                                "sense_id": "a677dfed-8f6d-3bfc-b7fc-ed9de1a67dc6",
