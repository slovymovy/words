                "senses": [
                    {
                        "sense_id": "ef7ab1ab-abb7-39dd-97c0-1b599d96f6e6",
                        "entry_id": "ba0701d5-7d7c-301e-bfb8-5485e95c2cbb",
                        "glosses": [
                            "ein milliardstel Gramm"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "23590abe-a34d-45d7-876a-bfefe1a47084",
                                "sense_id": "ef7ab1ab-abb7-39dd-97c0-1b599d96f6e6",
                                "text": "„Der Vitamin-D-Spiegel im Blut sollte mindestens 20 Nanogramm pro Liter betragen, was mit der Einnahme von 600 Einheiten Vitamin D pro Tag erreicht würde.“"
                            },
                            {
                                "example_id": "e0dc7c45-467b-42fe-b90e-e3fa5b6c4827",
                                "sense_id": "ef7ab1ab-abb7-39dd-97c0-1b599d96f6e6",
                                "text": "„Gemäß einer Untersuchung von Forschern aus Wien und Graz haben 26 Prozent der Erwachsenen in Österreich einen Vitamin-D-Spiegel von weniger als zwölf Nanogramm pro Liter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
