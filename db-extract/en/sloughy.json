                "senses": [
                    {
                        "sense_id": "c3e1b5ed-2606-3079-b9c9-9924e8d911f1",
                        "entry_id": "a1e69b84-ea61-3704-b2d4-12da03214d2a",
                        "glosses": [
                            "Having the characteristics of a wetland; marshy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec9d740a-ebd8-4bcb-b43d-d486f9e60905",
                                "sense_id": "c3e1b5ed-2606-3079-b9c9-9924e8d911f1",
                                "text": "Neither should that odious custom be allowed, of cutting scraws, (as they call them) which is flaying off the green surface of the ground, to cover their cabins; or make up their ditches; sometimes in shallow soils, where all is gravel within a few inches; and sometimes in low ground, with a thin greensward, and sloughy underneath; which last turns all into bog, by this mismanagement."
                            },
                            {
                                "example_id": "ec6cb562-622a-471d-b43e-ae9d62f06ec8",
                                "sense_id": "c3e1b5ed-2606-3079-b9c9-9924e8d911f1",
                                "text": "The Swedish Reform Church was in a sloughy, weedy district, near a group of factories."
                            }
                        ]
                    }
                ],
