                ],
                "senses": [
                    {
                        "sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
                        "entry_id": "b9394cd2-03ce-3fb4-95c6-05e3cb6f8653",
                        "glosses": [
                            "Action de fiscaliser, de taxer, d'imposer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba48d3f6-d30f-46b1-9e4e-20c9156a0011",
                                "sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
                                "text": "Il peut paraître injustifié de faire financer la protection sociale uniquement par le monde du travail, par le biais des cotisations salariales, d'où une tendance généralisée à la fiscalisation de la protection sociale, dont la TVA sociale serait un élément."
                            },
                            {
                                "example_id": "3e30edb2-abcb-4f75-a33d-7ea43af21314",
                                "sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
                                "text": "La fiscalisation différée du système de retraite par capitalisation place donc ce système à égalité de traitement fiscal avec la retraite par répartition."
                            },
                            {
                                "example_id": "5a1a27b2-094f-4106-8574-784e697c05c7",
                                "sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
                                "text": "Pour stopper la progression des transports aériens (les avions ne paient aucun impôt sur le CO2 qu’ils émettent et sont parmi les plus gros pollueurs de la planète) il faut instaurer une fiscalisation internationale du kérosène."
                            },
                            {
                                "example_id": "446e408c-1a5b-4b23-8b4f-b49371194879",
                                "sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
                                "text": "Dans ce dernier cas, il s’agit bien d’une fiscalisation des contributions budgétaires et non pas d’une fiscalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e4ba0d3-8def-4a5b-a314-2e55ca788af4",
                        "source_entry_id": "b9394cd2-03ce-3fb4-95c6-05e3cb6f8653",
                        "source_sense_id": "7b9726fe-98bd-3346-8fb7-d098e39c0415",
