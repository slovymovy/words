                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24fa6e0-7728-4f9a-aada-e1f5e1759460",
                                "sense_id": "c89a467d-c7af-3de8-a078-2a16104beb05",
                                "text": "Après avoir concrétisé, certains patients sont à l'affût de toute information dans le but de s'autoconvaincre du bien-fondé de leur choix."
                            },
                            {
                                "example_id": "60519e9a-3e55-4dfb-bc6c-dd0b55a01162",
                                "sense_id": "c89a467d-c7af-3de8-a078-2a16104beb05",
                                "text": "Elle lui permet de s'autoconvaincre de la potentialité et de la vraisemblance d'un retour a baita."
                            }
                        ]
