                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8b3a8ed-4741-3847-a8ad-93f820d923fe",
                        "entry_id": "234796fc-3bf2-3d22-9f0a-932129331cd3",
                        "glosses": [
                            "ćwiczenie fizyczne mięśni brzucha polegające na podnoszeniu tułowia, leżąc na wznak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5efe32bb-b126-417e-ab8d-7eb11aea9a98",
                                "sense_id": "d8b3a8ed-4741-3847-a8ad-93f820d923fe",
                                "text": "Po rozciąganiu, pompkach i brzuszkach uzupełniam swoją codzienną gimnastykę pedałowaniem przez pół godziny na rowerze stacjonarnym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d04e9b35-c3b0-48b7-8790-45ea8d39625e",
                        "source_entry_id": "234796fc-3bf2-3d22-9f0a-932129331cd3",
                        "source_sense_id": "d8b3a8ed-4741-3847-a8ad-93f820d923fe",
                        "target_lang_word": "sit-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sit-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a595d9d-d985-399b-bb04-0c942c81251f",
                                        "entry_id": "e64ee265-8487-3e3b-91ee-cb32b2ffe8f7",
                                        "glosses": [
                                            "An exercise in which the abdominal muscles are contracted, bringing the torso of a person lying down to a more upright position. The degree of difficulty can be controlled by choosing from partial-range or full-range versions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02c9f17-dc80-43dc-a6d7-deb56c7a3e78",
                                                "sense_id": "4a595d9d-d985-399b-bb04-0c942c81251f",
                                                "text": "Susan's doing sit-ups to strengthen her muscles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bea534f3-51c8-42af-9ab7-39ce7930a82a",
                        "source_entry_id": "234796fc-3bf2-3d22-9f0a-932129331cd3",
                        "source_sense_id": "d8b3a8ed-4741-3847-a8ad-93f820d923fe",
                        "target_lang_word": "crunch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "455bfb7c-4131-3dcc-9846-981ce6470571",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To crush something, especially food, with a noisy crackling sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ebae99-a7d3-4ed1-b11d-a73f28fc19e6",
                                                "sense_id": "455bfb7c-4131-3dcc-9846-981ce6470571",
                                                "text": "When I came home, Susan was watching TV with her feet up on the couch, crunching a piece of celery."
                                            },
                                            {
                                                "example_id": "98dc8fa4-d905-40f6-aa28-c84b0f624489",
                                                "sense_id": "455bfb7c-4131-3dcc-9846-981ce6470571",
                                                "text": "And their white tusks crunch'd o'er the whiter skull,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396793c8-1bc8-306b-b571-939bf3f57301",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To be crushed with a noisy crackling sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7622780e-9768-4f90-96b0-8e42213909f8",
                                                "sense_id": "396793c8-1bc8-306b-b571-939bf3f57301",
                                                "text": "Beetles crunched beneath the men's heavy boots as they worked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db38cf4-33ea-3c67-bb14-850c93fc822f",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To calculate or otherwise process (e.g. to crunch numbers: to perform mathematical calculations). Presumably from the sound made by mechanical calculators."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c7601c-aad7-4819-a16b-964b2033cbf5",
                                                "sense_id": "6db38cf4-33ea-3c67-bb14-850c93fc822f",
                                                "text": "That metadata makes it much easier for the search engine to crunch the data for queries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b19f34a-506c-3f9c-84e3-d1427e9f2165",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To grind or press with violence and noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38349d85-159c-426f-bff7-acf8f26207ff",
                                                "sense_id": "0b19f34a-506c-3f9c-84e3-d1427e9f2165",
                                                "text": "The sound of our vessel crunching her way through the new ice is not easy to be described."
                                            },
                                            {
                                                "example_id": "b0fd5c5f-360e-49ac-80cc-ae4635eeabf9",
                                                "sense_id": "0b19f34a-506c-3f9c-84e3-d1427e9f2165",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bdbfad7-4401-3f20-ab39-3c4d6c63b6a1",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To emit a grinding or crunching noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d551bc9-e4c6-433c-9bf6-ff8a8520f543",
                                                "sense_id": "7bdbfad7-4401-3f20-ab39-3c4d6c63b6a1",
                                                "text": "There were sounds in the air above his head – sounds of the crunching and rattling of the loose, smooth stones as his neighbors moved about[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3ce642-2ed8-3b64-ba7c-4ced7b1efee7",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To cause the gears to emit a crunching sound by releasing the clutch before the gears are properly synchronised."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cacdc73-dc0f-3546-80a5-294d78a958c4",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To compress (data) using a particular algorithm, so that it can be restored by decrunching."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc3f3e7-79f4-495b-9289-9b00658646a4",
                                                "sense_id": "4cacdc73-dc0f-3546-80a5-294d78a958c4",
                                                "text": "PackIt will not crunch executables, unless told to do so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bdcbc8b-3fc7-3758-afb6-65fa37f50c18",
                                        "entry_id": "51c05e57-5cfa-3c0b-a0d5-8f20cad3c560",
                                        "glosses": [
                                            "To make employees work overtime in order to meet a deadline in the development of a project."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7989dfbd-ad12-3155-a313-2c2ce9daf7e4",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A noisy crackling sound; the sound usually associated with crunching."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5766c95f-e35f-34ec-ba1c-43de12c5fdd7",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A critical moment or event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "604af6d9-60ce-4b10-92ee-16729274f680",
                                                "sense_id": "5766c95f-e35f-34ec-ba1c-43de12c5fdd7",
                                                "text": "It always pains me (slightly) when a flaming young radical like Neil Miller turns out when the crunch comes to be such an ardent defender of the status quo."
                                            },
                                            {
                                                "example_id": "20fe560a-504c-4ab8-9407-286461c38ddc",
                                                "sense_id": "5766c95f-e35f-34ec-ba1c-43de12c5fdd7",
                                                "text": "The friends, on the contrary, argue that Job does not \"know\", that only God knows; yet, when it comes to the crunch, they themselves seem to know as much as God knows: for example, that Job is a guilty sinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e378e6-ebe8-3a38-8c8a-0060c2581d4e",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A problem that leads to a crisis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab22ab2e-ccb1-4c9c-931c-7f138945661c",
                                                "sense_id": "09e378e6-ebe8-3a38-8c8a-0060c2581d4e",
                                                "text": "The crunch is characterized by extremely depressed liquidity and deteriorated balance sheet positions for households, corporations, and financial institutions[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "224f3a1f-83e8-361e-9742-ae98688be67e",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A form of abdominal exercise, based on a sit-up but in which the lower back remains in contact with the floor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d437ade8-dcb1-4b81-b955-d57c8b59e0b1",
                                                "sense_id": "224f3a1f-83e8-361e-9742-ae98688be67e",
                                                "text": "But even I draw the line at “doing crunches” in designer clothes. Fashion sneakers are for swanking around the shops, not for running in. And so, like everyone else, I wear grotty old tracksuits earmarked for Oxfam, and tragic free festival T-shirts that give away my age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bdc529-6827-31f7-b514-241084f8e237",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "The overtime work required to catch up and finish a project, usually in the final weeks of development before release."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef05294e-c37e-3f45-a978-beab6cac89dc",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A dessert consisting of a crunchy topping with fruit underneath."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac5e0ede-fe64-34aa-b23e-594fe07d6b4d",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "The symbol #."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "712a64ba-bd0b-32cc-96c9-8a02d3bf8f6b",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A small piece created by crushing; a piece of material with a friable or crunchy texture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a58fc479-943a-4b32-b8c5-511cdd53c0fe",
                                                "sense_id": "712a64ba-bd0b-32cc-96c9-8a02d3bf8f6b",
                                                "text": "Smear the peanut butter, fluff, and a bit of the nutella all over, even to the very edge of the wrap. Sprinkle the crunches on top and then start rolling from one of the non-trimmed edges"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823f5fc3-0d93-31d4-b5ec-1ae48a5f0d16",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "A shortage."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d416571-14eb-4602-bc52-714847a34e35",
                                                "sense_id": "823f5fc3-0d93-31d4-b5ec-1ae48a5f0d16",
                                                "text": "But a supply crunch, which is already affecting the drive, could slow it down further."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b146fa2-cb36-3ba5-89df-f428cf30790e",
                                        "entry_id": "bfa750da-15b4-3859-a1da-25048af62e47",
                                        "glosses": [
                                            "Moderate distortion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
