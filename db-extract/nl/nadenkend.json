                        "source_sense_id": "18a7bdf2-070e-36b6-84d4-c89b09ac671f",
                        "target_lang_word": "meditative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meditative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90976127-bf0b-3814-b9e8-39dc718aa4eb",
                                        "entry_id": "615929f1-2b14-3dad-9425-79822916923f",
                                        "glosses": [
                                            "Of or pertaining to meditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e455f19a-6cb0-4749-af9b-8d896af264fe",
                                                "sense_id": "90976127-bf0b-3814-b9e8-39dc718aa4eb",
                                                "text": "Yoga is a meditative practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c054d3-6353-31d2-a213-408a9781bef9",
                                        "entry_id": "615929f1-2b14-3dad-9425-79822916923f",
                                        "glosses": [
                                            "Thoughtful; pensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c5f193-17eb-4a44-96a3-867ad3a33176",
                                                "sense_id": "26c054d3-6353-31d2-a213-408a9781bef9",
                                                "text": "After hearing the news he became meditative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e867d792-0f49-46ac-8d31-9e834386eb9a",
                        "source_entry_id": "fcf62c42-f3b0-309a-a592-0b3895ce2af4",
                        "source_sense_id": "18a7bdf2-070e-36b6-84d4-c89b09ac671f",
                        "target_lang_word": "pensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d796349-0284-3d61-b4d7-aa0b487cf039",
                                        "entry_id": "cbcd577e-81b0-35e3-9f20-9af00563d2d9",
                                        "glosses": [
                                            "Engaged in, involving, or reflecting deep or serious thought."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f7173f5-2297-3b5a-adb4-9439bdcfb79c",
                                        "entry_id": "cbcd577e-81b0-35e3-9f20-9af00563d2d9",
                                        "glosses": [
                                            "Having the appearance of deep, often melancholic, thinking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5e91f50-8776-3714-bb7e-565500a64c87",
                                        "entry_id": "cbcd577e-81b0-35e3-9f20-9af00563d2d9",
                                        "glosses": [
                                            "Looking thoughtful, especially from sadness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39e3491-4843-4c04-9df6-4c8e415d4b7d",
                                                "sense_id": "c5e91f50-8776-3714-bb7e-565500a64c87",
                                                "text": "Through the deep grass the faces of the three children glowed like pensive moons."
                                            },
                                            {
                                                "example_id": "6228680a-9965-471d-9749-0163f7676d02",
                                                "sense_id": "c5e91f50-8776-3714-bb7e-565500a64c87",
                                                "text": "Abstruse thought and profound researches I prohibit, and will severely punish, by the pensive melancholy which they introduce"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deac7549-bc8c-4ba5-8ad7-c3eeb15da936",
                        "source_entry_id": "fcf62c42-f3b0-309a-a592-0b3895ce2af4",
                        "source_sense_id": "18a7bdf2-070e-36b6-84d4-c89b09ac671f",
                        "target_lang_word": "thinking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thinking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46641358-fdb8-357a-b185-754c0ecffb4b",
                                        "entry_id": "75c0bf5b-d84c-3f8f-9d0d-6817c16987ef",
                                        "glosses": [
                                            "Thought; gerund of think."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10c90d7-eadd-4a10-be8a-4536bc656ee8",
                                                "sense_id": "46641358-fdb8-357a-b185-754c0ecffb4b",
                                                "text": "What is your thinking on this subject?"
                                            },
                                            {
                                                "example_id": "3dda3e28-1fab-49ea-9bfd-388b8db04fe0",
                                                "sense_id": "46641358-fdb8-357a-b185-754c0ecffb4b",
                                                "text": "But how the neurons are organised in these lobes and ganglia remains obscure. Yet this is the level of organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                                            },
                                            {
                                                "example_id": "366654e1-e905-4341-9eb4-dd985d23285d",
                                                "sense_id": "46641358-fdb8-357a-b185-754c0ecffb4b",
                                                "text": "When BR \"back-checked\" (BR's term) the financial results of steam replacement across 49 schemes, where DMUs had been substituted on the London Midland Region, only one was now profitable. BR thinking on such substitutions referred to \"betterment\", not profit or loss."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thinking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46858d80-b480-3dd1-8f86-f5af0e7ea295",
                                        "entry_id": "a15c4c95-47f2-3cd8-a0e0-64d57b28c6d7",
                                        "glosses": [
                                            "present participle and gerund of think"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b03287b-bf63-4ba6-96e9-60ea25dc952b",
                                                "sense_id": "46858d80-b480-3dd1-8f86-f5af0e7ea295",
                                                "text": "I'm thinking about inventing a new perpetual-motion machine."
                                            },
                                            {
                                                "example_id": "ae28c82c-d390-43e5-9a18-f7b6b3bfc324",
                                                "sense_id": "46858d80-b480-3dd1-8f86-f5af0e7ea295",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f14eaad2-7e87-4d6a-8da4-1a3d212de81e",
                        "source_entry_id": "fcf62c42-f3b0-309a-a592-0b3895ce2af4",
                        "source_sense_id": "18a7bdf2-070e-36b6-84d4-c89b09ac671f",
                        "target_lang_word": "thoughtful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating thought or careful consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf3dce0-aead-436f-beca-1f26c15b0f33",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Most thoughtful people eventually solve the puzzle."
                                            },
                                            {
                                                "example_id": "ccd4471a-f88c-4800-afec-491fe4899d42",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Now the New Year reviving old Desires,\nThe thoughtful Soul to Solitude retires,\nWhere the White Hand of Moses on the Bough\nPuts out, and Jesus from the Ground suspires."
                                            },
                                            {
                                                "example_id": "9b9a0b42-3fee-46e4-90fe-13b3f0949f21",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating kindness or consideration for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ff19ae-7a1d-47f1-9d28-9695266dc78f",
                                                "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                                "text": "Preparing dinner is a thoughtful gesture for a new mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
