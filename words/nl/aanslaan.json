    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc81120d-bc9b-3458-96e4-f2e1d695c368",
                    "sense_definition": "succes hebben of populair worden bij een bepaald publiek",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "succes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe product <w>sloeg</w> goed <w>aan</w> en er werden direct enorme aantallen verkocht.",
                            "target_lang_translations": {
                                "en": "The new product <w>caught on</w> well and huge numbers were sold immediately."
                            }
                        },
                        {
                            "text": "Zijn nieuwe boek <w>slaat</w> totaal niet <w>aan</w> bij de jongere generatie lezers.",
                            "target_lang_translations": {
                                "en": "His new book doesn't <w>resonate</w> at all with the younger generation of readers."
                            }
                        }
                    ],
                    "synonyms": [
                        "pakken",
                        "scoren"
                    ],
                    "antonyms": [
                        "floppen",
                        "mislukken"
                    ],
                    "common_phrases": [
                        "goed aanslaan",
                        "niet aanslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be successful or become popular with a specific audience"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch on",
                                "target_lang_sense_clarification": "to become popular or fashionable"
                            },
                            {
                                "target_lang_word": "be a hit",
                                "target_lang_sense_clarification": "to be very successful"
                            },
                            {
                                "target_lang_word": "resonate",
                                "target_lang_sense_clarification": "to evoke a positive response"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a9679af-c108-352e-b78b-8d448c18ae3d",
                    "sense_definition": "beginnen te functioneren of te lopen, vaak gezegd van een motor of apparaat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "starten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na vele startpogingen <w>sloeg</w> de motor eindelijk <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "After many starting attempts, the engine finally <w>started up</w>."
                            }
                        },
                        {
                            "text": "De verwarming <w>slaat</w> automatisch <w>aan</w> zodra de temperatuur onder de achttien graden zakt.",
                            "target_lang_translations": {
                                "en": "The heating <w>kicks in</w> automatically as soon as the temperature drops below eighteen degrees."
                            }
                        }
                    ],
                    "synonyms": [
                        "starten",
                        "aangaan"
                    ],
                    "antonyms": [
                        "afsterven",
                        "uitvallen"
                    ],
                    "common_phrases": [
                        "motor slaat aan",
                        "automatisch aanslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To start functioning or running, often said of an engine or device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "start up",
                                "target_lang_sense_clarification": "to begin running (engine)"
                            },
                            {
                                "target_lang_word": "kick in",
                                "target_lang_sense_clarification": "to start operating automatically"
                            },
                            {
                                "target_lang_word": "fire up",
                                "target_lang_sense_clarification": "to start an engine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6fdbe07-a1cf-3128-a845-1c84e8f2dcc7",
                    "sense_definition": "beginnen te blaffen als teken van waarschuwing of alarm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote boerderijhond <w>sloeg</w> <w>aan</w> toen we het erf opkwamen.",
                            "target_lang_translations": {
                                "en": "The large farm dog <w>barked</w> when we entered the yard."
                            }
                        },
                        {
                            "text": "Zodra er iemand langs het hek loopt, <w>slaat</w> de hond luidruchtig <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "As soon as someone walks past the fence, the dog <w>gives tongue</w> loudly."
                            }
                        }
                    ],
                    "synonyms": [
                        "blaffen"
                    ],
                    "common_phrases": [
                        "hond slaat aan"
                    ],
                    "target_lang_definitions": {
                        "en": "To start barking as a sign of warning or alarm"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "to give a warning cry"
                            },
                            {
                                "target_lang_word": "give tongue",
                                "target_lang_sense_clarification": "to start barking (hunting/alarm)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b447e04-4e9b-3cff-96cd-c516d7dc4cc6",
                    "sense_definition": "een toets of snaar aanraken om een klank voort te brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen we de toetsen van de oude piano <w>aansloegen</w>, kwamen er valse tonen uit.",
                            "target_lang_translations": {
                                "en": "When we <w>struck</w> the keys of the old piano, out-of-tune notes came out."
                            }
                        },
                        {
                            "text": "Je moet de snaren van de gitaar zachter <w>aanslaan</w> voor dit liedje.",
                            "target_lang_translations": {
                                "en": "You should <w>pluck</w> the guitar strings more softly for this song."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespelen",
                        "tokkelen"
                    ],
                    "common_phrases": [
                        "toets aanslaan",
                        "snaar aanslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To touch a key or string to produce a sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "to hit a key or string"
                            },
                            {
                                "target_lang_word": "pluck",
                                "target_lang_sense_clarification": "to pull and release a string"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to press a key lightly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e4a2a83-92b2-327f-a44b-c688344faaf1",
                    "sense_definition": "iemand een officiële belastingheffing opleggen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De belastingdienst heeft hem voor een enorm bedrag <w>aangeslagen</w> dit jaar.",
                            "target_lang_translations": {
                                "en": "The tax authorities <w>assessed</w> him for a huge amount this year."
                            }
                        },
                        {
                            "text": "Toen de regering rijke burgers <w>aansloeg</w> met hoge belastingen, vertrokken velen naar het buitenland.",
                            "target_lang_translations": {
                                "en": "When the government <w>taxed</w> wealthy citizens with high rates, many left for abroad."
                            }
                        }
                    ],
                    "synonyms": [
                        "belasten",
                        "taxeren"
                    ],
                    "common_phrases": [
                        "voor een bedrag aanslaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebruikt in juridische en fiscale context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To impose an official tax assessment on someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assess",
                                "target_lang_sense_clarification": "to calculate and demand tax"
                            },
                            {
                                "target_lang_word": "tax",
                                "target_lang_sense_clarification": "to levy a tax on"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to impose a financial obligation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce1a7283-6618-3290-9bf1-769d71a18ffa",
                    "sense_definition": "het proces waarbij een plant begint te groeien na het planten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het duurde lang voordat de kiemen van de plantjes <w>aansloegen</w> in de droge grond.",
                            "target_lang_translations": {
                                "en": "It took a long time before the plant seedlings <w>took root</w> in the dry soil."
                            }
                        },
                        {
                            "text": "De nieuwe struiken zijn gelukkig goed <w>aangeslagen</w> na de verhuizing.",
                            "target_lang_translations": {
                                "en": "Fortunately, the new shrubs <w>established</w> well after the move."
                            }
                        }
                    ],
                    "synonyms": [
                        "wortelen",
                        "vastgroeien"
                    ],
                    "antonyms": [
                        "verwelken",
                        "doodgaan"
                    ],
                    "common_phrases": [
                        "plant slaat aan",
                        "wortel aanslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "The process where a plant begins to grow after being planted"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take root",
                                "target_lang_sense_clarification": "to begin to grow and establish"
                            },
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "to successfully start growing"
                            },
                            {
                                "target_lang_word": "establish",
                                "target_lang_sense_clarification": "to become settled in the soil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce388b03-666e-3bd1-beeb-0a1aca661a62",
                    "sense_definition": "op een formele, militaire manier een groet brengen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge soldaat moest bij iedere meerdere de hand tegen de klep van zijn pet <w>aanslaan</w>.",
                            "target_lang_translations": {
                                "en": "The young soldier had to <w>salute</w> every superior by putting his hand to the brim of his cap."
                            }
                        },
                        {
                            "text": "Hij <w>sloeg</w> strak <w>aan</w> toen de generaal de kazerne binnenliep.",
                            "target_lang_translations": {
                                "en": "He <w>snapped a salute</w> when the general walked into the barracks."
                            }
                        }
                    ],
                    "synonyms": [
                        "salueren",
                        "groeten"
                    ],
                    "common_phrases": [
                        "de hand aanslaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specifiek militair jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To give a salute in a formal, military manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "salute",
                                "target_lang_sense_clarification": "to give a military greeting"
                            },
                            {
                                "target_lang_word": "snap a salute",
                                "target_lang_sense_clarification": "to salute quickly and sharply"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}