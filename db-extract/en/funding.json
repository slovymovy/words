                        ],
                        "examples": [
                            {
                                "example_id": "30ae5168-b992-40b7-9924-54bd74762c48",
                                "sense_id": "17b93b9b-5348-31e8-9180-6cf13ceb6fdf",
                                "text": "The council is providing funding to the church to repair the roof."
                            },
                            {
                                "example_id": "081ea82c-7a0b-4d84-962c-c64cfc4cca13",
                                "sense_id": "17b93b9b-5348-31e8-9180-6cf13ceb6fdf",
                                "text": "Second, a bank can commit to provide a maximum amount of money (e.g., $US1,000,000) in one or more fundings over a set period of time (e.g., one year). Such credit facilities are called “lines of credit.”"
                            }
                        ]
