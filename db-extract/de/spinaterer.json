                        "examples": [
                            {
                                "example_id": "dd6fcdc7-9de5-4b40-aac1-069279f2ebb8",
                                "sense_id": "f929f898-06a1-3e0c-97c7-4ffbf7c2e115",
                                "text": "„Man schlug sich erbarmungslos auf die Schenkel und brüllte vor Lachen über die Spinatburschen oder Spinaterer, wie Homosexuelle auch abfällig bezeichnet wurden.“"
                            },
                            {
                                "example_id": "f46b77b8-7ad9-46be-bc07-5a480b66d7be",
                                "sense_id": "f929f898-06a1-3e0c-97c7-4ffbf7c2e115",
                                "text": "„Hab schon g'hört, dass du gern mal mit den Spinaterern, den schwulen Schuhplattlern, unterwegs bist.“"
                            },
                            {
                                "example_id": "5c0b9f03-a752-455a-a7a1-5ad98d701881",
                                "sense_id": "f929f898-06a1-3e0c-97c7-4ffbf7c2e115",
                                "text": "„Ein Arbeiter meinte, Hitler sei ein ›Spinaterer‹ [Vulgärausdruck für Homosexuelle], sonst hätte er schon längst geheiratet.“"
                            }
                        ],
