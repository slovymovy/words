                "senses": [
                    {
                        "sense_id": "c9180cdb-2461-3be9-86ff-beca2e63f060",
                        "entry_id": "942e5c05-d558-31e2-a268-a4cdbe5e6d9e",
                        "glosses": [
                            "Privilégier de façon particulièrement importants (y compris en termes de droit pour le recouvrement des créances)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd4e231-9a2e-4fb3-8b8a-6201cf33d7e1",
                                "sense_id": "c9180cdb-2461-3be9-86ff-beca2e63f060",
                                "text": "Elle estime que la loi superprivilégie seulement la partie incessible et insaisissable de la rémunération."
                            },
                            {
                                "example_id": "2a481a0f-c67e-4000-8960-198a31979f43",
                                "sense_id": "c9180cdb-2461-3be9-86ff-beca2e63f060",
                                "text": "Par ailleurs, les salariés peuvent être vus comme des créanciers, d’autant qu’ils sont superprivilégiés par la procédure."
                            },
                            {
                                "example_id": "eb173fe9-3273-4430-8c10-5b5f21bffb87",
                                "sense_id": "c9180cdb-2461-3be9-86ff-beca2e63f060",
                                "text": "Je partage bien ton avis ; ça me met en rogne de constater qu’on n’en profite pas pour superprivilégier ceux qui utilisent un moyen de locomotion propre"
                            }
                        ]
                    }
                ],
