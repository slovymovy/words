                "senses": [
                    {
                        "sense_id": "c1e042de-21da-3563-b1e6-83e48c9b270d",
                        "entry_id": "f8cdd74f-4b98-3ec0-834d-e6cb47c01b2d",
                        "glosses": [
                            "Plan, der vorschreibt, wie im Notfall gehandelt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dbaeedf-b8ee-4e9f-bc89-2579a7e98309",
                                "sense_id": "c1e042de-21da-3563-b1e6-83e48c9b270d",
                                "text": "„Wegen mutmaßlicher Suizidgefahr gilt für Ghislaine Maxwell ein erweitertes Sicherheitsprotokoll: Die frühere Partnerin des Sexualstraftäters Jeffrey Epstein darf im Gefängnis nicht alleine sein und muss Kleidung aus Papier tragen.“"
                            },
                            {
                                "example_id": "114cc958-b065-43ea-973c-aead1eb2a6d0",
                                "sense_id": "c1e042de-21da-3563-b1e6-83e48c9b270d",
                                "text": "„Das Zentrum habe ein Sicherheitsprotokoll gegen die Verbreitung des Virus vorgelegt, sagte eine Sprecherin der Sicherheitsbehörden der Deutschen Presse-Agentur.“"
                            },
                            {
                                "example_id": "f90c6cec-1805-429e-99df-d80c95b4b8dc",
                                "sense_id": "c1e042de-21da-3563-b1e6-83e48c9b270d",
                                "text": "„Daher hat die FIGC ein Sicherheitsprotokoll erstellt, das Tests und Temperaturkontrollen für die Spieler regelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
