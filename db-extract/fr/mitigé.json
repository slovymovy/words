                    {
                        "translation_id": "7a426897-54eb-4c44-b0eb-90dac38a3129",
                        "source_entry_id": "f7063b53-74ed-3a97-8a04-15b8d462dcfd",
                        "source_sense_description": "relâché",
                        "target_lang_word": "onbevredigend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbevredigend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ef3c3c-3271-31e8-8d5d-a808601a61ed",
                                        "entry_id": "69daa921-b4df-33ce-b559-5e661a1f1570",
                                        "glosses": [
                                            "niet voldoende aan de eisen die men ergens aan stelt waardoor men verdrietig, boos en teleurgesteld kan zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d9eff3-af66-4265-9c81-2b2d234b759d",
                                                "sense_id": "e2ef3c3c-3271-31e8-8d5d-a808601a61ed",
                                                "text": "Een auto ploegde in een groep demonstranten, maar de president van Amerika weigerde een daad van binnenslands terrorisme als zodanig te benoemen. Maandag legde Trump met zichtbare onwil een meer gematigde, maar nog steeds onbevredigende verklaring af. Dinsdag was Trump weer zijn gewone zelf en toonde eens te meer dat het ambt van president nu wordt bekleed door iemand die Amerika te schande maakt."
                                            },
                                            {
                                                "example_id": "80256c4c-4657-4a51-8445-69150c24a79c",
                                                "sense_id": "e2ef3c3c-3271-31e8-8d5d-a808601a61ed",
                                                "text": "Eigenares Agnes Nijmeijer is teleurgesteld en noemt het staken van het onderzoek 'erg onbevredigend'. Daarnaast is het gezin nog steeds erg aangedaan over wat er met Cieta gebeurd is. Nijmeijer heeft nog geen enkel idee wie verantwoordelijk is voor de dood van haar hond. \"Wij vragen ons nog steeds af wat iemand bezielt om zoiets te doen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
