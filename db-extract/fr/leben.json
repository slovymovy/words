                "senses": [
                    {
                        "sense_id": "70c5f22f-ebd3-3b21-bb9a-bc40d27ec86f",
                        "entry_id": "cf46fb33-8333-3bfa-9a40-781fc6808d2b",
                        "glosses": [
                            "Aux pays du Maghreb, petit-lait. Au Moyen-Orient arabe, yaourt et fromage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0a391d-bd87-4d0d-bc57-fe2ffb5a44d9",
                                "sense_id": "70c5f22f-ebd3-3b21-bb9a-bc40d27ec86f",
                                "text": "Les laits fermentés (tels que le yaourt, le kéfir ou le leben) sont préférés au lait frais dans certains pays en raison de leur goût et de leur texture plus agréables, de l'élimination des risques de contamination microbienne, et des vertus thérapeutiques qu'on leur prête."
                            },
                            {
                                "example_id": "f90dee8e-462d-4bbf-947f-8d7a8aa17990",
                                "sense_id": "70c5f22f-ebd3-3b21-bb9a-bc40d27ec86f",
                                "text": "Un lait acidifié largement consommé dans les pays chauds et en particulier en Afrique du nord et au Moyen-Orient est le leben ou lben. Il est préparé à l'aide de lait le plus souvent partiellement ou totalement écrémé."
                            },
                            {
                                "example_id": "4ccd9230-1fbf-46cb-9c04-d2341c9cdd42",
                                "sense_id": "70c5f22f-ebd3-3b21-bb9a-bc40d27ec86f",
                                "text": "Dans ce pays-là, au lieu de kaïmak, on a le leben, autre espèce de fromage mal fort agréable au goût, quoique mêlé d'un petit filet d'aigreur. On est si friand de ce leben que j'ai vu un Syrien de la ville de Baruth, qui ne se plaisait pas à Constantinople, parce qu'il n'y trouvait pas du leben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d54957c0-d41d-4612-b1ab-13cf4a69e235",
                        "source_entry_id": "cf46fb33-8333-3bfa-9a40-781fc6808d2b",
                        "source_sense_id": "70c5f22f-ebd3-3b21-bb9a-bc40d27ec86f",
                        "target_lang_word": "Buttermilch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buttermilch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                        "entry_id": "04e3781a-6550-3f55-9891-c4c3d460125f",
                                        "glosses": [
                                            "milchähnliches Getränk, Nebenprodukt der Butterherstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b147b60d-46dd-4dfc-b889-943ab010344b",
                                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                                "text": "Die Buttermilch wird mit den pürierten Früchten vermischt."
                                            },
                                            {
                                                "example_id": "58cc8141-a207-4f44-be5f-66620b34c3be",
                                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                                "text": "Milchhändler und Molkereien (Abnehmer) sind verpflichtet, Milch, entrahmte Milch, Buttermilch und geschlagene Buttermilch nur von Molkereien, die von der obersten Landesbehörde bestimmt werden, zu beziehen."
                                            },
                                            {
                                                "example_id": "167b18dd-5008-46d2-a8ab-cff810371294",
                                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                                "text": "„Später gab es dicke weiße Bohnen, wie sie die Großmutter samstags in Buttermilch gekocht hatte, hier schwammen sie in Öl und Zitrone und schmeckten köstlich wie zu Hause.“"
                                            },
                                            {
                                                "example_id": "642342b3-45a5-4774-93f2-5da4c6cd5506",
                                                "sense_id": "f10cd3fb-926f-343a-bd72-a88c5cd90e0f",
                                                "text": "„Otto Bambuss sieht mich an wie eine Eule, die mit Buttermilch gefüttert ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
