                "senses": [
                    {
                        "sense_id": "cd436e0c-1943-35b9-bb02-bd6c203e689c",
                        "entry_id": "b31a8dbd-d648-3241-bfe1-8279069fd8c9",
                        "glosses": [
                            "heel helder wit; letterlijk zo wit als hagel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1bfc62f-a3a3-4b56-9e5d-8a4fb44ac07b",
                                "sense_id": "cd436e0c-1943-35b9-bb02-bd6c203e689c",
                                "text": "We reizen verder naar Saint Vincent en de Grenadines. Een groep paradijselijke eilandjes waar alle clichés uit de reisfolders te vinden zijn. De palmbomen, de hagelwitte stranden, de vriendelijke rastamannen, de romantische baaitjes."
                            },
                            {
                                "example_id": "1b9e6b1b-4ccf-48bf-b032-a220b1e6b317",
                                "sense_id": "cd436e0c-1943-35b9-bb02-bd6c203e689c",
                                "text": "Vogelzang bedacht iets wat veel verder ging dan eten alleen. Twee hagelwitte tafellakens hingen vanaf het plafond naar beneden. De gasten moesten door uitsparingen in het laken hun armen en hoofd steken."
                            }
                        ]
                    }
