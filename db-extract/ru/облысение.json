                "senses": [
                    {
                        "sense_id": "165f0d63-37d0-34eb-b8c3-696fe10f1a91",
                        "entry_id": "f228f1db-be1c-39e9-9f67-e0748e2285e8",
                        "glosses": [
                            "мед. поредение или полное отсутствие волос на ограниченном участке или всей поверхности кожи"
                        ],
                        "tags": [],
