                    {
                        "sense_id": "d7cebe2c-d22d-3fe7-99ec-22564d353446",
                        "entry_id": "788c2e0b-b878-38cc-86e2-a29369df4192",
                        "glosses": [
                            "École normale supérieure, située rue d'Ulm, à Paris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1ba5ca-dacf-4fa8-9629-850a7005b9ff",
                                "sense_id": "d7cebe2c-d22d-3fe7-99ec-22564d353446",
                                "text": "Avoir fait Ulm."
                            },
                            {
                                "example_id": "2ecc6126-e062-4f9e-9683-18196035f1ce",
                                "sense_id": "d7cebe2c-d22d-3fe7-99ec-22564d353446",
                                "text": "En mathématiques pures, Ulm est loin devant [les autres écoles], en informatique, Cachan est la plus réputée."
                            }
                        ]
                    }
                ],
                "translations": [
