                "word": "Ptolemaic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "faa040cc-7580-3ce9-a240-a692b5e3ebc1",
                        "entry_id": "8c5ce7a1-be2c-3e15-a9e3-750f38eedf1f",
                        "glosses": [
