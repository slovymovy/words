                "senses": [
                    {
                        "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                        "entry_id": "50d787e7-ce64-3d7f-b94f-df104d677935",
                        "glosses": [
                            "Wasserbecken für Sportler zur Erholung nach einem Training oder einem Wettkampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc4b22b-8f69-4152-a0c2-24df62959d7c",
                                "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                                "text": "„Springt mit den Spielern nach der Meisterschaft ins Entmüdungsbecken - nicht nackt, gottlob.“"
                            },
                            {
                                "example_id": "078fa3d0-f312-40f7-8bd0-199852ccb646",
                                "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                                "text": "„Nur am Entmüdungsbecken und bei der Massage hat der Chinese nichts zu suchen.“"
                            },
                            {
                                "example_id": "9b336567-1a5b-4368-8228-19c78572db9a",
                                "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                                "text": "„Er verlangte den Einbau eines Entmüdungsbeckens und einer Sauna, und bessere Rasenplätze.“"
                            },
                            {
                                "example_id": "1f4182c2-ad6b-4fcc-9f58-e1bbe9456d06",
                                "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                                "text": "„Nach dem Training saßen Bernd Cullmann, Roger van Gool und mein Vater im Entmüdungsbecken und ›bestellten‹ bei mir ein Orangenmixgetränk.“"
                            },
                            {
                                "example_id": "392fc827-3049-44aa-bf86-9cbfb79563b6",
                                "sense_id": "734b76e3-a91c-3187-808d-d1cb53cb2eeb",
                                "text": "„Die Regeneration beginnt mit dem ‚Entmüden‘ nach der Therapie, führt über gezielte Entspannungsduschen, dem Verweilen im Entmüdungsbecken hin zu den physikalischen Maßnahmen wie Warmpackungen, Massagen oder Dehntechniken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
