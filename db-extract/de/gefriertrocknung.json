                "senses": [
                    {
                        "sense_id": "9aa5fcfa-af01-3083-b79a-7297e79b10bf",
                        "entry_id": "34a97180-bd44-3c64-a8de-4612d3af21c0",
                        "glosses": [
                            "Trocknung von tiefgefrorenen Stoffen und Lebensmitteln im Vakuum durch den Prozess der Sublimation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51548371-0881-459a-a7a2-eb645b97a163",
                                "sense_id": "9aa5fcfa-af01-3083-b79a-7297e79b10bf",
                                "text": "Das als Gefriertrocknung bekannte Verfahren funktioniert gut, denn Wasser kann vom festen direkt in den gasförmigen Zustand übergehen und so aus den Büchern „herausgezogen“ werden."
                            },
                            {
                                "example_id": "cd50aef4-077d-48c9-baf9-d619bafb9b43",
                                "sense_id": "9aa5fcfa-af01-3083-b79a-7297e79b10bf",
                                "text": "Gefriertrocknung zeichnet sich dadurch aus, dass Früchte ohne Zusatzstoffe haltbar bleiben."
                            },
                            {
                                "example_id": "5e7da729-cf62-41ad-8b63-1058f6b3951c",
                                "sense_id": "9aa5fcfa-af01-3083-b79a-7297e79b10bf",
                                "text": "Der Fokus der Investition von mehr als 60 Millionen Euro bis 2023 liege auf dem Bereich Gefriertrocknung sowie Anlagen für die Abfüllung und Verpackung von Glasflaschen und vorgefüllten Spritzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
