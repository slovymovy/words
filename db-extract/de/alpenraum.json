                ],
                "senses": [
                    {
                        "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                        "entry_id": "06879d4f-bc48-346d-983c-b78bdf3aa309",
                        "glosses": [
                            "Gesamtheit der Gebiete an und in den Alpen; dazu werden Gebiete der Länder Frankreich, Monaco, Italien, Schweiz, Liechtenstein, Deutschland, Österreich und Slowenien gerechnet"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "ac525893-4fff-4147-80ac-0ab5582a3386",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "[Schlagzeile:] „Alpenraum versinkt im Schnee“"
                            },
                            {
                                "example_id": "c7f4ac0d-eecb-47b5-914d-60875cffd436",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Zum Jahresbeginn setzten die heftigsten Schneefälle ein, die es im Alpenraum in den letzten Jahren gegeben hat.“"
                            },
                            {
                                "example_id": "47eeee36-b9de-4e89-b740-0cb527a21ce0",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Entspannung ist in Sicht: Laut Meteorologen sollen die Schneefälle im Alpenraum nach zwei Wochen nun ausklingen.“"
                            },
                            {
                                "example_id": "8dbeb994-11a9-4710-bc7d-6a9b3e427bc9",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Der Klimawandel wird den Alpenraum verändern.“"
                            },
                            {
                                "example_id": "81c3149c-9afa-4bd4-a496-62d55debfb41",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Die Hanfpalme fühlt sich im Alpenraum immer wohler, doch sie wird zur Gefahr für die heimische Natur.“"
                            },
                            {
                                "example_id": "a73bb54b-975e-4155-80e1-8dd1683fef27",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Der Wasserbedarf steigt gerade im Alpenraum. Die Landwirte, die Bergbahnbetreiber, die Elektrizitätswerke – sie alle sind dringend auf Wasser angewiesen.“"
                            },
                            {
                                "example_id": "75541675-13ce-449b-abca-5e82a05b6ce5",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "[13. Apr. 1927:] „Die dreimotorige Rohrbach Ro VIII Roland überfliegt als erstes deutsches Großraumverkehrsflugzeug den Alpenraum.“"
                            },
                            {
                                "example_id": "e2b4afb6-5929-4c84-84a2-6874fdf0f085",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "[25. Juli 1940:] „Vor den höheren schweizerischen Kommandanten gibt General Henri Guisan den Grundgedanken des Reduits-Verteidigungssystems, des Rückzugs der Armee in den schwer zugänglichen Alpenraum, bekannt.“"
                            },
                            {
                                "example_id": "6f8faea4-440f-40f5-ba80-c6e6d827a711",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Das Chalet ist ein im Alpenraum, insbesondere in der Schweiz verbreiteter ländlicher Haustyp.“"
                            },
                            {
                                "example_id": "48287855-ee5b-4bb2-866d-ebffba34e6e7",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Früher gab es sie im ganzen Alpenraum, heute sind nur noch Spuren von prähistorischen Pfahlbauten übrig geblieben.“"
                            },
                            {
                                "example_id": "2ff09da7-2f2c-494d-b66d-da029c61e57f",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Die Schneekanonen im Alpenraum produzieren eifrig, Liftbetreiber, Hotels und Gastronomie bereiten sich auf die Saison vor, ob und wann aber die Urlauber kommen dürfen, dahinter steht in diesem Corona-Winter ein großes Fragezeichen.“",
                                "translation": "mit Plural:"
                            },
                            {
                                "example_id": "413cc0bf-2a07-44f8-bbda-510073299aaa",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Und damit setzt in den achtziger Jahren langsam eine flächenhafte Wiederaufwertung der strukturschwachen Alpenräume ein, indem praktisch überall Ferienhäuser dezentral ausgebaut werden.“"
                            },
                            {
                                "example_id": "9cd00243-9a31-4354-9d13-d9e267ef8416",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Die bayerischen und die slowenische Alpen fallen mit Abstand als die am stärksten städtisch, bzw. am stärksten ländlich geprägten Alpenräume auf, bei denen beidemale die Einwohner- und Flächenanteile jeweils sehr ähnlich sind.“"
                            },
                            {
                                "example_id": "55570f19-2f6a-4cac-8191-4fc191dc0e5e",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "[…] „Die Alpenräume sind der empfindliche Seismograf für später auch andernorts anrollende Konflikte.“"
                            },
                            {
                                "example_id": "fa955eb1-f6d5-4332-b9cd-71018aadb5e8",
                                "sense_id": "2a810d70-767b-39f3-82fe-9712b58c171c",
                                "text": "„Wenn vor dem Jahre 1100 in den verschiedenen Alpenräumen lautliche Kriterien keine Differenzierung erlauben, haben sich dagegen zwischen dem 6. und 11. Jahrhundert die bestehenden lexikalischen Unterschiede des Regionallateins vertieft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
