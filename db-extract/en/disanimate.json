                "senses": [
                    {
                        "sense_id": "12606ce0-d5ca-3973-81c1-0bb779b1d726",
                        "entry_id": "c04a6f26-6836-375e-a7d8-a3eb3da23385",
                        "glosses": [
                            "To deprive of life."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b07902-e297-4634-9d6a-971000164c4b",
                                "sense_id": "12606ce0-d5ca-3973-81c1-0bb779b1d726",
                                "text": "That soul and life , that is now fled and gone from a lifeless carcass , is only a loss to that particular body or compages of matter , which by means thereof is now disanimated"
                            }
                        ]
                    },
                    {
                        "sense_id": "b1eb69b4-e724-3d96-837b-6d56d6a93127",
                        "entry_id": "c04a6f26-6836-375e-a7d8-a3eb3da23385",
                        "glosses": [
                            "To deprive of spirit; to dishearten."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c876fe10-94ea-4ca0-a20c-fb7b07a67a87",
                                "sense_id": "b1eb69b4-e724-3d96-837b-6d56d6a93127",
                                "text": "Now will it best avail your majesty\nTo cross the seas and to be crown'd in France:\nThe presence of a king engenders love\nAmongst his subjects and his loyal friends,\nAs it disanimates his enemies."
                            }
                        ]
                    }
