                        "zh": [
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "表达失望"
                            },
                            {
                                "target_lang_word": "真倒霉",
                                "target_lang_sense_clarification": "表达懊恼"
