                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7103f5f5-7f71-444d-9233-2f2adeeea625",
                                "sense_id": "524f3e98-3427-31c2-9037-d81d5e16b6a8",
                                "text": "The platforms of all stations from Shepherds Bush to Liverpool Street have been lengthened from 325 ft. to 427 ft. between tunnel headwalls, to take longer trains."
                            },
                            {
                                "example_id": "d90ebe04-46b8-44d8-922c-0a53a066e353",
                                "sense_id": "524f3e98-3427-31c2-9037-d81d5e16b6a8",
                                "text": "HS2 Ltd has built a 17-metre-high headwall and reinforced the ground at what will become the south portal of the ten-mile Chiltern Tunnel, as part of preparations for the arrival next year of tunnel boring machines (TBMs)."
                            }
                        ]
