                ],
                "senses": [
                    {
                        "sense_id": "9a892bc3-2c51-31c8-a9a9-85f4c142b51a",
                        "entry_id": "a55d3a75-989a-38a2-96d8-67f9aa4beddc",
                        "glosses": [
                            "Ready to dance."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3e9d7a40-be88-4ab3-8849-6226a7820878",
                                "sense_id": "9a892bc3-2c51-31c8-a9a9-85f4c142b51a",
                                "text": "I'm feeling a bit dancy today."
                            },
                            {
                                "example_id": "cc436821-f01f-4a3a-b2ce-bb6b417c11ca",
                                "sense_id": "9a892bc3-2c51-31c8-a9a9-85f4c142b51a",
                                "text": "Gear up for a bit of a walk—five whole minutes to The George on S. George St. We're all loosened up and ready to get a little dancey at this thoroughly festive gay club."
                            }
                        ]
                    },
                    {
                        "sense_id": "e453bd33-a48d-3217-b869-16db1ee9c23d",
                        "entry_id": "a55d3a75-989a-38a2-96d8-67f9aa4beddc",
                        "glosses": [
                            "Of music: suitable for dancing to."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "94a98f28-f50c-4115-9fbb-d6ae38e1849a",
                                "sense_id": "e453bd33-a48d-3217-b869-16db1ee9c23d",
                                "text": "After a few slow numbers, the band moved on to some more dancy tunes."
                            },
                            {
                                "example_id": "369b8e27-614c-4783-87bd-c8cf17fd0439",
                                "sense_id": "e453bd33-a48d-3217-b869-16db1ee9c23d",
                                "text": "This was the swingingest, danciest Ellington heard by most in a decade."
                            },
                            {
                                "example_id": "4397edf0-db3a-4041-9e10-3ad94ad13f23",
                                "sense_id": "e453bd33-a48d-3217-b869-16db1ee9c23d",
                                "text": "TOLBERT BIGAMY JONES was the danciest cowboy in our part of west Texas."
                            },
                            {
                                "example_id": "bf6088ff-9050-49aa-86d1-4be497a344fe",
                                "sense_id": "e453bd33-a48d-3217-b869-16db1ee9c23d",
                                "text": "Joseph Holmes Dance Theatre member Darrian Ford and JHDT instructor Winifred Haun teamed up in Long Lunch, the danciest piece on the program."
                            }
                        ]
                    }
                ],
