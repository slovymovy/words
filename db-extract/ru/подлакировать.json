                "senses": [
                    {
                        "sense_id": "960c42f1-c321-3794-9eb3-5bc9b5796f43",
                        "entry_id": "f85b8a4a-cb7a-3d93-904e-f263506a2473",
                        "glosses": [
                            "придать блеска, подновить или подправить дополнительной лакировкой"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a08774d5-93cf-3bac-8ea8-0f80a9bdfb17",
                        "entry_id": "f85b8a4a-cb7a-3d93-904e-f263506a2473",
                        "glosses": [
                            "перен. несколько приукрасить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe3e7c7-7e20-42b1-b6b5-715d705176a3",
                                "sense_id": "a08774d5-93cf-3bac-8ea8-0f80a9bdfb17",
                                "text": "Занижены были также цифры количества вредных выбросов в атмосферу, подлакированы и другие показатели."
                            }
                        ]
                    },
                    {
                        "sense_id": "07f61c78-93c1-3ab9-8fc8-aa76595c801f",
                        "entry_id": "f85b8a4a-cb7a-3d93-904e-f263506a2473",
                        "glosses": [
                            "перен., разг. выпить ещё спиртного для достижения желаемой степени алкогольного опьянения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c820983a-fb34-4f0a-9e7f-056e9f0e4756",
                                "sense_id": "07f61c78-93c1-3ab9-8fc8-aa76595c801f",
                                "text": "— Пивка бы кружечку, с пенкой на два пальца, да подлакировать самогоночкой."
                            }
                        ]
                    }
