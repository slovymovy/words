                "senses": [
                    {
                        "sense_id": "d2e494b2-2819-35d4-8358-8ce2bfdacb4f",
                        "entry_id": "b3676cff-88e9-3752-a1ce-3ba5f5c28747",
                        "glosses": [
                            "Donner un caractère partenarial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc8446f-185d-4d32-bf7b-fa243b668c48",
                                "sense_id": "d2e494b2-2819-35d4-8358-8ce2bfdacb4f",
                                "text": "Finalement, nous nous trouvons bien en face d’un ensemble de pratiques nouvelles dans l’action publique consistant à négocier, contractualiser ou « partenarialiser » des politiques publiques jusqu’alors gérées par l’Etat ou tout du moins affichées comme telles."
                            },
                            {
                                "example_id": "eeb3bf28-7e15-4455-abcd-59c8a183a6eb",
                                "sense_id": "d2e494b2-2819-35d4-8358-8ce2bfdacb4f",
                                "text": "Partenarialiser la formation pour en faire un véritable outil commun des salariés et des entreprises"
                            },
                            {
                                "example_id": "e6097d71-3a81-43f6-ac4f-f44493147a54",
                                "sense_id": "d2e494b2-2819-35d4-8358-8ce2bfdacb4f",
                                "text": "Celui-ci qualifié de « socle de la prise en charge éducative » est sommé d’innover, de créer, d’articuler, de DIPCiser, de PCPCiser, de protocoliser, de partenarialiser, de placer, d’investiguer, de réparer et bientôt de déradicaliser, le tout avec des dispositifs de droits communs de plus en plus exsangues."
                            }
                        ]
                    }
