                "translations": [
                    {
                        "translation_id": "0f752da9-9521-4321-b835-a2830213831a",
                        "source_entry_id": "6abda5bf-35ad-3fa6-b236-94e7d140d631",
                        "source_sense_id": "d700255d-ed3d-30bd-bfe5-278c6dea9b21",
                        "source_sense_description": "een onhandig persoon",
                        "target_lang_word": "Stümper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stümper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die auf einem Gebiet, auf dem sie tätig ist, nur wenige oder gar keine Kenntnisse hat"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2daff2-473c-498f-8815-be91cebe33fb",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Gute Musiker wollen sie dulden oder sogar fördern; Stümper an der Klampfe oder Fiedler mit Einliedrepertoire sollen aus U-Bahnen und Fußgängerzonen verschwinden.“"
                                            },
                                            {
                                                "example_id": "a1ca4af6-83ee-4cd0-8c34-d452e3265c67",
                                                "sense_id": "c3d7e7cb-dde8-3f9c-9576-6e95ba4be8b0",
                                                "text": "„Allerdings wird aus den Prozessunterlagen jetzt deutlich, daß die Terrorkumpane des al-Sarkawi im Ruhrgebiet eher eine Bande von Stümpern als Profis waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                        "entry_id": "fa3e8aa6-e9c9-3b8b-9334-e60574ca4ed6",
                                        "glosses": [
                                            "Person, die sich bei etwas keine Mühe gibt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18881293-ddaa-47e8-b34e-b42d6d4a196b",
                                                "sense_id": "71ce1497-3b63-3bca-b4f6-f69b6357a558",
                                                "text": "„Mein lieber Barbaro hielt die Karten wie ein Stümper; das gefiel mir von Anfang an nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f355fa-579d-439d-aa46-2e579f465cd9",
                        "source_entry_id": "6abda5bf-35ad-3fa6-b236-94e7d140d631",
                        "source_sense_id": "d700255d-ed3d-30bd-bfe5-278c6dea9b21",
                        "source_sense_description": "een onhandig persoon",
                        "target_lang_word": "bungler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bungler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                        "entry_id": "556c0c06-8c33-3b77-a4fc-7e42191b7b18",
                                        "glosses": [
                                            "Someone who makes mistakes because of incompetence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71873a14-5708-4d52-9cd7-d51b9d26f797",
                                                "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                                "text": "\"What you mean, comparing me to them botchers and bunglers? There ain't anybody but me in the furniture restoring line.\""
                                            },
                                            {
                                                "example_id": "ed7feec9-6714-4207-bebf-cbc9b6cc2146",
                                                "sense_id": "a94b0344-abf3-3f08-b526-5aff5ac91773",
                                                "text": "Noble Prophet of Truth, this has gone on long enough. Make an example of this bungler. The Council demands it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3f12d9f-ae4c-46b9-ab62-6111800dbe76",
                        "source_entry_id": "6abda5bf-35ad-3fa6-b236-94e7d140d631",
                        "source_sense_id": "d700255d-ed3d-30bd-bfe5-278c6dea9b21",
                        "source_sense_description": "een onhandig persoon",
                        "target_lang_word": "klutz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klutz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                        "entry_id": "ec7b363e-d2f8-3e94-b702-2f2fafd2a15a",
                                        "glosses": [
                                            "A clumsy or stupid person."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04834226-9e42-40ef-ab20-1894e75174e7",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "Well, that's all right, then, Brian. Sit down. Have a scone. Make yourself at home. You klutz!"
                                            },
                                            {
                                                "example_id": "511d282e-9010-41d3-97c4-5918287b7397",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "\"Out of [one abortion doctor's] first six months of work, there are nine malpractice suits ... After it was apparent the guy was a klutz, they kept using him, and trying to cover for him, because they couldn't find another provider.\""
                                            },
                                            {
                                                "example_id": "1c014e89-0dda-48be-bb94-a863a1e6b945",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "\"Mel, back home we'd call you a klutz.\" / Melissa: \"Use a lot of Yiddish back in Texas, do you?\""
                                            },
                                            {
                                                "example_id": "ef92b4f9-e2b9-42af-af9b-e5705015c3de",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "I bumped into the coffee table. \"Sorry about that table. Don't worry, you should see me, Qanta. I am the klutz! I am always doing that!\" She giggled at her clumsiness while I giggled at a Saudi using idiomatic Yiddish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed60b87-1e40-4ec1-a07d-1ae5a698dd08",
                        "source_entry_id": "6abda5bf-35ad-3fa6-b236-94e7d140d631",
                        "source_sense_id": "d700255d-ed3d-30bd-bfe5-278c6dea9b21",
                        "source_sense_description": "een onhandig persoon",
                        "target_lang_word": "balourd",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balourd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb478f2a-1341-33d3-9f49-10e61ba01896",
                                        "entry_id": "4c2eb790-aaa3-3479-900e-ea9fda465875",
                                        "glosses": [
                                            "Grossier et maladroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95c9cb1-83e1-4216-8aab-274dbb038ed3",
                                                "sense_id": "cb478f2a-1341-33d3-9f49-10e61ba01896",
                                                "text": "Elle est un peu balourde, mais ce n'était pas méchant."
                                            },
                                            {
                                                "example_id": "e9371eaa-6590-4818-ac0b-685f4b6859da",
                                                "sense_id": "cb478f2a-1341-33d3-9f49-10e61ba01896",
                                                "text": "Elle, si délicate, se croit tenue de me poser des questions balourdes, imbéciles, comme en poserait une bonne prise en faute."
                                            },
                                            {
                                                "example_id": "034ba674-992e-4b4e-b7ab-2ad21464c3b8",
                                                "sense_id": "cb478f2a-1341-33d3-9f49-10e61ba01896",
                                                "text": "De l'autre côté de la claire-voie, ils virent entrer les malabars l'un derrière l'autre, dans une lumière dansante qui dévoilait par éclipses leurs gros corps balourds et leurs vilaines ganaches de crapules."
                                            },
                                            {
                                                "example_id": "b357ea1f-cac3-4a6e-a070-2ce5d18b095f",
                                                "sense_id": "cb478f2a-1341-33d3-9f49-10e61ba01896",
                                                "text": "De nouveaux clients, au rire bruyant et à la démarche balourde, entrent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "balourd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9a628dd-8e57-3bb4-a41e-a7267f29328d",
                                        "entry_id": "a0e6f2e6-ab75-38d2-9078-7d533125f9c3",
                                        "glosses": [
                                            "Personne grossière et maladroite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0041236d-c16f-4e57-8a33-e26a824d8cde",
                                                "sense_id": "a9a628dd-8e57-3bb4-a41e-a7267f29328d",
                                                "text": "Elle dormait. Dans les bras d’un balourd. Ça avait l’air d’être son époux."
                                            },
                                            {
                                                "example_id": "c7d3fa45-5fac-4ced-95e0-7915b35964b0",
                                                "sense_id": "a9a628dd-8e57-3bb4-a41e-a7267f29328d",
                                                "text": "– Un rapt ! Mais pourquoi donc ? ironisait, balourd, l’adjudant, on n’a jamais vu ça par ici…"
                                            },
                                            {
                                                "example_id": "691c0316-165f-45fd-a231-a52fa417fc94",
                                                "sense_id": "a9a628dd-8e57-3bb4-a41e-a7267f29328d",
                                                "text": "Le naufragé de la quatre-voies de Saint-Appoline, « le cueilleur de coquelicots », comme le brocarde sans trop d'élégance ce balourd de Gérard, redevient peu à peu Michu, Raoul Michu, un représentant en mercerie […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "balourd",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5c56cd-5826-3995-b00b-a70e44cce65d",
                                        "entry_id": "fb7de168-4131-3ea2-b204-eb9aeb76557e",
                                        "glosses": [
                                            "Répartition asymétrique des masses qui entraîne des vibrations sur une pièce tournante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2694b76f-ac6b-49d4-b9da-e6ac78bdd8a5",
                                                "sense_id": "eb5c56cd-5826-3995-b00b-a70e44cce65d",
                                                "text": "A cet effet, on utilise un volant muni d'un balourd à masse fixe, mais avec un rayon de giration réglable."
                                            },
                                            {
                                                "example_id": "fe42170f-11b5-4eae-8a2a-b809ed804473",
                                                "sense_id": "eb5c56cd-5826-3995-b00b-a70e44cce65d",
                                                "text": "Et qu’est-ce qui les menaçait ? Quelques dixièmes de millimètre d’écart dans l’épaisseur d’un culot d’obus, dans le diamètre du fossé, cette ombre d’excentricité dénoncée au balourd…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
