                "senses": [
                    {
                        "sense_id": "868a31cc-7dbd-30ed-ad6d-f3ebc851cb84",
                        "entry_id": "997ed089-1293-320c-b823-a8bd1901d997",
                        "glosses": [
                            "onharen met behulp van gesmolten was die na afkoelen vast is geworden; de haren worden met wortel en al verwijderd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b107d4a-f8b9-4ea4-b80d-80dccb3322b3",
                                "sense_id": "868a31cc-7dbd-30ed-ad6d-f3ebc851cb84",
                                "text": "De brazilian wax, oftewel het waxen van de complete schaamstreek, is in de jaren negentig ontstaan in de kuststeden van Brazilië. Bekend werd het echter pas in New York door de J. Sisters International Salon. Beroemdheden als Scarlett Johansson en Naomi Campbell behoorden tot de klanten van deze salon en deden zeker niet geheimzinnig over hun nieuwste schoonheidsgeheim."
                            },
                            {
                                "example_id": "aae04706-5fcc-4113-bad0-a0b4556bd570",
                                "sense_id": "868a31cc-7dbd-30ed-ad6d-f3ebc851cb84",
                                "text": ",,Ik denk dat alle vrouwen zich hebben laten waxen of harsen”, stelt Elsinga."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ba6d998-e9b2-301c-8f74-bd811a34bd02",
                        "entry_id": "997ed089-1293-320c-b823-a8bd1901d997",
                        "glosses": [
                            "aanbrengen van hars op ski's, snowboards en andere voorwerpen om ze glad en glanzend te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595a6065-c1d1-4d9d-bbc4-7f252300a483",
                                "sense_id": "9ba6d998-e9b2-301c-8f74-bd811a34bd02",
                                "text": "Ga nooit waxen of polishen als een auto nog niet volledig schoon is, want dan veroorzaak je juist krassen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f13a15af-b48e-3258-a55e-106132ffd4e9",
                        "entry_id": "997ed089-1293-320c-b823-a8bd1901d997",
                        "glosses": [
                            "meubelen met politoer behandelen zodat ze glanzen"
