                        "form": "die Münzstätten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7d62bda-a0d2-340b-917a-70d24b1f59fe",
                        "entry_id": "9ea537b8-146d-3c16-a25e-580f73e24d09",
                        "glosses": [
                            "Institution, bei der Münzen geprägt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c633fee-d861-4afa-a5fe-b37afbb20051",
                                "sense_id": "f7d62bda-a0d2-340b-917a-70d24b1f59fe",
                                "text": "Die einzelnen Münzstätten lassen sich durch Prägezeichen auf den Münzrückseiten unterscheiden."
                            },
                            {
                                "example_id": "7e1c77b0-db16-43e6-afb0-1e3b2bf8483c",
                                "sense_id": "f7d62bda-a0d2-340b-917a-70d24b1f59fe",
                                "text": "„Unter den fränkischen und sächsischen Herrschern wuchs in der Folgezeit die Zahl der Münzstätten ebenso wie die Münzproduktion stark an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e3c220e-08a5-48af-a208-de6ad9a32d27",
                        "source_entry_id": "9ea537b8-146d-3c16-a25e-580f73e24d09",
                        "source_sense_id": "f7d62bda-a0d2-340b-917a-70d24b1f59fe",
                        "source_sense_description": "Institution, bei der Münzen geprägt werden",
                        "target_lang_word": "mint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c331a10-2670-3fa8-ab3b-545c677c0da0",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "A building or institution where money (originally, only coins) is produced under government licence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "A vast sum of money; (by extension) a large amount of something."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab34a659-56fa-4736-97e0-3498faf02b42",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "That house is worth a mint."
                                            },
                                            {
                                                "example_id": "eb50f654-9460-4e77-a0a5-acea0ca8d131",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "It must have cost a mint to produce!"
                                            },
                                            {
                                                "example_id": "7de6744e-aaa6-46a4-ae90-2e46b8477013",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "to make a mint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f38b23-cdd2-31f3-b21c-a08d7b645032",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "Any place regarded as a source of unlimited supply; the supply itself."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e51cc1-d66f-490c-abe1-20ba7c6aebbb",
                                                "sense_id": "81f38b23-cdd2-31f3-b21c-a08d7b645032",
                                                "text": "A mint of phrases in his brain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e55ea6f-eb6d-35eb-9d25-38aa2a859e7a",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To reproduce (coins), usually en masse, under licence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b835901d-a45b-43bc-bec0-196062a6e9e5",
                                                "sense_id": "8e55ea6f-eb6d-35eb-9d25-38aa2a859e7a",
                                                "text": "For some time past the legal currency in the various Provinces has been insufficient for use. Formerly the two Provinces of Fuchien and Kuangtung minted some large, round copper coins of excellent workmanship that were said, by the people after they were put into circulation, to be convenient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To invent; to forge; to fabricate; to fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81986aaa-fe86-4c5e-8dfc-78db6486168e",
                                                "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                                "text": "Titles […] as may appeare to be easily minted"
                                            },
                                            {
                                                "example_id": "503cd21f-c0c6-4a44-8034-fd168d3baea1",
                                                "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                                "text": "China’s newly minted national parks don’t just safeguard famous keystone species such as Siberian tigers, giant pandas and Hainan gibbons. They are also designed to preserve the shrinking ecosystems that support such iconic wildlife, ranging from sweltering (tropical jungles in the southern province of Hainan to the chilly maple forests of northern Heilongjiang and Jilin Provinces bordering Siberia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d733bf-5619-3f0a-89e7-725a0b7786fb",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To create a crypto token."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a67e920e-b0d6-4db9-8554-5b7014676441",
                                                "sense_id": "61d733bf-5619-3f0a-89e7-725a0b7786fb",
                                                "text": "Beeple’s collaged JPG was made, or “minted,” in February as a “nonfungible token,” or NFT."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5b9180-98f0-39a0-88d7-61098b028392",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "Ellipsis of mint condition: like new."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9f7841-d6d9-4d4d-8eb4-b1d0232f8f92",
                                                "sense_id": "5a5b9180-98f0-39a0-88d7-61098b028392",
                                                "text": "Most of my collection is near mint, but these ones here are mint."
                                            },
                                            {
                                                "example_id": "c018e58a-f0d5-4b9a-8e79-7683e5cd6df7",
                                                "sense_id": "5a5b9180-98f0-39a0-88d7-61098b028392",
                                                "text": "Trading card sales have taken off, too. The price of mint condition cards on StockX jumped to an average $775 in January from $280 a year ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f45956e-16e2-3c61-a528-d1c266b56e9c",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "In near-perfect condition; uncirculated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc07e1e5-6b88-34a2-a280-8476bb410e15",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "Unused with original gum; as issued originally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ba7b739-c324-30c3-81a6-2397c62bebb6",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "Very good, excellent."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "Northern-England",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a41e1e7-2149-45b2-8cbe-897017dc1573",
                                                "sense_id": "5ba7b739-c324-30c3-81a6-2397c62bebb6",
                                                "text": "And my God, what a house it was – it was mint! In all my life I had never set foot in such a beautiful place."
                                            },
                                            {
                                                "example_id": "942a6df6-d9ba-4a12-a7e7-6fd3cd369e35",
                                                "sense_id": "5ba7b739-c324-30c3-81a6-2397c62bebb6",
                                                "text": "“Everyone was having a beano, everyone was partying, the music was going, it was mint – as soon as England won we booked it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc1b7b1-43ae-38a3-afff-d7b5d47e7b79",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "Attractive; beautiful; handsome."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
