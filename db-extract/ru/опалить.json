                "senses": [
                    {
                        "sense_id": "b792d5aa-60c9-372f-bf1a-8769205ca8c9",
                        "entry_id": "265fbd92-89c4-3862-9328-bd51270d17e0",
                        "glosses": [
                            "слегка повреждать огнём или жаром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cfba589-d6d9-4510-abb6-20ba70b0cb97",
                                "sense_id": "b792d5aa-60c9-372f-bf1a-8769205ca8c9",
                                "text": "Лицо его было словно опалено страстью, глаза его горели во тьме."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adc89337-39db-4003-a51d-c15c80ebb291",
