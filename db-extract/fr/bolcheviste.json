                        ],
                        "examples": [
                            {
                                "example_id": "834933d7-94cc-48d8-9625-46de48b1b9d6",
                                "sense_id": "b937d6ba-cf4a-3d61-b086-e48df8cc821a",
                                "text": "Nous devions l’empêcher de s’établir à Pétersbourg et dans le golfe de Finlande ; nous devions pénétrer, après avoir battu les troupes bolchevistes, à travers la Livonie et l’Esthonie jusqu’à Narva afin de pouvoir, de là même, agir à temps."
                            },
                            {
                                "example_id": "0fb01709-4a8a-452b-ac04-3fedbb73ad25",
                                "sense_id": "b937d6ba-cf4a-3d61-b086-e48df8cc821a",
                                "text": "Les progrès de la vague bolcheviste sont le sujet de toutes les conversations et de toutes les préoccupations des milieux dirigeants berlinois."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
