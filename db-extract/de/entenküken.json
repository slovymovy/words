                "senses": [
                    {
                        "sense_id": "f0e64e91-6860-3e85-9fb0-2242c600fa2b",
                        "entry_id": "c1ea1192-b6de-39cf-88fe-7c5255306ac0",
                        "glosses": [
                            "Jungtier einer Ente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25fe3e0e-ac3b-4a60-8d8d-38f214db57ce",
                                "sense_id": "f0e64e91-6860-3e85-9fb0-2242c600fa2b",
                                "text": "„Nach etwa 26 Tagen schlüpfen die jungen Entenküken mit einem Gewicht von 30 g.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea07582b-060e-4a63-a652-aeb437950dcb",
                        "source_entry_id": "c1ea1192-b6de-39cf-88fe-7c5255306ac0",
                        "source_sense_id": "f0e64e91-6860-3e85-9fb0-2242c600fa2b",
                        "source_sense_description": "Jungtier einer Ente",
                        "target_lang_word": "duckling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duckling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "902bc275-6d76-3cb8-a0e7-101ef35391ad",
                                        "entry_id": "d981c062-ee85-334f-801d-2c721c6c4567",
                                        "glosses": [
                                            "A young duck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                        "entry_id": "d981c062-ee85-334f-801d-2c721c6c4567",
                                        "glosses": [
                                            "A young duck.",
                                            "A young female duck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f2ef1a-4a11-4f1b-9a68-27bdcfa72eab",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Good night, darling; take that kiss to your respected mother, and tell her with my compliments that we can’t afford to make ducks and drakes of the romance of our little pet’s life: she will hatch those birds for herself in due time, and remain cluck-clucking, wisely, but sadly, like a perplexed old hen, when her ducklings and drakelings have unexpectedly taken the water."
                                            },
                                            {
                                                "example_id": "4e54f0af-cf5b-4193-963f-7192bcb830a8",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Referring to Table 1 it will be seen that if a breeding duck produces 40 marketable progeny each year (and in practice this should be achieved) half of which are ducklings and the other half drakelings, and these birds realise 2s. per lb. live weight, then that breeding duck would return approximately £15 10s. over feeding costs for the 12 months."
                                            },
                                            {
                                                "example_id": "02a4b868-3ec9-4a04-894e-34858f9a824d",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Muscovy ducks with ducklings. This is the most popular breed for table purposes. They make weights of up to 5 lb. for ducklings at 13 to 14 weeks, and up to 9 lb. for drakelings at 16 weeks when correctly handled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f40821b1-1bc9-4aa1-a20e-1b16a2ccd69a",
                        "source_entry_id": "c1ea1192-b6de-39cf-88fe-7c5255306ac0",
                        "source_sense_id": "f0e64e91-6860-3e85-9fb0-2242c600fa2b",
                        "source_sense_description": "Jungtier einer Ente",
                        "target_lang_word": "caneton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caneton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92f4d535-f9b7-34e7-a066-7dc8eeaca5cf",
                                        "entry_id": "52c68c8f-7180-3b12-a304-062b87a3ddfd",
                                        "glosses": [
                                            "Petit d’une cane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5c9eff-562e-4698-9c74-b76089b7d69a",
                                                "sense_id": "92f4d535-f9b7-34e7-a066-7dc8eeaca5cf",
                                                "text": "Le caneton court vers l’eau, nage et plonge, se nourrit en immergeant le bec dans l’eau et huile ses plumes."
                                            },
                                            {
                                                "example_id": "8bce00f6-5aa6-4c4c-bc00-b476f6da6a34",
                                                "sense_id": "92f4d535-f9b7-34e7-a066-7dc8eeaca5cf",
                                                "text": "Chaque année en France, 80 millions de canetons naissent pour le foie gras, seuls les mâles sont gavés, les femelles sont généralement gazées ou broyées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7516c3-56ff-3d3b-84fb-3fdfa450dc43",
                                        "entry_id": "52c68c8f-7180-3b12-a304-062b87a3ddfd",
                                        "glosses": [
                                            "Petit canard, journal de faible importance."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
