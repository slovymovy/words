                "senses": [
                    {
                        "sense_id": "32d34d7d-6d0f-350c-b568-c8da920e0556",
                        "entry_id": "8858e347-7b46-3a41-83b6-d14acb0c19db",
                        "glosses": [
                            "Fortbewegung mit schnellen Schritten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ef75a3-9116-4c86-906c-542fa58f9fc1",
                                "sense_id": "32d34d7d-6d0f-350c-b568-c8da920e0556",
                                "text": "„Im Laufschritt kam uns ein Trupp mit Trägern, einem Guide und zwei Weißen entgegen.“"
                            },
                            {
                                "example_id": "8f7b4efc-bc27-4ce3-b546-1b1fb4bc1f75",
                                "sense_id": "32d34d7d-6d0f-350c-b568-c8da920e0556",
                                "text": "Sie [die Pflegekräfte in Krankenhäusern] haben ständig das Gefühl, sich nur im Laufschritt zu bewegen und trotzdem nicht genug zu schaffen."
                            },
                            {
                                "example_id": "811d98e8-1d5b-41a4-96f1-adbf8d2fce65",
                                "sense_id": "32d34d7d-6d0f-350c-b568-c8da920e0556",
                                "text": "„Fabiola hob ihren Arm, um ihn aufzuhalten, aber im Laufschritt entfernte sich Tom bereits und knallte die Tür hinter sich zu.“"
                            },
                            {
                                "example_id": "6ae883dd-4ba1-4102-94a5-4b3ceedb4fd3",
                                "sense_id": "32d34d7d-6d0f-350c-b568-c8da920e0556",
                                "text": "„Kutusow war inzwischen ins Dorf gegangen und hatte sich im Schatten des nächsten Hauses auf eine Bank gesetzt, die ein Kosak im Laufschritt angeschleppt und ein anderer hurtig mit einem Teppich bedeckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
