                "senses": [
                    {
                        "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                        "entry_id": "edb6e241-f4ce-3989-bcc5-c7f93acefc77",
                        "glosses": [
                            "Rinne, Kanal entlang einer Landstraße zum Abfluss von Regenwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa2ca798-a6b2-4751-a09a-3e6fea03d4ce",
                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                "text": "„Als er in einem Straßengraben gefunden wurde, schwebte der Mann nach Angaben der Polizei in Lebensgefahr.“"
                            },
                            {
                                "example_id": "47d7fe0f-ebcd-4edc-9b36-5252e837449e",
                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                "text": "„Im Straßengraben fanden wir ein dunkelgrünes Buch.“"
                            },
                            {
                                "example_id": "449a72d7-7d78-4144-9a42-8480a874ccb3",
                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                "text": "„Ich legte mich in dem flachen Straßengraben auf den Tornister.“"
                            },
                            {
                                "example_id": "a298ce17-b5f2-4be4-9e5c-96a3f12da747",
                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                "text": "„Im Straßengraben schaufelten sie eine Grube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b09284e6-8f08-482b-a803-542e660aea81",
                        "source_entry_id": "edb6e241-f4ce-3989-bcc5-c7f93acefc77",
                        "source_sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                        "source_sense_description": "Rinne, Kanal entlang einer Landstraße zum Abfluss von Regenwasser",
                        "target_lang_word": "ditch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ditch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61511834-8c8d-3a4a-ac6e-32cc9df78653",
                                        "entry_id": "7c65536d-f143-3e47-b909-278cc2ef0442",
                                        "glosses": [
                                            "A trench; a long, shallow indentation, as for irrigation or drainage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214e7dde-be23-4fee-97c8-c2f680531c3c",
                                                "sense_id": "61511834-8c8d-3a4a-ac6e-32cc9df78653",
                                                "text": "Digging ditches has long been considered one of the most demanding forms of manual labor."
                                            },
                                            {
                                                "example_id": "5572b419-4101-427a-b1f2-a2c5aba98c51",
                                                "sense_id": "61511834-8c8d-3a4a-ac6e-32cc9df78653",
                                                "text": "The truck careered off the road into a ditch."
                                            },
                                            {
                                                "example_id": "54dac6ff-24e3-4f0a-9c0d-8cbd280227a0",
                                                "sense_id": "61511834-8c8d-3a4a-ac6e-32cc9df78653",
                                                "text": "Ditches continued to be employed as the sole defensive measure at many sites even after wall building began to emerge. For example, an immense ditch varying between 15 and 20 meters in width and marked by depths of 2.5 to 3.8 meters has recently been discovered in Hubei near Sui-chou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf37634e-8c4d-34e7-8ebc-f4a116122d19",
                                        "entry_id": "7c65536d-f143-3e47-b909-278cc2ef0442",
                                        "glosses": [
                                            "A raised bank of earth and the hedgerow on top."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c9b7d4c-8285-49f0-a78a-5039b77cd0ed",
                                                "sense_id": "bf37634e-8c4d-34e7-8ebc-f4a116122d19",
                                                "text": "You flung a ditch on my vision\nOf beauty, love and truth.\nO stony grey soil of Monaghan\nYou burgled my bank of youth!"
                                            },
                                            {
                                                "example_id": "70251d36-70ac-49be-9280-8e11d8b8612b",
                                                "sense_id": "bf37634e-8c4d-34e7-8ebc-f4a116122d19",
                                                "text": "The original ditches were created by digging trenches, as boundaries and/or irrigation. But to the English, the ditch is the trench. Whereas in Ireland, the ditch is the raised bank of earth and the hedgerow on top. (As for the trench, where I come from that’s a sheugh)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ditch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb606391-6622-30ca-8072-2708b2202264",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To discard or abandon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bdec347-f6bd-4ad0-b05f-6d34084cc56b",
                                                "sense_id": "bb606391-6622-30ca-8072-2708b2202264",
                                                "text": "Once the sun came out we ditched our rain-gear and started a campfire."
                                            },
                                            {
                                                "example_id": "db9110df-3261-45e2-bc60-c62bed5a33db",
                                                "sense_id": "bb606391-6622-30ca-8072-2708b2202264",
                                                "text": "Why did you ditch your last boyfriend? He was so nice to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1fd3785-1a57-32e8-879c-4491dc165091",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To deliberately crash-land an airplane on water."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4d2a5a-8948-4a24-952e-1288b2bae80f",
                                                "sense_id": "e1fd3785-1a57-32e8-879c-4491dc165091",
                                                "text": "When the second engine failed, the pilot was forced to ditch; their last location was just south of the Azores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13883e54-b68a-3280-a899-d53c513c90e1",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To deliberately not attend classes; to play hookey."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4e71ee-9f46-47c1-bff6-4f14ab736865",
                                                "sense_id": "13883e54-b68a-3280-a899-d53c513c90e1",
                                                "text": "The truant officer caught Louise ditching with her friends, and her parents were forced to pay a fine."
                                            },
                                            {
                                                "example_id": "8d9d64e3-92dc-49d3-ba86-6443fac29a39",
                                                "sense_id": "13883e54-b68a-3280-a899-d53c513c90e1",
                                                "text": "\"No, instead, it just had enough power to transform me, overload, and force me to wait to change back! I had to ditch school!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9724af4d-bb3e-32cc-b715-b42185bf4711",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To dig ditches."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef484896-230e-44ba-a145-b0ff0109a34a",
                                                "sense_id": "9724af4d-bb3e-32cc-b715-b42185bf4711",
                                                "text": "Enclosure led to fuller winter employment in hedging and ditching."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471bb51f-22ca-3ae5-a9e0-9fcc6edab569",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To dig ditches around."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed70ea1a-9d7f-4098-bb1a-a5dd68d35eee",
                                                "sense_id": "471bb51f-22ca-3ae5-a9e0-9fcc6edab569",
                                                "text": "The soldiers ditched the tent to prevent flooding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70b6d08b-b91d-33a9-a7e2-57e6c3a2aa68",
                                        "entry_id": "866652fe-0934-358a-8a1c-b41cc39f70a8",
                                        "glosses": [
                                            "To throw into a ditch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1511b7c-3d89-46a5-b052-5b2e4c8300ec",
                                                "sense_id": "70b6d08b-b91d-33a9-a7e2-57e6c3a2aa68",
                                                "text": "The engine was ditched and turned on its side."
                                            }
                                        ]
                                    }
                                ]
                            },
