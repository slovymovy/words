                "translations": [
                    {
                        "translation_id": "feafac5f-d266-4bea-a8f2-8786c90c9ad4",
                        "source_entry_id": "1d6c0c67-fd3c-348b-b332-682a8dd223c4",
                        "source_sense_id": "8e88b72a-8d89-3a46-9190-f8df24245f12",
                        "target_lang_word": "boundless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boundless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81b125aa-094d-31a7-b6ee-d4880dfbeb1b",
                                        "entry_id": "d0230714-bdd2-3365-a6f2-470caf5daeac",
                                        "glosses": [
                                            "Without bounds, unbounded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3611b302-63e0-4494-b5a7-bceeec858301",
                                                "sense_id": "81b125aa-094d-31a7-b6ee-d4880dfbeb1b",
                                                "text": "'Tis the cruel gripe, / That lean hard-handed poverty inflicts, / The hope of better things, the chance to win, / The wiſh to ſhine, the thirſt to be amus'd, / That at the found of Winter's hoary wing, / Unpeople all our counties, of ſuch herds, / Of flutt'ring, loit'ring, cringing, begging, looſe, / And wanton vagrants, as make London, vaſt / And boundless as it is, a crowded coop."
                                            },
                                            {
                                                "example_id": "14efde6f-63d5-4169-a35d-b3c3cc8a5c3e",
                                                "sense_id": "81b125aa-094d-31a7-b6ee-d4880dfbeb1b",
                                                "text": "Round the decay / Of that colossal wreck, boundless and bare / The lone and level sands stretch far away."
                                            },
                                            {
                                                "example_id": "4d58ec15-0993-4076-972e-cf450eac4449",
                                                "sense_id": "81b125aa-094d-31a7-b6ee-d4880dfbeb1b",
                                                "text": "[…] still, from the audacious, daring, and boundless adventure of their subsequent lives, strangely blend with these unoutgrown peculiarities, a thousand bold dashes of character, not unworthy a Scandinavian sea-king, or a poetical Pagan Roman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
