                        ],
                        "examples": [
                            {
                                "example_id": "aad69a96-47cf-43d9-829a-2a8a098d0fc9",
                                "sense_id": "ebd7094c-b1f1-3e0b-a3a3-4eaacc97c20d",
                                "text": "J’ai toujours tout esgourdé et tout gardé pour moi."
                            },
                            {
                                "example_id": "bf3c9a81-7986-47fa-bcc9-1bbc83ae76aa",
                                "sense_id": "ebd7094c-b1f1-3e0b-a3a3-4eaacc97c20d",
                                "text": "Esgourdez rien qu’un instant\nLa goualante du pauvre Jean\nQue les femmes n’aimaient pas\n[…]"
                            },
                            {
                                "example_id": "1faf1002-e377-42c8-bee8-0ac81845384c",
                                "sense_id": "ebd7094c-b1f1-3e0b-a3a3-4eaacc97c20d",
                                "text": "Au milieu d’un groupe de reporters, le signor Tuttiquanti discourt et raconte comment il a découvert le larcin. Je me joins aux assistants pour esgourder."
                            }
                        ]
                    }
