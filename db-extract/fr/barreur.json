                    },
                    {
                        "form_id": "3a596a8a-5fc9-4fa3-a3ff-d53f9e42cde9",
                        "entry_id": "1031a8ab-427e-37b2-be6e-1e7acbf78bc1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "barreuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5321dca-10b6-39df-a3f9-184c7c45f834",
                        "entry_id": "1031a8ab-427e-37b2-be6e-1e7acbf78bc1",
                        "glosses": [
                            "Celui qui tient la barre d'un bateau pour le diriger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2b0bac-4e6a-4a5c-ad91-3b453561b755",
                                "sense_id": "e5321dca-10b6-39df-a3f9-184c7c45f834",
                                "text": "La jeune fille, assise dans le fauteuil du barreur, se laissait aller à la douceur d’être sur l’eau."
                            },
                            {
                                "example_id": "bb2fb169-952c-4b2c-bfb3-03d471bced59",
                                "sense_id": "e5321dca-10b6-39df-a3f9-184c7c45f834",
                                "text": "Pendant que l'équipier remet de l'ordre dans le bateau, le barreur règle le spinnaker et passe ensuite la retenue et l'écoute à l'équipier. Lorsque cela est terminé, ils peuvent reprendre la route normale."
                            },
                            {
                                "example_id": "7bdf63a9-2d3a-41cc-bf50-c35de7281729",
                                "sense_id": "e5321dca-10b6-39df-a3f9-184c7c45f834",
                                "text": "L'avantage, en mer, est que le barreur qui a vécu un départ au lof, sous spi (de manière irrésistible, le bateau se couche, ralentit et s’arrête vent de travers), n’ignorera plus qu’il doit être prêt, la prochaine fois, à lâcher le « bras » de cette voile pas comme les autres."
                            },
                            {
                                "example_id": "0052c494-69ac-4428-b302-b60ec63ac573",
                                "sense_id": "e5321dca-10b6-39df-a3f9-184c7c45f834",
                                "text": "Je vais peut-être briser un mythe, mais sur L'Hermione, on est en permanence minimum deux barreurs. Lorsque la météo se dégrade, deux autres barreurs viennent apporter leur aide. Et l'ensemble de l'équipe barreurs est sous l'ordre de l'officier de quart."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b78dadd-0cdf-38f6-b4e5-83aeff971ea2",
                        "entry_id": "1031a8ab-427e-37b2-be6e-1e7acbf78bc1",
                        "glosses": [
                            "En aviron, membre d'une équipe de rameurs chargé d’assurer le rythme et de diriger le bateau."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99f9dfb8-b361-4081-b0b0-2a0e87eefad2",
                        "source_entry_id": "1031a8ab-427e-37b2-be6e-1e7acbf78bc1",
                        "target_lang_word": "Steuermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steuermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                        "entry_id": "3072f12b-fdef-35d3-a662-e1b7a9131074",
                                        "glosses": [
                                            "Nautik, Wassersport: (zum Beispiel im Rudern) derjenige, der das Boot steuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a32ff6-523b-4f93-a428-52ff1aefb82b",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "Der Steuermann erhält die Goldmedaille."
                                            },
                                            {
                                                "example_id": "21ed49d5-3243-4d3c-a2c3-58204d61631e",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                                            },
                                            {
                                                "example_id": "4b6b6714-4b45-4ce9-8be7-6ae3472fa7b2",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann trug eine braunweiß gestreifte Strickmütze, die am Hinterkopf hochgeschlagen war.“"
                                            },
                                            {
                                                "example_id": "dbe1285b-7c08-4eae-95c6-4a59791664cc",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Bis in die 80er Jahre wurde zu jeder Fahrt auf dieser Strecke ein ortskundiger Rheinlotse als Steuermann hinzugezogen.“"
                                            },
                                            {
                                                "example_id": "e6d89a0c-d47f-463b-8076-2f5b7bcb5d25",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann war allein an Bord, und ich nahm meinen Mut zusammen und fragte ihn, ob er nicht einen Schiffsjungen brauche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
