                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом дети любят бегать <w>босиком</w> по росе. ",
                            "target_lang_translations": {
                                "en": "In summer, children like to run <w>barefoot</w> through the dew.",
                                "es": "En verano a los niños les gusta correr <w>descalzos</w> por el rocío.",
                                "fr": "En été, les enfants aiment courir <w>pieds nus</w> dans la rosée."
                            }
                        },
                        {
                            "text": "Мы решили пойти <w>босиком по траве</w> около дома.",
                            "target_lang_translations": {
                                "en": "We decided to walk <w>barefoot on the grass</w> near the house.",
                                "es": "Decidimos caminar <w>descalzos por la hierba</w> cerca de casa.",
                                "fr": "Nous avons décidé de marcher <w>pieds nus sur l'herbe</w> près de la maison."
                            }
                        }
                    ],
                    "synonyms": [
