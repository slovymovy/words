                "senses": [
                    {
                        "sense_id": "21225819-7dd4-35c3-b7e2-cccb1d332dfd",
                        "entry_id": "82ec5d8f-e579-36dc-8a72-9203618e6085",
                        "glosses": [
                            "pogląd sprzeciwiający się estetyzmowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7601d0-be39-4534-a5ec-b707f2f0a0fc",
                                "sense_id": "21225819-7dd4-35c3-b7e2-cccb1d332dfd",
                                "text": "A idąc dalej — czy na tle dotychczasowych kanonów estetyki wyrasta coś w rodzaju antyestetyki?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
