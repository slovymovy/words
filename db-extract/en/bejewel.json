                "senses": [
                    {
                        "sense_id": "1ed71a48-01f0-3b1e-9ba4-14f27f2fdd0a",
                        "entry_id": "8a577e18-c559-39b7-8a1d-fcfbab2ae481",
                        "glosses": [
                            "To decorate or bedeck with jewels or gems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6011afa6-3f4e-4ce6-ad51-2f49137551cc",
                                "sense_id": "1ed71a48-01f0-3b1e-9ba4-14f27f2fdd0a",
                                "text": "Men should remove any earrings. Hands are the only areas where rings of any sort should appear. Ditch any eyebrow, lip, or nose rings until after work. Also, do not use this occasion to bejewel yourself in all your finery."
                            },
                            {
                                "example_id": "392c5974-535c-4e2a-9569-f5bb91f60a96",
                                "sense_id": "1ed71a48-01f0-3b1e-9ba4-14f27f2fdd0a",
                                "text": "They bejewel each other beautifully to promote their evil cause."
                            }
                        ]
                    }
                ],
