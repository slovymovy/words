                        "entry_id": "15c42edc-1151-344f-8bf6-3e12ba5c3901",
                        "glosses": [
                            "Boogvormige brug die stevig is omdat er alleen maar drukkrachten optreden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55611ec7-6071-4375-9c93-974e754b25e7",
                                "sense_id": "d80e0648-5747-3eb9-bf31-db7aced9d3ae",
                                "text": "De boogbrug is het oudste niet-triviale ontwerp voor een brug, bedacht in Mesopotamië en verfijnd door de oude Grieken en Romeinen."
                            }
                        ]
                    }
                ],
