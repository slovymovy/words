{
    "word_family": [
        "zulk",
        "zodanig"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "bc48376b-cf7b-3a50-bb08-59bd90c46a33",
                    "sense_definition": "Verbogen vorm van <w>zulk</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "demonstrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb nog nooit <w>zulke</w> mooie bloemen gezien in deze tuin.",
                            "target_lang_translations": {
                                "en": "I have never seen <w>such</w> beautiful flowers in this garden.",
                                "ru": "Я еще никогда не видел <w>таких</w> красивых цветов в этом саду."
                            }
                        },
                        {
                            "text": "Waarom draag je <w>zulke</w> oude schoenen naar het feest?",
                            "target_lang_translations": {
                                "en": "Why are you wearing <w>such</w> old shoes to the party?",
                                "ru": "Почему ты надеваешь <w>такие</w> старые туфли на вечеринку?"
                            }
                        }
                    ],
                    "synonyms": [
                        "dergelijke",
                        "zodanige"
                    ],
                    "common_phrases": [
                        "zulke dingen",
                        "zulke mensen"
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of 'zulk', used to indicate a certain kind or type of plural nouns.",
                        "ru": "Склоняемая форма слова 'zulk', используемая для указания на подобные предметы или качества."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "of this or that kind"
                            },
                            {
                                "target_lang_word": "like that",
                                "target_lang_sense_clarification": "similar to those"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "такие",
                                "target_lang_sense_clarification": "подобные этому или этой категории"
                            },
                            {
                                "target_lang_word": "такие же",
                                "target_lang_sense_clarification": "аналогичные по качеству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07323e52-471e-35a4-abd8-ce4e23418500",
                    "sense_definition": "Gebruikt om een sterke graad of verbazing uit te drukken; vergelijkbaar met 'wat een'.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zulke</w> scherpslijpers! Je zou ze toch wat doen!",
                            "target_lang_translations": {
                                "en": "<w>Such</w> nitpickers! You'd really want to give them a piece of your mind!",
                                "ru": "<w>Какие</w> зануды! Так бы им и врезал!"
                            }
                        },
                        {
                            "text": "Het is ongelooflijk dat zij <w>zulke</w> grote fouten maken.",
                            "target_lang_translations": {
                                "en": "It is unbelievable that they make <w>such</w> big mistakes.",
                                "ru": "Невероятно, что они совершают <w>такие</w> грубые ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "zulk"
                    ],
                    "common_phrases": [
                        "zulke grote"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express a high degree or surprise; similar to 'what a' or 'so'.",
                        "ru": "Используется для выражения сильной степени или удивления; часто соответствует восклицанию 'какие'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such",
                                "target_lang_sense_clarification": "emphasizing a quality"
                            },
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "to such a great extent"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "какие",
                                "target_lang_sense_clarification": "в восклицательных предложениях"
                            },
                            {
                                "target_lang_word": "такие",
                                "target_lang_sense_clarification": "для усиления степени признака"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "3dad388b-3d58-3945-94bf-94b7a8483329",
                    "sense_definition": "Zelfstandig gebruikte verbogen vorm van <w>zulk</w> om naar personen of zaken van een bepaalde soort te verwijzen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demonstrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik had <w>zulke</w> nog nooit gezien in het wild.",
                            "target_lang_translations": {
                                "en": "I had never seen <w>ones like that</w> in the wild.",
                                "ru": "Я никогда не видел <w>таких</w> в дикой природе."
                            }
                        },
                        {
                            "text": "Er zijn altijd mensen die <w>zulke</w> beweren zonder bewijs.",
                            "target_lang_translations": {
                                "en": "There are always people who claim <w>such things</w> without proof.",
                                "ru": "Всегда найдутся люди, которые утверждают <w>подобное</w> без доказательств."
                            }
                        }
                    ],
                    "synonyms": [
                        "dergelijke"
                    ],
                    "target_lang_definitions": {
                        "en": "Independently used form referring to people or things of a certain type.",
                        "ru": "Самостоятельно используемая форма для обозначения людей или вещей определенного типа."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "such things",
                                "target_lang_sense_clarification": "items of that kind"
                            },
                            {
                                "target_lang_word": "such people",
                                "target_lang_sense_clarification": "individuals of that type"
                            },
                            {
                                "target_lang_word": "ones like that",
                                "target_lang_sense_clarification": "referring back to a category"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "такие",
                                "target_lang_sense_clarification": "в значении 'подобные вещи' или 'подобные люди'"
                            },
                            {
                                "target_lang_word": "подобные",
                                "target_lang_sense_clarification": "вещи такого рода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}