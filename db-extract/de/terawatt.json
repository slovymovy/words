                    {
                        "sense_id": "9caf4eaf-e426-3d42-bba6-6d76b89b0ffa",
                        "entry_id": "54f0b9a2-56df-3f2a-befa-6425e0e86ca3",
                        "glosses": [
                            "eine Billion Watt"
                        ],
