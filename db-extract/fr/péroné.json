                                            {
                                                "example_id": "192ef7c3-eabe-4bfb-a474-c0cd2ed01ec9",
                                                "sense_id": "e944f158-986a-3545-8e5f-9d3159193754",
                                                "text": "Tweeduizend jaar lang bloeide de kunst van de fibula: de kledingspeld waarmee mantels en, jurken werden dichtgehouden. Tot in de elfde eeuw een nieuwe uitvinding doorbrak: de knoop. In Nederland alleen zijn er al 25.000 fibula’s teruggevonden."
                                            }
                                        ]
                                    },
