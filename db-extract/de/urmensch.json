                "senses": [
                    {
                        "sense_id": "d9e57065-b64d-3195-b4ac-c31e0580f720",
                        "entry_id": "caaf05db-fbea-3c9a-9960-c77172cd5b41",
                        "glosses": [
                            "Vertreter der frühesten Entwicklungsstufe des Menschen, aus der heraus sich alle anderen Menschen entwickelt haben"
                        ],
                        "tags": [
                            "Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6d9c0927-9992-4d8a-90de-242b6aa27bd6",
                                "sense_id": "d9e57065-b64d-3195-b4ac-c31e0580f720",
                                "text": "„Forscher haben in Äthiopien die Überreste eines Frühmenschen entdeckt, der in der selben Zeitepoche wie der Urmensch Lucy lebte. Die Wissenschaftler um Yohannes Haile-Selassie vom Naturkundemuseum von Cleveland datierten die Reste des in der Wüstenregion Afar im Osten Äthiopiens gefundenen Fossils auf ein Alter zwischen 3,3 und 3,5 Millionen Jahren.“"
                            },
                            {
                                "example_id": "95cb6675-9ac7-4aa5-9fb7-21a36d784da5",
                                "sense_id": "d9e57065-b64d-3195-b4ac-c31e0580f720",
                                "text": "„Obwohl nur Knochen- und Zahnfragmente der Urmenschen erhalten geblieben sind, bieten sich Möglichkeiten, ihre Lebensweise zu interpretieren und zu rekonstruieren.“"
                            },
                            {
                                "example_id": "7a6c64b5-6f91-450f-98b1-3de380c1ea44",
                                "sense_id": "d9e57065-b64d-3195-b4ac-c31e0580f720",
                                "text": "„Die moderne Anthropologie übersieht heute einigermaßen den unsäglich mühevollen Weg vom Urmenschen zum Kulturmenschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0d21b87-7a78-36ed-aa82-49ce61b85547",
                        "entry_id": "caaf05db-fbea-3c9a-9960-c77172cd5b41",
