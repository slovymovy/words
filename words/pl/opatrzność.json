                            {
                                "target_lang_word": "providence",
                                "target_lang_sense_clarification": "divine care and guidance"
                            },
                            {
                                "target_lang_word": "divine providence",
                                "target_lang_sense_clarification": "God's protective intervention and care"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b71020f-d97f-3639-a24b-c824211121ae",
                    "sense_definition": "przeznaczenie lub siła decydująca o biegu zdarzeń",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religia_los",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czuli, że ślepa <w>opatrzność</w> połączyła ich drogi w najmniej spodziewanym momencie.",
                            "target_lang_translations": {
                                "en": "They felt that blind <w>fate</w> crossed their paths at the least expected moment."
                            }
                        },
                        {
                            "text": "Trudno było walczyć z tym, co przyniosła nieubłagana <w>opatrzność</w>.",
                            "target_lang_translations": {
                                "en": "It was hard to fight against what relentless <w>destiny</w> had brought."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ślepa opatrzność",
                        "wyroki opatrzności"
