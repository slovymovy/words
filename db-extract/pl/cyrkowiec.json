                    {
                        "sense_id": "0e46dccf-5026-3d6c-a21d-2508435635b7",
                        "entry_id": "8104de83-948a-3a4e-9791-370c8d006f6b",
                        "glosses": [
                            "artysta występujący w cyrku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbf8c0b-a3c2-46ee-875d-bf9d0a9a35d6",
                                "sense_id": "0e46dccf-5026-3d6c-a21d-2508435635b7",
                                "text": "Gdy światła zgasły, na arenę wybiegło kilku cyrkowców."
                            },
                            {
                                "example_id": "7858c4a2-d862-4fc6-a6dd-6de7e319bdec",
                                "sense_id": "0e46dccf-5026-3d6c-a21d-2508435635b7",
                                "text": "Wyraz „heca” już się całkowicie zleksykalizował i stracił związek ze szczuciem zwierząt, chociaż miał taki niemiecki źródłosłów; odtąd związał się na stałe z cyrkowcami i komediantami."
                            }
                        ],
