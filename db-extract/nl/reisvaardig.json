                ],
                "senses": [
                    {
                        "sense_id": "da28d85a-1fd2-354e-aefa-4d3cbfc95b61",
                        "entry_id": "994d6d09-41b9-3bde-9b27-326d591d5628",
                        "glosses": [
                            "gereed om te kunnen reizen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0214a2ce-6340-46b9-8ae9-50c61601ecf1",
                                "sense_id": "da28d85a-1fd2-354e-aefa-4d3cbfc95b61",
                                "text": "En het geschiedde in die dagen dat keizer Bloemius een decreet afkondigde dat alle inwoners van het rijk zich moesten inschrijven. Om gehoor te geven aan dit bevel maakten Jozef en Maria zich reisvaardig om zich te begeven naar hun gemeente van afkomst. Een samenvoeging van drie dorpen en een stadje. Berkelland geheten."
                            },
                            {
                                "example_id": "9efebaaf-899c-4a72-bdc7-0f1caec0dee0",
                                "sense_id": "da28d85a-1fd2-354e-aefa-4d3cbfc95b61",
                                "text": "De aardappelen achter op zijn bagagedrager die zeshonderd kilometer westwaarts zijn geoogst, zijn het optimistische bewijs dat Angola aan de vooravond van de verkiezingen weer reisvaardig is."
                            },
                            {
                                "example_id": "8e7de4c9-33f7-4a56-b7ed-77b83e0847bd",
                                "sense_id": "da28d85a-1fd2-354e-aefa-4d3cbfc95b61",
                                "text": "De leukste komkommers die ik ken, zijn met gemak de komkommers van Charlotte Mutsaers: getekende, reisvaardige komkommers met koffers in de hand en diepte in hun denken."
                            }
                        ]
                    }
