                        "form": "labélisation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58654a15-6978-31be-8b53-6a14c80ef63e",
                        "entry_id": "b9e494f4-7a27-380e-8a74-028da60a9edd",
                        "glosses": [
                            "Action de labelliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42e92603-641c-4e93-a197-baf81699afe8",
                                "sense_id": "58654a15-6978-31be-8b53-6a14c80ef63e",
                                "text": "La procédure de labellisation permet, grâce à l’effet de levier des subventions versées à chaque entreprise, d’accompagner un plus grand nombre d’entreprises françaises à l’international pour participer à des actions collectives de promotion répondant à des critères de qualité et d’intérêt économique."
                            },
                            {
                                "example_id": "0dc126ef-837c-41ec-b43c-9f23ad82ab5e",
                                "sense_id": "58654a15-6978-31be-8b53-6a14c80ef63e",
                                "text": "À ce dernier point de vue et plus généralement, il ne faut pas négliger les effets économiques qui peuvent être attachés à une labellisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1d308fc-2b92-439a-b191-9110a9b39eb8",
                        "source_entry_id": "b9e494f4-7a27-380e-8a74-028da60a9edd",
                        "source_sense_id": "58654a15-6978-31be-8b53-6a14c80ef63e",
                        "target_lang_word": "labeling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99789bf-d59c-3c6a-adfe-94290c0e91a4",
                                        "entry_id": "0fcfa56d-8fc1-3e73-896b-d326f3b8001d",
                                        "glosses": [
                                            "A set of labels applied to the various objects in a system, to packaged goods, and so on; the act or process of applying them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03822bf6-6023-4ddf-b2de-a8953dc2a1d2",
                                                "sense_id": "b99789bf-d59c-3c6a-adfe-94290c0e91a4",
                                                "text": "Near-synonyms: (for packaged goods) branding, trade dress"
                                            },
                                            {
                                                "example_id": "dd8d4b1a-1926-418a-a8f2-eb9c2563a3f8",
                                                "sense_id": "b99789bf-d59c-3c6a-adfe-94290c0e91a4",
                                                "text": "The labeling is required to include the nutrition facts itemized in 21 CFR 101.9."
                                            },
                                            {
                                                "example_id": "72445335-e485-40fa-ac44-58830d0dd41f",
                                                "sense_id": "b99789bf-d59c-3c6a-adfe-94290c0e91a4",
                                                "text": "4:00PM (722) An upper bound for the number of graceful labelings of a path with n edges. Sylvia R. Naples, Bard College"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae2564f-82b7-31f4-8856-eb1c29e7669e",
                                        "entry_id": "0fcfa56d-8fc1-3e73-896b-d326f3b8001d",
                                        "glosses": [
                                            "The introduction of a traceable chemical group (e.g., containing an isotope or a fluorescent dye) into a protein or other biomolecule of interest so it can be tracked or quantified during experimental analysis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d052a16-542b-4bf8-9b93-bfea6d1abed7",
                                                "sense_id": "6ae2564f-82b7-31f4-8856-eb1c29e7669e",
                                                "text": "There are two potential problems with this approach: first, the specificity of labeling depends on the purity of the LPS (if contaminants are present, they may be labeled also); second, removal of the label from the LPS in vivo might occur separately from processing of the LPS molecule itself."
                                            }
                                        ]
                                    }
                                ]
