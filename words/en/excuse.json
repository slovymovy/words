{
    "word_family": [
        "excusable",
        "inexcusable",
        "excusatory",
        "excuseless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffa45657-30fc-3e99-b786-37f984600435",
                    "sense_definition": "To forgive or pardon someone for a small fault or mistake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "forgiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>excuse</w> my late arrival as the traffic was much worse than I expected.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>извините</w> моё позднее прибытие, так как пробки были гораздо хуже, чем я ожидал.",
                                "tr": "Trafik beklediğimden çok daha kötü olduğu için lütfen geç kalışımı <w>bağışlayın</w>."
                            }
                        },
                        {
                            "text": "I hope you can <w>excuse</w> my interruption but there is an urgent phone call for you.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, вы сможете <w>простить</w> моё вмешательство, но вам срочно звонят.",
                                "tr": "Lafınızı kesmemi <w>mazur görürsünüz</w> umarım, ancak sizin için acil bir telefon araması var."
                            }
                        }
                    ],
                    "synonyms": [
                        "forgive",
                        "pardon",
                        "let pass"
                    ],
                    "antonyms": [
                        "blame",
                        "punish"
                    ],
                    "common_phrases": [
                        "excuse my interruption",
                        "excuse the mess"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простить или извинить кого-либо за небольшую ошибку или проступок.",
                        "tr": "Birini küçük bir hatasından veya kusurundan dolayı affetmek, bağışlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извинять",
                                "target_lang_sense_clarification": "проявлять снисходительность"
                            },
                            {
                                "target_lang_word": "прощать",
                                "target_lang_sense_clarification": "снимать вину за проступок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mazur görmek",
                                "target_lang_sense_clarification": "kusura bakmamak, hoş görmek"
                            },
                            {
                                "target_lang_word": "affetmek",
                                "target_lang_sense_clarification": "bağışlamak"
                            },
                            {
                                "target_lang_word": "kusura bakmamak",
                                "target_lang_sense_clarification": "hoşgörü göstermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f15bce4d-7acb-3b7a-abd4-6c5ff2aa3612",
                    "sense_definition": "To allow someone to leave or to release them from a duty or obligation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher decided to <w>excuse</w> the student from the final exam due to his excellent grades.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>освободить</w> ученика от выпускного экзамена из-за его отличных оценок.",
                                "tr": "Öğretmen, mükemmel notları nedeniyle öğrenciyi final sınavından <w>muaf tutmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "May I be <w>excused</w> from the table now that I have finished my dinner?",
                            "target_lang_translations": {
                                "ru": "Можно мне <w>выйти</w> из-за стола, раз уж я закончил ужинать?",
                                "tr": "Yemeğimi bitirdiğime göre masadan <w>ayrılmama izin var mı</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "exempt",
                        "discharge"
                    ],
                    "common_phrases": [
                        "excused from class",
                        "excuse yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволить кому-либо уйти или освободить от выполнения обязанности или долга.",
                        "tr": "Birinin gitmesine izin vermek veya onu bir görev ya da yükümlülükten muaf tutmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "от обязанности или урока"
                            },
                            {
                                "target_lang_word": "отпускать",
                                "target_lang_sense_clarification": "позволять уйти"
                            },
                            {
                                "target_lang_word": "извинить",
                                "target_lang_sense_clarification": "позволить выйти из-за стола или комнаты"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muaf tutmak",
                                "target_lang_sense_clarification": "görev veya dersten muaf kılmak"
                            },
                            {
                                "target_lang_word": "izin vermek",
                                "target_lang_sense_clarification": "ayrılmasına müsaade etmek"
                            },
                            {
                                "target_lang_word": "bağışlamak",
                                "target_lang_sense_clarification": "sorumluluktan muaf tutmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e68139f1-7130-3352-b728-15efd6a89ca2",
                    "sense_definition": "To provide a reason or justification for a behavior or action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing can <w>excuse</w> such rude behavior toward a guest in our home.",
                            "target_lang_translations": {
                                "ru": "Ничто не может <w>оправдать</w> такое грубое поведение по отношению к гостю в нашем доме.",
                                "tr": "Hiçbir şey evimizdeki bir misafire karşı gösterilen böyle kaba bir davranışı <w>haklı çıkaramaz</w>."
                            }
                        },
                        {
                            "text": "He tried to <w>excuse</w> his laziness by claiming he was feeling unwell.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>оправдать</w> свою лень, утверждая, что плохо себя чувствует.",
                                "tr": "Kendini kötü hissettiğini iddia ederek tembelliğini <w>mazur göstermeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "justify",
                        "vindicate",
                        "plead"
                    ],
                    "common_phrases": [
                        "excuse his behavior",
                        "nothing can excuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить причину или обоснование для поведения или действия.",
                        "tr": "Bir davranış veya eylem için geçerli bir sebep veya gerekçe sunmak, haklı çıkarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "находить смягчающие обстоятельства"
                            },
                            {
                                "target_lang_word": "служить оправданием",
                                "target_lang_sense_clarification": "быть причиной прощения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haklı çıkarmak",
                                "target_lang_sense_clarification": "gerekçe göstermek"
                            },
                            {
                                "target_lang_word": "ofradmak",
                                "target_lang_sense_clarification": "kusuru hafifletici sebep bulmak"
                            },
                            {
                                "target_lang_word": "mazur göstermek",
                                "target_lang_sense_clarification": "anlaşılır kılmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "198aa228-6d68-324a-ab6f-2eefb39d1552",
                    "sense_definition": "An explanation offered to justify a fault or to avoid being blamed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always has a clever <w>excuse</w> for why his homework is never finished on time.",
                            "target_lang_translations": {
                                "ru": "У него всегда есть хитрое <w>оправдание</w> тому, почему его домашнее задание никогда не готово вовремя.",
                                "tr": "Ödevinin neden hiçbir zaman vaktinde bitmediğine dair her zaman zekice bir <w>bahanesi</w> vardır."
                            }
                        },
                        {
                            "text": "I had to make an <w>excuse</w> for being late to the meeting this morning.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось придумать <w>отговорку</w> из-за опоздания на встречу сегодня утром.",
                                "tr": "Bu sabah toplantıya geç kaldığım için bir <w>mazeret</w> uydurmak zorunda kaldım."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretext",
                        "pretense"
                    ],
                    "common_phrases": [
                        "make an excuse",
                        "lame excuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объяснение, предлагаемое для оправдания вины или во избежание обвинений.",
                        "tr": "Bir kusuru haklı çıkarmak veya suçlanmaktan kaçınmak için sunulan açıklama veya gerekçe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "обоснование поступка"
                            },
                            {
                                "target_lang_word": "отговорка",
                                "target_lang_sense_clarification": "вымышленная причина для уклонения"
                            },
                            {
                                "target_lang_word": "предлог",
                                "target_lang_sense_clarification": "повод для действия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mazeret",
                                "target_lang_sense_clarification": "geçerli özür veya açıklama"
                            },
                            {
                                "target_lang_word": "bahane",
                                "target_lang_sense_clarification": "uydurma sebep veya gerekçe"
                            },
                            {
                                "target_lang_word": "özür",
                                "target_lang_sense_clarification": "bağışlanma sebebi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8dbec4e-0deb-3597-897c-cb858f0df3a9",
                    "sense_definition": "A very poor or inferior example of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inferiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That rusty old car is a sorry <w>excuse</w> for a vehicle.",
                            "target_lang_translations": {
                                "ru": "Эта ржавая старая машина — жалкое <w>подобие</w> транспортного средства.",
                                "tr": "Şu paslı eski araba, taşıt <w>bozuntusundan</w> başka bir şey değil."
                            }
                        },
                        {
                            "text": "The meal they served was a poor <w>excuse</w> for Italian cuisine.",
                            "target_lang_translations": {
                                "ru": "Еда, которую они подали, была плохой <w>пародией</w> на итальянскую кухню.",
                                "tr": "Sunumunu yaptıkları yemek, İtalyan mutfağının kötü bir <w>taklidiydi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poor excuse for",
                        "sorry excuse for"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'poor' or 'sorry'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой или некачественный пример чего-либо.",
                        "tr": "Bir şeyin çok kötü, yetersiz veya niteliksiz bir örneği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобие",
                                "target_lang_sense_clarification": "жалкое или плохое"
                            },
                            {
                                "target_lang_word": "пародия",
                                "target_lang_sense_clarification": "неудачный пример чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bozuntusu",
                                "target_lang_sense_clarification": "kötü veya değersiz taklidi"
                            },
                            {
                                "target_lang_word": "karikatürü",
                                "target_lang_sense_clarification": "gülünç ve kötü örneği"
                            },
                            {
                                "target_lang_word": "taklidi",
                                "target_lang_sense_clarification": "yetersiz örneği"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58df8e56-b255-3d13-8c23-a1fe8c224429",
                    "sense_definition": "A legal defense where one admits to an act but claims special circumstances remove culpability.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the defendant's mental state provided a legal <w>excuse</w> for the incident.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что психическое состояние подсудимого дает законное <w>оправдание</w> инциденту.",
                                "tr": "Avukat, sanığın akli dengesinin olay için hukuki bir <w>gerekçe</w> oluşturduğunu savundu."
                            }
                        },
                        {
                            "text": "In some jurisdictions, necessity can be used as an <w>excuse</w> for certain minor crimes.",
                            "target_lang_translations": {
                                "ru": "В некоторых юрисдикциях крайняя необходимость может быть использована как <w>оправдание</w> для определенных мелких преступлений.",
                                "tr": "Bazı hukuk sistemlerinde zorunluluk hali, belirli küçük suçlar için bir <w>mazeret</w> olarak kullanılabilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal excuse",
                        "lawful excuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая защита, при которой лицо признает деяние, но заявляет об особых обстоятельствах, снимающих вину.",
                        "tr": "Kişinin eylemi kabul ettiği ancak özel durumların cezai sorumluluğu kaldırdığını iddia ettiği hukuki savunma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "юридическое основание невиновности"
                            },
                            {
                                "target_lang_word": "обстоятельство, исключающее вину",
                                "target_lang_sense_clarification": "правовой термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hukuki mazeret",
                                "target_lang_sense_clarification": "sorumluluğu kaldıran hal"
                            },
                            {
                                "target_lang_word": "gerekçe",
                                "target_lang_sense_clarification": "hukuki savunma sebebi"
                            },
                            {
                                "target_lang_word": "kusurluluğu ortadan kaldıran neden",
                                "target_lang_sense_clarification": "ceza hukuku terimi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}