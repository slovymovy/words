                                        "entry_id": "9c8bc263-8bb8-3e81-98df-12c1c0232f43",
                                        "glosses": [
                                            "composto orgânico derivado de aminoácidos, produzido naturalmente no fígado, rins e pâncreas, e armazenado principalmente nos músculos, onde atua como reserva de energia"
                                        ],
                                        "tags": [
                                            "bioquímica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d3d72b-f7c5-453a-bb4f-feea01e7892d",
                                                "sense_id": "9ac87e72-284a-382e-8cae-1deaf307df07",
                                                "text": "A creatina é fundamental para o fornecimento rápido de energia durante exercícios de alta intensidade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50703953-b303-3243-9a1c-cca6932bc3d4",
                                        "entry_id": "9c8bc263-8bb8-3e81-98df-12c1c0232f43",
                                        "glosses": [
                                            "suplemento alimentar utilizado para aumentar a massa muscular, melhorar o desempenho físico e acelerar a recuperação após atividades intensas"
                                        ],
                                        "tags": [
                                            "nutrição"
                                        ],
                                        "examples": [
