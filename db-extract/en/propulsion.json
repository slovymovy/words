                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antrieb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0359c6dc-03de-311a-8432-8b0a859dc8de",
