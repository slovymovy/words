                                            {
                                                "example_id": "319fa4ee-a813-4cfb-9d97-5c687afeda3e",
                                                "sense_id": "1e9f3e8c-2eaf-3cad-b865-c6f2cb208061",
                                                "text": "It took a long time for the place to warm up and to counteract the cold and enable their fingers to cope with the delicate task of moulding, the men would often surround themselves with blocks of iron heated in the furnace."
                                            },
                                            {
                                                "example_id": "b2a65cb3-4c83-4311-9d00-0aee32445646",
                                                "sense_id": "1e9f3e8c-2eaf-3cad-b865-c6f2cb208061",
                                                "text": "The stateroom walls are veneered with finely figured English chestnut with the skirting and mouldings in English walnut."
                                            }
