                "senses": [
                    {
                        "sense_id": "104e07fa-df49-3936-ab6e-296464dabaa2",
                        "entry_id": "85a03611-8445-3733-b9ab-d1128bacc58d",
                        "glosses": [
                            "Essuyer en utilisant un torchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70364772-30fa-45d5-8efb-5748fc824f41",
                                "sense_id": "104e07fa-df49-3936-ab6e-296464dabaa2",
                                "text": "L’adjointe préside, à deux pas de la balustrade, moi je torchonne au fond du préau, ou même dans une des classes."
                            },
                            {
                                "example_id": "a79659f1-9b58-47da-a7e5-ad0388d97e86",
                                "sense_id": "104e07fa-df49-3936-ab6e-296464dabaa2",
                                "text": "La vocation prête à l’abandonner, l’aide-barman torchonnait mollement, à l’écart, le plateau des tables."
                            }
                        ]
                    },
                    {
                        "sense_id": "893c5da2-c5ed-3b7c-9aad-b1824a035a6b",
                        "entry_id": "85a03611-8445-3733-b9ab-d1128bacc58d",
                        "glosses": [
                            "Bâcler, faire sans aucun soin un travail que l’on doit rendre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4afcb7c3-ee0c-36c9-b9b9-72dcb15aff45",
                        "entry_id": "85a03611-8445-3733-b9ab-d1128bacc58d",
                        "glosses": [
                            "Enivrer"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "74c48371-e73c-4dda-ab43-01b00b02118c",
                                "sense_id": "4afcb7c3-ee0c-36c9-b9b9-72dcb15aff45",
                                "text": "On retrouve le plus d’alcooliques là où le vin n’est pas implanté et là où on se torchonne à la bière. Donc, pas de faux procès au vin."
                            }
                        ]
                    }
