                    {
                        "translation_id": "bf0e2dc7-1d12-418c-9785-16a74cd20828",
                        "source_entry_id": "90466439-a99e-3ef9-9ccc-e088d263502d",
                        "source_sense_id": "a8387146-3d44-39a5-b860-44023cda459f",
                        "target_lang_word": "Trotskyite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                        "entry_id": "abbbe8ac-1e85-3d76-8f48-4df91da18b83",
                                        "glosses": [
                                            "An advocate of the communist doctrines of Leon Trotsky (born Лев Дави́дович Бронште́йн (Lev Davídovič Bronštéjn) / Lev Davidovich Bronstein)."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a790af-3884-48a7-a0c6-c94e1caed0d7",
                                                "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                                "text": "A great number of disillusioned young men in the Western world are saying now that it is Stalin who is to blame and proclaiming themselves Trotskyites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                        "entry_id": "99f055d2-40b0-3708-b699-fe3a5bbf0618",
                                        "glosses": [
                                            "Of, relating to, supporting, or advocating the doctrines of Leon Trotsky."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08604fe-e9d3-4a7b-8bd8-d61e61b51399",
                                                "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                                "text": "[…] [her] father had fought in the Lincoln Brigade but now provided janitorial supplies to factories by day and attended Trotskyite meetings by night […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01d7fa46-ede2-4b06-8f37-8848e9815f1f",
                        "source_entry_id": "90466439-a99e-3ef9-9ccc-e088d263502d",
                        "source_sense_id": "a8387146-3d44-39a5-b860-44023cda459f",
