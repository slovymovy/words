                "senses": [
                    {
                        "sense_id": "bc7f803c-cad9-359c-ba04-71ea53a14a6a",
                        "entry_id": "94d4c450-5a64-3278-82e4-d183789c9a68",
                        "glosses": [
                            "Vorrichtung zum Wechseln der Übersetzungsverhältnisse und damit der Schaltstufen in einem Mehrganggetriebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39df2780-f44b-4dab-b331-b5de42484a23",
                                "sense_id": "bc7f803c-cad9-359c-ba04-71ea53a14a6a",
                                "text": "„Diese Getriebe sollen eigentlich die Vorteile von automatischer Gangschaltung mit denen eines Schaltgetriebes verbinden.“"
                            },
                            {
                                "example_id": "55503278-5fb8-4001-b434-b93a05eadac9",
                                "sense_id": "bc7f803c-cad9-359c-ba04-71ea53a14a6a",
                                "text": "„Es fiel ihr schwer, ihn nicht anzusehen, nicht auf die Hand zu starren, die auf der Gangschaltung lag, und nicht nach ihr zu greifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db79b238-065f-4631-b673-27501cd70f89",
                        "source_entry_id": "94d4c450-5a64-3278-82e4-d183789c9a68",
                        "source_sense_id": "bc7f803c-cad9-359c-ba04-71ea53a14a6a",
                        "source_sense_description": "Vorrichtung zum Wechseln der Gänge im Fahrzeug",
                        "target_lang_word": "changement de vitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "changement de vitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79ddb289-12b8-3046-adb6-416d2787adf3",
                                        "entry_id": "df6e9c0a-7a01-30a1-bc32-ad27d995d2c2",
                                        "glosses": [
                                            "Système qui permet au moteur d’une voiture à traction automobile de tourner plus ou moins vite et plus ou moins de fois pour un tour de roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a5f6fa-a242-4000-aa05-14925da0adab",
                                                "sense_id": "79ddb289-12b8-3046-adb6-416d2787adf3",
                                                "text": "A ce point de vue, pour elle, l’application d’un appareil de changement de vitesse continu apparaît comme un enviable perfectionnement, digne de tous points d’être poursuivi dans le but de répartir le travail fourni régulièrement, et de proportionner à chaque instant l’effort demandé au moteur à celui exigé par la résistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0bd61a-acc6-3f74-bfb5-1816f3d117ec",
                                        "entry_id": "df6e9c0a-7a01-30a1-bc32-ad27d995d2c2",
                                        "glosses": [
                                            "Système qui permet de changer le développement ; dérailleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce60009-255b-4cdc-a053-75691a50a5c1",
                                                "sense_id": "6f0bd61a-acc6-3f74-bfb5-1816f3d117ec",
                                                "text": "… le changement de vitesse par dérailleur, qui permet une variété de développement beaucoup plus grande, a pris le dessus sur tous les autres systèmes. Il est moins esthétique que le moyeu, la ligne de chaîne n’y est jamais respectée, mais au point de vue rendement, il est nettement supérieur et c’est, du reste, pour cela que les coureurs l’ont adopté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd73ccd9-6c79-3b99-950c-89357698adb0",
                                        "entry_id": "df6e9c0a-7a01-30a1-bc32-ad27d995d2c2",
                                        "glosses": [
                                            "Type de lancer utilisé par les lanceurs dans lequel la balle se déplace plus lentement que lors d’un lancer précédent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
