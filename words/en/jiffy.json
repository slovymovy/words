{
    "word_family": [
        "jiff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e45f8c1-68cf-3c70-b659-dddd0bac5706",
                    "sense_definition": "A very short, unspecified length of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wait right here, I will be back in a <w>jiffy</w> with your coffee.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подождите здесь, я вернусь в <w>один миг</w> с вашим кофе."
                            }
                        },
                        {
                            "text": "Don't worry about the mess; we can clean the whole room in a <w>jiffy</w>.",
                            "target_lang_translations": {
                                "ru": "Не беспокойтесь о беспорядке; мы уберем всю комнату <w>в два счета</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moment",
                        "second",
                        "flash",
                        "trice",
                        "instant",
                        "tick"
                    ],
                    "common_phrases": [
                        "in a jiffy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень короткий, неопределенный промежуток времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "очень короткий промежуток времени"
                            },
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "момент"
                            },
                            {
                                "target_lang_word": "один момент",
                                "target_lang_sense_clarification": "быстрое действие"
                            },
                            {
                                "target_lang_word": "в два счета",
                                "target_lang_sense_clarification": "очень быстро"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0acbd7e-2c03-3a85-9d08-2c5d76c70761",
                    "sense_definition": "A padded envelope used for mailing items that need protection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "packaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find a <w>jiffy</w> to send this fragile book to my friend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти <w>мягкий конверт</w>, чтобы отправить эту хрупкую книгу другу."
                            }
                        },
                        {
                            "text": "The clerk handed me a large <w>jiffy</w> bag for the documents.",
                            "target_lang_translations": {
                                "ru": "Клерк протянул мне большой <w>защитный конверт</w> для документов."
                            }
                        }
                    ],
                    "synonyms": [
                        "padded envelope",
                        "bubble mailer",
                        "Jiffy bag"
                    ],
                    "common_phrases": [
                        "jiffy bag"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily UK, Australia, and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий конверт с защитным слоем, используемый для пересылки хрупких предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пакет с пупыркой",
                                "target_lang_sense_clarification": "разговорное название защитного конверта"
                            },
                            {
                                "target_lang_word": "бандерольный конверт",
                                "target_lang_sense_clarification": "конверт с защитным слоем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc65982e-8d01-391f-a8a0-8a84aaddb785",
                    "sense_definition": "A technical unit of time, often 0.01 seconds in computing or the duration of one AC power cycle.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system updates the system clock every <w>jiffy</w> to maintain accuracy.",
                            "target_lang_translations": {
                                "ru": "Операционная система обновляет системные часы каждый <w>тик</w> для поддержания точности."
                            }
                        },
                        {
                            "text": "In this specific hardware architecture, a <w>jiffy</w> corresponds to exactly one sixtieth of a second.",
                            "target_lang_translations": {
                                "ru": "В этой конкретной аппаратной архитектуре один <w>джиффи</w> соответствует ровно одной шестидесятой секунды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техническая единица времени, часто 0,01 секунды в вычислительной технике или длительность одного цикла переменного тока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "системный тик",
                                "target_lang_sense_clarification": "в вычислительной технике"
                            },
                            {
                                "target_lang_word": "джиффи",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b05aad93-6975-3bf4-926a-2a626b43a626",
                    "sense_definition": "The time taken for light to travel a specified distance in a vacuum, such as one centimeter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Physicists sometimes use the term <w>jiffy</w> to describe the time light takes to cross a nucleon.",
                            "target_lang_translations": {
                                "ru": "Физики иногда используют термин <w>джиффи</w> для описания времени, за которое свет пересекает нуклон."
                            }
                        },
                        {
                            "text": "Calculating the interval in a <w>jiffy</w> helps in understanding high-speed particle interactions.",
                            "target_lang_translations": {
                                "ru": "Вычисление интервала в <w>джиффи</w> помогает понять высокоскоростные взаимодействия частиц."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, за которое свет проходит определенное расстояние в вакууме (например, один сантиметр)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джиффи",
                                "target_lang_sense_clarification": "в физике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}