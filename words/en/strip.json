                                "target_lang_word": "комикс",
                                "target_lang_sense_clarification": "серия рисунков с текстом"
                            },
                            {
                                "target_lang_word": "стрип",
                                "target_lang_sense_clarification": "короткий комикс в несколько кадров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连环画",
                                "target_lang_sense_clarification": "叙事性图画"
                            },
                            {
                                "target_lang_word": "漫画",
                                "target_lang_sense_clarification": "报刊中的短篇漫画"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de6292c4-78ce-324d-a722-ce896289bfc9",
