                                "target_senses": [
                                    {
                                        "sense_id": "06217966-9865-3ce1-919c-cec6c1e7721a",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "A pedestrianised street, especially a shopping precinct."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89077758-c7da-4a08-8f86-1fb5a4eb9c52",
                                                "sense_id": "06217966-9865-3ce1-919c-cec6c1e7721a",
                                                "text": "The preliminary plans provide for one million square feet of selling space in three main buildings and a double row of shops along a central shopping mall."
                                            },
                                            {
                                                "example_id": "5f3ae806-e571-40ba-bf95-7a8e28789b60",
                                                "sense_id": "06217966-9865-3ce1-919c-cec6c1e7721a",
                                                "text": "America′s first pedestrianized shopping mall opened in 1959 in Kalamazoo, Michigan. Like most later pedestrian malls, it was intended to revive what everybody thought was a decaying downtown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29500d5a-86de-32dd-9f6c-407332256a85",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "An enclosed shopping centre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7ef9d76-d2fd-4187-b341-f7dc3f1f3727",
                                                "sense_id": "29500d5a-86de-32dd-9f6c-407332256a85",
                                                "text": "Every day, at about the time the rest of us go to work, groups of retirees gather at many of America′s enclosed shopping malls."
                                            },
                                            {
                                                "example_id": "0c08baae-b789-4948-b48a-4e339040957d",
                                                "sense_id": "29500d5a-86de-32dd-9f6c-407332256a85",
                                                "text": "Cancel plans just in case you'd call / And say, \"Meet me behind the mall\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb12e5e-c77d-3c2a-9049-93e86019f05a",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "An alley where the game of pall mall was played."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "726b492e-2f89-3707-8923-bab125867c9a",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "A public walk; a level shaded walk, a promenade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "744dcf92-d63b-4e3f-ab79-26d159485ce1",
                                                "sense_id": "726b492e-2f89-3707-8923-bab125867c9a",
                                                "text": "Part of the area was laid out in gravel walks, and planted with elms; and these convenient and frequented walks obtained the name of the City Mall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8737f70b-e218-3e11-b79c-21a183a24ef8",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "A heavy wooden mallet or hammer used in the game of pall mall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5248da91-3ce9-4ff2-bd7b-f0f07615a6f8",
                                                "sense_id": "8737f70b-e218-3e11-b79c-21a183a24ef8",
                                                "text": "I also fell slightly; but his fall proving a severe one, he arose in wrath, and struck me with the mall which he held in his hand, until my blood flowed copiously […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19f34721-06a5-37ee-ac7f-0925c24686aa",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "The game of polo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c912ccad-1c56-3d59-b947-127306c8f227",
                                        "entry_id": "6059b3ac-8dfb-3823-ac23-dae9514bcd15",
                                        "glosses": [
                                            "An old game played with malls or mallets and balls; pall mall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
