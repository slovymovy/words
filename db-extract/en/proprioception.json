                    },
                    {
                        "translation_id": "33a3bdea-aeac-476b-a673-7daa78a5e603",
                        "source_entry_id": "22de9136-59bb-3a04-8cf8-71157e30be66",
                        "source_sense_id": "1fa4dbe4-7b55-3992-a424-3c62fa9c489a",
                        "source_sense_description": "sense of the position of parts of the body",
                        "target_lang_word": "proprioception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proprioception",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                        "entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                                        "glosses": [
                                            "Perception des sensations issues du corps qui renseignent sur l’attitude, les mouvements, l’équilibre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2adbd3c9-c542-4b93-a2b7-ebc5a4430635",
                                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                                "text": "La rééducation par la proprioception utilise les stimulations les plus proches possibles du réel pour déclencher des mouvements inutilisés, et les renforcer."
                                            },
                                            {
                                                "example_id": "cdaa7eed-2d4c-47ce-b9d6-339162289859",
                                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                                "text": "Porter des compensées peut rendre le pied plat et entraîner une perte de musculature. La hauteur des semelles fait perdre deux tiers des points de contact avec le sol et donc une grande part de la proprioception (perception de la position du corps dans l’espace)."
                                            },
                                            {
                                                "example_id": "718b54d0-2a29-4361-b538-46773c2f3feb",
                                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                                "text": "Le yoga propose également un travail de tonification — proprioception (que l’on retrouve aussi dans le Tai-chi et le Qi gong), des mobilisations douces, des étirements et assouplissements qui contribuent à lever les contractures et blocages musculaires, ainsi que des respirations profondes, amples et lentes qui agissent contre les douleurs dorsales et apaisent les tensions psychiques ou émotionnelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0397b7f9-4c04-40db-b1f0-5ef71b187bd5",
                        "source_entry_id": "22de9136-59bb-3a04-8cf8-71157e30be66",
                        "source_sense_id": "1fa4dbe4-7b55-3992-a424-3c62fa9c489a",
