{
    "word_family": [
        "justification",
        "justificatif",
        "justifiable",
        "injustifiable",
        "justificateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e995da0-8bb2-34f4-9b07-b8352f6eeec4",
                    "sense_definition": "Montrer qu'une action, une décision ou une dépense est légitime, fondée ou acceptable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legitimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur lui demande de <w>justifier</w> ce choix avant la fin de la réunion."
                        },
                        {
                            "text": "Rien ne peut <w>justifier</w> une telle attitude envers des collègues de travail."
                        }
                    ],
                    "common_phrases": [
                        "justifier un choix",
                        "justifier une dépense"
                    ]
                },
                {
                    "sense_id": "8857b25f-4a12-388e-98b3-64056908736e",
                    "sense_definition": "Donner des explications pour tenter de faire accepter son comportement ou ses actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legitimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'arrête pas de chercher à se <w>justifier</w> après cette maladresse évidente."
                        },
                        {
                            "text": "Vous n'avez pas besoin de vous <w>justifier</w> devant tout le monde."
                        }
                    ],
                    "synonyms": [
                        "expliquer"
                    ],
                    "common_phrases": [
                        "chercher à se justifier",
                        "se justifier constamment"
                    ]
                },
                {
                    "sense_id": "a91d0a6c-03b1-3039-8371-136b8bc5f17d",
                    "sense_definition": "Apporter les documents ou les preuves nécessaires pour attester de son identité ou d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prouver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque candidat doit impérativement <w>justifier</w> de son identité avant l'épreuve."
                        },
                        {
                            "text": "Elle a pu <w>justifier</w> son domicile grâce à une facture d'électricité récente."
                        }
                    ],
                    "common_phrases": [
                        "justifier de son identité",
                        "justifier son domicile"
                    ]
                },
                {
                    "sense_id": "cfc08202-879d-330b-9f89-3a9b84b60238",
                    "sense_definition": "Démontrer l'innocence d'une personne ou la dégager de tout soupçon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "innocenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouvel élément vient pleinement <w>justifier</w> l'accusé devant le tribunal."
                        },
                        {
                            "text": "L'avocat a réussi à <w>justifier</w> son client d'une accusation particulièrement injuste."
                        }
                    ],
                    "common_phrases": [
                        "se justifier d'une accusation"
                    ]
                },
                {
                    "sense_id": "e572df0a-25fe-32e2-88b3-0bdc9d5e462b",
                    "sense_definition": "Confirmer par les résultats la justesse d'une attente, d'une prévision ou d'un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses excellents résultats aux examens sont venus <w>justifier</w> la confiance accordée."
                        },
                        {
                            "text": "Les faits ont rapidement <w>justifié</w> ses nombreuses craintes initiales."
                        }
                    ],
                    "common_phrases": [
                        "justifier la confiance"
                    ]
                },
                {
                    "sense_id": "1927d705-b5b5-3392-8fa8-faee850f0059",
                    "sense_definition": "Ajuster l'espacement des lignes d'un texte pour que les bords gauche et droit soient alignés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "typographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à <w>justifier</w> le texte du rapport pour obtenir une présentation soignée."
                        },
                        {
                            "text": "Le logiciel permet de <w>justifier</w> un paragraphe en un seul clic."
                        }
                    ],
                    "common_phrases": [
                        "justifier le texte",
                        "justifier un paragraphe"
                    ]
                },
                {
                    "sense_id": "4af0040c-659e-3b5a-a85f-6053a3af8199",
                    "sense_definition": "Rendre une personne juste aux yeux de Dieu par l'effet de la grâce divine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce texte théologique, la miséricorde du créateur vient <w>justifier</w> le croyant repenti."
                        },
                        {
                            "text": "La foi seule pouvait, d'après les fidèles, <w>justifier</w> le pêcheur en quête de salut."
                        }
                    ]
                }
            ]
        }
    ]
}