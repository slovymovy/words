                                "target_senses": [
                                    {
                                        "sense_id": "4037e01d-ebb3-3aa1-a01a-32e3c528fb9f",
                                        "entry_id": "7ae17810-7b4c-368e-a39a-ad522bb6c0f5",
                                        "glosses": [
                                            "Lasting for a short period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6856acde-309a-4e9d-b5aa-627ee3c43fd9",
                                                "sense_id": "4037e01d-ebb3-3aa1-a01a-32e3c528fb9f",
                                                "text": "1821-1822, Vicesimus Knox, Remarks on the tendency of certain Clauses in a Bill now pending in Parliament to degrade Grammar Schools\nEsteem, lasting esteem, the esteem of good men, like himself, will be his reward, when the gale of ephemeral popularity shall have gradually subsided."
                                            },
                                            {
                                                "example_id": "89715a24-f3a8-4244-b46e-8966274d8282",
                                                "sense_id": "4037e01d-ebb3-3aa1-a01a-32e3c528fb9f",
                                                "text": "sentences not of ephemeral, but of eternal, efficacy"
                                            },
                                            {
                                                "example_id": "6b63d3a8-9a25-4fe2-bbb6-7080898030cb",
                                                "sense_id": "4037e01d-ebb3-3aa1-a01a-32e3c528fb9f",
                                                "text": "It was during an access of this kind that I suddenly left my home, and bending my steps towards the near Alpine valleys, sought in the magnificence, the eternity of such scenes, to forget myself and my ephemeral, because human, sorrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e94dee0-b58e-3e5c-bcba-9e07d44a46a2",
                                        "entry_id": "7ae17810-7b4c-368e-a39a-ad522bb6c0f5",
                                        "glosses": [
                                            "Existing for only one day, as with some flowers, insects, and diseases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddb18b25-59e6-3431-aa80-31e831853130",
                                        "entry_id": "7ae17810-7b4c-368e-a39a-ad522bb6c0f5",
                                        "glosses": [
                                            "Usually dry, but filling with water for brief periods during and after precipitation."
                                        ],
                                        "tags": [
                                            "of a body of water"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1b6888-94ee-487b-91a1-d21185a7b906",
                                                "sense_id": "ddb18b25-59e6-3431-aa80-31e831853130",
                                                "text": "The graben constitutes a depositional basin and a topographic low, underlain by Cretaceous shales, in which volcanic debris accumulated in ephemeral lakes and streams in Oligocene and early Miocene time."
                                            }
                                        ]
                                    }
                                ]
