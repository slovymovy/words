                "senses": [
                    {
                        "sense_id": "115e0041-074f-3f81-b6bc-5822b0cd355b",
                        "entry_id": "c8a934cb-0317-355d-92d4-465730924f91",
                        "glosses": [
                            "Tout animal appartenant à une classe d’archosauriens comprenant les dinosaures et leurs parents les plus proches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d46951f0-fbb5-4b0e-acd7-a87694d189f5",
                                "sense_id": "115e0041-074f-3f81-b6bc-5822b0cd355b",
                                "text": "Par ailleurs, la morphologie du fémur d’Eucoelophysis est très semblable à celle du dinosauriforme basal Silesaurus opolensis Dzik, 2003 du Trias supérieur de Pologne."
                            },
                            {
                                "example_id": "9b5d9dd3-effd-444c-a492-8bccde4fdade",
                                "sense_id": "115e0041-074f-3f81-b6bc-5822b0cd355b",
                                "text": "Silesaurus est un genre de dinosauriforme ayant vécu au Carnien à la fin du Trias, il y a environ 230 millions d’années dans ce qui est maintenant la Pologne."
                            },
                            {
                                "example_id": "c5067b89-d80d-41ce-8448-a2b50b05be95",
                                "sense_id": "115e0041-074f-3f81-b6bc-5822b0cd355b",
                                "text": "Imaginez la scène : au début du Trias, des coléoptères s’occupent de leurs affaires sur un rocher couvert d’algues, au bord d’un lac, quand tout d’un coup, ils se retrouvent aspirés dans la gueule d’un dinosauriforme, un ancêtre des dinosaures."
                            }
                        ]
                    }
                ],
