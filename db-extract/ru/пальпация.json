                "senses": [
                    {
                        "sense_id": "c0d61cb6-5c07-3685-a8fe-c396e36d0281",
                        "entry_id": "821c66f3-738c-39e8-b4f8-9cef8a9c5efb",
                        "glosses": [
                            "физический метод медицинской диагностики, проводимый путём ощупывания тела пациента"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7593fc-4c91-46a2-8bef-e2dc0eaf3008",
                                "sense_id": "c0d61cb6-5c07-3685-a8fe-c396e36d0281",
                                "text": "При пальпации определялась болезненность в левом подреберье и слева от пупка у 15% больных; креаторея имелась у 33%, стеаторея — у 34% и амилорея — у 27% больных."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0d1cd8-2db2-469a-bd2b-9b210fa8d88f",
                        "source_entry_id": "821c66f3-738c-39e8-b4f8-9cef8a9c5efb",
                        "source_sense_id": "c0d61cb6-5c07-3685-a8fe-c396e36d0281",
                        "target_lang_word": "Palpation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palpation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                        "entry_id": "c01cb2df-4c87-3f47-b77b-d245205db972",
                                        "glosses": [
                                            "ärztliche Untersuchungsmethode, bei der durch Betasten Größe, Lage, Härtegrad und Druckempfindlichkeit von Bauchorganen oder Geschwülsten festgestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40491118-db35-4b57-b3d7-aa217a257249",
                                                "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                                "text": "Der Arzt führte eine gründliche Palpation des Bauchraumes durch."
                                            },
                                            {
                                                "example_id": "14bdbcd4-d294-43a2-b831-8c45a7285858",
                                                "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                                "text": "„Die Palpation sollte stets systematisch nach Art und Topographie der Gewebe erfolgen.“"
                                            },
                                            {
                                                "example_id": "875983f7-93c8-45de-9bf3-0ec9901204e6",
                                                "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                                "text": "„Die Palpation der axillären Lymphknoten folgt im Anschluss an die Inspektion sowie Palpation der Brust.“"
                                            },
                                            {
                                                "example_id": "4d36fbcc-cb49-4b2c-a98c-7b843890f5e1",
                                                "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                                "text": "„Mit der Fingerspitze palpiert man bei oberflächlichen Muskeln senkrecht zur Längsachse das Gewebe (flache Palpation).“"
                                            },
                                            {
                                                "example_id": "bb7a2d1b-304b-4b6a-bf8d-e9e4fe002947",
                                                "sense_id": "df0afeae-9d5c-3305-bd01-8a82af5c8b1f",
                                                "text": "„Die Auskultation sollte vor der Palpation erfolgen, da durch die Palpation Darmbewegungen angeregt werden, die den Untersuchungsbefund verändern können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
