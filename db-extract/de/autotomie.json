                                "target_senses": [
                                    {
                                        "sense_id": "4f171d0f-278b-377b-8dc8-650a5a029775",
                                        "entry_id": "093b627e-b24f-3e5e-a1ce-a4826ec4eafd",
                                        "glosses": [
                                            "The spontaneous removal of a limb, tail etc, especially by some invertebrates as a self-defense mechanism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a04a271-8d88-4cca-95eb-ef81b8b47734",
                                                "sense_id": "4f171d0f-278b-377b-8dc8-650a5a029775",
                                                "text": "She has dropped it by autotomy, like the tail or claw of a fleeing lizard, lobster, or starfish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f9d00d9-e577-4b98-be2e-f1b089f9dc11",
                        "source_entry_id": "946483f7-e5fe-320a-8a42-31379ad868af",
                        "source_sense_id": "609235c2-465f-3009-926b-fd8322c30aea",
                        "source_sense_description": "Biologie, speziell Zoologie: Abwerfen von Körperteilen bei Bedrohung, die meist wieder nachwachsen",
                        "target_lang_word": "autotomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autotomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e91ae942-abd5-3dd2-84b1-8342c700a511",
                                        "entry_id": "640e2696-9cf0-3661-8e66-f7bf4a8ed9dc",
                                        "glosses": [
                                            "Mutilation par lui-même d’un animal qui se sent en danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c614227-55b6-4bf1-a822-81fd17512412",
                                                "sense_id": "e91ae942-abd5-3dd2-84b1-8342c700a511",
                                                "text": "La queue d’un lézard, qui continue à bouger après son autotomie, aide l’animal à détourner l’attention de son prédateur."
                                            },
                                            {
                                                "example_id": "53e6a769-5dc7-468f-ada6-5da18d4308cd",
                                                "sense_id": "e91ae942-abd5-3dd2-84b1-8342c700a511",
                                                "text": "Le phénomène d’autotomie n’est pas un simple mouvement réflexe, sans liaison avec la situation totale ; au contraire, il est lié à la tentative d’échapper au danger qui se fait plus menaçant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
