                                    {
                                        "sense_id": "7a132eae-ea26-38cd-8787-dcff224f8d49",
                                        "entry_id": "fde5d732-f607-3d18-8d3c-7c7b479ae4b7",
                                        "glosses": [
                                            "A lobby, corridor, or waiting room, used in a hotel, theater, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5134e0-4cfa-48d5-98f3-1cadf4ccf760",
                                                "sense_id": "7a132eae-ea26-38cd-8787-dcff224f8d49",
                                                "text": "We had a drink in the foyer waiting for the play to start."
                                            },
                                            {
                                                "example_id": "31952041-7fe0-403b-91f7-962825c6a6ab",
                                                "sense_id": "7a132eae-ea26-38cd-8787-dcff224f8d49",
                                                "text": "Now it's big black cars and Riviera views / And your lover in the foyer doesn't even know you / And your secrets end up splashed on the news front page"
                                            },
                                            {
                                                "example_id": "ab4ae4e0-40ee-4a6e-b9ac-4c45c8259b02",
                                                "sense_id": "7a132eae-ea26-38cd-8787-dcff224f8d49",
                                                "text": "\"He's been waiting to jump my brain-bones since I left R&E. I could feel him hammering on the door.\" She trotted to the nearest wall and knocked on it for emphasis. \"But whatever it is that makes us remember the good old days, it also makes us impossible to possess now. That's why Willie and I both woke up, and why Noè never got taken out by Mukami. So all I had to do was open my mind up to the guy, invite him in, then... gas the foyer, as it were.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6699425-c44a-30f7-af17-39d3875a5a4c",
                                        "entry_id": "fde5d732-f607-3d18-8d3c-7c7b479ae4b7",
                                        "glosses": [
                                            "The crucible or basin in a furnace which receives the molten metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c979da8-e083-3560-87a2-0bb029071615",
                                        "entry_id": "fde5d732-f607-3d18-8d3c-7c7b479ae4b7",
                                        "glosses": [
                                            "A hostel offering accommodation and work opportunities to homeless young people."
                                        ],
