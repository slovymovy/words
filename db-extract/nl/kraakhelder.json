                "senses": [
                    {
                        "sense_id": "c27795fe-d2a5-3de1-8888-9dddd72ec0b6",
                        "entry_id": "60bcd7f6-4308-335a-9169-db6cb1a9441f",
                        "glosses": [
                            "heel erg schoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68060302-f665-4000-b3a5-60ae9c7c295a",
                                "sense_id": "c27795fe-d2a5-3de1-8888-9dddd72ec0b6",
                                "text": "De hele operatie — watertappen, een scheut schoonmaakazijn erin, ramen met een spons bewerken, ramen droogtrekken, ramen nazemen PLUS spons en zeem uitspoelen en ophangen en water weggooien en de emmer droog terug in het aanrechtkastje zetten — duurde zeven minuten. ZEVEN minuten. Innig tevreden staarde ik naar mijn kraakheldere ramen."
                            },
                            {
                                "example_id": "a490df35-78f6-40b6-8812-11e27729b443",
                                "sense_id": "c27795fe-d2a5-3de1-8888-9dddd72ec0b6",
                                "text": "We zaten te lunchen bij een kraakhelder meer in Yosemite."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3942a30-b02f-344d-8dbd-f945b3d0df18",
                        "entry_id": "60bcd7f6-4308-335a-9169-db6cb1a9441f",
                        "glosses": [
                            "heel helder en duidelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0dbb06-520d-4671-879f-3c12d97a7605",
                                "sense_id": "a3942a30-b02f-344d-8dbd-f945b3d0df18",
                                "text": "De greppel - Herman Koch De Nederlandse bestsellerschrijver voert een Amsterdamse burgemeester met Jekyll-and-Hyde-allures ten tonele. Het beproefde recept: ingenieus verhaal, wat zwarte humor, kraakheldere stijl."
                            }
                        ]
                    }
