                "senses": [
                    {
                        "sense_id": "973d3dab-3ac7-3e6a-8c40-085c19340548",
                        "entry_id": "3ac8a4e5-378e-349d-9ef3-7d1fd49bfd88",
                        "glosses": [
                            "voorzichtig met het uitgeven van geld of andere kostbare zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f80da15-7b04-4b4b-9d4a-d9d6c6b017af",
                                "sense_id": "973d3dab-3ac7-3e6a-8c40-085c19340548",
                                "text": "Zuinig autorijden is niet alleen goed voor je portemonnee."
                            },
                            {
                                "example_id": "864fc58b-0830-4d30-b0ce-f061478486df",
                                "sense_id": "973d3dab-3ac7-3e6a-8c40-085c19340548",
                                "text": "Voor England was het een sport om zo zuinig mogelijk te leven."
                            },
                            {
                                "example_id": "482112aa-f8d2-4437-84f1-ef4b13d4dea4",
                                "sense_id": "973d3dab-3ac7-3e6a-8c40-085c19340548",
                                "text": "Mijn vrouw had vroeger een abonnement op de Vrekkenkrant (een tijdschrift dat een eenvoudige en zuinige levenswijze wilde promoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef684d9e-1810-38c6-925c-1637084a754f",
                        "entry_id": "3ac8a4e5-378e-349d-9ef3-7d1fd49bfd88",
                        "glosses": [
                            "terughoudend, weifelend of licht teleurgesteld/sip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e2749a-ecb3-40f9-b773-2c33ba211f84",
                                "sense_id": "ef684d9e-1810-38c6-925c-1637084a754f",
                                "text": "Hij keek met een zuinige blik."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3974937-249c-3f7f-9693-a4e66d27e7ad",
                        "entry_id": "3ac8a4e5-378e-349d-9ef3-7d1fd49bfd88",
                        "glosses": [
                            "weinig energie verbruikend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b751371-7592-4e6b-af95-4e4bd1951c2f",
                                "sense_id": "b3974937-249c-3f7f-9693-a4e66d27e7ad",
                                "text": "De auto's krijgen steeds zuinigere motoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fcecae5-8c3e-3e42-87d8-e7b50e9cee4d",
