                ],
                "senses": [
                    {
                        "sense_id": "a920a4ee-dea1-3d6c-b54a-fbef46574675",
                        "entry_id": "aa312b21-d9de-33b9-ae99-b180b59f07b2",
                        "glosses": [
                            "Donner un caractère neutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8b05ce-a264-4d63-8e90-7d18a5dfd53d",
                                "sense_id": "a920a4ee-dea1-3d6c-b54a-fbef46574675",
                                "text": "Faire advenir le neutre, ou neutriser, c’est suspendre les assignations identitaires et les classifications binaires et hiérarchiques."
                            },
                            {
                                "example_id": "9244d2c8-f559-4303-a5bb-402cec9df620",
                                "sense_id": "a920a4ee-dea1-3d6c-b54a-fbef46574675",
                                "text": "Ce sont des éponges, des algues, à la frontière de l’eau et de l’environnement aérien au sol, des vies neutrisées."
                            },
                            {
                                "example_id": "2e420551-4152-496f-8c73-1bbdc1e5dc0e",
                                "sense_id": "a920a4ee-dea1-3d6c-b54a-fbef46574675",
                                "text": "Dans certain cas très difficiles (sur la roche) ERDF peut accepter de fournir une terre \"neutrisée\" c’est à dire une terre prise sur le neutre en amont du différentiel de branchement (uniquement en régime TT)."
                            }
                        ]
                    },
                    {
                        "sense_id": "d890259f-8bf4-3779-8261-13a10bf95f7a",
                        "entry_id": "aa312b21-d9de-33b9-ae99-b180b59f07b2",
                        "glosses": [
                            "Rendre intransitif."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e53753be-135f-46e8-b2a3-0173f9a96631",
                                "sense_id": "d890259f-8bf4-3779-8261-13a10bf95f7a",
                                "text": "L’usage a neutrisé ce verbe, qui était autrefois actif."
                            }
                        ]
                    }
