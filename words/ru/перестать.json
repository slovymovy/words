{
    "word_family": [
        "переставать",
        "переставка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "918a16ff-6bf9-32cf-ae1a-54d69a080d92",
                    "sense_definition": "Прекратить какое-либо действие или выйти из какого-либо состояния.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пора <w>перестать</w> бояться и начать действовать.",
                            "target_lang_translations": {
                                "en": "It is time to <w>stop</w> being afraid and start taking action."
                            }
                        },
                        {
                            "text": "Дождь наконец <w>перестал</w> идти после обеда.",
                            "target_lang_translations": {
                                "en": "The rain finally <w>stopped</w> falling in the afternoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "прекратить"
                    ],
                    "antonyms": [
                        "начать"
                    ],
                    "common_phrases": [
                        "дождь перестал"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop an action or cease being in a particular state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cease an action or behavior"
                            },
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "to give up or discontinue a habit or activity"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "to bring to an end"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "631998e5-9436-3c66-95bb-55152162d1e6",
                    "sense_definition": "Прекратиться о природных явлениях таких как дождь снег или ветер.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сильный ветер внезапно <w>перестал</w> дуть.",
                            "target_lang_translations": {
                                "en": "The strong wind suddenly <w>stopped</w> blowing."
                            }
                        },
                        {
                            "text": "Когда снег <w>перестанет</w> идти, мы пойдём гулять.",
                            "target_lang_translations": {
                                "en": "When it <w>stops</w> snowing, we will go for a walk."
                            }
                        }
                    ],
                    "synonyms": [
                        "прекратиться"
                    ],
                    "common_phrases": [
                        "дождь перестал"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop or cease occurring, said of natural phenomena such as rain, snow, or wind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "of weather or natural phenomena, to cease"
                            },
                            {
                                "target_lang_word": "let up",
                                "target_lang_sense_clarification": "of rain, wind, or snow, to abate or stop"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}