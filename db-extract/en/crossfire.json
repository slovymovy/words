                "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                "word": "crossfire",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "296f1a92-d903-4bd8-8a09-e09a37c66ac0",
                        "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                        "tags": [
                            "plural"
                        ],
                        "form": "crossfires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e99be717-09cf-341c-84d4-a5c50d53f48c",
                        "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                        "glosses": [
                            "An arrangement of two or more weapons so each can fire diagonally at something in front of a line between them."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f6910da-7c59-38e8-91c9-244b458e3dce",
                        "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                        "glosses": [
                            "The danger to a third party passing between two belligerents firing at one another."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c5f603c-e7c6-49db-8f9c-2f568e8684d6",
                                "sense_id": "8f6910da-7c59-38e8-91c9-244b458e3dce",
                                "text": "The two factions were either side of the road. A civilian lorry was caught in the crossfire and became collateral damage"
                            }
                        ]
                    },
                    {
                        "sense_id": "4bd1841a-2822-34bb-8c28-d0f4d70bfbfd",
                        "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                        "glosses": [
                            "The danger to a third party passing between a gunman and his target."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6bc134d-f453-4079-884a-3d521f1907af",
                                "sense_id": "4bd1841a-2822-34bb-8c28-d0f4d70bfbfd",
                                "text": "A woman who was caught in the crossfire of a drive-by shooting in north London on Tuesday evening was not the intended target, police have said."
                            }
                        ]
                    },
                    {
                        "sense_id": "678dae3d-0057-38b2-90ca-bd8816fe0cb1",
                        "entry_id": "eb694ab5-7580-35b2-9fbb-09b3092f858f",
                        "glosses": [
                            "A heated confrontation between opposing factions."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c06f39c-431c-4c3c-b5be-a87377b0e9ab",
