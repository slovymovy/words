                    {
                        "sense_id": "d7e4c0f7-0c68-34e2-ae97-e8252dca79ab",
                        "entry_id": "e155082c-bbc9-3a29-a95c-1f4c66fb4335",
                        "glosses": [
                            "Critique envieux et méchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9139f1b-de45-49ed-9caa-d6a7d0cdcd2f",
                                "sense_id": "d7e4c0f7-0c68-34e2-ae97-e8252dca79ab",
                                "text": "C’étaient ces quatre-là, quatre zoïles vipérines remontées comme un jury rance, surtout la dernière qui se délectait de m’avoir piégé avec ses petits éléments de réel…."
                            },
                            {
                                "example_id": "f185f517-f977-4ef1-8932-82fcceeca304",
                                "sense_id": "d7e4c0f7-0c68-34e2-ae97-e8252dca79ab",
                                "text": "Tillemont trouva un moment son zoïle dans l'abbé Faidit, esprit inquiet, léger, et à qui il est arrivé de mêler par hasard quelques vérités dans beaucoup d'impertinences."
                            }
                        ]
                    }
                ],
