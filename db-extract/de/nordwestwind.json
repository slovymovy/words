                "senses": [
                    {
                        "sense_id": "2a7adcc0-c31e-3898-b136-bf46fed47226",
                        "entry_id": "f396d0d3-6e91-3b9f-aa52-8073c8ab60ec",
                        "glosses": [
                            "Wind aus dem Nordwesten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aaaf237-8b9d-437f-81af-31e2785d021a",
                                "sense_id": "2a7adcc0-c31e-3898-b136-bf46fed47226",
                                "text": "Der Nordwestwind flaute am Abend ab."
                            },
                            {
                                "example_id": "9dd6cff4-303b-4663-ae21-f7d8c10adec8",
                                "sense_id": "2a7adcc0-c31e-3898-b136-bf46fed47226",
                                "text": "„Wir entfernten uns bei starkem Nordwestwind vom Land, sodass wir zum Beidrehen gezwungen waren, weil der Seegang zu heftig war, um zu lenzen.“"
                            },
                            {
                                "example_id": "45be73d0-6098-4c60-b182-65df94d41425",
                                "sense_id": "2a7adcc0-c31e-3898-b136-bf46fed47226",
                                "text": "„El Sol horchte, einzelne Laute schlugen im Zuge des scharfen Nordwestwindes an sein Ohr.“"
                            },
                            {
                                "example_id": "92008104-f1a7-4bda-9fa4-d7ae926f692a",
                                "sense_id": "2a7adcc0-c31e-3898-b136-bf46fed47226",
                                "text": "„Am 18. März in der Nacht sollte der Ballon aufsteigen, und die Verbindungsgruppe hoffte, mit Hilfe eines leichten Nordwestwindes innerhalb weniger Stunden in Lees Hauptquartier landen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
