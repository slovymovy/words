                    {
                        "form_id": "6759885c-d48d-46c2-9c18-12506b365b44",
                        "entry_id": "a7c2ed3c-a5f2-3c8a-8939-562ac15df83d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flutwellen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                        "entry_id": "a7c2ed3c-a5f2-3c8a-8939-562ac15df83d",
                        "glosses": [
                            "sich fortbewegende Zone erhöhten Wasserstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c5a576-7730-47f5-802e-35036738d191",
                                "sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                                "text": "Fünf Tage nach den Unwettern im Riesengebirge erreichte die Flutwelle die Oder."
                            },
                            {
                                "example_id": "e8c421e8-e9a7-455e-b64e-4e8acea5e58c",
                                "sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                                "text": "„Die Eisberge könnten kentern oder bersten und eine hohe Flutwelle auslösen.“"
                            },
                            {
                                "example_id": "d32d57de-84d8-4531-bfcc-b864d11b74cd",
                                "sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                                "text": "„Als das Ergebnis von 12,6 Milliarden Mark offiziell bekannt gegeben wurde, rollte Stolz wie eine Flutwelle durch ganz Deutschland.“"
                            },
                            {
                                "example_id": "41738ca1-67eb-4181-8edb-9f1c7813761f",
                                "sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                                "text": "„Nachdem der Monsun immer wieder Flutwellen in die Bucht getrieben hatte, musste ein Teil Victorias versetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "009936e4-a888-3113-b3a3-3c7d5888aa1f",
                        "entry_id": "a7c2ed3c-a5f2-3c8a-8939-562ac15df83d",
                        "glosses": [
                            "einer der beiden im Rahmen der Tide einmal täglich die Erde umrundenden Wellenberge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22f748d-e0ad-4b67-bf3d-19b03384b072",
                                "sense_id": "009936e4-a888-3113-b3a3-3c7d5888aa1f",
                                "text": "Zweimal täglich spült die Flutwelle den Abfall von hoher See an Land."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b222c7c-8197-4eb0-acf1-30ff7399602a",
                        "source_entry_id": "a7c2ed3c-a5f2-3c8a-8939-562ac15df83d",
                        "source_sense_id": "fe092755-b182-33bf-84e0-ecb85940d9a5",
                        "source_sense_description": "sich fortbewegende Zone erhöhten Wasserstandes",
                        "target_lang_word": "tidal wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tidal wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e16add-301a-38a6-9ada-78dab01d63a2",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large and sudden rise and fall in the tide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden, and disastrous wave of water caused by a tremendous disturbance in the ocean; a tsunami. (See Usage notes below.)"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64682ce8-6949-4dae-b4c7-5399a8688cdd",
                                                "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                                "text": "The last tidal wave here killed twenty and left thousands homeless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden inundation of water from the storm surge, or waves of that surge; a sudden surge of river water."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c478e7fb-fe00-47e1-8121-fd0d8006ee39",
                                                "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A sudden and powerful surge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e45773-6533-44f6-a591-30084083f3ac",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "As the doors opened, a tidal wave of people flooded into the room."
                                            },
                                            {
                                                "example_id": "55ca3a81-52f6-41e1-a3fa-6eeef0a3edee",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "I was overcome by a tidal wave of emotions."
                                            },
                                            {
                                                "example_id": "53870bf8-e7ba-44ac-a5fd-b805eced5ceb",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "But this is no stream, folks. This will be a tidal wave that can swamp our democracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f6cd86-371d-3ad9-a006-8572505fa30b",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A crest of ocean water; a wave."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb47036b-9fc7-3b57-b19c-a7b1dc9fefef",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A crest of ocean water resulting from tidal forces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
