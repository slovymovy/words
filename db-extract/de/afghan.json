                "senses": [
                    {
                        "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                        "entry_id": "0b23819e-7cef-3229-8a65-70e59502a3d2",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c153e27-1e56-46a9-b7d9-9fb4716da38b",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Frau Afghan ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb03c474-8daf-4eb6-9daf-a98bd4802a77",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Herr Afghan wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8dd61f54-4af4-4db1-9bd7-149666403d03",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Die Afghans fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "9129539d-216d-49f8-a656-a5e168df5e81",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Der Afghan trägt nie die Pullover, die die Afghan ihm strickt."
                            },
                            {
                                "example_id": "32c19818-447a-498d-a05e-a81dec0d2b5a",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Afghan kommt, geht der Herr Afghan.“"
                            },
                            {
                                "example_id": "1cbac07b-d35f-4e71-abfa-9e599aa77d38",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Afghan kommt und geht."
                            },
                            {
                                "example_id": "efc2c21f-05e3-4afe-ae99-bd633b862f65",
                                "sense_id": "d10328a6-b296-3d84-aabf-423c5cb34b1c",
                                "text": "Afghans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
