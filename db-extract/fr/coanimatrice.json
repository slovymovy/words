                        "glosses": [
                            "Animatrice qui partage ce rôle avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608e4775-cb8d-4f19-a0cc-5b51a7dd8a53",
                                "sense_id": "99d497a0-6a1d-3b73-b77a-0f290bd2ef6c",
                                "text": "Léa Salamé, coanimatrice aux côtés de Hugo Clément, se définit, elle, comme « une convertie de la dernière heure »."
                            },
                            {
                                "example_id": "9af95e63-de61-45fd-89d8-d58e5c50160c",
                                "sense_id": "99d497a0-6a1d-3b73-b77a-0f290bd2ef6c",
                                "text": "La coanimatrice arrive à ce moment, elle s’intègre au groupe comme spectatrice."
                            },
                            {
                                "example_id": "d509796c-62db-47ee-9790-ab3707441cae",
                                "sense_id": "99d497a0-6a1d-3b73-b77a-0f290bd2ef6c",
                                "text": "À cet effet, une des deux coanimatrices peut commencer à se retirer, et laisser sa place à un membre afin que ce dernier puisse s’habituer à l’animation."
                            }
                        ]
                    }
