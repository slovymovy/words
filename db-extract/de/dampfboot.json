                "senses": [
                    {
                        "sense_id": "117a3bb7-0ed9-3dde-9c0e-2ff4c13f186e",
                        "entry_id": "a06dd390-77c1-345a-8224-64afde1bdfd6",
                        "glosses": [
                            "Boot, das von einer Dampfmaschine angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a37433-6656-406f-a52c-846af788aa42",
                                "sense_id": "117a3bb7-0ed9-3dde-9c0e-2ff4c13f186e",
                                "text": "„Ab den 1850er Jahren erledigte ein Dampfboot die Überfahrt von Kastel nach Mainz.“"
                            },
                            {
                                "example_id": "1a00a3a6-9e8a-46c0-984d-0660026ba3fa",
                                "sense_id": "117a3bb7-0ed9-3dde-9c0e-2ff4c13f186e",
                                "text": "„Ein, zwei bescheidene Dampfboote bilden den ganzen Verkehr eines Tages.“"
                            },
                            {
                                "example_id": "c0cc65a3-4cad-433b-a2df-8b457f08d7fc",
                                "sense_id": "117a3bb7-0ed9-3dde-9c0e-2ff4c13f186e",
                                "text": "„Sein altersschwaches Dampfboot lag fest vertäut im Hafen, die vier Negerjungs waren bei ihren Frauen und Kindern, und die drei fiebergeschüttelten Iren betranken sich wahrscheinlich irgendwo.“"
                            },
                            {
                                "example_id": "e63c48b1-9d4c-4e4c-9d9f-fa5218368d24",
                                "sense_id": "117a3bb7-0ed9-3dde-9c0e-2ff4c13f186e",
                                "text": "„Da erscheint wie aus dem Nichts ein großes Dampfboot, das unaufhaltsam auf den kleinen Kahn zuhält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
