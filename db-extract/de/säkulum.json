                                                "sense_id": "511dbd7e-7689-30d6-8d4e-a8c025aef0b3",
                                                "text": "Век воли не видать!"
                                            },
                                            {
                                                "example_id": "456510d8-e095-4810-a566-cd1794e73f35",
                                                "sense_id": "511dbd7e-7689-30d6-8d4e-a8c025aef0b3",
