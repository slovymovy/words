                    {
                        "sense_id": "29bee692-8ef5-3b3a-9857-213772c2b245",
                        "entry_id": "8f162483-cf2e-3aa4-baba-7c6ec4a684e5",
                        "glosses": [
                            "mit den Neandertalern verwandte, ausgestorbene Menschengattung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382432ed-0865-4cf1-8a38-209c47e4b048",
                                "sense_id": "29bee692-8ef5-3b3a-9857-213772c2b245",
                                "text": "„Hast du jemals etwas über die Denisova-Menschen gehört?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9f3f587-66f4-4db4-8ba8-3be51bc494bb",
                        "source_entry_id": "8f162483-cf2e-3aa4-baba-7c6ec4a684e5",
                        "source_sense_id": "29bee692-8ef5-3b3a-9857-213772c2b245",
                        "source_sense_description": "mit den Neandertalern verwandte, ausgestorbene Menschengattung",
                        "target_lang_word": "Denisovan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denisovan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a71e68d-3efe-31a1-922f-731111e3df1c",
                                        "entry_id": "eabaf93e-9f19-384c-b860-6a34758bc8ad",
                                        "glosses": [
                                            "Of or pertaining to an extinct grouping of the genus Homo that lived in the Altay Mountains some 41,000 years ago."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce93ef51-4e5c-4ad0-b5c9-51d2aac2c156",
                                                "sense_id": "5a71e68d-3efe-31a1-922f-731111e3df1c",
                                                "text": "Denisovan Man is the first human relative to have been identified purely from DNA, extracted from the bone and a tooth found in the Denisova cave in the Altai mountains of southern Siberia."
                                            },
                                            {
                                                "example_id": "d1fae40f-3a78-422f-a8d7-441cdabb0c5c",
                                                "sense_id": "5a71e68d-3efe-31a1-922f-731111e3df1c",
                                                "text": "A molar tooth, measuring around 1.5cm on each side and found at the site in 2000, also belongs to a Denisovan individual."
                                            },
                                            {
                                                "example_id": "b6dacc64-09df-4885-8ef3-6d0898f99b84",
                                                "sense_id": "5a71e68d-3efe-31a1-922f-731111e3df1c",
                                                "text": "It is the only known place on the planet where three types of humans — Denisovan, Neanderthal and modern — lived, probably not all at once."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Denisovan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c40d2fd0-a2e6-30f3-a7d9-9b85a53941db",
                                        "entry_id": "6e0be435-b680-3373-bf3d-7623fd77d545",
                                        "glosses": [
                                            "A member of an extinct grouping of the genus Homo that lived in the Altay Mountains some 41,000 years ago."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d58c6e1-d617-4022-bfe6-ec934c3d60c4",
                                                "sense_id": "c40d2fd0-a2e6-30f3-a7d9-9b85a53941db",
                                                "text": "And yet, despite their having the entire genome of a Denisovan, Dr. Paabo cannot say much yet about what they were like."
                                            },
                                            {
                                                "example_id": "d04f2f78-692e-4512-9d60-8d594d270db7",
                                                "sense_id": "c40d2fd0-a2e6-30f3-a7d9-9b85a53941db",
                                                "text": "…this was only the third fossil ever found of a Denisovan, the others being the bit of finger bone and another molar, also from Denisova cave."
                                            },
                                            {
                                                "example_id": "eed74f29-fb16-4db7-9c76-684bebce423a",
                                                "sense_id": "c40d2fd0-a2e6-30f3-a7d9-9b85a53941db",
                                                "text": "The researchers were even able to split and analyze the two strands of the Denisovan's DNA, and thus differentiate the contributions of each parent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
