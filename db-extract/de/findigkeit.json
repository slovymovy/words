                        "examples": [
                            {
                                "example_id": "6436fd17-3589-4896-9f9e-6862ae958d06",
                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                "text": "„Am meisten faszinierte ihn die Findigkeit der Arbeiter beim Diebstahl.“"
                            },
                            {
                                "example_id": "1508c1f2-2775-4645-88b3-ff20fa5692c1",
                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                "text": "„Das alles soll in diesem kurzen Strich stecken, auch der für seine Tüchtigkeit, seine Findigkeit und Fertigkeit gerühmte Fischer, dem vor keinem Wetter bange war, der zu viel trank, zugleich aber über einen unstillbaren Wissensdurst verfügte.“"
                            }
                        ],
