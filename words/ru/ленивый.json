            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86706551-e8a7-30a8-b51d-b8df138bb8b9",
                    "sense_definition": "Склонный к безделью, избегающий труда, не желающий работать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "лень",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>ленивый</w> ученик никогда не делает домашнее задание вовремя."
                        },
                        {
                            "text": "Не будь таким <w>ленивым</w>, помоги мне убраться в комнате."
                        }
                    ],
                    "antonyms": [
                        "прилежный",
                        "работящий"
                    ],
                    "common_phrases": [
                        "ленивый человек"
                    ]
                },
                {
                    "sense_id": "29de3417-2f67-3460-917f-54227ec0d5d7",
                    "sense_definition": "Медлительный, вялый, неторопливый в движениях или действиях.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "лень",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Толстый <w>ленивый</w> кот спал на солнце весь день."
                        },
                        {
                            "text": "Он шел <w>ленивой</w> походкой, никуда не торопясь."
                        }
                    ],
                    "common_phrases": [
                        "ленивая походка"
                    ]
                },
                {
                    "sense_id": "0bc4fe88-2430-3fd2-a3ff-a5f7811572c1",
                    "sense_definition": "Выражающий лень или безразличие во взгляде, мимике или внешности.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "лень",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Граф смотрел на гостей с <w>ленивым</w> любопытством."
                        },
                        {
                            "text": "У него был <w>ленивый</w> взгляд человека, который давно устал от всего."
                        }
                    ],
                    "common_phrases": [
                        "ленивый взгляд"
                    ]
                },
                {
                    "sense_id": "2f704322-daba-3135-a046-a3d3b549ac01",
                    "sense_definition": "Приготовленный по упрощенному рецепту, не требующему сложной обработки.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "кулинария",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На обед мы решили приготовить <w>ленивые</w> вареники с творогом."
                        },
                        {
                            "text": "Моя мама часто делает <w>ленивые</w> голубцы, потому что это быстро."
                        }
                    ],
                    "common_phrases": [
                        "ленивые вареники",
                        "ленивые голубцы"
                    ]
                }
            ]
        }
    ]
