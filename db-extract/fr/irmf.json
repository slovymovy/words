                                        "examples": [
                                            {
                                                "example_id": "f675ca34-99eb-431e-ad6b-1d9e90794805",
                                                "sense_id": "5b60f272-aa3b-387e-bebf-58039adc3de9",
                                                "text": "fMRI has not been carried out yet in the group of paedophilia or other paraphiliae. Given the much better spatial and in particular higher temporal resolution it may be the tool of preference."
                                            },
                                            {
                                                "example_id": "64462e8c-0019-48d7-b8f4-c92af3ca7cc0",
                                                "sense_id": "5b60f272-aa3b-387e-bebf-58039adc3de9",
                                                "text": "Functional magnetic resonance imaging (fMRI) visualizes the blood oxygen level-dependent (BOLD) signal in the brain, which indexes neural activity."
                                            },
                                            {
                                                "example_id": "d1fbeaf7-a564-4aeb-8953-3f00928c55e7",
                                                "sense_id": "5b60f272-aa3b-387e-bebf-58039adc3de9",
                                                "text": "The women underwent functional magnetic resonance imaging (fMRI), which measures changes in blood flow that happen with brain activity, while being shown images of their grandchild, another child they didn’t know, an adult they didn’t know, and the same-sex parent of their grandchild."
                                            }
