                    },
                    {
                        "translation_id": "d5d1d7bc-e84f-421e-950e-59a0cb8583bc",
                        "source_entry_id": "06e556f3-700b-337d-96d2-acb2d1554146",
                        "source_sense_id": "d94329a5-155a-3c9d-b713-22417dcbabc6",
                        "source_sense_description": "ein Unfall mit, durch, in einem Auto; ein Verkehrsunfall mit einem beteiligten Kraftfahrzeug",
                        "target_lang_word": "bingle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bingle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "629cb479-e728-3c3a-9efc-878845436ade",
                                        "entry_id": "bec82b6e-7661-3aaf-909c-d21fe6543a2d",
                                        "glosses": [
                                            "A minor collision, especially between motor vehicles."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589f175d-9436-47e7-b0e6-f1000abdc0c5",
                                                "sense_id": "629cb479-e728-3c3a-9efc-878845436ade",
                                                "text": "It is always an advantage if you have a sexy car, but if you pick her up in a rusty Datsun 180B you may as well say goodnight.[…]There is also the worst-case scenario of being involved in a bingle. If this happens you will definitely be finished and she will probably sneak off on you if she manages to escape injury."
                                            },
                                            {
                                                "example_id": "8c19094f-bdcf-4d75-acfe-ff2fb470a9f3",
                                                "sense_id": "629cb479-e728-3c3a-9efc-878845436ade",
                                                "text": "\"I, uh . . . \" I managed, \"I seem to have had a bit of a bingle.\" I pointed a thumb behind me at the car."
                                            },
                                            {
                                                "example_id": "e7a7e160-be8f-4f5d-99df-b64cb72d3b7f",
                                                "sense_id": "629cb479-e728-3c3a-9efc-878845436ade",
                                                "text": "‘But you've still got your father′s car haven′t you?’ ¶ ‘No. Had a bingle in it the other night, nothing major. I just hope to hell it′s fixed before he finds out.[…]’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bingle",
                                "target_lang_code": "en",
