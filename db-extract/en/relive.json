                                                "sense_id": "26af20e5-ac66-3a0e-9de2-3749520d13fc",
                                                "text": "rivivere un'emozione"
                                            },
                                            {
                                                "example_id": "2ee7cdfe-348e-48ad-8982-d8029138a77b",
                                                "sense_id": "26af20e5-ac66-3a0e-9de2-3749520d13fc",
