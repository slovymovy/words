                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb560d6f-6804-3f9a-bd3a-f001f2374573",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "An opening; a recess or chamber."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75321f51-3496-480d-8ac2-dfb507f7588b",
                                                "sense_id": "eb560d6f-6804-3f9a-bd3a-f001f2374573",
                                                "text": "c. 1612', George Chapman, A Hymne to Hermes\nthe cave's inmost overture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "863131bd-602e-3fde-85f5-16350f2c5f05",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "Disclosure; discovery; revelation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2408a8dd-e66e-4abc-a714-f77f1e88fa68",
                                                "sense_id": "863131bd-602e-3fde-85f5-16350f2c5f05",
                                                "text": "It was he\n That made the overture of thy treasons to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "An approach or proposal made to initiate communication, establish a relationship etc."
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a902fd-5b83-4a08-a413-4e6379199a33",
                                                "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                                                "text": "overture of friendship"
                                            },
                                            {
                                                "example_id": "704c7809-26b9-408e-a71f-cc781662cdcb",
                                                "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                                                "text": "Shortly afterwards the North Eastern Railway made overtures for the purchase of the Blyth & Tyne system, and the directors of the latter were then disposed to sell, but, in view of their excellent dividend record, stood out for a good price."
                                            },
                                            {
                                                "example_id": "ef48eb89-6e68-418a-8f44-f5d03ac7b364",
                                                "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                                                "text": "Sarkozy gave a defiant speech, going on the offensive and betraying no hint of having been beaten. He styled the result as a \"crisis\" vote, by a French population which was \"suffering\". In a clear overture to Le Pen's voters, and the extreme-right motto of loving France, he said: \"I call on all French people who put love of their country above partisan considerations, to unite and join me.\""
                                            },
                                            {
                                                "example_id": "2e05a997-e7d3-4a3c-bade-ea2b825749a5",
                                                "sense_id": "ecb75b68-69f7-332f-b5ac-c0fec705a091",
                                                "text": "My mother had no choice; one did not turn down such an overture from the regent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee1a7f47-dc7c-3155-8371-3e38e2068db3",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "A motion placed before a legislative body, such as the General Assembly of the Church of Scotland."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e777ac6-6e01-3466-bbf2-c6d084820da5",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "A musical introduction to a longer piece of music or a dramatic work (such as a play, an opera, or a motion picture)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eef81df-a2b5-44ae-b742-c9b5b9a799dc",
                                                "sense_id": "2e777ac6-6e01-3466-bbf2-c6d084820da5",
                                                "text": "The overture was almost at a close; and silence being now more effective than any thing that he could urge in favour of the play, Courtenaye went behind the scenes:..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7430bb94-ea88-3947-962c-22ce41d3d36c",
                                        "entry_id": "0e3c7ff7-43bc-3923-9a2c-59e7656fa1f4",
                                        "glosses": [
                                            "A medley of themes from a larger work, such as an opera or musical, typically played at the beginning but sometimes played at any part of the work or performed as a standalone piece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615dcc42-7dd0-4db7-b988-cf3417a1b998",
                                                "sense_id": "7430bb94-ea88-3947-962c-22ce41d3d36c",
                                                "text": "The paradoxical use of an overture at the end of a concert occasionally gave rise to satire in the musical press."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9bb1291-a6f2-32d6-bef4-99388b8f4620",
                                        "entry_id": "3fba59a6-6414-3ce8-94dc-df9665dc6546",
                                        "glosses": [
                                            "To make overtures; to approach with a proposal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7267a5-df92-4ba0-a4b1-32ae9b098c45",
                                                "sense_id": "d9bb1291-a6f2-32d6-bef4-99388b8f4620",
                                                "text": "For a partner setting a table in a game of “house,” an overturing child might assume the role of the father returning home from work at dinnertime rather than overturing by throwing a ball toward the child and yelling “catch.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
