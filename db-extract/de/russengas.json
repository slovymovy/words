                "senses": [
                    {
                        "sense_id": "3a3396e0-c5a9-3bdf-91b9-cea3f0fe9ac4",
                        "entry_id": "22d55f08-5cef-3b94-aab8-3d2ffa29ad7e",
                        "glosses": [
                            "Erdgas, das aus Russland stammt; das in Russland gefördert wurde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5ef82c8a-f882-4b38-a885-dab767c07644",
                                "sense_id": "3a3396e0-c5a9-3bdf-91b9-cea3f0fe9ac4",
                                "text": "„Auch will sie \"Peter Altmaier und Sigmar Gabriel fracken\", \"weil wir glauben, dass ungeheure Energiereserven in diesen Kolossen schlummern, die uns auf Jahre hinaus unabhängig machen vom Russengas. Das ist moderne Turbopolitik!\"“"
                            },
                            {
                                "example_id": "9e089b5d-d951-45c9-bd95-3f578a362951",
                                "sense_id": "3a3396e0-c5a9-3bdf-91b9-cea3f0fe9ac4",
                                "text": "„Gratulation, eine wirklich schlüssige Energiepolitik, die da betrieben wird! Ganz gegen den europäischen Trend, der eindeutig weg vom Russengas geht.“"
                            },
                            {
                                "example_id": "d8bea814-7d05-4111-a54a-68b6d2560d85",
                                "sense_id": "3a3396e0-c5a9-3bdf-91b9-cea3f0fe9ac4",
                                "text": "„Von der Preisanpassungsklausel nach Paragraf 24 EnSiG sind jene Gasverbraucher stark betroffen, deren Lieferanten Ersatz für nicht mehr geliefertes Russengas zu hohen Preisen kurzfristig beschaffen müssen.“"
                            },
                            {
                                "example_id": "b24460b6-29e6-442b-8616-04a757586a74",
                                "sense_id": "3a3396e0-c5a9-3bdf-91b9-cea3f0fe9ac4",
                                "text": "„Wer, wenn nicht er, wäre besser berufen zu sagen, was Österreich aus dem ersten Russengas-Schock gelernt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
