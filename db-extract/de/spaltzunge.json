                "senses": [
                    {
                        "sense_id": "6c1a4376-2db2-3866-89d3-20fdbd60003a",
                        "entry_id": "b7f75056-55ce-388d-b58b-73c3af6ea801",
                        "glosses": [
                            "Fehlbildung, die sich durch eine in zwei Teile gespaltene Zunge auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13a06dc-24c2-4490-abed-528493af0532",
                                "sense_id": "6c1a4376-2db2-3866-89d3-20fdbd60003a",
                                "text": "„Man weiß, daß Diploglossien — Spaltzungen — beim Menschen und den meisten Wirbeltieren zu den Mißbildungen im Bereiche der Mundhöhle gehören, bei einigen Vertretern der niederen und höheren Tierklassen aber die Regel sind.“"
                            },
                            {
                                "example_id": "96dd5641-bf28-4f87-ac4e-409c21c7955b",
                                "sense_id": "6c1a4376-2db2-3866-89d3-20fdbd60003a",
                                "text": "„Danach erklärt sich dann die Entstehung der Spaltzunge leichter. Es werden sehr ausführlich die bei Menschen und Tieren beschriebenen Spaltzungen hier aufgeführt und es folgt der Bericht über zwei selbst beobachtete Spaltzungen […]“"
                            },
                            {
                                "example_id": "1e13bd59-21e9-4ecd-9a37-4c6e63d18002",
                                "sense_id": "6c1a4376-2db2-3866-89d3-20fdbd60003a",
                                "text": "„Von den übrigen angeborenen Mißbildungen der Zunge haben nur die Spaltzunge, Lingua bifida, die angewachsene Zunge und die angeborene Verkürzung des Frenulum linguae praktisches Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
