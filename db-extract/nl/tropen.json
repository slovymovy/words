        "nl-extract.jsonl": [
            {
                "entry_id": "0317402d-4726-334b-a6b5-50201c2cc1fb",
                "word": "tropen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7eb5fc52-c8b4-33ce-bd95-dbb62e721f44",
                        "entry_id": "0317402d-4726-334b-a6b5-50201c2cc1fb",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord troop"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3530cfcf-2031-400f-bddd-431abb7bd2ff",
                                "sense_id": "7eb5fc52-c8b4-33ce-bd95-dbb62e721f44",
                                "text": "Wel kunnen ze gebruikmaken van allerlei kunstige vormen van beeldend taalgebruik en beeldspraak. Het gaat hier om de zogeheten tropen en figuren uit de traditionele retorica of welsprekendheidsleer, de kunst van het mondeling uitgesproken betoog."
                            }
                        ]
                    },
                    {
                        "sense_id": "13f00895-c268-3137-a801-86ab21aee93d",
                        "entry_id": "0317402d-4726-334b-a6b5-50201c2cc1fb",
                        "glosses": [
                            "streken tussen beide keerkringen"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1dad12fd-7c64-42f8-be9d-bc7fcefb2a27",
                                "sense_id": "13f00895-c268-3137-a801-86ab21aee93d",
                                "text": "In de koloniale tijd hadden Nederland en België bezittingen in de tropen."
                            },
                            {
                                "example_id": "78130db1-b267-445a-bad7-a6e2361f08c8",
                                "sense_id": "13f00895-c268-3137-a801-86ab21aee93d",
                                "text": "De onderzoekers begonnen met gegevens van 210.000 individuele bomen, verdeeld over 110 soorten, uit verschillende klimaatzones en ecosystemen, van de tropen tot de polen, en van dichtbeboste tot open gebieden."
                            }
                        ]
                    },
                    {
                        "sense_id": "f735079c-74a4-3721-85f1-bd1ee185903b",
                        "entry_id": "0317402d-4726-334b-a6b5-50201c2cc1fb",
                        "glosses": [
                            "beide keerkringen"
                        ],
                        "tags": [
                            "obsolete",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "99e44721-60d6-429e-b232-c55ffb393178",
                                "sense_id": "f735079c-74a4-3721-85f1-bd1ee185903b",
                                "text": "⧖ Welke betere gelegenheid tot het doen van dergelijke waarnemingen , (die stellig onder de interessantsten van de physiek behooren, en over de eigenlijke (werkende) oorzaak der zoo merkwaardige dagelijksche barometer-veranderingen licht kunnen verspreiden), — kan men ergens vinden, dan onder de tropen, waar de onregelmatige veranderingen in den barometer bijna geheel verdwenen zijn, — en welke betere onder de tropen, dan to Buitenzorg? (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5414001-10f9-4039-872c-0a7600e3b5f0",
                        "source_entry_id": "0317402d-4726-334b-a6b5-50201c2cc1fb",
                        "source_sense_id": "7eb5fc52-c8b4-33ce-bd95-dbb62e721f44",
