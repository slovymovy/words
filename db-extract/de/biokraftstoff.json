                    {
                        "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                        "entry_id": "efdfd585-f8a3-304b-9ace-93058fd1e4da",
                        "glosses": [
                            "Kraftstoff, der aus nachwachsenden Rohstoffen hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba68335-4fc0-46cc-b8fa-ae58d3dcd41d",
                                "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                                "text": "„Absatz von Biokraftstoffen geht deutschlandweit deutlich zurück.“"
                            },
                            {
                                "example_id": "70522eb8-5326-4fb6-ba99-66b6d52102b7",
                                "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                                "text": "„Die Produktion von Biokraftstoff, der aus Palmöl, Weizen, Mais oder Zuckerrüben hergestellt wird, führt zu massiven Entwaldungen in Südostasien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "591c6e27-fe50-4b72-bc58-b42d07ceab31",
                        "source_entry_id": "efdfd585-f8a3-304b-9ace-93058fd1e4da",
                        "source_sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                        "source_sense_description": "Kraftstoff, der aus nachwachsenden Rohstoffen hergestellt wurde",
                        "target_lang_word": "biofuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biofuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                                        "glosses": [
                                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                                            },
                                            {
                                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf5ba878-8226-4514-82b1-5b5a07933d11",
                        "source_entry_id": "efdfd585-f8a3-304b-9ace-93058fd1e4da",
                        "source_sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                        "source_sense_description": "Kraftstoff, der aus nachwachsenden Rohstoffen hergestellt wurde",
