{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5d3d5f7-8882-3288-8e45-89c7ff1765eb",
                    "sense_definition": "To participate in a video conference call over the internet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "video_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>zoomed</w> with our grandparents last night to wish them a happy birthday.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы <w>созвонились по зуму</w> с бабушкой и дедушкой, чтобы поздравить их с днем рождения.",
                                "zh": "昨晚我们和祖父母<w>视频通话</w>，祝他们生日快乐。"
                            }
                        },
                        {
                            "text": "She is <w>zooming</w> into the meeting from her home office.",
                            "target_lang_translations": {
                                "ru": "Она <w>подключается к зуму</w> на встречу из своего домашнего кабинета.",
                                "zh": "她正在家庭办公室<w>参加</w>视频会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "videoconference",
                        "video call"
                    ],
                    "common_phrases": [
                        "zoom with someone",
                        "zoom in to a meeting"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used generically for any video call"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в видеоконференции через интернет (обычно используя платформу Zoom).",
                        "zh": "通过互联网参加视频会议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созваниваться по зуму",
                                "target_lang_sense_clarification": "разговорное выражение"
                            },
                            {
                                "target_lang_word": "общаться по видеосвязи",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开视频会议",
                                "target_lang_sense_clarification": "指通过视频软件进行远程交流"
                            },
                            {
                                "target_lang_word": "视频通话",
                                "target_lang_sense_clarification": "通用的视频交流方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21185652-1e9a-34cb-bd4e-c4e3c8b74749",
                    "sense_definition": "To adjust a camera or screen display to make the image appear larger (closer) or smaller (further away).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_magnification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>zoom</w> in to see the details of the map more clearly.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>приблизить</w> изображение, чтобы рассмотреть детали карты более четко.",
                                "zh": "你可以<w>放大</w>地图，以便更清楚地查看细节。"
                            }
                        },
                        {
                            "text": "The photographer <w>zoomed</w> out to capture the entire landscape.",
                            "target_lang_translations": {
                                "ru": "Фотограф <w>отдалил</w> кадр, чтобы захватить весь пейзаж.",
                                "zh": "摄影师<w>缩小</w>了镜头，以拍下整个风景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnify",
                        "enlarge",
                        "scale"
                    ],
                    "common_phrases": [
                        "zoom in",
                        "zoom out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраивать камеру или экран, чтобы изображение казалось больше (ближе) или меньше (дальше).",
                        "zh": "调整相机或屏幕显示，使图像看起来更大（更近）或更小（更远）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "делать изображение крупнее (zoom in)"
                            },
                            {
                                "target_lang_word": "отдалять",
                                "target_lang_sense_clarification": "делать изображение мельче (zoom out)"
                            },
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "изменять масштаб"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放大",
                                "target_lang_sense_clarification": "使图像变大（zoom in）"
                            },
                            {
                                "target_lang_word": "缩小",
                                "target_lang_sense_clarification": "使图像变小（zoom out）"
                            },
                            {
                                "target_lang_word": "变焦",
                                "target_lang_sense_clarification": "调整焦距以改变视野"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e131b2-5dfd-3396-add3-f48aef8f6832",
                    "sense_definition": "To move very quickly, often making a loud humming sound.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The racing cars <w>zoomed</w> past us on the track.",
                            "target_lang_translations": {
                                "ru": "Гоночные машины <w>пронеслись</w> мимо нас по трассе.",
                                "zh": "赛车在赛道上从我们身边<w>飞驰</w>而过。"
                            }
                        },
                        {
                            "text": "Time <w>zoomed</w> by while we were having fun on vacation.",
                            "target_lang_translations": {
                                "ru": "Время <w>пролетело</w> незаметно, пока мы веселились в отпуске.",
                                "zh": "度假时我们玩得很开心，时间<w>飞逝</w>而过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed",
                        "rush",
                        "whiz",
                        "race"
                    ],
                    "antonyms": [
                        "crawl",
                        "creep"
                    ],
                    "common_phrases": [
                        "zoom past",
                        "zoom by",
                        "zoom along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться очень быстро, часто издавая громкий жужжащий звук.",
                        "zh": "快速移动，通常伴有嗡嗡声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проноситься",
                                "target_lang_sense_clarification": "быстро проезжать мимо"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "мчаться с большой скоростью"
                            },
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "быстро ехать или бежать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞驰",
                                "target_lang_sense_clarification": "形容速度极快"
                            },
                            {
                                "target_lang_word": "疾驰",
                                "target_lang_sense_clarification": "快速奔跑或行驶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c414fc7-a8fa-31c9-ab40-640eb594c9e1",
                    "sense_definition": "To increase or rise very sharply and quickly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapid_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "House prices have <w>zoomed</w> in this neighborhood over the last year.",
                            "target_lang_translations": {
                                "ru": "Цены на жилье в этом районе <w>взлетели</w> за последний год.",
                                "zh": "过去一年里，这个社区的房价<w>飙升</w>。"
                            }
                        },
                        {
                            "text": "The company's profits <w>zoomed</w> after the launch of the new product.",
                            "target_lang_translations": {
                                "ru": "Прибыль компании <w>резко возросла</w> после запуска нового продукта.",
                                "zh": "新产品发布后，公司的利润<w>猛涨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soar",
                        "skyrocket",
                        "surge"
                    ],
                    "antonyms": [
                        "plummet",
                        "crash",
                        "drop"
                    ],
                    "common_phrases": [
                        "prices zoom",
                        "zoom up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень резко и быстро увеличиваться или расти (о ценах, показателях).",
                        "zh": "指价格或数值急剧且迅速地上升。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взлетать",
                                "target_lang_sense_clarification": "резко подниматься (о ценах)"
                            },
                            {
                                "target_lang_word": "резко расти",
                                "target_lang_sense_clarification": "быстро увеличиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飙升",
                                "target_lang_sense_clarification": "形容价格或数值猛涨"
                            },
                            {
                                "target_lang_word": "猛涨",
                                "target_lang_sense_clarification": "快速增长"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c304b378-ffa8-3f5b-8635-f885b1485e16",
                    "sense_definition": "A video teleconferencing call.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "video_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>zoom</w> with the marketing team at two o'clock.",
                            "target_lang_translations": {
                                "ru": "У меня <w>зум</w> с маркетинговой командой в два часа.",
                                "zh": "我两点钟要和市场部团队<w>开视频会议</w>。"
                            }
                        },
                        {
                            "text": "Are you free for a quick <w>zoom</w> later today?",
                            "target_lang_translations": {
                                "ru": "Ты свободен для быстрого <w>зума</w> сегодня попозже?",
                                "zh": "你今天晚些时候有空<w>视频通话</w>一下吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "videoconference",
                        "video call",
                        "meeting"
                    ],
                    "common_phrases": [
                        "on a zoom",
                        "join a zoom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used generically for any video call"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видеоконференция или звонок по видеосвязи.",
                        "zh": "一次视频会议或视频通话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зум",
                                "target_lang_sense_clarification": "разговорное название видеозвонка"
                            },
                            {
                                "target_lang_word": "видеозвонок",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视频会议",
                                "target_lang_sense_clarification": "正式的远程会议"
                            },
                            {
                                "target_lang_word": "视频通话",
                                "target_lang_sense_clarification": "非正式的视频交流"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38acd576-6682-36dd-ad3e-c3d0f82b5dcf",
                    "sense_definition": "A feature on a camera or device that makes the subject appear closer or further away.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_magnification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This camera has a powerful optical <w>zoom</w> for distant shots.",
                            "target_lang_translations": {
                                "ru": "У этой камеры мощный оптический <w>зум</w> для съемки удаленных объектов.",
                                "zh": "这款相机拥有强大的光学<w>变焦</w>功能，适合拍摄远景。"
                            }
                        },
                        {
                            "text": "Use the <w>zoom</w> to frame the picture exactly how you want it.",
                            "target_lang_translations": {
                                "ru": "Используй <w>зум</w>, чтобы выстроить кадр именно так, как ты хочешь.",
                                "zh": "使用<w>变焦</w>功能，把画面调整到你想要的样子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnification"
                    ],
                    "common_phrases": [
                        "optical zoom",
                        "digital zoom",
                        "zoom lens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция камеры или устройства, которая делает объект ближе или дальше.",
                        "zh": "相机或设备上使拍摄对象看起来更近或更远的功能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зум",
                                "target_lang_sense_clarification": "функция увеличения"
                            },
                            {
                                "target_lang_word": "увеличение",
                                "target_lang_sense_clarification": "оптическое или цифровое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变焦",
                                "target_lang_sense_clarification": "指相机的变焦功能"
                            },
                            {
                                "target_lang_word": "缩放",
                                "target_lang_sense_clarification": "指屏幕或图像的放大缩小功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84d836f6-7ab7-3666-b29c-e54b30162145",
                    "sense_definition": "A low humming noise made by something moving very fast.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the loud <w>zoom</w> of a jet plane flying overhead.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>гул</w> реактивного самолета, пролетающего над головой.",
                                "zh": "我们听到了喷气式飞机从头顶飞过时发出的巨大<w>轰鸣声</w>。"
                            }
                        },
                        {
                            "text": "The sudden <w>zoom</w> of the motorbike startled the pedestrians.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>жужжание</w> мотоцикла испугало пешеходов.",
                                "zh": "摩托车突然<w>呼啸</w>而过，吓到了行人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hum",
                        "whir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий гудящий звук, издаваемый чем-то очень быстро движущимся.",
                        "zh": "物体高速移动时发出的低沉嗡嗡声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "громкий, низкий звук"
                            },
                            {
                                "target_lang_word": "жужжание",
                                "target_lang_sense_clarification": "вибрирующий звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗡嗡声",
                                "target_lang_sense_clarification": "低沉的振动声"
                            },
                            {
                                "target_lang_word": "呼啸声",
                                "target_lang_sense_clarification": "高速移动时产生的风声或机械声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "766678e3-7f28-3966-a898-0b4adba3b526",
                    "sense_definition": "Used to represent a sudden fast movement or a humming sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rapid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zoom</w>! The car flew past us before we could even see the driver.",
                            "target_lang_translations": {
                                "ru": "<w>Вжик</w>! Машина пролетела мимо нас, прежде чем мы успели разглядеть водителя.",
                                "zh": "<w>嗖</w>！车子从我们身边飞驰而过，我们甚至没看清司机。"
                            }
                        },
                        {
                            "text": "The bird dived down to catch the fish, <w>zoom</w>, and was gone again.",
                            "target_lang_translations": {
                                "ru": "Птица нырнула вниз, чтобы поймать рыбу, <w>вжик</w>, и снова исчезла.",
                                "zh": "鸟儿俯冲下去抓鱼，<w>嗖</w>的一下，又不见了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения внезапного быстрого движения или жужжащего звука.",
                        "zh": "用于模拟快速移动或嗡嗡声的拟声词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вжик",
                                "target_lang_sense_clarification": "звукоподражание быстрому движению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗖",
                                "target_lang_sense_clarification": "形容物体快速掠过"
                            },
                            {
                                "target_lang_word": "呼",
                                "target_lang_sense_clarification": "形容快速移动的声音"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}