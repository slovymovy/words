                    "frequency": "Low",
                    "semantic_group_id": "disciplinarian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new headmaster was known as a rigid <w>martinet</w> who punished even the slightest offenses."
                        },
                        {
                            "text": "Soldiers feared serving under the captain because he was an uncompromising military <w>martinet</w>."
                        }
                    ],
                    "synonyms": [
                        "disciplinarian",
                        "authoritarian",
                        "taskmaster"
                    ],
                    "common_phrases": [
