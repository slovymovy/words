                    {
                        "sense_id": "b6a3bc6a-4bd8-3ca9-b8a9-d9ece6c715ee",
                        "entry_id": "de261f58-3acf-3486-b8f5-c99108250e33",
                        "glosses": [
                            "Prozess der Übertragung oder Verbreitung einer Krankheit (von einem Organismus auf einen anderen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea091ddf-5867-459a-902a-25651a110f4c",
                                "sense_id": "b6a3bc6a-4bd8-3ca9-b8a9-d9ece6c715ee",
                                "text": "„Wichtig für einen Schutz vor einer Krankheitsübertragung über die Scheidenschleimhaut ist auch eine gesunde Scheidenflora, also die Bakterien, die sich zuhauf in der Vagina tummeln.“"
                            },
                            {
                                "example_id": "5553ec0f-9a31-40e7-a6cc-58bd54375e91",
                                "sense_id": "b6a3bc6a-4bd8-3ca9-b8a9-d9ece6c715ee",
                                "text": "„Bei Verdacht auf Krankheitsübertragung sollte unbedingt ein Arzt aufgesucht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
