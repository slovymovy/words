                                        "sense_id": "47f0d38b-f14d-3db3-81d1-86e3386739e5",
                                        "entry_id": "fb10f7f0-b48e-362f-99f2-761ef1a71404",
                                        "glosses": [
                                            "An area used for hunting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96bd0ba2-3f47-3472-a734-0bb0e884c5b7",
                                        "entry_id": "fb10f7f0-b48e-362f-99f2-761ef1a71404",
                                        "glosses": [
                                            "A place where people can find what they are looking for."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac79e30b-c9ec-4f3b-8385-ee6550d2dfd5",
                                                "sense_id": "96bd0ba2-3f47-3472-a734-0bb0e884c5b7",
                                                "text": "Yes, it was my hunting ground, and it was solid happy. Course, my home wasn't exactly in Harlem […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8957a85-8c36-3591-babf-8e931d77acc7",
                                        "entry_id": "fb10f7f0-b48e-362f-99f2-761ef1a71404",
                                        "glosses": [
                                            "Synonym of stamping ground (“a place habitually frequented”)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2180379-0ca8-42d6-bf9d-f3c43427b263",
                                                "sense_id": "c8957a85-8c36-3591-babf-8e931d77acc7",
                                                "text": "In January 1901 he fought Jerry Driscoll back on his old hunting ground of Gateshead in the North East."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
