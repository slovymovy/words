                "translations": [
                    {
                        "translation_id": "7a16b349-f78d-41e1-a100-a13df98c8c2b",
                        "source_entry_id": "feb2b51c-c586-302e-8361-b2a60a73669a",
                        "source_sense_id": "07dee791-ea4e-3a30-af79-a33243ccf8a0",
