                                "target_senses": [
                                    {
                                        "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Extraordinary capable or knowledgeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbe4a80-66d4-4097-a3ad-45546766c13e",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "I am expert at making a simple situation complex."
                                            },
                                            {
                                                "example_id": "eee8d8f3-3bee-42d3-8827-3ff4f8a3767f",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "My cousin is an expert pianist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Characteristic of an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4400dc18-9d2f-4229-8859-303d3ebe0aeb",
                                                "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                                "text": "This problem requires expert knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9aa305-7602-3c0a-82df-44e4726b49c1",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Proven, experienced, veteran."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A person with extensive knowledge or ability in a given subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885b1c9c-fd0a-432d-a905-72485e899517",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "If an expert says it can't be done, get another expert. - David Ben-Gurion"
                                            },
                                            {
                                                "example_id": "837256c2-464e-4ceb-9acd-28049ca7978d",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "We called in several experts on the subject, but they couldn't reach an agreement."
                                            },
                                            {
                                                "example_id": "7df3c666-9ca6-4377-b295-f5f5a23d16c3",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            },
                                            {
                                                "example_id": "10fa2d69-4d43-4bc4-8c13-6a74b71efb35",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "I'm an expert in my field\nUfology, yes, it's all real\nAncient aliens, it's all true\nI'm an expert just like you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f712187-def4-3f07-87f9-c24dcf1000d4",
