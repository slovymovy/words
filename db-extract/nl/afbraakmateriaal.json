                "senses": [
                    {
                        "sense_id": "3507fb82-f6a1-374f-9810-7ffefd47196c",
                        "entry_id": "92d2c70b-4b0f-32dd-984a-abf526d361f4",
                        "glosses": [
                            "materiaal dat overblijft na de afbraak van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3c7cdd-da3a-4959-9e2a-6ac05652cbb0",
                                "sense_id": "3507fb82-f6a1-374f-9810-7ffefd47196c",
                                "text": "Het lichaam van de jongen werd donderdagmiddag ontdekt in een reiskoffer, die niet ver van de woonplaats in Ferrières-en-Brie in een container met afbraakmateriaal was geworpen."
                            },
                            {
                                "example_id": "65fa8859-e294-4043-9091-5cd9c0f6bc50",
                                "sense_id": "3507fb82-f6a1-374f-9810-7ffefd47196c",
                                "text": "Door de afbraak van een reeks gebouwen en ontharding van de omliggende ruimte in het centrum van Wetteren kan er 1.734 vierkante meter vrijkomen. De site was dicht en hoog bebouwd. De ‘dense’ woningen aan de steeg langs de kerk gaan plat. Er wordt samengewerkt met een lokale plantenkweker en er is aandacht voor hergebruik van het afbraakmateriaal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c457f10-a893-4d24-a6c7-feec8a3f0595",
                        "source_entry_id": "92d2c70b-4b0f-32dd-984a-abf526d361f4",
                        "source_sense_id": "3507fb82-f6a1-374f-9810-7ffefd47196c",
                        "source_sense_description": "materiaal dat overblijft na de afbraak van iets",
