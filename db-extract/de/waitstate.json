                "senses": [
                    {
                        "sense_id": "b0a210b8-1b8b-37fa-bd73-92935ac242d4",
                        "entry_id": "98ee0d56-5eb9-3a74-a4da-ed4bdd493d19",
                        "glosses": [
                            "Wartezustand des Computerprozessors; ein Taktzyklus, während dem der Prozessor pausiert, ohne auf den langsameren Arbeitsspeicher oder eine andere langsamere Komponente zuzugreifen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "c8807968-c16e-4a73-a05a-fb56adae2534",
                                "sense_id": "b0a210b8-1b8b-37fa-bd73-92935ac242d4",
                                "text": "Werden Computerprozessoren durch technologische Fortschritte im Vergleich zu anderen Komponenten sehr schnell, müssen sie Waitstates einlegen, um auf die Antwort des Speichers zu warten."
                            },
                            {
                                "example_id": "9c50301e-63cb-4441-8d78-fdcbee4e2f47",
                                "sense_id": "b0a210b8-1b8b-37fa-bd73-92935ac242d4",
                                "text": "Eine höhere Anzahl von Waitstates macht den Computer langsamer, aber auch stabiler. Die Anzahl der Waitstates herabzusetzen, kann dagegen zu instabilen Situationen führen."
                            },
                            {
                                "example_id": "5af526d4-b98c-4013-83df-086b252b7fbe",
                                "sense_id": "b0a210b8-1b8b-37fa-bd73-92935ac242d4",
                                "text": "Heutzutage weisen typische Zyklen von Waitstates eine zweistellige Anzahl von Prozessortakten auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
