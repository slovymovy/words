{
    "word_family": [
        "prompter",
        "promptly",
        "promptness",
        "promptitude"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "496c93de-9e98-3343-a775-3eef31780862",
                    "sense_definition": "Done quickly, immediately, or without delay.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We received a <w>prompt</w> response to our inquiry.",
                            "target_lang_translations": {
                                "ru": "Мы получили <w>оперативный</w> ответ на наш запрос.",
                                "tr": "Talebimize <w>hızlı</w> bir yanıt aldık.",
                                "zh": "我们收到了对咨询的<w>及时</w>回复。"
                            }
                        },
                        {
                            "text": "The doctor suggested <w>prompt</w> treatment to avoid complications.",
                            "target_lang_translations": {
                                "ru": "Врач предложил <w>немедленное</w> лечение, чтобы избежать осложнений.",
                                "tr": "Doktor, komplikasyonları önlemek için <w>acil</w> tedavi önerdi.",
                                "zh": "医生建议<w>立即</w>治疗以避免并发症。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quick",
                        "fast",
                        "rapid",
                        "speedy",
                        "immediate",
                        "instant",
                        "swift"
                    ],
                    "antonyms": [
                        "hesitant",
                        "hesitative",
                        "vacillatory"
                    ],
                    "common_phrases": [
                        "prompt action",
                        "prompt reply",
                        "prompt payment",
                        "prompt response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный быстро, немедленно или без задержек.",
                        "tr": "Hızlı, hemen veya gecikmeden yapılan.",
                        "zh": "指动作迅速、立即或毫无延迟地完成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "происходящий с большой скоростью"
                            },
                            {
                                "target_lang_word": "оперативный",
                                "target_lang_sense_clarification": "сделанный вовремя и быстро (часто о реакции или ответе)"
                            },
                            {
                                "target_lang_word": "немедленный",
                                "target_lang_sense_clarification": "совершаемый безотлагательно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hızlı",
                                "target_lang_sense_clarification": "çabuk gerçekleşen"
                            },
                            {
                                "target_lang_word": "anında",
                                "target_lang_sense_clarification": "gecikmesiz yapılan"
                            },
                            {
                                "target_lang_word": "acil",
                                "target_lang_sense_clarification": "hemen yapılması gereken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迅速的",
                                "target_lang_sense_clarification": "指动作或反应非常快"
                            },
                            {
                                "target_lang_word": "及时的",
                                "target_lang_sense_clarification": "指在恰当的时间内完成"
                            },
                            {
                                "target_lang_word": "立即的",
                                "target_lang_sense_clarification": "指不加拖延地执行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21fdbb8b-ec89-35fd-8f2c-c91d8a463205",
                    "sense_definition": "Arriving or acting at the correct or expected time; punctual.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please be <w>prompt</w> for the meeting so we can start on time.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, будьте <w>пунктуальны</w> на встрече, чтобы мы могли начать вовремя.",
                                "tr": "Zamanında başlayabilmemiz için lütfen toplantıya <w>dakik</w> olun.",
                                "zh": "请<w>准时</w>参加会议，以便我们能按时开始。"
                            }
                        },
                        {
                            "text": "She is always <w>prompt</w> in paying her bills.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>пунктуальна</w> в оплате счетов.",
                                "tr": "Faturalarını ödeme konusunda her zaman <w>dakiktir</w>.",
                                "zh": "她总是<w>按时</w>支付账单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "punctual",
                        "on time",
                        "timely"
                    ],
                    "common_phrases": [
                        "be prompt",
                        "prompt arrival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибывающий или действующий в правильное или ожидаемое время; пунктуальный.",
                        "tr": "Doğru veya beklenen zamanda gelen ya da hareket eden; dakik.",
                        "zh": "指在正确或预期的时间内到达或行动；准时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пунктуальный",
                                "target_lang_sense_clarification": "делающий всё вовремя"
                            },
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "соблюдающий установленное время"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dakik",
                                "target_lang_sense_clarification": "zamanlamaya uyan"
                            },
                            {
                                "target_lang_word": "zamanında",
                                "target_lang_sense_clarification": "tam vaktinde olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准时的",
                                "target_lang_sense_clarification": "指严格遵守时间安排"
                            },
                            {
                                "target_lang_word": "守时的",
                                "target_lang_sense_clarification": "指习惯于按时行事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dfb6982-1256-3e57-a000-3a6c9b897c11",
                    "sense_definition": "To cause something to happen or to make someone decide to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "causation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news <w>prompted</w> him to call his family immediately.",
                            "target_lang_translations": {
                                "ru": "Новости <w>побудили</w> его немедленно позвонить семье.",
                                "tr": "Haberler onu hemen ailesini aramaya <w>teşvik etti</w>.",
                                "zh": "这则新闻<w>促使</w>他立即给家人打了电话。"
                            }
                        },
                        {
                            "text": "The accident <w>prompted</w> a review of the safety procedures.",
                            "target_lang_translations": {
                                "ru": "Авария <w>вызвала</w> пересмотр процедур безопасности.",
                                "tr": "Kaza, güvenlik prosedürlerinin gözden geçirilmesine <w>yol açtı</w>.",
                                "zh": "这次事故<w>引起</w>了对安全程序的重新审查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cause",
                        "trigger",
                        "provoke",
                        "instigate",
                        "motivate",
                        "inspire"
                    ],
                    "common_phrases": [
                        "prompt a response",
                        "prompt an investigation",
                        "prompt a discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить что-то произойти или побудить кого-то решить сделать что-то.",
                        "tr": "Bir şeyin olmasına neden olmak veya birini bir şey yapmaya karar verdirmek.",
                        "zh": "导致某事发生，或促使某人决定做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "склонять к какому-либо действию"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "быть причиной возникновения чего-либо"
                            },
                            {
                                "target_lang_word": "подталкивать",
                                "target_lang_sense_clarification": "стимулировать к принятию решения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teşvik etmek",
                                "target_lang_sense_clarification": "birini harekete geçirmek"
                            },
                            {
                                "target_lang_word": "yol açmak",
                                "target_lang_sense_clarification": "bir olaya neden olmak"
                            },
                            {
                                "target_lang_word": "sebebiyet vermek",
                                "target_lang_sense_clarification": "ortaya çıkmasına neden olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "促使",
                                "target_lang_sense_clarification": "推动某人采取行动"
                            },
                            {
                                "target_lang_word": "引起",
                                "target_lang_sense_clarification": "导致某种结果或反应"
                            },
                            {
                                "target_lang_word": "激发",
                                "target_lang_sense_clarification": "引发某种想法或行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6c25f49-ce89-3522-88eb-13d02d2fde43",
                    "sense_definition": "To help a speaker or actor remember what to say by telling them the next words.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>prompted</w> the student when he forgot the answer.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>подсказал</w> ученику, когда тот забыл ответ.",
                                "tr": "Öğrenci cevabı unuttuğunda öğretmen ona <w>hatırlattı</w>.",
                                "zh": "当学生忘记答案时，老师<w>提示</w>了他。"
                            }
                        },
                        {
                            "text": "If the actor forgets his lines, I will <w>prompt</w> him from the side of the stage.",
                            "target_lang_translations": {
                                "ru": "Если актер забудет слова, я <w>подскажу</w> ему из-за кулис.",
                                "tr": "Oyuncu repliklerini unutursa, sahne kenarından ona <w>suflörlük yapacağım</w>.",
                                "zh": "如果演员忘记了台词，我会从舞台侧面为他<w>提词</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cue",
                        "remind",
                        "assist"
                    ],
                    "common_phrases": [
                        "prompt an actor",
                        "prompt someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помочь оратору или актеру вспомнить, что сказать, подсказав следующие слова.",
                        "tr": "Konuşmacıya veya oyuncuya sonraki kelimeleri söyleyerek ne diyeceğini hatırlatmak.",
                        "zh": "通过告诉说话者或演员接下来的词语，帮助他们回忆起该说什么。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказывать",
                                "target_lang_sense_clarification": "тихо говорить забытые слова"
                            },
                            {
                                "target_lang_word": "суфлировать",
                                "target_lang_sense_clarification": "подсказывать актерам в театре"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "suflörlük yapmak",
                                "target_lang_sense_clarification": "tiyatroda kelimeleri fısıldamak"
                            },
                            {
                                "target_lang_word": "hatırlatmak",
                                "target_lang_sense_clarification": "unutulan kelimeyi söylemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提示",
                                "target_lang_sense_clarification": "给予必要的线索或提醒"
                            },
                            {
                                "target_lang_word": "提词",
                                "target_lang_sense_clarification": "在表演中为演员提供台词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28223b70-653d-3418-9341-8cba22a9216f",
                    "sense_definition": "To request a user to provide input on a computer or digital system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system <w>prompted</w> me to enter a new password.",
                            "target_lang_translations": {
                                "ru": "Система <w>запросила</w> у меня новый пароль.",
                                "tr": "Sistem yeni bir şifre girmemi <w>istedi</w>.",
                                "zh": "系统<w>提示</w>我输入新密码。"
                            }
                        },
                        {
                            "text": "The app <w>prompted</w> the user to allow location access.",
                            "target_lang_translations": {
                                "ru": "Приложение <w>предложило</w> пользователю разрешить доступ к геолокации.",
                                "tr": "Uygulama, kullanıcıdan konum erişimine izin vermesini <w>istedi</w>.",
                                "zh": "该应用程序<w>要求</w>用户允许访问位置信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "ask"
                    ],
                    "common_phrases": [
                        "prompt for password",
                        "prompt the user"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запросить у пользователя ввод данных в компьютерной или цифровой системе.",
                        "tr": "Kullanıcıdan bir bilgisayar veya dijital sisteme girdi sağlamasını istemek.",
                        "zh": "在计算机或数字系统中要求用户输入信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрашивать",
                                "target_lang_sense_clarification": "требовать ввода информации"
                            },
                            {
                                "target_lang_word": "предлагать",
                                "target_lang_sense_clarification": "выводить сообщение с просьбой о действии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "istemek",
                                "target_lang_sense_clarification": "kullanıcıdan veri talep etmek"
                            },
                            {
                                "target_lang_word": "sormak",
                                "target_lang_sense_clarification": "girdi için ekrana uyarı getirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提示",
                                "target_lang_sense_clarification": "系统要求用户进行操作"
                            },
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "系统请求用户提供数据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a2dc99-f0b6-3f74-9817-2ff120805713",
                    "sense_definition": "To provide instructions or text to an artificial intelligence model to generate a specific result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>prompted</w> the AI to write a poem about the ocean.",
                            "target_lang_translations": {
                                "ru": "Он <w>дал задание</w> ИИ написать стихотворение об океане.",
                                "tr": "Yapay zekaya okyanus hakkında bir şiir yazması için <w>talimat verdi</w>.",
                                "zh": "他<w>指令</w>人工智能写一首关于海洋的诗。"
                            }
                        },
                        {
                            "text": "Users can <w>prompt</w> the model to create images in various styles.",
                            "target_lang_translations": {
                                "ru": "Пользователи могут <w>инструктировать</w> модель создавать изображения в разных стилях.",
                                "tr": "Kullanıcılar çeşitli stillerde görseller oluşturması için modele <w>istem iletebilir</w>.",
                                "zh": "用户可以向模型发送<w>提示词</w>以创建各种风格的图像。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instruct"
                    ],
                    "common_phrases": [
                        "prompt the model",
                        "prompt an AI"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "artificial intelligence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить инструкции или текст модели искусственного интеллекта для получения определенного результата.",
                        "tr": "Belirli bir sonuç üretmesi için yapay zeka modeline talimat veya metin vermek.",
                        "zh": "向人工智能模型提供指令或文本，以生成特定的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать задание",
                                "target_lang_sense_clarification": "отправлять инструкцию нейросети"
                            },
                            {
                                "target_lang_word": "инструктировать",
                                "target_lang_sense_clarification": "задавать параметры генерации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "istem iletmek",
                                "target_lang_sense_clarification": "yapay zekaya komut vermek"
                            },
                            {
                                "target_lang_word": "talimat vermek",
                                "target_lang_sense_clarification": "yapay zekayı yönlendirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "给AI的明确操作要求"
                            },
                            {
                                "target_lang_word": "提示词",
                                "target_lang_sense_clarification": "用于引导AI生成内容的文本"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "961d369a-ce98-309e-83a1-8a6fb245f963",
                    "sense_definition": "A word, signal, or action that reminds someone what to say or do.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor waited for a <w>prompt</w> from the wings before continuing.",
                            "target_lang_translations": {
                                "ru": "Актер ждал <w>подсказки</w> из кулис, прежде чем продолжить.",
                                "tr": "Oyuncu devam etmeden önce kulisten bir <w>hatırlatma</w> bekledi.",
                                "zh": "演员在继续表演前等待着侧幕的<w>提示</w>。"
                            }
                        },
                        {
                            "text": "The teacher gave the students a writing <w>prompt</w> to start their stories.",
                            "target_lang_translations": {
                                "ru": "Учитель дал ученикам <w>тему</w> для начала их рассказов.",
                                "tr": "Öğretmen, hikayelerine başlamaları için öğrencilere bir yazı <w>ipucu</w> verdi.",
                                "zh": "老师给学生们一个写作<w>提示</w>来开启他们的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cue",
                        "reminder",
                        "hint"
                    ],
                    "common_phrases": [
                        "give a prompt",
                        "writing prompt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, сигнал или действие, напоминающее кому-то, что сказать или сделать.",
                        "tr": "Birine ne söyleyeceğini veya yapacağını hatırlatan kelime, işaret veya eylem.",
                        "zh": "提醒某人该说什么或做什么的词语、信号或动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "помощь в том, что нужно сказать или сделать"
                            },
                            {
                                "target_lang_word": "напоминание",
                                "target_lang_sense_clarification": "знак или сигнал, чтобы вспомнить что-то"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hatırlatma",
                                "target_lang_sense_clarification": "ne yapılacağını belirten ipucu"
                            },
                            {
                                "target_lang_word": "ipucu",
                                "target_lang_sense_clarification": "yol gösterici işaret"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提示",
                                "target_lang_sense_clarification": "帮助回忆的线索"
                            },
                            {
                                "target_lang_word": "提醒",
                                "target_lang_sense_clarification": "引起注意的信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe705df-fb7f-39d2-989a-861086b77e95",
                    "sense_definition": "Textual input or instructions given to an artificial intelligence model to produce a desired output.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I entered a detailed <w>prompt</w> to get the chatbot to summarize the article.",
