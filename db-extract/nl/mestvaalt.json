                ],
                "senses": [
                    {
                        "sense_id": "318d25f8-ed59-3dbd-9d64-c18b900510a6",
                        "entry_id": "5d374adb-ad43-355a-9ed3-9eb0e52ab847",
                        "glosses": [
                            "platte hoop waar men dierenpoep en andere organisch afval van de boerderij verzamelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be4176c-7d40-4aaf-a103-cdce76c7ca24",
                                "sense_id": "318d25f8-ed59-3dbd-9d64-c18b900510a6",
                                "text": "Het aantal insecten was al dramatisch gedaald door het verbod op een open mestvaalt, door de toegenomen chemische insectenverdelging in de koeienstal en door het verharden van boerenerven."
                            },
                            {
                                "example_id": "906cc78f-eb3c-415c-9d23-19450a20f2e7",
                                "sense_id": "318d25f8-ed59-3dbd-9d64-c18b900510a6",
                                "text": "Achter een heg liggen de mestvaalt, de mutsert (de bundels takkenbossen voor het bakhuis) en de bliksemkuil, waarin water werd opgevangen mocht er brand uitbreken. De daken van de boerderijen waren meestal van stro."
                            },
                            {
                                "example_id": "bafc661f-dbbb-40c2-894d-1df173fa974d",
                                "sense_id": "318d25f8-ed59-3dbd-9d64-c18b900510a6",
                                "text": "Welwater kon van behoorlijke kwaliteit zijn, maar was meestal vervuild door gier uit mestvaalten of huishoudelijk afval."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7813484-d96b-35ff-af55-82c17e07e43c",
                        "entry_id": "5d374adb-ad43-355a-9ed3-9eb0e52ab847",
                        "glosses": [
                            "iets waar het niet prettig is zoals op een vuilnisbelt, iets waar een luchtje aan zit"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "129bf1c2-dec2-4a2f-9bea-8f16ce38ce85",
                                "sense_id": "b7813484-d96b-35ff-af55-82c17e07e43c",
                                "text": "Het valt niet mee een wielerkoers te becommentariëren na de bittere winter waarin ijskonijn Armstrong terug in zijn holletje werd gedirigeerd. Na hem werd de een na de ander gedwongen in zijn ranzige spiegel te kijken. Wat te verdragen is als vermoeden, wordt ondraaglijk als de waarheid naakt op de keien ligt: het peloton als farmaceutische mestvaalt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67957493-0adb-468e-8a1e-41102c4aa214",
                        "source_entry_id": "5d374adb-ad43-355a-9ed3-9eb0e52ab847",
                        "source_sense_id": "318d25f8-ed59-3dbd-9d64-c18b900510a6",
                        "source_sense_description": "platte hoop waar men dierenpoep en andere organisch afval van de boerderij verzamelt",
                        "target_lang_word": "Misthaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Misthaufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "655126fd-262f-3786-8859-8d3e6e41f567",
                                        "entry_id": "1d7a55ac-2985-38bb-8731-bc07b85f990e",
                                        "glosses": [
                                            "Platz, an dem Mist gelagert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8621c4-8f17-4087-bfd7-379d68594dbc",
                                                "sense_id": "655126fd-262f-3786-8859-8d3e6e41f567",
                                                "text": "„Den Besuchern schlagen das Dröhnen der Schmieden und der Gestank von Tausend Misthaufen entgegen.“"
                                            },
                                            {
                                                "example_id": "bdbfada1-35e4-4ffa-8041-e1039ad56b5b",
                                                "sense_id": "655126fd-262f-3786-8859-8d3e6e41f567",
                                                "text": "„Zwischen Misthaufen und Rübenfeldern führte ein Teerweg lang und an Masten mit Stromkabeln oder Telefonkabeln vorbei.“"
                                            },
                                            {
                                                "example_id": "406abf4b-df49-427c-9c44-832d5b595bf2",
                                                "sense_id": "655126fd-262f-3786-8859-8d3e6e41f567",
                                                "text": "„Die Ställe und Scheunen werden abgesucht, Holzschober umgeworfen, das Heu und das Stroh, die Misthaufen durchstochen: Da könnte ja etwas verborgen sein.“"
                                            },
                                            {
                                                "example_id": "c5e4d59d-c0ce-4ae2-b487-4a7f8140e0ad",
                                                "sense_id": "655126fd-262f-3786-8859-8d3e6e41f567",
                                                "text": "„Wenn sie mal ihre Notdurft verrichten musste, ging sie einfach nach draußen auf den Misthaufen neben dem Haus, hob ihren Rock und pinkelte im Stehen, auch die größeren Geschäfte erledigte sie auf diese Weise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
