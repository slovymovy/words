                        "glosses": [
                            "een naam waardoor men een mens, dier of ding zich van andere van dezelfde soort onderscheidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad919f77-c0f0-48b5-9553-47ea884dbcdb",
                                "sense_id": "fa349f88-ba7c-375f-b5f4-77764cc60ef6",
                                "text": "Omdat Rome een eigennaam is, wordt het met een hoofdletter geschreven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13f5692f-7976-4249-a1e0-7b1bab691c68",
                        "source_entry_id": "36a7fbdc-a41d-3c0e-8eeb-581fe25b21c7",
                        "source_sense_id": "fa349f88-ba7c-375f-b5f4-77764cc60ef6",
                        "source_sense_description": "een naam waardoor men een mens, dier of ding zich van andere van dezelfde soort onderscheidt",
                        "target_lang_word": "Eigenname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                        "entry_id": "8b5358b0-f997-3350-a48a-b195029024ae",
                                        "glosses": [
                                            "feststehende Bezeichnung aus einem oder mehreren Wörtern für ein bestimmtes Objekt wie Personen, Institutionen, Produkte, Orte, Gegenstände, Ereignisse, Sachverhalte und ähnliche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a3dd6b-e921-41d7-8d8c-f7f6e3ab7d88",
                                                "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                                "text": "Eigennamen schreibt man im Deutschen groß. Jede Person hat einen Eigennamen."
                                            },
                                            {
                                                "example_id": "c17ae18c-3f38-4637-9998-edccac842bf4",
                                                "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                                "text": "„Innerhalb der Gruppe der Substantive wird nochmals unterschieden zwischen Eigennamen (nomina propria) und Gattungsnamen oder besser Gattungsbezeichnungen (nomina appellativa).“"
                                            },
                                            {
                                                "example_id": "b8298ee7-3ac6-45d8-9a4e-c5de1e676c58",
                                                "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                                "text": "„Interessanterweise können Eigennamen aber in Gattungsnamen, sogenannte Appellative, übergehen - und umgekehrt.“"
                                            },
                                            {
                                                "example_id": "e7b848e9-a566-4c7d-b68b-08ba2676d434",
                                                "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                                "text": "„Daneben existieren Unterschiede zwischen Eigennamen und Appellativa.“"
                                            },
                                            {
                                                "example_id": "a713d3a6-0106-467c-85d4-0c9c5346471d",
                                                "sense_id": "3b29821e-bf2c-349e-a4ff-858b7cef32e1",
                                                "text": "„Spezialfälle der Benennung sind Termini und Eigennamen (Onyme).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
