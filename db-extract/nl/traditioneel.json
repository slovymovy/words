                ],
                "senses": [
                    {
                        "sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                        "entry_id": "0f0b6f67-5456-3036-a2c8-876f65bc892b",
                        "glosses": [
                            "zoals de gewoonte dat meebrengt, van oudsher gewoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6bd89a-90c6-481c-9d4a-40e588db19d6",
                                "sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                                "text": "Zij onthulde mij het traditionele recept, zoals het al eeuwenlang bestaat."
                            },
                            {
                                "example_id": "97453008-8e32-42b2-bf60-bbf59cc2e1d7",
                                "sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                                "text": "De Camino del Norte heeft veel voordelen ten opzichte van de traditionele Camino Frances, die naar Santiago de Compostela loopt."
                            },
                            {
                                "example_id": "62bdbdf4-b4fb-449c-b567-ad22f9a71127",
                                "sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                                "text": "Ik hoop dat ik niet ongelegen kom, mijn naam is Eric Lauritzen en ik ben ruim op tijd gekomen om Ahlén & Akerlunds traditionele kerstmagazines aan te bieden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ea7953b-863a-4c91-937d-beb73b612a9e",
                        "source_entry_id": "0f0b6f67-5456-3036-a2c8-876f65bc892b",
                        "source_sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                        "source_sense_description": "zoals de gewoonte dat meebrengt, van oudsher",
                        "target_lang_word": "traditionell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traditionell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee919ffd-aeea-3471-98f9-5eb6438f4c48",
                                        "entry_id": "6a28aa6e-f734-30a5-9c26-fd3976b8e1ef",
                                        "glosses": [
                                            "der Tradition entsprechend, der Tradition gemäß, über eine Tradition vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42443ca0-ca65-4aa3-8d82-51d3f4ba387c",
                                                "sense_id": "ee919ffd-aeea-3471-98f9-5eb6438f4c48",
                                                "text": "„Die Keramik zeigt eine vollständige Verschmelzung kleinasiatischer und traditionell zyprischer Stilmerkmale.“"
                                            },
                                            {
                                                "example_id": "1bc4950d-8d71-407a-89f4-46c1db6b08be",
                                                "sense_id": "ee919ffd-aeea-3471-98f9-5eb6438f4c48",
                                                "text": "„Die Liebenswürdigkeit der Frau Friedrich wetteiferte an solchem Tage mit ihrer Kochkunst, und ihr märkisch-schlagfertiger Witz tat das Weitere, um das Maschinenmeisterhaus bei den hohen Besuchern in gutem Andenken zu erhalten. Traditionell pflanzte sich alsbald die Sitte fort, diesem Andenken einen ganz bestimmten Ausdruck zu leihen: ein Milch- oder Sahnentopf wurde »zur Erinnerung an eine froh verlebte Kaffeestunde« bei Frau Friedrich abgegeben.“"
                                            },
                                            {
                                                "example_id": "930e5727-5021-4c1d-9a9a-855da376494f",
                                                "sense_id": "ee919ffd-aeea-3471-98f9-5eb6438f4c48",
                                                "text": "„[…] ja ein im Jahre 1498 zu Frankfurt gegebenes Passionsspiel hat nicht weniger als zweihundertfünfundsechzig Personen. Wie volksmäßig aber diese Stücke geworden, bezeugt schon der Umstand, daß sie, gleich dem alten Epos, nicht aufgeschrieben wurden, sondern als Nationalgut traditionell von Geschlecht zu Geschlecht sich forterbten.“"
                                            },
                                            {
                                                "example_id": "1f84b19e-6df5-4425-9b4f-756032d2912c",
                                                "sense_id": "ee919ffd-aeea-3471-98f9-5eb6438f4c48",
                                                "text": "„Für den gleichen Tatbestand war auch die Einstellung der Schüler zur Unterrichtsmethodik typisch: Sie sprachen sich in großer Mehrheit für eine mehr traditionelle Form des Fachunterrichts aus, in dem der Lehrer als unterrichtende Fachkraft auftritt, und waren überwiegend gegen Arbeitsgemeinschaften und freiere Formen des Unterrichtens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3a913e1-cd5b-470c-ac6a-9d8103e8a92d",
                        "source_entry_id": "0f0b6f67-5456-3036-a2c8-876f65bc892b",
                        "source_sense_id": "44325353-065f-31a7-8d06-f5716e0c327f",
                        "source_sense_description": "zoals de gewoonte dat meebrengt, van oudsher",
                        "target_lang_word": "traditional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traditional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "887cb027-c124-38d7-abc2-e55cdf0c1d8c",
                                        "entry_id": "24dadb60-5761-3d3d-9cc4-3a693d35b1b1",
                                        "glosses": [
                                            "Of, relating to, or derived from tradition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425a2dca-4234-4b43-ae76-6677dfaaa38b",
                                                "sense_id": "887cb027-c124-38d7-abc2-e55cdf0c1d8c",
                                                "text": "This dance is one of the traditional customs in the area."
                                            },
                                            {
                                                "example_id": "7ad762cb-e10b-44c0-aa02-ca4efe6f4784",
                                                "sense_id": "887cb027-c124-38d7-abc2-e55cdf0c1d8c",
                                                "text": "I think her traditional values are antiquated."
                                            },
                                            {
                                                "example_id": "b0945dfb-6d01-4cd1-a107-421d757a5930",
                                                "sense_id": "887cb027-c124-38d7-abc2-e55cdf0c1d8c",
                                                "text": "For centuries, the nomadic tribes of Central Asia used colorful textiles called suzanis as seating, prayer mats, bedding and dividers in their yurts – the traditional tents that were their homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007dc00c-f250-310d-a650-b905e75cdaf0",
                                        "entry_id": "24dadb60-5761-3d3d-9cc4-3a693d35b1b1",
                                        "glosses": [
                                            "Communicated from ancestors to descendants by word only."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1222684b-9064-4fc0-9a58-bef5ac8bd20e",
                                                "sense_id": "007dc00c-f250-310d-a650-b905e75cdaf0",
                                                "text": "traditional expositions of the Scriptures"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f499966-95b8-36bc-b5b6-e4fadac1496d",
                                        "entry_id": "24dadb60-5761-3d3d-9cc4-3a693d35b1b1",
                                        "glosses": [
                                            "Observant of tradition; attached to old customs; old-fashioned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f2dbd0-3984-4b87-866f-8419494a13d7",
                                                "sense_id": "2f499966-95b8-36bc-b5b6-e4fadac1496d",
                                                "text": "Ryoteis usually look like traditional Japanese inns or even private homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eaddce2-851e-35b8-9907-83d80f4cda92",
                                        "entry_id": "24dadb60-5761-3d3d-9cc4-3a693d35b1b1",
                                        "glosses": [
                                            "In lieu of the name of the composer of a piece of music, whose real name is lost in the mists of time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d31a1522-13ea-3a4c-bcf3-1d4bc384bf3a",
                                        "entry_id": "24dadb60-5761-3d3d-9cc4-3a693d35b1b1",
                                        "glosses": [
                                            "Relating to traditional Chinese."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8202132e-ed1d-4f13-8899-79e0812c9b8b",
                                                "sense_id": "d31a1522-13ea-3a4c-bcf3-1d4bc384bf3a",
                                                "text": "The traditional form of the character has twice as many strokes as the simplified form."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traditional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b57c5c51-4d8b-37ee-98e8-dbf7ffd577ee",
                                        "entry_id": "da18a763-cc31-3086-8029-8cf8f661dc0d",
                                        "glosses": [
                                            "A person with traditional beliefs."
