                "senses": [
                    {
                        "sense_id": "c28d8ddf-3443-3e6d-8d89-f28704f5af7b",
                        "entry_id": "85c43990-9f33-3144-b7d8-297ab942739d",
                        "glosses": [
                            "różanecznik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b904e9f9-8f9b-494d-959d-78fe53b6f7b7",
                                "sense_id": "c28d8ddf-3443-3e6d-8d89-f28704f5af7b",
                                "text": "Te gatunki i odmiany, które mają zimozielone, skórzaste liście, nazywane są zwyczajowo rododendronami lub różanecznikami, natomiast te o miękkich, lekko owłosionych i zrzucanych na zimę lub półzimotrwałych liściach nazywa się azaliami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3df64bd5-5430-4fa4-ad03-2a5fe45bc69f",
                        "source_entry_id": "85c43990-9f33-3144-b7d8-297ab942739d",
                        "source_sense_id": "c28d8ddf-3443-3e6d-8d89-f28704f5af7b",
                        "target_lang_word": "Rhododendron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhododendron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0eef3499-9e0a-3bd6-9c05-db274e4ca0d0",
                                        "entry_id": "4f3bed77-8a27-342b-bf66-3953c466f0fe",
                                        "glosses": [
                                            "eine Gattung der Familie der Heidekrautgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77176179-8741-4ab8-a99c-10784e56e7fe",
                                                "sense_id": "0eef3499-9e0a-3bd6-9c05-db274e4ca0d0",
                                                "text": "Rhododendren werden häufig auf Friedhöfen angepflanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8028e76f-5680-357d-986c-893cb9812c2e",
                                        "entry_id": "4f3bed77-8a27-342b-bf66-3953c466f0fe",
                                        "glosses": [
                                            "ein Mitglied dieser Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fae80b2-79f4-42ef-8407-a88a31fb5728",
                                                "sense_id": "8028e76f-5680-357d-986c-893cb9812c2e",
                                                "text": "Manche Rhododendren sind giftig und können schlimme Krankheiten verursachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff4d1603-de98-430f-98d5-fa6e1dd05947",
                        "source_entry_id": "85c43990-9f33-3144-b7d8-297ab942739d",
                        "source_sense_id": "c28d8ddf-3443-3e6d-8d89-f28704f5af7b",
                        "target_lang_word": "рододендрон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рододендрон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "87d5a8cd-b6c0-3a4f-bc3d-b68275e3deb7",
                                        "entry_id": "a5f815ab-9f5d-3fe6-b676-e9e5f948a9fc",
                                        "glosses": [
                                            "ботан. одно из вечнозелёных, полулистопадных или листопадных растений (кустарников или деревьев) семейства Вересковые с плотными листьями и красивыми цветами (Rhododendron)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea384f7-76c6-4764-9d06-0182f700c86a",
                                                "sense_id": "87d5a8cd-b6c0-3a4f-bc3d-b68275e3deb7",
                                                "text": "Весной во многих местах леса стоит одуряющий запах рододендрона жёлтого ― это пахнут солнечно-жёлтые ворончатые в шаровидных соцветиях цветки этого невысокого листопадного кустарника."
                                            },
                                            {
                                                "example_id": "ff259e32-666b-4646-9b62-ce3ac9bde900",
                                                "sense_id": "87d5a8cd-b6c0-3a4f-bc3d-b68275e3deb7",
                                                "text": "На заднем плане высажены: тисс ягодный, сорта рододендронов с белоснежными цветками, а на стене дома укреплены шпале́ры для плети́стых роз, опять же с белыми цветками."
                                            },
                                            {
                                                "example_id": "5c173798-594d-4c75-ab9f-12ebe967d9a1",
                                                "sense_id": "87d5a8cd-b6c0-3a4f-bc3d-b68275e3deb7",
                                                "text": "В чести́ у местных садоводов барбари́с Тунберга, а также гибискус сирийский и гортензия метёльчатая, а вот рододендроны используются редко ― в Сиракузах сильнощелочны́е почвы, и только самые заядлые любители возятся с этими капризу́лями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
