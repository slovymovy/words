        "nl-extract.jsonl": [
            {
                "entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                "word": "induiken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                        "entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                        "glosses": [
                            "ergens met grote snelheid binnengaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15eb28bd-da7a-4338-aa8e-eb23c15cea8c",
                                "sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                                "text": "Tom Coronel: ,,Racen is een levensbehoefte voor Hamilton. Een uitlaatklep. Die gaat er gewoon weer vol voor. Rustig aan? Nooit niet. Hij hoeft nu ook niet te denken bij het induiken van de eerste bocht: ik ga hier voor de puntjes."
                            },
                            {
                                "example_id": "aaef213b-81a1-44a6-adbc-c55de6dd785e",
                                "sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                                "text": "Singles Day is overgewaaid uit China. Dat land kampt als gevolg van de eenkindpolitiek met een overschot van tientallen miljoenen vrijgezelle mannen. Dat bracht vier studenten volgens de overlevering op het idee om 11-11 (vanwege de vier enen) te adopteren als Singles Day: een soort anti-Valentijnsdag waarop vrijgezellen met vrienden de karaokebar induiken om hun onafhankelijkheid te vieren."
                            },
                            {
                                "example_id": "4d41f23d-3fc9-494d-9dc9-94e886ee99c0",
                                "sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                                "text": "Nadat gisteren de eerste bewegende beelden van de tortelduifjes, waarin ze hand in hand in rap tempo een Hamburgs restaurant induiken, weten bronnen in Denekamp het zeker. Aan Tubantia laten ze weten 'hun' Sander te herkennen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b2a2c5f-5a8a-3218-b83b-9aa6a00abe2b",
                        "entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                        "glosses": [
                            "je ergens in onderdompelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4dfab0-9c9b-4870-82e9-759791ebc7b8",
                                "sense_id": "1b2a2c5f-5a8a-3218-b83b-9aa6a00abe2b",
                                "text": "Mariska, die als badmeester minstens 150 kinderen én volwassenen uit het zwembad viste, zou willen dat we éven nadenken voor we het water induiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "926d7d32-6293-3473-8339-361b101bb598",
                        "entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                        "glosses": [
                            "je ergens intensief mee bezig houden"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a71a5b16-00ef-4686-984e-c6a477c9f280",
                        "source_entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                        "source_sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                        "source_sense_description": "ergens binnengaan",
                        "target_lang_word": "dive in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dive in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "811582d9-9316-3f63-a4cc-8d49125c6687",
                                        "entry_id": "b2952602-d6b4-39d3-b642-785aa9a3b45e",
                                        "glosses": [
                                            "To start a new endeavor enthusiastically and wholeheartedly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8565a311-f1d5-4149-81a6-8c40ecedc2e4",
                                                "sense_id": "811582d9-9316-3f63-a4cc-8d49125c6687",
                                                "text": "Don't just get a toe wet; dive in and create your first entry."
                                            },
                                            {
                                                "example_id": "245e543b-31c4-4c4b-aaab-42d71c09ad02",
                                                "sense_id": "811582d9-9316-3f63-a4cc-8d49125c6687",
                                                "text": "The new project at work is so exciting - I want to dive right in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ede3715-9297-4076-bbaa-ed462cff3f13",
                        "source_entry_id": "fce881a5-2fde-3228-a249-e798b78825d5",
                        "source_sense_id": "6a6c5206-a41b-3d88-bef8-eb62d0d6e878",
                        "source_sense_description": "ergens binnengaan",
                        "target_lang_word": "plunge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plunge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To thrust into liquid, or into any penetrable substance; to immerse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887bd534-a98a-47a0-b117-270311d83470",
                                                "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                                "text": "to plunge the body into water"
                                            },
                                            {
                                                "example_id": "59fdcbbe-fcc4-4666-aed1-85bebdfd1192",
                                                "sense_id": "97cbc49c-629f-3cb3-b4dc-5f2306c7c292",
                                                "text": "\"Most of them don't wash. Those who do usually plunge their head into some brook or rill, if there happens to be one about.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To cast, stab or throw deep and fast into some thing, state, condition or action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f7c261-b975-4ffd-8dcd-02b1425bde09",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "to plunge a dagger into the breast"
                                            },
                                            {
                                                "example_id": "76a6e251-7026-4af7-a207-d0ff567020e0",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "to plunge a nation into war"
                                            },
                                            {
                                                "example_id": "18d65688-e343-449f-bde1-b2d00c823a01",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "the city was plunged into darkness"
                                            },
                                            {
                                                "example_id": "296fe07c-c07b-4b74-9c62-88ba9711f5b6",
                                                "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                                                "text": "Jon isn’t lying when he tells her she will always be his queen, right before plunging a knife into her. He genuinely swore obedience, and sees himself as a traitor when he commits the deeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f843e4-a302-3f5a-a0e1-bc3027761e02",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To baptize by immersion."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccb90a03-4f60-3687-9b4d-4dfa0224ec06",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To dive, leap or rush (into water or some liquid); to submerge oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c3cd276-1cf6-43a5-888a-f45f464fa6ce",
                                                "sense_id": "ccb90a03-4f60-3687-9b4d-4dfa0224ec06",
                                                "text": "he plunged into the river"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To fall or rush headlong into some thing, action, state or condition."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a594573-9d7f-48d4-aa17-d81785faff5b",
                                                "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                                "text": "to plunge into debt"
                                            },
                                            {
                                                "example_id": "c1172109-e8d5-44e7-b230-1061fce1abfc",
                                                "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                                "text": "to plunge into controversy"
                                            },
                                            {
                                                "example_id": "b37acecd-b289-4ca2-b1c8-e76440da15e8",
                                                "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                                "text": "profits plunge 90%"
                                            },
                                            {
                                                "example_id": "8fad6da5-cef4-411a-b772-5e8c62525713",
                                                "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                                "text": "The day was cool and snappy for August, and the Rise all green with a lavish nature. Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            },
                                            {
                                                "example_id": "80d56ff3-d8a5-466b-81f9-be99c44f70e5",
                                                "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                                                "text": "Target reported profit plunged 90% in the second quarter, falling far short of expectations, as inflation-weary customers pulled back on spending on nonessential items."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5019fc1f-8a9d-3ee2-98ba-58ef349e135b",
                                        "entry_id": "9c2170ac-2571-30a5-b4f0-0907f7d82388",
                                        "glosses": [
                                            "To pitch or throw oneself headlong or violently forward, as a horse does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ee2649-efa8-441d-8e5e-ad9033fcb22e",
                                                "sense_id": "5019fc1f-8a9d-3ee2-98ba-58ef349e135b",
                                                "text": "[N]ature affects a looſe kinde of liberty, vvhich it cannot indure to have reſtrained: neither fares it othervviſe vvith it, then vvith ſome vvilde colt; which at the firſt taking up, flings and plunges, and vvill ſtand on no ground; but after it hath been ſomvvhile diſciplin'd at the Poſt, is grovvn tractable, and quietly ſubmits either to the ſaddle, or the collar: […]"
