                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5567e1f-8ca5-3d9f-856a-b9b700d8d956",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
