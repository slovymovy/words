                                    }
                                ]
                            },
                            {
                                "target_word": "Kachel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                        "entry_id": "abcc6b9d-06c9-3672-855d-70ed83508c6c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35a92fb-a3d9-4915-bd20-1adcbc3b9eb5",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Frau Kachel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6ad3c363-1d06-4d24-af7a-46ce319dadc1",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Herr Kachel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "26df5e00-6369-49cb-814b-ea6b0680ccfa",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Die Kachels kommen heute aus Hessen."
                                            },
                                            {
                                                "example_id": "3a04b106-4905-4e69-99c9-c8ad73d7c44d",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Der Kachel trägt nie die Schals, die die Kachel ihm strickt."
                                            },
                                            {
                                                "example_id": "4b7a98f1-6783-4849-b7a1-ba9b183078cf",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kachel kommt, geht der Herr Kachel.“"
                                            },
                                            {
                                                "example_id": "443fda83-9b60-4fd2-8e94-0aba70ff530a",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Kachel kommt und geht."
                                            },
                                            {
                                                "example_id": "9e463006-bc63-40d5-b75b-7e96e4b2dadb",
                                                "sense_id": "efd8351f-99c7-3203-bc86-d70a406f5171",
                                                "text": "Kachels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
