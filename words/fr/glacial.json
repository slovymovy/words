                    "sense_id": "7106dc58-7490-32d6-b380-c1a1c83a4c91",
                    "sense_definition": "Extrêmement froid, qui transperce d'un froid vif.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, un vent <w>glacial</w> souffle sans arrêt sur les sommets de la montagne.",
                            "target_lang_translations": {
                                "en": "In winter, a <w>freezing</w> wind blows constantly over the mountain peaks.",
                                "ru": "Зимой на горных вершинах не переставая дует <w>ледяной</w> ветер.",
                                "nl": "In de winter waait er voortdurend een <w>ijzige</w> wind over de bergtoppen.",
                                "de": "Im Winter weht unaufhörlich ein <w>eisiger</w> Wind über die Berggipfel.",
                                "pl": "Zimą na szczytach gór nieustannie wieje <w>lodowaty</w> wiatr.",
                                "it": "In inverno, un vento <w>gelido</w> soffia senza sosta sulle cime della montagna.",
                                "cs": "V zimě přes horské štíty bez přestání fouká <w>mrazivý</w> vítr.",
                                "tr": "Kışın dağ zirvelerinde sürekli <w>buz gibi</w> bir rüzgâr esiyor.",
                                "es": "En invierno, un viento <w>helado</w> sopla sin cesar sobre las cumbres de la montaña.",
                                "zh": "冬季里，<w>刺骨</w>的寒风不停地吹过山顶。"
                            }
                        },
                        {
                            "text": "Il portait un manteau très épais pour affronter ce froid <w>glacial</w>.",
                            "target_lang_translations": {
                                "en": "He wore a very thick coat to face the <w>bitter</w> cold.",
                                "ru": "Он надел очень толстое пальто, чтобы выдержать этот <w>лютый</w> холод.",
                                "nl": "Hij droeg een heel dikke jas om deze <w>bittere</w> kou te trotseren.",
                                "de": "Er trug einen sehr dicken Mantel, um dieser <w>eisigen</w> Kälte zu trotzen.",
                                "pl": "Założył bardzo gruby płaszcz, żeby stawić czoło temu <w>mroźnemu</w> chłodowi.",
                                "it": "Indossava un cappotto molto spesso per affrontare quel freddo <w>glaciale</w>.",
                                "cs": "Na sobě měl velmi tlustý kabát, aby čelil tomuto <w>mrazivému</w> chladu.",
                                "tr": "Bu <w>buz gibi</w> soğuğa göğüs germek için çok kalın bir palto giymişti.",
                                "es": "Llevaba un abrigo muy grueso para afrontar ese frío <w>glacial</w>.",
                                "zh": "他穿了一件很厚的大衣，以抵御这种<w>刺骨</w>的寒冷。"
                            }
                        }
                    ],
                    "synonyms": [
