                "senses": [
                    {
                        "sense_id": "698c9c5a-496f-3b20-b27b-c7b5d5f8c762",
                        "entry_id": "9e130d34-91fd-3e4d-86de-999da91cd520",
                        "glosses": [
                            "Tau/Trosse (Seil), das zum Einsatz kommt, um etwas oder jemanden vor unkontrollierter/gefährlicher Bewegung zu schützen, um zum Beispiel beim Bergsteigen einen Absturz auszuschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adc70035-ea0f-44d9-b178-b4b41196db78",
                                "sense_id": "698c9c5a-496f-3b20-b27b-c7b5d5f8c762",
                                "text": "„Das Sicherungsseil geht schräg hinauf zum Westgrat des Fünften Kreuzbergs, wo der sichernde Kamerad hinter einem Felszacken sitzt.“"
                            },
                            {
                                "example_id": "001d6640-9529-45cb-9dc8-195efa7acddb",
                                "sense_id": "698c9c5a-496f-3b20-b27b-c7b5d5f8c762",
                                "text": "„Ein Sicherungsseil musste möglichst hoch im Baum verankern werden, damit sich die Douglasie leichter beim Fallen in die vorbestimmte Richtung ziehen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
