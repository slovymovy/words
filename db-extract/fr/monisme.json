        "fr-extract.jsonl": [
            {
                "entry_id": "718475ad-40f2-3592-be64-5028234423df",
                "word": "monisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a57f709-7413-4be0-9593-4ce1f59e1f02",
                        "entry_id": "718475ad-40f2-3592-be64-5028234423df",
                        "tags": [
                            "plural"
                        ],
                        "form": "monismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                        "entry_id": "718475ad-40f2-3592-be64-5028234423df",
                        "glosses": [
                            "Doctrine qui explique tout l’univers, choses et êtres, par les transformations d’un élément unique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691ebac7-63b9-4bab-8a34-a552e14240c4",
                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                "text": "Non seulement on n'a jamais fourni aucune explication mécanique valable des phénomènes vitaux, mais le problème de l'origine des êtres vivants, que le monisme prétend avoir résolu, reste aussi impénétrable qu'auparavant."
                            },
                            {
                                "example_id": "3123e44e-8eeb-45a6-82a5-eaad8643da54",
                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                "text": "Toute la métaphysique d'Aristote est conditionnée par la nécessité d'échapper au monisme du Père des Métaphysiciens, de Parménide."
                            },
                            {
                                "example_id": "66f30429-3b44-4cdd-9b01-4be1b4ebfb45",
                                "sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                                "text": "Le monisme vitaliste s'est forgé dans un contexte de proximité où l'être humain se découvre dans une relation étroite à lui-même et à son environnement. Dans cet univers restreint, la vie paraît être le principe fondamental et la condition naturelle et primitive de toute chose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d084c988-f797-4cdb-8382-17f35df329cf",
                        "source_entry_id": "718475ad-40f2-3592-be64-5028234423df",
                        "source_sense_id": "7ef3bdc1-1514-3a4d-aa77-27b95ba56c52",
                        "target_lang_word": "Monismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f362b7bb-761e-3bc0-98d9-bdb3c4f1b293",
                                        "entry_id": "f616aebb-b8f3-3869-b46b-0fad1e28b3ab",
                                        "glosses": [
                                            "die philosophische oder metaphysische Position, wonach sich alle Vorgänge und Phänomene der Welt auf ein einziges Grundprinzip zurückführen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94973a73-62bc-465a-a8c0-058052d85cc5",
                                                "sense_id": "f362b7bb-761e-3bc0-98d9-bdb3c4f1b293",
                                                "text": "„Der Monismus führt alle Phänomene der Welt auf ein einziges Grundprinzip zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f9a394-12d8-4e5a-9af5-938d4992c618",
