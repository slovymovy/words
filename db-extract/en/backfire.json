                                        "entry_id": "0b47d5d5-c498-3557-b3ff-c18e36d8cd97",
                                        "glosses": [
                                            "nicht den gewünschten Erfolg bringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c7bfd9-f04a-4fb8-ace4-9cfdaf98e5e9",
                                                "sense_id": "5c627d31-f39a-3bd0-a542-b4dc5f258f08",
                                                "text": "Unser letztes Projekt ist fehlgeschlagen."
                                            },
                                            {
                                                "example_id": "94bfe785-ee60-470d-ba11-302b5095c647",
                                                "sense_id": "5c627d31-f39a-3bd0-a542-b4dc5f258f08",
                                                "text": "Doch selbst dieser Versuch einer Schadensbegrenzung musste letztlich fehlschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a7baf0c-5e37-4251-8c19-3ca6196ca139",
                        "source_entry_id": "71101637-0397-3317-88dd-cca12cc8de42",
                        "source_sense_description": "fail",
                        "target_lang_word": "nach hinten losgehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nach hinten losgehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac173120-c5ec-381a-a673-0d9e59685650",
                                        "entry_id": "bcb4df26-665b-3527-976c-8041957ea83c",
                                        "glosses": [
                                            "nicht wie erwartet verlaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8578c273-eb4b-4d33-bb5c-a103ec4250b4",
                                                "sense_id": "ac173120-c5ec-381a-a673-0d9e59685650",
                                                "text": "Der Ausbruch ging nach hinten los und die Gefangenen wurden wieder eingesperrt."
                                            },
                                            {
                                                "example_id": "4c57dc0d-5896-4387-9820-d5ba1caca21d",
                                                "sense_id": "ac173120-c5ec-381a-a673-0d9e59685650",
                                                "text": "Viele Konzerne klagen gegen Wallraff. Doch die Klagen gehen nach hinten los: Wallraff gewinnt fast alle Prozesse – und die Politik reagiert endlich. Nicht nur die unmenschlichen Bedingungen bei Thyssen werden abgeschafft, auch das Arbeitsrecht wird seitdem regelmäßiger kontrolliert."
                                            },
                                            {
                                                "example_id": "536c8b3a-b111-406b-92cf-e9b62f26cd0a",
                                                "sense_id": "ac173120-c5ec-381a-a673-0d9e59685650",
                                                "text": "Die Band musste sich eingestehen, dass die Vermarktungsstrategie ihres letzten Albums \"Songs of Innocence\" von 2014 nach hinten los ging. Damals hatte Apple das Album auf weltweit allen iTunes-Accounts - insgesamt einer halben Milliarde - gratis zur Verfügung gestellt."
                                            },
                                            {
                                                "example_id": "cdedb8ec-0b06-44d7-847e-123765db5574",
                                                "sense_id": "ac173120-c5ec-381a-a673-0d9e59685650",
                                                "text": "\"Made in Germany\" - mit der Pflicht, die Herkunft von Waren auszuzeichnen, wollte die britische Regierung vor 125 Jahren Billigimporte bekämpfen. Doch der Schuss ging nach hinten los: \"Made in Germany\" wurde ein Gütesiegel, das den deutschen Export noch immer beflügelt …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
