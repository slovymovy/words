{
    "word_family": [
        "mentor",
        "mentorship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0519a2ec-5db0-3fe8-975a-ca56d18fc074",
                    "sense_definition": "The act or process of providing guidance and support to a less experienced person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offers a formal <w>mentoring</w> program for all new employees.",
                            "target_lang_translations": {
                                "it": "L'azienda offre un programma formale di <w>mentoring</w> per tutti i nuovi dipendenti."
                            }
                        },
                        {
                            "text": "She found that <w>mentoring</w> junior staff helped her develop her own leadership skills.",
                            "target_lang_translations": {
                                "it": "Ha scoperto che <w>fare da mentore</w> al personale junior l'ha aiutata a sviluppare le proprie capacità di leadership."
                            }
                        }
                    ],
                    "synonyms": [
                        "guidance",
                        "coaching",
                        "tutoring"
                    ],
                    "common_phrases": [
                        "mentoring program",
                        "provide mentoring"
                    ],
                    "target_lang_definitions": {
                        "it": "L'atto o il processo di fornire guida e supporto a una persona meno esperta."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "mentoring",
                                "target_lang_sense_clarification": "termine inglese ampiamente utilizzato in ambito professionale italiano"
                            },
                            {
                                "target_lang_word": "tutoraggio",
                                "target_lang_sense_clarification": "attività di guida e assistenza, spesso in contesti formativi o lavorativi"
                            },
                            {
                                "target_lang_word": "affiancamento",
                                "target_lang_sense_clarification": "processo di supporto e guida pratica sul campo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dd6ac29-1925-37d1-be4f-bfff35e155b8",
                    "sense_definition": "The present participle and gerund of <w>mentor</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>mentoring</w> three students at the university.",
                            "target_lang_translations": {
                                "it": "Attualmente sta <w>guidando</w> tre studenti all'università."
                            }
                        },
                        {
                            "text": "After years of <w>mentoring</w> young artists, she decided to open her own gallery.",
                            "target_lang_translations": {
                                "it": "Dopo anni passati a <w>fare da mentore</w> a giovani artisti, ha deciso di aprire la sua galleria."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mentoring students",
                        "mentoring staff"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo mentor (fare da mentore, guidare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fare da mentore",
                                "target_lang_sense_clarification": "agire come guida esperta per qualcuno"
                            },
                            {
                                "target_lang_word": "guidare",
                                "target_lang_sense_clarification": "fornire direzione e supporto a qualcuno"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}