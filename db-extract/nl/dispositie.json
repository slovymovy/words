                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b989e805-39d7-4db0-b2ae-413f04b0da55",
                                                "sense_id": "ab55c647-0cf4-3f28-9aa5-d096c4a160a8",
                                                "text": "The scouts reported on the disposition of the enemy troops."
                                            },
                                            {
                                                "example_id": "f60bd2d3-b31c-4efd-9116-783cecf82be4",
                                                "sense_id": "ab55c647-0cf4-3f28-9aa5-d096c4a160a8",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e99b9b59-1436-3c4a-8528-1cf01ea71098",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Control over something, or the results produced by the exercise of such control; thus:",
                                            "Control over something, especially with regard to disposing or dispensing with an action item (disposal of a concern, allocation of disbursed funds) or control over the arrangement or placement of certain things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482b16b9-55c8-4c2c-afdc-3b141836ef4e",
                                                "sense_id": "e99b9b59-1436-3c4a-8528-1cf01ea71098",
                                                "text": "You will have full disposition of these funds."
                                            },
                                            {
                                                "example_id": "daeab415-7c29-40a6-9c37-a82e99d53a73",
                                                "sense_id": "e99b9b59-1436-3c4a-8528-1cf01ea71098",
                                                "text": "Seduced at the age of 10 by a famous sodomist named Duplessis, he had since been at the disposition of a number of homosexual persons, including officers, priests, and marquises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92104cc3-f801-33fe-8f13-1fff0d64ff54",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Control over something, or the results produced by the exercise of such control; thus:",
                                            "Transfer or relinquishment to the care or possession of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cae3def7-a8aa-44f7-aea7-dbe7df6c079f",
                                                "sense_id": "92104cc3-f801-33fe-8f13-1fff0d64ff54",
                                                "text": "The court ordered the disposition of all assets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf4b512-83fd-3fea-be74-f3405ead34c1",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Control over something, or the results produced by the exercise of such control; thus:",
                                            "Final decision or settlement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a45439d-4843-47c9-bd63-aef1b11a606b",
                                                "sense_id": "7cf4b512-83fd-3fea-be74-f3405ead34c1",
                                                "text": "The disposition of the case will be announced tomorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf7fb3f-b253-3e7e-8d5c-85bd95656bec",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Control over something, or the results produced by the exercise of such control; thus:",
                                            "The destination of a patient after medical treatment, especially after emergency triage, first line treatment, or surgery; the choice made for the next venue of care."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47e6a91-6376-4500-a792-36cfa72331df",
                                                "sense_id": "aaf7fb3f-b253-3e7e-8d5c-85bd95656bec",
                                                "text": "The patient was given a disposition for outpatient care, as ward admission was not indicated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9550881-2a7b-34d5-9b23-bfc017e37a14",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Control over something, or the results produced by the exercise of such control; thus:",
                                            "The set of choirs of strings on a harpsichord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efbf16f5-000d-4451-ae1f-67e01c7deaa8",
                                                "sense_id": "b9550881-2a7b-34d5-9b23-bfc017e37a14",
                                                "text": "This small harpsichord has a 1 x 4' disposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdbd1fc-2438-36d7-ab36-60f67e43893f",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Tendency or inclination under given circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e05de894-ef64-4d11-beaf-dba94d2cf024",
                                                "sense_id": "9bdbd1fc-2438-36d7-ab36-60f67e43893f",
                                                "text": "I have little disposition now to do as you say."
                                            },
                                            {
                                                "example_id": "f7dcc5ad-474f-48d5-955c-90bb60d16816",
                                                "sense_id": "9bdbd1fc-2438-36d7-ab36-60f67e43893f",
                                                "text": "Salt has a disposition to dissolve in water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "The way in which something or someone is disposed or disposed of (in any sense of those terms); thus:",
                                            "Temperament, temperamental makeup or habitual mood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64865ec2-2834-4e56-b13d-923335e7fd8b",
                                                "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                                "text": "She has a sunny disposition."
                                            },
                                            {
                                                "example_id": "e5250940-6ec0-4ce4-9a5c-b36ecf55d8b2",
                                                "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                                "text": "He has such a foul disposition."
                                            },
                                            {
                                                "example_id": "33bf4a5b-b199-4b06-99d4-84b994dcb899",
                                                "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                                "text": "He was, indeed, a lad of a remarkable disposition; sober, discreet, and pious beyond his age […]"
                                            },
                                            {
                                                "example_id": "773709c1-6bae-47b7-9bfa-2546f4bf5e86",
                                                "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                                "text": "So much does creative wisdom [of Divine Providence] seem to delight in variety, that, tame only a nest of small birds—starlings or sparrows—and you will soon perceive that these birds will not only be distinguishable by bodily appearance, but also by individuality of temper. The same diversity of disposition pervades all creation, even the vegetable and mineral kingdoms, and is far more perceptible in the human species, where the variations are endless and minute, between the two extremes of greatest and least ability and aptitude. Education will always do a great deal; yet where, by infinite labour, you can excite and impress the dull faculties of one brother or sister till they have got versed by rote in any lesson of art or science, another will catch up the idea at once with such aptitude as might make you suppose it intuitive in his or her constitution."
                                            },
                                            {
                                                "example_id": "0e218f89-058e-4ea3-9391-e24d34d1fbf2",
                                                "sense_id": "5de5d4d2-0662-3032-900b-23902dd46e6b",
                                                "text": "Sometimes I'm happy / Sometimes I'm blue / My disposition / Depends on you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb92e99d-9637-3f6d-b49e-4536b513738e",
                                        "entry_id": "ad0fdf39-1620-3c19-9029-50de8bf25004",
                                        "glosses": [
                                            "Provision; clause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6e4c04-9511-47d0-b102-c07d4442e86f",
                                                "sense_id": "eb92e99d-9637-3f6d-b49e-4536b513738e",
                                                "text": "The C.C. is the supreme interpreter of the Constitution (Section 1 of the O.L.C.C.) and, as we have already said, it was granted the monopoly of declaring unconstitutional the legal dispositions."
                                            },
                                            {
                                                "example_id": "e3f6fa89-06ee-43fc-8004-d4c35ab74624",
                                                "sense_id": "eb92e99d-9637-3f6d-b49e-4536b513738e",
                                                "text": "The dispositions of this Act shall not be applied in case of […]"
                                            },
                                            {
                                                "example_id": "b5c63ed6-285b-4477-9d59-1f65d0d0ddc3",
                                                "sense_id": "eb92e99d-9637-3f6d-b49e-4536b513738e",
                                                "text": "an obligation that can arise as a consequence of an expected action or inaction of the foreign person that goes against the dispositions of this law"
                                            }
                                        ]
                                    }
                                ]
