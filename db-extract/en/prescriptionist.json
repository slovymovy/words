                ],
                "senses": [
                    {
                        "sense_id": "c65bdc49-c198-3451-9225-9ca0cca879dd",
                        "entry_id": "432f14dc-e29b-34ca-b5be-e40bd24180c6",
                        "glosses": [
                            "Relying on historical precedent rather than current usage (to determine rights or correctness)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ed1b0c-124a-4ad4-91fd-6e4cff665e42",
                                "sense_id": "c65bdc49-c198-3451-9225-9ca0cca879dd",
                                "text": "Much of the disagreement between the prescriptionist and descriptionist views turns on the question of compensation among generations."
                            },
                            {
                                "example_id": "f9ce17ab-ae75-4e41-b8ab-afb51eb4edf9",
                                "sense_id": "c65bdc49-c198-3451-9225-9ca0cca879dd",
                                "text": "Educators often come into the profession with a certain view of language that is more prescriptionist in nature (Edwards, 1982; Taylor, 1983; Trudgill, 1975; Williams, 1976)."
                            },
                            {
                                "example_id": "2c0cd843-5b07-420b-b196-4881a85e6358",
                                "sense_id": "c65bdc49-c198-3451-9225-9ca0cca879dd",
                                "text": "Teaching the English language may be their bread and butter, but they are unable to enforce the notion of a 'standard prescriptionist English.'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
