                                        "entry_id": "5cb9acfa-e20e-3c8b-a68e-d8cbe2138de5",
                                        "glosses": [
                                            "Large, heavily-constructed scissors or shears, operated by hand and used for cutting sheets of metal."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8719bbf-8e9f-4943-9b53-b2dc2c14953e",
                                                "sense_id": "9260fe26-25c2-335b-8633-d55f339d2165",
                                                "text": "My husband spent the next day inside the plane, cutting out an unused gasoline tank, piece by piece, with tin snips."
                                            },
                                            {
                                                "example_id": "9d486657-84a9-4fb1-95b4-976196045723",
                                                "sense_id": "9260fe26-25c2-335b-8633-d55f339d2165",
                                                "text": "If you plan to do much work sheet metal, a pair of curved-blade tin snips will save wear and tear on your nerves in the long run."
                                            },
                                            {
                                                "example_id": "8430b94b-cdeb-4976-8003-cfdf9cab9bde",
                                                "sense_id": "9260fe26-25c2-335b-8633-d55f339d2165",
                                                "text": "This bend eliminates unsightly waviness that often develops as you cut the copper with a tin snips."
                                            }
                                        ]
                                    }
                                ]
                            }
