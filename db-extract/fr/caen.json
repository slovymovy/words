                "senses": [
                    {
                        "sense_id": "cf57c2e6-a261-311d-874c-2587fac0d57f",
                        "entry_id": "9eb090eb-6e5f-34dc-bdac-2ced4469d426",
                        "glosses": [
                            "Commune et chef-lieu de département français, située dans le département du Calvados."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072f427e-b6b1-42bf-aa20-86e07a7195d5",
                                "sense_id": "cf57c2e6-a261-311d-874c-2587fac0d57f",
                                "text": "De toute façon, on ne peut pas se dire : “Tiens, j’aurais dû faire ça ou ça”, insiste Patrice Garande, ex-coach de Caen ou Dijon."
                            },
                            {
                                "example_id": "50ffea5e-6700-4394-9f9f-9b579f9a10d4",
                                "sense_id": "cf57c2e6-a261-311d-874c-2587fac0d57f",
                                "text": "Les Rennais restaient sur trois victoires face à Caen (2-1), Augsbourg (3-2) et Nantes (1-0)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "563f054b-e21e-4fbe-bd87-846ce1a39816",
                        "source_entry_id": "9eb090eb-6e5f-34dc-bdac-2ced4469d426",
                        "source_sense_id": "cf57c2e6-a261-311d-874c-2587fac0d57f",
                        "target_lang_word": "Caen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caen",
