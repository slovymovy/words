                                    {
                                        "sense_id": "122ce928-8960-3a19-8608-d830aea94445",
                                        "entry_id": "a5a41c4a-028d-3b3b-87b5-423ac1e64b7c",
                                        "glosses": [
                                            "Ninfa del bosque vinculada con un árbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ed77f3-2a4e-4dcc-a44b-bdb3d746f070",
                                                "sense_id": "122ce928-8960-3a19-8608-d830aea94445",
                                                "text": "ÉRASE una vez una infancia que no acaba nunca, poblada de historias de grifones sentimentales y gaiteros que envejecen, pero que rescatan dríades que se aburren mortalmente en sus árboles, de gigantes con un alto sentido práctico, que declaran la guerra al príncipe a punto de casarse, para mantenerlo entretenido, y así hacer tiempo para que la joven princesa pueda tener todos sus modelitos terminados…"
                                            }
                                        ],
