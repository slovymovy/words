                        "glosses": [
                            "Recueil des coutumes d’une province ou d’un pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "629f19bc-a083-420e-8faf-60eb3b238a71",
                                "sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                                "text": "Au XIVᵉ siècle, le liber practicus de consilio Remensi nᵒ 36 et les coutumiers de Champagne considèrent le mariage comme émancipant."
                            },
                            {
                                "example_id": "78fe1d5c-04df-4d4c-8c11-173940cbade9",
                                "sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                                "text": "Lorsqu’un homme était justicié, lit-on dans le Grand Coutumier, le bourreau avait le droit à tout ce qui était au-dessus de la ceinture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0584d9c4-995e-4774-9ba9-f301405c3a39",
                        "source_entry_id": "31f718f3-2a25-37eb-9cbd-3790cc33a074",
                        "source_sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                        "target_lang_word": "Rechtsbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
