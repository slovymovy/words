                "senses": [
                    {
                        "sense_id": "f129c142-1a4b-36a9-a86f-f0c3f61d0345",
                        "entry_id": "0331d029-aaae-3eb6-99dd-07eb367f888c",
                        "glosses": [
                            "представитель группы родственных народов, говорящих на тюркских языках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75520721-b955-4a36-b5df-76bf418cb771",
                                "sense_id": "f129c142-1a4b-36a9-a86f-f0c3f61d0345",
                                "text": "Высокий лоб, мало выдающиеся скулы, почти прямой разрез глаз и прямой нос с горбинкой выдавали, что это не монгол, а тюрк или тангут."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f022e01a-1262-471e-b1fd-41805154b00f",
                        "source_entry_id": "0331d029-aaae-3eb6-99dd-07eb367f888c",
                        "source_sense_id": "f129c142-1a4b-36a9-a86f-f0c3f61d0345",
                        "target_lang_word": "Turk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69ef077d-89f6-35b4-95cf-094d256bacdf",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A speaker of the various Turkic languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29dd20b6-e822-3fc2-9be9-6c9266364909",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A person from Turkey or of Turkish ethnic descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6508c0db-ff2c-3634-b935-e5e7291b42c8",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A Muslim."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19f9547-dc30-442d-b4fe-837d484939de",
                                                "sense_id": "6508c0db-ff2c-3634-b935-e5e7291b42c8",
                                                "text": "Would not this, sir, and a forest of feathers—if the rest of my fortunes turn Turk with me—with two Provincial roses on my razed shoes, get me a fellowship in a cry of players?"
                                            },
                                            {
                                                "example_id": "a09b1597-1254-458c-bf82-61f8966e296e",
                                                "sense_id": "6508c0db-ff2c-3634-b935-e5e7291b42c8",
                                                "text": "Compare but our manners unto a Turke [translating Mahometan], or a Pagan, and we must needs yeeld unto them[…]."
                                            },
                                            {
                                                "example_id": "1874dd7b-48d7-4b7e-9fda-0d6083e1276b",
                                                "sense_id": "6508c0db-ff2c-3634-b935-e5e7291b42c8",
                                                "text": "It is no good reason for a man's religion that he was born and brought up in it; for then a Turk would have as much reason to be a Turk as a Christian to be a Christian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc13aa3f-f901-32cc-9998-fd70eea9eb8d",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "a Christian horse-archer in Crusader army (Turcopole)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A bloodthirsty and savage person; vandal; barbarian."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab0addf-894a-44ec-80b6-99563cd6a346",
                                                "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                                "text": "Was neuer any Impe so wicked and barbarous, any Turke so vyle and brutishe."
                                            },
                                            {
                                                "example_id": "4447dfda-d986-4d8a-afc0-ccbbc70f3087",
                                                "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                                "text": "A sort of primitive barbarity distinguishes the whole; no variety of character appears; and to call a man Turk is to say, that he is jealous, haughty, covetous, ignorant, and lascivious; at the same time that a certain dignity of gait, and magnificence of manners, gives him the appearance of generosity and true greatness of soul."
                                            },
                                            {
                                                "example_id": "98e0768b-e8ee-4b2b-a8b1-14a0d18d74b2",
                                                "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                                "text": "A bad temper does seem often favourable to health. The man who has been a Turk all his life lives long to plague all about him."
                                            },
                                            {
                                                "example_id": "811e62c2-b678-4018-8527-d37f59d754ee",
                                                "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                                "text": "As much as the wilfully or naturally blunted, the intelligently honest have to learn by touch: only, their understandings cannot meanwhile be so wholly obtuse as our society's matron, acting to please the tastes of the civilized man—a creature that is not clean-washed of the Turk in him—barbarously exacts."
                                            },
                                            {
                                                "example_id": "e35cf2d4-a2dc-456a-8845-41decc485f62",
                                                "sense_id": "18bbbabe-496d-3d6c-92cd-bc003ad2c604",
                                                "text": "They regarded the very word Turk as synonymous with ignorance, impoliteness, and idiocy. To call a man 'Turk' was regarded as a great dishonour to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38ce25d-1bbc-3e9b-af49-5c42b0cd2936",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A member of a Mestee group in South Carolina."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb74dcf7-fa40-3b58-9afa-e3fc12a2f82c",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A person from Llanelli, Wales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ebfe029-d22c-3ce1-8814-62978b4db640",
                                        "entry_id": "6edb1ca2-6439-3f0a-bc3a-521b63712b27",
                                        "glosses": [
                                            "A Turkish horse."
                                        ],
                                        "tags": [],
