                    {
                        "translation_id": "12b4b643-35a2-4a6b-8b8b-ae07895ceb01",
                        "source_entry_id": "9e9df2cb-d86f-37ef-adf7-09aa7405fa3b",
                        "target_lang_word": "Pinsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pinsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                        "entry_id": "8652313a-1527-38d7-ac62-9a6ba9a8c79e",
                                        "glosses": [
                                            "Gegenstand zum dosierten Auftragen von zum Beispiel Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce984822-81cf-402a-a891-c07d45b93dbe",
                                                "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                                "text": "Nach dem Malen muss man den Pinsel gleich gut reinigen, damit die Farbe nicht eintrocknet, und er nicht verklebt."
                                            },
                                            {
                                                "example_id": "11bf6ef4-d509-4610-bd0e-8d7619fdf747",
                                                "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                                "text": "Der Fingerabdruckexperte trug das Pulver mit einem kleinen Pinsel auf."
                                            },
                                            {
                                                "example_id": "15b8f3bc-0641-4d29-8486-abd095d502c3",
                                                "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                                "text": "„Wieder taucht er den Pinsel ein.“"
                                            },
                                            {
                                                "example_id": "743f5bd7-4ab9-4b9e-b10f-8dee0f1d31a9",
                                                "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                                "text": "„Er versuchte, sich abzulenken, reinigte Pinsel und Farbpalette, sortierte die Kreiden in eine Blechdose, nahm das Bild von der Staffelei und stellte es auf den Boden.“"
                                            },
                                            {
                                                "example_id": "ba3af8a6-4043-4c04-bb6a-f464f569ddce",
                                                "sense_id": "0b516227-931f-3c67-bfb4-09bf9b21aa71",
                                                "text": "„Vor einem Tisch, der vollgeräumt war mit Farben, Tuben, Pinseln, vollen Aschenbechern und Flaschen, saß Reynaldo Pereira.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "087e09e7-21b8-3e66-8ab5-88ffe989cacb",
                                        "entry_id": "8652313a-1527-38d7-ac62-9a6ba9a8c79e",
                                        "glosses": [
                                            "einfältiger, dummer Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "907fbb0c-6068-4351-ab9e-249447b9a7ff",
                                                "sense_id": "087e09e7-21b8-3e66-8ab5-88ffe989cacb",
                                                "text": "Was hast du dir denn da für einen Pinsel angelacht?"
                                            },
                                            {
                                                "example_id": "7beda6b9-4feb-4ba6-8114-43be83a8ca7a",
                                                "sense_id": "087e09e7-21b8-3e66-8ab5-88ffe989cacb",
                                                "text": "Der Pinsel hätte gestern mehr als eine Ohrfeige verdient. (frei nach Lessing)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
