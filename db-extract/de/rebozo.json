                        "glosses": [
                            "mexikanisches Kleidungsstück für Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "882b43ee-9de6-470f-bb18-bf5d58ec6baf",
                                "sense_id": "f9633315-09e1-3740-8f56-6b900dfb3258",
                                "text": "„Schon schlossen sich Kinder ihm an, dann älteres Volk, schließlich ein Schwarm von braunhäutigen Dörflern, alle in weißer Baumwolle, wie Aufseher in einer Anstalt, Zigarillos rauchend, die Frauen mit dunklen Rebozos, einige mit entblößter Brust, die Gesichter voll roter Almagraflecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
