                "senses": [
                    {
                        "sense_id": "973a7988-c5e0-33f3-a2b6-ffe9e755dfd0",
                        "entry_id": "98e64d00-ffc4-362c-b3cd-c9955a7712b7",
                        "glosses": [
                            "nicht hinterfragt, ohne hinterfragt zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c35c65a-1e3d-40c2-b12a-fd024f4213bc",
                                "sense_id": "973a7988-c5e0-33f3-a2b6-ffe9e755dfd0",
                                "text": "„Erst um 1990 ging die Wissenschaft ganz selbstverständlich davon aus, dass diese Behauptung unzutreffend war und die Indigenen nicht einfach Glaubensüberzeugungen, die seit Generationen lebendig waren, aufgegeben und christliche Lehren unhinterfragt übernommen hatten.“"
                            },
                            {
                                "example_id": "a6d60423-456a-4359-b782-73d74d062c37",
                                "sense_id": "973a7988-c5e0-33f3-a2b6-ffe9e755dfd0",
                                "text": "„‹Das ist eine der unhinterfragten Prämissen, mit denen wir arbeiten, falls Ihnen das noch nicht aufgefallen ist.›“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
