                    "frequency": "High",
                    "semantic_group_id": "disassembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to take the old clock <w>apart</w> to see how it worked.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>разобрать</w> старые часы, чтобы посмотреть, как они устроены.",
                                "pl": "Postanowił <w>rozebrać</w> stary zegar na części, aby zobaczyć, jak działa.",
                                "tr": "Nasıl çalıştığını görmek için eski saati <w>parçalarına</w> ayırmaya karar verdi."
                            }
                        },
                        {
                            "text": "The engine fell <w>apart</w> after years of neglect and poor maintenance.",
                            "target_lang_translations": {
                                "ru": "Двигатель <w>развалился на части</w> после многих лет небрежного обращения и плохого обслуживания.",
                                "pl": "Silnik <w>rozpadł się</w> na części po latach zaniedbań i złej konserwacji.",
                                "tr": "Yıllarca ilgilenilmedikten ve kötü bakımdan sonra motor <w>parça parça oldu</w>."
                            }
