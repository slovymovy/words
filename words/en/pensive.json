{
    "word_family": [
        "pensiveness",
        "pensively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d796349-0284-3d61-b4d7-aa0b487cf039",
                    "sense_definition": "Engaged in, involving, or reflecting deep or serious thought.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thoughtful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat in a <w>pensive</w> mood while staring out the window at the rain.",
                            "target_lang_translations": {
                                "cs": "Seděla v <w>zamyšlené</w> náladě a dívala se z okna na déšť."
                            }
                        },
                        {
                            "text": "The professor gave a <w>pensive</w> look before answering the difficult question.",
                            "target_lang_translations": {
                                "cs": "Profesor se <w>zamyšleně</w> podíval, než odpověděl na obtížnou otázku."
                            }
                        }
                    ],
                    "synonyms": [
                        "thoughtful",
                        "contemplative",
                        "reflective"
                    ],
                    "antonyms": [
                        "thoughtless",
                        "vacant"
                    ],
                    "common_phrases": [
                        "pensive mood",
                        "pensive look"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ponořený do hlubokého nebo vážného přemýšlení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zamyšlený",
                                "target_lang_sense_clarification": "obecně vyjadřující stav hlubokého přemýšlení"
                            },
                            {
                                "target_lang_word": "zahloubaný",
                                "target_lang_sense_clarification": "vyjadřující intenzivní soustředění na myšlenky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f7173f5-2297-3b5a-adb4-9439bdcfb79c",
                    "sense_definition": "Having the appearance of deep, often melancholic, thinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thoughtful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>pensive</w> expression that suggested he was missing his home.",
                            "target_lang_translations": {
                                "cs": "Měl <w>zadumaný</w> výraz, který naznačoval, že se mu stýská po domově."
                            }
                        },
                        {
                            "text": "The artist captured a <w>pensive</w> silence in her portrait of the lonely man.",
                            "target_lang_translations": {
                                "cs": "Umělkyně zachytila <w>zádumčivé</w> ticho ve svém portrétu osamělého muže."
                            }
                        }
                    ],
                    "synonyms": [
                        "wistful",
                        "melancholy"
                    ],
                    "common_phrases": [
                        "pensive expression",
                        "pensive silence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vypadající jako někdo, kdo je hluboce zamyšlený, často s nádechem melancholie."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zadumaný",
                                "target_lang_sense_clarification": "působící dojmem hlubokého, často smutného přemýšlení"
                            },
                            {
                                "target_lang_word": "zádumčivý",
                                "target_lang_sense_clarification": "mající sklon k melancholickému přemýšlení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e91f50-8776-3714-bb7e-565500a64c87",
                    "sense_definition": "Looking thoughtful, especially from sadness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "thoughtful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child sat alone with a <w>pensive</w> face after losing his favorite toy.",
                            "target_lang_translations": {
                                "cs": "Dítě sedělo samo se <w>zadumanou</w> tváří poté, co ztratilo svou oblíbenou hračku."
                            }
                        },
                        {
                            "text": "She remained in a <w>pensive</w> state throughout the long and difficult funeral.",
                            "target_lang_translations": {
                                "cs": "Během celého dlouhého a těžkého pohřbu zůstala v <w>zádumčivém</w> stavu."
                            }
                        }
                    ],
                    "synonyms": [
                        "somber",
                        "brooding"
                    ],
                    "common_phrases": [
                        "pensive face",
                        "pensive state"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vypadající zamyšleně, zejména v důsledku smutku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zadumaný",
                                "target_lang_sense_clarification": "vyjadřující smutný nebo vážný výraz tváře"
                            },
                            {
                                "target_lang_word": "zádumčivý",
                                "target_lang_sense_clarification": "působící smutně a uzavřeně do sebe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}