                        "glosses": [
                            "badacz zajmujący się opisaniem ewolucji człowieka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a1cbdb-894a-4752-827f-b157af338355",
                                "sense_id": "5e98f60f-c9a7-33f8-8ccd-b7590a939b96",
                                "text": "Teraz paleoantropologom z Republiki Południowej Afryki i Szwecji udało się ponownie przesunąć wiek homo sapiens i to aż o 170 tysięcy lat"
                            }
