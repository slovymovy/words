                                        "sense_id": "183714b7-afcc-3b82-b7b6-e10018edec87",
                                        "entry_id": "981ffa10-31fc-3a3b-b00e-13f154af2398",
                                        "glosses": [
                                            "A research rating that measures how the rational and emotional elements of a commercial affect consumer intention to consider, visit, or buy something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f4369d-630d-49e0-b5c2-59d866c44f96",
                                                "sense_id": "183714b7-afcc-3b82-b7b6-e10018edec87",
                                                "text": "The motivation scores showed that 65% of people wanted to visit our website to learn more about the offer after watching the commercial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e12623cc-c4d0-4866-951c-b3685a64b338",
                        "source_entry_id": "24e57815-a5fb-3cb5-8218-7386584919a3",
                        "target_lang_word": "motivation",
