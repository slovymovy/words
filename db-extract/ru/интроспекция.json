                                        "sense_id": "a54d41fe-4a8d-3e0a-8e3c-5f2891b54afe",
                                        "entry_id": "cb5b06ed-7620-3dd1-b649-dc3e809cf45a",
                                        "glosses": [
                                            "Clipping of type introspection."
                                        ],
