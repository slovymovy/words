                        "sense_id": "98d5cac5-32a1-34fd-917b-bf3ad83362b7",
                        "entry_id": "66c73c37-2c96-37e5-ab37-a1238c9609d2",
                        "glosses": [
                            "The further distribution of something received or purchased."
                        ],
                        "tags": [
