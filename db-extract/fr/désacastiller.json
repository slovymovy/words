                "senses": [
                    {
                        "sense_id": "2509ccff-96ba-3ba8-b880-be4be221c7e9",
                        "entry_id": "288a15dc-aad2-397a-8d43-1c6c18441a62",
                        "glosses": [
                            "Enlever ses parties non structurelles à (normalement, un bateau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84dae5ee-ee9a-41aa-a451-9d2c35382ab0",
                                "sense_id": "2509ccff-96ba-3ba8-b880-be4be221c7e9",
                                "text": "D'autres me disent qu'il faut absolument sabler le bateau, ce qui implique de tout désacastiller et de remplacer les panneaux de pont par des planches de CP."
                            },
                            {
                                "example_id": "94110511-9b36-4da9-8296-bd0b03bf740f",
                                "sense_id": "2509ccff-96ba-3ba8-b880-be4be221c7e9",
                                "text": "Etape 1 : tout désacastiller ; compter une journée complète, à 2 bien sûr – avec idéalement un 2e pas trop grand et pas claustrophobe."
                            },
                            {
                                "example_id": "697929ae-bf24-4c4d-b622-0bafce222fda",
                                "sense_id": "2509ccff-96ba-3ba8-b880-be4be221c7e9",
                                "text": "Pour avoir un bon résultat: ponce ton manche (démonté et désacastillé) au 320 jusqu'à arriver au bois."
                            }
                        ]
                    }
