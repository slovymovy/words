                                        "glosses": [
                                            "Département français de la région Normandie, qui porte le numéro 27."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6e0c12-5f89-4fd6-9c11-d569a47d673a",
                                                "sense_id": "a42c78e6-83a2-3fd6-836f-f8171626bc73",
                                                "text": "Ainsi Le Chesne-Populeux (Ardennes) et La Chapelle-Gauthier (Eure) qui vénèrent au premier chef saint Martin dans un cas et Notre-Dame dans l’autre, avouent saint Jacques pour patron."
                                            },
                                            {
                                                "example_id": "06e0b77a-49d3-40d8-9b54-6ec6220dd85b",
                                                "sense_id": "a42c78e6-83a2-3fd6-836f-f8171626bc73",
                                                "text": "Le groupe est mené au siège de la 3ᵉ légion de gendarmerie à Rouen, où l’on regroupe tous les Juifs arrêtés dans l’Eure lors de la rafle du 13 juillet."
                                            }
                                        ]
