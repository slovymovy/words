                        "source_entry_id": "4549653d-7457-32a6-8e10-203682d56bbc",
                        "source_sense_id": "3bd5304c-134c-3a0f-bd02-73d47b8edcb0",
                        "source_sense_description": "Blaulicht, Rundumlicht",
                        "target_lang_word": "Blaulicht",
