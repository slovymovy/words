                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70bbce1b-0e99-3969-b6c5-914d1da496b3",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Fil délié, petit fil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b3428e7-4e3f-3b15-8744-15e06c25f011",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Technique de couture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2819d13d-0b12-47cf-8880-5ad2a32c7bb2",
                                                "sense_id": "9b3428e7-4e3f-3b15-8744-15e06c25f011",
                                                "text": "Elle est en train de se confectionner au filet le manteau le plus adorables que vous puissiez imaginer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Maillage de cordes ou de fils destiné à empêcher le passage ou à capturer des objets de taille supérieure aux mailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78441c8-0bd7-4ebf-9dff-2f23e49aedbc",
                                                "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                                "text": "« Toi, tu crois les affaires et les hommes plus grands qu’ils ne sont, et tu fais des héros, en bien ou en mal, de tous les interlocuteurs. Tu tends tes filets trop haut, comme dit Thucydide des Béotiens. » Et Lucien répéta les mots grecs que j’ignore."
                                            },
                                            {
                                                "example_id": "f610c444-d6af-417a-9395-b6247dbf937e",
                                                "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "dea05211-4fe0-4b67-8eae-12d5f5c2647b",
                                                "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                                "text": "[…], n’avait-il point remarqué une superbe truite qui se calait sous un rocher de la rive.[…]. La question se posait seulement de savoir s’il la prendrait au filet ou à la main."
                                            },
                                            {
                                                "example_id": "7b17e132-06be-451f-bb7a-c41a89f28f05",
                                                "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                                "text": "Les bêtes si méfiantes qui s'abattaient à la croûle sur les fagnes pour en extraire les vers, ne prenaient point garde aux filets tendus à plat sur le sol; elles s'y empêtraient et tous leurs efforts étaient vains. Elles ne pouvaient s'en dépêtrer ou arracher le bâtonnet qui les fixe."
                                            },
                                            {
                                                "example_id": "efea43c0-84fc-4ef0-8280-ec959d643b88",
                                                "sense_id": "510b4422-2fdd-3b5e-8618-a48c2a132699",
                                                "text": "Sport ludique et convivial, le Padel est un jeu à l'aspect familier car il emprunte sa technicité et son règlement à nombre de jeux que nous connaissons bien : le tennis dont il a hérité du filet, de la balle, et du décompte des points, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2402c2df-2510-35bb-98f9-21f610b1ef7a",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Sac en mailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527b23ab-9cdd-49aa-abd9-ab866b1c0a14",
                                                "sense_id": "2402c2df-2510-35bb-98f9-21f610b1ef7a",
                                                "text": "Tout à coup, une commère qui, un filet de provisions à la main et le visage congestionné d'émotion, absorbait, le nez en l'air, ce récit sensationnel, poussa un hurlement d'effroi, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ece941-2750-3483-82f6-3d4ae337fb39",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Usinage en forme d'hélice cylindrique sur une vis ou autre tige filetée ainsi que dans un écrou ou autre taraudage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538c0d0c-d8ef-486c-af73-8965dd4cbb92",
                                                "sense_id": "b9ece941-2750-3483-82f6-3d4ae337fb39",
                                                "text": "Les vis peuvent être à filet rond, trapézoïdal ou triangulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc2a1b4-2df5-3fd6-8284-a7b2681220c2",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Qui ressemble à un petit fil, particulièrement en parlant des petites fibres des plantes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a86679-c569-4137-b36c-d9c26cfe0945",
                                                "sense_id": "ecc2a1b4-2df5-3fd6-8284-a7b2681220c2",
                                                "text": "Cette herbe, cette racine est pleine de filets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9650e1-f0b7-3d72-97c8-fefa86a26ed2",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Partie inférieure de l’étamine qui supporte l’anthère, et qui est ordinairement plus ou moins déliée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c0cb99-b70e-44ed-8603-a7854c3bbddd",
                                                "sense_id": "ff9650e1-f0b7-3d72-97c8-fefa86a26ed2",
                                                "text": "Quant aux anthères réellement unilobées, il est évident qu'elles s'ouvrent par une seule fente, qui, bien que longitudinale, paraît transversale, si cette anthère est, comme cela arrive fréquemment dans ce cas, renversée sur le dos à l'extrémité du filet."
                                            },
                                            {
                                                "example_id": "4f319911-cd7c-4fe3-b296-7c006854bfd8",
                                                "sense_id": "ff9650e1-f0b7-3d72-97c8-fefa86a26ed2",
                                                "text": "Les filets de cette fleur sont velus. Filets plus longs que le tube de la corolle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c5b3789-44d2-3fc8-8fc0-7135baa09ef2",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Ramifications les plus ténues des nerfs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a44ab53-2819-4c34-908f-cf550ee714ca",
                                                "sense_id": "6c5b3789-44d2-3fc8-8fc0-7135baa09ef2",
                                                "text": "Les filets nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a19065-f1e9-30fe-8ef3-68ca347d7fdb",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Pli membraneux qui est sous la langue et qui en règle les mouvements."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf874b5-968d-4aca-811e-65a21203906e",
                                                "sense_id": "24a19065-f1e9-30fe-8ef3-68ca347d7fdb",
                                                "text": "Faire l’opération d'entailler le filet d'un nouveau-né pour le libérer d’un handicap de succion dû à un filet de langue trop court."
                                            },
                                            {
                                                "example_id": "d5175b39-d68f-4e24-b588-72739187922c",
                                                "sense_id": "24a19065-f1e9-30fe-8ef3-68ca347d7fdb",
                                                "text": "Couper le filet : Empêcher de parler."
                                            },
                                            {
                                                "example_id": "96326749-9c7e-4960-8231-496fccd13362",
                                                "sense_id": "24a19065-f1e9-30fe-8ef3-68ca347d7fdb",
                                                "text": "Cette réponse inattendue lui a coupé le filet. → voir couper le sifflet"
                                            },
                                            {
                                                "example_id": "540d4305-f8e9-4cb6-9019-f5ad13eedad8",
                                                "sense_id": "24a19065-f1e9-30fe-8ef3-68ca347d7fdb",
                                                "text": "Il a le filet bien coupé : Il est bavard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Se dit de certains ornements linéaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3a3846-e134-4ae8-bea4-8988f8ba8dfa",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "La façade était peinte en blanc et les arêtes de la corniche se rehaussaient d'un filet rouge qui en accentuait le profil."
                                            },
                                            {
                                                "example_id": "81d68f6f-2940-4043-a404-2511fa798101",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "Couverts d’argent à filets."
                                            },
                                            {
                                                "example_id": "e8681e7d-ddc4-4412-8d7d-e8a641f60d65",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "Faire un filet sur le bord de la couverture d’un livre."
                                            },
                                            {
                                                "example_id": "720a826e-025c-4be2-b598-4ae3f1abfa99",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "Reliure de veau avec filets."
                                            },
                                            {
                                                "example_id": "1d814914-4d76-44c2-bcee-916dfb08dbb4",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "Orner une pièce de serrurerie d’un filet en relief."
                                            },
                                            {
                                                "example_id": "0d90cd0c-5665-48b6-90fd-abab1b38849d",
                                                "sense_id": "4bced9b5-89b2-36ad-affb-ebd0f156402f",
                                                "text": "Cette moulure est accompagnée d’un filet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9ba774b-702d-37bf-b71d-b70ae8479a45",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Zone libre de texte entre deux colonnes imprimées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb065754-3126-3f61-9c21-02724790df08",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Se dit de certains traits qui ont diverses formes et divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1082b1-31c8-40b5-9b24-4b641150b4d1",
                                                "sense_id": "bb065754-3126-3f61-9c21-02724790df08",
                                                "text": "Mettre un filet au-dessous d’un titre."
                                            },
                                            {
                                                "example_id": "18245e3f-7718-4a94-80bf-939ed08ba8ea",
                                                "sense_id": "bb065754-3126-3f61-9c21-02724790df08",
                                                "text": "Filet double."
                                            },
                                            {
                                                "example_id": "0fcd62c2-0032-4726-a522-a2e4a9644932",
                                                "sense_id": "bb065754-3126-3f61-9c21-02724790df08",
                                                "text": "Filet maigre."
                                            },
                                            {
                                                "example_id": "2d53278b-8fcb-4c5e-98b6-fd1d08590a5b",
                                                "sense_id": "bb065754-3126-3f61-9c21-02724790df08",
                                                "text": "Le lendemain, les nombreux abonnés d’un journal libéral lurent dans les premiers-Paris un article entre filets, inséré d’autorité par Chaboisseau et Métivier, actionnaires dans deux journaux, escompteurs de la librairie, de l’imprimerie, de la papeterie, et à qui nul rédacteur ne pouvait rien refuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e230f6e-70d2-3415-b157-dbc5f37457d7",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Lames de métal qui servent à imprimer ces sortes de traits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21668704-b74d-4355-bb9c-d8257c076117",
                                                "sense_id": "0e230f6e-70d2-3415-b157-dbc5f37457d7",
                                                "text": "Filets d’acier, filets de cuivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f03a4a-848a-304f-9554-58dba9196995",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Liquide coulant en petite quantité mais sans interruption."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00b5d56-7517-4c75-b406-9573d189e4e8",
                                                "sense_id": "a3f03a4a-848a-304f-9554-58dba9196995",
                                                "text": "Ajoutez un généreux filet d’huile d’olive, un petit de citron, une pincée de fleur de sel, une de sumac, et parsemez le plat de quelques feuilles de coriandre."
                                            },
                                            {
                                                "example_id": "76c6f63c-3a04-479d-a872-206154ea10d4",
                                                "sense_id": "a3f03a4a-848a-304f-9554-58dba9196995",
                                                "text": "On traverse l'oued Isten, il contient du berdi (roseau) en abondance, et a un tout petit filet d'eau. On campe à 9 h 30 devant Idelès."
                                            },
                                            {
                                                "example_id": "11d7f589-108a-468e-baa5-394636280c96",
                                                "sense_id": "a3f03a4a-848a-304f-9554-58dba9196995",
                                                "text": "Les enfants courant entre les jambes de grand-maman pendant que grand-papa ronfle sur sa chaise, un filet de salive au coin des lèvres ?"
                                            },
                                            {
                                                "example_id": "40c5023a-edbf-416e-905e-f99d327b39b4",
                                                "sense_id": "a3f03a4a-848a-304f-9554-58dba9196995",
                                                "text": "Le plastron de sa chemise portait la trace séchée d'un filet de vodka."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb8143b-e272-3305-9822-740cb808b020",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "La partie charnue qui est le long de l’épine dorsale de quelques animaux ; on ne l’appelle ainsi que quand ces animaux ont été dépecés pour être mangés."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9824db-4b97-44b3-964d-46510ad51c7e",
                                                "sense_id": "2eb8143b-e272-3305-9822-740cb808b020",
                                                "text": "La viande, qui doit se révéler un peu ferme, provient souvent de tranche grasse, de rond de gîte, de gîte à la noix, mais les rosbifs aristocratiques peuvent être taillés dans le filet, le faux-filet ou le romsteck."
                                            },
                                            {
                                                "example_id": "91dc73dd-4b89-42f3-ac6c-fbf38c520bcb",
                                                "sense_id": "2eb8143b-e272-3305-9822-740cb808b020",
                                                "text": "— Il s'adressa au cuistot :\n— Je prends un guéridon, tu m'enverras des filets d’harengs pour commencer, une double saucisse-frites, un calendo, un kil, et que ça saute."
                                            },
                                            {
                                                "example_id": "e084cb7c-e249-42f8-bcef-46cd8e701024",
                                                "sense_id": "2eb8143b-e272-3305-9822-740cb808b020",
                                                "text": "Mettez les filets de haddock dans un plat creux, versez le lait par-dessus et laissez tremper pendant 30 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59de8e1c-1f60-34d6-910b-458d20e01ca5",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Embouchure, bride. Il est souvent composé d’une muserolle, d’une sous-gorge, de montants et de rênes : il sert à diriger le cheval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "053698d5-30e7-319d-9d74-1d08b9f845ee",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Baguette moulurée en bois utilisée pour la couverture des joints."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0b093b3-f720-3279-9f53-80216db41002",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Moulure rectangulaire située soit le long d'une moulure plus importante, soit entre deux moulures, on le trouve généralement sur des façades."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "953aafbb-04a2-31af-bd05-23f6fd911bd0",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Rejeton d’une plante qui s’allonge en tige rampante sur le sol; stolon."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa19f89-75fc-4808-8406-6c5126eb5f81",
                                                "sense_id": "953aafbb-04a2-31af-bd05-23f6fd911bd0",
                                                "text": "La culture potagère fournit un remarquable exemple de marcottage dans la multiplication du fraisier par filets, coulants ou stolons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693962d7-13f2-3bfc-b3e1-efb99ea0c632",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Rectrice externe allongée, comme chez l'hirondelle rustique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3aa122fb-e9c0-3e7d-9ed4-67c85e27e557",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Bande plus fine que la cotice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d4f940a-1bfa-31a1-bd88-366ad9df3a1b",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Trait d'épaisseur donnée faisant partie du cadre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1234430-fcda-3878-9bc3-fb15f9a57d2a",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Ensemble d'une ou de plusieurs poutrelles métallique utilisé pour renforcer un plancher ou le linteau d'une ouverture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ca189a5-6708-3ac3-bc1a-d91838d5aa7d",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Bandeau réalisé en mortier pour parfaire l'étanchéité entre le rang supérieur du toit d'une ferme en appentis et un mur"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "caf5c7a8-2b0c-3e95-86c5-331e6d8edef2",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Technique de chasse, de braconnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e098ffa-10f4-4b56-9281-334399ae0338",
                                                "sense_id": "caf5c7a8-2b0c-3e95-86c5-331e6d8edef2",
                                                "text": "Chacun sa préférence ; la mienne c'est le filet : tu t'amènes tout à la douce, tu tends, tu rabats les lapins, tu les récoltes, et en route !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0002f937-3dc7-3738-9b88-4c5287136b42",
                                        "entry_id": "d7ff1a0c-c5b6-37bf-a2d7-9808c10c72a8",
                                        "glosses": [
                                            "Le but de chaque équipe, lors d’une partie de hockey."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b75fac-e349-411e-9527-f0e7f0d79dd8",
                                                "sense_id": "0002f937-3dc7-3738-9b88-4c5287136b42",
                                                "text": "Mais ce filet du défenseur russe a causé tout un émoi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "filet",
