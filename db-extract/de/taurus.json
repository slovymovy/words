                ],
                "senses": [
                    {
                        "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                        "entry_id": "ae6a33a1-ea05-3cba-b53b-055f1e815f7d",
                        "glosses": [
                            "Gebirge im Süden der Türkei, das vom Euphrat westwärts bis an das Ägäische Meer mit einer Länge von 1.500 Kilometer reicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "606d65a0-a14c-421b-b8c2-b4ea2b9331a8",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Direkt hinter der Küste wird es felsig und es finden sich die ersten Ausläufer des Taurus."
                            },
                            {
                                "example_id": "39a4402d-0cac-46d0-9422-d83f70659255",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Dabei aber mußte Alexander bis hoch in die Schneeregionen die Pässe des Taurus, des Kolossalgebirges, überschreiten, das dort parallel der Südküste läuft, und zwar im Winter."
                            },
                            {
                                "example_id": "f981f3ab-7e04-4720-b260-2b40cb374c58",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Der Transport geriet in Verwirrung, in ein fluchtartiges Laufen, das sich erst beruhigte, als der Tote schon weit zurückgeblieben war und die Raubvögel des Taurus näher kreisten."
                            },
                            {
                                "example_id": "a72ec86d-6a44-4f3e-9576-14961f642aaa",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Akra war neu befestigt worden; die Pässe des Taurus waren wohl bewacht; an der äußersten Gränze standen ein Regiment Infanterie und ein Regiment Cavallerie, zu Aleppo 3 Infanterieregimenter mit einem Artilleriepark von 36 Kanonen."
                            },
                            {
                                "example_id": "4076e482-b6d8-4f6b-92da-ec878a300f83",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Vom Emli-Tal aus führt die nächste Etappe in die Aladaglar-Region, den höchsten Gebirgszug des Taurus östlich von Nigde."
                            },
                            {
                                "example_id": "54dae62a-7088-4717-85da-49f2f8e81015",
                                "sense_id": "11da78e0-3736-3c64-87a1-0ea544d99da4",
                                "text": "Nach einem langen Anstieg eröffnet sich vom 3.916 m hohen Berg ein herrlicher Fernblick auf die Höhenzüge des Taurus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
