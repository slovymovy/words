                "senses": [
                    {
                        "sense_id": "7d75d7ed-e702-37c0-a3ed-30980a1e70c1",
                        "entry_id": "fcb4dbad-b70e-3f0e-b933-688f7bc35c6a",
                        "glosses": [
                            "Stadtteil von London"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a668f97-2aa0-43ce-9b3a-46cedbf71dd4",
                                "sense_id": "7d75d7ed-e702-37c0-a3ed-30980a1e70c1",
                                "text": "„Perkins eilte mit gesenktem Kopf quer über den Rasen des Hyde Park - in einem raschen Schritt, der fast ein Laufen war, so wie er fast jeden Tag von seinem Wohnhaus in Knightsbridge in sein Büro in Mayfair ging.“"
                            },
                            {
                                "example_id": "23d1626e-cd98-4373-9da7-4bfebecc0df8",
                                "sense_id": "7d75d7ed-e702-37c0-a3ed-30980a1e70c1",
                                "text": "„Zack nannte ihr laut die Straßennamen, die an ihm vorbeihuschten, und als der Van links abbog, meldete er Brewer, dass sie nun in den Stadtteil Knightsbridge hineinfuhren.“"
                            },
                            {
                                "example_id": "0adcfc71-0387-4557-ac72-b00b744e175e",
                                "sense_id": "7d75d7ed-e702-37c0-a3ed-30980a1e70c1",
                                "text": "„In Knightsbridge fiel ein kalter Oktoberregen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
