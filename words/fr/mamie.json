                            "text": "Une gentille <w>mamie</w> m'a demandé de l'aider à traverser la rue.",
                            "target_lang_translations": {
                                "en": "A kind <w>granny</w> asked me to help her cross the street.",
                                "ru": "Одна добрая <w>старушка</w> попросила меня помочь ей перейти улицу.",
                                "nl": "Een aardige <w>oma</w> vroeg me haar te helpen de straat over te steken.",
                                "de": "Eine nette <w>Oma</w> bat mich, ihr beim Überqueren der Straße zu helfen.",
                                "pl": "Jakaś miła <w>staruszka</w> poprosiła mnie o pomoc przy przejściu przez ulicę.",
                                "it": "Una gentile <w>vecchietta</w> mi ha chiesto di aiutarla ad attraversare la strada.",
                                "cs": "Jedna laskavá <w>stařenka</w> mě požádala o pomoc při přecházení ulice.",
                                "tr": "Nazik bir <w>teyze</w> caddeyi karşıya geçmesine yardım etmemi istedi.",
                                "es": "Una <w>viejecita</w> amable me pidió que la ayudara a cruzar la calle.",
                                "zh": "一位和善的<w>老太太</w>请我帮她过马路。"
                            }
                        },
                        {
                            "text": "Cette petite <w>mamie</w> promène son chien dans le parc tous les matins.",
                            "target_lang_translations": {
                                "en": "This little <w>granny</w> walks her dog in the park every morning.",
                                "ru": "Эта маленькая <w>старушка</w> каждое утро выгуливает собаку в парке.",
                                "nl": "Dit kleine <w>oudje</w> laat elke ochtend haar hond in het park uit.",
                                "de": "Diese kleine <w>Oma</w> führt jeden Morgen ihren Hund im Park Gassi.",
                                "pl": "Ta drobna <w>staruszka</w> co rano wyprowadza psa na spacer do parku.",
                                "it": "Questa piccola <w>vecchietta</w> porta a spasso il suo cane nel parco ogni mattina.",
                                "cs": "Ta malá <w>stařenka</w> každé ráno venčí svého psa v parku.",
                                "tr": "Bu küçük boylu <w>teyze</w> her sabah parkta köpeğini gezdiriyor.",
                                "es": "Esta <w>viejecita</w> bajita pasea a su perro por el parque todas las mañanas.",
                                "zh": "这位个子不高的<w>老太太</w>每天早上都在公园里遛狗。"
                            }
