                                        "glosses": [
                                            "Art d’imprimer avec des caractères de bois, ou avec des planchettes de bois dans lesquelles sont taillées les lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ca9f25-f844-47b4-9990-7105c3caf979",
                                                "sense_id": "8a9062b1-f721-3326-98d6-fafc91dd48be",
                                                "text": "La xylographie, qui a précédé l’imprimerie typographique, a surtout été en usage au quinzième siècle et au seizième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c9905c-6898-3d9f-94ec-43d541aa8b86",
                                        "entry_id": "35708e46-8662-3ac7-8d1b-3c94e988793e",
                                        "glosses": [
                                            "Épreuve de gravure sur bois, estampe xylographique."
                                        ],
