        "fr-extract.jsonl": [
            {
                "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                "word": "louable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1192688e-4779-4ab7-9feb-7c7fd829fa0b",
                        "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "louables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                        "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                        "glosses": [
                            "Qui est digne de louange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e96a4f-5abc-4703-9950-d999a93cea44",
                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                "text": "Le Danemark, avec le souci le plus louable de la santé physique et morale de ses sujets, interdit absolument l'importation de l'alcool au Groenland."
                            },
                            {
                                "example_id": "e7469c55-3521-4f68-a0c8-10a948b8de71",
                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                "text": "Le département fait de louables efforts pour créer un dispensaire antituberculeux. Il organise l'inspection des écoles."
                            },
                            {
                                "example_id": "395400e4-6881-474b-b1e4-cfaeb4285e6d",
                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                "text": "Il est évident que ces réformes sont fort louables, mais elles sont loin d’être acceptées avec enthousiasme: […] ; et les lettrés les considèrent comme un attentat sacrilège contre les traditions koraniques."
                            },
                            {
                                "example_id": "d4e9fb39-ca34-4257-9d0c-92e9c5bb4a5d",
                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                "text": "\"Les contraintes sont décuplées par les mesures strictes prises par les provinces de l’Atlantique qui ont été imposées avec une intention de protéger leur population, ce qui est certainement louable, mais qui n’avaient pas à aller aussi loin pour obtenir les mêmes résultats\", estime Joël Arseneau."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d6184b1-5b7c-3cc2-b1c5-a23da12a6ea5",
                        "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                        "glosses": [
                            "Qui peut être loué, moyennant loyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644ef0a8-7876-457c-ab46-047bdafcb84b",
                                "sense_id": "6d6184b1-5b7c-3cc2-b1c5-a23da12a6ea5",
                                "text": "[…], mais si tu voulais louer ou revendre ton bien après rapetassage, alors j'avais tout au contraire à multiplier ses espaces en les cloisonnant dans tous les sens je réformais un bon gros et bien vieil appartement pour obtenir les deux ou trois petits immédiatement louables ou vendables, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69a112d2-53bb-42e2-8d56-913a122441ff",
                        "source_entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                        "source_sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                        "source_sense_description": "Qui est digne de louange.",
                        "target_lang_word": "löblich",
                        "target_lang_code": "de",
