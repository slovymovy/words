                        ],
                        "examples": [
                            {
                                "example_id": "a25d4c66-0577-4fcb-842c-98eae1daee84",
                                "sense_id": "854cefb3-43f1-3d38-95ba-897eb9ab8bbc",
                                "text": "I'd just as soon goldbrick with malaria as with anything else."
                            },
                            {
                                "example_id": "8213824d-3afb-4e5a-bca2-a683195e50f7",
                                "sense_id": "854cefb3-43f1-3d38-95ba-897eb9ab8bbc",
                                "text": "He learned to despise the Germans, people he once thought fit to rule the world, but now so craven they ate French dirt for a glass of cheap campagne; he mastered the art of goldbricking. Sitting at his desk, bored and full of hate, he got fat and dreamed of Paris."
                            }
                        ]
                    },
