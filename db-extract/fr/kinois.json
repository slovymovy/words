                                    {
                                        "sense_id": "c9d58984-04ce-30a4-9b3c-324cd60c4481",
                                        "entry_id": "4327e5c7-dc3e-3b57-92bd-7e513df4e4a4",
                                        "glosses": [
                                            "A native or inhabitant of Kinshasa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64325b75-2cf1-4b7f-a235-5836a445a94b",
                                                "sense_id": "c9d58984-04ce-30a4-9b3c-324cd60c4481",
                                                "text": "This initiative gave birth to an urban movement, the […] SAPE: a way of expressing an identity that was antipoverty, antidepression, and antipower (because it opposed the abas-cost, the uniform imposed by Mobutu) for thousands of young Kinshasans, as well as for Brazzavillians on the other side of the Congo River."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
