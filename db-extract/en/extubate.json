                                        "sense_id": "d844c3d1-6806-3553-b340-0d5b7923b85d",
                                        "entry_id": "0fd2cbfa-2b32-3e46-be3c-999deccd214d",
                                        "glosses": [
                                            "Retirer le tube inséré dans la trachée d’un patient pour lui permettre de respirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324a0331-3a21-47b0-ab95-ad2b8565c2d2",
                                                "sense_id": "d844c3d1-6806-3553-b340-0d5b7923b85d",
                                                "text": "On devra constamment réévaluer qui peut bénéficier des respirateurs, et qui sera « extubé ».\n « Les patients COVID aux soins intensifs nécessitent trois ou quatre semaines de ventilation mécanique », dit Joseph Dahine, médecin intensiviste."
                                            },
                                            {
                                                "example_id": "4bfcd780-cbc4-4468-b6f3-286affbe0732",
                                                "sense_id": "d844c3d1-6806-3553-b340-0d5b7923b85d",
                                                "text": "Il faut l’extuber."
                                            },
                                            {
                                                "example_id": "c8b80e6d-32b9-44c8-9f65-45f2706c22c9",
                                                "sense_id": "d844c3d1-6806-3553-b340-0d5b7923b85d",
                                                "text": "Sa respiration est redevenue autonome et il a pu être extubé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff72b63-ef38-4b81-aa52-fb5e68987852",
                        "source_entry_id": "0c1cffb8-2272-3f38-a40c-72ec16a96951",
                        "source_sense_id": "4ba0e8e2-56e2-3a18-8ebc-766c6e0acad8",
