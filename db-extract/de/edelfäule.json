                        "sense_id": "176a367d-d891-3386-a88a-0406030f3406",
                        "entry_id": "eea660c8-6ac3-30cd-85d7-e0e118c1ea63",
                        "glosses": [
                            "eine gewünschte, durch den Pilz Botrytis cinerea verursachte Traubenfäule, bei der die Traubenschalen schrumpeln und der Saft in der Beere sich konzentriert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08488bc4-a758-40b0-a945-eb1f38412faf",
                                "sense_id": "176a367d-d891-3386-a88a-0406030f3406",
                                "text": "Bei der Edelfäule durchwächst der Grauschimmel die Beerenhaut, macht sie porös, wodurch der Wassergehalt der Beeren verdunstet, so dass die Traube einschrumpft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
