                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aae2abc-8d4c-352c-b67f-b975145d2faf",
                                        "entry_id": "16c0fa8b-57ef-3d86-9a6a-441a0e21a8a1",
                                        "glosses": [
                                            "Celui qui affronte le taureau lors d'une corrida, qu'il soit matador ou membre de la cuadrilla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1afaff7-fd20-46c9-956a-e7cbe6d44f65",
                                                "sense_id": "4aae2abc-8d4c-352c-b67f-b975145d2faf",
                                                "text": "A terre, le célèbre toréro Juan José Padilla a eu peur pour sa vie. Pendant une corrida dans les arènes d'Arevalo (Espagne) samedi, il a été déséquilibré par un taureau, qui lui a foncé dessus alors qu'il était au sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "270c748b-58c4-45f2-931f-959599a5c2cb",
                        "source_entry_id": "defc64d8-6598-3119-8cc8-11c4ce24b49e",
                        "source_sense_id": "6dad3a30-b7b9-3440-8fec-18de940011e7",
                        "source_sense_description": "a toreador or matador",
                        "target_lang_word": "toréador",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toréador",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a03daf8-da17-309b-a516-b1f4f46c7b75",
                                        "entry_id": "b57e30c4-4c0f-3925-8d2d-c23147882e2f",
                                        "glosses": [
                                            "Celui qui combat les taureaux dans les courses publiques, toréro (terme qui le supplante)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507d28dc-299c-42df-9788-ed1ab4d4a74e",
                                                "sense_id": "7a03daf8-da17-309b-a516-b1f4f46c7b75",
                                                "text": "Toréador, en garde !\nEt songe en combattant\nQu’un œil noir te regarde\nEt que l’amour t’attend."
                                            },
                                            {
                                                "example_id": "e39cfa56-15f8-4dd0-a0d2-2247fd118c66",
                                                "sense_id": "7a03daf8-da17-309b-a516-b1f4f46c7b75",
                                                "text": "Car Pépita se montre assise\nOffrant son regard et son corps\nAu plus vieux doge de Venise\nEt rit du toréador."
                                            },
                                            {
                                                "example_id": "73876151-5b06-41ea-9139-7f520cd95b71",
                                                "sense_id": "7a03daf8-da17-309b-a516-b1f4f46c7b75",
                                                "text": "Les toréadors sont généralement des hommes à fesses rebondies et cela suffit à me les rendre antipathiques !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b003f09-94d4-47e6-abed-a2a112d783cf",
                        "source_entry_id": "defc64d8-6598-3119-8cc8-11c4ce24b49e",
                        "source_sense_id": "6dad3a30-b7b9-3440-8fec-18de940011e7",
                        "source_sense_description": "a toreador or matador",
                        "target_lang_word": "matador",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matador",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                                        "glosses": [
                                            "Celui qui, dans les corridas, met l’animal à mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e2afed-ac1b-46bd-b627-5fd35ec9616d",
                                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                                "text": "Un cholo ! un matador ! un homme qui boit de l’eau-de-vie et qui mange des oignons crus !"
                                            },
                                            {
                                                "example_id": "f1d5ce42-e1a1-4d84-8e37-37b553fb973b",
                                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                                "text": "On n’emploie guère en Espagne le mot matador pour désigner celui qui tue le taureau, on l’appelle espada (épée), ce qui est plus noble et a plus de caractère ; l’on ne dit pas non plus toreador, mais bien torero. Je donne, en passant, cet utile renseignement à ceux qui font de la couleur locale dans les romances et dans les opéras-comiques."
                                            },
                                            {
                                                "example_id": "ef5bb5c2-4feb-4ba7-a834-eb81e4cd046c",
                                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                                "text": "Après s'être vanté d'avoir travaillé à éteindre les lampions célestes par un geste magnifique, il se donne les allures d'un matador aux pieds duquel va tomber le taureau furieux."
                                            },
                                            {
                                                "example_id": "fc6f1336-d6ea-4d98-9a6a-87fb7329b001",
                                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                                "text": "Jusqu’alors, et depuis plus de deux mois, l’arène était restée désespérément vide, malgré la mobilisation des alguazils, picadors et autres matadors, l’arsenal accumulé aussi des piques, des banderilles et même du poignard de fer."
                                            },
                                            {
                                                "example_id": "83dfc30c-ff1c-405d-a47c-5b715460fb90",
                                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                                "text": "Le matador qui tire du danger couru l’occasion d’être plus brillant que jamais et montre toute la qualité de son style à l’instant qu’il est le plus menacé : voilà ce qui m’émerveillait, voilà ce que je voudrais être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d255f1f3-7117-314c-91c4-615f4bbc4454",
                                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                                        "glosses": [
                                            "Dans le jeu de l’hombre, désigne les cartes supérieures."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc4a353-5d60-4681-af62-21135ff30c83",
                                                "sense_id": "d255f1f3-7117-314c-91c4-615f4bbc4454",
                                                "text": "Spadille, manille et baste sont les trois premiers matadors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "713ed85e-5317-3fdf-825c-f3d1ef374e26",
                                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                                        "glosses": [
                                            "Jeu de dominos où l’on doit toujours faire sept."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "696f57ea-e12e-37a9-9e2b-fdf078ab61dd",
                                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                                        "glosses": [
                                            "Outil utilisé en abattoir pour étourdir les animaux avant la mise à mort par saignée."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
