                    {
                        "translation_id": "c2eb0ffa-b369-4ac1-97b8-4a4dc8b2d82b",
                        "source_entry_id": "a78af95c-fe45-3efb-a0ad-ce306b0bd1af",
                        "source_sense_id": "914a900b-5af6-396b-bd39-82c9ab3f450a",
                        "target_lang_word": "Epilepsie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epilepsie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1a3feef-7c81-3ca5-88d9-5e0f5e6733d0",
                                        "entry_id": "d8e0e284-7acb-3558-8fe1-fd763590fb9c",
                                        "glosses": [
                                            "Krankheit, die sich durch plötzliche Krampfanfälle kennzeichnet, die zum Bewusstseinsverlust führen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b56153-0bad-459e-99dd-bc8dc4c3cbb5",
                                                "sense_id": "c1a3feef-7c81-3ca5-88d9-5e0f5e6733d0",
                                                "text": "„In Deutschland leiden etwa 600.000 Menschen an Epilepsie, weltweit sind es 50 Millionen.“"
                                            },
                                            {
                                                "example_id": "682f92dd-389f-49f8-a176-f8a264477f90",
                                                "sense_id": "c1a3feef-7c81-3ca5-88d9-5e0f5e6733d0",
                                                "text": "Obwohl Epilepsie bei den alten Griechen als »heilige Krankheit« galt und Persönlichkeiten wie Sokrates, Julius Cäsar und Vincent van Gogh Anfälle erlitten haben sollen, kennt die Geschichte grausame Diskriminierungen."
                                            },
                                            {
                                                "example_id": "741b1925-cf47-4ced-a34b-5f096b499ab8",
                                                "sense_id": "c1a3feef-7c81-3ca5-88d9-5e0f5e6733d0",
                                                "text": "„Zu den auf diese Weise behandelten Störungen gehören die Epilepsie, zentrale Schmerzzustände, Schlaflosigkeit, Angstzustände und Depressionen, unkontrollierbare Gewalttätigkeit und einige Abarten der Schizophrenie.“"
                                            },
                                            {
                                                "example_id": "549de10a-073e-4308-881a-ac46f9a868ad",
                                                "sense_id": "c1a3feef-7c81-3ca5-88d9-5e0f5e6733d0",
                                                "text": "„Bald würden die Epilepsien der Lust ausbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
