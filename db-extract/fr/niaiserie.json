                        "target_lang_word": "domheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "789d1b61-3c26-3599-a2c5-4de43b2cc045",
                                        "entry_id": "96f4f7bd-c922-30c1-bece-d258e6b16bcd",
                                        "glosses": [
                                            "het dom zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e62ff7-f7cf-45e0-9b08-a85e0a6e9d89",
                                                "sense_id": "789d1b61-3c26-3599-a2c5-4de43b2cc045",
                                                "text": "De domheid van mannen valt soms met geen pen te beschrijven."
                                            },
                                            {
                                                "example_id": "6bfe5701-41ee-494b-83ee-0e0590bbc3d9",
                                                "sense_id": "789d1b61-3c26-3599-a2c5-4de43b2cc045",
                                                "text": "Maar dat kapitaal hadden ze daarna allemaal vastgezet op spaarrekeningen tegen 4-5 procent rente. Op een moment dat de inflatie rond de tien procent lag. Het was niet simpelweg domheid, eerder een soort conservatief snobisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c91ae4e-aa9c-3694-8fde-ca178e319dac",
                                        "entry_id": "96f4f7bd-c922-30c1-bece-d258e6b16bcd",
                                        "glosses": [
                                            "het dom doen terwijl men beter zou moeten weten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8dec90-7dad-418d-9ff0-457f5ff1e879",
                                                "sense_id": "5c91ae4e-aa9c-3694-8fde-ca178e319dac",
                                                "text": "Door haar domheid is de wasmachine stuk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67bc04e2-3c20-4532-9d48-082ef80dde44",
                        "source_entry_id": "ef7d5692-cdd7-3ac2-ae7c-fdcf3a10ae1b",
