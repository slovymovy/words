                    {
                        "translation_id": "ec0c4049-cdf9-45c7-bf87-914af4f3e117",
                        "source_entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                        "source_sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                        "source_sense_description": "Recht: vorsätzliche Tötung einer Person, bei der die Kriterien für einen Mord nicht vorliegen",
                        "target_lang_word": "meurtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meurtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f40443-51b6-3878-b2fb-148d255db86b",
                                        "entry_id": "51ff58c2-bd6d-3b12-8a08-ef53714d0e9c",
                                        "glosses": [
                                            "Homicide volontaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07555c8-bf19-4a91-93f0-c0bb62f65c2c",
                                                "sense_id": "e3f40443-51b6-3878-b2fb-148d255db86b",
                                                "text": "L’idée du meurtre inspire bien moins d’effroi lorsque la loi-même en donne l’exemple et le spectacle ; l’horreur du crime diminue dès qu’elle ne le punit plus que par un autre crime."
                                            },
                                            {
                                                "example_id": "53e66643-1a3a-4b01-9632-356a2a32769a",
                                                "sense_id": "e3f40443-51b6-3878-b2fb-148d255db86b",
                                                "text": "La loi de Lynch était fréquemment appliquée ; un homme convaincu de meurtre ou de vol pouvait se voir arrêter, juger, et… pendre, en moins d’un quart d’heure, pour peu qu’un comité de vigilance énergique s’emparât de lui."
                                            },
                                            {
                                                "example_id": "87d42030-5d77-4c98-bf35-559611a48464",
                                                "sense_id": "e3f40443-51b6-3878-b2fb-148d255db86b",
                                                "text": "Les parents d’un bébé trouvé mort dans son berceau à Bray-Saint-Aignan (Loiret) ont été mis en examen ce vendredi du chef de « meurtre d’un mineur de moins de 15 ans » et placés en détention."
                                            },
                                            {
                                                "example_id": "e1200d1d-cc6c-4055-9d7a-535e330bfd42",
                                                "sense_id": "e3f40443-51b6-3878-b2fb-148d255db86b",
                                                "text": "À la suite du terrible massacre des juifs de la péninsule ibérique, en 1391, le Call de Perpignan fut envahi, en 1392, et devint la proie du meurtre et du pillage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60fe365-1877-32b9-9f9e-5edc9e31de17",
                                        "entry_id": "51ff58c2-bd6d-3b12-8a08-ef53714d0e9c",
                                        "glosses": [
                                            "Action perçue comme dommageable ou moralement répréhensible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ea4cea-aaa0-4b84-bac3-84df36ed371b",
                                                "sense_id": "b60fe365-1877-32b9-9f9e-5edc9e31de17",
                                                "text": "Ma cousine Bette, épouser ce jeune homme-là, elle qui serait sa mère ?… Mais ce serait un meurtre !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
