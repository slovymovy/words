                "senses": [
                    {
                        "sense_id": "a33ef2b3-bdf0-3e01-9cf5-1c2a2bc50f05",
                        "entry_id": "f87f32ff-1f91-3664-8fc3-768e0faf68e4",
                        "glosses": [
                            "Strophe (Gedicht oder Lied) aus acht Zeilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9791874e-8ada-4a02-bf70-a8dc45354f62",
                                "sense_id": "a33ef2b3-bdf0-3e01-9cf5-1c2a2bc50f05",
                                "text": "„Ich hatte einen Achtzeiler in freien Versen über ein bestimmtes Thema verfaßt und brachte ihn Crébillon, damit er ihn korrigiere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
