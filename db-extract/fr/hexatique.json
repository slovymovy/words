                "senses": [
                    {
                        "sense_id": "dd8bfa7e-3b85-3c9b-a89c-534dcad929ea",
                        "entry_id": "60564431-3100-3123-902c-b66fa4be5866",
                        "glosses": [
                            "Dans une forme de cristal liquide bidimensionnel faisant preuve d’un ordre moléculaire de positionnement à courte portée, et orientationnel à longue portée."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d39173-0ea8-4cd8-a632-dd6b9eff0c21",
                                "sense_id": "dd8bfa7e-3b85-3c9b-a89c-534dcad929ea",
                                "text": "Ces îlots s’attirent eux aussi pour constituer une phase cristalline imparfaite, appelée phase hexatique et qui n’existe que dans un espace à deux dimensions."
                            },
                            {
                                "example_id": "88fbf2f4-d24e-483f-a60f-4edbaea321ea",
                                "sense_id": "dd8bfa7e-3b85-3c9b-a89c-534dcad929ea",
                                "text": "La variation de la longueur de corrélation avec la température semble être plus en accord avec le modèle d’une transition bien prononcée entre les phases avec l’ordre liquide et hexatique, qu’avec le modèle de dissociation continue des paires de dislocation."
                            }
                        ]
                    }
                ],
