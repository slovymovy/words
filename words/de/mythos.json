    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1787b980-21ee-33bb-be9d-b3c75942e2de",
                    "sense_definition": "Traditionelle, meist mündlich überlieferte Erzählung aus der Vorzeit über Götter, Helden oder die Entstehung der Welt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Schule lasen die Schüler einen alten griechischen <w>Mythos</w> über die Entstehung der Welt."
                        },
                        {
                            "text": "Viele antike <w>Mythen</w> erzählen von mächtigen Göttern, die das Schicksal der Menschen bestimmen."
                        }
                    ],
                    "synonyms": [
                        "Sage",
                        "Legende"
                    ],
                    "antonyms": [
                        "Logos"
                    ],
                    "common_phrases": [
                        "antike Mythen",
                        "griechischer Mythos"
                    ]
                },
                {
                    "sense_id": "7aac8f89-cbda-3450-adf1-842240ac0cf5",
                    "sense_definition": "Verklärung oder glorifizierende Vorstellung rund um eine Person, ein historisches Ereignis oder eine Sache",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch ihren frühen und tragischen Tod wurde die berühmte Schauspielerin endgültig zum <w>Mythos</w>."
                        },
                        {
                            "text": "Journalisten versuchten jahrelang, den <w>Mythos</w> um diesen geheimnisvollen Musiker aufzuklären."
                        }
                    ],
                    "synonyms": [
                        "Legende"
                    ],
                    "common_phrases": [
                        "zum Mythos werden",
                        "Mythos um eine Person"
                    ]
                },
                {
                    "sense_id": "e114362e-8b95-3ebe-8438-f1c9617a5bff",
                    "sense_definition": "Weitverbreitete falsche Annahme, erfundene Vorstellung oder Irrglaube",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist ein weit verbreiteter <w>Mythos</w>, dass man bei Erkältungen keinen Sport treiben darf."
                        },
                        {
                            "text": "Die Wissenschaftlerin konnte den hartnäckigen <w>Mythos</w> über die angebliche Gefahr mit Fakten widerlegen."
                        }
                    ],
                    "common_phrases": [
                        "einen Mythos zerstören",
                        "weit verbreiteter Mythos"
                    ]
                }
            ]
        }
    ]
}