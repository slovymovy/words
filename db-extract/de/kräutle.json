                ],
                "senses": [
                    {
                        "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                        "entry_id": "2ff4cf22-da6f-335f-a4de-f2ae376dd855",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8238128f-18cb-49c1-85c4-a75a98f834b7",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Frau Kräutle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec677c1e-9d72-41e7-85ae-4c5d9e74f1bb",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Herr Kräutle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "48ae1d5d-6937-404e-947a-b8b0e6885dbf",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Die Kräutles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c8b6ce5f-2560-463b-86bb-6ee24c78e67e",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Der Kräutle trägt nie die Pullover, die die Kräutle ihm strickt."
                            },
                            {
                                "example_id": "1524f013-bdd2-4f75-b656-41ec204667ef",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kräutle kommt, geht der Herr Kräutle.“"
                            },
                            {
                                "example_id": "322da4fd-1190-4806-9c3f-36fa6482a249",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Kräutle kommt und geht."
                            },
                            {
                                "example_id": "c37ef6d3-7113-4889-9042-15702df6ce72",
                                "sense_id": "45b8b3f7-dcff-3c76-8304-3fb45905f8d1",
                                "text": "Kräutles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
