                    "sense_definition": "Terme familier et affectueux désignant la grand-mère.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais passer tout le week-end chez ma <w>mamie</w> pour son anniversaire.",
                            "target_lang_translations": {
                                "en": "I'm going to spend the whole weekend at my <w>grandma's</w> for her birthday.",
                                "ru": "Я проведу все выходные у <w>бабушки</w> на её день рождения.",
                                "nl": "Ik ga het hele weekend bij mijn <w>oma</w> doorbrengen voor haar verjaardag.",
                                "de": "Ich werde das ganze Wochenende bei meiner <w>Oma</w> verbringen, zu ihrem Geburtstag.",
                                "pl": "Spędzę cały weekend u <w>babci</w>, z okazji jej urodzin.",
                                "it": "Passerò tutto il fine settimana da mia <w>nonna</w> per il suo compleanno.",
                                "cs": "Celý víkend strávím u své <w>babičky</w> na její narozeniny.",
                                "tr": "Onun doğum günü için tüm hafta sonunu <w>ninemde</w> geçireceğim.",
                                "es": "Voy a pasar todo el fin de semana en casa de mi <w>abuela</w> por su cumpleaños.",
                                "zh": "这个周末我要整个待在<w>奶奶</w>家，为她过生日。"
                            }
                        },
                        {
                            "text": "Les enfants adorent écouter les belles histoires que raconte leur <w>mamie</w>.",
                            "target_lang_translations": {
                                "en": "The children love listening to the lovely stories their <w>grandma</w> tells.",
                                "ru": "Дети обожают слушать красивые истории, которые рассказывает их <w>бабушка</w>.",
                                "nl": "De kinderen luisteren graag naar de mooie verhalen die hun <w>oma</w> vertelt.",
                                "de": "Die Kinder lauschen gern den schönen Geschichten, die ihre <w>Oma</w> erzählt.",
                                "pl": "Dzieci uwielbiają słuchać pięknych historii, które opowiada ich <w>babcia</w>.",
                                "it": "I bambini adorano ascoltare le belle storie che racconta la loro <w>nonna</w>.",
                                "cs": "Děti rády poslouchají krásné příběhy, které jejich <w>babička</w> vypráví.",
                                "tr": "Çocuklar, kendi <w>ninelerinin</w> anlattığı güzel hikâyeleri dinlemeyi çok severler.",
                                "es": "A los niños les encanta escuchar las bonitas historias que cuenta su <w>abuela</w>.",
                                "zh": "孩子们最爱听他们的<w>奶奶</w>讲的动人故事。"
                            }
                        }
                    ],
