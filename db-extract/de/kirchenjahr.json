                "senses": [
                    {
                        "sense_id": "43cc0820-cc60-3d36-aa3a-e93435105a71",
                        "entry_id": "e58ce5aa-2004-3369-b144-c8965e29441f",
                        "glosses": [
                            "die Bezeichnung für den im Laufe der Zeit aus den religiösen Festtagen entstandenen liturgischen Jahreszyklus in den christlichen Kirchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f77482-16db-488d-bec6-f7ae7bbbd864",
                                "sense_id": "43cc0820-cc60-3d36-aa3a-e93435105a71",
                                "text": "„Der Bau des Kirchenjahres wächst zusammen aus dem Osterfestkreis und Weihnachtsfestkreis, die sich zueinander wie „Hauptschiff“ und „Atrium“ verhalten;“"
                            },
                            {
                                "example_id": "080ed1ec-d363-4e0b-b8a3-c6abde30c357",
                                "sense_id": "43cc0820-cc60-3d36-aa3a-e93435105a71",
                                "text": "„Erst in jüngerer Zeit hat sich das Bewußtsein vom 1. Adventssontag als dem Anfang des Kirchenjahres durchgesetzt.“"
                            },
                            {
                                "example_id": "11c97f54-bf5e-4f4a-a78b-63830bab62db",
                                "sense_id": "43cc0820-cc60-3d36-aa3a-e93435105a71",
                                "text": "„Zur üblichen Alltagsbetriebsamkeit an den Seitenaltären großer Kirchen kamen die feierlichen Sonntagsmessen und die feierlichen Hochämter an den Prunktagen des Kirchenjahrs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
