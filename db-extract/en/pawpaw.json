                        "entry_id": "a6c1a09b-ee8b-37bf-8811-dc5f29a1e3a3",
                        "glosses": [
                            "Alternative letter-case form of pawpaw (“grandfather”)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f5685f71-1387-4324-b8b4-5b0c2d76bda3",
                                "sense_id": "b8beaa28-7efa-31a7-859a-0949a1a7b5c3",
                                "text": "She had enjoyed a happy childhood, but her one consistent ambition was to join her Pawpaw's law firm."
                            },
                            {
                                "example_id": "2324aabe-a4e9-4d96-a573-95302dfb55bb",
                                "sense_id": "b8beaa28-7efa-31a7-859a-0949a1a7b5c3",
                                "text": "Finding Adam playing with his favorite toy truck on the floor beside her prostrate father. Adam had looked up and scampered to her. \"Pawpaw's takin' a nap,\" he'd said. But Talia had known from her father's odd posture that he wasn't napping."
                            }
                        ]
                    }
