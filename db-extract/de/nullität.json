                "senses": [
                    {
                        "sense_id": "446d3c06-ad41-3839-ae66-2843618898ca",
                        "entry_id": "0c3664b5-150d-352e-838a-0af7176e16d7",
                        "glosses": [
                            "Eigenschaft, nichtig, ungültig zu sein (für null und nichtig erklärt)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e89a4560-76bb-4d0b-96ac-ef1e11816e65",
                                "sense_id": "446d3c06-ad41-3839-ae66-2843618898ca",
                                "text": "„Es gibt zwei Arten der Nichtigkeitsbeschwerde: die wegen heilbarer Nullitäten, welche ein ordentliches, und die wegen unheilbarer Nullitäten, welche ein außerordentliches Rechtsmittel ist.“ (1864)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed13274d-2689-309b-820e-08698320cb38",
                        "entry_id": "0c3664b5-150d-352e-838a-0af7176e16d7",
                        "glosses": [
                            "Eigenschaft, wertlos, bedeutungslos zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38918f0a-349a-4be1-ac12-c27941e11f0a",
                                "sense_id": "ed13274d-2689-309b-820e-08698320cb38",
                                "text": "„Er bemerkt nicht, daß, so oft er wieder von einer bedeutenden Unterredung mit Bismarck berichtet, er selbst zur gänzlichen Nullität zusammenschrumpft.“"
                            },
                            {
                                "example_id": "5c87b130-cb08-40cd-a1ff-720575ff7d5a",
                                "sense_id": "ed13274d-2689-309b-820e-08698320cb38",
                                "text": "„Sozusagen über Nacht sahen sich Mr. Chatterbox' unglückliche Leser in eine graue, von Nullitäten bevölkerte Unterwelt gestürzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
