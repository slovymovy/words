                    {
                        "form_id": "515e470e-46e6-48e4-81d5-8cfe63101c4d",
                        "entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Lebensstil"
                    },
                    {
                        "form_id": "8f6435c8-3ff8-4369-9c08-21c698e23560",
                        "entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lebensstile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                        "entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "glosses": [
                            "für eine Person oder eine Personengruppe kennzeichnende Kombination von Verhaltensweisen, welche die Art der Lebensführung bildet oder bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bd382c-9eec-4e56-9084-25be275a37e4",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "In vielen Ländern mit einst nomadischem Lebensstil führten Ölreichtum und Verstädterung zu den schädlichen Ernährungsgewohnheiten, die zuvor vornehmlich in der westlichen Welt beobachtet wurden."
                            },
                            {
                                "example_id": "4e5a6352-82f2-4171-ade5-d1435f16eb0a",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "Man sollte sich bemühen, einen gesunden Lebensstil mit viel Bewegung, gesunder Ernährung und Entspannungsübungen in seinen Alltag zu etablieren."
                            },
                            {
                                "example_id": "eb205504-f010-4b12-89fd-25bea55ccb9b",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "Schlemmen, rauchen, träge sein: Ein solcher Lebensstil tut den Blutbahnen im Körper nicht gut."
                            },
                            {
                                "example_id": "16e6bde6-1151-4d34-8191-5dec87669fd6",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "„Heute spricht man ganz neutral von Anhängern alternativer Lebensstile.“"
                            },
                            {
                                "example_id": "06384b90-8db3-4fda-8422-fbdffcfb3c9b",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "„Sie prägen eigene Münzen, übernehmen aber die Gesetze der Franken, den Lebensstil der Einheimischen, deren christliche Religion und romanische Sprache und erschaffen ein effizient verwaltetes Fürstentum, das zur Basis weiterer Eroberungen wird.“"
                            },
                            {
                                "example_id": "060e8948-10b1-4dfe-8633-d8a07b7af364",
                                "sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                                "text": "„Er rechtfertigt sich: Als Évolué werde ein westlicher Lebensstil von ihm erwartet, sein Gehalt reiche dafür aber selbst nach mehr als einem Jahrzehnt im Postdienst nicht aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "628b5dc6-dd79-48f0-a0ed-b42c57c421d5",
                        "source_entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "source_sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                        "target_lang_word": "lifestyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifestyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                        "entry_id": "2ed762bb-861a-31b1-a670-259f7f46a857",
                                        "glosses": [
                                            "A style of living that reflects the attitudes and values of a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5885dd56-a9d8-466c-8db5-0c6b19c4d41b",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "The Neolithic Revolution (about 8000-3000 B.C.E.) was characterized by people moving from nomadic lifestyles to agricultural lifestyles."
                                            },
                                            {
                                                "example_id": "473245df-819b-4129-b5e1-1e76cc6de21a",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "I ended my aimless-roaming-short-term-odd-jobs lifestyle and joyfully went to work at a local restaurant in Langley Park, Maryland, as a carhop."
                                            },
                                            {
                                                "example_id": "e4f33ada-2496-4174-905b-712f0a4080a1",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "As we scroll through the curated lifestyles of the influencers we follow on Instagram or YouTube, it can seem like they have it all together and never had to suffer a day in their lives."
                                            },
                                            {
                                                "example_id": "9df43080-d85c-482c-9de7-cbb55c72a849",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "And yet queer and transgender people are finding a place in a lifestyle that, at least online, often occupies the same digital space as content from conservative creators, said Devin Proctor, an assistant professor of anthropology at Elon University in North Carolina who studies how we construct identities online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769c3438-d5cb-3d84-bda7-75e3d155a104",
                                        "entry_id": "2ed762bb-861a-31b1-a670-259f7f46a857",
                                        "glosses": [
                                            "The totality of the likes and dislikes of a particular section of the market, especially when expressed in terms of the products and services that they would buy; a marketing strategy based on the self-image of such a group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3db5429b-ac4c-4777-a210-d85064ba3dd1",
                        "source_entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "source_sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                        "target_lang_word": "mode de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mode de vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                        "entry_id": "d2eebe92-c3ab-3508-a386-e7eb193850f5",
                                        "glosses": [
                                            "Ensemble des pratiques, des comportements, des besoins et des aspirations inhérent à une personne ou à un groupe d’individu. Et ceci d’un point de vue économique, social et culturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec0f3f8-1823-4fbc-bb77-3edf199194fb",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "L’Europe occidentale est profondément marquée par le mode de vie d’Outre-Atlantique qui semble être porteur de valeur universelle comme la réalisation de soi et le succès, l’activité, l’efficacité et l’esprit pratique, le progrès, le confort matériel, l’individualité, la liberté, le conformisme externe, l’humanisme, la jeunesse, la forme physique et la santé."
                                            },
                                            {
                                                "example_id": "0f3070c3-dcbd-47bd-a73c-28936dede5bd",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Le terme de \"petite-bourgeoisie\" a longtemps fonctionné comme notion stigmatisante, à savoir une accusation portée sur un groupe social qui dans son mode de vie tendait beaucoup à copier le mode de vie \"bourgeois\"."
                                            },
                                            {
                                                "example_id": "8f398572-7f47-4e4b-9658-74cd0f9c9a4f",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Il m'a tout d'un coup semblé préférable d'examiner comment certains peuples répondaient, dans leurs modes de vie, plutôt que dans un discours théorique, aux questions que nous nous posons tous."
                                            },
                                            {
                                                "example_id": "1019b2ad-fe8d-42ea-a251-52d9a42c40f7",
                                                "sense_id": "c5f27bc4-5014-3186-ab73-2138855fb0dd",
                                                "text": "Si certaines industries du Maroc sont technologiquement proches de l'Oldowayen, en l'absence de fouille de sols d'habitat, on ne peut rien dire sur le plan palethnologique du mode de vie de leurs auteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                        "entry_id": "d2eebe92-c3ab-3508-a386-e7eb193850f5",
                                        "glosses": [
                                            "Comportement biologique ou écologique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88fa0682-7aba-4160-9fe4-b8512c4e839f",
                                                "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                                "text": "Des zoocécidies peuvent se former, suivant le mode de vie (aérien, souterrain, etc.) du parasite qui les provoque, dans tous les organes (racines, tiges, feuilles, fleurs) de nombreux Végétaux supérieurs."
                                            },
                                            {
                                                "example_id": "3201b559-98dd-418e-b4c8-826b4148c718",
                                                "sense_id": "06029fd5-af4e-396d-852f-4f9780acdc38",
                                                "text": "Ces minuscules algues peuvent se décolorer par perte - réversible ou non - de leur chlorophylle. Sous l'influence de l'obscurité ou de mauvaises conditions de nutrition, elles cessent d'effectuer la photosynthèse et adoptent un mode de vie typiquement animal : elles se nourrissent d'aliments organiques solides ou liquides.,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5d1c247-a24f-416e-bd9d-f0070e820deb",
                        "source_entry_id": "0ee6b045-3c2b-3c7b-be22-293d519f0fb7",
                        "source_sense_id": "d7c00959-21c3-32e0-a90b-edda5da58939",
                        "target_lang_word": "style de vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "style de vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2adedb23-c4f8-3922-b8d5-550b13679987",
                                        "entry_id": "7db03a64-265f-3dcb-a9aa-ae08ca31440e",
                                        "glosses": [
                                            "Manière de vivre — d’être et de penser — d’une personne ou d’un groupe d’individus. C’est son comportement quotidien, sa façon de vivre autour et pour certaines valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59152fbf-0f90-48ea-a616-5ae8e2abce31",
                                                "sense_id": "2adedb23-c4f8-3922-b8d5-550b13679987",
                                                "text": "On pourrait multiplier les exemples d’amélioration qualitative du style de vie par la technologie, où le progrès réalisé est disproportionné à l'investissement économique nécessaire. La pilule supprime les frustrations et les aléas du coït interrompu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb88ea5c-760a-32c8-ac70-01c48c572118",
                                        "entry_id": "7db03a64-265f-3dcb-a9aa-ae08ca31440e",
                                        "glosses": [
                                            "Façon dont une personne ou un groupe vit."
                                        ],
                                        "tags": [],
                                        "note": "Cela inclut ses types de relations sociales, sa façon de consommer, sa façon de se divertir, de s’habiller. Un style de vie reflète également l’attitude d’un individu, ses valeurs, sa façon de voir le monde dans lequel il vit",
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
