                "senses": [
                    {
                        "sense_id": "80912aaa-ac87-3e2c-b57a-27f13f0698d2",
                        "entry_id": "52b67baa-dc5b-31c8-8eb0-2c242e67a6f1",
                        "glosses": [
                            "eine in Namibia und im südlichen Angola gesprochene Sprache, die zu den Bantusprachen gerechnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c83357d-9978-492a-b713-4d11cebf0497",
                                "sense_id": "80912aaa-ac87-3e2c-b57a-27f13f0698d2",
                                "text": "„In dem ersten der genannten Nebenzweige finden wir die Heréro-Sprache, […] und das Ndonga von Ova-Mpo, welches im Süden des Flusses Cunéne von Volksstämmen geredet wird, welche dem Namen nach unter englischer Botmässigkeit stehen.“"
                            },
                            {
                                "example_id": "d7ac2bba-631c-4eb6-9ac5-c68f51c723dd",
                                "sense_id": "80912aaa-ac87-3e2c-b57a-27f13f0698d2",
                                "text": "„Das eigentliche Ovambo oder Kwanyama hat 400.000 Sprecher, das auch Ovambo genannte Ndonga 700.000.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
