                        "glosses": [
                            "Incompressibilité (approximativement), pour une substance."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3da268-7300-46f1-af47-18e330690a3e",
                                "sense_id": "0db0a6e8-fe3b-3060-b8b7-1d8895d6f5c6",
                                "text": "Für die meisten Anwendungen kann man von der Inkompressibilität der Flussigkeiten ausgehen.",
                                "translation": "Pour la plupart des apllications, on peut faire l'hypothèse de l'incompressibilité des liquides."
                            },
                            {
                                "example_id": "0a5cec82-2999-4db6-8395-575cd44239f7",
                                "sense_id": "0db0a6e8-fe3b-3060-b8b7-1d8895d6f5c6",
                                "text": "Die relative Inkompressibilität der Elastomere steht in starkem Kontrast zu ihrer leichten Verformbarkeit.",
                                "translation": "L'incompressibilité relative des élastomères contraste fortement avec leur déformabilité élevée."
                            }
                        ]
