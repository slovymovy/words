                                    {
                                        "sense_id": "65867625-f424-3147-9e94-da538f52de78",
                                        "entry_id": "f3409854-47b2-33bc-b5b6-fd3980d00e25",
                                        "glosses": [
                                            "Composé de formule C₁₂H₉N constitué d'un cycle de pyridine fusionné avec deux cycles de benzène, qu’on trouve dans les huiles lourdes de goudron, qui irrite les membranes muqueuses, et, respirée, provoque des éternuements violents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ced9220-ebac-4e78-83df-f26b126c0891",
                                                "sense_id": "65867625-f424-3147-9e94-da538f52de78",
                                                "text": "Les acridines sont des corps à fonction basique qui dérivent du composé découvert par MM. Graeve et Caro et nommé par eux acridine."
                                            },
                                            {
                                                "example_id": "5daa438f-8277-417b-bd9d-13b51de4bac8",
                                                "sense_id": "65867625-f424-3147-9e94-da538f52de78",
                                                "text": "L’acridine est un corps jaune, soluble dans l’eau, aux solutions fluorescentes."
                                            },
                                            {
                                                "example_id": "4915beb3-1d39-4047-9052-961d254bad6b",
                                                "sense_id": "65867625-f424-3147-9e94-da538f52de78",
                                                "text": "La formation de l’acridine s’accuse par un dégagement de vapeurs d’eau et par la coloration de la masse en brun : pour rendre la transformation complète, il suffit de maintenir la température à 180-200° pendant 25 minutes."
                                            }
                                        ]
                                    }
