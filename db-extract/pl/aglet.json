                "senses": [
                    {
                        "sense_id": "341da1cf-9817-3229-8174-e51c6b699c1e",
                        "entry_id": "6de0f4a3-632b-384e-9251-42ed8a8a4874",
                        "glosses": [
                            "aiglet (tip on a ribbon or cord)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0b88931c-8b9d-43fa-a08f-b4462ad55579",
                                "sense_id": "341da1cf-9817-3229-8174-e51c6b699c1e",
                                "text": "A-G-L-E-T! Wie już każdy! Wszyscy skaczemy ile sił! Tak, tak, tak!",
                                "translation": "A-I-G-L-E-T! A-G-L-E-T! Don't forget it! Get us all on our feet! Yeah, yeah, yeah!",
                                "english": "A-I-G-L-E-T! A-G-L-E-T! Don't forget it! Get us all on our feet! Yeah, yeah, yeah!"
                            },
                            {
                                "example_id": "6b3d83df-3a05-4b82-a5c3-7fa5cf450ef2",
                                "sense_id": "341da1cf-9817-3229-8174-e51c6b699c1e",
                                "text": "zawsze razem przez trudy i znoje\nniekiedy w oczy i kłody na drodze\naglet zerwany przetkać trudno",
                                "translation": "always together through tough times and toil\n sometimes one sees logs in the way\nit's difficult to unblock one's ripped off aiglet",
                                "english": "always together through tough times and toil\n sometimes one sees logs in the way\nit's difficult to unblock one's ripped off aiglet"
                            },
                            {
                                "example_id": "5aa1a002-4365-4e16-8dee-6214c2cfacf2",
                                "sense_id": "341da1cf-9817-3229-8174-e51c6b699c1e",
                                "text": "Lecz aglet za sznurówki wylatuje i mu plany rujnuje.",
                                "translation": "But the aiglet flies out past his shoelaces and ruins his plans.",
                                "english": "But the aiglet flies out past his shoelaces and ruins his plans."
                            }
                        ]
                    }
