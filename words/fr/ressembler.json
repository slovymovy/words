{
    "word_family": [
        "ressemblance",
        "ressemblant",
        "sembler",
        "semblable",
        "dissemblable",
        "dissemblance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6efade5-330b-3010-bbc9-8df2f07a3ebb",
                    "sense_definition": "Avoir des traits communs, une apparence ou des caractéristiques similaires à quelqu'un ou quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon <w>ressemble</w> beaucoup à son père quand il sourit."
                        },
                        {
                            "text": "Cette vieille maison de campagne <w>ressemble</w> à un petit château fort médiéval."
                        }
                    ],
                    "synonyms": [
                        "avoir l'air de",
                        "tenir de"
                    ],
                    "antonyms": [
                        "différer"
                    ],
                    "common_phrases": [
                        "ressembler à son père"
                    ]
                },
                {
                    "sense_id": "30e94795-76b8-31da-9160-4b246659efac",
                    "sense_definition": "Présenter une ressemblance mutuelle, être semblable l'un à l'autre.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux sœurs jumelles se <w>ressemblent</w> vraiment beaucoup par leur voix."
                        },
                        {
                            "text": "Même si nos deux opinions se <w>ressemblent</w>, nous avons des méthodes différentes."
                        }
                    ],
                    "common_phrases": [
                        "se ressembler comme deux gouttes d'eau"
                    ]
                },
                {
                    "sense_id": "5b7d59e7-9260-3e30-9ed5-4540743f837a",
                    "sense_definition": "Être conforme au caractère, aux principes ou au comportement habituel d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arriver en retard à une réunion importante ne lui <w>ressemble</w> vraiment pas."
                        },
                        {
                            "text": "Cette décision généreuse lui <w>ressemble</w> tout à fait car il aime aider les autres."
                        }
                    ],
                    "common_phrases": [
                        "ne pas lui ressembler"
                    ]
                },
                {
                    "sense_id": "6b7d0522-5ff3-3d4f-b1af-f1b795d8fcac",
                    "sense_definition": "Avoir une allure convenable, une structure ou un sens intelligible, surtout à la forme négative.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec toute cette peinture renversée partout, ton dessin ne <w>ressemble</w> à rien."
                        },
                        {
                            "text": "Le texte mal corrigé a été publié et ne <w>ressemble</w> à rien de cohérent."
                        }
                    ],
                    "common_phrases": [
                        "ne ressembler à rien"
                    ]
                }
            ]
        }
    ]
}