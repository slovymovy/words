                                        "glosses": [
                                            "reich an Eisen und Magnesium"
                                        ],
                                        "tags": [
                                            "von gesteinsbildenden Mineralien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06cf242-f28e-484e-8a46-b149a9bab2e5",
                                                "sense_id": "e821b944-f234-3bfa-8e4a-7fd6c1a185f2",
                                                "text": "Als mafische Minerale treten Ägirin, Aegirin-Augit, Alkaliamphibole, Olivin (Fayalit), Melanit und Biotit auf."
                                            },
                                            {
                                                "example_id": "132c8065-8c71-4959-a58e-cc3c0af590d6",
                                                "sense_id": "e821b944-f234-3bfa-8e4a-7fd6c1a185f2",
                                                "text": "Foidsyenite ohne mafische Gemengteile, die nur aus Nephelin und Feldspäten bestehen, sind aufgrund der geringeren Werte für die Dichte dieser Minerale leichter als Granite."
                                            }
                                        ],
