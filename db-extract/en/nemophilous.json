                        "examples": [
                            {
                                "example_id": "c5bfa78c-9463-407b-85c5-724930c7bf01",
                                "sense_id": "4f618957-d0c1-3659-8e7f-a682c694a467",
                                "text": "The general scenery is spellbinding, both underfoot as well as to the sides. To my joy and sheer wonder, your son Buddy has turned out to be utterly and thrillingly nemophilous!"
                            },
                            {
                                "example_id": "845c385a-7b70-42d4-a4cb-611bd496a51f",
                                "sense_id": "4f618957-d0c1-3659-8e7f-a682c694a467",
                                "text": "For the thorns and briers need a good scouring, confessing, in words, allegiance to a nobler, nemophilous wolf."
                            }
                        ]
                    }
