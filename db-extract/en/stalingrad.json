                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe24cde-3e41-4eaf-914e-87a3ba658b85",
                                                "sense_id": "b032e63c-3996-3cd3-9ae1-330a003a84d4",
                                                "text": "Meer dan drie miljoen Duitse soldaten stonden aan de start van operatie Barbarossa, de aanval zou de geschiedenis in gaan als grootste militaire operatie ooit. Tijdens Operatie Barbarossa vielen er meer dan achthonderdduizend doden aan Duitse zijde. De nederlaag wordt gezien als beginpunt van de neergang van het Duitse leger in de Tweede Wereldoorlog; twee jaar later zouden de Duitsers opnieuw verpletterend verslagen worden bij de Slag om Stalingrad"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55785f32-071a-4c2e-80c3-86487fce43a0",
                        "source_entry_id": "0ca12d9a-39d6-3420-8738-b70bd3e19cbb",
