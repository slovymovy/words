                "senses": [
                    {
                        "sense_id": "848764ce-e54e-35ce-bb7d-066c62dac77a",
                        "entry_id": "00569c0d-3376-3479-b99a-f677b6397c81",
                        "glosses": [
                            "das zusammenhängende System der Verdauung, bestehend aus Magen und Darm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35883206-2116-4191-8c79-bc8f85ba30d7",
                                "sense_id": "848764ce-e54e-35ce-bb7d-066c62dac77a",
                                "text": "Der menschliche Magen-Darm-Trakt ist sehr anpassungsfähig, denn er verträgt eine riesige Auswahl an Lebensmitteln und kann aus diesen die für den Körper wichtigen Nährstoffe herausziehen und die nicht verdaubaren Reste ausscheiden."
                            },
                            {
                                "example_id": "427dbc1e-f160-429a-8d8f-7cdd9304d25d",
                                "sense_id": "848764ce-e54e-35ce-bb7d-066c62dac77a",
                                "text": "„Schwerwiegende Infektionskrankheiten des Magen-Darm-Traktes, die mit blutigen Durchfällen und Fieberschüben einhergingen, waren zu allen Zeiten die gefürchteten Begleiter des Heeres.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
