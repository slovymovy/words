                "senses": [
                    {
                        "sense_id": "7fc36f77-e9e2-3b1c-bffb-d715c4cca9ed",
                        "entry_id": "5c41f894-ed2d-37bf-88bb-82d6db1fccbb",
                        "glosses": [
                            "Qualité de ce qui est général."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb69db9-c969-4b5f-82d7-eb45ca322756",
                                "sense_id": "7fc36f77-e9e2-3b1c-bffb-d715c4cca9ed",
                                "text": "Cette proposition dans sa généralité est fausse."
                            },
                            {
                                "example_id": "1430e944-7c10-4c76-9846-30bf75f04927",
                                "sense_id": "7fc36f77-e9e2-3b1c-bffb-d715c4cca9ed",
                                "text": "Votre affirmation a trop de généralité."
                            }
                        ]
                    },
                    {
                        "sense_id": "9286f485-8b48-3603-b8c5-48701df5fc1a",
                        "entry_id": "5c41f894-ed2d-37bf-88bb-82d6db1fccbb",
                        "glosses": [
                            "Grande majorité ; quasi-totalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0857cba-9952-405b-b2fe-dd2cb49028ea",
                                "sense_id": "9286f485-8b48-3603-b8c5-48701df5fc1a",
                                "text": "La généralité des Américains s’imaginaient la guerre d’après les campagnes limitées, avantageuses et pittoresques, qui avaient eu lieu autrefois."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5a2ea5f-d189-3b8f-888f-9c4f209549fe",
                        "entry_id": "5c41f894-ed2d-37bf-88bb-82d6db1fccbb",
                        "glosses": [
                            "Discours qui n’ont pas un rapport précis au sujet."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2ff0bbfa-d433-4912-9a64-443b6e9d94bb",
                                "sense_id": "a5a2ea5f-d189-3b8f-888f-9c4f209549fe",
                                "text": "Il n’est pas entré dans le vif de son sujet : il s’en est tenu à des généralités."
                            },
                            {
                                "example_id": "7c37082f-f300-467e-b22b-08dacfb85d69",
                                "sense_id": "a5a2ea5f-d189-3b8f-888f-9c4f209549fe",
                                "text": "S’attarder à des généralités sans intérêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ef3adeb-cbba-3d76-9943-06694591ef72",
                        "entry_id": "5c41f894-ed2d-37bf-88bb-82d6db1fccbb",
                        "glosses": [
                            "Étendue de la juridiction d’un bureau de trésoriers de France."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "b886f9b6-61cb-465d-9137-e5568d242310",
                                "sense_id": "6ef3adeb-cbba-3d76-9943-06694591ef72",
                                "text": "La généralité de Paris, de Moulins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3542e8be-65fd-45ed-b3e2-3fcc21d5a099",
                        "source_entry_id": "5c41f894-ed2d-37bf-88bb-82d6db1fccbb",
                        "target_lang_word": "general",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "general",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Including or involving every part or member of a given or implied entity, whole, etc.; common to all, universal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7692a416-1f9e-45f7-9da3-fbcf390c6eb2",
                                                "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                                "text": "It is generall / To be mortall: / I haue well espyde / No man may hym hyde / From Deth holow eyed […]."
                                            },
                                            {
                                                "example_id": "1aaa3498-3afd-45e0-98ae-f3587bb77083",
                                                "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                                "text": "\"Among us!\" was the general shout, and Peppersorn sat frozen to his chair."
                                            },
                                            {
                                                "example_id": "86167e9a-4b74-42ee-8823-88c38c534b66",
                                                "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                                "text": "That each, who seems a separate whole,\nShould move his rounds, and fusing all\nThe skirts of self again, should fall\nRemerging in the general Soul,\nIs faith as vague as all unsweet: […]"
                                            },
                                            {
                                                "example_id": "ff16ac68-eb4e-44b0-bc7c-4624f36da719",
                                                "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                                "text": "Undoubtedly the age of the Antonines was much better than any later age until the Renaissance, from the point of view of the general happiness."
                                            },
                                            {
                                                "example_id": "62fddd1e-f20c-4054-8403-ad14214f8ade",
                                                "sense_id": "848634ce-3515-3784-bcb0-2415bcb3ca23",
                                                "text": "One advantage of having profitable companies in Britain is that they pay large sums in corporate tax into the Exchequer, which in theory at least is used for the general good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0381cb55-1f2a-3408-ae25-9e189f8682b9",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Applied to a person (as a postmodifier or a normal preceding adjective) to indicate supreme rank, in civil or military titles, and later in other terms; pre-eminent."
                                        ],
                                        "tags": [
                                            "postpositional",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6267616b-92b8-4845-9848-f731fc5f8782",
                                                "sense_id": "0381cb55-1f2a-3408-ae25-9e189f8682b9",
                                                "text": "For these successes he obtained the rank of Field-Marshal General."
                                            },
                                            {
                                                "example_id": "79ce5f57-84bf-4b1c-a38c-6d5dccb19021",
                                                "sense_id": "0381cb55-1f2a-3408-ae25-9e189f8682b9",
                                                "text": "He becomes the chief chartered libertine, the whoremaster-general flourishing his \"standard\" over a female army […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07cd4ea-ddc8-3bb8-af8d-46faebd5718c",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Prevalent or widespread among a given class or area; common, usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ccb98c-9818-407a-95ee-e22a8b608ca9",
                                                "sense_id": "b07cd4ea-ddc8-3bb8-af8d-46faebd5718c",
                                                "text": "‘I can't quite afford you the sympathy you expect upon this score,’ I replied; ‘the misfortune is so general, that it belongs to one half of the species […].’"
                                            },
                                            {
                                                "example_id": "54578213-ab63-40ac-bdd5-fab181e55839",
                                                "sense_id": "b07cd4ea-ddc8-3bb8-af8d-46faebd5718c",
                                                "text": "The general opinion on Baz Luhrmann's overstuffed epic Australia seems to be that it throws in everything but the kitchen sink, and then tosses that in too, just to be sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c56a359-e231-310d-acc9-5681d17950db",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Not limited in use or application; applicable across a broad range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d5fc8d-d5a1-417b-a4de-2db0959712c9",
                                                "sense_id": "3c56a359-e231-310d-acc9-5681d17950db",
                                                "text": "M. Venizelos went to Athens from Paris early last January in response to a general invitation from the Greek populace."
                                            },
                                            {
                                                "example_id": "32712342-3efb-4658-a286-eb454cbf1bcc",
                                                "sense_id": "3c56a359-e231-310d-acc9-5681d17950db",
                                                "text": "Already in the primary school work is conducted for the purpose of equipping the pupils with those elements of general knowledge which are closely related to the military preparation of future warriors."
                                            },
                                            {
                                                "example_id": "f0b5f3fa-eb3e-4f1c-99e7-ca3c9c2a7b90",
                                                "sense_id": "3c56a359-e231-310d-acc9-5681d17950db",
                                                "text": "Supraventricular tachycardia (SVT) is a general term indicating a rapid heartbeat (tachycardia) coming from the top chambers of the heart - in essence, above (supra) the lower chamber (ventricular)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e20cee0-650f-31dd-ae84-f4fce9ccb218",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Giving or consisting of only the most important aspects of something, ignoring minor details; indefinite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5ed608-1661-4b89-85fe-097995f95526",
                                                "sense_id": "1e20cee0-650f-31dd-ae84-f4fce9ccb218",
                                                "text": "As she thus spoke, the entrance of the servants with dinner cut off all conversation but that of a general nature."
                                            },
                                            {
                                                "example_id": "df1af0ab-e560-475d-b25e-3ad91b4c5f5c",
                                                "sense_id": "1e20cee0-650f-31dd-ae84-f4fce9ccb218",
                                                "text": "There was a moment's pause. The Princess broke in with some casual remark and once more the conversation became general."
                                            },
                                            {
                                                "example_id": "b3e16674-a718-4c27-9417-0036971cd6db",
                                                "sense_id": "1e20cee0-650f-31dd-ae84-f4fce9ccb218",
                                                "text": "The quick answer is that the 1893 Exposition was simply so important — \"the greatest event in the history of the country since the Civil War,\" as Harper's put it that October — but that feels too general."
                                            },
                                            {
                                                "example_id": "53be7ecb-3c3e-4ea2-b164-48afd426fa87",
                                                "sense_id": "1e20cee0-650f-31dd-ae84-f4fce9ccb218",
                                                "text": "Given the scarcity of relevant historical detail in the New Testament, we are left with only a general outline about Joseph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9175763-277d-333f-8cb1-2c25e2b63f20",
                                        "entry_id": "098d747f-a91d-338c-8ad3-e3bd8f276176",
                                        "glosses": [
                                            "Not of a specific class; miscellaneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619b5dd3-d869-49ff-be1d-1bffe2cd2d41",
                                                "sense_id": "f9175763-277d-333f-8cb1-2c25e2b63f20",
                                                "text": "general goods"
                                            },
                                            {
                                                "example_id": "bf7ded0f-676a-4691-a808-d45c2a6a203f",
                                                "sense_id": "f9175763-277d-333f-8cb1-2c25e2b63f20",
                                                "text": "His measured, springless walk was the walk of the skilled countryman as distinct from the desultory shamble of the general labourer […]."
                                            }
                                        ]
                                    }
                                ]
                            },
