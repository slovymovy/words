                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "281e7132-960e-4371-a966-ed7504846333",
                        "source_entry_id": "4481fdfc-4c89-3b4b-8a7e-5cf2d86f905c",
                        "source_sense_id": "71f08cc3-3ac8-3713-b6eb-aa68cd60fd84",
                        "source_sense_description": "een afgerichte duif die berichten kan overbrengen",
                        "target_lang_word": "Brieftaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brieftaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                        "entry_id": "b3c2b693-9358-3eb1-a56d-778bad622883",
                                        "glosses": [
                                            "Eine Taubenrasse, die ursprünglich zur Nachrichtenübermittlung diente und heute oft zu Sportzwecken (Brieftaubenwettflüge) genutzt wird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a9ea2f-d729-4ea4-afbc-4a4cd49e78df",
                                                "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                                "text": "Mein Opa hat mit seinen Brieftauben sehr viele Preise gewonnen."
                                            },
                                            {
                                                "example_id": "e8ce3d55-a1b1-401c-88ee-bff3306ffcef",
                                                "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                                "text": "„Was genau die Brieftauben zur Rückkehr zum Nistplatz oder in den heimischen Schlag bewegt, ist bis heute ihr Geheimnis.“"
                                            },
                                            {
                                                "example_id": "d1693a94-0607-40b1-88b4-243973630bb5",
                                                "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                                "text": "„Mit Brieftauben ließ sich auch nicht viel für die Millionenstadt ausrichten.“"
                                            },
                                            {
                                                "example_id": "fdf8f416-603a-48a3-a7d8-90354e1e7857",
                                                "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                                "text": "„Die Ausdauer und den Orientierungssinn von Brieftauben schätzten schon die Menschen des Altertums.“"
                                            },
                                            {
                                                "example_id": "fdac57ca-44b9-49fa-a583-bc2f7db48c78",
                                                "sense_id": "1206a3cd-4a0e-3e03-8806-fdff0ced1d78",
                                                "text": "„Er hat vor dem Kriege eine Zucht von Brieftauben und schwarzweißen Tümmlern gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab4dcbf6-4547-4415-950d-69cc98a219ff",
                        "source_entry_id": "4481fdfc-4c89-3b4b-8a7e-5cf2d86f905c",
                        "source_sense_id": "71f08cc3-3ac8-3713-b6eb-aa68cd60fd84",
                        "source_sense_description": "een afgerichte duif die berichten kan overbrengen",
                        "target_lang_word": "carrier pigeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carrier pigeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19703e6f-3236-3adc-812a-28880eeaa4e9",
                                        "entry_id": "1d8257ad-8acb-3da4-9299-ee435f4d6af5",
                                        "glosses": [
                                            "A domestic pigeon which transports attached messages or very small parcels from the place where it is released to a familiar destination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23eac0cb-45c3-444e-947d-ad52dc85502b",
                                                "sense_id": "19703e6f-3236-3adc-812a-28880eeaa4e9",
                                                "text": "At length, after wheeling his toothpick slowly round and round in the air, as if it were a carrier pigeon just thrown up, he suddenly made a dart at the drawing,"
                                            },
                                            {
                                                "example_id": "d74855af-a1db-4df4-a96a-cf293fdefcd1",
                                                "sense_id": "19703e6f-3236-3adc-812a-28880eeaa4e9",
                                                "text": "Once on her window-sill Harmony found among the pigeons a carrier pigeon with a brass tube fastened to its leg."
                                            },
                                            {
                                                "example_id": "b52b69ff-3618-40b4-b196-e635f1f6b293",
                                                "sense_id": "19703e6f-3236-3adc-812a-28880eeaa4e9",
                                                "text": "Two days after the first U.S. bridgehead had been thrown back at Rapido (see p. 23), a U.S. carrier pigeon winged wearily into its home base in Italy. Clipped to its leg was this German sneer: \"Herewith your message pigeon is returned. We have plenty to eat.\""
                                            },
                                            {
                                                "example_id": "23e3c86d-d1d5-4111-8098-d3355d6ee833",
                                                "sense_id": "19703e6f-3236-3adc-812a-28880eeaa4e9",
                                                "text": "For the second time in four months, prison guards foiled an attempt to smuggle a cellphone into a prison by carrier pigeon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3bc189e-81f9-4f1f-b411-5ae12eccfe29",
                        "source_entry_id": "4481fdfc-4c89-3b4b-8a7e-5cf2d86f905c",
                        "source_sense_id": "71f08cc3-3ac8-3713-b6eb-aa68cd60fd84",
                        "source_sense_description": "een afgerichte duif die berichten kan overbrengen",
                        "target_lang_word": "homing pigeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homing pigeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69f5958b-47f3-3858-99f8-c8451a14df5b",
                                        "entry_id": "3246c567-3be0-3bd3-aea7-f80c1d2d28d5",
                                        "glosses": [
                                            "A variety of domesticated rock pigeon (Columba livia) that has been selectively bred to be able to find its way home over extremely long distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4992acd3-f145-47f5-8aa6-af8432c3356c",
                                                "sense_id": "69f5958b-47f3-3858-99f8-c8451a14df5b",
                                                "text": "“What I mean is, just stick around and you'll probably find the thing.” “You think it will return?” “I do.” “Like a homing pigeon?” “That's the idea.”"
                                            },
                                            {
                                                "example_id": "8a71e51e-2c6c-4117-9e1f-87548f62653a",
                                                "sense_id": "69f5958b-47f3-3858-99f8-c8451a14df5b",
                                                "text": "In her telling, she sought Musk out after the deal closed, pressing him to meet and discuss how she could make NBCUniversal a bigger media partner “via email, text, I may have been considering a homing pigeon”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bc051dc-13ca-49ed-967a-009dcb70c551",
                        "source_entry_id": "4481fdfc-4c89-3b4b-8a7e-5cf2d86f905c",
                        "source_sense_id": "71f08cc3-3ac8-3713-b6eb-aa68cd60fd84",
                        "source_sense_description": "een afgerichte duif die berichten kan overbrengen",
                        "target_lang_word": "pigeon voyageur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pigeon voyageur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a40786e-1388-3faf-af4c-cd57d0b2a7a3",
                                        "entry_id": "cecee878-45e3-37e4-b965-00ec90e3b75c",
                                        "glosses": [
                                            "Race de pigeons spécialement sélectionnés pour effectuer des voyages surtout afin de transmettre des messages et obtenue à partir du pigeon biset."
                                        ],
                                        "tags": [
                                            "Zootechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "728e9b3d-ea39-479c-81c0-f4559b0fde24",
                                                "sense_id": "8a40786e-1388-3faf-af4c-cd57d0b2a7a3",
                                                "text": "Quelques instants plus tard, un pigeon voyageur quitte le palais, portant un message qui doit mettre les ennemis de Venise au courant de la situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
