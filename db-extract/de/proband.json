                ],
                "senses": [
                    {
                        "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                        "entry_id": "92204c1e-24d4-34c8-9ab7-e8fbe7ba7ee1",
                        "glosses": [
                            "jemand, der einer wissenschaftlichen Prüfung oder einer Untersuchung unterzogen wird, der an einem wissenschaftlichen Versuch teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e245805e-af19-445d-88dd-322511645bf9",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "Die Hälfte der Probanden erkrankte bereits nach drei Tagen."
                            },
                            {
                                "example_id": "972bafff-4cb3-4672-85c3-8f2d036272bd",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "Der Proband wurde vorher ausführlich untersucht"
                            },
                            {
                                "example_id": "e7ae3188-faa0-4b61-b8a6-2470ca2689c3",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "„Hierbei wurden immer zwei Personen aus den sechs Fachbereichen, jeweils ein männlicher und ein weiblicher Proband, ausgewählt.“"
                            },
                            {
                                "example_id": "53323c4e-61a7-447a-a24e-27e43e3decbe",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "„So weisen weibliche Probanden, die im Besitz einer Zeitkarte sind, Affinitäten zur räumlichen Bemessung anhand von Flächenzonen auf.“"
                            },
                            {
                                "example_id": "b446b79e-64c6-439a-812c-8b7cd1f5377c",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "„Weil sich die Probanden für unsichtbar hielten, blieb ihre Pulsfrequenz niedriger als bei Teilnehmern von Kontrollgruppen.“"
                            },
                            {
                                "example_id": "b67b2e2e-653d-469f-b3c1-d0d6c04b6522",
                                "sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
                                "text": "„Den Probanden half es nicht einmal, wenn sie vorher ausdrücklich vor der Verwechslungsgefahr gewarnt wurden - sie irrten sich dann kaum weniger häufig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79b9756-fc7f-42f9-91f8-d86c801f214f",
                        "source_entry_id": "92204c1e-24d4-34c8-9ab7-e8fbe7ba7ee1",
                        "source_sense_id": "586583de-110c-3f64-a29e-ac7db3082912",
