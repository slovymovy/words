{
    "word_family": [
        "robustesse",
        "robustement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ab16122-1d48-33a3-9d0f-d741c1cc8023",
                    "sense_definition": "Qui présente une grande force physique, une constitution solide et une bonne résistance à la fatigue ou à la maladie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à sa constitution <w>robuste</w>, le randonneur a supporté sans peine les longues marches en altitude."
                        },
                        {
                            "text": "Ce travailleur particulièrement <w>robuste</w> soulève de lourdes charges toute la journée sans manifester de fatigue."
                        }
                    ],
                    "synonyms": [
                        "fort",
                        "vigoureux",
                        "solide",
                        "résistant"
                    ],
                    "antonyms": [
                        "chétif",
                        "faible",
                        "frêle"
                    ],
                    "common_phrases": [
                        "constitution robuste",
                        "santé robuste"
                    ]
                },
                {
                    "sense_id": "9af9d87e-044b-3493-ac94-6bcb7f569bb5",
                    "sense_definition": "Qui supporte bien les agressions extérieures, les intempéries ou l'usure, en parlant d'un végétal ou d'un objet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante <w>robuste</w> s'adapte sans difficulté aux hivers rigoureux et aux sols très arides."
                        },
                        {
                            "text": "Les parents ont acheté des meubles <w>robustes</w> pour équiper la chambre de leurs jeunes enfants."
                        }
                    ],
                    "synonyms": [
                        "résistant",
                        "solide",
                        "durable"
                    ],
                    "antonyms": [
                        "fragile",
                        "délicat"
                    ],
                    "common_phrases": [
                        "plante robuste",
                        "matériel robuste"
                    ]
                },
                {
                    "sense_id": "60935de1-c6a9-3adf-aeff-7704a7bb9b6c",
                    "sense_definition": "Qualifie un système ou un programme informatique capable de fonctionner correctement même en cas d'erreurs ou de perturbations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs ont développé un logiciel <w>robuste</w> capable de traiter des données corrompues sans jamais planter."
                        },
                        {
                            "text": "Cette application doit être assez <w>robuste</w> pour supporter de nombreuses requêtes simultanées sans ralentissement."
                        }
                    ],
                    "synonyms": [
                        "fiable",
                        "stable"
                    ],
                    "antonyms": [
                        "instable",
                        "vulnérable"
                    ],
                    "common_phrases": [
                        "logiciel robuste",
                        "système robuste"
                    ]
                }
            ]
        }
    ]
}