                                "target_lang_sense_clarification": "money or resources"
                            },
                            {
                                "target_lang_word": "to have remaining",
                                "target_lang_sense_clarification": "formal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e737643-96f9-31c7-bc76-89743e76ea66",
                    "sense_definition": "iets behouden of vasthouden als een direct gevolg of overblijfsel van een eerdere gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft een nare blessure aan dat ongeluk <w>overgehouden</w>.",
                            "target_lang_translations": {
                                "en": "He <w>was left with</w> a nasty injury from that accident."
                            }
                        },
                        {
                            "text": "Ik heb een goed gevoel aan ons gesprek <w>overgehouden</w>.",
                            "target_lang_translations": {
                                "en": "I <w>gained</w> a good feeling from our conversation."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "iets overhouden aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to retain or be left with something as a direct result or consequence of a previous event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be left with",
                                "target_lang_sense_clarification": "a consequence or feeling"
                            },
                            {
