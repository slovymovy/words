                    "sense_id": "aae6cd83-e22e-37b7-be35-d9da1d2371c3",
                    "sense_definition": "bijzonder erg of schrikwekkend",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "negatieve_ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat <w>vreselijke</w> ongeval veroorzaakte verslagenheid alom.",
                            "target_lang_translations": {
