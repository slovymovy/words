                    {
                        "translation_id": "872ed6bc-4dff-49cd-86a7-fd180542d77e",
                        "source_entry_id": "a6bfb277-f01d-3d2d-9bd2-a76b59e5e4b7",
                        "source_sense_id": "5ef28aa9-32b9-3bf2-8596-326c84bdb54e",
                        "target_lang_word": "bonne nuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonne nuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "959773e3-38ac-3439-abf9-b701edec2ac2",
                                        "entry_id": "bca3bda8-a50f-3b22-b351-f11c68436a3f",
                                        "glosses": [
                                            "Se dit avant de se coucher pour souhaiter une bonne nuit à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e487e4fe-760a-44dd-8f29-97d0c4e9601f",
                                                "sense_id": "959773e3-38ac-3439-abf9-b701edec2ac2",
                                                "text": "Eh bien, bonne nuit Benoît, dit-elle en l’embrassant sur le front."
                                            },
                                            {
                                                "example_id": "dd91648b-191e-4aaa-9adc-14e5d3f05fc4",
                                                "sense_id": "959773e3-38ac-3439-abf9-b701edec2ac2",
                                                "text": "Bonne nuit, les enfants, faites de beaux rêves."
                                            },
                                            {
                                                "example_id": "e59a4b13-42c4-48fc-be0d-982096c3ef71",
                                                "sense_id": "959773e3-38ac-3439-abf9-b701edec2ac2",
                                                "text": "Madame Latour. — Allons ! bien bonne nuit, monsieur, madame."
                                            },
                                            {
                                                "example_id": "58c23b3c-61c7-4bdd-bcc6-8c4b615d4285",
                                                "sense_id": "959773e3-38ac-3439-abf9-b701edec2ac2",
                                                "text": "Il aurait été cinq heures, et tout le monde serait aux portes pour dire bonne nuit au jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a9e98b-2f3d-4308-9645-a770f0978621",
                        "source_entry_id": "a6bfb277-f01d-3d2d-9bd2-a76b59e5e4b7",
                        "source_sense_id": "5ef28aa9-32b9-3bf2-8596-326c84bdb54e",
                        "target_lang_word": "nuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e37f8f52-468d-3eae-8f65-9a21acbf942d",
                                        "entry_id": "a0b838eb-0044-3c8e-b287-1da533ba5879",
                                        "glosses": [
                                            "Période qui s’écoule entre le coucher de soleil et le lever du soleil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                        "entry_id": "a0b838eb-0044-3c8e-b287-1da533ba5879",
                                        "glosses": [
                                            "Période quotidienne durant laquelle le soleil est sous notre horizon et qu'il fait noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24194638-c873-4a7a-a389-8f5ecb9e3d38",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "Nous avions mis trois jours à l’œuvre, Varsovie n’eut besoin que d’une nuit, de la nuit du 29 novembre 1830 !"
                                            },
                                            {
                                                "example_id": "770f672e-b8a3-43a2-969d-890819fd31af",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "Pendant la nuit, cet Éden des malheureux, elle échappait aux ennuis, aux tracasseries qu’elle avait à supporter durant la journée."
                                            },
                                            {
                                                "example_id": "b2927379-1867-4f65-a18d-79b93a3f02fa",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "Mme, M. et Mlle Chapoulot étaient éveillés, ne pouvaient plus se rendormir, et faisaient observer que la journée était assez longue pour répéter les musiques de théâtre, et que, dans une maison du Marais, on ne devait pas toucher du forté pendant la nuit…"
                                            },
                                            {
                                                "example_id": "a37a140c-8d39-4635-b588-d5fff870a86d",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "La nuit vient de bonne heure au mois de février, et quand le futur beau-père et le futur gendre, qui étaient sortis ensemble du café, arrivèrent à la Madeleine, on allumait déjà les becs de gaz."
                                            },
                                            {
                                                "example_id": "3f088727-a8e4-466f-8c85-f1c1e6531517",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m’attends à du gros temps."
                                            },
                                            {
                                                "example_id": "dc195f7d-1eac-4557-b61f-4eda7f66c6bb",
                                                "sense_id": "b43e9e8c-9ade-34c1-bb26-80a36aebeac7",
                                                "text": "«Qui utilise vraiment la nuit? 100% des chauves-souris, 90% des amphibiens et 60% des insectes», peut-on lire sur l'une des diapositives de la présentation de Daniel Gliedner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                        "entry_id": "a0b838eb-0044-3c8e-b287-1da533ba5879",
                                        "glosses": [
                                            "Obscurité, ténèbres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c720875-db3a-4bbc-854f-641c9d44e4a8",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "[…] La vision photopique est la vision de jour par opposition à la vision scotopique qui est la vision de nuit."
                                            },
                                            {
                                                "example_id": "e292a836-b7a2-4ace-b07b-68a0d3568d1b",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "[…] dans la nuit, les pauvres arbres, sous l’effort du vent plus colère, gémissent et craquent."
                                            },
                                            {
                                                "example_id": "42dd6c93-05d0-40f3-8860-1d795d39ff35",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "[…] je vis tragiquement émerger de la nuit une étonnante masure en ruines à un étage, aux persiennes vermoulues et closes."
                                            },
                                            {
                                                "example_id": "575fa862-1a32-4ecc-8477-dd0c52ae3e8b",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "Je monte sur le pont et aperçois dans la nuit très noire les nombreuses lumières d’un vapeur qui s’éloigne."
                                            },
                                            {
                                                "example_id": "31c7e568-f73a-4c7d-97d8-a5e567b284f3",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "D’une lucarne, dans le haut du mur, je voyais la nuit s’éclaircir. J’entendis un coq chanter […]"
                                            },
                                            {
                                                "example_id": "edbf4a2f-6973-40e1-a386-2b3395765377",
                                                "sense_id": "20864145-9ba6-3f53-9a26-cedb09a8f101",
                                                "text": "Il entra dans la grotte et se trouva alors dans une nuit profonde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8eae6d2-fffe-3bcf-9bec-d586f805b36a",
                                        "entry_id": "a0b838eb-0044-3c8e-b287-1da533ba5879",
                                        "glosses": [
                                            "Symbole de destruction, d’oubli, de mort, de néant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "173c2315-e2f6-4c26-a585-1983f4bfc85e",
                                                "sense_id": "d8eae6d2-fffe-3bcf-9bec-d586f805b36a",
                                                "text": "La nuit éternelle."
                                            }
                                        ]
                                    }
                                ]
                            },
