                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The windows were <w>rattling</w> in their frames due to the strong wind.",
                            "target_lang_translations": {
                                "cs": "Okna v rámech <w>drnčela</w> kvůli silnému větru."
                            }
