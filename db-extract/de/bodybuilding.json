        "fr-extract.jsonl": [
            {
                "entry_id": "eb6bd872-4f3d-348d-8f7c-f59cc456c45b",
                "word": "Bodybuilding",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "788ebc95-0e02-3da1-a8b1-685adadcf230",
                        "entry_id": "eb6bd872-4f3d-348d-8f7c-f59cc456c45b",
                        "glosses": [
                            "Culturisme, bodybuilding, sport consistant en la modélisation du corps par des exercices musculaires, en règle générale, en utilisant des appareils de fitness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932113e7-322e-4a35-87f4-b652cb94da8b",
                                "sense_id": "788ebc95-0e02-3da1-a8b1-685adadcf230",
                                "text": "Durch das Bodybuilding werden die Körpermuskel gestärkt und vergrößert. — Par le culturisme, les muscles du corps se renforcent et se développent."
                            }
                        ]
                    }
                ],
                "translations": [],
