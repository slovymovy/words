{
    "word_family": [
        "graph",
        "graphics",
        "graphically",
        "graphical"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02483530-5f0d-3112-9936-fb39b1693eeb",
                    "sense_definition": "Relating to visual art, especially involving drawing, engraving, or lettering.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>graphic</w> design at the art college.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>графический</w> дизайн в художественном колледже.",
                                "zh": "她决定在艺术学院学习<w>平面</w>设计。"
                            }
                        },
                        {
                            "text": "The author published a <w>graphic</w> novel about his childhood experiences.",
                            "target_lang_translations": {
                                "ru": "Автор опубликовал <w>графический</w> роман о своих детских переживаниях.",
                                "zh": "作者出版了一部关于自己童年经历的<w>图像</w>小说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visual",
                        "pictorial"
                    ],
                    "common_phrases": [
                        "graphic design",
                        "graphic novel",
                        "graphic arts",
                        "graphic artist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к изобразительному искусству, особенно к рисованию, гравюре или начертанию букв.",
                        "zh": "与视觉艺术有关，尤指涉及绘画、版画、刻印或字体设计的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "графи́ческий",
                                "target_lang_sense_clarification": "относящийся к графике как виду искусства"
                            },
                            {
                                "target_lang_word": "изобрази́тельный",
                                "target_lang_sense_clarification": "относящийся к визуальному искусству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平面的",
                                "target_lang_sense_clarification": "用于平面设计、版面与视觉传达"
                            },
                            {
                                "target_lang_word": "图形艺术的",
                                "target_lang_sense_clarification": "与绘图、刻印、字体设计等图形艺术有关"
                            },
                            {
                                "target_lang_word": "图像的",
                                "target_lang_sense_clarification": "与图像表现有关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b35688b-5f55-3a9e-9f65-b5cb19dc3a67",
                    "sense_definition": "Described in very clear and vivid detail, often referring to unpleasant or shocking subjects like violence or sex.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news report contained <w>graphic</w> images of the battlefield.",
                            "target_lang_translations": {
                                "ru": "Новостной репортаж содержал <w>натуралистичные</w> изображения с поля боя.",
                                "zh": "这则新闻报道包含战场上<w>触目惊心</w>的画面。"
                            }
                        },
                        {
                            "text": "He gave a <w>graphic</w> account of the accident to the police officers.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>живописное</w> описание аварии полицейским.",
                                "zh": "他向警察详细而<w>生动</w>地讲述了这起事故。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explicit",
                        "vivid",
                        "realistic",
                        "detailed"
                    ],
                    "antonyms": [
                        "vague",
                        "implicit"
                    ],
                    "common_phrases": [
                        "graphic detail",
                        "graphic violence",
                        "graphic content",
                        "graphic description"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описанный очень ясно и детально, часто в отношении неприятных или шокирующих тем (насилия, секса).",
                        "zh": "描写得非常清楚、生动而具体，常用于令人不适或震惊的题材，如暴力或性内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натуралисти́чный",
                                "target_lang_sense_clarification": "откровенный, изображающий неприятные детали"
                            },
                            {
                                "target_lang_word": "живопи́сный",
                                "target_lang_sense_clarification": "яркий, образный (об описании)"
                            },
                            {
                                "target_lang_word": "нагля́дный",
                                "target_lang_sense_clarification": "отчетливый, очевидный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触目惊心的",
                                "target_lang_sense_clarification": "画面或内容令人震惊、直白，常涉及暴力或血腥"
                            },
                            {
                                "target_lang_word": "生动详细的",
                                "target_lang_sense_clarification": "描写清楚而逼真"
                            },
                            {
                                "target_lang_word": "露骨的",
                                "target_lang_sense_clarification": "内容直白露骨，不过多遮掩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e67942c8-84df-3602-b0a2-d70dba4f5985",
                    "sense_definition": "Having a texture that resembles writing, commonly found in igneous rocks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist identified the stone by its unique <w>graphic</w> texture.",
                            "target_lang_translations": {
                                "ru": "Геолог определил камень по его уникальной <w>графической</w> текстуре.",
                                "zh": "地质学家根据这种石头独特的<w>文象</w>结构辨认出了它。"
                            }
                        },
                        {
                            "text": "We examined a sample of <w>graphic</w> granite under the microscope.",
                            "target_lang_translations": {
                                "ru": "Мы рассмотрели образец <w>письменного</w> гранита под микроскопом.",
                                "zh": "我们在显微镜下观察了一块<w>文象</w>花岗岩样本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "graphic granite",
                        "graphic texture"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "geology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий текстуру, напоминающую письмена (обычно о горных породах, например, граните).",
                        "zh": "具有类似文字状纹理的，常见于火成岩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пи́сьменный",
                                "target_lang_sense_clarification": "геологический термин (напр. письменный гранит)"
                            },
                            {
                                "target_lang_word": "графи́ческий",
                                "target_lang_sense_clarification": "имеющий узор, похожий на буквы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文象的",
                                "target_lang_sense_clarification": "地质学术语，指像文字或楔形笔画一样的纹理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a618014e-44c8-3e0c-8547-b19d55bd073b",
                    "sense_definition": "A visual representation, such as a drawing, chart, or photograph, used to illustrate something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_rep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article included a helpful <w>graphic</w> showing the population growth.",
                            "target_lang_translations": {
                                "ru": "Статья включала полезный <w>график</w>, показывающий рост населения.",
                                "zh": "这篇文章附了一幅展示人口增长的实用<w>图表</w>。"
                            }
                        },
                        {
                            "text": "Please insert a <w>graphic</w> to make the presentation more engaging.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вставьте <w>иллюстрацию</w>, чтобы сделать презентацию более интересной.",
                                "zh": "请插入一张<w>图片</w>，让演示更吸引人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "illustration",
                        "diagram",
                        "image",
                        "picture",
                        "visual",
                        "chart"
                    ],
                    "common_phrases": [
                        "info graphic",
                        "vector graphic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальное изображение, такое как рисунок, схема или фотография, используемое для иллюстрации чего-либо.",
                        "zh": "用于说明某事的视觉呈现，如图画、图表或照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстра́ция",
                                "target_lang_sense_clarification": "поясняющее изображение в тексте"
                            },
                            {
                                "target_lang_word": "рису́нок",
                                "target_lang_sense_clarification": "изображение, выполненное художником"
                            },
                            {
                                "target_lang_word": "график",
                                "target_lang_sense_clarification": "диаграмма или схема"
                            },
                            {
                                "target_lang_word": "изображе́ние",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图表",
                                "target_lang_sense_clarification": "用于说明内容的图示或图像"
                            },
                            {
                                "target_lang_word": "插图",
                                "target_lang_sense_clarification": "书刊、文章等中的配图"
                            },
                            {
                                "target_lang_word": "图片",
                                "target_lang_sense_clarification": "泛指视觉图像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bed6a44-51b2-39ea-985c-f5d7f79cc65f",
                    "sense_definition": "A computer-generated image or visual display used in video games, films, or software.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_rep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This single <w>graphic</w> took the computer several hours to render.",
                            "target_lang_translations": {
                                "ru": "Рендеринг этого единственного <w>изображения</w> занял у компьютера несколько часов.",
                                "zh": "这张<w>图像</w>就让电脑渲染了好几个小时。"
                            }
                        },
                        {
                            "text": "The new video game features a stunning 3D <w>graphic</w> environment.",
                            "target_lang_translations": {
                                "ru": "Новая видеоигра отличается потрясающей средой с трехмерной <w>графикой</w>.",
                                "zh": "这款新电子游戏拥有令人惊艳的三维<w>图形</w>环境。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer graphic",
                        "3D graphic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерное изображение или визуальное отображение, используемое в видеоиграх, фильмах или программном обеспечении.",
                        "zh": "用于电子游戏、电影或软件中的计算机生成图像或视觉显示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гра́фика",
                                "target_lang_sense_clarification": "собирательное, компьютерная графика"
                            },
                            {
                                "target_lang_word": "изображе́ние",
                                "target_lang_sense_clarification": "отдельный графический объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图像",
                                "target_lang_sense_clarification": "计算机生成的单个视觉对象或画面"
                            },
                            {
                                "target_lang_word": "图形",
                                "target_lang_sense_clarification": "尤指数字环境中的图形表现"
                            },
                            {
                                "target_lang_word": "画面",
                                "target_lang_sense_clarification": "电子游戏、软件等中的整体视觉效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "410a4010-7be6-3bfd-923c-29aa3a3fd2b0",
                    "sense_definition": "A moth of the subfamily Melipotini.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector was excited to find a rare <w>graphic</w> in the forest.",
                            "target_lang_translations": {
                                "ru": "Коллекционер был рад найти редкий <w>вид моли</w> в лесу.",
                                "zh": "收藏者很兴奋，因为他在森林里发现了一只罕见的<w>夜蛾</w>。"
                            }
                        },
                        {
                            "text": "We studied the wing pattern of the <w>graphic</w> during the biology class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали узор крыльев этой <w>моли</w> на уроке биологии.",
                                "zh": "生物课上，我们研究了这种<w>夜蛾</w>翅膀上的花纹。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "entomology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность моли подсемейства Melipotini.",
                        "zh": "Melipotini亚科的一种蛾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моль",
                                "target_lang_sense_clarification": "бабочка-моль подсемейства Melipotini"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夜蛾",
                                "target_lang_sense_clarification": "Melipotini亚科的一种蛾"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}