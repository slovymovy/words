                ],
                "senses": [
                    {
                        "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                        "entry_id": "8d95d329-eb28-35ea-be57-9343d7971f57",
                        "glosses": [
                            "Grad der Reinheit/Verunreinigung von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ae2d6b-f917-48a9-addb-a40b82d86858",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "„Die Seen und Flüsse der Schweiz weisen überwiegend eine hervorragende Wasserqualität auf.“"
                            },
                            {
                                "example_id": "5b51d7a4-c9f8-476e-ad11-38da875f2a37",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "„Die Wasserqualität ist hier genauso wichtig wie in einem herkömmlichen Schwimmbad und wird regelmäßig kontrolliert.“"
                            },
                            {
                                "example_id": "2947e022-a6bf-4dc7-a37f-bf2d6bf54d3a",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "„Erst in den 80er Jahren, nachdem die Wasserqualität wieder besser wurde, entwickelte sich das Rheinschwimmen zum Volkssport.“"
                            },
                            {
                                "example_id": "fac0b7d2-dcd3-4408-a831-dc0f9d585786",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "[Olympia 2024:] „Die Wasserqualität [der Seine], in dem am 8. und 9. August die Freiwasser-Wettkämpfe stattfinden sollen, bereitet den Organisatoren große Probleme.“"
                            },
                            {
                                "example_id": "d599e0ea-5e75-45b5-bcc0-2b04bdea12ce",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "„1,4 Milliarden Euro waren im Großraum Paris in den vergangenen Jahren in Kläranlagen und das Abwassersystem investiert worden, um die Wasserqualität zu verbessern.“"
                            },
                            {
                                "example_id": "9f72369e-ed3a-4ae0-81d9-e1d3fdade639",
                                "sense_id": "89d13223-a379-3fe1-a179-2e9603444032",
                                "text": "„Das Sommerwetter ist gut für die Wasserqualität des Hallwilersees: Weil es seit langer Zeit nicht mehr geregnet hat, sind weniger Nährstoffe im Wasser als sonst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
