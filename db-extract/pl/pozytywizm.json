                "forms": [],
                "senses": [
                    {
                        "sense_id": "91695426-dedb-384d-973e-06bf03a03e2f",
                        "entry_id": "a5b05c6d-17be-3405-9da2-16f97cea3d8e",
                        "glosses": [
                            "kierunek filozoficzny powstały we Francji w XIX wieku, rozumiejący naukę jako badanie faktów, a odrzucający wszelką metafizykę z myślenia naukowego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "022553ad-fe89-3eca-9d51-8e6f8a3ea5e6",
                        "entry_id": "a5b05c6d-17be-3405-9da2-16f97cea3d8e",
                        "glosses": [
                            "prąd umysłowy, literacki i społeczny w Polsce w latach 1863–1890, krytykujący romantyzm, propagujący zdobycze nauki i kult pracy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6377e37b-35fa-40cd-9712-f52f18ad349b",
                        "source_entry_id": "a5b05c6d-17be-3405-9da2-16f97cea3d8e",
                        "source_sense_id": "91695426-dedb-384d-973e-06bf03a03e2f",
                        "target_lang_word": "positivism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positivism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                        "entry_id": "efbdc25d-96ba-36aa-bf74-5e321342ddc6",
                                        "glosses": [
                                            "A doctrine that states that the only authentic knowledge is scientific knowledge, and that such knowledge can only come from positive affirmation of theories through strict scientific method, refusing every form of metaphysics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e1a54a-9854-4144-9ae4-972c0bd82623",
                                                "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                                "text": "The goal of positivism is to construct an objective, empirical and systematic foundation for knowledge. Given the above five tenets, it follows that positivists would hold that the world is composed of ‘facts’, or ‘sense data’ (or ‘atoms’)."
                                            },
                                            {
                                                "example_id": "062aae18-c6a9-4252-9815-361debccaab8",
                                                "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                                "text": "History, and its literary expression, narrative, were not scientific, and so did not deserve the attention that true sciences did. Only science could yield positive knowledge—hence the passion for positivism, and the origin of the term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489d102b-81e5-34aa-90db-deede540674f",
                                        "entry_id": "efbdc25d-96ba-36aa-bf74-5e321342ddc6",
                                        "glosses": [
                                            "A school of thought in jurisprudence in which the law is seen as separated from moral values; i.e. the law is posited by lawmakers (humans)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3e7413-ea83-42fc-ac0f-85a1dae73545",
                        "source_entry_id": "a5b05c6d-17be-3405-9da2-16f97cea3d8e",
                        "source_sense_id": "91695426-dedb-384d-973e-06bf03a03e2f",
                        "target_lang_word": "positivisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positivisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                        "entry_id": "5c951041-94ed-3641-b4a7-b9acba432881",
                                        "glosses": [
                                            "Système de philosophie positive, fondé par Auguste Comte, qui considère que le fondement de la connaissance repose sur l’observation et l’expérience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e47e7da4-e1e4-4d73-84ab-79fe26148957",
                                                "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                                "text": "À Londres, pays du positivisme, les femmes poussent néanmoins fort loin la manie de l’étrange et du mystérieux."
                                            },
                                            {
                                                "example_id": "a055dd37-e1af-48a4-a247-355664a14232",
                                                "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                                "text": "Comte lui avait ensuite donné des certitudes inébranlables dans l’ordre intellectuel, il s’en tenait à la logique, à la claire et décisive méthode du positivisme, hiérarchisant toutes les connaissances, rejetant les inutiles hypothèses métaphysiques, convaincu que par la science seule se résoudrait le problème humain, social et religieux."
                                            },
                                            {
                                                "example_id": "a1ee2f46-dfef-4cb2-9120-b50ac2e32e37",
                                                "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                                "text": "Comte lui avait ensuite donné des certitudes inébranlables dans l’ordre intellectuel, il s’en tenait à la logique, à la claire et décisive méthode du positivisme, hiérarchisant toutes les connaissances, rejetant les inutiles hypothèses métaphysiques, convaincu que par la science seule se résoudrait le problème humain, social et religieux."
                                            },
                                            {
                                                "example_id": "3db6b12c-28b6-4d04-91be-164560b07e77",
                                                "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                                "text": "Le positivisme est encore admiré par quelques Belges, les employés de l’Office du travail et le général André : ce sont gens qui comptent pour peu de chose dans le monde où l’on pense."
                                            },
                                            {
                                                "example_id": "84488a61-f21d-41a5-a3df-09aefff8d648",
                                                "sense_id": "72e495c4-d1f8-3f3a-aa0e-a0c98435fd1f",
                                                "text": "Ce combat pour l’élargissement des libertés corrige fortement, sinon dément, l’allégeance au positivisme dans laquelle on a si longtemps enfermé Ferry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cf015bb-9c22-431f-bc58-01e6e271ee61",
                        "source_entry_id": "a5b05c6d-17be-3405-9da2-16f97cea3d8e",
                        "source_sense_id": "91695426-dedb-384d-973e-06bf03a03e2f",
                        "target_lang_word": "Positivismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Positivismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c717aa4-35d9-34d4-81cf-a121e33b6fd0",
                                        "entry_id": "f6820807-858a-3b75-94d7-c5ca82f6e661",
                                        "glosses": [
                                            "philosophische Richtung, die nur Erfahrung/Tatsachen als philosophische Gegenstände akzeptiert und jegliche metaphysische Überlegungen als unnütz ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6dd789-a4a9-4fe5-8b93-bf52427851fd",
                                                "sense_id": "2c717aa4-35d9-34d4-81cf-a121e33b6fd0",
                                                "text": "„Es war nicht zuletzt der wissenschaftliche Positivismus des späten 19. Jahrhunderts, der die Erforscher außereuropäischer Regionen und Kulturen wieder zu Jägern und Sammlern werden ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
