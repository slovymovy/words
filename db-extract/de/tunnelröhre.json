                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d89c4d-5125-44e8-a1fb-7530ddbae8c9",
                                "sense_id": "69f69d0a-7f81-3d4e-b103-2a1e01db1450",
                                "text": "„Wegen fahrlässiger Tötung angeklagt sind der Fahrer jenes Lastwagens, der bei dem Inferno in Europas höchstem Berg am 24. März 1999 in der 11,6 Kilometer langen Tunnelröhre in Flammen aufgegangen war, sowie 15 weitere Beschuldigte.“"
                            },
                            {
                                "example_id": "15debe0f-7416-4f1f-b7b7-f770f04a55ef",
                                "sense_id": "69f69d0a-7f81-3d4e-b103-2a1e01db1450",
                                "text": "„Auf der 16 Kilometer langen Strecke von Faido bis zum Südportal in Bodio wurden die beiden Tunnelröhren von den Bohrmaschinen mit einem Durchmesser von 8,8 Metern statt der sonst üblichen 9,4 Meter ausgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
