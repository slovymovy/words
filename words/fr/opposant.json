                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a réparé avec soin le muscle <w>opposant</w> du pouce sectionné."
                        },
                        {
                            "text": "Une lésion de l'<w>opposant</w> du petit doigt empêche certains mouvements précis de la main."
                        }
                    ],
                    "common_phrases": [
                        "opposant du pouce"
                    ]
                }
            ]
        },
        {
