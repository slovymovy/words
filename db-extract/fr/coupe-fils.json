                        "glosses": [
                            "Outil, dispositif, destiné à couper des fils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86881b35-7d97-4d21-b619-c330e27ea4c7",
                                "sense_id": "5c04518d-725a-3067-b27f-7caff3a9615c",
                                "text": "De nombreuses pinces (généralement d'anciens modèles) sont munies sur le côté, au niveau de l'articulation, d'un coupe-fils destiné à sectionner de petits fils métalliques."
                            },
                            {
                                "example_id": "02074245-731f-4b91-9d12-c6a3e65bdcaa",
                                "sense_id": "5c04518d-725a-3067-b27f-7caff3a9615c",
                                "text": "Les machines à coudre possèdent en général une petite lame tranchante nommée coupe-fils et fixée non loin de l'aiguille, elle permet de trancher net le fil de couture."
                            },
                            {
                                "example_id": "74be16ef-cb2f-4185-9e4e-bfcdc8694425",
                                "sense_id": "5c04518d-725a-3067-b27f-7caff3a9615c",
                                "text": "Les pêcheurs à la ligne utilisent des coupe-fils pour le fil de pêche."
                            },
                            {
                                "example_id": "fd2aa964-a836-4c6a-8c00-7ede059a2fbf",
                                "sense_id": "5c04518d-725a-3067-b27f-7caff3a9615c",
                                "text": "Les électriciens ont de grosses cisailles nommées coupe-fils ou coupe-câbles."
                            },
                            {
                                "example_id": "0c791be3-da74-4823-8836-38cf998f208f",
                                "sense_id": "5c04518d-725a-3067-b27f-7caff3a9615c",
                                "text": "Les métiers à tisser ont un coupe-fils."
                            }
                        ]
