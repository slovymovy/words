                "senses": [
                    {
                        "sense_id": "69073dab-4256-3fdf-bb42-1aef9e6b38b5",
                        "entry_id": "910b46fe-6004-3156-840f-079e18d6b6a5",
                        "glosses": [
                            "Suppression des adhérences autour des tendons fléchisseurs, pratiquée afin de rétablir une course normale de ceux-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5ee2d2-4c4f-46a2-8485-9b8dc9257fc5",
                                "sense_id": "69073dab-4256-3fdf-bb42-1aef9e6b38b5",
                                "text": "Ce sont ces manœuvres de libération tendineuse ou ténolyse qui nous ont donné le beau et rapide succès de notre observation II."
                            },
                            {
                                "example_id": "9a8822f0-7742-4c8a-894e-4e164822bc33",
                                "sense_id": "69073dab-4256-3fdf-bb42-1aef9e6b38b5",
                                "text": "Nous avons vu que la rééducation des commandes est une condition préalable à la ténolyse."
                            },
                            {
                                "example_id": "1ed15db4-987e-4752-a4c8-a554615e3f00",
                                "sense_id": "69073dab-4256-3fdf-bb42-1aef9e6b38b5",
                                "text": "La formation et la persistance des adhérences postopératoires après réparation par suture ou greffes des tendons fléchisseurs restent un problème, malgré la mobilisation précoce. La ténolyse a fait la preuve de son efficacité, mais il s’agit d’une opération difficile dans ses indications et dans sa réalisation technique."
                            }
                        ]
                    }
                ],
