                ],
                "translations": [
                    {
                        "translation_id": "47c478a0-41c7-4008-91f5-8ecff53bab4b",
                        "source_entry_id": "b6f3665a-4dbd-3d36-992f-60c953cbcfc2",
                        "source_sense_id": "47e45df5-ede0-3a2a-b574-264e1b6e145a",
                        "target_lang_word": "Zicklein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zicklein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1586b01b-dbea-3039-a521-0ec8c20a8a39",
                                        "entry_id": "de272b4f-1b97-391d-88b9-bd88cff9b1b8",
                                        "glosses": [
                                            "junge Ziege"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2183b164-0ac4-4d07-9b35-e4e9567273b0",
                                                "sense_id": "1586b01b-dbea-3039-a521-0ec8c20a8a39",
                                                "text": "„In Wirklichkeit jedoch war sie fest entschlossen, sich nicht wie ein Zicklein an den Meistbietenden verkaufen zu lassen.“"
                                            },
                                            {
                                                "example_id": "7cb89c42-0fac-45d3-974e-8c39c3ada639",
                                                "sense_id": "1586b01b-dbea-3039-a521-0ec8c20a8a39",
                                                "text": "„Seit Monaten kursieren im Netz haarsträubende Berichte über angebliche Untaten von Flüchtlingen, die Mär von den geschlachteten Zicklein aus dem Streichelzoo ist nur eine davon.“"
                                            },
                                            {
                                                "example_id": "4e76d3e7-56ed-4829-bc8c-66e9c8b6fba4",
                                                "sense_id": "1586b01b-dbea-3039-a521-0ec8c20a8a39",
                                                "text": "„In einer Steuerliste des Jahres 1542 werden immerhin zehn Schweine (darunter drei Ferkel), fünf Kühe, neun Kälber und eine Ziege mit zwei Zicklein aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
