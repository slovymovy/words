                "senses": [
                    {
                        "sense_id": "6a5be20e-9e9c-3ee0-99e2-fd2605334bb9",
                        "entry_id": "80363ae4-17f2-347a-9e43-0d977cf44459",
                        "glosses": [
                            "Cépage donnant un raisin à gros grains rouge autrefois cultivé en Basses-Alpes, il n'est plus inscrit au registre des espèces autorisées. Toutefois ce nom est aussi parfois, selon les régions, synonyme de divers cépages à raisins noirs comme le quagliano et le calitor, ou blancs comme le colombaud qui sont des cultivars autorisés."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "f31ba961-e913-4424-aa93-b6f4284e5583",
                                "sense_id": "6a5be20e-9e9c-3ee0-99e2-fd2605334bb9",
                                "text": "On peut trouver le bouteillan blanc dans les vignobles suivants : Sud-ouest, Cognac, Bordeaux, Provence-corse, Rhône."
                            },
                            {
                                "example_id": "79af97b6-8e29-4e05-98e6-9fa67480583f",
                                "sense_id": "6a5be20e-9e9c-3ee0-99e2-fd2605334bb9",
                                "text": "Ces qualités seraient liées au sol et au choix ces cépages dont particulièrement le bouteillan."
                            }
                        ]
                    },
                    {
                        "sense_id": "58945480-6dbc-30bb-ad83-ea0a38070f4a",
                        "entry_id": "80363ae4-17f2-347a-9e43-0d977cf44459",
                        "glosses": [
                            "Variété d’olive originaire d'Aups en Provence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83206860-0b01-4b2a-9056-0ab8fbdc98f6",
                                "sense_id": "58945480-6dbc-30bb-ad83-ea0a38070f4a",
                                "text": "L'huile d'olive de bouteillan se fait à la mi-novembre alors que les olives sont encores tournantes."
                            }
                        ]
                    }
                ],
