            "senses": [
                {
                    "sense_id": "7194779c-e5e5-3ae4-9524-541ff7c28489",
                    "sense_definition": "een streep onder een woord of stuk tekst zetten om de aandacht erop te vestigen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderstrepen_letterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de nieuwe woorden met een pen <w>onderstrepen</w>.",
                            "target_lang_translations": {
                                "it": "Puoi <w>sottolineare</w> le nuove parole con una penna."
                            }
                        },
                        {
                            "text": "Hij had deze belangrijke zin zorgvuldig <w>onderstreept</w> in zijn nieuwe boek.",
                            "target_lang_translations": {
                                "it": "Aveva <w>sottolineato</w> attentamente questa frase importante nel suo nuovo libro."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderlijnen"
                    ],
                    "common_phrases": [
