                                "example_id": "8d8437b9-fbd2-42d4-9091-30ed7e73a83d",
                                "sense_id": "5d4a9889-743a-34ea-8a6f-912a6c58feed",
                                "text": "Hij heeft dat meermaals beweerd, maar nooit bewezen."
                            },
                            {
                                "example_id": "8a561554-0c5e-406f-aa5f-eed314710982",
                                "sense_id": "5d4a9889-743a-34ea-8a6f-912a6c58feed",
                                "text": "Harris reageert daarmee op uitspraken van John Kelly, de vroegere stafchef van Trump. Die zegt dat \"de algemene definitie van fascist van toepassing is op Trump\" en dat Trump meermaals beweerde \"dat Hitler ook enkele goede dingen gedaan heeft.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9fd722c-d18b-4421-8ed3-7ccd204ac87d",
                        "source_entry_id": "490110a0-e199-3809-8895-012305c5cacb",
