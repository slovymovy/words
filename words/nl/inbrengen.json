                    "sense_id": "c3010f27-2fe4-3e92-8fc0-7b0388bb0b99",
                    "sense_definition": "iets toevoegen of bijdragen aan een gezamenlijk doel, project of kapitaal",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bijdrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke partner moet een bepaald bedrag aan kapitaal <w>inbrengen</w> in de nieuwe onderneming.",
                            "target_lang_translations": {
                                "en": "Each partner must <w>contribute</w> a certain amount of capital to the new venture."
                            }
                        },
                        {
                            "text": "Zij kon veel expertise <w>inbrengen</w> tijdens de vergadering over het nieuwe project.",
                            "target_lang_translations": {
                                "en": "She was able to <w>bring</w> a lot of expertise <w>in</w> during the meeting about the new project."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijdragen",
                        "toevoegen",
                        "fourneren"
                    ],
                    "antonyms": [
                        "onttrekken"
                    ],
                    "common_phrases": [
                        "kapitaal inbrengen",
                        "expertise inbrengen",
                        "kennis inbrengen"
                    ],
                    "target_lang_definitions": {
                        "en": "to add or contribute something to a joint goal, project, or capital"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contribute",
                                "target_lang_sense_clarification": "to provide resources or effort"
                            },
                            {
