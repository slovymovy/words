                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c20a733c-4527-4fdf-8975-45c466df85b4",
                                "sense_id": "25f81de1-760d-32a2-8138-c3d0c9c552b1",
                                "text": "De computer wacht op invoer van de gebruiker.",
                                "translation": "The computer is waiting for input from the user.",
                                "english": "The computer is waiting for input from the user."
                            },
                            {
                                "example_id": "5345a76b-6295-4493-92ff-5c5ca1064204",
                                "sense_id": "25f81de1-760d-32a2-8138-c3d0c9c552b1",
                                "text": "Zorg ervoor dat je de juiste invoer geeft aan het programma.",
                                "translation": "Make sure you provide the correct input to the program.",
                                "english": "Make sure you provide the correct input to the program."
                            },
                            {
                                "example_id": "d82209cc-6af5-4377-8bf4-428f171d5fa8",
                                "sense_id": "25f81de1-760d-32a2-8138-c3d0c9c552b1",
                                "text": "Foutieve invoer kan leiden tot onverwachte resultaten.",
                                "translation": "Incorrect input can lead to unexpected results.",
                                "english": "Incorrect input can lead to unexpected results."
                            }
                        ]
                    },
                    {
                        "sense_id": "e348e881-e3ae-3c5c-b2f1-963715a94e91",
                        "entry_id": "f00e5ff4-4014-3ce6-b47d-7422c4acfa06",
