                ],
                "senses": [
                    {
                        "sense_id": "574867d5-f60c-34b8-b61c-bfc6c5635cf8",
                        "entry_id": "766521da-12ca-33b0-8d6c-f26dfdfddef8",
                        "glosses": [
                            "геогр. столица и город республиканского значения Киргизии, крупнейший город страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c3f951-d84b-4ecb-9b05-f57fac69c514",
                                "sense_id": "574867d5-f60c-34b8-b61c-bfc6c5635cf8",
                                "text": "Нечто подобное мне пришлось испытать и во время пребывания в Бишкеке, куда мы приехали от Международного союза музыкальных деятелей, чтобы участвовать в праздновании юбилея замечательного музыканта ― главного дирижёра симфонического оркестра Гостелерадио Киргизии Асанхана Джумахматова."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25e94c2-4fa8-4113-afaf-e95332048f1a",
                        "source_entry_id": "766521da-12ca-33b0-8d6c-f26dfdfddef8",
                        "source_sense_id": "574867d5-f60c-34b8-b61c-bfc6c5635cf8",
                        "target_lang_word": "Bishkek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bishkek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1766c5-8d8f-35a5-8cf1-db4c76e8d475",
                                        "entry_id": "014a765a-4184-3f13-bb5c-c2e86867f9b0",
                                        "glosses": [
                                            "The capital city of Kyrgyzstan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c6f1419-616a-43f7-9c4d-ff3651fddd22",
                        "source_entry_id": "766521da-12ca-33b0-8d6c-f26dfdfddef8",
                        "source_sense_id": "574867d5-f60c-34b8-b61c-bfc6c5635cf8",
                        "target_lang_word": "Bischkek",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bischkek",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9dd406-c0be-3808-9170-29a693a13511",
                                        "entry_id": "23b7eb01-5a03-3dd3-9c9a-bc852d5e0bae",
                                        "glosses": [
                                            "Hauptstadt Kirgisistans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d2dc2b-119c-4a84-a9bf-d61bf40bfc66",
                                                "sense_id": "eb9dd406-c0be-3808-9170-29a693a13511",
                                                "text": "„Bischkek liegt 800 m über dem Meeresspiegel am nördlichen Rand des bis zu 4875 m hohen Kirgisischen Gebirges, eines westlichen Teiles des Tianshan-Gebirges, welches der Stadt eine imposante Kulisse gibt.“"
                                            },
                                            {
                                                "example_id": "087af8b9-b080-4004-99b2-c027ef17d07b",
                                                "sense_id": "eb9dd406-c0be-3808-9170-29a693a13511",
                                                "text": "„Heute ist Bischkek eine lebhafte und in vieler Hinsicht moderne Stadt in Zentralasien, mit vielen Restaurants und Cafés und einem dichten Straßenverkehr, in dem zahllose Gebrauchtwagen aus Westeuropa und Überbleibseln aus sowjetischer Produktion unterwegs sind.“"
                                            },
                                            {
                                                "example_id": "232154b8-b02e-428e-b166-ad96022c2b9a",
                                                "sense_id": "eb9dd406-c0be-3808-9170-29a693a13511",
                                                "text": "Kirgisische Sicherheitskräfte sind gegen Oppositionelle vorgegangen, die in Bischkek gegen die Übergangsregierung demonstrieren wollten..“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f7fd8e4-a0a4-49b7-9a2f-68eca513bd8b",
                        "source_entry_id": "766521da-12ca-33b0-8d6c-f26dfdfddef8",
                        "source_sense_id": "574867d5-f60c-34b8-b61c-bfc6c5635cf8",
                        "target_lang_word": "Bichkek",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bichkek",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "013c5b84-4889-3be9-ab3a-3a692b33dc7d",
                                        "entry_id": "deeac648-e3ed-35f1-bbf4-b176a621736c",
                                        "glosses": [
                                            "Ville et capitale du Kirghizistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba55b45-f7de-4b9e-80e5-4974b1bdbac2",
                                                "sense_id": "013c5b84-4889-3be9-ab3a-3a692b33dc7d",
                                                "text": "C’est à Bichkek, au Kirghizistan, qu’aura lieu, le 15 septembre, la cérémonie de remise du prix de l’architecture de l’Aga Khan, un prix collectif partagé entre sept projets issus du monde musulman ou pensés pour la communauté musulmane."
                                            },
                                            {
                                                "example_id": "66c2be5f-cd05-4b95-acdf-b9940cfac847",
                                                "sense_id": "013c5b84-4889-3be9-ab3a-3a692b33dc7d",
                                                "text": "30/08 : Trois personnes ont été blessées après l’explosion d’une voiture positionnée devant l’ambassade de Chine à Bichkek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f5b07cf-4f11-3160-9be8-2bad1029d5f0",
                                        "entry_id": "deeac648-e3ed-35f1-bbf4-b176a621736c",
