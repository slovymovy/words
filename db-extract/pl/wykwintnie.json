                    },
                    {
                        "translation_id": "4bcc5082-7560-457d-a48e-fec8405dd8f4",
                        "source_entry_id": "76c8fc0c-5993-3e3b-8573-964b1e604050",
                        "source_sense_id": "f67fb7a0-a843-3e57-a0a5-61b04baf2e6b",
                        "target_lang_word": "elegant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elegant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "mit Stil und Chic, modisch und geschmackvoll gekleidet und frisiert"
                                        ],
                                        "tags": [
                                            "meist mit dem Fokus auf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3534f401-bdac-4a78-8596-62687bc24292",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Sie trägt einen eleganten Mantel."
                                            },
                                            {
                                                "example_id": "d00d2065-a2e8-488a-8c62-26e2b3664cf7",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Die Prinzessin galt zu ihrer Zeit als eine der elegantesten Frauen weltweit."
                                            },
                                            {
                                                "example_id": "dff83727-c10c-4986-b8a0-ad0e6020b7e5",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Er zeichnet sich durch einen eleganten Laufstil aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "auf gewandte, geschickte Weise zustandegekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d9b968-a345-4c09-9d9a-9b85de4448b4",
                                                "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                                "text": "Da hast du aber noch mal ganz elegant die Kurve gekriegt."
                                            },
                                            {
                                                "example_id": "8293dd07-bc4e-45f0-843d-f6e8fb4b3af7",
                                                "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                                "text": "Letztlich wurde das Problem dann ganz elegant gelöst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "auf eine feine und meist kultivierte Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92058cbc-a4f2-46b6-8e28-fcd71d39e861",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Das Essen findet in einem eleganten Restaurant statt."
                                            },
                                            {
                                                "example_id": "273d42fa-9e71-41e4-bfb5-bd5ee3183766",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Sie lächelte und zuckte elegant mit den Schultern."
                                            },
                                            {
                                                "example_id": "5023066f-d9c4-41e1-90bd-1a91594be0ad",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Es ist eine Freude zuzuhören, denn er findet immer so elegante Formulierungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3538a9b0-c0dc-47bd-94bb-3f76f8315a28",
                        "source_entry_id": "76c8fc0c-5993-3e3b-8573-964b1e604050",
                        "source_sense_id": "f67fb7a0-a843-3e57-a0a5-61b04baf2e6b",
                        "target_lang_word": "vorzüglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorzüglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a41492e-8cce-386d-b6ce-b15c08fa352e",
                                        "entry_id": "45b9fa42-e530-3fb3-9ba7-95c5e7a58f69",
                                        "glosses": [
                                            "besonders gut; sehr gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f6304e-c4d1-4350-a1f3-7046bf77b677",
                                                "sense_id": "2a41492e-8cce-386d-b6ce-b15c08fa352e",
                                                "text": "Der Sommelier hat einen vorzüglichen Wein ausgesucht."
                                            },
                                            {
                                                "example_id": "f9ea6f4a-c306-4499-b28b-b5bb45440381",
                                                "sense_id": "2a41492e-8cce-386d-b6ce-b15c08fa352e",
                                                "text": "Mein Siebeck'sches Weihnachtsmenü sah als Dessert ein Zimtparfait mit in Burgunder eingelegten Backpflaumen vor und schmeckte ganz vorzüglich."
                                            },
                                            {
                                                "example_id": "67d3ab95-5d71-403d-b9cd-afcabde3d61e",
                                                "sense_id": "2a41492e-8cce-386d-b6ce-b15c08fa352e",
                                                "text": "„Pückler ist ein glänzender Beobachter, was ihn zum vorzüglichen Prosaschriftsteller macht.“"
                                            },
                                            {
                                                "example_id": "5c468616-0dd7-44a4-bcbd-ebe6700cb96e",
                                                "sense_id": "2a41492e-8cce-386d-b6ce-b15c08fa352e",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
