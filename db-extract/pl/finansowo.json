                                            {
                                                "example_id": "493433d5-5ddf-4511-ae6a-e58224705e33",
                                                "sense_id": "133055d6-f141-3ac1-9982-b0b9e3e36641",
                                                "text": "Het inspectierapport, dat onder meer concludeert dat er sprake is van financieel wanbeheer op de school, vormt de belangrijkste onderbouwing voor Slobs vordering dat het bestuur moet opstappen."
                                            },
                                            {
                                                "example_id": "1ee487e7-93fa-4ded-b1e3-927fe6d30a76",
                                                "sense_id": "133055d6-f141-3ac1-9982-b0b9e3e36641",
                                                "text": "Meneer Wang heeft nadrukkelijk verklaard dat het in zijn intenties ligt het hotel in zijn oude luister te herstellen, waarbij de financiële armslag waarover hij naar het zich laat aanzien beschikt zeer zeker van pas zal komen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3c78c98-6635-4692-b029-2a9d30d41a10",
                        "source_entry_id": "9ebc2fbf-998f-3885-b215-83ea857729f9",
                        "source_sense_id": "8f72d8b2-76b9-3c24-9466-ab0843d5be72",
