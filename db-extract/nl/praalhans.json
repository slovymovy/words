                ],
                "senses": [
                    {
                        "sense_id": "718ce1b1-8fce-33b6-9c5c-cc2ed3301766",
                        "entry_id": "ce518b81-f0b2-3de4-a6bd-87196829c5ca",
                        "glosses": [
                            "opschepper, snoever"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bdd75258-5db1-4976-bec5-9950b0c3410c",
                                "sense_id": "718ce1b1-8fce-33b6-9c5c-cc2ed3301766",
                                "text": "Terwijl ik gedachteloos aardappelpuree naar binnen lepelde, blies ik op trumpdonald.org met een trompet Donald Trumps sluike peroxidehaar in kapsels waar Johnny Rottens groenezeepstekels bij zouden verbleken. Dat zal die praalhans leren, dacht ik, terwijl ik zijn mondhoeken omlaag trompette en snuiflachend een spruitje op mijn vork prikte."
                            },
                            {
                                "example_id": "5262c9f7-00bb-409a-bd1d-3ded15b9bdf7",
                                "sense_id": "718ce1b1-8fce-33b6-9c5c-cc2ed3301766",
                                "text": "Soms zie je een praalhans in een duur pak, maar meestal is het net of de gasten zijn gekleed door het rampenfonds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d5dc70e-2597-4fac-9581-3e07027697a7",
                        "source_entry_id": "ce518b81-f0b2-3de4-a6bd-87196829c5ca",
                        "source_sense_id": "718ce1b1-8fce-33b6-9c5c-cc2ed3301766",
                        "source_sense_description": "opschepper, snoever",
                        "target_lang_word": "braggart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                        "entry_id": "d4263855-a5b4-3026-8f30-e680ffd76e90",
                                        "glosses": [
                                            "Someone who constantly brags or boasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ee1c6c-31ca-432b-a027-b58643e30774",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "O I could play the woman with mine eyes, / And Braggart with my tongue."
                                            },
                                            {
                                                "example_id": "8c28d36b-c048-4b66-bfc6-354dfea54a86",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "Shallow water gives a great splash, and so a braggart has ever been contemptible in my eyes."
                                            },
                                            {
                                                "example_id": "a0252817-6318-4df5-bf66-61e17cd51ecd",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "A very good resolve to make and keep, if you would also keep any friends you make, is never to speak of anyone without, in imagination, having them overhear what you say. One often hears the exclamation “I would say it to her face!” At least be very sure that this is true, and not a braggart’s phrase and then—nine times out of ten think better of it and refrain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                        "entry_id": "861e2e01-a1f5-3da6-9ac2-773aa61cf329",
                                        "glosses": [
                                            "Characterized by boasting; boastful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1db0ef-a178-4608-a7ea-1eb19c556420",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "O my fair Mistress, Truth! Shall I quit thee, / For huffing, braggart, puft Nobility?"
                                            },
                                            {
                                                "example_id": "ebb6c33c-8136-4fda-81ff-ca2f33315b95",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "Captain [Benjamin] Bonneville was delighted with the game look of these cavaliers of the mountains, welcomed them heartily to his camp, and ordered a free allowance of grog to regale them, which soon put them in the most braggart spirits."
                                            },
                                            {
                                                "example_id": "22616bb0-e631-4830-8ad3-c9cdce94b965",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "He took him on the long walks of which he was fond, and made him in some sort his humble confidant, talking to him of himself and his plans with large and braggart vagueness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb4a46e6-36f6-4f1d-b16d-ba684a9a1b6e",
                        "source_entry_id": "ce518b81-f0b2-3de4-a6bd-87196829c5ca",
                        "source_sense_id": "718ce1b1-8fce-33b6-9c5c-cc2ed3301766",
                        "source_sense_description": "opschepper, snoever",
                        "target_lang_word": "swaggerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swaggerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc09318c-a0a4-3c2b-9b46-59a6a2a09ae7",
                                        "entry_id": "315ab15a-3e2c-391b-82e8-a8547ce374d6",
                                        "glosses": [
                                            "One who swaggers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "defb2495-2c74-4b19-ba6d-edf8d7d56508",
                                                "sense_id": "fc09318c-a0a4-3c2b-9b46-59a6a2a09ae7",
                                                "text": "He was […] none of your audacious young swaggerers, who would even penetrate into the bar—that solemn sanctuary—and, smiting old John upon the back, inquire if there was never a pretty girl in the house, and where he hid his little chambermaids, with a hundred other impertinencies of that nature; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
