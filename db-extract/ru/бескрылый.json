                                        "sense_id": "dba7f414-9c27-3886-819e-be84510abc5d",
                                        "entry_id": "1b5d2afd-3b82-3b99-bcca-d0e1db5b4658",
                                        "glosses": [
                                            "zonder vleugels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ddd246-df0c-48b8-8729-183e82e2a600",
                                                "sense_id": "dba7f414-9c27-3886-819e-be84510abc5d",
                                                "text": "Een vleugelloos lieveheersbeestje moet het nieuwe biologische wapen worden tegen bladluizenplagen in de glastuinbouw. Onderzoekers in Wageningen en Leiden experimenteren met een tweestippelig lieveheersbeestje dat door een natuurlijke mutatie zijn vleugels en een groot deel van het dekschild mist."
                                            }
