                        "cross_references": [
                            {
                                "target_word": "detailliert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d58ff968-2f11-31c8-a5e2-33f8fc0d192f",
                                        "entry_id": "11aebf0a-c541-3ce4-95a3-c786c4e36112",
                                        "glosses": [
                                            "sehr genau; sehr ausführlich, mit vielen Einzelheiten (Details)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e42031c-115b-46a7-8d93-3c7d255d6d37",
                                                "sense_id": "d58ff968-2f11-31c8-a5e2-33f8fc0d192f",
                                                "text": "Aufschluss gibt erst eine detaillierte Aufstellung."
                                            },
                                            {
                                                "example_id": "a48f9851-8b99-4180-86fe-a3128fd99852",
                                                "sense_id": "d58ff968-2f11-31c8-a5e2-33f8fc0d192f",
                                                "text": "2005 waren auf einem verlassenen Übungsgelände der inzwischen aufgelösten Nationalpolizei zufällig rund 80 Millionen Dokumente entdeckt worden, die die Verfolgung, Bespitzelung, Folter, Ermordung und das Verschwindenlassen von zigtausenden Menschen während des Bürgerkriegs in Guatemala detailliert belegen."
                                            },
                                            {
                                                "example_id": "3d4a3fea-ea41-42b1-a9b0-e5170dd60dc5",
                                                "sense_id": "d58ff968-2f11-31c8-a5e2-33f8fc0d192f",
                                                "text": "Bis heute seien Kirchenvertreter gehalten, bei verstorbenen Priestern und bei solchen, deren Tat mehr als zehn Jahre zurückliegt, \"den Teil der Akte zu vernichten, der detailliert beschreibt, was vorgefallen ist\", sagte Pfeiffer der Deutschen Welle."
                                            },
                                            {
                                                "example_id": "545f0001-023f-4971-8876-360aeb466614",
                                                "sense_id": "d58ff968-2f11-31c8-a5e2-33f8fc0d192f",
                                                "text": "Auf 17 Seiten listet ihr Prüfbericht detailliert auf, wo Taiwans Gesetze und Regelungen das selbstgesteckte Ziel der internationalen Menschenrechts-Standards noch verfehlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
