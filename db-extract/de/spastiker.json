                "senses": [
                    {
                        "sense_id": "c7d1962b-d8e0-3320-9e74-70ee87fc1c5b",
                        "entry_id": "b641b5cd-6749-3d9d-8f8e-c839c7bb956c",
                        "glosses": [
                            "Person, die unter Krämpfen (Spasmen) leidet, einer motorischen Erkrankung (Spastik)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98548db2-ef63-454b-95b9-98bb2bc6a978",
                                "sense_id": "c7d1962b-d8e0-3320-9e74-70ee87fc1c5b",
                                "text": "„Die Folge davon sind bleibende körperliche und geistige Schädigungen. Der Junge, der auf den Namen Markus getauft wurde, ist ein Spastiker. Er wird nie ein einigermaßen normales Leben führen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2122ddc5-209c-379f-8cdd-07161c75d301",
                        "entry_id": "b641b5cd-6749-3d9d-8f8e-c839c7bb956c",
                        "glosses": [
                            "Person, die sich ungeschickt oder dumm anstellt"
                        ],
                        "tags": [
                            "Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "c15e76c6-672b-41e0-b06b-b84bd0b8a433",
                                "sense_id": "2122ddc5-209c-379f-8cdd-07161c75d301",
                                "text": "Der Spastiker jetzt wieder! Wer kann sich solch einen Schwachsinn ausdenken!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
