        "fr-extract.jsonl": [
            {
                "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                "word": "somatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ebe0b62-c7c8-4b6e-934d-f72476177dd1",
                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "somatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                        "glosses": [
                            "Relatif au corps dans sa dimension physique, par opposition à sa dimension psychique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d43102-6943-46a3-a8e3-869e70baf0d4",
                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                "text": "Les violences et maltraitances, somatiques et/ou psychiques, ne sont en effet pas toutes et pas nécessairement, tant s'en faut, à rapporter à des relations d'emprise."
                            },
                            {
                                "example_id": "ec1df4f2-b55e-42ac-aa4d-e4e3bd41deba",
                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                "text": "Ici, les adolescents souffrant de TCA et d’obésité sont pris en charge de manière pluridisciplinaire (somatique et psychique), en consultation, en hospitalisation complète ou de jour, de manière individuelle, familiale, groupale en fonction des besoins, précise le Pʳ Marie Rose Moro, chef de service."
                            }
                        ]
                    },
                    {
                        "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                        "glosses": [
                            "Relatif au soma, aux cellules non reproductrices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a0e6c7a-bd6c-4416-8336-43e9de67ec81",
                                "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                                "text": "Une majorité de chercheurs semblent d’accord sur l’essentiel : s’engager à ne pas toucher au génome de l’embryon humain, ni aux cellules reproductrices, et se limiter à corriger les gènes porteurs de maladies génétiques graves situés dans les cellules somatiques, c’est-à-dire non sexuelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b788c72-78ca-304d-84d1-9a4b96c30989",
                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                        "glosses": [
                            "Relatif au contrôle volontaire des mouvements du corps et à la perception des stimuli externes via des récepteurs spécifiques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b33f0244-53e5-43fe-91ad-52e431069734",
                        "source_entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                        "source_sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                        "target_lang_word": "somatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                        "entry_id": "86ab5ef6-bb70-3ef4-9358-9e318cb28c62",
                                        "glosses": [
                                            "den Körper betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143d7fde-89f2-4b2e-b4c5-6a0a54665f8a",
                                                "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                                "text": "Ihr Unwohlsein hat keine somatischen Ursachen."
                                            },
                                            {
                                                "example_id": "e3065fe3-9568-4ca0-8a01-d69285bb3319",
                                                "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                                "text": "„Zahnärzte sind gefordert, ihre Diagnosen und Therapien nicht nur aus fachbegrenzt somatischer Sicht zu sehen, sondern auch allgemeinmedizinische, psychische und soziale Faktoren der Krankheit zu berücksichtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2897c02-dcca-3316-b790-3e9650e5b4f0",
                                        "entry_id": "86ab5ef6-bb70-3ef4-9358-9e318cb28c62",
                                        "glosses": [
                                            "zum Körper gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d869dcf-a634-439d-96d5-e83b9fb75814",
                                                "sense_id": "f2897c02-dcca-3316-b790-3e9650e5b4f0",
                                                "text": "Fortpflanzungszellen und somatische Zellen unterscheiden sich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
