                "senses": [
                    {
                        "sense_id": "7a1087af-8882-31fe-9c8a-23e2429bc754",
                        "entry_id": "eb4a44ab-4408-3312-a1a8-3cfd7deeae9c",
                        "glosses": [
                            "Pièce de monnaie en usage en Russie, centième partie du rouble ; en Biélorussie, centième partie du rouble ; et en Ukraine, centième partie du hryvnia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80586f04-8ae4-464b-934d-4496ffc5f8ae",
                                "sense_id": "7a1087af-8882-31fe-9c8a-23e2429bc754",
                                "text": "Une pièce de cinq kopecks."
                            },
                            {
                                "example_id": "b8b0bd92-ac00-4eb5-9755-4d61e95ce5cb",
                                "sense_id": "7a1087af-8882-31fe-9c8a-23e2429bc754",
                                "text": "Il tira une pièce d’un kopeck de sa poche et la plaça en équilibre sur l’extrémité de son pouce."
                            },
                            {
                                "example_id": "2d724243-9268-45dc-8512-a416e15d0297",
                                "sense_id": "7a1087af-8882-31fe-9c8a-23e2429bc754",
                                "text": "Celui-là est à quarante-cinq kopecks l’archine mais, excusez du peu, ce n’est pas la même qualité !"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c05f954-0bea-3443-8fee-e386376f292a",
                        "entry_id": "eb4a44ab-4408-3312-a1a8-3cfd7deeae9c",
                        "glosses": [
                            "Par extension, toute petite somme d'argent (souvent dans une phrase négative)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7a8bc285-c5c8-45c7-bc79-0b1363178776",
                                "sense_id": "6c05f954-0bea-3443-8fee-e386376f292a",
                                "text": "Sans un kopeck\n— Mot qui nous vient de Russie —\nSans un kopeck\nJ'peux pas faire des folies"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56e3d715-d771-40a7-aafb-d60ffa29cc1d",
                        "source_entry_id": "eb4a44ab-4408-3312-a1a8-3cfd7deeae9c",
