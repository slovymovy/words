                ],
                "senses": [
                    {
                        "sense_id": "b8ad28af-d05d-31a5-9ec7-d1bb2a088911",
                        "entry_id": "8fc30a75-048a-3b5a-8a7e-f5a63c445fe7",
                        "glosses": [
                            "Participation, succès, approbation de gens par intérêt commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9a43e3-a0b8-4a94-89ee-382b0a6b29df",
                                "sense_id": "b8ad28af-d05d-31a5-9ec7-d1bb2a088911",
                                "text": "In der Nachkriegszeit fand der Kommunismus einen beträchtlichen Zulauf.",
                                "translation": "Dans l'après-guerre, le communisme avait un succès important."
                            },
                            {
                                "example_id": "b7a44c8c-184f-4967-af0d-530af3befcd6",
                                "sense_id": "b8ad28af-d05d-31a5-9ec7-d1bb2a088911",
                                "text": "Dieser Park findet immer grossen Zulauf als Entspannungsort.",
                                "translation": "Ce parc a toujours un grand succès en tant que lieu de détente."
                            }
                        ]
                    },
                    {
                        "sense_id": "faa7df43-c40b-3e62-9fd5-42c402f24859",
                        "entry_id": "8fc30a75-048a-3b5a-8a7e-f5a63c445fe7",
                        "glosses": [
                            "Apport de fluide (liquide ou gaz), débit entrant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdde7ba6-6089-47bf-8d0e-fa48d4160540",
                                "sense_id": "faa7df43-c40b-3e62-9fd5-42c402f24859",
                                "text": "Bei starkem Regen wird die Kläranlage durch den resultierenden massiven Zulauf oft überlastet.",
                                "translation": "En cas de fortes pluies, la station d'épuration est souvent surchargée par le fort débit entrant résultant."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8a17c3d-8905-3a5c-9479-6f0e830e84ee",
                        "entry_id": "8fc30a75-048a-3b5a-8a7e-f5a63c445fe7",
                        "glosses": [
                            "Admission, lieu où un débit entrant est amené dans une installation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "085ec6f8-db9a-4f11-82db-ac641d618da8",
                                "sense_id": "e8a17c3d-8905-3a5c-9479-6f0e830e84ee",
                                "text": "Der Zulauf der Pumpe ist verstopft.",
                                "translation": "L'admission de la pompe est bouchée."
                            }
                        ]
                    }
                ],
