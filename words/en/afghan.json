{
    "word_family": [
        "Afghanistan",
        "Afghani"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "450c72ad-d24d-3534-bc87-6120b64014c6",
                    "sense_definition": "Of, from, or relating to the country of Afghanistan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nationality_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Afghan</w> government has implemented new policies to improve education.",
                            "target_lang_translations": {
                                "ru": "<w>Афганское</w> правительство внедрило новую политику для улучшения образования.",
                                "zh": "<w>阿富汗</w>政府已实施新政策以改善教育。"
                            }
                        },
                        {
                            "text": "We enjoyed a delicious meal at a local <w>Afghan</w> restaurant last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы наслаждались вкусным ужином в местном <w>афганском</w> ресторане.",
                                "zh": "昨晚我们在一家当地的<w>阿富汗</w>餐厅享用了美味的一餐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Afghan refugee",
                        "Afghan war",
                        "Afghan culture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Афганистану или происходящий из этой страны.",
                        "zh": "与阿富汗这个国家有关的或来自该国的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афганский",
                                "target_lang_sense_clarification": "относящийся к стране"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗的",
                                "target_lang_sense_clarification": "形容词，指代国家"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cd56d6a-2857-3cc4-87dd-488608d0644e",
                    "sense_definition": "Of, from, or pertaining to the Pashtun ethnic community.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ethnicity_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed traditional <w>Afghan</w> jewelry from the Pashtun tribes.",
                            "target_lang_translations": {
                                "ru": "В музее были выставлены традиционные <w>афганские</w> украшения пуштунских племен.",
                                "zh": "博物馆展出了来自普什图部落的传统<w>阿富汗</w>首饰。"
                            }
                        },
                        {
                            "text": "Scholars studied the <w>Afghan</w> dialects spoken in the border regions.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали <w>афганские</w> диалекты, на которых говорят в приграничных районах.",
                                "zh": "学者们研究了边境地区使用的<w>阿富汗</w>方言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Pashtun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к пуштунской этнической общности.",
                        "zh": "与普什图族群有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуштунский",
                                "target_lang_sense_clarification": "этнический"
                            },
                            {
                                "target_lang_word": "афганский",
                                "target_lang_sense_clarification": "в значении «пуштунский»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普什图族的",
                                "target_lang_sense_clarification": "民族属性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e98bb61a-fd78-3e6d-98a4-76109ef90978",
                    "sense_definition": "A native or inhabitant of Afghanistan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Afghans</w> have moved abroad to seek better opportunities for their families.",
                            "target_lang_translations": {
                                "ru": "Многие <w>афганцы</w> переехали за границу в поисках лучших возможностей для своих семей.",
                                "zh": "许多<w>阿富汗人</w>移居国外，为家人寻求更好的机会。"
                            }
                        },
                        {
                            "text": "He is a proud <w>Afghan</w> who enjoys sharing stories about his homeland.",
                            "target_lang_translations": {
                                "ru": "Он гордый <w>афганец</w>, которому нравится рассказывать истории о своей родине.",
                                "zh": "他是一位自豪的<w>阿富汗人</w>，喜欢分享关于他家乡的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Afghanistani"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель Афганистана.",
                        "zh": "阿富汗的本地人或居民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афганец",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "афганка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗人",
                                "target_lang_sense_clarification": "指代国民"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a52e3607-f360-31d5-b1ba-c59c354db597",
                    "sense_definition": "A blanket or throw, usually crocheted or knitted from colorful yarn.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrapped herself in a warm <w>afghan</w> while reading by the fire.",
                            "target_lang_translations": {
                                "ru": "Она завернулась в теплый <w>плед</w>, читая у камина.",
                                "zh": "她坐在火炉旁读书时，裹着一条温暖的<w>针织毯</w>。"
                            }
                        },
                        {
                            "text": "My grandmother knitted a beautiful multicolored <w>afghan</w> for my bed.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка связала красивый разноцветный <w>плед</w> для моей кровати.",
                                "zh": "我祖母为我的床织了一条漂亮的彩色<w>针织毯</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crochet afghan",
                        "knitted afghan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually lowercase"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязаный или трикотажный плед из разноцветной пряжи.",
                        "zh": "一种通常用彩色毛线钩织或编织而成的毯子或披肩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плед",
                                "target_lang_sense_clarification": "вязаное одеяло"
                            },
                            {
                                "target_lang_word": "вязаное одеяло",
                                "target_lang_sense_clarification": ""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "针织毯",
                                "target_lang_sense_clarification": "手工编织的毯子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b689677b-b6d9-38a2-9145-a40d8bbb4ce1",
                    "sense_definition": "A tall hunting dog with a long, silky coat; short for Afghan Hound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Afghan</w> requires regular grooming to keep its long hair free of tangles.",
                            "target_lang_translations": {
                                "ru": "<w>Афганская борзая</w> требует регулярного ухода, чтобы ее длинная шерсть не спутывалась.",
                                "zh": "<w>阿富汗猎犬</w>需要定期梳理，以保持其长毛不打结。"
                            }
                        },
                        {
                            "text": "She entered her prize-winning <w>Afghan</w> in the national dog show.",
                            "target_lang_translations": {
                                "ru": "Она выставила своего призового <w>афгана</w> на национальной выставке собак.",
                                "zh": "她带着她那只屡获殊荣的<w>阿富汗猎犬</w>参加了全国犬展。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Afghan Hound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокая охотничья собака с длинной шелковистой шерстью; афганская борзая.",
                        "zh": "一种体型高大、毛发长而丝滑的猎犬，即阿富汗猎犬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афганская борзая",
                                "target_lang_sense_clarification": "порода собаки"
                            },
                            {
                                "target_lang_word": "афган",
                                "target_lang_sense_clarification": "разговорное название породы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗猎犬",
                                "target_lang_sense_clarification": "犬种名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d24723d-773b-3fb7-8b65-492264056ec3",
                    "sense_definition": "A type of carpet or rug traditionally made in Afghanistan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They bought an expensive <w>Afghan</w> to cover the hardwood floor in the hallway.",
                            "target_lang_translations": {
                                "ru": "Они купили дорогой <w>афганский ковер</w>, чтобы застелить паркетный пол в прихожей.",
                                "zh": "他们买了一块昂贵的<w>阿富汗地毯</w>铺在走廊的硬木地板上。"
                            }
                        },
                        {
                            "text": "The intricate patterns on the <w>Afghan</w> added a touch of elegance to the room.",
                            "target_lang_translations": {
                                "ru": "Замысловатые узоры на <w>афганском ковре</w> добавили комнате элегантности.",
                                "zh": "<w>阿富汗地毯</w>上错综复杂的图案为房间增添了一抹优雅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Afghan rug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип ковра, традиционно производимого в Афганистане.",
                        "zh": "一种传统上在阿富汗制作的地毯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афганский ковер",
                                "target_lang_sense_clarification": ""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗地毯",
                                "target_lang_sense_clarification": "特指地毯类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a80cad8-d973-3c0b-99c4-9b4bccd7127f",
                    "sense_definition": "A sheepskin coat with the wool on the inside, often embroidered.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a vintage <w>Afghan</w> that became popular during the fashion trends of the sixties.",
                            "target_lang_translations": {
                                "ru": "Он носил винтажную <w>афганскую дубленку</w>, которая стала популярной на волне моды шестидесятых.",
                                "zh": "他穿着一件在六十年代时尚潮流中流行的复古<w>阿富汗皮大衣</w>。"
                            }
                        },
                        {
                            "text": "The heavy <w>Afghan</w> kept him warm during the bitter winter winds.",
                            "target_lang_translations": {
                                "ru": "Тяжелая <w>дубленка</w> согревала его во время пронизывающих зимних ветров.",
                                "zh": "这件厚重的<w>阿富汗皮大衣</w>在严冬的寒风中为他保暖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Afghan coat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пальто из овчины мехом внутрь, часто с вышивкой.",
                        "zh": "一种内侧带毛的羊皮大衣，通常带有刺绣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "афганская дубленка",
                                "target_lang_sense_clarification": ""
                            },
                            {
                                "target_lang_word": "дубленка",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗皮大衣",
                                "target_lang_sense_clarification": "服装类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "900107e9-726f-30b9-8c87-cb7c188f17bf",
                    "sense_definition": "A type of iced chocolate biscuit, sometimes containing cornflakes and topped with a walnut.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery sells a crunchy <w>afghan</w> topped with a piece of walnut.",
                            "target_lang_translations": {
                                "ru": "В пекарне продается хрустящее <w>печенье «Афган»</w>, украшенное кусочком грецкого ореха.",
                                "zh": "这家面包店出售一种上面放着核桃仁的酥脆<w>阿富汗饼干</w>。"
                            }
                        },
                        {
                            "text": "I baked a batch of <w>afghans</w> for the school bake sale.",
                            "target_lang_translations": {
                                "ru": "Я испек партию <w>печенья «Афган»</w> для школьной распродажи выпечки.",
                                "zh": "我为学校的义卖活动烤了一批<w>阿富汗饼干</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually lowercase"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шоколадное печенье с кукурузными хлопьями, иногда украшенное грецким орехом.",
                        "zh": "一种加了糖霜的巧克力饼干，有时含有玉米片并以核桃装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенье «Афган»",
                                "target_lang_sense_clarification": "новозеландская сладость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿富汗饼干",
                                "target_lang_sense_clarification": "新西兰特色甜点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "923faee8-3c21-30cd-9eb9-c11db7d06347",
                    "sense_definition": "The Pashto language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He is learning to speak <w>Afghan</w> to communicate better with his relatives.",
                            "target_lang_translations": {
                                "ru": "Он учится говорить на <w>пушту</w>, чтобы лучше общаться со своими родственниками.",
                                "zh": "他正在学习<w>普什图语</w>，以便更好地与亲戚交流。"
                            }
                        },
                        {
                            "text": "The translator specialized in <w>Afghan</w> and helped interpret the documents.",
                            "target_lang_translations": {
                                "ru": "Переводчик специализировался на <w>афганском языке</w> и помогал переводить документы.",
                                "zh": "这位翻译专攻<w>普什图语</w>，并协助翻译了这些文件。"
                            }
                        }
                    ],
