                "senses": [
                    {
                        "sense_id": "b0348135-8d5a-342f-b228-755236aea109",
                        "entry_id": "5d1eb5cf-702f-300d-b70d-2cb93ed300f7",
                        "glosses": [
                            "die Bemühungen Frieden zu schließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607bc1e5-83b6-49e3-a1a0-9a1785acf98f",
                                "sense_id": "b0348135-8d5a-342f-b228-755236aea109",
                                "text": "Der Friedensprozess im Nahen Osten hat noch immer keinen Erfolg gebracht."
                            },
                            {
                                "example_id": "6931ad94-7664-448b-ac83-56f7d0fe953c",
                                "sense_id": "b0348135-8d5a-342f-b228-755236aea109",
                                "text": "„Den allgegenwärtigen Terror bekommen auch die Soldaten der UN-Mission Minusma zu spüren, die in Gao und anderen Städten den Friedensprozess überwachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3098a491-06e1-4d66-a609-7ace45d1325e",
                        "source_entry_id": "5d1eb5cf-702f-300d-b70d-2cb93ed300f7",
                        "source_sense_id": "b0348135-8d5a-342f-b228-755236aea109",
                        "source_sense_description": "die Bemühungen Frieden zu schließen",
                        "target_lang_word": "processus de paix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "processus de paix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26d1214c-095f-3639-935a-5a71ff3938a8",
                                        "entry_id": "5c3a0687-f9e8-3a9a-a347-a2a3815f56ea",
                                        "glosses": [
                                            "Action visant à ramener la paix entre des parties belligérantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8724dae7-da87-45eb-a2cf-6bd7c19cd3f3",
                                                "sense_id": "26d1214c-095f-3639-935a-5a71ff3938a8",
                                                "text": "C’est à cette époque (1974) qu’apparut l’expression « processus de paix », forgée, semble-t-il, par Harold Saunders, principal collaborateur de Kissinger pour le Proche-Orient au sein du Conseil national de sécurité"
                                            },
                                            {
                                                "example_id": "df18b884-8e3a-4f38-8301-0915a7feb2d5",
                                                "sense_id": "26d1214c-095f-3639-935a-5a71ff3938a8",
                                                "text": "Marie-Agnes Zimmermann considère qu'il est \"primordial d'ouvrir la voie vers un processus de paix au Moyen-Orient\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
