        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                "word": "Cynthia",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7df6ffa7-c355-49fd-b0a6-4342f34e1397",
