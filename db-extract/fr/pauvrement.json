        "fr-extract.jsonl": [
            {
                "entry_id": "0b6fdbc2-36aa-3634-9236-2d74256e4aa8",
                "word": "pauvrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "093a38ea-3a06-3f42-a36e-e0feaf26117b",
                        "entry_id": "0b6fdbc2-36aa-3634-9236-2d74256e4aa8",
                        "glosses": [
                            "De façon pauvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0abb011b-0e0d-4a21-bdc7-0ee7c0287f6a",
                                "sense_id": "093a38ea-3a06-3f42-a36e-e0feaf26117b",
                                "text": "C’est un vieillard pauvrement vêtu mais à la figure sympathique encadrée d’une longue barbe blanche, un vrai croyant, fidèle observateur des préceptes hospitaliers de sa foi."
                            },
                            {
                                "example_id": "62fa402f-93e2-4643-9b15-e53f20910ed9",
                                "sense_id": "093a38ea-3a06-3f42-a36e-e0feaf26117b",
                                "text": "Il est mort au mois de janvier dernier dans un village nommé Vitry, tout près de Paris, une femme qui y vivait assez obscurément, et même assez pauvrement, et qu’on assure avoir été la veuve du czarowitz Alexis, que son père le czar Pierre Iᵉʳ fit mourir."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb373f42-caec-30a8-b62e-88135af84f0f",
                        "entry_id": "0b6fdbc2-36aa-3634-9236-2d74256e4aa8",
                        "glosses": [
                            "Dans une condition insuffisante ; chichement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30168cae-604f-4c16-b2c0-af10a219fc07",
                                "sense_id": "bb373f42-caec-30a8-b62e-88135af84f0f",
                                "text": "La question d’argent devient épineuse. Je ne peux plus vivre que pauvrement dans cette grande ville."
                            },
                            {
                                "example_id": "bbee89c9-3cad-4ea9-8dcd-54c3805c2fc3",
                                "sense_id": "bb373f42-caec-30a8-b62e-88135af84f0f",
                                "text": "J’allai, l’autre jour, voir une maison où l’on entretient environ trois cents personnes assez pauvrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f12acbd5-126f-3020-84b4-2def16045e57",
                        "entry_id": "0b6fdbc2-36aa-3634-9236-2d74256e4aa8",
                        "glosses": [
                            "D’une manière chétive, malhabile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809af59a-6955-4189-b6f7-d43bad0405c6",
                                "sense_id": "f12acbd5-126f-3020-84b4-2def16045e57",
                                "text": "Il [un des juges de Fouquet] reprit toute l’affaire pauvrement et misérablement, lisant ce qu’il disait."
                            }
                        ]
                    }
                ],
