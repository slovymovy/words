                "senses": [
                    {
                        "sense_id": "a7984a1d-3ef2-3dab-89bb-052f9c341140",
                        "entry_id": "db329bb8-f386-3829-b474-33640e121caf",
                        "glosses": [
                            "eine stark verdichtete Großstadtregion von hoher internationaler Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb571614-5422-46e0-9fe6-f0834593d7dc",
                                "sense_id": "a7984a1d-3ef2-3dab-89bb-052f9c341140",
                                "text": "Moskau, London, Istanbul, Île-de-France und Rhein-Ruhr sind die europäischen Metropolregionen, in denen die meisten Einwohner wohnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0649f16-a1f6-46a4-94a6-55aacb2937ee",
                        "source_entry_id": "db329bb8-f386-3829-b474-33640e121caf",
                        "source_sense_id": "a7984a1d-3ef2-3dab-89bb-052f9c341140",
                        "source_sense_description": "eine stark verdichtete Großstadtregion von hoher internationaler Bedeutung",
                        "target_lang_word": "metropolitan area",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metropolitan area",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c18ab8-7c9b-35bd-aed3-8f68b47a93ef",
                                        "entry_id": "91e71112-0ae6-368b-9484-01040583bb2f",
                                        "glosses": [
                                            "An area of population usually with a central or core city and surrounding towns or suburbs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc0bd53-5990-4c61-94c4-25692a2862f7",
                                                "sense_id": "a0c18ab8-7c9b-35bd-aed3-8f68b47a93ef",
                                                "text": "Before the year was out there were, in addition to Redwood's pioneer vehicle, quite a number of motor-perambulators to be seen in the west of London. I am told there were as many as eleven; but the most careful inquiries yield trustworthy evidence of only six within the Metropolitan area at that time."
                                            },
                                            {
                                                "example_id": "30e66717-0094-4705-8af0-c00a0ed3a532",
                                                "sense_id": "a0c18ab8-7c9b-35bd-aed3-8f68b47a93ef",
                                                "text": "1911 — Encyclopædia Britannica, \"Brisbane\"\nThe population of the metropolitan area in 1901 was 119,907; of the city proper, 28,953; of South Brisbane, 25,481."
                                            },
                                            {
                                                "example_id": "232d25c4-f86f-477e-9646-cb2a7eaea573",
                                                "sense_id": "a0c18ab8-7c9b-35bd-aed3-8f68b47a93ef",
                                                "text": "1949 — ', Part IX A (c) Article 243P Definitions\n\"Metropolitan area\" means an area having a population of ten lakhs or more, comprised in one or more districts and consisting of two or more Municipalities or Panchayats or other contiguous areas, specified by the Governor by public notification to be a Metropolitan area for the purposes of this Part;"
                                            },
                                            {
                                                "example_id": "bc8151cc-a902-453a-ba78-217ef40951d4",
                                                "sense_id": "a0c18ab8-7c9b-35bd-aed3-8f68b47a93ef",
                                                "text": "The metropolitan area of Lima accounts for 43 per cent of gross domestic product, for four-fifths of bank credit and consumer goods production."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
