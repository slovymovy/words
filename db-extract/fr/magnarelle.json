                        "glosses": [
                            "Femme qui pratique l’élevage des vers à soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "b4dbf2a3-2912-47f1-bee2-cb04cba2f0de",
                                "sense_id": "2270b9a4-314d-32aa-99b9-454f83d715c6",
                                "text": "…, combien de camisards entêtés dans leur foi, combien de magnarelles diligentes n'ont pas vécu ici sans prévoir cette mort prochaine de leur petite patrie!"
                            },
                            {
                                "example_id": "14e61c8e-4e39-4eb0-85bc-0bc50c1f548a",
                                "sense_id": "2270b9a4-314d-32aa-99b9-454f83d715c6",
                                "text": "Pour faire mûrir la graine de vers à soie, celle-ci était placée dans un petit sac suspendu autour du cou et reposait entre les seins de la femme, la magnarelle. La chaleur du corps favorisait l'éclosion des petites larves. (Muller 1874)"
                            }
                        ]
                    }
