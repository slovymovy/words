                "senses": [
                    {
                        "sense_id": "217b8787-c0d6-3ad9-ad6e-277aaf361f8f",
                        "entry_id": "5486d06b-4a28-3570-8f67-99a82b8db5e4",
                        "glosses": [
                            "Revenir en arrière sur un assassinat, faire en sorte qu’une personne assassinée ne le soit plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c036668b-53eb-4ee2-ab84-8860981c6a88",
                                "sense_id": "217b8787-c0d6-3ad9-ad6e-277aaf361f8f",
                                "text": "Wayne aurait pu désassassiner John Lennon si tu l’avais correctement envoyé en 1980."
                            },
                            {
                                "example_id": "f751363d-979a-4175-9779-910a61808242",
                                "sense_id": "217b8787-c0d6-3ad9-ad6e-277aaf361f8f",
                                "text": "Comme cette première enquête ne lui permet pas d’identifier la coupable, le professeur monte à l’aide d’Innes, d’Alice et de Fred, un stratagème destiné à démasquer la meurtrière en l’obligeant à \"désassassiner\" Innes…"
                            }
                        ]
                    }
