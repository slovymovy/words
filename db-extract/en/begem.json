                        "glosses": [
                            "To adorn (as if) with gems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78996616-7b98-4564-9da9-02b9fd9f1a6a",
                                "sense_id": "b8d794c8-6882-352f-9224-00204ee6f485",
                                "text": "Our Grove we illuminate, glorious to see,\nWith glittering Glow-worms begemming each Tree;"
                            },
                            {
                                "example_id": "3dee4f78-a413-4f28-bb40-929d19e141ec",
                                "sense_id": "b8d794c8-6882-352f-9224-00204ee6f485",
                                "text": "One […] threw\nThe wreath upon him, like an anadem,\nWhich frozen tears instead of pearls begem;"
                            },
                            {
                                "example_id": "9e02df0b-09ce-4095-9d08-7a9642a9dc77",
                                "sense_id": "b8d794c8-6882-352f-9224-00204ee6f485",
                                "text": "Time was, when a stage manager would spend hundreds of thousands of francs to begem with real emeralds the throne upon which a great actress would play the part of an empress."
                            }
                        ]
                    }
