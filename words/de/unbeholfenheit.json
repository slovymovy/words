                            },
                            {
                                "target_lang_word": "неуклюжесть",
                                "target_lang_sense_clarification": "ляпсус, огрех в речи или действии"
                            },
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "небольшая ошибка или бестактность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
