    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ccbfec9-0565-3f5d-8e27-cc6930714d0b",
                    "sense_definition": "Множественное число от слова <w>человек</w>; живые существа, обладающие разумом, речью и сознанием.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "humans_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На площади собрались тысячи <людей>.",
                            "target_lang_translations": {
                                "en": "Thousands of <w>people</w> gathered in the square.",
                                "zh": "广场上聚集了成千上万的<w>人</w>。"
                            }
                        },
                        {
                            "text": "Все <люди> хотят быть счастливыми и свободными.",
                            "target_lang_translations": {
                                "en": "All <w>people</w> want to be happy and free.",
                                "zh": "所有的<w>人</w>都渴望幸福与自由。"
                            }
                        }
                    ],
                    "antonyms": [
                        "животные",
                        "звери"
                    ],
                    "common_phrases": [
                        "много людей",
                        "группа людей",
                        "миллионы людей",
                        "тысячи людей"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the word \"chelovek\" (person); living beings possessing reason, speech, and consciousness.",
                        "zh": "“人”的复数形式；具有理智、语言和意识的生命体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "general plural of person"
                            },
                            {
                                "target_lang_word": "humans",
                                "target_lang_sense_clarification": "biological species"
                            },
                            {
                                "target_lang_word": "human beings",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "指代人类个体或群体"
                            },
                            {
                                "target_lang_word": "人类",
                                "target_lang_sense_clarification": "指代生物学意义上的物种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee50bd14-ad15-3c29-a433-ee7185998d41",
                    "sense_definition": "Лица, принадлежащие к определённой среде или группе, объединённые общими признаками (профессией, возрастом, взглядами).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "humans_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой компании работают очень серьёзные <люди>.",
                            "target_lang_translations": {
                                "en": "Very serious <w>people</w> work in this company.",
                                "zh": "这家公司里工作的都是非常严肃的<w>人</w>。"
                            }
                        },
                        {
                            "text": "Молодые <люди> часто любят слушать громкую музыку.",
                            "target_lang_translations": {
                                "en": "Young <w>people</w> often like listening to loud music.",
                                "zh": "年轻<w>人</w>通常喜欢听大声的音乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "деловые люди",
                        "молодые люди",
                        "русские люди",
                        "свои люди"
                    ],
                    "target_lang_definitions": {
                        "en": "Persons belonging to a specific environment or group, united by common characteristics (profession, age, views).",
                        "zh": "属于特定环境或群体，因职业、年龄或观点而结合在一起的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "members of a group"
                            },
                            {
                                "target_lang_word": "folks",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "指代特定群体中的成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "726fd221-b9d4-33d3-9cd9-17023e80e545",
                    "sense_definition": "Посторонние, чужие лица; окружающее общество (в отличие от семьи или близких).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humans_public",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему было стыдно плакать при <людях>.",
                            "target_lang_translations": {
                                "en": "He was ashamed to cry in front of <w>people</w>.",
                                "zh": "他在<w>别人</w>面前哭感到很羞愧。"
                            }
                        },
                        {
                            "text": "Нужно вести себя прилично, ведь кругом <люди>.",
                            "target_lang_translations": {
                                "en": "One must behave decently, for there are <w>people</w> all around.",
                                "zh": "举止要得体，毕竟周围都是<w>人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "посторонние",
                        "окружающие"
                    ],
                    "common_phrases": [
                        "на людях",
                        "выйти в люди",
                        "что люди скажут"
                    ],
                    "target_lang_definitions": {
                        "en": "Strangers, outsiders; surrounding society (as opposed to family or close ones).",
                        "zh": "外人、陌生人；指代家庭或亲近的人以外的社会大众。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "the public/society"
                            },
                            {
                                "target_lang_word": "strangers",
                                "target_lang_sense_clarification": "unknown persons"
                            },
                            {
                                "target_lang_word": "others",
                                "target_lang_sense_clarification": "other people"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别人",
                                "target_lang_sense_clarification": "指代他人或公众"
                            },
                            {
                                "target_lang_word": "外人",
                                "target_lang_sense_clarification": "指代非亲属的陌生人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df0e09c8-429b-31f6-9d57-1cf0e23187bf",
                    "sense_definition": "Слуги, работники в барском доме или усадьбе.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "servants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Барин приказал отправить <людей> на полевые работы.",
                            "target_lang_translations": {
                                "en": "The master ordered to send the <w>servants</w> to field work.",
                                "zh": "老爷下令把<w>仆人</w>派去干农活。"
                            }
                        },
                        {
                            "text": "Дворовые <люди> жили в отдельной избе рядом с кухней.",
                            "target_lang_translations": {
                                "en": "The household <w>servants</w> lived in a separate hut next to the kitchen.",
                                "zh": "家仆们住在厨房旁边的一间独立小屋里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "слуги",
                        "челядь",
                        "прислуга"
                    ],
                    "antonyms": [
                        "господа",
                        "баре"
                    ],
                    "common_phrases": [
                        "дворовые люди"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Servants, workers in a master's house or estate.",
                        "zh": "旧时指主人家里的仆人或劳工。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "servants",
                                "target_lang_sense_clarification": "domestic workers (archaic)"
                            },
                            {
                                "target_lang_word": "serfs",
                                "target_lang_sense_clarification": "feudal laborers"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仆人",
                                "target_lang_sense_clarification": "指代家仆"
                            },
                            {
                                "target_lang_word": "佣人",
                                "target_lang_sense_clarification": "指代受雇佣的劳工"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e31b0601-819b-3df8-bebb-73c0fdcc6956",
                    "sense_definition": "Старинное название буквы «л» в кириллице.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "letter_name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старой славянской азбуке эта буква называлась «<люди>».",
                            "target_lang_translations": {
                                "en": "In the old Slavic alphabet, this letter was called \"<w>lyudi</w>\".",
                                "zh": "在古斯拉夫字母表中，这个字母被称为“Lyudi”。"
                            }
                        },
                        {
                            "text": "Ученик старательно повторял названия букв: како, <люди>, мыслете.",
                            "target_lang_translations": {
                                "en": "The student diligently repeated the names of the letters: kako, <w>lyudi</w>, myslete.",
                                "zh": "学生认真地重复着字母名称：kako, Lyudi, myslete。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Old name for the letter \"L\" in the Cyrillic alphabet.",
                        "zh": "西里尔字母中字母“L”的古称。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Lyudi",
                                "target_lang_sense_clarification": "name of the letter L"
                            }
                        ],
