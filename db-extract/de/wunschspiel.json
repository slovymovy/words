                "senses": [
                    {
                        "sense_id": "b6b5713d-64d5-3c2c-b661-72f864f25d15",
                        "entry_id": "257a5309-a2b9-3059-84d2-119da99ed9d5",
                        "glosses": [
                            "begehrtes, bevorzugtes, ersehntes Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc756b6-cb9f-41a8-b710-b3bae2e3ae96",
                                "sense_id": "b6b5713d-64d5-3c2c-b661-72f864f25d15",
                                "text": "„Das Elternteil führt nun mit dem Kind das Wunschspiel durch, und der Therapeut bewegt sich hinter und mit dem Elternteil, um sicherzustellen, dass sich das Elternteil an die Regeln des Wunschspiels hält.“"
                            },
                            {
                                "example_id": "748895ac-d1c4-4b5d-b1ea-47aac2f34c30",
                                "sense_id": "b6b5713d-64d5-3c2c-b661-72f864f25d15",
                                "text": "„Die sechs Personen, die so amüsant einen Boden unter den Füßen gesucht und nicht gefunden haben, feiern nun gemeinsam ein Fest, erörtern Biografisches, versuchen ein Wunschspiel.“"
                            },
                            {
                                "example_id": "ec3e7274-e37e-44fc-b7c7-0e62bc042615",
                                "sense_id": "b6b5713d-64d5-3c2c-b661-72f864f25d15",
                                "text": "„Wir wollen das Wunschspiel spielen. Na schön, sagte Coffey, aber beeil dich!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
