                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf38af3-8a29-48db-8889-a64729d1f169",
                                "sense_id": "83df94c3-8762-3ec5-aa5e-b69edafc231f",
                                "text": "ein Denkverbot auferlegen/erteilen",
                                "translation": "to impose/issue a ban on thinking",
                                "english": "to impose/issue a ban on thinking"
                            },
                            {
                                "example_id": "148c8beb-cac5-473c-9f78-6dd181a578c2",
                                "sense_id": "83df94c3-8762-3ec5-aa5e-b69edafc231f",
                                "text": "Gas per Fracking zu fördern, ist in Deutschland verboten – aber nun mehren sich die Stimmen, die die Methode neu prüfen wollen. Die Bundesregierung bleibt beim Nein, aber die FDP kritisiert schon »Denkverbote«.",
                                "translation": "Extracting gas by fracking is banned in Germany – but now there are increasing voices who want to re-examine the method. The federal government is sticking with the no vote, but the FDP is already criticizing “bans on thinking”.",
                                "english": "Extracting gas by fracking is banned in Germany – but now there are increasing voices who want to re-examine the method. The federal government is sticking with the no vote, but the FDP is already criticizing “bans on thinking”."
                            }
                        ]
                    }
