                                    {
                                        "sense_id": "f3f5ee49-d42a-36ec-acab-60478793471e",
                                        "entry_id": "1a41aa2b-fbc2-3bb3-b48a-a3331e1f1475",
                                        "glosses": [
                                            "een planeet in een baan rond een andere ster dan de zon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce1c949-e592-4a2c-bf54-c9f7d7d7ea79",
                                                "sense_id": "f3f5ee49-d42a-36ec-acab-60478793471e",
                                                "text": "In 2013 werd er voor het eerst een exoplaneetje ontdekt (Kepler-37b) dat kleiner is dan onze planeet Mercurius."
                                            }
                                        ]
                                    }
                                ]
                            }
