                "senses": [
                    {
                        "sense_id": "62d1cda9-5c23-3d36-99d1-58b62dbed5df",
                        "entry_id": "e6961ea8-6bc4-314d-9443-6c2cdc447673",
                        "glosses": [
                            "Verdienst/Einkommen nach Abzug aller Abgaben (Steuern, Sozialabgaben und so weiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2172facc-30ce-4001-ba64-91f92184b4b3",
                                "sense_id": "62d1cda9-5c23-3d36-99d1-58b62dbed5df",
                                "text": "„Die Sozialbeiträge, die den Löhnen aufgeschlagen werden, verteuern die Arbeitsplätze, schmälern den Nettoverdienst und setzen eine unheilvolle Spirale in Gang: Um den Gewinn zu halten, streichen die Firmen Jobs.“"
                            },
                            {
                                "example_id": "1d977bd6-3e2f-44c2-8d88-1c4de59c33ba",
                                "sense_id": "62d1cda9-5c23-3d36-99d1-58b62dbed5df",
                                "text": "„Damit vermehren sie das Heer der Transferempfänger, so dass die Beiträge erneut steigen und die Nettoverdienste weiter sinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
