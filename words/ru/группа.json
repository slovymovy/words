                            {
                                "target_lang_word": "band",
                                "target_lang_sense_clarification": "musical ensemble"
                            },
                            {
                                "target_lang_word": "group",
                                "target_lang_sense_clarification": "musical group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐队",
                                "target_lang_sense_clarification": "演奏音乐的团体"
                            },
                            {
                                "target_lang_word": "组合",
                                "target_lang_sense_clarification": "流行音乐表演团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbefa3ac-a40d-3636-9fa7-a18e30f6ad21",
                    "sense_definition": "Объединение учеников или студентов для совместных занятий.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся наша учебная <w>группа</w> успешно сдала сложный экзамен по истории.",
                            "target_lang_translations": {
                                "en": "Our entire study <w>group</w> successfully passed the difficult history exam.",
                                "zh": "我们整个学习<w>小组</w>都顺利通过了那场高难度的历史考试。"
                            }
                        },
                        {
                            "text": "Преподаватель попросил старосту <w>группы</w> собрать тетради.",
                            "target_lang_translations": {
                                "en": "The teacher asked the <w>group</w> monitor to collect the notebooks.",
                                "zh": "老师让<w>班级</w>里的班长去收作业本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "учебная группа",
                        "староста группы",
                        "студенческая группа",
                        "старшая группа"
                    ],
                    "target_lang_definitions": {
                        "en": "An association of pupils or students for joint classes.",
                        "zh": "为共同学习而组成的学员或学生集合。"
