                        "examples": [
                            {
                                "example_id": "cfc6996d-0b64-4aeb-8e31-67e24c2e79c3",
                                "sense_id": "2700ae66-4cbd-37be-a5d7-c27b7a929c74",
                                "text": "De voormalige FIFA-functionaris Miguel Maduro heeft een opmerkelijke verklaring afgelegd tijdens een hoorzitting in het Britse parlement. Maduro werd door FIFA-voorzitter Gianni Infantino aangesteld in de onafhankelijke bestuurscommissie. Afgelopen mei, minder dan een jaar na zijn benoeming, werd de Portugese oud-politicus vervangen."
                            },
                            {
                                "example_id": "c82dba11-3518-4764-a849-c0406b01c80b",
                                "sense_id": "2700ae66-4cbd-37be-a5d7-c27b7a929c74",
                                "text": "Dit is Jeffrey Webb. Hij is 50 jaar oud en komt van de Kaaimaneilanden. Webb is een belangrijke man binnen de FIFA: hij is dus vice-voorzitter van de bestuurscommissie, maar daarnaast is hij ook president van de Concacaf, de voetbalbond voor Noord-Amerika, Centraal-Amerika en de Caraïben. Sinds 1991 runt Webb ook de voetbalbond van de Kaaimaneilanden."
                            },
                            {
                                "example_id": "343dff04-38b6-4f3b-9b20-038b72bbe8da",
                                "sense_id": "2700ae66-4cbd-37be-a5d7-c27b7a929c74",
                                "text": "Na een toespraak van de voorzitter van de bestuurscommissie Zuidoost, kregen nabestaanden en een predikant het woord. Daarna volgden een minuut stilte en een kranslegging."
                            }
                        ]
                    }
