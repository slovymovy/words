                ],
                "translations": [
                    {
                        "translation_id": "2b23b76b-685e-4ca9-aead-829c6e9684e3",
                        "source_entry_id": "4b728ad8-39e8-3344-9ba0-b709cd64b025",
                        "source_sense_id": "f6608721-054b-3cd2-8ec1-bfecd53d9768",
                        "target_lang_word": "стойка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стойка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bca67368-3240-3cfc-bdcd-dad8a82f00c8",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "положение тела человека в строю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0e6788-c296-401a-aea5-6a985b2eaf09",
                                                "sense_id": "bca67368-3240-3cfc-bdcd-dad8a82f00c8",
                                                "text": "Например, можно попробовать доказать инспектору, что тот принял на дороге неправильную «стойку»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547a325a-8276-341c-943a-28d27fc258c6",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "напряжённая неподвижная устойчивая поза, принимаемая человеком в готовности совершить выпад, манёвр"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b952f6b-04ae-4618-ba8c-6a62dd9b673a",
                                                "sense_id": "547a325a-8276-341c-943a-28d27fc258c6",
                                                "text": "Одни и те же удары из разных стоек наносятся по-разному, имеют разную силу удара и скорость, поэтому необходимо уметь подбирать стойки для выполнения конкретной задачи и цели действия."
                                            },
                                            {
                                                "example_id": "3d2879a9-1835-4d0a-968b-93428fd436f5",
                                                "sense_id": "547a325a-8276-341c-943a-28d27fc258c6",
                                                "text": "Такая позиция наиболее выгодна для перемещения хоть шагом, хоть прыжком практически в любую сторону, позволяет начинать движение с любой удобной вам ноги, а также практически идентична стойке для стрельбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d66aea-a7ec-31b9-b9b7-280e82960f9e",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "напряжённая неподвижная поза, принимаемая охотничьей собакой при обнаружении дичи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df5c57e-5857-449f-a8fb-7bbbe1184eea",
                                                "sense_id": "a6d66aea-a7ec-31b9-b9b7-280e82960f9e",
                                                "text": "Врачам руки облизала, а когда увидела инструменты — в стойку встала, глаза остановились."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "вертикальный стержень, служащий опорой для чего-либо в каком-либо сооружении, устройстве, приспособлении, либо само сооружение, устройство, приспособление, включающее такой стержень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f560d7a-93b0-4414-8cd9-2cd1f2dbb560",
                                                "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                                "text": "По крайней мере, стойки для капельниц были явно западноевропейских кровей, тумбочки не традиционно обшарпанные, а белье свежее."
                                            },
                                            {
                                                "example_id": "9598c894-88bf-4ff4-981b-7d0cc5dc719f",
                                                "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                                "text": "Машина на газовых стойках, с пробегом 45000 км, бошевским инжектором и свечами."
                                            },
                                            {
                                                "example_id": "ad76aed3-b47e-4d46-9a9d-a1c66763aefd",
                                                "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                                "text": "В ожидании восхода луны лётчик поднялся на крыло самолёта и увидел отчётливое голубое сияние, распространившееся в воде вокруг стоек, подпиравших крыло и хвост самолёта."
                                            },
                                            {
                                                "example_id": "6573f371-3569-4528-b6cb-6123cc2e95c4",
                                                "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                                "text": "Для их монтажа мы вынуждены были поставить на кровлю передвигающийся по рельсам мостовой кран, с помощью которого устанавливали стойки, идя с торцов здания к центру."
                                            },
                                            {
                                                "example_id": "598ea73d-b76b-4aa7-a0ae-89f7a2c3deb7",
                                                "sense_id": "0e911c37-1d8d-36ae-b662-b9a7b946f062",
                                                "text": "Лет пятнадцать назад старый дом сломали, на его месте поставили табачный и квасной киоски, а чуть подальше устроили баскетбольную площадку, правда, теперь стойки для корзин были покорёжены, кольца погнуты и посреди площадки утвердился стол для любителей домино и серьёзного напитка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca89221-4937-395b-a576-77c6857f97b2",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "род узкого продолговатого стола для работы, приёма пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "830dfb50-4f59-487a-b317-7396d36d72a0",
                                                "sense_id": "5ca89221-4937-395b-a576-77c6857f97b2",
                                                "text": "Возможна и угловая планировка, в этом случае зону отдыха от рабочей зоны легко отделить, например, стойкой для завтраков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4614c215-6b39-364a-b8cd-82dd8cf8db96",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "высокий прилавок для продажи закусок, напитков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b5ccf6-e173-4aed-887f-8004add60c7a",
                                                "sense_id": "4614c215-6b39-364a-b8cd-82dd8cf8db96",
                                                "text": "Опрокинули по кружке и уже собрались рассчитаться, как вдруг с негромким пристуком донышка о стойку перед нами появилось ещё по кружке и по стопке."
                                            },
                                            {
                                                "example_id": "5a0d2dce-378d-4b31-a38c-5748cae041a5",
                                                "sense_id": "4614c215-6b39-364a-b8cd-82dd8cf8db96",
                                                "text": "Я, почтеннейший, проходил вчера мимо вашей стойки и до сих пор не могу забыть ни осетрины, ни брынзы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24dbfe39-7807-335d-9ab6-c7ae009e05dd",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "воротник в виде стоячей полоски, плотно охватывающей шею"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f82684c-fb66-4b1d-a2c4-a82f50d888ba",
                                                "sense_id": "24dbfe39-7807-335d-9ab6-c7ae009e05dd",
                                                "text": "Жена Клео заявилась в золотистом шёлковом платье с воротником стойкой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea5c3e0-740b-30d1-b198-d14575cb0f8e",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "техн. специальное шасси для крепления нескольких блоков устройства один над другим (например, блоков сетевого оборудования)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec861294-323d-477c-a64a-602edcfe17af",
                                                "sense_id": "0ea5c3e0-740b-30d1-b198-d14575cb0f8e",
                                                "text": "Первый — наиболее предпочтителен для многостаночных систем, однако для его использования необходимо изменять микропрограммное обеспечение контроллера стойки ЧПУ, что не всегда возможно и сопряжено с определёнными трудностями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a17915bf-c7a9-39ae-a200-e3a74ec966b3",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "небольшой шкафчик, этажерка, тумба с открытыми полками, без дверок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f566577a-f737-4519-a7e6-9a1c351855f5",
                                                "sense_id": "a17915bf-c7a9-39ae-a200-e3a74ec966b3",
                                                "text": "Прихожая была очевидно другая — большая, просторная, с резным зеркальным шкафом и стойкой для обуви, которые решительно не могли бы поместиться в крошечной прихожей той квартиры, где я была в прошлый раз."
                                            },
                                            {
                                                "example_id": "2f8cf143-38a2-4679-aa77-22305bfe5944",
                                                "sense_id": "a17915bf-c7a9-39ae-a200-e3a74ec966b3",
                                                "text": "Коллекция «для самых маленьких», опять-таки МОРЕЛАТО, включает в себя стаканы для карандашей, брелки (оригинальные «Альберелло» Уго Ла Пиетры и Андреа Пелликани), подставки для книг, деревянные стойки для журналов из венге и соломы Роберто Паломбы, пюпитры, зеркала, подносы, стойки для журналов, крепления для щёток, всякие предметы, которые служат нам для хранения дорогих нам вещей, будь то фотография близкого человека или оригинальное приспособление для утреннего завтрака в постели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32524e86-acf2-3211-a757-ead3dc7dea2e",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "специальная конструкция, предназначенная для устойчивого, удобного и компактного размещения чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658248fe-5f54-4ed5-b675-bf2c1b108ad9",
                                                "sense_id": "32524e86-acf2-3211-a757-ead3dc7dea2e",
                                                "text": "Кусты, беседки, светильники, элементы мощения, стойки для велосипедов, спортивные площадки, камни и травы организуют территорию по зонам."
                                            },
                                            {
                                                "example_id": "71dd2393-eb9e-4a55-bb7a-b3f351454eb7",
                                                "sense_id": "32524e86-acf2-3211-a757-ead3dc7dea2e",
                                                "text": "Если расположить её в мансардном помещении, могут возникнуть проблемы с размещением стоек для киев и полочек для шаров."
                                            },
                                            {
                                                "example_id": "437dddcd-a0cc-4ce8-a2e9-0c3f09f2a3b6",
                                                "sense_id": "32524e86-acf2-3211-a757-ead3dc7dea2e",
                                                "text": "И вот вам факт: вешалка и калошная стойка в нашем доме."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4fc0866-216b-3446-af9b-a07d586c17d6",
                                        "entry_id": "fe0a5c5d-99d0-3fc5-b541-0b923bfc8461",
                                        "glosses": [
                                            "рег. то же, что стойбище"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6c4c9cd-7f8a-457d-b2cc-da3f30cdee61",
                                                "sense_id": "a4fc0866-216b-3446-af9b-a07d586c17d6",
                                                "text": "А Фомич бормотал про три доски на стойках каравана и нехватку аварийного запаса топлива: «Ежели, значить, мы теперь постоянно лесовоз, так надо бревна выписать и с собой возить, чтобы стойки для каравана самим делать…»"
                                            },
                                            {
                                                "example_id": "0bfc8139-4e78-41ee-b3ca-68662f6ca012",
                                                "sense_id": "a4fc0866-216b-3446-af9b-a07d586c17d6",
                                                "text": "Службы были заняты «стойками» для скотины, амбарами, сусеками и громадным сеновалом."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "стойка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40815bff-2d46-37b3-8762-fa090a3abaff",
                                        "entry_id": "0835e063-ee25-319e-8793-0d50fa8a8caa",
                                        "glosses": [
                                            "краткая форма женского рода единственного числа прилагательного стойкий"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
