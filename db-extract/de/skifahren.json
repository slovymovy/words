                "senses": [
                    {
                        "sense_id": "ec098209-03e5-34e7-816c-2a8ab7e3db91",
                        "entry_id": "5fa710b3-d899-3307-ad4c-852ba3b9ae04",
                        "glosses": [
                            "Fortbewegung auf Schiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67d9a3f-24d7-42bb-a496-99416980056c",
                                "sense_id": "ec098209-03e5-34e7-816c-2a8ab7e3db91",
                                "text": "„Wenn Mikaela Shiffrin übers Skifahren spricht, meint man oft, ihre Mutter Eileen zu hören, viele Sätze, viele Sprachbilder ähneln sich.“"
                            },
                            {
                                "example_id": "3a1cabdc-fba1-4f32-b3b2-4ec4cbe02f8c",
                                "sense_id": "ec098209-03e5-34e7-816c-2a8ab7e3db91",
                                "text": "„Ari hatte sich erst einige wenige Male auf die Pisten gewagt, aber wenn er irgendwann einmal als echter Siglufjörđuraner durchgehen wollte, war klar, dass er zumindest so tun musste, als ob ihm das Skifahren Spaß machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
