                                        "examples": [
                                            {
                                                "example_id": "a40bf97b-a2f2-4cbf-95c3-1b016c267591",
                                                "sense_id": "64f69120-e543-3c49-8cf4-a156523ffe75",
                                                "text": "Il s’assit et écrivit en français une épître ainsi conçue : …."
                                            },
                                            {
                                                "example_id": "eef6ea22-23eb-4edb-a800-bca54289795d",
                                                "sense_id": "64f69120-e543-3c49-8cf4-a156523ffe75",
                                                "text": "Tout à coup Planchet entra, apportant deux lettres à l’adresse de d’Artagnan.\nL’une était un petit billet gentiment plié en long, avec un joli cachet de cire verte sur lequel était empreinte une colombe rapportant un rameau vert.\nL’autre était une grande épître carrée, et resplendissante des armes terribles de Son Éminence le cardinal-duc."
                                            },
                                            {
                                                "example_id": "26b6a548-67ce-4dff-9ba8-b4a995eb65de",
                                                "sense_id": "64f69120-e543-3c49-8cf4-a156523ffe75",
                                                "text": "Dauriat, incapable de prendre cette épître au sérieux, répondit par des railleries de libraire, une lettre faite entre cinq ou six journalistes."
                                            },
                                            {
                                                "example_id": "e7de4574-74a3-457c-b338-d99cb1524a07",
                                                "sense_id": "64f69120-e543-3c49-8cf4-a156523ffe75",
                                                "text": "Voici en peu de mots l'histoire de ces malheureuses épîtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd0ef2d-0f7b-3ab9-8b21-d3f259a69854",
                                        "entry_id": "cb89e2f3-866a-3796-86a4-d5c759b70cf8",
                                        "glosses": [
                                            "Lettres en vers adressées à quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b93a36-50ba-44bc-9f3c-fcbf14396ead",
                                                "sense_id": "2bd0ef2d-0f7b-3ab9-8b21-d3f259a69854",
                                                "text": "Les épîtres d’Horace, de Boileau, de Pope."
                                            },
                                            {
                                                "example_id": "7440bd19-f39e-4082-b137-9a98eb85b1bf",
                                                "sense_id": "2bd0ef2d-0f7b-3ab9-8b21-d3f259a69854",
                                                "text": "Épître dédicatoire."
                                            },
                                            {
                                                "example_id": "eeada7b3-518d-4920-a4e1-4ee28f0c9d60",
                                                "sense_id": "2bd0ef2d-0f7b-3ab9-8b21-d3f259a69854",
                                                "text": "Les poëtes académiques du XVIIᵉ et du XIIIᵉ siècle n’auraient pas plus compris de telles inspirations que les paysans n’eussent admiré leurs odes, leurs épîtres et leurs poésies fugitives, si incolores, si gourmées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20210576-af3e-3a56-9355-03cb38e13a11",
                                        "entry_id": "cb89e2f3-866a-3796-86a4-d5c759b70cf8",
                                        "glosses": [
                                            "Texte sacré qui se dit, un peu avant l’évangile, au cours d’une messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48b2a9e-7a02-4793-8aa1-f3fa919e367a",
                                                "sense_id": "20210576-af3e-3a56-9355-03cb38e13a11",
                                                "text": "La messe en est à l’épître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f56a4c20-a974-4c74-88cd-0853540adea3",
                        "source_entry_id": "142f9b4c-14ba-3fae-9cf7-5ff2a57f279e",
                        "source_sense_id": "4ce2b080-3856-3842-9531-eabdd4a42e4d",
                        "source_sense_description": "in Briefform verfasste Apostelschriften im Neuen Testament",
                        "target_lang_word": "épitre",
