                                        "sense_id": "75d7ee3f-f6f2-392e-80e2-42cbff61399c",
                                        "entry_id": "74f604a8-ea93-32b2-8292-4fed2b290c99",
                                        "glosses": [
                                            "Relatif à Acy-Romance, commune française située dans le département des Ardennes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
