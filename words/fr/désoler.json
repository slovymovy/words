                    "frequency": "Middle",
                    "semantic_group_id": "contrariete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce retard imprévu me <w>désole</w>, mais nous devons reporter notre réunion."
                        },
                        {
                            "text": "Votre départ prématuré le <w>désole</w> beaucoup, car il comptait sur votre aide."
                        }
                    ],
                    "synonyms": [
                        "contrarier",
                        "peiner"
                    ],
                    "antonyms": [
                        "réjouir"
                    ],
                    "common_phrases": [
