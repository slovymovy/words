                        "cross_references": [
                            {
                                "target_word": "palidecer",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "00d7d1c5-1e06-3727-a9e5-65d384216808",
                                        "entry_id": "5fc03a36-9320-3e0d-a3d2-486f17f58438",
                                        "glosses": [
                                            "Ponerse pálido o lívido, perder color de piel por enfermedad, debilidad, temor, u otro tipo de emoción intensa y negativa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c29ed5d-51ac-4064-8089-b0edfe6a7e87",
                                                "sense_id": "00d7d1c5-1e06-3727-a9e5-65d384216808",
                                                "text": "Se había aferrado al brazo de su marido deseando hablar, explicar, y fue aquí donde su pánico, rebelde, saltó por sobre todo argumento: —«Quiero irme."
                                            },
                                            {
                                                "example_id": "649850f9-99bb-46aa-b66a-445387241506",
                                                "sense_id": "00d7d1c5-1e06-3727-a9e5-65d384216808",
                                                "text": "Él la miró intensamente. Nunca había visto ella palidecer a nadie. Desde ese momento supo lo que era: una blancura insólita afilando el pómulo, una cara inmóvil donde sólo viven los ojos, brillantes y fijos.\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7653949-186c-3e72-80c2-f3943afae59e",
                                        "entry_id": "5fc03a36-9320-3e0d-a3d2-486f17f58438",
                                        "glosses": [
                                            "Perder fuerza, importancia, aprecio, influencia, significación, prestigio o fama."
                                        ],
                                        "tags": [
                                            "se aplica especialmente",
                                            "cosas tales como la reputación",
                                            "la influencia",
                                            "el esplendor de una civilización",
                                            "de un reinado",
                                            "etc"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
