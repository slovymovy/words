                "senses": [
                    {
                        "sense_id": "6469190a-718c-3ba4-9519-d7802fdfc1ab",
                        "entry_id": "ef5cefae-d63f-3977-bfa6-1e059b0ba52c",
                        "glosses": [
                            "Action de passer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                        "entry_id": "ef5cefae-d63f-3977-bfa6-1e059b0ba52c",
                        "glosses": [
                            "Tissu plat et un peu large, de fil d’or, de soie, de laine, etc., qu’on met pour ornement sur des vêtements, sur des meubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a7cf99-cb4a-4a79-8feb-5d5f6bd659e1",
                                "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                                "text": "Passement d’or, d’argent, de soie, etc."
                            },
                            {
                                "example_id": "4b23edbf-4e4d-48c9-8231-fca0ac310c4a",
                                "sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                                "text": "C’est du passement français, du huit-brins… Mais si vous voulez, nous en avons de l’ordinaire, du gros… Celui-là est à quarante-cinq kopecks l’archine mais, excusez du peu, ce n’est pas la même qualité !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8a31feb-cb9f-4dd1-88dc-511efed73751",
                        "source_entry_id": "ef5cefae-d63f-3977-bfa6-1e059b0ba52c",
                        "source_sense_id": "4dc94da9-06b7-3796-a8ce-9eecdae9e279",
                        "target_lang_word": "Posament",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Posament",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                        "entry_id": "8911bac6-ff80-3785-b666-8342342c68bd",
                                        "glosses": [
                                            "textiler Besatz (zum Beispiel eine kunstvoll gearbeitete Franse, Quaste oder Borte) zum Verzieren von Kleidungsstücken, Decken, Polstern, Polstermöbeln und dergleichen"
                                        ],
                                        "tags": [
                                            "Kunsthandwerk",
                                            "ganz überwiegend im Plural; im Singular auch als Gattungsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e653098-55c2-4d81-bc97-fc0216185b35",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Man verfertigt in derselben, alle Arten von seidenen Bändern, Agremens, Bastardkanten, und verschiedene andre Passemente; nämlich: […]“"
                                            },
                                            {
                                                "example_id": "e719b10c-7c3e-42c7-a73d-b6f7289add1e",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Wie eine Schneiderfigurine blickt sie auf meinen Samtanzug, der seinerseits mit Posamenten überladen und von einem Modeblatt zu stammen scheint.“"
                                            },
                                            {
                                                "example_id": "d6a2b003-270c-412b-8149-f961b7452bcd",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Die Montez spielt darin eine etwas anrüchige Hafendame, sie wird ein cerise-rotes Kleid mit Perlen und Posamenten tragen, Tüllröcke mit Pailletten und Federn.“"
                                            },
                                            {
                                                "example_id": "aaff070b-b69e-4347-baf5-915e03fc0961",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Bei Genny wurde den Mennequins eine Kaiserin Sissi-Frisur verpaßt, die Modelle in Sanduhrlinie à la Wiener Hofburg üppig mit Tressen, Posamenten und Schleifen garniert.“"
                                            },
                                            {
                                                "example_id": "4d31de3d-8b30-4b01-8614-732c7ff0ab80",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Zusammen mit zwei Vollzeittangestellten und je nach Bedarf mehreren Heimarbeiterinnen produziert Ruedi Leemann nebst den klassischen Posamenten auch Klöppelspitzen und Lampenstoffe.“"
                                            },
                                            {
                                                "example_id": "86ad983c-3e40-42ec-9742-2aee384da63b",
                                                "sense_id": "6b28edca-62f3-3466-a244-923e2747b41f",
                                                "text": "„Die Berichte, die sie erhielten, die Zeichnungen, welche die Boten mitbrachten, waren detailliert und taugten zur Diskussion mit dem Schneider darüber, wie ein Kragen zu drapieren, ein Mieder zu binden, ein dekoratives Posament (eine Borte, eine Quaste, ein Band) zu sitzen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f2ce629-2eea-3654-a01f-33621f20b060",
                                        "entry_id": "8911bac6-ff80-3785-b666-8342342c68bd",
                                        "glosses": [
                                            "Unterbau beziehungsweise Sockel von Büsten, Statuen, Säulen oder Ähnlichem; Postament"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c81570-c42b-46e7-bd55-6cd75ef7b3c4",
                                                "sense_id": "8f2ce629-2eea-3654-a01f-33621f20b060",
                                                "text": "„Der Mord geschahe von denen Raths-Herrn in jenem Rath-Hauß / welches der Pompejus erbauet hatte / und zwar bey dem Posament der Statuen deß Pompeij; daß er also Todter zu dessen Füssen lage."
                                            },
                                            {
                                                "example_id": "f5f90bad-b916-42e1-ba6c-1952f3f72d52",
                                                "sense_id": "8f2ce629-2eea-3654-a01f-33621f20b060",
                                                "text": "„Seit dieser Zeit haben dessen Nachkommende, gemeldten Geschlechts, viel schöne Arbeit, […] in unser Gn. Hrn. Zeughauß, wie auch in andere Orth verfertiget, auch unlängst von schönen Laubwerck ausgearbeitete, von Metall gegossene Posament, so auf denen Marmor-Säulen an des Rathhauses Portal stehen.“"
                                            },
                                            {
                                                "example_id": "880e759a-f053-4b50-9d86-96e536b942a3",
                                                "sense_id": "8f2ce629-2eea-3654-a01f-33621f20b060",
                                                "text": "„Das Fußgestell, auch Säulenstuhl, Postament, Basement, Untergestell; Stylobata; Fr. Pièdestal, Pasement genannt […], ist der unterste Theil einer Säule, worauf dieselbe mit dem Schaftgesimse zu stehen kommt oder ruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
