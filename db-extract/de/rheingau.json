                    {
                        "sense_id": "fa2efeba-2d32-336d-9ae8-4d50ca13cbe9",
                        "entry_id": "fbde5327-578b-3236-a022-9bf2876419a7",
                        "glosses": [
                            "rechtsrheinische Landschaft in Hessen, westlich von Wiesbaden, bis Lorch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb390a4-4eef-41ec-8864-aa909c44c545",
                                "sense_id": "fa2efeba-2d32-336d-9ae8-4d50ca13cbe9",
                                "text": "„Muss es der Wein aus Südafrika sein oder geht auch der aus dem Rheingau?“"
                            },
                            {
                                "example_id": "ced66279-2c0e-4f6e-820a-ca8257d72c07",
                                "sense_id": "fa2efeba-2d32-336d-9ae8-4d50ca13cbe9",
                                "text": "„Als sein Schiff zuvor die sanften Hänge des Rheingaus passierte, griff er nach einem Buch und las darin.“"
                            },
                            {
                                "example_id": "48416e18-4390-4eb5-a828-cced276b234f",
                                "sense_id": "fa2efeba-2d32-336d-9ae8-4d50ca13cbe9",
                                "text": "„Die Folgen waren dramatisch: die Wasserburgen im Rheingau verlandeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
