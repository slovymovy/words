                                "target_senses": [
                                    {
                                        "sense_id": "14f66e3f-dcdf-3c71-850d-7b07cf2e2ae9",
                                        "entry_id": "4908328e-30fa-327e-98b1-7a49349a3c96",
                                        "glosses": [
