                "senses": [
                    {
                        "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                        "entry_id": "29d3b87b-198a-3cd4-b07b-fab1288c75f1",
                        "glosses": [
                            "Gewerkschaftsfunktionärin, welche hauptamtlich angestellt ist und verschiedene Tätigkeitsfelder übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793081e2-c34f-4f78-93a0-6da994c91306",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Die Zürcher Gewerkschaftssekretärin: bald wieder „frei“ für ganz Neues.“"
                            },
                            {
                                "example_id": "27d8773f-a684-4c5f-9c58-db659bdca351",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Bei den Einsparungen denkt die Gewerkschaftssekretärin an die Erhöhung des Rentenalters der Frauen auf 65 Jahre und Kürzungen bei den Witwenrenten.“"
                            },
                            {
                                "example_id": "b058ebe9-ad94-4cec-988b-d072b484ef4c",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Gewerkschaftssekretärin Hilke Stein betonte: ‚Zum LBK Hamburg gehören auch dessen Tochterbetriebe, und damit gilt auch für sie das Rückkehrrecht.‘“"
                            },
                            {
                                "example_id": "6e476532-fa40-424f-8fa0-f9bba5bf4118",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„In ihrer Laudatio ließ die Gewerkschaftssekretärin Karin Migdalek vom Verdi-Fachbereich 10 in Mainz den Werdegang der Geehrten Revue passieren.“"
                            },
                            {
                                "example_id": "ce027852-f1cf-4dea-8e6e-50bc062385cd",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„‚Der unbefristete, sichere Arbeitsplatz ist wesentlich für ein menschenwürdiges Leben‘, sagt Gewerkschaftssekretärin Karin Dechert.“"
                            },
                            {
                                "example_id": "4effcd0c-8213-4797-87e0-fa9ae50d5909",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Beim Aktionstag der IHK im April in Bargen hatte die Schweizer Gewerkschaftssekretärin Heidi Rebsamen betont, der zivile Zoll habe im Jahr 2015 der Schweiz insgesamt 21,7 Milliarden Schweizer Franken erwirtschaftet und damit rund ein Drittel der gesamten Bundeseinnahmen.“"
                            },
                            {
                                "example_id": "b45d7ea8-1cb7-4b37-81d0-ea668c4a107d",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„‚Es gibt Schulhäuser, in denen mehr als 80 Prozent der Lehrpersonen befristet angestellt sind‘, sagt Gewerkschaftssekretärin Kerstin Wenk.“"
                            },
                            {
                                "example_id": "40e5a810-3d09-4dd9-813c-78e359fbe8ae",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Die 29-jährige Gewerkschaftssekretärin der IG Metall Gütersloh-Oelde, kommt an die Schulen, um die Azubis über ihre Rechte und Pflichten aufzuklären.“"
                            },
                            {
                                "example_id": "9e62edda-8b6a-43db-bcb0-b8412db1f877",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Die Gewerkschaftssekretärin erläutert, wie eingeschränkt der Deutsche Gewerkschaftsbund in den vergangenen Jahren war: 2020 wurden statt einer Zusammenkunft Fotos und Videos aufgenommen und ins Internet gestellt; 2021 war eine Kundgebung geplant, musste dann aber doch abgesagt werden.“"
                            },
                            {
                                "example_id": "c4f07a44-8e9c-47db-8e24-01673cd6e3bb",
                                "sense_id": "ae5c9a4d-d563-374c-b551-8e47342ee3fd",
                                "text": "„Die Kürzungen seien \"eine Entscheidung für überfüllte Seminarräume, weniger Studienplätze, überarbeitete Angestellte und marode Gebäude\", sagte die für die Hochschulen zuständige Gewerkschaftssekretärin Julia Dück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
