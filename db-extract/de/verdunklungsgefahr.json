                        "entry_id": "9210394c-9171-3632-b9f2-7dd1f7675c92",
                        "glosses": [
                            "the likelihood that a defendant will take actions (whether legal or illegal) to destroy, hide or alter important evidence (physical or otherwise) while out of custody"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ca8e54c7-e754-45aa-a3c0-a5fb55e3011f",
                                "sense_id": "d57a03bd-edf4-3700-b17f-51b2d051231a",
                                "text": "Da alle relevanten Akten mittlerweile beschlagnahmt sind, besteht keine Verdunklungsgefahr mehr und somit auch kein Grund zur Verlängerung der Untersuchungshaft.",
                                "translation": "Since all relevant files have now been seized, there is no longer any danger of obfuscation of evidence and therefore no reason to extend pre-trial detention.",
                                "english": "Since all relevant files have now been seized, there is no longer any danger of obfuscation of evidence and therefore no reason to extend pre-trial detention."
