                "translations": [
                    {
                        "translation_id": "edb0ed02-006c-49df-bc1e-eefadcb0f749",
                        "source_entry_id": "95199f56-f5ba-3873-ae00-eb074c11f51b",
                        "source_sense_id": "58c2b84d-8b1b-3176-bdd3-ebcd9376b12b",
                        "target_lang_word": "stag's-horn clubmoss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stag's-horn clubmoss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f98ee140-8575-32db-8963-547b9aa2204a",
                                        "entry_id": "73ea44df-36db-389a-9a3b-6822013c6c16",
                                        "glosses": [
                                            "Lycopodium clavatum, a club moss in the family Lycopodiaceae."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f318fb1-f6e0-4671-a7ff-07138b7ea565",
                                                "sense_id": "f98ee140-8575-32db-8963-547b9aa2204a",
                                                "text": "Stag's-horn Clubmoss (Lycopodium clavatum) is particularly widespread in drier heathland areas, and is one of the most likely species to be encountered."
                                            },
                                            {
                                                "example_id": "ad9e6c68-1062-4248-a81b-14dcf216d807",
                                                "sense_id": "f98ee140-8575-32db-8963-547b9aa2204a",
                                                "text": "In the Stag's-horn Clubmoss (Lycopodium clavatum, Fig. 3 III, IV) these strobili are even elevated above the main system of creeping shoots on an upright, elongate and sparsely leafy \"podium\"."
                                            },
                                            {
                                                "example_id": "f980b7df-7b78-4d3a-b2c5-ff9a893a526d",
                                                "sense_id": "f98ee140-8575-32db-8963-547b9aa2204a",
                                                "text": "Fir clubmoss can spread by producing disc shaped vegetative propagules and stag's horn clubmoss can spread by means of creeping stems (stolons)."
                                            },
                                            {
                                                "example_id": "06901816-0afe-4a00-8c04-508272d33626",
                                                "sense_id": "f98ee140-8575-32db-8963-547b9aa2204a",
                                                "text": "Throughout, you'll discover a woodland carpeted with stag's-horn clubmoss (Lycopodium clavatum), trailing pine (L. digitatum) and princess pine (L. dendroideum)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
