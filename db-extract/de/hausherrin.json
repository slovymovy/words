                "senses": [
                    {
                        "sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                        "entry_id": "62ccfbdf-474d-337b-94df-ca4daf6c9075",
                        "glosses": [
                            "Dame, die in einer Familie/Organisation Entscheidungen fällen kann; Ehefrau des Hausherrn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ada8c4-aad5-42dc-8e2a-618de827f51f",
                                "sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                                "text": "„Die Hausherrin war offensichtlich alleine zu Hause, was mir nicht passte, weil sie uninteressanter und besonnener war als ihr Ehemann.“"
                            },
                            {
                                "example_id": "40e37dbd-d68e-4ecd-baf7-e0e4ef388718",
                                "sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                                "text": "„Die Hausherrin des achtzehnten Jahrhunderts trug ständig einen riesigen Schlüsselbund um die Taille, die mehr dem Schutz vor Langfingern im eigenen Haus als dem vor Einbrechern diente.“"
                            },
                            {
                                "example_id": "d54e0d6e-669f-444d-a2ce-be233063ebab",
                                "sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                                "text": "„Als freundlicher Gast folgte ich den Bitten der Hausherrin und prostete den verbleibenden Männern am Tisch zu.“"
                            },
                            {
                                "example_id": "c153f5e4-2d9c-4a6a-832c-fbef0660f3c5",
                                "sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                                "text": "„Doch als die Hausherrin vorschlug, uns ihre Kapelle zu zeigen, schützte ich Müdigkeit vor, die sich prompt einstellte nach soviel gutem Essen und Trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "892a9384-2b9b-3d92-8f5d-ab4d74b0a215",
                        "entry_id": "62ccfbdf-474d-337b-94df-ca4daf6c9075",
                        "glosses": [
                            "Dame, die ein Haus/mehrere Häuser besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9243a4d4-986c-4cdb-bafb-0816c6481d2c",
                                "sense_id": "892a9384-2b9b-3d92-8f5d-ab4d74b0a215",
                                "text": "Eine Versicherung ist die Hausherrin dieses Gebäudes."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93d03208-9e7c-4a44-8d45-0e52e449467a",
                        "source_entry_id": "62ccfbdf-474d-337b-94df-ca4daf6c9075",
                        "source_sense_id": "b871aa95-7a32-3ab1-af1c-35b625ad8c4d",
                        "source_sense_description": "Dame, die in einer Familie/Organisation Entscheidungen fällen kann; Ehefrau des Hausherrn",
                        "target_lang_word": "maîtresse de maison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maîtresse de maison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                        "entry_id": "8c5e5b94-fdb7-3769-a432-f49fd819e4e9",
                                        "glosses": [
                                            "Celle qui dirige la maison, qui reçoit des visites ou des invités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5b0f37-a152-49a7-9919-dc34a62402bf",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Comme maîtresse de maison, Alix a en gouvernation les clefs des appartements."
                                            },
                                            {
                                                "example_id": "f0dc69a0-334a-48eb-b6f5-e4f7e8b6bc13",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "La maîtresse de maison a, dans Homère, la moitié du gouvernement, tous les soins intérieurs, ceux même de l’hospitalité. Elle siège vis-à-vis du mari, et comme son égale, au foyer."
                                            },
                                            {
                                                "example_id": "910a0d7e-eb67-40ab-8e3a-216079e75e0f",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "De toutes les maîtresses de maison où il dînait, Mme Berthier était la seule que Pons nommât de son petit nom : il lui disait : « Félicie ! » et il croyait parfois être compris par elle."
                                            },
                                            {
                                                "example_id": "f94290fe-5210-494e-8b9e-c829f1dcefee",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Fierté des maîtresses de maison formées aux traditions familiales, la blanquette est, révérence gardée, à la cuisine française ce que Molière est au théâtre."
                                            },
                                            {
                                                "example_id": "254521ac-50e5-4469-9abb-414b49f542c0",
                                                "sense_id": "88173095-8750-3a4e-b4ba-aa96b21902c5",
                                                "text": "Je suis une maîtresse de maison désastreuse, mais je rattrape le coup en mettant tout en place à la one again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75de9bd8-3f86-4d6f-8bad-8d7516908b0b",
                        "source_entry_id": "62ccfbdf-474d-337b-94df-ca4daf6c9075",
