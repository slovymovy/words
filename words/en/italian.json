            "senses": [
                {
                    "sense_id": "10ec9932-1a5e-3943-b3f8-052e6277cb50",
                    "sense_definition": "The official Romance language spoken in Italy and parts of Switzerland.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She speaks <w>Italian</w> fluently after living in Rome for two years.",
                            "target_lang_translations": {
                                "ru": "Она свободно говорит по-<w>итальянски</w> после двух лет жизни в Риме.",
                                "zh": "在罗马住了两年后，她能流利地说<w>意大利语</w>。"
                            }
                        },
                        {
                            "text": "I am learning <w>Italian</w> because I love the opera.",
                            "target_lang_translations": {
                                "ru": "Я учу <w>итальянский</w>, потому что люблю оперу.",
                                "zh": "我正在学习<w>意大利语</w>，因为我热爱歌剧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Italian",
                        "learn Italian",
                        "fluent in Italian"
                    ],
                    "target_lang_definitions": {
