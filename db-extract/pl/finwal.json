                    {
                        "translation_id": "e064ffc6-cf24-4726-8929-e36ec4d09880",
                        "source_entry_id": "d9c557c3-fa73-32b8-90c2-bbfcd1d1b498",
                        "source_sense_id": "bd2d2d45-a5e5-3297-af00-8e7b2fa0531e",
                        "target_lang_word": "Finnwal",
                        "target_lang_code": "de",
