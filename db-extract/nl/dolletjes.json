                        "examples": [
                            {
                                "example_id": "6529f0aa-dedf-4103-896f-3fe1bc7e7061",
                                "sense_id": "620e05aa-af8f-3f3c-972b-5f7d36603bac",
                                "text": "Nou, ik veur me zelf mag van ’eluk spreke dat onze lieve ’Eertje me geen konaijn het ’emaekt. ’k Zou er stikke. Lucht mot ik 'ebbe. Weetje, lucht en waeter. ’k Zal er raeis dolletjes onderduike, dat beloof ik ie, ’oor!"
                            },
                            {
                                "example_id": "c4568940-d174-431c-af0d-07df86bd747b",
                                "sense_id": "620e05aa-af8f-3f3c-972b-5f7d36603bac",
                                "text": "De eenige plek waar het min of meer „dolletjes\" toeging, was in de onderwereld, de rookkamer. Dit is typisch: een Hollander schijnt eerst los te komen in den tabaksrook."
                            }
                        ]
                    }
