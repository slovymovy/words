                    },
                    {
                        "form_id": "a7e0cb21-d14e-49fd-ba63-827dac25a319",
                        "entry_id": "aa427365-88e0-35d3-a66a-f8b61b465a72",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "зазнава́вшись"
                    },
                    {
                        "form_id": "a1a36782-7ff3-4123-bd5a-4ab190961978",
                        "entry_id": "aa427365-88e0-35d3-a66a-f8b61b465a72",
