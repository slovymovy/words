                "senses": [
                    {
                        "sense_id": "7e665ad8-16f9-347c-9883-b716ebddfa2c",
                        "entry_id": "8fb72220-5761-35fe-bed6-e3a7698ac0ea",
                        "glosses": [
                            "Page web dans un sous-répertoire. Le nom de la sous-page comprend une ou plusieurs barres obliques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2331326-db03-4156-827e-097ec974af94",
                        "source_entry_id": "8fb72220-5761-35fe-bed6-e3a7698ac0ea",
                        "source_sense_id": "7e665ad8-16f9-347c-9883-b716ebddfa2c",
                        "target_lang_word": "Unterseite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterseite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                        "entry_id": "75f4f090-fbe7-398b-976f-a9979d3e0e28",
                                        "glosses": [
                                            "Teil von etwas, der normalerweise nach unten (Richtung Boden) zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5219aeb-5dba-4819-9bd4-3c885aab1c3c",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Die jungen Blindschleichen sind auf der Unterseite schwarz, auf der Oberseite hellbraun gefärbt und tragen einen schwarzen Rückenstreifen.“"
                                            },
                                            {
                                                "example_id": "ee80edf9-2f3e-4683-9947-5d2c6645d661",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Die Oberseite der Zungenwurzel geht unmittelbar in die mittlere Fläche der Gaumenbögen und Mandeln über, die Unterseite ist durch eine derbe Schleimhautfalte (Frenulum linguae, Zungenbändchen) am Zahnfleisch fixiert.“"
                                            },
                                            {
                                                "example_id": "a2dbe7f5-c4f6-4afa-8a02-e2369dd026c6",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Auf der Unterseite hat die Graugans schwarze Flecken.“"
                                            },
                                            {
                                                "example_id": "87fa9de3-abb0-4d7f-b1e1-1fc8b3d6c193",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„In der Kammer, die ich betrat, waren nur ein Tisch, ein Stuhl, ein kleiner Spiegel und ein Bett mit zusammengerollter Matratze, so daß nur deren Unterseite zu sehen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                        "entry_id": "75f4f090-fbe7-398b-976f-a9979d3e0e28",
                                        "glosses": [
                                            "Website, die Teil einer anderen Website ist, einer Website untergeordnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9d9442-4fe7-41a1-bb67-5062db55b62c",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Bislang blendet der Konzern die Anfragen nur auf den europäischen Unterseiten wie Google.de oder Google.fr aus.“"
                                            },
                                            {
                                                "example_id": "166bfac8-304f-41aa-977d-989bd6fc5bee",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Die Information zur Energieeffizienzklasse erschien erst, nachdem der User ein konkretes Gerät angeklickt hatte und durch diesen Klick auf eine Unterseite geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "7fb17bfe-7c5c-474b-b79d-6bd4ca8003fc",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Selbst in der URL einer Unterseite ist eine \"88\" versteckt.“"
                                            },
                                            {
                                                "example_id": "8f3f2124-1496-4dd3-ba67-1b81d61b8281",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Ob sie nun den E-Mail-Dienst Gmail, die Videoplattform Youtube oder das Blogprogramm Blogger nutzten – für jeden einzelnen Dienst gab es spezielle Unterseiten, über die sich Einstellungen zur Nutzung der Dienste oder zum Schutz der Privatsphäre verwalten ließen.“"
                                            },
                                            {
                                                "example_id": "3bb65564-e7de-4843-82eb-5ab06504c09f",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Seit Freitag ist eine neue Unterseite im städtischen Internet-Auftritt zu finden, auf der alle, die helfen wollen, einen Überblick über Hilfsangebote erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
