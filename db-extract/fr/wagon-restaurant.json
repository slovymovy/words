                    },
                    {
                        "form_id": "516192a5-13a4-48ef-92ec-d859c57ab61c",
                        "entry_id": "e8886922-8452-359e-be5a-980cd2d124ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "wagons-restaurant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                        "entry_id": "e8886922-8452-359e-be5a-980cd2d124ad",
                        "glosses": [
                            "Voiture aménagée pour y servir des repas aux voyageurs d’un train."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e299e688-3369-4a3e-a228-d313156257a6",
                                "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                                "text": "Je visite alors le wagon-restaurant. Il est d’un tiers plus long que les autres wagons, une véritable salle à manger, garnie d’une unique table ; à l’arrière, d’un côté se trouve un office, de l’autre une cuisine, où fonctionnent le cuisinier et le maître d’hôtel, tous les deux d’origine moscovite."
                            },
                            {
                                "example_id": "6cfe835f-95ed-4839-a113-88fd600c5327",
                                "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                                "text": "[…] elle suppliait sa cousine Florence de l’interroger sur la traduction de tel mot, de telle locution, plutôt que la laisser savourer la poularde à la crème qu’une escouade de grooms leur présentait en soulevant des cloches argentées dans le wagon-restaurant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "811c988e-8290-412b-8d2c-71c7a7f222d6",
                        "source_entry_id": "e8886922-8452-359e-be5a-980cd2d124ad",
                        "source_sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                        "target_lang_word": "Speisewagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisewagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                        "entry_id": "d10908ad-9c37-39ea-a08d-515ed9f37988",
                                        "glosses": [
                                            "Wagen in einem Personenzug, in dem man speisen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67933c07-a8ca-4dba-ad45-88dce7c1dd5d",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "Auf der Strecke Hamburg - Prag wird in den tschechischen Speisewagen noch richtig auf einem Herd gekocht - und nicht nur aufgewärmt, wie in den deutschen Zügen."
                                            },
                                            {
                                                "example_id": "a71b2740-aaec-4366-bdf3-d762d9e7bbb1",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Während ich zurück zum Speisewagen gehe, denke ich über das deutsch-polnische Ehepaar in meinem Abteil nach.“"
                                            },
                                            {
                                                "example_id": "f567acfc-6848-4856-a9e2-fe4f80efa19c",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Meine Mutter konnte vor Aufregung im Speisewagen gar nicht frühstücken.“"
                                            },
                                            {
                                                "example_id": "a425304b-9f78-4207-9efd-3c8316891067",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Daraufhin hatte sie sich im Speisewagen ein üppiges Mittagessen geleistet.“"
                                            },
                                            {
                                                "example_id": "ce7bacd8-0193-431f-b48c-304fdb1a5320",
                                                "sense_id": "416f42f4-c24e-305d-bc20-4af1fe2a3235",
                                                "text": "„Im Zug war er schließlich in den Speisewagen gegangen, um sich ein Bier zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
