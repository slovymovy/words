                                        "examples": [
                                            {
                                                "example_id": "ad8f2809-40c0-4f2e-9416-6fd87d7eaac4",
                                                "sense_id": "211dcb93-82c8-3093-a40e-69ffbfe8d84a",
                                                "text": "У пояса, в кожаной кобуре, висел старый друг, семизарядный револьвер, а за плечами — ёмкая дорожная сумка."
                                            },
                                            {
