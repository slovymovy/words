                    {
                        "sense_id": "d6201872-34fa-3934-bc91-a146310623f6",
                        "entry_id": "a55ee3ce-44bb-3bd5-aaed-2ca75ecfc451",
                        "glosses": [
                            "Covered by or carrying an umbrella."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c300f1d5-b261-4f1f-a2a5-f61e3ba7334e",
                                "sense_id": "d6201872-34fa-3934-bc91-a146310623f6",
                                "text": "1892, Ambrose Bierce, “The Applicant,” in The Collected Works of Ambrose Bierce, Volume II: In the Midst of Life (Tales of Soldiers and Civilians), New York: Gordian Press, 1966,\nHe was hatted, booted, overcoated, and umbrellaed, as became a person who was about to expose himself to the night and the storm on an errand of charity […]"
                            },
                            {
                                "example_id": "d89973cd-334e-47eb-8550-1ab4df00410b",
                                "sense_id": "d6201872-34fa-3934-bc91-a146310623f6",
                                "text": "It was a dull, rainy, depressing day as I stood upon the dock-side above the landing-stage, and watched the tender come sidling up with the crowd of umbrellaed passengers upon her deck, and my errand was not of a kind to elevate the spirits."
                            },
                            {
                                "example_id": "382565bb-0961-41bc-bc0f-d4bc9aeaed86",
                                "sense_id": "d6201872-34fa-3934-bc91-a146310623f6",
                                "text": "[W]e had moved out to one of the umbrellaed tables, out of easy earshot from the bartender."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e3fe314-eb5c-340b-96eb-a5f71d767c4d",
                        "entry_id": "a55ee3ce-44bb-3bd5-aaed-2ca75ecfc451",
                        "glosses": [
                            "Under an umbrella."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b318b46a-5d9e-449b-9991-6dac323c3c2a",
                                "sense_id": "8e3fe314-eb5c-340b-96eb-a5f71d767c4d",
                                "text": "His ideal of a woman looked up at Tom Smith's great sun-burnt Lincoln-like face, umbrellaed by the fateful sombrero, and laughed."
                            },
                            {
                                "example_id": "9d2f9dff-3879-4f18-9863-ad366899329c",
                                "sense_id": "8e3fe314-eb5c-340b-96eb-a5f71d767c4d",
                                "text": "How then are these umbrella-ed powers to respond, as they see their own security diminishing [...]"
                            },
                            {
                                "example_id": "51850f4c-4dc4-42fb-b94f-4daf988ed111",
                                "sense_id": "8e3fe314-eb5c-340b-96eb-a5f71d767c4d",
                                "text": "[...] a loose collective of prostitute advocacy groups, prostitution survivors and academic activists, commonly umbrellaed under the label \"radical feminist.\""
                            }
                        ]
                    }
