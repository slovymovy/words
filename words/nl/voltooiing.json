{
    "word_family": [
        "voltooien",
        "voltooid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cb01823-30a3-397e-85f9-9323426928ef",
                    "sense_definition": "het proces van iets afmaken of tot een einde brengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>voltooiing</w> van het nieuwe kantoorgebouw heeft bijna twee jaar geduurd.",
                            "target_lang_translations": {
                                "en": "The <w>completion</w> of the new office building took almost two years."
                            }
                        },
                        {
                            "text": "Na de <w>voltooiing</w> van zijn studie besloot hij een lange reis door Azië te maken.",
                            "target_lang_translations": {
                                "en": "After the <w>completion</w> of his studies, he decided to take a long trip through Asia."
                            }
                        }
                    ],
                    "synonyms": [
                        "finalisering",
                        "finalisatie",
                        "completering",
                        "afronding",
                        "beëindiging"
                    ],
                    "common_phrases": [
                        "na de voltooiing",
                        "voltooiing van de bouw"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of finishing something or bringing it to an end"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "completion",
                                "target_lang_sense_clarification": "the act of finishing a task or project"
                            },
                            {
                                "target_lang_word": "accomplishment",
                                "target_lang_sense_clarification": "the act of carrying out or finishing an enterprise"
                            },
                            {
                                "target_lang_word": "finalization",
                                "target_lang_sense_clarification": "the process of making something final"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c32dc538-31e5-3ecc-967e-de21355a2d56",
                    "sense_definition": "het resultaat of de staat van iets dat helemaal af is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit schilderij wordt door velen gezien als de <w>voltooiing</w> van zijn artistieke carrière.",
                            "target_lang_translations": {
                                "en": "This painting is seen by many as the <w>culmination</w> of his artistic career."
                            }
                        },
                        {
                            "text": "De succesvolle lancering was de <w>voltooiing</w> van een jarenlang wetenschappelijk project.",
                            "target_lang_translations": {
                                "en": "The successful launch was the <w>completion</w> of a years-long scientific project."
                            }
                        }
                    ],
                    "synonyms": [
                        "completering"
                    ],
                    "common_phrases": [
                        "een kroon op de voltooiing"
                    ],
                    "target_lang_definitions": {
                        "en": "the result or state of something being completely finished"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "completion",
                                "target_lang_sense_clarification": "the state of being finished"
                            },
                            {
                                "target_lang_word": "consummation",
                                "target_lang_sense_clarification": "the point at which something is complete or finalized"
                            },
                            {
                                "target_lang_word": "culmination",
                                "target_lang_sense_clarification": "the highest or climatic point of something, especially as attained after a long time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
