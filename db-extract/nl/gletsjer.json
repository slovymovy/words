                "senses": [
                    {
                        "sense_id": "0d1b161f-0fbc-3989-8ab9-788440be9f61",
                        "entry_id": "a02303c2-8b17-33bc-881c-cf4063373041",
                        "glosses": [
                            "een ijsmassa die gevormd wordt op land en dik en groot genoeg is om bergafwaarts te stromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff46b39e-d51b-4ffd-9027-bf592016878b",
                                "sense_id": "0d1b161f-0fbc-3989-8ab9-788440be9f61",
                                "text": "Beneden aan de gletsjer was er een meer ontstaan."
                            },
                            {
                                "example_id": "33efe27c-a67c-447f-b5e7-a4b59384d161",
                                "sense_id": "0d1b161f-0fbc-3989-8ab9-788440be9f61",
                                "text": "Een jonge poolvos heeft Noorse onderzoekers versteld doen staan met een zeer lange én snelle wandeling. Het dier liep - over land, gletsjers en zee-ijs - van Noorwegen naar Canada en legde de in totaal 3.506 kilometer af in 76 dagen. ,,We konden onze ogen niet geloven.”"
                            },
                            {
                                "example_id": "8fc75d6a-e3d3-45ba-a7c8-d1f24f6692a9",
                                "sense_id": "0d1b161f-0fbc-3989-8ab9-788440be9f61",
                                "text": "Ik liep langs vele gletsjers die de afgelopen honderd jaar voor meer dan de helft waren geslonken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f80974ea-870a-48be-a70b-f83a2a670e43",
                        "source_entry_id": "a02303c2-8b17-33bc-881c-cf4063373041",
                        "source_sense_id": "0d1b161f-0fbc-3989-8ab9-788440be9f61",
                        "source_sense_description": "een ijsmassa die gevormd wordt op land en dik en groot genoeg is om bergafwaarts te stromen",
                        "target_lang_word": "Gletscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gletscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                        "entry_id": "8fd650b1-53de-3485-b8f1-acecbc9834f8",
                                        "glosses": [
                                            "Eismasse, die bis zu mehrere hundert Meter dick sein kann und sich durch das Eigengewicht in langsamem Fluss talwärts bewegt"
                                        ],
                                        "tags": [
                                            "Glaziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c44605-3e11-4f67-ab67-4f602ae757d2",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "Ein Gletscher entsteht durch die Ansammlung von Schnee, der nicht schmilzt, sondern sich immer weiter ansammelt."
                                            },
                                            {
                                                "example_id": "0ed5dd2c-2fcd-45a9-a20f-bf5a8e21a617",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "„Der Himmel über den Berggipfeln war von reinstem Blau, die Gletscher wirkten menschenfeindlicher denn je.“"
                                            },
                                            {
                                                "example_id": "6531a593-928a-42d2-8d5a-9955e687ef13",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "„Auf meiner ersten Reise nach Island habe ich eine Wanderung auf einem Gletscher gemacht.“"
                                            },
                                            {
                                                "example_id": "2dddd5aa-99a8-45b2-a1d6-f0a4956f3b25",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "„Obwohl sie größtenteils von Gletschern bedeckt und die umgebenden Fahrwasser im gesamten Winterhalbjahr zugefroren sind, gibt es dort eine reichhaltige Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "ccf82714-a554-4db5-890f-3002ef3e08e6",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "„Bergsteigen heißt nicht nur Klettern: Wenn sich Bergsteiger zum Gipfel aufmachen, müssen sie auch wegloses Gelände, Felswände, Schneefelder und Gletscher überwinden.“"
                                            },
                                            {
                                                "example_id": "1cbddfe1-6dad-4cb7-926e-dce37dbdf4d6",
                                                "sense_id": "dcebc741-aec8-3dbf-8e64-c8c2d82cf4e9",
                                                "text": "[Weichsel-Würm-Kaltzeit - 115.000 bis 10.000 v. Chr.:] „Riesige Gletscher lasteten mit einer Dicke von fast vier Kilometern auf Skandinavien sowie auf den Britischen Inseln und Irland. Ihre Fläche war etwa 20-mal so groß wie Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb28832b-90c3-4527-9ff7-0bc09e0b5cb6",
                        "source_entry_id": "a02303c2-8b17-33bc-881c-cf4063373041",
