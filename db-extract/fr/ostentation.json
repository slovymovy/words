        "fr-extract.jsonl": [
            {
                "entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                "word": "ostentation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8048da4b-2e4e-45f4-b9b1-dd63546f511b",
                        "entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "tags": [
                            "plural"
                        ],
                        "form": "ostentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                        "entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "glosses": [
                            "Affectation de montrer des qualités ou des avantages dont on veut faire parade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d20084-11d3-4645-8161-3caf6f79ff18",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Notre monde n’est formé qu’à l'ostentation : les hommes ne s'enflent que de vent …."
                            },
                            {
                                "example_id": "e12dc8e3-2c71-4ab3-8f72-4b3cd0a64f2f",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Son ostentation est doublée de générosité. Les résultats profitent à la société, les motifs regardent Dieu."
                            },
                            {
                                "example_id": "88233c8a-5b64-4512-8c60-397cf0021dea",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Elle aurait eu de l’amitié pour lui si elle ne l’avait trouvé rusé, sournois et trop subtil à lui tirer sa signature quand il avait besoin d’argent pour des entreprises où il mettait plus d’ostentation que d’avidité."
                            },
                            {
                                "example_id": "db385cae-ceee-4a64-9e96-0e82efbde2b0",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Par ostentation, parfois, une munitionnette, qui ne paye d'ailleurs pas son loyer comme femme de mobilisé, et mème cumule son salaire avec le salaire de son mari en certain cas, n'hésite pas à payer 10 fr. un méchant poulet, au lieu d'acheter un honnête bifteck."
                            },
                            {
                                "example_id": "5953ce24-1fa6-47cd-82d3-a1453857394b",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Je surpris, j'effarouchai en marquant tout de suite, sans ostentation, mais nettement, mon éloignement des observances religieuses."
                            },
                            {
                                "example_id": "ef24cf99-014d-4004-be2f-66b1a7686404",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "A présent bien embarrassé de ce chagrin qu’il avait provoqué avec un certain plaisir, Peter consultait le menu avec ostentation."
                            },
                            {
                                "example_id": "778bee9a-9d98-4405-bf01-40a7463d4aa2",
                                "sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                                "text": "Paradoxalement, c’est parfois le mépris qui se trouve à l’origine de la démonstration identitaire, comme le dit Amin Maalouf: « Lorsqu’on sent sa langue méprisée, sa religion bafouée, sa culture dévalorisée, on réagit en affirmant avec ostentation les signes de sa différence. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f24abc3-4668-49df-810e-a4c8ff28dd21",
                        "source_entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "source_sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                        "target_lang_word": "Prunksucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0341a0db-bcab-4693-bb26-47ff392a8d97",
                        "source_entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "source_sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                        "target_lang_word": "Prahlerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prahlerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                        "entry_id": "dc6eb28c-c5a0-3f99-a7a2-6f743537e0d2",
                                        "glosses": [
                                            "übertriebene Betonung/Hervorhebung von etwas, mit dem sich der Sprecher selbst lobt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8833d2-791e-4c1c-8b93-b8bea2eb9990",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Das war keine Prahlerei, sondern eher Untertreibung.“."
                                            },
                                            {
                                                "example_id": "b01944cc-a642-4e9a-beff-4e9a2ffaf5c2",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Man hatte bald genug, übergenug von diesem Querulanten und seiner Prahlerei, er sei schließlich schon ein Wunderkind gewesen.“"
                                            },
                                            {
                                                "example_id": "05110552-ab50-4d1f-8ea3-04a7d92c3fde",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Nationen bestehen aus einzelnen Menschen, und nicht jeder ist bereit, der Prahlerei und Rüpelei seiner Regierung Beifall zu spenden.“"
                                            },
                                            {
                                                "example_id": "680cc527-e4b8-44c5-bef1-e0d4cfa0442a",
                                                "sense_id": "bc3bd626-4881-3d94-98d7-83f029bb7b3d",
                                                "text": "„Der Ausdruck des jungen Mannes der Indianerin gegenüber hatte jene hier ziemlich alberne Prahlerei angenommen, der sich jedoch auch der sonst vernünftige Brite so gerne und nie mehr als dann überläßt, wenn es sein Vorteil zu erheischen scheint, Fremden eine recht große Idee von seinem Lande und so gelegentlich von sich selbst beizubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c47e5d08-38fa-432f-8452-e463ef2e0d9c",
                        "source_entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "source_sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
                        "target_lang_word": "ostentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fef2fcd-3847-30d5-923c-648df29a266a",
                                        "entry_id": "7936f4eb-0959-399c-8199-cd8debf253b6",
                                        "glosses": [
                                            "Ambitious display; vain show; display intended to excite admiration or applause."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aa5ed28-71ab-46f9-bc2f-3615141e9027",
                                                "sense_id": "4fef2fcd-3847-30d5-923c-648df29a266a",
                                                "text": "Sir Henry had consumed his substance in ostentation and riotous hospitality—had fed many at his board, made many merry in his halls, but not a friend was in his house of mourning; the very retainers who had grown rich upon his ruin, seemed to deem the burial of their master but a signal for carousing and license."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d128dae-3247-35b1-bbd7-7ba31cb4fbac",
                                        "entry_id": "7936f4eb-0959-399c-8199-cd8debf253b6",
                                        "glosses": [
                                            "A show or spectacle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9feae29-a144-4481-a9de-31ca640e9e52",
                                                "sense_id": "2d128dae-3247-35b1-bbd7-7ba31cb4fbac",
                                                "text": "Let her awhile be secretly kept in,\nAnd publish it that she is dead indeed:\nMaintain a mourning ostentation;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd96043-1b7b-4ae7-814f-391d2931d837",
                        "source_entry_id": "589c9ea6-c7e5-3fd4-b725-db3e2baf3612",
                        "source_sense_id": "422880df-6636-350c-a6de-8ddc58bfd906",
