                ],
                "senses": [
                    {
                        "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                        "entry_id": "090418ed-9155-3da9-b3a4-02bf4b3eb5b9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2cc6dbf-2dff-4180-9b8c-d3b720da0d59",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Frau Schöttle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b6287237-8146-42c1-944f-0f850d65ea75",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Herr Schöttle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6d2cb9c5-38ce-43d7-be2b-a65a88a6490a",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Die Schöttles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5ab85d4a-cdbd-4625-a077-f2a9c231bb80",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Der Schöttle trägt nie die Schals, die die Schöttle ihm strickt."
                            },
                            {
                                "example_id": "8a1c7861-571f-4277-a001-fef4a9e7049d",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöttle kommt, geht der Herr Schöttle.“"
                            },
                            {
                                "example_id": "be94c481-98c7-4c82-a57e-c770e50a91aa",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Schöttle kommt und geht."
                            },
                            {
                                "example_id": "bba0e984-8ed3-4ea9-8407-3c4b947d18a7",
                                "sense_id": "b67a46ee-df7b-3eba-a246-0df6b3ca5ee4",
                                "text": "Schöttles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
