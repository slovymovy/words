                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gentle words were spoken to <w>sooth</w> the angry king.",
                            "target_lang_translations": {
                                "it": "Furono pronunciate parole gentili per <w>calmare</w> il re adirato."
                            }
                        },
                        {
                            "text": "The soft music helped to <w>sooth</w> her troubled mind.",
                            "target_lang_translations": {
                                "it": "La dolce musica contribuì a <w>lenire</w> la sua mente turbata."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "soothe"
                    ],
                    "antonyms": [
                        "agitate",
                        "provoke"
                    ],
