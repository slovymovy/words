                    {
                        "translation_id": "7f222d86-146e-4fff-975f-4c876ae1e12d",
                        "source_entry_id": "bb8e88a1-0e43-3ac1-ae35-29f8f41ebc4c",
                        "source_sense_description": "strepsirrhine primate of the infraorder Lemuriformes, superfamily Lemuroidea",
