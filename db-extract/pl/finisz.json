                "translations": [
                    {
                        "translation_id": "8352e4bf-2427-4dda-aaee-ab45635bb56a",
                        "source_entry_id": "78834cf1-1dd9-3c60-a3b1-f653ae90be31",
                        "source_sense_id": "f231759c-345d-37ca-8275-01b8d5ec602e",
                        "target_lang_word": "Spurt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spurt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49e2a9aa-08aa-3cdb-871b-2eba00b2f9a0",
                                        "entry_id": "f14e0709-6fd9-3b85-af4a-346e2f419dfe",
                                        "glosses": [
                                            "kurzzeitige Beschleunigung beim Laufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf23a12-e7fd-4b42-a5a9-39492db29170",
                                                "sense_id": "49e2a9aa-08aa-3cdb-871b-2eba00b2f9a0",
                                                "text": "Er zog sich beim Spurt eine Zerrung zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43c7d2ae-6058-48a0-876e-b69c35d6949e",
                        "source_entry_id": "78834cf1-1dd9-3c60-a3b1-f653ae90be31",
                        "source_sense_id": "f231759c-345d-37ca-8275-01b8d5ec602e",
                        "target_lang_word": "финиш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "финиш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c5500f79-9bdd-366c-a60a-9184ff121b42",
                                        "entry_id": "e62fb982-a376-357b-a69c-82b6bbabb059",
                                        "glosses": [
                                            "спорт. заключительная часть спортивного состязания на скорость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f32acc9-9c79-4515-ae5b-35501cdc9aee",
                                                "sense_id": "c5500f79-9bdd-366c-a60a-9184ff121b42",
                                                "text": "До финиша гонки остается лишь 30 кругов, 20, 10… Занарди делает свою последнюю остановку на пит-лейн."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20ecd5b-127e-31a9-8227-fea631f0ffac",
                                        "entry_id": "e62fb982-a376-357b-a69c-82b6bbabb059",
                                        "glosses": [
                                            "спорт., разг. финишный рывок, ускорение в конце дистанции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1543776b-5374-4dd3-a381-581ad2241569",
                                                "sense_id": "a20ecd5b-127e-31a9-8227-fea631f0ffac",
                                                "text": "Если вы сами обладаете хорошим финишем и ваш конкурент применит только что указанную тактику, то, лучше всего, дайте ему немного уйти вперед, стараясь сохранить побольше сил на финиш, но и не давая ему черезчур оторваться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2122baf1-3a59-38ce-820f-3e8adb3680e3",
                                        "entry_id": "e62fb982-a376-357b-a69c-82b6bbabb059",
                                        "glosses": [
                                            "спорт. конечный или промежуточный пункт такого состязания, обозначенный определённым образом, а также небольшое расстояние перед ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b385790-e078-49a2-a921-9118d3b24c04",
                                                "sense_id": "2122baf1-3a59-38ce-820f-3e8adb3680e3",
                                                "text": "Весь путь был разделен на этапы: старт и финиш находились в Петровском парке, в клубе лыжников〈…〉"
                                            },
                                            {
                                                "example_id": "1519a0e5-2388-489a-bc9b-fbb498008b7b",
                                                "sense_id": "2122baf1-3a59-38ce-820f-3e8adb3680e3",
                                                "text": "Саженей за 10 до финиша команда судна «Авось», увеличив резвость гребка, вырвала первенство, пройдя установленную дистанцию в 10 м."
                                            },
                                            {
                                                "example_id": "14354feb-f52f-4330-b40c-cc0050892cf0",
                                                "sense_id": "2122baf1-3a59-38ce-820f-3e8adb3680e3",
                                                "text": "Из всех скакавших лошадей пришло к финишу меньше половины."
                                            },
                                            {
                                                "example_id": "ba42cb4b-8983-40b5-9ddc-9d25cc535eb3",
                                                "sense_id": "2122baf1-3a59-38ce-820f-3e8adb3680e3",
                                                "text": "На промежуточные и конечный финиши нужно прибыть секунда в секунду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0060b5ba-1d93-3754-9621-29d54ee79982",
                                        "entry_id": "e62fb982-a376-357b-a69c-82b6bbabb059",
                                        "glosses": [
                                            "окончание, завершение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "760ea917-66ab-4c44-b1df-3b73de0b1773",
                                                "sense_id": "0060b5ba-1d93-3754-9621-29d54ee79982",
                                                "text": "Пятьдесят девиц (от каждого штата по первой красавице) начинали ежегодное шоу, к финишу выбрались шесть, в том числе мисс Мичиган, мисс Калифорния, мисс Флорида."
                                            },
                                            {
                                                "example_id": "bd28f78d-4481-4952-8e7b-c73f2f453aee",
                                                "sense_id": "0060b5ba-1d93-3754-9621-29d54ee79982",
                                                "text": "— Ну что ж, хорошо. Где мы сейчас? — Через час выходим на финиш, — ответил Михаил Антонович. — Пойдем над северным полюсом Юпитера〈…〉"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
