                        "glosses": [
                            "находиться в процессе брожения, подвергаться брожению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad9cdb6-efad-4426-b7de-012807a3dc86",
                                "sense_id": "08f5d7ad-b461-389c-abf0-aee5d5cf139c",
                                "text": "Мореплаватели брали в дальние путешествия вместо воды яблочный сок, который в пути сбраживался."
                            }
                        ]
                    },
                    {
