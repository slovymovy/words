                        "sense_id": "e01c2fac-1c27-3155-9f49-d1d099513f68",
                        "entry_id": "260732d1-b919-351d-8f67-9a26c6189ed8",
                        "glosses": [
                            "To make unlike or describe as being unlike."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aae21b36-bb97-4c41-90fb-24b92c9ad7a1",
                                "sense_id": "e01c2fac-1c27-3155-9f49-d1d099513f68",
                                "text": "\"To unliken them would make nonsense of any poem,\" I said."
                            },
                            {
                                "example_id": "ed37fe97-9310-451d-b75f-bb62a8689fbc",
                                "sense_id": "e01c2fac-1c27-3155-9f49-d1d099513f68",
                                "text": "At some time, in a similar mood, Flaubert made an undated entry on the last page of one of his travel notebooks, likening and unlikening his accesses of depression to the midsummer rising of the Nile: 'Oh Nile!'"
                            },
                            {
                                "example_id": "3470965d-010a-4ef6-ab65-7c3dff20f792",
                                "sense_id": "e01c2fac-1c27-3155-9f49-d1d099513f68",
                                "text": "At which point, my mind abandons the count, rationalising that there are countless more unlikening bricks in this building."
                            }
                        ]
                    }
                ],
