                                "target_senses": [
                                    {
                                        "sense_id": "098a45ee-208a-3772-89ac-554e3b4de7e5",
                                        "entry_id": "a641e1f2-0e11-36c6-96ef-5a77781a2954",
                                        "glosses": [
                                            "ботан. травянистое огородное растение, листья которого употребляются в пищу в сыром виде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7a32de-3006-4fa9-bfd9-887d338c923e",
                                                "sense_id": "098a45ee-208a-3772-89ac-554e3b4de7e5",
                                                "text": "Немецкие и голландские купцы развели спаржу и салат; русские сначала смеялись над немцами, что едят сырую траву, но потом некоторые сами стали находить в ней вкус."
                                            },
                                            {
                                                "example_id": "37326508-3cff-47f2-b210-e5408735eaa6",
                                                "sense_id": "098a45ee-208a-3772-89ac-554e3b4de7e5",
                                                "text": "Выращивают на фабрике и другие овощи: капусту, редис, баклажаны, перец, салат…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605ff2b2-0ddd-38d5-96fe-f73f022f7f2b",
                                        "entry_id": "a641e1f2-0e11-36c6-96ef-5a77781a2954",
                                        "glosses": [
                                            "кулин. кушанье из листьев такого растения, заправленное уксусом, сметаной и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c05e17-1a31-333e-9282-59219fe09aec",
                                        "entry_id": "a641e1f2-0e11-36c6-96ef-5a77781a2954",
                                        "glosses": [
                                            "кулин. приправа к жарко́му из листьев салата [1] в сметане, уксусе или прованском масле; вообще — та или иная приправа к жарко́му"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceaf6887-09d9-4ae2-9b58-567f61a4b025",
                                                "sense_id": "f9c05e17-1a31-333e-9282-59219fe09aec",
                                                "text": "Жареное мясо с огурцами, пикулями и другим салатом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494246e8-866e-31b4-b52f-96183f40f2e6",
                                        "entry_id": "a641e1f2-0e11-36c6-96ef-5a77781a2954",
                                        "glosses": [
                                            "кулин. холодное блюдо из нарезанных сырых или варёных овощей, зелени, яиц и т. п., заправленное каким-либо соусом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5afa0ae-0827-4fc0-a422-5b39d715c386",
                                                "sense_id": "494246e8-866e-31b4-b52f-96183f40f2e6",
                                                "text": "Путешественник .. ел салат из крабов с провансалем .."
                                            },
                                            {
                                                "example_id": "63ae8404-7937-406e-983b-1aed86cc9f37",
                                                "sense_id": "494246e8-866e-31b4-b52f-96183f40f2e6",
                                                "text": "Если внимательно вглядеться, то можно разобрать, из чего салат составлен: картошка, морковка, зелёный горошек, крутое яйцо, отварное мясо, свежий огурец, солёный огурец, грецкий орех, яблоки, зелёная петрушка, и всё это вяло утопало в майонезе."
                                            }
                                        ]
                                    }
                                ]
                            },
