                "senses": [
                    {
                        "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                        "entry_id": "369142d9-f5f6-3c4b-96e3-523715bf1be2",
                        "glosses": [
                            "zweiundzwanzigster Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a17cdb-b371-4a5f-9ec7-557e54509d79",
                                "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                                "text": "Die Fläche des Bezirkes Donaustadt beträgt rund ein Viertel der Fläche Wiens."
                            },
                            {
                                "example_id": "01d005e0-52b4-4bd5-ba9d-ee825b943c6e",
                                "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                                "text": "Die Donaustadt wächst derzeit wie kein anderer Bezirk."
                            },
                            {
                                "example_id": "10b800e6-80b2-497d-9374-964ee7f1a459",
                                "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                                "text": "Die Donaustadt ist vom Durchschnittsalter seiner Bürger der jüngste Bezirk von Wien."
                            },
                            {
                                "example_id": "2a98cef9-48ba-4a84-b4ff-1bcf363cfc07",
                                "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                                "text": "Wiens 22. Bezirk Donaustadt soll nach der \"Donaucity\" eine zweite Hochhaus-Silhouette erhalten."
                            },
                            {
                                "example_id": "f33dac9c-d0c7-411d-9385-8e6dcee869ca",
                                "sense_id": "aeaecc7b-ac10-3380-a741-916583967b5f",
                                "text": "Während in den Innenbezirken immer weniger Menschen ein Auto besitzen, stieg etwa in der Donaustadt die Zahl der Autolenker."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
