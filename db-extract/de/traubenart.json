                        "entry_id": "4f9d83ca-2890-3889-8feb-f178ac92fe3f",
                        "glosses": [
                            "Art der Gattung Vitis (Weinreben) oder der echten Weinrebe Vitis vinifera selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183acba9-cdee-426a-bb63-989f868e12a1",
                                "sense_id": "f5a01861-84c9-3258-9efd-5ccc66f31541",
                                "text": "Vitis vinifera, die echte Weinrebe, ist eine von ungefähr 60 Traubenarten innerhalb der Gattung Vitis."
                            },
                            {
                                "example_id": "d779be01-4721-4fa7-a244-4537957a67c6",
                                "sense_id": "f5a01861-84c9-3258-9efd-5ccc66f31541",
                                "text": "„Hier verzichten die Weinbauern auf Herbizide oder Pestizide, setzen stattdessen auf biologisch abbaubare Pflanzenschutzmittel etwa auf Schwefelbasis und auf pilzwiderstandsfähige Traubenarten.“"
                            }
                        ],
