                                        "glosses": [
                                            "Relatif à l’œuvre mathématique de Bernard Riemann."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffde9ad3-e571-43f1-a401-b0ac3a57b058",
                                                "sense_id": "f48a86fa-1d1c-3268-ac77-8c3730f6ebdf",
                                                "text": "Il existe des variétés pseudo-riemanniennes, généralisant les variétés riemanniennes, qui en restent assez proche par bien des aspects, et qui permettent notamment de modéliser l’espace-temps en physique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c2573f8-38c7-343f-85c0-1615ba6ec48e",
