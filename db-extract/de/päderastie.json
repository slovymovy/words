                ],
                "senses": [
                    {
                        "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                        "entry_id": "25a8e98d-ea66-3b1d-bb6f-67f7eebf0fc6",
                        "glosses": [
                            "„homosexuelle Neigungen, Beziehungen zu Jungen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9b2ad2-8a78-4a5f-b44e-6deb07ef3969",
                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                "text": "„Päderastie und Homosexualität waren bei den Griechen keineswegs verboten, sondern wurden höher bewertet als die normale Heterosexualität.“"
                            },
                            {
                                "example_id": "ac4a0edf-8d53-46a3-b7c1-822f8f935374",
                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                "text": "„Rom, die heilige Stadt, die gleichwohl durch diese Anordnung das ganze Menschengeschlecht zur Päderastie zwingt, will es weder zugeben, noch eine Illusion für möglich halten, die sie mit allen Mitteln im Geist der Theaterbesucher erzeugt.“"
                            },
                            {
                                "example_id": "2d839d87-9517-4a2e-ae5d-0d10e6cd4cae",
                                "sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                                "text": "„Sade war mit allen Formen des Eros vertraut; Neugier, der echt französische Trieb zur Systematik, Überdruß an der normalen Befriedigung, Haß gegen die sentimentale Belastung und Herausforderung hatten beträchtlichen Anteil an seiner Wendung zur Päderastie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f547989d-d7e9-4127-8da9-26ba55c20446",
                        "source_entry_id": "25a8e98d-ea66-3b1d-bb6f-67f7eebf0fc6",
                        "source_sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                        "target_lang_word": "pederasty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pederasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c92e1698-a048-33cd-a505-55779b8dc19b",
                                        "entry_id": "39170ff5-f813-36e3-afd4-59144292fb11",
                                        "glosses": [
                                            "Erotic love, sexually expressed or chaste, between a man and an adolescent boy."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "152f1a6e-ea8d-48b0-a5d4-afaabbc59e11",
                                                "sense_id": "c92e1698-a048-33cd-a505-55779b8dc19b",
                                                "text": "[…] aber die Entwürdigung der Frauen rächte sich an den Männern und entwürdigte auch sie, bis sie versanken in die Widerwärtigkeit der Knabenliebe und ihre Götter entwürdigten wie sich selbst durch den Mythus von Ganymed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a4a64d-309e-37b4-a3df-6714895ca19b",
                                        "entry_id": "39170ff5-f813-36e3-afd4-59144292fb11",
                                        "glosses": [
                                            "Anal intercourse in general, usually between a man and an adolescent boy."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "318069e4-e380-48f0-83ae-6a7f2c7990f0",
                        "source_entry_id": "25a8e98d-ea66-3b1d-bb6f-67f7eebf0fc6",
                        "source_sense_id": "c76ae50a-ee26-3caf-90fb-b19339cb5f3a",
                        "target_lang_word": "pédérastie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédérastie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb3afa1-71f7-3694-8fef-89c585ccd6d1",
                                        "entry_id": "03ee35e5-f456-33c5-a95a-4a598dd4ee5f",
                                        "glosses": [
                                            "Relation à visée éducative entre un homme mûr et un jeune garçon, dont les rapports sexuels ne sont qu’une dimension."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c507c4b-8d02-4a57-ad78-536201109cbd",
                                                "sense_id": "bbb3afa1-71f7-3694-8fef-89c585ccd6d1",
                                                "text": "Cette période de l’éducation où on accorde le plus d’intention à l’enfant et où une relation des plus surprenantes pouvait être nourrie avec son précepteur : c’est la « pédérastie ». Cela relevait-il d’une forme de prostitution juvénile normalisée ? En fait, à l’époque, ce rapport pédérastique était vraisemblablement moins amoral que pédagogique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11084b2a-be9d-349a-bfb1-35431e1c4f77",
                                        "entry_id": "03ee35e5-f456-33c5-a95a-4a598dd4ee5f",
                                        "glosses": [
                                            "Attirance érotique d’un homme pour les jeunes garçons, généralement adolescents ou préadolescents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b45e183-36cf-4236-a122-fbe1a90d6b2f",
                                                "sense_id": "11084b2a-be9d-349a-bfb1-35431e1c4f77",
                                                "text": "Un jour qu’on luy demandoit si la pederastie n’estoit pas un crime : « À Dieu ne plaise », respondit-elle, « que je condamne ce que Socrate a pratiqué. » À son sens la pederastie est louable ; mais cela est assez gaillard pour une pucelle."
                                            },
                                            {
                                                "example_id": "e74756f3-4e7a-4e1b-8abc-9fa5316b54fa",
                                                "sense_id": "11084b2a-be9d-349a-bfb1-35431e1c4f77",
                                                "text": "Les moines chargés d’élever la jeunesse ont été toujours un peu adonnés à la pédérastie."
                                            },
                                            {
                                                "example_id": "4d32b9b3-fc38-4b31-b1a2-390dc592b01a",
                                                "sense_id": "11084b2a-be9d-349a-bfb1-35431e1c4f77",
                                                "text": "Rome nous rappelle que suicide et pédérastie sont faits communs chez des hommes parfaitement équilibrés, et l’honneur de leur pays."
                                            },
                                            {
                                                "example_id": "8e9ed125-84e7-4852-901a-d051ed6f7940",
                                                "sense_id": "11084b2a-be9d-349a-bfb1-35431e1c4f77",
                                                "text": "La pédérastie est la forme la plus inépuisable de l’amour, parce que c'est l’amour de la jeunesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9427804-fb8a-3f51-8375-5ed693d03fa1",
                                        "entry_id": "03ee35e5-f456-33c5-a95a-4a598dd4ee5f",
                                        "glosses": [
                                            "Homosexualité masculine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d728852d-9387-48ec-bbbc-e15dd0c60a23",
                                                "sense_id": "e9427804-fb8a-3f51-8375-5ed693d03fa1",
                                                "text": "Comment comprendrait-elle que, pour des mercenaires du Corps expéditionnaire […], il n'y a pas vraiment de honte dans la pédérastie ou la gouinerie?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
