                "senses": [
                    {
                        "sense_id": "59f348ee-ea2b-33a5-baf8-40577378f298",
                        "entry_id": "4f6e63ec-33a8-3f59-97cc-409a2eba768c",
                        "glosses": [
                            "разг. презр. тот, кто прислуживается к кому-либо из мелких, корыстных побуждений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3eb92b9-f3ae-4905-9871-ee8604c0d711",
                                "sense_id": "59f348ee-ea2b-33a5-baf8-40577378f298",
                                "text": "Кроме того, что сброд этих лизоблюдников разных и старикашек негодных вас, моего ангельчика, на болезненный одр свести хочет, кроме этого всего — они и меня, лизоблюды-то эти, извести хотят."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c09519cc-cf6a-44df-810e-d13913c0f3c3",
                        "source_entry_id": "4f6e63ec-33a8-3f59-97cc-409a2eba768c",
                        "source_sense_id": "59f348ee-ea2b-33a5-baf8-40577378f298",
                        "target_lang_word": "sycophant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who uses obsequious compliments to gain self-serving favour or advantage from another; a servile flatterer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f525c996-305a-4757-96aa-e3bb251b0bc4",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "A sycophant will everything admire: / Each verse, each sentence, sets his soul on fire"
                                            },
                                            {
                                                "example_id": "b01c4077-ca44-40f1-8dbe-2f6d2a1bebcd",
                                                "sense_id": "67152c02-d7d5-3a1a-ad71-9d7470a04c2c",
                                                "text": "VVhile a mean Crovvd of Sycophants attend, / And favvn and flatter, creep and cringe and bend; / The Fav'rite bleſſes his ſuperior State, / Riſes o'er all, and hails Himſelf the Great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10d5819-4588-3279-adfb-8870e50bee91",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "One who seeks to gain through the powerful and influential."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                        "entry_id": "4ea2a22e-5ab4-3ff0-8739-9265d085b390",
                                        "glosses": [
                                            "An informer; a talebearer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bcc55c3-1911-417d-a41a-cb8bbc7a37fa",
                                                "sense_id": "7ef390e3-92cd-3b79-b84a-a1862e167e32",
                                                "text": "[H]is mind had no eye to espy goodness; and therefore accusing sycophants, of all men, did best sort to his nature.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sycophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To inform against; hence, to calumniate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62fc6e6-b17a-4330-a1e2-fba335af3a04",
                                                "sense_id": "90a02387-0ba7-3c7e-b763-ed5d3fbe6928",
                                                "text": "As therefore he began in the title, so in the next leaf he makes it his first business to tamper with his reader by sycophanting and misnaming the work of his adversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfb8419-5bda-3708-b79a-90ead1b0f720",
                                        "entry_id": "ea1f3569-1144-3cdf-9c3e-7d5e917dee26",
                                        "glosses": [
                                            "To play the sycophant toward; to flatter obsequiously."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1bd987e-fc26-4d10-8b74-0d24496ddbb0",
                        "source_entry_id": "4f6e63ec-33a8-3f59-97cc-409a2eba768c",
                        "source_sense_id": "59f348ee-ea2b-33a5-baf8-40577378f298",
                        "target_lang_word": "toady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                        "entry_id": "9ea4c4bc-4a75-384b-b910-737f1d542a2c",
                                        "glosses": [
                                            "A sycophant who flatters others to gain personal advantage, or an obsequious, servile lackey or minion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a0d50b-763e-4d4a-affa-62becba9a532",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "\"Go on, Hiram, show 'em what you can do,\" urged Luke Fodick, who was a sort of toady to Hiram Shell, the school bully, if ever there was one."
                                            },
                                            {
                                                "example_id": "e1713c21-8ed4-4630-8b8e-7f52fcaa23fe",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "\"But who is she, can you tell me?\" / \"Some fair-skinned speculation of old Montreville's, I suppose, that she has got either to toady herself, or take in some of her black friends with.—Is it possible you have never heard of old Mother Montreville?\""
                                            },
                                            {
                                                "example_id": "40e82f43-428b-4171-a58f-9e6112567cdc",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "Before I had been standing at the window five minutes, they somehow conveyed to me that they were all toadies and humbugs, but that each of them pretended not to know that the others were toadies and humbugs: because the admission that he or she did know it, would have made him or her out to be a toady and a humbug."
                                            },
                                            {
                                                "example_id": "2ec58c94-8acc-4179-8de5-15d1a4d2b7f7",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "[T]he appearance of only three coaches, each drawn by four horses, was rather trying for poor Lady Scott. They contained Mrs Coutts – her future lord the Duke of St Albans – one of his Grace's sisters – a dame de compagnie (vulgarly styled a Toady)"
                                            },
                                            {
                                                "example_id": "b7818964-c7b3-445b-9017-1d09d298f924",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "But how could she have helped herself? I asked, imagining the sneers and the laughter, the adulation of the toadies, the scepticism of the professional poet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1986ef80-456e-3cc3-8d6e-d712d4882cde",
                                        "entry_id": "9ea4c4bc-4a75-384b-b910-737f1d542a2c",
                                        "glosses": [
                                            "A coarse, rustic woman."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24fcba3a-9bf7-369a-8891-5b9ae8d53fbf",
                                        "entry_id": "e2cadf46-22eb-30e5-a937-21b7c2f7743e",
                                        "glosses": [
                                            "To behave like a toady (toward someone)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ce32d9-1175-40f8-b20a-5f28f36d2d68",
                                                "sense_id": "24fcba3a-9bf7-369a-8891-5b9ae8d53fbf",
                                                "text": "He had toadied to the late Mr William Morris: he had toadied to various members of the Fabian Society, he had toadied at first to the great Bransdon himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094f770a-07dc-36ca-b521-ba9410385208",
                                        "entry_id": "e2cadf46-22eb-30e5-a937-21b7c2f7743e",
                                        "glosses": [
                                            "To behave like a toady toward (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9fe82fa-dd7b-418f-b0f5-44707749037d",
                                                "sense_id": "094f770a-07dc-36ca-b521-ba9410385208",
                                                "text": "But bless your hearts, we \"ain't so green,\" though lots of us of all sorts toady you enough certainly, and try to make you think so."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8f8e63-1c2e-3c4c-a62f-51511b79bf75",
                                        "entry_id": "686d47d3-59a2-328f-a91f-38e401764db4",
                                        "glosses": [
                                            "toadlike"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1993f7d-bf6a-48d4-9a95-11172a5cdb72",
                                                "sense_id": "7c8f8e63-1c2e-3c4c-a62f-51511b79bf75",
                                                "text": "The bath is of greatest advantage in these chronic cases, with an earthy complexion and toady skin, if I am allowed thus to express its appearance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
