                "senses": [
                    {
                        "sense_id": "c8ae160e-97fb-3791-9eaf-8ab60d268650",
                        "entry_id": "07000c27-97de-32c5-9d40-5eb138140aee",
                        "glosses": [
                            "Faire perdre son caractère customisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6da94ae-8ccc-45c8-96dd-4ea4d73c46ad",
                                "sense_id": "c8ae160e-97fb-3791-9eaf-8ab60d268650",
                                "text": "Il est toujours plus facile de customiser un vêtement plutôt que de le décustomiser !"
                            },
                            {
                                "example_id": "bdde28d7-73fa-40aa-8f65-d9084a24325a",
                                "sense_id": "c8ae160e-97fb-3791-9eaf-8ab60d268650",
                                "text": "Customiser/décustomiser le curseur de la souris"
                            },
                            {
                                "example_id": "f5d9ddae-84aa-4f0b-b869-5999ba6a7ca5",
                                "sense_id": "c8ae160e-97fb-3791-9eaf-8ab60d268650",
                                "text": "Courant à nouveau dans sa remise, il en sortit les bras chargés de nouvelles pièces, allant même jusqu'à décustomiser ces anciennes créations."
                            }
                        ]
                    }
