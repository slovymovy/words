                    },
                    {
                        "translation_id": "11d05145-3dba-481c-b0ff-91dfa00098aa",
                        "source_entry_id": "cfe41032-5245-30d8-a9b1-02151a8f85cc",
                        "source_sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                        "target_lang_word": "veuve de guerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veuve de guerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                        "entry_id": "764184cf-c93f-321f-9d38-2222c5b1ca4f",
                                        "glosses": [
                                            "Veuve dont le mari est mort, comme soldat, au combat ou des suites de ses blessures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b58d6a-90f3-45bf-b3d7-ae7e87582628",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "Depuis quelque temps on faisait défiler les veuves de guerre sous nos fenêtres. Des centaines de veuves de guerre. Elles criaient de leurs voix aiguës : « Clemenceau assassin, Clemenceau assassin. »"
                                            },
                                            {
                                                "example_id": "b6cceaaf-3092-47fe-8eb0-d8f9c640bbc9",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "À Bully-les-Mines, Marie Glisseur, servante, veuve de guerre, a recueilli Germaine Prinsier dont le père est mort « au champ d'honneur » et la mère lors d'un bombardement ; […]."
                                            },
                                            {
                                                "example_id": "c8ba8c0e-bdf9-482b-8c3b-a7a946fea6d8",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "Elle pensait que les autorités lui bourraient le mou pour ne pas avoir à lui verser de pension de veuve de guerre. Selon elle, on lui cachait la vérité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
