                                            {
                                                "example_id": "fdd2d55f-852e-44f4-9ec7-2b6b58f1916f",
                                                "sense_id": "55d874dc-47f1-344a-87f1-1550a928d96f",
                                                "text": "Her voice more sweet than warbling sound,\nTho’ sung by nightingale or lark,\nHer eyes such lustre dart around,\nCompar’d to them the sun is dark."
                                            },
                                            {
                                                "example_id": "333670cc-41bf-438d-bddc-5a2dc36ec9c5",
                                                "sense_id": "55d874dc-47f1-344a-87f1-1550a928d96f",
                                                "text": "In the swamp in secluded recesses, / A shy and hidden bird is warbling a song."
                                            }
