{
    "word_family": [
        "ceinture",
        "ceinturon",
        "ceinturage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2414b72-1947-3976-a0e4-ab2f04e9ef09",
                    "sense_definition": "Saisir quelqu'un au corps avec les bras autour de la taille pour l'immobiliser ou le jeter à terre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vigile a rapidement réussi à <w>ceinturer</w> le voleur qui tentait de s'enfuir."
                        },
                        {
                            "text": "Le policier l'a <w>ceinturé</w> fermement par la taille pour l'empêcher d'avancer."
                        }
                    ],
                    "synonyms": [
                        "plaquer",
                        "immobiliser"
                    ],
                    "antonyms": [
                        "lâcher",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "ceinturer un agresseur",
                        "ceinturer un suspect"
                    ]
                },
                {
                    "sense_id": "42a78d49-f632-36b1-a1d3-ffd6b7eaf617",
                    "sense_definition": "Entourer un lieu ou un espace comme une ceinture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entourer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'anciens remparts de pierre viennent <w>ceinturer</w> la vieille ville historique."
                        },
                        {
                            "text": "Une large forêt d'arbres majestueux <w>ceinture</w> le grand domaine royal."
                        }
                    ],
                    "synonyms": [
                        "entourer",
                        "encercler",
                        "border"
                    ],
                    "common_phrases": [
                        "ceinturer la ville"
                    ]
                },
                {
                    "sense_id": "8e4ed718-2c92-3224-a90d-8b9ea00b204d",
                    "sense_definition": "Attacher ou serrer autour de la taille ou d'un objet au moyen d'une ceinture ou d'une sangle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle préféra <w>ceinturer</w> son manteau ample pour se protéger du vent glacial."
                        },
                        {
                            "text": "Il prit le temps de <w>ceinturer</w> sa valise avec une lanière en cuir solide."
                        }
                    ],
                    "synonyms": [
                        "sangler"
                    ]
                },
                {
                    "sense_id": "5724a96b-5ef5-3132-b7b6-34000faa81ea",
                    "sense_definition": "Envelopper ou enserrer étroitement quelque chose.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entourer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une épaisse bande de tissu venait <w>ceinturer</w> le paquet fragile."
                        },
                        {
                            "text": "Les racines de l'arbre géant semblent <w>ceinturer</w> les ruines du temple."
                        }
                    ],
                    "synonyms": [
                        "envelopper",
                        "enserrer"
                    ]
                }
            ]
        }
    ]
}