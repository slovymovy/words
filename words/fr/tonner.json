                    "sense_id": "f6b0b4da-624e-333e-812d-811574c2305c",
                    "sense_definition": "Produire le bruit du tonnerre lors d'un orage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel s'assombrit rapidement et commence à <w>tonner</w> au loin.",
                            "target_lang_translations": {
                                "en": "The sky quickly darkens and starts to <w>thunder</w> in the distance.",
                                "ru": "Небо быстро темнеет, и вдали начинает <w>греметь</w> гром.",
                                "nl": "De lucht verdonkert snel en in de verte begint het te <w>donderen</w>.",
                                "de": "Der Himmel verdunkelt sich schnell, und in der Ferne fängt es an zu <w>donnern</w>.",
                                "pl": "Niebo szybko ciemnieje i w oddali zaczyna <w>grzmieć</w>.",
                                "it": "Il cielo si oscura rapidamente e comincia a <w>tuonare</w> in lontananza.",
                                "cs": "Obloha rychle ztmavne a v dálce začíná <w>hřmět</w>.",
                                "tr": "Gökyüzü hızla kararıyor ve uzaklarda <w>gürlemeye</w> başlıyor.",
                                "es": "El cielo se oscurece rápidamente y empieza a <w>tronar</w> a lo lejos.",
                                "zh": "天空很快暗了下来，远处开始<w>打雷</w>了。"
                            }
                        },
                        {
                            "text": "Il a <w>tonné</w> toute la nuit sans qu'une seule goutte de pluie ne tombe.",
                            "target_lang_translations": {
                                "en": "It <w>thundered</w> all night without a single drop of rain falling.",
                                "ru": "Всю ночь <w>гремело</w>, но ни одна капля дождя так и не упала.",
                                "nl": "Het heeft de hele nacht <w>gedonderd</w> zonder dat er ook maar één regendruppel viel.",
                                "de": "Es hat die ganze Nacht <w>gedonnert</w>, ohne dass auch nur ein einziger Regentropfen fiel.",
                                "pl": "Całą noc <w>grzmiało</w>, ale nie spadła ani jedna kropla deszczu.",
                                "it": "Ha <w>tuonato</w> tutta la notte senza che cadesse nemmeno una goccia di pioggia.",
                                "cs": "Celou noc <w>hřmělo</w>, aniž by spadla jediná kapka deště.",
                                "tr": "Bütün gece gök <w>gürledi</w>, ama tek bir damla bile yağmur düşmedi.",
                                "es": "Ha <w>tronado</w> toda la noche sin que cayera ni una sola gota de lluvia.",
                                "zh": "整夜都在<w>打雷</w>，可是一滴雨也没下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gronder"
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound of thunder during a storm.",
                        "ru": "Издавать звуки грома во время грозы.",
                        "nl": "Het geluid van donder maken tijdens een onweersbui.",
                        "de": "Bei einem Gewitter das Geräusch des Donners erzeugen.",
                        "pl": "Wydawać odgłos grzmotu podczas burzy.",
                        "it": "Produrre il rumore del tuono durante un temporale.",
                        "cs": "Vydávat zvuk hromu během bouřky.",
                        "tr": "Fırtına sırasında gök gürültüsü sesi çıkarmak.",
                        "es": "Producir el ruido del trueno durante una tormenta.",
                        "zh": "在暴风雨中发出雷鸣般的声音。"
                    },
