                                "target_senses": [
                                    {
                                        "sense_id": "8de70be6-9e78-34d4-a6cd-7ac5e2f76c97",
                                        "entry_id": "980e12a6-b76a-305c-94cb-985a309898df",
                                        "glosses": [
                                            "Eintopfgericht mit kleinen Fleischstücken, die kräftig (insbesondere mit Paprika) gewürzt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc9fbd0-0ca9-4522-897a-8f717cc2cffa",
                                                "sense_id": "8de70be6-9e78-34d4-a6cd-7ac5e2f76c97",
                                                "text": "Man sagt, dass Gulasch am besten schmeckt, wenn es mehrmals aufgewärmt wird."
                                            },
                                            {
                                                "example_id": "6dc15c60-7a10-4004-93ef-1a7f06c68832",
                                                "sense_id": "8de70be6-9e78-34d4-a6cd-7ac5e2f76c97",
                                                "text": "„Wodka schmeckte wie das Leben selbst nach dem Szegediner Gulasch der Köchin Rosa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
