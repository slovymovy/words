                "senses": [
                    {
                        "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                        "entry_id": "2438cd32-db86-35d1-94bb-c845b97228f8",
                        "glosses": [
                            "hochprozentiges alkoholisches Getränk, Branntwein, Schnaps"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "fc7b2505-8abc-4dcf-b697-dfe3fc245045",
                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                "text": "„Stoßen wir trotzdem noch einmal mit dem Feuerwasser an, das immer brennt.“"
                            },
                            {
                                "example_id": "7dc8211c-d5fb-402f-a627-0822258a97e2",
                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                "text": "„Ihre Jagdgebiete schrumpften, und das leicht zugängliche Feuerwasser forderte seinen Tribut.“"
                            },
                            {
                                "example_id": "676fbb8f-b283-4a94-a4f8-6fb6afba60df",
                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                "text": "„Sie belohnte die Willigen mit einer Kalebasse des deliziösen Feuerwassers, während sie sie dem Mürrischen oder Widerspenstigen mit demselben schlauen Lächeln mit reinem Quellwasser füllte.“"
                            },
                            {
                                "example_id": "fc6a6385-4f53-490a-955f-b0734532da2a",
                                "sense_id": "a192f45e-86a4-36d0-a96e-7f6158af1a40",
                                "text": "„Winnetou verfiel nicht dem Feuerwasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
