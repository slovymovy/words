{
    "word_family": [
        "verveling",
        "vervelend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "478fc99e-f19d-3b00-93ff-379401940068",
                    "sense_definition": "Zich niet vermaken omdat er niets interessants te doen is of omdat men niet weet wat te doen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>verveel</w> me altijd als ik moet wachten op de bus.",
                            "target_lang_translations": {
                                "en": "I always <w>get bored</w> when I have to wait for the bus.",
                                "ru": "Я всегда <w>скучаю</w>, когда мне приходится ждать автобус.",
                                "it": "Mi <w>annoio</w> sempre quando devo aspettare l'autobus."
                            }
                        },
                        {
                            "text": "De kinderen <w>verveelden</w> zich dood tijdens de regenachtige vakantie.",
                            "target_lang_translations": {
                                "en": "The children <w>were bored</w> to death during the rainy holiday.",
                                "ru": "Дети смертельно <w>скучали</w> во время дождливых каникул.",
                                "it": "I bambini si <w>annoiavano</w> a morte durante la vacanza piovosa."
                            }
                        }
                    ],
                    "antonyms": [
                        "zich vermaken",
                        "zich amuseren"
                    ],
                    "common_phrases": [
                        "zich dood vervelen",
                        "zich te pletter vervelen",
                        "zich kapot vervelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "reflexive"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To not enjoy oneself because there is nothing interesting to do or one does not know what to do.",
                        "ru": "Испытывать скуку из-за отсутствия интересного занятия или незнания, чем себя занять.",
                        "it": "Non divertirsi perché non c'è nulla di interessante da fare o perché non si sa cosa fare."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be bored",
                                "target_lang_sense_clarification": "reflexive use"
                            },
                            {
                                "target_lang_word": "get bored",
                                "target_lang_sense_clarification": "reflexive use"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скучать",
                                "target_lang_sense_clarification": "испытывать душевное томление"
                            },
                            {
                                "target_lang_word": "томиться",
                                "target_lang_sense_clarification": "изнывать от скуки"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "annoiarsi",
                                "target_lang_sense_clarification": "forma riflessiva, provare noia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4291eeb-b1f2-3fee-bfb3-e5b147106ce8",
                    "sense_definition": "Saai zijn en daardoor een gevoel van desinteresse of lusteloosheid bij iemand opwekken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die lange film begon me na een uur te <w>vervelen</w>.",
                            "target_lang_translations": {
                                "en": "That long movie started to <w>bore</w> me after an hour.",
                                "ru": "Этот длинный фильм начал мне <w>наскучивать</w> через час.",
                                "it": "Quel lungo film ha iniziato ad <w>annoiare</w> dopo un'ora."
                            }
                        },
                        {
                            "text": "Hij <w>verveelt</w> iedereen met zijn eindeloze verhalen over het weer.",
                            "target_lang_translations": {
                                "en": "He <w>bores</w> everyone with his endless stories about the weather.",
                                "ru": "Он <w>нагоняет скуку</w> на всех своими бесконечными историями о погоде.",
                                "it": "Lui <w>annoia</w> tutti con i suoi racconti infiniti sul tempo."
                            }
                        }
                    ],
                    "antonyms": [
                        "boeien",
                        "interesseren",
                        "vermaken"
                    ],
                    "target_lang_definitions": {
                        "en": "To be boring and thereby arouse a feeling of disinterest or listlessness in someone.",
                        "ru": "Быть скучным и вызывать у кого-то чувство незаинтересованности или уныния.",
                        "it": "Essere noioso e quindi suscitare in qualcuno un senso di disinteresse o apatia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bore",
                                "target_lang_sense_clarification": "cause boredom"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наскучивать",
                                "target_lang_sense_clarification": "становиться неинтересным"
                            },
                            {
                                "target_lang_word": "нагонять скуку",
                                "target_lang_sense_clarification": "вызывать скуку"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "становиться скучным от повторения"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "annoiare",
                                "target_lang_sense_clarification": "causare noia a qualcuno"
                            },
                            {
                                "target_lang_word": "stancare",
                                "target_lang_sense_clarification": "risultare ripetitivo o poco interessante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c948032c-daf0-31df-a537-23ae1853e29b",
                    "sense_definition": "Iemand irriteren, hinderen of tot last zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit je zusje niet zo te <w>vervelen</w> als ze huiswerk maakt!",
                            "target_lang_translations": {
                                "en": "Don't <w>bother</w> your sister like that while she's doing homework!",
                                "ru": "Не <w>приставай</w> так к сестренке, когда она делает уроки!",
                                "it": "Non <w>infastidire</w> tua sorella mentre fa i compiti!"
                            }
                        },
                        {
                            "text": "De muggen <w>verveelden</w> ons de hele avond tijdens de barbecue.",
                            "target_lang_translations": {
                                "en": "The mosquitoes <w>annoyed</w> us all evening during the barbecue.",
                                "ru": "Комары <w>докучали</w> нам весь вечер во время барбекю.",
                                "it": "Le zanzare ci hanno <w>infastidito</w> per tutta la sera durante il barbecue."
                            }
                        }
                    ],
                    "synonyms": [
                        "irriteren",
                        "hinderen",
                        "lastigvallen",
                        "klieren",
                        "ergeren"
                    ],
                    "antonyms": [
                        "met rust laten"
                    ],
                    "target_lang_definitions": {
                        "en": "To irritate, hinder, or be a burden to someone.",
                        "ru": "Раздражать кого-то, мешать или быть в тягость.",
                        "it": "Irritare, disturbare o essere di peso a qualcuno."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "irritate"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "disturb or trouble"
                            },
                            {
                                "target_lang_word": "pester",
                                "target_lang_sense_clarification": "annoy persistently"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "докучать",
                                "target_lang_sense_clarification": "назойливо мешать"
                            },
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать недовольство"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "навязываться, лезть"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "infastidire",
                                "target_lang_sense_clarification": "causare fastidio o disturbo"
                            },
                            {
                                "target_lang_word": "dare fastidio",
                                "target_lang_sense_clarification": "essere molesto o di disturbo"
                            },
                            {
                                "target_lang_word": "disturbare",
                                "target_lang_sense_clarification": "interrompere o molestare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
