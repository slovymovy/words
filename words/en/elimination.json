    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59ca9d92-d7ac-357e-9b10-156e4d6d9526",
                    "sense_definition": "The act of removing or getting rid of something completely.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>elimination</w> of errors is crucial for the success of the project.",
                            "target_lang_translations": {
                                "ru": "<w>Устранение</w> ошибок критически важно для успеха проекта.",
                                "zh": "<w>消除</w>错误对项目的成功至关重要。"
                            }
                        },
                        {
                            "text": "We figured out the correct answer by using the process of <w>elimination</w>.",
                            "target_lang_translations": {
                                "ru": "Мы нашли правильный ответ, используя метод <w>исключения</w>.",
                                "zh": "我们通过<w>排除</w>法找到了正确答案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "removal",
                        "eradication",
                        "exclusion",
                        "deletion"
                    ],
                    "antonyms": [
                        "inclusion",
                        "addition",
                        "retention"
                    ],
                    "common_phrases": [
                        "process of elimination",
                        "complete elimination",
                        "elimination of poverty",
                        "elimination of waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по полному удалению или избавлению от чего-либо.",
                        "zh": "彻底清除、消除或去除某事物的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устранение",
                                "target_lang_sense_clarification": "ошибок, препятствий"
                            },
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "метод исключения"
                            },
                            {
                                "target_lang_word": "ликвидация",
                                "target_lang_sense_clarification": "полное уничтожение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消除",
                                "target_lang_sense_clarification": "消除错误、贫困等"
                            },
                            {
                                "target_lang_word": "排除",
                                "target_lang_sense_clarification": "排除法、排除可能性"
                            },
                            {
                                "target_lang_word": "根除",
                                "target_lang_sense_clarification": "彻底消灭、清除"
                            }
                        ]
