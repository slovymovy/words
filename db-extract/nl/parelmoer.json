                                        "sense_id": "5cbd843a-0414-3be7-a4dc-28537ee0e247",
                                        "entry_id": "193b5df8-4774-3c77-8866-07048ec0d008",
                                        "glosses": [
                                            "The hard pearly inner layer of certain mollusk shells; nacre."
                                        ],
                                        "tags": [
