                "senses": [
                    {
                        "sense_id": "9eed07c5-badd-3dd9-a4a9-307c9c22589d",
                        "entry_id": "15fcbcd2-deeb-3a8c-b216-74fc06838c7d",
                        "glosses": [
                            "meestal samen met soortgelijke palen, de markering van een grens vormend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcb6b9d-0e3f-4283-a50b-ddf2a13084d4",
                                "sense_id": "9eed07c5-badd-3dd9-a4a9-307c9c22589d",
                                "text": "Er zijn weerwolven die meisjes lastig vallen, begrafeniswagens die bewegingsloos worden bij de grenspaal die de dode ooit valselijk verzet had, en tolgaarders die ook heksen zijn."
                            },
                            {
                                "example_id": "597bef37-fd67-4aaf-b575-f6d5cebbd4e1",
                                "sense_id": "9eed07c5-badd-3dd9-a4a9-307c9c22589d",
                                "text": "Nederland kent honderden genummerde grenspalen."
                            },
                            {
                                "example_id": "2209f7c3-c734-4f19-8d78-c7cb29a090e9",
                                "sense_id": "9eed07c5-badd-3dd9-a4a9-307c9c22589d",
                                "text": "Ik daalde af naar het laatste dal, liep een drassig bos in en bereikte na bijna zes maanden eindelijk de grenspalen, de noordelijke Terminus genoemd, op de grens met Canada."
                            }
                        ]
                    }
                ],
