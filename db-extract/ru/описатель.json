                        "examples": [
                            {
                                "example_id": "e4592919-1f42-40d2-a7ec-b085e6a47c63",
                                "sense_id": "2e70df53-c315-327e-8e17-4019941fe7af",
                                "text": "Описатели зверей пишут, что слоны каждый день громадою собираются пред восходом солнца и смотрят на восток."
                            },
                            {
                                "example_id": "57f8b60b-7876-4f49-97e6-3a880cd6b742",
                                "sense_id": "2e70df53-c315-327e-8e17-4019941fe7af",
                                "text": "Повторяю, я плохой описатель чувств, но тут главное мечта."
                            }
                        ]
                    }
