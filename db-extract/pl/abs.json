                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df453cc-efd1-45ff-a81b-a0a4b2f4824d",
                                                "sense_id": "d8ef3e6c-79ea-34fb-a775-e9f0847afdab",
                                                "text": "Das ABS verhindert bei einer Vollbremsung das Blockieren der Räder."
                                            },
                                            {
                                                "example_id": "b96782ea-c08a-43e1-b2dd-759579748ac2",
                                                "sense_id": "d8ef3e6c-79ea-34fb-a775-e9f0847afdab",
                                                "text": "„Weder ABS noch selbstblockierende Differenziale können mich beeindrucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d931217-5c3a-3ae0-abd5-435f8e643ecb",
                                        "entry_id": "3e5d6204-b903-3e3f-9403-07f2ffaaddff",
                                        "glosses": [
                                            "Acrylnitril/Butadien/ Styrol-Copolymer (aus der Kunststofftechnik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
