{
    "word_family": [
        "assortment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2afe3a55-7241-35e4-86f3-b0615bf7ce1d",
                    "sense_definition": "To sort, classify, or arrange into groups according to kind or characteristics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "categorize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>assort</w> the gathered produce by size and quality before packing."
                        },
                        {
                            "text": "The librarian took hours to <w>assort</w> the rare manuscripts according to their historical era."
                        }
                    ],
                    "synonyms": [
                        "classify",
                        "categorize",
                        "sort"
                    ]
                },
                {
                    "sense_id": "b98e0a30-de1c-3bdc-a685-3c960fb9de93",
                    "sense_definition": "To supply or furnish with a variety of goods or different sorts of items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchants decided to <w>assort</w> the cargo with textiles, spices, and ceramics."
                        },
                        {
                            "text": "The company planned to <w>assort</w> their warehouse with a wider selection of products."
                        }
                    ],
                    "common_phrases": [
                        "assort a cargo"
                    ]
                },
                {
                    "sense_id": "3efa6bce-2550-36eb-8c61-25c02361b6a5",
                    "sense_definition": "To match, harmonize, or correspond in kind, color, or style.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harmonize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer ensured the curtain fabric would <w>assort</w> with the antique furniture in the parlor."
                        },
                        {
                            "text": "Her quiet manner did not <w>assort</w> well with the loud and boisterous crowd."
                        }
                    ],
                    "synonyms": [
                        "harmonize",
                        "match"
                    ],
                    "common_phrases": [
                        "assort with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used rarely in modern English in this sense."
                        }
                    ]
                },
                {
                    "sense_id": "6ff11742-53de-3f0b-9f20-973445995ed1",
                    "sense_definition": "To keep company or consort with others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harmonize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose not to <w>assort</w> with the disreputable crowd gathered at the docks."
                        },
                        {
                            "text": "The young scholar would rarely <w>assort</w> with anyone outside his circle of colleagues."
                        }
                    ],
                    "synonyms": [
                        "consort",
                        "associate"
                    ],
                    "common_phrases": [
                        "assort with"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Largely superseded by 'consort' or 'associate'."
                        }
                    ]
                }
            ]
        }
    ]
}