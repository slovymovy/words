                "senses": [
                    {
                        "sense_id": "cbd6cbdd-ce0b-3618-85de-0cdf1f7a1568",
                        "entry_id": "237277ba-0a23-3696-9fe6-d6c6c902235b",
                        "glosses": [
                            "omstandigheid dat iemand ergens mee akkoord gaat"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "79c7418c-c20f-4104-b574-e6cd04e64c11",
                                "sense_id": "cbd6cbdd-ce0b-3618-85de-0cdf1f7a1568",
                                "text": "Het personage Moenen verklaart in deze rederijkers-tekst dat de duivel zich met Gods welnemen een menselijke gedaante kan aannemen, op voorwaarde dat hem een lichamelijk gebrek aankleeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab3024fe-d9ea-49f1-ad0e-ad2decfb4199",
                        "source_entry_id": "237277ba-0a23-3696-9fe6-d6c6c902235b",
                        "source_sense_id": "cbd6cbdd-ce0b-3618-85de-0cdf1f7a1568",
                        "source_sense_description": "toestemming",
                        "target_lang_word": "Einverständnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einverständnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                        "entry_id": "6b2ecc29-82fb-3b32-9a21-74e253b72d2a",
                                        "glosses": [
                                            "Zustimmung, Erlaubnis"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e41950-95cb-4fe7-a323-79ded455a1d3",
                                                "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                                "text": "Minderjährige dürfen nur mit Einverständnis ihrer Erziehungsberechtigten tätowiert werden."
                                            },
                                            {
                                                "example_id": "a85457f0-ff23-4de4-a0dd-bb23da7a90f8",
                                                "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                                "text": "„Lautstark gaben die Männer ihr Einverständnis, und sie hinterlegten die Wettsumme beim Barkeeper.“"
                                            },
                                            {
                                                "example_id": "8e1a7afb-b494-4b26-8c35-efbaa82bd76f",
                                                "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "89842be8-ae67-422d-8159-69bda2431b8e",
                                                "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                                "text": "„Von Anfang an hat zwischen Joseph Dincklage und Käthe Lenk großes Einverständnis geherrscht.“"
                                            },
                                            {
                                                "example_id": "2a90395d-00d3-49df-adf7-b8ced0e6809c",
                                                "sense_id": "6f595ce4-00a7-3791-9700-590b03100643",
                                                "text": "„Das Verhör hatte bereits mehrere Stunden gedauert, ob er mit einem der Einwohner im Einverständnisse gewesen, wollte er trotz des Flehens dieser nicht beantworten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
