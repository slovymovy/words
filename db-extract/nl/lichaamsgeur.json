                        "entry_id": "e79d1ed4-9760-3970-91de-52c3fa33cc03",
                        "glosses": [
                            "geur die bij een bepaald persoon hoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c634ca63-610e-4970-a489-f5e1f5615d39",
                                "sense_id": "64e9b612-0592-34e6-8eae-bb934e9288a3",
                                "text": "Muskusachtige deodorant gecombineerd met een zoetige lichaamsgeur drong mijn neusgaten binnen."
                            },
                            {
                                "example_id": "62f4bda2-e1af-43cd-82c7-c1217ec42b31",
                                "sense_id": "64e9b612-0592-34e6-8eae-bb934e9288a3",
                                "text": "Die zaak ging over de vraag of iemand de toegang tot een bibliotheek kon worden geweigerd vanwege zijn penetrante lichaamsgeur. Er staat immers nergens in de wet dat zweetvoeten verboden zijn (de man onderstreepte dat nog eens door ook in de rechtszaal zijn schoenen uit te trekken). Desalniettemin veroordeelde de rechter de man, voor lokaalvredebreuk."
                            }
                        ]
                    }
