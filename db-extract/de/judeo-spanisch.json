                        "glosses": [
                            "der spezielle von den 1492 aus Spanien vertriebenen Juden beibehaltene jüdisch-spanische Dialekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3a4db2-8a96-49a4-9de2-8d740210c144",
                                "sense_id": "e50f8645-f610-3b19-8c98-b6ce580851d0",
                                "text": "„Uzi dämpfte die Stimme, und wir unterhielten uns kurz auf Judeo-Spanisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
