{
    "word_family": [
        "certainty",
        "uncertainty",
        "certainly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34402d70-aa80-3705-8b6b-7df533885474",
                    "sense_definition": "Not feeling sure or confident about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel <w>uncertain</w> about which path to take in my career.",
                            "target_lang_translations": {
                                "nl": "Ik voel me <w>onzeker</w> over welk pad ik in mijn carrière moet kiezen."
                            }
                        },
                        {
                            "text": "She was <w>uncertain</w> whether to accept the job offer or stay.",
                            "target_lang_translations": {
                                "nl": "Ze was <w>onzeker</w> of ze het werkaanbod moest accepteren of moest blijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsure",
                        "doubtful"
                    ],
                    "antonyms": [
                        "certain"
                    ],
                    "common_phrases": [
                        "feel uncertain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet zeker of zelfverzekerd zijn over iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onzeker",
                                "target_lang_sense_clarification": "gevoel van twijfel of gebrek aan zelfvertrouwen"
                            },
                            {
                                "target_lang_word": "twijfelend",
                                "target_lang_sense_clarification": "niet in staat om een beslissing te nemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95ed60a-3a1f-3b89-9335-4b27ac00a21d",
                    "sense_definition": "Not known for sure; questionable or not fixed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exact date of the meeting remains <w>uncertain</w>.",
                            "target_lang_translations": {
                                "nl": "De exacte datum van de vergadering blijft <w>onzeker</w>."
                            }
                        },
                        {
                            "text": "The outcome of the election is still <w>uncertain</w>.",
                            "target_lang_translations": {
                                "nl": "De uitslag van de verkiezingen is nog <w>onzeker</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unknown",
                        "unclear"
                    ],
                    "antonyms": [
                        "certain"
                    ],
                    "common_phrases": [
                        "remain uncertain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet met zekerheid bekend; twijfelachtig of niet vaststaand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onzeker",
                                "target_lang_sense_clarification": "niet vaststaand of onbekend"
                            },
                            {
                                "target_lang_word": "onduidelijk",
                                "target_lang_sense_clarification": "niet helder of niet vastgelegd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56709425-0970-36e0-819c-1f046e9b4c7e",
                    "sense_definition": "Not yet decided or settled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plans for the weekend are still <w>uncertain</w>.",
                            "target_lang_translations": {
                                "nl": "De plannen voor het weekend zijn nog <w>onbeslist</w>."
                            }
                        },
                        {
                            "text": "His future at the company is <w>uncertain</w>.",
                            "target_lang_translations": {
                                "nl": "Zijn toekomst bij het bedrijf is <w>onzeker</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "undecided",
                        "unsettled"
                    ],
                    "antonyms": [
                        "certain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Nog niet beslist of vastgesteld."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onbeslist",
                                "target_lang_sense_clarification": "nog geen definitieve keuze gemaakt"
                            },
                            {
                                "target_lang_word": "onzeker",
                                "target_lang_sense_clarification": "toekomstige status is nog niet vastgelegd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981b8e6f-64fb-31fb-8a7b-149afee25da6",
                    "sense_definition": "Variable and likely to change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changeable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather in the mountains is notoriously <w>uncertain</w>.",
                            "target_lang_translations": {
                                "nl": "Het weer in de bergen is berucht <w>wisselvallig</w>."
                            }
                        },
                        {
                            "text": "They faced <w>uncertain</w> economic conditions during the crisis.",
                            "target_lang_translations": {
                                "nl": "Ze kregen te maken met <w>onvoorspelbare</w> economische omstandigheden tijdens de crisis."
                            }
                        }
                    ],
                    "synonyms": [
                        "changeable",
                        "unpredictable"
                    ],
                    "common_phrases": [
                        "uncertain weather"
                    ],
                    "target_lang_definitions": {
                        "nl": "Veranderlijk en waarschijnlijk aan verandering onderhevig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onvoorspelbaar",
                                "target_lang_sense_clarification": "niet te voorzien hoe het zal verlopen"
                            },
                            {
                                "target_lang_word": "wisselvallig",
                                "target_lang_sense_clarification": "vaak veranderend, vaak gebruikt voor weer of omstandigheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12800fa6-96eb-3aa2-ae9c-d1d8217ee8b5",
                    "sense_definition": "Lacking stability or confidence in movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a few <w>uncertain</w> steps toward the door.",
                            "target_lang_translations": {
                                "nl": "Hij zette een paar <w>wankele</w> stappen richting de deur."
                            }
                        },
                        {
                            "text": "Her voice was <w>uncertain</w> as she began to speak.",
                            "target_lang_translations": {
                                "nl": "Haar stem klonk <w>aarzelend</w> toen ze begon te spreken."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsteady",
                        "hesitant"
                    ],
                    "common_phrases": [
                        "uncertain steps"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gebrek aan stabiliteit of zelfvertrouwen in beweging of houding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wankel",
                                "target_lang_sense_clarification": "niet stabiel in beweging"
                            },
                            {
                                "target_lang_word": "aarzelend",
                                "target_lang_sense_clarification": "niet zelfverzekerd in actie of spraak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31c48e4d-c2b6-3593-8ea7-1db0a07741d8",
                    "sense_definition": "Difficult to predict or prone to sudden changes in behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "changeable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader had an <w>uncertain</w> temper that worried his staff.",
                            "target_lang_translations": {
                                "nl": "De leider had een <w>grillig</w> humeur waar zijn personeel zich zorgen over maakte."
                            }
                        },
                        {
                            "text": "His <w>uncertain</w> moods made it hard to work with him.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>wispelturige</w> stemmingen maakten het moeilijk om met hem samen te werken."
                            }
                        }
                    ],
                    "synonyms": [
                        "capricious",
                        "erratic"
                    ],
                    "target_lang_definitions": {
                        "nl": "Moeilijk te voorspellen of geneigd tot plotselinge gedragsveranderingen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "grillig",
                                "target_lang_sense_clarification": "onvoorspelbaar in gedrag of humeur"
                            },
                            {
                                "target_lang_word": "wispelturig",
                                "target_lang_sense_clarification": "snel wisselend van stemming of mening"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5971628a-3dec-35a5-9867-f139ee417eac",
                    "sense_definition": "Something that is not known or is not fixed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must learn to live with the <w>uncertain</w> in life.",
                            "target_lang_translations": {
                                "nl": "We moeten leren leven met <w>het onzekere</w> in het leven."
                            }
                        },
                        {
                            "text": "He tried to turn the <w>uncertain</w> into a clear plan.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde <w>het onzekere</w> om te zetten in een duidelijk plan."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat niet bekend of niet vastgelegd is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het onzekere",
                                "target_lang_sense_clarification": "datgene wat niet vaststaat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}