    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaa606a0-0100-37f2-9f37-1f4d26018716",
                    "sense_definition": "Sentiment de vive répugnance physique provoqué par une chose sale, nauséabonde ou repoussante.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "repulsion_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a poussé un cri de <w>dégoût</w> en apercevant l'insecte écrasé sur la table de la cuisine."
                        },
                        {
                            "text": "L'odeur insupportable de cette poubelle abandonnée sous la chaleur m'inspire un profond <w>dégoût</w>."
                        }
                    ],
                    "synonyms": [
                        "écœurement",
                        "répugnance",
                        "nausée"
                    ],
                    "antonyms": [
                        "attrait",
                        "envie"
                    ],
                    "common_phrases": [
                        "mouvement de dégoût",
                        "frémir de dégoût"
                    ]
                },
                {
                    "sense_id": "556b4889-5166-3ef2-bfc3-a1725d1a904b",
                    "sense_definition": "Aversion profonde, vive réprobation ou mépris envers un comportement, une idée ou une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repulsion_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les mensonges répétés de ce politicien véreux suscitent le <w>dégoût</w> de l'opinion publique."
                        },
                        {
                            "text": "Il a éprouvé un sincère <w>dégoût</w> devant les actes cruels commis envers ces animaux sans défense."
                        }
                    ],
                    "synonyms": [
                        "aversion",
                        "répulsion",
                        "mépris"
                    ],
                    "antonyms": [
                        "admiration",
                        "sympathie",
                        "estime"
                    ],
                    "common_phrases": [
                        "sentiment de dégoût",
                        "profond dégoût",
                        "éprouver du dégoût"
                    ]
                },
                {
                    "sense_id": "75398804-3750-3aa9-ace0-15beec73060c",
                    "sense_definition": "Manque d'appétit ou perte de l'envie de s'alimenter, souvent causé par la maladie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le début de sa grippe, ce patient souffre d'un <w>dégoût</w> complet pour la nourriture."
                        },
                        {
                            "text": "Elle doit absolument surmonter son <w>dégoût</w> pour avaler au moins quelques cuillères de soupe tiède."
                        }
                    ],
                    "synonyms": [
                        "inappétence"
                    ],
                    "antonyms": [
                        "appétit",
                        "faim"
                    ],
                    "common_phrases": [
                        "surmonter son dégoût",
                        "avoir du dégoût"
                    ]
                },
                {
                    "sense_id": "a4d65c7f-eb52-3f75-803a-ca2405c77685",
                    "sense_definition": "Répugnance ou hostilité marquée envers certains aliments en particulier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque enfant manifeste ses propres goûts et ses <w>dégoûts</w> face aux légumes verts."
                        },
                        {
                            "text": "Son <w>dégoût</w> pour les fruits de mer remonte à une intoxication vécue pendant ses vacances."
                        }
                    ],
                    "synonyms": [
                        "aversion",
                        "répugnance"
                    ],
                    "antonyms": [
                        "goût",
                        "penchant"
                    ],
                    "common_phrases": [
                        "goûts et dégoûts"
                    ]
                },
                {
                    "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                    "sense_definition": "Déboire, contrariété ou déception pénible subie au cours d'une entreprise ou d'une carrière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a connu bien des <w>dégoûts</w> au cours de sa longue carrière administrative sans jamais se plaindre."
                        },
                        {
                            "text": "Après avoir essuyé tant de <w>dégoûts</w> dans ce milieu corrompu, le jeune avocat a démissionné."
                        }
                    ],
                    "synonyms": [
                        "déboire",
                        "amertume",
                        "déconvenue"
                    ],
                    "antonyms": [
                        "satisfaction",
                        "contentement"
                    ],
                    "common_phrases": [
                        "essuyer des dégoûts"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "S'emploie principalement au pluriel"
                        }
                    ]
                }
            ]
        }
    ]
