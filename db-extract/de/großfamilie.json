                ],
                "senses": [
                    {
                        "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                        "entry_id": "3d2297a6-ee24-3a1d-a76b-1bd8a81dae43",
                        "glosses": [
                            "Familie, in der mehr als zwei Generationen von miteinander verwandten Personen unter einem Dach als Gemeinschaft zusammenleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e73d01c6-cb99-4038-a1f2-05262c5b34c3",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "In Großfamilien ist für die Kinderbetreuung meist durch eines der Familienmitglieder gesorgt."
                            },
                            {
                                "example_id": "64e20f2d-d140-489a-96aa-622a35bd7b1d",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "Eine traditionelle Großfamilie besteht aus Verwandten und eingeheirateten Frauen."
                            },
                            {
                                "example_id": "6df89069-d364-42f2-a923-e87530aa90d8",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "Das Netz der Großfamilie ist häufig die einzige soziale Absicherung dieser Kinder, doch die Pflegefamilien sind mit der Anzahl der zu versorgenden AIDS-Waisen zunehmend überfordert."
                            },
                            {
                                "example_id": "2de583f9-c358-4abd-912b-f614fe2cb195",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "„Die Familienpolitik der letzten Jahre, die hauptsächlich die Vereinbarkeit von Beruf und Familie zum Ziel hat, geht an den Interessen der meisten Großfamilien völlig vorbei“, sagt der Bonner Familienforscher Stefan Fuchs."
                            },
                            {
                                "example_id": "0ed5b8c8-3d9d-4105-a246-5dbef1a18e4b",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "„Wie befreiend ist es, in die türkische Großfamilie einzutauchen und ohne Zweifel und Widerrede das anzunehmen, was einem die älteren Familienmitglieder sagen.“"
                            },
                            {
                                "example_id": "2fb4aedd-9e83-4e58-bb6a-361bfd556235",
                                "sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                                "text": "„Bruno kommt aus einer Großfamilie mit sieben Geschwistern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2fd9c0a-2b5f-4a26-a16b-a05828e8bb8c",
                        "source_entry_id": "3d2297a6-ee24-3a1d-a76b-1bd8a81dae43",
                        "source_sense_id": "5c45b619-4775-3990-925b-07f8f9e16c6d",
                        "target_lang_word": "extended family",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extended family",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590380b0-c2db-3ede-b507-d6f96b905dda",
                                        "entry_id": "ddf886da-bcc7-3c7e-911a-e006ad720911",
                                        "glosses": [
                                            "A family consisting of parents and children, along with additional members such as grandparents, grandchildren, aunts or uncles, cousins, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d4a5cd-5c59-4d91-b217-fe01c80213a9",
                                                "sense_id": "590380b0-c2db-3ede-b507-d6f96b905dda",
                                                "text": "Angaran females typically give birth to several young who require support and supervision, resulting in large extended families that become accustomed to living and working together."
                                            },
                                            {
                                                "example_id": "481b832c-8e99-41fe-bc06-c5c3d0bb9411",
                                                "sense_id": "590380b0-c2db-3ede-b507-d6f96b905dda",
                                                "text": "The old men nap on couches, waiting for dessert. It’s the extended family in all its tangled, loving, exhausting glory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
