                "senses": [
                    {
                        "sense_id": "6fd09e5b-c538-30c9-b569-214fe87bdcfc",
                        "entry_id": "62a982f9-262d-3ed7-95e7-8282bf285130",
                        "glosses": [
                            "Se connecter par-dessus la session en cours sans la fermer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43b925ff-bc28-3632-a7c2-9188b1aac95e",
                        "entry_id": "62a982f9-262d-3ed7-95e7-8282bf285130",
                        "glosses": [
                            "Se connecter de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f1304fa-ab26-4f14-95c8-3e88b8412b1e",
                                "sense_id": "43b925ff-bc28-3632-a7c2-9188b1aac95e",
                                "text": "Notre pays doit arrêter de se surconnecter."
                            },
                            {
                                "example_id": "283a66ab-f7c5-4b54-ac83-beba04b47d00",
                                "sense_id": "43b925ff-bc28-3632-a7c2-9188b1aac95e",
                                "text": "Le fait de nous inciter à nous surconnecter et à être en contact permanent avec le Monde entier n’a d’autre but que de nous isoler, y compris de nous-mêmes."
                            },
                            {
                                "example_id": "77f3d315-ed6e-421f-9456-4fb159300e5f",
                                "sense_id": "43b925ff-bc28-3632-a7c2-9188b1aac95e",
                                "text": "Peut-être déjà en organisant des séances de \"déconnexion\"... ou plutôt en évitant de se \"surconnecter\"."
                            }
                        ]
                    }
                ],
