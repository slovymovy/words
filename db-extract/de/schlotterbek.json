                "senses": [
                    {
                        "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                        "entry_id": "af705e5c-e205-3b53-b898-78bbf3cb7da0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b81e2c4-49b2-41e9-8b7e-a6875baee3b2",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Der Schlotterbek trägt nie die Schals, die die Schlotterbek ihm strickt."
                            },
                            {
                                "example_id": "b7c57995-1e62-41aa-a2f8-cfd99dd33c38",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schlotterbek kommt, geht der Herr Schlotterbeck.“"
                            },
                            {
                                "example_id": "a39736c1-98af-4f9c-a914-bab449bba641",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Schlotterbek kommt und geht."
                            },
                            {
                                "example_id": "3fc33577-8c14-4be0-8e27-bd27f5ce9b6d",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Schlotterbeks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "17b943dd-55fe-4374-b653-97d82e650452",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Frau Schlotterbek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bcb633d3-c7e2-4c3e-befc-463e6e8b2432",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Herr Schlotterbek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4801833f-babe-46a4-8592-92461ce9242b",
                                "sense_id": "a4b05283-66eb-355d-98f8-efc65b557937",
                                "text": "Die Schlotterbeks fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
