                "forms": [
                    {
                        "form_id": "df6ed4a7-aab8-47b0-b226-f2d69d695520",
                        "entry_id": "0056e76d-846d-3b31-b735-132fd0786e6c",
                        "tags": [
                            "singular"
                        ],
                        "form": "écriture"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79e4072b-1b9f-38d2-a25a-73e5208d531c",
                        "entry_id": "0056e76d-846d-3b31-b735-132fd0786e6c",
                        "glosses": [
                            "Pluriel de écriture."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "75e43c07-0ce4-4ad8-aca6-105655eb6bd7",
                                "sense_id": "79e4072b-1b9f-38d2-a25a-73e5208d531c",
                                "text": "Une expression est restée longtemps en usage : un tel « est dans les écritures », pour « travaille dans un bureau »."
                            },
                            {
                                "example_id": "a82b8834-fcd9-4903-a171-c8e2a313d140",
                                "sense_id": "79e4072b-1b9f-38d2-a25a-73e5208d531c",
                                "text": "Il vit avec son fils, Nicolas, qui rechigne au métier et voudrait apprendre pour aller dans les écritures ; mais il n’a jamais osé en parler au vieux."
                            },
                            {
                                "example_id": "15ae9d43-0eb2-4f6b-8b0b-9b594a7e4c80",
                                "sense_id": "79e4072b-1b9f-38d2-a25a-73e5208d531c",
                                "text": "Fils de la servante, Jacquet entre à moins de treize ans comme employé aux écritures chez son père naturel qui ne lui accorde rien, après cette place de clerc dans son étude, pas même un regard."
                            },
                            {
                                "example_id": "55295fec-cb44-49ea-9708-5e0f6c979e4c",
                                "sense_id": "79e4072b-1b9f-38d2-a25a-73e5208d531c",
                                "text": "Je voudrais que mon petit Auguste « travaille dans les écritures » et gagne cent cinquante à cent quatre-vingts francs par mois quand il reviendra du régiment."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c6ee524a-32fd-3a2f-a480-577d376729c4",
