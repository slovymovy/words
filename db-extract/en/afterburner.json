                                        "entry_id": "ba4a8240-ca40-3999-8ea6-5542b300334c",
                                        "glosses": [
                                            "Vorrichtung bei Strahltriebwerken, mit deren Hilfe eine Erhöhung des Schubs erreicht werden kann"
                                        ],
                                        "tags": [],
