                        "examples": [
                            {
                                "example_id": "3b63f6fe-cddf-4a7f-b9d2-75ff24cd7620",
                                "sense_id": "5738ae67-302c-3c41-a9d4-19fb2d253bbb",
                                "text": "L'écoute de la musique aide la personne à gérer ses états mentaux, à s'autocalmer et à s'autostimuler mais aussi à ressentir de l'apaisement, des moments de détente."
                            },
                            {
                                "example_id": "cf06bc4c-d304-44a8-a31e-4ddd2899d580",
                                "sense_id": "5738ae67-302c-3c41-a9d4-19fb2d253bbb",
                                "text": "On se vante bien d'être contre, quand tout va pour le mieux, mais on s'en sert pour s'autocalmer."
                            },
                            {
                                "example_id": "d45ce4a4-80ed-41be-bf9e-89f4cd95ef2c",
                                "sense_id": "5738ae67-302c-3c41-a9d4-19fb2d253bbb",
                                "text": "Je l'aide aussi à apprendre à s'autocalmer, à contrôler ses réactions."
                            }
                        ]
                    }
