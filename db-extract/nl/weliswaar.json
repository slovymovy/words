                                "target_senses": [
                                    {
                                        "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                        "entry_id": "975bdb6f-a374-304a-8051-2e2d9c87cabd",
                                        "glosses": [
                                            "indessen, jedoch"
                                        ],
                                        "tags": [
                                            "eine Einschränkung beschreibend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7450c6d7-3339-4c8c-b8b9-2fa952f8651e",
                                                "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                                "text": "„Ein halbwegs bequemer und gerader Wasserweg ist der Rhein freilich nicht immer gewesen.“"
                                            },
                                            {
                                                "example_id": "e78b6d96-6af1-47d2-a138-60651e019144",
                                                "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                                "text": "Man muss die Leistung Kramniks gegen Deep Fritz anerkennen, auch wenn er das Match hoch verloren hat. Freilich muss man auch bemerken, dass er in keiner Partie auf Sieg stand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                        "entry_id": "975bdb6f-a374-304a-8051-2e2d9c87cabd",
                                        "glosses": [
                                            "klare Zustimmung, selbstverständlich"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d310cf-ef4f-4f4d-84a8-5d34ac905800",
                                                "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                                "text": "Freilich mache ich kein Hehl daraus, dass ich meine Frau liebe."
                                            },
                                            {
                                                "example_id": "8f516fac-8830-425f-856c-52d8bc6d4df6",
                                                "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                                "text": "Auf die Frage, ob sie ihm beim Umzug helfen würde, antwortete sie nur: „Freilich!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7803848-74f0-4e58-88b6-2ea52abb882c",
                        "source_entry_id": "cf85d919-f26b-3666-8c5c-a89d805cdbcb",
