            "senses": [
                {
                    "sense_id": "4f5c17f8-cf4f-32ac-871a-ad2551c8a3ae",
                    "sense_definition": "veel waardevolle zaken zonder voldoende nuttig effect verbruikend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkwistend_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>verkwistende</w> levensstijl leidde er uiteindelijk toe dat hij al zijn geld verloor.",
                            "target_lang_translations": {
                                "fr": "Son mode de vie <w>dépensier</w> a fini par lui faire perdre tout son argent."
                            }
                        },
                        {
                            "text": "De oppositie bekritiseerde het <w>verkwistende</w> beleid van de huidige regering scherp.",
                            "target_lang_translations": {
                                "fr": "L'opposition a vivement critiqué la politique <w>gaspilleuse</w> du gouvernement actuel."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwistig",
                        "spilziek",
                        "verspillend"
                    ],
                    "antonyms": [
                        "zuinig",
                        "spaarzaam"
                    ],
                    "common_phrases": [
                        "een verkwistende levensstijl",
                        "verkwistend omgaan met"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui consomme ou dépense des biens précieux de manière excessive et sans utilité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dépensier",
                                "target_lang_sense_clarification": "qui a tendance à dépenser sans compter"
                            },
                            {
                                "target_lang_word": "prodigue",
                                "target_lang_sense_clarification": "qui dilapide son bien, très généreux ou excessif"
                            },
                            {
                                "target_lang_word": "gaspilleur",
                                "target_lang_sense_clarification": "qui gaspille inutilement des ressources"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34b5462b-a69d-3bba-bd8c-29f831779e04",
                    "sense_definition": "onvoltooid deelwoord van <w>verkwisten</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verkwistend_participle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al zijn tijd aan nutteloze spelletjes <w>verkwistend</w>, vergat hij zijn huiswerk volledig.",
                            "target_lang_translations": {
                                "fr": "<w>Gaspillant</w> tout son temps à des jeux futiles, il en oubliait complètement ses devoirs."
                            }
                        },
                        {
                            "text": "Grote sommen geld aan luxe goederen <w>verkwistend</w>, raakte hij diep in de schulden.",
                            "target_lang_translations": {
                                "fr": "<w>Dilapidant</w> d'importantes sommes d'argent dans des produits de luxe, il s'est lourdement endetté."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
