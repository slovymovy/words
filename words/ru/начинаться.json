{
    "word_family": [
        "начало",
        "начальный",
        "начальник",
        "начинающий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3517827-c5c1-35d1-83e9-0f760156ee0e",
                    "sense_definition": "Начинать существовать, возникать, переходить от несуществования к существованию.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня <w>начинается</w> африканская часть ралли.",
                            "target_lang_translations": {
                                "en": "The African leg of the rally <w>begins</w> today."
                            }
                        },
                        {
                            "text": "В Подмосковье понижение температуры часто <w>начинается</w> уже в начале августа.",
                            "target_lang_translations": {
                                "en": "In the Moscow region, the drop in temperature often <w>starts</w> as early as the beginning of August."
                            }
                        }
                    ],
                    "synonyms": [
                        "возникать"
                    ],
                    "antonyms": [
                        "кончаться",
                        "завершаться"
                    ],
                    "common_phrases": [
                        "урок начинается",
                        "фильм начинается"
                    ],
                    "target_lang_definitions": {
                        "en": "To begin to exist, to arise, to transition from non-existence to existence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "begin",
                                "target_lang_sense_clarification": "To come into existence or start an event."
                            },
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "To commence or set in motion."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "285a0034-355f-3b30-bf5d-d49dfe18ebcb",
                    "sense_definition": "Иметь в качестве начала, исходной точки, первого элемента.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой телефонный номер <w>начинается</w> с тройки.",
                            "target_lang_translations": {
                                "en": "My phone number <w>starts</w> with a three."
                            }
                        },
                        {
                            "text": "Эта улица <w>начинается</w> от центральной площади города.",
                            "target_lang_translations": {
                                "en": "This street <w>begins</w> at the city's central square."
                            }
                        }
                    ],
                    "common_phrases": [
                        "начинается с"
                    ],
                    "target_lang_definitions": {
                        "en": "To have as a beginning, a starting point, or a first element."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "To have its origin or beginning point at a specific location or value."
                            },
                            {
                                "target_lang_word": "begin",
                                "target_lang_sense_clarification": "To have a starting point or initial element."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45fe4944-3e43-330e-8b40-2b4237ef62bb",
                    "sense_definition": "Страдательный залог к глаголу <w>начинать</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строительство дома <w>начинается</w> рабочими по плану.",
                            "target_lang_translations": {
                                "en": "The construction of the house <w>is being started</w> by the workers according to the plan."
                            }
                        },
                        {
                            "text": "Новое исследование <w>начинается</w> учеными в этом месяце.",
                            "target_lang_translations": {
                                "en": "A new study <w>is being started</w> by the scientists this month."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive voice of the verb 'to start' (to be started by someone)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be started",
                                "target_lang_sense_clarification": "Passive construction indicating an action is initiated by an agent."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}