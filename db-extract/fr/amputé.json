                ],
                "senses": [
                    {
                        "sense_id": "25d4e26e-3e4a-333a-a49e-edf5c9651741",
                        "entry_id": "eba7e029-849b-3611-bc0f-472767b9bcaa",
                        "glosses": [
                            "Qui a subi une amputation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe8d36f-811e-4330-877a-86b80f012a99",
                                "sense_id": "25d4e26e-3e4a-333a-a49e-edf5c9651741",
                                "text": "Son bras amputé ne le gênait nullement dans cette besogne."
                            },
                            {
                                "example_id": "0e745562-8cce-4d14-87a5-ec5ad929225d",
                                "sense_id": "25d4e26e-3e4a-333a-a49e-edf5c9651741",
                                "text": "« Oh ! vous savez, je le sais, que je le suis ! avec cette jambe droite qui se bande et qui sautille dès qu’elle entend la jambe gauche. » Mais, au fait, où était-elle, la jambe gauche ?\n« Il est amputé », expliquait le frère."
                            },
                            {
                                "example_id": "c2d940f1-9bc1-4b4f-8d0b-71300a6cf399",
                                "sense_id": "25d4e26e-3e4a-333a-a49e-edf5c9651741",
                                "text": "Après une amputation, presque tous les patients ont l’illusion que le membre amputé est toujours présent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fdfcfa-311d-40f3-9b00-4d86a52ab6e6",
