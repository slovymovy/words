                ],
                "senses": [
                    {
                        "sense_id": "fbd48dc8-a49e-3e72-9426-fb91b187c3f9",
                        "entry_id": "b976c1f4-af85-3c61-836d-6aea6451b198",
                        "glosses": [
                            "Se diffuser par ses propres moyens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e01cbb4-3fa5-4d7e-bdbf-07e5d73d640f",
                                "sense_id": "fbd48dc8-a49e-3e72-9426-fb91b187c3f9",
                                "text": "Pour passer à l’étape supérieure, la maison, en mars 1990, cesse d’assurer sa propre diffusion – on se discrédite à s’autodiffuser au-delà d’un certain temps – et quitte le distributeur Distique pour confier l’ensemble de ces tâches aux PUF par le biais desquelles le responsable de la maison espère améliorer ses ventes."
                            },
                            {
                                "example_id": "a58ae3aa-c0af-41c0-af2c-2d461207b4d4",
                                "sense_id": "fbd48dc8-a49e-3e72-9426-fb91b187c3f9",
                                "text": "Devant ces difficultés, beaucoup choisissent de s’autoproduire et même de s’autodiffuser par correspondance, par association interposée, par spectacle ou par démarchage local, et cela ne marche pas trop mal pour certains."
                            }
                        ]
                    }
