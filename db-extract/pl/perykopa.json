                "senses": [
                    {
                        "sense_id": "1f8556ee-7af0-32ff-be25-a8a767771c6e",
                        "entry_id": "65ed75fc-7a41-3710-b383-c0868e8444af",
                        "glosses": [
                            "określony fragment tekstu biblijnego odczytywanego podczas liturgii lub badanego przez biblistę"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "5f355604-6b75-483f-8c24-1b11fb0800d6",
                                "sense_id": "1f8556ee-7af0-32ff-be25-a8a767771c6e",
                                "text": "Przedmiotem niniejszego opracowania jest kontrowersja o szabat w świetle Janowej perykopy o uzdrowieniu chromego przy sadzawce Betesda."
                            },
                            {
                                "example_id": "9b86dfa4-3dbd-4bff-9372-ccaf554fc099",
                                "sense_id": "1f8556ee-7af0-32ff-be25-a8a767771c6e",
                                "text": "Omawiana perykopa ukazuje nam bardzo dokładnie naturę pokus i sposoby walki z nimi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "291927fc-018b-3aca-a983-94f74163265b",
                        "entry_id": "65ed75fc-7a41-3710-b383-c0868e8444af",
                        "glosses": [
                            "w poezji antycznej fragment utworu wydzielony zgodnie z zasadmi składni i rytmiki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dc75b94-3100-454c-b20a-f9d1c170ba35",
