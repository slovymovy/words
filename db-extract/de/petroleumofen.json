                        "examples": [
                            {
                                "example_id": "5068ecfd-870f-4263-9103-c2304acba70a",
                                "sense_id": "2f850514-d2f3-32dd-90be-db5fca99cc1f",
                                "text": "„Ich gab dem Pferd etwas Hafer, kochte auf dem kleinen Petroleumofen ein Ei und eine Tasse Kaffee für mich und zerbröckelte einen Hundekuchen für Bock.“"
                            },
                            {
                                "example_id": "02044d11-adff-4203-9621-e34fe853041a",
                                "sense_id": "2f850514-d2f3-32dd-90be-db5fca99cc1f",
                                "text": "„Da Dieter immer noch »Geschäftsmann« war, hatte er es zu einem Teppich, einem Bett und einem Petroleumofen gebracht.“"
                            }
                        ],
