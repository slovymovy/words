                        "examples": [
                            {
                                "example_id": "6b352fc1-09b7-4088-85a9-7924a324c142",
                                "sense_id": "06815fa4-f434-3ac6-b688-6c0f78b42bc9",
                                "text": "Ik werd uit de situatie gered door een andere Nederlandse campinggast, die mij voor Tim Krabbé aanzag."
                            },
                            {
                                "example_id": "ecce7231-7f9c-425c-b902-44acadf01af0",
                                "sense_id": "06815fa4-f434-3ac6-b688-6c0f78b42bc9",
                                "text": "De campingeigenaar weet niet wat er is gebeurd met het kind en hoe het nu met haar is. Ook weet hij niet om wie het gaat. Volgens hem is het een meisje van ongeveer 9 jaar. Geen campinggast maar bezoeker van de dagrecreatie. Het park aan de Lingesteeg in Kapel-Avezaath, een paar kilometer ten westen van Tiel, heeft een camping en een recreatieterrein met een plas."
                            }
                        ]
