                                        "sense_id": "61a47bf9-82fd-33ea-bb2f-2f7524ce76cb",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "A person who keeps an unkempt or sloppy appearance and has unusually long hair (for males), and is thus often stereotyped as a deadbeat."
                                        ],
                                        "tags": [
                                            "modern",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a9e7aa-58f6-37da-9a4b-bb7f6f4ddbf7",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "Someone who dresses in a hippie style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef05e36-999c-3989-9fb0-33297d018f2b",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "One who is hip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hippie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Of or pertaining to hippies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862e91a2-8e3d-44fe-9caa-ff76533d5420",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "That dress looks very hippie."
                                            },
                                            {
                                                "example_id": "b0799aa2-e4c3-4f53-9891-805665213053",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "The drug-taking he's writing about is less hippie than punk: it's about speed and smack and pills as much as hallucinogens and weed, about compulsion as well as escape."
                                            },
                                            {
                                                "example_id": "b7dc1f9a-9d09-4413-b938-cb7a805a1df0",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "You have to understand I worked in a very hippie nightclub for years, and the majority of the staff did not even like the Grateful Dead."
                                            },
                                            {
                                                "example_id": "b37353ef-b6c7-40a2-8adb-00a95b5b0c85",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "And then I discovered LSD, you can't get much more hippie than that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Not conforming to generally accepted standards."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706ffcc0-0ba1-4160-98c0-5ddb8e3a4b1b",
                                                "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                                "text": "They used a bunch of hippie compression formats instead of the usual RAR and ZIP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d21a89a-717c-46de-8191-67187d104077",
