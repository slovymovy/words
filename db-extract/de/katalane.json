                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Catalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c64421fd-e406-3040-87a9-008b77c35cde",
                                        "entry_id": "e43ac667-a5f1-3f3e-8c31-a51a2719064b",
                                        "glosses": [
                                            "A native or inhabitant of Catalonia, Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d22ff08-13dc-4d49-8133-2ea8df9dff62",
                                                "sense_id": "c64421fd-e406-3040-87a9-008b77c35cde",
                                                "text": "Even if he draws back from a declaration, many Catalans – including Mossos and civil servants – may decide to not to obey orders from Madrid, and tens of thousands of people could take to the streets to protect key regional government institutions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Catalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7713e1d5-5566-3724-8f39-3f73139bd439",
                                        "entry_id": "7c3843e5-5a29-3c28-a2ce-598a23ea7d6a",
                                        "glosses": [
                                            "The Romance language of Catalonia, an autonomous region in the northeast of Spain, also spoken in the Valencian autonomous region (where the language is officially named valencià), the Balearic Islands, Andorra, Roussillon in France, and the Sardinian city of Alghero."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276e602a-02b8-491d-91b5-174a403ba3fd",
                                                "sense_id": "7713e1d5-5566-3724-8f39-3f73139bd439",
                                                "text": "By the time this mysterious knight died in the 1360s, his book was available in every European language, including Dutch, Gaelic, Czech, Catalan, and Walloon."
                                            },
                                            {
                                                "example_id": "ffba05cc-0b7d-474e-aa93-f37ac71ae45e",
                                                "sense_id": "7713e1d5-5566-3724-8f39-3f73139bd439",
                                                "text": "Websites on the .cat domain are required to have content in the Catalan language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913fc28d-a87a-3dd1-86b1-2700a3d26647",
                                        "entry_id": "7c3843e5-5a29-3c28-a2ce-598a23ea7d6a",
                                        "glosses": [
                                            "A surname from Spanish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Catalan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "851340fb-66cc-3a06-b026-38c443e3e92c",
                                        "entry_id": "355c9f08-0ea8-376f-b5ad-9bb717e1a8a3",
                                        "glosses": [
                                            "Of, from or relating to Catalonia, Spain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25948301-600f-4b67-a21c-705533f280d7",
                                                "sense_id": "851340fb-66cc-3a06-b026-38c443e3e92c",
                                                "text": "The PSOE leader, who once promised to bring Puigdemont back to Spain to face justice, risked considerable political capital two years ago by pardoning nine of the Catalan leaders behind the drive for secession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "484341a2-d5b1-42f1-8743-22e5bec7566e",
                        "source_entry_id": "9628d85a-4d20-3326-8efd-c27c91a51f16",
                        "source_sense_id": "134b7da9-48ef-3e00-8155-02e367f5ada6",
                        "source_sense_description": "ein Bewohner von Katalonien",
                        "target_lang_word": "Catalan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Catalan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                        "entry_id": "1ae6d066-b1ab-35a3-9e16-4f118370103a",
                                        "glosses": [
                                            "Habitant de la région autonome espagnole de Catalogne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72db5aa3-148b-40ef-8d89-d55cf4a800cc",
                                                "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                                "text": "Les Barcelonais sont des Catalans, et ces Catalans, originaires de la partie de la Catalogne se trouvant en territoire espagnol, ont, par la force des choses, la nationalité espagnole."
                                            },
                                            {
                                                "example_id": "d77b1120-6dcc-4780-8361-cb0579eb6f70",
                                                "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                                "text": "L’aspect de Barcelone ressemble à Marseille, et le type espagnol n’y est presque plus sensible ; les édifices sont grands, réguliers, et, sans les immenses pantalons de velours bleu et les grands bonnets rouges des Catalans, l’on pourrait se croire dans une ville de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e703828-b1d9-342a-b283-57aaf5930403",
                                        "entry_id": "1ae6d066-b1ab-35a3-9e16-4f118370103a",
                                        "glosses": [
                                            "Habitant du département des Pyrénées-Orientales où le catalan est parlé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c9b95a-7928-4098-8d2c-a0a589083767",
                                                "sense_id": "6e703828-b1d9-342a-b283-57aaf5930403",
                                                "text": "Les Perpignanais sont des Catalans, et ces Catalans, originaires de la partie de la Catalogne se trouvant en territoire français, ont, par la force des choses, la nationalité française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
