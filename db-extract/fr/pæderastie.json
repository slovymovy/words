                        "examples": [
                            {
                                "example_id": "ce0bd860-1a6e-437b-a509-e1fa28e68bca",
                                "sense_id": "bf70c30e-d85f-302d-bace-a46b96bd281b",
                                "text": "Car ils eſtoient adonnés à la pæderaſtie ou amour des ieunes garçons, vice contre nature, le plus execrable & deteſtable de tous les vices: & faiſoient tant d’eſtat de la beauté du corps qu’ils ſe deſcouuroient à nud pour en faire monſtre par vanité a quinconque les en requeroit."
                            },
                            {
                                "example_id": "6625d0fd-a875-441e-be46-c2768eb40af5",
                                "sense_id": "bf70c30e-d85f-302d-bace-a46b96bd281b",
                                "text": "Car au jugement de Suidas , & de quelques autres Auteurs (3) elles eſtoient remplies de corruption & d’infamies, & on y trouvoit des leçons de Pæderaſtie , de Sodomie , & de tout ce qu’il y a de plus honteux dans les déreglemens d’une vie brutale."
                            }
                        ]
                    }
