                    {
                        "sense_id": "b80a13be-350f-37fd-898a-a50941af6bc0",
                        "entry_id": "47bc1543-9927-347d-bc36-cc58d3f7f67b",
                        "glosses": [
                            "Decorated and illustrated."
                        ],
                        "tags": [
                            "of a manuscript"
                        ],
                        "examples": [
                            {
                                "example_id": "080ef13c-6588-425f-a00c-067e51421c0b",
                                "sense_id": "b80a13be-350f-37fd-898a-a50941af6bc0",
                                "text": "On the table lay an illuminated missal and a silver crucifix. The Abbess herself was seated in the chair—pale, abstracted, and with features whose expression, in repose at least, was severe."
                            },
                            {
                                "example_id": "f7b4a08e-2dcb-4b0e-b819-c7f6ceba916b",
                                "sense_id": "b80a13be-350f-37fd-898a-a50941af6bc0",
                                "text": "From this list are purposely omitted books printed upon vellum, Books of Hours of the Virgin Mary, and illuminated books; for these are rarities within reach of the wealthy only."
                            }
                        ]
                    }
