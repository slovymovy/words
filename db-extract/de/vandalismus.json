                                    {
                                        "sense_id": "d5f08eeb-e285-37f8-bf65-c2a37daa0f85",
                                        "entry_id": "6fb4c9f9-72db-3465-a287-0b8f98007634",
                                        "glosses": [
                                            "destruição intencional de propriedades e bens alheios; defraudação"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f01fe5b-e479-4c4b-862b-62f7df1df013",
                                                "sense_id": "d5f08eeb-e285-37f8-bf65-c2a37daa0f85",
                                                "text": "Em outubro deste ano os carros de quatro professores sofreram vandalismo no estacionamento da Estadual Herbert Baldus, no Jardim São Bernardo."
                                            }
                                        ]
                                    }
