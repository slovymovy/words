                "senses": [
                    {
                        "sense_id": "3cd5ec12-ac45-3571-9d00-62c792a71e38",
                        "entry_id": "fe410e10-c175-3d21-9efc-25beef82efff",
                        "glosses": [
                            "bewogenheid, vaart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf2c2af-bcfb-49e0-845f-880ca9b09b38",
                                "sense_id": "3cd5ec12-ac45-3571-9d00-62c792a71e38",
                                "text": "De werknemers konden de dynamiek van het management niet meer bijbenen, waardoor het ziekteverzuim schrikbarend toenam."
                            },
                            {
                                "example_id": "9bc0ff63-3961-43bb-ad50-ceb38f9e733b",
                                "sense_id": "3cd5ec12-ac45-3571-9d00-62c792a71e38",
                                "text": "Het is een verleidelijk beeld, als je langs talloze kerken en kastelen rijdt, door stadjes waar geen leven te bekennen is, laat staan enige moderne vorm van bedrijvigheid. Maar daarmee misken je de dynamiek die je even goed langs de Nationale 7 aantreft."
                            },
                            {
                                "example_id": "c621f8aa-e634-46d3-bacc-2f25ee5008d4",
                                "sense_id": "3cd5ec12-ac45-3571-9d00-62c792a71e38",
                                "text": "We hadden het ook over de dynamiek binnen de hartstochtelijke trailrelaties die we om ons heen zagen en waarom die vaak al na drie weken voorbij waren."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef1cdd86-3b66-36e9-94ad-5fda7abcc11c",
                        "entry_id": "fe410e10-c175-3d21-9efc-25beef82efff",
                        "glosses": [
                            "gebruik van wisselingen in geluidssterkte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a0773e-37dd-4501-8863-e01fe379d946",
                                "sense_id": "ef1cdd86-3b66-36e9-94ad-5fda7abcc11c",
                                "text": "De enorme dynamiek van een symfonieorkest kan natuurlijk nooit worden afgespeeld met een mp3-spelertje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34e38ebe-bfe4-4f46-8c84-9aaca3cf6f7a",
                        "source_entry_id": "fe410e10-c175-3d21-9efc-25beef82efff",
                        "target_lang_word": "Dynamik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
