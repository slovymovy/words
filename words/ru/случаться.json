            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbe4a2a6-a3a3-3bed-8c26-c3c2bbb26227",
                    "sense_definition": "происходить, иметь место, совершаться",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "происходить",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашей жизни иногда <w>случаются</w> очень странные и неожиданные события.",
                            "target_lang_translations": {
                                "de": "In unserem Leben <w>geschehen</w> manchmal sehr seltsame und unerwartete Ereignisse."
                            }
                        },
                        {
                            "text": "Как часто <w>случается</w>, после долгого дождя на небе появилась яркая радуга.",
                            "target_lang_translations": {
                                "de": "Wie es oft <w>vorkommt</w>, erschien nach einem langen Regen ein farbenfroher Regenbogen am Himmel."
                            }
                        }
                    ],
                    "synonyms": [
                        "происходи́ть",
                        "соверша́ться"
                    ],
                    "common_phrases": [
                        "как часто случается",
                        "всякое случается"
                    ],
                    "target_lang_definitions": {
                        "de": "geschehen, stattfinden, sich ereignen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "passieren",
                                "target_lang_sense_clarification": "geschehen, vorfallen"
                            },
                            {
                                "target_lang_word": "geschehen",
                                "target_lang_sense_clarification": "sich ereignen"
                            },
                            {
                                "target_lang_word": "vorkommen",
                                "target_lang_sense_clarification": "sich von Zeit zu Zeit ereignen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9e39f7-8924-35df-9ef9-490cfe4b0f40",
                    "sense_definition": "о животных: спариваться, соединяться для размножения",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "размножение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной породистые животные на ферме регулярно <w>случаются</w> под контролем ветеринара.",
                            "target_lang_translations": {
                                "de": "Im Frühling <w>paaren sich</w> die reinrassigen Tiere auf dem Bauernhof regelmäßig unter Aufsicht des Tierarztes."
                            }
                        },
                        {
                            "text": "Овцы в этом хозяйстве обычно <w>случаются</w> в начале осени.",
                            "target_lang_translations": {
                                "de": "Die Schafe in diesem Betrieb <w>werden</w> normalerweise zu Beginn des Herbstes <w>gedeckt</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "von Tieren: sich paaren, zur Fortpflanzung zusammengeführt werden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich paaren",
                                "target_lang_sense_clarification": "Fortpflanzung bei Tieren"
                            },
                            {
                                "target_lang_word": "gedeckt werden",
                                "target_lang_sense_clarification": "in der Viehzucht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
