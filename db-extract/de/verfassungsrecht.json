                ],
                "senses": [
                    {
                        "sense_id": "39fed12e-a1a0-3985-8450-5a86e2a26655",
                        "entry_id": "5d39a3af-dee7-3e46-833c-6b1c1c715bf6",
                        "glosses": [
                            "Teilwissenschaft, die sich mit den rechtlichen Grundlagen von Staaten beschäftigt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b5fd965b-a3bd-4840-9be7-18cb0c58a8d4",
                                "sense_id": "39fed12e-a1a0-3985-8450-5a86e2a26655",
                                "text": "„Vornehmlich in den Ländern des deutschen Rechtskreises wird zwischen Staatsrecht im Allgemeinen und Verfassungsrecht im Besonderen unterschieden“."
                            },
                            {
                                "example_id": "d66d9fa9-8470-4092-a6a4-6d73f57ce785",
                                "sense_id": "39fed12e-a1a0-3985-8450-5a86e2a26655",
                                "text": "Eine Freundin von mir, die Jura studiert, muss gerade Verfassungsrecht lernen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7912c111-631c-3808-bcec-979792f0f7bf",
                        "entry_id": "5d39a3af-dee7-3e46-833c-6b1c1c715bf6",
                        "glosses": [
                            "in der Verfassung (eines Staates) enthaltene Rechtsnorm; durch die Verfassung zuerkanntes Recht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f0daf58-2052-4cd4-a71d-d0cafdee36b0",
                                "sense_id": "7912c111-631c-3808-bcec-979792f0f7bf",
                                "text": "Verfassungsrechte sind in Deutschland unter anderem die Meinungsfreiheit, das Versammlungsrecht, und die Redefreiheit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
