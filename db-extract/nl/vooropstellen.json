                                                "sense_id": "a8177935-390e-38cb-ace1-8c82f8a4c2c9",
                                                "text": "Als ihr Professor setze ich die Kenntnisse der Vorlesung des letzten Semesters voraus."
                                            },
                                            {
                                                "example_id": "234620c8-a8a3-4173-b8bf-ae06509846aa",
                                                "sense_id": "a8177935-390e-38cb-ace1-8c82f8a4c2c9",
                                                "text": "Ich muss die Kenntnis der Vorlesung des letzten Semesters voraussetzen."
                                            },
                                            {
                                                "example_id": "2d30f09f-176c-4274-a56f-bb13a55f8e08",
                                                "sense_id": "a8177935-390e-38cb-ace1-8c82f8a4c2c9",
                                                "text": "Ich setze mal voraus, dass Sie bereits im Archiv nachgeschaut haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19f9a06d-b5ba-3ff1-96b1-ac279efd4612",
