        "fr-extract.jsonl": [
            {
                "entry_id": "ba86b53a-f9b6-3bf9-82a4-b15261eace66",
                "word": "gargouillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7594c5a-51cf-41af-874c-e11dae8a1224",
                        "entry_id": "ba86b53a-f9b6-3bf9-82a4-b15261eace66",
                        "tags": [
                            "plural"
                        ],
                        "form": "gargouillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                        "entry_id": "ba86b53a-f9b6-3bf9-82a4-b15261eace66",
                        "glosses": [
                            "Bruit analogue à celui que fait l’eau dans une gargouille et qui est produit par le déplacement de liquides dans l’estomac et les intestins."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d8de8040-f692-4f51-bd21-9b4237dbb05b",
                                "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                                "text": "Le maître de chapelle eut à peine interrogé de l'archet la viole bourdonnante, qu'elle lui répondit par un gargouillement burlesque de lazzis et de roulades, comme si elle eût eu au ventre une indigestion de comédie italienne."
                            },
                            {
                                "example_id": "422b5dcc-5f2a-4d86-b181-b8c905808923",
                                "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                                "text": "Hommes et femmes s'étreignaient : les hommes entre eux, les femmes entre elles, à de rares exceptions, et l'accordéon couvrait l'épaisse rumeur de son gargouillement."
                            },
                            {
                                "example_id": "e9d74959-d945-4f6e-ae92-24f86ccdbce4",
                                "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                                "text": "Pendant la dissection du sac, la hernie se désétrangle spontanément : on entend un gargouillement et le sac s’affaisse."
                            },
                            {
                                "example_id": "0f021511-cb3f-4a28-aabe-6dcbb4a6c734",
                                "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                                "text": "Il ne parla plus. Son nez se pinçait ; sa figure devint violette ; il émettait des sons rauques ; ce gargouillement de la fin… Joséfa en larmes le prit entre ses bras, tandis que les Frontenac terrifiés reculaient vers la porte."
                            },
                            {
                                "example_id": "92506599-4e62-4d85-be73-c5241c4e565e",
                                "sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                                "text": "Il a eu une adolescence précocement queutarde : […]. On pourrait le brancher des heures sur ces fumantes évocations avec des gargouillements de bidet en fond sonore et des poils de cul sur la langue pour le faire zozoter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67d29581-a1ee-476b-ae49-263aad2b882c",
                        "source_entry_id": "ba86b53a-f9b6-3bf9-82a4-b15261eace66",
                        "source_sense_id": "9887aa40-e9a9-3154-a1d8-0debdee73211",
                        "target_lang_word": "geborrel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geborrel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "62b619d6-3a38-3410-8f33-465fbf432460",
                                        "entry_id": "2da6f2c7-9fb1-35f0-b734-7cad91ae5c81",
                                        "glosses": [
                                            "het aanhoudend borrelen van een vloeistof waardoorheen men een gas leidt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ff0074-39e1-46f5-8143-eb1fcccb6842",
                                                "sense_id": "62b619d6-3a38-3410-8f33-465fbf432460",
                                                "text": "In het krappe hoekpandje ruikt het zoals alleen een dierenwinkel kan geuren. Het geborrel van de waterpompen van de aquaria (de blanke bijlzalm kost 3,50 euro per stuk, een blauwe tetra heb je voor anderhalve euro) geeft het huisdierenmekka ondanks de volgepropte schappen iets sereens. Alleen Dennis’ lievelingspapegaai doorbreekt op onregelmatige momenten de rust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70541728-6404-389c-a90e-5ef53d0b8346",
                                        "entry_id": "2da6f2c7-9fb1-35f0-b734-7cad91ae5c81",
                                        "glosses": [
                                            "het aanhoudend drinken van alcoholische drankjes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66607a2-8764-4cce-aa88-87736da9c216",
                                                "sense_id": "70541728-6404-389c-a90e-5ef53d0b8346",
                                                "text": "Vorig jaar heb ik me namelijk iets te veel laten gaan. De avond begon bij mij thuis, waar we met z’n vieren uitgebreid geborreld hebben. Rond een uur of acht bracht mijn man ons naar het station, waar we met flessen wijn en plastic bekertjes in de trein naar Maastricht stapten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "092c276a-6e77-4d1c-beb7-ac3cf7d7c72b",
