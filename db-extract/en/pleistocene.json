                        ]
                    },
                    {
                        "translation_id": "47f8164f-6f16-4210-bca0-7548f56e66cc",
                        "source_entry_id": "52df202c-1959-307c-b1a7-cd13f065f007",
                        "source_sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                        "source_sense_description": "(geology) the Pleistocene epoch",
                        "target_lang_word": "Pleistozän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pleistozän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                        "entry_id": "b70393e2-4db1-3f65-91b3-cff337f2c5c9",
                                        "glosses": [
                                            "erdgeschichtliche Epoche, geprägt durch mehrere Eiszeiten, die vor etwa 2,4 Mio. Jahren begann und vor etwa 11.300 Jahren endete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f29ec31-8236-4fb4-a0eb-7ef9bbb18ffd",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Das Pleistozän wurde abgelöst vom Holozän."
                                            },
                                            {
                                                "example_id": "68712073-326f-4ea9-a4fc-097332fe9553",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Im Pleistozän bedeckte das Eis bis zu 30% des gesamten Festlandes."
                                            },
                                            {
                                                "example_id": "cd145417-15ce-4c02-930e-bc34c0061194",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Zu dieser Zeit herrschten in Mitteleuropa noch kaltzeitliche Verhältnisse mit deutlich geringeren Jahresmitteltemperaturen als heute, die - abgesehen von kurzen Wärmeschwankungen - für fast das gesamte damals ausklingende Pleistozän, das Eiszeitalter, kennzeichnend waren.“"
                                            },
                                            {
                                                "example_id": "d00e6573-25a1-45cc-b78a-be3efc12e97f",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im Pleistozän herrschten in Europa mehrere Eiszeiten.“"
                                            },
                                            {
                                                "example_id": "d8b73ce5-4bd9-436f-8fef-cfea21d6fc88",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im mittleren Pleistozän wirkten sich die klimatischen Bedingungen der Eiszeiten auf die biologische und kulturelle Evolution des Frühmenschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "812d1620-79ba-4a97-9505-02b00071a093",
                        "source_entry_id": "52df202c-1959-307c-b1a7-cd13f065f007",
                        "source_sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                        "source_sense_description": "(geology) the Pleistocene epoch",
                        "target_lang_word": "Eiszeitalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eiszeitalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66c37027-89d4-3a78-8828-53831c698975",
                                        "entry_id": "243482a9-a534-3ea1-a7c4-fce296270be6",
                                        "glosses": [
                                            "durch eine Abfolge mehrerer Kalt- und Warmzeiten geprägter erdgeschichtlicher Zeitraum, Kaltzeit"
                                        ],
                                        "tags": [
                                            "Klimatologie",
                                            "oft auch speziell nur die eine Hälfte",
                                            "die"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc247f26-6302-490f-a4dd-ca7d5a838027",
                                                "sense_id": "66c37027-89d4-3a78-8828-53831c698975",
                                                "text": "In Norddeutschland findet man manche Relikte des letzten Eiszeitalters."
                                            },
                                            {
                                                "example_id": "50eaa2c3-f484-4cf5-acc4-1d0dc74201c3",
                                                "sense_id": "66c37027-89d4-3a78-8828-53831c698975",
                                                "text": "„Doch dann begann das letzte Eiszeitalter, es wurde kühler, trockener und aus den fruchtbaren, feuchten Savannen wurden Trockensavannen.“"
                                            },
                                            {
                                                "example_id": "0e045953-f311-463e-914c-56088903dfa3",
                                                "sense_id": "66c37027-89d4-3a78-8828-53831c698975",
                                                "text": "„Neben die Gebirgsbildungen tritt ein weiteres wichtiges geologisches Ereignis, das Eiszeitalter, in dem Nordeuropa mehrfach von einer mächtigen Inlandeisdecke überdeckt war, die sich bis nach England, nach Mitteleuropa und in das Osteuropäische Flachland hinein erstreckte.“"
                                            },
                                            {
                                                "example_id": "e7501296-b833-4e5b-9006-99c3764af7fb",
                                                "sense_id": "66c37027-89d4-3a78-8828-53831c698975",
                                                "text": "Es gab in der bisherigen Erdgeschichte sieben Eiszeitalter, also Kaltzeiten, von denen jede (ausgenommen der relativ kurzen Gaskiers-Eiszeit) mehrere Millionen Jahre dauerte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6b9cd8f-d021-386f-97ad-7963405ae57e",
                                        "entry_id": "243482a9-a534-3ea1-a7c4-fce296270be6",
                                        "glosses": [
                                            "Pleistozän, die 2,5 Millionen Jahre vor der Neuzeit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f005e69-1558-4b58-9f9b-9455052d5cd1",
                                                "sense_id": "d6b9cd8f-d021-386f-97ad-7963405ae57e",
                                                "text": "Der Beginn des Eiszeitalters fällt zeitlich in etwa mit dem Beginn der Vergletscherung der Arktis vor ca. 2,6 Millionen Jahren zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ad0ddf7-92d9-43d8-ae27-40c4132e3d73",
