                ],
                "senses": [
                    {
                        "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                        "entry_id": "f35f0fca-750c-3174-a3d5-76a471f28338",
                        "glosses": [
                            "Sitz mit Lehne(n), besonders Sitz des Lehrers/der Autoritätsperson"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f53dd17e-c8f9-490a-88ca-16c4d08169db",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„In späten römischen Grabanlagen findet sich verschiedentlich in Grabräumen, die zugleich für kleinere Zusammenkünfte der Hinterbliebenen hergerichtet sind, eine Kathedra, die zwischen Sitzbänken einen Ehrenplatz bildet, […] Die Sitzweite der Kathedren ist in vielen Fällen so gering, daß ein erwachsener Mensch auf ihnen nicht Platz hätte, […]“"
                            },
                            {
                                "example_id": "9e2459e5-a766-4f65-b0d6-5f4576d44dd9",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„So findet sich z. B. die sogenannte Kathedra, der Lehnsessel mit nach auswärts geschweiften Beinen und breiter runder Lehne, […] auf Vasen des vierten Jahrhunderts v. Chr., […]“"
                            },
                            {
                                "example_id": "ddea710e-6258-4c2f-87c2-4d73513d556d",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„Dabei wurde ein Stuhl immer hervorgehoben: der eigentliche Lehrstuhl, den die Juden vielfach mit der Kathedra des Mose identifizierten (vgl. Mt 23,2).“"
                            },
                            {
                                "example_id": "d7381dc9-352b-4ece-9793-9e376266fc76",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„Auffallend ist hier [in der Mischna] bereits das Gemeinsamkeit markierende griechische Fremdwort Kathedra für \"Lehnstuhl\".“"
                            },
                            {
                                "example_id": "08d94305-acc9-49fa-bace-6c9c6084da6c",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„Auf einer Seite dieser Handschrift nun befand sich ein Bild, das den alten Gelehrten unter einer Säulenhalle auf goldener Kathedra im weißen Talare sitzend darstellte.“"
                            },
                            {
                                "example_id": "d536dc42-609f-4c0f-8dfb-d17d0a42a0db",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„Kathedren oder Thronsitze für den Bischof oder vorsitzenden Kleriker bestanden wohl schon immer zumeist aus Holz, und es haben sich nur wenige marmorne erhalten.“"
                            },
                            {
                                "example_id": "884d2b2c-3206-4256-baba-be454f8818da",
                                "sense_id": "cdcf800b-44a9-3e8f-b770-d929ecfc1500",
                                "text": "„Vom Beginne der Kirche an waren die Sitze der Priester von denen der Bischöfe durchaus verschieden. Diese hatten allezeit die Form eigentlicher Kathedren mit Armlehnen und hohen Rückseiten, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96c16453-5e21-3deb-8cd5-77ca696bd544",
                        "entry_id": "f35f0fca-750c-3174-a3d5-76a471f28338",
                        "glosses": [
                            "Sitz des jeweiligen Kirchenoberhauptes, in der Regel des Bischofs"
                        ],
                        "tags": [
                            "Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "d299ea66-9dd7-4a23-a819-a903b82db66f",
                                "sense_id": "96c16453-5e21-3deb-8cd5-77ca696bd544",
                                "text": "„Kathedren oder Thronsitze für den Bischof oder vorsitzenden Kleriker bestanden wohl schon immer zumeist aus Holz, und es haben sich nur wenige marmorne erhalten.“"
                            },
                            {
                                "example_id": "10292999-3ed9-4fad-b66a-e9a5710abd94",
                                "sense_id": "96c16453-5e21-3deb-8cd5-77ca696bd544",
                                "text": "„Vom Beginne der Kirche an waren die Sitze der Priester von denen der Bischöfe durchaus verschieden. Diese hatten allezeit die Form eigentlicher Kathedren mit Armlehnen und hohen Rückseiten, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c00b283c-9849-389b-8905-9e885b7b152c",
                        "entry_id": "f35f0fca-750c-3174-a3d5-76a471f28338",
                        "glosses": [
                            "Amtsbereich eines Bischofs, dessen Bistum"
                        ],
                        "tags": [
                            "figurative",
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f31fcc18-22d9-4e11-bbdc-42a047e6eda0",
                                "sense_id": "c00b283c-9849-389b-8905-9e885b7b152c",
                                "text": "„Der Urquell ist Christus, von ihm fließt ein breiter Strom zum apostolischen Stuhl, schmalere Bäche aber zu den nicht apostolischen Kathedren.“"
                            },
                            {
                                "example_id": "9e9e6cfc-6c6d-448a-a6d1-8c05ea24adf4",
                                "sense_id": "c00b283c-9849-389b-8905-9e885b7b152c",
                                "text": "„\"[…] wir […] haben jedem Metropoliten an der passenden Stelle die Kathedren zugeteilt, […]\"“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
