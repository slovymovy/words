                ],
                "senses": [
                    {
                        "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                        "entry_id": "236b6554-8d33-3c61-b33b-cc5cfb6e281a",
                        "glosses": [
                            "Übung, die morgens stattfindet; (körperliche) Aktivität, die darauf abzielt, den Körper und Geist zu aktivieren und den Tag positiv zu beginnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25335317-4996-4865-9047-626e96d26da8",
                                "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                                "text": "„Der Tag beginnt mit Morgenübungen am See zum aktiven Erwachen.“"
                            },
                            {
                                "example_id": "f2b8a1e2-9e19-424f-b3a7-4fe8a657cba1",
                                "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                                "text": "„Diese einfachen Morgenübungen können helfen, den Körper und Geist zu aktivieren, den Kreislauf in Schwung zu bringen und Spannungen und Stress abzubauen.“"
                            },
                            {
                                "example_id": "a0ea158d-5514-4104-a9cc-0df49062bf99",
                                "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                                "text": "„Er verabscheute besonders die halsbrecherische Anbetung der Schneidigkeit, die, von außen kommend, nun auch schon in seinem Vaterland manchem als Ideal vorschwebte; und sich von ihr abzuwenden, gehörte ganz und gar zu seinen Morgenübungen.“"
                            },
                            {
                                "example_id": "09061973-4a6f-4fcd-9c27-476e9d3698f3",
                                "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                                "text": "„Im Raum der Stille finden auch die Morgenübungen statt, welche allen Gästen des ChieneHuus sowie des benachbarten Kientalerhofs kostenlos offenstehen (keine Anmeldung notwendig).“"
                            },
                            {
                                "example_id": "b975a913-325d-4534-8bf5-faa1c45286b2",
                                "sense_id": "f7b389d1-4650-3734-94b1-feee0b1f9622",
                                "text": "„Nach den Morgenübungen besuchst du Patanjali Yogpeeth, ein großes Yoga- und Ayurveda-Zentrum in Haridwar, dem ein Krankenhaus und ein Yoga-Forschungsinstitut angehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
