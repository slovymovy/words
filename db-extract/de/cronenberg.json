                ],
                "senses": [
                    {
                        "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                        "entry_id": "f62565b3-c68e-3d09-bae2-60a96e42e3d5",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb4cfcf-47ee-49d7-9ade-b21488f99157",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Der Cronenberg trägt nie die Schals, die die Cronenberg ihm strickt."
                            },
                            {
                                "example_id": "4a04ee52-0b47-4391-b14b-dfac84722467",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cronenberg kommt, geht der Herr Cronenberg.“"
                            },
                            {
                                "example_id": "a4bb9498-f78d-40ff-a70b-18950b694cc7",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Cronenberg kommt und geht."
                            },
                            {
                                "example_id": "96e69f97-ffef-4a58-9286-0033a4c27ce6",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Cronenbergs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a27a8545-89ff-4aab-9091-e9107ffe1d39",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "An verregneten Herbsttagen ist Familie Cronenbergs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "a7643fea-b0ad-47d7-bb5c-cc69287b8780",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Cronenberg das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "16968290-fa7b-4266-b614-b3089acc3e4c",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Frau Cronenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "68f59232-52db-4c65-a409-dcd3c83f3dd6",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Herr Cronenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6256d444-6365-451a-b6da-6e0e62ac5217",
                                "sense_id": "f7180416-a4e5-3536-9803-4ef6c635c37b",
                                "text": "Die Cronenbergs kommen heute aus dem Siegerland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
