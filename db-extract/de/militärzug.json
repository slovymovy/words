                        "sense_id": "f429b9f6-5c70-3018-93c4-afce05e720d3",
                        "entry_id": "9ba54a0a-f2f0-3bbe-a07a-00d0dda94fc9",
                        "glosses": [
                            "Zug, der Personal und/oder Material des Militärs transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62c53df-1d4a-4442-8a68-e2369171f51d",
                                "sense_id": "f429b9f6-5c70-3018-93c4-afce05e720d3",
                                "text": "„Er stand schon die zweite Nacht draußen und sah den Militärzügen nach.“"
                            },
                            {
                                "example_id": "72e01fde-5e39-476b-864b-3db5c9e860d4",
                                "sense_id": "f429b9f6-5c70-3018-93c4-afce05e720d3",
                                "text": "„Doch die Mobilmachung, die Militärzügen absoluten Vorrang einräumte, ließ alle normalen Fahrpläne Makulatur werden und damit auch die darauf angewiesenen Abläufe.“"
                            }
                        ],
