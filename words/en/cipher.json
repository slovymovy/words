{
    "word_family": [
        "decipher",
        "encipher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa38d8b3-32dd-30f2-866e-2681aeabb564",
                    "sense_definition": "The number zero.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new symbol, the <w>cipher</w>, allowed mathematicians to represent nothingness.",
                            "target_lang_translations": {
                                "nl": "Het nieuwe symbool, de <w>nul</w>, stelde wiskundigen in staat om nietsheid weer te geven."
                            }
                        },
                        {
                            "text": "He added a <w>cipher</w> to the end of the number to make it ten times larger.",
                            "target_lang_translations": {
                                "nl": "Hij voegde een <w>nul</w> toe aan het einde van het getal om het tien keer zo groot te maken."
                            }
                        }
                    ],
                    "synonyms": [
                        "zero"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het getal nul."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nul",
                                "target_lang_sense_clarification": "Het getal nul als symbool voor niets."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a04c51a-a3f8-39c0-bf80-070e8db5630b",
                    "sense_definition": "A method of transforming text to hide its meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secret message was written in a simple <w>cipher</w>.",
                            "target_lang_translations": {
                                "nl": "Het geheime bericht was geschreven in een eenvoudige <w>cijfercode</w>."
                            }
                        },
                        {
                            "text": "Spies often use a complex <w>cipher</w> to protect their communications.",
                            "target_lang_translations": {
                                "nl": "Spionnen gebruiken vaak een complexe <w>versleuteling</w> om hun communicatie te beschermen."
                            }
                        }
                    ],
                    "synonyms": [
                        "code"
                    ],
                    "common_phrases": [
                        "simple cipher"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een methode om tekst te versleutelen om de betekenis te verbergen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "cijfercode",
                                "target_lang_sense_clarification": "Een systeem voor het versleutelen van berichten."
                            },
                            {
                                "target_lang_word": "versleuteling",
                                "target_lang_sense_clarification": "Het proces van het onleesbaar maken van informatie."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ec3bd41-cc7e-3cf3-b50b-585abf13cc61",
                    "sense_definition": "A person or thing that has no importance or influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assistant felt like a mere <w>cipher</w> in the large corporation.",
                            "target_lang_translations": {
                                "nl": "De assistent voelde zich slechts een <w>nul</w> in het grote bedrijf."
                            }
                        },
                        {
                            "text": "Without any real power, the politician was just a <w>cipher</w> for his party.",
                            "target_lang_translations": {
                                "nl": "Zonder enige echte macht was de politicus slechts een <w>nietsnut</w> voor zijn partij."
                            }
                        }
                    ],
                    "synonyms": [
                        "nobody",
                        "nonentity"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een persoon of ding zonder enig belang of invloed."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nul",
                                "target_lang_sense_clarification": "Iemand die niets voorstelt."
                            },
                            {
                                "target_lang_word": "nietsnut",
                                "target_lang_sense_clarification": "Een persoon zonder waarde of invloed."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d47c8db-ed2d-392a-8e90-60755a25ea5d",
                    "sense_definition": "A decorative design made of intertwined letters, often initials.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal ring featured a gold <w>cipher</w> of the queen's initials.",
                            "target_lang_translations": {
                                "nl": "De koninklijke ring bevatte een gouden <w>monogram</w> van de initialen van de koningin."
                            }
                        },
                        {
                            "text": "The artist carved a small <w>cipher</w> into the corner of the painting.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar kerfde een klein <w>monogram</w> in de hoek van het schilderij."
                            }
                        }
                    ],
                    "synonyms": [
                        "monogram"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een decoratief ontwerp bestaande uit verstrengelde letters, vaak initialen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "monogram",
                                "target_lang_sense_clarification": "Een teken bestaande uit in elkaar gevlochten letters."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5696c30e-3aec-3f9d-b1fd-929c67f1833c",
                    "sense_definition": "To perform mathematical calculations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calculate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students were taught to read and <w>cipher</w> in the old schoolhouse.",
                            "target_lang_translations": {
                                "nl": "Leerlingen leerden lezen en <w>cijferen</w> in het oude schoolgebouw."
                            }
                        },
                        {
                            "text": "It took hours to <w>cipher</w> the total costs of the project.",
                            "target_lang_translations": {
                                "nl": "Het kostte uren om de totale kosten van het project te <w>cijferen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to basic arithmetic skills."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Wiskundige berekeningen uitvoeren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "cijferen",
                                "target_lang_sense_clarification": "Het uitvoeren van rekenkundige bewerkingen."
                            },
                            {
                                "target_lang_word": "rekenen",
                                "target_lang_sense_clarification": "Algemene term voor het uitvoeren van berekeningen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d4ddd3f-a160-3a3c-8578-37f1f67a9b94",
                    "sense_definition": "To write something in a secret code.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent had to <w>cipher</w> the report before sending it.",
                            "target_lang_translations": {
                                "nl": "De agent moest het rapport <w>versleutelen</w> voordat hij het verstuurde."
                            }
                        },
                        {
                            "text": "They <w>cipher</w> all sensitive data to keep it safe from hackers.",
                            "target_lang_translations": {
                                "nl": "Ze <w>coderen</w> alle gevoelige gegevens om ze veilig te houden voor hackers."
                            }
                        }
                    ],
                    "synonyms": [
                        "encode"
                    ],
                    "antonyms": [
                        "decipher"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets in een geheime code schrijven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versleutelen",
                                "target_lang_sense_clarification": "Informatie omzetten naar een geheime code."
                            },
                            {
                                "target_lang_word": "coderen",
                                "target_lang_sense_clarification": "Gegevens omzetten naar een andere vorm of code."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}