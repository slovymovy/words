        "fr-extract.jsonl": [
            {
                "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                "word": "dithyrambique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ce9d61c-8d05-40e7-bd1b-dd9fcf67fa97",
                        "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dithyrambiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35243698-ea4c-3074-b643-3da41752ec69",
                        "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "glosses": [
                            "Qui appartient au genre poétique du dithyrambe."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad45e01-3dad-4863-88fd-3647423e9d77",
                                "sense_id": "35243698-ea4c-3074-b643-3da41752ec69",
                                "text": "Poème dithyrambique."
                            },
                            {
                                "example_id": "dd5c2cc1-6766-4223-b345-989311bf4f77",
                                "sense_id": "35243698-ea4c-3074-b643-3da41752ec69",
                                "text": "Au temps d’Eschyle, quand la tragédie, fidèle à ses origines, est encore un chant dithyrambique."
                            },
                            {
                                "example_id": "8070fb04-dc1d-4468-adb5-f4f70958bfe2",
                                "sense_id": "35243698-ea4c-3074-b643-3da41752ec69",
                                "text": "Les visions des anciens prophètes avaient souvent été accompagnées de phénomènes d’excitation nerveuse. L’état dithyrambique des Grecs entraînait des faits du même genre…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bacd527-8dd1-3b32-a47c-557bcde8b86e",
                        "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "glosses": [
                            "Qui est de la nature du dithyrambe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18fd29b2-d1ff-494d-b08f-181901a5caa1",
                                "sense_id": "7bacd527-8dd1-3b32-a47c-557bcde8b86e",
                                "text": "Le genre dithyrambique."
                            },
                            {
                                "example_id": "d36d77b1-7e0d-4be0-8c60-bb197cfb1ce4",
                                "sense_id": "7bacd527-8dd1-3b32-a47c-557bcde8b86e",
                                "text": "Les Italiens modernes se sont exercés dans la poésie dithyrambique, et pensent y avoir excellé."
                            }
                        ]
                    },
                    {
                        "sense_id": "119669b7-4cc5-3e86-a7b3-24c995d9a000",
                        "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "glosses": [
                            "Qui compose des dithyrambes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecc48e7-9357-4cfc-bee8-551d635caceb",
                                "sense_id": "119669b7-4cc5-3e86-a7b3-24c995d9a000",
                                "text": "Poète dithyrambique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4375126d-0200-3a97-9d68-dd1b7d8d2fca",
                        "entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "glosses": [
                            "Se dit de quelqu’un volontiers excessif, emphatique, et pompeux dans ses éloges ou son expression en général."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ef51152b-662f-4365-b8c2-a63f5845e934",
                                "sense_id": "4375126d-0200-3a97-9d68-dd1b7d8d2fca",
                                "text": "Je connaissais trop Puig, son exubérance, sa nature dithyrambique."
                            },
                            {
                                "example_id": "b1a335a0-39ee-409a-9825-9c3d5013f176",
                                "sense_id": "4375126d-0200-3a97-9d68-dd1b7d8d2fca",
                                "text": "Le style à moi, qui m’est naturel, c’est le style dithyrambique et enflé."
                            },
                            {
                                "example_id": "c0109913-92fc-4aff-bb17-8e817e9e6733",
                                "sense_id": "4375126d-0200-3a97-9d68-dd1b7d8d2fca",
                                "text": "Il commença, en style pompeux, un long éloge dithyrambique auquel je ne compris rien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3e124d1-c352-4f90-a37b-9a880dba6558",
                        "source_entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "target_lang_word": "dithyrambic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dithyrambic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                        "entry_id": "a5d60b3c-3287-34f2-9bd5-750720b01caf",
                                        "glosses": [
                                            "Of, pertaining to, or resembling a dithyramb; especially, passionate, intoxicated with enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636cadf2-081b-4cc1-9ac7-59ef1cb44693",
                                                "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                                "text": "Signor Papini, the leader of italian pragmatism, grows fairly dithyrambic over the view that it opens, of man's divinely-creative functions."
                                            },
                                            {
                                                "example_id": "d47d0c1d-81bc-4a72-967a-b36dafcd50ee",
                                                "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                                "text": "Bradly was out of bed, blundering across the floor to kneel by her and pat reassurance on her satin-smooth shoulders. She gripped him with both arms, holding him tight against the convulsive shudder that rejected terror in the security of his arms. Confounded by a dithyrambic conflict of fear and exultation, Bradly could only snatch at one coherent thought, \"Damme, after the old bitch accusin' me...\""
                                            },
                                            {
                                                "example_id": "a1f807ef-b365-4384-8c93-9d59968e9677",
                                                "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                                "text": "... thighs appear to be continuously alighting and pausing in mid-air, detached from their dithyrambic owners, like luminous birds on the wing."
                                            },
                                            {
                                                "example_id": "64f55205-92e2-4fcf-bf18-90b4935de085",
                                                "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                                "text": "The dithyrambic chorus is a chorus of transformed people, for whom their social past, their civic position, is entirely forgotten."
                                            },
                                            {
                                                "example_id": "2e53ca97-720f-417c-b1d1-4c3d202947c0",
                                                "sense_id": "dea7077e-56cb-3fdc-ba9e-3e714bc4280d",
                                                "text": "Nevertheless, if one has time and, still more, the patience to search whole acres of dithyrambic prose, he shall have his reward."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dithyrambic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f3f2b98-d44b-32b2-acf6-dea036a70298",
                                        "entry_id": "19a646de-8641-37fb-9843-9c02a4c85f37",
                                        "glosses": [
                                            "A dithyramb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbedb6b-2048-47f0-bd2b-fbe98bd3e2ef",
                                                "sense_id": "7f3f2b98-d44b-32b2-acf6-dea036a70298",
                                                "text": "1775, Anonymous, review of the West translation of Pindar's Olympic Odes, in The Critical Review, volume 40, page 451,\nAs we have no remains of the dithyrambics of the ancients, we cannot exactly ascertain the measure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8275deb-cb6c-44d1-93e1-6d300d542463",
                        "source_entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
                        "target_lang_word": "eulogistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eulogistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7491b9d8-4f33-3e52-b0a2-306fe17b6cec",
                                        "entry_id": "3dfad0b9-ce2f-3b48-bb11-96ce206469d2",
                                        "glosses": [
                                            "Conveying praise or admiration, as in a eulogy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449e1d6d-ecdc-461a-84eb-287ef078b64c",
                                                "sense_id": "7491b9d8-4f33-3e52-b0a2-306fe17b6cec",
                                                "text": "But on one fatal occasion I happened to change my tactics and warmly praised a work[…] my eulogistic review of the hated individual, unfortunately for me, appeared, with the result that private spite outweighed public justice and I was immediately dismissed."
                                            },
                                            {
                                                "example_id": "5f723856-c11c-4b14-9046-64d0600dff9d",
                                                "sense_id": "7491b9d8-4f33-3e52-b0a2-306fe17b6cec",
                                                "text": "He writhed for twenty minutes under the flowery and eulogistic periods of the president, and rose himself in the state of confused indignation which the Briton feels when he is publicly approved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3901a49c-e703-4269-83d0-3dcbef774d78",
                        "source_entry_id": "6548869b-6f4e-387f-979e-dd1979fc6599",
