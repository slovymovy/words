                        "target_lang_word": "inductance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inductance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecee480f-7618-3bf1-853e-ec32a4d17e4d",
                                        "entry_id": "c250bedb-1b95-3d69-92c8-bd8a77046c05",
                                        "glosses": [
                                            "Coefficient d’auto-induction ; il a pour unité le henry (H) dans le Système international."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc058756-f852-4c40-ae66-0fa820366f4b",
                                                "sense_id": "ecee480f-7618-3bf1-853e-ec32a4d17e4d",
                                                "text": "Des diodes de puissance au silicium de ce type connectées en opposition pour former un écrêteur symétrique, ont pu rendre de sécurité des circuits, contenant des inductances atteignant 330 mH, dans lesquelles circulaient des courants de 3,2 A efficaces sous des tensions allant jusqu’à 75 V efficaces."
                                            },
                                            {
                                                "example_id": "33d72c9c-4501-453b-b1a3-69bc630b28a8",
                                                "sense_id": "ecee480f-7618-3bf1-853e-ec32a4d17e4d",
                                                "text": "La société américaine Boonton a réalisé un inductancemètre numérique destiné à la mesure des inductances dont la valeur est comprise entre 2 µH et 2,000 H."
                                            },
                                            {
                                                "example_id": "e5f2702b-4697-4687-86be-cd9320deeaf3",
                                                "sense_id": "ecee480f-7618-3bf1-853e-ec32a4d17e4d",
                                                "text": "Il existe des inductancemètres ou des « ponts RLC » (Résistance Inductance Capacité) mesurant des inductances ; à part pour satisfaire sa curiosité, le dépanneur n’aura pas besoin (en ce qui concerne les inductances) de tels appareils ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b329d3d2-cabb-3ef6-9ce7-6af17f6d446e",
                                        "entry_id": "c250bedb-1b95-3d69-92c8-bd8a77046c05",
                                        "glosses": [
                                            "Tout composant électrique qui crée un flux d’induction magnétique quand un courant le traverse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c11988bd-e206-431d-a34e-19d7a31b4e8a",
                        "source_entry_id": "0f1c1114-bfe4-3f51-8e7f-c613eb27625c",
                        "source_sense_description": "property",
                        "target_lang_word": "Induktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Induktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1df85839-003d-33d5-9d50-80985413561d",
                                        "entry_id": "533a2311-675e-320c-a03d-a27ba391a4f6",
                                        "glosses": [
                                            "Eigenschaft einer Spule (das Verhältnis zwischen induzierter Spannung und der Änderung der Stromstärke pro Zeiteinheit)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0828b39-f7eb-4bc0-999b-d890e30b67ca",
                                                "sense_id": "1df85839-003d-33d5-9d50-80985413561d",
                                                "text": "„Die Formel für die Induktivität L ist: L = µ.N2.A/l“"
                                            },
                                            {
                                                "example_id": "89342bdf-de07-45eb-8174-763883b49f8e",
                                                "sense_id": "1df85839-003d-33d5-9d50-80985413561d",
                                                "text": "Induktivitäten werden in Henry (H) gemessen."
                                            },
                                            {
                                                "example_id": "44b2fb9b-b17c-4d45-89ac-8567b89b159b",
                                                "sense_id": "1df85839-003d-33d5-9d50-80985413561d",
                                                "text": "„Das Magnetfeld ist abhängig vom Kernmaterial der Spule, von der Windungszahl und von der Spulengeometrie. Alle Größen zusammengefasst bilden die Induktivität einer Spule.“"
                                            },
                                            {
                                                "example_id": "bd13faf0-0749-48dc-96f2-4b04ddeaecbe",
                                                "sense_id": "1df85839-003d-33d5-9d50-80985413561d",
                                                "text": "„Eine Induktivität von 1 Henry erzeugt in einer Spule bei gleichförmiger Stromänderung von 1 Ampere (A) in einer Sekunde (s) eine Selbstinduktion von 1 Volt (V).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
