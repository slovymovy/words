                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe3e1aea-2fbe-46fd-833b-6b385e4bec79",
                        "source_entry_id": "17965743-842d-3482-ad6b-ba76a930c570",
