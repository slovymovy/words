                        "examples": [
                            {
                                "example_id": "f7156c37-acc6-48ff-b0c1-ee8b985702d2",
                                "sense_id": "14137d87-2d34-3389-9474-1daf959ba424",
                                "text": "L’ovaire se forme de la manière que j’ai décrite dans mon mémoire sur les Ptéropodes ; la seule faute que j’ai commise à cet égard a été de prendre le rudiment de l’ovaire pour l’origine de la glande hermaphroditique tout entière."
                            },
                            {
                                "example_id": "c6d9efe7-8a37-42ef-ba49-86c4bd890a90",
                                "sense_id": "14137d87-2d34-3389-9474-1daf959ba424",
                                "text": "Enfin, pour énoncer que le quartier des bains appelé Salmakis, était le rendez-vous des hommes efféminés, des eunuques et des mignons, les voisins disaient malicieusement que ces bains rendaient efféminés et hermaphroditiques ceux qui les fréquentaient."
                            },
                            {
                                "example_id": "676b8527-a6db-4672-a2ac-6f54ac0f52c1",
                                "sense_id": "14137d87-2d34-3389-9474-1daf959ba424",
                                "text": "Ça fluctue dans les accords à cause des racines hermaphroditiques… c’est pas de la tarte !"
                            }
                        ]
                    }
