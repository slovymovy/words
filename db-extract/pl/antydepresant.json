                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2afd028-2569-404b-a934-6e47843ad22b",
                        "source_entry_id": "e319ae17-bea4-3d0e-a623-9e6812f59937",
                        "source_sense_id": "c436ee4d-8bce-3cff-ab8f-90f6bef2d5d3",
                        "target_lang_word": "AD",
                        "target_lang_code": "en",
