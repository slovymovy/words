                                        "sense_id": "f884ece8-3c29-3460-b79f-1646606b17bd",
                                        "entry_id": "0ba85156-a58f-3743-a0fc-63d21737ac4f",
                                        "glosses": [
                                            "Épouse d’un pâtissier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39ec18e6-5cb7-3ee5-b864-223dc6b7d23a",
                                        "entry_id": "0ba85156-a58f-3743-a0fc-63d21737ac4f",
                                        "glosses": [
                                            "Crème pâtissière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
