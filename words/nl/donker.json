            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55fe57e7-da8a-3972-bfb1-da2c17800d81",
                    "sense_definition": "met weinig of geen licht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichtsterkte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter wordt het al heel vroeg <w>donker</w> buiten.",
                            "target_lang_translations": {
                                "en": "In winter it already gets <w>dark</w> outside very early.",
                                "ru": "Зимой на улице становится <w>темно</w> уже очень рано."
                            }
                        },
                        {
                            "text": "Door de stroomuitval zitten we nu al anderhalve dag in een <w>donker</w> huis.",
                            "target_lang_translations": {
                                "en": "Due to the power outage, we have been sitting in a <w>dark</w> house for a day and a half now.",
                                "ru": "Из-за отключения электричества мы уже полтора дня сидим в <w>темном</w> доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "duister"
                    ],
                    "antonyms": [
                        "licht"
                    ],
                    "common_phrases": [
                        "donker worden",
                        "in het donker"
                    ],
                    "target_lang_definitions": {
                        "en": "with little or no light",
                        "ru": "с небольшим количеством света или без него"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dark",
                                "target_lang_sense_clarification": "lacking light"
                            },
                            {
