                                    },
                                    {
                                        "sense_id": "d189fcd4-61f5-3141-912d-7e551803a325",
                                        "entry_id": "c546993d-66b4-33bb-a9f5-3ef579164bae",
                                        "glosses": [
                                            "The distinguishing part of a toponym."
                                        ],
                                        "tags": [],
