                    },
                    {
                        "sense_id": "a4e022c5-9b62-3a51-b2aa-646c478c3224",
                        "entry_id": "15585a6e-974c-3c5b-b9ba-a7e9b0a995b7",
                        "glosses": [
                            "Goodly appearance or looks; beauty."
