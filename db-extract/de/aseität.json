                        "source_sense_id": "69c9c81c-40af-312c-8573-939937d67a23",
                        "source_sense_description": "Religion, Philosophie: das Aus-sich-selbst-Sein, absolute Unabhängigkeit",
                        "target_lang_word": "aseity",
