                "senses": [
                    {
                        "sense_id": "82332e3b-1b01-3e5a-aa41-492a9b7e2b73",
                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                        "glosses": [
                            "An animal, such as a dairy cow, kept for the milk it produces."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                        "glosses": [
                            "A person who milks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896caef7-85b4-4e3e-9ad2-68aa15129643",
                                "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                                "text": "The milker woke up at dawn each day to tend to the cows."
                            },
                            {
                                "example_id": "6f2bf010-dc2c-474d-b085-622ec8bada75",
                                "sense_id": "bbd446cf-65f4-3a57-861e-11c6eb9a0a44",
                                "text": "The snake milker massages the glands to extract the full measure of venom during each milking."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c65a5f-9c61-3b78-8c86-560acadd3eb5",
                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                        "glosses": [
                            "A milking machine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94eef611-9f88-46f8-806c-947af24e5832",
                                "sense_id": "13c65a5f-9c61-3b78-8c86-560acadd3eb5",
                                "text": "Many of those running small farms said the choice of a computerized milker came down to a bigger question: whether to upgrade or just give up. […] “It’s tough to find people to do it well and show up on time,” said Tim Kurtz, who installed four robotic milkers last year at his farm in Berks County, Pa. “And you don’t have to worry about that with a robot.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9899d597-a10e-3900-b28f-02928f63f7ac",
                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                        "glosses": [
                            "A conservative poker player who only raises the stakes on a good hand."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "582826cf-8d79-3351-9449-422b5f68501b",
                        "entry_id": "b4911ea9-6d59-3e10-bbef-fbd496e2543a",
                        "glosses": [
                            "A woman’s breast."
                        ],
                        "tags": [
                            "in-plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f1a2c89e-13ac-4167-95d8-7c5e41f3ffaf",
                                "sense_id": "582826cf-8d79-3351-9449-422b5f68501b",
                                "text": "In the San Diego Convention Center, hanging high above the makeshift alleyways of merchandise vendors, more than 40 pairs of anime-style breasts looked down upon me. I felt like a beetle at a cartoon Renaissance fair, staring at rows of mommy milkers peeking through manga bodices."
                            }
                        ]
                    }
                ],
