                    }
                ],
                "translations": [
                    {
                        "translation_id": "21be47f8-e60c-4e05-9ee8-1e1e082e775e",
                        "source_entry_id": "51a14a47-c00c-3d1a-8c90-1d05bac04690",
                        "source_sense_id": "44b26a3c-3367-3de6-8656-e887d57f0e6f",
                        "source_sense_description": "traditional Korean hat",
                        "target_lang_word": "кат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "55e966c8-99b4-31fb-8e7a-af7b70a3c3d5",
                                        "entry_id": "4cd4d37f-4ff4-3b40-b935-ee13b3c705fa",
                                        "glosses": [
                                            "устар. палач"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16893c97-1e5e-49a1-a576-f77e2366af21",
                                                "sense_id": "55e966c8-99b4-31fb-8e7a-af7b70a3c3d5",
                                                "text": "— Православные, в чём согрубил, // Всё простите, виновен не мало, // Кат за дело Степана казнит…"
                                            },
                                            {
                                                "example_id": "a8bfb22c-d0d4-492c-bb6a-0327c34e9af2",
                                                "sense_id": "55e966c8-99b4-31fb-8e7a-af7b70a3c3d5",
                                                "text": "Кат не кат, а ему брат."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e1b247-04db-33b4-8b4d-e36c643adfaf",
                                        "entry_id": "cccf7ed7-3b9f-3e29-8753-edcb57d7ed03",
                                        "glosses": [
                                            "ботан. вечнозелёный кустарник семейства бересклетовых, листья которого используются в качестве лёгкого наркотика-стимулятора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c22d8fc-82fa-4a30-9491-5480779183b8",
                                                "sense_id": "c7e1b247-04db-33b4-8b4d-e36c643adfaf",
                                                "text": "Полицейские считают, что все семеро осуществляли финансирование терроризма на средства, вырученные от продажи ката, который эти люди поставляли в США и Канаду. Кат — легкий наркотик, популярный у выходцев из Йемена, Сомали и Эфиопии. В Соединенных Штатах и Канаде он относится к запрещенным веществам."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db9682d7-d1ee-33de-a734-75742f8b5c39",
                                        "entry_id": "ba07acb8-8b2f-3391-a43e-6e5d0f91a7df",
                                        "glosses": [
                                            "морск. кран для подъёма якоря"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae46a44-cd13-4199-8ab7-6c6fc51bec52",
                                                "sense_id": "db9682d7-d1ee-33de-a734-75742f8b5c39",
                                                "text": "Во времена парусного флота всякие маневры, связанные с отдачей или уборкой якоря на корабль, требовали большой сноровки команды. Особенно трудно было взять якорь на кат на сильном волнении, когда судно уже двигалось, а якорь еще висел на канате у борта и, раскачиваясь, угрожал пробить лапой скулу корабля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb9f681-5124-3fe3-aedf-5e1447471bde",
                                        "entry_id": "ba07acb8-8b2f-3391-a43e-6e5d0f91a7df",
                                        "glosses": [
                                            "истор. род парусного мореходного судна"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e3c3c7-859c-355e-a42b-53afc003e2c5",
                                        "entry_id": "f2b0513e-edac-336f-b64d-21ab2335e246",
                                        "glosses": [
                                            "интернет. (обычно в сочетании с предлогом под) скрытая часть текста в блоге или на форуме, для просмотра которой необходимо выполнить какие-либо действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998cf024-5e74-4e02-9f09-f5d1b764f650",
                                                "sense_id": "a9e3c3c7-859c-355e-a42b-53afc003e2c5",
                                                "text": "В том месте, где вы пожелали сделать деление «под кат», появится небольшая кодовая метка."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f16a8d6f-14b9-3228-b984-f3e635411918",
                                        "entry_id": "9b1fb28b-145e-3154-ac6c-a917e0519b1b",
                                        "glosses": [
                                            "разг., сленг катамаран"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8899fa-e1fb-40f3-bcc9-37a84a56b010",
                                                "sense_id": "f16a8d6f-14b9-3228-b984-f3e635411918",
                                                "text": "Ребята планировали, что будут плыть только на спокойных участках, на сложных ― нести катамаран по берегу. Однако перед одним из таких мест спортсмены не успели причалить к берегу, и кат опять перевернулся."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "кат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba6f44a-b849-3d1a-9bb7-2487fe9317d0",
                                        "entry_id": "2a6da6e5-d3df-3679-a096-b8024a5d752b",
                                        "glosses": [
                                            "разг. прост. разовый перекат (перекатывание, перемещение) чего- или кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f36761-3b8a-4f6d-9798-89ed94d833a4",
                                                "sense_id": "3ba6f44a-b849-3d1a-9bb7-2487fe9317d0",
                                                "text": "Раз кат, два кат, три кат… — повторяла запыхавшаяся от усталости Катя, перекатывая огромный снежный ком для создания снежной бабы."
                                            },
                                            {
                                                "example_id": "02664b8f-f42d-4ccb-86cc-1e8c38177cfc",
                                                "sense_id": "3ba6f44a-b849-3d1a-9bb7-2487fe9317d0",
                                                "text": "Кат, кат — перекат!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
