                        "sense_id": "05e390b3-771e-3d80-abba-a602af7ec6cf",
                        "entry_id": "689a6de3-e5ba-3447-98b6-80a39a496d5e",
                        "glosses": [
                            "Personne originaire ou habitant l’Extrême-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21523e5-c81c-4c45-ba93-3a34fa5534ad",
                                "sense_id": "05e390b3-771e-3d80-abba-a602af7ec6cf",
                                "text": "[…] tandis qu’un Européen, pour enfiler une aiguille, pousse l’extrémité du fil vers le chas de l’aiguille, un Extrême-Oriental maintient son fil immobile et rapproche le chas du fil. La place d’honneur est à gauche et non à droite."
                            },
                            {
                                "example_id": "5c426c83-8b3d-4f7a-a6ea-a06946d76457",
                                "sense_id": "05e390b3-771e-3d80-abba-a602af7ec6cf",
                                "text": "Le colonel Boumediene est à l’image de l’armée. Taciturne comme elle. Son maigre et ascétique visage a les traits figés d’un Extrême-Oriental."
                            }
                        ]
                    }
