                "senses": [
                    {
                        "sense_id": "3959bda1-8e98-3c08-bbeb-e7f449484f92",
                        "entry_id": "1a52cf49-43e8-3209-a0ee-f06c1935ebc2",
                        "glosses": [
                            "südlicher Teil Chinas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea008102-8e9c-4617-8bd3-876c484e5643",
                                "sense_id": "3959bda1-8e98-3c08-bbeb-e7f449484f92",
                                "text": "„Und in der Mitte, umhüllt von der üblichen diesigen Luft Südchinas, erhob sich ein riesiger zentraler Berg, der bis in den Himmel zu reichen schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58c152f2-03b2-41b1-9be9-f3ea692e9333",
                        "source_entry_id": "1a52cf49-43e8-3209-a0ee-f06c1935ebc2",
                        "source_sense_id": "3959bda1-8e98-3c08-bbeb-e7f449484f92",
                        "source_sense_description": "südlicher Teil Chinas",
                        "target_lang_word": "South China",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "South China",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca43748-ffc3-3e67-94e9-caed6f320d87",
                                        "entry_id": "64e5c4bd-c586-31e2-8969-c7d91e377719",
                                        "glosses": [
                                            "Southern China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98498ac5-252c-46a9-9dc1-b94607974017",
                                                "sense_id": "6ca43748-ffc3-3e67-94e9-caed6f320d87",
                                                "text": "DAIREN, South Manchuria, Oct. 12. -- South China with its Communists, the Yangtse Valley with rampant anti-foreignism and incessant civil warfare and Peking with Marshal Chang Tso-lin attempting to consolidate his dictatorship and found a stable central Government -- these seem to be the major constituents of the Chinese problem until one visits Manchuria."
                                            },
                                            {
                                                "example_id": "6f47d8ea-b842-4aec-8ace-3c17d3c599f7",
                                                "sense_id": "6ca43748-ffc3-3e67-94e9-caed6f320d87",
                                                "text": "Confronted with the challenge of economic restructuring in the context of the noninterventionist policy of the Hong Kong government, local manufacturers had amore limited ability to pursue technological upgrading than their counterparts in Taiwan, South Korea, and Singapore had. Their survival strategy was to take advantage of the new availability of the massive supply of cheap labor and cheap industrial land in South China."
                                            },
                                            {
                                                "example_id": "19a3392c-d720-46b4-b46b-f06d226a7c7a",
                                                "sense_id": "6ca43748-ffc3-3e67-94e9-caed6f320d87",
                                                "text": "The seasonal change of the winds, in the Asian monsoon system, drove long distance mobility on the south China coast."
                                            },
                                            {
                                                "example_id": "64883c33-1255-4efd-9b1c-7a9285f5034e",
                                                "sense_id": "6ca43748-ffc3-3e67-94e9-caed6f320d87",
                                                "text": "As they spent much time in prayer for the nearly eight million people of Kwangsi, South China, God began calling some of them to that field of service so that within the next five years seventeen from the same class were serving in South China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3752a4f-ee0c-37d5-9e87-de2e166d404a",
                                        "entry_id": "64e5c4bd-c586-31e2-8969-c7d91e377719",
                                        "glosses": [
                                            "A village in China, Kennebec, Maine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e20eaf-c29b-4acd-b25f-dc582ad407bf",
                                                "sense_id": "f3752a4f-ee0c-37d5-9e87-de2e166d404a",
                                                "text": "Helga Cotta, 57, from South China, Maine, said: “Hunting season is like my vacation. It’s so solitary, you can leave all your problems at home and just go out and watch the woods come alive around you in the morning.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15dd2e8e-aa73-4db1-bf19-063bae855a5e",
                        "source_entry_id": "1a52cf49-43e8-3209-a0ee-f06c1935ebc2",
                        "source_sense_id": "3959bda1-8e98-3c08-bbeb-e7f449484f92",
                        "source_sense_description": "südlicher Teil Chinas",
                        "target_lang_word": "Chine du Sud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chine du Sud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de24eca6-9a86-3d06-97db-b45262c454b1",
                                        "entry_id": "5188d359-fe44-3f56-adc8-fb12f3637226",
                                        "glosses": [
                                            "Moitié sud de la Chine propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974d46c6-95f6-47ab-ad2d-7d850bb8f1b1",
                                                "sense_id": "de24eca6-9a86-3d06-97db-b45262c454b1",
                                                "text": "Le monde chinois est très divers : de violents contrastes opposent la Chine du Nord et la Chine du Sud, l’Extrême-Orient chinois et l’Asie centrale chinoise.\nAu XIIIᵉ siècle, Marco Polo opposait déjà Cathay ou Chine du Nord, et Manji ou Chine du Sud. De part et d’autres^([sic]) des Monts Tsin-Ling, ces deux Chines diffèrent par leurs structures, leurs climats, leurs sols, leurs paysages ruraux et urbains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
