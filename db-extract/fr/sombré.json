                        "glosses": [
                            "Participe passé masculin singulier du verbe sombrer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d5bd8065-da5e-41c7-915f-1e1e34512c10",
                                "sense_id": "8b86de52-1034-342d-a3bd-696ad271c384",
                                "text": "Maintenant, il ne distinguait plus rien de la chambre, noyée de nuit, où tout avait sombré, le poêle, les meubles, les murs ; et il fallait qu’il se tournât, pour retrouver les deux carrés pâles des fenêtres, immobiles, d’une légèreté de rêve."
                            }
                        ]
                    }
