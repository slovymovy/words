                "senses": [
                    {
                        "sense_id": "d57feced-0e73-3828-b9d8-5928e8025c71",
                        "entry_id": "bdd971a2-d0aa-3412-9f39-dd2d91dcad0f",
                        "glosses": [
                            "Person, die für einen besonderen Zweck als Ermittler tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e852afe6-712b-49e4-b06b-a4e766ad4b4f",
                                "sense_id": "d57feced-0e73-3828-b9d8-5928e8025c71",
                                "text": "„Die Trump Organization erklärte auf Anfrage der Nachrichtenagentur AFP, man kooperiere von jeher mit dem Sonderermittler und antworte auf dessen ‚Anfragen‘.“"
                            },
                            {
                                "example_id": "3a103b7a-9f40-4a4f-8e3e-c047abf56da1",
                                "sense_id": "d57feced-0e73-3828-b9d8-5928e8025c71",
                                "text": "„Im Februar hatte der Sonderermittler 13 andere russische Staatsbürger wegen Desinformationskampagnen im Internet anklagen lassen.“"
                            },
                            {
                                "example_id": "67798d88-098b-44c1-a715-e9a8863de929",
                                "sense_id": "d57feced-0e73-3828-b9d8-5928e8025c71",
                                "text": "„Trump machte deutlich, dass er die Berufung von Sonderermittler Robert Mueller für verfassungswidrig hält.“"
                            },
                            {
                                "example_id": "58be77a5-9aaf-426d-bd18-39fee6f8fcb9",
                                "sense_id": "d57feced-0e73-3828-b9d8-5928e8025c71",
                                "text": "„Trump kann den Sonderermittler gemäss geltenden Verordnungen nicht einfach mit einem Federstrich entmachten, so wie er es mit Comey oder kürzlich mit seinem Aussenminister Rex Tillerson gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
