                        "glosses": [
                            "анат., зоол. последний (4-й) отдел сложного желудка жвачных, соответствующий простому однокамерному желудку большинства млекопитающих"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a89c24ac-5bfc-30ae-a7bc-873b138476ad",
