{
    "word_family": [
        "superficiality",
        "superficially",
        "superficialness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "939b1aff-736c-3f08-95f3-36324930e55d",
                    "sense_definition": "Located on or near the surface of the body or an object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor treated the <w>superficial</w> wound on his arm.",
                            "target_lang_translations": {
                                "tr": "Doktor, kolundaki <w>yüzeysel</w> yarayı tedavi etti.",
                                "zh": "医生处理了他手臂上那处<w>浅层</w>伤口。"
                            }
                        },
                        {
                            "text": "The <w>superficial</w> muscles are located just beneath the skin.",
                            "target_lang_translations": {
                                "tr": "<w>Yüzeysel</w> kaslar derinin hemen altında bulunur.",
                                "zh": "<w>表面</w>肌肉位于皮肤下方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "external",
                        "surficial"
                    ],
                    "antonyms": [
                        "deep"
                    ],
                    "common_phrases": [
                        "superficial wound",
                        "superficial layer"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vücudun veya bir nesnenin yüzeyinde veya yüzeyine yakın bir yerde bulunan.",
                        "zh": "位于身体或物体表面或其附近。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yüzeysel",
                                "target_lang_sense_clarification": "Fiziksel olarak yüzeyde bulunan veya yüzeyle ilgili olan."
                            },
                            {
                                "target_lang_word": "sathî",
                                "target_lang_sense_clarification": "Yüzeyle ilgili, derin olmayan (eski kullanım)."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表面的",
                                "target_lang_sense_clarification": "指物理位置在最外层。"
                            },
                            {
                                "target_lang_word": "浅层的",
                                "target_lang_sense_clarification": "指深度较浅，靠近表面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c19be907-fd12-3ccc-9939-2a9e7e40c352",
                    "sense_definition": "Lacking depth of character, understanding, or substance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>superficial</w> comment that ignored the real problem.",
                            "target_lang_translations": {
                                "tr": "Gerçek sorunu görmezden gelen <w>yüzeysel</w> bir yorum yaptı.",
                                "zh": "他发表了一番<w>肤浅</w>的评论，完全忽略了真正的问题。"
                            }
                        },
                        {
                            "text": "Their <w>superficial</w> relationship ended when they faced a real challenge.",
                            "target_lang_translations": {
                                "tr": "Gerçek bir zorlukla karşılaştıklarında <w>yüzeysel</w> ilişkileri sona erdi.",
                                "zh": "当面临真正的挑战时，他们那段<w>浅薄</w>的关系就结束了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shallow",
                        "glib",
                        "facile",
                        "skin-deep"
                    ],
                    "antonyms": [
                        "thorough",
                        "substantive"
                    ],
                    "common_phrases": [
                        "superficial charm",
                        "superficial analysis"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karakter, anlayış veya öz derinliğinden yoksun olan.",
                        "zh": "缺乏深度、理解力或实质内容。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yüzeysel",
                                "target_lang_sense_clarification": "Derinliği olmayan, sığ, özden yoksun."
                            },
                            {
                                "target_lang_word": "sığ",
                                "target_lang_sense_clarification": "Düşünce veya karakter açısından derinliği olmayan."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肤浅的",
                                "target_lang_sense_clarification": "指思想、见解或性格不够深刻。"
                            },
                            {
                                "target_lang_word": "浅薄的",
                                "target_lang_sense_clarification": "指学识或修养不够深厚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7d03ab0-504d-3165-95a6-d4508e91f0f0",
                    "sense_definition": "Not thorough or complete; concerned only with the obvious.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report provided only a <w>superficial</w> overview of the complex situation.",
                            "target_lang_translations": {
                                "tr": "Rapor, karmaşık durumun sadece <w>üstünkörü</w> bir özetini sundu.",
                                "zh": "这份报告对复杂局势只提供了<w>草率</w>的概述。"
                            }
                        },
                        {
                            "text": "A <w>superficial</w> reading of the text will not reveal its hidden meaning.",
                            "target_lang_translations": {
                                "tr": "Metnin <w>üstünkörü</w> bir okuması, gizli anlamını ortaya çıkarmayacaktır.",
                                "zh": "对文本进行<w>走马观花</w>式的阅读是无法揭示其深层含义的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cursory",
                        "surface-level"
                    ],
                    "antonyms": [
                        "in-depth",
                        "thorough"
                    ],
                    "common_phrases": [
                        "superficial examination",
                        "superficial knowledge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kapsamlı veya tam olmayan; sadece bariz olanla ilgilenen.",
                        "zh": "不彻底或不完整；只关注表面现象。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "üstünkörü",
                                "target_lang_sense_clarification": "İnceliklerine inmeden, özen göstermeden, baştan savma yapılan."
                            },
                            {
                                "target_lang_word": "yüzeysel",
                                "target_lang_sense_clarification": "Ayrıntılı olmayan, derinlemesine incelenmemiş."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草率的",
                                "target_lang_sense_clarification": "指做事不认真，不深入。"
                            },
                            {
                                "target_lang_word": "走马观花的",
                                "target_lang_sense_clarification": "形容观察事物不深入，只看表面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f323cc-d44d-388b-bba7-c0f2d61532b3",
                    "sense_definition": "Relating to the area of a surface rather than its volume or length.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>superficial</w> area of the room was measured in square feet.",
                            "target_lang_translations": {
                                "tr": "Odanın <w>yüzey</w> alanı fit kare cinsinden ölçüldü.",
                                "zh": "房间的<w>表面</w>积是以平方英尺来测量的。"
                            }
                        },
                        {
                            "text": "Engineers calculated the <w>superficial</w> dimensions of the metal sheet.",
                            "target_lang_translations": {
                                "tr": "Mühendisler metal levhanın <w>yüzey</w> boyutlarını hesapladılar.",
                                "zh": "工程师计算了金属板的<w>表面</w>尺寸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "square"
                    ],
                    "common_phrases": [
                        "superficial area"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hacim veya uzunluktan ziyade bir yüzeyin alanı ile ilgili olan.",
                        "zh": "与面积有关，而非体积或长度。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yüzey",
                                "target_lang_sense_clarification": "Matematiksel veya geometrik olarak yüzey alanı ile ilgili."
                            },
                            {
                                "target_lang_word": "sathî",
                                "target_lang_sense_clarification": "Yüzey ölçümü ile ilgili teknik bağlamda."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表面的",
                                "target_lang_sense_clarification": "指几何学或物理学中与面积相关的属性。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50210f11-4f31-3f7c-a4c4-578a36672b96",
                    "sense_definition": "A detail that is on the surface and lacks importance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lack_of_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He focuses too much on <w>superficials</w> instead of the core issues.",
                            "target_lang_translations": {
                                "tr": "Temel sorunlar yerine çok fazla <w>yüzeysel</w> detaylara odaklanıyor.",
                                "zh": "他太关注<w>表面文章</w>，而不去解决核心问题。"
                            }
                        },
                        {
                            "text": "The design changes were mere <w>superficials</w> that did not improve functionality.",
                            "target_lang_translations": {
                                "tr": "Tasarım değişiklikleri, işlevselliği artırmayan sadece <w>yüzeysel</w> dokunuşlardı.",
                                "zh": "这些设计改动仅仅是一些<w>皮毛</w>，并没有改善功能。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüzeyde kalan ve önem taşımayan detay.",
                        "zh": "停留在表面且缺乏重要性的细节。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yüzeysel detaylar",
                                "target_lang_sense_clarification": "Önemsiz, derinliği olmayan ayrıntılar."
                            },
                            {
                                "target_lang_word": "sathi şeyler",
                                "target_lang_sense_clarification": "Özden yoksun, sadece dış görünüşle ilgili unsurlar."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表面文章",
                                "target_lang_sense_clarification": "指只做表面功夫，不解决实质问题。"
                            },
                            {
                                "target_lang_word": "皮毛",
                                "target_lang_sense_clarification": "指事物的表面或不重要的部分。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}