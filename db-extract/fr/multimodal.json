                                                "sense_id": "d74f6d07-c058-3f91-b144-e3b1868db17b",
                                                "text": "multimodal transport"
                                            },
                                            {
                                                "example_id": "dad34e09-10cb-45fb-a3a6-035ca1e08a47",
                                                "sense_id": "d74f6d07-c058-3f91-b144-e3b1868db17b",
                                                "text": "multimodal AI models"
                                            },
                                            {
                                                "example_id": "6e167c9c-8d92-479f-8d76-a695b19311d8",
                                                "sense_id": "d74f6d07-c058-3f91-b144-e3b1868db17b",
                                                "text": "The push for multimodal models is not entirely new; Google, Facebook, and others introduced automated image-captioning systems nearly a decade ago."
                                            },
                                            {
                                                "example_id": "143e83ad-82d4-4923-a3a0-4a673063a1e2",
                                                "sense_id": "d74f6d07-c058-3f91-b144-e3b1868db17b",
                                                "text": "Over the course of the five-year partnership, Hitachi will deliver a multimodal digital booking system that will include all modes of public transport."
                                            }
                                        ]
                                    }
                                ]
