                "senses": [
                    {
                        "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                        "entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                        "glosses": [
                            "przyrząd do ustalania tempa utworu muzycznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de3444f-e29f-46a0-a6b1-2828d071586e",
                                "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                                "text": "Często wydaje mi się, że metronom zaczyna przyspieszać w częściach utworu, których nie umiem."
                            },
                            {
                                "example_id": "6ba1c218-91df-4efc-83c6-f001890bbeae",
                                "sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                                "text": "Oprócz klasycznych metronomów z wahadłem produkowane są także elektroniczne. Pierwsze z nich trzeba od czasu do czasu nakręcać, do drugich potrzeba tylko baterii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da3332b8-91b6-4c7d-bc57-92e52a7553b7",
                        "source_entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                        "source_sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                        "target_lang_word": "metronome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metronome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0cc22d-d059-3209-b616-1d5a9f12294d",
                                        "entry_id": "7ec8d223-95c8-3d4e-82eb-79e2a8876b73",
                                        "glosses": [
                                            "A device, containing an inverted pendulum, used to mark time by means of regular ticks at adjustable intervals; an electronic equivalent that emits flashes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11dab9f-9b4a-4867-b133-a343e924be55",
                                                "sense_id": "ea0cc22d-d059-3209-b616-1d5a9f12294d",
                                                "text": "The etudes with metronome markings should be played in tempo, all others should be considered rubato."
                                            },
                                            {
                                                "example_id": "ddbf324d-07dd-42dc-9bd9-598213bf3798",
                                                "sense_id": "ea0cc22d-d059-3209-b616-1d5a9f12294d",
                                                "text": "It’s one of the earliest pieces in the comprehensive collection of metronomes by the British instrument dealer Tony Bingham, which forms the bulk of the Basel exhibition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae7d1597-bd02-41bb-8523-e4cdbe0f7fd8",
                        "source_entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                        "source_sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                        "target_lang_word": "métronome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métronome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                        "entry_id": "8be17a7e-cb4a-38cf-81eb-0fa2de70300f",
                                        "glosses": [
                                            "Instrument d’horlogerie qui sert à battre la mesure."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8794223c-c708-4a14-8cdb-d8ba88e694ac",
                                                "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                                "text": "Sur les hauteurs dominant le fleuve, un métronome géant battait la mesure où s'élevait encore, quelques années auparavant, une statue déboulonnable à l'effigie du petit père des peuples."
                                            },
                                            {
                                                "example_id": "44d2149f-838e-4587-b60c-43cd7e8f6744",
                                                "sense_id": "06a7191b-4988-31f5-a33d-71c5bcb36473",
                                                "text": "Il entendit les grognements d’une bête furieuse. Réguliers. Affreux métronome fracassant le silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ad709a1-1c5f-4292-92ed-79d290d5f668",
                        "source_entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                        "source_sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                        "target_lang_word": "metrónomo",
