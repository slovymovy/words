                        ],
                        "form": "die Idealstadt"
                    },
                    {
                        "form_id": "2429fd04-f68e-4d74-b8b0-ccd58e88ed7a",
                        "entry_id": "c4271d8a-9ee7-39ea-a382-88966dd72410",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Idealstädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                        "entry_id": "c4271d8a-9ee7-39ea-a382-88966dd72410",
                        "glosses": [
                            "(häufig utopische) Vorstellung, Konzept einer wirtschaftlich, gesellschaftlich, politisch sowie ästhetisch optimalen Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515fc6da-989f-49ad-aac8-bb1247dc3db5",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Die Stadt geht auf in ihrer eigenen großräumigen Peripherie – und eignet sich gerade dadurch als Idealstadt westdeutscher Wohlhabenheit, als Villengroßstadt der gar nicht so mageren Schicht der Wohlstandsgewinnler.“"
                            },
                            {
                                "example_id": "896825b4-c8d9-4192-8466-d1e65cfa1c49",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Er hat sich von Paris zurückgezogen, um fern von demselben eine Idealstadt zu gründen.“"
                            },
                            {
                                "example_id": "939dc10e-ea00-4768-8e3f-905a65ad7edf",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Beim Aufbau dieser ‚Idealstadt‘ ist der in Berliner und Hamburger Statistiken niedergelegte umfassende Stoff gründlich verarbeitet.“"
                            },
                            {
                                "example_id": "4d0aa8ce-2051-4e6b-9360-e3e409018082",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Innerhalb des Films ‚The Truman Show‘ wird anlässlich der gleichnamigen Reality-TV-Show eine Idealstadt im Stil der fünfziger Jahre in einem riesigen Filmstudio erschaffen.“"
                            },
                            {
                                "example_id": "7cdc82e9-8221-422b-9267-5976b8f1b653",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Filarete stellte seine Idealstadt ›Sforzinda‹ im Rahmen eines utopischen Romans vor.“"
                            },
                            {
                                "example_id": "4ca7e9f9-711f-4431-bacb-a9e026ce5b1e",
                                "sense_id": "41cf4c71-b635-3579-b0b3-781bebef5c2a",
                                "text": "„Das Himmlische Jerusalem In der Bibel entwirft die Offenbarung des Johannes Jerusalem als Idealstadt Gottes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "477a2921-54ce-470c-a9bf-4f5a5161ca41",
                        "source_entry_id": "c4271d8a-9ee7-39ea-a382-88966dd72410",
