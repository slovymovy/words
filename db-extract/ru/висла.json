                "translations": [
                    {
                        "translation_id": "fb1bc4e4-c7fb-4f2b-aaee-22d831e718d5",
                        "source_entry_id": "02a34443-7f00-3523-ade2-b62096f0fe57",
                        "source_sense_id": "e4edac05-a507-3bba-8aa9-b222be9b32da",
                        "target_lang_word": "Weichsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weichsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                        "entry_id": "57013101-e497-35b6-879f-42963221d469",
                                        "glosses": [
                                            "Sauerkirsche (Prunus cerasus)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293d1d5d-6a02-4569-aac9-10cd0d780307",
                                                "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                                "text": "Das ist eine Weichsel, keine Süßkirsche."
                                            },
                                            {
                                                "example_id": "509a810e-723f-4e54-8522-0fc14c7cde06",
                                                "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                                "text": "Sauerkirsche (Weichsel). Die Früchte sind 10-25 mm groß, nierenförmig, flachrund oder länglich. Eine Unterteilung erfolgt in echte Sauerkirschen (Schattenmorellen, Strauchweichsel), Amarellen (Kreuzung aus Süß- und Sauerkirsche wie Glaskirschen und Baumweichsel) und dunklere Morellen (Süßweichsel)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weichsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                        "entry_id": "75f4cbf5-dc2c-39e5-948d-276548fb9850",
                                        "glosses": [
                                            "osteuropäischer Fluss, Strom in Polen, der in die Ostsee mündet; deutsche Bezeichnung der Wisła"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ec6b7d-6788-46fa-995f-071c2dab8390",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Das ist die Weichsel."
                                            },
                                            {
                                                "example_id": "6cf1cb6f-b091-4ad4-a122-585502f1c42f",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Seit Ende August biwakierten ihre Truppen an der Weichsel, aber es bestand kein Zweifel daran, dass sie dort nicht stehen bleiben würden.“"
                                            },
                                            {
                                                "example_id": "49dba8b3-6434-444c-acc3-56452c3f5443",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Die Weichsel wollte ich schon immer mal befahren.“"
                                            },
                                            {
                                                "example_id": "b8d9b838-8a3d-4c8b-a969-ea4d8a8b5436",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Wir überquerten die Weichsel."
                                            },
                                            {
                                                "example_id": "85a59367-55f9-419f-a54d-c59d9afd773a",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Die Kinder versuchten, in der Weichsel zu baden."
                                            },
                                            {
                                                "example_id": "68899824-1949-4d75-b0db-a45b17036ee3",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Die Hochzeitsreise ist eine Floßfahrt auf der Weichsel.“"
                                            },
                                            {
                                                "example_id": "3e4cede4-652d-4e6b-864b-87ff9d733475",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Wo der Treck über die Weichsel kam, erwähnt Else nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
