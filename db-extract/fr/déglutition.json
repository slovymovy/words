                ],
                "senses": [
                    {
                        "sense_id": "7097dd1d-36c0-31f6-a3e2-1003fcdcd6c1",
                        "entry_id": "b687bef6-40f0-3c79-93bc-51b91dd97aa9",
                        "glosses": [
                            "Action d’avaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4569c7ab-7f5e-4290-8e62-e722ddb8f7ed",
                                "sense_id": "7097dd1d-36c0-31f6-a3e2-1003fcdcd6c1",
                                "text": "Point de mastication vraie, puisqu'il manque de dents, ni d'insalivation, puisqu'il manque de glandes salivaires. La déglutition ne s'opère que paupières jointes et bouche close."
                            },
                            {
                                "example_id": "ff947bd2-832c-46ef-bfd6-2923612cd609",
                                "sense_id": "7097dd1d-36c0-31f6-a3e2-1003fcdcd6c1",
                                "text": "Pour empêcher cette déglutition imprudente, on a substitué aux fèves des petits bébés en porcelaine moins avalables, mais fort désagréables pour les dents !"
                            },
                            {
                                "example_id": "027dc837-d8e5-4080-90cb-a090d39ae42c",
                                "sense_id": "7097dd1d-36c0-31f6-a3e2-1003fcdcd6c1",
                                "text": "À un certain point, on peut même voir le groupe de plongeurs face à la bête, qui tentent tant bien que mal de récupérer l’appareil pendant que le requin semble poursuivre sa déglutition."
                            }
                        ]
                    }
                ],
