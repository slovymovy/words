                                            {
                                                "example_id": "63426048-ec6a-45e3-a225-a21c139a5ffd",
                                                "sense_id": "6735616b-aefa-3c01-8921-2371ab51eb9e",
                                                "text": "Un Ancien insinue, aujourd'hui, que les fournitures en bon uniforme de drap ne furent pas étrangères au succès du scoutisme à l'abbaye ! 1"
                                            },
                                            {
                                                "example_id": "3ac0f3c4-91c8-4a74-abce-093deac84300",
                                                "sense_id": "6735616b-aefa-3c01-8921-2371ab51eb9e",
                                                "text": "Mmm... ça ressemble bien à un message. Mais ça fait des siècles que je n'ai pas transcrit un message en morse. Pour ne rien vous cacher, ça date de mes années de scoutisme."
                                            },
                                            {
                                                "example_id": "1bb4d64e-91b0-49b8-85fa-6a80cc95ea03",
                                                "sense_id": "6735616b-aefa-3c01-8921-2371ab51eb9e",
                                                "text": "Surtout, ils se sont tous rencontrés dans le cadre du scoutisme traditionnel catholique, instance de socialisation dont la mention revient dans l’ensemble de leurs discours."
                                            }
                                        ]
