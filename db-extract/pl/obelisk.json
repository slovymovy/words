                    {
                        "translation_id": "95274833-9d3a-4a6e-b131-85b0e8c0585b",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "obelisk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3e8b7b-8266-30fe-bee3-1856cf3a3120",
                                        "entry_id": "ab929262-8770-3da0-8c09-7200f79e1190",
                                        "glosses": [
                                            "een stenen, vaak granieten, gedenknaald zoals deze eertijds in het Oude Egypte opgericht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64a6957-abba-42bd-8347-0548526c3fec",
                                                "sense_id": "ad3e8b7b-8266-30fe-bee3-1856cf3a3120",
                                                "text": "Er zijn obelisken verplaatst naar Rome en Constantinopel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50717c40-e31f-4b1b-9f8a-f2ed1ad161a2",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "Obelisk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obelisk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                        "entry_id": "3cc3cdb8-300b-3fe1-aca6-2c14a747f4f2",
                                        "glosses": [
                                            "rechteckiger Steinpfeiler mit aufgesetzter pyramidenförmiger Spitze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c81f13-535e-4273-a01d-890551430bd6",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "Der Obelisk von Luxor war ein Geschenk ägyptischen Königs Muhammad Ali Pascha an den französischen König Louis Philippe."
                                            },
                                            {
                                                "example_id": "2aa535f2-d964-4774-984b-cee8448d5cc1",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "Der Name des Steinmetzes Obelix wird gewöhnlich als Wortspiel mit dem französischen Wort obélisque (Obelisk) angesehen."
                                            },
                                            {
                                                "example_id": "4de31c97-8fbf-4b8b-85d2-50e8918cd4c1",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Eine griechische Inschrift, die man auf einem Sockel in der Nähe des Obelisken gefunden hatte, legte die Vermutung nahe, der Obelisk sei im Namen von Ptolemaios und Kleopatra geweiht gewesen.“"
                                            },
                                            {
                                                "example_id": "0306e91f-01eb-4e72-90db-3f8ca8fc7258",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Er stellt in zierlichen Bildern die ägyptischen Obelisken dar, die Papst Sixtus V. zu Rom mit großen Kosten hatte aufrichten lassen.“"
                                            },
                                            {
                                                "example_id": "0c0c58d1-f695-4fa8-82ab-97bb4e6085a7",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„In Erwartung von etwas Russisch-Orthodoxem, von etwas Üppigem mit Kreuzen und Gold fährt man hinunter, und dann findet man nur Obelisken mit einem roten Stern auf der Spitze.“"
                                            },
                                            {
                                                "example_id": "bd981ce4-d0db-49eb-b8cf-87d71a6cf632",
                                                "sense_id": "58f679a4-ad34-3e8b-ad7c-66a518d5230e",
                                                "text": "„Was sie suchte, befand sich im Hinterhof. Ein kleiner Obelisk aus schwarzem Granit, ein Säulenschaft, der etwa vier Fuß hoch war und sich auf einem großen, soliden Sockel erhob, auf dem die Inschrift angebracht werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3eda2cd1-eab7-4aa0-83bd-9c467fcfe613",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "обелиск",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обелиск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4670d697-1363-3376-b573-8bc8f5654ea1",
                                        "entry_id": "939275bf-2d2b-3e94-95e5-60d1f08eea8b",
                                        "glosses": [
                                            "памятник, каменное сооружение в виде столба (наиболее часто четырёхгранного), сужающегося кверху"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309d2e0a-6657-49df-a64f-c2d1ad53d0b7",
                                                "sense_id": "4670d697-1363-3376-b573-8bc8f5654ea1",
                                                "text": "Огромные иглы обелисков по пятьдесят локтей высоты, одетые листами ярко-жёлтого азема — сплава золота и серебра, горели как раскалённые, пронизывая жёсткую тёмную листву пальм."
                                            },
                                            {
                                                "example_id": "f7f9fcfc-79df-4014-ab71-51699a261a06",
                                                "sense_id": "4670d697-1363-3376-b573-8bc8f5654ea1",
                                                "text": "Прожектора больше не метались по кустам, они замерли, скрестившись на том самом мраморном обелиске, и в ярком голубом тумане Рэдрик отчётливо увидел согнутую фигуру, бредущую среди крестов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
