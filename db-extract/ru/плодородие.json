                                    {
                                        "sense_id": "063369d8-8c54-39bc-85b4-a3d6f003d88e",
                                        "entry_id": "24075a3a-89d8-3925-8e02-d1c1291dddde",
                                        "glosses": [
                                            "The condition, or the degree, of being fertile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8bfb25b-c150-4efe-a5fb-a30d720d1e97",
                                                "sense_id": "063369d8-8c54-39bc-85b4-a3d6f003d88e",
                                                "text": "Muckspreading increases the fertility of the soil."
                                            },
                                            {
                                                "example_id": "59fee9a3-386b-4836-a1af-3ba158e3c116",
                                                "sense_id": "063369d8-8c54-39bc-85b4-a3d6f003d88e",
                                                "text": "Men may also have fertility challenges, especially if their hypogonadism was caused by anabolic steroid use. Anabolic steroids can affect testicular health, including reducing the production of sperm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a361487-6bb7-3f86-a583-ecc73904fe79",
                                        "entry_id": "24075a3a-89d8-3925-8e02-d1c1291dddde",
                                        "glosses": [
                                            "The birthrate of a population; the number of live births per 1000 people per year."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "640f424e-30bd-30fc-b89c-81dafa1f02a1",
                                        "entry_id": "24075a3a-89d8-3925-8e02-d1c1291dddde",
                                        "glosses": [
                                            "The average number of births per woman within a population."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
