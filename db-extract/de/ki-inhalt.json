                "senses": [
                    {
                        "sense_id": "f2ec89a9-3a4c-34a4-b434-6372339a4da1",
                        "entry_id": "426bd114-f845-3ccf-a6a0-6f435ea797ab",
                        "glosses": [
                            "von einer künstlichen Intelligenz erzeugter Inhalt (Text, Bild oder dergleichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20249331-8a6b-4fd4-9616-a099a63c6ad1",
                                "sense_id": "f2ec89a9-3a4c-34a4-b434-6372339a4da1",
                                "text": "„Vor allem in den USA, wo am 5. November unter anderen die Präsidentschaftswahl stattfindet, gibt es schon reichlich Erfahrungen mit manipulativen KI-Inhalten im laufenden Wahlkampf.“"
                            },
                            {
                                "example_id": "ee8862c4-af85-490d-a686-0417c2aa6343",
                                "sense_id": "f2ec89a9-3a4c-34a4-b434-6372339a4da1",
                                "text": "„Die oben aufgeführten Ansätze zur Erkennung von KI-Inhalten bergen einige technische Herausforderungen.“"
                            },
                            {
                                "example_id": "0bdaa729-68b0-40ce-a284-63dfad821542",
                                "sense_id": "f2ec89a9-3a4c-34a4-b434-6372339a4da1",
                                "text": "„Es ist wohl nur eine Frage der Zeit, bis die Kennzeichnung von KI-Inhalten allgemein gesetzlich verpflichtend wird.“"
                            },
                            {
                                "example_id": "cad6de4c-3af1-419b-9770-8d8c965bc456",
                                "sense_id": "f2ec89a9-3a4c-34a4-b434-6372339a4da1",
                                "text": "„Wenn der generative KI-Inhalt nicht auf einer realen Person basiert, aber visuell einer Person ähnelt, musst du im Portal für Mitwirkende auf das Feld „Personen und Eigentum sind fiktiv“ klicken, um zu bestätigen, dass die Personen und/oder das Eigentum fiktiv sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
