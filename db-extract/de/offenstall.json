                ],
                "senses": [
                    {
                        "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                        "entry_id": "67c0fba2-9a19-3775-8863-8584c1f374c3",
                        "glosses": [
                            "Gebäude (meist eines landwirtschaftlichen Betriebs), das der Unterbringung von Tieren (beispielsweise Rindern, Pferden) dient und bei dem eine Wand oder auch mehrere Wände fehlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c671206-bc9c-43c5-9e59-c74812ab7cb5",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Die 22jährige baut mit ihrem Vater einen Pferdehof auf. Ihr Konzept des Offenstalls ist beliebt.“"
                            },
                            {
                                "example_id": "fc562c67-995d-43a3-955c-e58b72af85a8",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Paint Horses können ganzjährig im Offenstall auf der Weide robust gehalten werden.“"
                            },
                            {
                                "example_id": "efd101d5-e2fe-4ada-b417-a8c346a89a42",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Freizeitreiter“ […] „halten ihre Pferde häufig im Offenstall“ […]."
                            },
                            {
                                "example_id": "312763bb-d454-48d7-9ad2-f8fd9f1afd3e",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Andreas Freise und Familie halten sieben Alpakas im Offenstall.“"
                            },
                            {
                                "example_id": "8c5de9eb-ab0b-4fb8-8e3b-b688b34df62e",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„In Wolfgang Groths Offenstall wuseln Dutzende Schweine durchs Stroh.“"
                            },
                            {
                                "example_id": "9970d42d-10da-4c4b-872f-250cdc298efa",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Eine neue Initiative aus Osnabrück will die Haltung der Tiere verbessern – und wirbt für sogenannte Offenställe.“"
                            },
                            {
                                "example_id": "d8172810-5cbf-49cd-bcaf-da6149f5dceb",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Bisher werden“ […] „rund drei Prozent der 27 Millionen Schweine in Offenställen gehalten.“"
                            },
                            {
                                "example_id": "2aee7db5-9b9d-4ccc-a81f-776388b2c279",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "[Edmund Haferbeck von Peta:] „»Offenställe sind eine Nischenhaltung im Promillebereich«“"
                            },
                            {
                                "example_id": "be6fcac8-19f0-40e5-b0b6-a48caae7ffd6",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "[Hähnchenmast:] „In den USA sind Offenställe verbreitet, die keinen befestigten Boden haben und deren Seiten nur durch automatisch geregelte Jalousien begrenzt sind.“"
                            },
                            {
                                "example_id": "8b61a891-2da9-47b7-a578-c33363e0b6ad",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„»Wir sind jetzt in einem Stall, wo vier Gruppen mit je 200 Tieren drinstehen. Wir stehen in einem Offenstall, das heißt, wir haben hier klimatisch gesehen wirklich Außenbedingungen.«“"
                            },
                            {
                                "example_id": "fd54d920-55c9-479a-841f-0cdd73707ad4",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Die Kühe vom Hof Holthusen bei Brake haben ihre Tage bis vor Kurzem auf der Weide verbracht. Nur zum Melken ging es in den Offenstall - mit ausreichend Platz für Bewegung und viel frischer Luft. Zum Start der Wintersaison stehen sie nun drinnen und fressen Gras von den Hof-eigenen Wiesen.“"
                            },
                            {
                                "example_id": "f5096d0f-837e-4175-8f8a-09bbcf4fafb5",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "[Kaninchenhaltung:] „Dieser kühle Offenstall ist für die Kaninchen selbständig von ihrem Freilaufrevier durch eine Röhre oder eine Klappe ebenerdig erreichbar.“"
                            },
                            {
                                "example_id": "f69fae86-d4cc-40b7-8f4c-ecc56503d0fc",
                                "sense_id": "7f137126-1b49-34a7-b9a2-ee52fb97a0f2",
                                "text": "„Der Himmel ist blau, die Sonne strahlt, aber es ist wieder kalt. Der Raureif hat sich über das Fell der Pferde gelegt, die im Offenstall von Schloss Aufhausen im oberbayerischen Landkreis Erding stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
