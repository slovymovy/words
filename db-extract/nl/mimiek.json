                                            {
                                                "example_id": "f265076a-2b6e-4b75-8631-8b8b464c238a",
                                                "sense_id": "e59dd05f-91d4-392d-9b01-119b2e435a70",
                                                "text": "In this game, you're given a word, which you have to mime to the others in the group."
                                            }
                                        ]
