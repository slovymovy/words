{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c2c01bc-72d1-33e0-86a3-7d32792c2c82",
                    "sense_definition": "Any of the several species of plant in the genus Taraxacum, characterized by yellow flower heads and notched, broad-ended leaves.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright yellow <w>dandelion</w> grew quickly in the middle of the green lawn.",
                            "target_lang_translations": {
                                "zh": "那朵明黄色的<w>蒲公英</w>在绿草坪中间长得很快。"
                            }
                        },
                        {
                            "text": "Children often pick a <w>dandelion</w> to give to their parents as a small gift.",
                            "target_lang_translations": {
                                "zh": "孩子们经常采摘<w>蒲公英</w>作为小礼物送给父母。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "common dandelion"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种菊科植物，花朵呈黄色，叶片边缘有缺刻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蒲公英",
                                "target_lang_sense_clarification": "指代整个植物个体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b9fef7b-0bb0-37bb-8ac3-138a421e8f51",
                    "sense_definition": "The flower head or the white, fluffy seed head of the dandelion plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She blew on the <w>dandelion</w> and watched the seeds float away in the wind.",
                            "target_lang_translations": {
                                "zh": "她对着<w>蒲公英</w>吹了一口气，看着种子随风飘散。"
                            }
                        },
                        {
                            "text": "The field was covered in fluffy white <w>dandelions</w> after the flowers had finished blooming.",
                            "target_lang_translations": {
                                "zh": "花期过后，田野里覆盖着毛茸茸的白色<w>蒲公英</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "蒲公英的花朵或其成熟后形成的白色绒毛状种子球。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蒲公英",
                                "target_lang_sense_clarification": "指代花朵或种子部分。"
                            }
                        ]
                    },
                    "common_phrases": [
                        "dandelion clock"
                    ]
                },
                {
                    "sense_id": "e3b1fb82-219c-365e-8172-058ee5397f6b",
                    "sense_definition": "A bright yellow colour, similar to that of the dandelion flower.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the sun using a vibrant shade of <w>dandelion</w>.",
                            "target_lang_translations": {
                                "zh": "艺术家用一种鲜艳的<w>蒲公英黄</w>画了太阳。"
                            }
                        },
                        {
                            "text": "She wore a dress in a soft <w>dandelion</w> yellow for the spring party.",
                            "target_lang_translations": {
                                "zh": "她穿着一件柔和的<w>蒲公英黄</w>色裙子参加春季派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yellow"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种明亮的黄色，类似于蒲公英花朵的颜色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蒲公英黄",
                                "target_lang_sense_clarification": "形容一种特定的明亮黄色。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb79c0d6-66e6-398d-8f03-8edd654075b1",
                    "sense_definition": "Of a bright yellow colour, like that of the dandelion flower.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was decorated with <w>dandelion</w> curtains that made it feel very bright.",
                            "target_lang_translations": {
                                "zh": "房间装饰着<w>蒲公英黄色的</w>窗帘，让室内感觉非常明亮。"
                            }
                        },
                        {
                            "text": "He chose a <w>dandelion</w> paint for the kitchen walls to create a cheerful atmosphere.",
                            "target_lang_translations": {
                                "zh": "他为厨房墙壁选择了<w>蒲公英黄色的</w>油漆，以营造欢快的氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yellow"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容像蒲公英花朵一样明亮的黄色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蒲公英黄色的",
                                "target_lang_sense_clarification": "用作形容词描述颜色。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}