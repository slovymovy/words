                        "glosses": [
                            "Celle qui parle beaucoup, qui parle trop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038832b4-8641-481b-8daf-d33ad4f1f81d",
                                "sense_id": "5b3b3703-c37f-3306-9b20-0b6f1dd36b9e",
                                "text": "Le Duc. – Tu sais que je n’aime pas les bavardes, et il m’est revenu que la Catherine était une belle parleuse."
                            },
                            {
                                "example_id": "97b0fff8-4832-449b-a986-d942dbfeb2ee",
                                "sense_id": "5b3b3703-c37f-3306-9b20-0b6f1dd36b9e",
                                "text": "— Même, ajouta la femme de chambre, belle parleuse, il m'a dit à moi-même, parlant à ma personne : « […] »."
                            }
                        ]
                    },
