                                "target_senses": [
                                    {
                                        "sense_id": "693d3dcf-59c6-361e-adcd-964af55151a3",
                                        "entry_id": "bec2776f-eaee-31be-930e-08eaa03adbff",
                                        "glosses": [
                                            "Injury or harm; the condition or measure of something not being intact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf130beb-89b7-494e-9f35-a278e62c0882",
                                                "sense_id": "693d3dcf-59c6-361e-adcd-964af55151a3",
                                                "text": "The storm did a lot of damage to the area."
                                            },
                                            {
                                                "example_id": "a59c72a7-956c-4bb5-b02e-2292f6da32ce",
                                                "sense_id": "693d3dcf-59c6-361e-adcd-964af55151a3",
                                                "text": "Great errors and absurdities many […]commit for want of a friend to tell them of them, to the great damage both of their fame and fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d2708ce-0e07-39e2-ad4b-ee493d68a24c",
                                        "entry_id": "bec2776f-eaee-31be-930e-08eaa03adbff",
                                        "glosses": [
                                            "Cost or expense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971a2db4-5fa4-45bc-9155-3f689d4c4df0",
                                                "sense_id": "6d2708ce-0e07-39e2-ad4b-ee493d68a24c",
                                                "text": "\"What's the damage?\" he asked the waiter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "damage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                        "entry_id": "431230a8-e9ca-3664-947c-416a03bcd394",
                                        "glosses": [
                                            "To impair the soundness, goodness, or value of; to harm or cause destruction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fca61af-b855-4adf-ac48-437294d05ba2",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "Be careful not to damage any of the fragile items while unpacking them."
                                            },
                                            {
                                                "example_id": "e5636c82-9ab3-4590-b71c-889edb873e40",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "Cold temperatures, heavy rain, falling rocks, strong winds and glacier movement can damage the equipment."
                                            },
                                            {
                                                "example_id": "6358d954-8f6f-487e-bf7b-2ff95a1fb1e4",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "The building was erected in two years, at the parochial expence, on the foundation of the former one, which was irreparably damaged by the hurricane of Auguſt, 1712."
                                            },
                                            {
                                                "example_id": "6a40ddfd-772e-45f9-9c93-3c3e070a0b2b",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "He […] came up to the English admiral and gave him a broadside, with which he killed many of his men and damaged the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59f0165-9c5f-35a8-9f27-574ce3f84bd0",
                                        "entry_id": "431230a8-e9ca-3664-947c-416a03bcd394",
                                        "glosses": [
                                            "To undergo damage; to take damage."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33e9a3ae-38f5-3eac-bd60-5183030f85c4",
                                        "entry_id": "431230a8-e9ca-3664-947c-416a03bcd394",
                                        "glosses": [
                                            "To remove a damaged or unsalable item from the sales floor for processing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0cbfb47-0385-4c2e-ba2f-410ea33b93c9",
                                                "sense_id": "33e9a3ae-38f5-3eac-bd60-5183030f85c4",
                                                "text": "Did you damage the items that the customer returned yet?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
