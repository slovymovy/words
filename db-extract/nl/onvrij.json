                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10dc9444-d4cd-4377-a93b-f56533728c6b",
                                                "sense_id": "d4375fc5-0a38-3e43-964d-74f0807c26cd",
                                                "text": "to bound a horse"
                                            },
                                            {
                                                "example_id": "0b50dada-8003-475d-8d3e-287f58ca4a67",
                                                "sense_id": "d4375fc5-0a38-3e43-964d-74f0807c26cd",
                                                "text": "[…] Or if I might buffet for my Loue, or bound my Horſe for her fauours, I could lay on like a Butcher, and fit like a Iack an Apes, neuer off."
                                            }
                                        ]
