                        "form": "onduleuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                        "entry_id": "045f924d-c8ed-3857-8695-35237d5669e0",
                        "glosses": [
                            "Qui forme des ondulations, des sinuosités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a960ba30-7454-4f67-8e49-ef13d40aaad9",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "De temps en temps elle redressait sa tête avec un mouvement onduleux de couleuvre ou de paon qui se rengorge, et imprimait un léger frisson à la haute fraise brodée à jour qui l’entourait comme un treillis d’argent."
                            },
                            {
                                "example_id": "07a99aa5-2810-40b0-9421-f4b29ff46588",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "D’où diable vient-elle si matin ? se demanda-t-il en analysant le mouvement onduleux de la robe auquel elle imprimait une grâce peut-être exagérée."
                            },
                            {
                                "example_id": "29f54fa6-cff0-447f-bd50-70a8ead66cbc",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "Le soleil n’est pas haut encore, et pendant que les têtes onduleuses de la forêt rient, gaiement illuminées, les tranchées intérieures profondes de roc cassé restent noyées dans leur ombre noire."
                            },
                            {
                                "example_id": "c5782c0b-6772-4e2e-9f10-04aed059dc5c",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "Sur le lac tranquille, une barque passa avec un lampion vert qui moirait l’eau noire de reflets onduleux."
                            },
                            {
                                "example_id": "8b84c1cf-a5ec-4818-bbc8-f7f3e7a91217",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "La foncée du Brochet avait ouvert une grande cocarde sur l’étang. Ces cercles d’eau onduleuse soulevèrent brusquement l’esquif de Justin."
                            },
                            {
                                "example_id": "c5647dc6-3240-4ffe-81ba-68f59ec1dd40",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "Sa mise était celle des bergers des Syrtes, mais ce qui me frappa aussitôt vivement était quelque chose d’onduleux et de singulièrement souple dans la démarche, et surtout la teinte très sombre, presque exotique, du visage et des mains."
                            },
                            {
                                "example_id": "5323ee6e-a8ae-47d0-9d61-0f00a0e9e0d8",
                                "sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                                "text": "Le canot semblait décoller du lac, dans un instant il planerait au-dessus de ce marasme onduleux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4108b561-1ac0-4427-8598-fb69c9dad629",
                        "source_entry_id": "045f924d-c8ed-3857-8695-35237d5669e0",
                        "source_sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                        "target_lang_word": "wellig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wellig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                        "entry_id": "e1602da3-1c48-3fed-bac0-b0cafc88bff7",
                                        "glosses": [
                                            "in Form von vielen kleinen Wellen, wellenförmig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bf5512-8b58-4eca-8252-c89cc8de6e7a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Cellulite:] „Stadium 3 – Auch in Ruhe und im Liegen ist eine wellige Hautoberfläche sichtbar.“"
                                            },
                                            {
                                                "example_id": "ee6f6cb5-8fce-4a09-918c-7135f4635964",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[EKG:] „Verschiedenfarbige zackige und wellige Linien laufen über den Bildschirm, jede liefert Informationen über den Schlaf des Patienten.“"
                                            },
                                            {
                                                "example_id": "bafccec8-f769-491e-811c-ad571fb72e1a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Seehunde:] „Die Barthaare sind stark wellig und im Querschnitt oval.“"
                                            },
                                            {
                                                "example_id": "25838cdb-fab9-45d2-8db4-2e36a30d8f37",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Daneben steht ein Styroporkopf, und da herum hängen reihenweise Echthaarperücken, lange und kurze, wellige und glatte, blonde und schwarze.“"
                                            },
                                            {
                                                "example_id": "a964eea6-63b5-4f70-96bd-5cd09949c322",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Der Wind SO 4-6 ist böig, die See ist wellig, der Skipper kämpft Einhand mit dem achterlichen Wind, teilweise wird nur mit der Genua gesegelt. Die Bordfrau nimmt zum ersten Mal Tabletten gegen Seekrankheit.“"
                                            },
                                            {
                                                "example_id": "b3ac9c3e-bda6-4f5e-abf9-9f0511ad0d85",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Das Himmerland im Norden Dänemarks ist eine leicht wellige Hügellandschaft.“"
                                            },
                                            {
                                                "example_id": "81da7537-19ef-4306-9b83-d523d75ef45d",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Roztocze ist eine wellige Hügelkette im südöstlichen Polen und in der westlichen Ukraine.“"
                                            },
                                            {
                                                "example_id": "712fdc81-8cab-4d26-a634-7dd2f48e066c",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Er zeigt auf den welligen gerissenen Asphalt.“"
                                            },
                                            {
                                                "example_id": "762751e0-dc93-4a97-8c05-bcc4693f85ee",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Tour de France 2020:] „»Erst ist die Strecke eben, dann wird es wellig und am Ende kommt ein unglaublicher Berg«, schwärmte Prudhomme vom 36 Kilometer langen Bergzeitfahren zur Planche des Belles Filles in den Vogesen.“"
                                            },
                                            {
                                                "example_id": "9820a620-404c-4a5f-b30e-01480e5ccce9",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Mountainbike-Rennen:] „Schon auf dem ersten der sechs Teilabschnitte, der rund 600 Höhenmeter hinauf auf den Kupferberg und dann durch das wellige Gelände des Khomas-Gebirges führt, spürt er den Lohn seiner unzähligen Trainingsstunden.“"
                                            },
                                            {
                                                "example_id": "91d9c906-795b-410a-8eb3-adc034481d8a",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Radrennen – Deutschlandtour:] „Stehen zum Auftakt in Halberstadt noch die Sprinter im Fokus, könnten es auf dem welligen Schlusskurs in Göttingen schon angriffslustige Fahrer sein.“"
                                            },
                                            {
                                                "example_id": "7182c023-fb93-44c9-b66d-b0ccf894a99d",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Formel 1 in Spa-Francorchamps/Belgien:] „Ferrari, das auch schon seit einem Jahr auf einen Triumph wartet, stellte jedenfalls unter Beweis, dass das Auto auf dem welligen und anspruchsvollen Kurs unweit der deutschen Grenze am besten funktioniert.“"
                                            },
                                            {
                                                "example_id": "fb042213-f597-4c6f-904d-9f4a16c00af8",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Golf:] Auf einem welligen Grün ist es schwerer, zu putten."
                                            },
                                            {
                                                "example_id": "c6c195e8-bf07-49b2-b392-63037dad2879",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "[Skirennen:] „Die Bedingungen waren für alle schwierig, der Lauf war flüssig gesteckt, jedoch sehr wellig, so dass der eine oder andere Läufer ausgehoben wurde und es zu Stürzen und Torfehlern kam.“"
                                            },
                                            {
                                                "example_id": "5041df39-77fe-4d10-b22c-abc1ee9fd9c8",
                                                "sense_id": "db2e1239-f1c3-39e2-bf0f-0eed5befc197",
                                                "text": "„Steigungen: Die Routen sind leicht wellig durch die Hügel des niederen Fläming.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35d1d0ca-2008-4851-b164-7671cf4a79bc",
                        "source_entry_id": "045f924d-c8ed-3857-8695-35237d5669e0",
                        "source_sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                        "target_lang_word": "undulating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undulating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55468853-5efc-338d-8459-4d59c11b8741",
                                        "entry_id": "3d8b02fe-c2e0-3583-80a2-16a62744587e",
                                        "glosses": [
                                            "Moving up and down like waves; wavy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8861ed-6ec0-4572-8841-3c90d1361906",
                                                "sense_id": "55468853-5efc-338d-8459-4d59c11b8741",
                                                "text": "From Belgrade the train is hauled by a 2-10-0, and makes good time through undulating country, with vineyards and herds of woolly pigs, over single line to Nish, where the Sofia and Istanbul portion, including through coaches (until recently) from Prague to Sofia, the capital of Bulgaria, is detached."
                                            },
                                            {
                                                "example_id": "dd6ba232-db0d-4c18-bb69-3a8d5fd7de9e",
                                                "sense_id": "55468853-5efc-338d-8459-4d59c11b8741",
                                                "text": "The Borinage coalfield around Mons is another attractive area for the railway enthusiast; it is rather like South Lancashire, with its gently undulating landscape studded with slag heaps and pithead gear and criss-crossed by railway lines and tramways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a4f945-ad61-3618-aa7f-f971aad1195f",
                                        "entry_id": "3d8b02fe-c2e0-3583-80a2-16a62744587e",
                                        "glosses": [
                                            "Forming a series of regular curves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a3a725-a7bb-4cbc-8d82-bab289395efc",
                                                "sense_id": "92a4f945-ad61-3618-aa7f-f971aad1195f",
                                                "text": "Leaving behind us the town at the bottom of its deep bay, we set out to explore a bluff-headed parallelogramical promontory, bounded by Thurso Bay on the one hand, and Murkle Bay on the other, and which presents to the open sea, in the space that stretches between, an undulating line of iron-bound coast, exposed to the roll of the northern ocean."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "undulating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5db3d6-a1f3-3ba9-a130-af47a20036dd",
                                        "entry_id": "77d10ef7-5f5d-3e80-bb35-f915041628e8",
                                        "glosses": [
                                            "present participle and gerund of undulate"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "undulating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c75513fe-2255-39c5-813a-b4eb95e196f6",
                                        "entry_id": "1f24b964-cd4e-3019-bbe9-ccb771b6e139",
                                        "glosses": [
                                            "undulation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ac9de8-c5f6-4027-9a83-61b3512a43d0",
                                                "sense_id": "c75513fe-2255-39c5-813a-b4eb95e196f6",
                                                "text": "In good poetry every word and phrase, as Professor McKail says, reverberates like the sound of a lyre, and leaves after it numberless undulatings. The verse exhales sweet sound, and light-like thought, as perfumes do; but we cannot explain just why."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea3bd5f2-5c8a-4687-ab67-206a5e2994e2",
                        "source_entry_id": "045f924d-c8ed-3857-8695-35237d5669e0",
                        "source_sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                        "target_lang_word": "sinuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Having curves in alternate directions; meandering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dac33e-3a12-4cf6-9cd7-2cd96694f814",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "We followed every bend of the sinuous river."
                                            },
                                            {
                                                "example_id": "fbe0df2f-9b98-486c-b4f8-f342f203b44e",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "[W]hen a transverse, or, within certain limits, an oblique impulse, impinges laterally upon a continuous mountain range, two movements of vibration are communicated; the one, a wave transmitted along and in the line of the axis, the other a transverse wave, which causes the axial line to sway laterally, and transmit a quam prox. horizontal transverse wave, along from one end to the other; like the sinuous movement which travels along a long rope when, hanging suspended between two points at the same level, it is jerked suddenly at one end, transversely to its length."
                                            },
                                            {
                                                "example_id": "9f2e6131-1534-47c4-8a9e-50e5f89548ed",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "[A] peculiar luminous and sinuous marking appeared on the unillumined half of the inner planet, and almost simultaneously a faint dark mark of a similar sinuous character was detected upon a photograph of the Martian disc."
                                            },
                                            {
                                                "example_id": "5b5112fb-086a-4342-ada8-3dad8a69cc11",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "The way through the wood was shorter, but it was also sinuous. He missed his way, and, as a direct consequence, missed his train."
                                            },
                                            {
                                                "example_id": "d522a7df-7a28-497d-8b23-4ce62f35a001",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "My own apprehension rose again to a superlative pitch as we swept down from St. Neots at all but 110 m.p.h. towards those sinuous curves round the bank of the Ouse near Offord, and were almost on to them before we suddenly braked."
                                            },
                                            {
                                                "example_id": "18b07ee4-52cd-4291-a2a6-c4276ea0ef9d",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "This is the perfect climbing tree: wrought by two centuries of good London living, its sinuous spread presents any number of routes into the canopy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Moving gracefully and in a supple manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c0af63-8a71-44c5-9184-1f9f2939a672",
                                                "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                                "text": "We were entranced by her sinuous dance."
                                            },
                                            {
                                                "example_id": "9be37e6d-e2e2-4d18-8ef7-93c718e26f85",
                                                "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                                "text": "Once a dark, clumsy tapir stared at us from a gap in the bushes, and then lumbered away through the forest; once, too, the yellow, sinuous form of a great puma whisked amid the brushwood, and its green, baleful eyes glared hatred at us over its tawny shoulder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2afba3-340a-3cc8-ad82-3cead4b8abf8",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Morally crooked; shifty."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b60e8a-bb2c-4ced-b5eb-f9da367aab74",
                                                "sense_id": "fa2afba3-340a-3cc8-ad82-3cead4b8abf8",
                                                "text": "On 16 December 1999, Lanny Davis, one of the President's more sinuous apologists, was asked on an MSNBC chat show to address the issue and replied that Ms. Broaddrick had been adjudged unreliable by the FBI."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d367f9f1-25f1-4da6-9e30-502461c57634",
                        "source_entry_id": "045f924d-c8ed-3857-8695-35237d5669e0",
                        "source_sense_id": "b860708e-2fa3-33f8-a2f7-274fbae507fc",
                        "target_lang_word": "ondulante",
