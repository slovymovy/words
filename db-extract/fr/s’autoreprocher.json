                        "glosses": [
                            "Se reprocher à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd3f4be-3c9b-44aa-9d38-b951eab74fee",
                                "sense_id": "f3839e17-41de-30eb-8f28-bbbfa29b7dd9",
                                "text": "Marianne a en plus l'honnêteté de s'autoreprocher de s'être trop souvent roulé dans la même laine."
                            },
                            {
                                "example_id": "0d6bf2f6-9c16-4156-8b9e-49c104f0d15f",
                                "sense_id": "f3839e17-41de-30eb-8f28-bbbfa29b7dd9",
                                "text": "Sais-tu ce qu'est de voir dans les yeux de tes parents de la peur et du dégout, de les entendre s'autoreprocher l'anormalité de leur enfant."
                            },
                            {
                                "example_id": "f254a4d6-3cdb-4c56-95f2-63555eae51e9",
                                "sense_id": "f3839e17-41de-30eb-8f28-bbbfa29b7dd9",
                                "text": "L'occasion aussi de nous autoreprocher aujourd'hui la rareté de cette rubrique « Clin d'œil » dans Satellifax !"
                            }
                        ]
                    }
