                                "target_senses": [
                                    {
                                        "sense_id": "5aad10e6-4efd-38a3-8e49-62b537724c0e",
                                        "entry_id": "980096eb-fbd9-3c67-a598-bc41eb177fe8",
                                        "glosses": [
                                            "Einwohner der Stadt Hamburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941eff03-88ab-4b7a-8dad-e577f9bae4c1",
                                                "sense_id": "5aad10e6-4efd-38a3-8e49-62b537724c0e",
                                                "text": "Er kommt aus Hamburg, also ist er ein Hamburger."
                                            },
                                            {
                                                "example_id": "15330143-83c6-42cf-971d-9bb395b78018",
                                                "sense_id": "5aad10e6-4efd-38a3-8e49-62b537724c0e",
                                                "text": "„Uffelen sagte, daß man deutscherseits sich auf solches nicht einlassen würde, zudem hätten die Hamburger keine Möglichkeit, von auswärts Arbeitskraft zu beschaffen, um die Insel auszunutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hamburger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8250f361-65aa-3b74-9971-16b1e5292346",
                                        "entry_id": "de63b831-f52b-39a2-823e-cd35d98f50c8",
                                        "glosses": [
                                            "belegtes Brot oder Brötchen; bekanntes, weltweit verbreitetes Fastfood-Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37ab293-5ca0-414d-bf27-fed71c00d48b",
                                                "sense_id": "8250f361-65aa-3b74-9971-16b1e5292346",
                                                "text": "Ich habe gerade einen Hamburger mit Pommes gegessen."
                                            },
                                            {
                                                "example_id": "a3164b91-7188-4974-a154-7d26bbee12b7",
                                                "sense_id": "8250f361-65aa-3b74-9971-16b1e5292346",
                                                "text": "„Der Hamburger ist, neben dem Hotdog, ein isländisches Lieblingsessen.“"
                                            },
                                            {
                                                "example_id": "522a1a6c-b2c1-412c-b0b6-71cd050b8730",
                                                "sense_id": "8250f361-65aa-3b74-9971-16b1e5292346",
                                                "text": "„Der Hamburger war saftig und gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hamburger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1376114a-5cfc-31b8-8388-2fafcb966736",
                                        "entry_id": "6abd4962-5b1e-3b17-b7bf-79653cccc3a5",
                                        "glosses": [
                                            "zu Hamburg^([1, 2]), sich auf diesen Ort beziehend, in der Art und Weise dieses Ortes, aus Hamburg kommend, stammend, Hamburg betreffend, zu Hamburg gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488c17e5-1bd5-414b-acac-606365b8b736",
                                                "sense_id": "1376114a-5cfc-31b8-8388-2fafcb966736",
                                                "text": "Der Hamburger Hafen ist der zweitgrößte in Europa."
                                            },
                                            {
                                                "example_id": "4081bd98-c700-4316-a31f-3b4fbf511237",
                                                "sense_id": "1376114a-5cfc-31b8-8388-2fafcb966736",
                                                "text": "Sie ist eine echte Hamburger Deern."
                                            },
                                            {
                                                "example_id": "c1b239e2-8886-48ca-b9ae-8cad8d38d052",
                                                "sense_id": "1376114a-5cfc-31b8-8388-2fafcb966736",
                                                "text": "„Auch die Landesliste zur Bürgerschaftswahl am 2. März haben die Hamburger BSW-Mitglieder aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
