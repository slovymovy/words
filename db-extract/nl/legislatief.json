                                "target_senses": [
                                    {
                                        "sense_id": "ad30cd64-0434-3a28-baa6-81524575fa0e",
                                        "entry_id": "ec61d8ad-70cc-35ef-9719-145c15e26b82",
                                        "glosses": [
                                            "Making, or having the power to make, a law or laws; lawmaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2050ce-a91f-4017-b71c-3712c3524613",
                                                "sense_id": "ad30cd64-0434-3a28-baa6-81524575fa0e",
                                                "text": "a legislative act"
                                            },
                                            {
                                                "example_id": "85a87735-a8ca-4b3e-81b5-d2360e414b6d",
                                                "sense_id": "ad30cd64-0434-3a28-baa6-81524575fa0e",
                                                "text": "Although enormously influential in shaping the laws of the land, The House of Lords are not actually a legislative body."
                                            },
                                            {
                                                "example_id": "5d8d431e-8411-4ae5-8c2d-8d3eceda9a41",
                                                "sense_id": "ad30cd64-0434-3a28-baa6-81524575fa0e",
                                                "text": "The legislative framework provides much opportunity for correction and amendment of poorly thought out bills."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "legislative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33406d85-51b8-3707-89d6-f8daa3f67328",
                                        "entry_id": "6c1bdff7-083c-39db-b89d-66f24a09e8b9",
                                        "glosses": [
                                            "That branch of government which is responsible for making, or having the power to make, a law or laws."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf82006-d0a3-490d-be7b-b9d2b7330a01",
                        "source_entry_id": "ad88f1b3-6b91-3980-91fe-e6cf78094d19",
                        "source_sense_id": "99ddac79-27f3-340f-9482-9e6ec0c78e46",
                        "target_lang_word": "législatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "législatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b618f19-d408-3ac7-94dd-b023bb9f0970",
                                        "entry_id": "e1256559-8ac4-30c7-920b-1cb9560b2393",
                                        "glosses": [
                                            "Qui fait les lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fa7df6-2fe5-4c44-8faa-aab842a15beb",
                                                "sense_id": "9b618f19-d408-3ac7-94dd-b023bb9f0970",
                                                "text": "Pour organiser la machine politique de manière à faire triompher la justice et la liberté, il fallait mettre le pouvoir législatif dans la dépendance éternelle de la nation et l'isoler parfaitement du pouvoir exécutif."
                                            },
                                            {
                                                "example_id": "bab8cc6c-c19f-4265-b28a-bf11d2cf0766",
                                                "sense_id": "9b618f19-d408-3ac7-94dd-b023bb9f0970",
                                                "text": "Si, un mois après l’invitation du Corps législatif, le roi n’a pas prêté ce serment, ou si, après l’avoir prêté, il le rétracte, il sera censé avoir abdiqué la royauté."
                                            },
                                            {
                                                "example_id": "3078cc83-2d38-471b-80e2-c7182ee8231d",
                                                "sense_id": "9b618f19-d408-3ac7-94dd-b023bb9f0970",
                                                "text": "Dès le début du règne de Louis-Philippe, devait naître, à l’initiative de certains présidents du conseil, la question de confiance aux députés, soit à l'occasion de certains votes législatifs, soit au moment de la constitution du ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cfc183-0d50-3856-ab45-127ce1a1917a",
                                        "entry_id": "e1256559-8ac4-30c7-920b-1cb9560b2393",
                                        "glosses": [
                                            "Qui est de la nature des lois ; qui a le caractère d’une loi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4e560d-3b3b-47d0-aed5-c6c0cb94ca9e",
                                                "sense_id": "e3cfc183-0d50-3856-ab45-127ce1a1917a",
                                                "text": "L'honorable M. Bertauld nous a dit encore : Je repousse votre projet de loi parce que c'est un expédient, une loi de circonstance, et qu'il n'appartient pas aux assemblées politiques de se saisir de faits particuliers pour en faire l'objet d'une modification législative."
                                            },
                                            {
                                                "example_id": "9cc7394a-96dc-42f5-a5a6-51d9bd3398db",
                                                "sense_id": "e3cfc183-0d50-3856-ab45-127ce1a1917a",
                                                "text": "On brise un instrument législatif quand on prétend le forcer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44821612-297a-3ec1-824d-a2621170711d",
                                        "entry_id": "e1256559-8ac4-30c7-920b-1cb9560b2393",
                                        "glosses": [
                                            "Qui est relatif aux lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498565ef-f22a-4115-b45d-5b457a509f92",
                                                "sense_id": "44821612-297a-3ec1-824d-a2621170711d",
                                                "text": "En dépit du morcellement législatif des coutumes, nous avons une unité remarquable de législation en cette matière, car c'est l’Église qui seule légifère et juge."
                                            },
                                            {
                                                "example_id": "4c1934f2-0855-49f6-b5ee-edb915126e7c",
                                                "sense_id": "44821612-297a-3ec1-824d-a2621170711d",
                                                "text": "Si certains se targuèrent alors de rendre la chose plus « transparente » donc soi-disant plus saine, cela revenait tout de même à leur permettre de faire du renseignement législatif voire d'influencer nos élus."
                                            },
                                            {
                                                "example_id": "24903033-51ba-4d76-a932-399f85dd96e0",
                                                "sense_id": "44821612-297a-3ec1-824d-a2621170711d",
                                                "text": "Élection législative, élection des députés, des sénateurs qui font les lois, après en avoir préparé et discuté la rédaction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
