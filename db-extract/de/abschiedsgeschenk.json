                "senses": [
                    {
                        "sense_id": "8444956f-d342-38cd-804d-36455ab8e846",
                        "entry_id": "afbd653a-1c1f-3301-9c53-4f4cc57afdc7",
                        "glosses": [
                            "Geschenk, das anlässlich einer Verabschiedung gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16c1d97c-dd2f-46cd-b23d-ab9dbd8ec6fa",
                                "sense_id": "8444956f-d342-38cd-804d-36455ab8e846",
                                "text": "„Das Abschiedsgeschenk für den siebenmaligen Weltmeister steht schon jetzt fest.“"
                            },
                            {
                                "example_id": "a8246722-efda-40a2-beb5-06f2a4ff52c7",
                                "sense_id": "8444956f-d342-38cd-804d-36455ab8e846",
                                "text": "„In dem Fall ist man nicht nur froh über den Abschied, man verstellt sich auch nicht und handelt konsequent, sprich, man beteiligt sich nicht an einem Abschiedsgeschenk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
