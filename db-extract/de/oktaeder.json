                "senses": [
                    {
                        "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                        "entry_id": "6de8ce8f-6ce7-3888-b9b2-797e7e09be04",
                        "glosses": [
                            "Körper mit acht gleichseitigen Dreiecken als Seitenflächen"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "e650963f-316f-4bf4-b3e6-853374164e0f",
                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                "text": "Die Lehrerin trug ihren Schülern auf, das Netz eines Oktaeders zu zeichnen."
                            },
                            {
                                "example_id": "581f3aaa-df33-48ef-9734-96d9db10b65d",
                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                "text": "Der Oktaeder ist dual zum regelmäßigen Hexaeder."
                            },
                            {
                                "example_id": "dfb494a5-dcd2-45c6-b352-304b6f0ae5bf",
                                "sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                                "text": "„Die aufgefundenen Erzbrocken ließen auf Vorkommen von ziemlich reinem und fettem Eisenoxydul schließen, das in Oktaedern kristallisiert war; das gleiche sogenannte Magneteisen wird in den Gruben Schwedens und Norwegens gewonnen und ist der Rohstoff für das Qualitätseisen Europas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac908881-0f73-4631-97a9-4356da508a57",
                        "source_entry_id": "6de8ce8f-6ce7-3888-b9b2-797e7e09be04",
                        "source_sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                        "source_sense_description": "Geometrie: Körper mit acht gleichseitigen Dreiecken als Seitenflächen",
                        "target_lang_word": "octahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be2b8a7c-f78c-3537-8785-fcc387f03b0b",
                                        "entry_id": "08836e30-9f57-38d5-a977-775e6c47ee60",
                                        "glosses": [
                                            "a polyhedron with eight faces; the regular octahedron has regular triangles as faces and is one of the Platonic solids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5025bdaa-7b22-4824-b240-ea2bf2f6e8bd",
                        "source_entry_id": "6de8ce8f-6ce7-3888-b9b2-797e7e09be04",
                        "source_sense_id": "24a197be-9a75-32fd-af4a-4849358e3645",
                        "source_sense_description": "Geometrie: Körper mit acht gleichseitigen Dreiecken als Seitenflächen",
                        "target_lang_word": "октаэдр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "октаэдр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                        "entry_id": "2993b412-fbb6-3243-b8b9-3381ad48bb5a",
                                        "glosses": [
                                            "геометр. выпуклый правильный многогранник, имеющий восемь треугольных, в виде равностороннего треугольника, граней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285ba0bb-314e-47d7-b31a-738ecb00354d",
                                                "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                                "text": "Понятие золотого сечения, или пропорции, было известно ещё в Древнем Египте, его применяли при сооружении пирамид. Широкое распространение оно получило и в Древней Греции благодаря Пифагору, который использовал это правило для своей модели мира и построения симметричных многогранников: кубов, октаэдров, тетраэдров и додекаэдров .."
                                            },
                                            {
                                                "example_id": "3c01be8c-ed9d-4b57-b10e-af2c3b69c207",
                                                "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                                "text": ".. в правильном многоугольнике может быть какое угодно количество сторон, в правильном же многограннике количеством граней может служить лишь одно из следующих пяти чисел: четыре (у тетраэдра), шесть (у куба, он же гексаэдр), восемь (у октаэдра), двенадцать (у додекаэдра) или двадцать (у икосаэдра) .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
