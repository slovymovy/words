                                        "entry_id": "eec22d81-96b8-355b-ab54-49c461e047de",
                                        "glosses": [
                                            "Participe présent de sonner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3eb6724-9470-4d0e-a9ee-16acccede552",
                                                "sense_id": "aed2ef9f-afe7-36cc-bf9b-296c9eb8f362",
                                                "text": "Oh ! notre petite bellote sera chez elle, répondit Mme Marneffe en sonnant Reine pour faire demander Mme Olivier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sonnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb2458b-abf3-381a-80a0-7a624f9537cd",
                                        "entry_id": "0469e654-01e1-3ddc-be10-27b9e82e1310",
                                        "glosses": [
                                            "Qui rend un son clair et distinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e1f6e8-a892-4589-be5b-0bd150007b58",
                                                "sense_id": "ecb2458b-abf3-381a-80a0-7a624f9537cd",
                                                "text": "De l’étain sonnant. Airain sonnant."
                                            },
                                            {
                                                "example_id": "f34009a4-31f2-4f2d-ae54-232f36a4ecff",
                                                "sense_id": "ecb2458b-abf3-381a-80a0-7a624f9537cd",
                                                "text": "Bouquinant et flânant, je goûtais au passage quelques vers haut sonnants d’un poète de la pléiade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b6cffcb-51c1-391b-b1b2-d26f26533659",
                                        "entry_id": "0469e654-01e1-3ddc-be10-27b9e82e1310",
                                        "glosses": [
                                            "En parlant d'une heure, qui est tout juste en train de sonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d38882-43f3-4b72-993e-f6ac6ceb328b",
                                                "sense_id": "6b6cffcb-51c1-391b-b1b2-d26f26533659",
                                                "text": "Je suis arrivé à sept heures sonnantes."
                                            },
                                            {
                                                "example_id": "881404ab-4c68-454d-8827-b0fa91d9f1fa",
                                                "sense_id": "6b6cffcb-51c1-391b-b1b2-d26f26533659",
                                                "text": "Soyez chez moi à midi sonnant."
                                            },
                                            {
                                                "example_id": "db09e377-abfa-40c9-93a7-192a6b4f46df",
                                                "sense_id": "6b6cffcb-51c1-391b-b1b2-d26f26533659",
                                                "text": "Sur la place de la Seigneurie, où le soleil fleuri du printemps répandait ses roses jaunes, midi sonnant dissipait la foule rustique des marchands de grains et de pâtes assemblés pour le marché."
                                            },
                                            {
                                                "example_id": "b8cbf805-8574-413f-8b08-19a64e96b9fa",
                                                "sense_id": "6b6cffcb-51c1-391b-b1b2-d26f26533659",
                                                "text": "– … Mais il sait pertinemment que son baratin ne l’engage à rien puisque le lendemain à neuf heures sonnantes il hisse les voiles ! Ou bien je ne comprends plus rien à rien, ma chérie, ou bien tu n’es pas près de le revoir."
                                            }
                                        ]
                                    }
                                ]
                            }
