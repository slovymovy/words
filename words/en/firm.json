            "senses": [
                {
                    "sense_id": "2c737ad8-eead-3ff2-8b7c-3170b871ae06",
                    "sense_definition": "Having a solid surface or structure that is not easy to press into a different shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mattress was too soft for me, so I asked for a <w>firm</w> one.",
                            "target_lang_translations": {
                                "ru": "Матрас был слишком мягким для меня, поэтому я попросил <w>жёсткий</w>.",
                                "zh": "那张床垫对我来说太软了，所以我换了一张<w>硬</w>的。",
                                "de": "Die Matratze war mir zu weich, also habe ich nach einer <w>festen</w> gefragt."
                            }
                        },
                        {
                            "text": "After the rain stopped, we finally found some <w>firm</w> ground to set up the tent.",
