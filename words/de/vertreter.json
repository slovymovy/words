            "senses": [
                {
                    "sense_id": "9dbfbc68-6bf7-3019-85f1-660eeb05c843",
                    "sense_definition": "Person, die für eine andere Person, Gruppe oder Institution an deren Stelle handelt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stellvertretung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn der Chef im Urlaub ist, übernimmt sein <w>Vertreter</w> alle wichtigen Aufgaben im Betrieb."
                        },
                        {
                            "text": "Als gesetzlicher <w>Vertreter</w> unterschrieb der Vater den Ausbildungsvertrag für seine minderjährige Tochter."
                        }
                    ],
                    "synonyms": [
                        "Repräsentant"
                    ],
                    "common_phrases": [
                        "gesetzlicher Vertreter",
                        "ständiger Vertreter"
                    ]
                },
                {
                    "sense_id": "c2847a6f-fab4-3274-9e3b-a453344a2dbb",
                    "sense_definition": "Person, die Waren oder Verträge im Außendienst direkt bei Kunden vorstellt und verkauft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gestern hat ein <w>Vertreter</w> an der Haustür geklingelt und neue Zeitschriftenabonnements angeboten."
                        },
                        {
                            "text": "Er arbeitet seit vielen Jahren als selbstständiger <w>Vertreter</w> für einen großen deutschen Verlag."
