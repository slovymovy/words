                ],
                "senses": [
                    {
                        "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                        "entry_id": "18bc2f7a-c644-3728-97e0-62ae8b4bbad3",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c7e234-0a53-4e4c-8ca1-a985f01a4663",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Frau Natale ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ee8b98bd-8836-42b6-9881-af6d5fb7b290",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Herr Natale wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe8fe1d0-0ad9-49f7-960f-f5131e5315a1",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Die Natales fahren heute in den Odenwald."
                            },
                            {
                                "example_id": "875dbd1d-3cf5-40b4-a9a7-43fb57efea4d",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Der Natale trägt nie die Schals, die die Natale ihm strickt."
                            },
                            {
                                "example_id": "d808d5ed-1e45-4eec-877b-4b7208905d1e",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Natale kommt, geht der Herr Natale.“"
                            },
                            {
                                "example_id": "5f5b0131-85ef-4a36-96b2-5692600e2a8a",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Natale kommt und geht."
                            },
                            {
                                "example_id": "4b2e5e46-e2fa-4c06-9f33-0bddb2db0f75",
                                "sense_id": "50b4ed3d-57ab-3292-9880-5b9f6495ad77",
                                "text": "Natales kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
