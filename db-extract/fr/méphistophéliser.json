                "senses": [
                    {
                        "sense_id": "b74aa3ea-6bd5-3cbb-ac1d-545f97d17157",
                        "entry_id": "2451fd35-6c09-38cc-b90e-3a3ef3f23850",
                        "glosses": [
                            "Donner un caractère méphistophélique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549c895a-e4b9-4e7e-bd98-8f06e168c221",
                                "sense_id": "b74aa3ea-6bd5-3cbb-ac1d-545f97d17157",
                                "text": "Devant une telle complexité thématique, on ne pourra donner ici que quelques exemples de la façon dont Liszt va “méphistophéliser” certains motifs de Faust."
                            },
                            {
                                "example_id": "88834656-0c73-464a-a613-dad1ef91f744",
                                "sense_id": "b74aa3ea-6bd5-3cbb-ac1d-545f97d17157",
                                "text": "Quant à Evgeny Nikitin, il a le grand mérite de ne pas méphistophéliser Klingsor, et la voix est belle."
                            },
                            {
                                "example_id": "668c050d-7ea0-4525-b6ea-ca22fb51c33e",
                                "sense_id": "b74aa3ea-6bd5-3cbb-ac1d-545f97d17157",
                                "text": "Souvent, quand nous causions avec de Leuven et Ferdinand Langlé de cette manie d’Eugène Sue de se méphistophéliser, nous riions à cœur joie."
                            }
                        ]
                    }
