                "senses": [
                    {
                        "sense_id": "3f3cbd23-8270-39ef-bb40-bc97572b82fc",
                        "entry_id": "eda6a195-a316-3b5f-aaac-a32e3e50f32d",
                        "glosses": [
                            "opsomming van gerechten of maaltijden zoals op een menu- of spijskaart"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "04ae0f45-db03-31ba-9851-7e7853f930e9",
                        "entry_id": "eda6a195-a316-3b5f-aaac-a32e3e50f32d",
                        "glosses": [
                            "samenstelling van een maaltijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5765adfa-e6c3-417b-af2c-cbda053a2a2c",
                                "sense_id": "04ae0f45-db03-31ba-9851-7e7853f930e9",
                                "text": "Een moeder voor me trok woedend aan de bovenarm van haar kind, een stel maakte ruzie over het menu en een getatoeëerde man stond luid te bellen."
                            },
                            {
                                "example_id": "e8f87ea0-7c9c-4bcc-83e9-d5278ed28c83",
                                "sense_id": "04ae0f45-db03-31ba-9851-7e7853f930e9",
                                "text": "‘Drie Big Mac Menu’s en een salade graag.’ Ik zocht een rustig tafeltje voor mijn spullen en ging direct naar de wc om mijn handen voor de eerste keer in vijf dagen te wassen."
                            }
                        ]
                    },
                    {
                        "sense_id": "42a30bb1-f4fb-357f-b72a-031a29ddbc1b",
                        "entry_id": "eda6a195-a316-3b5f-aaac-a32e3e50f32d",
                        "glosses": [
                            "een door een computerprogramma gegenereerde opsomming van keuzemogelijkheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b870ba-d39d-40f4-b809-07f07ad90ba3",
                                "sense_id": "42a30bb1-f4fb-357f-b72a-031a29ddbc1b",
                                "text": "Je moet in het menu op \"Exporteren...\" klikken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baf15422-a4e7-4862-90e3-c58248db4f0c",
                        "source_entry_id": "eda6a195-a316-3b5f-aaac-a32e3e50f32d",
                        "target_lang_word": "menu",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c38894-b0a1-3b52-85b1-7e4f7a2fe29a",
                                        "entry_id": "d6c09a3c-d006-3ad4-92b7-07012c3dcf47",
                                        "glosses": [
                                            "The details of the food to be served at a banquet; a bill of fare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a22e80-294e-4b3f-b88f-c31b56dfd6da",
                                                "sense_id": "03c38894-b0a1-3b52-85b1-7e4f7a2fe29a",
                                                "text": "After the wedding celebration was over the menu was displayed for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bc19d14-a789-3c85-885d-32c33fe24c1d",
                                        "entry_id": "d6c09a3c-d006-3ad4-92b7-07012c3dcf47",
                                        "glosses": [
                                            "A list containing the food and beverages served at a restaurant, café, or bar. Menus may be printed on paper sheets provided to customers, put on a large poster or display board inside the establishment, displayed outside the restaurant, or digital."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e360fcc-72d0-4792-b608-302a26ae5ee9",
                                                "sense_id": "2bc19d14-a789-3c85-885d-32c33fe24c1d",
                                                "text": "The server handed us the menu."
                                            },
                                            {
                                                "example_id": "3fbdc969-bf59-4b43-ab77-87ffc2185fba",
                                                "sense_id": "2bc19d14-a789-3c85-885d-32c33fe24c1d",
                                                "text": "We selected duck pâté and chicken goujons from the menu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13d6207-e2c5-32b0-a9db-ec4ffcaa9bc4",
                                        "entry_id": "d6c09a3c-d006-3ad4-92b7-07012c3dcf47",
                                        "glosses": [
                                            "The food or drinks that are available in a restaurant, café, or bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1425facd-12de-4567-90ee-29ae67319534",
                                                "sense_id": "c13d6207-e2c5-32b0-a9db-ec4ffcaa9bc4",
                                                "text": "They took the chicken sandwich off their menu."
                                            },
                                            {
                                                "example_id": "ad41629a-2754-453a-a5a5-e5abc4f8a906",
                                                "sense_id": "c13d6207-e2c5-32b0-a9db-ec4ffcaa9bc4",
                                                "text": "We've added a few new dishes to our menu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6032a65-5fd7-39ff-b868-f251c5f389f8",
                                        "entry_id": "d6c09a3c-d006-3ad4-92b7-07012c3dcf47",
                                        "glosses": [
                                            "A list from which the user may select an operation to be performed, often done with a keyboard, mouse, or controller under a graphical user interface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d6e0eb5-443d-36a2-b49c-bb8e81614fde",
                                        "entry_id": "d6c09a3c-d006-3ad4-92b7-07012c3dcf47",
                                        "glosses": [
                                            "A list or agenda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6820d9e9-5e76-4672-b8cf-2b5f230ce71c",
                                                "sense_id": "6d6e0eb5-443d-36a2-b49c-bb8e81614fde",
                                                "text": "What's on the menu for today's meeting?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                        "entry_id": "69d7dfd6-c50f-3446-bc1e-b62a43a3f91c",
                                        "glosses": [
                                            "To include (something) in a menu."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97cd65d0-a422-4029-a038-8a6fdd711fa8",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "He created this prize-winning dish last December, to serve at a catered dinner that honored benefactors of Nashua Memorial Hospital. At that elaborate holiday repast, Quimby menued the seafood dish as a first course. However, he noted, his dish is substantial enough to serve as a satisfying entree."
                                            },
                                            {
                                                "example_id": "57bf83e7-2c8b-4e48-8b6f-46169f275861",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "[…] held their own, then that child nutrition program would consider menuing the product in the future. Kater knew he was in trouble when he saw what he was up against that day: pizza and chicken nuggets, two of the most popular school lunches served in today’s schools."
                                            },
                                            {
                                                "example_id": "f1af1605-8d2f-462f-a4f5-65b8342adc6f",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "“Menuing a bisque allows you to charge another dollar or two for the soup. Instead of $8, I can charge $11,” says Beacon’s chef and an owner, Waldy Malouf."
                                            },
                                            {
                                                "example_id": "fcfe0bc5-e40f-4c79-8d65-7ce84719a21a",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "He first menued the chop two years ago, expecting a short run, but has seen surprising customer loyalty: “If I took it off the menu, there would be an uprising.”"
                                            },
                                            {
                                                "example_id": "1773ad56-eac7-4a4f-9259-d8f8022a9e18",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "[…] scale chef who couldn’t resist menuing the classic. But unlike Regis, Gardner’s take has a few unexpected extras."
                                            },
                                            {
                                                "example_id": "36fdcc48-362b-4148-afa0-524605ad6e12",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "Depending upon your customer base, you may want to menu options that are gluten-free (G-F), vegan, macrobiotic, organic or even create a healthful kids’ menu. In fact, none of these categories are mutually exclusive, so you might consider menuing a dessert like Brownies with Cashew Cream, a popular item fitting all those categories, served at the Cal Dining-sponsored “Raw Food Chef Night” at the University of California, Berkeley ([…])."
                                            },
                                            {
                                                "example_id": "73eb85e6-4191-4d01-b03f-b01f0037ae77",
                                                "sense_id": "cb4ee38f-7761-33fc-8332-87a2a5cae0b8",
                                                "text": "Along with the meats, local Gnocchi, Borgotaro malfatti, made from ricotta, herbs, and spinach were menued. The mixture contained eggs and breadcrumbs to bind the ingredients, the chef optioning grated cheese. White truffles, Borgotaro mushrooms and stuffed tortellini bordered the fresh fish catch of the day. The bishop explained, “You’ll find our tastings vary significantly from the cuisine served at your restaurants in New York City– where the Neapolitan and Sicilian sauces are prevalent.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
