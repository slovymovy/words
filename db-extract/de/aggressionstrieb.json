                ],
                "senses": [
                    {
                        "sense_id": "4a529489-5dcf-38b1-ae72-5d29ba3b543c",
                        "entry_id": "aaaae975-fd23-3a8c-97ad-88ac2db3b27e",
                        "glosses": [
                            "Antrieb zur Aggression ([in der Triebtheorie] als Anteil des Todestriebes, der sich gegen die Außenwelt richtet)"
                        ],
                        "tags": [
                            "Verhaltensforschung"
                        ],
                        "examples": [
                            {
                                "example_id": "ddae10a7-5d85-4ba4-b590-ca43430802f8",
                                "sense_id": "4a529489-5dcf-38b1-ae72-5d29ba3b543c",
                                "text": "„Die Kultur muß alles aufbieten, um den Aggressionstrieben der Menschen Schranken zu setzen, ihre Äußerungen durch psychische Reaktionsbildungen niederzuhalten.“"
                            },
                            {
                                "example_id": "29adbe41-ba26-49da-9cf2-5eda9ecba83f",
                                "sense_id": "4a529489-5dcf-38b1-ae72-5d29ba3b543c",
                                "text": "„‚Ich glaube nicht an die Existenz eines Aggressionstriebes‘, es seien alles angelernte Verhaltensmuster, stellte er in der abschließenden Diskussion klar.“"
                            },
                            {
                                "example_id": "80382904-3216-4ae3-bc44-120d799666b1",
                                "sense_id": "4a529489-5dcf-38b1-ae72-5d29ba3b543c",
                                "text": "„Bauer setzt sich kritisch mit wissenschaftlich überholten Annahmen, etwa vom Aggressionstrieb (der große Flop der Psychoanalyse), auseinander.“"
                            },
                            {
                                "example_id": "56c99c77-7e8b-4a1d-9b9c-e8af285e3a8b",
                                "sense_id": "4a529489-5dcf-38b1-ae72-5d29ba3b543c",
                                "text": "„So ist vor allem der Aggressionstrieb von Anreizen – wirklichen Gefahren, wirklichen Angriffen usw. – unabhängig; ihr Fehlen führt zu einer Unterdrückung des Triebes, der nun kein Objekt mehr findet, und das führt wiederum zu einer »Triebstauung«, deren schließliche Entladung um so gefährlicher sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
