        "fr-extract.jsonl": [
            {
                "entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                "word": "sincèrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                        "entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                        "glosses": [
                            "Avec sincérité; d'une manière sincère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624313d6-f933-4db9-b84c-47f1918fd8cd",
                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                "text": "Des fautes si sincèrement senties et dans la suite si glorieusement réparées,"
                            },
                            {
                                "example_id": "8f4f1a49-fbf5-4d78-9add-e7548a8f2b7b",
                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                "text": "Il jugera chaque homme selon la loi qu’il aura sincèrement admise,"
                            },
                            {
                                "example_id": "4952fb26-747d-48db-94a3-a5e06b740cb6",
                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                "text": "Toutefois, si un magnanime sentiment de fraternité s'imposait sincèrement et définitivement, sans arrière pensée, à tous les esprits européens, alors nous n'aurions pas à nous inquiéter du cosmopolitisme marseillais, intéressant embryon de la civilisation future."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "479081c9-daee-4b9b-8f04-5b32e2d3558d",
                        "source_entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                        "source_sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                        "target_lang_word": "herzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                        "entry_id": "e6c52fc0-0e1a-3391-ae2f-80597d727dee",
                                        "glosses": [
                                            "freundlich gesinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec705a7-5eb8-461f-a24b-ae0a8b62c597",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "Sie wurde am Bahnhof von der Tante herzlich empfangen."
                                            },
                                            {
                                                "example_id": "764f2cc8-9bec-4019-8697-e68a6195fa7a",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "Er wünschte ihr herzliche Glückwünsche zum Geburtstag."
                                            },
                                            {
                                                "example_id": "22f4acf6-2a01-4adb-a123-fe4fbc6f4dbd",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "„Freddie begrüßte seinen Bruder mit einer herzlichen Umarmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                        "entry_id": "e6c52fc0-0e1a-3391-ae2f-80597d727dee",
                                        "glosses": [
                                            "ziemlich, sehr"
                                        ],
                                        "tags": [
                                            "verstärkend",
                                            "bei Adjektiven und Verben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77a4663-9dfe-44bb-bb22-e6805cf3da4b",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "Der Schüler wusste bei der Prüfung herzlich wenig vom Lehrstoff."
                                            },
                                            {
                                                "example_id": "c6de4dbb-e58c-4255-9b5e-db423124f50f",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "Das tut mir aber herzlich leid."
                                            },
                                            {
                                                "example_id": "a7a22175-247f-4251-8c9b-c7892edcdc4d",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "„Den Schweden ist das EuGH-Urteil zur Arbeitszeiterfassung herzlich egal. Denn sie machen schon heute kaum Überstunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7cf397-2e7d-47ba-849c-ce01ebc09477",
                        "source_entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                        "source_sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                        "target_lang_word": "genuinely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genuinely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69a61f77-b4b9-34f0-8db9-7a464e393272",
                                        "entry_id": "25bc0e96-7b46-3c27-bd33-b4e3335fb1ed",
                                        "glosses": [
                                            "In a genuine manner; truthfully, truly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2591be-5fa3-4ba2-af4a-44ab9174a5ab",
                                                "sense_id": "69a61f77-b4b9-34f0-8db9-7a464e393272",
                                                "text": "I thought they were joking at first, but it seemed they were genuinely interested in the talk about glaciers."
                                            },
                                            {
                                                "example_id": "29d41d27-f5eb-457d-90ab-ef23b27775d4",
                                                "sense_id": "69a61f77-b4b9-34f0-8db9-7a464e393272",
                                                "text": "This was an emphatic performance and victory, the hosts controlling affairs from pretty much first to last in a display that suggested they are genuinely moving forward once again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "334cdf6b-6a65-4b8f-945d-b1d7f7edaa28",
                        "source_entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                        "source_sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                        "target_lang_word": "honestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "In an honest manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f47224-adce-4cba-b951-4f1d25aae945",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "He answered the questions honestly."
                                            },
                                            {
                                                "example_id": "dfd8017f-109d-4648-b244-05c9c5d7ea7f",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "You honestly quit your tools; quit a most muddy confused coil of sore work, short rations, of sorrows, dispiritments and contradictions, having now honestly done with it all; — and await, not entirely in a distracted manner, what the Supreme Powers, and the Silences and the Eternities may have to say to you."
                                            },
                                            {
                                                "example_id": "e8f7b1a5-4848-4bf5-9be4-717a53399ac4",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "I can't honestly say that I feel any elatement at the prospect."
                                            },
                                            {
                                                "example_id": "442f14ec-7a46-41b0-93fa-063d624a9ca6",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "Nevertheless, you must know (if I am to speak honestly to you) that I do not repent me those dallyings in enchanted fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "Frankly, to be honest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9a6216-1d40-4d3e-91b5-2237de473c20",
                                                "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                                "text": "Honestly, I didn't believe a word she said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                        "entry_id": "b4df50d1-7d4e-3216-b748-72ab564d082d",
                                        "glosses": [
                                            "Used to express exasperation, dismay, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd40b95-57cc-478f-83b5-28372d72cbab",
                                                "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                                "text": "Honestly! I want to finish this work and you keep interrupting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f7362a7-a13e-4e93-be00-60901a064225",
                        "source_entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                        "source_sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                        "target_lang_word": "really",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "In a way or manner that is real, not unreal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a8e63-d433-4df4-a07c-de3a4fbebb19",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "We are to believe that by an extraordinary Conception by Means of the holy Ghost he in an extraordinary MANNER, (unknown to us) really assumed Flesh, and was by her nourished in the Womb and in due Time born in a natural Manner, and that whilst on Earth he was really hungry, and dry, and eat and drank as really as other Men, without, any Deception of Sight in us or Delusion whatsoever."
                                            },
                                            {
                                                "example_id": "fa0b85b9-aad1-434e-97e7-65878e996862",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "If we take the phenomenal world as it strikes our senses, in all its varied and wonderful powers and aspects; as the mere symbol of the Divine Presence and power, that is, according to Christ, ever in, through, and over all, as really as are causal light, heat and gravity, or as really as our own life and souls pervade every atom of our bodies, [...]"
                                            },
                                            {
                                                "example_id": "0dfb3646-05b9-46a6-9777-5a4253706e6d",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "Thus Brahman must be described as ‘really real’, while a rope, or a person, or God Himself, is ‘unreally real’. And it is only the Vedantin who can distinguish the real from the unreal, for to others all seems real."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Actually; in fact; in reality."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f698d2fb-ec01-41af-be15-ab2d936c3910",
                                                "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                                "text": "\"He really is a true friend.\" / \"Really? What makes you so sure?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Very (modifying an adjective); very much (modifying a verb)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d557a52-0785-43dd-b374-4de4a1b158cf",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "But ma, I really, really want to go to the show!"
                                            },
                                            {
                                                "example_id": "61416a01-e612-4565-864e-21766212f3ea",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "9c904749-08ca-41ce-8dbc-8a0f46de71bd",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27dc7852-d518-4a8f-933d-341df701f6b9",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "A: He won the Nobel Prize yesterday."
                                            },
                                            {
                                                "example_id": "cd4159f2-67b5-4246-b76b-a74030122215",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "B: Really?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism.",
                                            "A phatic confirmation by a listener, to signal active listening; mostly devoid of literal meaning, with the phatically contrived incredulity being merely formulaic."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589720c6-b17e-4343-8b69-fcc8e76698d4",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "A: You know, I saw Oliver the other day."
                                            },
                                            {
                                                "example_id": "caa44746-8434-44f8-91aa-e16650ee6933",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "B: Really? What's he been up to?"
                                            },
                                            {
                                                "example_id": "68c7ad7c-b748-4256-98a2-9804592d98f3",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "\"Literally\" is not the only word that has lost touch with reality: look at \"really.\" That word also was meant to describe a state of reality, or literalness. Even as a substitute for \"Is that so?,\" the word asked, \"Is that true, or real?\" Nowadays, one guy goes, \"I literally flew off the handle,\" and the other guy goes \"Really.\" It's a grunt, meaning, \"I'm still here.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating that what was just said was obvious and unnecessary; contrived incredulity"
                                        ],
                                        "tags": [
                                            "informal",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815b625c-e932-440c-b2cc-9d439ef49ef9",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "A: I've just been reading Shakespeare - he's one of the best authors like, ever!"
                                            },
                                            {
                                                "example_id": "671c3f5e-a06e-4013-a1f1-438d0d0a8a65",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "B: Really."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating affirmation, agreement."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb27bef-c7c4-43f2-abe3-7a562e84913b",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "A: That girl talks about herself way too much."
                                            },
                                            {
                                                "example_id": "216152de-eaef-44ab-85ec-fa682d7c5d19",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "B: Really. She's a nightmare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating displeasure at another person's behaviour or statement."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887fb587-bf8b-4d56-a0b1-9a32fb658e15",
                                                "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                                "text": "Well, really! How rude."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                        "entry_id": "14bd7a7d-e7bd-3ac3-96f2-497367f55566",
                                        "glosses": [
                                            "Alternative form of re-ally."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5568d978-e346-421a-9359-efa3752f9b23",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "She wished since long to die and to be reallied with her children in heaven."
                                            },
                                            {
                                                "example_id": "87d4e24d-eb20-42eb-97c7-37dd5b43cef6",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "Following the election, those who had publicly opposed Harding hastened to really themselves with Republicans who had remained in the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
