                        "glosses": [
                            "Spécialiste de la psychoacoustique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a644fe7-d79e-406d-b3f8-e1abe56275d1",
                                "sense_id": "0a461a9f-7b3d-39d4-adbb-9b9f9d53f75b",
                                "text": "La psychoacousticienne Catherine Guastavino nous explique que le silence peut être interprété comme une absence de vie, ce qui crée une sensation de pression ou d’étouffement chez certaines personnes."
                            },
                            {
                                "example_id": "62433e6d-5156-4615-8929-4fc4b03e7b05",
                                "sense_id": "0a461a9f-7b3d-39d4-adbb-9b9f9d53f75b",
                                "text": "Les travaux de la psychoacousticienne Catherine Guastavino, professeure à l’Université McGill, permettent de saisir ces nuances en s’intéressant à la fois aux sons comme phénomènes physiques et à l’expérience sensible ressentie par des sujets qui les entendent."
                            }
                        ]
                    }
