                                        "glosses": [
                                            "Qui a été altéré dans le but de tromper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4645f701-607d-4626-8bed-4fe883f4825b",
                                                "sense_id": "b5f8b995-3ddb-35a7-b276-2dce633a6012",
                                                "text": "C’est ce que démontrent inversement les élections truquées de 2009, qui apportèrent à Mahmud Ahmadinejad un second mandat, et déclenchèrent de véhémentes protestations. Les gens n’aiment guère que leurs voix soient détournées."
                                            }
                                        ]
                                    }
                                ]
