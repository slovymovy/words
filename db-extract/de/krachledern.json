                ],
                "senses": [
                    {
                        "sense_id": "b89121f5-931c-3aa6-a7c3-b4fd0970f814",
                        "entry_id": "d564dc0c-01ac-3e3a-b5ec-cc011876a05c",
                        "glosses": [
                            "auf laute und direkte Art, ohne besondere Feinheiten oder Rücksichtnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2aa4e6-02fb-4a26-aea6-c5dff58af3f2",
                                "sense_id": "b89121f5-931c-3aa6-a7c3-b4fd0970f814",
                                "text": "„Temporeich und krachledern wurde gestritten und – von Dylan bis Mozart – gesungen, geflirtet und gestorben.“"
                            },
                            {
                                "example_id": "f80bf456-eee0-44a3-8c59-6923c50a49f9",
                                "sense_id": "b89121f5-931c-3aa6-a7c3-b4fd0970f814",
                                "text": "„Zwischen krachlederner Klamotte und selbstironischer Naivität ist der Roman angesiedelt, dessen Held bei Golf- und Liebesspiel erniedrigende Abfuhren erleidet.“"
                            },
                            {
                                "example_id": "0e64f1cd-4f7e-4709-8ee7-55afbf620db1",
                                "sense_id": "b89121f5-931c-3aa6-a7c3-b4fd0970f814",
                                "text": "„Auf den Stufen vor der Nibelungenhalle, dort, wo die CSU alljährlich zum Politischen Aschermittwoch einlädt und die Bayern bei Unmengen von Bier krachledern die rechten Werte lehrt, hocken junge, sehr junge Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
