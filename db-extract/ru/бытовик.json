                        "entry_id": "04e4d40b-1521-32d8-aa65-80a74b977854",
                        "glosses": [
                            "разг. автор произведений (писатель или художник), в которых изображается быт, повседневная жизнь; бытописатель"
                        ],
                        "tags": [],
                        "examples": [
                            {
