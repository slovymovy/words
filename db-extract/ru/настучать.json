                    },
                    {
                        "sense_id": "e2ec1c47-6220-3465-a6cc-43ab1311e822",
                        "entry_id": "2f0101ef-253e-3b5c-b7cf-d002fe91de6f",
                        "glosses": [
                            "жарг. сделать донос, донести на кого-либо"
                        ],
                        "tags": [],
