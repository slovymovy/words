                                                "example_id": "dd6347f0-7d22-4ac5-9ca0-f0691cdbe29b",
                                                "sense_id": "f901d97d-85e8-3bd1-9bb7-1bf93bd4d4b4",
                                                "text": "You have to push the switch hard to get the heater to kick in."
                                            },
                                            {
                                                "example_id": "718642b3-05dd-4596-9023-d6cd859720fc",
                                                "sense_id": "f901d97d-85e8-3bd1-9bb7-1bf93bd4d4b4",
                                                "text": "I took my medication an hour ago, and it hasn't kicked in yet."
                                            },
                                            {
                                                "example_id": "ecfaf751-1b5a-428b-b474-b23a3218bcfb",
                                                "sense_id": "f901d97d-85e8-3bd1-9bb7-1bf93bd4d4b4",
                                                "text": "People expect women [when they give birth] to have this instinct that kicks in."
                                            },
                                            {
                                                "example_id": "26d203e8-0283-4879-a43a-f6d20ab33d53",
                                                "sense_id": "f901d97d-85e8-3bd1-9bb7-1bf93bd4d4b4",
                                                "text": "Once the wet kicks in up north, you can be stranded for months waiting for swollen rivers to subside to a crossable depth[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e32ab3f-1e0c-3fb0-a07d-c05388bcdbb3",
                                        "entry_id": "5b7f678e-b409-3249-9e7a-bf22e87dc8ff",
                                        "glosses": [
                                            "To begin, contribute or join in on.",
                                            "To join or begin."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053b727c-e9b9-4152-afa3-88895f8e4ea2",
                                                "sense_id": "4e32ab3f-1e0c-3fb0-a07d-c05388bcdbb3",
                                                "text": "The rhythm section will kick in after that point."
                                            },
                                            {
                                                "example_id": "bd9f3845-0a56-4ea4-8b14-ea192737b3c5",
                                                "sense_id": "4e32ab3f-1e0c-3fb0-a07d-c05388bcdbb3",
                                                "text": "You should kick in on the work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e32a0e-bae8-3b14-be41-30d21ad420ae",
                                        "entry_id": "5b7f678e-b409-3249-9e7a-bf22e87dc8ff",
                                        "glosses": [
                                            "To begin, contribute or join in on.",
                                            "To contribute, especially to a collection of money; to hand over."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b202e498-de7f-43e7-aee1-2044b1ac7f1f",
                                                "sense_id": "48e32a0e-bae8-3b14-be41-30d21ad420ae",
                                                "text": "For the year-end party, we're asking each employee to kick in twenty dollars."
                                            },
                                            {
                                                "example_id": "9199e8d1-5e96-4be2-b828-e2ea66ff0666",
                                                "sense_id": "48e32a0e-bae8-3b14-be41-30d21ad420ae",
                                                "text": "This is a worthy charity, so everyone should kick in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117df558-0868-3852-a4e2-bf44c157e578",
                                        "entry_id": "5b7f678e-b409-3249-9e7a-bf22e87dc8ff",
                                        "glosses": [
                                            "To die; to give up on something."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98d3f01a-8ae0-4187-bbe8-f791226d9cb8",
                                                "sense_id": "117df558-0868-3852-a4e2-bf44c157e578",
                                                "text": "The business is going to kick in most likely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
