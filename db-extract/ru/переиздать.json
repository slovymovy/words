                "senses": [
                    {
                        "sense_id": "aa5a167b-e0e3-31e4-8243-f91b6d85a2e5",
                        "entry_id": "1abf5329-6d93-3e1d-ae3d-28564def55db",
                        "glosses": [
                            "издать снова, ещё раз"
                        ],
                        "tags": [],
