                "senses": [
                    {
                        "sense_id": "33d2e3fa-1dc2-3b8f-9f04-1bba4164c188",
                        "entry_id": "2e05a7a9-65b0-3887-ae04-d52c6e9be93f",
                        "glosses": [
                            "die Produktion einer Ware in hohen Stückzahlen mittels Einsatz von vorgefertigten, austauschbaren Einzelteilen und zeitlich genormten Arbeitsschritten in fest definierter Reihenfolge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e992d1c-badd-4401-8fe6-1c56233a2c72",
                                "sense_id": "33d2e3fa-1dc2-3b8f-9f04-1bba4164c188",
                                "text": "Die Massenproduktion macht unsere heutige Konsumgesellschaft erst möglich."
                            },
                            {
                                "example_id": "647cdb74-cc0b-4016-9e1b-e06d77ef161c",
                                "sense_id": "33d2e3fa-1dc2-3b8f-9f04-1bba4164c188",
                                "text": "„Die klassische Ära der industriellen Massenproduktion ist Geschichte, jedenfalls in Europa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3de1b382-6346-4ec2-a805-21790c66bcdc",
                        "source_entry_id": "2e05a7a9-65b0-3887-ae04-d52c6e9be93f",
                        "source_sense_id": "33d2e3fa-1dc2-3b8f-9f04-1bba4164c188",
