                "senses": [
                    {
                        "sense_id": "59236d8f-9a98-32c5-a055-03a023b22026",
                        "entry_id": "6fd2102d-3a5f-3258-82e8-37723ab40304",
                        "glosses": [
                            "door publieke media aan een zaak geschonken aandacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa7290f-2fbb-4823-bdb3-5306d6fe9485",
                                "sense_id": "59236d8f-9a98-32c5-a055-03a023b22026",
                                "text": "Er ontstond enorm veel publiciteit over deze zaak."
                            },
                            {
                                "example_id": "e3298e2f-a15a-45e8-87d1-48d7f63bfbb8",
                                "sense_id": "59236d8f-9a98-32c5-a055-03a023b22026",
                                "text": "Gerard Sanderinks ict-bedrijf Centric wankelt onder de aanhoudende stroom van slechte publiciteit. Die opmerkelijke bekentenis deed bestuursvoorzitter Louis Luijten maandagmorgen in de rechtszaal in Almelo."
                            }
                        ]
                    },
                    {
                        "sense_id": "8870ff67-7e5a-3c64-9356-237554efdf04",
                        "entry_id": "6fd2102d-3a5f-3258-82e8-37723ab40304",
                        "glosses": [
                            "openbaarheid, bekendheid"
                        ],
                        "tags": [],
                        "examples": []
                    },
