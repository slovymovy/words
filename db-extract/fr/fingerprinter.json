                "senses": [
                    {
                        "sense_id": "b876e5e5-32a4-320e-8ff5-30c22eb15ae3",
                        "entry_id": "a76c5621-9bc6-32de-85d4-8d8442c199b8",
                        "glosses": [
                            "Tenter de repérer un internaute, une application… grâce à des caractéristiques repérables (par exemple les caractéristiques précisées du navigateur utilisé, etc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b924d4-aefb-4af6-98d4-8191468bc62e",
                                "sense_id": "b876e5e5-32a4-320e-8ff5-30c22eb15ae3",
                                "text": "ils ont utilisé crawler un tool qui cherche des sqli (jamais utilisé) et google pour fingerprinter une vulnérabilité."
                            },
                            {
                                "example_id": "60ec5426-97ea-42fb-a703-59343d4d6a6d",
                                "sense_id": "b876e5e5-32a4-320e-8ff5-30c22eb15ae3",
                                "text": "Les différents \"outils\" ne se basent pas QUE sur la bannière pour \"fingerprinter\" les services..."
                            },
                            {
                                "example_id": "6cafce7f-8cae-4ed9-823e-9d022c664cdb",
                                "sense_id": "b876e5e5-32a4-320e-8ff5-30c22eb15ae3",
                                "text": "Il fingerprintera pas grand chose, sauf à avoir une sonde dédiée SOCKS5…"
                            },
                            {
                                "example_id": "0f700d7a-a1a8-42ce-9419-7955a947b0f2",
                                "sense_id": "b876e5e5-32a4-320e-8ff5-30c22eb15ae3",
                                "text": "Un attaquant, pour préparer de futures attaques, commence par reconnaître sa cible, chercher les machines, etc. Avec la synchronisation d’horloges, il peut, passivement, collecter des informations qui, par leur fréquence et leur contenu, permettent, entre autres, de fingerprinter des machines spécifiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "3de26476-65ac-3edb-9a63-353207d599ff",
                        "entry_id": "a76c5621-9bc6-32de-85d4-8d8442c199b8",
                        "glosses": [
                            "Permettre d’identifier une version particulière en lui attribuant une \\\"empreinte\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f51424ab-5d62-4c9a-998a-6bf22080ec72",
                                "sense_id": "3de26476-65ac-3edb-9a63-353207d599ff",
                                "text": "Pour “fingerprinter” les assets (en langage un peu plus humain : pour mettre un hash à la fin des noms de fichiers des javascripts, css et autres images) afin d’éviter qu’un navigateur n’utilise une version obsolète d’un fichier qu’il aurait gardé en cache, il suffit d’ajouter cette ligne à config.rb (dans le block configure :build) : activate :asset_hash"
                            }
                        ]
                    }
