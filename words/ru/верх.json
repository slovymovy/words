    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2112a7cb-bdc3-3170-b2b6-1ffec8fd34e1",
                    "sense_definition": "Самая высокая часть предмета, то, что находится выше остального; верхняя сторона или поверхность.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы наконец добрались до самого <w>верха</w> горы.",
                            "target_lang_translations": {
                                "en": "The tourists finally reached the very <w>top</w> of the mountain.",
                                "pl": "Turyści w końcu dotarli na sam <w>szczyt</w> góry."
                            }
                        },
                        {
                            "text": "<w>Верх</w> коробки был плотно заклеен скотчем.",
                            "target_lang_translations": {
                                "en": "The <w>top</w> of the box was tightly taped shut.",
                                "pl": "<w>Wierzch</w> pudełka był szczelnie zaklejony taśmą."
                            }
                        }
                    ],
                    "synonyms": [
                        "вершина"
                    ],
                    "antonyms": [
                        "низ"
                    ],
                    "common_phrases": [
                        "с верхом",
                        "на самый верх"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest part of an object, what is above the rest; the upper side or surface.",
                        "pl": "Najwyższa część przedmiotu, to, co znajduje się powyżej reszty; górna strona lub powierzchnia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "highest part"
                            },
                            {
                                "target_lang_word": "summit",
                                "target_lang_sense_clarification": "of a mountain"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "góra",
                                "target_lang_sense_clarification": "najwyższa część"
                            },
                            {
                                "target_lang_word": "wierzchołek",
                                "target_lang_sense_clarification": "szczyt góry lub drzewa"
                            },
                            {
                                "target_lang_word": "wierzch",
                                "target_lang_sense_clarification": "górna powierzchnia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2742d436-a8d1-3e44-a4a5-be2889310e5f",
                    "sense_definition": "Откидная или съёмная крыша автомобиля или экипажа.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы любим ездить на машине, опустив <w>верх</w>.",
                            "target_lang_translations": {
                                "en": "In summer, we like to drive with the <w>top</w> down.",
                                "pl": "Latem lubimy jeździć samochodem z otwartym <w>dachem</w>."
                            }
                        },
                        {
                            "text": "У этого кабриолета жёсткий <w>верх</w>, который складывается автоматически.",
                            "target_lang_translations": {
                                "en": "This convertible has a hard <w>top</w> that folds automatically.",
                                "pl": "Ten kabriolet ma twardy <w>dach</w>, który składa się automatycznie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "откидной верх",
                        "мягкий верх",
                        "опустить верх"
                    ],
                    "target_lang_definitions": {
                        "en": "A folding or removable roof of a car or carriage.",
                        "pl": "Składany lub zdejmowany dach samochodu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "convertible roof"
                            },
                            {
                                "target_lang_word": "hood",
                                "target_lang_sense_clarification": "convertible roof (UK)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dach",
                                "target_lang_sense_clarification": "w samochodzie typu kabriolet"
                            },
                            {
                                "target_lang_word": "składany dach",
                                "target_lang_sense_clarification": "mechanizm dachu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ac979b-ad2e-34b2-9ee4-f1075a3e2f14",
                    "sense_definition": "Высшая степень какого-либо качества или состояния.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это просто <w>верх</w> неприличия — приходить в гости без приглашения.",
                            "target_lang_translations": {
                                "en": "It is simply the <w>height</w> of indecency to visit without an invitation.",
                                "pl": "To po prostu <w>szczyt</w> nieprzyzwoitości — przychodzić w gości bez zaproszenia."
                            }
                        },
                        {
                            "text": "Его поведение в той ситуации было расценено как <w>верх</w> легкомыслия.",
                            "target_lang_translations": {
                                "en": "His behavior in that situation was regarded as the <w>height</w> of frivolity.",
                                "pl": "Jego zachowanie w tej sytuacji zostało ocenione jako <w>szczyt</w> lekkomyślności."
                            }
                        }
                    ],
                    "synonyms": [
                        "предел"
                    ],
                    "common_phrases": [
                        "верх глупости",
                        "верх совершенства",
                        "верх блаженства"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest degree of a quality or state.",
                        "pl": "Najwyższy stopień jakiejś cechy lub stanu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "height",
                                "target_lang_sense_clarification": "maximum degree"
                            },
                            {
                                "target_lang_word": "peak",
                                "target_lang_sense_clarification": "highest point of a state"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szczyt",
                                "target_lang_sense_clarification": "najwyższy punkt, np. szczyt głupoty"
                            },
                            {
                                "target_lang_word": "apogeum",
                                "target_lang_sense_clarification": "najwyższy punkt rozwoju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d48d5b-22bc-37d3-8888-8de85f9343e8",
                    "sense_definition": "Преобладание, победа над кем-либо в борьбе или споре (используется в устойчивых выражениях).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dominance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В жарком споре разум всё-таки взял <w>верх</w> над эмоциями.",
                            "target_lang_translations": {
                                "en": "In the heated argument, reason finally got the <w>upper hand</w> over emotions.",
                                "pl": "W gorącym sporze rozsądek w końcu <w>wziął górę</w> nad emocjami."
                            }
                        },
                        {
                            "text": "Наша команда одержала <w>верх</w> в этом непростом матче.",
                            "target_lang_translations": {
                                "en": "Our team gained the <w>upper hand</w> in this difficult match.",
                                "pl": "Nasza drużyna <w>wzięła górę</w> w tym trudnym meczu."
                            }
                        }
                    ],
                    "synonyms": [
                        "победа"
                    ],
                    "common_phrases": [
                        "взять верх",
                        "одержать верх"
                    ],
                    "target_lang_definitions": {
                        "en": "Prevalence, victory over someone in a struggle or dispute (used in set expressions).",
                        "pl": "Przewaga, zwycięstwo nad kimś w walce lub sporze (używane w wyrażeniach)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upper hand",
                                "target_lang_sense_clarification": "advantage or control"
                            },
                            {
                                "target_lang_word": "better",
                                "target_lang_sense_clarification": "to get the better of"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "góra",
                                "target_lang_sense_clarification": "w wyrażeniu 'wziąć górę'"
                            },
                            {
                                "target_lang_word": "przewaga",
                                "target_lang_sense_clarification": "dominacja nad kimś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62911f61-cbef-3a54-b8a6-8de6de4f14a8",
                    "sense_definition": "Люди, занимающие высокое общественное или служебное положение; руководство, правительство.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В политических <w>верхах</w> уже давно обсуждают этот новый законопроект.",
                            "target_lang_translations": {
                                "en": "In political <w>circles</w> they have long been discussing this new bill.",
                                "pl": "W politycznych <w>wyższych sferach</w> już dawno dyskutują o tym nowym projekcie ustawy."
                            }
                        },
                        {
                            "text": "Решение было принято где-то в <w>верхах</w>, а нам остаётся только исполнять.",
                            "target_lang_translations": {
                                "en": "The decision was made somewhere at the <w>top</w>, and we just have to execute it.",
                                "pl": "Decyzja została podjęta gdzieś na <w>górze</w>, a nam pozostaje tylko ją wykonać."
                            }
                        }
                    ],
                    "antonyms": [
                        "низ"
                    ],
                    "common_phrases": [
                        "в верхах",
                        "сигнал с верхов"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in media and conversation"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "People occupying high social or official positions; leadership, government.",
                        "pl": "Osoby zajmujące wysokie stanowiska społeczne lub urzędowe; kierownictwo, władze."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "higher-ups",
                                "target_lang_sense_clarification": "people in authority"
                            },
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "leadership level"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "góra",
                                "target_lang_sense_clarification": "potocznie o władzach lub kierownictwie"
                            },
                            {
                                "target_lang_word": "władze",
                                "target_lang_sense_clarification": "osoby decyzyjne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "723ec0b4-ba82-3723-8dea-0cbada3562a1",
                    "sense_definition": "Наружная часть одежды или обуви (в отличие от подкладки или подошвы).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этих зимних сапог кожаный <w>верх</w> и тёплая меховая подкладка.",
                            "target_lang_translations": {
                                "en": "These winter boots have a leather <w>upper</w> and a warm fur lining.",
                                "pl": "Te zimowe buty mają skórzany <w>wierzch</w> i ciepłą futrzaną podszewkę."
                            }
                        },
                        {
                            "text": "Портной аккуратно прострочил <w>верх</w> пальто, чтобы швы были ровными.",
                            "target_lang_translations": {
                                "en": "The tailor neatly stitched the <w>top</w> of the coat so the seams were even.",
                                "pl": "Krawiec starannie przeszył <w>wierzch</w> płaszcza, żeby szwy były równe."
                            }
                        }
                    ],
                    "antonyms": [
                        "подкладка"
                    ],
                    "common_phrases": [
                        "кожаный верх",
                        "текстильный верх"
                    ],
                    "target_lang_definitions": {
                        "en": "The outer part of clothing or footwear (as opposed to the lining or sole).",
                        "pl": "Zewnętrzna część odzieży lub obuwia (w przeciwieństwie do podszewki lub podeszwy)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upper",
                                "target_lang_sense_clarification": "of a shoe"
                            },
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "outer side"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wierzch",
                                "target_lang_sense_clarification": "zewnętrzna warstwa materiału"
                            },
                            {
                                "target_lang_word": "cholewka",
                                "target_lang_sense_clarification": "górna część buta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0fcd3b33-0c82-37e3-9a78-8e13a46a603f",
                    "sense_definition": "Деревня в Череповецком районе Вологодской области.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Моя бабушка родилась в маленькой деревне <w>Верх</w>.",
                            "target_lang_translations": {
                                "en": "My grandmother was born in the small village of <w>Verkh</w>.",
                                "pl": "Moja babcia urodziła się w małej wsi <w>Wierch</w>."
                            }
                        },
                        {
                            "text": "На карте области трудно найти населённый пункт с названием <w>Верх</w>.",
                            "target_lang_translations": {
                                "en": "It is difficult to find a settlement named <w>Verkh</w> on the region's map.",
                                "pl": "Na mapie obwodu trudno znaleźć miejscowość o nazwie <w>Wierch</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A village in the Cherepovets district of the Vologda region.",
                        "pl": "Wieś w rejonie czerepowieckim obwodu wołogodzkiego."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Verkh",
                                "target_lang_sense_clarification": "place name"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Wierch",
                                "target_lang_sense_clarification": "nazwa własna miejscowości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}