                "senses": [
                    {
                        "sense_id": "d880e6cb-ebff-3a76-b83a-384894e0aed1",
                        "entry_id": "a03493d7-a86a-39c3-932d-331c4ef08232",
                        "glosses": [
                            "innere Haltung, gegen etwas zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7087507c-61e5-4eb4-90b2-2d136e87b466",
                                "sense_id": "d880e6cb-ebff-3a76-b83a-384894e0aed1",
                                "text": "„Der Grund für seine Haltung war unbedingte Gegnerschaft zum verhassten Zarismus, in dem die SPD reinen Despotismus sah.“"
                            },
                            {
                                "example_id": "a9f55136-23af-4d8a-a208-cddd06237c07",
                                "sense_id": "d880e6cb-ebff-3a76-b83a-384894e0aed1",
                                "text": "„In beinahe offener Gegnerschaft hatte man sich getrennt.“"
                            },
                            {
                                "example_id": "a9cf5ad3-92e3-4d4d-b940-9ee4b54ec7ee",
                                "sense_id": "d880e6cb-ebff-3a76-b83a-384894e0aed1",
                                "text": "„In der Gegnerschaft zum Kapitalismus stand selbst die als unpolitisch geltende Lyrikerin Else Lasker-Schüler.“"
                            }
                        ],
