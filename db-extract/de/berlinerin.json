                "senses": [
                    {
                        "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                        "entry_id": "06746585-db57-305c-8e64-2f7aef064b6b",
                        "glosses": [
                            "eine in Berlin (Deutschland) geborene oder dort auf Dauer lebende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c110d220-211f-4acf-a1f4-0ca96bc9ede5",
                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                "text": "Jede Frau, die in Berlin das Wahlrecht hat, gilt als Berlinerin."
                            },
                            {
                                "example_id": "4773b357-70a1-4b63-bb01-a12e79191566",
                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                "text": "„Ich kannte einen Bühnenarbeiter, der einmal von einem Berliner beim Militär betrogen worden war und seitdem jeden Berliner und jede Berlinerin wie persönliche Feinde behandelte.“"
                            },
                            {
                                "example_id": "dd73919d-cbb1-42ca-a5a6-f35966dfecb8",
                                "sense_id": "d6e3b245-31ea-3927-b6b3-a60b79f0bee8",
                                "text": "„Im Sommer 1933 kam eine junge Berlinerin aufs Gut Kukehnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
