                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "eb2d255c-2656-3987-b1ca-d29bca0b12f0",
                    "sense_definition": "Vendre les actifs d'une société en difficulté pour payer ses créanciers et dissoudre l'entité.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "droit_affaires",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal de commerce a ordonné au mandataire de <w>liquider</w> l'entreprise en faillite."
                        },
                        {
                            "text": "Les associés ont voté pour <w>liquider</w> la société après plusieurs trimestres déficitaires."
                        }
                    ],
                    "synonyms": [
                        "dissoudre"
                    ],
                    "common_phrases": [
