                            }
                        },
                        {
                            "text": "Al vroeg in zijn dertiger jaren begon hij zichtbaar te veranderen, gestaag <w>grijzend</w>.",
                            "target_lang_translations": {
                                "de": "Schon früh in seinen Dreißigern begann er sich sichtlich zu verändern, stetig <w>ergrauend</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
