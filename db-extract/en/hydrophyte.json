                                        "glosses": [
                                            "Plante qui vit partiellement ou totalement immergée dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a503a9-18bb-4dff-8bed-cd0ae71007d5",
                                                "sense_id": "217c9048-9d78-334e-8ba4-e02f49da40c4",
                                                "text": "Nous signalerons aux basses eaux un curieux mélange de l’association à Rorippa et des associations d’Hydrophytes temporairement exondées […]"
                                            },
                                            {
                                                "example_id": "7324bcde-e292-4130-a860-6643dbb84a2e",
                                                "sense_id": "217c9048-9d78-334e-8ba4-e02f49da40c4",
                                                "text": "Ne le lâchons pas d’une plume, et avec quelle facilité il surfe sur les masses d’air, avec quelle aisance somptueuse, tandis qu’au-dessous de lui le fleuve coule toujours qui tresse son eau parmi les pierres et les herbes des rives, décoiffant quelques hydrophytes à son passage, courant vers l’estuaire, aspiré par l’idée de la mer, tout là-bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc39db0-8ff7-3051-99d4-c7e65b6132d9",
                                        "entry_id": "06668c2a-0f32-3edb-981e-c09a6a6dcbba",
                                        "glosses": [
                                            "Plante survivant immergée à la mauvaise saison."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "Le terme est parfois cité comme un des types biologiques de la classification de Raunkier",
                                        "examples": []
                                    }
                                ]
                            }
                        ]
