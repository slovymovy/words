                                        "glosses": [
                                            "jemanden faszinieren, in sich verliebt machen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbeee82-95f2-4600-bbf2-294cc98f2b88",
                                                "sense_id": "a970c2fc-1848-37da-a1ff-9a5f4f66a6d5",
                                                "text": "Der Blick, den Ina Konstantin über den Tisch hinweg zuwarf, betörte ihn."
                                            },
                                            {
                                                "example_id": "1b86a2c3-1a82-4856-bfa3-e66cfd0c644a",
                                                "sense_id": "a970c2fc-1848-37da-a1ff-9a5f4f66a6d5",
                                                "text": "Es war von Anfang an Paulas Plan gewesen, Waldemar zu betören."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cf41524-eb68-37f7-a93f-0e505dca38b2",
                                        "entry_id": "c9ff1026-1cc0-3c7d-b883-f6833af646ee",
                                        "glosses": [
                                            "jemanden seines nüchternen Verstandes berauben, ihn zu etwas hinreißen oder verführen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73eca3d7-0919-4c9f-a612-ff67e4e467e2",
                                                "sense_id": "7cf41524-eb68-37f7-a93f-0e505dca38b2",
                                                "text": "Angesichts dieser riesigen Auswahl ist es schwierig, eine Entscheidung zu treffen. Man ist von allem betört."
                                            },
                                            {
                                                "example_id": "86b3797a-4264-4f09-8a35-a12bebc52391",
                                                "sense_id": "7cf41524-eb68-37f7-a93f-0e505dca38b2",
                                                "text": "Männer lassen sich gern von schnellen Autos betören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "37cfa96b-d890-3f76-bed8-9db60ab50771",
                                        "entry_id": "c9ff1026-1cc0-3c7d-b883-f6833af646ee",
                                        "glosses": [
