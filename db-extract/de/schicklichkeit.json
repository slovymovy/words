                "senses": [
                    {
                        "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                        "entry_id": "5aabcabf-3ac9-34b3-956f-2b57d1334fb1",
                        "glosses": [
                            "Angemessenheit zur Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e34465b-5c3a-4876-9403-419115db53d8",
                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                "text": "Also war sie bei offiziellen Anlässen stets von vortrefflicher Schicklichkeit."
                            },
                            {
                                "example_id": "b5bdc646-2beb-4a99-85c6-2d3387ac4972",
                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                "text": "„Der Schicklichkeit halber blickte die Contessa ihren Gatten an, und dieser sagte sogleich, er sei bereit und einverstanden, selbst wenn ich mir vorgenommen hätte, die ganze Familie zu entführen.“"
                            },
                            {
                                "example_id": "6f556f8d-4b75-4616-99ba-2c3ffd88e9a2",
                                "sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                                "text": "„Man soll die Schicklichkeit wahren, aber der Begriff des Schicklichen ändert sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "593d5620-cf6a-45bd-8b85-7d73168e786b",
                        "source_entry_id": "5aabcabf-3ac9-34b3-956f-2b57d1334fb1",
                        "source_sense_id": "0ad49aca-0b94-310b-bf3b-6221c49f08a9",
                        "source_sense_description": "Angemessenheit zur Situation",
                        "target_lang_word": "decency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                                        "entry_id": "72ca3f99-94d3-30d2-9b24-633cfd3ff10a",
                                        "glosses": [
                                            "The quality of being decent; propriety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051970cb-3611-4096-846f-ef4f94b1f4b0",
                                                "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                                                "text": "Immodest words admit of no defence, / For want of decency is want of sense."
                                            },
                                            {
                                                "example_id": "a0d5ba28-361b-47b0-a482-aa8f391d87b9",
                                                "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                                                "text": "Indeed it is for the moſt part in our ſkill in manners, and in the obſervances of time and place, and of decency in general, which is only to be learned in thoſe ſchools to which Horace recommends us, that what is called Taſte by way of diſtinction, conſiſts; and which is in reality no other than a more refined judgment."
                                            },
                                            {
                                                "example_id": "7a0957a6-48bf-469a-b4cc-5878ecadaacb",
                                                "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                                                "text": "[To Joseph McCarthy:] Have you no sense of decency, sir? At long last, have you left no sense of decency?"
                                            },
                                            {
                                                "example_id": "4d26357c-1ffb-43a5-8984-92b1f5edfece",
                                                "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                                                "text": "Now, what is interesting about that poem is nothing. But, what is relevant about it is that his muse is his wife, Marcela, who is 42 years younger than him. He is 75, she is 33. And I’ll say this, at least when 70-something American politicians get creepily handsy with 30-something women, they have the decency to do so with their own daughters. Have some class, Brazil! Have some class!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9201ca7d-1269-3d8a-ab4a-a2da0804b0e8",
                                        "entry_id": "72ca3f99-94d3-30d2-9b24-633cfd3ff10a",
                                        "glosses": [
                                            "That which is proper or becoming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f7f14e7-5d7e-456b-8985-05261906e841",
                                                "sense_id": "9201ca7d-1269-3d8a-ab4a-a2da0804b0e8",
                                                "text": "Those thousand decencies, that daily flow / From all her words and actions."
                                            },
                                            {
                                                "example_id": "d5f2005d-65b5-4bab-8fe3-7a36b6be224c",
                                                "sense_id": "9201ca7d-1269-3d8a-ab4a-a2da0804b0e8",
                                                "text": "'Tis in the Civil Government, as in the Offices of Religion; which, were they ſtript of all the External Decencies of Worſhip, would not make a due Impreſſion on the Minds of thoſe who aſſiſt at them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
