                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72ea5dae-3c9b-4a2c-acda-f6d4d7df8c77",
                        "source_entry_id": "d2bd821a-897e-34c7-856d-9722a69459ed",
                        "source_sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                        "source_sense_description": "Sammelbegriff für verschiedene Diagnoseverfahren und Behandlungsmethoden, deren Wirksamkeit wissenschaftlich nicht belegt ist und die als Ergänzung oder Ersatz für Verfahren der Universitätsmedizin verstanden werden",
                        "target_lang_word": "alternative medicine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternative medicine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deadf734-bfda-3eed-b304-b475d64e7a91",
                                        "entry_id": "4d8a85a2-ed6c-392a-bb56-3a8ac31940d1",
                                        "glosses": [
                                            "Any of various pseudoscientific medical methods and practices used in place of, or as well as, conventional (scientific) medicine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d10ae5-7c6d-4447-87a3-1d339d2be47d",
                                                "sense_id": "deadf734-bfda-3eed-b304-b475d64e7a91",
                                                "text": "Unlike their conventional counterparts, practitioners of alternative medicine often excel at harnessing the placebo effect, says Dr Ernst."
                                            },
                                            {
                                                "example_id": "72dc5cf7-4a4d-47ce-8b05-de7e66daaa3b",
                                                "sense_id": "deadf734-bfda-3eed-b304-b475d64e7a91",
                                                "text": "“Such courses involve so-called 'complementary or alternative medicine' masquerading as, and sitting side-by-side with, evidence-based health-related science courses,” the letter said. It added that universities were risking their reputations by teaching courses like chiropractic, homeopathy, iridology and reflexology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae355fe-30ec-4a30-a1a5-0c9fb2fbdb53",
                        "source_entry_id": "d2bd821a-897e-34c7-856d-9722a69459ed",
                        "source_sense_id": "a15b9b15-6552-3c52-9ae7-48be18c00beb",
                        "source_sense_description": "Sammelbegriff für verschiedene Diagnoseverfahren und Behandlungsmethoden, deren Wirksamkeit wissenschaftlich nicht belegt ist und die als Ergänzung oder Ersatz für Verfahren der Universitätsmedizin verstanden werden",
                        "target_lang_word": "альтернативная медицина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "альтернативная медицина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "409ffab0-aa0a-3309-a43c-20bf703e14fe",
                                        "entry_id": "91e93542-5c81-3839-9ab1-4e82e156d1d4",
                                        "glosses": [
                                            "то же, что нетрадиционная медицина; собирательное название методов, претендующих на способность лечить (или предупреждать) болезни, эффективность и безопасность которых не была доказана научным методом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ccff52-9715-4cc9-8aa8-c0c5ed968a1c",
                                                "sense_id": "409ffab0-aa0a-3309-a43c-20bf703e14fe",
                                                "text": "С точки зрения государственной системы здравоохранения альтернативная медицина считается маргинальным направлением, однако все громче звучат требования интеграции традиционных и альтернативных подходов."
                                            }
                                        ]
                                    }
                                ]
                            }
