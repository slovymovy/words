                "senses": [
                    {
                        "sense_id": "edb5f626-6cb3-3426-8a32-d67bb12f853e",
                        "entry_id": "483623d7-be0e-3d12-a4ae-bb62e8d16c98",
                        "glosses": [
                            "Femme dont le métier consiste à damer la neige."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca76eda7-f920-39f4-ac11-3e2091618046",
                        "entry_id": "483623d7-be0e-3d12-a4ae-bb62e8d16c98",
                        "glosses": [
                            "Véhicule chenillé utilisé pour le damage des pistes de ski."
                        ],
                        "tags": [
                            "Sports d’hiver"
                        ],
                        "examples": [
                            {
                                "example_id": "3076a6dd-d233-4047-bd99-7cd15b6a0640",
                                "sense_id": "ca76eda7-f920-39f4-ac11-3e2091618046",
                                "text": "Le rôle de cet engin nettoyeur rappelle celui de la dameuse sur les pistes enneigées des stations."
                            },
                            {
                                "example_id": "4810bcdf-ad30-4045-b0f7-15424e5d5d84",
                                "sense_id": "ca76eda7-f920-39f4-ac11-3e2091618046",
                                "text": "Curieusement, le ski de fond est sous-exploité dans nos villes et banlieues, où l’équivalent d’une motoneige équipée comme une dameuse pourrait transformer des pistes cyclables en voies skiables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0290a956-5984-4a66-a002-9aefe796e677",
                        "source_entry_id": "483623d7-be0e-3d12-a4ae-bb62e8d16c98",
                        "source_sense_id": "ca76eda7-f920-39f4-ac11-3e2091618046",
                        "source_sense_description": "Engin utilisé pour damer",
                        "target_lang_word": "Pistenraupe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pistenraupe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                        "entry_id": "b973f55c-387c-3e4c-a1e9-d327db81f7f7",
                                        "glosses": [
                                            "vorwiegend in Skigebieten zum Präparieren von Skipisten, Loipen und Halfpipes sowie zum Transport eingesetztes Kettenfahrzeug, an dessen Vorderseite eine Schaufel (Räumschild) und an dessen Heck eine Fräse oder Walze angebracht sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802a2c91-d042-4721-8c62-5f6fab427f3f",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Es schnauben die Pistenraupen, durch die Drehgatter der Bergbahnhöfe drängen die Skifans, die Curler wischen wieder das Eis, die Hirsche kommen pünktlich zum Rendezvous mit den Pferdeschlittenfahrern, und abends ist Fondue-Party, Skilehrerball und Beat in der Tenne.“"
                                            },
                                            {
                                                "example_id": "9cc2cd92-46da-49bc-8071-c27667790127",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Doch in den letzten Jahren sind hier wie in Schweden die meisten Kronen in Lifts, Seilbahnen und Pistenraupen investiert worden.“"
                                            },
                                            {
                                                "example_id": "d8a89a73-cade-4d83-86a0-60227f04221b",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Aber auch Pistenraupen beschädigen die Vegetation stark, wenn sie die weiße Decke auf weniger als 30 Zentimeter zusammendrücken.“"
                                            },
                                            {
                                                "example_id": "5a06b8a6-145f-44ef-81d7-e6aa26bc7f8b",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Der Kunstschnee soll, so hat es der Skiclub angekündigt, an höchstens 20 Tagen in der Skisaison bei Bedarf aufgebracht werden, und zwar von einer mobilen Anlage aus, die auf einer Pistenraupe montiert ist.“"
                                            },
                                            {
                                                "example_id": "20b24512-706c-4f0b-b7e6-f05ccb675ea0",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Bis vor kurzem gab es Steilhänge, die konnte sogar eine noch so gut gebaute Pistenraupe nicht bearbeiten.“"
                                            },
                                            {
                                                "example_id": "f8a22053-a13c-4345-be54-d224581667ca",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Und der Aufwand, der für die Präparierung der Pisten notwendig ist, tut es ebenfalls: 300.000 Euro kostet eine moderne Pistenraupe, eine Schneekanone kommt auf immerhin 35.000 Euro.“"
                                            },
                                            {
                                                "example_id": "d934156f-a4fa-4680-909d-4a9700e7d8b8",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Auf dem Crap Sogn Gion kreuzt einsam eine Pistenraupe in den ersten Sonnenstrahlen des Tages. Schnaubt. Ächzt. Rasselt. 300 PS am Limit. Es ist 7 Uhr 50.“"
                                            },
                                            {
                                                "example_id": "79110b39-3f70-491a-8bc4-2a0e7cc36ae6",
                                                "sense_id": "e8e97194-5179-3808-a19f-5fb8977dd024",
                                                "text": "„Im Gegenteil: Der weiche, natürliche Schnee schafft Mehrarbeit für die Pistenraupen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
