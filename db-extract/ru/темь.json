                "senses": [
                    {
                        "sense_id": "11481066-ce7d-3139-a674-a9398e68c11a",
                        "entry_id": "c44668d7-969e-34d9-b4c3-a76370543100",
                        "glosses": [
                            "разг., поэт. темнота, отсутствие или недостаток света, освещения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8443f8e4-52c7-4aa1-9c4f-a45b0c247e6d",
                                "sense_id": "11481066-ce7d-3139-a674-a9398e68c11a",
                                "text": "И на его одухотворённое лицо упала уже окончательно наступившая вечерняя темь."
                            },
                            {
                                "example_id": "72dd8e7c-7216-43b6-92c7-87d52e554fce",
                                "sense_id": "11481066-ce7d-3139-a674-a9398e68c11a",
                                "text": "Болезненный кошмар отступил в темь ночи, и я снова мог думать."
                            },
                            {
                                "example_id": "a3be9821-01f3-4884-bac9-164198f5031a",
                                "sense_id": "11481066-ce7d-3139-a674-a9398e68c11a",
                                "text": "В теми́ ночной тати бродят."
                            }
                        ]
                    }
                ],
