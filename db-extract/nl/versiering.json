                        "entry_id": "1d6c708d-d484-3379-8895-b3b1523e3a08",
                        "glosses": [
                            "iets aangebracht om het uiterlijk fraaier te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caabc805-dbb4-49b0-943e-6897ebacdfc7",
                                "sense_id": "4ea2b69b-d542-31fd-8f94-948abccfdb98",
                                "text": "Er werden versieringen aangebracht om het heuglijke feit te vieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd5ac829-7344-33b4-9644-0976b01d8d56",
                        "entry_id": "1d6c708d-d484-3379-8895-b3b1523e3a08",
                        "glosses": [
                            "een korte wijziging van de normale melodie om deze te verfraaien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0b5a9e-107d-4e6c-8675-b4181b717b68",
                                "sense_id": "cd5ac829-7344-33b4-9644-0976b01d8d56",
                                "text": "Trillers, voorslagen en mordenten zijn vooral in de Barok veelgebruikte versieringen."
                            }
                        ]
                    }
                ],
