                            },
                            {
                                "target_lang_word": "нахал",
                                "target_lang_sense_clarification": "бесцеремонный грубиян"
                            },
                            {
                                "target_lang_word": "грубиян",
                                "target_lang_sense_clarification": "невежливый человек"
                            }
                        ]
