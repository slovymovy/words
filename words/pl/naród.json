            "senses": [
                {
                    "sense_id": "3eaf1a3c-483b-31d2-9da2-40dcadb647ae",
                    "sense_definition": "Grupa ludzi, których łączy wspólna kultura, język, religia, historia lub pochodzenie etniczne, często zamieszkująca określone terytorium.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy <w>naród</w> ma prawo do posiadania swojego własnego państwa.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>народ</w> имеет право на собственное государство.",
                                "en": "Every <w>nation</w> has the right to have its own state."
                            }
                        },
                        {
                            "text": "Cały <w>naród</w> zjednoczył się w obliczu nadchodzącego zagrożenia.",
                            "target_lang_translations": {
                                "ru": "Весь <w>народ</w> объединился перед лицом надвигающейся угрозы.",
                                "en": "The whole <w>nation</w> united in the face of the approaching threat."
                            }
                        }
                    ],
                    "synonyms": [
                        "nacja"
                    ],
                    "common_phrases": [
                        "naród polski",
                        "ojciec narodu",
                        "zdrada narodu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, объединенных общей культурой, языком, религией, историей или этническим происхождением.",
                        "en": "A large body of people united by common descent, history, culture, language, or territory."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "этническая общность, население страны"
                            },
                            {
                                "target_lang_word": "нация",
                                "target_lang_sense_clarification": "историческая или политическая общность"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "nation",
                                "target_lang_sense_clarification": "historically or politically united community"
                            },
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "an ethnic or cultural group; populace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f0d5864-ea4e-324a-a4c7-89ab092d0e5d",
                    "sense_definition": "Duża liczba ludzi zgromadzona w jednym miejscu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ale <w>narodu</w> się tu zjechało na ten festyn!",
                            "target_lang_translations": {
                                "ru": "Сколько же <w>народу</w> съехалось на этот праздник!",
                                "en": "What a <w>crowd</w> showed up here for the festival!"
                            }
                        },
                        {
                            "text": "W centrum handlowym było tyle <w>narodu</w>, że trudno było przejść.",
                            "target_lang_translations": {
                                "ru": "В торговом центре было столько <w>народу</w>, что трудно было пройти.",
                                "en": "There were so many <w>people</w> in the shopping mall that it was hard to walk through."
                            }
                        }
                    ],
                    "synonyms": [
                        "tłum",
                        "ciżba",
                        "mrowie",
                        "rzesza"
                    ],
                    "common_phrases": [
