                        "glosses": [
                            "de mening over literatuur; de mening van iemand over wat literatuur is en wat niet en over wat literatuur zou moeten zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597dcaff-cf96-435e-a446-b686d8d13698",
                                "sense_id": "3c8c0b77-f01b-35a5-ba21-c24915f4b859",
                                "text": "De literatuuropvatting van Misja is een typisch negentiende-eeuwse, zoals die op de meeste Russische middelbare scholen nog altijd wordt onderwezen."
                            },
                            {
                                "example_id": "734f8204-a69d-4e94-ae4b-fa0d2591dc17",
                                "sense_id": "3c8c0b77-f01b-35a5-ba21-c24915f4b859",
                                "text": "Een boekwerk als dit bevat een uiteenlopend palet aan proza. Smaken verschillen, literatuuropvattingen verschillen. De ene lezer zal getroffen worden door F. B. Hotz, een ander door Couperus. Of door Raes, Hermans, Du Perron, Vandeloo of Vestdijk. Voor elk wat wils dus, de keuze is ruim genoeg. Een ideaal boek voor op het nachtkastje - als je liggend in bed tenminste in staat bent om een boek van 1810 gram vast te houden."
                            }
                        ]
                    }
