                        "glosses": [
                            "Celui qui astique quelque chose."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ce53a8ab-4d37-4d2a-9422-400cc3d69832",
                                "sense_id": "3965885d-ff8f-3638-bb28-a1bfe9881d31",
                                "text": "Il lui dit d'arrêter de mazouter le pingouin, il le qualifia même d’astiqueur de moignons pendant le jour, et d’obsédé sexuel durant la nuit."
                            },
                            {
                                "example_id": "00751022-fd6a-4b34-99af-01b0a6160714",
                                "sense_id": "3965885d-ff8f-3638-bb28-a1bfe9881d31",
                                "text": "Confronté au tas de fumiers qui parfume la planète, l’astiqueur de ciboires n'en a pas moins toujours foi en l'homme."
                            },
                            {
                                "example_id": "4f3a0c03-b3fa-4847-afb9-a8d7db9fcb29",
                                "sense_id": "3965885d-ff8f-3638-bb28-a1bfe9881d31",
                                "text": "Que fait-il là,nom d'un chien, lui qui ne va pas tarder à se promener avec un étui à violon sur le dos et se fera copieusement traiter d’astiqueur de boyau par ses camarades ?"
                            },
                            {
                                "example_id": "a3f655ea-3803-4459-9a69-53855314f380",
                                "sense_id": "3965885d-ff8f-3638-bb28-a1bfe9881d31",
                                "text": "L'année 1952 lève enfin le voile sur l'omniprésence de cette astiqueuse zélée ; Kim Il-sung présente à ses proches sa nouvelle épouse."
                            }
                        ]
                    }
