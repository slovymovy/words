                "senses": [
                    {
                        "sense_id": "ed19bee7-37fe-3ab5-8d09-85f4f63c1112",
                        "entry_id": "816ea7d3-3217-3049-85d9-733c7632df09",
                        "glosses": [
                            "Bouclier en forme de cœur ou de coquillage bivalve ouvert d’origine mauresque, utilisé en Espagne, composé de cuir encollés et de bois léger, et en usage jusqu’au XIXᵉ siècle dans la cavalerie mexicaine."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "8316e90b-a87b-4861-8232-fe20ed20460b",
                                "sense_id": "ed19bee7-37fe-3ab5-8d09-85f4f63c1112",
                                "text": "Nul ne sait rehausser une rondelle ou une adargue d’ornemens (sic) plus élégamment combinés, et aussi de ces entrelacs ingénieux où un trait ténu s’enroule, court, disparaît sans se rompre, puis reparaît."
                            },
                            {
                                "example_id": "cad6f54f-af4c-439a-99a8-9fb41c86e14e",
                                "sense_id": "ed19bee7-37fe-3ab5-8d09-85f4f63c1112",
                                "text": "Il discute la selle du Cid, l’adargue de Charles-Quint, l’épée de Ferdinand le Catholique, l’armure de don Juan d'Autriche, toutes ces armes célèbres enfin que la tradition a conservées, et qu’elle attribue, souvent avec raison, quelquefois à tort, aux grand rois et aux grands capitaines."
                            }
                        ]
                    }
                ],
