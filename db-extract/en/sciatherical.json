                "senses": [
                    {
                        "sense_id": "bc010b05-ba98-3f1f-a348-47d74b12ab3d",
                        "entry_id": "6bd6f2e7-8417-3fc9-b38c-146bfc06e048",
                        "glosses": [
                            "sciatheric"
