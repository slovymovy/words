                                        "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                        "entry_id": "01f75870-da29-315a-abd1-3cb9f2bde2a3",
                                        "glosses": [
                                            "Unité de mesure de longueur du Système international (SI), valant 10⁻¹ mètre, et dont le symbole est dm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce21f7b-4804-4d6b-b0b5-c50b63717378",
                                                "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                                "text": "Ajoutons que, sur un grand nombre de points, lorsque les sables superposés à la couche imperméable (crassun) ont peu d'épaisseur, on arrive à l'eau en creusant de quelques décimètres seulement."
                                            },
                                            {
                                                "example_id": "01c8633a-e7bb-4f07-8b99-6f955dc74921",
                                                "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                                "text": "Les traits des demi-centimètres devront être plus longs que ceux des millimètres, et plus courts que ceux des centimètres ; ces derniers seront aussi plus courts que ceux qui répondent aux décimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2b03a22-ca6a-38f4-852f-b31eda24fe3f",
                                        "entry_id": "01f75870-da29-315a-abd1-3cb9f2bde2a3",
                                        "glosses": [
                                            "Règle de bois ou de métal ayant cette mesure et servant pour les ouvrages de dessin. Cette règle mesure souvent deux décimètres et s’appelle alors double décimètre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
