                                            {
                                                "example_id": "f25924e3-c632-4e2c-b7ca-65928d812c0c",
                                                "sense_id": "02a0f566-da5c-3d7a-9c6e-1f0609c7780d",
                                                "text": "Čeká svatý rebe reb Mélech, až si host nabere lžíci polévky a zatímco tu plnou lžíci zvedá k svým svatým ústům, opatrně, aby mu ani kapka neukápla, noří zase pomalounku on, totiž náš svatý rebe reb Mélech, svou lžíci do polévky, a teď zase čeká jeho svatý host, až si rebe reb Mílech nabere, a tak to jde neustále."
                                            },
                                            {
                                                "example_id": "bcfda2c8-11ea-4050-8e93-f52163a6cd62",
                                                "sense_id": "02a0f566-da5c-3d7a-9c6e-1f0609c7780d",
                                                "text": "Sedm plných lžic polévky již pojedl svatý rebe reb Mélech. Nyní si chce svatý reb Mendele nabrat osmou lžíci, neb teď je právě on na řadě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac5cba6-8ce7-35b8-9024-10138fc41d43",
                                        "entry_id": "2011c7a2-b92b-3b7c-93fe-1d164cd56cb5",
