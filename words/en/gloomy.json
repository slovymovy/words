{
    "word_family": [
        "gloom",
        "gloomily",
        "gloominess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1ac3448-a0f6-340c-bb97-7df4d556880f",
                    "sense_definition": "Dimly lit or dark in a way that feels depressing or frightening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old castle was filled with <w>gloomy</w> corridors that made the children feel uneasy.",
                            "target_lang_translations": {
                                "ru": "Старый замок был полон <w>мрачных</w> коридоров, от которых детям было не по себе."
                            }
                        },
                        {
                            "text": "It was a <w>gloomy</w> winter day with thick clouds blocking any sign of the sun.",
                            "target_lang_translations": {
                                "ru": "Это был <w>хмурый</w> зимний день с густыми тучами, закрывающими любые признаки солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "dim",
                        "dark",
                        "murky",
                        "somber",
                        "sunless"
                    ],
                    "antonyms": [
                        "bright",
                        "sunny",
                        "well-lit"
                    ],
                    "common_phrases": [
                        "gloomy winter day",
                        "gloomy corridor",
                        "gloomy weather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабо освещенный или темный, вызывающий чувство подавленности или страха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "о месте или погоде"
                            },
                            {
                                "target_lang_word": "хмурый",
                                "target_lang_sense_clarification": "о небе или погоде"
                            },
                            {
                                "target_lang_word": "темный",
                                "target_lang_sense_clarification": "лишенный света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1039e8a6-31c7-32d6-b92d-7fe26fa7c71c",
                    "sense_definition": "Feeling or showing a lack of hope; sad, pessimistic, or depressed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the good news, he remained in a <w>gloomy</w> mood for the rest of the evening.",
                            "target_lang_translations": {
                                "ru": "Несмотря на хорошие новости, он оставался в <w>мрачном</w> настроении до конца вечера."
                            }
                        },
                        {
                            "text": "The economic <w>gloomy</w> outlook suggested that many people might lose their jobs next year.",
                            "target_lang_translations": {
                                "ru": "<w>Пессимистичный</w> экономический прогноз указывал на то, что в следующем году многие люди могут потерять работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "melancholy",
                        "dejected",
                        "miserable",
                        "pessimistic",
                        "glum"
                    ],
                    "antonyms": [
                        "cheerful",
                        "optimistic",
                        "happy"
                    ],
                    "common_phrases": [
                        "gloomy outlook",
                        "gloomy mood",
                        "gloomy expression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий отсутствие надежды; грустный, пессимистичный или подавленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "о настроении или прогнозе"
                            },
                            {
                                "target_lang_word": "унылый",
                                "target_lang_sense_clarification": "подавленный и печальный"
                            },
                            {
                                "target_lang_word": "угрюмый",
                                "target_lang_sense_clarification": "необщительный и хмурый"
                            },
                            {
                                "target_lang_word": "пессимистичный",
                                "target_lang_sense_clarification": "о взгляде на будущее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c28d7484-3786-3ff1-b7a6-d39cb6c96c4e",
                    "sense_definition": "A person who is habitually pessimistic or a member of a subculture characterized by dark clothing and a somber attitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet <w>gloomies</w> were predicting a total collapse of the system by midnight.",
                            "target_lang_translations": {
                                "ru": "Интернет-<w>пессимисты</w> предсказывали полный крах системы к полуночи."
                            }
                        },
                        {
                            "text": "He hung out with a group of <w>gloomies</w> who always wore black and listened to sad music.",
                            "target_lang_translations": {
                                "ru": "Он тусовался с компанией <w>мрачных ребят</w>, которые всегда носили черное и слушали грустную музыку."
                            }
                        }
                    ],
                    "synonyms": [
                        "pessimist"
                    ],
                    "antonyms": [
                        "optimist"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe people with a specific pessimistic attitude or style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который постоянно настроен пессимистично, или представитель субкультуры, отличающийся темной одеждой и мрачным поведением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пессимист",
                                "target_lang_sense_clarification": "человек, ожидающий худшего"
                            },
                            {
                                "target_lang_word": "нытик",
                                "target_lang_sense_clarification": "разговорное, о вечно недовольном человеке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}