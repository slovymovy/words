                        "examples": [
                            {
                                "example_id": "2a6432ef-2778-4d21-918a-9686e61659f9",
                                "sense_id": "3d895536-3111-393e-b3ca-b1255a0fcb62",
                                "text": "Roger Federer is de jacht op zijn zevende Wimbledon-titel goed begonnen. De Zwitserse nummer drie van de wereld liet op baan 1 de Spaanse gravelbijter Albert Ramos totaal kansloos: 6-1, 6-1, 6-1."
                            },
                            {
                                "example_id": "f98c1b61-a289-4602-9e4d-6278da145dab",
                                "sense_id": "3d895536-3111-393e-b3ca-b1255a0fcb62",
                                "text": "Thiemo de Bakker heeft in de achtste finales van het toernooi in Barcelona voor een daverende verrassing gezorgd door gravelbijter Juan Carlos Ferrero te verslaan."
                            },
                            {
                                "example_id": "2d45b719-3a2b-40d3-a93e-ed492130534b",
                                "sense_id": "3d895536-3111-393e-b3ca-b1255a0fcb62",
                                "text": "De Argentijnse nummer veertien van de wereld verkeert in topvorm; hij won dit jaar al twee toernooien. Toch had Monaco veel te stellen met Haase, die knap de eerste set pakte. In het vervolg had de Hagenaar echter geen antwoord op het spelletje van de gravelbijter bij uitstek."
                            }
                        ]
                    }
