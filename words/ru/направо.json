                    "sense_id": "fed57f01-2b6b-3da0-8b7d-ac6f57d8dd13",
                    "sense_definition": "В правую сторону; по направлению к правой руке.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На следующем перекрёстке вам нужно повернуть <w>направо</w>.",
                            "target_lang_translations": {
                                "en": "At the next intersection you need to turn <w>right</w>.",
                                "nl": "Bij het volgende kruispunt moet u <w>rechtsaf</w> slaan.",
                                "pl": "Na następnym skrzyżowaniu musisz skręcić <w>w prawo</w>.",
                                "de": "An der nächsten Kreuzung müssen Sie <w>nach rechts</w> abbiegen.",
                                "fr": "Au prochain carrefour, vous devez tourner <w>à droite</w>.",
                                "it": "Al prossimo incrocio deve girare <w>a destra</w>.",
                                "cs": "Na příští křižovatce musíte zahnout <w>doprava</w>.",
                                "tr": "Bir sonraki kavşaktan <w>sağa</w> dönmeniz gerekiyor.",
                                "es": "En el siguiente cruce debe girar <w>a la derecha</w>.",
                                "zh": "在下一个路口你需要<w>向右</w>转。"
                            }
                        },
                        {
                            "text": "Если вы посмотрите <w>направо</w>, то увидите старый парк.",
                            "target_lang_translations": {
                                "en": "If you look <w>to the right</w>, you will see an old park.",
                                "nl": "Als u <w>naar rechts</w> kijkt, ziet u een oud park.",
                                "pl": "Jeśli spojrzysz <w>w prawo</w>, zobaczysz stary park.",
                                "de": "Wenn Sie <w>nach rechts</w> schauen, sehen Sie einen alten Park.",
                                "fr": "Si vous regardez <w>à droite</w>, vous verrez un vieux parc.",
                                "it": "Se guarda <w>a destra</w>, vedrà un vecchio parco.",
                                "cs": "Pokud se podíváte <w>doprava</w>, uvidíte starý park.",
                                "tr": "Eğer <w>sağa</w> bakarsanız, eski bir park göreceksiniz.",
                                "es": "Si mira <w>a la derecha</w>, verá un parque antiguo.",
                                "zh": "如果你往<w>右边</w>看，就能看到一个老公园。"
                            }
                        }
