                                "target_senses": [
                                    {
                                        "sense_id": "eeb3a099-7d75-3c25-a1d7-5417405c29c9",
                                        "entry_id": "78f54dbc-dd3e-39de-a552-a67f229f0ecf",
                                        "glosses": [
                                            "spezielle Bass-Lautsprecherbox an einer Stereo- oder Heimkinoanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9ead8a-5c0d-46e0-8d3f-1e46c1c8eb1e",
                                                "sense_id": "eeb3a099-7d75-3c25-a1d7-5417405c29c9",
                                                "text": "„Tuner und CD-Wechsler sind von Alpine, Subwoofer und Verstärker von Infinity und die Lautsprecher von Magnat. Den respektablen Gewinn nahm Ulrich Klein jetzt beim Media Markt in Mannheim-Neckarau in Empfang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b40f340-a210-4913-90c4-7d6562fdbc22",
                        "source_entry_id": "4478d456-deaf-308a-bb90-e9bdecb3b288",
                        "source_sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                        "source_sense_description": "a woofer dedicated to the reproduction of low-pitched audio frequencies",
                        "target_lang_word": "сабву́фер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сабву́фер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cf926048-abb2-303a-b880-bdc978de0ca8",
                                        "entry_id": "c4a8c25f-db4b-39b1-920b-54a69b74754b",
                                        "glosses": [
                                            "техн. отдельная низкочастотная колонка, низкочастотный динамик, воспроизводящая звук сверхнизкой частоты, включая инфразвук (от 5 Гц)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d74b3bf-f1a0-49d3-80b5-bc88f8a42b9c",
                                                "sense_id": "cf926048-abb2-303a-b880-bdc978de0ca8",
                                                "text": "Чтобы слушать многоканальный звук, которым сопровождаются современные фильмы, нужен набор акустики, состоящий из шести компонентов: двух фронтальных колонок, двух тыловых, одной центральной и низкочастотного сабвуфера."
                                            },
                                            {
                                                "example_id": "613a4bba-11a5-4378-84fe-3ca4ecffa137",
                                                "sense_id": "cf926048-abb2-303a-b880-bdc978de0ca8",
                                                "text": "Воспроизведение самых низких частот (до 150 Гц) стали поручать специальному излучателю ― сабвуферу. Сабвуфер в автомобиле даже для стереоустановок всего один, поскольку на указанных частотах стереоэффект отсутствует, ухом они не локализуются"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
