                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette forêt est gravement touchée par la maladie de l'<w>encre</w> depuis plusieurs années."
                        },
                        {
                            "text": "L'<w>encre</w> attaque les racines de l'arbre et provoque un dépérissement rapide des branches."
                        }
                    ],
                    "common_phrases": [
                        "maladie de l'encre"
                    ]
                }
            ]
        },
