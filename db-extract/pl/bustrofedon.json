                            },
                            {
                                "target_word": "boustrophedon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47aa0f3f-0c10-3561-bb2f-950f9f331e3c",
                                        "entry_id": "a5b47e67-57e9-3c86-9385-a493821bb998",
                                        "glosses": [
                                            "Written from right-to-left and left-to-right on alternate lines."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
