                                "target_senses": [
                                    {
                                        "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                        "entry_id": "5da8509c-95af-3aa1-8422-87b0dfc01fe6",
                                        "glosses": [
                                            "Gesamtheit aller unter einer Domain stehenden Webseiten"
                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79dd4b9e-98cd-460b-ae44-d197c6d0688e",
                                                "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                                "text": "Die Website war für kurze Zeit nicht erreichbar."
                                            },
                                            {
                                                "example_id": "76e0ee2b-a306-4d79-a427-33ea9c2f6583",
                                                "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                                "text": "„Das sei wahrer Sozialismus gewesen, jubelte er auf seiner Website.“"
                                            },
                                            {
                                                "example_id": "11bd5b92-2648-4ee4-802a-ad7aae0d09de",
                                                "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                                "text": "„Auf meinem Bildschirm ist noch eine andere Website geöffnet.“"
                                            },
                                            {
                                                "example_id": "67f02412-2294-4a1d-950d-fd5c7fc17d27",
                                                "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                                "text": "„Was ich sagen will: Bei den Fotos, den Videos, die wir überall sehen, auf den Katalogen und Websites der Bustouren und der Reiseanbieter, wird geschummelt.“"
                                            },
                                            {
                                                "example_id": "1d3f6bc8-8473-41a1-902d-31e3cb155992",
                                                "sense_id": "e2dcf18f-9aef-3111-821d-ebd19b1fe0ba",
                                                "text": "„Wir wollen wissen, was die BASF zu diesen Vorkommnissen sagt, und gehen als Erstes auf die Website des Unternehmens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
