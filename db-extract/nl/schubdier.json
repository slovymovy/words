                                        "entry_id": "df2830f8-dff9-3d15-96cf-8bc2719a20b2",
                                        "glosses": [
                                            "ein Säugetier mit geschupptem Panzer, nachtaktiv, Länge bis 1,10 m und Gewicht bis 18 kg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5ca225-5103-469d-9d29-18f96e926b82",
                                                "sense_id": "ea5e956a-85c5-3adc-b2df-49c096818158",
                                                "text": "Den großen Hornschuppen des Schuppentiers werden Heilkräfte zugesprochen, und auch ihr Fleisch ist begehrt, deshalb sind Schuppentiere vom Aussterben bedroht."
                                            },
                                            {
                                                "example_id": "11f30cd4-061d-4f98-aa7d-6ccc1ad4f655",
                                                "sense_id": "ea5e956a-85c5-3adc-b2df-49c096818158",
                                                "text": "Schuppentiere seien inzwischen die am häufigsten illegal gehandelten Säugetiere weltweit, so die Naturschützer."
                                            },
                                            {
                                                "example_id": "15595ae6-3ff5-4111-9862-e509e160d11f",
                                                "sense_id": "ea5e956a-85c5-3adc-b2df-49c096818158",
                                                "text": "Als ausgesprochene Futterspezialisten, die sich nur von Ameisen und Termiten ernähren, können die Schuppentiere lediglich in Gebieten leben, wo es genügend von diesen Insekten gibt."
                                            },
                                            {
                                                "example_id": "e2f85520-c85d-44d0-9978-63ee3d814b5b",
                                                "sense_id": "ea5e956a-85c5-3adc-b2df-49c096818158",
                                                "text": "„In der Vergangenheit kämpften sie vor allem gegen den Handel größerer Wildtierarten wie Elefanten, Nashörner oder Schuppentiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
