                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Het gehucht <w>Lakei</w> ligt verscholen in het Limburgse landschap.",
                            "target_lang_translations": {
                                "en": "The hamlet of <w>Lakei</w> lies hidden in the Limburg landscape."
                            }
                        },
                        {
                            "text": "Zij fietsten via rustige landwegen langs <w>Lakei</w> naar hun bestemming.",
                            "target_lang_translations": {
                                "en": "They cycled along quiet country roads past <w>Lakei</w> to their destination."
                            }
