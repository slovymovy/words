                                    {
                                        "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                                        "entry_id": "35066260-a080-379e-b87f-2fcab70485d3",
                                        "glosses": [
                                            "Lebensgemeinschaft verschiedener Arten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf23466-104a-4c21-8414-fb3faf53e607",
                                                "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                                                "text": "Den von einer Biozönose bevölkerten Raum nennt man Biotop."
                                            },
                                            {
                                                "example_id": "42f7f659-3562-4214-b8ae-ea0a1ede390a",
                                                "sense_id": "c3902057-2462-3bb1-bb02-9addfb870447",
                                                "text": "„Eine Biozönose ist die Gesamtheit der Organismen verschiedener Arten in einer lokalen Einheit, insbesondere insofern sie miteinander interagieren oder sogar ein System von wechselseitig voneinander abhängigen Populationen, d.h., oberhalb der Ebene der Organismen, ein organisiertes System zweiter Ordnung bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed0119d1-f61c-4794-9875-81ca859d6407",
                        "source_entry_id": "4ce5c78c-fc18-39b0-8c50-64a4bdb03d1d",
                        "source_sense_id": "df6c8682-e8c9-3f4a-be35-e7d748de3117",
                        "target_lang_word": "biocénose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biocénose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                        "entry_id": "975f7b69-4be1-31bb-add7-7f3b9ac74c5c",
                                        "glosses": [
                                            "Ensemble des êtres vivants rencontrés dans un biotope donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011f9f97-b180-4fcd-b822-a863944cba62",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "Notre avenir tient dans notre sagesse à réintégrer la biocénose, cette association harmonieuse entre toutes les espèces vivantes."
                                            },
                                            {
                                                "example_id": "171edbb3-359c-4c66-bbc3-ad6edff1a76d",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "La première conséquence de cette jeunesse des biocénoses est une pauvreté floristique marquée."
                                            },
                                            {
                                                "example_id": "d59a7f74-696c-444f-aea8-f4c2fec864c8",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "L’équilibre des biocénoses n’est donc pas statique mais dynamique, puisqu’il résulte des compétitions internes à la biocénose."
                                            },
                                            {
                                                "example_id": "1cee4833-373e-4425-9acd-cda5938bda35",
                                                "sense_id": "41754b99-611b-3989-a719-5394415d4153",
                                                "text": "La biocénose est étroitement liée au biotope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
