                            {
                                "example_id": "c1e3a4cd-9cee-42e0-8e6d-1bb9eb874e69",
                                "sense_id": "3853e063-4025-3718-a6e4-542269662bac",
                                "text": "„Ein Reporter vor Ort schilderte das Durcheinander von Menschen, Pferden, Maultieren und Bergen von Habseligkeiten. Tagelang saßen Männer, Frauen und Kinder unter freiem Himmel auf ihren Bündeln und warteten, bis sie an der Reihe waren. Ein Wagen nach dem anderen brach auf — Dutzende, Hunderte von Wagen, beladen mit Klavieren, Teppichen, schweren Möbeln, Thorarollen, Weizen und anderen Nahrungsmitteln. Sie hinterließen eine Fährte aus Tierexkrementen.“"
                            }
                        ],
