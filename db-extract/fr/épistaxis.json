        "fr-extract.jsonl": [
            {
                "entry_id": "dc2d7af9-a7d1-375f-8e87-8d79d8e7a584",
                "word": "épistaxis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b5833a4-5b32-3490-9e00-dd577b8aae53",
                        "entry_id": "dc2d7af9-a7d1-375f-8e87-8d79d8e7a584",
                        "glosses": [
                            "Écoulement de sang par les narines."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0e4521fb-80ed-42d7-8bb2-b29971990e8e",
                                "sense_id": "4b5833a4-5b32-3490-9e00-dd577b8aae53",
                                "text": "La Sandaraque impure des marchés arabes provient du Thuya et de divers Juniperus. On l'emploie en poudre pour arrêter les petites hémorragies de l’épistaxis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8b72ef4-7551-4064-811f-6711ea8f91fb",
                        "source_entry_id": "dc2d7af9-a7d1-375f-8e87-8d79d8e7a584",
                        "source_sense_id": "4b5833a4-5b32-3490-9e00-dd577b8aae53",
                        "target_lang_word": "Epistaxis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epistaxis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                        "entry_id": "e39727cf-7a55-36ce-9f8a-67f910ecc2de",
                                        "glosses": [
                                            "spontaner Austritt von Blut aus einem oder beiden Nasenlöchern; Nasenbluten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f06c46-16e7-4bc6-8e80-24a0c9179ddf",
                                                "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                                "text": "„Nasenbluten, medizinisch Epistaxis genannt, ist ein häufiges Phänomen, das Menschen in allen Altersgruppen betrifft.“"
                                            },
                                            {
                                                "example_id": "5f557e7b-19d8-42cb-8ff8-6c28a20df5b1",
                                                "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                                "text": "„Typische Symptome sind Epistaxis, Petechien, Hämatome, Schleimhautblutungen, perioperative Blutungen und Menorrhagien.“"
                                            },
                                            {
                                                "example_id": "6bc155f9-8700-490e-b5cd-5e572a274e7c",
                                                "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                                "text": "„Ein erstes Warnzeichen für ein Tumorgeschehen kann häufiges, starkes Nasenbluten (Epistaxis) sein, das bei Nasenpolypen normalerweise nicht auftritt.“"
                                            },
                                            {
                                                "example_id": "aae4dfc2-48f3-47e1-8e3e-be40a3eca219",
                                                "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                                "text": "„Eine Epistaxis kann als Folge einer entzündlicher, physischer oder chemischer Schädigung eines Gefäßes der vorderen Nasenscheidewand.“"
                                            },
                                            {
                                                "example_id": "ea9b9562-8dc8-4432-ad11-dbc86114a339",
                                                "sense_id": "0b73dcec-9b78-3ce1-8836-2cbe2d92ed1b",
                                                "text": "„Circa 60 Prozent der Menschen leiden jedoch mindestens ein Mal im Leben unter einer Epistaxis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
