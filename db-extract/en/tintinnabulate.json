                                        "glosses": [
                                            "Tinter avec un son argentin, aigu et léger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650d7f3a-c962-4054-bdf5-a414198105e2",
                                                "sense_id": "e8a0c6e2-48f0-3b9b-8c15-c0961dc0344e",
                                                "text": "Elle ne disait pas une phrase que mes oreilles ne fussent assourdies par ce mot qui tintinnabulait sans cesse et secouait sur moi l’agaçante et folle musique de ses mille grelots."
                                            },
                                            {
                                                "example_id": "a61a4a7a-1dd7-40dd-b875-a3f4a15e4d3d",
                                                "sense_id": "e8a0c6e2-48f0-3b9b-8c15-c0961dc0344e",
                                                "text": "Entends-tu les clochettes tintinnabuler ?"
                                            },
                                            {
                                                "example_id": "8a8d2063-a8ed-4e1d-9a81-4c883a8b8bcb",
                                                "sense_id": "e8a0c6e2-48f0-3b9b-8c15-c0961dc0344e",
                                                "text": "Toute la structure était pleine de billes d’acier et tintinnabulait doucement, comme une ville à son réveil"
                                            },
                                            {
                                                "example_id": "69746e6d-685d-433f-9dd0-533214e8327f",
                                                "sense_id": "e8a0c6e2-48f0-3b9b-8c15-c0961dc0344e",
                                                "text": "Little Richard se fraya un chemin, sa tirelire tintinnabulant désormais avec les pièces que Mary lui avait demandé de récupérer chez toutes les Vertes-âmes."
                                            }
                                        ]
                                    }
                                ]
