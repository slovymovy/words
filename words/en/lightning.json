{
    "word_family": [
        "light",
        "lighten",
        "enlighten",
        "lighter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                    "sense_definition": "A powerful flash of bright light in the sky produced by electricity, usually during a storm and followed by thunder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tree in the park was struck by <w>lightning</w> during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "В старое дерево в парке ударила <w>молния</w> во время сильной грозы.",
                                "zh": "暴风雨中，公园里的那棵老树被<w>闪电</w>击中了。"
                            }
                        },
                        {
                            "text": "We saw a sudden flash of <w>lightning</w> illuminate the dark sky.",
                            "target_lang_translations": {
                                "ru": "Мы увидели, как внезапная вспышка <w>молнии</w> осветила темное небо.",
                                "zh": "我们看到一道突如其来的<w>闪电</w>照亮了漆黑的夜空。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thunderbolt",
                        "bolt"
                    ],
                    "common_phrases": [
                        "flash of lightning",
                        "struck by lightning",
                        "lightning bolt",
                        "lightning storm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощная вспышка яркого света в небе, вызванная электричеством, обычно во время грозы и сопровождаемая громом.",
                        "zh": "在暴风雨中，由大气放电产生的强烈闪光，通常伴随着雷声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молния",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "грозовой разряд",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪电",
                                "target_lang_sense_clarification": "大气放电现象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe78ee6d-9d97-337b-88e7-28036893fb71",
                    "sense_definition": "Something or someone that moves or happens extremely quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner was absolute <w>lightning</w> on the track and easily won the race.",
                            "target_lang_translations": {
                                "ru": "Бегун был настоящей <w>молнией</w> на треке и легко выиграл гонку.",
                                "zh": "那名选手在赛道上跑得像<w>闪电</w>一样快，轻松赢得了比赛。"
                            }
                        },
                        {
                            "text": "He moved like <w>lightning</w> to catch the falling glass before it hit the floor.",
                            "target_lang_translations": {
                                "ru": "Он метнулся как <w>молния</w>, чтобы поймать падающий стакан, прежде чем тот ударится об пол.",
                                "zh": "他动作如<w>闪电</w>般迅速，在杯子落地前将其接住。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "like lightning",
                        "greased lightning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то или что-то, что движется или происходит чрезвычайно быстро.",
                        "zh": "形容动作或事物发生得极快。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молния",
                                "target_lang_sense_clarification": "метафора скорости"
                            },
                            {
                                "target_lang_word": "метеор",
                                "target_lang_sense_clarification": "о быстром человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪电",
                                "target_lang_sense_clarification": "比喻极快的速度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136d2b99-8471-36ab-bea0-857cbb64ec37",
                    "sense_definition": "A slang term for gin or strong spirits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender poured a glass of <w>lightning</w> for the weary traveler.",
                            "target_lang_translations": {
                                "ru": "Бармен налил стакан <w>самогона</w> уставшему путнику.",
                                "zh": "酒保为那位疲惫的旅人倒了一杯<w>烈酒</w>。"
                            }
                        },
                        {
                            "text": "He took a sip of the <w>lightning</w> and felt it burn all the way down.",
                            "target_lang_translations": {
                                "ru": "Он сделал глоток <w>самогона</w> и почувствовал, как тот обжигает всё внутри.",
                                "zh": "他抿了一口那杯<w>烈酒</w>，感觉它一路灼烧着滑入喉咙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "white lightning"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название джина или крепких спиртных напитков.",
                        "zh": "指代烈酒或私酿酒的俚语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самогон",
                                "target_lang_sense_clarification": "крепкий самодельный алкоголь"
                            },
                            {
                                "target_lang_word": "сивуха",
                                "target_lang_sense_clarification": "некачественный крепкий алкоголь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "私酿烈酒",
                                "target_lang_sense_clarification": "俚语，指强力酒精饮料"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a59c59df-8236-33fc-a6d4-b55494693514",
                    "sense_definition": "Happening or moving very quickly and suddenly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army launched a <w>lightning</w> attack that took the enemy by surprise.",
                            "target_lang_translations": {
                                "ru": "Армия начала <w>молниеносную</w> атаку, которая застала врага врасплох.",
                                "zh": "军队发动了一场<w>闪电</w>战，打得敌人措手不及。"
                            }
                        },
                        {
                            "text": "She has <w>lightning</w> reflexes which make her an excellent goalkeeper.",
                            "target_lang_translations": {
                                "ru": "У неё <w>молниеносная</w> реакция, что делает её отличным вратарём.",
                                "zh": "她有着<w>闪电</w>般的反应速度，这使她成为了一名出色的守门员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rapid",
                        "swift",
                        "instantaneous",
                        "sudden"
                    ],
                    "antonyms": [
                        "slow",
                        "sluggish"
                    ],
                    "common_phrases": [
                        "lightning speed",
                        "lightning fast",
                        "lightning reflexes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или движущийся очень быстро и внезапно.",
                        "zh": "形容发生或移动得非常迅速且突然。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молниеносный",
                                "target_lang_sense_clarification": "очень быстрый"
                            },
                            {
                                "target_lang_word": "мгновенный",
                                "target_lang_sense_clarification": "случающийся сразу же"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪电般的",
                                "target_lang_sense_clarification": "形容速度极快"
                            },
                            {
                                "target_lang_word": "迅雷不及掩耳的",
                                "target_lang_sense_clarification": "形容动作迅速且突然"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                    "sense_definition": "To produce flashes of lightning; usually used with 'it' as the subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stayed indoors because it thundered and <w>lightninged</w> throughout the night.",
                            "target_lang_translations": {
                                "ru": "Мы оставались дома, потому что всю ночь гремел гром и <w>сверкали молнии</w>.",
                                "zh": "我们整晚都待在室内，因为外面雷声隆隆，不断地<w>打闪</w>。"
                            }
                        },
                        {
                            "text": "It <w>lightninged</w> briefly in the distance, but the storm never reached us.",
                            "target_lang_translations": {
                                "ru": "Вдали немного <w>посверкало</w>, но гроза до нас так и не дошла.",
                                "zh": "远处偶尔<w>闪电</w>了几下，但那场暴风雨并没有波及我们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thundered and lightninged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверкать (о молнии); обычно используется в безличных предложениях.",
                        "zh": "指天空出现闪电现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверкать",
                                "target_lang_sense_clarification": "излучать яркий свет"
                            },
                            {
                                "target_lang_word": "сверкать молнией",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打闪",
                                "target_lang_sense_clarification": "气象用语"
                            },
                            {
                                "target_lang_word": "闪电",
                                "target_lang_sense_clarification": "指发生闪电现象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}