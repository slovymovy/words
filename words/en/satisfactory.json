{
    "word_family": [
        "satisfaction",
        "satisfy",
        "satisfactorily",
        "unsatisfactory",
        "dissatisfaction"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94ee79b4-16b9-3384-8480-d32735ca578e",
                    "sense_definition": "Meeting requirements or being good enough for a specific purpose; adequate.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adequacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student's performance was <w>satisfactory</w>, so he passed the final exam.",
                            "target_lang_translations": {
                                "ru": "Успеваемость студента была <w>удовлетворительной</w>, поэтому он сдал выпускной экзамен."
                            }
                        },
                        {
                            "text": "The company provided a <w>satisfactory</w> explanation for the delay in shipping.",
                            "target_lang_translations": {
                                "ru": "Компания предоставила <w>приемлемое</w> объяснение задержки отгрузки."
                            }
                        }
                    ],
                    "synonyms": [
                        "adequate",
                        "acceptable",
                        "sufficient",
                        "passable",
                        "decent"
                    ],
                    "antonyms": [
                        "unsatisfactory",
                        "inadequate",
                        "insufficient",
                        "poor"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Соответствующий требованиям или достаточно хороший для определенной цели; адекватный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворительный",
                                "target_lang_sense_clarification": "соответствующий требованиям"
                            },
                            {
                                "target_lang_word": "приемлемый",
                                "target_lang_sense_clarification": "допустимый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2de250cd-dd9e-319d-b508-0dc63eb7120b",
                    "sense_definition": "Giving pleasure or contentment; providing a sense of fulfillment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finishing a long project is a very <w>satisfactory</w> experience for any professional.",
                            "target_lang_translations": {
                                "ru": "Завершение долгого проекта — это опыт, <w>приносящий</w> большое <w>удовлетворение</w> любому профессионалу."
                            }
                        },
                        {
                            "text": "They found a <w>satisfactory</w> solution that made everyone in the group happy.",
                            "target_lang_translations": {
                                "ru": "Они нашли <w>удачное</w> решение, которое устроило всех в группе."
                            }
                        }
                    ],
                    "synonyms": [
                        "pleasing",
                        "gratifying",
                        "fulfilling"
                    ],
                    "antonyms": [
                        "disappointing",
                        "unsatisfactory"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Доставляющий удовольствие или удовлетворение; дающий чувство завершенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятный",
                                "target_lang_sense_clarification": "доставляющий удовольствие"
                            },
                            {
                                "target_lang_word": "приносящий удовлетворение",
                                "target_lang_sense_clarification": "дающий чувство выполненного дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdfd3039-3de6-3a14-a961-1019ab8507af",
                    "sense_definition": "Relating to the making of atonement or reparation for a sin or wrongdoing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theologian argued that the sacrifice was a <w>satisfactory</w> act of penance.",
                            "target_lang_translations": {
                                "ru": "Теолог утверждал, что жертва была <w>искупительным</w> актом покаяния."
                            }
                        },
                        {
                            "text": "In some religious contexts, a <w>satisfactory</w> prayer is required to seek forgiveness.",
                            "target_lang_translations": {
                                "ru": "В некоторых религиозных контекстах для искупления вины требуется <w>искупительная</w> молитва."
                            }
                        }
                    ],
                    "synonyms": [
                        "expiatory",
                        "atoning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "theological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искуплению или возмещению за грех или проступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искупительный",
                                "target_lang_sense_clarification": "в теологическом смысле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b4ebd31-793a-336e-b9b4-e1b7b1a3d7fa",
                    "sense_definition": "A grade or rating indicating that performance meets the required standard but does not exceed it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was disappointed to receive a <w>satisfactory</w> on his report card instead of an excellent.",
                            "target_lang_translations": {
                                "ru": "Он был разочарован, получив «<w>удовлетворительно</w>» в табеле вместо «отлично»."
                            }
                        },
                        {
                            "text": "The teacher marked the assignment as a <w>satisfactory</w> based on the rubric.",
                            "target_lang_translations": {
                                "ru": "Учитель оценил задание на «<w>удовлетворительно</w>» в соответствии с критериями."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценка или рейтинг, указывающий на то, что работа соответствует требуемому стандарту, но не превосходит его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворительно",
                                "target_lang_sense_clarification": "оценка в школе или вузе"
                            },
                            {
                                "target_lang_word": "зачет",
                                "target_lang_sense_clarification": "подтверждение выполнения требований"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "414c9b41-b4f1-3376-b5c1-9ad791a23bd0",
                    "sense_definition": "A person or thing that is considered adequate or meets basic requirements.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee divided the applicants into the <w>satisfactories</w> and the exceptional candidates.",
                            "target_lang_translations": {
                                "ru": "Комитет разделил абитуриентов на <w>средних</w> и исключительных кандидатов."
                            }
                        },
                        {
                            "text": "In this quality control test, we only keep the <w>satisfactories</w> for further processing.",
                            "target_lang_translations": {
                                "ru": "В этом тесте контроля качества мы оставляем только <w>годные</w> образцы для дальнейшей обработки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который считается адекватным или отвечающим базовым требованиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходящий вариант",
                                "target_lang_sense_clarification": "о предмете или кандидате"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}