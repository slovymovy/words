                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordvorm_kuisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kuis</w> je vandaag zelf je kamer of heb je daar geen tijd voor?",
                            "target_lang_translations": {
                                "fr": "<w>Nettoies</w>-tu ta chambre toi-même aujourd'hui, ou n'as-tu pas le temps ?"
                            }
                        },
                        {
                            "text": "Waarom <w>kuis</w> je die vuile schoenen niet even buiten?",
                            "target_lang_translations": {
                                "fr": "Pourquoi ne <w>nettoies</w>-tu pas ces chaussures sales dehors ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gangbaar in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "deuxième personne du singulier du présent de l'indicatif de « kuisen » avec inversion (nettoyer)"
                    },
                    "translations": {
