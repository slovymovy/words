                                                "sense_id": "3bab0e31-909c-34d5-840d-0cba8d0f4b5a",
                                                "text": "Wordsworth's distinctive work was a war with pomp and pretence, and a display of the majesty of simple feelings and humble hearts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae5a9ea-66ec-3c9c-8f9e-5042f8bb5961",
                                        "entry_id": "6e68f843-e0a5-3755-9176-7e4dad6029c9",
                                        "glosses": [
                                            "Distinguished, being distinct in character or position."
                                        ],
                                        "tags": [
