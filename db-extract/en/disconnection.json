                                    {
                                        "sense_id": "73ca315b-d681-364f-955d-f932cf0e7d39",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "materiell: Vorgang oder Ergebnis der Absonderung von Substanzen voneinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d498d7-862d-4f61-b44b-b37db39d7c91",
                                                "sense_id": "73ca315b-d681-364f-955d-f932cf0e7d39",
                                                "text": "Die Trennung der Substanzen in dem Gemisch war ein großen Problem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d38a754-2424-3546-900f-18abab73bb7c",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "persönlich: Vorgang oder Ergebnis der Auflösung einer persönlichen Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a833c02-8625-4297-91f1-04b554c95052",
                                                "sense_id": "2d38a754-2424-3546-900f-18abab73bb7c",
                                                "text": "Die Trennung von meinem Freund fiel mir schwer."
                                            },
                                            {
                                                "example_id": "68b7afbf-93d2-4d47-82e9-56f22591279f",
                                                "sense_id": "2d38a754-2424-3546-900f-18abab73bb7c",
                                                "text": "„Ich wusste auch, dass die Trennung nicht nur ein paar Tage dauern würde.“"
                                            },
                                            {
                                                "example_id": "b127e23e-6023-48bb-a37e-1e09f1dc750a",
                                                "sense_id": "2d38a754-2424-3546-900f-18abab73bb7c",
                                                "text": "„Natascha wäre vollkommen glücklich gewesen, wenn der Gedanke an die bevorstehende und immer näher rückende Trennung sie nicht erschreckt hätte, ein Gedanke, der auch ihn blasswerden und Kälteschauer verspüren liess.“"
                                            },
                                            {
                                                "example_id": "b34c6243-904d-4f3c-bf25-2180a59b714e",
                                                "sense_id": "2d38a754-2424-3546-900f-18abab73bb7c",
                                                "text": "„Dem alten Manne war die Trennung von dem lebhaften Franzosen augenscheinlich sehr schwergefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "345e52ca-71bf-3f48-bfdf-34acdf24837f",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "sozial: Vorgang oder Ergebnis der Auflösung einer sozialen Bindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544e7216-ddd3-4274-b1a5-616d25412209",
                                                "sense_id": "345e52ca-71bf-3f48-bfdf-34acdf24837f",
                                                "text": "Die Trennung von meinem Verein war ein notwendiger Schritt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "40b428cb-b95d-3eff-a5da-84ffee12eb4c",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "technisch: Vorgang oder Ergebnis der Auflösung einer technischen Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d03fd2-128e-427b-9502-7d469921bf93",
                                                "sense_id": "40b428cb-b95d-3eff-a5da-84ffee12eb4c",
                                                "text": "Durch die Trennung der Verbindung mit dem Korrespondenten konnte man leider nichts über den Vorfall erfahren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "97787e27-87e3-36d7-9be6-30bbbaa43f8f",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "wirtschaftlich: Vorgang oder Ergebnis der Auflösung einer betrieblichen Zusammenarbeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48bfb67f-a94c-4ab9-87d9-b0ca5a470ecf",
                                                "sense_id": "97787e27-87e3-36d7-9be6-30bbbaa43f8f",
                                                "text": "Die Trennung der Betriebe verursachte einen hohen organisatorischen Aufwand."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "653c6c4e-8610-390c-866b-b9b73c668530",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "Arbeitsrecht: Vorgang oder Ergebnis der Auflösung eines Arbeitsvertrags"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4938569-a849-47d0-a8b3-700069a79198",
                                                "sense_id": "653c6c4e-8610-390c-866b-b9b73c668530",
                                                "text": "Nach den Vorfällen war die Trennung von diesem Mitarbeiter unumgänglich."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "9e75841f-ca92-3574-98f8-a71b11c88501",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "Linguistik: kurz für Silbentrennung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456c0711-b870-4573-a319-cfc9055305c1",
                                                "sense_id": "9e75841f-ca92-3574-98f8-a71b11c88501",
                                                "text": "Die Rechtschreibreform brachte einige Änderungen auch bei der Trennung der Wörter mit sich."
                                            },
                                            {
                                                "example_id": "ccdf03be-1921-45d9-8e5c-151520c37a5a",
                                                "sense_id": "9e75841f-ca92-3574-98f8-a71b11c88501",
                                                "text": "„Für die Trennung der Wörter am Zeilenende gibt es zwei Grundprinzipien: Man trennt einfache Wörter nach Sprechsilben, wie sie sich beim langsamen Vorlesen ergeben, und man trennt zusammengesetzte Wörter und Wörter mit Präfixen (Vorsilben) nach ihren erkennbaren Bestandteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "0dbea591-294f-326a-9a82-9a1034fd6b99",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "Logik: möglichst klare Unterscheidung von Begriffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbf1808-5788-4ec2-991d-50c01961783c",
                                                "sense_id": "0dbea591-294f-326a-9a82-9a1034fd6b99",
                                                "text": "Eine saubere Trennung der verwendeten Begriffe ist eine Voraussetzung für systematisches Arbeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "7f27324d-e3e7-32bc-b878-1863d78deae6",
                                        "entry_id": "48b9ba28-fb8a-30f9-b3a6-129d0d5d83d1",
                                        "glosses": [
                                            "Politik: Vorgang oder Ergebnis der Auflösung einer staatlichen Gemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "247e19ab-f004-49ca-be44-1ee7ffc05d5c",
                                                "sense_id": "7f27324d-e3e7-32bc-b878-1863d78deae6",
                                                "text": "Kosovo strebt die Trennung von Serbien an."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352feeda-f4de-4fa4-a90b-acd23cff181a",
                        "source_entry_id": "f89ea0e0-9748-30ac-b582-4e2c520747ad",
                        "source_sense_id": "a65427d1-bbf2-3c96-9e8f-615028aa3a13",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Unterbrechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterbrechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4e85e7-627b-3a28-a28e-e1f34570df2e",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Zerteilung einer Verbindung; Öffnung einer Leitung, eines Rohres, eines Seils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdcab69-d2ca-431e-b73b-aa296bfcd0b8",
                                                "sense_id": "2d4e85e7-627b-3a28-a28e-e1f34570df2e",
                                                "text": "Die Unterbrechung im Leitungssystem führte zu einem Stromausfall."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Störung einer Kommunikation, eines Gesprächs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1668b79b-ed21-4eb9-ba14-88adef7f9db1",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "Bitte entschuldigen Sie die Unterbrechung, aber da ist jemand am Telefon für Sie."
                                            },
                                            {
                                                "example_id": "54a17ec1-e548-4c80-bd3b-61799f7fe377",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "Weitere Unterbrechungen werde ich in meinem Gerichtssaal nicht dulden."
                                            },
                                            {
                                                "example_id": "1476bb8c-7da1-43b3-bd64-ee478f97ba06",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "„Wiegand hat die Unterbrechung unwillig abgeschüttelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "kurzzeitige Aussetzung einer Handlung, um diese später wieder aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f047bf5-598f-4932-b56f-190c7c37e635",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Um zwölf Uhr gibt es eine kurze Unterbrechung, damit ihr alle mal zur Toilette gehen könnt."
                                            },
                                            {
                                                "example_id": "b84486c2-9380-4c5a-8465-29b727aea1a8",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Danach werden wir ohne Unterbrechung fortfahren."
                                            },
                                            {
                                                "example_id": "bf330d5e-c80a-45d0-b1a6-0f50b66e4f0d",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Das Unwetter führte zu einer längeren Unterbrechung der Versorgungsflüge."
                                            },
                                            {
                                                "example_id": "385a1789-480d-4098-8e5c-df2fc8136d22",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "„Jetzt wurde sehr schnell und ohne jede Unterbrechung marschiert und erst bei Sonnenuntergang wieder halt gemacht.“"
                                            },
                                            {
                                                "example_id": "3ba61431-6ff1-421b-b359-b04b3693fb45",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "„Da er sich der Behauptung von Raspail entsann, daß man durch Unterbrechung der Diät das Fieber herabdrücke, verordnete er Fleischbrühe und sogar ein wenig Fleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af2944ba-fb0c-3649-83a0-8cb7c25d4ae7",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Aussetzen einer vertraglich vereinbarten Frist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38e89df-6c95-483a-ad90-77c234191fe8",
                                                "sense_id": "af2944ba-fb0c-3649-83a0-8cb7c25d4ae7",
                                                "text": "Die rechtzeitige Schadensmeldung führt nicht zu einer Unterbrechung der Verjährungsfrist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "920cec29-c64c-32e1-973a-1b55a07065a3",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "kurzfristige Aussetzung eines Programms, um eine höherpriorisierte und damit zeitkritische Verarbeitung durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0baf1ce-340f-45d6-b1bd-c6de38ca7234",
                                                "sense_id": "920cec29-c64c-32e1-973a-1b55a07065a3",
                                                "text": "Ein Systemaufruf, der im Kernel-Modus läuft, führt zur Unterbrechung des im Benutzer-Modus laufenden Programms."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
