                "senses": [
                    {
                        "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                        "entry_id": "007db17f-7129-36c4-8460-1523b0e98181",
                        "glosses": [
                            "ein italienischer Hartkäse aus Kuhmilch"
                        ],
                        "tags": [
                            "italienische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "b1df4219-5919-4e18-93df-2e93634dcb1b",
                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                "text": "Der Parmesan sollte klein gerieben sein."
                            },
                            {
                                "example_id": "cb36629b-16c8-4fa4-96fb-a1aba2027e61",
                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                "text": "„Manchmal isst er seine Zucchini auch roh als Salat: mit einem Dressing aus Olivenöl und Zitrone, darüber geriebenen Parmesan und geröstete Pinienkerne.“"
                            },
                            {
                                "example_id": "59c76239-a460-44e3-9b13-c585ccf82631",
                                "sense_id": "739fc6d9-8080-3408-88ea-9f04bc925c9e",
                                "text": "„Am Tag des heiligen Michael erschien Lorenzo in aller Frühe mit einem großen Kessel, in dem die Makkaroni kochten; ich stellte sogleich Butter auf ein Kohlenbecken, um sie zu schmelzen, und bereitete meine zwei Platten vor, die ich mit Parmesan bestreute, den er mir fertig gerieben gebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "503af129-bf43-49e5-a8db-2d53d1a389af",
