                        "form": "das Trio"
                    },
                    {
                        "form_id": "600743b8-c0b6-459e-b45a-789f9f75abc8",
                        "entry_id": "ba94acff-9380-3548-96a3-87ff01974347",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Trios"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                        "entry_id": "ba94acff-9380-3548-96a3-87ff01974347",
                        "glosses": [
                            "Gruppe von drei Personen, die etwas gemeinsam tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f38846c-6654-4117-9086-24d14130fc11",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "Da der Saxophonist krank war, spielten sie diesmal nur als Trio."
                            },
                            {
                                "example_id": "23aa82a8-16e6-447e-aa94-6358808ff2c5",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "„Am nächsten Tisch nimmt ein elegantes Trio Platz: ein Mann mit silbergrauem Haar, ein sehr gepflegter, kultivierter Mann, und zwei Frauen, seine Frau und seine Mutter wahrscheinlich.“"
                            },
                            {
                                "example_id": "7010f4ef-a519-4ee0-abd3-5fb22053ea42",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "„Seither prangte das revolutionäre Trio wieder an seinem Stammplatz.“"
                            },
                            {
                                "example_id": "26c5a9d9-6721-4a9a-a0db-a73648188ce7",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "„Der liebe Gott meint es gut mit dem Trio, und um diesen Umstand zu feiern, gibt es ausnahmsweise noch einen Schnaps.“"
                            },
                            {
                                "example_id": "f3d2e090-98cd-44bc-aa18-d0866b2e3c98",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "„Unser Trio dauerte vier Stunden.“"
                            },
                            {
                                "example_id": "11905a62-6576-4137-8959-9d724182cb4e",
                                "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                                "text": "„Als ich am selben Tag wieder zur Konferenz ging, wartete ein Trio erzürnter japanischer Bürokraten auf mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0977e786-78b9-3535-a835-be970bee2b5e",
                        "entry_id": "ba94acff-9380-3548-96a3-87ff01974347",
                        "glosses": [
                            "Stück für drei Instrumente"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "1139e2a5-070e-4285-bbe8-530cfb5911f1",
                                "sense_id": "0977e786-78b9-3535-a835-be970bee2b5e",
                                "text": "Sie spielten ein Trio für Violine, Bratsche und Violoncello."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5cb5eeef-1202-338d-8319-5ada224f4244",
                        "entry_id": "ba94acff-9380-3548-96a3-87ff01974347",
                        "glosses": [
                            "Teil eines Musikstückes, ursprünglich ein Mittelteil, heute oft auch der Schlussteil vor allem bei Menuett, Scherzo, Marsch und Polka"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9ada50ba-52f7-432f-bf61-93dfc1485de2",
                                "sense_id": "5cb5eeef-1202-338d-8319-5ada224f4244",
                                "text": "Eine weit verbreitete Untugend ist es, im Trio eines Marsches rhytmisch mitzuklatschen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2df712be-23dd-4c27-957b-a7461198bba2",
                        "source_entry_id": "ba94acff-9380-3548-96a3-87ff01974347",
                        "source_sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                        "source_sense_description": "Gruppe von drei Personen, die etwas gemeinsam tun",
                        "target_lang_word": "trio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A group of three people or things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c66086b-8d93-4a70-8381-acb45531f194",
                                                "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                                "text": "I'm cooking crab cakes with arugula and mayonnaise, griddled lamb with rosemary potatoes and buttered spinach, then a trio of desserts."
                                            },
                                            {
                                                "example_id": "c8c5bef7-6b10-4e30-a2aa-6a8e7b4784dc",
                                                "sense_id": "dbbbf9db-df39-39e6-ac01-d2f042cdeba0",
                                                "text": "These are exciting times for England and particularly for this group. Six of this side won the Under-17s European Championship in 2014 and the attacking trio from Everton and Liverpool – Ademola Lookman, Dominic Solanke and Calvert-Lewin – had an excellent tournament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254ce3b6-0a5f-3eaf-b215-32a5ed99aebf",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A group of three musicians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d0a3549-2377-3477-b1ad-3a6454ee70bc",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
                                        "glosses": [
                                            "A piece of music written for three musicians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f253b85-cf4c-4941-8819-9d6d017b672a",
                                                "sense_id": "3d0a3549-2377-3477-b1ad-3a6454ee70bc",
                                                "text": "I love his music, but it is a bit disconcerting to realize that you could die in extreme old age and still only be familiar with a mere handful of the baryton trios."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a09a3e-8780-3c34-8208-437cf3bbc725",
                                        "entry_id": "923ed040-e738-38b6-bd52-b83b12adce6f",
