                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous cherchez dans l'<w>ancien</w>, il y a des offres intéressantes."
                        },
                        {
                            "text": "Ils préfèrent acheter dans l'<w>ancien</w> plutôt que dans le neuf."
