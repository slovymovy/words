                "senses": [
                    {
                        "sense_id": "15c75f52-f8e3-392c-a47a-c8b884516490",
                        "entry_id": "3c4a7f1b-5b0a-30fc-9342-a64a8959e8a7",
                        "glosses": [
                            "unbefestigte und mit Gras bedeckte Landebahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4378d08-1f86-4be2-a9e0-c43f7a1ce0cd",
                                "sense_id": "15c75f52-f8e3-392c-a47a-c8b884516490",
                                "text": "„Rund 250 gewerbliche Flugplätze unterschiedlichster Größe verzeichnet die offizielle Statistik hierzulande, zuzüglich diverser Graspisten für Segelflieger und dergleichen.“"
                            },
                            {
                                "example_id": "63bd1dc3-0c19-49d3-9412-432bc022031c",
                                "sense_id": "15c75f52-f8e3-392c-a47a-c8b884516490",
                                "text": "„Es zeigt die in einer großen Staubwolke endende, aber geglückte Landung der Düsenmaschine auf der Graspiste bei Stölln.“"
                            },
                            {
                                "example_id": "caa0a47a-befa-4a42-aea2-fcf2f343294e",
                                "sense_id": "15c75f52-f8e3-392c-a47a-c8b884516490",
                                "text": "„Die Propellermaschine der birmanischen Fluglinie Myanmar Airlines setzt auf einer holprigen Graspiste auf, die fernab der Hauptstadt Rangun in der bewaldeten Bergregion Birmas liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
