                    "semantic_group_id": "disponibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excusez-moi monsieur, est-ce que cette place est <w>libre</w> pour le voyage ?"
                        },
                        {
                            "text": "Pendant son temps <w>libre</w>, elle adore lire des romans et faire du vélo."
                        }
                    ],
                    "antonyms": [
