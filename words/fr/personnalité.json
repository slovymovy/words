                    ]
                },
                {
                    "sense_id": "ef7667cf-9395-3d5b-8b26-ff34970e9567",
                    "sense_definition": "Statut ou aptitude reconnue par la loi conférant des droits et des obligations à un individu ou à un groupe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une entreprise acquiert la <w>personnalité</w> juridique dès son immatriculation au registre du commerce."
                        },
                        {
                            "text": "L'association dispose de la <w>personnalité</w> juridique pour agir en justice."
