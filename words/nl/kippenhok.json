                {
                    "sense_id": "93ce9f0c-227a-30cc-ac3e-951b2da5d0cb",
                    "sense_definition": "Een heel kleine, armzalige of rommelige woning of ruimte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn eerste studentenkamer was echt een <w>kippenhok</w> waar nauwelijks een bed in paste.",
                            "target_lang_translations": {
                                "en": "My first student room was really a <w>hovel</w> where a bed barely fit.",
                                "tr": "İlk öğrenci odam içine bir yatağın bile zor sığdığı tam bir <w>kümesti</w>."
                            }
                        },
                        {
                            "text": "Ze wonen al jaren in dat kleine <w>kippenhok</w> aan de rand van de stad.",
                            "target_lang_translations": {
                                "en": "They have been living in that small <w>pigsty</w> on the edge of town for years.",
                                "tr": "Yıllardır şehrin kenarındaki o küçük <w>kümes gibi yerde</w> yaşıyorlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "krot",
                        "kluizenarij"
                    ],
                    "common_phrases": [
