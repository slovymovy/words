        "nl-extract.jsonl": [
            {
                "entry_id": "58ba67d1-b3ae-3525-b167-814c62b0b1a2",
                "word": "privaatrecht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d18a656-1b6b-32b0-a6da-ae6628bd35cd",
                        "entry_id": "58ba67d1-b3ae-3525-b167-814c62b0b1a2",
                        "glosses": [
                            "recht dat de verhoudingen tussen particuliere personen beschrijft en de procedures die beschrijven hoe dit recht kan worden toegepast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aacb2efb-e422-41da-816d-c3e07fd9ba1e",
                                "sense_id": "7d18a656-1b6b-32b0-a6da-ae6628bd35cd",
                                "text": "De wildgroei aan claimclubs van woekerpolishouders vertraagt mogelijk de rechtszaken tegen de verzekeraars. 'Het proces duurt jaren en in de tussentijd hebben de gedupeerden nog niets', zegt hoogleraar privaatrecht Eddy Bauw."
                            },
                            {
                                "example_id": "ed4e8f4c-209a-4d51-8800-12fddbfb4466",
                                "sense_id": "7d18a656-1b6b-32b0-a6da-ae6628bd35cd",
                                "text": "Ter Apel wacht op de komst van 22 kindbruiden uit Syrië. Klopt het? Politici reageren in elk geval verontwaardigd. Het COA wil niet ingaan op geruchten. Nederland erkent huwelijken met kinderen vanaf 15 jaar, op basis van het internationaal privaatrecht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9d9f036-2775-454a-b929-021077960586",
                        "source_entry_id": "58ba67d1-b3ae-3525-b167-814c62b0b1a2",
                        "source_sense_id": "7d18a656-1b6b-32b0-a6da-ae6628bd35cd",
                        "source_sense_description": "vakgebied van het recht m.b.t. de onderlinge verhoudingen tussen private personen, maar ook hun privébelangen",
                        "target_lang_word": "Privatrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "067b39b2-3e27-36e8-951f-7a83a6ed950f",
                                        "entry_id": "90c3fafe-6898-3c38-85b4-373db57d6a23",
                                        "glosses": [
                                            "die Gesamtheit aller Rechtsnormen, die zwischen den (rechtlich gleichgestellten) Bürgern (allgemeiner: zwischen Rechtssubjekten des Privatrechts) gelten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6182540b-da1b-4a94-9c4b-59bcc00fa7ca",
                                                "sense_id": "067b39b2-3e27-36e8-951f-7a83a6ed950f",
                                                "text": "„Die kontinental-europäische Rechtslehre pflegt alles Recht in öffentliches Recht und Privatrecht einzuteilen. Unter öffentlichem Recht versteht sie alles Recht, das die Verhältnisse der Rechtsgemeinschaften … als Träger einer hoheitlichen Gewalt regelt, der der einzelne untergeordnet ist. Das Privatrecht dagegen regelt die Rechtsverhältnisse, in denen sich die einzelnen Personen auf gleicher Ebene gegenüberstehen, also ohne Hoheitsgewalt des einen über den anderen.“"
                                            },
                                            {
                                                "example_id": "8e121c93-413d-42d7-8331-6a7680c80713",
                                                "sense_id": "067b39b2-3e27-36e8-951f-7a83a6ed950f",
                                                "text": "„Das Privatrecht ist derjenige Teil der Rechtsordnung, der die Beziehungen der einzelnen zueinander auf der Grundlage ihrer Gleichberechtigung und Selbstbestimmung (‚Privatautonomie‘) regelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84eeb7de-798f-3a0b-96aa-fdd42c1a0705",
                                        "entry_id": "90c3fafe-6898-3c38-85b4-373db57d6a23",
                                        "glosses": [
                                            "einem Einzelnen zustehendes Recht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978805c3-e59d-498f-8e6d-b4d2c4c4b6c5",
                                                "sense_id": "84eeb7de-798f-3a0b-96aa-fdd42c1a0705",
                                                "text": "Er bat seinem Chef darum, seine Privatrechte nicht zu verletzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
