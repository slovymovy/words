                "senses": [
                    {
                        "sense_id": "775ecf6f-854b-3b37-b6e3-72230188c65b",
                        "entry_id": "c6c670f3-ec02-35b6-92c3-6b2e21ae8319",
                        "glosses": [
                            "technische Einrichtung, mit welcher Luft geschlossenen Räumen zugeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ff6931-5b3c-4d9b-bd5a-1e4c692dcad4",
                                "sense_id": "775ecf6f-854b-3b37-b6e3-72230188c65b",
                                "text": "„RK-K Zuluftanlagen sind für die Be- und Entlüftung von Hallen entwickelt und können in Gebäuden oder außerhalb des Gebäudes als wetterfeste Dachzentrale eingesetzt werden.“"
                            },
                            {
                                "example_id": "405a5ba1-ad46-4578-9588-682f44331d50",
                                "sense_id": "775ecf6f-854b-3b37-b6e3-72230188c65b",
                                "text": "„Zuluftanlagen und Zuluftgeräte werden im Bereich der Spritz- und Lackierräume eingesetzt, um die von Farbnebelabsauganlagen abgesaugte Luft durch gefilterte und aufgewärmte Frischluft zu ersetzen.“"
                            },
                            {
                                "example_id": "04864d48-ddf4-47fa-bc66-d3a7394417cf",
                                "sense_id": "775ecf6f-854b-3b37-b6e3-72230188c65b",
                                "text": "„Bei der Zuluftanlage ist darauf zu achten das sie kleiner dimensioniert sein muß als die Abluftanlage, sonst blasen wir die Luft durch Ritzen wieder nach draußen.“"
                            },
                            {
                                "example_id": "dae840dc-fa1a-4613-8de5-f5877d663377",
                                "sense_id": "775ecf6f-854b-3b37-b6e3-72230188c65b",
                                "text": "„In Küchen werden häufig Zuluftanlagen mit geringer räumlicher Ausdehnung und den alleinigen Luftbehandlungsfunktionen „Filtern“ und „Erwärmen“ eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
