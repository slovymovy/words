        "fr-extract.jsonl": [
            {
                "entry_id": "c1a2fda9-500a-38a1-9a65-2ec2e03e57bc",
                "word": "exhibition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e7b3f16-7153-4b7a-8ef1-03453768e270",
                        "entry_id": "c1a2fda9-500a-38a1-9a65-2ec2e03e57bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "exhibitions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c15738da-a356-3a60-bd1f-36a7a52f8f05",
                        "entry_id": "c1a2fda9-500a-38a1-9a65-2ec2e03e57bc",
                        "glosses": [
                            "Action d’exhiber des pièces en justice."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "6cd2e7c8-e6f1-4c5e-88f6-ecf33dcb35bf",
                                "sense_id": "c15738da-a356-3a60-bd1f-36a7a52f8f05",
                                "text": "Après l’exhibition de son contrat."
                            },
                            {
                                "example_id": "795ff158-039b-4b3d-b010-b22ae73eae5d",
                                "sense_id": "c15738da-a356-3a60-bd1f-36a7a52f8f05",
                                "text": "Faire l’exhibition de son passeport, de son permis de séjour, de sa carte d’identité."
                            }
                        ]
                    },
                    {
                        "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                        "entry_id": "c1a2fda9-500a-38a1-9a65-2ec2e03e57bc",
                        "glosses": [
                            "Action d’exhiber en public."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9cb833bb-f83d-4711-941b-a882baade99a",
                                "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                                "text": "[…] le marché aux fourrures étalait des dépouilles d’animaux sans nombre, venues soit de la haute Sibérie, soit des bords de la mer Caspienne. - L’ours blanc, le renard bleu, l’hermine, étaient les moindres curiosités de cette incomparable exhibition."
                            },
                            {
                                "example_id": "917caf59-4679-405f-8f8d-3fe5591df178",
                                "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                                "text": "[…], mais ce fut inutile et il dut se résigner à l’humiliation de cette exhibition publique à ce pilori paroissial."
                            },
                            {
                                "example_id": "4c962e5b-67df-4743-9179-32081a7e7edd",
                                "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                                "text": "Je jouai même aussi une exhibition de tennis contre le champion de Panama, que je gagnai malgré mon peu d’entraînement."
                            },
                            {
                                "example_id": "6462938d-0b57-46c8-bf90-10725fe5cfbe",
                                "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                                "text": "Le yé-yé désigne un genre, l’ensemble des exhibitions de mineurs ignares, exhibitions vocales ou instrumentales, individuelles ou collectives, caractérisées par leur outrance sonore et leur indigence d’expression."
                            },
                            {
                                "example_id": "a22933d8-5c7a-4cb1-b814-c1f6024a56f5",
                                "sense_id": "2147323c-7451-3a17-ae09-6966c8fd86b8",
                                "text": "Cette démonstration unique dans les annales sera complétée par des exhibitions acrobatiques des deux as de la Djiquitovka, Serge et Michel Pakhomoff, rois de la haute voltige à cheval."
                            }
                        ]
                    },
                    {
                        "sense_id": "133680d9-0e9b-3284-a89f-ba9b6c69315e",
                        "entry_id": "c1a2fda9-500a-38a1-9a65-2ec2e03e57bc",
                        "glosses": [
                            "Chose exposée."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b4b24ce6-8d93-4023-ab05-9d1ff30a3b63",
                                "sense_id": "133680d9-0e9b-3284-a89f-ba9b6c69315e",
                                "text": "L’Anglaise, d’une indifférence morne, lorgna d’abord tout autour d’elle avant de lorgner les trois exhibitions, sans donner de signe d’approbation ou d’improbation."
                            }
                        ]
                    }
                ],
