                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6d2d24d-805c-390e-856e-8715ecf5948f",
                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "A destructive rampage."
