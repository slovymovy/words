                    {
                        "translation_id": "ba67470d-868f-409f-ba96-a1beeac71860",
                        "source_entry_id": "3db979b2-694d-36c1-b942-4215cbdf832d",
                        "source_sense_id": "dae40ddd-023e-3047-865a-fbf156a92b92",
                        "source_sense_description": "innerliche Anspannung, Eifer",
                        "target_lang_word": "tension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e01aa12-b6ef-31a1-865a-4687d3b99f5a",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "État de ce qui est tendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78cc6b5a-08a7-49e4-8b57-c70cf859724d",
                                                "sense_id": "2e01aa12-b6ef-31a1-865a-4687d3b99f5a",
                                                "text": "Tension des muscles. - Tension artérielle."
                                            },
                                            {
                                                "example_id": "03440cfb-ac22-41f2-984c-d5c77b5e3ad7",
                                                "sense_id": "2e01aa12-b6ef-31a1-865a-4687d3b99f5a",
                                                "text": "Une corde rend un son plus aigu ou plus grave selon qu’elle a plus ou moins de tension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8696f03-86ce-346d-830e-488c1ed85f43",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "Action de tendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9ef0cd-511c-4afa-a0de-220752b6dbdd",
                                                "sense_id": "a8696f03-86ce-346d-830e-488c1ed85f43",
                                                "text": "Deux fils de même ténacité, mais de numéros différents, qui doivent être tendus conséquemment avec la même traction, ne peuvent donc pas, au dévidoir, prendre le même dispositif de tension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0a3cf9b-4db1-384e-8853-c8fdb7d41a8d",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "Dissentiment entre deux états mentaux d’une personne, d’un groupe, pouvant amener des menaces d’hostilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49895bd5-b80d-4a0d-ad03-b44b34e86ab0",
                                                "sense_id": "a0a3cf9b-4db1-384e-8853-c8fdb7d41a8d",
                                                "text": "Le décor sert de filtre à l’absurde, de même que celui-ci lui sert de cadre. Et cette tension, le marabout l’entretient tout au long de la consultation."
                                            },
                                            {
                                                "example_id": "edd0a635-2575-4e00-9767-0c90b49fc913",
                                                "sense_id": "a0a3cf9b-4db1-384e-8853-c8fdb7d41a8d",
                                                "text": "Que l'équilibre du groupe juvénile reste précaire, qu’il soit exposé à s’évanouir à la moindre tension, l’existence éphémère de ces groupes le montre assez."
                                            },
                                            {
                                                "example_id": "4e716d76-bfff-4769-8003-93be13b7b483",
                                                "sense_id": "a0a3cf9b-4db1-384e-8853-c8fdb7d41a8d",
                                                "text": "C'était ma sœur tout craché : elle ne pouvait pas rester sérieuse. Il fallait à tout prix qu’elle désamorce les tensions avec des références de geek."
                                            },
                                            {
                                                "example_id": "b6f2364f-3f0a-4a24-8d82-d14f32ed54d1",
                                                "sense_id": "a0a3cf9b-4db1-384e-8853-c8fdb7d41a8d",
                                                "text": "Ces tensions entre citoyens et élus traduisent le pourrissement de la situation depuis l’installation, le 24 septembre 2021, des consommateurs de crack du jardin d’Éole sur le site de Forceval, adjacent à la porte de la Villette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687c0a53-6971-3313-a9b5-b58b7570e6b5",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "Pression des gaz."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "609e1645-31ba-4184-a077-559a8446733c",
                                                "sense_id": "687c0a53-6971-3313-a9b5-b58b7570e6b5",
                                                "text": "La tension de la vapeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb1e4d8b-330c-3516-a80e-5c3114107aed",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "Différence de potentiel, tension électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351872e3-3e7a-41e8-8ee1-b3054db36185",
                                                "sense_id": "fb1e4d8b-330c-3516-a80e-5c3114107aed",
                                                "text": "Les bougies comportant deux électrodes séparées par un espacement de 0,5 à 1 mm environ ; l'étincelle jaillit entre les électrodes pour une tension de 12 000 à 40 000 V."
                                            },
                                            {
                                                "example_id": "d689a8d0-d5e8-4e4e-98cf-79548ccd574a",
                                                "sense_id": "fb1e4d8b-330c-3516-a80e-5c3114107aed",
                                                "text": "Un générateur hydroélectrique produit un courant alternatif à tension adaptée à sa puissance. Sur les petites productions, il peut s'agir du 220V monophasé mais plus souvent du triphasé 380 V. Pour les puissances plus importantes, un transformateur adapte la tension à 380/220 V."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d27e88c-f8cf-372e-b705-4438b6c05a39",
                                        "entry_id": "b8eb895c-c6f4-3eb7-8936-bdfc87eeea15",
                                        "glosses": [
                                            "Augmentation de l’énergie potentielle d’une entité moléculaire due à une déviation d’angles de liaisons, à des conformations défavorables ou à d’autres interactions répulsives à travers l’espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebd90e6-40b9-48a0-8f34-15d9e384d5d0",
                                                "sense_id": "7d27e88c-f8cf-372e-b705-4438b6c05a39",
                                                "text": "La tension de la vapeur émise par un solide ou un liquide dans un gaz étranger, sans action chimique sur la vapeur, est égale à la tension de la vapeur que ce corps émettrait dans le vide […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
