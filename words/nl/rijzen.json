{
    "word_family": [
        "oprijzen",
        "verrijzen",
        "rijzing",
        "rijstafel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc6aa5dc-eeb9-3a0a-8ac7-9555ea36dc2b",
                    "sense_definition": "omhooggaan of boven de horizon verschijnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "omhooggaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Japan is het land van de <w>rijzende</w> zon.",
                            "target_lang_translations": {
                                "en": "Japan is the land of the <w>rising</w> sun.",
                                "ru": "Япония — страна <w>восходящего</w> солнца."
                            }
                        },
                        {
                            "text": "We keken hoe de zon langzaam boven de bergen begon te <w>rijzen</w>.",
                            "target_lang_translations": {
                                "en": "We watched how the sun slowly began to <w>rise</w> above the mountains.",
                                "ru": "Мы смотрели, как солнце медленно начало <w>всходить</w> над горами."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgaan",
                        "opstijgen"
                    ],
                    "antonyms": [
                        "dalen",
                        "ondergaan"
                    ],
                    "common_phrases": [
                        "de zon rijst"
                    ],
                    "target_lang_definitions": {
                        "en": "to move upward or appear above the horizon",
                        "ru": "подниматься или появляться над горизонтом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "of the sun or celestial bodies"
                            },
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "to move physically upwards"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "всходить",
                                "target_lang_sense_clarification": "о солнце или небесных телах"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "двигаться вверх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8888fc03-6ba7-38c8-94a6-a889cb3397d9",
                    "sense_definition": "het groter en luchtiger worden van deeg door gist of bakpoeder",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het deeg is nog niet voldoende <w>gerezen</w> om in de oven te gaan.",
                            "target_lang_translations": {
                                "en": "The dough has not <w>risen</w> enough yet to go into the oven.",
                                "ru": "Тесто еще недостаточно <w>поднялось</w>, чтобы ставить его в духовку."
                            }
                        },
                        {
                            "text": "Je moet het brood op een warme plek laten <w>rijzen</w>.",
                            "target_lang_translations": {
                                "en": "You should let the bread <w>rise</w> in a warm place.",
                                "ru": "Нужно дать хлебу <w>подойти</w> в теплом месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "opkomen",
                        "uitzetten"
                    ],
                    "common_phrases": [
                        "het deeg laten rijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of dough becoming larger and lighter due to yeast or baking powder",
                        "ru": "увеличение теста в объеме под воздействием дрожжей или разрыхлителя"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "of dough or bread"
                            },
                            {
                                "target_lang_word": "prove",
                                "target_lang_sense_clarification": "to let dough rise before baking"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "о тесте"
                            },
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "о дрожжевом тесте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cd20940-4534-3694-bbb2-bcb702d1be2a",
                    "sense_definition": "het plotseling tevoorschijn komen of zich voordoen van een abstracte zaak",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontstaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>rijst</w> een vraag over de nieuwe regels van het bedrijf.",
                            "target_lang_translations": {
                                "en": "A question <w>arises</w> about the company's new rules.",
                                "ru": "<w>Возникает</w> вопрос о новых правилах компании."
                            }
                        },
                        {
                            "text": "Er zijn dienaangaande enige bezwaren <w>gerezen</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "Some objections <w>arose</w> in this regard during the meeting.",
                                "ru": "В связи с этим во время собрания <w>возникли</w> некоторые возражения."
                            }
                        }
                    ],
                    "synonyms": [
                        "opkomen",
                        "ontstaan",
                        "opdoemen"
                    ],
                    "antonyms": [
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "een vraag rijst",
                        "bezwaren rijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "the sudden appearance or occurrence of an abstract matter",
                        "ru": "внезапное появление или возникновение чего-то абстрактного"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "of questions, problems, or situations"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "to become apparent or known"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "о вопросах, проблемах или сомнениях"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "становиться очевидным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c81efdb-0cc0-328f-8aa7-ceeaf40748dd",
                    "sense_definition": "het loslaten en naar beneden vallen van kleine deeltjes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De naalden <w>rijzen</w> van de dennenboom omdat hij te droog is.",
                            "target_lang_translations": {
                                "en": "The needles are <w>falling</w> from the pine tree because it is too dry.",
                                "ru": "Иголки <w>осыпаются</w> с сосны, потому что она слишком сухая."
                            }
                        },
                        {
                            "text": "In de herfst beginnen de dode bladeren langzaam te <w>rijzen</w>.",
                            "target_lang_translations": {
                                "en": "In autumn, the dead leaves slowly begin to <w>drop</w>.",
                                "ru": "Осенью сухие листья начинают медленно <w>опадать</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvallen",
                        "afvallen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "voornamelijk in specifieke regio's of verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the loosening and falling down of small particles like needles or leaves",
                        "ru": "отслоение и падение мелких частиц, таких как иголки или листья"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall out",
                                "target_lang_sense_clarification": "of needles or hair"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to fall from a tree"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осыпаться",
                                "target_lang_sense_clarification": "о хвое или листьях"
                            },
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "опадать с дерева"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2c0d8d2-e958-3dfb-bb06-d860f9511654",
                    "sense_definition": "meervoud van <w>rijs</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mandenmaker gebruikte verschillende <w>rijzen</w> om de mand te vlechten.",
                            "target_lang_translations": {
                                "en": "The basket maker used various <w>twigs</w> to weave the basket.",
                                "ru": "Корзинщик использовал различные <w>прутья</w>, чтобы сплести корзину."
                            }
                        },
                        {
                            "text": "Langs de oever groeien jonge <w>rijzen</w> van de wilgenboom.",
                            "target_lang_translations": {
                                "en": "Young <w>shoots</w> of the willow tree grow along the bank.",
                                "ru": "Вдоль берега растут молодые <w>побеги</w> ивы."
                            }
                        }
                    ],
                    "synonyms": [
                        "takken",
                        "twijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'rijs'; thin, flexible branches or twigs",
                        "ru": "множественное число от 'rijs'; тонкие, гибкие ветки или прутья"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twigs",
                                "target_lang_sense_clarification": "small thin branches"
                            },
                            {
                                "target_lang_word": "osiers",
                                "target_lang_sense_clarification": "willow branches used in basketry"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "прутья",
                                "target_lang_sense_clarification": "тонкие гибкие ветви"
                            },
                            {
                                "target_lang_word": "хворост",
                                "target_lang_sense_clarification": "сухие тонкие ветки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}