                                "sense_id": "48924824-c01c-37df-9016-f5de583de787",
                                "text": "Blood is one of the easiest things to arrange on a filmset."
                            },
                            {
                                "example_id": "e7354d24-62d7-4c63-a068-9f6f90680bef",
                                "sense_id": "48924824-c01c-37df-9016-f5de583de787",
                                "text": "Some of Peters's filmset designs, together with those for the store and for an ideal art centre, were put on display at Bullock's Wilshire not long after the store's opening."
                            },
                            {
                                "example_id": "e4c0c3a5-fa1c-4000-9201-64b7e16340a3",
                                "sense_id": "48924824-c01c-37df-9016-f5de583de787",
                                "text": "True enough, Spain has become a filmset to me, the whole of it barely more real than Fort Bravo itself."
                            }
                        ]
