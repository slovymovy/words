                "senses": [
                    {
                        "sense_id": "8a670394-4172-345d-abc2-1b872e9b36a0",
                        "entry_id": "92f00eb4-c9a7-30b7-80ad-cc498fda654d",
                        "glosses": [
                            "Unkostenbeitrag zur Versorgung eines Pferdes (zum Beispiel bei einer Reitbeteiligung)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7c637694-e3b5-4175-908f-e12056f932ce",
                                "sense_id": "8a670394-4172-345d-abc2-1b872e9b36a0",
                                "text": "„Wie bei jeder unserer gemeinschaftlichen Kutschfahrt, sind Gäste auf den Kutschen herzlich willkommen. Für die Pferde bitten wir um ein kleines Möhrengeld.“"
                            },
                            {
                                "example_id": "73d97a4c-5714-47c1-bd01-d3d3ea1906fd",
                                "sense_id": "8a670394-4172-345d-abc2-1b872e9b36a0",
                                "text": "„Welcher Reiter kennt es nicht? Der Tag hat eigentlich zu wenige Stunden! Arbeiten gehen um genug Möhrengeld zu verdienen, schnell nach Hause umziehen und auf dem Weg in den Stall noch irgendwas in den Mund gestopft, damit der Magen nicht knurrt.“"
                            },
                            {
                                "example_id": "754aba2a-07d9-418a-aa73-5f588965e135",
                                "sense_id": "8a670394-4172-345d-abc2-1b872e9b36a0",
                                "text": "„Für jedes Kind wird lediglich ein symbolischer Beitrag von 2,50 Euro pro Stunde erhoben. Einmal in der Woche sind die Kinder für ein bis zwei Stunden im Pony-Club zu Gast. ‚Das ist als eine Art Möhrengeld zu verstehen. […]‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
