                        ],
                        "form": "gedienstigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                        "entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "glosses": [
                            "het bereid zijn om iemand diensten te verlenen; de neiging om dienstbaar te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82348fff-857e-4cf9-860b-80be976993ae",
                                "sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                                "text": "Ernst en Thjum kweten zich op de plantenmarkt, zo goed en zo kwaad als het ging, nederig van hun taak, alsof ze allebei tegenover Malou iets in het reine te brengen hadden. Hun gedienstigheid was bijna te opzichtig."
                            },
                            {
                                "example_id": "042264aa-ee2c-4dae-ba5d-e35d9f9ad691",
                                "sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                                "text": "La Tim ligt aan de drukke Herenstraat, in het centrum van Breukelen. Het is een komen en gaan bij de afhaal en het restaurant is goed bezet. Desondanks is een wuifje met de hand al voldoende om de gedienstigheid van onze ciderman te doen ontwaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c721e21-05cb-3112-95a5-47a36b127b84",
                        "entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "glosses": [
                            "handeling die getuigd van gedienstigheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "914e8f50-f0d7-4b1b-a0ed-0c1b1885074c",
                        "source_entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "source_sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                        "source_sense_description": "het bereid zijn om iemand diensten te verlenen; de neiging om dienstbaar te zijn",
                        "target_lang_word": "kindness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "The state of being kind."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b64ef6-5462-418a-8af6-4e71ad930cc9",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "Jamie's kindness is legendary, so much that people have taken advantage of her."
                                            },
                                            {
                                                "example_id": "f9b2b7d7-ef5b-47b7-8b3a-7ef7986e4d5d",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "If attending to your childhood wounds and responding with kindness feels selfish, it is important to remember that compassion for oneself often makes people more compassionate to others, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "An instance of kind or charitable behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c828946f-6ab7-4e60-84b3-67ae6975cb42",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "How can I thank you for your many kindnesses?"
                                            },
                                            {
                                                "example_id": "891af2e3-a28b-4c81-bd15-09d0a1fe2f68",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "Do me a kindness and leave."
                                            },
                                            {
                                                "example_id": "bb3885f8-fea5-4449-a2bf-a24340da0ca8",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "i'm going to turn a blind eye to this misdemeanour, out of the kindness of my heart."
                                            },
                                            {
                                                "example_id": "f61e6fa4-502f-4f9e-8b88-d09025a0a72e",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "They are grateful for kindnesses that they may have received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e5716b-6729-46e9-aba7-714cc63fed63",
                        "source_entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "source_sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                        "source_sense_description": "het bereid zijn om iemand diensten te verlenen; de neiging om dienstbaar te zijn",
                        "target_lang_word": "modesty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modesty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "The quality of being modest; having a limited and not overly high opinion of oneself and one's abilities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a91821-dcfd-466d-84ae-c66850791baa",
                                                "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "174e3b69-ffe2-34e2-a038-a80f346051fa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Moderate behaviour; reserve."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                        "entry_id": "7f4011fc-1436-3671-acb0-a80564210559",
                                        "glosses": [
                                            "Pudency, avoidance of sexual explicitness."
                                        ],
                                        "tags": [
                                            "specifically",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b203066-537c-4b5a-aa64-ccc3d0417121",
                                                "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6f39dfc-14d0-48ad-93eb-3bab6e8c7d73",
                        "source_entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "source_sense_id": "85cb78ce-215f-31af-bd8d-98622a536463",
                        "source_sense_description": "het bereid zijn om iemand diensten te verlenen; de neiging om dienstbaar te zijn",
                        "target_lang_word": "courtesy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtesy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Polite behavior."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543ef2e2-5e64-4e90-8bc5-722c57de5b8b",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Please extend them the courtesy of your presence."
                                            },
                                            {
                                                "example_id": "2b87370e-b0e3-4f90-9960-4b8ce2a86693",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "He was always known for his grace, kindness, and courtesy to people of every rank."
                                            },
                                            {
                                                "example_id": "df7fd945-0b3c-40b5-904e-4da1f595b554",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Rabbit doesn't want to tell him anything. The more he tells, the more he loses. He's safe inside his own skin, he doesn't want to come out. This guy's whole game is to get him out into the open where he can be manipulated. But the fierce convention of courtesy pries open Rabbit's lips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A polite gesture or remark, especially as opposed to an obligation or standard practice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976bf96b-437e-4d8e-968d-3d13f879d6fd",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "I offered them a ride simply as a courtesy."
                                            },
                                            {
                                                "example_id": "37cb6746-3949-476d-8fb8-6e89e77c8608",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "My lord, for your many courtesies I thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Consent or agreement in spite of fact; indulgence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5c3842-1945-4383-b9fb-fec7517bd632",
                                                "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                                "text": "They call this pond a lake by courtesy only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Willingness or generosity in providing something needed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf86eb31-e180-42b4-be7f-ddcbc6566a95",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "They received free advertising through the courtesy of the local newspaper."
                                            },
                                            {
                                                "example_id": "4905db6d-1465-4cbb-9dd2-98c41061cc05",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "[on a label, caption, etc.] Courtesy the Smith Foundation: [e.g.] use of this image was allowed through the courtesy of the Smith Foundation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A curtsey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e478e550-cd1d-405b-a58d-767aeada387f",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "The lady drops a courtesy in token of obedience, and the ceremony proceeds as usual."
                                            },
                                            {
                                                "example_id": "c052f638-94b4-4007-9952-0908991bd959",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "[I]t was her favorite amusement to array herself in the faded brocades, and parade up and down before the long mirror, making stately courtesies, and sweeping her train about, with a rustle which delighted her ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb48f82-c1e4-3127-9665-f90d217a76b6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "The life interest that the surviving husband has in the real or heritable estate of his wife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
