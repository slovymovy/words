                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vaker gebruikt in België dan in Nederland voor openbaar vervoer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "leaving a vehicle such as a bus, train, or tram"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to get off",
