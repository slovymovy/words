{
    "word_family": [
        "biblical",
        "bibliolatry",
        "bibliology",
        "bibliomancy"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b7980966-e8a6-31cf-87f0-09220d736a48",
                    "sense_definition": "The main religious text in Christianity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_texts",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "In my religion class we learn about the <w>Bible</w>, as well as religious texts of other religions.",
                            "target_lang_translations": {
                                "ru": "На уроках религии мы изучаем <w>Библию</w>, а также религиозные тексты других конфессий."
                            }
                        },
                        {
                            "text": "Many non-Christians regard portions of the <w>Bible</w> as inspiring, but they do not believe it was inspired by God.",
                            "target_lang_translations": {
                                "ru": "Многие нехристиане считают части <w>Библии</w> вдохновляющими, но не верят в её божественное происхождение."
                            }
                        }
                    ],
                    "synonyms": [
                        "Christian Bible",
                        "Holy Bible",
                        "Good Book",
                        "Book",
                        "word of life"
                    ],
                    "common_phrases": [
                        "read the Bible",
                        "Holy Bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной религиозный текст в христианстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Библия",
                                "target_lang_sense_clarification": "священная книга христиан"
                            },
                            {
                                "target_lang_word": "Священное Писание",
                                "target_lang_sense_clarification": "религиозный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a413a8-ac70-3237-9799-24bae49d54a5",
                    "sense_definition": "The Jewish holy book that was largely incorporated into the Christian Bible.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_texts",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "She is Jewish, but she does not read the <w>Bible</w> because she is not religious.",
                            "target_lang_translations": {
                                "ru": "Она еврейка, но не читает <w>Библию</w>, потому что не религиозна."
                            }
                        },
                        {
                            "text": "The Hebrew <w>Bible</w> contains the Torah and other sacred writings.",
                            "target_lang_translations": {
                                "ru": "Еврейская <w>Библия</w> включает в себя Тору и другие священные писания."
                            }
                        }
                    ],
                    "synonyms": [
                        "Tanakh",
                        "Tanach",
                        "Jewish Bible",
                        "Hebrew Bible",
                        "Old Testament"
                    ],
                    "common_phrases": [
                        "Hebrew Bible",
                        "Jewish Bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иудейская священная книга, большая часть которой вошла в христианскую Библию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Танах",
                                "target_lang_sense_clarification": "еврейская Библия"
                            },
                            {
                                "target_lang_word": "Ветхий Завет",
                                "target_lang_sense_clarification": "христианское название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b1386a-edea-3b5a-94cb-4c8416f6f540",
                    "sense_definition": "The analogous holy book of another religion or belief.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_texts",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The cult's ideological substance was the popular digest dubbed the <w>Bible</w> of Maoism.",
                            "target_lang_translations": {
                                "ru": "Идеологической основой культа был популярный дайджест, прозванный <w>библией</w> маоизма."
                            }
                        },
                        {
                            "text": "Some scholars refer to the Bhagavad Gita as the Hindu <w>Bible</w> for its central importance.",
                            "target_lang_translations": {
                                "ru": "Некоторые ученые называют Бхагавад-гиту индуистской <w>библией</w> из-за её центрального значения."
                            }
                        }
                    ],
                    "synonyms": [
                        "other religious text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аналогичная священная книга другой религии или учения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "библия",
                                "target_lang_sense_clarification": "в переносном смысле для других религий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69209bfc-a011-3168-9cca-abea91c01c3d",
                    "sense_definition": "A surname originating as a matronymic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher found that the surname <w>Bible</w> has historical roots in certain regions.",
                            "target_lang_translations": {
                                "ru": "Исследователь обнаружил, что фамилия <w>Библ</w> имеет исторические корни в определенных регионах."
                            }
                        },
                        {
                            "text": "Mr. <w>Bible</w> was invited to speak at the genealogy conference next month.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Библ</w> был приглашен выступить на генеалогической конференции в следующем месяце."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от матронима."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Библ",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "490df16a-9747-3598-87dc-dc882f7b532e",
                    "sense_definition": "A specific version, edition, translation, or copy of the Christian religious text.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_book",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had just become able to read short sentences in his <w>Bible</w>.",
                            "target_lang_translations": {
                                "ru": "Он только что научился читать короткие предложения в своей <w>Библии</w>."
                            }
                        },
                        {
                            "text": "The hotel room had a small <w>bible</w> placed inside the bedside drawer.",
                            "target_lang_translations": {
                                "ru": "В гостиничном номере в ящике прикроватной тумбочки лежала маленькая <w>библия</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "family bible",
                        "pocket bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная версия, издание, перевод или экземпляр христианского религиозного текста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Библия",
                                "target_lang_sense_clarification": "экземпляр книги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31b9c2da-33ed-36f0-83e9-4bc6a95f33d7",
                    "sense_definition": "A comprehensive manual that describes something, or a publication with a loyal readership.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This book is considered the handyman's <w>bible</w> for home repairs.",
                            "target_lang_translations": {
                                "ru": "Эта книга считается <w>библией</w> домашнего мастера по ремонту жилья."
                            }
                        },
                        {
                            "text": "For many years, this magazine was the <w>bible</w> of the fashion industry.",
                            "target_lang_translations": {
                                "ru": "На протяжении многих лет этот журнал был <w>библией</w> модной индустрии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "handyman's bible",
                        "industry bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всеобъемлющее руководство или издание с преданной аудиторией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "библия",
                                "target_lang_sense_clarification": "главная книга в какой-либо области"
                            },
                            {
                                "target_lang_word": "настольная книга",
                                "target_lang_sense_clarification": "наиболее важное пособие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ad74fe-a136-3d50-b01b-c5a313f7a505",
                    "sense_definition": "A reference document used by screenwriters, with information on characters, settings, and other elements of a project.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writers consulted the show's <w>bible</w> to ensure character consistency.",
                            "target_lang_translations": {
                                "ru": "Сценаристы сверялись с <w>библией</w> шоу, чтобы обеспечить последовательность характеров."
                            }
                        },
                        {
                            "text": "Before filming the pilot, the creator finished the series <w>bible</w>.",
                            "target_lang_translations": {
                                "ru": "Перед съемками пилотной серии создатель закончил <w>библию</w> сериала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "series bible",
                        "show bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Справочный документ для сценаристов с информацией о персонажах и мире проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "библия персонажей",
                                "target_lang_sense_clarification": "сценарный термин"
                            },
                            {
                                "target_lang_word": "библия сериала",
                                "target_lang_sense_clarification": "описание проекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9bdf6ef-b8b1-3f8e-b983-b9c4f3b3694f",
                    "sense_definition": "A binder containing copies of the most important documents for a particular matter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please add these new files to the case <w>bible</w>?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы добавить эти новые файлы в <w>досье</w> по делу?"
                            }
                        },
                        {
                            "text": "The legal team prepared a closing <w>bible</w> for the corporate merger.",
                            "target_lang_translations": {
                                "ru": "Юристы подготовили итоговый <w>свод документов</w> для корпоративного слияния."
                            }
                        }
                    ],
                    "common_phrases": [
                        "case bible"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in legal or business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Папка, содержащая копии наиболее важных документов по конкретному делу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досье",
                                "target_lang_sense_clarification": "собрание документов"
                            },
                            {
                                "target_lang_word": "свод документов",
                                "target_lang_sense_clarification": "юридический или деловой контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6605e2a6-0e7d-3304-bd72-3622427ca06e",
                    "sense_definition": "A compilation of problems and solutions from previous years of a given course, used by students.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students passed around a physics <w>bible</w> to study for the final exam.",
                            "target_lang_translations": {
                                "ru": "Студенты передавали друг другу <w>решебник</w> по физике, чтобы подготовиться к выпускному экзамену."
                            }
                        },
                        {
                            "text": "He managed to find an old <w>bible</w> of a sophomore to help with the homework.",
                            "target_lang_translations": {
                                "ru": "Ему удалось найти старую <w>тетрадь с решениями</w> одного второкурсника, чтобы помочь с домашним заданием."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "student slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборник задач и решений прошлых лет по определенному курсу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решебник",
                                "target_lang_sense_clarification": "студенческий сленг"
                            },
                            {
                                "target_lang_word": "шпаргалка",
                                "target_lang_sense_clarification": "в широком смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc2ae96-b386-3efe-b571-901bdafbdb8a",
                    "sense_definition": "Omasum, the third compartment of the stomach of ruminants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher explained that the <w>bible</w> is another name for the omasum.",
                            "target_lang_translations": {
                                "ru": "Мясник объяснил, что <w>книжка</w> — это другое название омасума."
                            }
                        },
                        {
                            "text": "In ruminant anatomy, the <w>bible</w> is known for its many leaf-like folds.",
                            "target_lang_translations": {
                                "ru": "В анатомии жвачных животных <w>книжка</w> известна своими многочисленными листовидными складками."
                            }
                        }
                    ],
                    "synonyms": [
                        "omasum",
                        "psalterium",
                        "manyplies",
                        "fardel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книжка, третий отдел желудка жвачных животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "книжка",
                                "target_lang_sense_clarification": "анатомия животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bb4cce4-39b9-3752-8b05-8907660a5ad1",
                    "sense_definition": "A piece of sandstone used for scouring wooden decks on ships.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors used a <w>bible</w> to scrub the deck until it was white.",
                            "target_lang_translations": {
                                "ru": "Матросы использовали <w>точильный камень</w>, чтобы отдраить палубу до белизны."
                            }
                        },
                        {
                            "text": "Scouring the wood with a <w>bible</w> was a back-breaking task for the crew.",
                            "target_lang_translations": {
                                "ru": "Чистка дерева <w>камнем</w> была изнурительной задачей для команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "holystone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок песчаника, используемый для чистки деревянных палуб на кораблях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точильный камень",
                                "target_lang_sense_clarification": "морской термин для чистки палубы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3544202d-b1c7-3d58-9459-74845fc7a104",
                    "sense_definition": "The upper part of a pin-tumbler lock, containing the driver pins and springs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locksmith carefully disassembled the <w>bible</w> of the lock to replace the springs.",
                            "target_lang_translations": {
                                "ru": "Слесарь осторожно разобрал <w>корпус</w> замка, чтобы заменить пружины."
                            }
                        },
                        {
                            "text": "If the <w>bible</w> is damaged, the pins will not move correctly.",
                            "target_lang_translations": {
                                "ru": "Если <w>верхняя часть</w> повреждена, штифты не будут двигаться правильно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical term in locksmithing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть цилиндрового замка, содержащая штифты и пружины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус цилиндра",
                                "target_lang_sense_clarification": "технический термин в слесарном деле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}