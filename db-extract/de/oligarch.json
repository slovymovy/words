                ],
                "senses": [
                    {
                        "sense_id": "8dac2f01-babd-372a-973e-dbd6cbc6177b",
                        "entry_id": "ef17e48c-eeff-3c9d-96bb-088af225be98",
                        "glosses": [
                            "Angehöriger einer kleinen Gruppe, die politische Macht über ein Land oder eine Region hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cea68e6a-2897-48e7-9658-5922c3d326b6",
                                "sense_id": "8dac2f01-babd-372a-973e-dbd6cbc6177b",
                                "text": "Die russischen Oligarchen sind zumeist in der Gorbatschow-Ära reich geworden."
                            },
                            {
                                "example_id": "58ab7a30-3a95-432c-a1ac-6d2c4e2987e7",
                                "sense_id": "8dac2f01-babd-372a-973e-dbd6cbc6177b",
                                "text": "„Präsident Poroschenko hat schon in früheren Regierungen hohe Posten eingenommen, als Oligarch trieb er im Kartell mit anderen einst die Zuckerpreise hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6391f21e-ef58-4ff5-be94-b50afed7e4e7",
                        "source_entry_id": "ef17e48c-eeff-3c9d-96bb-088af225be98",
                        "source_sense_id": "8dac2f01-babd-372a-973e-dbd6cbc6177b",
                        "source_sense_description": "Angehöriger einer kleinen Gruppe, die politische Macht über ein Land oder eine Region hat",
                        "target_lang_word": "oligarcha",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarcha",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "73db2edb-9831-3e6f-8224-1e358a647d51",
                                        "entry_id": "64c2a8e8-5dfb-302e-960a-94774327b473",
                                        "glosses": [
                                            "(v zemích zejména východní Evropy) podnikatel, který po pádu komunismu (zejména díky svým konexím) rychle získal obrovský majetek a politický vliv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe704f8f-41e1-4c54-a9d7-4e53e1edecfa",
                                                "sense_id": "73db2edb-9831-3e6f-8224-1e358a647d51",
                                                "text": "Absurdita: komunisté chtějí podpořit vládu oligarchy, miliardáře, megakapitalisty, a zároveň stále dál vzdychají po socialismu a brojí proti kapitalismu. V takových paradoxech tu žijeme, nic neplatí, máloco má logiku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
