                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "320fe783-f08f-396e-9c6e-611141e47d30",
                                        "entry_id": "21458fc7-2efd-3af5-9518-e2dc4ff3da9b",
                                        "glosses": [
                                            "so, dass es überwunden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca4f706-d3fd-4485-91b7-41b44449ad5c",
                                                "sense_id": "320fe783-f08f-396e-9c6e-611141e47d30",
                                                "text": "„Und ich bin überzeugt, daß die Rokokowillkür von denen, die ihr unterlagen, für überwindbar gehalten worden ist, sonst hätten sie nicht die Revolution gemacht.“"
                                            }
                                        ],
