                        "entry_id": "367ea35a-26ba-33b4-90c9-26c6ceb3f257",
                        "glosses": [
                            "An old game of chance played with cards in silence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06a8dfcd-b76a-470a-8f00-dfbefb589482",
                                "sense_id": "52c04b00-4c72-3146-9f8b-559ef55d4035",
                                "text": "The Taker oꝛ the Verſer is the man muſt play with him, the Cardes are fetch, Mumchance oꝛ Decoy is the game: the firſt wager is Wine, the ſecond two pence in money, from two pence they riſe to a ſhilling, from that to a pound, […]"
                            },
                            {
                                "example_id": "5585d693-121e-4625-9d8c-8acee87a0682",
                                "sense_id": "52c04b00-4c72-3146-9f8b-559ef55d4035",
                                "text": "Bear and wolf, look to your prisoner—prance, hobby—hiss, dragon, and halloo, boys—we grow older every moment we stand idle, and life is too short to be spent in playing mumchance."
                            }
                        ]
                    },
                    {
                        "sense_id": "f814f3b8-f0d5-3bc1-90a1-93f62cf003da",
                        "entry_id": "367ea35a-26ba-33b4-90c9-26c6ceb3f257",
                        "glosses": [
                            "A silent, stupid person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "002b87da-b58e-46ab-b627-788fb463a11f",
                                "sense_id": "f814f3b8-f0d5-3bc1-90a1-93f62cf003da",
                                "text": "I'm not such a mumchance, to be sure, but I've as good a fortune"
                            }
                        ]
                    }
