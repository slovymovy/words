{
    "word_family": [
        "rapture",
        "enrapture"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10e2752f-da5d-35c6-a15a-8adbd63afdfd",
                    "sense_definition": "Very interested, involved in something, absorbed, or fascinated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched in <w>rapt</w> attention as the magician performed his tricks.",
                            "target_lang_translations": {
                                "fr": "Les enfants regardaient avec une attention <w>captivée</w> le magicien faire ses tours."
                            }
                        },
                        {
                            "text": "The audience sat in <w>rapt</w> silence while the musician played the final piece.",
                            "target_lang_translations": {
                                "fr": "Le public est resté dans un silence <w>fasciné</w> pendant que le musicien jouait le dernier morceau."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthralled",
                        "entranced",
                        "hypnotized",
                        "mesmerized",
                        "transfixed"
                    ],
                    "antonyms": [
                        "disinterested",
                        "unconcerned"
                    ],
                    "common_phrases": [
                        "rapt attention"
                    ],
                    "target_lang_definitions": {
                        "fr": "Très intéressé, absorbé ou fasciné par quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "captivé",
                                "target_lang_sense_clarification": "Qui retient toute l'attention."
                            },
                            {
                                "target_lang_word": "absorbé",
                                "target_lang_sense_clarification": "Profondément concentré sur une activité."
                            },
                            {
                                "target_lang_word": "fasciné",
                                "target_lang_sense_clarification": "Captivé par un intérêt intense."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96127cca-3cf8-38fc-9f0f-a44b7d5ca6d9",
                    "sense_definition": "Feeling great enthusiasm, joy, or excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>rapt</w> with his exam results after months of hard study.",
                            "target_lang_translations": {
                                "fr": "Il était <w>ravi</w> de ses résultats d'examen après des mois d'études acharnées."
                            }
                        },
                        {
                            "text": "The team was <w>rapt</w> to hear they had won the championship game.",
                            "target_lang_translations": {
                                "fr": "L'équipe était <w>ravie</w> d'apprendre qu'elle avait gagné le match de championnat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australian and New Zealand English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Ressentir un grand enthousiasme, de la joie ou de l'excitation."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ravi",
                                "target_lang_sense_clarification": "Très content ou enchanté par une nouvelle."
                            },
                            {
                                "target_lang_word": "enthousiaste",
                                "target_lang_sense_clarification": "Qui manifeste un vif intérêt ou de la joie."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b75a0ef9-c372-3b77-8b6a-eb0198210f7a",
                    "sense_definition": "Taken away or abducted by force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The princess was <w>rapt</w> away by the dragon to a distant mountain.",
                            "target_lang_translations": {
                                "fr": "La princesse fut <w>enlevée</w> par le dragon vers une montagne lointaine."
                            }
                        },
                        {
                            "text": "In the old stories, travelers were often <w>rapt</w> by mysterious spirits.",
                            "target_lang_translations": {
                                "fr": "Dans les vieilles histoires, les voyageurs étaient souvent <w>enlevés</w> par des esprits mystérieux."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Enlevé ou emmené de force."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "enlevé",
                                "target_lang_sense_clarification": "Action d'abduire quelqu'un par la force."
                            },
                            {
                                "target_lang_word": "rapté",
                                "target_lang_sense_clarification": "Terme juridique ou littéraire pour un enlèvement."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9eb8fcab-d07d-33fd-bf30-2df854e195bb",
                    "sense_definition": "A state of intense ecstasy or a trance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mystic fell into a deep <w>rapt</w> during his meditation.",
                            "target_lang_translations": {
                                "fr": "Le mystique tomba dans une profonde <w>extase</w> pendant sa méditation."
                            }
                        },
                        {
                            "text": "She experienced a sudden <w>rapt</w> while listening to the beautiful music.",
                            "target_lang_translations": {
                                "fr": "Elle a ressenti un soudain <w>ravissement</w> en écoutant cette belle musique."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un état d'extase intense ou de transe."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "extase",
                                "target_lang_sense_clarification": "État de ravissement intense."
                            },
                            {
                                "target_lang_word": "ravissement",
                                "target_lang_sense_clarification": "État de bonheur extrême ou de transport mystique."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05082442-537c-3c88-b132-6af61e34704c",
                    "sense_definition": "To carry someone or something away by force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm seemed to <w>rapt</w> everything in its path into the dark sky.",
                            "target_lang_translations": {
                                "fr": "La tempête semblait <w>enlever</w> tout ce qui se trouvait sur son passage vers le ciel sombre."
                            }
                        },
                        {
                            "text": "The villain tried to <w>rapt</w> the treasure from the guarded vault.",
                            "target_lang_translations": {
                                "fr": "Le méchant a essayé de <w>ravir</w> le trésor du coffre-fort gardé."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Emporter quelqu'un ou quelque chose par la force."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "enlever",
                                "target_lang_sense_clarification": "Action de prendre quelqu'un de force."
                            },
                            {
                                "target_lang_word": "ravir",
                                "target_lang_sense_clarification": "Emporter violemment (usage littéraire ou archaïque)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}