                        "examples": [
                            {
                                "example_id": "a3bb7a20-8a6e-46fc-8176-5ba20f8d0bbb",
                                "sense_id": "f93ce043-730c-3f2a-a14e-9a41cd32c8c6",
                                "text": "Nu had ik een paar dat ik speciaal apart hield om op het strand te gebruiken, ivoorkleurige kalfsleren handschoenen die smerig en hard waren geworden van het water, met bij de knokkel afgeknipte vingers om dingen makkelijker te kunnen hanteren."
                            },
                            {
                                "example_id": "fbf6971e-fbc9-4996-b228-274e675810cc",
                                "sense_id": "f93ce043-730c-3f2a-a14e-9a41cd32c8c6",
                                "text": "De Texaanse zakenman Milton Verret heeft de bijna 1,3 miljoen euro betaald voor het rood-zwarte kalfsleren jasje. Verret wil het kledingstuk tentoonstellen om wereldwijd geld op te halen voor kinderziekenhuizen."
                            }
                        ]
