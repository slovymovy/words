                "senses": [
                    {
                        "sense_id": "7fb4c2b9-14d2-3c61-a0bf-4c5d10f02df9",
                        "entry_id": "59fd035e-3ca3-32ae-a2b8-717fe961d2d0",
                        "glosses": [
                            "Habitant du département des Landes, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67b08ed-2d32-4cf4-98b1-db0acc613ec2",
                                "sense_id": "7fb4c2b9-14d2-3c61-a0bf-4c5d10f02df9",
                                "text": "Son repaire, sa bauge l’attendait : des ajoncs, que les Landais appellent des jaugues, des fougères hautes comme des corps humains, l’enserraient, le protégeait."
                            },
                            {
                                "example_id": "c3436201-51a7-40fa-9931-78844a8ea7df",
                                "sense_id": "7fb4c2b9-14d2-3c61-a0bf-4c5d10f02df9",
                                "text": "J’ai quand même été, je pense, à la hauteur contre lui, je lui ai vraiment posé des problèmes, a souligné le finaliste du Challenger de Bordeaux en 2022, entraîné par le Landais Nicolas Devilder."
                            },
                            {
                                "example_id": "6ca59e69-97a5-4284-af54-3a70756a92d8",
                                "sense_id": "7fb4c2b9-14d2-3c61-a0bf-4c5d10f02df9",
                                "text": "Au départ, c’est un peu par hasard que le « 100 % Landais, 100 % Tursan » tombe dans le citron."
                            }
                        ]
                    },
