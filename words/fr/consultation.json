                    ],
                    "synonyms": [
                        "référendum",
                        "sondage",
                        "scrutin"
                    ],
                    "common_phrases": [
                        "consultation populaire",
                        "consultation citoyenne",
                        "consultation électorale"
                    ]
                },
                {
                    "sense_id": "9c514daf-713d-390e-9903-f11f16b266f8",
                    "sense_definition": "Avis oral ou écrit délivré par un spécialiste sur une question précise relevant de ses compétences.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "advice_opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre avocat a rédigé une <w>consultation</w> très claire sur les risques juridiques encourus."
                        },
                        {
                            "text": "Avant de signer le contrat, l'entreprise a sollicité une <w>consultation</w> juridique indépendante."
                        }
                    ],
                    "synonyms": [
                        "avis",
                        "expertise"
                    ],
                    "common_phrases": [
                        "consultation juridique",
                        "donner une consultation",
                        "demander une consultation"
                    ]
                },
                {
                    "sense_id": "63fc38db-a7d7-30e3-95e3-78c0fc587322",
                    "sense_definition": "Lieu ou plage horaire où un médecin ou un praticien reçoit ses patients pour les examiner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_legal_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce spécialiste assure sa <w>consultation</w> tous les mardis après-midi au centre hospitalier."
                        },
                        {
                            "text": "Les patients attendent calmement dans le couloir avant d'entrer à la <w>consultation</w>."
                        }
                    ],
                    "synonyms": [
                        "permanence",
                        "cabinet"
                    ],
                    "common_phrases": [
                        "heures de consultation",
                        "aller à la consultation"
                    ]
                },
                {
                    "sense_id": "3bf78f52-ed7d-3469-ae65-06fec9dcd6fa",
                    "sense_definition": "Procédure engagée par un acheteur ou une collectivité pour recueillir des offres concurrentes avant d'attribuer un marché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "procurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a décidé de lancer une <w>consultation</w> pour la réfection du gymnase."
                        },
                        {
                            "text": "Plusieurs entreprises locales ont répondu à la <w>consultation</w> avant la date limite fixée."
                        }
                    ],
                    "synonyms": [
                        "appel d'offres",
                        "mise en concurrence"
                    ],
                    "common_phrases": [
                        "dossier de consultation",
                        "lancer une consultation",
                        "règlement de consultation"
                    ]
                }
            ]
        }
