                                "target_senses": [
                                    {
                                        "sense_id": "b0cc1905-065b-3f46-b9b7-9c4a9b4aa325",
                                        "entry_id": "a42e6660-ada1-3001-8618-ad81bcd47783",
                                        "glosses": [
                                            "Colocasia esculenta, raised as a food primarily for its corm, which distantly resembles potato."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "382a5a74-2d13-419a-b3f6-280a3772d4aa",
                                                "sense_id": "b0cc1905-065b-3f46-b9b7-9c4a9b4aa325",
                                                "text": "The Jiasian region is famous for taro ice cream. Even though taro is the key ingredient in the ice cream, people in this area bought taro from other regions. During the post-Typhoon Morakot reconstruction process, JCA and other local organisations encouraged large numbers of farmers in Jiasian to grow taro. The Agriculture Bureau then started investing in Jiasian taro farming. Local taro ice cream makers are now using local taro to support local agriculture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41afe59-fc9a-3e79-ae9d-00198efb24f2",
                                        "entry_id": "a42e6660-ada1-3001-8618-ad81bcd47783",
                                        "glosses": [
                                            "Any of several other species with similar corms and growth habit in Colocasia, Alocasia etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81ac57d7-ee9d-3b2b-b39f-26a328a4722f",
                                        "entry_id": "a42e6660-ada1-3001-8618-ad81bcd47783",
                                        "glosses": [
                                            "Food from a taro plant."
                                        ],
                                        "tags": [
