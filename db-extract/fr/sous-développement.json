                                        "entry_id": "ab4a5265-06cb-36ff-ae29-40d5240d82b0",
                                        "glosses": [
                                            "The condition of being underdeveloped."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea4142e-560f-4989-869e-f5b69bfa46e6",
                                                "sense_id": "00de8982-5a94-3143-bae1-8447f0057613",
                                                "text": "Drawing on insights from thinkers such as Karl Marx, Aimé Césaire and Mahatma Gandhi, they pointed out that underdevelopment in the global South was not a natural condition, but a consequence of the way Western powers had organised the world system over hundreds of years."
                                            }
