                        "source_sense_id": "8196c1c3-7eee-3381-bf2d-91d03273b3c8",
                        "target_lang_word": "Droide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Droide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3b3a6d-3ace-3808-9a3a-e90fc1b3bfb1",
                                        "entry_id": "4ce21147-3291-3c7f-b84c-253ee1493449",
                                        "glosses": [
                                            "ein beweglicher Roboter, ursprünglich wohl nur in Star Wars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1da62a-9a8b-4aee-a2b1-a38ecc6873ef",
                                                "sense_id": "ed3b3a6d-3ace-3808-9a3a-e90fc1b3bfb1",
                                                "text": "Ein winziger Droide wuselte den Mittelgang auf und ab."
                                            }
