                                    {
                                        "sense_id": "3d60d8c1-fcaa-3240-948a-6d9398802876",
                                        "entry_id": "47bd5075-a232-345c-8d93-138943fcb29f",
                                        "glosses": [
                                            "A sudden, often uncontrolled movement, especially of the human body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8edb5f-5595-45d3-ac3c-350702547691",
                                                "sense_id": "3d60d8c1-fcaa-3240-948a-6d9398802876",
                                                "text": "1856, Gustave Flaubert, Madame Bovary, Part III Chapter X, translated by Eleanor Marx-Aveling\nThe black cloth bestrewn with white beads blew up from time to time, laying bare the coffin. The tired bearers walked more slowly, and it advanced with constant jerks, like a boat that pitches with every wave."
                                            },
                                            {
                                                "example_id": "24b814b3-9db1-4c49-8316-4d45ecf2e7d8",
                                                "sense_id": "3d60d8c1-fcaa-3240-948a-6d9398802876",
                                                "text": "A barrel-organ in the street suddenly sprang with a jerk into a jovial tune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8547461-705b-33af-8916-0c6ae8ed2554",
                                        "entry_id": "47bd5075-a232-345c-8d93-138943fcb29f",
                                        "glosses": [
                                            "A quick pull on something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a9df9be-866d-46d7-9c9b-fa4515c06de2",
                                                "sense_id": "a8547461-705b-33af-8916-0c6ae8ed2554",
                                                "text": "When I yell \"OK,\" give the mooring line a good jerk!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79b9d1a-a097-3cac-9fed-585ed8c77b85",
                                        "entry_id": "47bd5075-a232-345c-8d93-138943fcb29f",
                                        "glosses": [
                                            "A person with unlikable or obnoxious qualities and behavior, typically mean, self-centered, or disagreeable."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65fe25c9-61fb-4dbc-9089-b5f2d0ed1a0c",
                                                "sense_id": "c79b9d1a-a097-3cac-9fed-585ed8c77b85",
                                                "text": "Oh, Raymond―don't be such a jerk. Go and get yourself a drink or a tranquilizer or something."
                                            },
                                            {
                                                "example_id": "86fba7ca-852e-4609-9bb9-bf1442736e03",
                                                "sense_id": "c79b9d1a-a097-3cac-9fed-585ed8c77b85",
                                                "text": "I finally fired him, because he was being a real jerk to his customers, even to some of the staff."
                                            },
                                            {
                                                "example_id": "fde032b8-2817-4fa2-87cf-715c9870c907",
                                                "sense_id": "c79b9d1a-a097-3cac-9fed-585ed8c77b85",
                                                "text": "You really are a jerk sometimes."
                                            },
                                            {
                                                "example_id": "df6bad6e-553a-460e-a76b-3baa3cff0be1",
                                                "sense_id": "c79b9d1a-a097-3cac-9fed-585ed8c77b85",
                                                "text": "And [Albert Fish] was dizzyingly happy about it, smiled as described the grizzly details of the tortures and the murders, appearing to the detectives and one of the detectives said \"he appeared as the Devil himself.\" I mean this Albert F-, I mean this guy was a real jerk!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eed8ee77-b634-3eb8-9eaa-1829672c711d",
                                        "entry_id": "47bd5075-a232-345c-8d93-138943fcb29f",
                                        "glosses": [
                                            "A stupid person; an idiot or fool."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
