                        ],
                        "form": "die Broterwerbe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                        "entry_id": "b924dffa-ab92-3885-b84b-849733485a82",
                        "glosses": [
                            "Tätigkeit, um sich den Lebensunterhalt zu sichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a811eb-d197-4c3b-81ce-be9c73957286",
                                "sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                                "text": "„Für die Menschen aus Duderstadt, Heiligenstadt und Worbis war es gleichwohl eine Selbstverständlichkeit, zum Broterwerb in die Fremde zu ziehen, aber daheim auf dem Eichsfeld die eigenen Wurzeln zu pflegen.“"
                            },
                            {
                                "example_id": "335d5e3f-92dd-4748-b6d3-52ccf8b533f5",
                                "sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                                "text": "„Den Folgen dieses in den Annalen der Hamburger Reederei wahrscheinlich einmaligen Vorfalls nur durch den Kriegsausbruch entgangen, mußte Alf notgedrungen einen neuen Broterwerb suchen.“"
                            },
                            {
                                "example_id": "c280f827-6950-4a94-b787-4a322a262316",
                                "sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                                "text": "„Nur ich konnte mich damals zu keinem Broterwerb aufraffen.“"
                            },
                            {
                                "example_id": "c902a3ba-2691-483f-92c5-96955d20a0cd",
                                "sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                                "text": "„Der Arzt sah sich in seinem Broterwerb, seinen Vorrechten, seiner sozialen Geltung angegriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c503df1d-1b62-4991-9313-d6bf4977333a",
                        "source_entry_id": "b924dffa-ab92-3885-b84b-849733485a82",
                        "source_sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
