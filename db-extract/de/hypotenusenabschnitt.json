                ],
                "senses": [
                    {
                        "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                        "entry_id": "61a2c4dc-b91a-31fd-9ade-b26a6c5ba02d",
                        "glosses": [
                            "Strecke zwischen dem Scheitel eines spitzen Winkels in einem rechtwinkeligen Dreieck und dem Schnittpunkt der innerhalb des Dreiecks liegenden Höhe mit der dem rechten Winkel gegenüberliegenden Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c976dd79-8b80-4ea5-96b2-4faa385ce1d9",
                                "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                                "text": "„In einem rechtwinkligen Dreieck ist das Quadrat über einer Kathete gleich dem Rechteck aus Hypotenuse und zugehörigem Hypotenusenabschnitt […].“"
                            },
                            {
                                "example_id": "2726cbc0-3e93-472e-90a4-e74705d20d0d",
                                "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                                "text": "„Das Quadrat einer Kathete ist gleich dem Produkt des anliegenden Hypotenusenabschnitts und der Hypotenuse.“"
                            },
                            {
                                "example_id": "eb4cc5ef-7a5f-4e6a-941f-12764d7406c6",
                                "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                                "text": "„Mit den Ausdrücken der Proportionenlehre heißt das: Die Kathete im rechtwinkligen Dreieck ist mittlere Proportionale zwischen der Hypotenuse und dem anliegenden Hypotenusenabschnitt.“"
                            },
                            {
                                "example_id": "3bede65a-e8bf-4dd2-91c5-ab9d6555ea26",
                                "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                                "text": "„Dann heißen die Strecken AH und BH die Hypotenusenabschnitte und CH heißt die Höhe des Dreiecks (auf die Hypotenuse).“"
                            },
                            {
                                "example_id": "b1146465-cccf-43f5-8dcf-7e0ba46fd73e",
                                "sense_id": "30c9c850-ac68-347d-958d-2d3b238bd8f5",
                                "text": "„In einem rechtwinkligen Dreieck teilt der Fußpunkt der Höhe auf der Hypotenuse diese in zwei sogenannte Hypotenusenabschnitte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
