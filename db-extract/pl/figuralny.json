                                    {
                                        "sense_id": "0e377570-8143-3036-9577-3f238a016192",
                                        "entry_id": "b954d1dc-d45d-3436-8818-8798fe97f354",
                                        "glosses": [
                                            "eine oder mehrere Figuren darstellend"
