                                    {
                                        "sense_id": "8f04d5e9-ef27-3a2a-bae0-16a9329fd530",
                                        "entry_id": "411c3c2a-21cb-35ed-8a63-d1d9daf1e446",
                                        "glosses": [
                                            "To interact or coexist well, without argument or trouble."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d86c36-b73a-4e86-a090-87a417f13518",
                                                "sense_id": "8f04d5e9-ef27-3a2a-bae0-16a9329fd530",
                                                "text": "I wish the kids would get along better."
                                            },
                                            {
                                                "example_id": "b79ab57e-d97e-4391-a775-2a39e4d9d740",
                                                "sense_id": "8f04d5e9-ef27-3a2a-bae0-16a9329fd530",
                                                "text": "She never did get along with her brother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6821410-7a1b-3527-9bc7-39e5a583e96d",
                                        "entry_id": "411c3c2a-21cb-35ed-8a63-d1d9daf1e446",
                                        "glosses": [
                                            "To survive; to do well enough."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e00b514-2540-49dc-9a01-feb709b63ea2",
                                                "sense_id": "f6821410-7a1b-3527-9bc7-39e5a583e96d",
                                                "text": "She didn’t have a lot of money, but she had enough to get along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff59a2c-f6b2-3f27-8bfc-9f0fb1a43f97",
                                        "entry_id": "411c3c2a-21cb-35ed-8a63-d1d9daf1e446",
                                        "glosses": [
                                            "To go; to move; to leave. Also, git along."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "progressive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f14c4a9-3e04-45e3-994f-d9a185dc3a13",
                                                "sense_id": "4ff59a2c-f6b2-3f27-8bfc-9f0fb1a43f97",
                                                "text": "Driver, get along there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cd04048-2370-4ab9-a215-b1d05cf8132d",
