                    {
                        "sense_id": "6e890fe5-77c5-3835-95fb-2b683710e04f",
                        "entry_id": "c820c0ba-cd2a-3264-8eb3-e8a1fcf6c6c0",
                        "glosses": [
                            "verzameling van alle aandelen die iemand bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94689c3f-e01c-4b1b-91b0-abfbfe763994",
                                "sense_id": "6e890fe5-77c5-3835-95fb-2b683710e04f",
                                "text": "’s Werelds grootste vermogensbeheerder BlackRock overweegt aandelenportefeuilles op te zetten die makers en verkopers van wapens uitsluiten."
                            },
                            {
                                "example_id": "9628f5f1-b144-4551-81aa-9de2f7ee80ee",
                                "sense_id": "6e890fe5-77c5-3835-95fb-2b683710e04f",
                                "text": "Voor veel beleggers is het niet weggelegd zelf een goed gespreide aandelenportefeuille samen te stellen op basis van individuele aandelen. Het bedrag dat ze ter beschikking hebben voor beleggen is simpelweg te klein. Vandaar dat veel van hen in fondsen beleggen. In één keer wordt daarmee een breed gespreid mandje met aandelen gekocht. In dergelijke mandjes zitten vaak hoge (verborgen) kosten."
                            },
                            {
                                "example_id": "c14d336d-6370-4be8-9ad8-584afbab9a79",
                                "sense_id": "6e890fe5-77c5-3835-95fb-2b683710e04f",
                                "text": "Wie dus niet in januari een deel van zijn winst op de aandelenportefeuille “te gelde” heeft gemaakt om later weer in te stappen mag de hand in eigen boezem steken."
                            },
                            {
                                "example_id": "02057bf7-52c3-4d83-9f59-1984333d3ac0",
                                "sense_id": "6e890fe5-77c5-3835-95fb-2b683710e04f",
                                "text": "'Goed, zullen we beginnen met de aandelenportefeuille?' vroeg één van de juristen."
                            }
                        ]
                    }
                ],
