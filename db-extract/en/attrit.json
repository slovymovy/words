                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ec6aca-3ced-42b3-b561-1c5ce6e59c4d",
                                "sense_id": "898f3393-8978-33ea-8e8f-70eb989d0daf",
                                "text": "The interference theory of second language loss holds that forgetting is actually interference between the attriting language and the language replacing it."
                            }
                        ]
                    },
                    {
                        "sense_id": "d771bb69-66b3-3afb-999b-edacb74d660f",
                        "entry_id": "7ac7e189-f8d0-309d-9c95-64a00c8c0523",
                        "glosses": [
                            "To lose, or to kill, troops by attrition due to sustained firepower."
                        ],
                        "tags": [],
                        "examples": [
