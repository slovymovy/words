                ],
                "translations": [
                    {
                        "translation_id": "cd68fcf9-b7a4-4f94-b068-e6a5da47fd28",
                        "source_entry_id": "d021dd45-498c-3844-81bb-0059eb2621d9",
                        "target_lang_word": "chow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d253271-2777-307d-93ef-073a49b60149",
                                        "entry_id": "881d3e17-2919-30d9-b61e-7e9f56d892d3",
                                        "glosses": [
                                            "Food, especially snacks."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bafe13f7-11c7-45a9-80af-f62897f55e5d",
                                                "sense_id": "5d253271-2777-307d-93ef-073a49b60149",
                                                "text": "I'm going to pick up some chow for dinner."
                                            },
                                            {
                                                "example_id": "19fbc2a6-2252-408d-9a51-81068654321f",
                                                "sense_id": "5d253271-2777-307d-93ef-073a49b60149",
                                                "text": "Donlon says, \"Well, we're rich and we got beaucoup beer and beaucoup chow. Now all we need is the Bob Hope show.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3256cd0d-d40b-32d3-800f-7a99a6794cb0",
                                        "entry_id": "881d3e17-2919-30d9-b61e-7e9f56d892d3",
                                        "glosses": [
                                            "Unripe, or partially ripened, fruit seasoned and served as a dish, e.g. pineapple chow or mango chow."
                                        ],
                                        "tags": [
                                            "Trinidad-and-Tobago",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfb95f86-1ab2-3cd4-8809-77e11fc4a16e",
                                        "entry_id": "881d3e17-2919-30d9-b61e-7e9f56d892d3",
                                        "glosses": [
                                            "A Chow Chow."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328491a1-bfe0-46c9-8d69-741a8a85920b",
                                                "sense_id": "dfb95f86-1ab2-3cd4-8809-77e11fc4a16e",
                                                "text": "‘I'd try and grapple with him myself, only I've got my chow in my room, you know, and he goes for pigs wherever he finds them.’"
                                            },
                                            {
                                                "example_id": "f61f9a39-0ec7-4de1-9c4a-bc8f2ec65292",
                                                "sense_id": "dfb95f86-1ab2-3cd4-8809-77e11fc4a16e",
                                                "text": "While we were talking, one of the chows, the rusty one, had come over to me and I was absently petting him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24ec6e8a-2584-325d-972e-e29fd39aac41",
                                        "entry_id": "881d3e17-2919-30d9-b61e-7e9f56d892d3",
                                        "glosses": [
                                            "A Chinese person."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "archaic",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7770e6c1-951c-4afb-9d89-423b126a0cc2",
                                                "sense_id": "24ec6e8a-2584-325d-972e-e29fd39aac41",
                                                "text": "These were the creatures Nawnim had been amazed to see about him on the day of his arrival. When he inquired about them, Anna told him they were Japs an' Chows."
                                            },
                                            {
                                                "example_id": "1625953b-6409-45e7-9570-1d67e03fec27",
                                                "sense_id": "24ec6e8a-2584-325d-972e-e29fd39aac41",
                                                "text": "‘Now look here old man if you should ever bump into an interesting Chow from over the river – one with access, follow me? – just you remember High Haven!’"
                                            }
                                        ]
                                    }
                                ]
                            },
