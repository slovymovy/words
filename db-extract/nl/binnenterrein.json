                "senses": [
                    {
                        "sense_id": "3e9eb569-01b8-36e0-984d-eb587768e3e8",
                        "entry_id": "7122ddd4-a29b-30b5-bbc2-39576e65a6f3",
                        "glosses": [
                            "gebied dat door een of meer bouwwerken wordt ingesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599f58fc-f412-4bf1-b1e0-35984191cf6e",
                                "sense_id": "3e9eb569-01b8-36e0-984d-eb587768e3e8",
                                "text": "„Het is voor het eerst in lange tijd dat ik hier weer ben”, zegt ze aan een picknicktafel op een binnenterrein tussen de gebouwen."
                            },
                            {
                                "example_id": "06ed4ec4-62bc-4bf3-9028-5364b511661b",
                                "sense_id": "3e9eb569-01b8-36e0-984d-eb587768e3e8",
                                "text": "De huizenblokken hebben prachtige groene binnenterreinen."
                            },
                            {
                                "example_id": "b163b7bd-84e2-4919-9433-54e1b9db0956",
                                "sense_id": "3e9eb569-01b8-36e0-984d-eb587768e3e8",
                                "text": "Fijn voor hen is dat ze nog wel buiten kunnen spelen, op een binnenterreintje achter het huis."
                            }
                        ]
                    },
                    {
                        "sense_id": "45b59825-4ef3-344d-8edd-06630a3eb937",
                        "entry_id": "7122ddd4-a29b-30b5-bbc2-39576e65a6f3",
                        "glosses": [
                            "gebied dat wordt omsloten door een baan voor snelheidswedstrijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8962eca3-5baf-49a6-a993-7af6e4a7b293",
                                "sense_id": "45b59825-4ef3-344d-8edd-06630a3eb937",
                                "text": "Mijn vader leerde mij de racesport kennen. Ik was acht of negen toen we naar Zandvoort gingen. Pa had een kaartje geregeld voor het binnenterrein."
                            }
                        ]
                    }
