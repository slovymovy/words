                            {
                                "target_lang_word": "Lab",
                                "target_lang_sense_clarification": "Enzymgemisch zur Milchgerinnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24211ea3-30da-3fd6-8ed9-5ca6db1a2658",
                    "sense_definition": "Present participle and gerund of <w>yearn</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole afternoon <w>yearning</w> for a vacation by the sea.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte den ganzen Nachmittag damit, sich nach einem Urlaub am Meer <w>zu sehnen</w>."
                            }
