                                        "glosses": [
                                            "Sur-le-champ ; aussitôt ; tout de suite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb8df6e-5945-472e-8cfa-65292206b98c",
                                                "sense_id": "49fbcf91-d3fa-3a05-9816-4e3421ecf9a8",
                                                "text": "C’est un ouvrier qui doit se mettre sans délai à son ouvrage, et qui différerait vainement et nuisiblement de travailler."
                                            },
                                            {
                                                "example_id": "b2149cd2-8c6a-431e-b1ba-d514e3044381",
                                                "sense_id": "49fbcf91-d3fa-3a05-9816-4e3421ecf9a8",
                                                "text": "À la caserne, on est fréquemment convoqué par un capitaine inconnu qui veut connaître sans délai l’horaire de paquebots pour la Chine […]."
                                            }
                                        ]
