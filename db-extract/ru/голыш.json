                    {
                        "sense_id": "d2bc843b-c151-386d-b94b-50fe9cd3133b",
                        "entry_id": "b69d8584-83ed-312c-843b-0c40a94747fd",
                        "glosses": [
                            "река в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693c7bdc-68cf-466e-a410-794203bf65b9",
                                "sense_id": "d2bc843b-c151-386d-b94b-50fe9cd3133b",
                                "text": "Голыш — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
                    }
                ],
