                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d018ed-4305-4941-959e-da1339a77e84",
                        "source_entry_id": "b73c1504-5415-3014-b3fb-c85e200f5d94",
                        "source_sense_id": "f74dbf7c-7fe7-3c3e-812b-4e371b019caa",
