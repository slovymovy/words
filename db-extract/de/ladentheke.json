                                "sense_id": "79fdb8bf-a49e-3bb8-9eee-576325564b20",
                                "text": "„Sie holt Schachteln von verschiedenen Regalen herunter und öffnet sie auf der Ladentheke.“"
                            },
                            {
                                "example_id": "34ddb85a-e1b4-4be8-89a0-9731786cb33a",
                                "sense_id": "79fdb8bf-a49e-3bb8-9eee-576325564b20",
                                "text": "„In den acht Monaten, die er in Sandersons Laden arbeitete, schlief Cook unter der Ladentheke, wie damals für einen Ladenschwengel so üblich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
