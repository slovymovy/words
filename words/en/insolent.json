                    "sense_id": "596c9d20-dbeb-32a1-8cba-5ead684efda6",
                    "sense_definition": "A person who behaves in an insolent, rude, or disrespectful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>insolents</w> laughed and continued to mock the old man.",
                            "target_lang_translations": {
