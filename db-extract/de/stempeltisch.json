                "senses": [
                    {
                        "sense_id": "0956d3d9-bb50-340a-bd99-64f0d2636a6f",
                        "entry_id": "4d420955-cb0a-3ded-9fa6-7c53a3d88d94",
                        "glosses": [
                            "Arbeitsplatte, auf der Postbeamte einen Brief mit einem Poststempel versehen hat"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "f9504fd0-0269-410c-a392-b9ac34d37cc0",
                                "sense_id": "0956d3d9-bb50-340a-bd99-64f0d2636a6f",
                                "text": "„Fast vergessene Arbeitsmittel wie Stempeltisch, Beutelgestell, Schnürösen und Bundschließen versetzen den Besucher in die zurückliegenden Jahre und spiegeln die Arbeitsabläufe wider.“"
                            },
                            {
                                "example_id": "8e9ac335-7086-4124-907b-59dc36f2725c",
                                "sense_id": "0956d3d9-bb50-340a-bd99-64f0d2636a6f",
                                "text": "„Das Band 1 ruht in einem ausgemauerten und mit Eisenplatten abgedeckten Schacht im Kellerfußboden; es wirft die Briefe auf das schräg aufwärtsführende Band 3 ab, das die Briefe zum Stempeltisch befördert.“"
                            },
                            {
                                "example_id": "15256cf4-2395-4a3e-81ce-888a7faf9e5d",
                                "sense_id": "0956d3d9-bb50-340a-bd99-64f0d2636a6f",
                                "text": "„1969 wurde beim Wegrücken des sich in der Nähe des Stempeltisches befindlichen Grobverteilspindes ein Brief in stark beschädigtem und leicht verschmutztem Zustand vorgefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
