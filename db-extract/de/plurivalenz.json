                ],
                "senses": [
                    {
                        "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                        "entry_id": "54367b66-e0ce-3398-af1b-39b9a6ab97cb",
                        "glosses": [
                            "Eigenschaft, auf vielfältige Weise genutzt oder gedeutet werden zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa21759-4656-475b-99bc-ccb1d0075cba",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Einen komplexen Text, dessen Komplexität auf der Plurivalenz eines Lexems beruht, nennen wir Wortspiel.“"
                            },
                            {
                                "example_id": "98c028dc-44b8-45d4-8239-c2fa096518a9",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Sprache eignet eine gewisse Plastizität für die metrische Formung im Sinne einer prosodischen Plurivalenz.“"
                            },
                            {
                                "example_id": "2189b14d-2412-4aa6-b67e-a0b63c0a41ac",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Diese Plurivalenz wird durch die geschickte Einfügung eines bildinternen Rahmens durch weitere Sinndimensionen ergänzt.“"
                            },
                            {
                                "example_id": "60e7a96a-98ef-4580-aea4-75051072e14c",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Auf diese Weise könnte auch der Plurivalenz von Gerechtigkeitsdiskursen angemessen Rechnung getragen und für diesen verwickelten Gegenstandsbereich eine Einheit in der Vielfalt im Sinne einer operativen Kernmoralität erreicht werden.“"
                            },
                            {
                                "example_id": "4631edd3-9eed-4ae9-a495-28a70e2cb90f",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Trotz der Plurivalenz des Begriffes, wie später noch zu zeigen sein wird, steht Globalisierung in der öffentlichen Wahrnehmung in erster Linie für die Ökonomisierung der Welt in unserem Zeitalter.“"
                            },
                            {
                                "example_id": "e4ca0e03-1b26-435b-8a34-067d0ae09a11",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Dies ergibt sich aus der Plurivalenz der miteinander besonders verketteten sozialen, kulturellen und ökonomischen Aktivitäten eines Raumes, die eine Eigendynamik entwickeln.“"
                            },
                            {
                                "example_id": "a95b7bf9-53bf-4a9c-a901-a2dc4fb8538f",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Hierfür spricht auch die immense Vielfalt an Staaten und staatsähnlichen Formen sowie die Plurivalenz sozialer Bindungen.“"
                            },
                            {
                                "example_id": "748f7774-7ff9-4ad4-a9e9-82f0790dedb5",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Die Plurivalenz der Melancholie und der Musik bringt es mit sich, daß in vielen Darstellungen verschiedene Bedeutungen mitschwingen und das gleiche Denkmal eigentlich verschiedenen Rubriken zugeordnet werden könnte.“"
                            },
                            {
                                "example_id": "e27830c2-cbca-4a03-9123-6c7aa7b9358e",
                                "sense_id": "e1f63010-92c1-369c-9196-40b732bac93c",
                                "text": "„Ihm wird vorgeworfen, die Heterogenität und Plurivalenz der nietzscheschen Schrift unterschätzt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
