                "senses": [
                    {
                        "sense_id": "c9d32dc7-9ea4-35a0-a516-dbf35eb97fd5",
                        "entry_id": "80b2ffd6-348a-391b-895a-3bb9f8de2908",
                        "glosses": [
                            "Donner un caractère nivernais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bffbfba4-d91c-4d25-95ba-0a04e37baec9",
                                "sense_id": "c9d32dc7-9ea4-35a0-a516-dbf35eb97fd5",
                                "text": "Deux autres éléments contribuent à « niverniser » ce qui échappe à l’autorité féodale des comtes puis ducs."
                            },
                            {
                                "example_id": "1d68410a-ece8-4664-ac4b-730fa7815c7c",
                                "sense_id": "c9d32dc7-9ea4-35a0-a516-dbf35eb97fd5",
                                "text": "La crise agricole de 1820 à 1823 allait donner un coup de fouet décisif à cet élevage qui va remplacer le \"bétail rouge\" alors typique du Nivernais, par la fameuse \"Reine Blanche\" de nos jours, la charolaise que l'on a un temps qualifiée de \"nivernisée\" par rapport à la souche d'origine."
                            }
                        ]
                    }
