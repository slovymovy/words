                        "examples": [
                            {
                                "example_id": "b315284c-7bdd-4a25-94e9-f4511cda35f9",
                                "sense_id": "925f585e-5a84-3fba-b179-c3f342bd4186",
                                "text": "Hun tienjarig kind ging naar groep 7 van de basisschool."
                            },
                            {
                                "example_id": "d52ba112-add8-4900-b950-5409fe4e0e15",
                                "sense_id": "925f585e-5a84-3fba-b179-c3f342bd4186",
                                "text": "Toen ik mijn tienjarige zoon vroeg wat hij ervan vond dat ik zo lang weg zou zijn, antwoordde hij: ‘Geen idee, dat weet ik toch pas als je weg bent?’ Grappig vond ik zijn opmerking over het motief van mijn reis: ‘Wat is het nut van je wandeling? Je bereikt en verdient er niks mee.’ Mijn vijftienjarige dochter reageerde net als mijn vrouw pragmatisch en recht door zee."
                            }
                        ]
                    }
