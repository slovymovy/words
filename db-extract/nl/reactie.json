                ],
                "senses": [
                    {
                        "sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                        "entry_id": "816c314f-b797-3f11-8f87-a50dafad92d6",
                        "glosses": [
                            "een actie die een gevolg is van een stimulus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b77dba6-4c05-479e-a48f-8acf539ef866",
                                "sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                                "text": "De aankondiging van zijn ontslag leidde tot een emotionele reactie."
                            },
                            {
                                "example_id": "6b0fabdc-9c68-4e3d-9eee-43f40b0441d0",
                                "sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                                "text": "Toen ik de laatste keer mosselen at, kreeg ik een felle allergische reactie."
                            },
                            {
                                "example_id": "f1d2d647-13e2-4d56-9e20-325cd772c2b7",
                                "sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                                "text": "De ANVR laat in een reactie weten teleurgesteld te zijn en overweegt een hoger beroep."
                            },
                            {
                                "example_id": "6e896023-35ce-4e4d-88d5-c1389f4d7b9c",
                                "sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                                "text": "Voor vertrek kreeg ik naast enthousiaste reacties ook veel aanmerkingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0028e8a2-2968-35a1-9ade-28a8148de222",
                        "entry_id": "816c314f-b797-3f11-8f87-a50dafad92d6",
                        "glosses": [
                            "een proces waarbij stoffen veranderen doordat er bindingen gevormd en/of verbroken worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c824498-828a-475c-a2b9-e14ecf19c982",
                                "sense_id": "0028e8a2-2968-35a1-9ade-28a8148de222",
                                "text": "De reactie van H₂ met O₂ leidt tot de vorming van H₂O."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6f32dd9-b064-4e85-b92b-4103d7a569a8",
                        "source_entry_id": "816c314f-b797-3f11-8f87-a50dafad92d6",
                        "source_sense_id": "22545f8b-cb7b-350d-9a1b-7ece9f1916f8",
                        "source_sense_description": "een actie die een gevolg is van een stimulus",
                        "target_lang_word": "Reaktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reaktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                        "entry_id": "94eda61d-6c0b-3203-885f-8e4127383f17",
                                        "glosses": [
                                            "(Gegen-)Handlung beziehungsweise Wirkung, die aus einer vorhergehenden Handlung oder einem Reiz folgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5bce6b-95b7-44b1-b1f4-b721695ee4dd",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Müssten deine Eltern nicht mal langsam eine Reaktion zeigen?"
                                            },
                                            {
                                                "example_id": "ef56c111-e771-4a33-b179-47cd561c5a03",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Auf unsere Aktion am Marktplatz gab es die unterschiedlichsten Reaktionen."
                                            },
                                            {
                                                "example_id": "1f173e64-d2ee-4c71-bf97-48ac9003facb",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Die Reaktion des Publikums auf die Darbietung war überaus positiv: es gab stürmischen Beifall."
                                            },
                                            {
                                                "example_id": "180ec75b-586a-42b7-a65d-39062b096934",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Die Reaktion auf den Vertrauensbruch ließ nicht auf sich warten."
                                            },
                                            {
                                                "example_id": "a5469446-e721-4d8a-9409-eab8aadbe889",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Wir warten jetzt auf eine Reaktion des Königshauses."
                                            },
                                            {
                                                "example_id": "ba68ff9b-8bb3-4492-9ac4-602c4e6cb6be",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Die erwartete Reaktion blieb jedoch aus."
                                            },
                                            {
                                                "example_id": "bf352b87-0d7e-41b5-9b9f-9c7c603f535d",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "„Deshalb begann er mit den Leuten in der Menge zu sprechen, um ihre Reaktion zu erfahren.“"
                                            },
                                            {
                                                "example_id": "a17eda24-ec19-49fc-b7b6-84b83f567d27",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "„Als Reaktion auf die Trockenheit kündigen immer mehr Landkreise und Städte an, die Entnahme von Oberflächenwasser zu untersagen.“"
                                            },
                                            {
                                                "example_id": "d1bc4955-153f-4093-b130-be27d234d1c8",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "„Risiken beim Einsatz gentechnisch veränderter Pflanzen sind neben einer Bedrohung der Artenvielfalt auch Nebeneffekte wie das Auftreten neuer unerwünschter Eigenschaften bei den Pflanzen, aber auch allergische Reaktionen bei den Verbrauchern.“"
                                            },
                                            {
                                                "example_id": "6739edad-0ff3-4752-9623-5d5bf48f823f",
                                                "sense_id": "5a861c5c-721d-35f5-ad82-47f236e826ce",
                                                "text": "Erst mischt man die zwei Stoffe, wartet die Reaktion ab und entnimmt dann die obere Schicht des Gemisches."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae3a39c3-aa85-3c64-923a-52a29c73dc08",
                                        "entry_id": "94eda61d-6c0b-3203-885f-8e4127383f17",
                                        "glosses": [
                                            "Vorgang, bei dem eine oder meist mehrere chemische Verbindungen in andere umgewandelt werden und Energie freigesetzt oder aufgenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4816486f-9995-4cd9-bd12-ea272deac3ac",
                                                "sense_id": "ae3a39c3-aa85-3c64-923a-52a29c73dc08",
                                                "text": "Erst mischt man die zwei Stoffe, wartet die Reaktion ab und entnimmt dann die obere Schicht des Gemisches."
                                            },
                                            {
                                                "example_id": "129434fa-196f-4f29-8f3e-df81096c5224",
                                                "sense_id": "ae3a39c3-aa85-3c64-923a-52a29c73dc08",
                                                "text": "Die Reaktion zwischen Magnesium und Kohlenstoffdioxid ist spannend."
                                            },
                                            {
                                                "example_id": "95670e37-5a04-4ddc-9b0d-589f8c5fc49a",
                                                "sense_id": "ae3a39c3-aa85-3c64-923a-52a29c73dc08",
                                                "text": "„Die bei der Reaktion von Natrium mit Wasser entstandene Lösung wird als Natronlauge bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd405268-baaf-3365-addb-f42cb949c65f",
                                        "entry_id": "94eda61d-6c0b-3203-885f-8e4127383f17",
                                        "glosses": [
                                            "politische Gruppierung/Haltung, die hergekommene Verhältnisse bewahren will und daher Neuerungen ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21046cb3-e0c7-425a-ba3a-124f91587419",
                                                "sense_id": "cd405268-baaf-3365-addb-f42cb949c65f",
                                                "text": "„Er hat mit seiner Rede gegen den Imperialismus und gegen die Kriegsverbrecher den erbitterten Haß der deutschen Reaktion erregt.“"
                                            },
                                            {
                                                "example_id": "db48ab0d-d623-42c0-86fa-8991efe7c46b",
                                                "sense_id": "cd405268-baaf-3365-addb-f42cb949c65f",
                                                "text": "„In den folgenden Wochen eskalierte der Kampf zwischen Revolution und Reaktion in ganz Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86c048a2-0acc-488c-94ae-c6436c573ff5",
                        "source_entry_id": "816c314f-b797-3f11-8f87-a50dafad92d6",
