                    {
                        "sense_id": "11eae44e-a3d1-3f05-8218-28b5a9285ad8",
                        "entry_id": "ad7d446a-e844-3c8b-bc9b-e7215ff810b7",
                        "glosses": [
                            "Angehöriger des alten, römischen, gleichnamigen Herrschergeschlechts, das mehrere Kaiser stellte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1ccae9cf-2d7e-4e7e-942f-14de86f10404",
                                "sense_id": "11eae44e-a3d1-3f05-8218-28b5a9285ad8",
                                "text": "„Mit den Flaviern (69-98) bestieg die erste außerhalb Roms beheimatete italische Familie den Thron der Caesaren.“"
                            },
                            {
                                "example_id": "cd296430-31fb-4526-9625-4013745c1175",
                                "sense_id": "11eae44e-a3d1-3f05-8218-28b5a9285ad8",
                                "text": "„Unter den Flaviern eroberten die Statthalter Cerialis und Frontinus zunächst Nordengland und ganz Wales, bevor Tacitus’ Schwiegervater Julius Agricola schließlich zum Sprung nach Schottland ansetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
