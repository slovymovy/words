                        "glosses": [
                            "nach mündlicher Überlieferung ein guter Schiffsgeist, der sein Schiff bis zum Untergang nicht verlässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb870a2-c4ac-4e74-b4eb-a46b546a9f46",
                                "sense_id": "889f4cc0-bd24-35e1-8e87-9cc81ab25a60",
                                "text": "„Auch sein Landsmann gehörte der Klasse der Kobolde an, allerdings jener anderen Abteilung, die dem Wasser zugeordnet ist und die bei uns im Norden durch die Figur des Klabautermannes vertreten wird.“"
                            }
                        ],
