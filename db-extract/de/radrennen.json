                "senses": [
                    {
                        "sense_id": "0c333c87-b677-3075-b02b-bdac353ffe8a",
                        "entry_id": "1b1dfe1f-92fb-3be0-8f1c-51b1833e7af4",
                        "glosses": [
                            "Wettrennen, das mit Fahrrädern ausgetragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7e0e0d-886b-47b9-9515-877e32ac73ac",
                                "sense_id": "0c333c87-b677-3075-b02b-bdac353ffe8a",
                                "text": "„Strasser schaffte seinen vierten Triumph beim längsten Radrennen der Welt.“"
                            },
                            {
                                "example_id": "e6dcbd2c-d0fc-4590-89ef-f777f5bb1d1d",
                                "sense_id": "0c333c87-b677-3075-b02b-bdac353ffe8a",
                                "text": "„Das Radrennen, das Hayden so sehr ans Limit gebracht hatte, dass er kaum noch einen klaren Satz zustande brachte, führt quer durch Europa.“"
                            },
                            {
                                "example_id": "fcf60c55-ad74-4905-b975-ede3b2a810dc",
                                "sense_id": "0c333c87-b677-3075-b02b-bdac353ffe8a",
                                "text": "„In manchen Momenten fühlt es sich in an, als sei dies hier in Predazzo mehr Verkaufsveranstaltung als Radrennen, ein perfekt durchorganisierter Cluburlaub inklusive Werbepausen für Menschen mit rasierten Waden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
