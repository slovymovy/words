                    "sense_definition": "mający wiele zakrętów, załamań; kręty, wijący się",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przestrzenny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wąska, <w>zawiła</w> ścieżka prowadziła turystów przez gęsty las ku szczytowi góry.",
                            "target_lang_translations": {
                                "ru": "Узкая, <w>извилистая</w> тропинка вела туристов через густой лес к вершине горы."
                            }
                        },
                        {
                            "text": "Samochód powoli pokonywał kolejne zakręty na wyjątkowo <w>zawiłej</w> trasie.",
                            "target_lang_translations": {
                                "ru": "Автомобиль медленно преодолевал очередной поворот на исключительно <w>петляющей</w> трассе."
                            }
