                "senses": [
                    {
                        "sense_id": "40e2e67d-82e3-3c48-844f-92a790e029d1",
                        "entry_id": "b2b54a68-d733-38b4-8885-63f88791610c",
                        "glosses": [
                            "Feuerzeug, das mit Gas betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3760825-fc82-4681-8a47-fab953099edf",
                                "sense_id": "40e2e67d-82e3-3c48-844f-92a790e029d1",
                                "text": "„Entgegen dem Wortlaut der offiziellen Richtlinie ist es merkwürdigerweise erlaubt, ein Gasfeuerzeug mit ins Flugzeug zu nehmen.“"
                            },
                            {
                                "example_id": "39c5afd5-7795-4b06-8852-69a1fa0c1298",
                                "sense_id": "40e2e67d-82e3-3c48-844f-92a790e029d1",
                                "text": "„Ich schneide der einen Zigarre die Spitze ab und zünde sie mit dem Gasfeuerzeug an, bis sie gleichmäßig brennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
