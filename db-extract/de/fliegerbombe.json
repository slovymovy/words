                ],
                "senses": [
                    {
                        "sense_id": "f95e773e-62ad-305a-8786-a207cca7f1f0",
                        "entry_id": "590d166d-ea3d-331f-86db-ec67ace421ee",
                        "glosses": [
                            "Bombe, die von einem Flugzeug abgeworfen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e7d8ee-bf4f-451d-93ee-cf56b23556d7",
                                "sense_id": "f95e773e-62ad-305a-8786-a207cca7f1f0",
                                "text": "Das Gebäude wurde durch Fliegerbomben schwer beschädigt."
                            },
                            {
                                "example_id": "3f7a79b5-1e04-402e-9813-44abc9319bea",
                                "sense_id": "f95e773e-62ad-305a-8786-a207cca7f1f0",
                                "text": "„Bei dem neu entdeckten Sprengkörper handelte es sich um eine US-amerikanische 250 Kilo-Fliegerbombe mit Aufschlagzünder, die innerhalb von drei Stunden geborgen und abtransportiert werden konnte.“"
                            },
                            {
                                "example_id": "cbc32e44-d8de-4177-a184-3d20c5d67bd0",
                                "sense_id": "f95e773e-62ad-305a-8786-a207cca7f1f0",
                                "text": "„Wie benommen waren die Deutschen aus den kataklysmischen Strudeln des Krieges aufgetaucht, taub noch von den Explosionsgeräuschen der Fliegerbomben und Artilleriegranaten, abgestumpft durch die Tristesse der Umstände, erschöpft von der schieren Mühsal des Überlebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
