                        "cross_references": [
                            {
                                "target_word": "spaghetti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494228c5-610e-3469-86ad-c3732d59733c",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "A type of pasta made in the shape of long thin strings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c539435-e686-46a0-89bf-b252f330dd55",
                                                "sense_id": "494228c5-610e-3469-86ad-c3732d59733c",
                                                "text": "Her mother was cooking spaghetti for dinner."
                                            },
                                            {
                                                "example_id": "ea37f500-c3e2-4428-a23c-aaca21f2df94",
                                                "sense_id": "494228c5-610e-3469-86ad-c3732d59733c",
                                                "text": "Maccheroni, or Spaghetti, a smaller kind of macaroni, sufficient for the dinner of an ordinary mortal, generally follows the soup. It is as a rule served up with tomato sauce, and Parmesan cheese thickly scattered over it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b01ff7c1-c98b-3a07-bde9-caf3e0b32468",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "A type of pasta made in the shape of long thin strings.",
                                            "A dish that has spaghetti (sense 1) as a main part of it, such as spaghetti bolognese."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a32aeaa1-5125-3ea8-974b-c4db33cd0b0c",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Denoting Italianness.",
                                            "An Italian person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "derogatory",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a19f865c-b3b0-3702-97cd-0e13d4bcb001",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Denoting Italianness.",
                                            "Ellipsis of spaghetti western (“a motion picture depicting a story of cowboys and desperadoes set in the American Old West, but produced by an Italian-based company and filmed in Europe, notably in Italy”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "broadly",
                                            "countable",
                                            "ellipsis",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "016184a6-e262-3bda-808a-f7c01a198c94",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Something physically resembling spaghetti (sense 1) in appearance or consistency, or in being tangled."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "informal",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "136b2fd7-ca1d-4159-b018-848b46684060",
                                                "sense_id": "016184a6-e262-3bda-808a-f7c01a198c94",
                                                "text": "spaghetti grid    spaghetti junction    spaghetti limbs    spaghetti strap    spaghetti stripes"
                                            },
                                            {
                                                "example_id": "5e8178a2-5c66-41c3-b7ad-c6e1e40cc94d",
                                                "sense_id": "016184a6-e262-3bda-808a-f7c01a198c94",
                                                "text": "Or how about that spaghetti of cables, adaptors and plugs you keep in a box somewhere, the detritus of old phones, laptops and tablets — each with a different charging point — is that not an example of staggeringly wasteful, bad design?"
                                            },
                                            {
                                                "example_id": "85e06bfa-0614-46c8-9fcd-7b49a2566c41",
                                                "sense_id": "016184a6-e262-3bda-808a-f7c01a198c94",
                                                "text": "“But the infrastructure is like spaghetti,” he continued. “It’s chaotic, it doesn’t connect up and there’s no cohesive network. If you can get that right, it will eliminate a lot of confusion.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef2e62c-41da-362d-ad6b-e16667bae921",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Something physically resembling spaghetti (sense 1) in appearance or consistency, or in being tangled.",
                                            "Electrical insulating tubing or electrical wiring."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "informal",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bd375ce-bc57-32c5-9f6e-abc4a876f9d8",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Something physically resembling spaghetti (sense 1) in appearance or consistency, or in being tangled.",
                                            "Roads forming a complex junction, especially one with multiple levels on a motorway."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "informal",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d768ea7-36ac-3d2c-bc2a-3bcc8b904f50",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Something confusing or intricate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44de041f-9eab-4a7e-b9c6-899f89ecbc56",
                                                "sense_id": "4d768ea7-36ac-3d2c-bc2a-3bcc8b904f50",
                                                "text": "The lands along the Danube, by contrast, seemed wide open. That is, if he could find his way through them. “Arrows drawn on maps build up into an astonishing spaghetti of population movement,” Mr. Winder writes, and a single city like Lviv, now in Ukraine, might also have been called Lemberg, Lemberik, Lwow or Lvov."
                                            },
                                            {
                                                "example_id": "4e5aa5c2-4cab-4fa8-8e30-3e0f4d8c3612",
                                                "sense_id": "4d768ea7-36ac-3d2c-bc2a-3bcc8b904f50",
                                                "text": "In an age when the charts have become an algorithmic spaghetti of streaming plays, radio and downloads, the purest way of measuring who is up and who is down in pop might be the Billboard Social 50, a sub-chart that measures reach across social networks."
                                            },
                                            {
                                                "example_id": "a160ee05-2887-45fe-85db-645bb5688b03",
                                                "sense_id": "4d768ea7-36ac-3d2c-bc2a-3bcc8b904f50",
                                                "text": "Then there’s payments tech. Over the past decade, private equity has been instrumental in consolidating that industry; Worldpay and Nexi serve as two good examples. And while the logic of creating economies of scale was simple, this created a spaghetti of IT technical debt with disparate systems, which hampered the speed of innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1dec227-3b97-3edf-8601-62b7906d4d86",
                                        "entry_id": "c8f15eb8-e239-31f6-acaf-168ea3db0e93",
                                        "glosses": [
                                            "Something confusing or intricate.",
                                            "Ellipsis of spaghetti code (“unstructured or poorly structured program source code, especially code with many GOTO statements or their equivalent”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "derogatory",
                                            "ellipsis",
                                            "figuratively",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spaghetti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28bb68d4-1f50-3aa9-967d-9c96eebf7817",
                                        "entry_id": "39f0688d-695c-3096-9d84-3d7edd82a66a",
