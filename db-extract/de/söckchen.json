                        "entry_id": "a4d51ab5-de88-376d-b519-620d50051aac",
                        "glosses": [
                            "eine in allen ihren Maßen kleine Socke"
                        ],
                        "tags": [
                            "Diminutiv von Socke"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5466d5-9a6d-4d6e-803e-6a92bb2c0049",
                                "sense_id": "69d095a0-2092-332b-98a2-6a9101a2e109",
                                "text": "Der Puppe strickte sie gestreifte Söckchen, die denen ihrer Tochter ähnelten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7266cb1d-a7c2-3420-87d7-93943903f8e5",
                        "entry_id": "a4d51ab5-de88-376d-b519-620d50051aac",
                        "glosses": [
                            "eine Socke, die einen sehr kurzen Strumpfschaft hat und aus eher dünnem Material ist"
                        ],
                        "tags": [
                            "Diminutiv von Socke"
                        ],
                        "examples": [
                            {
                                "example_id": "d77fb23b-35bc-4d4a-bbfb-8a8916a41896",
                                "sense_id": "7266cb1d-a7c2-3420-87d7-93943903f8e5",
                                "text": "Du willst doch keine Söckchen in den Skistiefeln anziehen! Das ist viel zu kalt!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
