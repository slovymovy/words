                    {
                        "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                        "entry_id": "a0e1a8de-680e-39b1-aa85-b41e2c05725e",
                        "glosses": [
                            "To search for (something) on the Internet using the Baidu search engine."
                        ],
                        "tags": [
                            "transitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "281ddb76-a256-45e0-881f-e33caff35ad5",
                                "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                                "text": "To ground my assumption in facts, I “googled” and “baidued” the major Baidu events in 2008 and 2009."
                            },
                            {
                                "example_id": "cb12b6cc-30f1-49ab-aae9-282713f32a9a",
                                "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                                "text": "This generally involves students reading the text for the main idea of the text, consulting print dictionary or online dictionary or Googling /Baiduing (one of the most popular searching engine in China) for difficult words, phrases, expression and sentence structure and figure out how they should be used properly if they can’t find satisfying answers from their print dictionaries."
                            },
                            {
                                "example_id": "e271a37c-b2b6-4d6c-8110-1cf255391987",
                                "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                                "text": "P.S, did some baiduing, found your cool dictator book"
                            },
                            {
                                "example_id": "aa0e77c0-1b6f-4012-8b5a-3190e664cb4f",
                                "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                                "text": "From May 6, 2014 I read online English news by Googling news of “Alibaba IPO.” Simultaneously, I read online Chinese news by Baiduing news of “Alibaba IPO.”"
                            },
                            {
                                "example_id": "3cd1b8f8-16e7-4912-a454-3b7e53adbe4a",
                                "sense_id": "d54564ad-899a-366a-bc37-bc7cb9e40da6",
                                "text": "When I baidued the keywords “剩女/leftover women” and “新华网/Xinhua.net,” a website sponsored by the Chinese government on June 11, 2019, at 11:30a.m., I found numerous reports on the leftover women on the Xinhua net."
                            }
                        ]
                    }
