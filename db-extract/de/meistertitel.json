                        "glosses": [
                            "Auszeichnung, die man bekommt, wenn man einen (sportlichen) Wettbewerb gewinnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45601708-6b57-48a1-be45-2f23f857b7b1",
                                "sense_id": "54f1cf8a-8d32-317c-903a-e593a060ed20",
                                "text": "Mit seinem Verein hat er den Meistertitel geholt."
                            },
                            {
                                "example_id": "a276ba35-8701-46c6-b9fa-f33f49ea1ff5",
                                "sense_id": "54f1cf8a-8d32-317c-903a-e593a060ed20",
                                "text": "„Die deutsche Männermannschaft holte nach 1954 und 1974 zuletzt 1990 den Meistertitel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7701ccda-bd3f-3b05-b932-d1967bdc9299",
