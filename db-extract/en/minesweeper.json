                    {
                        "translation_id": "a7a6e043-80a8-487a-a1ea-cb05b1f26cc1",
                        "source_entry_id": "8b62452c-c33c-37f2-b20b-25ae33f163b0",
                        "source_sense_description": "vehicle, device or person for the removal of mines",
                        "target_lang_word": "démineur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "270af5e4-2bc7-3593-9154-daa4ac44de4d",
                                        "entry_id": "fc24a3c1-dc7a-3756-a2a4-0810bedd2518",
                                        "glosses": [
                                            "Personne dont le métier consiste à désactiver des mines, bombes ou autres munitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115d188d-e0fe-4b85-a2dc-92ac0f2a1ffd",
                                                "sense_id": "270af5e4-2bc7-3593-9154-daa4ac44de4d",
                                                "text": "Mais un second allumeur peut être caché et faire exploser l’engin lorsqu’un démineur inexpérimenté essaiera de déterrer ce dernier."
                                            },
                                            {
                                                "example_id": "7c26164b-6642-4b81-b142-2ea50af9eb58",
                                                "sense_id": "270af5e4-2bc7-3593-9154-daa4ac44de4d",
                                                "text": "En attendant les démineurs pour les sortir de là, la police militaire sur la route faisait circuler les convois et interdisait l'approche du périmètre miné."
                                            },
                                            {
                                                "example_id": "6822e123-cfaa-4d94-b14f-2caa3c1989aa",
                                                "sense_id": "270af5e4-2bc7-3593-9154-daa4ac44de4d",
                                                "text": "En 2000, je suis allé au Kosovo et j'ai revêtu une de ces cuirasses des démineurs. C'est lourd, ça pèse trente-cinq kilos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "850bb479-740e-3ff0-8147-5c81f03fed85",
                                        "entry_id": "fc24a3c1-dc7a-3756-a2a4-0810bedd2518",
                                        "glosses": [
                                            "Jeu informatique consistant à déminer une grille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029a0e73-ab20-40e9-ab8e-f5dff8e49c72",
                                                "sense_id": "850bb479-740e-3ff0-8147-5c81f03fed85",
                                                "text": "Les premiers jeux occasionnels ayant obtenu un vrai succès sont « le solitaire », «le démineur» et « Tétris»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
