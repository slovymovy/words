                {
                    "sense_id": "e727164a-33ad-3eb0-b3ff-32d4af6f8b95",
                    "sense_definition": "A diminutive of the male given names <w>Edward</w> or <w>Theodore</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My cousin <w>Teddy</w> is coming to visit us next week.",
                            "target_lang_translations": {
