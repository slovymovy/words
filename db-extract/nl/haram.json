                    }
                ],
                "translations": [
                    {
                        "translation_id": "85a21c74-a2af-447c-8ac9-610e22beb583",
                        "source_entry_id": "f55564ee-b4b0-3914-82e7-2b15dd8d27c0",
                        "source_sense_id": "e6c101bb-0925-3493-8cc5-227898b98074",
                        "target_lang_word": "haram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce0d965b-68b2-315c-b196-96a2bb0943be",
                                        "entry_id": "6c76339e-6e2d-32a3-b22d-f32dbee0f9bc",
                                        "glosses": [
                                            "A sin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3dd6cd-985c-41a6-bb10-9beaca97d3d3",
                                                "sense_id": "ce0d965b-68b2-315c-b196-96a2bb0943be",
                                                "text": "In case of necessity it is permissible to change one's madhhab or to do a few things according to another madhhab. It is haram to cheat in order to omit a fard or commit a haram."
                                            },
                                            {
                                                "example_id": "01d946ef-ea35-4dbb-a955-bd2dec140566",
                                                "sense_id": "ce0d965b-68b2-315c-b196-96a2bb0943be",
                                                "text": "In Arabic, haram is the noun derived from the verb hrm, the opposite of what it allowed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7069fb-8881-31a4-b171-21739d7052c9",
                                        "entry_id": "e3846091-604c-3e45-914e-17eaa2aac88d",
                                        "glosses": [
                                            "Forbidden by Islam: unlawful, sinful."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a199377-a4de-4d6b-9d6f-91edf661ff7b",
                                                "sense_id": "ee7069fb-8881-31a4-b171-21739d7052c9",
                                                "text": "I can’t speak about sex with my friends in Arabic. The words are too heavy and culturally loaded. It all sounds haram (sinful)."
                                            },
                                            {
                                                "example_id": "ae96f552-b78a-4609-888c-7e72ce64acd7",
                                                "sense_id": "ee7069fb-8881-31a4-b171-21739d7052c9",
                                                "text": "[…] collateral assets must not be debt, cash or prohibited as haram (sinful activity) and must not be associated in any way with unethical or exploitative operations or with speculation and uncertainty (gharar) […]"
                                            },
                                            {
                                                "example_id": "8b6eee1a-d74c-45dc-a5b1-e6a38055cd7b",
                                                "sense_id": "ee7069fb-8881-31a4-b171-21739d7052c9",
                                                "text": "A year ago, the Party didn't even exist; some Salafi preachers had deemed democracy haram—forbidden under Islamic law."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba0c4653-3126-4289-9058-6cd9de1ee0ec",
                        "source_entry_id": "f55564ee-b4b0-3914-82e7-2b15dd8d27c0",
                        "source_sense_id": "e6c101bb-0925-3493-8cc5-227898b98074",
                        "target_lang_word": "haram",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haram",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43b9b3fc-441d-3ce2-86c7-3b498b2d3b08",
                                        "entry_id": "6b734c2c-e578-3d5b-b6d6-42b727363ec1",
                                        "glosses": [
                                            "Interdit par le Coran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5386990-2bd2-4ed1-9abf-c4d7b29b63d3",
                                                "sense_id": "43b9b3fc-441d-3ce2-86c7-3b498b2d3b08",
                                                "text": "Tu sais, c’est haram chez nous, qu’une musulmane prenne un chrétien ou un juif ; et pourtant, tu es beau, tu es bon. Je t’aime…"
                                            },
                                            {
                                                "example_id": "13270c05-f340-4982-b1ff-e54381bf6189",
                                                "sense_id": "43b9b3fc-441d-3ce2-86c7-3b498b2d3b08",
                                                "text": "L’autre jour, un producteur de vin me racontait ses misères. Impossible de trouver des ouvriers, l’activité est considérée comme haram, illicite."
                                            },
                                            {
                                                "example_id": "5c7dfd0f-3904-4c0e-a03f-2b36dac42ae3",
                                                "sense_id": "43b9b3fc-441d-3ce2-86c7-3b498b2d3b08",
                                                "text": "Ton argent, il m’a dit, il est haram, comme ta peinture, comme toute ta vie, je n’y toucherai jamais ! Tu le crois ça, Naïma, tu le crois ? C’est pour ça qu’on s’est battus ?"
                                            },
                                            {
                                                "example_id": "c9518196-680f-464a-9672-42595454485d",
                                                "sense_id": "43b9b3fc-441d-3ce2-86c7-3b498b2d3b08",
                                                "text": "L’accusée se serait défendue contre son époux qui voulait pratiquer une «relation sexuelle haram», c’est-à-dire considérée pêchée dans la religion musulmane, selon la mère de l’épouse, citée par «Algérie360». Le mari aurait demandé à son épouse une fellation ou une sodomie, ce qui aurait fait réagir violemment la nouvelle mariée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bef4a56-0d35-4e2e-9d9e-56896ef3f425",
                        "source_entry_id": "f55564ee-b4b0-3914-82e7-2b15dd8d27c0",
                        "source_sense_id": "e6c101bb-0925-3493-8cc5-227898b98074",
