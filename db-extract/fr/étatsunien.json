                "senses": [
                    {
                        "sense_id": "fdf3975d-a0a7-35fa-8d23-9d847fd298e0",
                        "entry_id": "9f2727bb-390d-3dc0-bb59-75177df5cf31",
                        "glosses": [
                            "Citoyen des États-Unis d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c7fe15-fb5b-4b60-8615-fc2f2d9b888e",
                                "sense_id": "fdf3975d-a0a7-35fa-8d23-9d847fd298e0",
                                "text": "Les Étatsuniens apprécient de plus en plus le spectacle en pantoufles que leur offre la télévision et le télécinéma."
                            },
                            {
                                "example_id": "7efdecaf-5c9e-4198-90f2-5b65fdfea435",
                                "sense_id": "fdf3975d-a0a7-35fa-8d23-9d847fd298e0",
                                "text": "Si les Étasuniens ont toléré jusqu’à présent les outrances de Trump et de son équipe, alors il est peu probable qu’ils les arrêtent dans les années à venir."
                            }
                        ]
                    }
