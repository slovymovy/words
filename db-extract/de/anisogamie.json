                "senses": [
                    {
                        "sense_id": "ffa8ac76-30e6-3755-9822-6a0196bb0562",
                        "entry_id": "b5084b56-35ae-3f93-bb15-df52a9a22985",
                        "glosses": [
                            "Bei der geschlechtlichen Fortpflanzung die Vereinigung von Gameten, die sich in ihrem Aussehen unterschieden"
                        ],
                        "tags": [
                            "Fortpflanzungsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "27d3f1c3-1297-4c26-8c93-6a3bd2350723",
                                "sense_id": "ffa8ac76-30e6-3755-9822-6a0196bb0562",
                                "text": "Auf dem Weg zur Sexualität, bei der die Gameten als Eizellen und Spermien vorliegen, hat sich bei Mikroorganismen die Anisogamie entwickelt, bei der die Gameten sich in ihrer Größe unterschieden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe792f7d-83ee-3e0e-8c00-a2deea2ceb25",
                        "entry_id": "b5084b56-35ae-3f93-bb15-df52a9a22985",
                        "glosses": [
                            "Heiratsregel, die besagt, dass Braut und Bräutigam aus unterschiedlichen sozialen Schichten stammen"
                        ],
                        "tags": [
                            "Ethnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ff496352-f3c7-421f-b127-453d40bf83d5",
                                "sense_id": "fe792f7d-83ee-3e0e-8c00-a2deea2ceb25",
                                "text": "In einigen Kulturen ist Anisogamie Voraussetzung für die Akzeptanz einer Eheschließung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
