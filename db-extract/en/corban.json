                "senses": [
                    {
                        "sense_id": "a154e681-3781-3760-8fa2-7be81aba46b1",
                        "entry_id": "97c81d20-f8c3-3a2c-8540-971e95db93c1",
                        "glosses": [
                            "An offering to God, especially in fulfilment of a vow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3ac6bb-3fed-4f41-994e-350ccb32cee9",
                                "sense_id": "a154e681-3781-3760-8fa2-7be81aba46b1",
                                "text": "but ye say, If a man shall say to his father or his mother, That wherewith thou mightest have been profited by me is Corban, that is to say, Given [to God];"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d4c48a2-330c-3dca-8486-052ae141ed24",
                        "entry_id": "97c81d20-f8c3-3a2c-8540-971e95db93c1",
                        "glosses": [
                            "An alms basket; a vessel to receive gifts of charity; a treasury of the church, where offerings are deposited."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ec9ff31-fc2b-4185-8653-4ac0c33b3354",
                        "source_entry_id": "97c81d20-f8c3-3a2c-8540-971e95db93c1",
                        "source_sense_description": "an offering to God, especially in fulfilment of a vow — see also sacrifice",
                        "target_lang_word": "corban",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corban",
