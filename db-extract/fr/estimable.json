                    {
                        "translation_id": "3a303f3a-8e35-40c3-bd81-e208378691ce",
                        "source_entry_id": "be72bceb-66f9-337c-a63c-4888b1198e6e",
                        "source_sense_id": "1795dc6e-fd07-382f-8a3d-b1f71f887121",
                        "target_lang_word": "estimable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estimable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                        "entry_id": "006469b9-f865-3f4e-af5b-e1458dfeffda",
                                        "glosses": [
                                            "Worthy of esteem; admirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405a923f-8981-4134-b539-5be2b28e4a7e",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "Mr. March told […]how devoted Brooke had been, and how he was altogether a most estimable and upright young man."
                                            },
                                            {
                                                "example_id": "c2f4eff4-e4c0-46d4-91a6-26c4d620234c",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "Near-synonyms: esteemed, revered"
                                            },
                                            {
                                                "example_id": "8fc1ae8e-3a76-4d6e-8c6d-b718d4d56ea7",
                                                "sense_id": "a0a18b0f-9e29-328f-b350-570c737bdc84",
                                                "text": "[Homer] allows their characters such estimable qualities as could consist, and in truth generally do, with tender frailties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1eebb38-665e-3080-bebd-c06482ab5806",
                                        "entry_id": "006469b9-f865-3f4e-af5b-e1458dfeffda",
                                        "glosses": [
                                            "Valuable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab51e543-6403-49e4-8e06-9eb2ed97f8a7",
                                                "sense_id": "c1eebb38-665e-3080-bebd-c06482ab5806",
                                                "text": "A pound of man's flesh taken from a man\nIs not so estimable, profitable neither,\nAs flesh of muttons, beefs, or goats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4948755-08e3-33aa-881c-4710c86beab3",
                                        "entry_id": "006469b9-f865-3f4e-af5b-e1458dfeffda",
                                        "glosses": [
                                            "Capable of being estimated; estimatable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7121eb-56d4-432c-af76-552cd70491d6",
                                                "sense_id": "f4948755-08e3-33aa-881c-4710c86beab3",
                                                "text": "After this time boric acid is always present in estimable amounts."
                                            },
                                            {
                                                "example_id": "5ef34799-a8b7-47da-a56f-57726338521a",
                                                "sense_id": "f4948755-08e3-33aa-881c-4710c86beab3",
                                                "text": "In this section we review the recent theory that generates an estimable Phillips curve relation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
