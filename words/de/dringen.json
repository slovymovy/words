{
    "word_family": [
        "drängen",
        "Drang",
        "Dringlichkeit",
        "Eindringling",
        "vordringen",
        "durchdringen",
        "eindringen",
        "aufdringen",
        "bedrängen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "347fa5f7-4d8e-30a5-b108-3912d860b86a",
                    "sense_definition": "Sich durch eine Barriere, Öffnung oder ein Hindernis hindurch einen Weg bahnen (besonders von Licht, Schall, Rauch oder Flüssigkeiten).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die ersten warmen Sonnenstrahlen <w>drangen</w> mühsam durch den dichten Nebel des Tals.",
                            "target_lang_translations": {
                                "en": "The first warm rays of sunlight struggled to <w>pierce</w> through the dense fog of the valley."
                            }
                        },
                        {
                            "text": "Trotz der geschlossenen Fenster <w>dringt</w> der laute Baustellenlärm direkt in die Wohnung.",
                            "target_lang_translations": {
                                "en": "Despite the closed windows, the loud construction noise <w>penetrates</w> directly into the apartment."
                            }
                        }
                    ],
                    "synonyms": [
                        "durchdringen",
                        "vordringen"
                    ],
                    "common_phrases": [
                        "an die Öffentlichkeit dringen",
                        "durch die Wolken dringen",
                        "in das Gebäude dringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To force a way through a barrier, opening, or obstacle (especially of light, sound, smoke, or liquids)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "penetrate",
                                "target_lang_sense_clarification": "pass through or into an obstacle or medium"
                            },
                            {
                                "target_lang_word": "pierce",
                                "target_lang_sense_clarification": "break through, e.g. of light or sound"
                            },
                            {
                                "target_lang_word": "seep",
                                "target_lang_sense_clarification": "slowly pass or leak through"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef0fb595-f440-3d80-95bf-2b0056975ed0",
                    "sense_definition": "Nachdrücklich auf etwas bestehen oder eine bestimmte Handlung fordern.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Oppositionspartei <w>dringt</w> vehement auf eine rasche Aufklärung des politischen Skandals.",
                            "target_lang_translations": {
                                "en": "The opposition party is vehemently <w>pressing</w> for a swift investigation into the political scandal."
                            }
                        },
                        {
                            "text": "Wegen der drohenden Frist <w>drang</w> der Anwalt auf eine sofortige Antwort der Gegenseite.",
                            "target_lang_translations": {
                                "en": "Because of the impending deadline, the lawyer <w>insisted</w> on an immediate response from the opposing party."
                            }
                        }
                    ],
                    "synonyms": [
                        "beharren",
                        "pochen",
                        "bestehen"
                    ],
                    "antonyms": [
                        "nachgeben",
                        "verzichten"
                    ],
                    "common_phrases": [
                        "auf eine Entscheidung dringen",
                        "auf Eile dringen",
                        "auf Aufklärung dringen"
                    ],
                    "target_lang_definitions": {
                        "en": "To insist emphatically on something or demand a specific course of action (used with 'auf')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insist",
                                "target_lang_sense_clarification": "persistently demand (used with 'on')"
                            },
                            {
                                "target_lang_word": "press",
                                "target_lang_sense_clarification": "demand or urge urgently (used with 'for')"
                            },
                            {
                                "target_lang_word": "urge",
                                "target_lang_sense_clarification": "strongly advocate or push for"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}