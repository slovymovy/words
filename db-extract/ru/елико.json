                                    {
                                        "sense_id": "20696d48-922c-398d-871e-a9c1bf1ad65a",
                                        "entry_id": "3e8047b1-0416-3edc-86f8-0017ba3407a2",
                                        "glosses": [
                                            "What amount or quantity (of something stated or implied)."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cbf50e-745c-47f5-a8e1-166b06e3036d",
                                                "sense_id": "20696d48-922c-398d-871e-a9c1bf1ad65a",
                                                "text": "How much (cheese) is left in the fridge? - This is how much we've got left."
                                            },
                                            {
                                                "example_id": "af833e5a-cc12-41e0-8e5b-02c773f6cba9",
                                                "sense_id": "20696d48-922c-398d-871e-a9c1bf1ad65a",
                                                "text": "How much of a problem will that cause the government?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2e4c88-2d0d-339b-944a-75837ab48f7c",
                                        "entry_id": "3e8047b1-0416-3edc-86f8-0017ba3407a2",
                                        "glosses": [
                                            "What amount of money."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8760dd9d-9aba-4d82-9232-500d38f0a679",
                                                "sense_id": "5e2e4c88-2d0d-339b-944a-75837ab48f7c",
                                                "text": "How much is it?"
                                            },
                                            {
                                                "example_id": "5cca5c1f-3c8b-4743-9c16-9ca5f633036a",
                                                "sense_id": "5e2e4c88-2d0d-339b-944a-75837ab48f7c",
                                                "text": "How much is it worth?"
                                            },
                                            {
                                                "example_id": "1cb9359b-819b-4352-a686-2983b84bfc86",
                                                "sense_id": "5e2e4c88-2d0d-339b-944a-75837ab48f7c",
                                                "text": "How much do you want for it?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "how much",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7523439a-6bc3-3353-af3b-e28dc8b48d3b",
                                        "entry_id": "79020cfb-b5a8-3865-b2a4-bb198c86b9f7",
                                        "glosses": [
                                            "To what degree; to what extent."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9ba916-dc63-4198-9de0-c0dffd0bc761",
                                                "sense_id": "7523439a-6bc3-3353-af3b-e28dc8b48d3b",
                                                "text": "How much do you like me?"
                                            },
                                            {
                                                "example_id": "2c5cab94-2a70-46ca-a404-06911227c17a",
                                                "sense_id": "7523439a-6bc3-3353-af3b-e28dc8b48d3b",
                                                "text": "It's a real bargain, considering both its price and how much in need of one we are."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "how much",
