                ],
                "senses": [
                    {
                        "sense_id": "e983b452-0570-325e-8b68-805815d3d460",
                        "entry_id": "d1259b38-5caf-3fee-8a20-de76258a55ec",
                        "glosses": [
                            "Lücke in der Schädeldecke bei Neugeborenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae34013-384a-49e4-b3f0-4199ac3e83e9",
                                "sense_id": "e983b452-0570-325e-8b68-805815d3d460",
                                "text": "„Ursprünglich hatte Frau Mondtraut mit Simen Tjing darüber gesprochen, daß das Kind nicht zur Familiengruft mitgenommen werden sollte, einmal, weil es noch kein volles Jahr alt sei, und zweitens, weil die alte Liu erklärt hatte, die Fontanellen des Kindes seien noch nicht zugewachsen, auch könne der Kleine bei seiner Ängstlichkeit auf dem weiten Wege zur Grabstätte leicht erschrecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "486c23e9-5a1d-4f6d-9fb4-fdd7b30c018d",
                        "source_entry_id": "d1259b38-5caf-3fee-8a20-de76258a55ec",
                        "source_sense_id": "e983b452-0570-325e-8b68-805815d3d460",
                        "source_sense_description": "Anatomie: Lücke in der Schädeldecke bei Neugeborenen",
                        "target_lang_word": "fontanelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fontanelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8471f135-bb5a-33dc-9f94-f5fb94485eec",
                                        "entry_id": "b1c91aa5-e896-3271-acd9-4261b5d542fd",
                                        "glosses": [
                                            "Solution de continuité membraneuse comprise entre les os du crâne chez les nouveau-nés."
                                        ],
                                        "tags": [
                                            "Puériculture",
                                            "Squelette"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e45ea5-529f-4e8e-a789-333cf70c258e",
                                                "sense_id": "8471f135-bb5a-33dc-9f94-f5fb94485eec",
                                                "text": "Dans le parcours de la suture sagittale à environ 1 centimètre au-dessus de la petite fontanelle, il se produit aussi assez souvent un élargissement rhomboïdal de la suture, qui peut conduire à des erreurs."
                                            },
                                            {
                                                "example_id": "9f0f592b-626f-43e6-8f52-ac30e72384e7",
                                                "sense_id": "8471f135-bb5a-33dc-9f94-f5fb94485eec",
                                                "text": "Les trois femmes que j’avais connues avaient un trait commun : elles aimaient toucher mes fontanelles. Éliane, Gina, Gilberte voulaient vérifier si mon crâne gardait encore sa fragilité de nouveau-né."
                                            },
                                            {
                                                "example_id": "122b49e4-8f49-4d4c-b607-93ef89af3758",
                                                "sense_id": "8471f135-bb5a-33dc-9f94-f5fb94485eec",
                                                "text": "La vue directe de ce crâne enfantin qui paraissait énorme, nu et fragile comme un œuf, était vraiment inquiétante : on voyait battre la fontanelle, comme si un poussin allait en sortir."
                                            }
                                        ]
                                    }
                                ]
                            },
