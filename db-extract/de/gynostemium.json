                        "entry_id": "3fde1b48-86e9-3046-9887-a3afc6ca7f8b",
                        "glosses": [
                            "spezielles Blütenorgan, welches durch Griffel, Narbe und Staubblätter miteinander verwachsen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1644245b-b840-4f7a-90fc-ccfaeba8e6f1",
                                "sense_id": "b442dd5d-b471-38b1-ac9f-c88e44d4ad30",
                                "text": "Bei Orchideen zeigt sich im Inneren der Blüte das typische Gynostemium."
                            },
                            {
                                "example_id": "af663e0d-368c-41ba-a017-0c3d8d25883f",
                                "sense_id": "b442dd5d-b471-38b1-ac9f-c88e44d4ad30",
                                "text": "Das Gynostemium ist bei Orchideenblüten eine Verbindung aus männlichen Staubgefäßen und weiblichen Blütenteilen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
