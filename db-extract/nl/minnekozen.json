                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "love",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f759e73d-6245-3cb0-a552-2f8cc29f97c8",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A deep caring for the existence of another."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc7bbf0f-6a3e-3c97-9d9c-cbe61c495012",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Strong affection.",
                                            "A profound and caring affection towards someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746a3f18-c59a-4569-9712-80ff256af9fa",
                                                "sense_id": "bc7bbf0f-6a3e-3c97-9d9c-cbe61c495012",
                                                "text": "A mother’s love is not easily shaken."
                                            },
                                            {
                                                "example_id": "73c85b69-71b6-4f66-a700-0e7a5fc93091",
                                                "sense_id": "bc7bbf0f-6a3e-3c97-9d9c-cbe61c495012",
                                                "text": "My husband’s love is the most important thing in my life."
                                            },
                                            {
                                                "example_id": "e90216ca-6433-423a-b98f-09d2d188f98b",
                                                "sense_id": "bc7bbf0f-6a3e-3c97-9d9c-cbe61c495012",
                                                "text": "My love for Melca is eternal."
                                            },
                                            {
                                                "example_id": "32977b50-6b75-4520-904e-4fcd875d3ae0",
                                                "sense_id": "bc7bbf0f-6a3e-3c97-9d9c-cbe61c495012",
                                                "text": "He on his side / Leaning half-raised, with looks of cordial love / Hung over her enamoured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac4e2aa7-c005-33dd-b0be-cf652bc90895",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Strong affection.",
                                            "Affectionate, benevolent concern or care for other people or beings, and for their well-being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9865807-e862-4ee6-b00e-269228167018",
                                                "sense_id": "ac4e2aa7-c005-33dd-b0be-cf652bc90895",
                                                "text": "The love of your neighbor as yourself, is expressly given as the definition and test of Charity,—not alms-giving—and this love is … the highest of all the Divine commands[.]"
                                            },
                                            {
                                                "example_id": "d6bb1898-588b-4e12-8608-6a2a4db4b763",
                                                "sense_id": "ac4e2aa7-c005-33dd-b0be-cf652bc90895",
                                                "text": "Through nonviolent resistance we shall be able to oppose the unjust system and at the same time love the perpetrators of the system. We must work passionately and unrelentingly for full stature as citizens, but may it never be said, my friends, that to gain it we used the inferior methods of falsehood, malice, hate, and violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7320a56b-5d2d-3cc4-86ad-82b4daa7d687",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Strong affection.",
                                            "A feeling of intense attraction towards someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f12d458f-5bf7-45dc-814e-29e74a2ca714",
                                                "sense_id": "7320a56b-5d2d-3cc4-86ad-82b4daa7d687",
                                                "text": "I have never been in love as much as I have with you."
                                            },
                                            {
                                                "example_id": "e53837ca-ffab-447c-80fe-382c8af1276d",
                                                "sense_id": "7320a56b-5d2d-3cc4-86ad-82b4daa7d687",
                                                "text": "Heav'n has no Rage, like Love to Hatred turn'd, / Nor Hell a Fury, like a Woman ſcorn'd."
                                            },
                                            {
                                                "example_id": "fcce51bb-dd4e-4dbb-b882-2aea242dcde9",
                                                "sense_id": "7320a56b-5d2d-3cc4-86ad-82b4daa7d687",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again; for, even after she had conquered her love for the Celebrity, the mortification of having been jilted by him remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a31657-383c-3732-9d51-e57303a4da0e",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Strong affection.",
                                            "A deep or abiding liking for something; an enthusiasm for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2b6144-8466-40b2-925d-a495569c74e1",
                                                "sense_id": "f4a31657-383c-3732-9d51-e57303a4da0e",
                                                "text": "My love of cricket knows no bounds."
                                            },
                                            {
                                                "example_id": "12523657-fea5-4372-8a8b-718866888f7a",
                                                "sense_id": "f4a31657-383c-3732-9d51-e57303a4da0e",
                                                "text": "For three decades, the average number of miles driven by US motorists increased steadily. Then, in 2007, that steady climb was suddenly halted. [...] What magic caused Americans to temper their longstanding love of the open road?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e718e40c-1adb-3749-89d0-29888d4f16bf",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A person who is the object of romantic feelings; a darling, a sweetheart, a beloved."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9bec36d-590a-45d4-890b-20b4b0bc2d87",
                                                "sense_id": "e718e40c-1adb-3749-89d0-29888d4f16bf",
                                                "text": "Open the temple gates unto my love."
                                            },
                                            {
                                                "example_id": "c0e24319-d4d0-47cb-a4a9-81828db7f264",
                                                "sense_id": "e718e40c-1adb-3749-89d0-29888d4f16bf",
                                                "text": "O love, dispatch all business, and be gone!"
                                            },
                                            {
                                                "example_id": "ca377cb4-3954-45c0-84b1-183a363c1895",
                                                "sense_id": "e718e40c-1adb-3749-89d0-29888d4f16bf",
                                                "text": "'Oh, my love, my love!' she murmured, 'wilt thou ever know how I have loved thee?' and she kissed him on the forehead, and then went and stood in the pathway of the flame of Life."
                                            },
                                            {
                                                "example_id": "4da588b5-4571-48f7-b6b8-d3394f0cbacd",
                                                "sense_id": "e718e40c-1adb-3749-89d0-29888d4f16bf",
                                                "text": "I met my love by the gasworks wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6f9992-9fd9-306a-b2b1-9bb13f23aa0f",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A term of friendly address, regardless of feelings."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4e6e8e-5498-4283-bbe8-b6762b39b036",
                                                "sense_id": "ba6f9992-9fd9-306a-b2b1-9bb13f23aa0f",
                                                "text": "Hello love, how can I help you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0043c67-e08f-3b2a-8ba0-e1610b929fe1",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A thing, activity, etc. which is the object of one's deep liking or enthusiasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb62201-2df2-4b33-b1b5-d0dee2965ba7",
                                                "sense_id": "e0043c67-e08f-3b2a-8ba0-e1610b929fe1",
                                                "text": "But it wasn't until [Theresa M. Claiborne] went to ROTC training camp at the University of California at Berkeley that she discovered that flying was her first love. \"Pilots talk about getting bit by the flying bug,\" she says. \"I thought, This is heaven.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7e7d7e-aee8-3986-a224-55f8a108b44f",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Sexual desire; attachment based on sexual attraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adce80e3-ae77-46fe-99b4-7859dab8f59f",
                                                "sense_id": "2f7e7d7e-aee8-3986-a224-55f8a108b44f",
                                                "text": "The prospect that their cherished Greeks would have countenanced, much less honored, a love between men that expressed itself carnally, however, was not so easily assimilated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd6f7f6f-cc8f-38f6-b77c-2ed755f0f00e",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Sexual activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10bb0a25-797a-4861-ac43-16ea6af0ee47",
                                                "sense_id": "bd6f7f6f-cc8f-38f6-b77c-2ed755f0f00e",
                                                "text": "—What think you, my lord, of... love?\n—You mean ‘rumpy-pumpy’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ac4fe3-19c4-3d6e-afcb-98d957a59fee",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "An instance or episode of being in love; a love affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da9f5c4-a9c8-4693-b341-6e6091e754a8",
                                                "sense_id": "f5ac4fe3-19c4-3d6e-afcb-98d957a59fee",
                                                "text": "Maybe it was just a summer love, something with no future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a0b890-432e-34b1-8878-b375d6364473",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Used as the closing, before the signature, of a letter, especially between good friends or family members, or by the young."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065548b7-a270-30f6-a4e1-4e8ed92c03ca",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "Alternative letter-case form of Love (“personification of love”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263fa300-897d-4d6a-9c39-26b6b07e2d5c",
                                                "sense_id": "065548b7-a270-30f6-a4e1-4e8ed92c03ca",
                                                "text": "At busy hearts in vain love's arrows fly; …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46dfa94c-0f61-358d-ab81-ca4a3328cdd6",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A thin silk material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "facdf970-8712-4e0e-b983-353ba6ccfe3f",
                                                "sense_id": "46dfa94c-0f61-358d-ab81-ca4a3328cdd6",
                                                "text": "Such a kind of transparency, as that of a Sive, a piece of Cyprus, or a Love-Hood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dbb7565-3b53-3abc-8ad1-a9ac97b1b579",
                                        "entry_id": "a4ad8260-fc3a-3bc8-aea8-6240a8d9dcd9",
                                        "glosses": [
                                            "A climbing plant, Clematis vitalba."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "love",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2417ed-5a57-3218-a419-7d94a53a9f40",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "To have a strong affection for (someone or something)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "sometimes",
                                            "stative",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6efcfd66-1fbd-4f9a-bd19-882336b88ac5",
                                                "sense_id": "fc2417ed-5a57-3218-a419-7d94a53a9f40",
                                                "text": "I love my spouse. I love you! I love that song!"
                                            },
                                            {
                                                "example_id": "6a7c160d-9c94-498d-97bc-fcdf4b6ca815",
                                                "sense_id": "fc2417ed-5a57-3218-a419-7d94a53a9f40",
                                                "text": "wanted to take her in my arms and tell her how I loved her, and had taken her hand from the rail and started to draw her toward me when Olson came blundering up on deck with his bedding."
                                            },
                                            {
                                                "example_id": "bcf3eedb-2c35-462f-b69f-0eb47f64c086",
                                                "sense_id": "fc2417ed-5a57-3218-a419-7d94a53a9f40",
                                                "text": "Just give me a reason, / just a little bit's enough, / just a second we're not broken, just bent / and we can learn to love again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a20b806-e927-3373-b563-48cd184a00a2",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "To need, thrive on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f300fb2-3aa6-477f-8b59-22c40c9a4d4c",
                                                "sense_id": "1a20b806-e927-3373-b563-48cd184a00a2",
                                                "text": "Mold loves moist, dark places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f18762c-809c-3606-89e2-eac0c7cce82a",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "To be strongly inclined towards something; an emphatic form of like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b10bb52-9b0c-477d-90d4-df55f028d845",
                                                "sense_id": "2f18762c-809c-3606-89e2-eac0c7cce82a",
                                                "text": "I love walking barefoot on wet grass; I'd love to join the team; I love what you've done with your hair"
                                            },
                                            {
                                                "example_id": "0e93a255-3c46-4fb3-ab9a-4858b95738b5",
                                                "sense_id": "2f18762c-809c-3606-89e2-eac0c7cce82a",
                                                "text": "\"I love not that underlings should perceive my wisdom.\""
                                            },
                                            {
                                                "example_id": "bafbf44a-ddd0-460a-a379-9511d28490c1",
                                                "sense_id": "2f18762c-809c-3606-89e2-eac0c7cce82a",
                                                "text": "“Everywhere he went, I went with him. When I was twenty-three, I had been nearly all over the world. It was a splendid life—I loved it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63036ddf-4d2b-38f5-8f73-d0822bb0c68b",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "To seek the good or honor of (someone), care deeply about, to be dedicated to (someone or something)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "sometimes",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7946c866-26c3-4c2e-b696-167d8350954c",
                                                "sense_id": "63036ddf-4d2b-38f5-8f73-d0822bb0c68b",
                                                "text": "For God so loued þe world, that he gaue his only begotten Sonne: that whosoeuer beleeueth in him, should not perish, but haue euerlasting life."
                                            },
                                            {
                                                "example_id": "8c3fea88-ea6b-4e93-b2b7-4dc306ae0686",
                                                "sense_id": "63036ddf-4d2b-38f5-8f73-d0822bb0c68b",
                                                "text": "Iesus sayd vnto him, Thou shalt loue the Lord thy God with all thy heart, and with all thy soule, and with all thy minde. This is the first and great Commandement. And the second is like vnto it, Thou shalt loue thy neighbour as thy selfe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9f1424-f749-35e1-b6c2-850e70d62505",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "To derive delight from a fact or situation."
                                        ],
                                        "tags": [
                                            "ironic",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292e3742-0793-4625-a666-af60c9ea5e29",
                                                "sense_id": "0d9f1424-f749-35e1-b6c2-850e70d62505",
                                                "text": "I love the fact that the coffee shop now offers fat-free chai latte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da4e888f-fabc-3058-b751-bd17e2a26d73",
                                        "entry_id": "c74f8de0-0d67-36bf-8c05-c0b137441b8b",
                                        "glosses": [
                                            "Synonym of heart (verb)."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a964570-a0a6-4ac1-b813-175f180e2eb1",
                                                "sense_id": "da4e888f-fabc-3058-b751-bd17e2a26d73",
                                                "text": "She loved my photos of the kids playing with the dogs."
                                            }
                                        ]
                                    },
                                    {
