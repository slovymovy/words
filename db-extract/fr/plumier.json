                                "target_senses": [
                                    {
                                        "sense_id": "1961f143-bfb5-3def-b380-9164d0861d2f",
                                        "entry_id": "335019c6-44fb-37de-9da2-f2dbc09acc59",
                                        "glosses": [
                                            "kleiner länglicher Kasten, in dem Griffel und andere Schreibutensilien aufbewahrt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5515e9d5-9c0d-4e1e-a4c7-1c50f7a05d8b",
                                                "sense_id": "1961f143-bfb5-3def-b380-9164d0861d2f",
                                                "text": "„Wenn ich hüpfte, klapperte die Schiefertafel gegen den Griffelkasten, den der Großvater aus Brettchen geleimt und mit Schiffen, Fröschen und Wichtelmännchen bemalt hatte, und ein gehäkeltes Läppchen an einer gedrehten Schnur hüpfte mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698fd41b-8f86-484a-a58e-d87f21ab74a0",
                        "source_entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "target_lang_word": "Federkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Federkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "681ae58f-6282-3e97-9040-036376917e4a",
                                        "entry_id": "bc8bd2cd-f1cb-3cce-94c6-13f0c9b306f9",
                                        "glosses": [
                                            "kleiner länglicher Kasten, in dem Schreibutensilien aufbewahrt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b644df0c-4593-43eb-afd9-5c3617bc712e",
                                                "sense_id": "681ae58f-6282-3e97-9040-036376917e4a",
                                                "text": "„Da werfen sie klappernd die Federkästen in die Tornister und drängen zwitschernd und atemlos hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17b38109-727c-431b-b3f8-4ca504bd0e87",
                        "source_entry_id": "223eb58f-0cec-3bbb-8578-ae3d16d36096",
                        "target_lang_word": "Pennal",
