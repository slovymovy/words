                "senses": [
                    {
                        "sense_id": "f55f115c-2464-3180-9382-33e54ae4ed71",
                        "entry_id": "7d75e02c-2084-39c8-a408-d3165763036c",
                        "glosses": [
                            "in der Stadt lebende Taube"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb955cc9-56d9-47cb-9c75-7cdf5c50aaed",
                                "sense_id": "f55f115c-2464-3180-9382-33e54ae4ed71",
                                "text": "„Schätzungsweise 20 000 bis 30 000 Stadttauben leben in Stuttgart, von denen jede jährlich etwa zwölf Kilogramm Nasskot produziert.“"
                            },
                            {
                                "example_id": "d140ea99-ba36-4336-945f-72caa2ba074e",
                                "sense_id": "f55f115c-2464-3180-9382-33e54ae4ed71",
                                "text": "Die Stadt- oder Straßentaube stammt von verwilderten Haus- und Brieftauben ab. Diese wurden einst aus der Felsentaube gezüchtet, die an und auf den Klippen des Mittelmeeres lebt, sich aber durch Vermischung mit den Stadttauben fast über die ganze Erde ausbreitete."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8165447f-0044-43b5-a044-369c90a52e7b",
                        "source_entry_id": "7d75e02c-2084-39c8-a408-d3165763036c",
                        "source_sense_id": "f55f115c-2464-3180-9382-33e54ae4ed71",
                        "source_sense_description": "in der Stadt lebende Taube",
                        "target_lang_word": "gołąb",
