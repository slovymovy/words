                    },
                    {
                        "translation_id": "7baf5c6b-8ae6-4889-a7fb-0045e276f6ef",
                        "source_entry_id": "85d77f35-9b43-3a72-9e0b-c79010f2047b",
                        "source_sense_id": "5428e85d-1932-343b-b635-7f7316706c62",
                        "source_sense_description": ", 2., 3. of 3. (zaad, bladeren of knol van) plant Foeniculum vulgare",
                        "target_lang_word": "fenouil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenouil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dac890d4-2df0-3e0d-8412-f201bbcae0bf",
                                        "entry_id": "530f9bd4-7a50-301a-8249-b0ba078e1924",
                                        "glosses": [
                                            "Plante aromatique, de la famille des Apiacées, qui porte des fleurs jaunes et qui croît surtout dans le midi de l’Europe, de nom scientifique Foeniculum vulgare."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7921eff2-f4c1-38b8-bb0a-4b38ab5a0faa",
                                        "entry_id": "530f9bd4-7a50-301a-8249-b0ba078e1924",
                                        "glosses": [
                                            "Feuilles de cette plante utilisées comme aromate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9003d2c2-22ac-4702-bec5-85da55410fbf",
                                                "sense_id": "7921eff2-f4c1-38b8-bb0a-4b38ab5a0faa",
                                                "text": "Souvent, les bras croisés, adossé contre un pin, et mordillant une ombelle de fenouil, il me disait gravement : « Raconte-moi encore les bartavelles… »"
                                            },
                                            {
                                                "example_id": "907eb8ea-8832-4a82-8137-b06b89d77bb7",
                                                "sense_id": "7921eff2-f4c1-38b8-bb0a-4b38ab5a0faa",
                                                "text": "Et ces merveilleux poissons dont parlait Garrigou (ah ! bien oui, Garrigou !) étalés sur un lit de fenouil, l’écaille nacrée comme s’ils sortaient de l’eau."
                                            },
                                            {
                                                "example_id": "109054dd-1e90-4a8f-9627-556e6852ce64",
                                                "sense_id": "7921eff2-f4c1-38b8-bb0a-4b38ab5a0faa",
                                                "text": "Les feuilles peuvent être ajoutées aux poissons, surtout s’il s’agit de poissons huileux à saveur prononcée, comme le maquereau ; le fenouil aide à atténuer l’odeur du poisson et facilite la digestion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6185900-6ad9-3ad8-a941-60ef404664d7",
                                        "entry_id": "530f9bd4-7a50-301a-8249-b0ba078e1924",
                                        "glosses": [
                                            "Base renflée des pétioles, utilisée comme un légume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a2bb0d9-167a-4054-a696-def47247b0af",
                                                "sense_id": "c6185900-6ad9-3ad8-a941-60ef404664d7",
                                                "text": "« Tâche aussi de trouver des fenouils, mais moins gros que ceux de la dernière fois. Ils étaient durs comme des roseaux, et secs comme une canne à pêche. Il m’ont servi à allumer le feu ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cccd8b3-1a97-38ec-aa5a-aa9fc187effd",
                                        "entry_id": "530f9bd4-7a50-301a-8249-b0ba078e1924",
                                        "glosses": [
                                            "Il se prend aussi pour la graine de la même plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36833cee-6031-48e6-94bf-4bb11a8f47d1",
                                                "sense_id": "0cccd8b3-1a97-38ec-aa5a-aa9fc187effd",
                                                "text": "Il y a aussi les Car en Sac, appelés « torpilles » en raison de leur forme, et les fruits et graines enrobés, dont les agrumes, le fenouil, le carvi et le gingembre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
