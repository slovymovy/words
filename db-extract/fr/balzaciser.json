                ],
                "senses": [
                    {
                        "sense_id": "fab781d8-e305-3db2-8273-64af5c173a94",
                        "entry_id": "8849448c-d08d-3678-b30d-99c30bf3a0a5",
                        "glosses": [
                            "Donner un caractère rappelant Honoré de Balzac à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d992fa9a-9f5e-49a6-8cae-45df74c085e3",
                                "sense_id": "fab781d8-e305-3db2-8273-64af5c173a94",
                                "text": "Un lettré de 1688, résistant à la tentation de balzaciser les textes qu’il reproduit, serait un miracle."
                            },
                            {
                                "example_id": "d03b1a77-5955-48df-bb72-1a2a3e8faec5",
                                "sense_id": "fab781d8-e305-3db2-8273-64af5c173a94",
                                "text": "Cette citation est faite de « concaténations » de passages de Stendhal. L’ensemble est en quelque sorte « balzacisé »."
                            },
                            {
                                "example_id": "37b5e869-444a-4360-8626-ad165b6d9b82",
                                "sense_id": "fab781d8-e305-3db2-8273-64af5c173a94",
                                "text": "Tout écrivain qui veut peindre les mœurs de son temps et les milieux sociaux où elles se produisent relève plus ou moins, de Balzac, et vous-même dans votre Lac Noir, par exemple, n’avez-vous pas quelque peu balzacisé ?"
                            }
                        ]
                    }
