                    },
                    {
                        "translation_id": "6a88f094-38ae-4daa-a832-6b121458cdfd",
                        "source_entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                        "source_sense_description": "form of government",
                        "target_lang_word": "autocratie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                        "entry_id": "9c68c819-38ec-37b7-a44a-ea7ffa8d0ea5",
                                        "glosses": [
                                            "een regeringsvorm waarbij de macht wordt uitgeoefend door één man of vrouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1dc39f-95ea-4726-9e93-dfab564113c3",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "Rusland is eeuwenlang een autocratie geweest."
                                            },
                                            {
                                                "example_id": "8bf56f0d-2a1d-46e1-9a4d-e478a70fa687",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "\"Turkije is hard op weg naar een autocratie\""
                                            },
                                            {
                                                "example_id": "f3788bed-3cea-4b94-8ac0-77296695cb69",
                                                "sense_id": "04c8164d-475f-314f-a633-dafa0cfa0ef2",
                                                "text": "De Republikeinen, die volledig meegingen in Trumps retoriek van verheerlijking van autocratie, misogynie en verdeeldheid, hebben bovendien hun greep op het Huis van Afgevaardigden behouden en de meerderheid in de Senaat gekregen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd81a7d-3244-402d-8a4b-f8c8a301e27d",
                        "source_entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                        "source_sense_description": "form of government",
                        "target_lang_word": "alleenheerschappij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alleenheerschappij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "878a58e3-e561-316c-978e-eaf37bf56cf4",
                                        "entry_id": "629a7bda-2d07-3c3a-9471-b0c811b82006",
                                        "glosses": [
                                            "volstrekte heerschappij van één persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b69ef6-76a8-4caa-aa47-4a838bedcfb5",
                                                "sense_id": "878a58e3-e561-316c-978e-eaf37bf56cf4",
                                                "text": "Ook toen haar jaren van absolute alleenheerschappij voorbij waren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c62ff89-5b7c-4679-8e8c-97bd0e5a6e73",
                        "source_entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                        "source_sense_description": "form of government",
                        "target_lang_word": "autocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                                        "glosses": [
                                            "Gouvernement d’un autocrate, dictature, monarchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf70bc9a-5657-4e25-b957-4a91a2a57a1a",
                                                "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                                                "text": "On a pendu les régicides et proclamé sous Alexandre III, l’autocratie « inébranlable »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                                        "glosses": [
                                            "Régime politique d’un autoritarisme absolu."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544ed99d-01fd-442a-ad8b-8640717d51e3",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Peut-être parce que, depuis le XIᵉ siècle, la seule théorie politique de l’islam a été celle de l’obéissance passive à toute autorité de facto, le gouvernement par consentement reste un concept inconnu : l’autocratie a été la véritable et, pour l’essentiel, l’unique expérience."
                                            },
                                            {
                                                "example_id": "3a001333-267f-4a06-9206-2f379748222a",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Un peuple se lavait de l’opprobre d'une autocratie réductrice. Un pays ravalait sa façade dans l'espoir têtu que sa rage de vivre debout allait éclater sur son nouveau visage."
                                            },
                                            {
                                                "example_id": "3e737877-3852-4222-a7bb-8c0769a1fd71",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "Les Américains feront le choix entre l’autocratie et la démocratie."
                                            },
                                            {
                                                "example_id": "c47ea998-4901-4fe8-90e2-9f0c451d14ab",
                                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                                "text": "À l’évidence, dès la fin du XXᵉ siècle, le rêve – réel ou soudoyé – de ceux qui faisaient miroiter une fin de l’Histoire, dans une victoire définitive et totale d’une démocratie à la Suisse, devenait indéfendable, à mesure que la mondialisation économique, la dualité des deux – l’oligarchie à l’ouest et l’autocratie à l’est, jusqu’au Pacifique – s’affirmait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "283bd348-3cfb-4b9b-92a7-ab857d0d22a7",
                        "source_entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                        "source_sense_description": "form of government",
                        "target_lang_word": "Autokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                        "entry_id": "5d00164e-21ae-3e77-8369-f58f8285346c",
                                        "glosses": [
                                            "Staatsform, in der die absolute Herrschaft von einer Person oder Gruppe ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43de086-b923-480e-acee-a2fe783cd124",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "Nach jahrzehntelangem Leben in einer Autokratie müssen sich die Menschen erst an den Gedanken einer neugewonnenen Freiheit und Selbstbestimmung gewöhnen."
                                            },
                                            {
                                                "example_id": "155ceeee-0f97-417d-851c-83d9c2a54725",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f3a1de7-7d9d-4c32-ad79-c3e14e5f59ab",
                        "source_entry_id": "4bf70d3e-827c-3f3e-96ea-6ffc08faca55",
                        "source_sense_description": "form of government",
                        "target_lang_word": "Alleinherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alleinherrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7584c1c-a8e5-3a6b-87c1-8f2fc07d4050",
                                        "entry_id": "8eeeec0e-0ef6-3d45-bf47-7c7a587ceaa3",
                                        "glosses": [
                                            "Staatsform, in der die absolute Herrschaft von einer einzigen Person oder Gruppe ausgeht"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9702ff-840c-4029-ae0d-cc3fd66ab93e",
                                                "sense_id": "b7584c1c-a8e5-3a6b-87c1-8f2fc07d4050",
                                                "text": "„Dass auch das Mehrkaisertum durchaus als Monarchie aufgefasst wurde, belegt etwa Porphyrius, der feststellte, eine Alleinherrschaft sei nicht etwa dadurch definiert, dass es nur einen einzigen Herrscher gebe, sondern dadurch, dass nur ein Einziger wirklich herrsche.“"
                                            },
                                            {
                                                "example_id": "35e68622-3341-42f7-b623-77ccac2bb4c3",
                                                "sense_id": "b7584c1c-a8e5-3a6b-87c1-8f2fc07d4050",
                                                "text": "„Weder ein Plädoyer für eine Alleinherrschaft ohne Wenn und Aber und ohne verfassungsmäßige Einhegung noch jakobinische Parteigängerei konnte er seinen Figuren in den Mund legen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
