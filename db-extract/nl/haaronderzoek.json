                        "examples": [
                            {
                                "example_id": "07ab77a3-e2a8-42bb-bb79-682bd3425570",
                                "sense_id": "095cda77-e736-35ed-aea3-747d50506899",
                                "text": "De SP en D66 maken zich zorgen over het Nederlands Forensisch Instituut. De twee oppositiepartijen vrezen dat de kwaliteit niet meer gewaarborgd is op het terrein van verf-, handschrift- en haaronderzoek. Deze drie kleine afdelingen zijn namelijk bij het NFI opgeheven, mede door bezuinigingen."
                            },
                            {
                                "example_id": "701fde52-5f7d-4ce8-85ff-51b1adb70058",
                                "sense_id": "095cda77-e736-35ed-aea3-747d50506899",
                                "text": "Volgens NFI-directeur Woittiez loopt het oplossen van misdrijven geen gevaar door het schrappen van bijvoorbeld [sic!] handschrift- en haaronderzoek. Hij wijst erop dat dna-onderzoek de toekomst heeft"
                            }
