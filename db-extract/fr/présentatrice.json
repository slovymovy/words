                    }
                ],
                "senses": [
                    {
                        "sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "glosses": [
                            "Celle qui présente les invités d’une émission de télévision et plus largement qui l’anime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc2b522-2be1-4649-b73d-1e2cd33c51a7",
                                "sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                                "text": "Le temps de quelques jours, Anne-Sophie Lapix, présentatrice du journal de 20 h sur France 2, a quitté son Pays basque natal - auquel elle est très attachée - pour se rendre à… Dinard (35)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c327ecfd-42d3-44e8-a8d2-ea88a2bb3409",
                        "source_entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "source_sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "target_lang_word": "Nachrichtensprecherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachrichtensprecherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                                        "entry_id": "5e5aecc3-9e25-38e5-9bf2-803f41a89e99",
                                        "glosses": [
                                            "weibliche Person, die in Funk und Fernsehen die Nachrichten vorträgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28afea43-d073-4895-97ba-13d8fbc8fe98",
                                                "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                                                "text": "„Die alterslose Nachrichtensprecherin war vielleicht die Freundin des uralten Wettermannes.“"
                                            },
                                            {
                                                "example_id": "7f8651e5-105c-477a-a812-becbd4b57fb6",
                                                "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                                                "text": "„So muss sich diese Nachrichtensprecherin gefühlt haben, als sie während der Livesendung eine Nierenkolik hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f94ce985-818d-436f-8f9a-91f9935ddcfa",
                        "source_entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "source_sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "target_lang_word": "Moderatorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moderatorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                        "entry_id": "66f82672-ed6c-3066-89ee-7aaafaeeb936",
                                        "glosses": [
                                            "weibliche Person, die eine Diskussion, Veranstaltung oder eine Sendung moderiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60cbb13-c09f-4bc1-8909-4d2eee1d5dc7",
                                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                                "text": "Die Moderatorin kündigte die nächste Musikgruppe an."
                                            },
                                            {
                                                "example_id": "98622eb6-ab14-4667-9ffb-bc8382c87952",
                                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                                "text": "„Die Frage der Moderarorin, ob es sich um einen Anschlag handele und wer ihn ausgeführt habe, beantwortete der Reporter ausweichend.“"
                                            },
                                            {
                                                "example_id": "94bf51da-6cf7-4b1e-9649-491fa9f40a47",
                                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                                "text": "„Einmal war ich mit meinen Witzen zum Frühstücksfernsehen bei SAT.1 eingeladen und lernte dort eine besonders gewitzte und gut aussehende Moderatorin, Simone Panteleit, kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cb75573-3ba4-4ece-989f-8a16a07fdb43",
                        "source_entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "source_sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "target_lang_word": "announcer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                        "entry_id": "446d08f8-7506-31ec-a3b8-f8aeb41f3058",
                                        "glosses": [
                                            "One who makes announcements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e150d7-0d3e-44a7-8949-3ad3500f4983",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "radio announcer"
                                            },
                                            {
                                                "example_id": "c153baa4-96cd-4e9e-a96f-cf89d00d822d",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Even TV announcers at the last Winter Olympics were spotted with a swoosh on their jackets."
                                            },
                                            {
                                                "example_id": "511d5df9-6300-41a6-af6d-ddf49132aa94",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Perlman devised a format inspired by the seminal mockumentary Spinal Tap, where the spot started with an ESPN announcer speaking to camera in a serious, straight voice, framing the story as “real” documentary."
                                            },
                                            {
                                                "example_id": "3dec8bff-9084-41aa-81fc-150a1477eff8",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "There were passing moments when it threatened to be a difficult night and, with the game goalless at half-time, the stadium announcer sounded almost apologetic when he relayed the news that Ukraine, kicking off an hour earlier, had gone to the top of the group by beating Poland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cd34e0c-21d6-4f2a-89dc-45e08af01684",
                        "source_entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "source_sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "target_lang_word": "newscaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newscaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                        "entry_id": "b9c53f0b-175d-354e-9c98-0aed234d3b51",
                                        "glosses": [
                                            "One who delivers the news for broadcast on television, radio, etc; a newsreader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd97b28a-2bd3-4eb9-94cc-9fd790e1cd29",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "Take Linda, a thirty-nine-year-old newscaster who relished her career but began to hear the alarm ringing on her biological clock."
                                            },
                                            {
                                                "example_id": "7dd59579-1837-40c7-97f8-9dd40a9bc2da",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "Yet, a few US newscasters will go on the air at 6 pm or later and say, \"Moscow said tonight.[\"] ... A careful writer would make his script read, \"Moscow said today. ...\""
                                            },
                                            {
                                                "example_id": "162fb97d-9abf-4231-9681-9f5ed366045f",
                                                "sense_id": "63f5edf9-9a95-3ac9-ae9e-e90b4134ab75",
                                                "text": "It is still considered embarrassing if people in authority like teachers or newscasters “shrub.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab26fc45-23e4-4ad0-8125-2b33ae331a43",
                        "source_entry_id": "e9873d82-c106-3509-b21f-1d94bca155d4",
                        "source_sense_id": "860fe117-b81f-3b29-9e4f-cb5f922c743e",
                        "target_lang_word": "anchor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anchor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7397f510-069b-3c8d-9c50-3384cdcffe1a",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A tool used to moor a vessel to the bottom of a sea or river to resist movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fc9f89-aac0-4761-a53c-0a0657f24372",
                                                "sense_id": "7397f510-069b-3c8d-9c50-3384cdcffe1a",
                                                "text": "Men that I knew around Wapatomac didn't wear high, shiny plug hats, nor yeller spring overcoats, nor carry canes with ivory heads as big as a catboat's anchor, as you might say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9213ca-00fb-327a-bfef-331cb75eebb5",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "An iron device so shaped as to grip the bottom and hold a vessel at her berth by the chain or rope attached. (FM 55-501)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8402ef6b-7c7b-3a4d-8c92-6177c8242c6c",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The combined anchoring gear (anchor, rode, bill/peak and fittings such as bitts, cat, and windlass.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ecb8027-45da-3636-8b15-c176f930d0d2",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Representation of the nautical tool, used as a heraldic charge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "289f117c-b462-36ed-b2c3-a09b043cf3e6",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Any instrument serving a purpose like that of a ship's anchor, such as an arrangement of timber to hold a dam fast; a device to hold the end of a bridge cable etc.; or a device used in metalworking to hold the core of a mould in place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7532cd6b-52cb-3b46-b3f8-7bfa0f3ec89b",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A marked point in a document that can be the target of a hyperlink."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98d9d557-3235-35a4-bc87-dc44af8af07e",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A line of code in a program which acts as a reference point for further code to be added immediately before or after, usually via copy and paste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a379f29c-f522-3f8e-8c81-fe9699938db3",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "An anchorman or anchorwoman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d797b02e-67fb-4dfa-8b36-665c66cbaafd",
                                                "sense_id": "a379f29c-f522-3f8e-8c81-fe9699938db3",
                                                "text": "Condoleezza Rice pops up on Fox to be told by the anchor: “When you invade a sovereign nation, that is a war crime.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40732e5e-0f5a-367f-922c-65be5c438d57",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The final runner in a relay race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e43d127d-4dc8-3d1a-8453-608964260309",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A point that is touched by the draw hand or string when the bow is fully drawn and ready to shoot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A superstore or other facility that serves as a focus to bring customers into an area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdd829b-9fae-45db-aa3d-ba2465c8a660",
                                                "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                                "text": "Supermarkets have also had to adjust. Tesco, Sainsbury's and Asda have put a much greater emphasis on developing smaller high street stores or becoming anchors for mixed-used regeneration schemes […]"
                                            },
                                            {
                                                "example_id": "db5fb40f-0c7d-43e4-976b-41fe968b3a00",
                                                "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                                "text": "However, mall developers offer huge discounts to department stores because these anchors create traffic […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23079f1-e5ac-313a-805d-bc806d1d3248",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "That which gives stability or security."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2271392c-f365-4bf1-b3a3-daf9adefbc57",
                                                "sense_id": "e23079f1-e5ac-313a-805d-bc806d1d3248",
                                                "text": "which hope we have as an anchor of the soul"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5712e804-8f9f-3391-93f9-653f08d0cbe4",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A metal tie holding adjoining parts of a building together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "709a567b-3ae1-37dc-a58f-01bebca1f05a",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A screw anchor."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "384258d1-9b78-316b-910a-f1500d45861c",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Carved work, somewhat resembling an anchor or arrowhead; part of the ornaments of certain mouldings. It is seen in the echinus, or egg-and-anchor (called also egg-and-dart, egg-and-tongue) ornament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0b440c-8e2f-346e-8b5f-5ec539a0ecf2",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "One of the anchor-shaped spicules of certain sponges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f484b3a-1164-344e-947d-0761285ed1e3",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "One of the calcareous spinules of certain holothurians, as in species of Synapta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb23ad1-cdbf-39da-8c77-b33da57dd65b",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The thirty-fifth Lenormand card."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The brake of a vehicle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff71dd33-3b5c-4534-ae28-e1864fc40109",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "I saw Tim look back through the rear window of the cab and prayed he wouldn't do the first thing that came into his mind and step on the anchors."
                                            },
                                            {
                                                "example_id": "7c82e63a-542d-4599-a773-fe9052015a88",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "[Police:] ‘… when we blow the horn, you do an emergency stop.’ So the foaf did as he was bid and, hearing an almighty horn blast stepped on the anchors. There was a most tremendous crash as the Police car ran into the back of his Austin."
                                            },
                                            {
                                                "example_id": "e921b767-9c9b-4605-9da5-645c0ff5b272",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "“Brake, brake, brake! You need to scrub off more speed before you enter the corner,” he explained, as I took his advice and jumped on the anchors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82bc1658-657d-3376-8d19-1f386bb651f8",
