                                    {
                                        "sense_id": "8422a2c2-6848-35ab-ad47-a20c7fe04038",
                                        "entry_id": "92df86b2-09a2-3d5e-8f75-5c17bc64dc22",
                                        "glosses": [
                                            "männlicher Name, meist der griechische Philosoph Pythagoras von Samos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fca0829-7e87-49b6-81a0-1bf5ece58f42",
                                                "sense_id": "8422a2c2-6848-35ab-ad47-a20c7fe04038",
                                                "text": "„In der Spätantike und im Mittelalter war die Überzeugung allgemein verbreitet, Pythagoras sei der Begründer der Mathematik gewesen.“"
                                            },
                                            {
                                                "example_id": "d3d88b96-0d45-4179-a0e7-1e27c801a103",
                                                "sense_id": "8422a2c2-6848-35ab-ad47-a20c7fe04038",
                                                "text": "„Insbesondere Pythagoras hatte durch seine Schule in Kroton in Unteritalien einen großen Einfluss auf die weitere Entwicklung der griechischen Mathematik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
