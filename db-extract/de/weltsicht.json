                                        "glosses": [
                                            "zespół poglądów, sądów, przekonań danej osoby na temat otaczającego świata czerpanych z rozmaitych dziedzin kultury, mający wpływ na jego zachowanie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
