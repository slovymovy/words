                "senses": [
                    {
                        "sense_id": "2698395a-8ab4-31d6-938e-478809347fdb",
                        "entry_id": "52963b53-1584-3a34-bd1d-a8f3999f52a3",
                        "glosses": [
                            "Palissade destinée à protéger les cultures du vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4b0634-7c2a-4200-b008-2cde779208b0",
                                "sense_id": "2698395a-8ab4-31d6-938e-478809347fdb",
                                "text": "Le site idéal pour la culture des roses est celui qui assure une exposition au sud ou au sud-est, avec un abrivent au nord et au nord-ouest, d’où viennent les vents les plus froids de nos hivers."
                            },
                            {
                                "example_id": "15e4e5e0-0dca-4a0d-8505-b7e830d61878",
                                "sense_id": "2698395a-8ab4-31d6-938e-478809347fdb",
                                "text": "Des claies et des abrivents en racine de bruyère coupent maintenant de leur ligne d’un violet sombre les romarins et les mimosas sauvages."
                            }
                        ]
                    },
                    {
                        "sense_id": "61ec8895-7015-38b8-95a0-41388ad3308c",
                        "entry_id": "52963b53-1584-3a34-bd1d-a8f3999f52a3",
                        "glosses": [
                            "Abri de fortune lors d’un bivouac."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f5eeb679-f08b-3e25-b89e-8348e2e15ee4",
                        "entry_id": "52963b53-1584-3a34-bd1d-a8f3999f52a3",
                        "glosses": [
                            "Paillasson dont le briquetier couvre son fourneau pour empêcher la déperdition de chaleur. — (Quillet, 1946)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
