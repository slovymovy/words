                                    {
                                        "sense_id": "41162947-db1c-3458-8ef4-e56a5cc2bcda",
                                        "entry_id": "f4b36950-6654-38f2-b345-efae7cf8a536",
                                        "glosses": [
                                            "Of or pertaining to alpinism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c97b17a-1dbb-49e4-8ce5-501340b11249",
                                                "sense_id": "41162947-db1c-3458-8ef4-e56a5cc2bcda",
                                                "text": "The group of Warsaw cavers climbed out of several caves in Poland and of Sistema Cheve using alpinist techniques."
                                            },
                                            {
                                                "example_id": "f2a13c38-d524-4415-a9a3-7125ba497c3b",
                                                "sense_id": "41162947-db1c-3458-8ef4-e56a5cc2bcda",
                                                "text": "The crowns of taller individuals could only be studied from neighbouring trees (climbed using spikes or alpinist ropes)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30eb0ff0-1fa4-3c1d-854c-22709149ad42",
                                        "entry_id": "f4b36950-6654-38f2-b345-efae7cf8a536",
                                        "glosses": [
                                            "Pertaining to alpine skiing or downhill skiing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "alpinist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                        "entry_id": "b99384e0-852b-3e86-a593-5f73138f9007",
                                        "glosses": [
                                            "A mountain climber, especially in the European Alps or in ranges of similar ruggedness and elevation."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624c9565-b4fc-488d-80de-4d4bad851cbf",
                                                "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                                "text": "The Swiss geologist and alpinist, Horace Bénédict de Saussure, the first to make the ascent of Mont Blanc (Aug. 3, 1787), is to have erected in his honor a statue in the village of Chamounix."
                                            },
                                            {
                                                "example_id": "6f8685a4-7554-4ea6-8711-e3e70e7284f7",
                                                "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                                "text": "A cross in the sky could have appeared. . . . The famous Alpinist Edward Whymper saw a similar effect on the Matterhorn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "796ca8d8-42c5-3b79-9a0b-9b334fb853d2",
                                        "entry_id": "b99384e0-852b-3e86-a593-5f73138f9007",
                                        "glosses": [
                                            "A downhill skier who practises the sport on high mountains."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "064b9d9d-ab63-3016-9f2a-c0077a5d9ebc",
                                        "entry_id": "b99384e0-852b-3e86-a593-5f73138f9007",
                                        "glosses": [
                                            "Synonym of alpine skier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
