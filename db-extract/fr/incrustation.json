                "senses": [
                    {
                        "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                        "entry_id": "c629627d-3522-39d3-b980-a2744d2c1416",
                        "glosses": [
                            "Action d’incruster ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91c4a39-6e75-4bc1-8be5-b8b59fc8d3c0",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "En 1866, M. l'abbé Jeuffrain, nommé récemment curé de Graville-Sainte-Honorine, remarqua dans la chapelle de sainte Honorine une pierre tombale de grande dimension, sans légende, mais chargée de traces d’incrustations héraldiques, au nombre de douze ou quatorze, et présentant les effigies d'un chevalier et de sa femme."
                            },
                            {
                                "example_id": "8d907f54-6f75-4f4d-9a04-8fb02c356193",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "Les mosaïques, les tables de pierres fines de Florence se font par incrustation."
                            },
                            {
                                "example_id": "82dbf83d-9a4c-4326-9b7c-5c3c509eaecd",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "Une belle incrustation."
                            },
                            {
                                "example_id": "20e58d5d-e61c-4ef0-8b2d-cc473809d2b9",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "Les ouvrages de marqueterie sont des incrustations."
                            },
                            {
                                "example_id": "adabf5eb-3b90-4aac-b818-42d2206c21c3",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "Un meuble orné d’incrustations."
                            },
                            {
                                "example_id": "195e1b19-49ed-433c-a8fd-4289b776b52c",
                                "sense_id": "484a3ced-45d7-3861-b910-ee1bbb068608",
                                "text": "Les incrustations sur acier."
                            }
                        ]
