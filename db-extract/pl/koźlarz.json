                                        "entry_id": "0121cb4c-5cdb-315d-ad4f-e8310020eddb",
                                        "glosses": [
                                            "рег. трубчатый гриб с бурой шляпкой и белой мякотью, растущий в берёзовых лесах; подберёзовик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1b54e4-5bc3-4e97-b320-213eacd216f2",
                                                "sense_id": "ce3d2fdf-cc1d-3579-be73-485434cbc794",
                                                "text": "Я бы сказал даже, что берёзовик ― это выродившаяся ветвь белого, его ухудшенный вариант."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7bda179-ff48-3fa6-88e1-2bcff111a54d",
                                        "entry_id": "0121cb4c-5cdb-315d-ad4f-e8310020eddb",
                                        "glosses": [
                                            "берёзовый сок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9d1553-1a9b-468b-a304-20b13094f205",
                                                "sense_id": "e7bda179-ff48-3fa6-88e1-2bcff111a54d",
                                                "text": "Воду в бочках схватило ледком, берёзовик едва капал ― сосулька."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
