    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "206ddabd-3927-3174-861b-946db2a7a503",
                    "sense_definition": "A temporary passion or infatuation for a new fashion, amusement, or pursuit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest fitness <w>craze</w> has everyone joining local yoga studios this summer.",
                            "target_lang_translations": {
                                "ru": "Из-за последнего фитнес-<w>бума</w> этим летом все записываются в местные студии йоги."
                            }
                        },
                        {
                            "text": "In the 1990s, collecting these small plush toys became a massive <w>craze</w> across the country.",
                            "target_lang_translations": {
                                "ru": "В 1990-е годы коллекционирование этих маленьких плюшевых игрушек стало массовым <w>увлечением</w> по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "fad",
                        "trend",
                        "vogue",
                        "mania"
                    ],
                    "common_phrases": [
                        "latest craze",
                        "fitness craze",
                        "huge craze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное сильное увлечение или мода на что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мания",
                                "target_lang_sense_clarification": "сильное увлечение"
                            },
                            {
                                "target_lang_word": "повальное увлечение",
                                "target_lang_sense_clarification": "массовая мода"
                            },
                            {
                                "target_lang_word": "бум",
                                "target_lang_sense_clarification": "резкий рост популярности"
                            },
                            {
                                "target_lang_word": "мода",
                                "target_lang_sense_clarification": "временный тренд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30b2659c-ad24-3b9b-9ff7-50443ab280c2",
                    "sense_definition": "A strong habitual desire, fancy, or obsession with something",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obsession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>craze</w> for collecting rare stamps often leaves him with very little money for other hobbies.",
                            "target_lang_translations": {
                                "ru": "Его <w>страсть</w> к коллекционированию редких марок часто оставляет его почти без денег на другие хобби."
                            }
                        },
                        {
                            "text": "She has a particular <w>craze</w> for old mystery novels that she finds in second-hand bookstores.",
                            "target_lang_translations": {
                                "ru": "У неё особенная <w>слабость</w> к старым детективным романам, которые она находит в букинистических магазинах."
                            }
                        }
                    ],
                    "synonyms": [
                        "obsession",
                        "fixation",
                        "compulsion"
                    ],
                    "common_phrases": [
                        "particular craze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная привычка, страсть или одержимость чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пунктик",
                                "target_lang_sense_clarification": "небольшая странная одержимость"
                            },
                            {
                                "target_lang_word": "одержимость",
                                "target_lang_sense_clarification": "сильное пристрастие"
                            },
                            {
                                "target_lang_word": "мания",
                                "target_lang_sense_clarification": "крайняя степень увлеченности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2b38bd1-3262-3652-b2dd-98ca6a377380",
                    "sense_definition": "A state of insanity or mental derangement",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was often dismissed as a simpleton with a <w>craze</w> that no one understood.",
                            "target_lang_translations": {
                                "ru": "Старика часто считали простаком с <w>пунктиком</w>, которого никто не понимал."
                            }
                        },
                        {
                            "text": "In the story, the protagonist descends into a <w>craze</w> after years of isolation.",
                            "target_lang_translations": {
                                "ru": "В этой истории главный герой впадает в <w>безумие</w> после многих лет изоляции."
                            }
                        }
                    ],
                    "synonyms": [
                        "insanity",
                        "madness",
                        "lunacy"
                    ],
                    "antonyms": [
                        "sanity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used more frequently in older literature to describe mental states"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние безумия или психического расстройства"
