        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e49d316-a696-3286-87d8-13261243f859",
                    "sense_definition": "No longer alive; deceased.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dead_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered to mourn their <w>departed</w> relatives.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы оплакать своих <w>усопших</w> родственников.",
                                "pl": "Rodzina zebrała się, aby opłakiwać swoich <w>zmarłych</w> krewnych."
                            }
                        },
                        {
