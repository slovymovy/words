                                            {
                                                "example_id": "d2dd0b80-df41-4115-a2b9-c61db4a71063",
                                                "sense_id": "922396a2-5b97-3e1a-a91b-1bd5b6e89a5c",
                                                "text": "„Der Augsburger Polizistenmörder ist zu einer lebenslangen Haftstrafe verurteilt worden.“"
                                            },
                                            {
                                                "example_id": "6b07cb70-1a99-4c8e-a9d0-fd9c0d22dc00",
                                                "sense_id": "922396a2-5b97-3e1a-a91b-1bd5b6e89a5c",
                                                "text": "\"Ich glaube, vielen der Wähler, die diese Gesetze unterstützt und vielen der Politiker, die sie verabschiedet haben, war gar nicht klar, dass da Menschen lebenslang hinter Gittern verschwinden würden, weil sie eine Jacke geklaut haben\", so Turner. Woche für Woche würden solche Urteile gefällt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
