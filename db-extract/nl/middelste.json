                                        "entry_id": "a4fa14a9-0530-3fcd-9bc4-a8ffcf47c1d8",
                                        "glosses": [
                                            "Being very important, or key to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfedeee-11b7-49c5-95d1-ad6f25b94ad6",
                                                "sense_id": "1197eeb7-a01c-3238-91da-1ffa38aef6d4",
                                                "text": "Cleverley was a central figure as England took the lead inside three minutes. He saw his shot handled by Moldovan defender Simion Bulgaru and Lampard drilled home the penalty in trademark fashion."
                                            },
                                            {
                                                "example_id": "368b1851-d048-4188-98f9-fe5d5d97ed4b",
                                                "sense_id": "1197eeb7-a01c-3238-91da-1ffa38aef6d4",
                                                "text": "Passengers crowd in the main concourse at London Euston on January 28 2017, before boarding West Coast Main Line services. The urgent need to relieve congestion and improve reliability on the WCML remains central in the recently published Full Business Case for HS2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dabd1ca-464a-3766-ba58-5b2efd7b4de3",
                                        "entry_id": "a4fa14a9-0530-3fcd-9bc4-a8ffcf47c1d8",
