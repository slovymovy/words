                "senses": [
                    {
                        "sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                        "entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "glosses": [
                            "dokładność, staranność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d204c2-ef32-4be4-94ed-2c3b2256c0f1",
                                "sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                                "text": "Chirurga musi cechować precyzja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8b8ef9b1-6167-34b4-973d-279997120fbd",
                        "entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "glosses": [
                            "stopień zgodności między wynikami uzyskanymi w określonych warunkach z wielokrotnych pomiarów tej samej wielkości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03678e0-85b5-4607-9630-840d925659d9",
                                "sense_id": "8b8ef9b1-6167-34b4-973d-279997120fbd",
                                "text": "Maszyna jest wyposażona w odczyty optyczne o bardzo dużej precyzji."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6dfffc0-94ed-49dc-80c0-fe6730e77c71",
                        "source_entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "source_sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                        "target_lang_word": "precision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The state of being precise or exact; especially, both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3389e6da-5aab-431e-b6ad-6775a2ec68a7",
                                                "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                                "text": "Near-synonyms: exactitude, exactness; accuracy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The ability of a measurement to be reproduced consistently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09abd386-ef1e-43df-867e-b0f99be9b9cb",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "Near-synonyms: repeatability; reproducibility"
                                            },
                                            {
                                                "example_id": "6e6e73d6-bc03-4c80-84a2-32167028acf7",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "The classic example of the difference between precision and accuracy is that in target practice, if the grouping is tight but the group is off-center, your precision is good but your accuracy needs calibration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c38040-7559-3d64-8d19-6d8f8519acfa",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The number of significant digits to which a value may be measured reliably."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee1836ab-8802-3fec-a480-5832f2e48484",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "A bidding system that makes use of many artificial bids to describe a hand quite precisely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Used for exact or precise measurement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dda30d8-1e5e-4cc4-865c-7aed877a4a13",
                                                "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                                "text": "precision instruments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Made, or characterized by accuracy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bf21c0-fc12-498d-9727-d72cdd30bb56",
                                                "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                                "text": "But there was nothing he could do about Villa's second when Agbonlahor crossed from the left and Bent finished with a precision volley."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c13551-76b8-4ab5-804d-41ce2f53fb4f",
                        "source_entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "source_sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                        "target_lang_word": "accuracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accuracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "The state of being accurate; being free from error; exactness; correctness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61723ab6-6994-4fa0-ba85-6c926e519377",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "Its professed end [of logic], is to teach men to think, to judge, and to reason, with precision and accuracy."
                                            },
                                            {
                                                "example_id": "b5182719-27e8-46c5-8da7-022f608c285a",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "The efficiency of the instrument will also depend upon the accuracy with which the piston fits the bottom and sides of the barrel. When the piston is depressed to the bottom, it is considered in theory to be in absolute contact, so as to exclude every particle of air from the space between it and the bottom."
                                            },
                                            {
                                                "example_id": "cf9817f6-b9d1-48f0-a856-4115b42e1d16",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "Exact conformity to truth, or to a rule or model; degree of conformity of a measure to a true or standard value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b336e89-43b9-46c0-a9a0-d5867d4adff8",
                                                "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                                "text": "The jury doubted the accuracy of the witness' comments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051e9a94-a82b-4f9b-b5c1-35f53e72ea0c",
                        "source_entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "source_sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                        "target_lang_word": "Präzision",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präzision",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                        "entry_id": "fa4d44a1-8a66-38bd-8b3e-f45c68a6fbad",
                                        "glosses": [
                                            "sachgemäße Genauigkeit, Exaktheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9ea920-16ca-4f56-b9c4-b1d92ecfe6c1",
                                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                                "text": "Seine hohen Trefferquoten beim Zielschießen bezeugen seine Präzision."
                                            },
                                            {
                                                "example_id": "38ece244-7f3b-4b53-9ab4-c64d24371d20",
                                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                                "text": "„Die Deutschen sind bekannt für ihre Präzision, sie wollen am liebsten immer alles ganz genau wissen.“"
                                            },
                                            {
                                                "example_id": "1c63d027-a172-4d65-9d87-ad97a6b2bcf2",
                                                "sense_id": "791d2c7e-f242-32b4-bc32-bc1705de4ced",
                                                "text": "„Das Faszinierende beim Kunstfliegen sei aber kein einzelnes Manöver, sondern die Präzision, mit der so ein Flug ausgeführt werden muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fca35b97-0da0-4cf5-862a-2a11010d0b82",
                        "source_entry_id": "95d8eca8-4990-3e42-bcfa-bea25de73c28",
                        "source_sense_id": "9f34e696-9db4-3c0d-83e3-5e069f26b7e1",
                        "target_lang_word": "точность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "точность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                        "entry_id": "2460ba29-3c72-3f51-9f19-1c5d8ad1f834",
                                        "glosses": [
                                            "свойство по значению прилагательного точный; выверенность, размеренность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a3ebaa-7b95-4c4c-8b3b-a3928ce9fecf",
                                                "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                                "text": "Кроме того, он знал с точностью физиолога и боксёра, куда и как следует бить человека."
                                            },
                                            {
                                                "example_id": "08c305ce-6c41-46a0-87c8-ece16b76b494",
                                                "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                                "text": "Но, каким бы инструментом ни был вооружен нейрохирург, от него требуется снайперская точность попадания в «мишень»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                        "entry_id": "2460ba29-3c72-3f51-9f19-1c5d8ad1f834",
                                        "glosses": [
                                            "степень соответствия какому-нибудь образцу, плану или представлению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba2a8d-3c81-4a78-8316-956d21361f5c",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Противоречие между результатом опыта и теорией естественно вызвало сомнение в точности опытов."
                                            },
                                            {
                                                "example_id": "eff6774f-5b50-46a2-825c-ec4e0db2eaa8",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Военная неэффективность «Фау-2» была видна невооруженным глазом: плохая точность попадания, малая дальность, ненадёжность."
                                            },
                                            {
                                                "example_id": "c43f21cb-f242-46a5-b96d-5108ed07d01b",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Существенно более высокая, по сравнению с точностью кварцевых, точность атомных часов составляла одну секунду за 300 лет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
