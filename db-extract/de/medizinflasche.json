                        "entry_id": "1a4e145d-7b7c-311e-9b7b-13ec7d2bc6d5",
                        "glosses": [
                            "Flasche für Medizin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81fd17f5-f43a-408f-b094-1ae0c72d6fb6",
                                "sense_id": "c84eb8ac-ad83-357f-8595-dfbb3b26eb4c",
                                "text": "„Er faßte sie blinzelnd zusammen. Das wäßrige Rot der Medizinflasche und das bläuliche Metall des Löffels auf der weißen Porzellanfläche des Tischchens.“"
                            },
                            {
                                "example_id": "66f67118-9149-4333-97a3-e080ff2b1256",
                                "sense_id": "c84eb8ac-ad83-357f-8595-dfbb3b26eb4c",
                                "text": "„Aus der Brusttasche holt er eine kleine braune Medizinflasche, die er mit einer geübten, fast diskreten Bewegung leert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
