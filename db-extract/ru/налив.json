                "senses": [
                    {
                        "sense_id": "d7da32c9-260d-3840-86ad-0c470a850527",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "действие по значению гл. наливать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c523b3b-8807-4b52-aab6-3d5c3b878db2",
                                "sense_id": "d7da32c9-260d-3840-86ad-0c470a850527",
                                "text": "Перед наливом цистерн грузоотправители проверяют техническую исправность котлов, арматуры и универсальных сливных приборов цистерн."
                            }
                        ]
                    },
                    {
                        "sense_id": "71e44ea0-577d-33c4-8977-459ec4acf990",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "только ед. ч. созревание, приток сока в плодах и зерне"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "497e795f-63ab-326c-ad9f-20454cbcc130",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "время, пора этого созревания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a14b64-8226-4699-b7a6-4efda9ef6a9a",
                                "sense_id": "497e795f-63ab-326c-ad9f-20454cbcc130",
                                "text": "Теперь самый налив яблокам."
                            }
                        ]
                    },
                    {
                        "sense_id": "70cd404e-f2fc-32ee-94dc-b8486449dfaf",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "качество, сорт этого сока"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c244689-90e1-4b55-8034-adfccedd1c2c",
                                "sense_id": "70cd404e-f2fc-32ee-94dc-b8486449dfaf",
                                "text": "Яблоки белого налива."
                            }
                        ]
                    },
                    {
                        "sense_id": "24d46b2e-01d2-35d7-a42b-1ec5a26a0ea7",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "отверстие в бочке для наполнения её жидкостью"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f67e8733-7c83-33f2-9fa6-631e263b4d58",
                        "entry_id": "90be751f-bd41-319e-82a9-27b099d86a13",
                        "glosses": [
                            "вет. опухоль на ноге у лошади"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc37a815-ea90-4ea7-8e62-eb3d65a76c41",
                                "sense_id": "f67e8733-7c83-33f2-9fa6-631e263b4d58",
                                "text": "Сошли копыта, сделались наливы, и ноги согнулись."
                            }
                        ]
                    },
                    {
                        "sense_id": "4677cecd-0f6b-3c6a-b6b6-67c46c802538",
