                                                "example_id": "bb2527a5-b545-4d96-8604-852d9c06766f",
                                                "sense_id": "243670a8-5659-3e02-93d8-a0abef558c3b",
                                                "text": "Un oiseau est un animal ailé et ovipare."
                                            },
                                            {
                                                "example_id": "c254f17a-a56a-4151-b3bd-e699aa6e7111",
                                                "sense_id": "243670a8-5659-3e02-93d8-a0abef558c3b",
                                                "text": "Ses yeux sont bruns et le ciel est bleu."
                                            },
                                            {
                                                "example_id": "411a2010-31e2-4ab9-b104-3591962c8f4d",
                                                "sense_id": "243670a8-5659-3e02-93d8-a0abef558c3b",
                                                "text": "Le ciel est bleu et ses yeux sont bruns."
                                            },
                                            {
                                                "example_id": "cbaf1e98-8730-494a-998e-eca9b225f04d",
                                                "sense_id": "243670a8-5659-3e02-93d8-a0abef558c3b",
                                                "text": "Je n’aime une personne que si elle est cultivée et sympathique et drôle et généreuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f353d0f2-910d-3557-8844-b0e2700dc2ed",
                                        "entry_id": "2bc09079-7f42-3e12-9807-223a25a8eeb1",
                                        "glosses": [
                                            "À la suite de quoi, après quoi."
                                        ],
                                        "tags": [],
                                        "note": "Énonce l’induction entre deux événements, l’ordre ayant une importance",
                                        "examples": [
                                            {
                                                "example_id": "c6bdfecc-d69f-40a4-bdad-267dc14df96d",
                                                "sense_id": "f353d0f2-910d-3557-8844-b0e2700dc2ed",
                                                "text": "Ce n’est pas du tout la même chose de dire « Carole se mit à pleurer et François s’en alla » ou « François s’en alla et Carole se mit à pleurer »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ec4cea-39de-3ff8-998b-eab34ff1cfcd",
                                        "entry_id": "2bc09079-7f42-3e12-9807-223a25a8eeb1",
                                        "glosses": [
                                            "Il est quelquefois emphatique, au commencement des phrases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34349f04-c843-4dc5-a204-f7e52121b607",
                                                "sense_id": "26ec4cea-39de-3ff8-998b-eab34ff1cfcd",
                                                "text": "Et voilà que tout d’un coup…"
                                            },
                                            {
                                                "example_id": "18d5f6e7-d049-4351-bee4-ceb098c76776",
                                                "sense_id": "26ec4cea-39de-3ff8-998b-eab34ff1cfcd",
                                                "text": "Et ainsi, vous osez me dire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dce383b-a566-3f51-bdd6-922d551ef5d2",
                                        "entry_id": "2bc09079-7f42-3e12-9807-223a25a8eeb1",
                                        "glosses": [
                                            "A souvent le sens de mais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee45e56a-7d70-4118-804b-044152af5619",
                                                "sense_id": "9dce383b-a566-3f51-bdd6-922d551ef5d2",
                                                "text": "Il plie et ne rompt pas."
                                            }
                                        ]
                                    }
