                        "examples": [
                            {
                                "example_id": "dc02d423-6414-4235-bf01-026e556d7dec",
                                "sense_id": "03139ff1-9b80-30de-be27-9675c456c9c9",
                                "text": "Radley pulled it, as a great laugh went up, to the very spot from which the fieldsman had been removed."
                            },
                            {
                                "example_id": "fed61a03-50d6-4432-aa91-5f374e9e469d",
                                "sense_id": "03139ff1-9b80-30de-be27-9675c456c9c9",
                                "text": "The batsmen took an easy single as the ball approached the fieldsman but Gambhir called for a second on the throw and Franklin uprooted the non-striker's stumps."
                            },
                            {
                                "example_id": "9143a45e-74b5-4bf6-b05f-c2c91a7b3318",
                                "sense_id": "03139ff1-9b80-30de-be27-9675c456c9c9",
                                "text": "I timed it successfully, and had no doubt of having added four to my score, when, to my astonishment, I saw a fieldsman running from the direction of the hedge."
                            },
                            {
                                "example_id": "a051d786-96b8-4d14-81cb-b58332f314aa",
                                "sense_id": "03139ff1-9b80-30de-be27-9675c456c9c9",
                                "text": "Watch the flying fieldsman, Keen to save the fourer, Gallop past the wooden box Sacred to the scorer!"
                            },
                            {
                                "example_id": "70c15a20-8624-4ffa-8414-5d41ca1a5179",
                                "sense_id": "03139ff1-9b80-30de-be27-9675c456c9c9",
                                "text": "William Grey, 1; Samuel Long, 2; James Brown, 3; George and John Simmons, one capital, the other so-so--an uncertain hitter, but a good fieldsman, 5; Joel Brent, excellent, 6; Ben Appleton--here was a little pause, for Ben's abilities at cricket were not completely ascertained, but then he was a good fellow, so full of fun and waggery!"
                            }
                        ]
                    }
