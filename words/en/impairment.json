{
    "word_family": [
        "impair"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35103759-0184-3edf-8258-b7bdaa94891b",
                    "sense_definition": "A permanent or long-term damage to or loss of normal physical, sensory, or mental function.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school offers special software designed to help students with visual <w>impairment</w>.",
                            "target_lang_translations": {
                                "ru": "Школа предлагает специальное программное обеспечение, разработанное для помощи учащимся с <w>нарушениями</w> зрения."
                            }
                        },
                        {
                            "text": "He suffered severe hearing <w>impairment</w> after working for decades in a noisy factory.",
                            "target_lang_translations": {
                                "ru": "Он получил серьезное <w>нарушение</w> слуха после десятилетий работы на шумном заводе."
                            }
                        }
                    ],
                    "synonyms": [
                        "disability",
                        "handicap"
                    ],
                    "common_phrases": [
                        "visual impairment",
                        "hearing impairment",
                        "cognitive impairment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянное или долговременное нарушение нормальной физической, сенсорной или умственной функции организма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "функции органа или системы (зрения, слуха и т.д.)"
                            },
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "стойкий сбой в функционировании"
                            },
                            {
                                "target_lang_word": "дефект",
                                "target_lang_sense_clarification": "врожденный или приобретенный физический недостаток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed67e830-c631-3d2c-9b45-64f73ecbdaab",
                    "sense_definition": "A state or condition of being weakened, diminished, or functioning less effectively.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was arrested under suspicion of alcohol <w>impairment</w>.",
                            "target_lang_translations": {
                                "ru": "Водитель был задержан по подозрению в алкогольном <w>опьянении</w>."
                            }
                        },
                        {
                            "text": "Sleep deprivation causes serious <w>impairment</w> in memory and reaction times.",
                            "target_lang_translations": {
                                "ru": "Дефицит сна вызывает серьезное <w>ухудшение</w> памяти и времени реакции."
                            }
                        }
                    ],
                    "synonyms": [
                        "deterioration",
                        "weakening"
                    ],
                    "antonyms": [
                        "improvement"
                    ],
                    "common_phrases": [
                        "alcohol impairment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ослабления, снижения эффективности работы или временного ухудшения функций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "снижение качества или возможностей"
                            },
                            {
                                "target_lang_word": "ослабление",
                                "target_lang_sense_clarification": "падение силы, внимания, реакции"
                            },
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "временный сбой или нарушение восприятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcbfa58e-ab89-3371-a55e-88d2884e27b4",
                    "sense_definition": "A reduction in the carrying value of an asset when its fair market value falls below its book value.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company recorded an asset <w>impairment</w> following the drop in real estate values.",
                            "target_lang_translations": {
                                "ru": "Компания зафиксировала <w>обесценение</w> активов вслед за падением цен на недвижимость."
                            }
                        },
                        {
                            "text": "Sudden market downturns forced several banks to recognize large <w>impairments</w> on bad loans.",
                            "target_lang_translations": {
                                "ru": "Внезапный спад на рынке вынудил несколько банков признать крупные <w>убытки от обесценения</w> безнадежных кредитов."
                            }
                        }
                    ],
                    "synonyms": [
                        "write-down"
                    ],
                    "common_phrases": [
                        "asset impairment",
                        "impairment loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение балансовой стоимости актива, когда его справедливая рыночная стоимость опускается ниже балансовой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обесценение",
                                "target_lang_sense_clarification": "бухгалтерское снижение стоимости активов"
                            },
                            {
                                "target_lang_word": "убыток от обесценения",
                                "target_lang_sense_clarification": "финансовые потери из-за снижения стоимости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}