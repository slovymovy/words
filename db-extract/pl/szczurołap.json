                        "cross_references": [
                            {
                                "target_word": "крысолов",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8af7e6b8-7633-324f-91b4-6973c285545d",
                                        "entry_id": "d37ff622-fa37-3fe5-aae6-28ee5bc9f150",
                                        "glosses": [
                                            "тот, кто ловит крыс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "042846b7-65eb-401c-9b78-4eb45e528735",
                                                "sense_id": "8af7e6b8-7633-324f-91b4-6973c285545d",
                                                "text": "— Это шутка, — возразил я, — и шутка, конечно, отвечающая занятию Крысолова. — Говоря так, я припомнил вывеску небольшого размера, над которой висел звонок. На ней было написано: «КРЫСОЛОВ» Истребление крыс и мышей. О. Иенсен. Телеф. 1-08-01."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
