                "senses": [
                    {
                        "sense_id": "95dfe0dd-b14b-34d0-b328-91657ce50e73",
                        "entry_id": "04ab218f-617d-3065-8505-3e996ba9fd96",
                        "glosses": [
                            "Vêtement de longueur intermédiaire entre le pantacourt et le short, s’arrêtant à hauteur du genou ou un peu au-dessus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b2f7689-fb02-40e2-94b5-6e3d505e5aa9",
                                "sense_id": "95dfe0dd-b14b-34d0-b328-91657ce50e73",
                                "text": "C'était une semaine après cette nuit alcoolisée, et Camila était en train de travailler son art funambulesque, vêtue d'un bermuda marron qui laissait voir la blancheur presque transparente des ses mollets."
                            },
                            {
                                "example_id": "345c9413-5bf9-4873-b130-7dcc20947894",
                                "sense_id": "95dfe0dd-b14b-34d0-b328-91657ce50e73",
                                "text": "Daniel rôtit des pains perdus et ses jambes, deux baguettes pâlichonnes, s'échappent de son bermuda chiffonné ; il est déjà presque chauve, alors il se rase tout le crâne et ça lui donne un air de para-commando anorexique, mais ses pains perdus sont à tomber raide."
                            }
                        ]
                    }
                ],
