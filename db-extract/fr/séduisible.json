                "senses": [
                    {
                        "sense_id": "88b6317d-4c74-3364-b011-e0d6c07a114c",
                        "entry_id": "8f96d98c-1cc6-32bc-85e9-6b341f317991",
                        "glosses": [
                            "Qui peut être séduit."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f91f50c7-94af-4c79-9564-20dcdce98bb3",
                                "sense_id": "88b6317d-4c74-3364-b011-e0d6c07a114c",
                                "text": "C’est surtout son côté générique, de jolie femme facilement « séduisible » que retient Rodolphe."
                            },
                            {
                                "example_id": "2eb5ef59-71e6-47a1-b580-8579c80f77dc",
                                "sense_id": "88b6317d-4c74-3364-b011-e0d6c07a114c",
                                "text": "En cas de crimes accomplis à deux, ces « complices » sont souvent considérés à tort comme des psychopathes facilement séduisibles, hébétés et insensibles, et ils reçoivent de ce fait un jugement qui ne répond pas aux vraies données, et c'est pourquoi les précautions nécessaires sont négligées."
                            },
                            {
                                "example_id": "a23ea3e8-ca5c-4b1b-8ff0-9dfceebe09a8",
                                "sense_id": "88b6317d-4c74-3364-b011-e0d6c07a114c",
                                "text": "Vous êtes l’un des hommes les plus charmants du zodiaque chinois, vous séduisez et êtes séduisible."
                            },
                            {
                                "example_id": "9d1b89f1-2a10-4eab-8210-b3c40cb99cc1",
                                "sense_id": "88b6317d-4c74-3364-b011-e0d6c07a114c",
                                "text": "Je suis tout-à-fait humain, convaincable, séduisible, influençable, mais avec des arguments concrets et réalistes, pas de belles paroles."
                            }
                        ]
                    }
                ],
