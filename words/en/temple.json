                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She believes that her body is a <w>temple</w> and eats only healthy food.",
                            "target_lang_translations": {
                                "ru": "Она верит, что ее тело — это <w>храм</w>, и ест только здоровую пищу."
                            }
                        },
                        {
                            "text": "The library was a <w>temple</w> of knowledge for the young student.",
                            "target_lang_translations": {
                                "ru": "Библиотека была <w>храмом</w> знаний для молодого студента."
                            }
