                "senses": [
                    {
                        "sense_id": "0d1ce29e-c236-34d6-9e79-508d880cd2a8",
                        "entry_id": "ddd75d69-0f0a-30fc-8b7a-c470b173ce13",
                        "glosses": [
                            "Tiefe eines Gefühls oder einer Empfindung; tiefes Gefühl"
                        ],
                        "tags": [
                            "Sensibilität"
                        ],
                        "examples": [
                            {
                                "example_id": "abcfe98d-51e1-4245-811b-84ec2f58303c",
                                "sense_id": "0d1ce29e-c236-34d6-9e79-508d880cd2a8",
                                "text": "Seine eigene Gefühlstiefe erkennt man oft erst in außergewöhnlichen Situationen wie Angst, Not und Stress und fühlt diese durch ein zuckendes Bauchgefühl. (\"Wenn sich einem der Magen umdreht!\")"
                            },
                            {
                                "example_id": "134e19bb-5b7f-4b96-a11d-c8efbe3fc02b",
                                "sense_id": "0d1ce29e-c236-34d6-9e79-508d880cd2a8",
                                "text": "Hysterisch zu sein, ist ein Ausdruck von Gefühlstiefe, in Kombination mit Angst, Wut und Zorn."
                            },
                            {
                                "example_id": "b3c70324-ec64-40b7-9359-8c4a68d081ac",
                                "sense_id": "0d1ce29e-c236-34d6-9e79-508d880cd2a8",
                                "text": "„„Es gibt keine Musik, die eine so positive Gefühlstiefe und zugleich inhaltliche christliche Prägung hat wie die Gospelmusik“, erklärt Keding die Faszination dieser Musikrichtung.“"
                            },
                            {
                                "example_id": "117701b7-acf0-4f4a-b0db-405347cb2af5",
                                "sense_id": "0d1ce29e-c236-34d6-9e79-508d880cd2a8",
                                "text": "„Das ständige fortissimo ist sein stilistisches Grundprinzip, ob es sich dabei um eine Inszenierung lodernder Leidenschaften oder empfindsamer Gefühlstiefe, um philosophische Appelle oder die Projektion aufgewühlter Szenerien handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
