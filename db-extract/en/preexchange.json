                                "sense_id": "4ac4d2c5-93e3-328b-9946-6ea8fbfc5cd6",
                                "text": "Reconsider preexchange financing strategy for alternative outcomes that may be more favorable to the parties."
                            },
                            {
                                "example_id": "6d394581-1c70-4b85-9da5-35fa8dc24938",
                                "sense_id": "4ac4d2c5-93e3-328b-9946-6ea8fbfc5cd6",
                                "text": "Normal total serum protein and albumin concentrations from cord and preexchange blood samples were within normal limits (5.8 g/dL and 3.3 g/dL, respectively)."
                            },
                            {
                                "example_id": "49a983f9-6a7e-488c-8edf-eb1fa9140497",
                                "sense_id": "4ac4d2c5-93e3-328b-9946-6ea8fbfc5cd6",
                                "text": "In contrasting the preexchange and postexchange stages for both benefits and harms (see Table 1), the degree of potential harms and benefits is heightened and more pronounced in the postexchange stage."
                            }
                        ]
                    }
