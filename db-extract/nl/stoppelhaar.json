            {
                "entry_id": "acf8ca4a-fe1f-3d58-b654-a7da45c6e670",
                "word": "stoppelhaar",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c564b090-fce3-3e62-9277-1f1a03908227",
                        "entry_id": "acf8ca4a-fe1f-3d58-b654-a7da45c6e670",
                        "glosses": [
                            "kapsel van kort, rechtopstaand, stekelig haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0c26ed-6719-4694-94ea-cc1db72f99e0",
                                "sense_id": "c564b090-fce3-3e62-9277-1f1a03908227",
                                "text": "Zo werd Nader (34) laatst naar Ramallah ontvoerd, geslagen en kaalgeschoren. Hij was een junk, bekent hij. Met zijn hoofd nog vol stoppelhaar, en drie van zijn zes kindertjes op schoot, zweert hij dat hij “de business” vaarwel heeft gezegd. Maar op de vraag hoe hij voortaan zijn gezin zal onderhouden, smeekt hij: “Geef mij je autosleutels, dan krijg je van mij 600 gulden.”"
                            },
                            {
                                "example_id": "97d0e5cc-858a-4248-b899-24c4d7363dbb",
                                "sense_id": "c564b090-fce3-3e62-9277-1f1a03908227",
                                "text": "Lech Jeczmyk is de vice-voorzitter van de Beweging voor de Republiek, een klein rechts partijtje dat Walesa's campagnestaf zijn hoofdkwartier aan de Ujazdowskie-boulevard ter beschikking heeft gesteld. Hij is een grote vijftiger met grijs stoppelhaar, een roze gezicht en een witte snor en draagt een loden jas. Hij is niet zo enthousiast over Walesa, zegt hij, Walesa is veel te mild geweest voor de communisten, de afgelopen jaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ecbcd03-1696-408b-8044-9cb2a6306ca7",
                        "source_entry_id": "acf8ca4a-fe1f-3d58-b654-a7da45c6e670",
                        "source_sense_id": "c564b090-fce3-3e62-9277-1f1a03908227",
                        "source_sense_description": "1",
                        "target_lang_word": "bristle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bristle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "764d3e13-8ecd-34a7-8bad-375e45eb5ddb",
                                        "entry_id": "86bf659b-362a-395d-9e7f-4de872411c83",
                                        "glosses": [
                                            "A stiff or coarse hair on a nonhuman mammal or on a plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a3d508b-e410-4e1d-a9d3-d7785deea71c",
                                                "sense_id": "764d3e13-8ecd-34a7-8bad-375e45eb5ddb",
                                                "text": "the bristles of a pig"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fac8d1b-d5ac-3678-ae41-b3f609694610",
                                        "entry_id": "86bf659b-362a-395d-9e7f-4de872411c83",
                                        "glosses": [
                                            "A chaeta: an analogous filament on arthropods, annelids, or other animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6ff3dba-dbd2-3c5f-91db-0b586a19783b",
                                        "entry_id": "86bf659b-362a-395d-9e7f-4de872411c83",
                                        "glosses": [
                                            "The hairs or other filaments that make up a brush, broom, or similar item, typically made from plant cellulose, animal hairs, or synthetic polymers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bristle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To rise or stand erect, like bristles."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "921798fd-0e63-4db8-9439-0c7089066b11",
                                                "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                                "text": "His hair began to bristle with anger when the subject was mentioned."
                                            },
                                            {
                                                "example_id": "8c549cf8-4dbf-4c3f-9e30-a084ad9badee",
                                                "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                                "text": "The cat’s fur bristled when the dog approached."
                                            },
                                            {
                                                "example_id": "9ff18ca0-2d68-4eec-8f6f-a10029cf1439",
                                                "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                                "text": "The soldier’s body would bristle with tension before a battle."
                                            },
                                            {
                                                "example_id": "13d5a052-2b24-4fc5-8e7d-cb8ef557d521",
                                                "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                                "text": "His hair did bristle upon his head."
                                            },
                                            {
                                                "example_id": "368ccb75-6200-463e-985a-dd4105adb09f",
                                                "sense_id": "06249b36-c4a1-3778-a3a4-03f1cf4cdf95",
                                                "text": "He sat down with his elbows upon the desk, his gorilla hands clasped together, his beard bristling forward, and his big grey eyes, half-covered by his drooping lids, fixed benignly upon me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909bd38c-c932-3f2c-a39b-8fcaede056fc",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To abound, to be covered with, or to have an abundance of, something, especially something jutting out."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65bb88ae-c7c5-4a20-b5b3-598cf80aeaef",
                                                "sense_id": "909bd38c-c932-3f2c-a39b-8fcaede056fc",
                                                "text": "the hill of La Haye Sainte bristling with ten thousand bayonets"
                                            },
                                            {
                                                "example_id": "2d3993e3-b4d0-4b96-8895-b25392edf101",
                                                "sense_id": "909bd38c-c932-3f2c-a39b-8fcaede056fc",
                                                "text": "ports bristling with thousands of masts"
                                            },
                                            {
                                                "example_id": "a1703fe6-5cce-4e05-a866-a7c6542dc8b8",
                                                "sense_id": "909bd38c-c932-3f2c-a39b-8fcaede056fc",
                                                "text": "Kieran Tierney did not want to risk a challenge on Pulisic, who darted on to the ball with far greater purpose, and the dink over Emi Martínez bristled with composure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f4d9e3-30cc-3b22-b5da-7d0cdc9426bc",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To be on one's guard or raise one's defenses; to react with fear, suspicion, or distance."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f8640d0-c4e4-4562-932c-74adac7d7389",
                                                "sense_id": "34f4d9e3-30cc-3b22-b5da-7d0cdc9426bc",
                                                "text": "The employees bristled at the prospect of working through the holidays."
                                            },
                                            {
                                                "example_id": "227b3fee-d505-4deb-8610-769cef3f9f6b",
                                                "sense_id": "34f4d9e3-30cc-3b22-b5da-7d0cdc9426bc",
                                                "text": "Now for the bare-picked bone of majesty / Doth dogged war bristle his angry crest."
                                            },
                                            {
                                                "example_id": "670df2c1-e937-4b93-9882-724427bdda06",
                                                "sense_id": "34f4d9e3-30cc-3b22-b5da-7d0cdc9426bc",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            },
                                            {
                                                "example_id": "72a58003-2655-4aa1-abc5-3933c244dcc1",
                                                "sense_id": "34f4d9e3-30cc-3b22-b5da-7d0cdc9426bc",
                                                "text": "If only the industry could be honest and explain why it has been forced, owing to government policies, to increase fares over the quarter century since privatisation. Instead, it is defensive and clearly bristles with annoyance when someone merely states the facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b76e561-e992-35dc-9dbb-61500ea7e697",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To make (something) rise or stand erect, like bristles."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3eedac-0e4b-4b45-b811-2a8f09607e56",
                                                "sense_id": "4b76e561-e992-35dc-9dbb-61500ea7e697",
                                                "text": "The lion is let looſe inthe night, and the Earle hauing a night-gowne caſt ouer his ſhirt, with his girdle and ſword, and ſo comming downe the ſtaires into the court, meeteth with the lion briſtling his haire, and roaring."
                                            },
                                            {
                                                "example_id": "6eeb95ea-605c-4322-aa09-6f55ab00fd82",
                                                "sense_id": "4b76e561-e992-35dc-9dbb-61500ea7e697",
                                                "text": "As for the Icnumon, hee hath but onely chāged his name;now called the Rat of Nilus.A beaſt particular to Ægypt,about the bigneſſe of a Cat, and as cleanly: ſnowted like a Ferret , but that blacke and without long haire,ſharpe tootht,round eard,ſhort legd,long taild (being thicke where it ioynes to the body,and ſpinie at the end)his haire ſharpe, hard,and branded, briſtling it vp when angry, and then will flye vpon a maſtiffe."
                                            },
                                            {
                                                "example_id": "29052aa5-3199-49bf-9905-300b4f51fa5e",
                                                "sense_id": "4b76e561-e992-35dc-9dbb-61500ea7e697",
                                                "text": "As,when(at Cock-pit)two old Cocks doe fight,\n(Briſtling their Plumes,&(red with rage)do ſmite […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To cause (someone) to be on one's guard or raise one's defenses."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f497579-9337-41d4-98e9-761b13aca03f",
                                                "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                                "text": "Your blatant attitude always bristles me."
                                            },
                                            {
                                                "example_id": "88819065-ce20-458e-9e95-bc62707fe1ee",
                                                "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                                "text": "Mr. Berman, you know me well enough to know that I—and it just bristles me when I hear agriculture thrown into one lump basket, that we’re a bunch of crooks and treat our workers bad, because that is not the case. I have—I wish you could talk to some of my farm workers."
                                            },
                                            {
                                                "example_id": "444ec3dd-8c11-48fd-b2fb-077bcd0c99d5",
                                                "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                                "text": "I scowl. “Pretty sure women are not explicitly forbidden in my contract.”\nHe lowers his voice. “No, but it’s good to be cautious when you're trying to rehab a public image.”\nSomething about the comment bristles me. “Hey, it’s not my image. I’ve always been good.”"
                                            },
                                            {
                                                "example_id": "18455941-a48c-45b6-89e6-6d5b2b1a8bbe",
                                                "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                                "text": "When we take on a new name, it can be hard for other people to get used to. […] But if someone new in my life calls me that old name, it bristles me. That’s not who I am."
                                            },
                                            {
                                                "example_id": "83a6b4df-acc9-401e-a930-74948a51794f",
                                                "sense_id": "458707ac-fdc5-3abb-a89f-777aed11bba9",
                                                "text": "‘No. I don’t believe in wasting my money on crap like that.’\n‘It’s not your money, it’s mine.’ I can see the comment bristles him; he feels inadequate: his daughter is wealthier than he’s ever been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a66b8d5-6fe5-30f4-87eb-9ddc6d1672da",
                                        "entry_id": "1116f76c-c740-380a-aba3-523aaa6755cb",
                                        "glosses": [
                                            "To fix a bristle or bristles to."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d2111d-6062-47df-b05d-18b8ccfd960c",
                                                "sense_id": "3a66b8d5-6fe5-30f4-87eb-9ddc6d1672da",
                                                "text": "to bristle a thread"
                                            },
                                            {
                                                "example_id": "20f85186-e37d-4cd9-973e-4df0079c99bb",
                                                "sense_id": "3a66b8d5-6fe5-30f4-87eb-9ddc6d1672da",
                                                "text": "For quotations using this term, see Citations:bristle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
