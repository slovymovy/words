                ],
                "senses": [
                    {
                        "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                        "entry_id": "b35641a8-9fd0-343c-b00e-ebf94c7147a7",
                        "glosses": [
                            "Person, die regelmäßig oder exzessiv Medikamente (insbesondere Tabletten) einnimmt"
                        ],
                        "tags": [
                            "colloquial",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "ba44582c-1bd7-46da-9acf-904c9b7a44f3",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„Ich bin inzwischen 66, regelmäßiger Arztbesucher und Tablettenfresser, ewig wird das nicht weitergehen.“"
                            },
                            {
                                "example_id": "30ef3066-0967-420d-97e1-2c91632e3385",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„Die nach Alkohol stinkenden Tablettenfresser, die jede Woche zu diesem pilgerten, machten es ihm mit ihren getorkelten Tanzübungen schwer, an das andere Ende der Tanzfläche zu gelangen, wo die reichen Leute an reservierten Tischen dinierten.“"
                            },
                            {
                                "example_id": "96cec2ea-5fca-4315-b0ab-448c97244fb4",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„Erst werden diese Tablettenfresser bloß stiller, dann reden sie bald überhaupt nicht mehr, nur noch die Lippen bewegen sich, sie sind schon irgendwo weit weg, danach schlafen sie nur noch, werden wie Fliegen im Winter völlig schlaff, und das war's dann, Strich drunter.“"
                            },
                            {
                                "example_id": "92defd19-8b64-440f-8933-4ca6b832e06f",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„In den Augen meiner Restfamilie galt ich als manisch süchtiger Tablettenfresser, der nicht die Disziplin aufbrachte, sein Studium zu Ende zu führen.“"
                            },
                            {
                                "example_id": "3244b3eb-7319-41f8-9ed5-cd289745a8cf",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„Und man liest ja so viel von Aufgehängten und Tablettenfressern an den Feiertagen, wie sie unterm Tannenbaum tagelang dahin verwesen ohne Beistand und Gottes Segen.“"
                            },
                            {
                                "example_id": "f493b6fd-8613-48a9-be17-bf257b1e8592",
                                "sense_id": "130d83b0-922b-37ff-b7fe-e1f8b9ad2462",
                                "text": "„Ich weigere mich schon seit langem, Notiz von Leistungswettkämpfen in Presse und TV zu nehmen, und entziehe den gedopten Spitzensportlern meine Anerkennung und Ehrerbietung[;] Tablettenfresser dürfen keine Vorbilder sein!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
