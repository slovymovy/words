                "word": "Bornholm",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a807b60-0900-3786-bce7-4b939ca76a8b",
                        "entry_id": "46ddd28e-48c1-3d97-a8bd-0ac7de591190",
                        "glosses": [
                            "Île du Danemark située dans la mer Baltique à 36 km au sud-est de la province suédoise de Scanie et à 137 km à l’est des premières côtes danoises."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "25d91ecb-e379-4188-99f3-d13d06596d54",
                                "sense_id": "9a807b60-0900-3786-bce7-4b939ca76a8b",
                                "text": "Hors service à cause de la guerre en Ukraine, les gazoducs Nord Stream reliant la Russie à l’Allemagne sous la mer Baltique ont été tous deux touchés, lundi, par des fuites spectaculaires, au large de l’île danoise de Bornholm."
                            }
                        ]
                    }
                ],
