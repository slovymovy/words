                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ad9b1c0-b88d-36e8-94c4-1897e07b71ac",
                        "entry_id": "d199e7f9-5682-3362-a9d9-0b027d001d17",
                        "glosses": [
