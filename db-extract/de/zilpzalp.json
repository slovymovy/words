                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8ff2d5-2c59-46dc-93bb-e4443f708ba9",
                                                "sense_id": "c288d0ed-e7f2-39d6-bc2b-6a713bdfb60d",
                                                "text": "I thought I heard something singing chiffchaff, chiffchaff. So I had a look and there was a chiffchaff."
                                            }
