                "senses": [
                    {
                        "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                        "entry_id": "261e2fa9-3f75-35f5-b2c9-4f431174627d",
                        "glosses": [
                            "durch Sauerstoff bewirkte Oxidation eines Stoffes; Oxidbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df4fc1a-3641-42a0-b60c-31cf8a6244e3",
                                "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                                "text": "Wenn blanker Stahl keine Schutzschicht erhält, wird dieser, in kürzester Zeit, in Korrosion übergehen."
                            },
                            {
                                "example_id": "5b388bcc-5131-4249-b4f4-19c2a7d30bf5",
                                "sense_id": "fc8acd0a-5101-3185-98cd-5a4967f12d7b",
                                "text": "Eisen möchte nicht das Produkt aus Eisenerz, Legierungen und Energie sein, sondern zerfällt mit Hilfe des Sauerstoff, bei der Korrosion, viel lieber zu Rost."
                            }
                        ],
                        "sense_index_json": "\"1\""
