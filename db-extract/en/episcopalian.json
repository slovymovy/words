                "senses": [
                    {
                        "sense_id": "12129939-025c-32fb-ab54-ce19ccf16928",
                        "entry_id": "b3457099-62b5-3c94-b9dc-4fedfddd6b86",
                        "glosses": [
                            "Of or relating to Anglicanism or an Anglican church, especially the Scottish Episcopal Church, the Episcopal Church in the United States of America, or the Anglican churches in the Philippines, western Asia, South Sudan, the Horn of Africa, and most of north Africa."
                        ],
                        "tags": [
                            "nonstandard",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6e259a-a1f8-454e-bf0b-05d72fda73f1",
                                "sense_id": "12129939-025c-32fb-ab54-ce19ccf16928",
                                "text": "The cathedral is part of the Episcopal Church, the American branch of Anglicanism. Considered the \"church of the establishment\" for much of American history -- 11 US presidents have been Episcopalian -- the church of late has been known as a forerunner of progressive theology."
                            }
                        ]
                    },
