                ],
                "senses": [
                    {
                        "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                        "entry_id": "54ca6ab2-c55e-3fbd-bc16-bee950143022",
                        "glosses": [
                            "Änderung eines beziehungsweise seines Namens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0058f53-0dbf-4239-8eca-f856f4254f44",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "Aus kopierschutzrechtlichen Gründen bedarf es einer Namensänderung des Produktes."
                            },
                            {
                                "example_id": "39e708b2-222f-4c5e-add3-1966ba8243b0",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "„Auch existiert keine Statistik darüber, wie viele Familien dem Aufruf einer Namensänderung nachkamen.“"
                            },
                            {
                                "example_id": "d08b0bb3-9d1b-4365-b486-b7a346a3154b",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "Einer Namensänderung kann aus ästhetischen Gründen zugestimmt werden."
                            },
                            {
                                "example_id": "0b099b8b-1125-4739-b02f-08ad2e74eeb1",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "Er suchte und suchte, aber durch die Namensänderung konnte er sie nicht finden."
                            },
                            {
                                "example_id": "16e1c976-212c-49e6-a4d2-b3211bf94ee0",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "„Sie ließen sich durch eine bloße Namensänderung nicht hypnotisieren.“"
                            },
                            {
                                "example_id": "43a9a775-7429-40ad-b19b-be4107b05377",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "„Nein, weder habe ich geheiratet noch eine Namensänderung beantragt.“"
                            },
                            {
                                "example_id": "6ca2d83d-43f6-4b75-a87d-10203efd711b",
                                "sense_id": "a33a5bd2-7119-3164-9801-e37070c153b8",
                                "text": "„Nur der Familie der Coleoni aus Bergamo würde eine Namensänderung schwerfallen, denn die für die Fortpflanzung nötigen Drüsen erscheinen auf ihrem alten Familienschild; sie hätten sich also mit dem Verzicht auf ihr Wappen zugleich des Ruhmes ihres Heros Bartolomeo begeben müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
