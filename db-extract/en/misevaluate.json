                                        "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                        "entry_id": "971faabc-3958-30f0-88d6-39fab3ee0da3",
                                        "glosses": [
                                            "den Wert oder die Qualität von etwas abschätzen, bestimmen oder festlegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eecc24d-48b1-4edd-9d51-ec14461da401",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Wie würden sie als Fachmann die Situation bewerten?"
                                            },
                                            {
                                                "example_id": "f9b21eed-272a-4979-bdcd-dc13c6b24a1b",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Ich bewerte die Lage nicht allzu dramatisch."
                                            },
                                            {
                                                "example_id": "669b88b6-90c4-4a4e-8d57-5e30ca82566e",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Die Lehrerin bewertet die Mädchen immer etwas besser als die Jungen."
                                            },
                                            {
                                                "example_id": "27ab7cc5-54bc-43c0-bde1-445738e7103b",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Die Analysten bewerten die Aktie der Heuschreck AG mit 1,45 Euro."
                                            },
                                            {
                                                "example_id": "92d572b4-244f-4e94-89da-ab9d87cdc60c",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Ich will die Aussage meines Parteikollegen hier nicht bewerten."
                                            },
                                            {
                                                "example_id": "bbbddd81-fbe5-438c-92d2-681752d625fa",
                                                "sense_id": "8e45eb25-59fc-3843-b759-90d0a5f10d58",
                                                "text": "Wir bewerteten die Leistungen des Herrn Bleibein damals zu schlecht, weshalb er unser Unternehmen verließ."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
