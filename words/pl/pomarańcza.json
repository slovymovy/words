                    "sense_definition": "Owoc cytrusowy o soczystym miąższu i pomarańczowej skórce.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "owoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem na rynku dwie słodkie <w>pomarańcze</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил на рынке два сладких <w>апельсина</w>.",
                                "en": "I bought two sweet <w>oranges</w> at the market."
                            }
                        },
                        {
                            "text": "Codziennie rano piję świeżo wyciśnięty sok z <w>pomarańczy</w>.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я пью свежевыжатый сок из <w>апельсинов</w>.",
                                "en": "Every morning I drink freshly squeezed <w>orange</w> juice."
                            }
                        }
