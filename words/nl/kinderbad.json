                    "synonyms": [
                        "babybad"
                    ],
                    "common_phrases": [
                        "plastic kinderbad"
                    ],
                    "target_lang_definitions": {
                        "en": "Small, portable bathtub or basin used for bathing a baby or small child."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baby bath",
