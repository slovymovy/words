                ],
                "senses": [
                    {
                        "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                        "entry_id": "43d01a8f-313e-3022-b746-f58fa44a8c83",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b8c24cd-d2d9-43de-8e10-f7734b08f30c",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Frau Biberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7ad80499-6932-4011-870c-ca3feaa7ab3a",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Herr Biberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00b2e8a4-903d-4bdf-8bd4-d968e7523758",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Die Biberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "de3a389f-11e7-497a-bdde-61b7a3c36672",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Der Biberle trägt nie die Pullover, die die Biberle ihm strickt."
                            },
                            {
                                "example_id": "01127d03-eaae-4dd4-96c6-4e151558ca99",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Biberle kommt, geht der Herr Biberle.“"
                            },
                            {
                                "example_id": "1c6bde85-4204-47ea-a0bf-78a28de0e24f",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Biberle kommt und geht."
                            },
                            {
                                "example_id": "e98820e8-5997-4224-af13-69a21bff9ea8",
                                "sense_id": "41da150c-f3c2-39a0-b27f-a983072db9a9",
                                "text": "Biberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
