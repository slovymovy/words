        "nl-extract.jsonl": [
            {
                "entry_id": "d2357a87-6c7e-3d79-9213-a4881810520d",
                "word": "apparatuur",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9942bd82-c117-30ce-8958-d4e6cb899e1d",
                        "entry_id": "d2357a87-6c7e-3d79-9213-a4881810520d",
                        "glosses": [
                            "geheel aan toestellen en toebehoren dat men voor een bepaalde taak benodigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46fad0a-a16d-403f-b0c5-042c9d2c4f27",
                                "sense_id": "9942bd82-c117-30ce-8958-d4e6cb899e1d",
                                "text": "Voor de algoritmes is hij een doorsneezestiger met een liefde voor exotische vakantieoorden en vernuftige, niet al te dure huishoudelijke apparatuur."
                            },
                            {
                                "example_id": "646ec2d6-bcc3-4aa6-896c-d008a7ff4f71",
                                "sense_id": "9942bd82-c117-30ce-8958-d4e6cb899e1d",
                                "text": "Hoewel hij nooit kookte had hij toch een enorme hoeveelheid keukenapparatuur in zijn keuken staan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2df5ff-6383-4dd5-b293-43a8e28c3fb2",
                        "source_entry_id": "d2357a87-6c7e-3d79-9213-a4881810520d",
                        "source_sense_id": "9942bd82-c117-30ce-8958-d4e6cb899e1d",
                        "source_sense_description": "het geheel aan toestellen en toebehoor dat men voor een bepaalde taak benodigt",
                        "target_lang_word": "equipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The act of equipping, or the state of being equipped, as for a voyage or expedition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc28791-9dce-4934-a86e-1d48bb263b60",
                                                "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                                "text": "The equipment of the fleet was therefore hastened by de Witt ; in hopes that , by striking at first a successful blow , he might inspire courage into the dismayed States"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "Any items used in equipping something or someone, for example things needed for an expedition or voyage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a95e163-8cc9-4283-a135-9f12d3b13ef2",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "We need more gardening equipment if we want to properly landscape our yard, not just a rake and some gloves."
                                            },
                                            {
                                                "example_id": "72d04ec0-c08a-47f7-9713-c6b2ee67bf2a",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "The sports shop sells different kits of famous clubs, and equipment from all kind of sports."
                                            },
                                            {
                                                "example_id": "124b0ea7-6398-4553-8d53-ddb688c00592",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Tompkins is considered a hero in the deep ecology movement and works hand in hand with his wife Kris, the former CEO of the outdoor clothing and equipment company Patagonia."
                                            },
                                            {
                                                "example_id": "ef7a840c-130a-43de-b4f9-c5f966a6f1c6",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Armed and dight, In the equipments of a knight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The male genitalia."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ce009d-1f83-49df-92b0-0c7b08d28902",
                                                "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                                "text": "The segment advises the reader matter-of-factly that “the penis [of a whale] should be tucked inside the body and when needed enlarged into an erection”. At the very least, the statement sounds odd. At most, it could make human penis owners consider that their equipment might not represent the highest evolutionary ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "416a931f-7a8e-45bf-b1d8-9ad5a885ba78",
                        "source_entry_id": "d2357a87-6c7e-3d79-9213-a4881810520d",
                        "source_sense_id": "9942bd82-c117-30ce-8958-d4e6cb899e1d",
                        "source_sense_description": "het geheel aan toestellen en toebehoor dat men voor een bepaalde taak benodigt",
                        "target_lang_word": "appareillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04688109-b419-3770-b1bb-fcb5d46bfb8a",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Action d’appareiller ou de s’y disposer, de quitter le port, de lever l’ancre ou de quitter le mouillage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be1c8cc3-a5cb-4b87-b3e5-a22625d8fbea",
                                                "sense_id": "04688109-b419-3770-b1bb-fcb5d46bfb8a",
                                                "text": "Le navire prépare son appareillage."
                                            },
                                            {
                                                "example_id": "2351fb4e-444e-4fbc-91ef-09b5947901ca",
                                                "sense_id": "04688109-b419-3770-b1bb-fcb5d46bfb8a",
                                                "text": "Au poste d'appareillage, chacun est attentif aux manœuvres."
                                            },
                                            {
                                                "example_id": "41304f43-40ea-4cb2-9ad0-0882c1a3cedd",
                                                "sense_id": "04688109-b419-3770-b1bb-fcb5d46bfb8a",
                                                "text": "On fit les dispositions pour l’appareillage. De nouvelles voiles furent enverguées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908a2610-cea7-317b-88d9-524f2a2d0cca",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Ensemble des manœuvres nécessaires à cette action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "184a365c-58e7-3f12-ab5c-f25fd426a747",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Action d’appareiller des pierres, des briques ou des dalles. Motifs formés par les pierres, briques ou dalles et résultant de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba38462-ff65-4c11-becd-1789c3605d3c",
                                                "sense_id": "184a365c-58e7-3f12-ab5c-f25fd426a747",
                                                "text": "Un opus romain, un dallage à l'anglaise ou à l'antique, un opus incertum sont des types d’appareillages assez fréquents pour la réalisation de dallages réguliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3bbf7f-cb90-3c5c-a919-2c842939b6d1",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Désigne la disposition régulière de différents matériaux de construction."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b5315b-b333-485b-94e0-4d9abd69cea8",
                                                "sense_id": "db3bbf7f-cb90-3c5c-a919-2c842939b6d1",
                                                "text": "Les lames de parquets permettent de créer de nombreux appareillages."
                                            },
                                            {
                                                "example_id": "e7d49efd-8655-4bae-b34b-734b5ed15468",
                                                "sense_id": "db3bbf7f-cb90-3c5c-a919-2c842939b6d1",
                                                "text": "Note d’usage : Mot récent dans cette acception, les ouvrages de référence lui préfèrent appareil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c2119b6-707d-3c92-9d6b-7e90a7ed0289",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Ensemble d'appareils, d'outils et d'accessoires disposés pour un usage technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7dc73fa-e995-48d3-953c-7ce4cb03a034",
                                                "sense_id": "1c2119b6-707d-3c92-9d6b-7e90a7ed0289",
                                                "text": "Pour créer ton studio d’enregistrement il te faut tout un appareillage électronique."
                                            },
                                            {
                                                "example_id": "8181bf5a-1beb-4187-961d-e7abb92aa78d",
                                                "sense_id": "1c2119b6-707d-3c92-9d6b-7e90a7ed0289",
                                                "text": "Le laboratoire va renouveler tout son appareillage."
                                            },
                                            {
                                                "example_id": "e0dd1361-8dbe-4cfc-95b7-f46a94d091e2",
                                                "sense_id": "1c2119b6-707d-3c92-9d6b-7e90a7ed0289",
                                                "text": "L’appareillage ressemblait à celui du local précédent : générateurs, transformateurs, électrodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "486eae22-8621-363c-822f-4001ca6838dd",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Prothèse ou orthèse médicale ou dentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb564a73-48dd-4db4-a0c5-a69abb887100",
                                                "sense_id": "486eae22-8621-363c-822f-4001ca6838dd",
                                                "text": "À la suite de son accident, on lui a installé un appareillage pour sa jambe gauche."
                                            },
                                            {
                                                "example_id": "7ee8bfc9-48e7-4dd3-815b-1d07d6d16a54",
                                                "sense_id": "486eae22-8621-363c-822f-4001ca6838dd",
                                                "text": "Il suffirait, en théorie, d'installer une caméra par exemple sur une paire de lunettes, puis de convertir les images pour les envoyer au cerveau de la personne. Un appareillage semblable à celui qu'a porté Geordi La Forge dans Star Trek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c91c7c0-51f0-3903-b851-544330c16095",
                                        "entry_id": "2870d022-3d8c-3410-98d9-7006ef6a028e",
                                        "glosses": [
                                            "Pose d’une prothèse médicale ou dentaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ff1038-b676-4ef9-a31e-3d507c088226",
                                                "sense_id": "4c91c7c0-51f0-3903-b851-544330c16095",
                                                "text": "Je vais devoir vous faire un appareillage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
