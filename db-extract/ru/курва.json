                    }
                ],
                "senses": [
                    {
                        "sense_id": "06ff7dc8-a85e-3bd6-8c71-00bd789d53f5",
                        "entry_id": "6712a81c-5852-3cc6-b96f-9851b846a892",
                        "glosses": [
                            "вульг., бран. проститутка, шлюха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a976d7a6-c425-4226-a432-47028bb8d6e6",
                                "sense_id": "06ff7dc8-a85e-3bd6-8c71-00bd789d53f5",
                                "text": "Царь ― пьянюга, царица ― курва, паньским грошам от войны прибавка, а нам на шею… удавка."
                            },
                            {
                                "example_id": "bd21cb81-a0b2-4eb9-b82c-ca2c3394e1a1",
                                "sense_id": "06ff7dc8-a85e-3bd6-8c71-00bd789d53f5",
                                "text": "Пел Ганя про «сибулонцев» (заключенных сибирских лагерей) ― как одному удалось сбежать; только он сбежать-то сбежал, а куда теперь ― не знает, потому что жена его, курва, сошлась без него с другим."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab471f90-6134-4d66-b205-edd3352dc3ec",
                        "source_entry_id": "6712a81c-5852-3cc6-b96f-9851b846a892",
                        "source_sense_id": "06ff7dc8-a85e-3bd6-8c71-00bd789d53f5",
                        "target_lang_word": "kurwa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurwa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e41491a1-16ff-326a-9431-f9cdade49b1c",
                                        "entry_id": "de6818b3-2e8e-30bb-a7bc-bdacd23f4bce",
                                        "glosses": [
                                            "prostytutka"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad6e6de-377c-430d-9c7f-8015a3ceb829",
                                                "sense_id": "e41491a1-16ff-326a-9431-f9cdade49b1c",
                                                "text": "Co wieczór przy szosie stoją kurwy i czekają na jakiś zarobek."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "03fae6dc-0c7d-388a-a16b-b3550e9fccc0",
                                        "entry_id": "de6818b3-2e8e-30bb-a7bc-bdacd23f4bce",
                                        "glosses": [
                                            "kobieta prowadząca rozwiązły tryb życia"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d0d348-8e71-406a-a951-b9c15b1f0ffd",
                                                "sense_id": "03fae6dc-0c7d-388a-a16b-b3550e9fccc0",
                                                "text": "Ziemię pomierzył i głębokie morze, • Wie, jako wstają i zachodzą zorze, • Wiatrom rozumie, praktykuje komu — • A sam nie widzi, że ma kurwę w domu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "5ea4621f-c0f0-39d8-8a9d-0346e4bd3844",
                                        "entry_id": "de6818b3-2e8e-30bb-a7bc-bdacd23f4bce",
                                        "glosses": [
                                            "do kobiety / o kobiecie"
                                        ],
                                        "tags": [
                                            "scornfully",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c907ab0b-a43a-48ab-b0dc-77849bee019b",
                                                "sense_id": "5ea4621f-c0f0-39d8-8a9d-0346e4bd3844",
                                                "text": "Nie będziesz mi, kurwo, mówiła, co mam robić!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "69126766-43fd-39b0-bcaf-1f3a8917687a",
                                        "entry_id": "de6818b3-2e8e-30bb-a7bc-bdacd23f4bce",
                                        "glosses": [
                                            "człowiek postępujący w sposób podły lub niemoralny, łajdak, nikczemnik, sprzedający się"
                                        ],
                                        "tags": [
                                            "scornfully",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f196759-5334-493b-ad6f-be4bac48d31b",
                                                "sense_id": "69126766-43fd-39b0-bcaf-1f3a8917687a",
                                                "text": "Ty kurwo! Jeszcze mi wisisz dwa baniaki, co przerżnąłeś w pokera."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "kurwa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7fc3b5-0adb-34a7-8ee0-7aa27672ffc8",
                                        "entry_id": "15e8cb04-cb52-3514-9f44-687e9eb5649f",
                                        "glosses": [
                                            "…powtarzany jako przekleństwo, w mowie potocznej często jako przerywnik w zdaniu"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2ed3fa-9c58-4adf-acdf-b23c339b69cd",
                                                "sense_id": "ee7fc3b5-0adb-34a7-8ee0-7aa27672ffc8",
                                                "text": "Zamkniesz się, kurwa, czy nie?!"
                                            },
                                            {
                                                "example_id": "5300b751-6916-4778-abe6-90b0672b2f4d",
                                                "sense_id": "ee7fc3b5-0adb-34a7-8ee0-7aa27672ffc8",
                                                "text": "O kurwa, zajebali mi portfel!"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "kurwa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f04dcc52-c355-3150-8114-8ac9ce26d3c7",
                                        "entry_id": "e0e89554-d7eb-3353-b311-9507d2cf4611",
                                        "glosses": [
                                            "…występująca bezpośrednio po wyrazie, który mówca chce podkreślić (i tym samym swoje uniesienie, euforię lub rozgoryczenie)"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
