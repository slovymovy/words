                            },
                            {
                                "target_lang_word": "línea de sangre",
                                "target_lang_sense_clarification": "descendencia genética o familiar"
                            },
                            {
                                "target_lang_word": "estirpe",
                                "target_lang_sense_clarification": "raíz o tronco de una familia"
                            },
                            {
                                "target_lang_word": "progenie",
                                "target_lang_sense_clarification": "origen o ascendencia genealógica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a39f70bb-951a-3c9a-8f12-c4773e3f3de2",
                    "sense_definition": "The pedigree or recorded lineage of an animal.",
