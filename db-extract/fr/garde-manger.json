                ],
                "senses": [
                    {
                        "sense_id": "f63826bc-daab-397f-a620-111179c3ea78",
                        "entry_id": "7c198efc-7e68-364b-8ed4-3532de24e1a6",
                        "glosses": [
                            "Lieu pour garder ou serrer de la viande et autres aliments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f0fd37-4005-4b79-bccf-5576b361a50c",
                                "sense_id": "f63826bc-daab-397f-a620-111179c3ea78",
                                "text": "Or, disait le caporal Joliffe, […], quand l’ours est dans le garde-manger, c’est un genre de venaison qui n’est point à dédaigner, tant s’en faut."
                            }
                        ]
                    },
                    {
                        "sense_id": "be54199d-0d72-3381-a6d1-40ee7a52694d",
                        "entry_id": "7c198efc-7e68-364b-8ed4-3532de24e1a6",
                        "glosses": [
                            "Petite armoire formée ordinairement de châssis garnis de toile métallique et destinée au même usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec4a6af-5cc6-4848-a767-8b9b40a70d2b",
                                "sense_id": "be54199d-0d72-3381-a6d1-40ee7a52694d",
                                "text": "Serrer du gibier dans un garde-manger."
                            },
                            {
                                "example_id": "162efc77-d281-4d0c-a63f-a1bf10102440",
                                "sense_id": "be54199d-0d72-3381-a6d1-40ee7a52694d",
                                "text": "Quoi qu’il en soit, pareil jambon n’existe plus de nos jours : le goût était exquis, ma grand-mère le conservait dans un garde-manger finement grillagé pendu au plafond de la fraîche cave qui jouxtait la « vieille maison »."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34f7176-6dc5-3085-9a4e-8a6fbfc1b04a",
                        "entry_id": "7c198efc-7e68-364b-8ed4-3532de24e1a6",
                        "glosses": [
                            "Chef de partie responsable des plats froids dans une brigade de cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a1612e-3751-4bb3-836d-50017c47921d",
                                "sense_id": "b34f7176-6dc5-3085-9a4e-8a6fbfc1b04a",
                                "text": "Un chef de partie tournant est capable de remplacer n’importe quel chef de partie : saucier, grilladin, garde-manger, entremétier, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4f50c88-6141-4465-8370-b65b83cf9129",
                        "source_entry_id": "7c198efc-7e68-364b-8ed4-3532de24e1a6",
                        "target_lang_word": "Speisekammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisekammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                        "entry_id": "d00e1c14-b802-361d-a4f2-4b9647ef4aa4",
                                        "glosses": [
                                            "ein kleiner und kühler Raum, in dem Lebensmittel aufbewahrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846e1f2b-9a33-4f15-b2de-676143e79587",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "Die Speisekammer sollte trocken und eher kühl sein."
                                            },
                                            {
                                                "example_id": "6849e17a-d37a-4df6-aabf-cafe639c77f3",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Die Speisekammer eines Flugzeuges war geräumiger.“"
                                            },
                                            {
                                                "example_id": "ae3552a9-2ae2-4e6f-ba0b-6620ad99fe2f",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Vasen standen in der Speisekammer.“"
                                            },
                                            {
                                                "example_id": "d7b53b64-40b7-49c8-8cfa-c24fabe0b780",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Erich Snider riß die Tür zur Speisekammer auf, wies auf die gefüllten, übervollen Regale.“"
                                            },
                                            {
                                                "example_id": "64b7b4bd-a1ce-4085-bd34-29d3e5750601",
                                                "sense_id": "e4c12d26-0011-3f46-a85b-d978d0b7a26e",
                                                "text": "„Minnas Teller ist längst leer, und nun stöbert Willy Jensen in der Speisekammer herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
