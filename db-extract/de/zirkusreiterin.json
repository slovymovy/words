                        "examples": [
                            {
                                "example_id": "6a66962e-4423-45a1-b7db-d216597fe0d6",
                                "sense_id": "bec12652-f548-39fb-bf17-aadeffb6ef4b",
                                "text": "„Margaretha Zelle geht nach Paris, da ist sie 28. Sie versucht es als Aktmodell, dann als Zirkusreiterin. Im Zirkus rät man ihr zum Tanz.“"
                            },
                            {
                                "example_id": "abf33a03-ca58-4e8c-bb35-85854befc86d",
                                "sense_id": "bec12652-f548-39fb-bf17-aadeffb6ef4b",
                                "text": "„Eine polnische Zirkusreiterin beklagte sich in ihrem Zelt über plötzlich auftretende rheumatische Schmerzen im Rücken.“"
                            }
                        ],
