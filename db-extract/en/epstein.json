                        "sense_id": "6b2450a2-6bf2-31f4-91f9-e257c14fa1bd",
                        "entry_id": "6a21965b-d32f-38b9-8f38-1b4e873e039d",
                        "glosses": [
                            "To commit homicide and then frame it as a suicide, especially against a witness or co-conspirator in a crime."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a2681ee-3702-4138-81a6-effed8df86c7",
                                "sense_id": "6b2450a2-6bf2-31f4-91f9-e257c14fa1bd",
                                "text": "He has dirt on a lot of powerful people; they are likely going to epstein him."
                            },
                            {
                                "example_id": "5f4d3ebd-1e4b-466f-afb2-9f9836aadf2a",
                                "sense_id": "6b2450a2-6bf2-31f4-91f9-e257c14fa1bd",
                                "text": "not epsteined, they were after his money, he was into flakka, bet he got toasty in jail too"
                            },
                            {
                                "example_id": "eec116b7-b202-402c-bd63-6c257d78b239",
                                "sense_id": "6b2450a2-6bf2-31f4-91f9-e257c14fa1bd",
                                "text": "If the Dominions were used to cheat the 2020 [election], I'm certain the evidence has been wiped by now. If a whistle blower popped up, they'd be epsteined by sundown."
                            }
                        ]
                    }
