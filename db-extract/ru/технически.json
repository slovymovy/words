                                "target_senses": [
                                    {
                                        "sense_id": "a82f3ca3-d904-3f1b-a98a-37a8f61ca842",
                                        "entry_id": "1b243db5-ec77-31c2-9ae7-623394d48182",
                                        "glosses": [
                                            "dal punto di vista tecnico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f748aa-91a9-4a5a-9046-9d75a276eb8d",
                                                "sense_id": "a82f3ca3-d904-3f1b-a98a-37a8f61ca842",
                                                "text": "L'agenzia nazionale della sicurezza ferroviaria ANSF è un soggetto tecnicamente indipendente rispetto a tutti gli operatori nel campo del trasporto ferroviario"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a58bd8e0-0fe9-4739-b379-6bed0e2f7802",
                        "source_entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
                        "source_sense_id": "1cabb9c7-3430-3ed1-8f05-915ed59a874d",
                        "target_lang_word": "technisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                        "entry_id": "1bf834d6-4722-343f-a483-d386f2e281a3",
                                        "glosses": [
                                            "die Technik betreffend, auf die Technik bezogen, in der Art und Weise der Technik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c986e8bf-8247-4aa6-82a9-c5d85a9bd27d",
                                                "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            },
                                            {
                                                "example_id": "61540fa4-46fd-4dc1-88a3-5b741c170f8a",
                                                "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                                "text": "„Die Landung, der technisch anspruchsvollste Teil eines Drachenflugs, wird nicht mehr geschildert, und der Leser fragt sich, wie der psychisch und wohl auch flugtechnisch total überforderte Mann wohl gelandet sein mag.“"
                                            },
                                            {
                                                "example_id": "f97bc5bb-5a02-4625-8e52-a78017349923",
                                                "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                                "text": "Maschinen werden anhand technischer Zeichnungen gebaut."
                                            },
                                            {
                                                "example_id": "2eb82d2d-7c10-4b15-92b8-adec1989581b",
                                                "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                                "text": "Rein technisch gesehen ist das kein Problem."
                                            },
                                            {
                                                "example_id": "4217ab8d-76af-4364-bbaf-14d7b743b34e",
                                                "sense_id": "9af6e827-5f93-3a61-b04c-6eda238e5d63",
                                                "text": "„Infolge technischer Verbesserungen erfährt die Dampfschifffahrt ab der Mitte des 19. Jahrhunderts rasante Fortschritte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df11c180-9dec-4bbb-95bd-9d78bb490f2d",
                        "source_entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
                        "source_sense_id": "1cabb9c7-3430-3ed1-8f05-915ed59a874d",
                        "target_lang_word": "techniquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "techniquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf2583f-fb92-3534-aec0-f6dbdf05445f",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "D’une manière technique; selon les procédés techniques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35fe52b1-01fc-3072-87f3-f13ef567f6d0",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "Du point de vue technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac1ab74-62e5-480f-bcbe-db30a5868eb1",
                                                "sense_id": "35fe52b1-01fc-3072-87f3-f13ef567f6d0",
                                                "text": "Pour le stratégiste, elle risque, entre autres problèmes, de « tacticiser » la stratégie — réduisant la stratégie à une pure exécution technique, la dépolitisant au passage — imposant également de reconsidérer l’articulation entre efficacité et efficience militaire, au risque de déboucher sur de « nouvelles armées d’ancien régime », techniquement très avancées, mais stratégiquement inaptes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "Du point de vue purement technique, en faisant abstraction de points essentiels."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2eef54-4c3c-4d41-8e6a-3060276d4fed",
                                                "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                                "text": "La guerre de 1950-1953 avait en effet été conclue avec un armistice et non par un traité de paix : Nord et Sud sont donc techniquement toujours en guerre."
                                            },
                                            {
                                                "example_id": "a171810d-00ea-4ec7-954e-ea2716f5df24",
                                                "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                                "text": "Bien que la faille soit techniquement critique, sa sévérité fait débat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
