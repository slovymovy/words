                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_et_forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les murs de ce temple antique sont ornés d'un magnifique <w>relief</w> représentant des batailles."
