                "senses": [
                    {
                        "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                        "entry_id": "d3bb0c7e-38ba-3bd0-8a8c-b20fa66ad011",
                        "glosses": [
                            "Any species of the suborder Serpentes; a snake or serpent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be1a24b4-18f1-48ff-8667-ea68fc80d649",
                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                "text": "Vertebral structure is critical for the identification of fossil snakes, because vertebrae are among the most easily fossilized parts of ophidians."
                            },
                            {
                                "example_id": "b06c3219-3730-4043-bb2b-54be59e664cc",
                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                "text": "It has long been known that ophidians have lost not only their front legs but also every embryonic trace of these limbs and their associated shoulder girdle (to such a degree that we cannot determine how many cervical vertebrae they have)."
                            },
                            {
                                "example_id": "50f91877-3a36-44b0-b9b6-1d937db11948",
                                "sense_id": "d134e898-7445-3a59-ad1c-1b731f993802",
                                "text": "Siamese or double monsters are well known in saurians, chelonians, and ophidians, as are bicephalic, two-tailed and conjoined bodies (thoracodymus, ischiodymus, etc.)."
                            }
                        ]
                    }
                ],
