                                        "examples": [
                                            {
                                                "example_id": "049fef45-9f27-44c3-9d5c-fd0e0a36b594",
                                                "sense_id": "178f2365-536b-3312-bcd3-1bb6edc7fb66",
                                                "text": "Yet Mrs Allen found much favour with the décor of the new vehicles. She also agreed that the levels of comfort were \"immeasurably higher\" than she had previously found."
                                            },
                                            {
                                                "example_id": "008bac40-2ad3-4cb4-95d1-dedf5693febd",
                                                "sense_id": "178f2365-536b-3312-bcd3-1bb6edc7fb66",
                                                "text": "Fashionable Uzbeks wear clothing made from the fabric, and suzanis have become popular with interior designers from the UK to Singapore, who use them as wall décor, bedding, or as the fabric for throw pillows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8284cbe1-3348-4d5b-ba3e-a50bc43f498e",
                        "source_entry_id": "5a7f7200-e9df-3324-8469-8257d2d2a943",
