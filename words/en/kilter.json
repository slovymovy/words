{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef8e5b5d-f977-360c-808b-29a15d4d2112",
                    "sense_definition": "Good, proper, or balanced condition, working order, or alignment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer suddenly stopped working properly and seemed completely out of <w>kilter</w>.",
                            "target_lang_translations": {
                                "de": "Der Drucker funktionierte plötzlich nicht mehr richtig und schien völlig <w>aus dem Lot</w> zu sein."
                            }
                        },
                        {
                            "text": "Lack of sleep threw my daily schedule entirely off <w>kilter</w>.",
                            "target_lang_translations": {
                                "de": "Schlafmangel brachte meinen Tagesablauf völlig <w>durcheinander</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "fettle",
                        "alignment"
                    ],
                    "common_phrases": [
                        "out of kilter",
                        "off kilter"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein guter, ordnungsgemäßer oder ausgeglichener Zustand; Funktionsfähigkeit oder Ausrichtung (fast ausschließlich in festen Wendungen wie „out of kilter“ / „off kilter“ verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ordnung",
                                "target_lang_sense_clarification": "im Sinne von einwandfreiem Zustand oder Funktionsfähigkeit"
                            },
                            {
                                "target_lang_word": "Gleichgewicht",
                                "target_lang_sense_clarification": "im Sinne von Ausgeglichenheit oder Balance"
                            },
                            {
                                "target_lang_word": "Einklang",
                                "target_lang_sense_clarification": "im Sinne von harmonischer Übereinstimmung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dbfe26b-f1c0-3a1a-818e-95aed42163e9",
                    "sense_definition": "A completely worthless or useless hand of cards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to fold immediately after being dealt an absolute <w>kilter</w>.",
                            "target_lang_translations": {
                                "de": "Er beschloss sofort zu passen, nachdem ihm ein absolut <w>wertloses Blatt</w> ausgeteilt worden war."
                            }
                        },
                        {
                            "text": "There was no point in betting with such a useless <w>kilter</w> in his hand.",
                            "target_lang_translations": {
                                "de": "Es hatte keinen Sinn, mit einem so unbrauchbaren <w>Blatt</w> auf der Hand mitzugehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in card games"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein völlig wertloses oder unbrauchbares Blatt beim Kartenspiel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wertloses Blatt",
                                "target_lang_sense_clarification": "beim Kartenspiel"
                            },
                            {
                                "target_lang_word": "schlechtes Blatt",
                                "target_lang_sense_clarification": "Karten ohne Spielwert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}