                        "entry_id": "de18c62b-6dff-36ff-9eab-ce29f62946db",
                        "glosses": [
                            "A pith helmet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84d2bb4-8756-4106-b66e-e7f3bfad51ed",
                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                "text": "I lent my topee to Camarião, who looked extremely odd in it."
                            },
                            {
                                "example_id": "2ec1cf9a-68b1-46bb-83a0-ffa4210d6d3d",
                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                "text": "There were a few people on the platform, among them two Indian police, and a station oflicial with a white topee."
                            },
                            {
                                "example_id": "93d640c5-131a-4d69-ae67-c0b542dba577",
                                "sense_id": "3515afcc-1850-3632-ae58-11d6dff57faa",
                                "text": "'Not a drop of perspiration on his face,' Ned had commented, 'and in the tropics now no one wears a topee, except certain regiments, and Peter the Planter's type of topee blows off in anything over a five-knot breeze.'"
                            }
                        ]
                    }
