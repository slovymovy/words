        "fr-extract.jsonl": [
            {
                "entry_id": "395e5e51-1419-3b83-aa67-4b19243e1374",
                "word": "ninja",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa3cc03d-6b80-417b-b72a-e23ec3b7b602",
                        "entry_id": "395e5e51-1419-3b83-aa67-4b19243e1374",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "ninjas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea29e443-4d73-3225-b78f-18e5cfc3ebee",
                        "entry_id": "395e5e51-1419-3b83-aa67-4b19243e1374",
                        "glosses": [
                            "Espion japonais. Dans les œuvres de fiction, ils et elles sont plus souvent représenté vêtu de noir, une cagoule masquant son visage, accomplissant des exploits physiques en combat, des acrobaties, et expert dans les techniques de diversion."
                        ],
                        "tags": [
                            "Japon"
                        ],
                        "examples": [
                            {
                                "example_id": "baeadb70-d227-4ea0-839d-72576fdf61b3",
                                "sense_id": "ea29e443-4d73-3225-b78f-18e5cfc3ebee",
                                "text": "Incapable de me redresser, j'entrevis un ninja lever son arme au-dessus de ma tête, puis s'écrouler sur moi, le dos transpercé."
                            },
                            {
                                "example_id": "50515b8a-e112-4abf-b8de-68d51c453d24",
                                "sense_id": "ea29e443-4d73-3225-b78f-18e5cfc3ebee",
                                "text": "Elle qui a toujours rêvé d'être une ninja, voilà qu'elle se découvre des dons surnaturels !"
                            },
                            {
                                "example_id": "e9dbbe27-7fd4-4bf9-9d8d-d384e0a668e9",
                                "sense_id": "ea29e443-4d73-3225-b78f-18e5cfc3ebee",
                                "text": "La première, c'est que Rose est la personne la plus flippante que je connaisse. Plus flippante qu'un assassin ninja. Plus flippante qu'un motard apocalyptique sociopathe."
                            }
                        ]
                    },
                    {
                        "sense_id": "089760a0-0c44-384a-8282-50e9a1b8667a",
                        "entry_id": "395e5e51-1419-3b83-aa67-4b19243e1374",
                        "glosses": [
                            "Menace destinée à pousser les joueurs et joueuses à l’action, pour faire avancer une situation qui s’enlise."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8cd3682-b9c0-4c92-a10c-7b38e69d447d",
                        "source_entry_id": "395e5e51-1419-3b83-aa67-4b19243e1374",
                        "target_lang_word": "ninja",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ninja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "A person trained in ninjutsu, especially (historical) one used for espionage, assassination, and other tasks requiring stealth during Japan's shogunate period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7785d4-eb12-459c-9619-86d0bef3b89f",
                                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                                "text": "He used to work in the Japanese agency as a ninja."
                                            },
                                            {
                                                "example_id": "c566e5ce-2634-4498-9dcd-909a6749ab92",
                                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                                "text": "The men... are now learning to be ninja or ‘stealers-in’."
                                            },
                                            {
                                                "example_id": "67f8449c-9cbf-4402-b9d9-f115749ec433",
                                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                                "text": "Spies prowled Japan from the seventh century, but the secretive ninja left few written records."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "A person considered similarly skillful to the historical ninja, especially in covert or stealthy operation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0eb568-0234-4486-a3d2-e9df06f3355b",
                                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                                "text": "Young banking and securities firms executives (nicknamed the ninja...) are especially assigned to cultivate relations with the finance ministry. Only verbal instructions are ever given to the ninja."
                                            },
                                            {
                                                "example_id": "3363f06c-52cf-46fc-9be3-2464868cb03b",
                                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                                "text": "A JavaScript ninja should write lots of code and build things!"
                                            },
                                            {
                                                "example_id": "afc5e731-be1a-4b58-abec-c0e5232dc5c8",
                                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                                "text": "For months the Japanese spoke of national-security adviser Henry Kissinger as a ninja—the magician of Japanese legends who performs supernatural acts and practices sorcery."
                                            },
                                            {
                                                "example_id": "0c0421c8-d573-4d3c-bffa-2daac3e84403",
                                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                                "text": "Other bankers are dubbing themselves ninja, modern-day descendants of the superspies of 17th century samurai houses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "A person considered similarly skillful to the historical ninja, especially in covert or stealthy operation.",
                                            "A notional draconian arm of a corporation (originally Nintendo), tasked with dealing with individuals that infringe on its rights or do not comply with its regulations."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef24056-159a-437b-8d3e-e199273b92b6",
                                                "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                                                "text": "I had TOTK running on my pc 2 weeks before it released on the switch and I'm still here. They can send the ninjas, I'm waiting."
                                            },
                                            {
                                                "example_id": "0a5d4bae-a10b-4842-b40a-2f6f4f358d88",
                                                "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                                                "text": "Nintendo ninjas were inside the discord, watching. Now all the Yuzu devs have turned over all electronic devices, websites, logs..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "A person considered to look like the historical ninja in some way, including (historical slang) an amateur private miner in Mongolia."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e9b374d-363d-4255-92f1-fab19894fac3",
                                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                                "text": "He immediately suspected they were ninjas because, he said, they were dressed in black and wore masks, trademarks of the mysterious assassins who have been sowing terror across East Java in recent months."
                                            },
                                            {
                                                "example_id": "e91db1ac-b5e1-4939-bb6a-6ba10b50df79",
                                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                                "text": "Yen buyers were more subdued... fearing the Bank of Japan's new strategy of covert intervention to buy U.S. dollars through agent banks—described by some as the central bank's ninjas or secret agents."
                                            },
                                            {
                                                "example_id": "0ec2722c-ef95-4843-9746-840134ff7f1b",
                                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                                "text": "Many were former nomads, but as the gold rush gathered pace, students, vets and taxi drivers from Ulan Bator joined the ninjas, not just in Ogoomor but in other gold towns across the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "Synonym of nigga as a friendly term of address."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4cee6d-839e-4a57-a98a-faf15e5b81c5",
                                                "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                                                "text": "What's up, ninjas?"
                                            },
                                            {
                                                "example_id": "5931c33c-3c58-4383-9a0d-4c8017f050aa",
                                                "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                                                "text": "I'm thicker than a Snicker, I'm thicker than your ninja!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09842b73-4642-386d-9a55-6ce67d33fcfa",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "Synonym of nigga as a friendly term of address.",
                                            "Synonym of man as a friendly term of address."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ffd302-5969-477a-ac9e-1b32fc816eb7",
                                                "sense_id": "09842b73-4642-386d-9a55-6ce67d33fcfa",
                                                "text": "What up, my ninja!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e61835-5769-3d3f-a660-580e3daa5c98",
                                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                                        "glosses": [
                                            "nigger."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "euphemistic",
                                            "offensive",
                                            "slur",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ninja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                        "entry_id": "075f80a3-0b90-35d3-8b05-bacde651db5a",
                                        "glosses": [
                                            "Of or related to ninjas in their various senses."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1b8c66-65f6-496e-aa02-32ebdca9bbb8",
                                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                                "text": "The July 1966 issue had a cartoon concerning a Ninja dojo."
                                            },
                                            {
                                                "example_id": "8ec40b63-8f03-4d33-9565-a803dee9bd39",
                                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                                "text": "One of the most controversial characters in Japan's current ninja boom is a stout but surprisingly agile man in his mid-forties named Norihiro Iga-Hakuyusai."
                                            },
                                            {
                                                "example_id": "1d2bb4ad-d7eb-4c52-bee1-0b9c95757459",
                                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                                "text": "[…]Federal agents in body armor and black ninja uniforms[…]"
                                            },
                                            {
                                                "example_id": "95db1d95-1856-45f2-b7d7-4c3beaa1455e",
                                                "sense_id": "ceacfdd2-3b97-35ed-87fd-cf71ba96769e",
                                                "text": "As they broke camp, the teenage son practised his Ninja moves with a tentpole."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ninja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                                        "glosses": [
                                            "To act or move like a ninja, particularly with regard to a combination of speed, power, and stealth."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fb42dd6-8753-45ec-a5a8-3d10571b0912",
                                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                                "text": "I leapt up, ninja'd over to Gav's bed and wheeched the duvet off."
                                            },
                                            {
                                                "example_id": "45e3a45f-4ddc-401d-bbc9-ba9ae57a177d",
                                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                                "text": "In our dark house we were ninja-ing around with water guns."
                                            },
                                            {
                                                "example_id": "9dcbfe08-03e6-4a21-a1ba-48b6ad4801cb",
                                                "sense_id": "f5205fd0-2afe-3cf9-ab58-b68f184ff6d8",
                                                "text": "I ninja'd my way into Kung Fu Records to hang out with those merry pranksters the Vandals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47bd8099-100f-3945-930b-afa3cde95bce",
                                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                                        "glosses": [
                                            "Synonym of preempt: to supersede and invalidate a response to a thread or message by posting immediately before it, typically shortly before the other party finishes writing or posting their reply."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae7ba30c-f59a-43f3-b9a2-fe3c91fc99d3",
                                                "sense_id": "47bd8099-100f-3945-930b-afa3cde95bce",
                                                "text": "When I hit post, I saw that Blue Emu had ninja'd me, so I just deleted my reply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "045f6a33-4c35-3832-b180-59407ca8b1a7",
                                        "entry_id": "97f0dfbe-a347-3613-a453-030cb6a70e05",
                                        "glosses": [
                                            "To claim an item through abuse of game mechanics."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "340c14d7-ec3c-4d07-a0b5-d94c5439b6d0",
                                                "sense_id": "045f6a33-4c35-3832-b180-59407ca8b1a7",
                                                "text": "That damn warrior ninja'd an epic-quality wand even though he can't even use it!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
