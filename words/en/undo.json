                {
                    "sense_id": "b6f3f6b7-d94a-3b36-a747-9f113236afcd",
                    "sense_definition": "To reverse the effects or results of a previous action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reverse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>undo</w> the changes if you make a mistake while typing.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>отменить</w> изменения, если допустите ошибку при наборе текста.",
                                "cs": "Pokud při psaní uděláte chybu, můžete změny <w>vrátit zpět</w>.",
                                "de": "Du kannst die Änderungen <w>rückgängig machen</w>, wenn du dich beim Tippen verschreibst.",
                                "nl": "Je kunt de wijzigingen <w>ongedaan maken</w> als je een fout maakt tijdens het typen."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>undo</w> the damage caused by a natural disaster.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>исправить</w> ущерб, нанесенный стихийным бедствием.",
                                "cs": "Často je obtížné <w>odčinit</w> škody způsobené přírodní katastrofou.",
                                "de": "Es ist oft schwierig, den durch eine Naturkatastrophe verursachten Schaden <w>beheben</w>.",
                                "nl": "Het is vaak moeilijk om de schade veroorzaakt door een natuurramp <w>te herstellen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancel",
                        "reverse"
                    ],
                    "antonyms": [
                        "redo"
                    ],
                    "common_phrases": [
                        "undo the damage",
                        "undo the changes",
                        "undo the effects"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отменить последствия или результаты предыдущего действия.",
                        "cs": "Zvrátit účinky nebo výsledky předchozího jednání.",
                        "de": "Die Auswirkungen oder Ergebnisse einer vorherigen Handlung rückgängig machen.",
                        "nl": "De effecten of resultaten van een eerdere handeling ongedaan maken of terugdraaien."
                    },
