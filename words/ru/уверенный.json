    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "25a3df90-8ce1-378f-bc96-a4dfcdd2ada0",
                    "sense_definition": "Человек, который не сомневается в своих силах, возможностях или в чем-либо другом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "confident_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>уверена</w> в своём успехе на экзамене.",
                            "target_lang_translations": {
                                "en": "She is <w>confident</w> of her success on the exam."
                            }
                        },
                        {
                            "text": "Он был <w>уверен</w> в правильности своего решения.",
                            "target_lang_translations": {
                                "en": "He was <w>sure</w> that his decision was correct."
                            }
                        }
                    ],
                    "antonyms": [
                        "неуверенный"
                    ],
                    "common_phrases": [
                        "уверен в себе",
                        "уверен в успехе"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who does not doubt their abilities, potential, or anything else; self-assured."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confident",
                                "target_lang_sense_clarification": "having belief in oneself or an outcome"
                            },
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "having no doubt about oneself or success"
                            },
                            {
                                "target_lang_word": "certain",
                                "target_lang_sense_clarification": "completely convinced or positive"
                            }
                        ]
                    }
                },
                {
