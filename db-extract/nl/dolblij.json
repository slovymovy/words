        "nl-extract.jsonl": [
            {
                "entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                "word": "dolblij",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "293962c1-b574-4516-8b9f-369ee0836a54",
                        "entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                        "tags": [
                            "inflected",
                            "positive"
                        ],
                        "form": "dolblije"
                    },
                    {
                        "form_id": "6058d58c-15dd-4523-9dc6-b7ba8cd5afb3",
                        "entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "dolblijs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                        "entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                        "glosses": [
                            "in een uitgelaten bui, heel erg vrolijk van stemming, buitengewoon blij, enorm blij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7676a00-80ae-4d19-81ae-94a727039a53",
                                "sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                                "text": "Ze zijn dolblij, net als Hollandsche jongens met de eerste sneeuw."
                            },
                            {
                                "example_id": "503531dd-5e6b-4a41-b6e1-40b63d561a0f",
                                "sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                                "text": "Wat een tocht! Na zeven weken lopen had ik nog niet eens een kwart van de hele trail afgelegd, maar ik was dolblij dat ik de hete woestijn eindelijk achter me kon laten."
                            },
                            {
                                "example_id": "3680b93a-1977-4a83-b312-f3abe7a0db7d",
                                "sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                                "text": "Als je privéles nam van een of andere bijklussende leraar vroegen ze vijftien kroon per uur, had ik uitgezocht. Ik bood Clark aan het voor de helft van de prijs te doen. Hij was dolblij met het aanbod en dat was niet bepaald wat ik had verwacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "724a138c-a56b-4ac4-8576-73c361422d0b",
                        "source_entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                        "source_sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                        "source_sense_description": "uitgelaten zijn, heel erg vrolijk van stemming, buitengewoon blij, enorm blij",
                        "target_lang_word": "heilfroh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heilfroh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6f9714-0d46-36ed-a6d6-cc51cb27da38",
                                        "entry_id": "fbddbe8d-ce60-3546-8817-76e5e5acc3c7",
                                        "glosses": [
                                            "erleichtert, dass eine unangenehme Geschichte ein positives Ende gefunden hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7bde35-c3bc-491a-8116-bfb40c7c5a22",
                                                "sense_id": "6f6f9714-0d46-36ed-a6d6-cc51cb27da38",
                                                "text": "„Die abendlichen Wanderungen hatten mir einen ordentlichen Muskelkater beschert, und so war ich heilfroh, dass ich zu meinem Abendessen mit Ton nicht auch noch radeln musste.“"
                                            },
                                            {
                                                "example_id": "0cf9c2b5-755b-4e08-b26a-d7420b1701b6",
                                                "sense_id": "6f6f9714-0d46-36ed-a6d6-cc51cb27da38",
                                                "text": "„Zuvor hatte Schülersprecherin Lina Vogl („Wir sind heilfroh, dass wir die Prüfungen hinter uns haben“) den Lehrern und den Eltern für ihre Geduld gedankt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "003a2570-0491-4ce9-a8e1-3834a929a6c0",
                        "source_entry_id": "fd55a70a-acfb-363f-bbe0-abd09f7c80b9",
                        "source_sense_id": "337ffd79-09ad-3c34-9976-f282c7b41b8f",
                        "source_sense_description": "uitgelaten zijn, heel erg vrolijk van stemming, buitengewoon blij, enorm blij",
                        "target_lang_word": "froh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5142499c-db9b-39b0-8f5b-803a205c80f5",
                                        "entry_id": "ab3ea46d-b609-3350-9f61-020ef5928daa",
                                        "glosses": [
                                            "voller Freude sein"
                                        ],
                                        "tags": [
                                            "menschliche Emotion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff11a096-cb5e-4cfe-b476-c13a777df28c",
                                                "sense_id": "5142499c-db9b-39b0-8f5b-803a205c80f5",
                                                "text": "Frohe Gesichter machen zufrieden."
                                            },
                                            {
                                                "example_id": "666b71cb-91f8-477f-8245-7e263cd7e8fe",
                                                "sense_id": "5142499c-db9b-39b0-8f5b-803a205c80f5",
                                                "text": "Nachdem die Feinde vertrieben worden waren, waren die Bürger froh."
                                            },
                                            {
                                                "example_id": "cc2671bb-c473-4ca8-86f6-46b88b425cd0",
                                                "sense_id": "5142499c-db9b-39b0-8f5b-803a205c80f5",
                                                "text": "„Er wird erwerben und doch nichts davon genießen und über seine eingetauschten Güter nicht froh werden.“"
                                            },
                                            {
                                                "example_id": "7c4c0922-5760-4562-9163-396e6157bf74",
                                                "sense_id": "5142499c-db9b-39b0-8f5b-803a205c80f5",
                                                "text": "„Mein Sohn, wenn dein Herz weise ist, so freut sich auch mein Herz, und meine Seele ist froh, wenn deine Lippen reden, was recht ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                        "entry_id": "ab3ea46d-b609-3350-9f61-020ef5928daa",
                                        "glosses": [
                                            "Freude auslösend: erleichtert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494ca83a-10b7-4de6-9240-003b78157e41",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "Nachdem die Feinde vertrieben worden waren, waren die Bürger froh."
                                            },
                                            {
                                                "example_id": "6c96f514-772b-4ee6-88e6-84ba5e1bda09",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Er wird erwerben und doch nichts davon genießen und über seine eingetauschten Güter nicht froh werden.“"
                                            },
                                            {
                                                "example_id": "47a5fb79-f876-45df-a184-aa7bf91fa3bd",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Mein Sohn, wenn dein Herz weise ist, so freut sich auch mein Herz, und meine Seele ist froh, wenn deine Lippen reden, was recht ist.“"
                                            },
                                            {
                                                "example_id": "4e1c9e20-cab3-47b6-89df-5de47f43cd90",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Bin ich aber froh, die Steuererklärung ist fertig.“"
                                            },
                                            {
                                                "example_id": "fde7e719-5490-4fa5-b7a5-7d3bebc0e2d3",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Ich bin froh, dass ich helfen konnte.“"
                                            },
                                            {
                                                "example_id": "a6850949-4bcc-4079-8238-91c0f89b6f49",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Ich bin froh, das zu hören.“"
                                            },
                                            {
                                                "example_id": "d848201e-1b93-4532-bb27-36422d25e432",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Wir können froh sein, dass nicht mehr passiert ist!“"
                                            },
                                            {
                                                "example_id": "91388391-675b-4e1e-a12d-920508333c5f",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Ich bin ganz froh, dass ich da nicht mehr arbeiten muss.“"
                                            },
                                            {
                                                "example_id": "6c71be8f-685f-4743-bcfb-f262501595ac",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "Die frohe Botschaft vom Helsinki-Gipfel zuerst: Mit dem Treffen in Finnland beendet Donald Trump seine Europa-Reise und fliegt zurück in die Heimat."
                                            },
                                            {
                                                "example_id": "0c613536-9fe0-4d3e-887a-62c0fe699b57",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "Er kann froh sein, dass Dummheit nicht wehtut."
                                            },
                                            {
                                                "example_id": "aa2b7b46-1782-4a4c-99a4-617aa00ded4e",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "„Wir bekommen hier keinen Flüchtlingsstatus. Aber wir wären ja schon froh über irgendeinen Status. Ich kann mir nicht vorstellen, in die Ukraine zurückzukehren.“"
                                            },
                                            {
                                                "example_id": "9504d0e2-a8e6-4391-a378-c189a35123af",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "Wir messen unseren Blutdruck, wir messen Fieber und unseren Bodymaßindex. Aber, können wir Glück messen? Die Forscher wären froh, wenn sie eine zuverlässige und objektive Methode finden könnten."
                                            },
                                            {
                                                "example_id": "7de0a6e5-c4c6-4082-8866-d96bd8d8aa8b",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "Ein als gefährlich eingestufter […] Islamist ist als ganz normaler Passagier von Hamburg nach Athen geflogen. Deutsche Behörden scheinen froh, ihn los zu sein."
                                            },
                                            {
                                                "example_id": "2977978e-fb9e-4c17-b9b9-958f72637dbb",
                                                "sense_id": "a59ae652-e6fb-3325-bb35-3c69460ccf2d",
                                                "text": "[Der 50-jährige kommandierende Oberst Nicklas Blomquist:] „Wir haben wieder einen Platz im Herzen der Schweden. Das macht mich als Berufssoldaten und Bürger gleichermaßen froh. Denn die Armee sollte ein Teil der Gesellschaft sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
