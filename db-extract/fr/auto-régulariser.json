                "senses": [
                    {
                        "sense_id": "abb36c20-02d0-341d-9678-a730a5f4e52e",
                        "entry_id": "0d84c229-5e5f-39d0-b092-85bb03f7de30",
                        "glosses": [
                            "Régulariser sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa13e72c-c647-44cc-b733-ffbb085ea451",
                                "sense_id": "abb36c20-02d0-341d-9678-a730a5f4e52e",
                                "text": "En régularisant plus ou moins bien les variations tensionnelles du bébé, elle l’entraîne à s’auto-régulariser de la même manière."
                            },
                            {
                                "example_id": "7a5c2e76-0832-45d3-8135-63d90b372f64",
                                "sense_id": "abb36c20-02d0-341d-9678-a730a5f4e52e",
                                "text": "Sur quoi l’acupuncture va-t-elle agir pour pouvoir aider l’organisme à s’auto-régulariser, ou à se prémunir des maladies ?"
                            },
                            {
                                "example_id": "b46cf44f-6afd-4a48-99a1-e9cf7e69367e",
                                "sense_id": "abb36c20-02d0-341d-9678-a730a5f4e52e",
                                "text": "Ce que Miley et tous les autres enfants stars ont besoin, c’est d’une maison où ils peuvent apprendre à s’auto-régulariser sous surveillance»."
                            }
                        ]
                    }
