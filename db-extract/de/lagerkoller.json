                    {
                        "sense_id": "87727ecb-334c-31ac-9ef7-041dfe84a737",
                        "entry_id": "e8f3ea57-55ad-385d-b1a0-ae8c3aa0793d",
                        "glosses": [
                            "psychischer Erregungszustand bei längeranhaltender, jedoch vorübergehender Unterbringung an einem Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd484dfd-1327-4d18-bc38-4a2484c747b5",
                                "sense_id": "87727ecb-334c-31ac-9ef7-041dfe84a737",
                                "text": "Er musste mal raus, sonst würde er einen Lagerkoller kriegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74cdb026-cfd0-4818-a474-abeb655fdfb8",
                        "source_entry_id": "e8f3ea57-55ad-385d-b1a0-ae8c3aa0793d",
                        "source_sense_id": "87727ecb-334c-31ac-9ef7-041dfe84a737",
                        "source_sense_description": "psychischer Erregungszustand bei längeranhaltender, jedoch vorübergehender Unterbringung an einem Ort",
                        "target_lang_word": "cabin fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabin fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7df5e04d-1504-3db2-a883-166b83d6e288",
                                        "entry_id": "7e9d42fd-c424-3053-b0dd-a618b9dd723f",
                                        "glosses": [
                                            "A condition of restlessness and irritability caused by being in a confined space."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23794bf3-742d-43cc-ab74-e30ed0ab63f0",
                                                "sense_id": "7df5e04d-1504-3db2-a883-166b83d6e288",
                                                "text": "Some residents of Alaska suffer from cabin fever when they remain indoors throughout the long, snowy winters."
                                            },
                                            {
                                                "example_id": "bd9c3d52-8f7e-44d3-9706-c7d558f71eca",
                                                "sense_id": "7df5e04d-1504-3db2-a883-166b83d6e288",
                                                "text": "Just as the body fed too long upon meat becomes a prey to that horrid disease called scurvy, so the mind fed too long upon monotony succumbs to the insidious mental ailment which the West calls \"cabin fever.\""
                                            },
                                            {
                                                "example_id": "c64ecade-e985-4ca5-9520-7298a6553ac5",
                                                "sense_id": "7df5e04d-1504-3db2-a883-166b83d6e288",
                                                "text": "The novelty of a wilderness winter wore off. I began to suffer from cabin fever. I was so anxious to see someone that whenever I heard a car or truck motor, I jumped up on a chair to look out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d01344f4-5770-341a-a971-9c2fda0df375",
                                        "entry_id": "7e9d42fd-c424-3053-b0dd-a618b9dd723f",
                                        "glosses": [
                                            "Typhus."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc03b741-8d95-4900-85c2-f862a18dce7e",
                                                "sense_id": "d01344f4-5770-341a-a971-9c2fda0df375",
                                                "text": "The certain consequence is the low typhus or cabin fever, which at all times, and at this present moment, exists in Ireland to a degree, that in any other country would create a serious alarm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
