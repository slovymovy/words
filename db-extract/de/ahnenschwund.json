                        "source_sense_id": "7fd81f3e-667c-3ed6-9a64-10ef8d3234e2",
                        "source_sense_description": "Auftreten einer geringeren Anzahl an Vorfahren durch Heirat von Verwandten",
                        "target_lang_word": "pedigree collapse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedigree collapse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e03bc2-c228-363a-b682-77a55f7f43cd",
                                        "entry_id": "2c6899f9-a6ac-31b4-8bec-b28ebba3c3cf",
                                        "glosses": [
                                            "The phenomenon in which ancestral inbreeding causes the number of a descendant’s distinct ancestors to be smaller than that predicted by a binary tree (∑ᵢ₌₁ⁿ 2ⁱ, where n represents the number of generations)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd00e74-43cf-47d8-82b6-470200520ee4",
                                                "sense_id": "e3e03bc2-c228-363a-b682-77a55f7f43cd",
                                                "text": "Less well-known is the argument that we may all have a single mitochondrial foundress — not necessarily a single ancestress — owing to the likelihood of ‘lineage extinction’ and ‘pedigree collapse’ as a result of mating with cousins, small population sizes, and high mortality before reproductive age."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cebb9bb4-3fbb-470a-89c8-5fba00624d75",
                        "source_entry_id": "3e31989e-172f-3ad1-93b2-8f23ec7fea27",
                        "source_sense_id": "7fd81f3e-667c-3ed6-9a64-10ef8d3234e2",
