                    "sense_definition": "Een houten melkvat of melkemmer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De melkmeisjes droegen vroeger de zware houten <w>staar</w> aan een juk.",
                            "target_lang_translations": {
                                "en": "In the past, milkmaids carried the heavy wooden <w>milk pail</w> on a yoke."
                            }
                        },
                        {
                            "text": "In het historisch museum staat nog een oude <w>staar</w> die gebruikt werd bij het melken.",
                            "target_lang_translations": {
                                "en": "In the historical museum, there is still an old <w>milk pail</w> that was used for milking."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical vessel"
                        }
