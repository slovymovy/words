                                "example_id": "dd7fdce8-4ac7-4fe8-8031-56eac304069e",
                                "sense_id": "c694f0f3-f100-342c-bc1d-1a64c1d129dd",
                                "text": "Folgen Sie dieser Straße und biegen Sie nach der nächsten Rechtskurve gleich links ab."
                            },
                            {
                                "example_id": "b169c940-ab1b-4db3-9f8d-c46e47cb9897",
                                "sense_id": "c694f0f3-f100-342c-bc1d-1a64c1d129dd",
                                "text": "„Die Straße von Niedaltdorf nach Ihn macht eine Rechtskurve, und links liegt der Parkplatz, von dem der kleine Pfad durch den Wald auf das Heiligtum zuführt.“"
                            }
