                                        "entry_id": "1219aa83-70ea-3960-80cb-0d5a9ef8fe6a",
                                        "glosses": [
                                            "Occurring after an apocalypse or catastrophic event."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc2535a-b6d4-420a-b530-df0c33043116",
                                                "sense_id": "f666f71d-a64e-3bc7-a070-6e6831c0a85d",
                                                "text": "The novel dealt with life in a postapocalyptic France."
                                            },
                                            {
                                                "example_id": "eed74b29-4ba3-432a-b8b2-36fd17f572cd",
                                                "sense_id": "f666f71d-a64e-3bc7-a070-6e6831c0a85d",
                                                "text": "Now she’s been spending her days hanging out at KMUN, learning about the seemingly outmoded technology of terrestrial radio, which she thinks will gain a kind of “postapocalyptic” usefulness to humanity as the internet is overrun with AI slop."
                                            }
                                        ]
                                    }
                                ]
