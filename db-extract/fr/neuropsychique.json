                "senses": [
                    {
                        "sense_id": "86aa3a6f-c4e1-34f9-83ab-4b500dc21283",
                        "entry_id": "483e523a-88d9-33d0-ad1f-85a871459c22",
                        "glosses": [
                            "Relatif au système nerveux et au psychisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34a02b1-7094-486f-b460-775fbf3cb30a",
                                "sense_id": "86aa3a6f-c4e1-34f9-83ab-4b500dc21283",
                                "text": "Du côté de l’organisme, les bains de forêt agissent sur les systèmes neuropsychique, endocrinien et immunitaire."
                            },
                            {
                                "example_id": "65970a76-6c6b-46af-924f-a9b6efe1b254",
                                "sense_id": "86aa3a6f-c4e1-34f9-83ab-4b500dc21283",
                                "text": "Nous avons étudié de façon rétrospective 128 patients de plus de 65 ans avec des symptômes neuropsychiques, hospitalisés entre mai 2009 et mai 2010 dans un service de Post-Urgences Médicales."
                            },
                            {
                                "example_id": "8eca0b0e-24c4-491f-89a1-9608b21f8a07",
                                "sense_id": "86aa3a6f-c4e1-34f9-83ab-4b500dc21283",
                                "text": "Le groupe des schizophrénies – prototype des psychoses – représente un ensemble de maladies neuropsychiques fréquentes (environ 1 % de la population), causes de handicap, de souffrances et de comportements suicidaires."
                            }
                        ]
                    }
