                                                "text": "Is dat yo mama? What's yo doin' in here??"
                                            },
                                            {
                                                "example_id": "d8acba5c-7dfd-4d54-9423-fd14897a574d",
                                                "sense_id": "7732b072-f208-3909-a6e1-8e82845708ac",
                                                "text": "I think I've lost ma pet turtle! You seen yo? Yo mustn't be far from here..."
                                            },
                                            {
                                                "example_id": "ec9665a8-aef3-4e81-b097-3929b264b576",
                                                "sense_id": "7732b072-f208-3909-a6e1-8e82845708ac",
                                                "text": "Yo was tuckin' in his shirt!"
                                            },
                                            {
                                                "example_id": "1660cb6d-baeb-41f2-b063-91333740ba9f",
                                                "sense_id": "7732b072-f208-3909-a6e1-8e82845708ac",
                                                "text": "Wha' dey did to yo? Yo looks nervous!"
                                            }
                                        ]
