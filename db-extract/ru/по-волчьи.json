                        "entry_id": "b49e128b-529e-3886-9e44-677bd61169df",
                        "glosses": [
                            "перен. мрачно, злобно; так, как характерно для тех, кто привык к невзгодам, опасностям"
                        ],
                        "tags": [],
                        "examples": [
