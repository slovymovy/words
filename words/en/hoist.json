{
    "word_family": [
        "hoister",
        "hoisting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                    "sense_definition": "To raise or lift something up, especially using a mechanical device like a pulley or tackle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction workers had to <w>hoist</w> the heavy steel beams to the top floor.",
                            "target_lang_translations": {
                                "ru": "Строителям пришлось <w>поднять</w> тяжелые стальные балки на верхний этаж."
                            }
                        },
                        {
                            "text": "It is tradition to <w>hoist</w> the flag every morning at sunrise.",
                            "target_lang_translations": {
                                "ru": "Существует традиция <w>поднимать</w> флаг каждое утро на рассвете."
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "raise",
                        "elevate",
                        "heave"
                    ],
                    "antonyms": [
                        "lower",
                        "drop"
                    ],
                    "common_phrases": [
                        "hoist the flag",
                        "hoist a sail",
                        "hoist into place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать что-либо, особенно с использованием механических устройств, таких как лебедка или блок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "перемещать вверх"
                            },
                            {
                                "target_lang_word": "поднимать на лебедке",
                                "target_lang_sense_clarification": "с помощью механизма"
                            },
                            {
                                "target_lang_word": "водружать",
                                "target_lang_sense_clarification": "устанавливать на высоте (флаг)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db8fd15-f769-36e0-b208-b4de46599bbb",
                    "sense_definition": "To lift a trophy or prize into the air to celebrate a victory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain was proud to <w>hoist</w> the trophy in front of the cheering fans.",
                            "target_lang_translations": {
                                "ru": "Капитан с гордостью <w>вскинул</w> трофей перед ликующими болельщиками."
                            }
                        },
                        {
                            "text": "After winning the championship, the team gathered to <w>hoist</w> the cup together.",
                            "target_lang_translations": {
                                "ru": "После победы в чемпионате команда собралась, чтобы вместе <w>поднять</w> кубок."
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "raise"
                    ],
                    "common_phrases": [
                        "hoist the trophy",
                        "hoist the cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать трофей или приз в воздух, празднуя победу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "над головой"
                            },
                            {
                                "target_lang_word": "вскидывать",
                                "target_lang_sense_clarification": "торжественно вверх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67187df8-6796-30f4-98f4-e8f518919ad7",
                    "sense_definition": "To steal or rob something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves managed to <w>hoist</w> several valuable paintings from the gallery.",
                            "target_lang_translations": {
                                "ru": "Ворам удалось <w>стащить</w> несколько ценных картин из галереи."
                            }
                        },
                        {
                            "text": "He was caught trying to <w>hoist</w> a wallet from the unsuspecting tourist.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке <w>свистнуть</w> кошелек у ничего не подозревающего туриста."
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "pilfer",
                        "swipe",
                        "pinch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for stealing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть или совершить ограбление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свистнуть",
                                "target_lang_sense_clarification": "украсть (сленг)"
                            },
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "незаметно забрать"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "позаимствовать без спроса (сленг)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "208731fd-82b6-3f93-8cf6-59465e4e034c",
                    "sense_definition": "To move code out of a loop or a specific scope to improve performance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler will <w>hoist</w> the constant expression out of the loop to save time.",
                            "target_lang_translations": {
                                "ru": "Компилятор <w>вынесет</w> константное выражение за пределы цикла для экономии времени."
                            }
                        },
                        {
                            "text": "In JavaScript, variable declarations are often <w>hoisted</w> to the top of the function.",
                            "target_lang_translations": {
                                "ru": "В JavaScript объявления переменных часто <w>поднимаются</w> в начало функции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoist a variable",
                        "loop hoisting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выносить код за пределы цикла или области видимости для оптимизации производительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "в контексте хойстинга переменных"
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "за пределы цикла"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70552679-e216-35bd-992b-49d1081e3a2a",
                    "sense_definition": "A mechanical device used for lifting heavy loads.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garage uses an electric <w>hoist</w> to lift engines out of cars.",
                            "target_lang_translations": {
                                "ru": "В гараже используют электрический <w>подъёмник</w>, чтобы вынимать двигатели из автомобилей."
                            }
                        },
                        {
                            "text": "Make sure the <w>hoist</w> is securely attached before lifting the crate.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>лебёдка</w> надежно закреплена, прежде чем поднимать ящик."
                            }
                        }
                    ],
                    "synonyms": [
                        "crane",
                        "winch",
                        "pulley",
                        "lift"
                    ],
                    "common_phrases": [
                        "electric hoist",
                        "chain hoist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство для подъема тяжелых грузов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъёмник",
                                "target_lang_sense_clarification": "механизм"
                            },
                            {
                                "target_lang_word": "лебёдка",
                                "target_lang_sense_clarification": "тяговый механизм"
                            },
                            {
                                "target_lang_word": "таль",
                                "target_lang_sense_clarification": "подвесное устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3925bbf1-5459-32dc-a40d-1707050fde34",
                    "sense_definition": "The act of lifting or being lifted up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one final <w>hoist</w>, they managed to get the sofa into the truck.",
                            "target_lang_translations": {
                                "ru": "Одним последним <w>рывком</w> им удалось затащить диван в грузовик."
                            }
                        },
                        {
                            "text": "Give me a <w>hoist</w> so I can see over the tall fence.",
                            "target_lang_translations": {
                                "ru": "<w>Подсади</w> меня, чтобы я мог заглянуть за высокий забор."
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "heave",
                        "boost"
                    ],
                    "common_phrases": [
                        "give a hoist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подъема или процесс перемещения вверх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение вверх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b97fb95-aa8d-356b-b4fc-04e79498ca1d",
                    "sense_definition": "The vertical edge of a flag nearest the staff, or the height of a flag when flying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dimensions of the flag are measured by its <w>hoist</w> and its fly.",
                            "target_lang_translations": {
                                "ru": "Размеры флага определяются его <w>высотой</w> и длиной."
                            }
                        },
                        {
                            "text": "The rope is attached to the <w>hoist</w> of the sail to pull it up.",
                            "target_lang_translations": {
                                "ru": "Трос крепится к <w>шкаторине</w> паруса, чтобы подтянуть его вверх."
                            }
                        }
                    ],
                    "antonyms": [
                        "fly"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical and vexillological term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный край флага, ближайший к древку, или высота флага в полете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаторина",
                                "target_lang_sense_clarification": "передняя кромка паруса или флага"
                            },
                            {
                                "target_lang_word": "высота флага",
                                "target_lang_sense_clarification": "вертикальный размер"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}