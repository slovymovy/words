    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de2f3e56-1654-366f-9fff-82c6044a3c77",
                    "sense_definition": "Процесс возведения зданий, сооружений или иных объектов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "процесс созидания",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной началось <w>строительство</w> нового дома в нашем районе.",
                            "target_lang_translations": {
                                "en": "In the spring, the <w>construction</w> of a new house began in our neighborhood.",
                                "zh": "春天，我们社区开始了新房的<w>建设</w>。"
                            }
                        },
                        {
                            "text": "План включает <w>строительство</w> дорог и ремонт старых больниц.",
                            "target_lang_translations": {
                                "en": "The plan includes the <w>building</w> of roads and the renovation of old hospitals.",
                                "zh": "该计划包括道路<w>建设</w>和旧医院的翻修。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возведение",
                        "постро́йка"
                    ],
                    "antonyms": [
                        "разрушение"
                    ],
                    "common_phrases": [
                        "строительство дорог",
                        "начать строительство",
                        "план строительства"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of erecting buildings, structures, or other objects.",
                        "zh": "建造建筑物、构筑物或其他物体的过程。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "the process of building"
                            },
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "the act of constructing"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建设",
                                "target_lang_sense_clarification": "指大规模的建造过程"
                            },
                            {
                                "target_lang_word": "建筑",
                                "target_lang_sense_clarification": "指建造的行为或结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "110691bb-8946-38ec-91ea-41ee93359ff4",
                    "sense_definition": "Место, площадка или сам объект, где ведутся строительные работы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "место действия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Инженер каждый день посещает <w>строительство</w>, чтобы проверить ход работ.",
                            "target_lang_translations": {
                                "en": "The engineer visits the <w>construction site</w> every day to check the progress of the work.",
                                "zh": "工程师每天都会去<w>工地</w>检查工作进度。"
                            }
                        },
                        {
                            "text": "Посторонним вход на <w>строительство</w> строго запрещен в целях безопасности.",
                            "target_lang_translations": {
                                "en": "Unauthorized entry to the <w>construction</w> area is strictly prohibited for safety reasons.",
                                "zh": "出于安全考虑，严禁外人进入<w>建筑工地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "строительный объект",
                        "сооружение"
                    ],
                    "common_phrases": [
                        "работать на строительстве",
                        "заброшенное строительство"
                    ],
                    "target_lang_definitions": {
                        "en": "A place, site, or the object itself where construction work is being carried out.",
                        "zh": "进行建筑施工的场所、工地或项目本身。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction site",
                                "target_lang_sense_clarification": "the place where building happens"
                            },
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "the site or project"
                            },
                            {
                                "target_lang_word": "building site",
                                "target_lang_sense_clarification": "location of work"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工地",
                                "target_lang_sense_clarification": "施工现场"
                            },
                            {
                                "target_lang_word": "建筑工地",
                                "target_lang_sense_clarification": "具体的施工地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acb7b207-d31d-30cc-b7a8-4a135283de45",
                    "sense_definition": "Отрасль экономики, науки и техники, занимающаяся возведением зданий.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отрасль",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Современное городское <w>строительство</w> требует использования экологически чистых материалов.",
                            "target_lang_translations": {
                                "en": "Modern urban <w>construction</w> requires the use of environmentally friendly materials.",
                                "zh": "现代城市<w>建筑</w>要求使用环保材料。"
                            }
                        },
                        {
                            "text": "В этом году <w>строительство</w> показало значительный рост как сектор экономики.",
                            "target_lang_translations": {
                                "en": "This year, <w>construction</w> showed significant growth as an economic sector.",
                                "zh": "今年，<w>建筑业</w>作为经济部门表现出了显著增长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "зодчество"
                    ],
                    "common_phrases": [
                        "городское строительство",
                        "министерство строительства"
                    ],
                    "target_lang_definitions": {
                        "en": "The sector of the economy, science, and technology involved in the erection of buildings.",
                        "zh": "从事建筑物建造的经济、科学和技术部门。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "the industry or trade"
                            },
                            {
                                "target_lang_word": "construction industry",
                                "target_lang_sense_clarification": "economic sector"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建筑业",
                                "target_lang_sense_clarification": "作为经济部门的建筑行业"
                            },
                            {
                                "target_lang_word": "建筑",
                                "target_lang_sense_clarification": "指代建筑领域或行业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f87a9c-de7c-370d-87d0-c3507bc23006",
                    "sense_definition": "Изготовление крупных, сложных технических изделий (кораблей, самолетов, вагонов).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "производство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древесину агатиса веками использовали для <w>строительства</w> кораблей.",
                            "target_lang_translations": {
                                "en": "Agathis wood has been used for centuries for ship <w>building</w>.",
                                "zh": "几个世纪以来，贝壳杉木一直被用于<w>建造</w>船舶。"
                            }
                        },
                        {
                            "text": "Новое <w>строительство</w> самолетов требует огромных финансовых вложений.",
                            "target_lang_translations": {
                                "en": "New aircraft <w>construction</w> requires huge financial investments.",
                                "zh": "新型飞机的<w>制造</w>需要巨大的资金投入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "изготовление",
                        "производство"
                    ],
                    "common_phrases": [
                        "строительство кораблей",
                        "строительство самолетов"
                    ],
                    "target_lang_definitions": {
                        "en": "The manufacturing of large, complex technical products such as ships, aircraft, or railcars.",
                        "zh": "制造大型、复杂的工业产品，如船舶、飞机或车厢。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "manufacturing of large vessels/vehicles"
                            },
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "e.g., shipbuilding"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制造",
                                "target_lang_sense_clarification": "指大型工业产品的生产"
                            },
                            {
                                "target_lang_word": "建造",
                                "target_lang_sense_clarification": "特指大型交通工具的生产"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94b1e855-0feb-3009-a958-1422043faad2",
                    "sense_definition": "Создание, организация или развитие чего-либо нематериального (государства, партии, отношений).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "абстрактное создание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Партийное <w>строительство</w> в регионе шло быстрыми темпами.",
                            "target_lang_translations": {
                                "en": "Party <w>building</w> in the region was proceeding at a rapid pace.",
                                "zh": "该地区的政党<w>建设</w>进展迅速。"
                            }
                        },
                        {
                            "text": "Педагог посвятил жизнь <w>строительству</w> душ своих учеников.",
                            "target_lang_translations": {
                                "en": "The educator dedicated his life to the <w>shaping</w> of his students' souls.",
                                "zh": "这位教育家毕生致力于<w>构建</w>学生的心灵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "создание",
                        "организация",
                        "формирование",
                        "становление"
                    ],
                    "common_phrases": [
                        "партийное строительство",
                        "государственное строительство"
                    ],
                    "target_lang_definitions": {
                        "en": "The creation, organization, or development of something intangible, such as a state, party, or relationships.",
                        "zh": "创建、组织或发展非物质事物，如国家、政党或关系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "abstract development"
                            },
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "formation of abstract entities"
                            },
                            {
                                "target_lang_word": "formation",
