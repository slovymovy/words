                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "glosses": [
                            "do tego momentu, do chwili obecnej"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c63f10ef-a111-4c30-873c-9ff0a2af11cf",
                                "sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                                "text": "Dotychczas sama sobie radziłam z zadaniami z matematyki, więc nie potrzebuję korepetycji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8d7dd39-4f82-4722-b1a7-ece53187e166",
                        "source_entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "source_sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "target_lang_word": "so far",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so far",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                        "entry_id": "b4d3a6c7-529e-3f51-a927-dcbfc4648e62",
                                        "glosses": [
                                            "Until now; previously; yet."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7163639b-7593-48d8-aaf2-a9446b012bbb",
                                                "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                                "text": "So far, nothing unusual has happened."
                                            },
                                            {
                                                "example_id": "47978fa6-7f74-4eb3-b588-01a9a7f36ccc",
                                                "sense_id": "83853f49-67c0-3cfd-a954-368aa4438d9d",
                                                "text": "―How are your driving lessons? ―So far, pretty good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                        "entry_id": "b4d3a6c7-529e-3f51-a927-dcbfc4648e62",
                                        "glosses": [
                                            "A limited distance, literal or metaphorical."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703768d9-c383-4f42-872f-1661e895ce74",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "Don’t expect a long walk. You can only go so far in that direction."
                                            },
                                            {
                                                "example_id": "9eb1c974-e84f-40bd-89ac-d5ba41cdf1d4",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            },
                                            {
                                                "example_id": "4003e770-576c-4780-b7b9-f154e7095e34",
                                                "sense_id": "080665e5-d8fd-3adc-9b92-fc8903dbdf0e",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cff1f9e-7fab-4d4c-9202-c5238211896a",
                        "source_entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "source_sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "target_lang_word": "as yet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as yet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5d0e1c-40e0-3139-b89e-3b820b014778",
                                        "entry_id": "b8270513-1001-321c-ab32-8b0ac938fa06",
                                        "glosses": [
                                            "Up to the present."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03b17df4-d47c-4b41-97d2-fdaa5015adda",
                                                "sense_id": "5d5d0e1c-40e0-3139-b89e-3b820b014778",
                                                "text": "As yet, we have not received the letter you sent us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4dda7c6-c0bf-4ae8-b97f-76b60b6be553",
                        "source_entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "source_sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "target_lang_word": "hitherto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hitherto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                        "entry_id": "02279668-c447-394b-a315-71083603e5e2",
                                        "glosses": [
                                            "Up to this or that time."
                                        ],
                                        "tags": [
                                            "also",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865ceb3f-c8cb-487a-a893-a4066011c8d2",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "All men att the begynnynge⸝ ſett forth goode wyne⸝ And when men be dronke⸝ then thatt which is worſſe: Butt thou haſt kept backe the goode wyne hetherto."
                                            },
                                            {
                                                "example_id": "7bdd2089-fe47-4406-813b-911383091db6",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "[T]he greateſt and moſt active part of Mankind, has never hetherto been vvell contented vvith the preſent."
                                            },
                                            {
                                                "example_id": "6c7bcbb7-6483-41fd-8dd3-025534a1833d",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "But Charles, as vvell from unvvillingneſs to alienate a province of ſo much value, as from diſguſt at the Pope, vvho had hitherto refuſed to join in the vvar againſt Francis, rejected the propoſal."
                                            },
                                            {
                                                "example_id": "8844a13e-ff42-4d12-bcb0-5db80fd623c9",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "The exhaustless conjecturings of that evening's full conversation, made such of the small party, as had hitherto been strangers, well acquainted with each other's turn of mind; […]"
                                            },
                                            {
                                                "example_id": "e9aa767c-207a-4935-b01b-f654fc451bca",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "The history of all hitherto existing society is the history of class struggles."
                                            },
                                            {
                                                "example_id": "a2ac1415-a0ce-4c54-8370-a4c04fa5330a",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "The results of this study argue for a greater endonormativity in Indian English than has hitherto been recognised."
                                            },
                                            {
                                                "example_id": "8add4d01-4c51-4882-a51d-23c49806789b",
                                                "sense_id": "332da3cc-125b-3f16-8687-557cfdc9fc20",
                                                "text": "North of Tain[…], the line reaches the southern shore of Dornoch Firth. Here, the railway and the A9 trunk road, which have hitherto run close together, diverge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c52ca0-2a1f-3737-b983-3dd6009456c1",
                                        "entry_id": "02279668-c447-394b-a315-71083603e5e2",
                                        "glosses": [
                                            "Up to this place."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4d0624-0d93-44d3-b965-6d0dedcbfc06",
                                                "sense_id": "b0c52ca0-2a1f-3737-b983-3dd6009456c1",
                                                "text": "Hither to ſhalt thou come, but no further, and here ſhalt thou laye downe thy proude and hye wawes.^([sic – meaning waves])"
                                            },
                                            {
                                                "example_id": "32be1ed9-e073-4465-8dea-4304b5e3ba27",
                                                "sense_id": "b0c52ca0-2a1f-3737-b983-3dd6009456c1",
                                                "text": "The Archdeacon hath diuided it / Into three limits very equally: / England from Trent, and Seuerne hitherto, / By South and Eaſt is to my part aſsignd: […]"
                                            },
                                            {
                                                "example_id": "148340db-3ed2-49ae-8ed0-41ed0103f3b0",
                                                "sense_id": "b0c52ca0-2a1f-3737-b983-3dd6009456c1",
                                                "text": "Thus far the very Reputation of Defending our Rights does Service to the Publick, it checks and diſcourages Tyranny, and is the Shore and Sea-dyke againſt Arbitrary Povver, and ſays to its proud VVaves, Hitherto ſhall ye come and no further."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3f3456-be50-32b1-bd64-515bb7d916ff",
                                        "entry_id": "02279668-c447-394b-a315-71083603e5e2",
                                        "glosses": [
                                            "In speech or writing: up to this point; thus far."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32094b5-2a59-468f-af92-6bf41f3dbbd5",
                                                "sense_id": "3f3f3456-be50-32b1-bd64-515bb7d916ff",
                                                "text": "The great man dovvne, you marke his fauourite flyes, / The poore aduanc'd, makes friends of enemies, / And hetherto doth loue on fortune tend, / For vvho not needes, ſhall neuer lacke a friend, / And vvho in vvant a hollovv friend doth try, / Directly ſeaſons him his enemy."
                                            },
                                            {
                                                "example_id": "b54a00cf-2569-42f0-810f-0aec75f0b9dc",
                                                "sense_id": "3f3f3456-be50-32b1-bd64-515bb7d916ff",
                                                "text": "\"Really, Mr. Collins,\" cried Elizabeth with some warmth, \"you puzzle me exceedingly. If what I have hitherto said can appear to you in the form of encouragement, I know not how to express my refusal in such a way as to convince you of its being one.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556bcbd9-9b06-37ad-bd79-d29d84459ffe",
                                        "entry_id": "02279668-c447-394b-a315-71083603e5e2",
                                        "glosses": [
                                            "Synonym of hereto (“regarding this subject; to achieve this result; to this end”)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64fb33a6-46ae-4475-a598-5f3fe27d1ece",
                                                "sense_id": "556bcbd9-9b06-37ad-bd79-d29d84459ffe",
                                                "text": "And the eſpeciall intent of this meeting is, to receive our Biſhops directions for the adminiſtration of the Sacraments and Preaching, as his Articles informe us. Hitherto, if I can but hold me by my text, I hope not to fall into impertinencies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hitherto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec218c4-caf2-37c6-9d69-1671b621ed12",
                                        "entry_id": "5623d6f9-f127-3159-98e9-0c492f421239",
                                        "glosses": [
                                            "Existing or occurring before now; former, preceding, previous."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b8315c-a169-4bec-91d5-0cb2f85a1527",
                                                "sense_id": "9ec218c4-caf2-37c6-9d69-1671b621ed12",
                                                "text": "At the same time, then, that the categorical imperative can enjoin nothing without liability to exception but disinterested obedience to itself, it will have no lack of definite content. The particular duties which it enjoins will at least be all those in the practice of which, according to the hitherto experience of men, some progress is made towards the fulfilment of man's capabilities, or some condition necessary to that progress is satisfied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ac4215-b664-40bf-b8ac-ec927badb294",
                        "source_entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "source_sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "target_lang_word": "до сих пор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "до сих пор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5acc06a8-00cb-3385-8071-f28a1441fd74",
                                        "entry_id": "ab0f0954-7eb4-32d1-bd3c-ad52bde1cc04",
                                        "glosses": [
                                            ": до настоящего времени, до настоящего момента"
                                        ],
                                        "tags": [
                                            "с глаг. несов. и сов. вида, с прил., с прич."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ddd9744-2604-4091-a157-9fc49b434b84",
                                                "sense_id": "5acc06a8-00cb-3385-8071-f28a1441fd74",
                                                "text": "Я не знаю, как случилось, что мы до сих пор с вами незнакомы…"
                                            },
                                            {
                                                "example_id": "f6f984c4-4397-48b0-a587-2a90fc4518c9",
                                                "sense_id": "5acc06a8-00cb-3385-8071-f28a1441fd74",
                                                "text": "Мне кажется, у него большие способности к музыке; но он до сих пор не занимался ею как следует."
                                            },
                                            {
                                                "example_id": "342d9d91-07a3-4c81-9ee7-104c864e9c32",
                                                "sense_id": "5acc06a8-00cb-3385-8071-f28a1441fd74",
                                                "text": "Очаровательное место! Всякий может в этом убедиться, если пожелает направиться в этот сад. Пусть обратится ко мне, я скажу ему адрес, укажу дорогу – особняк цел ещё до сих пор."
                                            },
                                            {
                                                "example_id": "c2a1df76-b21a-4e97-93c1-cc043f6b58a6",
                                                "sense_id": "5acc06a8-00cb-3385-8071-f28a1441fd74",
                                                "text": "Лучшим местом на земле я считал (и считаю до сих пор) холм под стеной Святогорского монастыря в Псковщине, где похоронен Пушкин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630a251f-4f8c-3019-a773-7510850c62ea",
                                        "entry_id": "ab0f0954-7eb4-32d1-bd3c-ad52bde1cc04",
                                        "glosses": [
                                            "перен., разг. до указанного места"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd280a92-ae34-4e62-a18b-4eba45c808ae",
                        "source_entry_id": "f5db750b-bbc2-3f88-89b7-5e4d84429a0e",
                        "source_sense_id": "ff35df25-200a-37e5-b8d3-32d9d18c75c8",
                        "target_lang_word": "пока что",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пока что",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0d52a6-d823-39bb-9ff3-78e1af0f50b0",
                                        "entry_id": "35165cc9-1995-3949-b076-436a3d0ee0d5",
                                        "glosses": [
                                            "сейчас и в ближайшем будущем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd90589-d1ce-41a8-9a99-95db8d793ae8",
                                                "sense_id": "6d0d52a6-d823-39bb-9ff3-78e1af0f50b0",
                                                "text": "«Располагайтесь пока что. Через два часа будет подан ужин», ― сказал дворецкий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79af6720-ad28-3089-a963-7171f50d2ea0",
                                        "entry_id": "35165cc9-1995-3949-b076-436a3d0ee0d5",
                                        "glosses": [
                                            "до настоящего момента и сейчас (обычно с ожиданием скорого прекращения)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572a8c22-1358-4ff1-ad28-1c6e9c4df178",
                                                "sense_id": "79af6720-ad28-3089-a963-7171f50d2ea0",
                                                "text": "Уяснив это, Путилов берёт под наблюдение одну популярную в Петербурге гадалку, пока что избежавшую участи товарок по ремеслу."
                                            },
                                            {
                                                "example_id": "18130ed8-e8ea-42d2-8b7f-19448e4f2777",
                                                "sense_id": "79af6720-ad28-3089-a963-7171f50d2ea0",
                                                "text": "Хотелось бы напомнить, что попытка сократить количество рекламных поверхностей происходит не впервые, но пока что видимых результатов не приносила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
