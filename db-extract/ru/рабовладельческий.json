                        "translation_id": "baabc885-2b46-4e60-8519-cc56f15eef38",
                        "source_entry_id": "83870c36-0cfc-36a7-b500-e1773edbe136",
                        "target_lang_word": "slaveholding",
                        "target_lang_code": "en",
