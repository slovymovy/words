                    {
                        "translation_id": "e0fd0424-39c4-4453-9f1b-bec80e813d05",
                        "source_entry_id": "6e9b05ab-215a-3653-b54b-bc7912c26f91",
                        "source_sense_id": "c0873f29-5137-3f7f-9999-4c29899e5265",
                        "target_lang_word": "Hirn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hirn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6da7e390-98e8-3473-b577-dcff6a3458c2",
                                        "entry_id": "db858ce6-405a-3246-bf31-ce77dc094fee",
                                        "glosses": [
                                            "Gehirn"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79366f84-2bda-4958-9bcf-e44aa4f53b32",
                                                "sense_id": "6da7e390-98e8-3473-b577-dcff6a3458c2",
                                                "text": "„Japanischen Forschern ist es nun gelungen, in das Hirn von an Parkinson erkrankten Affen Dopamin-Nervenzellen zu transplantieren, die aus embryonalen Stammzellen hervorgegangen sind.“"
                                            },
                                            {
                                                "example_id": "00d43598-d4e1-4cf6-a8bd-ba3874c65106",
                                                "sense_id": "6da7e390-98e8-3473-b577-dcff6a3458c2",
                                                "text": "„Ich spürte, wie mein Hirn langsam warmlief.“"
                                            },
                                            {
                                                "example_id": "d5207fcd-e64e-452a-ade8-7df9b275f132",
                                                "sense_id": "6da7e390-98e8-3473-b577-dcff6a3458c2",
                                                "text": "„Aber von irgendeiner Seite her sah er diesen Knoten doch immer vor sich, auch wenn sein Hirn schon vom Wein umnebelt war, wenn er schwatzte oder dem Geschwätz anderer zuhörte oder nach dem Diner oder Souper wieder bei seiner Lektüre war.“"
                                            },
                                            {
                                                "example_id": "b32b5133-d7f4-440a-9432-b4998ec59be6",
                                                "sense_id": "6da7e390-98e8-3473-b577-dcff6a3458c2",
                                                "text": "„Wir brauchen das Gefühl, Herr oder Frau unseres Hirns zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "077f5e04-1111-3d07-8a74-62cc721ab6c7",
                                        "entry_id": "db858ce6-405a-3246-bf31-ce77dc094fee",
                                        "glosses": [
                                            "Gehirn von Schlachttieren als Lebensmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fb8592-7ddf-4d52-869b-145432716ac4",
                                                "sense_id": "077f5e04-1111-3d07-8a74-62cc721ab6c7",
                                                "text": "„Gebratenes Hirn erinnert geschmacklich an Leber, roh schmeckt es nussartig und hat einen metallischen Nachgeschmack.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "77294e1d-12e9-3e38-8cb9-c0f5b15819c0",
                                        "entry_id": "db858ce6-405a-3246-bf31-ce77dc094fee",
                                        "glosses": [
                                            "Teil des Gesichts zwischen Augenbrauen und Haaransatz; Stirn"
                                        ],
                                        "tags": [
                                            "Bavarian",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b472415-f775-4c93-a938-a2ddd52dc055",
                                                "sense_id": "77294e1d-12e9-3e38-8cb9-c0f5b15819c0",
                                                "text": "In der Nacht vor Resis Hochzeit ist ihr ein riesiger Binkel auf dem Hirn gewachsen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2fd014-07cf-4c32-9272-9e4b718c2317",
                        "source_entry_id": "6e9b05ab-215a-3653-b54b-bc7912c26f91",
