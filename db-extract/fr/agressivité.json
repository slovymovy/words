        "fr-extract.jsonl": [
            {
                "entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
                "word": "agressivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "47a1b74e-519b-48e7-a234-578e42d5fe80",
                        "entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
                        "tags": [
                            "plural"
                        ],
                        "form": "agressivités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12b0b550-2ff3-3f10-b21f-6c52a153fde3",
                        "entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
                        "glosses": [
                            "Caractère agressif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc34623-cab2-4526-86fe-cb7ef394bacc",
                                "sense_id": "12b0b550-2ff3-3f10-b21f-6c52a153fde3",
                                "text": "On avait mis sur le plateau improvisé des chasseurs et des antichasseurs, et les journalistes poussaient les uns et les autres au conflit. Ce que j'ai remarqué alors : l’agressivité n'était pas du côté des chasseurs."
                            },
                            {
                                "example_id": "026d5b8a-e17f-41f3-b573-9c451b6bfb07",
                                "sense_id": "12b0b550-2ff3-3f10-b21f-6c52a153fde3",
                                "text": "Dans nos sociétés modernes, ne faudrait-il pas plus de rabat-joies pour prévenir l’agressivité invisible nichée dans la bonne humeur des “winners” ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a27d227a-6f7d-4107-9ce7-9c8f0144a335",
                        "source_entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
                        "source_sense_id": "12b0b550-2ff3-3f10-b21f-6c52a153fde3",
                        "target_lang_word": "Angriffslust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angriffslust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1d4f82-023b-3846-b3d9-a5814fb49b65",
                                        "entry_id": "59edc75d-b41b-33e3-a01f-8c7dc4c1a0bf",
                                        "glosses": [
                                            "starker Drang/Lust, anzugreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57d78521-bedd-45a7-9b56-5d2fdeff899f",
                                                "sense_id": "1a1d4f82-023b-3846-b3d9-a5814fb49b65",
                                                "text": "„Wenn je ein Urbild für ungestüme Weiblichkeit, Kraft, Angriffslust, Leidenschaft und Selbstbestimmung stand, dann sind es die keltischen Frauen.“"
                                            },
                                            {
                                                "example_id": "7710dd55-1348-4200-899a-9581694660ba",
                                                "sense_id": "1a1d4f82-023b-3846-b3d9-a5814fb49b65",
                                                "text": "„Mit Kim kehrt ein Spieler zurück, der Mitte der Nullerjahre die Golfwelt im Sturm erobert hatte mit einer wilden Mischung aus Talent, Lässigkeit und Angriffslust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c779969e-408c-40bc-9f39-183e64fb9cff",
                        "source_entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
                        "source_sense_id": "12b0b550-2ff3-3f10-b21f-6c52a153fde3",
                        "target_lang_word": "Aggressivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aggressivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                                        "entry_id": "65553fe5-e075-3323-b1e8-bd86498c9728",
                                        "glosses": [
                                            "Bereitschaft, Gewalt oder aggressives Verhalten anzuwenden (Angriffslust)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d2ba43-4d1d-4bee-994a-24e128bc1d6d",
                                                "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                                                "text": "Seine Aggressivität ist wirklich angsteinflößend."
                                            },
                                            {
                                                "example_id": "efe606ba-0b26-4f4f-b713-8f56bbdc0ebf",
                                                "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                                                "text": "„In der Verhaltensbiologie verwendet man den Ausdruck Aggression für Auseinandersetzungen zwischen Artgenossen oder auch zwischen den Vertretern verschiedener Arten; Aggressivität ist die Bereitschaft zur gegnerischen Auseinandersetzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "731cac17-f8fb-4ad5-85f8-e7a8dde18432",
                        "source_entry_id": "cef6c9e5-f735-3923-8a4d-87c101a4d576",
