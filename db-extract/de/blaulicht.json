                                "sense_id": "33778e3a-28e2-38ab-94c3-f34c98c87234",
                                "text": "Mir ist vorhin auf der Autobahn viel Blaulicht entgegengekommen.",
                                "translation": "Earlier on the highway there were a lot of emergency vehicles going the other way.",
                                "english": "Earlier on the highway there were a lot of emergency vehicles going the other way."
                            }
                        ]
