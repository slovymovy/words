                                    },
                                    {
                                        "sense_id": "b442e4ad-da6f-3ef6-b7bd-fbb17ba5c989",
                                        "entry_id": "41695a95-dcbb-33a3-a916-9147e9bf31e4",
                                        "glosses": [
                                            "A heterodox belief, creed, or teaching."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b3a7e44-572b-4a92-a93b-a0acd9089d0d",
                                                "sense_id": "b442e4ad-da6f-3ef6-b7bd-fbb17ba5c989",
                                                "text": "A genuine first-hand religious experience like this is bound to be a heterodoxy to its witnesses, the prophet appearing as a mere lonely madman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c42d841-18eb-494a-8ce5-6be5045aa9b8",
