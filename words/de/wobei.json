            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "87a0a1fd-3dc1-3ab9-8466-5cf47ccfc06a",
                    "sense_definition": "leitet eine Frage oder einen Relativsatz ein und fragt nach oder bezieht sich auf eine Sache oder Angelegenheit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interrogativ_relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wobei</w> brauchst du denn genau meine Hilfe?"
                        },
                        {
                            "text": "Das ist eine Aufgabe, <w>wobei</w> man sich wirklich gut konzentrieren muss."
                        }
                    ],
                    "common_phrases": [
                        "wobei helfen"
                    ]
                },
                {
                    "sense_id": "419cca82-df0a-3e28-ac87-1e4cf8c3cfc6",
                    "sense_definition": "leitet einen Nebensatz ein, der ein gleichzeitiges Geschehen oder einen begleitenden Umstand zu einer Haupthandlung beschreibt",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "begleitumstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Auto prallte gegen einen Baum, <w>wobei</w> der Fahrer glücklicherweise unverletzt blieb."
                        },
                        {
                            "text": "Sie las ein spannendes Buch, <w>wobei</w> sie völlig die Zeit um sich herum vergaß."
                        }
                    ],
                    "synonyms": []
                },
                {
                    "sense_id": "f39007e0-e857-3a19-be5f-93a3ea8e585c",
                    "sense_definition": "drückt eine einschränkende Bemerkung, Erläuterung oder Relativierung zu einer vorherigen Aussage aus",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "einschraenkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir können uns gerne treffen, <w>wobei</w> ich allerdings erst abends Zeit habe."
                        },
                        {
                            "text": "<w>Wobei</w> man ehrlich sagen muss, dass dieser Plan nicht ohne jedes Risiko ist."
                        }
                    ],
                    "synonyms": [
                        "aber",
                        "allerdings"
                    ],
                    "common_phrases": [
                        "wobei man sagen muss"
                    ]
                }
            ]
        }
