{
    "word_family": [
        "tidal",
        "tidally",
        "tideless",
        "tideway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0f1532e-9c68-329d-8da3-26b454a7e1d3",
                    "sense_definition": "The regular rise and fall of the sea level caused by the gravitational pull of the moon and the sun.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tide</w> comes in and goes out twice a day.",
                            "target_lang_translations": {
                                "ru": "<w>Прилив</w> наступает и отступает дважды в день.",
                                "pl": "<w>Przypływ</w> i odpływ występują dwa razy dziennie."
                            }
                        },
                        {
                            "text": "We decided to walk along the beach at low <w>tide</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили прогуляться по пляжу во время <w>отлива</w>.",
                                "pl": "Zdecydowaliśmy się na spacer wzdłuż plaży podczas <w>odpływu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high tide",
                        "low tide",
                        "rising tide",
                        "turn the tide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярное повышение и понижение уровня моря, вызванное гравитационным притяжением Луны и Солнца.",
                        "pl": "Cykliczne podnoszenie i opadanie poziomu morza spowodowane przyciąganiem grawitacyjnym Księżyca i Słońca."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "поднятие уровня воды"
                            },
                            {
                                "target_lang_word": "отлив",
                                "target_lang_sense_clarification": "падение уровня воды"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pływ",
                                "target_lang_sense_clarification": "ogólne zjawisko zmiany poziomu wody"
                            },
                            {
                                "target_lang_word": "przypływ",
                                "target_lang_sense_clarification": "podniesienie się poziomu wody"
                            },
                            {
                                "target_lang_word": "odpływ",
                                "target_lang_sense_clarification": "obniżenie się poziomu wody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e84653-32ec-393d-a88f-6e5f7d172435",
                    "sense_definition": "The direction or trend of events, public opinion, or emotions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tide</w> of public opinion has turned against the government.",
                            "target_lang_translations": {
                                "ru": "<w>Волна</w> общественного мнения обернулась против правительства.",
                                "pl": "<w>Fala</w> opinii publicznej odwróciła się przeciwko rządowi."
                            }
                        },
                        {
                            "text": "They struggled to swim against the <w>tide</w> of popular culture.",
                            "target_lang_translations": {
                                "ru": "Они изо всех сил пытались плыть против <w>течения</w> популярной культуры.",
                                "pl": "Zmagali się, by płynąć pod <w>prąd</w> kultury popularnej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tide of opinion",
                        "stem the tide",
                        "go with the tide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направление или тенденция развития событий, общественного мнения или эмоций.",
                        "pl": "Kierunek lub tendencja w rozwoju wydarzeń, opinii publicznej lub emocji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "ход событий или направление мыслей"
                            },
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "нарастающее движение или чувство"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nurt",
                                "target_lang_sense_clarification": "kierunek rozwoju wydarzeń lub myśli"
                            },
                            {
                                "target_lang_word": "fala",
                                "target_lang_sense_clarification": "narastające zjawisko społeczne lub emocjonalne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27408a9f-b3bc-3c14-8b61-a533b5e6953f",
                    "sense_definition": "A large amount of something that moves or increases like a flood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>tide</w> of refugees crossed the border seeking safety.",
                            "target_lang_translations": {
                                "ru": "<w>Поток</w> беженцев пересек границу в поисках безопасности.",
                                "pl": "<w>Fala</w> uchodźców przekroczyła granicę w poszukiwaniu bezpieczeństwa."
                            }
                        },
                        {
                            "text": "The hospital faced a sudden <w>tide</w> of patients during the flu season.",
                            "target_lang_translations": {
                                "ru": "Больница столкнулась с внезапным <w>наплывом</w> пациентов в сезон гриппа.",
                                "pl": "Szpital stanął w obliczu nagłego <w>napływu</w> pacjentów w sezonie grypowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "influx",
                        "inflow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество чего-либо, что движется или увеличивается подобно наводнению.",
                        "pl": "Duża ilość czegoś, co przemieszcza się lub narasta niczym powódź."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "непрерывное движение множества объектов"
                            },
                            {
                                "target_lang_word": "наплыв",
                                "target_lang_sense_clarification": "резкое увеличение количества"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "napływ",
                                "target_lang_sense_clarification": "gwałtowne pojawienie się dużej liczby osób lub rzeczy"
                            },
                            {
                                "target_lang_word": "fala",
                                "target_lang_sense_clarification": "masowe zjawisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a023be-dbd4-340a-9764-8243d0e715aa",
                    "sense_definition": "A specific time, season, or anniversary, often used in historical or poetic contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers celebrated the holy <w>tide</w> with a great feast.",
                            "target_lang_translations": {
                                "ru": "Жители деревни праздновали священное <w>время</w> большим пиром.",
                                "pl": "Mieszkańcy wioski świętowali tę uroczystą <w>porę</w> wielką ucztą."
                            }
                        },
                        {
                            "text": "He arrived at eventide, just as the evening <w>tide</w> began.",
                            "target_lang_translations": {
                                "ru": "Он прибыл к вечеру, как раз когда начиналась вечерняя <w>пора</w>.",
                                "pl": "Przybył o zmierzchu, właśnie gdy zaczynała się wieczorna <w>pora</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in compounds like Yuletide or eventide"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное время, сезон или годовщина (часто используется в исторических или поэтических контекстах).",
                        "pl": "Określony czas, pora roku lub święto, często używane w kontekście historycznym lub poetyckim."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "период или пора"
                            },
                            {
                                "target_lang_word": "пора",
                                "target_lang_sense_clarification": "сезон или отрезок времени"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pora",
                                "target_lang_sense_clarification": "okres czasu"
                            },
                            {
                                "target_lang_word": "czas",
                                "target_lang_sense_clarification": "okres lub moment"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec8538a2-7576-3156-b9ff-82840f452e49",
                    "sense_definition": "To help someone survive a difficult period, especially by providing money or support.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This small loan should <w>tide</w> you over until you find a new job.",
                            "target_lang_translations": {
                                "ru": "Этот небольшой заем должен <w>поддержать</w> тебя, пока ты не найдешь новую работу.",
                                "pl": "Ta niewielka pożyczka powinna cię <w>wesprzeć</w>, dopóki nie znajdziesz nowej pracy."
                            }
                        },
                        {
                            "text": "We ate a snack to <w>tide</w> us over until dinner was ready.",
                            "target_lang_translations": {
                                "ru": "Мы перекусили, чтобы <w>продержаться</w> до ужина.",
                                "pl": "Zjedliśmy przekąskę, żeby <w>przetrwać</w> do kolacji."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tide over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помочь кому-либо пережить трудный период, особенно предоставив деньги или поддержку.",
                        "pl": "Pomóc komuś przetrwać trudny okres, zwłaszcza poprzez wsparcie finansowe lub pomoc doraźną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддержать",
                                "target_lang_sense_clarification": "оказать помощь в трудную минуту"
                            },
                            {
                                "target_lang_word": "выручить",
                                "target_lang_sense_clarification": "помочь выйти из затруднительного положения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wesprzeć",
                                "target_lang_sense_clarification": "udzielić pomocy w trudnej sytuacji"
                            },
                            {
                                "target_lang_word": "podratować",
                                "target_lang_sense_clarification": "pomóc przetrwać kryzys"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0ae17b9-7e29-3661-9ecd-133aae3c201d",
                    "sense_definition": "To float or drift with the current of the water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat <w>tided</w> down the river without using its engine.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка <w>плыла по течению</w> реки, не используя двигатель.",
                                "pl": "Mała łódź <w>płynęła</w> z prądem rzeki bez użycia silnika."
                            }
                        },
                        {
                            "text": "They <w>tided</w> into the harbor as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Они <w>заплыли</w> в гавань вместе с приливом, когда солнце начало садиться.",
                                "pl": "Wpłynęli do portu z <w>przypływem</w>, gdy słońce zaczęło zachodzić."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плыть или дрейфовать по течению воды.",
                        "pl": "Płynąć lub dryfować zgodnie z prądem wody."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плыть по течению",
                                "target_lang_sense_clarification": "двигаться вместе с потоком воды"
                            },
                            {
                                "target_lang_word": "дрейфовать",
                                "target_lang_sense_clarification": "перемещаться под действием внешних сил"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "płynąć z prądem",
                                "target_lang_sense_clarification": "przemieszczać się zgodnie z ruchem wody"
                            },
                            {
                                "target_lang_word": "dryfować",
                                "target_lang_sense_clarification": "przemieszczać się pod wpływem prądu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1ac718d-0855-32ef-86a9-707a8d20543c",
                    "sense_definition": "To happen or occur to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whatever may <w>tide</w>, I will remain by your side.",
                            "target_lang_translations": {
                                "ru": "Что бы ни <w>случилось</w>, я останусь на твоей стороне.",
                                "pl": "Cokolwiek się <w>stanie</w>, pozostanę u twego boku."
                            }
                        },
                        {
                            "text": "Woe <w>tide</w> the person who ignores the warning signs.",
                            "target_lang_translations": {
                                "ru": "Горе <w>постигнет</w> того, кто игнорирует предупреждающие знаки.",
                                "pl": "Biada temu, kogo <w>spotka</w> kara za ignorowanie znaków ostrzegawczych."
                            }
                        }
                    ],
                    "synonyms": [
                        "betide",
                        "befall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случаться или происходить с кем-либо.",
                        "pl": "Wydarzyć się lub przydarzyć komuś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "происходить (о событиях)"
                            },
                            {
                                "target_lang_word": "постигать",
                                "target_lang_sense_clarification": "настигать (о беде или участи)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zdarzyć się",
                                "target_lang_sense_clarification": "mieć miejsce"
                            },
                            {
                                "target_lang_word": "spotkać",
                                "target_lang_sense_clarification": "dotyczyć kogoś (o losie)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}