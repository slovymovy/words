                ],
                "senses": [
                    {
                        "sense_id": "baee3870-dfb6-3638-8677-d9430a749986",
                        "entry_id": "327d7d8b-ee0c-304b-b661-c24fc2792729",
                        "glosses": [
                            "Homme qui change continuellement de manières, d’opinions, qui joue toutes sortes de rôles."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd828c1-4db5-42c7-b94f-02a6a324e40f",
                                "sense_id": "baee3870-dfb6-3638-8677-d9430a749986",
                                "text": "Et derrière, LE ROI, l’homme protée, le surhomme, qui pensa, s’il ne le dit point: “Il suffit de le vouloir pour avoir le temps de tout”."
                            },
                            {
                                "example_id": "7a4788f5-73ab-40ba-a80a-25236180641d",
                                "sense_id": "baee3870-dfb6-3638-8677-d9430a749986",
                                "text": "Cet homme est un vrai protée."
                            }
                        ]
                    },
                    {
                        "sense_id": "06ff60a3-1e44-3bc6-aaf3-69801ab934d2",
                        "entry_id": "327d7d8b-ee0c-304b-b661-c24fc2792729",
                        "glosses": [
                            "Amphibien urodèle cavernicole à branchies persistantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46664abb-2b25-49eb-b1d8-d74be9e060d9",
                                "sense_id": "06ff60a3-1e44-3bc6-aaf3-69801ab934d2",
                                "text": "Dans l’obscurité des cavernes, les protées sont blancs ; exposés à la lumière, ils se couvrent de taches brunes ou noires."
                            }
                        ]
                    },
                    {
                        "sense_id": "3426b1dc-f737-3422-af6c-6e6a7dc511b1",
                        "entry_id": "327d7d8b-ee0c-304b-b661-c24fc2792729",
                        "glosses": [
                            "Papillon de la famille des Lycaenidae, aussi appelé « azuré des mouillères »."
