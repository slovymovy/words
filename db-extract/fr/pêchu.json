                    {
                        "translation_id": "cffbe770-ad42-4b3d-b40d-964dd32a7f5d",
                        "source_entry_id": "d573484a-b605-35e1-8b1b-cbc46462752c",
                        "source_sense_id": "ba09b20d-7f56-3654-b175-7b412827a5f6",
                        "source_sense_description": "umgangssprachlich: dynamisch, fit, topfit, energiegeladen, beschwingt, mitreißend, spritzig",
                        "target_lang_word": "spritzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spritzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "993cbd59-b474-3077-9b09-2ce70c8889f3",
                                        "entry_id": "e3e93286-764f-362a-b9e0-bd934f50e4d3",
                                        "glosses": [
                                            "prickelnd, anregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7cd173-4cd0-41ba-a6b3-32d2b767467e",
                                                "sense_id": "993cbd59-b474-3077-9b09-2ce70c8889f3",
                                                "text": "„Der Wein war kühl, spritzig und voller Blume. ›Saarwein,‹ dachte er, ›Maximin Grünhäuser‹. Er sah auf das Etikett, freute sich, daß er richtig geschätzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "facd37dd-2304-32d9-9d91-0deb05a12f5b",
                                        "entry_id": "e3e93286-764f-362a-b9e0-bd934f50e4d3",
                                        "glosses": [
                                            "schwungvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63509709-eb64-41f9-8cb1-38644427d771",
                                                "sense_id": "facd37dd-2304-32d9-9d91-0deb05a12f5b",
                                                "text": "„»Also, sehn Se, ich hab mir das so gedacht –: wir machen eine Revue, verstehn Se, also eine Revue, so was hat Berlin überhaupt noch nicht gesehn! Scharf, verstehn Sie mich, witzig, spritzig – also es ist ja gar kein Zweifel ….«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82af84ca-81d1-3818-897b-bddb21b36bc5",
