                "senses": [
                    {
                        "sense_id": "4c3404b9-fdea-3054-bac7-4512da2312ad",
                        "entry_id": "b1e5a6d3-4574-39b6-8aeb-93de284b46a8",
                        "glosses": [
                            "Qui reçoit des appointements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8c2721-6f5d-4401-b24f-fa29f772b366",
                                "sense_id": "4c3404b9-fdea-3054-bac7-4512da2312ad",
                                "text": "L'architecte appointé exerce sa profession totalement ou partiellement dans les liens d’un contrat d’emploi au service d’une personne physique ou morale. Il ne peut exercer sa profession en qualité d’indépendant qu’avec l’accord de son employeur et moyennant l’autorisation préalable du conseil de l’Ordre…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7039bad9-26b5-3df3-ac63-c1b2c8a3d7ec",
                        "entry_id": "b1e5a6d3-4574-39b6-8aeb-93de284b46a8",
                        "glosses": [
                            "Placé pointe contre pointe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93171313-fb02-4a93-81fb-0cb6c153a1e5",
                                "sense_id": "7039bad9-26b5-3df3-ac63-c1b2c8a3d7ec",
                                "text": "D'argent à trois lions léopardés de gueules regardants, armés et et lampassés d’azur, posés l’un sur l’autre. / De gueules, au pal de vair appointé et renversé."
                            },
                            {
                                "example_id": "8118d566-bebf-447b-8423-7ea887428a84",
                                "sense_id": "7039bad9-26b5-3df3-ac63-c1b2c8a3d7ec",
                                "text": "J'ai vu un fonctionnaire qui était appointé... complètement désappointé!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d18e6287-6334-3be3-95f2-d0b19ed8e3ba",
                        "entry_id": "b1e5a6d3-4574-39b6-8aeb-93de284b46a8",
                        "glosses": [
                            "Qualifiait un procès à juger sur rapport."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a82dbc40-16ca-46df-b8cf-7ce65d2cfdd4",
                                "sense_id": "d18e6287-6334-3be3-95f2-d0b19ed8e3ba",
                                "text": "Ces instances étoient jointes, & le procès appointé en droit le 28 Juin 1777, lorsque le sieur Darcet, un des quarante, fit signifier à l’Exposant un acte par lequel ces Particuliers l’avoient nommé Syndic."
                            }
                        ]
                    },
                    {
                        "sense_id": "941a46a0-fa5c-3d71-8e5e-003e06978593",
                        "entry_id": "b1e5a6d3-4574-39b6-8aeb-93de284b46a8",
                        "glosses": [
                            "Taillé en pointe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6728df0-94d1-4215-a093-cd8297b12aa2",
                                "sense_id": "941a46a0-fa5c-3d71-8e5e-003e06978593",
                                "text": "Piquet fraisé appointé et chanfreiné: 6.50 €"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c6a6674-fc71-38a9-9d3d-0f56a968b269",
                        "entry_id": "b1e5a6d3-4574-39b6-8aeb-93de284b46a8",
                        "glosses": [
                            "Vif, affûté, aiguisé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "52dd7f9b-5de1-4a8c-a1f0-305c7c4fc54e",
                                "sense_id": "0c6a6674-fc71-38a9-9d3d-0f56a968b269",
                                "text": "Il me venait parfois de ces tentations-là avec elle, pour me venger de son esprit, plus précocement appointé et moqueur que le mien."
                            }
                        ]
                    }
