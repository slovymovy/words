                                        "entry_id": "52892ac8-7afa-3be9-a08d-d64ee7936487",
                                        "glosses": [
                                            "A series of boat races, or sometimes a single race."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa9ac72-afcf-46cd-a87e-2ac95d628653",
                                                "sense_id": "2c2171ac-7615-3552-81a4-0c3cf787e3fe",
                                                "text": "[…] many people living along the harbour front had boathouses and boats of their own, for regattas and water sports were one of Victoria's chief attractions."
                                            },
                                            {
                                                "example_id": "66cf3ec4-6338-44f6-9e45-cd244fcd038e",
                                                "sense_id": "2c2171ac-7615-3552-81a4-0c3cf787e3fe",
                                                "text": "The novice eights race demonstrated one of the reasons UVa manages to be so good year after year; the UVa novs finished first and second in the event, while Clemson's novice crew, the surprise of the regatta, took third."
                                            }
                                        ]
