                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd00d084-c34a-4feb-89ed-1ddc43cf5943",
                        "source_entry_id": "409fb187-6ec3-31b1-a481-b8de99cc31ff",
                        "source_sense_id": "b70fc5f5-4a13-3009-97b7-21985cae487d",
                        "target_lang_word": "personification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A person, thing or name typifying a certain quality or idea; an embodiment or exemplification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1688a5c0-8aa1-4e7b-b1ae-e6869779f355",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "Adolf Hitler was the personification of anti-Semitism."
                                            },
                                            {
                                                "example_id": "41d88554-d9b9-46bc-9aed-53309f6c53fb",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "He might have sat for a personification of fear: if he moved, he seemed rather afraid of his own shadow following him too closely; if he laughed, he soon checked himself, quite alarmed at the sound."
                                            },
                                            {
                                                "example_id": "4fa256ba-c9b9-447e-8bda-6eacb7666477",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "De Coude was the personification of coolness—was he not the best shot in France?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A literary device in which an inanimate object or an idea is given human qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261f660c-c3b9-4669-8b3e-f55079e01faf",
                                                "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                                "text": "The writer used personification to convey her ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "An artistic representation of an abstract quality as a human"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c6de46-4d09-475e-a82f-9e63dfe8bc6e",
                                                "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                                "text": "The Grim Reaper is a personification of death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3f842aa-3630-48f9-94d1-3b12c9f22fdf",
                        "source_entry_id": "409fb187-6ec3-31b1-a481-b8de99cc31ff",
                        "source_sense_id": "b70fc5f5-4a13-3009-97b7-21985cae487d",
                        "target_lang_word": "personnification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personnification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc010fb2-ef25-361d-8aec-3a2cf5e96d67",
                                        "entry_id": "5cc47997-4484-3874-ac4e-6af76b2de0c9",
                                        "glosses": [
                                            "Action de personnifier, consistant à faire d’un être inanimé ou d’une abstraction un personnage réel."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f29cb86-6eae-40db-ad76-9ae3a62563e3",
                                                "sense_id": "fc010fb2-ef25-361d-8aec-3a2cf5e96d67",
                                                "text": "On dit par personnification : être dans les bras de la mort, du sommeil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                        "entry_id": "5cc47997-4484-3874-ac4e-6af76b2de0c9",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130320d1-59b9-4f76-a382-95f4381acc6c",
                                                "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                                "text": "Les Grecs vivaient au grand air. […], et bien qu'ils eussent élevé au rang des déesses la personnification du Foyer, ils se trouvaient bien partout, excepté chez eux."
                                            },
                                            {
                                                "example_id": "efd1ebdd-7fb5-4270-a9a2-ff3c0e0cb987",
                                                "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                                "text": "[…] ; ces derniers chevaux, placés à côté des coursiers d’Orient, auraient pu passer pour la personnification de la matière, et les autres pour celle de l’ombre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71047284-e2a2-4164-bf85-590cd2b3702d",
