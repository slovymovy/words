                                        "sense_id": "186f77ff-e47e-3ef6-a3af-fd0ddf37f950",
                                        "entry_id": "936d6f07-1d76-3708-8652-c6c397912615",
                                        "glosses": [
                                            "een onbemand onderzoekstoestel dat buiten de aarde wordt gebracht"
                                        ],
                                        "tags": [
                                            "ruimtevaart"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c42be6f2-72eb-4190-a8f2-542fcc1236c6",
                                                "sense_id": "186f77ff-e47e-3ef6-a3af-fd0ddf37f950",
                                                "text": "Aangezien een ruimtesonde altijd de baansnelheid van de aarde meekrijgt, beweegt hij in principe ook in hetzelfde baanvlak als de aarde."
                                            },
                                            {
                                                "example_id": "d4885bc1-b2ab-441f-ae74-630994cccae4",
                                                "sense_id": "186f77ff-e47e-3ef6-a3af-fd0ddf37f950",
                                                "text": "Komeet Halley is bovendien ook nog een geval apart: hij beweegt tegen de normale omlooprichting van de planeten in, zodat de ruimtesonde en de komeet met een enorme snelheid vrijwel recht op elkaar af zullen vliegen."
                                            }
                                        ]
