                ],
                "senses": [
                    {
                        "sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
                        "entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                        "glosses": [
                            "woning zonder bovenverdieping"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7baf8d69-ce87-4e5c-8eac-df9c1bc789f3",
                                "sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
                                "text": "“We komen de meest gekke dingen tegen. Zo had iemand in een gelijkvloerse bungalow een traplift opgevoerd. Anderen vragen hypotheekrenteaftrek aan, terwijl ze in een huurhuis wonen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1a7e03-154e-3748-9ecb-1975eec755dc",
                        "entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                        "glosses": [
                            "vakantiewoning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fc66dd-57f4-4329-800d-8729a7bd573a",
                                "sense_id": "4b1a7e03-154e-3748-9ecb-1975eec755dc",
                                "text": "Met de vakantie zitten we in een bungalow in de Ardennen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f46434d-8f91-4dc4-a7b1-4288bc572e1b",
                        "source_entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                        "source_sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
                        "source_sense_description": "woning of vakantiehuis zonder bovenverdieping",
                        "target_lang_word": "Bungalow",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bungalow",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                        "entry_id": "f50a7000-d8d3-3e22-bddb-be9825a586e0",
                                        "glosses": [
                                            "eingeschossiges Haus in leichter Bauweise, oft mit flachem Dach, für Wohnzwecke (teilweise als Sommerhaus) oder andere Nutzungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1578c8ff-8386-457b-88f8-6f2ccc0c2b6a",
                                                "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                                "text": "Wir wohnen in einem schicken Bungalow."
                                            },
                                            {
                                                "example_id": "401a9196-3b1b-4a82-a1dd-ba084d2e42d6",
                                                "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                                "text": "„Sie fuhren zuerst ein oder zwei Meilen an Villen, Bungalows und Wirtshäusern vorbei in eine Ortschaft, wo jedes Haus eine Garage oder eine Tankstation zu sein schien.“"
                                            },
                                            {
                                                "example_id": "8b0df233-187c-4411-b766-464f2d3709c1",
                                                "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                                "text": "„Er verläßt unmittelbar nach seiner Ankunft den Bungalow, den die Dietrich ihm in ihrer Nachbarschaft gemietet hat, und bezieht ein neues Haus.“"
                                            },
                                            {
                                                "example_id": "38f60a28-01c7-408e-ad63-fe38bb4256f0",
                                                "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                                "text": "„Auch sei ein alter Garagenkomplex zu barrierefreien Bungalows umgebaut worden, die nun für den Tourismus genutzt werden.“"
                                            },
                                            {
                                                "example_id": "96fd4a4d-00d5-4fc6-931e-8f0fac3cced8",
                                                "sense_id": "d0108c6b-86c7-3404-b975-4745391e01f1",
                                                "text": "„Stefan wohnte in einem Bungalow in einer Anlage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c4fad01-1037-3069-bab2-5f3e4a720cee",
                                        "entry_id": "f50a7000-d8d3-3e22-bddb-be9825a586e0",
                                        "glosses": [
                                            "leichtes, eingeschossiges Wohnhaus in tropischen oder subtropischen Regionen Asiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "161b34af-563b-4184-9515-6524db4a29b9",
                                                "sense_id": "6c4fad01-1037-3069-bab2-5f3e4a720cee",
                                                "text": "„Dies ist die Geschichte der Schlacht, die Rikki-Tikki-Tavi schlug, ganz allein, in dem Badezimmer des großen Bungalows in der Militärstation Segowli. Darsie, der Webervogel, half ihm, und Tschutschandra, die Moschusratte, die an Platzangst leidet und deshalb immer an den Wänden entlangkriecht, gab ihm guten Rat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3b986118-c0ee-3271-80d8-7883f89b9c02",
                                        "entry_id": "f50a7000-d8d3-3e22-bddb-be9825a586e0",
                                        "glosses": [
                                            "kleines Wochenendhaus auf dem Land, in einem Garten oder in der Natur"
                                        ],
                                        "tags": [
                                            "bes.",
                                            "DDR"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac2c1a8-82d2-40ba-bd12-e837837347c8",
                                                "sense_id": "3b986118-c0ee-3271-80d8-7883f89b9c02",
                                                "text": "„Stefan wohnte in einem Bungalow in einer Anlage.“"
                                            },
                                            {
                                                "example_id": "a7998d51-f3c1-43c9-8038-938781b8d08e",
                                                "sense_id": "3b986118-c0ee-3271-80d8-7883f89b9c02",
                                                "text": "Wir wollen ein Gartengrundstück mit Bungalow und Swimmingpool kaufen."
                                            },
                                            {
                                                "example_id": "45256dac-99dd-4bc7-a532-8ce551f3283d",
                                                "sense_id": "3b986118-c0ee-3271-80d8-7883f89b9c02",
                                                "text": "„Direkt daneben entstanden ein Campingplatz und eine Feriensiedlung mit Bungalows.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4cc5da9-cb0f-4e8f-b805-a83662184fd9",
                        "source_entry_id": "9d6de24d-41a8-3604-a8d8-775ff5f8200a",
                        "source_sense_id": "d8086315-70f0-335f-abf0-d0491f3c8e3a",
