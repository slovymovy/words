                        ]
                    },
                    {
                        "translation_id": "aebb8f75-5fa9-4cc8-9dbc-0a830cc3ea1d",
                        "source_entry_id": "7cc2395f-17bc-32d0-b299-7de311a49b87",
                        "source_sense_id": "623230ba-b2b3-3969-a332-f52d1e6d344a",
                        "target_lang_word": "torticolis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torticolis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97d0b9c3-ba69-30cf-a5a9-1d9271feaa5b",
                                        "entry_id": "adc5bc2c-56be-3023-95cb-a503e9344398",
                                        "glosses": [
                                            "Contracture du cou, qui fait qu’on ne peut le tourner sans douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd433f8-3d55-4666-8936-4d3c5d7b2fe6",
                                                "sense_id": "97d0b9c3-ba69-30cf-a5a9-1d9271feaa5b",
                                                "text": "Oui, dans le commencement cela donne le torticolis à force de regarder"
                                            },
                                            {
                                                "example_id": "6ec8a4d9-8674-461d-a16c-959f871a7df1",
                                                "sense_id": "97d0b9c3-ba69-30cf-a5a9-1d9271feaa5b",
                                                "text": "Je crois que j’ai un torticolis, reprenait languissamment la blonde Suzanne. Non, vrai, si ça avait duré une minute de plus, j’aurais remis ma tête d’une façon naturelle, tant j’avais mal au cou."
                                            },
                                            {
                                                "example_id": "85957722-2ec3-4e19-82fd-9b932d8c0878",
                                                "sense_id": "97d0b9c3-ba69-30cf-a5a9-1d9271feaa5b",
                                                "text": "Il n’y avait que la maîtresse qui ne riait pas.\n– Tu ne me feras jamais croire, m’a-t-elle dit, que « torticolis » est, pour toi, le plus beau mot de la langue française !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
