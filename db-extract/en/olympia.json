                            {
                                "example_id": "bdfd5f75-de8c-4941-b617-a8f2774b8ba9",
                                "sense_id": "41f1e229-05c4-36f8-8f6d-eb40d94f71a2",
                                "text": "The Olympia City Council voted 4-3 Tuesday night against adopting a Workers’ Bill of Rights and raising the minimum wage across the city to $20. Mayor Dontae Payne cast the deciding vote."
                            },
                            {
                                "example_id": "1d54ed15-fc11-4419-bba7-f5d7290f0047",
                                "sense_id": "41f1e229-05c4-36f8-8f6d-eb40d94f71a2",
                                "text": "The Olympian has posted similar stories on the Port of Olympia, Olympia City Council, and Olympia School Board primaries elsewhere on our website."
                            }
                        ]
