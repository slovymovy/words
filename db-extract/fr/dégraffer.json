                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711026de-846b-4710-800f-46eec467e34f",
                                "sense_id": "ba7d1cb0-6b3b-3152-b7ee-90c559f2f9e1",
                                "text": "Ils dégraffèrent mon pantalon, baissèrent mon slip et m'accrochèrent les électrodes de chaque côté de l'aine."
                            },
                            {
                                "example_id": "bc5b90aa-2da3-48dc-90d1-7450193ffe4a",
                                "sense_id": "ba7d1cb0-6b3b-3152-b7ee-90c559f2f9e1",
                                "text": "Cela fait, il considéra les deux hommes et la jeune femme en se frottant les mains, puis il s’occupa de Marinier, dégraffant son col et l’aspergeant copieusement."
                            }
                        ]
                    }
