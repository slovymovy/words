                    },
                    {
                        "form_id": "a34e1d18-d475-46ca-9821-73ca899de3fd",
                        "entry_id": "b843f129-d7e1-32c8-8aa2-46ecf3d5da30",
                        "tags": [],
                        "form": "sénestrochère"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e0a176f-5d66-374d-b0e9-fd927208530b",
                        "entry_id": "b843f129-d7e1-32c8-8aa2-46ecf3d5da30",
                        "glosses": [
                            "Meuble représentant dans les armoiries un bras gauche nu ou habillé, tenant une arme ou tout autre objet. À rapprocher de bras, dextrochère et main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b213c1e4-dcfd-4519-9f47-a1c615b0e5ce",
                                "sense_id": "1e0a176f-5d66-374d-b0e9-fd927208530b",
                                "text": "D’azur au senestrochère d’or mouvant du flanc dextre, tenant une clef contournée d’argent en pal, qui est de la commune de Saint-Pierre du Bas-Rhin → voir illustration « armoiries avec un senestrochère »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5549217e-8d78-4cd8-bb86-dcfd6ace9dd6",
                        "source_entry_id": "b843f129-d7e1-32c8-8aa2-46ecf3d5da30",
                        "source_sense_id": "1e0a176f-5d66-374d-b0e9-fd927208530b",
                        "target_lang_word": "sinister",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c024cbf-41f7-39ac-9b3c-caab8d325e36",
                                        "entry_id": "b7477663-18d4-337d-a171-f1260089d588",
                                        "glosses": [
                                            "Inauspicious, ominous, unlucky, illegitimate (as in bar sinister)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6868df3e-c5c8-4ca1-a4ac-8c5cce011d07",
                                                "sense_id": "5c024cbf-41f7-39ac-9b3c-caab8d325e36",
                                                "text": "All the several ills that visit earth,\nBrought forth by night, with a sinister birth."
                                            },
                                            {
                                                "example_id": "9ccf116a-54bb-4cf8-8838-af3ec9530947",
                                                "sense_id": "5c024cbf-41f7-39ac-9b3c-caab8d325e36",
                                                "text": "And in the meanwhile, Society shivered a little feverishly, filled now with the scions of those who had come over with the Jewish and American Conquests. Escutcheons were becoming valueless, how sinister soever the blots and clots upon them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946712c4-570a-34cb-87c1-056ad4a1db30",
                                        "entry_id": "b7477663-18d4-337d-a171-f1260089d588",
                                        "glosses": [
                                            "Evil or seemingly evil; indicating lurking danger or harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0829c7b4-d61f-43ba-98b5-3bfc15e3150a",
                                                "sense_id": "946712c4-570a-34cb-87c1-056ad4a1db30",
                                                "text": "sinister influences"
                                            },
                                            {
                                                "example_id": "1d0f20e7-0a5c-46d2-b23b-20dd92a74201",
                                                "sense_id": "946712c4-570a-34cb-87c1-056ad4a1db30",
                                                "text": "the sinister atmosphere of the crypt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1507f4-6305-368c-81d9-039455a26603",
                                        "entry_id": "b7477663-18d4-337d-a171-f1260089d588",
                                        "glosses": [
                                            "Of the left side."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25208e86-9b67-4578-ab37-d7f2d9a011ac",
                                                "sense_id": "5e1507f4-6305-368c-81d9-039455a26603",
                                                "text": "my Mothers bloud\nRuns on the dexter checke, and this ſiniſter\nBounds in my fathers:"
                                            },
                                            {
                                                "example_id": "1f526cd4-6565-49d4-851d-515e6827f09b",
                                                "sense_id": "5e1507f4-6305-368c-81d9-039455a26603",
                                                "text": "His ſicatrice, with an Embleme of warre, heere on his ſiniſter cheeke;"
                                            },
                                            {
                                                "example_id": "a9091727-5ee8-4aa6-8c9b-647f86c66758",
                                                "sense_id": "5e1507f4-6305-368c-81d9-039455a26603",
                                                "text": "Before the train had stopped he had decorated his sinister shirt-cuff with the inscription, ‘J. P. Huddle, The Warren, Tilfield, near Slowborough.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175f9395-bf93-3a96-ad3d-91b2a235c15f",
                                        "entry_id": "b7477663-18d4-337d-a171-f1260089d588",
                                        "glosses": [
                                            "On the left side of a shield from the wearer's standpoint, and the right side to the viewer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b2581f-ee69-4316-a096-fd3344b7c027",
                                                "sense_id": "175f9395-bf93-3a96-ad3d-91b2a235c15f",
                                                "text": "The shield was divided into five, with two coats of arms on the dexter side (the right-hand side from the point of view of the bearer of the shield)—London and Southampton—and three on the sinister side—Salisbury, Winchester and Portsmouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee21855-0b45-39be-9f40-0cc2f38995e8",
                                        "entry_id": "b7477663-18d4-337d-a171-f1260089d588",
                                        "glosses": [
                                            "Wrong, as springing from indirection or obliquity; perverse; dishonest."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "317ef092-4301-49d5-8726-fbdf1be45e67",
                                                "sense_id": "1ee21855-0b45-39be-9f40-0cc2f38995e8",
                                                "text": "Nimble and sinister tricks and shifts."
                                            },
                                            {
                                                "example_id": "4ea2d5e6-87a9-4caf-9cde-9d60dec938e4",
                                                "sense_id": "1ee21855-0b45-39be-9f40-0cc2f38995e8",
                                                "text": "He scorns to undermine another's interest by any sinister or inferior arts."
                                            },
                                            {
                                                "example_id": "09aaeacc-53a9-4d0e-88e8-3faf53fe98ec",
                                                "sense_id": "1ee21855-0b45-39be-9f40-0cc2f38995e8",
                                                "text": "He read in their looks […] sinister intentions directed particularly toward himself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
