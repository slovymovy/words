                        "entry_id": "880fe391-752a-327e-b1f7-62335fef5241",
                        "glosses": [
                            "A mixture composed of different materials; especially:",
                            "A mixture of different sorts of grain, such as wheat and rye."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac7b5e00-1444-47c2-a94a-9a3c5ab9ad9f",
                                "sense_id": "a556b142-056f-3a38-b581-8eed6a22ad1a",
                                "text": "Now for this fallow field it must euer be made where the yéere before you did reape your Pease, in case you haue but thrée fields, or where you did reape your Wheate, Rye, and Maslin, in case you haue foure fields, according to the manner of the blacke clay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
