                ],
                "senses": [
                    {
                        "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                        "entry_id": "c14e88bf-b65e-30d3-a020-90395f162249",
                        "glosses": [
                            "Spielfeld für das Fußballspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e009be47-c72e-4f7a-a392-a0d64b80a1c0",
                                "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                                "text": "„Das ist gewöhnungsbedürftig und in den ersten Spielen stolpert man unsicher über das riesige Fußballfeld dem Ball hinterher.“"
                            },
                            {
                                "example_id": "662589f3-aecd-406b-ab71-34178cfeb8eb",
                                "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                                "text": "„Die sozialistische Partei Georgiens will auf dem Fußballfeld eine Annäherung an Russland erreichen.“"
                            },
                            {
                                "example_id": "3ff201aa-3de2-43c8-be65-56b2cced6f40",
                                "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                                "text": "„Der Verlust tropischer Wälder bleibt unverändert hoch. Im vergangenen Jahr ist jede Minute eine Fläche so groß wie zehn Fußballfelder verlorengegangen.“"
                            },
                            {
                                "example_id": "496866b7-bd89-4d55-9551-5ab60c6696af",
                                "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                                "text": "„Pro Sekunde gehen weltweit vier Fußballfelder fruchtbarer Boden verloren – durch Dürre, Erosion und Bodenversiegelung.“"
                            },
                            {
                                "example_id": "3034ebe9-23ee-44c1-bad8-f454b2ecd27a",
                                "sense_id": "67d1301e-e397-3494-abce-ca7f7b977fc4",
                                "text": "„Diese subterranen Magazinräume kommen in etwa auf eine Fläche von einem Fußballfeld, verteilt auf drei bis vier Stockwerke mit einer gigantischen Raumhöhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
