                                                "sense_id": "946ab3d8-ad03-39d6-9d65-19b15cf20f17",
                                                "text": "parte la bonifica per l'amianto alla scuola materna comunale di via Garibaldi"
                                            },
                                            {
                                                "example_id": "c3ea4439-adb6-4604-a025-fdffa8ae9162",
                                                "sense_id": "946ab3d8-ad03-39d6-9d65-19b15cf20f17",
