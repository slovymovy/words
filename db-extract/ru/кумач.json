                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837a148c-2357-43bb-bdf4-b84dbc295936",
                                "sense_id": "533b2b23-304b-3083-bb2d-5d004f459d3d",
                                "text": "Беру́т с собо́ю одну́ ба́бу, то́лстую и румя́ную. Она́ в кумача́х, в ки́чке с би́сером, на нога́х коты́, щёлкает оре́шки и посме́ивается.",
                                "translation": "They hauled in a fat, rosy-cheeked woman. She was dressed in red cotton, in a pointed, beaded headdress and thick leather shoes; she was cracking nuts and laughing.",
                                "english": "They hauled in a fat, rosy-cheeked woman. She was dressed in red cotton, in a pointed, beaded headdress and thick leather shoes; she was cracking nuts and laughing."
                            }
                        ]
                    }
