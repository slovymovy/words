                        "entry_id": "396659f1-46f7-3d06-a859-092fda40515f",
                        "glosses": [
                            "weibliche Person, welche neben einer anderen, auf einer Sitzgelegenheit für mehrere Personen oder an einem Tisch für mehrere Personen, sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c44fcb-de25-42f0-894b-0de393c8716f",
                                "sense_id": "d04fc228-79f5-3d1d-a348-aaf88b6cee79",
                                "text": "Meine Banknachbarin hat mich immer genervt."
                            },
                            {
                                "example_id": "91d5264a-9370-4266-afba-eb33b000d526",
                                "sense_id": "d04fc228-79f5-3d1d-a348-aaf88b6cee79",
                                "text": "„Stell dir vor, du kommst nach den Ferien zurück in die Schule, triffst alle deine Freunde wieder, hast aber eine neue Banknachbarin.“"
                            }
                        ],
