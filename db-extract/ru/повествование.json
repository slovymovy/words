                    },
                    {
                        "form_id": "7b8877d0-79c7-4376-86a4-f5603ad3c683",
                        "entry_id": "37acb4c6-5ba8-3b0f-81df-8dbc9278499c",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "повествова́ниях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58226e69-f646-31e1-9c09-727695739a6b",
                        "entry_id": "37acb4c6-5ba8-3b0f-81df-8dbc9278499c",
                        "glosses": [
                            "действие по значению гл. повествовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8eeff50-0043-40ed-a1d1-a980003f2250",
                                "sense_id": "58226e69-f646-31e1-9c09-727695739a6b",
                                "text": "Ольга Федотовна, доходя в своих рассказах до этого события, всегда впадала в какой-то смешанный трагикомический тон повествования."
                            },
                            {
                                "example_id": "c21f3f1f-a6f2-45d7-be6f-f8cd6ec4261f",
                                "sense_id": "58226e69-f646-31e1-9c09-727695739a6b",
                                "text": "Желая, по возможности, передать живость изустного повествования, я везде говорю прямо от лица рассказчика."
                            }
                        ]
                    },
                    {
                        "sense_id": "d31e76b4-aee2-34cf-bfd6-f67e25396753",
                        "entry_id": "37acb4c6-5ba8-3b0f-81df-8dbc9278499c",
                        "glosses": [
                            "связный рассказ о ком-либо, о каком-либо событии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80112fc-2344-4c76-b873-edc52154e5f0",
                                "sense_id": "d31e76b4-aee2-34cf-bfd6-f67e25396753",
                                "text": "Теперь приведу рассказ очевидца, генерала фон Клугена в таком виде, как это повествование осталось в моей памяти."
                            },
                            {
                                "example_id": "f1c81b8b-1a43-4ee1-8263-da01ba79fd2a",
                                "sense_id": "d31e76b4-aee2-34cf-bfd6-f67e25396753",
                                "text": "Пишу оттого не подробно, что в должность спешу, ибо старанием и рачением хочу загладить все вины мои в упущении по службе; дальнейшее же повествование о всех происшествиях и о приключении с офицерами откладываю до вечера."
                            },
                            {
                                "example_id": "f4509b25-c82a-4a32-a0fd-dddf9e2fd8dc",
                                "sense_id": "d31e76b4-aee2-34cf-bfd6-f67e25396753",
                                "text": "— Ну что, далеко уже прочитали моё немудрое повествование?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "127ad00a-abfa-4215-96d0-bc5196f48853",
                        "source_entry_id": "37acb4c6-5ba8-3b0f-81df-8dbc9278499c",
                        "target_lang_word": "narration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae21b3f7-0390-338e-9893-af49ebaebe76",
                                        "entry_id": "74df3aff-30cd-32ab-b4c7-f14b39d49ea2",
                                        "glosses": [
                                            "The act of recounting or relating in order the particulars of some action, occurrence, or affair; a narrating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e79e86b-30d8-4866-a7e3-3bdbc17f3f7d",
                                                "sense_id": "ae21b3f7-0390-338e-9893-af49ebaebe76",
                                                "text": "The film used voice-over narration to explain the story."
                                            },
                                            {
                                                "example_id": "7d9078ef-2faf-4ea4-af15-8ee5ac0e6a21",
                                                "sense_id": "ae21b3f7-0390-338e-9893-af49ebaebe76",
                                                "text": "His calm narration made the documentary easy to follow."
                                            },
                                            {
                                                "example_id": "1124d218-d375-446a-89e8-2564734cba03",
                                                "sense_id": "ae21b3f7-0390-338e-9893-af49ebaebe76",
                                                "text": "The novel contains a first-person narration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae6f1f9-9146-3101-b2ca-ca5343101ff7",
                                        "entry_id": "74df3aff-30cd-32ab-b4c7-f14b39d49ea2",
                                        "glosses": [
                                            "That which is narrated or recounted; an orderly recital of the details and particulars of some transaction or event, or of a series of transactions or events; a story or narrative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9a288c0-6f04-36ba-968c-027a0b014bac",
                                        "entry_id": "74df3aff-30cd-32ab-b4c7-f14b39d49ea2",
                                        "glosses": [
                                            "That part of an oration in which the speaker makes his or her statement of facts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81c103ed-bc50-493b-8d94-ca385a517ebb",
                        "source_entry_id": "37acb4c6-5ba8-3b0f-81df-8dbc9278499c",
                        "target_lang_word": "narrative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6a8814-3c0a-365f-8c88-00e02894862e",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Telling a story."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abf29dfb-e2df-3be8-8134-0338aa8311e8",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Overly talkative; garrulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3b0442-2560-4909-b002-fd2c6b35a111",
                                                "sense_id": "abf29dfb-e2df-3be8-8134-0338aa8311e8",
                                                "text": "But wise through time, and narrative with age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Of or relating to narration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92333510-3cf8-409d-a1c8-885bb831602f",
                                                "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                                "text": "the narrative thrust of a film"
                                            },
                                            {
                                                "example_id": "d18ba8b8-75c7-43f4-8f85-4c77d47462dc",
                                                "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                                "text": "There is a deep divide in our species. On one side, the narrators: those who are indeed intensely narrative, self-storying, Homeric, in their sense of life and self, whether they look to the past or the future."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "narrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333a554f-4d81-375c-a322-b2d7ffa1601f",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "The systematic recitation of an event or series of events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41d0467a-55df-3912-bde8-e6eb50f3ec7c",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "That which is narrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "A representation of an event or story in a way to promote a certain point of view."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0fe70a3-e8aa-4921-a641-5d6f2d60d8eb",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "changing, controlling the narrative"
                                            },
                                            {
                                                "example_id": "49471677-8a6b-4958-b870-94ccfa580ccc",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "Yes, there were instances of grandstanding and obsessive behaviour, but many were concealed at the time to help protect an aggressively peddled narrative of [Oscar] Pistorius the paragon, the emblem, the trailblazer."
                                            },
                                            {
                                                "example_id": "b1a2d8f1-0ae0-4aed-9c2b-78810711ce1d",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "[Alexandra] Bell challenges the dominant coverage of Brown’s killing with the aim of introducing “a perspective and a narrative which is probably how a lot of people from these communities saw it go down”."
                                            },
                                            {
                                                "example_id": "7bf5206c-aac5-4970-b93b-b16763831926",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "The posters quickly became embroiled in the interminable battle over narrative in the Israel-Palestine conflict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "A manner of conveying a story, fictional or otherwise, in a body of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a884eb-0f29-4067-8c01-8b91a2227490",
                                                "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                                "text": "The plot is full of holes, but the narrative is extremely compelling."
                                            },
                                            {
                                                "example_id": "e0765b27-76c5-4f1b-a39c-4fd60ffbc702",
                                                "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                                "text": "The player is free to create their own narrative within a much larger set of possible designed narrative options, or, given the geographic and dialogical openness of Morrowind, to refuse the creation of any narrative but their own and wander aimlessly through the game."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
