                "senses": [
                    {
                        "sense_id": "9aad34fa-55c0-3a2c-a3dc-27d0a95d5f7a",
                        "entry_id": "d47e752b-d21e-31eb-90db-170956e242eb",
                        "glosses": [
                            "Femme apôtre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4836dd28-4caa-4f99-9e67-4932ed49a245",
                                "sense_id": "9aad34fa-55c0-3a2c-a3dc-27d0a95d5f7a",
                                "text": "La figure de Madeleine occupe dans les œuvres poétiques et romanesques composées par des femmes pendant le xviiᵉ siècle une place privilégiée liée à la dévotion inspirée par la sainte pécheresse. Certains livres à tendances plus « féministes » en font même une « Apôtresse » égale aux Apôtres et même capable de leur en remontrer dans la transmission du message de la Résurrection."
                            },
                            {
                                "example_id": "c51d2b58-c35f-4479-aa81-f2ef3c636c8c",
                                "sense_id": "9aad34fa-55c0-3a2c-a3dc-27d0a95d5f7a",
                                "text": "Détruise les dénominations ou abandonnez-les, sortez du milieu d’eux : « Église de ceci ; ministère de ceci cela ; apôtresse de ceci cela. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb17a9cc-16cb-4a44-802a-d2026a66a89c",
                        "source_entry_id": "d47e752b-d21e-31eb-90db-170956e242eb",
                        "source_sense_id": "9aad34fa-55c0-3a2c-a3dc-27d0a95d5f7a",
                        "target_lang_word": "Apostelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apostelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                                        "entry_id": "cd11aa4f-de3f-3638-8c79-4f086714e419",
                                        "glosses": [
                                            "herausragende Glaubensverkünderin der Urkirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a20f46f-19c5-453f-bae2-4951502b6710",
                                                "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                                                "text": "„Wie wirksam die Ausschließung von Frauen ist, zeigt sich am Beispiel der Apostelin Junia.“"
                                            },
                                            {
                                                "example_id": "f455a301-f7c1-4f92-83ac-f34e11ec431b",
                                                "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                                                "text": "„Bei solchen Texten lassen sich fließende Übergänge in die hagiographische Literatur sehen, besonders reichhaltig bei jenen Texten, in denen die Mutter Maria bzw. die Apostelin Thekla im Mittelpunkt stehen..“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0957d112-f8a8-3a54-8165-8d40d6790d49",
                                        "entry_id": "cd11aa4f-de3f-3638-8c79-4f086714e419",
                                        "glosses": [
                                            "engagierte Vertreterin einer bestimmten Lehre"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297a32b1-fb73-4dd2-b423-0aa6b9a6ef84",
                                                "sense_id": "0957d112-f8a8-3a54-8165-8d40d6790d49",
                                                "text": "Da schwingt sich eine zur Apostelin auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
