        "fr-extract.jsonl": [
            {
                "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                "word": "attribution",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f72818e2-4640-4b76-ab28-9abb0cf95dac",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "tags": [
                            "plural"
                        ],
                        "form": "attributions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66d25555-bf8c-3ac8-b1fe-9011baa3fa58",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "glosses": [
                            "Action d’attribuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88734e0a-4c8e-4a40-9559-6f0197abeda7",
                                "sense_id": "66d25555-bf8c-3ac8-b1fe-9011baa3fa58",
                                "text": "Il n’ignorait pas les malpropretés auxquelles donne souvent lieu l’attribution de la Légion d’honneur à des industriels, à des commerçants, à des financiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b5b9df-812d-36fd-a643-017a410bd536",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "glosses": [
                            "Action d’attribuer.",
                            "Fait d’attribuer un marché à l’un des candidats d’une procédure de passation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbcd7a7-d727-4fa6-b3f8-19a0fd61b9d1",
                                "sense_id": "89b5b9df-812d-36fd-a643-017a410bd536",
                                "text": "Le monde du spatial a été surpris par la défaite d’EADS-Astrium dans l’attribution des 14 satellites du système Galiléo, remportée par l’allemand OHB."
                            },
                            {
                                "example_id": "6a9ccf95-571c-4b49-8e8b-5868142e1e14",
                                "sense_id": "89b5b9df-812d-36fd-a643-017a410bd536",
                                "text": "Mais l’IA, c’est aussi un moyen de procéder à l’attribution d’un contrat de la commande publique."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdadd09a-8a2b-31fb-aa15-f3ddf5302069",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "glosses": [
                            "Action d’attribuer.",
                            "Action d’attribuer à un sujet, une cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12023178-d6b3-47b0-9d52-ce9c63eab9cb",
                                "sense_id": "bdadd09a-8a2b-31fb-aa15-f3ddf5302069",
                                "text": "Le complément d’attribution désigne la personne ou la chose intéressée à l’action que fait le sujet."
                            },
                            {
                                "example_id": "e871f290-8ac8-478e-911e-4070166901eb",
                                "sense_id": "bdadd09a-8a2b-31fb-aa15-f3ddf5302069",
                                "text": "Dans : « Il a donné un sou à un pauvre », « Mourir pour la patrie », Pauvre, Patrie sont des compléments d’attribution."
                            }
                        ]
                    },
                    {
                        "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "glosses": [
                            "Droits que possède une personne chargée de quelque fonction ou qui sont attachés à la fonction elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2be459-816a-473d-9cd4-bf49064e5467",
                                "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                                "text": "Lettres d’attribution, pouvoir que le roi donnait à des commissaires ou à une juridiction subalterne pour juger une affaire en dernier ressort."
                            },
                            {
                                "example_id": "ebe8ca60-b10f-4626-a24e-4650ae251068",
                                "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                                "text": "Édit d’attribution de droits, édit par lequel une prérogative, un privilège étaient concédés en vertu de lettres du Prince."
                            },
                            {
                                "example_id": "65c26c3b-9536-4f91-8204-89050ad9f86e",
                                "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                                "text": "Ces personnes ont craint, en pénétrant trop avant dans le système de l'homme, de voir disparaître ses plus brillantes attributions."
                            },
                            {
                                "example_id": "d3e41488-3ce7-4e7d-9c88-cf651dd7696b",
                                "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                                "text": "Cela est dans les attributions du Tribunal de Commerce, mais cela n’est pas, n’entre pas dans les attributions du ministre du Commerce ou du Préfet."
                            },
                            {
                                "example_id": "277ceebf-1027-486c-bf33-bdf9724c47ad",
                                "sense_id": "80bf7bcd-5a73-3a42-bb5d-907123577d3d",
                                "text": "Vous savez que j’ai les attributions de magistrat mais, en l’occurrence, j’aurais autant aimé qu’un autre s’occupât de l’affaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a9180d5-0146-3da6-b8db-e7a46e78fdb4",
                        "entry_id": "e318aea5-eb25-37a8-8878-1b806fee1493",
                        "glosses": [
                            "Processus consistant à expliquer les comportements d’autrui ou ses propres comportements en les rattachant à des causes internes (traits, intentions) ou externes (contexte, situation)."
                        ],
                        "tags": [
                            "Psychologie sociale",
                            "Psychologie cognitive"
                        ],
                        "examples": []
                    }
                ],
