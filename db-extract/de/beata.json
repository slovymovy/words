                            {
                                "example_id": "3a2b00d7-1b3c-4767-a44c-461426a5221a",
                                "sense_id": "def1ac72-9c45-3d34-b3a2-1ecfa69de76b",
                                "text": "Es war immer Beatas Wunsch, das Reiten zu lernen."
                            }
