                "senses": [
                    {
                        "sense_id": "90992bc8-0f17-324e-adfd-be7b9a016cf1",
                        "entry_id": "e4c2e13e-66a1-3bc1-8172-cb30d74afc4c",
                        "glosses": [
                            "Explorer les parois de la vessie et de l’urètre par cystographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a4c9bd-8364-46e5-9648-1d51c1393243",
                                "sense_id": "90992bc8-0f17-324e-adfd-be7b9a016cf1",
                                "text": "Je le fis radiographier et cystographier."
                            },
                            {
                                "example_id": "1b815a1c-aea6-42ee-bf5d-798b040fe369",
                                "sense_id": "90992bc8-0f17-324e-adfd-be7b9a016cf1",
                                "text": "Notre méthode présentée au Congrès International du Caire en 1928, d’hydrocystographier et de cystographier dans la même séance et dans le même film (après l’injection d'une solution de BrNa dans la vessie tout de suite après l’hydrocystogramme), est basée sur l’expérience suivante […]"
                            },
                            {
                                "example_id": "b7409aa4-87b1-42a7-8de2-1fdff8464476",
                                "sense_id": "90992bc8-0f17-324e-adfd-be7b9a016cf1",
                                "text": "Elle veut me radiographier, me coronarographier, m’échographier, m’urographier, me cystographier, me fibroscopier, me cartographier (ha, ha !)…"
                            }
                        ]
                    }
