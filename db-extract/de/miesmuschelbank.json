                "senses": [
                    {
                        "sense_id": "dda9830b-9853-3378-866d-c72dcefe301f",
                        "entry_id": "23559c5d-51c7-3042-b891-d0d224817ae8",
                        "glosses": [
                            "große Menge von (festliegenden) lebenden Miesmuscheln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388d017e-6c0c-4e6e-a9e3-9252a3702b6e",
                                "sense_id": "dda9830b-9853-3378-866d-c72dcefe301f",
                                "text": "„Künstliche Miesmuschelbänke und Austernfarmen sind vor allem von der französischen Atlantikküste bekannt.“"
                            },
                            {
                                "example_id": "dbddce01-4f05-4b7b-b8df-5224325914ad",
                                "sense_id": "dda9830b-9853-3378-866d-c72dcefe301f",
                                "text": "„Wenige Kilometer südlich der Insel Juist liegt eine große Miesmuschelbank.“"
                            },
                            {
                                "example_id": "cbe80746-df40-4fe5-b685-dcbde1f50b02",
                                "sense_id": "dda9830b-9853-3378-866d-c72dcefe301f",
                                "text": "„Auf den Miesmuschelbänken, die sich im Gezeitenbereich befinden, findet man fast keine Seesterne, da sie von den Möwen wie der Silbermöwe gefressen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
