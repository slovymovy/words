                    },
                    {
                        "translation_id": "98862daa-efc9-48e1-9b92-d54e3e1399aa",
                        "source_entry_id": "fba19c72-dac1-3510-8d86-4d9c16895e04",
                        "source_sense_id": "ace87150-0b21-3cb7-aa9a-33a334c08b74",
