                    {
                        "form_id": "e19bd3ca-ec3f-41c0-8796-1dfe9b530b05",
                        "entry_id": "efb38364-0ffa-3043-a222-f882b2003b23",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sonderausschüsse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                        "entry_id": "efb38364-0ffa-3043-a222-f882b2003b23",
                        "glosses": [
                            "Gremium aus einer Gruppe von Personen aus einem Parlament, das für die Bearbeitung besondere Aufgaben/Themen gebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ed2d1c-5036-4814-8f11-ab651f519d4c",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Für besondere Aufgaben kann der Landtag Sonderausschüsse bilden.“"
                            },
                            {
                                "example_id": "a1ed5b6e-2910-4928-9c2e-bf139db99d7c",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Was war am 22. Mrz. 1917? – Ein Sonderausschuss der russischen Provisorischen Regierung nimmt die Gesetzesvorlage über die vollständige Abstinenz in Russland an. Alkoholdestillen sollen zu Zuckerraffinerien umgebaut werden.“"
                            },
                            {
                                "example_id": "af5db4e2-83c5-456c-989c-88863070b291",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Was war am 30. Okt. 1968? – Der Sonderausschuss des Bundestages für die Strafrechtsreform beschließt in Berlin (West) einstimmig, den Paragraphen über die Bestrafung des Ehebruchs ersatzlos zu streichen.“"
                            },
                            {
                                "example_id": "8e17486a-f2c3-4528-b9ec-2b5ae87d8585",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Zum Thema Finanzkriminalität hat das Europaparlament einen Sonderausschuss eingesetzt.“"
                            },
                            {
                                "example_id": "f7e97183-99ce-4c46-8e27-11a73fbca2e0",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "Im Grunde sind sich alle einig: Beim Vorgehen gegen Terroristen arbeiten die EU-Staaten nicht gut genug zusammen. Deshalb stimmt das EU-Parlament heute über den Einsatz eines Sonderausschusses zum Thema Terrorismus ab."
                            },
                            {
                                "example_id": "9d589789-8267-4e7b-b858-3c6ba8ef6a2f",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Was war am 27. Feb. 1958? – Der im Oktober 1956 vom Bundestag eingesetzte Sonderausschuss Radioaktivität stellt in einem ersten Bericht eine beständige Zunahme der Radioaktivität aufgrund von Atomwaffenversuchen fest.“"
                            },
                            {
                                "example_id": "63d0c464-88c9-4b8c-b2e5-1aeecd7707b6",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "[G20-Gipfel 2017 in Hamburg:] „Warum kam es in Hamburg zu derart massiven Ausschreitungen? Ein Sonderausschuss befasst sich mit der Frage.“"
                            },
                            {
                                "example_id": "4b299833-73f7-44a3-a4cf-4032a2d3edb5",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Ein Sonderausschuss des Senats war am vergangenen Freitag zusammengekommen, um das Thema zu diskutieren.“"
                            },
                            {
                                "example_id": "3465d4ae-2947-4e62-a59d-735e0016456d",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Ein Sonderausschuss des Europaparlaments soll Versuche ausländischer Cyber-Einflussnahme aufdecken und bekämpfen.“"
                            },
                            {
                                "example_id": "4d9f3643-be5a-4ea0-ad04-d711cbf40ea1",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Der Sonderausschuss soll nun Kompetenzen aus verschiedenen Fachbereichen wie der Außenpolitik, der Justiz und der Medienpolitik bündeln.“"
                            },
                            {
                                "example_id": "beda8aa8-7927-4562-97e0-b8bfb53f4e2b",
                                "sense_id": "026adcfa-1a6c-3219-b680-5aebe22109a1",
                                "text": "„Zuvor hatte Merkel die erste Sitzung des Sonderausschusses des Bundeskabinetts zu den Folgen des angestrebten EU-Austritts Großbritanniens geleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
