        "fr-extract.jsonl": [
            {
                "entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                "word": "contemplation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e9e09f4b-5934-477b-81cb-f8ad06630644",
                        "entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "tags": [
                            "plural"
                        ],
                        "form": "contemplations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09062905-f881-3b10-a098-10fe9f97fac2",
                        "entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "glosses": [
                            "Action de contempler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ab5250-461f-4b8b-824a-d9bf9b6244ca",
                                "sense_id": "09062905-f881-3b10-a098-10fe9f97fac2",
                                "text": "Mrs. Paulina Barnett, dans un perpétuel ravissement, assistait à ce spectacle nouveau pour elle. De quelles souffrances, de quelles fatigues, son âme de voyageuse n'eût-elle pas payé la contemplation de telles choses !"
                            },
                            {
                                "example_id": "7caadb24-aa8e-426b-b0ee-fb7090c966c1",
                                "sense_id": "09062905-f881-3b10-a098-10fe9f97fac2",
                                "text": "Cependant la contemplation des phénomènes célestes soulève peut-être, à côté du sentiment de l'admiration, des pensées moins réellement religieuses."
                            },
                            {
                                "example_id": "e7912f3b-81d9-4d13-beae-21e74a6d0001",
                                "sense_id": "09062905-f881-3b10-a098-10fe9f97fac2",
                                "text": "La contemplation permet de ressentir l'amour dans son état le plus pur, un amour désintéressé, gratuit et transcendant."
                            }
                        ]
                    },
                    {
                        "sense_id": "097d7a15-6547-3db3-aef2-659890ff0afb",
                        "entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "glosses": [
                            "Profonde application de l’esprit à quelque objet, surtout aux objets purement intellectuels ou religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f4709c-2292-44cd-9b66-17e2b6d16c82",
                                "sense_id": "097d7a15-6547-3db3-aef2-659890ff0afb",
                                "text": "Quant à Othon, […] il était tombé dans une contemplation muette et profonde à la vue de la jeune princesse Héléna."
                            },
                            {
                                "example_id": "d8594f17-a7a6-442b-ad6e-81de6afea312",
                                "sense_id": "097d7a15-6547-3db3-aef2-659890ff0afb",
                                "text": "Et il était tellement absorbé par cette contemplation, – hypnotisé, diraient les gens qui n’aiment pas à parler comme tout le monde, – qu’il avait oublié de rengainer le portefeuille où il venait de puiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "d68dc379-174c-3c51-b8e0-6b78f478570f",
                        "entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "glosses": [
                            "Habitude de l’esprit qui porte à la méditation, à la rêverie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f21a717-b5a8-4f3a-a96c-99f361021f1b",
                                "sense_id": "d68dc379-174c-3c51-b8e0-6b78f478570f",
                                "text": "Le goût de la solitude et de la contemplation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fea0fb1-c530-48ff-998b-399320bbd599",
                        "source_entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "target_lang_word": "Kontemplation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontemplation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02c84812-80d0-3764-8cfc-187a34295f90",
                                        "entry_id": "f264283f-1442-348b-9ab6-535d2bd56ff9",
                                        "glosses": [
                                            "Rückzug auf sich selbst, Versenkung in sich selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d8d9c3-56db-433f-af08-37505c8613fd",
                                                "sense_id": "02c84812-80d0-3764-8cfc-187a34295f90",
                                                "text": "Kontemplation kann man auch in der Natur erleben."
                                            },
                                            {
                                                "example_id": "b28ecfcf-ad02-4483-9905-2b46688fea12",
                                                "sense_id": "02c84812-80d0-3764-8cfc-187a34295f90",
                                                "text": "Kontemplation ist nicht so sehr am Ergebnis orientiert, am besten, man betreibt sie um ihrer selbst willen."
                                            },
                                            {
                                                "example_id": "88d372a4-6cc5-4352-a7e1-a9efeb687928",
                                                "sense_id": "02c84812-80d0-3764-8cfc-187a34295f90",
                                                "text": "„Diese Beschreibung der klaren Kontemplation – die aller Kunst zugrundeliegt – ist selbst so klar, dass man ihren absolut bahnbrechenden Charakter beinahe vergessen könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21c01940-2083-332a-9c38-78ee8235ae4b",
                                        "entry_id": "f264283f-1442-348b-9ab6-535d2bd56ff9",
                                        "glosses": [
                                            "Versenkung in Gott und seine Werke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6d5945-5e32-4140-aba3-ab95896c993f",
                                                "sense_id": "21c01940-2083-332a-9c38-78ee8235ae4b",
                                                "text": "Zur Kontemplation kann man sich in ein Gotteshaus zurückziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3df7980e-3ac1-4cf4-9edc-7e0ae2fb1ec9",
                        "source_entry_id": "43443acf-06ea-3fb5-a093-aca924518c8b",
                        "target_lang_word": "contemplation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemplation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7ef1f2-d07c-3f45-8d85-508ddf64d260",
                                        "entry_id": "49e29ba7-0694-364f-a75c-ef0a85864350",
                                        "glosses": [
                                            "The act of contemplating; musing; being highly concentrated in thought"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde53517-e232-428b-a4ae-57b8b242d80d",
                                                "sense_id": "6d7ef1f2-d07c-3f45-8d85-508ddf64d260",
                                                "text": "Now, 80 percent is accessible — quickly filling with exhibition spaces, stylish restaurants and cafes, bookstores, and highly profitable gift stores, as well as quiet walkways, shady stands of trees and odd nooks that invite contemplation of bygone dynasties."
                                            },
                                            {
                                                "example_id": "be91b795-2d1d-4eef-a612-d47b6d0b90ac",
                                                "sense_id": "6d7ef1f2-d07c-3f45-8d85-508ddf64d260",
                                                "text": "Mr. Pickwick congratulated the fortunate owner of the irresistible garments on their acquisition; and Mr. Peter Magnus remained a few moments apparently absorbed in contemplation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c738c9c6-2b7c-3a45-847c-8465e87de28c",
                                        "entry_id": "49e29ba7-0694-364f-a75c-ef0a85864350",
                                        "glosses": [
                                            "Holy meditation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc5c01e-0b15-4de9-8852-3cd3c05949b5",
                                                "sense_id": "c738c9c6-2b7c-3a45-847c-8465e87de28c",
                                                "text": "Whilst he roamed about with his flocks, through ice and snow, communion with his God in prayer, and quiet contemplation, were his portion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4f4f629-6c31-392a-94d1-6dd7980a0c1a",
                                        "entry_id": "49e29ba7-0694-364f-a75c-ef0a85864350",
                                        "glosses": [
                                            "The act of looking forward to a future event"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c377dd41-902f-3307-95ed-5c0d0b3467dc",
                                        "entry_id": "49e29ba7-0694-364f-a75c-ef0a85864350",
                                        "glosses": [
                                            "The state of being considered or planned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed5c219-dfc2-431f-8b89-9ff3cd7b4b26",
                                                "sense_id": "c377dd41-902f-3307-95ed-5c0d0b3467dc",
                                                "text": "He concludes: \"This letter is written in contemplation of legal proceedings, and is a pre-action protocol letter within the meaning of the Civil Procedure Rules 1998.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
