                        "glosses": [
                            "Extérieur aux ministères, qui ne relève pas des ministères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612bc20d-c2f1-4ae1-b5d5-942308ee4620",
                                "sense_id": "5ba64015-36c4-3049-a984-a0f86d172861",
                                "text": "Il doit surtout compter sur des forces extraministérielles et extraparlementaires, sur des personnes issues d’horizons idéologiques différents, notamment de gauche."
                            },
                            {
                                "example_id": "160cf384-c1d4-4d29-8767-a2503fbf6657",
                                "sense_id": "5ba64015-36c4-3049-a984-a0f86d172861",
                                "text": "Ces influences extraministérielles, je dirai tout de suite où elles étaient : elles étaient derrière le rideau entourant assidûment le président de la République, conservant sur son esprit une déplorable et désastreuse influence."
                            }
                        ]
                    }
