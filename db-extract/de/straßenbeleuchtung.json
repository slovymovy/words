                "senses": [
                    {
                        "sense_id": "ff39bd31-846e-3e38-8324-c61758c4d5b4",
                        "entry_id": "56c3fde4-952a-3ef2-8854-ded98b3d833e",
                        "glosses": [
                            "Beleuchtung/Erhellung einer Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ede134-f6fb-4b76-b6bb-c155e8d0152f",
                                "sense_id": "ff39bd31-846e-3e38-8324-c61758c4d5b4",
                                "text": "„Zwischen der katholischen Kirche und dem Rathaus ist als Straßenbeleuchtung eine sogenannte Kohlenbogenleuchte sichtbar.“"
                            },
                            {
                                "example_id": "605ab752-0528-42a2-828e-774e7f694783",
                                "sense_id": "ff39bd31-846e-3e38-8324-c61758c4d5b4",
                                "text": "„Die Straßenbeleuchtung hier ist schlecht, obwohl das eine moderne Stadt ist.“"
                            },
                            {
                                "example_id": "8c3f8c52-a170-4610-b479-57cce67d5438",
                                "sense_id": "ff39bd31-846e-3e38-8324-c61758c4d5b4",
                                "text": "„Genau in dem Moment, in dem wir hinaustreten, schaltet sich die Straßenbeleuchtung ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
