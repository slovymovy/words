                                    {
                                        "sense_id": "20b5ba0f-5900-3eab-9ece-3cb602869b15",
                                        "entry_id": "7de40d0b-ccea-340c-8c74-2161d568bbcc",
                                        "glosses": [
                                            "Put into a package."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d67a055-1327-410d-976c-daa6832e6fb0",
                                                "sense_id": "20b5ba0f-5900-3eab-9ece-3cb602869b15",
                                                "text": "packed lunch"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d00cd078-253a-3bd1-b6d0-a733ec562b23",
                                        "entry_id": "7de40d0b-ccea-340c-8c74-2161d568bbcc",
                                        "glosses": [
                                            "Filled with a large number or large quantity of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5b23c5-3e0c-4fa0-a79d-f2b488404a32",
                                                "sense_id": "d00cd078-253a-3bd1-b6d0-a733ec562b23",
                                                "text": "packed with goodness"
                                            },
                                            {
                                                "example_id": "bdd0bb4f-175d-45b9-b8f9-4d6972a9a9fd",
                                                "sense_id": "d00cd078-253a-3bd1-b6d0-a733ec562b23",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "9d5d0d01-58af-429b-9829-fdf2eb38f1b1",
                                                "sense_id": "d00cd078-253a-3bd1-b6d0-a733ec562b23",
                                                "text": "A packed schedule of 13 different inquiries ranged from parking on pavements to filling potholes, plus a hard-hitting examination of the Government's proposed Airports National Policy Statement and its recommendation to grant approval for a third runway to be built at Heathrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7de2ac2c-6ee4-327f-9923-b3994515cd1a",
                                        "entry_id": "7de40d0b-ccea-340c-8c74-2161d568bbcc",
                                        "glosses": [
                                            "Filled to capacity with people."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad268fc1-bbce-4686-85fc-5c4604a43cdc",
                                                "sense_id": "7de2ac2c-6ee4-327f-9923-b3994515cd1a",
                                                "text": "The bus was packed and I couldn't get on."
                                            },
                                            {
                                                "example_id": "ffbb06b9-5d95-42d2-b381-dced8e5ef3e5",
                                                "sense_id": "7de2ac2c-6ee4-327f-9923-b3994515cd1a",
                                                "text": "On a steamy summer late afternoon the Luzhniki was once again packed. It is a vast space, with a roof that almost closes in on itself capturing the air like a superheated bubble."
                                            },
                                            {
                                                "example_id": "514545f7-5362-4b48-bfd7-9b8441f5fe71",
                                                "sense_id": "7de2ac2c-6ee4-327f-9923-b3994515cd1a",
                                                "text": "We picked up returning Millwall supporters at New Street, together with a couple of British Transport Police officers, and the train, an 11-car set, was now packed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
