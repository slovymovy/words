                "senses": [
                    {
                        "sense_id": "6dce8a0c-358c-3c5a-9dfb-d31b5039c163",
                        "entry_id": "3f586b39-a725-3b95-bf7d-9371b5bcfeea",
                        "glosses": [
                            "Donner un caractère homo à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d07b39-7879-4895-8790-c07ba6db1987",
                                "sense_id": "6dce8a0c-358c-3c5a-9dfb-d31b5039c163",
                                "text": "En France, l'école souffre de rumeurs qui la présente comme un complot pour « féminiser » (ou « homoïser ») les petits garçons."
                            },
                            {
                                "example_id": "23f4bbc6-7c82-4a9c-8393-cfb76c253724",
                                "sense_id": "6dce8a0c-358c-3c5a-9dfb-d31b5039c163",
                                "text": "Il y a quelques années j'étais un pro pour repérer les gays parmi les hétéros mais ces dernières années les looks d'hétéro s'homoïsent (oui je crée des mots et alors, il faut bien enrichir la langue) et celui de certains homo s'hétéroïse!"
                            },
                            {
                                "example_id": "a2d5ce4f-3dd7-4dcf-8568-3ccfe85e3170",
                                "sense_id": "6dce8a0c-358c-3c5a-9dfb-d31b5039c163",
                                "text": "Beaucoup de parents ont démissionné et beaucoup d'enfants trimballés entre des familles recomposés voire \"homoïsées\" ne savent plus à quel saint se vouer."
                            }
                        ]
                    }
                ],
