                        ],
                        "form": "midweeks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fac7a5a0-0ce6-31ed-9e92-f158cf009a75",
                        "entry_id": "db59d421-4dbc-3995-ab7f-abc55d1950f0",
                        "glosses": [
                            "The middle of the week."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69072207-bbe7-44cf-a551-4c79400b88e3",
                                "sense_id": "fac7a5a0-0ce6-31ed-9e92-f158cf009a75",
                                "text": "In midweek, however, the stretch is reasonably quiet and I can conceal myself behind a clump of rushes and cast a big piece of luncheon meat on a link-leger rig right in the deep hole and let the current roll it under the roof."
                            },
                            {
                                "example_id": "31dc1437-6437-467b-8c78-58d862885755",
                                "sense_id": "fac7a5a0-0ce6-31ed-9e92-f158cf009a75",
                                "text": "Carol, who is responsible for two coaches, says the sleeping accommodation is virtually full - surprising for midweek in mid-April. The Train Manager confirms that the train is well-loaded overall, noting that people view the train as a tourist attraction in its own right."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ca2e7b-6267-3048-bde2-46b79eaf33f7",
                        "entry_id": "db59d421-4dbc-3995-ab7f-abc55d1950f0",
                        "glosses": [
                            "Midweek worship service, held by many congregations and in addition to a Sunday morning service."
                        ],
                        "tags": [
                            "Jehovah's-Witnesses",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "57528d4b-bc8f-47c9-a222-9f0499107abf",
                                "sense_id": "90ca2e7b-6267-3048-bde2-46b79eaf33f7",
                                "text": "This Wednesday is churchwide midweek; men's is the next one."
                            }
                        ]
                    }
                ],
