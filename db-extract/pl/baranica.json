                "senses": [
                    {
                        "sense_id": "0bfe96e4-8e3f-3623-a084-33787c95b167",
                        "entry_id": "81c28552-29a4-318f-9993-0d5013d15b69",
                        "glosses": [
                            "wyprawiana skóra barania; skóra barania do przykrycia nóg w podróży"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c7dcf8-0412-40b8-9a0b-a8026d56cebc",
                                "sense_id": "0bfe96e4-8e3f-3623-a084-33787c95b167",
                                "text": "Okryj się baranicą, bo nogi odmrozisz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c491fc26-9503-3758-a4fa-e660aae38897",
                        "entry_id": "81c28552-29a4-318f-9993-0d5013d15b69",
                        "glosses": [
                            "czapka z futra baraniego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e5576e0-b60c-4963-8d68-ab6e5988b3f2",
                                "sense_id": "c491fc26-9503-3758-a4fa-e660aae38897",
                                "text": "Wdział na głowę baranicę i spiesznie wyszedł z izby."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a4348286-4238-37cc-9f21-2128d16be45d",
                        "entry_id": "81c28552-29a4-318f-9993-0d5013d15b69",
                        "glosses": [
                            "długi kożuch barani"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2149ed9c-e729-4ff2-874e-10652d3b6d94",
                                "sense_id": "a4348286-4238-37cc-9f21-2128d16be45d",
                                "text": "Szedł przez zasypane śniegiem pole w tej swojej baranicy, która sięgała mu do kolan."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4413e06a-b31f-3f90-9614-fa6cad3c73ec",
                        "entry_id": "81c28552-29a4-318f-9993-0d5013d15b69",
                        "glosses": [
                            "struna skrzypiec z baraniego jelita"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1585cd0c-e8b7-487a-979a-9a485f679547",
                                "sense_id": "4413e06a-b31f-3f90-9614-fa6cad3c73ec",
                                "text": "Jankowi pękła baranica, gdy przygrywał do oberka."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
