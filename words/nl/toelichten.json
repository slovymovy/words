                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je argumenten toch wat beter <w>toelichten</w>, anders worden ze verworpen.",
                            "target_lang_translations": {
                                "en": "You still need to <w>explain</w> your arguments a bit better, otherwise they will be rejected.",
                                "ru": "Тебе всё же нужно лучше <w>разъяснить</w> свои аргументы, иначе их отклонят."
                            }
                        },
                        {
                            "text": "De minister zal het nieuwe beleid morgen in de Kamer <w>toelichten</w>.",
                            "target_lang_translations": {
                                "en": "The minister will <w>elucidate</w> the new policy in Parliament tomorrow.",
                                "ru": "Завтра министр <w>разъяснит</w> новую политику в парламенте."
                            }
                        },
                        {
                            "text": "Kun je dat besluit met een voorbeeld <w>toelichten</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>clarify</w> that decision with an example?",
                                "ru": "Можешь <w>уточнить</w> это решение на примере?"
                            }
                        }
                    ],
                    "synonyms": [
                        "uitleggen"
                    ],
                    "common_phrases": [
                        "een besluit toelichten",
                        "met een voorbeeld toelichten",
                        "nader toelichten"
                    ],
                    "target_lang_definitions": {
