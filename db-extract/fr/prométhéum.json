                                        "sense_id": "8483f815-5081-321d-b519-31dddf9fe991",
                                        "entry_id": "d55f1cbe-004e-36d4-95f1-6869d23799e2",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 61, das zu den Lanthanoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a27f673-fefa-4f0b-9964-204eb1972414",
                                                "sense_id": "8483f815-5081-321d-b519-31dddf9fe991",
                                                "text": "Promethium ist das zweite radioaktive Element des Periodensystems."
                                            },
                                            {
                                                "example_id": "7cd63b5b-09de-4c73-be48-5a02d9bf19eb",
                                                "sense_id": "8483f815-5081-321d-b519-31dddf9fe991",
                                                "text": "Promethium wurde 1945 von einer amerikanischen Forschergruppe als Spaltprodukt des Urans entdeckt."
                                            }
