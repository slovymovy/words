                "translations": [
                    {
                        "translation_id": "345b7987-47dc-436b-92c3-f24cbf343463",
                        "source_entry_id": "8c74e18d-ff5e-365b-b560-ec615a02787d",
                        "source_sense_id": "5f5f1af8-9553-3413-aa4b-47d808e0e28b",
                        "source_sense_description": "Architektur: ein kunstvoller, vielfach geschmückter Überbau über einem Altar",
                        "target_lang_word": "ciborium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciborium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbc077c-923c-3cad-b8e9-01ff06aa3714",
                                        "entry_id": "a45fa926-c20b-3f62-b14a-090ff115519c",
                                        "glosses": [
                                            "A fixed vaulted canopy over a Christian altar, supported on four columns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9956fbe8-f913-3591-8a10-0133d208c982",
                                        "entry_id": "a45fa926-c20b-3f62-b14a-090ff115519c",
                                        "glosses": [
                                            "A covered receptacle for holding the consecrated wafers of the Eucharist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff450edb-32ee-4632-a32f-fd93464ee2d3",
                                                "sense_id": "9956fbe8-f913-3591-8a10-0133d208c982",
                                                "text": "Michael came after her, solemnly bearing the teapot like a ciborium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81c21262-8afe-4ed9-9945-866e6f66f26e",
                        "source_entry_id": "8c74e18d-ff5e-365b-b560-ec615a02787d",
                        "source_sense_id": "5f5f1af8-9553-3413-aa4b-47d808e0e28b",
                        "source_sense_description": "Architektur: ein kunstvoller, vielfach geschmückter Überbau über einem Altar",
                        "target_lang_word": "ciboire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciboire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                        "entry_id": "dc1c78c8-3f00-3041-a8ce-8cd7df61559f",
                                        "glosses": [
                                            "Coupe sacrée où l’on conserve les hosties pour la communion des fidèles."
                                        ],
                                        "tags": [
                                            "Liturgie catholique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64adaee7-2bd8-46d8-b70c-99fa10a15987",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "À l’aide d’un de ces instruments, il ouvrit le tabernacle, en tirant d’abord le saint-ciboire, magnifique coupe de vieil argent, ciselée sous Henri II, puis un ostensoir massif."
                                            },
                                            {
                                                "example_id": "40903bd4-030d-411a-9870-f52b9fe04ee3",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "L’orfèvre. – Si j’étais un grand artiste, j’aimerais les princes, parce qu’eux seuls peuvent faire entreprendre de grands travaux ; les grands artistes n’ont pas de patrie ; moi, je fais des saints ciboires et des poignées d’épée."
                                            },
                                            {
                                                "example_id": "c78a9e5d-5acd-49a2-be12-7408e39addc2",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "On aspergea d’eau bénite les draps du lit ; le prêtre retira du saint ciboire la blanche hostie ; et ce fut en défaillant d’une joie céleste qu’elle avança les lèvres pour accepter le corps du Sauveur qui se présentait."
                                            },
                                            {
                                                "example_id": "73de294a-c5c3-4b3b-b56f-29ed0f5aa3d5",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "Le vol des choses consacrées à Dieu était un sacrilège, parce que ce vol renfermait une profanation de choses saintes : tel était le vol des calices, ciboires, reliques, images et même des troncs d'église."
                                            },
                                            {
                                                "example_id": "b0f4cf98-80e0-43a4-af17-b78a3c3c4ff2",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "Il montait le ciboire aussi haut que ses mains pouvaient aller avec une courte hésitation avant d'atteindre le point culminant, comme font les porteurs d'haltères ; il se courbait sur l'autel plus que de coutume, forçant les enfants de chœur à rester de longues et angoissantes minutes le bras tendu lui soulevant sa chasuble ; et à chaque génuflexion il allait jusqu'au sol, frappant résolument du genou la marche creuse sans se soucier de sa sourde résonance, de son « Bang… Bang… » de grosse caisse…"
                                            },
                                            {
                                                "example_id": "dce131f0-bd45-4652-93b4-57a6ab3f26c6",
                                                "sense_id": "fc2622b9-b95b-3f76-b121-fcb514345f4c",
                                                "text": "Imaginez qu’il a dû marquer des essais de cent mètres en serrant le ballon contre sa poitrine comme Tarcisius son ciboire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f16406e0-c1fd-32d9-9d07-46cb2c955e15",
                                        "entry_id": "dc1c78c8-3f00-3041-a8ce-8cd7df61559f",
                                        "glosses": [
                                            "Meuble représentant la coupe du même nom dans les armoiries. À rapprocher de calice, coupe et hanap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5381ca0-edbe-4306-bb9b-a899419c8f93",
                                                "sense_id": "f16406e0-c1fd-32d9-9d07-46cb2c955e15",
                                                "text": "D’azur, semé de croix recroisetées au pied fiché d’or, au ciboire de même, qui était anciennement du royaume de Galice français illustration « armoiries avec un ciboire »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ciboire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ecac61b-9320-3e37-a624-4950b922e6cb",
                                        "entry_id": "45ac4282-a540-3333-bace-0d10e4db8efd",
                                        "glosses": [
                                            "Juron manifestant la colère, la frustration ou l’indignation."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd5166c-8f75-48df-b668-e032067430b8",
                                                "sense_id": "3ecac61b-9320-3e37-a624-4950b922e6cb",
                                                "text": "Et une fois de plus sa voix s’élevait en jurons et en plaintes : Je te dis que je t’aurai… ah ! Ciboire !."
                                            },
                                            {
                                                "example_id": "e30ff28b-53d8-4b30-8856-60b911b31ed5",
                                                "sense_id": "3ecac61b-9320-3e37-a624-4950b922e6cb",
                                                "text": "M’as passer mon check-up\n M’en vas faire mon ketchup\n On va voir c’qu’on va voir\n M’as m’forcer en ciboire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
