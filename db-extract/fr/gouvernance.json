                                        "entry_id": "e265a5c4-bb7d-38ef-af67-c608e4a1e2a1",
                                        "glosses": [
                                            "in den höchsten regierenden Institutionen und Funktionen (Staatsorgane) eines Staates tätige Personengruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8b8014-9ae5-411e-aaef-039a0808acc3",
                                                "sense_id": "9814bec4-268b-3fe8-9623-fece09d80d76",
                                                "text": "„Nachdem 1933 in der politischen Führung der entscheidende Wechsel mit allen überflüssigen Auffassungen gebrochen hatte, behandelte die Staatsführung auch die Probleme der Kultur und Kunst in einem neuen Stil.“"
                                            },
                                            {
                                                "example_id": "c2415786-7552-4fbe-8753-2ea7ff7eb2f1",
                                                "sense_id": "9814bec4-268b-3fe8-9623-fece09d80d76",
                                                "text": "„Die Staatsführung der Ukraine hat am Dienstag der Opfer der Atomkatastrophe von Tschornobyl [sic] vor 30 Jahren gedacht.“"
                                            },
                                            {
                                                "example_id": "eafb0598-d764-461f-a93f-ee63f3d4a580",
                                                "sense_id": "9814bec4-268b-3fe8-9623-fece09d80d76",
                                                "text": "„Eines der wichtigsten Instrumente von Partei und Staatsführung, die Menschen zu politischem Denken und Handeln anzuhalten, war die Ausgabe von Losungen.“"
                                            },
                                            {
                                                "example_id": "ac531cc9-db23-44c0-b56b-9cdcbcc6e729",
                                                "sense_id": "9814bec4-268b-3fe8-9623-fece09d80d76",
                                                "text": "„Auch in den bürgerlichen Parteien wird der Ruf nach einer autoritären Staatsführung immer lauter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c7a1a9c-6ba8-3e00-9274-1793840b5b65",
                                        "entry_id": "e265a5c4-bb7d-38ef-af67-c608e4a1e2a1",
                                        "glosses": [
                                            "Gesamtheit der Handlungen, einen Staat zu regieren"
                                        ],
