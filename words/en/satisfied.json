{
    "word_family": [
        "satisfy",
        "satisfaction",
        "satisfactory",
        "unsatisfied",
        "dissatisfied",
        "satisfying"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6c5267c-9c8e-3d8b-a97d-3904bf6a1a4a",
                    "sense_definition": "Feeling or showing pleasure and contentment because one's needs or expectations have been met.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contentment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>satisfied</w> with your progress in your homework, so you can watch television now.",
                            "target_lang_translations": {
                                "ru": "Я <w>доволен</w> твоими успехами в домашней работе, так что теперь ты можешь посмотреть телевизор."
                            }
                        },
                        {
                            "text": "The customer left the store feeling perfectly <w>satisfied</w> with her new purchase.",
                            "target_lang_translations": {
                                "ru": "Покупательница вышла из магазина, чувствуя себя совершенно <w>удовлетворённой</w> своей новой покупкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "content",
                        "happy",
                        "pleased"
                    ],
                    "antonyms": [
                        "unhappy",
                        "dissatisfied",
                        "frustrated"
                    ],
                    "common_phrases": [
                        "perfectly satisfied",
                        "satisfied customer",
                        "satisfied with results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство удовольствия и удовлетворения из-за того, что потребности или ожидания были оправданы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довольный",
                                "target_lang_sense_clarification": "о человеке, испытывающем радость"
                            },
                            {
                                "target_lang_word": "удовлетворённый",
                                "target_lang_sense_clarification": "ощущающий исполнение желаний или требований"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e5e27be-387c-3cdb-9b98-ac64860702cd",
                    "sense_definition": "Convinced or certain that something is true based on the available evidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge was <w>satisfied</w> that the defendant did not go out with the intent to start a riot.",
                            "target_lang_translations": {
                                "ru": "Судья был <w>убеждён</w>, что подсудимый не выходил на улицу с намерением начать беспорядки."
                            }
                        },
                        {
                            "text": "After reviewing the documents, the manager was entirely <w>satisfied</w> that the report was accurate.",
                            "target_lang_translations": {
                                "ru": "После изучения документов менеджер был <w>полностью</w> <w>уверен</w>, что отчет точен."
                            }
                        }
                    ],
                    "antonyms": [
                        "unconvinced",
                        "doubtful"
                    ],
                    "common_phrases": [
                        "entirely satisfied",
                        "satisfied that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убежденный или уверенный в истинности чего-либо на основе имеющихся доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убеждённый",
                                "target_lang_sense_clarification": "уверенный в правоте или факте"
                            },
                            {
                                "target_lang_word": "удовлетворённый",
                                "target_lang_sense_clarification": "получивший достаточно доказательств"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afac1543-8fc5-3b99-a456-66403c8a295a",
                    "sense_definition": "Simple past and past participle of <w>satisfy</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meal <w>satisfied</w> his hunger after a long day of hiking in the mountains.",
                            "target_lang_translations": {
                                "ru": "Еда <w>утолила</w> его голод после долгого дня походов в горах."
                            }
                        },
                        {
                            "text": "She has <w>satisfied</w> all the requirements needed to graduate from the university.",
                            "target_lang_translations": {
                                "ru": "Она <w>выполнила</w> все требования, необходимые для окончания университета."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола satisfy (удовлетворять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворил",
                                "target_lang_sense_clarification": "выполнил условие или утолил потребность"
                            },
                            {
                                "target_lang_word": "соответствовал",
                                "target_lang_sense_clarification": "отвечал требованиям"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}