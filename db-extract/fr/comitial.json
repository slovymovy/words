                ],
                "senses": [
                    {
                        "sense_id": "86fb3d9f-2510-3f7b-95b2-6ee53fb37c1b",
                        "entry_id": "4cb0b4fa-12fc-336f-b6ba-baf943042ff2",
                        "glosses": [
                            "Relatif aux comices, qui se déroule pendant les comices."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "c6b9c2fc-de90-4837-957d-fb0bebfece61",
                                "sense_id": "86fb3d9f-2510-3f7b-95b2-6ee53fb37c1b",
                                "text": "Dans un ouvrage récent consacré aux fonctions des assemblées du peuple au début du Principat, Virginie Hollard a montré que le vote comitial était avant tout un rituel contrôlé par le pouvoir impérial."
                            }
                        ]
                    },
                    {
                        "sense_id": "57c70fea-32ea-308e-a11d-e18cf5f87cfc",
                        "entry_id": "4cb0b4fa-12fc-336f-b6ba-baf943042ff2",
                        "glosses": [
                            "Dans le calendrier julien, désigne un des jours du mois où doivent se dérouler des comices (jour considéré comme faste)."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "f8045377-ecaa-430a-9479-e7761eb876bb",
                                "sense_id": "57c70fea-32ea-308e-a11d-e18cf5f87cfc",
                                "text": "Messalla, dès le 18 février, premier jour comitial disponible, pouvait convoquer les comices pour voter la rogatio, toujours pendante, puisque n’étant ni acceptée ni refusée."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f6fd553-f6e9-3400-9741-638032b75126",
                        "entry_id": "4cb0b4fa-12fc-336f-b6ba-baf943042ff2",
                        "glosses": [
                            "Qualifie un acte testamentaire présenté par un citoyen lors des « comices calates » (comices sans vote présidés par un pontife), s'il n'a pas d’héritier ou si cet héritier a démérité."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "6896cbdc-0b2b-4d03-bf5f-cd2df52224b3",
                                "sense_id": "5f6fd553-f6e9-3400-9741-638032b75126",
                                "text": "C'est le testament comitial que les décemvirs légitiment, en lui réservant un verset de leur code. Autrement le silence aurait signifié abolition."
                            }
                        ]
                    }
                ],
                "translations": [],
