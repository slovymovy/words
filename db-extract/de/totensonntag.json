                "senses": [
                    {
                        "sense_id": "412f3fcd-7c81-3fdf-a923-cc077add0f22",
                        "entry_id": "d3f479f5-3661-37df-98c6-02b00d0e2ddd",
                        "glosses": [
                            "letzter Sonntag (im November) vor Advent, an dem der Verstorbenen des vergangenen Jahres gedacht wird; in Deutschland ein sogenannter stiller Feiertag"
                        ],
                        "tags": [
                            "evangelische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "20c2daf0-6237-4664-a772-127688c6cf03",
                                "sense_id": "412f3fcd-7c81-3fdf-a923-cc077add0f22",
                                "text": "Der Totensonntag liegt in der dunklen Jahreszeit."
                            },
                            {
                                "example_id": "6ba5aba3-c519-48d0-a443-24eb8466fe66",
                                "sense_id": "412f3fcd-7c81-3fdf-a923-cc077add0f22",
                                "text": "Der Totensonntag ist der letzte Sonntag vor dem 1. Adventssonntag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3098d979-4130-4ac2-8304-30421ef34880",
                        "source_entry_id": "d3f479f5-3661-37df-98c6-02b00d0e2ddd",
