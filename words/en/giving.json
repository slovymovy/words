                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддавание, размягчение, таяние или прогибание под давлением или теплом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оседание",
