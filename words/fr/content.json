            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cbf45424-9812-37e9-b2de-ab8581c64749",
                    "sense_definition": "Qui éprouve de la satisfaction ou de la joie parce que les choses se passent comme on le souhaite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis très <w>content</w> de mon nouveau travail."
                        },
                        {
                            "text": "Les enfants sont <w>contents</w> parce qu'ils vont à la plage cet après-midi."
                        },
                        {
                            "text": "Ma mère n'était pas <w>contente</w> de mes notes à l'école."
                        }
                    ],
                    "synonyms": [
                        "satisfait",
                        "heureux",
                        "ravi",
                        "enchanté"
                    ],
                    "antonyms": [
                        "mécontent",
                        "malheureux"
                    ],
                    "common_phrases": [
