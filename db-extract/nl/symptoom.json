                    {
                        "sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                        "entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
                        "glosses": [
                            "ziekteverschijnsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd78c9bb-ed11-4018-8f36-8ffaa9e99c57",
                                "sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                                "text": "De eerste symptomen komen bij sommige ziekten pas jaren na de besmetting."
                            }
                        ]
                    },
                    {
                        "sense_id": "a426fa3c-3be6-3a21-be93-74cec3f73370",
                        "entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
                        "glosses": [
                            "verschijnsel waaraan men iets herkent"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb8e963d-1af4-4bbb-a662-eb659886b977",
                        "source_entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
                        "source_sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                        "source_sense_description": "ziekteverschijnsel",
                        "target_lang_word": "Symptom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Symptom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7021341-989a-3ee0-8c67-eb8f741cd80a",
                                        "entry_id": "8f433d4b-31dc-33fb-a456-f79de8d46b3e",
                                        "glosses": [
                                            "etwas, das auf etwas anderes schließen lässt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af8e7a5-ede2-4195-9430-d01b155c27c6",
                                                "sense_id": "d7021341-989a-3ee0-8c67-eb8f741cd80a",
                                                "text": "Man kann den Verlauf der Börsenkurse als Symptom für den Zustand der Finanzmärkte interpretieren."
                                            },
                                            {
                                                "example_id": "3806ae4e-f4b1-45d3-b25e-6e1e458809ab",
                                                "sense_id": "d7021341-989a-3ee0-8c67-eb8f741cd80a",
                                                "text": "„Die Schieflage in der Auseinandersetzung mit Rechts- und Linksextremismus ist ein Symptom, das ebenso auf andere gesellschaftliche Bereiche zutrifft.“"
                                            },
                                            {
                                                "example_id": "3c229560-0e72-43fa-802b-f78edf06409f",
                                                "sense_id": "d7021341-989a-3ee0-8c67-eb8f741cd80a",
                                                "text": "„Der Feldzug von 1812 hat mit der Periode von Borodino bis zur Vertreibung der Franzosen den Nachweis dafür geliefert, dass eine gewonnene Schlacht nicht nur nicht die Eroberung eines Landes nach sich zu ziehen brauchte, sondern nicht einmal als ein sicheres Symptom für die Eroberung eines Landes anzusehen ist; er hat den Nachweis erbracht, dass die Kraft, die das Schicksal der Völker entscheidet, nicht in den Eroberern liegt, nicht einmal in den Armeen und Schlachten, sondern in etwas anderem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "979c0739-d086-3361-97a3-386f8ff4ed6f",
                                        "entry_id": "8f433d4b-31dc-33fb-a456-f79de8d46b3e",
                                        "glosses": [
                                            "Ausdrucksseite (Signifiant, Signifikant) eines sprachlichen Zeichens in seiner Funktion, Rückschlüsse auf den Sprecher/Schreiber zuzulassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567f5a7d-6cbf-47cd-a247-7c6eb4e90177",
                                                "sense_id": "979c0739-d086-3361-97a3-386f8ff4ed6f",
                                                "text": "Zur Ausdrucksseite des sprachlichen Zeichens: „Es ist Symbol kraft seiner Zuordnung zu Gegenständen und Sachverhalten, Symptom (Anzeichen, Indicium) kraft seiner Abhängigkeit vom Sender, dessen Innerlichkeit es ausdrückt, und Signal kraft seines Appells an den Hörer, dessen äußeres oder inneres Verhalten es steuert wie andere Verkehrszeichen.“"
                                            },
                                            {
                                                "example_id": "b3c33940-6ceb-45b8-89c9-d10a6a86825e",
                                                "sense_id": "979c0739-d086-3361-97a3-386f8ff4ed6f",
                                                "text": "Im Organon-Modell der Sprache von Hans Bühler entspricht das Symptom der Funktion des Ausdrucks der Sprache."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                                        "entry_id": "8f433d4b-31dc-33fb-a456-f79de8d46b3e",
                                        "glosses": [
                                            "Anzeichen einer bereits vorhandenen oder sich anbahnenden Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24cd4522-3ed0-4856-b1fc-c3c4e1de86e3",
                                                "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                                                "text": "Du hast den ersten Symptomen einer Erkältung keine Beachtung geschenkt. Nun hat es dich richtig erwischt!"
                                            },
                                            {
                                                "example_id": "4a453d3d-33e6-40c1-b218-359150ca621f",
                                                "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                                                "text": "„Alle Symptome, davon war sie überzeugt, waren lediglich ein Zeichen für ihre Schwierigkeiten, sich in einem fremden Land einzuleben.“"
                                            },
                                            {
                                                "example_id": "cd799ec5-df73-442e-a4f3-c4fb08dc8c95",
                                                "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                                                "text": "„Pastor lacht glucksend und biegt dabei den Kopf in den Nacken, als litte er an den Symptomen einer akuten Meningitis.“"
                                            },
                                            {
                                                "example_id": "9636601c-4e62-40ee-9945-4d9f3d53d415",
                                                "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                                                "text": "„Seinen Arzt fragt er nach den Symptomen einer Gehirnhautentzündung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "970696ea-f165-3ecd-9896-f311a88e4cc1",
                                        "entry_id": "8f433d4b-31dc-33fb-a456-f79de8d46b3e",
                                        "glosses": [
                                            "Erscheinungsform eines Fehlers"
                                        ],
                                        "tags": [
                                            "Qualität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c7b256-0af0-4e1c-ab8b-727217aabaf3",
                                                "sense_id": "970696ea-f165-3ecd-9896-f311a88e4cc1",
                                                "text": "\"Mit der 8D-Methodik wird, ähnlich wie bei der Six-Sigma-Methodik, eine systematische Vorgehensweise und konsequente Dokumentation der einzelnen Lösungsschritte erreicht. Der Ansatz beider Methodiken ist faktenorientiert und stellt sicher, dass Produktfehler auf ihre Ursachen zurückgeführt und diese dauerhaft abgestellt werden, anstatt nur Symptome zu überdecken.\""
                                            },
                                            {
                                                "example_id": "22ca134b-f622-4a4a-8a31-241577748c1e",
                                                "sense_id": "970696ea-f165-3ecd-9896-f311a88e4cc1",
                                                "text": "\"Eine Ursachenanalyse (englisch Root Cause Analysis, kurz RCA) ist ein Prozess, mit dem die tiefere Ursache von Problemen ermittelt wird, um geeignete Lösungen zu finden. Die Grundannahme lautet: Es ist wesentlich effektiver, zugrunde liegende Probleme systematisch zu verhindern und zu beseitigen, anstatt einfach nur an den Symptomen herumzudoktern.\""
                                            },
                                            {
                                                "example_id": "14c2b9b9-c270-4225-91aa-6d5b08b23908",
                                                "sense_id": "970696ea-f165-3ecd-9896-f311a88e4cc1",
                                                "text": "\"Diese Fehler zu identifizieren und zu beschreiben, ist ein wichtiger Schritt im Qualitätsmanagement. Oft sind sie aber nur die sichtbaren Symptome. Für das Qualitätsmanagement und die vorbeugende Qualitätssicherung ist deshalb wichtig, dass die Fehlerursachen gefunden werden.\""
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eba750c-4c00-4ea8-8bf4-cd48236299a7",
                        "source_entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
                        "source_sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                        "source_sense_description": "ziekteverschijnsel",
                        "target_lang_word": "symptom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symptom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                        "entry_id": "dccb2d62-b3ac-34fa-8ef6-3cc9b83d49cc",
                                        "glosses": [
                                            "A perceived change in some function, sensation or appearance of a person that indicates a disease or disorder, such as fever, headache or rash; strictly, a symptom is felt or experienced by the patient, while a sign can be detected by an observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93de309e-8ea5-4dc8-9ec5-62203430f405",
                                                "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                                "text": "The doctor told that his coughing and sneezing was the symptom of standing for too long in the rain."
                                            },
                                            {
                                                "example_id": "267045c4-72bd-4585-8680-a92b69d55dc0",
                                                "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                                                "text": "Swollen breasts, morning sickness, and a missed period are classic symptoms of pregnancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                        "entry_id": "dccb2d62-b3ac-34fa-8ef6-3cc9b83d49cc",
                                        "glosses": [
                                            "A signal; anything that indicates, or is characteristic of, the presence of something else, especially of something undesirable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd1d4c4-d95b-48ee-b9db-52f55a23f691",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "Lying, hiding one's true feelings, and having affairs are typical symptoms of a doomed marriage."
                                            },
                                            {
                                                "example_id": "6fdfbe75-a450-4fc9-be26-c6dfc77274b8",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "\"Nay, nay,\" exclaimed Lord Norbourne, \"I cannot go quite so far as that. I have, thanks to your hospitality, laid in a stock of health enough for the ensuing winter: but as to the general benevolence of which you talk, I confess I find no symptoms: if I did, they would alarm me more than those of the gout.\""
                                            },
                                            {
                                                "example_id": "1bacc17f-bf7f-4ad3-aa47-d746a9150987",
                                                "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                                                "text": "Some people see birth outside of marriage as a social problem—a sign of a breakdown in the traditional family and a symptom of moral decay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df22d96e-985d-4bde-b913-8315c219718b",
                        "source_entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
                        "source_sense_id": "8e50fe7a-bc3d-380a-897b-20ce83dd1f7a",
                        "source_sense_description": "ziekteverschijnsel",
                        "target_lang_word": "symptôme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symptôme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                        "entry_id": "84e1af07-8011-31d0-8a23-814082cde485",
                                        "glosses": [
                                            "Phénomène caractéristique d’un trouble organique ou fonctionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b86e9a-f625-49eb-a1fe-bb4e269316e0",
                                                "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                                "text": "Et tout le village bientôt, à des degrés variant selon la constitution et la force de résistance de chacun, fut en proie à des malaises étranges, symptômes inexplicables d’empoisonnement."
                                            },
                                            {
                                                "example_id": "a4c48e74-0790-4fc6-a671-0e4d93bd9878",
                                                "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                                "text": "Au premier symptôme, l’apparition d’un léger œdème prétibial, il fallait cesser toute absorption de viande de conserve et se nourrir exclusivement de légumes conservés ou secs et de viande fraîche."
                                            },
                                            {
                                                "example_id": "fe77063d-822c-4d40-b21f-e55c910f43b8",
                                                "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                                "text": "Les premiers symptômes extérieurs sont visibles en juin : ils constituent en une fanaison et un brunissement du feuillage d’un ou deux rameaux."
                                            },
                                            {
                                                "example_id": "478b1292-262f-46a7-8136-9ca4ddf3cb18",
                                                "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                                "text": "Le diagnostic différentiel de l’apathie et de la dépression reste un véritable défi lancé au clinicien, certains symptômes étant communs, le manque de motivation en particulier."
                                            },
                                            {
                                                "example_id": "b3db8058-bbf3-43b1-8936-1cbc88106c96",
                                                "sense_id": "f6d21d4a-89eb-3770-a406-45f321b6de33",
                                                "text": "En fait, Jean-Martin Charcot (1825-1893) est confronté à un fouillis de symptômes mal définis échappant aux classifications nosographiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c725de-ceec-3502-8088-6c562c29ce2c",
                                        "entry_id": "84e1af07-8011-31d0-8a23-814082cde485",
                                        "glosses": [
                                            "Signe révélateur d’une situation matérielle ou d’un état d’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07009c9-f729-41c3-9205-a2a82e7c1d9b",
                                                "sense_id": "f0c725de-ceec-3502-8088-6c562c29ce2c",
                                                "text": "Ces grèves sont le symptôme d’une crise révolutionnaire."
                                            },
                                            {
                                                "example_id": "3f847a29-3aad-4292-9e61-bd699a1cf003",
                                                "sense_id": "f0c725de-ceec-3502-8088-6c562c29ce2c",
                                                "text": "De fâcheux symptômes. Symptôme de mécontentement. Symptôme de décadence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4afde6f1-3ddd-43ca-bdaf-7d9a20b15218",
                        "source_entry_id": "ce57bc11-a9ae-3db5-8a0a-8fef5353e1f0",
