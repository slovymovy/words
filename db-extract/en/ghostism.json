                        "examples": [
                            {
                                "example_id": "a0c54171-15f8-440c-b92a-e43c2cc83fc2",
                                "sense_id": "ee6bdc8e-e464-386f-b818-4bef399e3865",
                                "text": "Immortal-soulism, spiritism, ghostism, all spring from a fabulous or mythical source. Corporeity is characteristic of being."
                            },
                            {
                                "example_id": "aa1e309b-b954-433d-8bce-a9953826732c",
                                "sense_id": "ee6bdc8e-e464-386f-b818-4bef399e3865",
                                "text": "This degradation took the forms of belief in Sheol (Hades) and in necromancy. Both of them were forms of ghostism. The first was a conception that the spirits of the departed remained associated somehow with their bodies and with the place of burial."
                            }
                        ]
                    }
