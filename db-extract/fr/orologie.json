                        "glosses": [
                            "Traité sur les montagnes, science des montagnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d8bc20-f262-474f-9bd9-ba5104b7fb99",
                                "sense_id": "5bb6ee28-c0b1-39ad-8e30-ca8aa2191cdb",
                                "text": "Il en est de même de l’orologie ou de la description des montagnes, qu’on peut considérer comme une section de la géologie."
                            },
                            {
                                "example_id": "0dea5661-9a8e-4e70-b72d-5cb8ca65c223",
                                "sense_id": "5bb6ee28-c0b1-39ad-8e30-ca8aa2191cdb",
                                "text": "Ayant ainsi déterminé les limites naturelles de l’Europe par son hydrographie, l’auteur en donne l’orologie, en rattachant toutes les montagnes à cette même ligne de partage des eaux, qui traverse l’Europe du nord-est au sud-ouest […]"
                            },
                            {
                                "example_id": "f3d4b9d8-5876-4c47-9505-a65e95bc220c",
                                "sense_id": "5bb6ee28-c0b1-39ad-8e30-ca8aa2191cdb",
                                "text": "L’orologie (science des montagnes) n’existe pas, mais c’est précisément parce que nous ne parvenons pas à mettre dans le même panier, à penser en même temps ses différents aspects."
                            }
                        ]
                    }
