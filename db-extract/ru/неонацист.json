                ],
                "translations": [
                    {
                        "translation_id": "ddf67981-a946-4ff4-b2f9-702f7136b350",
                        "source_entry_id": "269560f5-dede-3f4a-8fe2-ab1b752b7a81",
                        "source_sense_id": "2d2ffef9-0d27-3360-8cb1-f4f7a3de8904",
                        "target_lang_word": "neo-Nazi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                        "entry_id": "c2ea2748-9d35-325a-805d-30e32f9c94fd",
                                        "glosses": [
                                            "An adherent of neo-Nazism, any of various (far right, authoritarian, or bigoted) post-World War II Nazi ideologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6c8b78-e57b-4552-9c85-9f63e1f1812e",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Andrew Anglin, head of the now defunct alt-right publication Daily Stormer, a Neo-Nazi, and friend of Richard Spencer claimed on his site that “the only thing in our movement that really matters [is] anti-Semitism […] Last but not least, President Trump himself was key in mainstreaming alt-right politics, referring to white supremacists and Neo-Nazis as “very fine people”, […]"
                                            },
                                            {
                                                "example_id": "d60e61c0-a308-4e12-b20e-450c8351f60c",
                                                "sense_id": "f0c6eb15-a747-3dfe-9aea-420cfb0de42f",
                                                "text": "Among his first moves, he dismantled Twitter's trust and safety infrastructure, laying off the vast majority of the staff responsible for things like taking down violent threats and hate speech. In their place, he welcomed neo-Nazis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neo-Nazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                        "entry_id": "15e32e81-f7bf-33b7-a0cb-8e24ae12e601",
                                        "glosses": [
                                            "Of or pertaining to neo-Nazism or neo-Nazis."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2955ad6f-9017-4635-838b-4cba2e7bc4b8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "On the whole the Galicians have been at the more pitiful end of the spectrum, trading infantile political insults on the web, each trying desperately to appear more neo-Nazi than the other."
                                            },
                                            {
                                                "example_id": "04281a07-c4d2-4b90-9a0d-ff3709f4dad8",
                                                "sense_id": "570912bf-b33a-35e8-a2b9-bfa829ecba93",
                                                "text": "Wilson has tweeted the phrase “Ausländer Raus” at least four times, including the slogan, “Deutschland den Deutschen. Ausländer raus.” The phrase, which means, “Germany for Germans, foreigners out,” is explicitly considered to be an extremist slogan in Germany with neo-Nazi roots; in fact, a 1992 paper about its use among German skinheads is available on a Department of Justice website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "488787f5-cefd-4fd2-bf54-664cc1b93ed6",
                        "source_entry_id": "269560f5-dede-3f4a-8fe2-ab1b752b7a81",
                        "source_sense_id": "2d2ffef9-0d27-3360-8cb1-f4f7a3de8904",
