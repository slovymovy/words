                    "frequency": "Low",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит <переводить> дорогие продукты, если никто не будет это есть.",
                            "target_lang_translations": {
                                "en": "It's not worth <w>wasting</w> expensive products if no one is going to eat them.",
                                "es": "No vale la pena <w>desperdiciar</w> productos caros si nadie los va a comer.",
                                "fr": "Il ne faut pas <w>gaspiller</w> des produits coûteux si personne ne va les manger."
