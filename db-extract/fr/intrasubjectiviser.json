                "senses": [
                    {
                        "sense_id": "c54bc2a8-9a4b-3063-b1c1-179c4026d4c7",
                        "entry_id": "250996bc-e706-3b22-81d5-6a4d8a8e9745",
                        "glosses": [
                            "Donner un caractère intrasubjectif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8007f26-862e-4beb-a147-59f6b931201b",
                                "sense_id": "c54bc2a8-9a4b-3063-b1c1-179c4026d4c7",
                                "text": "Si le fonctionnement de la théorie analytique, plus que tout autre, ne peut être validé que par son intersubjectivité, lui permettant d’éviter de s’intrasubjectiviser autour d’un noyau pulsionnel, d’un punctum caecum ou d’un axe narcissique, cette intersubjectivité est autant garantie par le transfert, dans la séance clinique, que par l’histoire, ordonnant les modalités des manifestations cliniques."
                            },
                            {
                                "example_id": "85a253a0-02db-4b51-929c-57f70e73813c",
                                "sense_id": "c54bc2a8-9a4b-3063-b1c1-179c4026d4c7",
                                "text": "Contre une « théorie où l’objet du transfert serait entièrement intrasubjectivisé » et tout-puissant, le fonctionnement de la théorie ne peut être validé que de son intersubjectivité, garantie par le transfert."
                            }
                        ]
                    }
