                ],
                "senses": [
                    {
                        "sense_id": "3536df5d-22bc-37d2-8ede-d503b90705bf",
                        "entry_id": "2c458298-5a39-38ae-8596-5b5c28406396",
                        "glosses": [
                            "устар. знать, аристократия, высший свет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59101d13-0ad3-4e11-bd49-180f61a25253",
                                "sense_id": "3536df5d-22bc-37d2-8ede-d503b90705bf",
                                "text": "Время от времени красавицу жену можно с гордостью вывести в люди: на презентацию, премьеру в театре, короче говоря — в местный бомонд."
                            },
                            {
                                "example_id": "13a6e162-0ca5-44ab-957f-4c0bf41af284",
                                "sense_id": "3536df5d-22bc-37d2-8ede-d503b90705bf",
                                "text": "И на эти спектакли мать Демидова зовёт весь Петербург, со Двором во главе; в первом ряду сидели Государь, Императрица, все трое Великие Князья, Великая Княгиня Мария Николаевна, а затем весь бомонд."
                            }
                        ]
                    }
