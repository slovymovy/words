                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b19d0bd-0932-36a4-9552-12b40676184d",
                        "entry_id": "15fd2fe2-e6cb-3c48-a1ab-0d3b24952ace",
                        "glosses": [
                            "половая связь между близкими родственниками, запрещаемая законом; инцест"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aba9a94-700f-45e6-9ea5-6f08878f099e",
                                "sense_id": "7b19d0bd-0932-36a4-9552-12b40676184d",
                                "text": "Нет никаких точных доказательств тому, что слухи о кровосмешении правильны, то есть что Мольер женился на своей дочери."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6aa7647-fe34-45af-a215-67585369b5a6",
                        "source_entry_id": "15fd2fe2-e6cb-3c48-a1ab-0d3b24952ace",
                        "source_sense_id": "7b19d0bd-0932-36a4-9552-12b40676184d",
                        "target_lang_word": "incest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                        "entry_id": "4392e647-aa72-36d2-98d6-d563acd769dd",
                                        "glosses": [
                                            "Sexual relations between close relatives, especially immediate family members and sometimes first cousins, usually considered taboo; in many jurisdictions, close relatives are not allowed to marry, and incest is a crime."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce71985-0290-4d6a-b9e6-4360016934eb",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "Genetic problems caused by incest are thought to have plagued many royal families in the Middle Ages."
                                            },
                                            {
                                                "example_id": "d2244b1f-7004-4771-a464-a51d88f132aa",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "For a structuralist like Edmund Leach, the structure is the meaning. Genesis, for example, is about incest taboos; all the rest is noise and mystification."
                                            },
                                            {
                                                "example_id": "551561e0-edeb-4b0d-a142-9e931881b45d",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "He was only Craster's whelp, an abomination born of incest, not the son of the King-beyond-the-Wall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                        "entry_id": "bc2bf782-ec3f-3fbe-a782-76c421bba786",
                                        "glosses": [
                                            "To engage in incestuous sexual intercourse."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e04c54-4878-41bc-ae5b-aa51697e741d",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "I do not want anyone to feel that my lesbianism is a result of being incested."
                                            },
                                            {
                                                "example_id": "b99938c6-aec0-4596-af0f-dfd923a18f48",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "Her erotic transference ultimately devolved into a revelation that she had been consistently incested by her brother"
                                            },
                                            {
                                                "example_id": "bb0153e0-926c-432f-aec9-eb74518ce464",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "[…] the most powerful of that bunch of immortal giants called Titans was Cronus, who “incested” with sister Rhea, who then birthed the Olympians (Zeus and his bunch) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "891de424-4c7d-40f5-9ab2-fd69aa40f70d",
                        "source_entry_id": "15fd2fe2-e6cb-3c48-a1ab-0d3b24952ace",
                        "source_sense_id": "7b19d0bd-0932-36a4-9552-12b40676184d",
                        "target_lang_word": "Blutschande",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutschande",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b82d7053-9920-3d4d-8821-b941c92af487",
                                        "entry_id": "815b192f-44d8-3717-a127-04cf3b30148e",
                                        "glosses": [
                                            "Geschlechtsverkehr zwischen engsten Verwandten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f5585b-2a4d-4fbc-8a88-8eba81eb579f",
                                                "sense_id": "b82d7053-9920-3d4d-8821-b941c92af487",
                                                "text": "Im alten Ägypten war Blutschande normal."
                                            },
                                            {
                                                "example_id": "de11e461-a2ca-48e8-93f7-74587e9208fc",
                                                "sense_id": "b82d7053-9920-3d4d-8821-b941c92af487",
                                                "text": "Auf die Frage nach den fortdauernden Vergewaltigungen, der Blutschande, der fortdauernden Freiheitsberaubung seiner Tochter und dreier Kinder antwortete er [Josef Fritzl] mit \"schuldig\" oder \"teilschuldig\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ca075b7-4cfa-39dc-9a3f-b8a1cd5942d6",
                                        "entry_id": "815b192f-44d8-3717-a127-04cf3b30148e",
                                        "glosses": [
                                            "nach nationalsozialistischer Rassenideologie sexuelle Beziehungen zwischen Menschen unterschiedlicher „Rassen“"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b65f853c-b3f3-4657-905c-40eca73223a1",
                                                "sense_id": "8ca075b7-4cfa-39dc-9a3f-b8a1cd5942d6",
                                                "text": "Im 2. Weltkrieg mussten sich viele Frauen wegen „Blutschande“ verantworten, weil sie mit Schwarzen verheiratet waren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5c5203f-3266-4298-9fb2-6280606777b4",
                        "source_entry_id": "15fd2fe2-e6cb-3c48-a1ab-0d3b24952ace",
                        "source_sense_id": "7b19d0bd-0932-36a4-9552-12b40676184d",
