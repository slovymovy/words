                "senses": [
                    {
                        "sense_id": "3dcf08d9-2e19-3c3b-a89f-35174f8a13c7",
                        "entry_id": "f04899da-f23b-3972-94fe-a193683bc714",
                        "glosses": [
                            "To fit or furnish with a vandyke; to form with points or scallops like a vandyke."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "59513456-47a3-4ec9-984c-243b7011effc",
                                "sense_id": "3dcf08d9-2e19-3c3b-a89f-35174f8a13c7",
                                "text": "Again I searched, and found a most diabolical pair of cock-nosed shears, capable of vandyking the interiors of elephants."
                            },
                            {
                                "example_id": "40d795a6-ffb2-4429-b0a5-174cf9874970",
                                "sense_id": "3dcf08d9-2e19-3c3b-a89f-35174f8a13c7",
                                "text": "The travellers had not advanced many paces towards them before the peaks of three gables rose above them, vandyking the sky and docking the last sparse branches of the elms. Mr. Thomasson's exclamation of relief, as he surveyed the building, was cut short by the harsh rattle of a chain, followed by the roar of a watch-dog, as it bounded from the kennel; in a second a horrid raving and baying, as of a score of hounds, awoke the night."
                            }
                        ]
                    }
