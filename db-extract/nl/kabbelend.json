        "nl-extract.jsonl": [
            {
                "entry_id": "19ef96af-ae98-30a5-b7e9-184d287e96c2",
                "word": "kabbelend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72a665a8-613e-3856-8e46-32f37cf81ebe",
                        "entry_id": "19ef96af-ae98-30a5-b7e9-184d287e96c2",
                        "glosses": [
                            "rustig, traag voortgaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2cc635-0169-411e-aeab-c924e5d01ac4",
                                "sense_id": "72a665a8-613e-3856-8e46-32f37cf81ebe",
                                "text": "Het kabbelende beekje kwam na rust eindelijk tot leven. Met kansen, onderling venijn, strijd, spanning en doelpunten."
                            },
                            {
                                "example_id": "ee55b699-876d-4e98-b280-0935983b27c1",
                                "sense_id": "72a665a8-613e-3856-8e46-32f37cf81ebe",
                                "text": "Het is goed toeven in de zomp op het langzaam kabbelende water. ‘Dat was vroeger wel eens anders!’ vertelt schipper Braamhaar. ‘Vaak werd vanuit de textielfabrieken vervuild water geloosd. Als er in Goor blauwe of groene verf was gebruikt, dan kreeg de Regge plotseling die kleur. Die wantoestanden maken we vandaag de dag gelukkig niet meer mee’."
                            },
                            {
                                "example_id": "13a66b7b-b3ef-4f8d-9c3a-6505a2477bf6",
                                "sense_id": "72a665a8-613e-3856-8e46-32f37cf81ebe",
                                "text": "En op dat eerder genoemde videoscherm trekken het hele concert prachtige visuals voorbij: je zou er zo in willen duiken, dat aanlokkelijk kabbelende water in de filmpjes bij het nummer 'Swimming pools'."
                            }
                        ]
                    }
                ],
