                "senses": [
                    {
                        "sense_id": "169715d0-cd8e-3a29-a54b-45341e6014d7",
                        "entry_id": "d1c07b25-3e64-30b2-abc5-ebed3be5769d",
                        "glosses": [
                            "Plan/Vorsatz, etwas zu bauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2096abb5-4d6d-4f6a-8500-f3c94e86c46f",
                                "sense_id": "169715d0-cd8e-3a29-a54b-45341e6014d7",
                                "text": "Ihr solltet euren längst gefassten Bauplan wegen der niedrigen Zinsen bald in die Tat umsetzen und nicht mehr allzu lange warten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7ffcea5-b42f-344f-8a1b-3a9c035431fc",
                        "entry_id": "d1c07b25-3e64-30b2-abc5-ebed3be5769d",
                        "glosses": [
                            "grafischer Entwurf für etwas, das gebaut werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caafd8af-80d6-465d-93c7-ea3f081db437",
                                "sense_id": "f7ffcea5-b42f-344f-8a1b-3a9c035431fc",
                                "text": "Ich baue nach meinem Bauplan. Hier ist meine Skizze: …"
                            },
                            {
                                "example_id": "b0b166e9-b1dd-42bb-92cd-c3364b98a8f9",
                                "sense_id": "f7ffcea5-b42f-344f-8a1b-3a9c035431fc",
                                "text": "„Er spürte alte Baupläne in Archiven und Bibliotheken auf und beschäftigte mehrere Zeichner, Restauratoren und Kupfersteher, mit denen er die Planungen zum Weiterbau des Doms vorantrieb.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
