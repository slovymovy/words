                        "glosses": [
                            "Fasting, abstention, abstinence; the third of the five pillars of Islam."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bfb8b9d-a9cf-45ba-9eb8-11327968a533",
                        "source_entry_id": "c9ec3a3d-051a-3f67-9937-998c4bfa1e96",
                        "source_sense_id": "3f30597b-b5e5-3174-aad9-ab842fec720d",
                        "source_sense_description": "Islamic fasting",
                        "target_lang_word": "saoum",
