                ],
                "senses": [
                    {
                        "sense_id": "4813d664-769d-3ae2-ad17-d4fcb1dae256",
                        "entry_id": "3df6d236-a0b2-3ce7-a777-e1c961fcc9a7",
                        "glosses": [
                            "Raum, in dem Patienten während ihrer stationären medizinischen Behandlung in einem Krankenhaus untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb84b502-fdd1-4072-ae16-348063f6b87d",
                                "sense_id": "4813d664-769d-3ae2-ad17-d4fcb1dae256",
                                "text": "„In jenen letzten Augusttagen des Jahres 1961 erwacht in einem kleinen Krankenhauszimmer das Mädchen Rita Seidel. Sie hat nicht geschlafen, sie war ohnmächtig.“"
                            },
                            {
                                "example_id": "85dd0641-72f4-49a5-a7ab-32329e73998f",
                                "sense_id": "4813d664-769d-3ae2-ad17-d4fcb1dae256",
                                "text": "„Nietzsche war nicht nur der furchtlose Denker, der zu der entscheidenden Schlussfolgerung ›Gott ist tot!‹ kam, er war es auch, der am Ende seinen Namen mit eigenen Exkrementen an die Wand seines Krankenhauszimmers schrieb.“"
                            },
                            {
                                "example_id": "137d707a-2371-4cc7-887e-a917bca58fd4",
                                "sense_id": "4813d664-769d-3ae2-ad17-d4fcb1dae256",
                                "text": "„Im Krankenhaus des Roten Kreuzes gibt es noch viele freie Betten, die Schwestern haben noch ein frisches und kein erschöpftes oder gequältes Aussehen, die Damen aus reichen Sofioter Kreisen bringen Blumen und den Duft von Parfüm in die Krankenhauszimmer, ziehen ihren Handschuh von der rechten Hand und streicheln mit ihren schönen zarten Fingern den Kranken Stirn und Wangen, die mit kaltem Schweiß bedeckt sind.“"
                            },
                            {
                                "example_id": "f0d9ad8c-0cfe-4a81-b57b-7410fa81ca64",
                                "sense_id": "4813d664-769d-3ae2-ad17-d4fcb1dae256",
                                "text": "„Dass in Krankenhauszimmern Krankenschwestern arbeiten, gehört genauso zum vorausgesetzten Weltwissen wie die Tatsache, dass zum Aufschließen einer Tür ein Schlüssel dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
