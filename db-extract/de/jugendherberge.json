                ],
                "senses": [
                    {
                        "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                        "entry_id": "0f648118-ca75-337c-a909-0ad5f4d69914",
                        "glosses": [
                            "eine Art einfaches Hotel, in dem besonders Jugendliche billig übernachten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81edf66b-9621-418b-bfdf-f413ace602de",
                                "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                                "text": "Wir gingen zurück in die Jugendherberge, um zu schlafen."
                            },
                            {
                                "example_id": "abc1d9cf-b113-4dfe-8218-4007a69ada8b",
                                "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                                "text": "„Weil sie in Bad Schandau aus der Jugendherberge ausgebüxt waren, haben Floris alte Klassenkameraden Strafarbeiten bekommen.“"
                            },
                            {
                                "example_id": "e7f088ec-e81e-460a-a2f0-f4a76f7637d6",
                                "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                                "text": "Jugendherbergen – da denken viele noch an Gemeinschaftsduschen, große Schlafsäle und schlechtes Essen. Doch das Aussehen der Jugendherbergen hat sich in den letzten Jahren stark geändert. Jetzt gibt es dort oft Frühstücksbuffets und Einzelzimmer mit eigener Dusche und separater Toilette."
                            },
                            {
                                "example_id": "14c71873-0af1-4a02-9e12-90a6372edde6",
                                "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                                "text": "„Er übernachtete in Jugendherbergen im Gebirge.“"
                            },
                            {
                                "example_id": "44f734ae-8a0f-4a7e-8557-8e3472c0cfe4",
                                "sense_id": "e5182edf-5992-34d8-a7b6-85721fa26df6",
                                "text": "„Eine zauberhafte Jugendherberge gibt es auch in Vík, eine, die immer viel zu warm geheizt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
