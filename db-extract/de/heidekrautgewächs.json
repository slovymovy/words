                ],
                "senses": [
                    {
                        "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                        "entry_id": "c6fec3cd-5d5c-38e5-a759-a072b3e5972d",
                        "glosses": [
                            "meist immergrüner Strauch mit radiären 3- bis 6-zähligen Blüten; wissenschaftliche Familie der Ordnung Heidekrautartige"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7c8f3f1c-a53e-46db-9f26-58118cead66b",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„Unterschiedliche Bezeichnungen und viele Sorten Je nach Region ist das Heidekrautgewächs (Vaccinium myrtillus) auch als Mollbeere, Schwarzbeere, Bickbeere oder Blaubeere bekannt.“"
                            },
                            {
                                "example_id": "98d299f9-3cd0-49aa-8241-fc450d516cc6",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„In früheren Zeiten habe die Gegend Porst-Bruch geheißen - nach dem seltenen Heidekrautgewächs Sumpf-Porst.“"
                            },
                            {
                                "example_id": "3f3b7844-3eea-4d10-a4a1-3de1b5596187",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„Unterschiedliche Bezeichnungen und viele Sorten Je nach Region ist das Heidekrautgewächs (Vaccinium myrtillus) auch als Mollbeere, Schwarzbeere, Bickbeere oder Blaubeere bekannt.“"
                            },
                            {
                                "example_id": "8bf7b867-05ed-405a-bb75-4d3baa3cbaf1",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„Das Heidekrautgewächs entwickelt sich zum Liebling der Deutschen: Der Absatz schnellt in die Höhe, 66.“"
                            },
                            {
                                "example_id": "e3228c82-5748-48d4-a3ba-a4c2357e4563",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„Mit ein paar Tipps können Sie dem Heidekrautgewächs Gutes tun und sich umso länger an ihm erfreuen.“"
                            },
                            {
                                "example_id": "841f61a1-53be-4a25-b70a-12cc9817251c",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "„Wild wachsendes Heidekrautgewächs Preiselbeeren (oder auch Kronsbeeren oder Grante) sind die Früchte eines immergrünen, wild wachsenden Heidekrautgewächses, das man in Mooren, Kiefernwäldern und in bergigen Regionen findet.“"
                            },
                            {
                                "example_id": "dc4da4cc-d2ef-466f-934b-dc8a750bad32",
                                "sense_id": "71376b8b-07eb-3e28-a1a7-eea9f49d67b0",
                                "text": "In die Heidekrautgewächse werden nach neueren Erkenntnissen die früheren Familien Wintergrün-, Fichtenspargel- und Australheidegewächse eingeschlossen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
