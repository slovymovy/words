                "entry_id": "39a8e95f-0453-3919-9e6d-54d55e33bc1e",
                "word": "immunoglobulin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f4d22714-4837-4a06-b755-75716b67e0d7",
                        "entry_id": "39a8e95f-0453-3919-9e6d-54d55e33bc1e",
                        "tags": [
                            "plural"
                        ],
                        "form": "immunoglobulins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74c82d10-c361-33f9-b7b1-100ee15614f2",
                        "entry_id": "39a8e95f-0453-3919-9e6d-54d55e33bc1e",
                        "glosses": [
                            "Any of the glycoproteins in blood serum that respond to invasion by foreign antigens and that protect the host by removing pathogens; an antibody."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69d0573-1cbf-4ac4-ba90-32b782ae35de",
                                "sense_id": "74c82d10-c361-33f9-b7b1-100ee15614f2",
                                "text": "The recent observation that a heat labile human immunoglobulin, IgE , could mediate the release of both histamine and SRS-Aᵐᵒⁿᵏᵉʸ from primate lung slices (Ishizaka et al., 1969), prompted a re-examination of the biologic activity of rat heat labile homocytotropic antibody."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc9c08fa-de8b-4d69-b595-5f96307308c0",
                        "source_entry_id": "39a8e95f-0453-3919-9e6d-54d55e33bc1e",
                        "source_sense_id": "74c82d10-c361-33f9-b7b1-100ee15614f2",
                        "source_sense_description": "glycoprotein protecting the host",
