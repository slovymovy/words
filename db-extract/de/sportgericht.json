                        "glosses": [
                            "Institution innerhalb von Verbänden und Vereinen unterschiedlicher Sportarten, die über Regelverstöße verhandeln und diese sanktionieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "006b64e7-1b53-441a-9637-fa9a6ba196e1",
                                "sense_id": "2bb6b4dc-bda4-349b-ba04-269dd97deb2e",
                                "text": "„Das Sportgericht des Deutschen Fußball-Bundes (DFB) hat Baris Özbek für mehrere Tätlichkeiten mit einer harten Strafe belegt.“"
                            },
                            {
                                "example_id": "eb600706-4c35-44eb-8597-ade0436f2c07",
                                "sense_id": "2bb6b4dc-bda4-349b-ba04-269dd97deb2e",
                                "text": "„Nachdem in den vergangenen Jahren bei den bayerischen Sportgerichten Tausende Vorfälle verhandelt werden mussten, bei denen überehrgeizige Eltern am Spielfeldrand ausgerastet waren, wurde für den Kreis München beschlossen, in der F-Jugend die Tabellen abzuschaffen.“"
                            },
                            {
                                "example_id": "20a2ffed-d14e-431b-b065-9863a353129b",
                                "sense_id": "2bb6b4dc-bda4-349b-ba04-269dd97deb2e",
                                "text": "„Das Sportgericht bestrafte Altglienicke unter anderem mit zwei Heimspielen ohne Zuschauer.“"
                            }
                        ],
