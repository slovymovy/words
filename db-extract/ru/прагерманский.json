                                "target_senses": [
                                    {
                                        "sense_id": "d71a2772-66cc-3f49-8830-c4b8a0720da6",
                                        "entry_id": "e1504e1c-1740-3961-a817-dd0eee9f6124",
                                        "glosses": [
                                            "der hypothetischen Vorläufersprache aller germanischen Sprachen zugehörig; auf das Urgermanische bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40b4c59-a209-4303-b018-9f2efbfcc02f",
                                                "sense_id": "d71a2772-66cc-3f49-8830-c4b8a0720da6",
                                                "text": "„Es gibt Hinweise, dass der Zusammenfall von Lokativ und (altem) Dativ in den Formen des urgermanischen Dativs nicht allzu lange vor Beginn der Überlieferung der germanischen Einzelsprachen geschehen ist, daher hat möglicherweise im Urgermanischen noch ein eigenständiger Lokativ existiert.“"
                                            },
                                            {
                                                "example_id": "2473ed65-27b1-4f93-beaa-7aa2d5b9d478",
                                                "sense_id": "d71a2772-66cc-3f49-8830-c4b8a0720da6",
                                                "text": "„Dem belegten germanischen Vergleichsmaterial gehen urgermanische und urnordische Rekonstruktionen voraus.“"
                                            },
                                            {
                                                "example_id": "474479b6-01b1-4fe1-95f5-c4d7d2bad98b",
                                                "sense_id": "d71a2772-66cc-3f49-8830-c4b8a0720da6",
                                                "text": "„Ich muss also dabei bleiben, dass schon urgermanisch sich ›-az‹, ›-iz‹, ›-uz‹ im Nominativ-Accusativ den Rang streitig machten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
