{
    "word_family": [
        "dominant",
        "dominance",
        "domination",
        "dominator",
        "dominion",
        "predominate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6acdab9d-ec4d-380a-8da7-7cc66c76b5df",
                    "sense_definition": "To govern, rule, or control by superior authority or power.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator sought to <w>dominate</w> the entire region through military force.",
                            "target_lang_translations": {
                                "ru": "Диктатор стремился <w>господствовать</w> во всем регионе с помощью военной силы."
                            }
                        },
                        {
                            "text": "One country should not <w>dominate</w> world politics at the expense of others.",
                            "target_lang_translations": {
                                "ru": "Одна страна не должна <w>доминировать</w> в мировой политике за счет других."
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "govern",
                        "control",
                        "command"
                    ],
                    "antonyms": [
                        "obey",
                        "submit"
                    ],
                    "common_phrases": [
                        "dominate the world",
                        "dominate the region"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять, править или контролировать с помощью превосходящей власти или силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господствовать",
                                "target_lang_sense_clarification": "иметь власть или подавляющее влияние"
                            },
                            {
                                "target_lang_word": "доминировать",
                                "target_lang_sense_clarification": "занимать лидирующее положение"
                            },
                            {
                                "target_lang_word": "властвовать",
                                "target_lang_sense_clarification": "осуществлять верховную власть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af24ba66-4b17-35a8-beff-f6a64726a7b5",
                    "sense_definition": "To enjoy a commanding position or be the most important feature in a particular field or activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team continued to <w>dominate</w> the game despite losing their best player.",
                            "target_lang_translations": {
                                "ru": "Команда продолжала <w>доминировать</w> в игре, несмотря на потерю своего лучшего игрока."
                            }
                        },
                        {
                            "text": "Large corporations often <w>dominate</w> the market and make it hard for small businesses.",
                            "target_lang_translations": {
                                "ru": "Крупные корпорации часто <w>господствуют</w> на рынке, затрудняя работу малому бизнесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "monopolize",
                        "prevail"
                    ],
                    "common_phrases": [
                        "dominate the market",
                        "dominate the game",
                        "dominate the conversation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать лидирующую позицию или быть наиболее важной чертой в определенной области или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминировать",
                                "target_lang_sense_clarification": "преобладать в какой-либо сфере"
                            },
                            {
                                "target_lang_word": "преобладать",
                                "target_lang_sense_clarification": "иметь количественный или качественный перевес"
                            },
                            {
                                "target_lang_word": "лидировать",
                                "target_lang_sense_clarification": "быть первым в соревновании или на рынке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa32310-a3d9-3a42-afab-8c19014a65d4",
                    "sense_definition": "To exert an overwhelming guiding influence over something or someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He allowed his fear of failure to <w>dominate</w> his life for many years.",
                            "target_lang_translations": {
                                "ru": "Он позволял страху неудачи <w>преобладать</w> в его жизни на протяжении многих лет."
                            }
                        },
                        {
                            "text": "The need for profit tends to <w>dominate</w> every decision the board makes.",
                            "target_lang_translations": {
                                "ru": "Потребность в прибыли, как правило, <w>определяет</w> каждое решение, принимаемое советом директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "influence",
                        "sway",
                        "overshadow"
                    ],
                    "common_phrases": [
                        "dominate his thoughts",
                        "dominate the discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать подавляющее направляющее влияние на что-либо или кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминировать",
                                "target_lang_sense_clarification": "быть основным мотивом или чувством"
                            },
                            {
                                "target_lang_word": "преобладать",
                                "target_lang_sense_clarification": "брать верх над другими чувствами или мыслями"
                            },
                            {
                                "target_lang_word": "овладевать",
                                "target_lang_sense_clarification": "полностью захватывать внимание или жизнь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1482cd8a-31f5-3de8-845b-47f8c69d4f98",
                    "sense_definition": "To be much taller or more visible than surrounding objects; to overlook from a height.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient cathedral continues to <w>dominate</w> the skyline of the city.",
                            "target_lang_translations": {
                                "ru": "Древний собор продолжает <w>возвышаться</w> над горизонтом города."
                            }
                        },
                        {
                            "text": "From the top of the hill, the castle <w>dominates</w> the valley below.",
                            "target_lang_translations": {
                                "ru": "С вершины холма замок <w>господствует</w> над долиной внизу."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlook",
                        "tower over"
                    ],
                    "common_phrases": [
                        "dominate the skyline",
                        "dominate the landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть намного выше или заметнее окружающих объектов; возвышаться над чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господствовать",
                                "target_lang_sense_clarification": "возвышаться над местностью"
                            },
                            {
                                "target_lang_word": "возвышаться",
                                "target_lang_sense_clarification": "быть выше окружающих строений"
                            },
                            {
                                "target_lang_word": "доминировать",
                                "target_lang_sense_clarification": "выделяться на фоне ландшафта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f2b76f-ffe0-35a3-b08b-7e20ae56a7ac",
                    "sense_definition": "To precede another node of a directed graph in all paths from the start of the graph to the other node.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this flow graph, node A <w>dominates</w> node B because every path to B goes through A.",
                            "target_lang_translations": {
                                "ru": "В этом графе потока узел А <w>доминирует</w> над узлом B, потому что каждый путь к B проходит через A."
                            }
                        },
                        {
                            "text": "We need to identify which blocks <w>dominate</w> others to optimize the compiler code.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить, какие блоки <w>доминируют</w> над другими, чтобы оптимизировать код компилятора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предшествовать другому узлу в ориентированном графе на всех путях от начала графа к этому узлу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминировать",
                                "target_lang_sense_clarification": "в теории графов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07eb47fe-a5cf-3edb-99c3-248c8d2c168d",
                    "sense_definition": "A non-standard or dialectal variant of <w>dominant</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older texts, the word is used as a <w>dominate</w> species in the local fauna.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах это слово используется для обозначения <w>доминирующего</w> вида в местной фауне."
                            }
                        },
                        {
                            "text": "She described herself as a <w>dominate</w> personality in her personal advertisements.",
                            "target_lang_translations": {
                                "ru": "В своих личных объявлениях она описывала себя как <w>доминантную</w> личность."
                            }
                        }
                    ],
                    "synonyms": [
                        "dominant"
                    ],
                    "common_phrases": [
                        "dominate species",
                        "dominate type"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "often considered a misspelling of dominant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестандартный или диалектный вариант слова dominant (доминантный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доминирующий",
                                "target_lang_sense_clarification": "преобладающий"
                            },
                            {
                                "target_lang_word": "господствующий",
                                "target_lang_sense_clarification": "основной"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e065c5e9-5103-3bde-8c2d-4f719b4cb6d3",
                    "sense_definition": "The late period of the Roman Empire, following the principate, characterized by autocratic rule.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The transition to the <w>Dominate</w> marked the end of the traditional Roman Republic vestiges.",
                            "target_lang_translations": {
                                "ru": "Переход к <w>Доминату</w> ознаменовал конец пережитков традиционной Римской республики."
                            }
                        },
                        {
                            "text": "Historians study the <w>Dominate</w> to understand the shift toward absolute monarchy in Rome.",
                            "target_lang_translations": {
                                "ru": "Историки изучают <w>Доминат</w>, чтобы понять переход к абсолютной монархии в Риме."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поздний период Римской империи, следующий за принципатом, характеризующийся самодержавным правлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Доминат",
                                "target_lang_sense_clarification": "исторический период в Древнем Риме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}