                "senses": [
                    {
                        "sense_id": "ed16b924-3f7b-3dd1-ae4a-f9b394e04c51",
                        "entry_id": "7f8bc6f8-8270-3ab3-90b8-d46bd337a1b5",
                        "glosses": [
                            "Personal einer Fluggesellschaft das sich während eines Fluges im Cockpit befindet"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "9b8e144d-36d7-41a3-8f3c-92524a5fdfc5",
                                "sense_id": "ed16b924-3f7b-3dd1-ae4a-f9b394e04c51",
                                "text": "„Vor allem die gefundenen Reste von Schrapnellen in den Leichnamen der Cockpitbesatzung hätten die Kommission zu der Einschätzung geführt.“"
                            },
                            {
                                "example_id": "0708a49b-a427-47eb-8fe7-ee6ba4ad8cd7",
                                "sense_id": "ed16b924-3f7b-3dd1-ae4a-f9b394e04c51",
                                "text": "„Die Cockpitbesatzung kann sich dann über die Impulse der Elektronik hinweg setzen.“"
                            },
                            {
                                "example_id": "c5c455c1-1171-4c97-8f51-d9dfc31999ef",
                                "sense_id": "ed16b924-3f7b-3dd1-ae4a-f9b394e04c51",
                                "text": "„Vonnöten sind Cockpitbesatzungen, die laufend auf ihre Fähigkeiten und Ressourcen geprüft und später entsprechend begleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
