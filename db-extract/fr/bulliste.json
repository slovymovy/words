                        "glosses": [
                            "Religieux d'une congrégation de l'ordre de Saint-François."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6595b8b1-aa2a-4bef-94e6-3044e7e84d56",
                                "sense_id": "2fc2aa3f-1b00-38a5-ab87-363c01db7262",
                                "text": "Autrefois à Avignon il suffisoit de s'adresser à un bulliste, ou d'écrire à un ami qui lui exposoit, sans nommer le suppliant, le cas dont il s'agissoit ; et ce bulliste procuroit le bref de la pénitencerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "54acfb5c-330e-3759-8ab1-22d53eb8f181",
                        "entry_id": "9e9f9fb3-839b-3491-af3f-d4761ef0bdc7",
                        "glosses": [
                            "Conducteur de bulldozer, de bouteur."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffe83a0-59ac-4d54-9641-3d3f00ab10b8",
                                "sense_id": "54acfb5c-330e-3759-8ab1-22d53eb8f181",
                                "text": "J'ai commencé par être bulliste. J'ai été formé sur le tas comme on dit par des chauffeurs d'engins qualifiés. Au départ je regardais comment ils faisaient."
                            },
                            {
                                "example_id": "ff8cf23b-5e55-4099-b8d8-bda77e61768e",
                                "sense_id": "54acfb5c-330e-3759-8ab1-22d53eb8f181",
                                "text": "Il était bulliste, conducteur de bulldozer. La puissance de son engin rejaillissait sur lui, il savait dominer les monstres des Blancs."
                            },
                            {
                                "example_id": "818d1985-ca5b-4aa5-aa8e-cac1d6685a9e",
                                "sense_id": "54acfb5c-330e-3759-8ab1-22d53eb8f181",
                                "text": "Il veut reconnaître la piste plus en avant pour juger du boulot qui attend encore notre bulliste."
                            }
                        ]
                    }
