                        "target_lang_word": "komora gazowa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "komora gazowa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4504d105-5479-384b-ad8a-fb49c9c8e499",
                                        "entry_id": "4b307ebd-0113-311f-9d31-30e425470fb0",
                                        "glosses": [
                                            "urządzenie służące do wykonywania kary śmierci przez zagazowanie skazańca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54bbd047-ca72-42e1-8cc8-cce6235b8f71",
                                                "sense_id": "4504d105-5479-384b-ad8a-fb49c9c8e499",
                                                "text": "W obozie koncentracyjnym Auschwitz istniało sześć komór gazowych."
                                            }
