                        "target_lang_word": "sac de nœuds",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sac de nœuds",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a221d10-6ede-3920-8f5e-3d94d0a7142c",
                                        "entry_id": "cfaf4cd2-776f-35c0-a20e-50b15373019a",
                                        "glosses": [
                                            "Situation embrouillée, confuse, qu’il paraît difficile, voire impossible de tirer au clair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c48a42-6d70-4a9e-8e1a-f661cd34e582",
                                                "sense_id": "9a221d10-6ede-3920-8f5e-3d94d0a7142c",
                                                "text": "Cette affaire de faux commence à devenir marrante et intéressante. C’est un tel sac de nœuds que bientôt je sens que je vais m’inculper de complicité."
                                            },
                                            {
                                                "example_id": "6bd408f9-db57-419f-b908-f04c4d6224e9",
                                                "sense_id": "9a221d10-6ede-3920-8f5e-3d94d0a7142c",
                                                "text": "« Alors, comme ça, tu remontes la Marne ? Qu’est-ce que tu cherches ? Le sac de nœuds ? »"
                                            },
                                            {
                                                "example_id": "520cb552-65d5-4418-8a74-41c41e27280b",
                                                "sense_id": "9a221d10-6ede-3920-8f5e-3d94d0a7142c",
                                                "text": "Où avait-il donc la tête quand il avait décidé de se laisser entraîner dans ce sac de nœuds ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
