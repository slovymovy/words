{
    "word_family": [
        "sunrise",
        "sundown"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a218aec3-d698-35a9-be21-a4749f0735cc",
                    "sense_definition": "The moment each evening when the sun disappears below the western horizon.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on the beach to watch the beautiful <w>sunset</w>.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на пляже и смотрели на красивый <w>закат</w>.",
                                "zh": "我们坐在沙滩上观看美丽的<w>日落</w>。"
                            }
                        },
                        {
                            "text": "The park gates close at <w>sunset</w> every day.",
                            "target_lang_translations": {
                                "ru": "Ворота парка закрываются на <w>закате</w> каждый день.",
                                "zh": "公园大门每天在<w>日落</w>时关闭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sundown",
                        "nightfall",
                        "dusk",
                        "twilight"
                    ],
                    "antonyms": [
                        "sunrise"
                    ],
                    "common_phrases": [
                        "at sunset",
                        "watch the sunset",
                        "golden sunset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время вечером, когда солнце опускается за западный горизонт.",
                        "zh": "傍晚时分，太阳落入地平线以下的时候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "время суток или явление"
                            },
                            {
                                "target_lang_word": "заход солнца",
                                "target_lang_sense_clarification": "астрономическое событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日落",
                                "target_lang_sense_clarification": "指太阳落下的自然现象"
                            },
                            {
                                "target_lang_word": "夕阳",
                                "target_lang_sense_clarification": "指傍晚的太阳或其光辉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4e5f34b-a35d-387f-841a-a3eff879a5ab",
                    "sense_definition": "The final period of the life of a person, era, or thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote his best poetry in the <w>sunset</w> of his life.",
                            "target_lang_translations": {
                                "ru": "Он написал свои лучшие стихи на <w>закате</w> жизни.",
                                "zh": "他在<w>晚年</w>写出了他最好的诗篇。"
                            }
                        },
                        {
                            "text": "The company is entering the <w>sunset</w> of its existence.",
                            "target_lang_translations": {
                                "ru": "Компания вступает в период <w>заката</w> своего существования.",
                                "zh": "这家公司正步入其存在的<w>末期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "end",
                        "swansong",
                        "final act"
                    ],
                    "common_phrases": [
                        "sunset years",
                        "sunset of life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительный период жизни человека, эпохи или существования чего-либо.",
                        "zh": "指人、时代或事物生命周期的最后阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "переносное значение: конец, упадок"
                            },
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "завершение периода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚年",
                                "target_lang_sense_clarification": "指人生的最后阶段"
                            },
                            {
                                "target_lang_word": "末期",
                                "target_lang_sense_clarification": "指事物或时代的最后阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd4f69b8-b1f1-3b81-a592-1f0c973605d9",
                    "sense_definition": "A set termination date for a law, contract, or program.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new legislation includes a <w>sunset</w> clause that expires in five years.",
                            "target_lang_translations": {
                                "ru": "Новый закон включает положение о <w>прекращении действия</w>, которое вступает в силу через пять лет.",
                                "zh": "新法规包含一条五年后<w>失效</w>的条款。"
                            }
                        },
                        {
                            "text": "Funding for the project has a strict <w>sunset</w> date attached to it.",
                            "target_lang_translations": {
                                "ru": "Финансирование проекта имеет строгую дату <w>окончания</w>.",
                                "zh": "该项目的资金有严格的<w>终止日期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "end"
                    ],
                    "common_phrases": [
                        "sunset clause",
                        "sunset date",
                        "sunset provision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленная дата прекращения действия закона, контракта или программы.",
                        "zh": "法律、合同或项目预设的终止日期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращение действия",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "окончание срока",
                                "target_lang_sense_clarification": "временной предел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失效条款",
                                "target_lang_sense_clarification": "法律中规定自动失效的条款"
                            },
                            {
                                "target_lang_word": "终止日期",
                                "target_lang_sense_clarification": "合同或项目结束的期限"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad563b94-9c13-3fcf-90cf-28394e217b1d",
                    "sense_definition": "To phase out or discontinue a product, service, or program.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>sunset</w> the old software version next month.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>прекратить поддержку</w> старой версии программного обеспечения в следующем месяце.",
                                "zh": "公司计划下个月<w>停止支持</w>旧版软件。"
                            }
                        },
                        {
                            "text": "They will <w>sunset</w> the service because very few people use it.",
                            "target_lang_translations": {
                                "ru": "Они <w>выведут из эксплуатации</w> этот сервис, потому что им пользуется очень мало людей.",
                                "zh": "由于使用人数很少，他们将<w>淘汰</w>这项服务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "end"
                    ],
                    "common_phrases": [
                        "sunset a product",
                        "sunset the software"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поэтапно прекращать производство или поддержку продукта, услуги или программы.",
                        "zh": "逐步淘汰或停止提供某项产品、服务或程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить из эксплуатации",
                                "target_lang_sense_clarification": "о сервисах и продуктах"
                            },
                            {
                                "target_lang_word": "прекращать поддержку",
                                "target_lang_sense_clarification": "о программном обеспечении"
                            },
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "о проекте или программе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淘汰",
                                "target_lang_sense_clarification": "指停止使用旧产品或服务"
                            },
                            {
                                "target_lang_word": "停止支持",
                                "target_lang_sense_clarification": "指软件或服务的终止维护"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}