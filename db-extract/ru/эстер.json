                                        "glosses": [
                                            "A book of the Old Testament and the Hebrew Tanakh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "115e9f81-6962-3828-8369-2f3f7286c63c",
                                        "entry_id": "df408ae9-39f8-313f-b246-2824601bf56e",
                                        "glosses": [
                                            "The heroine of the Book of Esther."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552bcc86-3aef-43e8-adc3-1dc420cc9cbb",
                                                "sense_id": "115e9f81-6962-3828-8369-2f3f7286c63c",
                                                "text": "And he brought up Hadassah, that is, Esther, his uncle's daughter: for she had neither father or mother, and the maiden was fair and beautiful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
