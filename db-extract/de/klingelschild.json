                "senses": [
                    {
                        "sense_id": "dbf9e091-4009-3a8e-a2e3-2ea362f9ccbf",
                        "entry_id": "30d17ee3-4fda-361c-81a1-6c6c079f8db4",
                        "glosses": [
                            "am Eingang zu einem Gebäude/Grundstück angebrachtes Schild, auf dem sich der Name der Person/der Firma sowie der Taster (Klingelknopf) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a31a0c-5c35-4c65-928c-014aaa9437e8",
                                "sense_id": "dbf9e091-4009-3a8e-a2e3-2ea362f9ccbf",
                                "text": "„In manchen Teilen des Regierungsviertels findet sich kaum noch ein Klingelschild, an dem nicht mindestens eine Interessenvertretung ihr Kürzel angebracht hat.“"
                            },
                            {
                                "example_id": "16e307e2-b50f-421b-aebc-8990fac8c82e",
                                "sense_id": "dbf9e091-4009-3a8e-a2e3-2ea362f9ccbf",
                                "text": "„Und auf dem Klingelschild steht Schörg-Oppowa.“"
                            },
                            {
                                "example_id": "895ee4f8-996c-4484-87ef-af839bd8353e",
                                "sense_id": "dbf9e091-4009-3a8e-a2e3-2ea362f9ccbf",
                                "text": "„Laut Klingelschildern wohnten zwei Parteien hier, im ersten und zweiten Stock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
