                                    {
                                        "sense_id": "936fab0f-bf39-3c5b-8d48-bf4349f8ae9b",
                                        "entry_id": "4f5954bd-1e5a-3bd4-9c7e-c47d6b25af36",
                                        "glosses": [
                                            "etwas oder jemanden geringschätzen/verabscheuen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870e7d7c-3681-487f-b89e-705ca9d7533d",
                                                "sense_id": "936fab0f-bf39-3c5b-8d48-bf4349f8ae9b",
                                                "text": "Der Bürgermeister erklärte, dass man Fremdenfeindlichkeit verachtet und alles tun werde, um das Problem in den Griff zu bekommen."
                                            },
                                            {
                                                "example_id": "ac87eb56-66a2-4760-9b79-320738afb694",
                                                "sense_id": "936fab0f-bf39-3c5b-8d48-bf4349f8ae9b",
                                                "text": "„Erst werden die Menschen unters Joch gezwungen und dann als knechtisch verachtet, unterdrückt und dann von oben herab behandelt, verdummt und ihrer Dummheit wegen verhöhnt, versklavt und als Sklaven geschmäht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bde75b5-b79a-4cab-a102-a97e06c81dbd",
