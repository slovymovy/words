                "senses": [
                    {
                        "sense_id": "11b82be6-9a9f-3d76-a88e-ffbd9b06b4b1",
                        "entry_id": "6612902a-1a74-3b57-b0c8-aceb084447e8",
                        "glosses": [
                            "Qui manifeste une vivacité gaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13be51c6-3ed0-4e39-861f-9367bf8c54c6",
                                "sense_id": "11b82be6-9a9f-3d76-a88e-ffbd9b06b4b1",
                                "text": "Laisse-moi tenir ton jupon\nCourons, guilleret, guillerette"
                            },
                            {
                                "example_id": "7bbb7d7e-a1aa-4f55-be7a-2dbbf22e86b0",
                                "sense_id": "11b82be6-9a9f-3d76-a88e-ffbd9b06b4b1",
                                "text": "Martine la Missionnaire Possible sauta du lit plus guillerette qu’à l’ordinaire, même si elle se sentait, comme chaque matin, troublée."
                            },
                            {
                                "example_id": "02b9a88e-090e-46a0-8522-13a601945fe8",
                                "sense_id": "11b82be6-9a9f-3d76-a88e-ffbd9b06b4b1",
                                "text": "Cette entrée fracassante et guillerette de Jamel au petit matin est un fantastique réveil matin."
                            },
                            {
                                "example_id": "680cf73c-a2c2-47e6-be09-00d2db16b7b6",
                                "sense_id": "11b82be6-9a9f-3d76-a88e-ffbd9b06b4b1",
                                "text": "— On t'a dit que ce cher Flavio et son camarade bas du front avaient décroché un aller simple pour la morgue ? ai-je demandé d'un ton guilleret."
                            }
                        ]
                    },
                    {
                        "sense_id": "769fe7df-57a3-36d5-b17e-7d13b31eb6b8",
                        "entry_id": "6612902a-1a74-3b57-b0c8-aceb084447e8",
                        "glosses": [
                            "Qui donne une impression de gaîté."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "53f36ff9-510f-4a13-8ac7-4b3ebf2e6021",
                                "sense_id": "769fe7df-57a3-36d5-b17e-7d13b31eb6b8",
                                "text": "Un conte guilleret."
                            },
                            {
                                "example_id": "ba73b200-6e0c-4152-b5ee-9a8f37cbd09d",
                                "sense_id": "769fe7df-57a3-36d5-b17e-7d13b31eb6b8",
                                "text": "Mais comme c’était un gars solide, dont le coffre était bon, à peine s’il avait les jambes guillerettes, quand ils revenaient au soir, seul à seule, dans le grand silence des campagnes."
                            }
                        ]
                    }
                ],
