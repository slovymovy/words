{
    "word_family": [
        "plainte",
        "plaintif",
        "complainte",
        "plaignant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ebf0886-1e05-3c1e-a292-8d20b298d88e",
                    "sense_definition": "Exprimer sa douleur, son mécontentement ou ses griefs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voisin est venu se <w>plaindre</w> du bruit causé par les travaux dans la rue."
                        },
                        {
                            "text": "Elle a des raisons valables, mais elle préfère agir plutôt que de se <w>plaindre</w> constamment."
                        }
                    ],
                    "common_phrases": [
                        "se plaindre de tout"
                    ]
                },
                {
                    "sense_id": "8f6a7382-fd98-3b63-911d-918530798903",
                    "sense_definition": "Éprouver de la compassion ou de la pitié pour les souffrances d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>plains</w> sincèrement ces sinistrés qui ont tout perdu dans les inondations."
                        },
                        {
                            "text": "Cet homme a perdu son travail et sa maison, il est vraiment à <w>plaindre</w>."
                        }
                    ],
                    "antonyms": [
                        "envier"
                    ],
                    "common_phrases": [
                        "être à plaindre",
                        "plaindre son sort"
                    ]
                },
                {
                    "sense_id": "2614ba4e-3eec-3b38-bd0d-482da2aafadf",
                    "sense_definition": "Donner, accorder ou dépenser quelque chose avec regret ou parcimonie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les bénévoles n'ont pas <w>plaint</w> leur peine pour nettoyer le parc communal ce week-end."
                        },
                        {
                            "text": "Pour réussir ce projet difficile, elle n'a pas <w>plaint</w> son temps ni son énergie."
                        }
                    ],
                    "synonyms": [
                        "ménager"
                    ],
                    "common_phrases": [
                        "ne pas plaindre sa peine",
                        "ne pas plaindre son temps"
                    ]
                }
            ]
        }
    ]
}