                                "example_id": "5d30d168-89ba-4539-9204-bc64a8c1711f",
                                "sense_id": "39c9a455-22a1-362e-ac54-8a6ab82c6cd5",
                                "text": "A jużci, obaczą nauczycielkę, kiedy tutejszym włosy na dłoni wyrosną! Niedoczekanie wsioków!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
