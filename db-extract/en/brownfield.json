                        "entry_id": "b446ed47-f909-307b-8d97-0c7b05a67412",
                        "glosses": [
                            "A site, to be used for housing or commerce, that has been previously used for industry and may be contaminated or need extensive clearing."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "a657019a-1d60-49c4-a623-06144bcf3220",
                                "sense_id": "899910b4-175c-3bbd-8936-610254d1d1cc",
                                "text": "My budget will improve our environment by accelerating the cleanup of toxic brownfields."
                            },
                            {
                                "example_id": "fef0b219-20be-4ae5-b1f4-74e1f1ef8707",
                                "sense_id": "899910b4-175c-3bbd-8936-610254d1d1cc",
                                "text": "On such a densely-populated island, most infrastructure projects are on brownfield sites, rather than starting in pastures new."
                            },
                            {
                                "example_id": "f4fcc59c-05ae-488e-9b1a-8007c3772387",
                                "sense_id": "899910b4-175c-3bbd-8936-610254d1d1cc",
                                "text": "The depot will occupy a 75-acre brownfield site."
                            }
                        ]
                    }
