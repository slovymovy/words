                                    {
                                        "sense_id": "c44c65ae-8942-3c66-8550-d765f37db298",
                                        "entry_id": "0ac663e4-5bcf-3c70-9b9e-c591e365711c",
                                        "glosses": [
                                            "ein urzeitliches Denkmal aus einem großen, rohen Stein, das meist als Grab oder Kultstätte diente"
                                        ],
                                        "tags": [
                                            "Archäologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20355161-377d-433e-bf9d-7ddd6f43f3cb",
                                                "sense_id": "c44c65ae-8942-3c66-8550-d765f37db298",
                                                "text": "Jeder aufgestellte Stein oder Megalith ist ein Symbol für einen Ahnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
