                "senses": [
                    {
                        "sense_id": "e4dc4ee1-31e3-35e9-8618-a7c2e6379470",
                        "entry_id": "c1f80fc2-8e59-31fa-9aab-c8264320c672",
                        "glosses": [
                            "разг. горячо любимая женщина; возлюбленная"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "655ce608-b7d7-4c66-b2cd-cd4f768b7c4a",
                                "sense_id": "e4dc4ee1-31e3-35e9-8618-a7c2e6379470",
                                "text": "Милку находят, жену выбирают, говорит народ, и Лилия, хоть и не знала этой пословицы, душой чувствовала её правоту."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6d55399-0eac-3f76-b19b-1a73c7cc1c1a",
                        "entry_id": "c1f80fc2-8e59-31fa-9aab-c8264320c672",
                        "glosses": [
                            "ласк., фам. обращение к женщине, девушке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73dfb4f1-c8d1-41e0-8978-ed01f9a4c0f9",
                                "sense_id": "b6d55399-0eac-3f76-b19b-1a73c7cc1c1a",
                                "text": "― Так он же, милка моя, по профессии театральный художник, бутафор!"
                            }
                        ]
                    }
                ],
