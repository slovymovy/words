                                        "entry_id": "a18002f6-f8eb-39ca-9cdf-b7d652bf139d",
                                        "glosses": [
                                            "The noisy banging of pots and pans as a mock serenade to a newly married couple, or similar occasion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fa2b75-2c52-419c-9e9b-395605a3abb1",
                                                "sense_id": "74018a15-47d7-3ddf-ad98-ac2c22bab53f",
                                                "text": "The marriage ceremony was given primordial significance over folkloric pre-marriage engagement rituals and wild charivaris."
                                            }
                                        ]
                                    },
