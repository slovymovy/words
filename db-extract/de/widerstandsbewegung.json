                "senses": [
                    {
                        "sense_id": "53f08085-0df5-30ab-b295-93f459e4be3c",
                        "entry_id": "59b20953-beb3-3846-9999-79f3e20d699f",
                        "glosses": [
                            "Gruppe von Menschen, die sich gemeinsam aktiv gegen etwas wendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042645b9-f3b9-4136-a5c7-c15c014750da",
                                "sense_id": "53f08085-0df5-30ab-b295-93f459e4be3c",
                                "text": "„Die Legende, die uns so oft in die Irre führt, behauptete steif und fest, alle Widerstandsbewegungen und Befreiungskriege wären hier im Bahnhof zwischen zwei Lokomotiven aufgekeimt.“"
                            },
                            {
                                "example_id": "9fe17bbd-8e33-42ef-9c45-0e1a33f68193",
                                "sense_id": "53f08085-0df5-30ab-b295-93f459e4be3c",
                                "text": "„Er war zwischen 1939 und 1942 vergleichsweise stark; spätestens mit dem Eintreffen Heydrichs rollte die Gestapo die Widerstandsbewegungen auf.“"
                            },
                            {
                                "example_id": "8ddbd7cd-d7c0-4fcc-ab6d-a6001d3da3cf",
                                "sense_id": "53f08085-0df5-30ab-b295-93f459e4be3c",
                                "text": "„In diesem Winter wurde die Widerstandsbewegung in Frankreich immer stärker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
