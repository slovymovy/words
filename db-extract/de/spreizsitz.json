                ],
                "senses": [
                    {
                        "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                        "entry_id": "c954b7ed-5763-338d-b805-7879f836f7d6",
                        "glosses": [
                            "Sitzposition, bei der die Beine weit gespreizt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6f3b25-f616-47f9-a087-78a4b9b9063a",
                                "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                                "text": "„Dank eines Spreizsitzes und einer Stütze für Ihren Oberkörper können Sie mit diesem ‚ Larry Scott-Schreibtisch ‚ Unterarmcurls ausführen, während Sie Hanteln oder eine Langhantel halten.“"
                            },
                            {
                                "example_id": "eff4a36f-4d7a-4f54-9dea-934305dda9ff",
                                "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                                "text": "„Auch Menschen mit Behinderung, die im Spreizsitz nicht sitzen können, zählen zu Viola Ebbeckes Kundenstamm.“"
                            },
                            {
                                "example_id": "edddde02-1741-4b2f-baff-6fa8177cc741",
                                "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                                "text": "„Ausführung: Setze dich im Spreizsitz auf den Boden und wickle ein elastisches Band um deinen Fußrücken.“"
                            },
                            {
                                "example_id": "21d0fbf3-2b3e-4c7d-ac90-5b068ada3038",
                                "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                                "text": "„Für alle [sic !] die der Ansicht sind, dass eine Dame nicht im Spreizsitz zu reiten hat, sei ein Blick in das Buch ‚Im Gefolge Dianas, Frauen und höfische Jagd im Mittelalter (1200–1500)‘ von Katharina Fietze empfohlen.“"
                            },
                            {
                                "example_id": "21e24c39-67be-4a4c-9192-a2bd3faad43c",
                                "sense_id": "35737b24-ef6f-35e7-a607-c20c66432bb2",
                                "text": "„So kommt Ihr Kind automatisch in den vom Kinderarzt empfohlenen Spreizsitz und kann sich eng an Ihren Körper schmiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
