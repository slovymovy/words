                "senses": [
                    {
                        "sense_id": "c046353e-3e76-334c-8124-5c84bcfaf0b4",
                        "entry_id": "d010a4e7-179c-3f47-a933-1fec536c06fd",
                        "glosses": [
                            "Sprachstil, der unter bestimmten, definierten Kommunikationsbedingungen zustande kommt und als funktional angemessen gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d79af78-f427-488f-b719-185777db800d",
                                "sense_id": "c046353e-3e76-334c-8124-5c84bcfaf0b4",
                                "text": "„Riesel unterscheidet fünf verschiedene Funktionalstile, die sie, L. Doležel folgend, mit zweckhaften Benennungen umschreibt, wobei der »Stil der Presse und Publizistik« ohne weitere Kennzeichnung bleibt (1975, S. 50 f.): 1. Stil der öffentlichen Rede: Direktivstil; 2. Stil der Wissenschaft: Erkenntnisstil; 3. Stil der Presse und Publizistik; 4. Stil der Alltagsrede: Konversationsstil; 5. Stil der schönen Literatur: künstlerischer Stil.“"
                            },
                            {
                                "example_id": "e2bbd9a1-a9b5-4e4f-bb99-718a5e8fbc02",
                                "sense_id": "c046353e-3e76-334c-8124-5c84bcfaf0b4",
                                "text": "„Die hier zu verwendenden Kategorien ›Register‹ und ›Funktionalstil‹ werden unten näher beschrieben.“"
                            },
                            {
                                "example_id": "1b7e0ce3-1b11-400e-a81d-123b930a7446",
                                "sense_id": "c046353e-3e76-334c-8124-5c84bcfaf0b4",
                                "text": "„Der Begriff »Funktionalstil« seinerseits wird in der Stilistik dem des »Stiltypus« untergeordnet (»Stiltypus«: »die unter einem bestimmten Aspekt erfolgende Abstraktion und Zusammenfassung der für mehrere Stile gemeinsamen Stilzüge«) oder dem des »Typus der Redeweise«…“"
                            },
                            {
                                "example_id": "e2e8a5e1-3346-4039-a9a0-2a2b61b2562c",
                                "sense_id": "c046353e-3e76-334c-8124-5c84bcfaf0b4",
                                "text": "„Man vergleiche diese Ausdrücke mit einigen Funktionalstilen, die im Gefolge der Prager Schule etabliert wurden…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
