    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04c7af0a-7a4c-3173-9c2a-e5a448dfa1dc",
                    "sense_definition": "To identify or locate something precisely or with great accuracy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators tried to <w>pinpoint</w> the source of the flames.",
                            "target_lang_translations": {
                                "pl": "Śledczy próbowali <w>precyzyjnie zlokalizować</w> źródło płomieni."
                            }
                        },
                        {
                            "text": "It is difficult to <w>pinpoint</w> exactly when the error occurred.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>precyzyjnie określić</w>, kiedy dokładnie wystąpił błąd."
                            }
                        }
                    ],
                    "synonyms": [
                        "locate",
                        "identify",
                        "spot"
                    ],
                    "common_phrases": [
                        "pinpoint the cause",
                        "pinpoint the location"
                    ],
                    "target_lang_definitions": {
                        "pl": "Precyzyjnie określić, zlokalizować lub zidentyfikować coś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "precyzyjnie określić",
                                "target_lang_sense_clarification": "w odniesieniu do czasu lub przyczyny"
                            },
                            {
                                "target_lang_word": "zlokalizować",
                                "target_lang_sense_clarification": "w odniesieniu do miejsca lub źródła"
                            },
                            {
                                "target_lang_word": "wskazać",
                                "target_lang_sense_clarification": "wskazać coś z dużą dokładnością"
                            }
                        ]
                    }
                }
            ]
        },
        {
