                ],
                "senses": [
                    {
                        "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                        "entry_id": "66a1ec85-7224-3bb4-a127-774bb09608dc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e3e5b4a-a373-4ea4-94a8-f58fb1e3e7c2",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Frau Deppe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1125c464-0ad6-4023-bcf4-b7aaaca0b821",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Herr Deppe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a8e14486-b387-416a-909c-a7479281f0d0",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Die Deppes fahren heute nach Karlsruhe."
                            },
                            {
                                "example_id": "c28960e1-0ce7-4814-8d04-56cbc793ca8e",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Der Deppe trägt nie die Schals, die die Deppe ihm strickt."
                            },
                            {
                                "example_id": "a0ec9ffa-232d-43a5-86bb-ff4387682f89",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Deppe kommt, geht der Herr Deppe.“"
                            },
                            {
                                "example_id": "205c2607-e30c-43a6-8f41-8809fab89011",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Deppe kommt und geht."
                            },
                            {
                                "example_id": "3af3708e-164b-4aec-90a6-c26f6bf70d20",
                                "sense_id": "68905395-2e9c-393f-b771-e1026c9d382d",
                                "text": "Deppes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
