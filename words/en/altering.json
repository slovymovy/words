                    "frequency": "VeryLow",
                    "semantic_group_id": "alter_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repeated <w>altering</w> of the text made it difficult to follow the original meaning.",
                            "target_lang_translations": {
                                "de": "Das wiederholte <w>Ändern</w> des Textes machte es schwer, der ursprünglichen Bedeutung zu folgen."
                            }
                        },
                        {
                            "text": "Any unnecessary <w>altering</w> of the design will only add unwanted costs to the project.",
                            "target_lang_translations": {
                                "de": "Jede unnötige <w>Änderung</w> des Designs wird das Projekt nur mit unerwünschten Kosten belasten."
                            }
                        }
