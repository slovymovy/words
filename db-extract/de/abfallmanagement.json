                        "examples": [
                            {
                                "example_id": "6b7806c4-26c9-409e-9493-e0c8d4f8288d",
                                "sense_id": "8530b6a8-7cd5-3aec-b446-1e36ee4b24d4",
                                "text": "„In vielen Ländern seien die Stadtverwaltungen überfordert, nur mit Hilfe von außen werden sie ein vernünftiges Abfallmanagement aufbauen können, mahnt die Weltbank.“"
                            },
                            {
                                "example_id": "5deffdf3-7b8f-4f26-b793-7897669c0298",
                                "sense_id": "8530b6a8-7cd5-3aec-b446-1e36ee4b24d4",
                                "text": "„Vor allem auf Schiffen und in der Fischerei müsse es ein besseres Abfallmanagement geben, fordern die Wissenschaftlerinnen.“"
                            }
                        ],
