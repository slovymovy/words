                        "glosses": [
                            "Relatif à la photopériode et au photopériodisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2892c9-175c-4464-8291-9671df951593",
                                "sense_id": "02190837-b549-3503-ae85-3742a8a506a6",
                                "text": "Les tubes fluorescents sont adaptés à l'étude de la photosynthèse en phytotron ; leur faible température de surface permet de les placer à proximité des plantes. Elles peuvent être utilisées en serre pour des éclairages photopériodiques."
                            },
                            {
                                "example_id": "766820f7-8f3a-4458-98f0-b2d06c10a83c",
                                "sense_id": "02190837-b549-3503-ae85-3742a8a506a6",
                                "text": "On a bien plus étudié le contrôle photopériodique de la reproduction que celui de la migration, mais certains principes sont les mêmes."
                            }
                        ]
                    }
