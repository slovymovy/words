{
    "word_family": [
        "плохой",
        "плохо",
        "плохость"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c374d8f7-96d0-3875-8bc1-d32889379e0f",
                    "sense_definition": "Низкого качества, посредственный или неважный (уменьшительно-уничижительная форма от слова плохой).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Даже самый <w>плохонький</w> инструмент лучше, чем полное отсутствие возможности работать.",
                            "target_lang_translations": {
                                "pl": "Nawet <w>najlichsze</w> narzędzie jest lepsze niż całkowity brak możliwości pracy."
                            }
                        },
                        {
                            "text": "Он купил себе <w>плохонький</w> домик на окраине города, но был очень доволен покупкой.",
                            "target_lang_translations": {
                                "pl": "Kupił sobie <w>marny</w> domek na obrzeżach miasta, ale był bardzo zadowolony z zakupu."
                            }
                        }
                    ],
                    "synonyms": [
                        "посредственный",
                        "неважный"
                    ],
                    "antonyms": [
                        "хороший"
                    ],
                    "common_phrases": [
                        "плохонький домик",
                        "плохонький инструмент"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niskiej jakości, przeciętny lub marny (zdrobniała, lekceważąca forma słowa 'zły')."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "marny",
                                "target_lang_sense_clarification": "o niskiej jakości lub wartości"
                            },
                            {
                                "target_lang_word": "lichy",
                                "target_lang_sense_clarification": "o czymś słabym, kiepskim"
                            },
                            {
                                "target_lang_word": "kiepski",
                                "target_lang_sense_clarification": "potoczne określenie czegoś słabego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b91f9af-f6b0-3615-ab6b-a6f998f5a23b",
                    "sense_definition": "Слабый, не обладающий достаточной силой или здоровьем.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребенок родился совсем <w>плохонький</w>, поэтому врачи долго боролись за его жизнь.",
                            "target_lang_translations": {
                                "pl": "Dziecko urodziło się bardzo <w>słabe</w>, dlatego lekarze długo walczyli o jego życie."
                            }
                        },
                        {
                            "text": "После долгой болезни он выглядел совсем <w>плохоньким</w> и уставшим.",
                            "target_lang_translations": {
                                "pl": "Po długiej chorobie wyglądał na bardzo <w>mizernego</w> i zmęczonego."
                            }
                        }
                    ],
                    "synonyms": [
                        "слабый",
                        "немощный"
                    ],
                    "antonyms": [
                        "сильный",
                        "здоровый"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Słaby, nieposiadający wystarczającej siły lub zdrowia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "o braku sił fizycznych lub zdrowia"
                            },
                            {
                                "target_lang_word": "cherlawy",
                                "target_lang_sense_clarification": "o kimś chorowitym i słabym"
                            },
                            {
                                "target_lang_word": "mizerny",
                                "target_lang_sense_clarification": "o kimś wyglądającym na słabego lub chorego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}