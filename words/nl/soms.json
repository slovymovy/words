                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga <w>soms</w> met de fiets naar mijn werk.",
                            "target_lang_translations": {
                                "en": "I <w>sometimes</w> go to work by bike.",
                                "ru": "Я <w>иногда</w> езжу на работу на велосипеде.",
                                "pl": "Jeżdżę <w>czasami</w> do pracy rowerem.",
                                "de": "Ich fahre <w>manchmal</w> mit dem Fahrrad zur Arbeit.",
                                "fr": "Je vais <w>parfois</w> au travail à vélo.",
                                "it": "Vado <w>a volte</w> al lavoro in bicicletta.",
                                "cs": "Do práce jezdím <w>někdy</w> na kole.",
                                "tr": "İşe <w>bazen</w> bisikletle giderim.",
                                "es": "Voy <w>a veces</w> al trabajo en bicicleta."
                            }
                        },
                        {
                            "text": "In Nederland regent het <w>soms</w> de hele dag.",
                            "target_lang_translations": {
                                "en": "In the Netherlands it <w>sometimes</w> rains all day.",
                                "ru": "В Нидерландах <w>иногда</w> весь день идет дождь.",
                                "pl": "W Holandii <w>czasem</w> pada przez cały dzień.",
                                "de": "In den Niederlanden regnet es <w>manchmal</w> den ganzen Tag.",
                                "fr": "Aux Pays-Bas, il pleut <w>parfois</w> toute la journée.",
                                "it": "In Olanda <w>a volte</w> piove tutto il giorno.",
                                "cs": "V Nizozemsku <w>někdy</w> prší celý den.",
                                "tr": "Hollanda'da <w>bazen</w> bütün gün yağmur yağar.",
                                "es": "En los Países Bajos <w>a veces</w> llueve todo el día."
                            }
                        }
                    ],
                    "synonyms": [
