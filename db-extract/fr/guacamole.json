                    }
                ],
                "senses": [
                    {
                        "sense_id": "66b2d7a1-9739-3237-8776-c5cf6382f490",
                        "entry_id": "12241780-2f9c-3862-8c63-90adffe717ff",
                        "glosses": [
                            "Purée à base d’avocats, d’oignons, de piment, de coriandre, de tomates et de citron vert ; il sert d’accompagnement pour tout genre de plat mexicain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e782c829-c429-4ae8-a9d4-54898979b31b",
                                "sense_id": "66b2d7a1-9739-3237-8776-c5cf6382f490",
                                "text": "Les fonds devaient être bas, le couscous avait cédé devant le guacamole et les chips piquantes, l’arak s’était commué en sangria ponceau où nageaient, flapies comme des papillons morts, des rondelles d’orange."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50eba3b7-02cf-4aa5-9d57-d92c4c92a10f",
                        "source_entry_id": "12241780-2f9c-3862-8c63-90adffe717ff",
                        "source_sense_id": "66b2d7a1-9739-3237-8776-c5cf6382f490",
                        "source_sense_description": "Purée d'avocats",
                        "target_lang_word": "Guacamole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guacamole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d81294cd-5ec1-3d35-8567-c3b2346b6341",
                                        "entry_id": "788dfac3-6e75-3dff-8584-a25e9a4f7e8c",
                                        "glosses": [
                                            "kalte Soße auf der Basis von Avocados"
                                        ],
                                        "tags": [
                                            "mexikanische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5dcc1d2-d2ba-47af-9e84-540d55098620",
                                                "sense_id": "d81294cd-5ec1-3d35-8567-c3b2346b6341",
                                                "text": "„Hier wird wunderbar gekocht, alle Gerichte haben außergewöhnliche Aromen, ob das Tunfischtatar mit Guacamole oder der – nicht näher identifizierte – ‚kleine Fisch‘ mit einer apart abgeschmeckten Ratatouille.“"
                                            },
                                            {
                                                "example_id": "75a0b217-bd7a-433c-991c-c641e3f7eeb5",
                                                "sense_id": "d81294cd-5ec1-3d35-8567-c3b2346b6341",
                                                "text": "„[…] der Gurkensalat ist mit einem leichten Hang zur Süße traditionell abgeschmeckt, die gehackte Avocado ähnelt einer sanften Guacamole.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ee7c78b-3098-40c3-8814-1aa78d020278",
