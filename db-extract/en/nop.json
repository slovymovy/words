                "senses": [
                    {
                        "sense_id": "a6ef60ec-7743-34a5-b4ee-d394a4845dbc",
                        "entry_id": "4f90ccec-5f4d-3d5e-8882-a94cfad11d71",
                        "glosses": [
                            "To replace machine code with nop instructions when modifying software."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62220e40-a108-4a9f-aff8-c98817a8bf6b",
                                "sense_id": "a6ef60ec-7743-34a5-b4ee-d394a4845dbc",
                                "text": "For example, if there is a CALL 3140 and we want to skip this call, we can NOP it out."
                            },
                            {
                                "example_id": "6e9155cc-88a4-4a2a-98e6-ee0070b23cde",
                                "sense_id": "a6ef60ec-7743-34a5-b4ee-d394a4845dbc",
                                "text": "Worse, some patching can result in codes which cannot be executed: for example nopping the load which provides the value for the denominator of a division can result in a division by zero."
                            }
                        ]
                    }
                ],
