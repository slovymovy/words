                "senses": [
                    {
                        "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                        "entry_id": "f405c4d0-0467-392a-b042-cef6ffca04a9",
                        "glosses": [
                            "Mensch, der sich mit einem Sportflugzeug (Cessna, Piper) durch die Luft bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e3fd3a-b8fd-4d1b-8cf6-998f6fd3e334",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Ich habe mitunter den Eindruck, als wollten unsere Motorflieger die Pionierzeit der Luftfahrt verewigen.“"
                            },
                            {
                                "example_id": "c41effb9-d122-47b4-bdb7-a701df4dac17",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Zudem werden weitere 55 Motorflieger erwartet, die für den Sternflug des Deutschen Aero- Clubs aus ganz Deutschland Richtung Tempelhof starten.“"
                            },
                            {
                                "example_id": "5c5db712-dca9-4d6d-a588-8171d86cb644",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Im Flugsport kann sich z.B. eine Ordalsituation andeuten, wenn ein Pilot auf seinen Gerät- und Startcheck verzichtet, wenn ein Paragleiter bei Föhn oder aufziehender Gewitterfront einen Flug wagt, […] wenn ein Segel- oder Motorflieger trotz Wetterwarnungen einen Überlandflug angeht.“"
                            },
                            {
                                "example_id": "7409ffee-7f11-458a-8e2d-d5402fa21311",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„In diesem Papier werde ein für allemal festgelegt, das niemand anderes als die Gebrüder Wright als erste Motorflieger genannt werden dürften; zwei Amerikaner und nicht der Bayer.“"
                            },
                            {
                                "example_id": "b9c363c8-1203-4802-8a53-b31dbd07a372",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Gouverneur Dannel P. Malloy hat ein entsprechendes Gesetz unterzeichnet. Connecticut erkennt damit Weißkopf als ersten Motorflieger der Geschichte an.“"
                            },
                            {
                                "example_id": "dc7b8e2f-b619-408c-a15f-66ffeacb76f5",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Seine Fliegerlaufbahn begann er mit 14 Jahren in einem Segelflugzeug, mit 18 hatte er die Lizenz als Motorflieger.“"
                            },
                            {
                                "example_id": "222f1b85-2a0e-4352-9a73-bad73c69ad0f",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Damals hätten Motorflieger dafür in der DDR zwei Jahre sitzen müssen.“"
                            },
                            {
                                "example_id": "1bf0fc28-7051-4972-8de7-6bc1aa3ad653",
                                "sense_id": "af038814-c57d-3fbc-9986-b35bca63f088",
                                "text": "„Plötzlich hörte der Motorflieger auf zu kreisen. In eine ganz andere Richtung ging es auf einmal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                        "entry_id": "f405c4d0-0467-392a-b042-cef6ffca04a9",
                        "glosses": [
                            "propellergetriebene Maschine, mit der sich Luftsport betreiben lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc15854d-a9eb-40a3-826e-b6f7f5ad120d",
                                "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                                "text": "„Zudem werden weitere 55 Motorflieger erwartet, die für den Sternflug des Deutschen Aero- Clubs aus ganz Deutschland Richtung Tempelhof starten.“"
                            },
                            {
                                "example_id": "f5142f68-89eb-4c01-84d6-595a72fce832",
                                "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                                "text": "„Plötzlich hörte der Motorflieger auf zu kreisen. In eine ganz andere Richtung ging es auf einmal.“"
                            },
                            {
                                "example_id": "6f43e544-ba2a-4579-8490-3e1c06818591",
                                "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                                "text": "„Wie an einer Voltigierlonge dreht sich der strombetriebene Nachbau eines Motorfliegers brummend im Kreis.“"
                            },
                            {
                                "example_id": "a99baec5-dac8-4372-8391-0ae05686f912",
                                "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                                "text": "„Neben dem früheren Museum für Verkehr und Bau sowie dem Meereskundlichen Museum hatte die Deutsche Luftfahrt-Sammlung mit über 100 Motorfliegern bis dahin eine der bedeutendsten historischen Flugschauen überhaupt dargestellt.“"
                            },
                            {
                                "example_id": "62c81d10-d342-4b3c-bb55-5e30f119e2aa",
                                "sense_id": "33bebd97-9f9e-3aed-887b-f20b12e70208",
                                "text": "„Der Motor des Schleppflugzeugs wird auf Touren gebracht, ein Helfer hebt den Flügel des Segelflugzeuges an und nun zieht der Motorflieger an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
