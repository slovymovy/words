                            {
                                "example_id": "37c629ba-9f6b-45c9-9ffe-f3579332f985",
                                "sense_id": "8cead7f9-ba0f-37b1-a7c5-4d255dd70893",
                                "text": "Dier is een hyperoniem van vogel, dat op zijn beurt weer een hyperoniem is van mus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8badb579-e1f2-4a70-b476-2c272d580952",
                        "source_entry_id": "15d73919-f504-303a-8297-87a4966b1fba",
                        "source_sense_id": "8cead7f9-ba0f-37b1-a7c5-4d255dd70893",
                        "source_sense_description": "een woord dat een verzameling van verwante specifiekere woorden samenvoegt, een overkoepelende term",
                        "target_lang_word": "Oberbegriff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oberbegriff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "361942c1-7a27-37c1-91e9-62d8fa1d5e32",
                                        "entry_id": "074bdc80-cc47-3d05-b64a-025d6e6b298d",
                                        "glosses": [
                                            "eine Generalisierung oder Oberklasse eines Begriffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdbf4b9f-5233-4d82-938b-bbf7b50ce0e7",
                                                "sense_id": "361942c1-7a27-37c1-91e9-62d8fa1d5e32",
                                                "text": "Obst ist ein Oberbegriff zu Kirsche."
                                            },
                                            {
                                                "example_id": "6ed1259e-9626-4813-a249-6864b589dd7d",
                                                "sense_id": "361942c1-7a27-37c1-91e9-62d8fa1d5e32",
                                                "text": "Tier ist ein Oberbegriff zu Vogel."
                                            },
                                            {
                                                "example_id": "3b3bc701-70f7-4f2c-afcf-706ad646cc31",
                                                "sense_id": "361942c1-7a27-37c1-91e9-62d8fa1d5e32",
                                                "text": "„Wer dieses System anwenden will, muß natürlich zur Darstellung aller Oberbegriffe und Methoden ihrer Differenzierung und Spezifizierung das Buch befragen, bis er sie im Gedächtnis hat.“"
                                            },
                                            {
                                                "example_id": "06aabbcf-f40e-4e5b-a809-d8d9c5f16994",
                                                "sense_id": "361942c1-7a27-37c1-91e9-62d8fa1d5e32",
                                                "text": "„Das sind eben Oberbegriffe, geschlechtsneutral.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e51ca6-5bee-452d-8dfe-ee3f8b6901e9",
                        "source_entry_id": "15d73919-f504-303a-8297-87a4966b1fba",
