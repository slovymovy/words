                "senses": [
                    {
                        "sense_id": "7aa5da4f-a78c-308b-af96-63f5c09970a1",
                        "entry_id": "364b689c-ea24-39f3-b556-b4a8319f5e4b",
                        "glosses": [
                            "церк. предмет одежды православной монахини; головной убор, прикрывающий также подбородок, шею и плечи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63942ebe-46c7-4f14-89b1-8b2b016585eb",
                                "sense_id": "7aa5da4f-a78c-308b-af96-63f5c09970a1",
                                "text": "В неуклюжей четырёхконной лазаретной фуре белели апостольники и фартуки сестёр."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ac34836-2b8f-4661-ad33-6f91127d53db",
                        "source_entry_id": "364b689c-ea24-39f3-b556-b4a8319f5e4b",
                        "source_sense_id": "7aa5da4f-a78c-308b-af96-63f5c09970a1",
                        "target_lang_word": "wimple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wimple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49da8bf3-a21c-3646-bccd-6d9db7d98e82",
                                        "entry_id": "b5a0b556-8547-39f3-bd60-cb040c03eb5c",
                                        "glosses": [
                                            "A cloth which usually covers the head and is worn around the neck and chin. It was worn by women in medieval Europe and is still worn by nuns in certain orders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90d0851-e6d2-4252-b513-256ef774d182",
                                                "sense_id": "49da8bf3-a21c-3646-bccd-6d9db7d98e82",
                                                "text": "There are two tombs, each bearing effigies of a knight and his lady. One is 14th century, the other 15th century. The earlier knight wears chain mail and his lady has long, flowing hair. The later knight has plate armour, and his wife wears a wimple."
                                            },
                                            {
                                                "example_id": "5d0ef51a-b887-472f-bc1d-fd0dfd80d3a9",
                                                "sense_id": "49da8bf3-a21c-3646-bccd-6d9db7d98e82",
                                                "text": "Even the unprecedented detail of the Urbanist regulations is still not sufficient to enable us to envisage with accuracy the appearance of the wimple or the other items that went to make up the habit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6817740-34f6-3ac5-84b5-2ef94ec06671",
                                        "entry_id": "b5a0b556-8547-39f3-bd60-cb040c03eb5c",
                                        "glosses": [
                                            "A fold or pleat in cloth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6e1ae48-677e-32a0-b7d1-aced66eed17d",
                                        "entry_id": "b5a0b556-8547-39f3-bd60-cb040c03eb5c",
                                        "glosses": [
                                            "A ripple, as on the surface of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9361e516-9471-3b7b-abc9-0047d0abfce3",
