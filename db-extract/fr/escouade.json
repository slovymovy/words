                                "target_senses": [
                                    {
                                        "sense_id": "154dd141-484a-3d74-b0a2-a05c15755696",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "A group of people organized for some common purpose, usually of about ten members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fc691f-476a-4920-bcc1-c9df51d07647",
                                                "sense_id": "154dd141-484a-3d74-b0a2-a05c15755696",
                                                "text": "He assembled a squad of ten to take on the assassin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266373d9-1295-34bc-91bb-0bd7d3ec0f19",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "A group of people organized for some common purpose, usually of about ten members.",
                                            "A unit of tactical military personnel, or of police officers, usually of about ten members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d65301-dda8-42f8-8551-2a2f9a365e31",
                                                "sense_id": "266373d9-1295-34bc-91bb-0bd7d3ec0f19",
                                                "text": "A squad of soldiers ordered them to disperse but instead of doing so they commenced throwing ice and rocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddc85161-afe8-352e-aa18-77dde6dbf637",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "A group of people organized for some common purpose, usually of about ten members.",
                                            "A group of potential players from whom a starting team and substitutes are chosen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f406eb7a-cc6d-3006-8573-932fb715bb35",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "A group of people organized for some common purpose, usually of about ten members.",
                                            "A collective noun for a group of squid."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f41e1077-ac58-46ed-b852-e2f28493d3a0",
                                                "sense_id": "f406eb7a-cc6d-3006-8573-932fb715bb35",
                                                "text": "At one point, the 400-ton Calypso was brought to a standstill by a squad of squid which clogged the engines and caused a power failure. Other, highlights included an attack by predatory blue sharks, […]"
                                            },
                                            {
                                                "example_id": "9148c37f-e248-409e-a8c8-9923b44b393d",
                                                "sense_id": "f406eb7a-cc6d-3006-8573-932fb715bb35",
                                                "text": "The Sea Life Centre retains a squad of squid and such."
                                            },
                                            {
                                                "example_id": "52843986-7b0b-4e26-accd-dfefcdce6a43",
                                                "sense_id": "f406eb7a-cc6d-3006-8573-932fb715bb35",
                                                "text": "There's several new symbols next to the doorway symbol. Beso pushed all six of them without waiting to see what they brought; like a herd of charging rhinos or rampaging squad of squid. Next best thing though."
                                            },
                                            {
                                                "example_id": "4dd04646-9baa-48ea-92ac-d8061d749889",
                                                "sense_id": "f406eb7a-cc6d-3006-8573-932fb715bb35",
                                                "text": "I pulled in as deep a breath as my gag allowed and began relaxing my body. I used a little trick I'd learned in college. I imagined that a friendly squad of squid were massaging every muscle on the bottoms of my feet; the tension began to drain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd859279-ab6b-33f6-8f4d-e1cbaefad200",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "Ellipsis of squad truck."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e3f99e9-212b-34af-9cfb-4d156f8cf164",
                                        "entry_id": "3ae7a037-d9ec-35e7-a5cd-34f544e217cc",
                                        "glosses": [
                                            "One's friend group, taken collectively; one's peeps."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e5c784-3985-4dda-afb0-6eff786fd1c0",
                                                "sense_id": "3e3f99e9-212b-34af-9cfb-4d156f8cf164",
                                                "text": "anyway, sheʼs resigned herself to hanging out with the squad at uni rather than going manhunting"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
