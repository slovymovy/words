                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                        "entry_id": "e84e27e6-7558-3bf2-8873-3ccc746b3105",
                        "glosses": [
                            "gerecht van een belegde broodbodem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3227ecbb-9b16-48d4-a757-34abfb385d56",
                                "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                                "text": "Als je wat wilt eten, neem je maar een pizza."
                            },
                            {
                                "example_id": "bb46a86e-5094-4bb1-8df4-76ebb6e01f06",
                                "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                                "text": "We bestelden pizza en dronken op het leven met een lokaal biertje."
                            },
                            {
                                "example_id": "126d40d3-2b68-4166-8836-9374e3eb5649",
                                "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                                "text": "Ik had al wel genoeg hamburgers en pizza’s gegeten de afgelopen tijd."
                            },
                            {
                                "example_id": "235ada11-c8d4-4394-96b9-4ae37f96d99a",
                                "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                                "text": "Het volk viert Paschen met braspartijen. De armste werkman zal liever zĳn jas naar den lommerd brengen dan niet zĳn Paschen te vieren met de eieren, saucijsjes, lamsvleesch en pizza (een soort van broedertjes), alles overgoten met ontelbare fiaschi wĳn van de Castelli Romani."
                            },
                            {
                                "example_id": "d90be322-1993-4911-92e9-3cb671b756d3",
                                "sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                                "text": "Het ergste is men in de Toledostraat en de Via di Chiaja er aan toe, want boven en behalve dat daarheen alle ambulante uitventers zamenstroomen, bieden ook de koekbakkers der lazzaroni aldaar aan de hoeken der dwarsstraten hunne lekkernijen te koop, en deze zijn juist de onbarmhartigste schreeuwhalzen, die met oogen gezien zijn, daar zij slechte in olij gebakken koek, un grano il quarto di pizza (een grein een stuk taart) te koop roepen met eene stem, welke op den ganschen aardbol eenig in hare soort is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72132e9a-0989-4c18-8e85-4d9c8b34dbe7",
                        "source_entry_id": "e84e27e6-7558-3bf2-8873-3ccc746b3105",
                        "source_sense_id": "0ce0fd39-1c24-374e-a95d-a7d45e880c6b",
                        "source_sense_description": "gerecht van een belegde broodbodem",
                        "target_lang_word": "Pizza",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pizza",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                        "entry_id": "353abdf9-0f70-378c-83e8-efe99e219474",
                                        "glosses": [
                                            "ein Gericht der italienischen Küche, welches aus einem Fladenbrot aus Hefeteig, das vor dem Backen mit Tomatensauce bestrichen und mit weiteren Zutaten wie zum Beispiel Mozzarella belegt wird, besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68973d51-fc74-478e-ab3e-41654991edd2",
                                                "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                                "text": "Am liebsten esse ich mit Salami belegte Pizza."
                                            },
                                            {
                                                "example_id": "694f45b4-1cf9-42e1-91b1-fc909712c0db",
                                                "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                                "text": "„Ich lenkte meine Gedanken zurück an die Pizza, die ich heute Abend verspeisen wollte, und tauchte noch einmal mit dem Kopf in das wohltuende Wasser.“"
                                            },
                                            {
                                                "example_id": "841638e0-9097-4fb4-8c66-56598a10f36a",
                                                "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                                "text": "„Italien ist das Land von Pizza und Pasta.“"
                                            },
                                            {
                                                "example_id": "1b0518e7-eac5-44e1-ad4b-a7cad3d892ed",
                                                "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                                "text": "„Die teure Pizza ist gegessen und der Kellner kommt mit einem Tablett Espresso.“"
                                            },
                                            {
                                                "example_id": "337dbd1a-5e5f-41d4-91e8-a2be402c2c9e",
                                                "sense_id": "c45d2fe7-770f-3513-8d3b-d648c0b4563d",
                                                "text": "„Die Pizza schmeckt nicht nach Pizza, nicht einmal die dicke Schicht Käse kann diese Illusion erzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
