{
    "word_family": [
        "uderzenie",
        "uderzający",
        "uderzeniowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fb2c0a3-59f7-3270-be91-cc5dc9418f17",
                    "sense_definition": "zadawać cios, bić kogoś lub coś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uderzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wolno <w>uderzać</w> innych dzieci w szkole.",
                            "target_lang_translations": {
                                "ru": "В школе нельзя <w>ударять</w> других детей."
                            }
                        },
                        {
                            "text": "Pięściarz zaczął mocno <w>uderzać</w> w worek treningowy.",
                            "target_lang_translations": {
                                "ru": "Боксер начал сильно <w>ударять</w> по боксерской груше."
                            }
                        }
                    ],
                    "synonyms": [
                        "bić",
                        "walić"
                    ],
                    "common_phrases": [
                        "uderzać pięścią"
                    ],
                    "target_lang_definitions": {
                        "ru": "наносить удар, бить кого-либо или что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударять",
                                "target_lang_sense_clarification": "наносить удар, совершать резкое движение до соприкосновения с объектом"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "наносить удары, причинять физическую боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39508e88-637c-3b22-9e21-4232730bfc02",
                    "sense_definition": "trafiać w coś, zderzać się z czymś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uderzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fale mocno <w>uderzały</w> o brzeg morza.",
                            "target_lang_translations": {
                                "ru": "Волны сильно <w>били</w> о морской берег."
                            }
                        },
                        {
                            "text": "Deszcz zaczął <w>uderzać</w> w szyby okienne podczas burzy.",
                            "target_lang_translations": {
                                "ru": "Во время грозы дождь начал <w>бить</w> в оконные стекла."
                            }
                        }
                    ],
                    "synonyms": [
                        "obijać się",
                        "trafiać"
                    ],
                    "common_phrases": [
                        "uderzać o coś"
                    ],
                    "target_lang_definitions": {
                        "ru": "сталкиваться с чем-либо, попадать во что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударяться",
                                "target_lang_sense_clarification": "сталкиваться с чем-либо, попадать во что-либо"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "о стихии, например, о волнах или дожде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fab1747-bc03-3b08-8af0-7d23001c0382",
                    "sense_definition": "zwracać się do kogoś z prośbą lub sprawą",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej sprawie musisz <w>uderzać</w> bezpośrednio do dyrektora.",
                            "target_lang_translations": {
                                "ru": "По этому вопросу тебе нужно <w>обращаться</w> напрямую к директору."
                            }
                        },
                        {
                            "text": "Jeśli potrzebujesz pomocy, <w>uderzaj</w> do specjalisty od marketingu.",
                            "target_lang_translations": {
                                "ru": "Если тебе нужна помощь, <w>обращайся</w> к специалисту по маркетингу."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwracać się",
                        "zgłaszać się"
                    ],
                    "common_phrases": [
                        "uderzać do kogoś"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "обращаться к кому-либо с просьбой или по делу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "просить о помощи или содействии"
                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "разговорный вариант, означающий направиться к кому-то за помощью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e226b81f-36f9-3295-812a-4626f64b514b",
                    "sense_definition": "forma niedokonana od <w>uderzyć</w> się",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uderzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Często <w>uderzam</w> się w kolano, gdy biegnę za szybko.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>ударяюсь</w> коленом, когда бегу слишком быстро."
                            }
                        },
                        {
                            "text": "Nie <w>uderzaj</w> się w głowę przy wchodzeniu do piwnicy.",
                            "target_lang_translations": {
                                "ru": "Не <w>ударяйся</w> головой, когда входишь в подвал."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt niedokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "несовершенный вид глагола ударяться (о себе)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударяться",
                                "target_lang_sense_clarification": "несовершенный вид, описывающий процесс получения удара"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}