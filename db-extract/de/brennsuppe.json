                "senses": [
                    {
                        "sense_id": "0889027a-24b1-31d1-bffc-9f8d90b70adb",
                        "entry_id": "11d1c5a9-caeb-3a7a-acfb-82e55f44529d",
                        "glosses": [
                            "Eine Suppe aus Mehl, Fett und Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c8d4c4-bde8-4cee-8108-cbc7dbfe5468",
                                "sense_id": "0889027a-24b1-31d1-bffc-9f8d90b70adb",
                                "text": "Die Brennsuppe wird noch heute während der Fastenzeit serviert."
                            },
                            {
                                "example_id": "4f23b442-950f-462b-bd8f-87d16267ca1b",
                                "sense_id": "0889027a-24b1-31d1-bffc-9f8d90b70adb",
                                "text": "Die Brennsuppe war ein Arme-Leute-Gericht."
                            },
                            {
                                "example_id": "b80d40cc-a2bc-472a-a4e5-b37895dc6746",
                                "sense_id": "0889027a-24b1-31d1-bffc-9f8d90b70adb",
                                "text": "„Es gab Brennsuppe, als Hauptgericht Kartoffeln mit Soße und zum Nachtisch einen Apfel.“"
                            }
                        ],
