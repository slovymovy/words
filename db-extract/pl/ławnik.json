                "senses": [
                    {
                        "sense_id": "862da475-b0db-3135-ae12-4ee4169bfe22",
                        "entry_id": "648f983f-ce6b-3254-98a2-55e0a7e289b6",
                        "glosses": [
                            "osoba niebędąca sędzią, uczestnicząca w wydawaniu wyroków w niektórych kategoriach spraw sądowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbad343-b436-4f77-b1cb-f1ef96d5499f",
                                "sense_id": "862da475-b0db-3135-ae12-4ee4169bfe22",
                                "text": "W sprawach cywilnych dwaj ławnicy pod przewodnictwem zawodowego sędziego rozpoznają sprawy z zakresu prawa pracy oraz część spraw wynikających ze stosunków rodzinnych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d5dc1dd1-67fc-31af-83b3-a616c8555dba",
                        "entry_id": "648f983f-ce6b-3254-98a2-55e0a7e289b6",
                        "glosses": [
                            "w dawnej Polsce: członek ławy miejskiej lub wiejskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5766992-d27d-4e80-b383-c8be61e2a259",
                                "sense_id": "d5dc1dd1-67fc-31af-83b3-a616c8555dba",
                                "text": "Ława miejska (…) składała się z wójta, landwójta i sześciu ławników"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "708c0919-b167-427a-b0e0-794e6fbc0255",
                        "source_entry_id": "648f983f-ce6b-3254-98a2-55e0a7e289b6",
