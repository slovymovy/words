    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                    "sense_definition": "An understanding or arrangement between two or more entities to follow a specific course of action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries signed a trade <w>agreement</w> last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе две страны подписали торговое <w>соглашение</w>.",
                                "zh": "两国上周签署了一份贸易<w>协议</w>。",
                                "pl": "Dwa kraje podpisały w zeszłym tygodniu <w>umowę</w> handlową."
                            }
                        },
                        {
                            "text": "We finally reached an <w>agreement</w> after hours of discussion.",
                            "target_lang_translations": {
                                "ru": "Мы наконец пришли к <w>соглашению</w> после многочасового обсуждения.",
                                "zh": "经过数小时的讨论，我们最终达成了<w>协议</w>。",
                                "pl": "Po godzinach dyskusji w końcu osiągnęliśmy <w>porozumienie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pact",
                        "treaty",
                        "settlement",
                        "convention",
                        "accord",
                        "deal",
                        "contract"
                    ],
                    "antonyms": [
                        "disagreement",
                        "conflict"
                    ],
                    "common_phrases": [
                        "reach an agreement",
                        "come to an agreement",
                        "sign an agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Договорённость или понимание между двумя или более сторонами о выполнении определённых действий.",
                        "zh": "双方或多方之间就采取特定行动达成的理解或安排。",
                        "pl": "Porozumienie lub ustalenie między dwiema lub większą liczbą stron dotyczące podjęcia określonych działań."
                    },
                    "translations": {
                        "ru": [
