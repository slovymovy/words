                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554d2cf3-c002-46a9-af24-50587ca6b836",
                                "sense_id": "bef212bc-d6db-3ccb-a87c-beeadbc325e8",
                                "text": "И Терек, прыгая, как львица // С косматой гривой на хребте"
                            }
                        ]
                    },
                    {
                        "sense_id": "dcdf6c4d-cf61-30b2-a96f-5ea9706a9854",
                        "entry_id": "71c9f743-7509-3885-9a0f-ff950cdc55f1",
                        "glosses": [
