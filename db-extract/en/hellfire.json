                            {
                                "target_word": "Höllenfeuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3576d2af-7ddf-3130-9416-2626400d625e",
                                        "entry_id": "47c87dd4-8da4-364d-8546-5481df25078d",
                                        "glosses": [
                                            "Feuer der Hölle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0cd7436-1fa3-4a1c-ab0c-046f315b12b9",
                                                "sense_id": "3576d2af-7ddf-3130-9416-2626400d625e",
                                                "text": "„Er wird Gog und Magog um sich scharen, zwei Völker von den Enden der Erde; der Messias wird erneut erscheinen, und nach einem fürchterlichen Endkampf, dem Armageddon, werden Satan und alle, die ihm gefolgt sind, vom ewigen Höllenfeuer verschlungen werden.“"
                                            },
                                            {
                                                "example_id": "9ede29c0-f751-491a-8010-360173a9393f",
                                                "sense_id": "3576d2af-7ddf-3130-9416-2626400d625e",
                                                "text": "„Das Ächzen der Türen, das Rauschen der vom Sturm geschüttelten Bäume und das Heulen des Windes klangen für die Dorfbewohner wie die Flüche vor langer Zeit verstorbener Sünder, die von der zermürbenden Ungewissheit der Vorhölle oder dem Schmoren im endlosen Höllenfeuer gequält wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
