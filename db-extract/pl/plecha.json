                                        "sense_id": "5fd65012-f5dc-39fc-a5a1-3654d7d3e021",
                                        "entry_id": "0575699e-2a41-3b0a-ab6d-4cfa7f587eeb",
                                        "glosses": [
                                            "An undifferentiated plant body, such as in algae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b34b10-1574-47e3-bf93-6c919a9da2dc",
                                                "sense_id": "5fd65012-f5dc-39fc-a5a1-3654d7d3e021",
                                                "text": "As it flows it takes the forms of sappy leaves or vines, making heaps of pulpy sprays a foot or more in depth, and resembling, as you look down on them, the laciniated, lobed, and imbricated thalluses of some lichens; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b218f0-98ad-39af-bd6f-93f14e5c2cb7",
                                        "entry_id": "0575699e-2a41-3b0a-ab6d-4cfa7f587eeb",
                                        "glosses": [
                                            "Any plant body lacking vascular tissue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1772e024-aa46-44ef-9b46-42f29ff27772",
                        "source_entry_id": "7d7bb8f7-4f1d-34a2-8deb-70a6c3518d0b",
                        "source_sense_id": "9ab5fd67-bbfe-3478-a27d-32c4c6f44247",
