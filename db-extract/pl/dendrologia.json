                                "target_senses": [
                                    {
                                        "sense_id": "5e0d2a24-3e17-3b60-a1d7-0fba873836a5",
                                        "entry_id": "5d0a1e08-c898-34c8-90f9-f4aaac82ca0e",
                                        "glosses": [
                                            "Science qui étudie les arbres et autres végétaux ligneux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32be5e64-2d0d-4d16-ac9f-6fdf0a6cf994",
                                                "sense_id": "5e0d2a24-3e17-3b60-a1d7-0fba873836a5",
                                                "text": "Les sciences naturelles, la dendrologie surtout, viennent de faire une perte notable en la personne de notre confrère H. J. Elwes, décédé le 26 novembre dernier dans son domaine de Colesborne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1cdf779-ed49-4c95-aea0-f3e311b03ffa",
                        "source_entry_id": "6228c738-8c11-3764-8cbc-167e155a61d8",
                        "source_sense_id": "159f1982-d499-378c-be89-09701923b8fa",
                        "target_lang_word": "dendrología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "59dd76db-823c-4e5e-91c6-433668c3a5a0",
                        "source_entry_id": "6228c738-8c11-3764-8cbc-167e155a61d8",
                        "source_sense_id": "159f1982-d499-378c-be89-09701923b8fa",
                        "target_lang_word": "Dendrologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dendrologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3797201c-ce0d-39ab-b38a-da7466c4bb93",
                                        "entry_id": "405f7f29-9aa3-3467-8340-2b5bdd9247e3",
                                        "glosses": [
                                            "wissenschaftliche Lehre von den Bäumen und Gehölzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bb28723-31d7-45d8-ac90-1f22a2de59d8",
                                                "sense_id": "3797201c-ce0d-39ab-b38a-da7466c4bb93",
                                                "text": "„Was es noch nicht so lange gibt, sind neue Methoden der Dendrologie, mit deren Hilfe sich heute auch das Alter von Holz bestimmen lässt.“"
                                            },
                                            {
                                                "example_id": "d6f913b1-553b-4a2e-a8f7-4b109eead534",
                                                "sense_id": "3797201c-ce0d-39ab-b38a-da7466c4bb93",
                                                "text": "„In Zepernick werden Übungen und Demonstrationen innerhalb von Modulen rund um das Baumschulwesen, die Dendrologie oder die Verwendung von Gehölzen durchgeführt.“"
                                            },
                                            {
                                                "example_id": "5fefd514-49f5-454e-ae07-ba29c7a8bfcf",
                                                "sense_id": "3797201c-ce0d-39ab-b38a-da7466c4bb93",
                                                "text": "„Der Herausgeber grundlegender Weinatlanten (‚großer‘ und ‚kleiner Johnson‘) wird ebenso für sein Fachwissen zu Gartenarchitektur und Dendrologie, der Lehre von den Baumarten, geschätzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
