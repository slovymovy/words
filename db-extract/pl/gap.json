                "senses": [
                    {
                        "sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "glosses": [
                            "osoba bezmyślnie patrząca na pewne wydarzenie, zjawisko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50032730-20fa-4cbc-93e3-dc0b07c16dc8",
                                "sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                                "text": "Obok rozbitego samochodu stał tłum gapiów, ale nikt nie udzielił rannym pomocy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "75703377-fd0f-3cec-9877-e7684974cba8",
                        "entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "glosses": [
                            "gap niebieskonogi – inna nazwa głuptaka niebieskonogiego, dużego ptaka morskiego z rodziny głuptaków."
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5b2430b-c24a-4369-b0b7-fccfd1a15f95",
                        "source_entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "source_sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "target_lang_word": "onlooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onlooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                        "entry_id": "c467616c-7b61-32cd-8da6-7d4a258a313b",
                                        "glosses": [
                                            "A spectator; someone looks on or watches, without becoming involved or participating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d641ad28-474d-44bd-a50c-f4c18285e8ad",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "I wasn’t involved in the fight; I was only an onlooker."
                                            },
                                            {
                                                "example_id": "e366a5ae-69d3-426e-93ff-51acaa5196e0",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "When the right-away was given, Driver Gibson would give a sonorous blast on Cardean's deep-toned hooter, and amid a flurry of swirling steam the train would move majestically out, with nearly half the city of Carlisle—or so it would appear—as onlookers on the platform."
                                            },
                                            {
                                                "example_id": "75a66cc0-3ee5-4b94-af99-b161fc96b076",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "As a result, while the train was being shunted at Bombay, the buffers became locked, producing a situation most intriguing for the onlookers, but exasperating for the exalted passengers and the unhappy railway authorities."
                                            },
                                            {
                                                "example_id": "2c382c57-be74-4bb2-b66e-57af6757c974",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "Please allow me to adjust my pants\nSo that I may dance the good time dance\nAnd put the onlookers and innocent bystanders into a trance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f95b23b7-0156-4e6a-a8c8-828b7f8e10b1",
                        "source_entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "source_sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "target_lang_word": "bystander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bystander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                        "entry_id": "910b5bdf-b91d-3262-9d11-e03267682f37",
                                        "glosses": [
                                            "A person who, although present at some event, does not take part in it; an observer, witness, or spectator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40961ee1-6333-4bd4-abce-b7999c9e4c28",
                                                "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                                "text": "If he wins, he will be at liberty, perhaps, to give vent to a laugh, or to pass a remark on the circumstance to a bystander, or to stake again, or to double his stake; but, even this he must do solely out of curiosity, and for the pleasure of watching the play of chances and of calculations, and not because of any vulgar desire to win."
                                            },
                                            {
                                                "example_id": "216f44e9-6760-40a9-9742-49d02c17a2fe",
                                                "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                                "text": "Conservative influencer Nick Sortor is handcuffed Thursday night by a police officer outside an ICE facility in Portland, Oregon, a bystander video shows; the video does not show events leading up to the arrest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c7cfd5-50b2-47ee-8f2b-d8be672ff2b3",
                        "source_entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "source_sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "target_lang_word": "mirón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d48426a5-4c3f-3934-8989-b8b1addaae8b",
                                        "entry_id": "097da999-f963-31fc-8c54-d0e066769ef2",
                                        "glosses": [
                                            "Dicho de una persona, que se dedica a fisgonear o mirar indiscretamente, en especial cosas que no le incumben o bien por morbo sexual."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58dfc39a-7369-478f-8a81-5d5b1f53b9d1",
                        "source_entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "source_sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "target_lang_word": "Gaffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d31e3c18-76d4-3935-b417-ffcee98c8f4b",
                                        "entry_id": "a9430081-3565-37ca-9dbc-27f9d60d9627",
                                        "glosses": [
                                            "jemand, der spektakulären und katastrophalen Ereignissen nur als neugieriger Zuschauer beiwohnt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d92b7d1-5e4c-4e6d-b96a-2de22d519432",
                                                "sense_id": "d31e3c18-76d4-3935-b417-ffcee98c8f4b",
                                                "text": "Bei dem gefährlichen Hochwasser behinderten zahlreiche Gaffer die Rettungsarbeiten."
                                            },
                                            {
                                                "example_id": "316db55d-d0c8-48aa-a9e7-a209547ef7f9",
                                                "sense_id": "d31e3c18-76d4-3935-b417-ffcee98c8f4b",
                                                "text": "„Bei ihrer Ankunft war es vor dem Portale ganz dunkel vom Gedränge der Gaffer, und es wimmelte von Bediensteten.“"
                                            },
                                            {
                                                "example_id": "0a4ce68e-a828-4541-930c-414e77b32571",
                                                "sense_id": "d31e3c18-76d4-3935-b417-ffcee98c8f4b",
                                                "text": "„Ich könnte noch andere, schrecklichere Einzelheiten berichten; aber das sind Dinge für Sadisten und neugierige Gaffer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gaffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                        "entry_id": "9ae07111-7db1-33b0-b398-baa9bc001523",
                                        "glosses": [
                                            "Leiter der Beleuchter am Set"
                                        ],
                                        "tags": [
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7d1d60-145b-4347-99dd-54bc3aa82f80",
                                                "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                                "text": "„Der Chefbeleuchter (Oberbeleuchter, Gaffer) ist als Leiter der Abteilung Licht und Elektrotechnik zuständig für die Erstellung und Umsetzung des Lichtplans.“"
                                            },
                                            {
                                                "example_id": "c15c2378-d44b-4eb7-b05c-c6eb6da5eb25",
                                                "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                                "text": "„«Und warum hat er vorhin ständig nach dem Gaffer verlangt? Wozu braucht er denn Zuschauer?» «Ein Gaffer ist kein Zuschauer, sondern der Oberbeleuchter.»“"
                                            },
                                            {
                                                "example_id": "7a70be77-f970-4a73-81d8-84b748165cde",
                                                "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                                "text": "„Mann, Derek, der Gaffer ist der Oberbeleuchter. Die Szene spielt im Keller, aber da unten ist es zu dunkel. Wir brauchen Licht.“"
                                            },
                                            {
                                                "example_id": "361eaa9a-7053-432a-9100-6532844aac9e",
                                                "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                                "text": "„Der Film ist zu Ende, und während auf dem Abspann die Namen aller Hilfskräfte des Meisters von unten nach oben gezogen werden, Best Boy, Gaffer, Driver und Dutzende andere, treten wir aus dem Kino Piccadilly, […]“"
                                            },
                                            {
                                                "example_id": "a314ae2d-d9f1-4fda-98dd-6414433f7b3a",
                                                "sense_id": "01f272b7-26ec-35ac-b83c-63374dd45736",
                                                "text": "„»Beim letzten Mal, als das kaputt war, hat's einer von den Gaffern repariert.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "228c48f5-7bc9-46dd-8f37-2847bfd73a13",
                        "source_entry_id": "7a741e9c-af98-31cf-9167-c818db7788be",
                        "source_sense_id": "c3d947d1-0d5b-3f77-80da-8870488ca06a",
                        "target_lang_word": "Schaulustiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaulustiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                        "entry_id": "e219cc7a-4a3d-31b0-9d4f-2da2236c0471",
                                        "glosses": [
                                            "jemand, der ein spektakuläres Ereignis beobachtet, das nicht für Zuschauer vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08817b0f-134e-4177-9279-ed7d28ea4acf",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "Viele Schaulustige versammelten sich um die Unfallstelle, doch niemand half den Verletzten."
                                            },
                                            {
                                                "example_id": "849b9f3b-9fad-4e67-b4e6-17bead7cf7d3",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Tausende Schaulustige strömten an die Kaimauern.“"
                                            },
                                            {
                                                "example_id": "e5ea84a7-9c0b-4513-adad-37606209bad4",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Leider vereiteln das mühevolle Anziehen von Helm und Handschuhen eine schnelle Flucht auf dem Motorrad, und als der Wagen schon außer Sichtweite war, hatte ich bereits eine Menge Schaulustiger angezogen.“"
                                            },
                                            {
                                                "example_id": "5932ac1e-7d78-4c56-9056-eaa4b10a1265",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Durch ein Spalier von Schaulustigen begab ich mich in ein Café, um den bitteren Geschmack mit einer ungezuckerten Limonade hinunterzuspülen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
