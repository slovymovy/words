                    "sense_definition": "Yet to be paid; owed as an outstanding debt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant sent a reminder about the amount still <w>owing</w> on the invoice.",
                            "target_lang_translations": {
