{
    "word_family": [
        "purveyance",
        "purveyor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeac5c50-fb0a-36ba-a7d9-dd823643e1fd",
                    "sense_definition": "To furnish, supply, or provide, especially food, goods, or services.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local farm began to <w>purvey</w> fresh vegetables to several restaurants in the city.",
                            "target_lang_translations": {
                                "ru": "Местная ферма начала <w>поставлять</w> свежие овощи в несколько ресторанов города."
                            }
                        },
                        {
                            "text": "Critics accused the magazine of choosing to <w>purvey</w> sensational gossip rather than genuine news.",
                            "target_lang_translations": {
                                "ru": "Критики обвинили журнал в том, что он решил <w>распространять</w> сенсационные сплетни вместо настоящих новостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "furnish",
                        "provide",
                        "supply"
                    ],
                    "common_phrases": [
                        "purvey goods",
                        "purvey information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поставлять, доставлять или снабжать, особенно продуктами питания, товарами, услугами или информацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставлять",
                                "target_lang_sense_clarification": "товары, продукты"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать чем-либо необходимым"
                            },
                            {
                                "target_lang_word": "распространять",
                                "target_lang_sense_clarification": "слухи, информацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e57559-5884-3d0d-b380-c313cc7b1c56",
                    "sense_definition": "To procure, obtain, or get something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>purvey</w> rare manuscripts from collectors across Europe.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>раздобыть</w> редкие рукописи у коллекционеров по всей Европе."
                            }
                        },
                        {
                            "text": "They sought to <w>purvey</w> enough grain to sustain the town through the harsh winter.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>заготовить</w> достаточно зерна, чтобы прокормить город суровой зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "obtain",
                        "procure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "procure or obtain"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добывать, доставать или закупать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "находить, получать с трудом"
                            },
                            {
                                "target_lang_word": "закупать",
                                "target_lang_sense_clarification": "приобретать провизию или запасы"
                            },
                            {
                                "target_lang_word": "доставать",
                                "target_lang_sense_clarification": "приобретать редкое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dea46c6-5d22-3cf2-bddb-6b315feb7098",
                    "sense_definition": "To prepare in advance; to make provision or plan ahead.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wise leaders must <w>purvey</w> against unforeseen disasters before they occur.",
                            "target_lang_translations": {
                                "ru": "Мудрые лидеры должны <w>готовиться</w> к непредвиденным бедствиям до того, как они произойдут."
                            }
                        },
                        {
                            "text": "The knight was advised to <w>purvey</w> for the long and dangerous journey ahead.",
                            "target_lang_translations": {
                                "ru": "Рыцарю посоветовали <w>запастись всем необходимым</w> для предстоящего долгого и опасного путешествия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "prepare or make provision"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее готовиться, принимать меры предосторожности или запасаться впрок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запасаться",
                                "target_lang_sense_clarification": "делать запасы заранее"
                            },
                            {
                                "target_lang_word": "готовиться",
                                "target_lang_sense_clarification": "принимать меры к чему-либо"
                            },
                            {
                                "target_lang_word": "предусматривать",
                                "target_lang_sense_clarification": "готовиться к непредвиденному"
                            }
                        ]
                    }
                }
            ]
        },
        {
