                "senses": [
                    {
                        "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                        "entry_id": "76f01577-b258-3820-b099-dc9131c3cd25",
                        "glosses": [
                            "To squeeze; to scrunch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2222616e-f3b8-46d7-89df-7e532791f3ae",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "I feels th' coal scrunge as I come down an' the exhaust steam hisses as we strikes."
                            },
                            {
                                "example_id": "28923054-582d-461a-93e9-f453908f5e59",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "To bring his head somewhere down near hers, he slid down and scrunged his bony knees to one side and beneath the music rack on the pew ahead."
                            },
                            {
                                "example_id": "d6c95dfe-d840-447a-85e0-873fe580d72a",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "He goes to the back room and scrunges into the corner."
                            },
                            {
                                "example_id": "b53082d3-1fb5-434c-9aeb-61f9b8997f6b",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "The light pattern had been reversed as I was walking over from the hospital and now the vast ziggurat was bathed inbright light, while the bench where the idiot and I scrunged cheese through our teeth was in deep shadow."
                            },
                            {
                                "example_id": "7dda3d4e-6003-40ec-96ee-199e596d1762",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "I know there's something bothering you. Your face is all scrunged up and you're pale as a ghost."
                            },
                            {
                                "example_id": "ab3120ea-9597-4860-b768-5c1983becc23",
                                "sense_id": "7e1baf66-e140-3302-9fb9-699627c8f35b",
                                "text": "We were scrunged up at a small table, at least those of us not dropping folders."
                            }
                        ]
                    }
                ],
