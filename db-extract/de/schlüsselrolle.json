                "senses": [
                    {
                        "sense_id": "8129f1a2-3d80-3705-9a4e-fc798f92352e",
                        "entry_id": "73bdb61a-6138-3b4a-981b-0a0096cefc54",
                        "glosses": [
                            "wichtige, einflussreiche oder entscheidende Rolle/Figur in einem künstlerischen Werk, Film, Roman, Theaterstück oder einer sonstigen Bühneninszenierung (zum Beispiel in Oper, Ballett, Musical)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b717b6f-8392-4e97-9c03-fead12c98bb9",
                                "sense_id": "8129f1a2-3d80-3705-9a4e-fc798f92352e",
                                "text": "Als Priesterin und Tochter des Druiden Oroveso hat Norma eine Schlüsselrolle im geplanten Aufstand gegen die verhassten Römer."
                            },
                            {
                                "example_id": "410c8cb5-5866-40c3-8d5d-142d22cbc040",
                                "sense_id": "8129f1a2-3d80-3705-9a4e-fc798f92352e",
                                "text": "Der Narr hat eine Schlüsselrolle in Shakespeares Stück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                        "entry_id": "73bdb61a-6138-3b4a-981b-0a0096cefc54",
                        "glosses": [
                            "wichtige, einflussreiche, führende Rolle einer Person/Gruppe, eines Sachverhalts oder bestimmter Dinge in einer Angelegenheit oder einem Prozess (zum Beispiel in Auseinandersetzung, Konflikt, geschichtliche Entwicklung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e177c570-f018-41fc-a387-263d4c6c81cd",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "Im Werk Van Gohgs nehmen die Stilleben eine Schlüsselrolle ein."
                            },
                            {
                                "example_id": "a4399422-189a-4d3b-9fa0-f0608b41b08f",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "Das Plateau des Tempelbergs ist gerade einmal 14 Hektar groß – und doch spielt der Streit darum eine Schlüsselrolle im Nahostkonflikt."
                            },
                            {
                                "example_id": "0753f9c9-eb8f-44d9-a445-3a01a0a24384",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "Alexa soll eine Schlüsselrolle im vernetzten Zuhause spielen."
                            },
                            {
                                "example_id": "0c2a553c-9f2e-41e3-af33-70664f730042",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "IT-Sicherheit spielt eine Schlüsselrolle für die Industrie 4.0."
                            },
                            {
                                "example_id": "d4cf355a-cfc8-4531-a0ea-490d30e0856d",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "In der Kulturgeschichte der Menschheit kommt dem Salz als Konservierungs- und Genussmittel eine Schlüsselrolle zu."
                            },
                            {
                                "example_id": "9411ede4-0c39-4b58-a75b-ece173dddc34",
                                "sense_id": "d316fb82-f2f9-3e38-b881-bfcd3514dce4",
                                "text": "„Eine Schlüsselrolle bei der freiwilligen Demilitarisierung Britanniens spielte Kaiser Honorius.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
