                "senses": [
                    {
                        "sense_id": "6b179ce3-f792-37b8-b39c-22626cf7455f",
                        "entry_id": "52f16ff9-9877-3354-a35b-096370f4e1a5",
                        "glosses": [
                            "een vrouwelijk persoon die danst"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "22971486-c1a8-4647-bb75-6a6047a70b93",
                                "sense_id": "6b179ce3-f792-37b8-b39c-22626cf7455f",
                                "text": "Zij is een bekende danseres."
                            },
                            {
                                "example_id": "2c9534a1-b5f4-4ef2-8d04-230b908a8425",
                                "sense_id": "6b179ce3-f792-37b8-b39c-22626cf7455f",
                                "text": "Actrice en danseres Roekie Aronds (95) overleden, ze schreef geschiedenis met één kus: Aronds schreef in de jaren 50 wereldgeschiedenis met de eerste interraciale kus die op de Nederlandse tv te zien was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8730b8d3-132a-4f33-9313-78e7f2b7f94d",
                        "source_entry_id": "52f16ff9-9877-3354-a35b-096370f4e1a5",
                        "source_sense_id": "6b179ce3-f792-37b8-b39c-22626cf7455f",
                        "source_sense_description": "een vrouwelijk persoon die danst",
                        "target_lang_word": "Tänzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tänzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                        "entry_id": "39c9e720-3f17-3194-9ec8-85649c0557e2",
                                        "glosses": [
                                            "weibliche Person, die tanzt, privat oder auch beruflich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfbe3fff-7033-4672-8ba1-4517cbeb8387",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "Manche der Tänzerinnen und Tänzer waren mit dem neuen Tanz noch nicht wirklich vertraut."
                                            },
                                            {
                                                "example_id": "23bcc98a-db10-45c3-a273-e537e0c564cd",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "Die Tänzerinnen wurden vom Publikum bejubelt."
                                            },
                                            {
                                                "example_id": "87be2722-e56d-4c35-b7bc-01115c03f543",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "„Von einer Tänzerin erfuhr ich, dass man beim Ballett gleichzeitig schweben und stabiler als jemand sonst auf dem Boden stehen könne.“"
                                            },
                                            {
                                                "example_id": "ae043ba5-643b-4b85-a106-cda9475d727f",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "„Sogar Tänzerin bin ich einmal gewesen.“"
                                            },
                                            {
                                                "example_id": "d2ebdb4a-5ff0-44aa-81ca-23b2739f18fc",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "„Djuna trat so herein, wie eine echte Tänzerin auftritt.“"
                                            },
                                            {
                                                "example_id": "4d5d3aeb-eabd-47ff-90da-ecde7e9b955f",
                                                "sense_id": "e3237ed4-1e22-340b-9822-0315a2e7f711",
                                                "text": "„Natascha fasste mit rundgewinkelten Armen ihr Kleid an wie eine Tänzerin, lief einige Schritte zurück, drehte sich herum, vollführte einen Entrechat, schlug mit den Füsschen gegeneinander und machte dann einige Schritte auf den alleräussersten Spitzen ihrer Schuhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3db1abc9-1c4b-4d3d-aab2-33c02043578d",
                        "source_entry_id": "52f16ff9-9877-3354-a35b-096370f4e1a5",
                        "source_sense_id": "6b179ce3-f792-37b8-b39c-22626cf7455f",
