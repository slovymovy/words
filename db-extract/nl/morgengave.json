                        "sense_id": "390aafe0-d70e-35b6-ad9d-6f6274f96872",
                        "entry_id": "8950ab13-6d86-3636-b10c-7ef6df6d3473",
                        "glosses": [
                            "een bruidsschat die binnen het Morganatische huwelijk door een man aan zijn vrouw wordt gegeven de ochtend na de huwelijksnacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb31d64-d9a2-481f-a7d6-92c918302d38",
                                "sense_id": "390aafe0-d70e-35b6-ad9d-6f6274f96872",
                                "text": "De morgengave is nu puur symbolisch maar was vroeger noodzaak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12cee5cb-45a9-4410-8dbb-68af81f067e1",
                        "source_entry_id": "8950ab13-6d86-3636-b10c-7ef6df6d3473",
                        "source_sense_id": "390aafe0-d70e-35b6-ad9d-6f6274f96872",
                        "source_sense_description": "een bruidsschat die binnen het Morganatische huwelijk door een man aan zijn vrouw wordt gegeven de ochtend na de huwelijksnacht",
                        "target_lang_word": "Morgengabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgengabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "307cf7ac-2c86-3786-9e09-e5a58ce1527e",
                                        "entry_id": "5e0a4366-33cf-3138-aa81-f11c830060d5",
                                        "glosses": [
                                            "Geschenk des Ehemannes an die Frau am Morgen nach der Hochzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a601674-77c1-4849-8167-38ffe1da4e0b",
                                                "sense_id": "307cf7ac-2c86-3786-9e09-e5a58ce1527e",
                                                "text": "„Wenn ihr Vater sich weigert, sie ihm zu geben, wäge er Silber dar nach der Morgengabe der Jungfrauen.“"
                                            },
                                            {
                                                "example_id": "cfa27d63-0172-4532-80b4-60881e9a03fc",
                                                "sense_id": "307cf7ac-2c86-3786-9e09-e5a58ce1527e",
                                                "text": "„Die Braut war in weiße Seide gehüllt, und ihr war eine reiche Morgengabe versprochen worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e2602d-50ce-4e0b-a256-d31ec85444ba",
                        "source_entry_id": "8950ab13-6d86-3636-b10c-7ef6df6d3473",
                        "source_sense_id": "390aafe0-d70e-35b6-ad9d-6f6274f96872",
                        "source_sense_description": "een bruidsschat die binnen het Morganatische huwelijk door een man aan zijn vrouw wordt gegeven de ochtend na de huwelijksnacht",
                        "target_lang_word": "dower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c026adf3-4487-3994-921d-f5fdf1d70752",
                                        "entry_id": "82625426-7443-3d82-9e1f-c73fa7ad8394",
                                        "glosses": [
                                            "The part of or interest in a deceased husband's property provided to his widow, usually in the form of a life estate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31e78649-43c9-3c3a-a4e8-b7cecc42a355",
                                        "entry_id": "82625426-7443-3d82-9e1f-c73fa7ad8394",
                                        "glosses": [
                                            "Property given by a groom to his bride or her family, at or before their wedding, in order to legitimize the marriage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c65fafb-c6b3-4314-9831-cbc827f35567",
                                                "sense_id": "31e78649-43c9-3c3a-a4e8-b7cecc42a355",
                                                "text": "[…] how features are abroad, / I am skill-less of; but, by my modesty,— / The jewel in my dower,—I would not wish / Any companion in the world but you […]"
                                            },
                                            {
                                                "example_id": "08cff2ae-2cc0-4519-a011-e911d1d2140c",
                                                "sense_id": "31e78649-43c9-3c3a-a4e8-b7cecc42a355",
                                                "text": "In New Bedford, fathers, they say, give whales for dowers to their daughters, and portion off their nieces with a few porpoises a-piece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b23d6c2-0018-398b-9c9c-ee7117fa103e",
                                        "entry_id": "82625426-7443-3d82-9e1f-c73fa7ad8394",
                                        "glosses": [
                                            "That with which one is gifted or endowed; endowment; gift."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d851b85d-150a-4f00-87ae-672b08230c34",
                                                "sense_id": "2b23d6c2-0018-398b-9c9c-ee7117fa103e",
                                                "text": "How great, how plentiful, how rich a dower!"
                                            },
                                            {
                                                "example_id": "3ab0263b-e930-4c4a-80ab-4471c664a188",
                                                "sense_id": "2b23d6c2-0018-398b-9c9c-ee7117fa103e",
                                                "text": "Man in his primeval dower arrayed."
                                            },
                                            {
                                                "example_id": "a98bd716-e4ef-4cf8-bc84-0e50a53aa202",
                                                "sense_id": "2b23d6c2-0018-398b-9c9c-ee7117fa103e",
                                                "text": "For though God had bestowed on her the rare dower of a fine mind, He had not added to it the much more common, though infinitely less precious gift, of a quick intellect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "437b6586-6b00-3651-8849-b0613ec091f1",
                                        "entry_id": "c07c492a-5dfe-3e32-a5dd-fdff34c2b414",
                                        "glosses": [
                                            "To give a dower or dowry to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc36658d-fbe2-4841-80bb-df9f9f14fd60",
                                                "sense_id": "437b6586-6b00-3651-8849-b0613ec091f1",
                                                "text": "He had married a lady well educated and softly nurtured, but not dowered with worldly wealth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d054fce-a910-36a1-9354-15ed1e752b06",
                                        "entry_id": "c07c492a-5dfe-3e32-a5dd-fdff34c2b414",
                                        "glosses": [
                                            "To endow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25551716-08b0-495a-b179-c5cfc883a553",
                                                "sense_id": "6d054fce-a910-36a1-9354-15ed1e752b06",
                                                "text": "It was nothing of this earth, but a piece of the great outside; and as such dowered with outside properties and obedient to outside laws."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a52db487-5315-3855-bda3-2beece2a15f3",
                                        "entry_id": "584152ad-71a5-39d8-9bc1-762d66eea8a8",
