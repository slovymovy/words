        "fr-extract.jsonl": [
            {
                "entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                "word": "orfraie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0339a53-ab6b-4467-904a-fddc9eafc581",
                        "entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "tags": [
                            "plural"
                        ],
                        "form": "orfraies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0975127-5fdf-38e8-b5fd-913e88d88b1f",
                        "entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "glosses": [
                            "Oiseau de proie diurne, l’aigle pygargue (Haliaeetus albicilla)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "68f2e6a0-efe5-46c2-9c93-32f58b62cf42",
                                "sense_id": "f0975127-5fdf-38e8-b5fd-913e88d88b1f",
                                "text": "Le chasseur Sabine parvint à abattre un couple de ces gigantesques orfraies, dont l’envergure mesurait près de six pieds, – magnifiques échantillons de ces oiseaux voyageurs, exclusivement ichtyophages, que l’hiver chasse jusqu’aux rivages du golfe du Mexique, et que l’été ramène vers les plus hautes latitudes de l’Amérique septentrionale."
                            },
                            {
                                "example_id": "f0fa1502-6538-4d97-bde9-9c856d13243f",
                                "sense_id": "f0975127-5fdf-38e8-b5fd-913e88d88b1f",
                                "text": "La citation : Tout le monde ne peut pas être orphelin devenait : Tout le monde ne peut pas être orfrelin (petit de l'orfraie, en patois, par confusion d'orfraie avec effraie, comme dans Rousseau et Balzac)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0988beed-f2b4-3850-b351-9bec1a21d5a0",
                        "entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "glosses": [
                            "Synonyme de balbuzard (au sens large) ou de balbuzard pêcheur (au sens étroit)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "13e767f3-70ab-3247-a689-10acb75ae6ac",
                        "entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "glosses": [
                            "Oiseau de mauvais augure."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1f7e1294-19a9-4eb7-a81d-557e04cdfee2",
                                "sense_id": "13e767f3-70ab-3247-a689-10acb75ae6ac",
                                "text": "Vile sorcière ! détestable scélérate ! hideuse orfraie ! s’écria Front-de-Bœuf, c’est donc toi qui viens jouir de la vue de mon désespoir."
                            },
                            {
                                "example_id": "58bcf6a7-b6a2-4012-a556-cd090a6d5904",
                                "sense_id": "13e767f3-70ab-3247-a689-10acb75ae6ac",
                                "text": "Samuel était fort curieux de savoir si ses Orfraies [un recueil de poésies] avaient charmé l’âme de cette belle mélancolique, et si les cris de ces vilains oiseaux lui avaient parlé en sa faveur."
                            },
                            {
                                "example_id": "becb50bc-36ad-4310-aa9b-aef87819126d",
                                "sense_id": "13e767f3-70ab-3247-a689-10acb75ae6ac",
                                "text": "Le leader parlementaire Simon Jolin-Barrette en a poussé un cri d’orfraie totalement excessif et déplacé ; mais sur le fond, il y avait de quoi rager."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5154043e-0a45-4924-9e12-12039c8d0507",
                        "source_entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "target_lang_word": "Seeadler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeadler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "großer Greifvogel aus der Gattung Haliaeetus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e77fa38-cd48-48d9-a142-c4a9062593ee",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "Seeadler sind beeindruckende Vögel."
                                            },
                                            {
                                                "example_id": "089ec714-57a2-49c3-984f-5345f175e979",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "„Darß und Zingst sind Brutheimat des Seeadlers; zahlreiche See- und Küstenvögel brüten auf den Inseln Oie und Kirr, auf den Bülten, den Wiesen und großen Vogelschutzgebieten Hiddensees.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "speziell der einheimische Haliaeetus albicilla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86852488-a48b-4a23-9c4f-4047bafeea46",
                                                "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                                "text": "Der Seeadler ist auch der Wappenvogel Deutschlands."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d83547c-8d5a-4fa6-97ce-3b9f0fdf405c",
                        "source_entry_id": "a19f0e67-fc7c-3b34-b9d7-870f03429c44",
                        "target_lang_word": "zeearend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeearend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                                        "entry_id": "411fe011-72ca-3a86-b4ad-a506ee53cacc",
                                        "glosses": [
                                            "bepaald soort roofvogel die in kustgebieden leeft, Haliaeetus albicilla, de grootste Europese arend"
                                        ],
                                        "tags": [
                                            "havikachtigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78768cb6-87e5-414d-8411-c3425d90ae7c",
                                                "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                                                "text": "De zeearend heeft zich in de laatste jaren weer als broedvogel in Nederland gevestigd."
                                            },
                                            {
                                                "example_id": "adce88be-0459-4857-b05b-8852c242af50",
                                                "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                                                "text": "Lena zat op de bank onder een groot schilderij van Bruno Liljefors, een zeearend die op een sneeuwhaas joeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
