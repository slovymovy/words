                "senses": [
                    {
                        "sense_id": "35fa218c-eacb-31d8-89f5-9dfd85526602",
                        "entry_id": "79155e87-aa40-3677-8618-39cca9728378",
                        "glosses": [
                            "betrekking hebbend op de waterbouwkunde"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "da3cdbc5-3c8a-454b-b1c8-41f0cda1aade",
                                "sense_id": "35fa218c-eacb-31d8-89f5-9dfd85526602",
                                "text": "De waterschappen investeerden ook fors in grond-, weg- en waterbouwkundige werken. Daardoor zijn hun bezittingen toegenomen tot bijna 9 miljard euro."
                            },
                            {
                                "example_id": "b40276a0-72d5-4c49-9d2c-395e39f46ec1",
                                "sense_id": "35fa218c-eacb-31d8-89f5-9dfd85526602",
                                "text": "Baggeraar Van Oord mag weer aan de slag in Dubai. Het Rotterdamse bedrijf heeft opdracht verkregen voor de waterbouwkundige werkzaamheden van het project Dubai Harbour. Naast 1400 aanlegplaatsen voor schepen wordt in de haven ook een cruise-terminal aangelegd."
                            },
                            {
                                "example_id": "bc413b1d-b3e1-48f7-b992-6ef76cb9bca4",
                                "sense_id": "35fa218c-eacb-31d8-89f5-9dfd85526602",
                                "text": "De enige waterbouwkundige ingrepen zijn de lage dammen in de rivier, die om de paar kilometer het water richting de watermolens op de oever stuwen. Reusachtige molens die tot in de jaren ’60 van de vorige eeuw het graan maalden."
                            },
                            {
                                "example_id": "b5331d23-66e3-4f0b-bcdf-adebdab54fda",
                                "sense_id": "35fa218c-eacb-31d8-89f5-9dfd85526602",
                                "text": "Het pronkstuk van Nederland: Architectuur mag in het geheel niet meedoen aan de verkiezing van het pronkstuk. Ballet, toneel, nieuwe media en film zijn ook uitgesloten en Nederlands trots, de waterbouwkundige werken zijn niet genomineerd. Het suffe Wilhelmus is de enige muzikale nominatie."
                            }
                        ]
                    }
