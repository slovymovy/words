                                        "glosses": [
                                            "převod pohledávky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf57f9f-de78-4bff-833d-b8e99d909a37",
                                                "sense_id": "ab98a52c-3117-34b9-a465-2ca419dfba3a",
                                                "text": "Je-li pohledávka jednou osobou převedena na druhou a touto přijata, vzniká změna práva přistoupením nového věřitele. Takové jednání nazývá se postup (cesse) a může býti sjednáno za plat nebo bezplatně."
                                            }
                                        ]
                                    },
