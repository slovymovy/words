                "translations": [
                    {
                        "translation_id": "e594b1e9-e646-410a-adc4-6b1258024bc1",
                        "source_entry_id": "762ad302-3362-3239-bae8-45622ef93c61",
                        "source_sense_id": "86fb6d74-e942-3640-bd2c-07d25e3bbeb5",
                        "target_lang_word": "fearlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                        "entry_id": "48c498bb-88e0-3708-9ef9-5943c45bda0a",
                                        "glosses": [
                                            "The quality of being fearless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59db7d8b-8d8d-4784-95e3-30c294c056ae",
                                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                                "text": "Anne was indignant with that straight-out and generous indignation which belongs to women, who are ready to follow their principles to any result with more inconsiderate fearlessness than men."
                                            },
                                            {
                                                "example_id": "44907e95-c803-43aa-9d12-3e0a4e35a362",
                                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                                "text": "The only thing to fear is fearlessness / The bigger the weapon, the greater the fear / Hyena is ambassador to here"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea988046-9f4f-4ebb-811e-b6aed2f967bf",
                        "source_entry_id": "762ad302-3362-3239-bae8-45622ef93c61",
                        "source_sense_id": "86fb6d74-e942-3640-bd2c-07d25e3bbeb5",
                        "target_lang_word": "boldness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boldness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fda139b7-ec26-338f-b5a5-0543576fbcc6",
                                        "entry_id": "fc8bef36-e9b5-3bdf-8859-015108a00402",
                                        "glosses": [
                                            "The state of being bold; courage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d519374-5082-41e6-b445-cbd5d492ca1b",
                                                "sense_id": "fda139b7-ec26-338f-b5a5-0543576fbcc6",
                                                "text": "Then he warmed to it, and smoothly set out all his shifts, malices, and treacheries, his extreme boldnesses (he was desperate bold); his retreats, shufflings, and counterfeitings (he was also inconceivably a coward) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc55c15-d3ef-30d5-aba2-4d4b064003be",
                                        "entry_id": "fc8bef36-e9b5-3bdf-8859-015108a00402",
