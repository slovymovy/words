                            "Schweizerdeutsch (Dec̄heli)"
                        ],
                        "examples": [
                            {
                                "example_id": "c542388d-80ba-431c-9787-5593c99d6bc6",
                                "sense_id": "2a742d93-3232-3876-a67c-b315de606593",
                                "text": "Aber iez chunnt esang dem Mönsche⸗n i d'Auge de Schlafgott, | D' Decheli falle vo sälber ne zue, si bruuche kei Bschließer. [Augendeckel]"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
