{
    "word_family": [
        "odd",
        "oddity",
        "oddness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                    "sense_definition": "In a strange, unusual, or peculiar manner",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strangeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streets were <w>oddly</w> quiet for a busy Friday afternoon.",
                            "target_lang_translations": {
                                "de": "Die Straßen waren für einen geschäftigen Freitagnachmittag <w>seltsam</w> ruhig.",
                                "ru": "Улицы были <w>странно</w> тихими для оживленного дня пятницы."
                            }
                        },
                        {
                            "text": "She looked at him <w>oddly</w> when he suggested walking home in the rain.",
                            "target_lang_translations": {
                                "de": "Sie sah ihn <w>merkwürdig</w> an, als er vorschlug, im Regen nach Hause zu laufen.",
                                "ru": "Она <w>странно</w> посмотрела на него, когда он предложил пойти домой пешком под дождем."
                            }
                        }
                    ],
                    "synonyms": [
                        "curiously",
                        "queerly"
                    ],
                    "common_phrases": [
                        "oddly enough",
                        "oddly familiar",
                        "oddly quiet"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf eine seltsame, ungewöhnliche oder merkwürdige Art und Weise",
                        "ru": "Странно, необычно или причудливо"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "seltsam",
                                "target_lang_sense_clarification": "auf eine eigenartige Weise"
                            },
                            {
                                "target_lang_word": "merkwürdig",
                                "target_lang_sense_clarification": "auffallend oder unerwartet sonderbar"
                            },
                            {
                                "target_lang_word": "komisch",
                                "target_lang_sense_clarification": "befremdlich oder unverständlich"
                            },
                            {
                                "target_lang_word": "eigenartig",
                                "target_lang_sense_clarification": "ungewöhnlich"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "странно",
                                "target_lang_sense_clarification": "необычным образом"
                            },
                            {
                                "target_lang_word": "необычно",
                                "target_lang_sense_clarification": "не так, как обычно или принято"
                            },
                            {
                                "target_lang_word": "чудно",
                                "target_lang_sense_clarification": "причудливо или чудаковато"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                    "sense_definition": "In an odd-numbered quantity or manner",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sequence of houses was <w>oddly</w> numbered along the northern side of the street.",
                            "target_lang_translations": {
                                "de": "Die Häuserreihe an der Nordseite der Straße war mit <w>ungeraden</w> Nummern versehen.",
                                "ru": "Дома по северной стороне улицы имели <w>нечетную</w> нумерацию."
                            }
                        },
                        {
                            "text": "The items were <w>oddly</w> grouped into sets of three and five rather than pairs.",
                            "target_lang_translations": {
                                "de": "Die Gegenstände waren in <w>ungeraden</w> Gruppen von drei und fünf statt paarweise angeordnet.",
                                "ru": "Предметы были <w>нечетно</w> сгруппированы по три и пять штук вместо пар."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oddly numbered"
                    ],
                    "target_lang_definitions": {
                        "de": "In einer ungeraden Anzahl oder Anordnung",
                        "ru": "Нечетным числом или способом, связанным с нечетными числами"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ungerade",
                                "target_lang_sense_clarification": "auf ungerade Zahlen oder Anzahlen bezogen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нечетно",
                                "target_lang_sense_clarification": "нечетным числом или порядком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}