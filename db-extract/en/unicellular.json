                "senses": [
                    {
                        "sense_id": "bbd65eac-e1fb-36b5-be4a-6622ebac2471",
                        "entry_id": "6fa88120-9bc0-3a7b-b276-63b32848599a",
                        "glosses": [
                            "A single-celled organism; a unicell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54edd899-b00e-4867-aebe-7f416afdaf04",
                                "sense_id": "bbd65eac-e1fb-36b5-be4a-6622ebac2471",
                                "text": "Among unicellulars, the rate of increase is beyond belief."
                            },
                            {
                                "example_id": "672772d3-4493-4f78-9657-ded9a8ef50ea",
                                "sense_id": "bbd65eac-e1fb-36b5-be4a-6622ebac2471",
                                "text": "In unicellulars the uncoupling of the various nutritional and energy sources is much more widely spread."
                            },
                            {
                                "example_id": "9d8532f4-6d5b-493f-9799-856b120b9561",
                                "sense_id": "bbd65eac-e1fb-36b5-be4a-6622ebac2471",
                                "text": "More or less distinct specialisation of reproductive elements in some unicellulars."
                            }
                        ]
                    }
