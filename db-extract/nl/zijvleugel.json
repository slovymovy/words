                "senses": [
                    {
                        "sense_id": "c04dbc71-ef06-3980-b572-599da12ee9f6",
                        "entry_id": "8a3f2b59-45b1-388f-8cc7-2b2d43f99145",
                        "glosses": [
                            "een deel van een gebouw dat aan de zijkant staat van het centraal gelegen hoofdgebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecd78db-c90b-46ea-aa31-2ff68d6434eb",
                                "sense_id": "c04dbc71-ef06-3980-b572-599da12ee9f6",
                                "text": "Ronddwalen kan, want het middengedeelte is open voor het publiek. Het paleis-hotel is namelijk één van de grootste bezienswaardigheden van Abu Dhabi. De zijvleugels zijn afgesloten en alleen voor betalende gasten. Logisch ook, als je duizenden euro's neerlegt voor een overnachting..."
                            },
                            {
                                "example_id": "52f5abe5-0324-45c0-8ceb-a65d82561bd3",
                                "sense_id": "c04dbc71-ef06-3980-b572-599da12ee9f6",
                                "text": "Het reuzenrad staat 20 meter uit de kust op een nieuw platform, dat als een zijvleugel aan de pier is gebouwd. Maartje Egberink en Anouk Wolf uit het Twentse Bornerbroek zijn een weekendje in Den Haag en stappen als een van de eerste bezoekers in de attractie. Terwijl de gondel langzaam omhoog wiebelt kijkt Maartje verschrikt om zich heen. ,,Ze heeft een beetje last van hoogtevrees”, grapt Anouk."
                            }
                        ]
                    },
                    {
                        "sense_id": "5eed7755-07a1-3602-9a69-e30e6715c3f1",
                        "entry_id": "8a3f2b59-45b1-388f-8cc7-2b2d43f99145",
                        "glosses": [
                            "de zijlinie van een militaire opstelling"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9314f95-14aa-4fbb-8e96-43bdcbacf5bd",
                        "source_entry_id": "8a3f2b59-45b1-388f-8cc7-2b2d43f99145",
                        "source_sense_id": "c04dbc71-ef06-3980-b572-599da12ee9f6",
                        "target_lang_word": "spur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5c66d27-85b5-357d-8c5e-64b60f4cf16e",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "A rigid implement, often roughly y-shaped, that is fixed to one's heel for the purpose of prodding a horse. Often worn by, and emblematic of, the cowboy or the knight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d115e72-7ec2-4a4b-9e2b-5dfff3dd7fc4",
                                                "sense_id": "d5c66d27-85b5-357d-8c5e-64b60f4cf16e",
                                                "text": "Lives he, good uncle? thrice within this hour I saw him down; thrice up again, and fighting; From helmet to the spur all blood he was."
                                            },
                                            {
                                                "example_id": "2353d7b3-eaeb-4291-a243-be9a23a4fc24",
                                                "sense_id": "d5c66d27-85b5-357d-8c5e-64b60f4cf16e",
                                                "text": "Tvvo ſorts of ſpurs ſeem to have been in uſe about the time of the Conqueſt, one called a pryck, having only a ſingle point like the gaffle of a fighting cock; the other conſiſting of a number of points of a conſiderable length, radiating from and revolving on a center, thence named the rouelle or vvheel ſpur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad1fe8c-b504-385d-ba6d-5db5a0e4f7b0",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "A jab given with the spurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b4b0a6-8f24-41ac-bc78-8aa91ab3d81a",
                                                "sense_id": "1ad1fe8c-b504-385d-ba6d-5db5a0e4f7b0",
                                                "text": "I had hardly said the word, when Kit jumped into the saddle, and gave his horse a whip and a spur — and off it cantered, as if it were in as great a hurry to be married as Kit himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b97330e6-0db9-3e48-8508-b45c46d7ada2",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "Anything that inspires or motivates, as a spur does a horse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18edd200-de19-4c70-86bc-461859e6a7e5",
                                                "sense_id": "b97330e6-0db9-3e48-8508-b45c46d7ada2",
                                                "text": "She is a theame of honour and renowne, / A ſpurre to valiant and magnanimous deeds, / Whoſe preſent courage may beate downe our foes, / And fame in time to come canonize us, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a98c7a-9f86-3e99-896d-99956fea1e82",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "An appendage or spike pointing rearward, near the foot, for instance that of a rooster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19207865-4bc0-32b6-85df-815d2de68092",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "Any protruding part connected at one end, for instance a highway that extends from another highway into a city."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dcef1eb-a5f4-391d-a05f-e0ad0a861e61",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "Roots, tree roots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95e57a7-f9b2-440f-b929-ae114ac70ab6",
                                                "sense_id": "2dcef1eb-a5f4-391d-a05f-e0ad0a861e61",
                                                "text": "[…] the strong-bas'd promontory / Have I made shake; and by the spurs pluck'd up / The pine and cedar […]"
                                            },
                                            {
                                                "example_id": "42524ee5-cda3-4898-a917-f615c3c00b73",
                                                "sense_id": "2dcef1eb-a5f4-391d-a05f-e0ad0a861e61",
                                                "text": "I do note / That grief and patience, rooted in them both, / Mingle their spurs together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f71f2c9-b02a-3320-9fae-685821298da0",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "A mountain that shoots from another mountain or range and extends some distance in a lateral direction, or at right angles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7df1fd34-55f8-3929-ae3a-03845e0799c1",
                                        "entry_id": "55a72190-c735-3401-a178-efb06c954b87",
                                        "glosses": [
                                            "A spiked iron worn by seamen upon the bottom of the boot, to enable them to stand upon the carcass of a whale to strip off the blubber."
                                        ],
