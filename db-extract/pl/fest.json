                                "sense_id": "d5f34485-82cd-3f68-a632-1bd1aa45df05",
                                "text": "Poszelontej tą flaszką, ale tak fest.",
                                "translation": "Potrząśnij tą butelką, ale bardzo mocno."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
