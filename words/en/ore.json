                {
                    "sense_id": "825c03c6-dc9c-36fe-8dae-16e4406337bc",
                    "sense_definition": "Seaweed, especially that which is washed up ashore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seaweed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm left piles of rotting <w>ore</w> along the coastline.",
