                "senses": [
                    {
                        "sense_id": "558eb0c5-c5d3-3740-88fa-d71c26ba7553",
                        "entry_id": "26e059f9-2d34-3d37-b06b-384aaf0f33dd",
                        "glosses": [
                            "Veranstaltung, bei der mehrere Personen, meist Jäger, gemeinsam auf bestimmtes Wild jagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876584bc-5a81-44e7-8c17-86b9bf464779",
                                "sense_id": "558eb0c5-c5d3-3740-88fa-d71c26ba7553",
                                "text": "„Ich erwähne Herrn Beyrer deshalb, weil über ihn im Profil zu lesen war, dass er im Jahr 2008 von der Telekom Austria zu einem Jagdausflug ins schottischen Hochland eingeladen worden war.“"
                            },
                            {
                                "example_id": "9463ab60-a6fd-4ba3-bc2f-48e88b30d781",
                                "sense_id": "558eb0c5-c5d3-3740-88fa-d71c26ba7553",
                                "text": "„Die Ermordung Habibullahs I. während eines Jagdausflugs am 12. Februar 1919 löste umgehend Thronstreitigkeiten aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
