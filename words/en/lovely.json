                },
                {
                    "sense_id": "554696a0-3ef8-3b55-8e63-08cc82951f6e",
                    "sense_definition": "Very pleasant, enjoyable, or wonderful.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aesthetic_pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would be <w>lovely</w> to see you again soon.",
