                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7111d1-a31b-42f2-a4f2-e1722ac60b81",
                                "sense_id": "f25fe305-5c34-30ec-93da-3abf2201d4fd",
                                "text": "„Im Jahr 2004 wurden den Vertretungen der Gläubiger mehrmals Vorschläge unterbreitet, die einen Kapitalschnitt von 75%, später 65% vorsahen. Sie stießen zunächst besonders bei den ausländischen Gläubigern, die mehr als 55% des Schuldenvolumens reklamieren, allgemein auf Ablehnung und trübten auch Argentiniens Verhältnis mit dem IWF.“"
                            },
                            {
                                "example_id": "1b440ee1-ee32-4c8c-9f16-9b879eb0dc03",
                                "sense_id": "f25fe305-5c34-30ec-93da-3abf2201d4fd",
                                "text": "„Während die durchschnittliche Verschuldung um 400 Euro auf 32.600 Euro zurückgegangen ist, hat sich das gesamte Schuldenvolumen aus Konsumentenkrediten um eine Milliarde Euro auf 218 Milliarden Euro weiter erhöht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
