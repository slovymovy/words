        "fr-extract.jsonl": [
            {
                "entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                "word": "préambule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8c78407-c61d-47c3-ab25-697eea8b0c35",
                        "entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "tags": [
                            "plural"
                        ],
                        "form": "préambules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afddcb96-b844-350a-8edd-9f8ea756f61c",
                        "entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "glosses": [
                            "Avant-propos ; entrée en matière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6648f045-8a02-4212-8faf-46e4f50ab844",
                                "sense_id": "afddcb96-b844-350a-8edd-9f8ea756f61c",
                                "text": "La dame ne comptait pas s’en tenir aux préambules épistolaires, puisqu’elle lui annonçait un prochain rendez-vous, sous prétexte de lui donner des nouvelles d’Héva, […]."
                            },
                            {
                                "example_id": "445f4073-20a0-4295-a239-e68f5f91b057",
                                "sense_id": "afddcb96-b844-350a-8edd-9f8ea756f61c",
                                "text": "Et sans autre préambule, avant qu’elle s’y attendît, il la gifla si largement qu’il l’envoya culbuter contre le lit d’un seul revers de main."
                            },
                            {
                                "example_id": "5bdaae3a-3bc3-4aa6-ab11-5f12888feee2",
                                "sense_id": "afddcb96-b844-350a-8edd-9f8ea756f61c",
                                "text": "Arsène André perçait enfin la brume de ce préambule. Ah ! ah ! l’hypocrisie hargneuse le circonvenait comme un filet de chasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c3a1841-e9a1-328d-affd-7f2503e5194a",
                        "entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "glosses": [
                            "Partie préliminaire d’une constitution, d’une loi, d’un édit, d’une ordonnance, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "23abceba-1942-3d75-b23c-aef2b193f42a",
                        "entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "glosses": [
                            "Introduction vague et longuette."
                        ],
                        "tags": [
                            "figuratively",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "b9298776-919c-4f15-a863-b56fe8b64d00",
                                "sense_id": "23abceba-1942-3d75-b23c-aef2b193f42a",
                                "text": "Pas tant de préambules, venez au fait."
                            },
                            {
                                "example_id": "8a07da6f-a550-4a63-bb2a-a3f2ab5f0dc1",
                                "sense_id": "23abceba-1942-3d75-b23c-aef2b193f42a",
                                "text": "Il m’ennuie avec ses préambules."
                            },
                            {
                                "example_id": "61cc88f0-faa1-4eb6-bf21-0a96e5aa30d8",
                                "sense_id": "23abceba-1942-3d75-b23c-aef2b193f42a",
                                "text": "Un préambule que la suite a contredit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a33ebb9d-a8ab-4b01-b8c1-aa5e78bd09de",
                        "source_entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "source_sense_description": "avant-propos, entrée en matière",
                        "target_lang_word": "preface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A beginning or introductory portion that comes before the main text of a document or book, typically serving to contextualize or explain the writing of the book and sometimes to acknowledge others' contributions; especially, such a discussion written by the work's own author."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b306a6b7-7406-41ad-b114-4d969963a503",
                                                "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                                "text": "Holonyms: front matter, prelims"
                                            },
                                            {
                                                "example_id": "543b85f9-24e9-4336-8aeb-5670301e0e64",
                                                "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                                "text": "The book included a brief preface explaining the author's motivations for writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "An introduction, or series of preliminary remarks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6512da1-0042-44f2-abfa-71703ae5ba2c",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "This superficial tale / Is but a preface of her worthy praise."
                                            },
                                            {
                                                "example_id": "53726171-f07c-415c-aa8c-b64555bb4667",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "Heav'ns high behest no preface needs."
                                            },
                                            {
                                                "example_id": "59dab612-43f6-4ae2-89f2-95c4be3ae605",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "And now, without any further preface, we proceed to our next chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c8cbef0-44b7-3e1d-9f7e-87bb79fa4195",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A variable prayer forming the prelude or introduction to the Eucharistic Prayer or canon of the Mass, following the Sursum corda dialogue and leading into the Sanctus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e9d2e9-9593-45b4-b7c8-436afa11840b",
                                                "sense_id": "5c8cbef0-44b7-3e1d-9f7e-87bb79fa4195",
                                                "text": "Meronyms: protocol, embolism, eschatocol"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdd8572-5c21-3602-9281-26c2b657017c",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A title or epithet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82db2888-9271-4e37-a454-15e682148d0f",
                                                "sense_id": "5bdd8572-5c21-3602-9281-26c2b657017c",
                                                "text": "[…] a black-tie dinner to celebrate on the eve of the ceremony which would remove the preface \"Sir\" from his name and replace it with the preface \"Lord,\" thought by some to be one of the most potent words in the English language."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d4d107-3031-3614-9ca5-19c150a0d1a9",
                                        "entry_id": "35a8dea7-e7b8-31a3-8071-c8ef3cd18212",
                                        "glosses": [
                                            "To introduce or make a comment before (the main point); to premise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4f5238-93ad-4d99-be22-8dc3c86e15d1",
                                                "sense_id": "e0d4d107-3031-3614-9ca5-19c150a0d1a9",
                                                "text": "Let me preface this by saying that I don't know him that well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fbf5916-aaf6-3b27-9722-094a99c7b10c",
                                        "entry_id": "35a8dea7-e7b8-31a3-8071-c8ef3cd18212",
                                        "glosses": [
                                            "To give a preface to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0994044f-c092-4558-bdb4-3d899f8c0c5d",
                                                "sense_id": "3fbf5916-aaf6-3b27-9722-094a99c7b10c",
                                                "text": "to preface a book"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2551c9b4-311f-4c14-b0df-fb91bbe1de3e",
                        "source_entry_id": "df0db35b-fce2-39ae-9b82-577f7d87c86f",
                        "source_sense_description": "avant-propos, entrée en matière",
                        "target_lang_word": "preamble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preamble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "347827ec-9555-3794-94a9-fb650a2eecba",
                                        "entry_id": "3087a47a-a659-3230-b8ba-2169594c954d",
                                        "glosses": [
                                            "A short preliminary statement or remark, especially an explanatory introduction to a formal document or statute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f7b6cb-45cd-4f90-ad5c-634d9622589b",
                                                "sense_id": "347827ec-9555-3794-94a9-fb650a2eecba",
                                                "text": "The consultation preamble explains: \"The planned timetable will be introduced in 2025 once we have completed the necessary steps required to ensure that we have enough resources to do so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b471de-218e-3935-9dca-96ceee301080",
                                        "entry_id": "3087a47a-a659-3230-b8ba-2169594c954d",
                                        "glosses": [
                                            "A syncword."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4475a4c-167a-3838-a9c1-1e65d7b66a31",
                                        "entry_id": "3087a47a-a659-3230-b8ba-2169594c954d",
                                        "glosses": [
                                            "A precursor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af62997a-b639-42a3-a3bf-df41b133632e",
                                                "sense_id": "a4475a4c-167a-3838-a9c1-1e65d7b66a31",
                                                "text": "And lest any man should think her intent was to unnestle ill neighbours, and not to aid good neighbours, or that she was readier to restore what was invaded by others than to render what was in her own hands; see if the time provided not a new occasion afterwards, when through their own division, without the intermise of strangers, her forces were again sought and required; she forsook them not, prevailed so far as to be possessed of the castle of Edinburgh, the principal strength of that kingdom, with peace, incontinently, without cunctations or cavillations, the preambles of a wavering faith, she rendered with all honour and security; and his person to safe and faithful hands; and so ever after during his minority continued his principal guardian and protector."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preamble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b000799d-b9a1-3d24-8319-30f70246d5ce",
                                        "entry_id": "4a792110-5460-30ee-a068-3c46423f0025",
                                        "glosses": [
                                            "To speak or write a preamble; to provide a preliminary statement or set of remarks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68240241-411e-4d77-8f2b-9a1ccc252f87",
                                                "sense_id": "b000799d-b9a1-3d24-8319-30f70246d5ce",
                                                "text": "But these things being beside my main design, I will desist from preambling and come to the materials I have collected towards a history of the Baptists in this province."
                                            },
                                            {
                                                "example_id": "a17a719c-cdc7-442a-8692-4546c6d77e5e",
                                                "sense_id": "b000799d-b9a1-3d24-8319-30f70246d5ce",
                                                "text": "Once I was young and had so much more orientation and could talk with nervous intelligence about everything and with clarity and without as much literary preambling as this; in other words this is the story of an unself-confident man, at the same time of an egomaniac."
                                            },
                                            {
                                                "example_id": "5d2c5f82-f6b2-4efd-b267-19de9f8c2918",
                                                "sense_id": "b000799d-b9a1-3d24-8319-30f70246d5ce",
                                                "text": "So, what say we skip the preambling. Is it women? Money? Writer's block?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
