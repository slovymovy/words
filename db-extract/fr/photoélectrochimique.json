                        "sense_id": "b96735ed-6b5a-32e5-9d3d-807ea0fb34ac",
                        "entry_id": "7508d69e-14f2-3d40-bb64-f51b36913672",
                        "glosses": [
                            "Relatif aux réactions chimiques liées à la lumière ou aux photons."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "745f1226-1619-457b-a918-eebf42263c26",
                                "sense_id": "b96735ed-6b5a-32e5-9d3d-807ea0fb34ac",
                                "text": "Il existe actuellement deux types de cellule photoélectrochimique : la cellule à photolyse et la cellule solaire nanocristalline à colorant ou cellule de Graetzel."
                            },
                            {
                                "example_id": "56ea276d-2052-4cd6-8e0f-a50db9daf732",
                                "sense_id": "b96735ed-6b5a-32e5-9d3d-807ea0fb34ac",
                                "text": "Installés sur le toit, de tels capteurs solaires photoélectrochimiques pourraient alors fournir à chacun son hydrogène quotidien, pour son électricité, son chauffage et sa mobilité, l’hydrogène servant de carburant de véhicule."
                            }
                        ]
                    }
