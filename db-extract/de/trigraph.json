                                "target_senses": [
                                    {
                                        "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                        "entry_id": "749a746f-ba20-3914-b49b-9d31d1d64170",
                                        "glosses": [
                                            "A specific sequence of three letters, especially one used collectively to represent a single phoneme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c281fba0-170e-4d04-a9d5-f65fcb80f66b",
                                                "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                                "text": "Letter “i” is pronounced as /aɪ/ when followed by the trigraph “ght”, as in right /raɪt/."
                                            },
                                            {
                                                "example_id": "45fdaa07-bed6-4ecd-8d2d-f63bfbb69304",
                                                "sense_id": "7d06fbac-5898-3e17-9913-c525fb84e525",
                                                "text": "Then, practice reading fluency sentences together that contain words with trigraphs and other mastered words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1be2d94-275d-36d4-b2ce-b6b55740410e",
                                        "entry_id": "749a746f-ba20-3914-b49b-9d31d1d64170",
                                        "glosses": [
                                            "A three-character sequence used to enter a single conceptual character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5e1c20-4690-4c81-acf7-3c222a388421",
                                                "sense_id": "e1be2d94-275d-36d4-b2ce-b6b55740410e",
                                                "text": "These new features are charizing, stringization, token concatenation, string concatenation, trigraph replacement, and predefined macros."
                                            }
                                        ]
                                    }
