{
    "word_family": [
        "incident",
        "incidental",
        "incidentally",
        "coincidence",
        "coincidental"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f61005f-8ea0-32d2-afbf-7b8a6b66a939",
                    "sense_definition": "The frequency or rate at which something undesirable occurs or is present.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high <w>incidence</w> of heart disease in this region is a major concern for health officials.",
                            "target_lang_translations": {
                                "ru": "Высокий <w>уровень</w> сердечных заболеваний в этом регионе вызывает серьезную озабоченность у чиновников здравоохранения."
                            }
                        },
                        {
                            "text": "Studies show a lower <w>incidence</w> of the flu among people who exercise regularly.",
                            "target_lang_translations": {
                                "ru": "Исследования показывают более низкую <w>частоту</w> заболеваний гриппом среди людей, которые регулярно занимаются спортом."
                            }
                        }
                    ],
                    "synonyms": [
                        "frequency",
                        "prevalence",
                        "rate"
                    ],
                    "common_phrases": [
                        "high incidence",
                        "low incidence",
                        "incidence of disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частота или степень, с которой происходит или проявляется что-либо нежелательное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "показатель частоты возникновения"
                            },
                            {
                                "target_lang_word": "распространённость",
                                "target_lang_sense_clarification": "степень охвата"
                            },
                            {
                                "target_lang_word": "частота",
                                "target_lang_sense_clarification": "повторяемость событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe4cb7e-6cec-3fef-8004-438a6c5b178c",
                    "sense_definition": "The number of new cases of a specific medical condition occurring in a population during a certain period.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual <w>incidence</w> of the virus has decreased significantly since the vaccination program began.",
                            "target_lang_translations": {
                                "ru": "Ежегодная <w>заболеваемость</w> вирусом значительно снизилась с начала программы вакцинации."
                            }
                        },
                        {
                            "text": "Researchers are tracking the <w>incidence</w> rate to determine if the environmental factors are contributing to the illness.",
                            "target_lang_translations": {
                                "ru": "Исследователи отслеживают <w>показатель заболеваемости</w>, чтобы определить, способствуют ли факторы окружающей среды развитию болезни."
                            }
                        }
                    ],
                    "synonyms": [
                        "occurrence rate"
                    ],
                    "common_phrases": [
                        "incidence rate",
                        "annual incidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество новых случаев конкретного заболевания, возникающих в популяции за определенный период."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заболеваемость",
                                "target_lang_sense_clarification": "медицинский статистический показатель"
                            },
                            {
                                "target_lang_word": "частота случаев",
                                "target_lang_sense_clarification": "количество новых регистраций болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70d4ec8a-6b10-3bb4-966a-c2454d437401",
                    "sense_definition": "The way in which light or other radiation strikes a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angle of <w>incidence</w> is equal to the angle of reflection in a perfect mirror.",
                            "target_lang_translations": {
                                "ru": "Угол <w>падения</w> равен углу отражения в идеальном зеркале."
                            }
                        },
                        {
                            "text": "Solar panels are most efficient when the <w>incidence</w> of sunlight is direct.",
                            "target_lang_translations": {
                                "ru": "Солнечные панели наиболее эффективны, когда <w>падение</w> солнечного света является прямым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "angle of incidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым свет или другое излучение падает на поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "физический процесс попадания лучей на поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64ab1998-708d-3fc0-83cf-f5aaa90f31e6",
                    "sense_definition": "The way in which the burden of a tax or cost falls upon different groups.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists are debating the tax <w>incidence</w> to see if the consumers or the producers pay more.",
                            "target_lang_translations": {
                                "ru": "Экономисты спорят о <w>сфере действия</w> налога, чтобы понять, кто платит больше — потребители или производители."
                            }
                        },
                        {
                            "text": "The <w>incidence</w> of the new levy falls most heavily on low-income families.",
                            "target_lang_translations": {
                                "ru": "<w>Бремя</w> нового сбора тяжелее всего ложится на семьи с низким доходом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax incidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределение налогового бремени или издержек между различными группами лиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфера действия",
                                "target_lang_sense_clarification": "в контексте налогообложения"
                            },
                            {
                                "target_lang_word": "распределение",
                                "target_lang_sense_clarification": "налогового бремени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}