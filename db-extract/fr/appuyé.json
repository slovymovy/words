                                "text": "Appuyé sur le coude."
                            },
                            {
                                "example_id": "5dc5fdb9-d4bd-422d-a148-25e7ad5c3445",
                                "sense_id": "ca4f39ce-2877-30af-aa1c-dbf29a2a3461",
                                "text": "Appuyé sur sa lance."
                            }
                        ]
                    },
                    {
                        "sense_id": "f07ab180-76bf-3581-ad0c-ad0d4a4412c6",
                        "entry_id": "b1730690-c519-38af-a14a-0f60ce87068b",
                        "glosses": [
                            "Qui porte contre."
                        ],
                        "tags": [],
                        "examples": [
