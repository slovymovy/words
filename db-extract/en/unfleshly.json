                    {
                        "sense_id": "10c2df02-0fac-3721-af88-7f32e1d45bbd",
                        "entry_id": "73f8de68-4cb0-3fef-97d6-dbac876f2ffd",
                        "glosses": [
                            "Not pertaining to or devoted to the flesh or the body; not physical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fcb72fa-9c86-4c32-9f4c-129097a5a32d",
                                "sense_id": "10c2df02-0fac-3721-af88-7f32e1d45bbd",
                                "text": "1683, uncredited translator, Ecclesiastical History by Evagrius Scholasticus, Book 4, Chapter 33, in The History of the Church from Our Lord’s Incarnation, to the Twelfth Year of the Emperour Maricius Tiberius, London: Han. Sawbridge, p. 493,\nThis person lead an unfleshly life in the flesh, in a certain Monastery […]"
                            },
                            {
                                "example_id": "41900f22-dc19-4a49-8c6b-f299f3ddf1a4",
                                "sense_id": "10c2df02-0fac-3721-af88-7f32e1d45bbd",
                                "text": "c. 1721, Aaron Hill, The Fatal Extravagance, London: T. Jauncy, Epilogue,\nThe Bard, not carnal-minded,—say the Curious,\nHow come th’ unfleshly Folks, to be so furious?"
                            },
                            {
                                "example_id": "24b706dd-6c48-4d2a-94e0-e3fe290065d6",
                                "sense_id": "10c2df02-0fac-3721-af88-7f32e1d45bbd",
                                "text": "[…] her tears fell on his arm the while, unheeded—except by those unfleshly eyes, with which they say the very air is thronged."
                            },
                            {
                                "example_id": "29fc835a-1c7a-4f92-ad0d-43401331d4ed",
                                "sense_id": "10c2df02-0fac-3721-af88-7f32e1d45bbd",
                                "text": "[…] from its unfleshly character, as the women remember today, the spirituality of camp love became even more profound."
                            }
                        ]
                    }
                ],
