            {
                "entry_id": "d3c5128e-9696-30b7-988a-d31398932ab4",
                "word": "Sasha",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                        "entry_id": "d3c5128e-9696-30b7-988a-d31398932ab4",
                        "glosses": [
                            "A diminutive of the female given name Natasha."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee1fc8f-1128-403f-a8b2-e6dcc6672ce1",
                                "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                                "text": "The engagement is announced between Seth, son of Mrs Renate Forsyth, of Jacobstow, Cornwall, and the late Mr Neil Gale, of Wimbledon, London, and Natasha (Sasha), daughter of Mr and Mrs Francis Hussey, of Pease Pottage, West Sussex, formerly of Hereford."
                            },
                            {
                                "example_id": "b106f133-b0f5-4563-8669-846b33ac99ed",
                                "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                                "text": "In one bus was none other than Sen. Barack Obama, candidate for the Democratic presidential nomination, his wife, Michelle, and two daughters, Malia, 9, and Natasha “Sasha”, 7."
                            },
                            {
                                "example_id": "6d3131ca-db1d-4195-98de-9262a5df1fd0",
                                "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                                "text": "Natasha “Sasha” Fisher Ninete of Sinajana was named to the College of Letters and Science Dean’s List for the Spring 2019 semester at University Of Wisconsin-Milwaukee."
                            },
                            {
                                "example_id": "cb886db4-d377-4891-baf5-0575ef5fcb32",
                                "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                                "text": "I missed my father whenever he left, and years later, when I was writing guest columns for the Detroit Free Press and in my early days of parenting, I imagined how his frequent departures might have impacted my own relationship with my two children, Natasha (Sasha) and Noah."
                            },
                            {
                                "example_id": "e53a9ec8-00de-4a06-a64b-ae3201c396c2",
                                "sense_id": "9075a71b-4480-38c7-9589-9b1e1c17f49f",
                                "text": "His sister, Natasha “Sasha” Carter was a confidential informant to Cruz’s best friend, Narcotics Detective Matt Yablonski."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
