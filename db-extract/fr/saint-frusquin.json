                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                        "entry_id": "a90ec4ba-9a9b-3730-81d9-61a318544f6b",
                        "glosses": [
                            "Bien, capital, patrimoine, ensemble des affaires que quelqu’un possède."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cadba37a-09ba-4b5a-b4ac-727ee7def257",
                                "sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                                "text": "Je vais rapporter soudain\nLa poudre de perlinpinpin.\nDépense, pauvre Arlequin,\nTon dernier saint-frusquin."
                            },
                            {
                                "example_id": "e097f110-f7ad-4e85-a8f0-c7ecc38e555f",
                                "sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                                "text": "Ils avaient attrapé leur saint-frusquin dans des négoces ou des manigances aussi honorables que pacifiques."
                            },
                            {
                                "example_id": "02d5c4c4-8f35-41e2-84ce-6087da3197ac",
                                "sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                                "text": "Je ne doute pas du reste que dans certaines classes les intérêts de caste n’effacent tout sentiment de patriotisme, et que pour conserver leur saint-frusquin, ces gens-là se feraient volontiers le sacrifice des trois-quarts de la France."
                            },
                            {
                                "example_id": "58d8250a-f03d-4b92-a15b-1386f5a40d2a",
                                "sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                                "text": "La nuit, les Allemands furent rappelés d’urgence. Ils n’eurent même pas le temps de ramasser leur saint-frusquin, piquèrent la moto, filèrent sans demander leur reste & les prisonniers furent oubliés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2923881-cc61-4a17-9fb0-cacac8cd2525",
                        "source_entry_id": "a90ec4ba-9a9b-3730-81d9-61a318544f6b",
                        "source_sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                        "source_sense_description": "Patrimoine",
                        "target_lang_word": "Hab und Gut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hab und Gut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cfd7a83-9468-3559-8ffd-a054ee024fc9",
                                        "entry_id": "b12ebf69-963a-37cb-af30-c03c5cda865a",
                                        "glosses": [
                                            "alles, was jemand besitzt, jemandes gesamtes Eigentum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a488754b-f101-4772-b495-8e7c3a555415",
                                                "sense_id": "4cfd7a83-9468-3559-8ffd-a054ee024fc9",
                                                "text": "„Viele Betroffene werden nicht von der bevorstehenden Überschwemmung ihrer Häuser informiert: Sie müssen ohne Vorwarnung zusehen, wie ihr Hab und Gut in den Fluten untergeht.“"
                                            },
                                            {
                                                "example_id": "1adc395d-9150-40a3-8d44-c4cc46efea58",
                                                "sense_id": "4cfd7a83-9468-3559-8ffd-a054ee024fc9",
                                                "text": "„Den Deutschen wurde befohlen, das nötigste Hab und Gut zu packen, woraufhin sie in Güterzüge verladen und in den Westen ausgesiedelt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6c54981-03e2-403e-b6be-85c3818d2350",
                        "source_entry_id": "a90ec4ba-9a9b-3730-81d9-61a318544f6b",
                        "source_sense_id": "f0715192-9eba-394e-93f4-334268df2fea",
                        "source_sense_description": "Patrimoine",
                        "target_lang_word": "Siebensachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siebensachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "verschiedene Dinge, die man für ein bestimmtes Vorhaben benötigt oder die man gerade bei sich hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c9b0507-9cc0-4d78-ab3a-8e3495a5b75d",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "Wenn jetzt alle ihre Siebensachen zusammengesucht haben, können wir endlich los zum See."
                                            },
                                            {
                                                "example_id": "5f4cc625-babb-47d5-9bf2-bc976ca83e41",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Zu den Stoßzeiten morgens um neun bilden sich Schlangen vor den Einlaßschleusen, wenn Athleten und Journalisten mit ihren Siebensachen eintrudeln.“"
                                            },
                                            {
                                                "example_id": "589791b8-4955-49f4-9ee6-577ac105f5d5",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Danach zogen wir wieder zum Mono Lake, und als wir merkten, daß die Aufregung um den Zement für den Augenblick abgeklungen war, packten wir unsere Siebensachen und kehrten nach Esmeralda zurück.“"
                                            },
                                            {
                                                "example_id": "466beb43-431a-48f0-aab9-d7e3aabd1211",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Sie selbst aber, also die Mama, wolle in der Wohnung bleiben und unsere Siebensachen in Ruhe packen.“"
                                            },
                                            {
                                                "example_id": "c2c379e6-8908-4cb5-ba33-42028eaa4015",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Darum packten sie 1970 ihre Siebensachen und reisten von Antakya/Arsch der Welt nach Frankfurt/Main.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "das Eigentum eines Menschen, dem nur wenige Sachen gehören"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a85ec25-fd07-41aa-a739-17244054d690",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "Wenn jemand wie dein Onkel umzieht, ist das kein großer Aufwand, da seine Siebensachen schnell zusammengepackt sind."
                                            },
                                            {
                                                "example_id": "2357df8b-eee3-46dc-bb3c-8f4bbca87913",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "Du brauchst doch nicht viel Platz. Deine Siebensachen passen ja in einen Schuhkarton."
                                            },
                                            {
                                                "example_id": "036bade9-66d5-42d0-ad78-7eb0387926ce",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "„Am Morgen kamen alle ihre Siebensachen.“"
                                            },
                                            {
                                                "example_id": "f100e64f-fdb8-499d-b7d5-e913f1288693",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "„Dann mußte sie ihre Siebensachen zusammenpacken und unter mein eigenes Dach ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61ce2a2b-99f0-3bcf-8a6d-1dc97bbbb5d1",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "wertlose Dinge"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b59ba43-65af-4c87-bd9f-17025c0974d8",
                                                "sense_id": "61ce2a2b-99f0-3bcf-8a6d-1dc97bbbb5d1",
                                                "text": "In dem alten Schuppen bewahrt Opa seine Siebensachen auf, die er meistens vom Sperrmüll holt, um damit herumzubasteln."
                                            },
                                            {
                                                "example_id": "1eacfb50-9006-4acc-829b-89785f276f99",
                                                "sense_id": "61ce2a2b-99f0-3bcf-8a6d-1dc97bbbb5d1",
                                                "text": "Was machen wir jetzt mit Norberts Siebensachen, die er einfach im Garten herumliegen lässt?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "782c8837-488d-3bf3-a8d9-9a6365126054",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "Reize einer Frau"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3b0f95ea-17d9-3b46-b2d7-69da476d0d4e",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
