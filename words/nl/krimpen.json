                    "sense_id": "b712948c-caab-3860-9ba7-2baf9b41d3f7",
                    "sense_definition": "kleiner worden van textiel na een wasbeurt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleiner worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn nieuwe wollen trui is helaas <w>gekrompen</w> in de wasmachine.",
                            "target_lang_translations": {
                                "en": "My new wool sweater has unfortunately <w>shrunk</w> in the washing machine.",
                                "ru": "Мой новый шерстяной свитер, к сожалению, <w>сел</w> в стиральной машине."
                            }
                        },
                        {
                            "text": "Je moet deze broek koud wassen zodat de stof niet gaat <w>krimpen</w>.",
                            "target_lang_translations": {
                                "en": "You should wash these pants cold so the fabric doesn't <w>shrink</w>.",
                                "ru": "Эти брюки нужно стирать в холодной воде, чтобы ткань не <w>села</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de was krimpen"
                    ],
                    "target_lang_definitions": {
