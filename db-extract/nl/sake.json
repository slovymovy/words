                                        "sense_id": "cfde29d2-a857-384a-a4ea-b5b812b2c3c4",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
                                            "cause, interest or account"
                                        ],
