                        "glosses": [
                            "De façon adultère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52bf2f31-672e-4b7c-aadd-89c6840cc841",
                                "sense_id": "3fe49d30-b5eb-3fb3-8145-9ef393e512be",
                                "text": "— Et j'ai séduit adultèrement une fille de cette cité !"
                            },
                            {
                                "example_id": "55090998-b9dc-4471-a67f-5622f7ce99d2",
                                "sense_id": "3fe49d30-b5eb-3fb3-8145-9ef393e512be",
                                "text": "Quoique abbé, Hullon, qui possédait une maison de grande valeur à Paris, vivait adultèrement avec une femme que, par précaution, il avait marié à un sien valet."
                            },
                            {
                                "example_id": "efcc0f39-5c47-4759-a2ae-5593340bf326",
                                "sense_id": "3fe49d30-b5eb-3fb3-8145-9ef393e512be",
                                "text": "Quand la jolie marquise qui avait adultèrement fauté sur les confins de l’an 1716, vit, quelque trente années plus tard, que le produit de ses galantes galipètës arrivait à la gloire, elle se présenta au logis du jeune précurseur de la Révolution et, aussi émue que Mme Duc-Quercy après un excellent déjeuner pris sur la masse des grèves, entr’ouvrit ses bras au philosophe en geignant: - Je suis ta mère !"
                            }
                        ]
                    }
