                ],
                "senses": [
                    {
                        "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                        "entry_id": "1fb67fef-7327-3b6e-a5d1-057e8015ed02",
                        "glosses": [
                            "Amt oder Amtsbereich eines Sufeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9231d53c-e2a2-4699-ab43-5b36bf8a017e",
                                "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                                "text": "„Wiewohl das Volk zentrale Souveränitätsrechte ausübte, blieben die wichtigsten staatlichen Ämter und Institutionen (Sufetat, Rat, Gerichte) in der Hand einer durch Reichtum und politische Erfahrung ausgewiesenen Führungsschicht.“"
                            },
                            {
                                "example_id": "2207d666-69e3-4309-b00b-b173b805574b",
                                "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                                "text": "„Von dieser Neuverteilung der Macht war wohl auch das Sufetat betroffen, dessen spätere Bedeutung im Staat in dieser Zeit angelegt sein muß.“"
                            },
                            {
                                "example_id": "6206d6ef-fac1-43cf-a8d3-0bb1444c6771",
                                "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                                "text": "„Von Bedeutung für die Entstehung des karthagischen Sufetats mag allerdings die Tatsache gewesen sein, daß in Tyros in den 60er Jahren des 6. Jh. das Königtum durch den Suffetat — allerdings durch einen, wie ich meine, durchgängig einstelligen Sufetat — abgelöst worden ist.“"
                            },
                            {
                                "example_id": "f50ab4d4-89c5-4698-94a3-161c6067b2db",
                                "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                                "text": "„Wohl erscheint das Sufetat als stark familiär gebunden; die ‚tatsächliche Erblichkeit‘ Belochs kommt jedoch nicht in Frage.“"
                            },
                            {
                                "example_id": "bbc8f17b-c775-42ce-a42b-51ecd6fbfff3",
                                "sense_id": "5f178305-c645-343f-8662-d9d91afcd3fb",
                                "text": "„Dass der Sufetat, zumindest in der historisch fassbaren Zeit, das Kennzeichen der Annuität besaß, liegt aufgrund von Notizen von Nepos und Zonaras nahe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
