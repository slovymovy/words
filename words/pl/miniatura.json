                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manuscript_miniature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Średniowieczne <w>miniatury</w> zachwycają bogactwem barw i złoceń.",
                            "target_lang_translations": {
                                "ru": "Средневековые <w>миниатюры</w> восхищают богатством красок и позолоты."
                            }
