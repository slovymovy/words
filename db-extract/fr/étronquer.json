                ],
                "senses": [
                    {
                        "sense_id": "978c6eeb-6311-39e0-a7ec-46ceca2b56df",
                        "entry_id": "88843482-7215-3b69-a64c-94abbcf52ada",
                        "glosses": [
                            "Tronquer en faisant devenir plus petit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a86701b-b94e-4208-9465-b36ddf78ed46",
                                "sense_id": "978c6eeb-6311-39e0-a7ec-46ceca2b56df",
                                "text": "Et vous, disparaissez, Forêts que sans relâche Vient étronquer la serpe et décimer la hache;"
                            },
                            {
                                "example_id": "264c6b05-707f-4ac8-92e9-4d193076a647",
                                "sense_id": "978c6eeb-6311-39e0-a7ec-46ceca2b56df",
                                "text": "Un jeune arbriseau, un vieil arbre étronqué m’apparaît comme une sentinelle indienne qui examine de loin la route, dans l’attente de quelques victimes. (sic)"
                            },
                            {
                                "example_id": "546a7fc1-d0ae-4b9f-b298-17c1b363191d",
                                "sense_id": "978c6eeb-6311-39e0-a7ec-46ceca2b56df",
                                "text": "On voit de temps en temps quelques gros chênes centenaires, à la cime étronquée et morte, et, sur cette cime, un ou deux vautours qui nous regardent dans toute leur sinistre majesté."
                            }
                        ]
                    }
                ],
