{
    "word_family": [
        "paperbacked",
        "paperbacking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12cb8093-47e9-3fe2-856a-e337d550d3ab",
                    "sense_definition": "A book with a flexible paper cover rather than a stiff cardboard one.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "books",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to buy a <w>paperback</w> because it is lighter to carry in my bag.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю покупать <w>книги в мягкой обложке</w>, потому что их легче носить в сумке."
                            }
                        },
                        {
                            "text": "The shop sells the latest <w>paperback</w> edition of the novel for ten dollars.",
                            "target_lang_translations": {
                                "ru": "Магазин продает последнее издание романа <w>в мягкой обложке</w> за десять долларов."
                            }
                        }
                    ],
                    "synonyms": [
                        "pocketbook"
                    ],
                    "antonyms": [
                        "hardback",
                        "hardcover"
                    ],
                    "common_phrases": [
                        "paperback edition",
                        "original paperback",
                        "bestselling paperback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга с гибкой бумажной обложкой, а не с жестким картонным переплетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "книга в мягкой обложке",
                                "target_lang_sense_clarification": "издание в бумажном переплете"
                            },
                            {
                                "target_lang_word": "покетбук",
                                "target_lang_sense_clarification": "карманное издание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "734ecf92-f5b0-3925-80a1-64cd233f86ce",
                    "sense_definition": "Describing a book that has a flexible paper binding.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "books",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>paperback</w> version of the textbook is much cheaper than the hardcover one.",
                            "target_lang_translations": {
                                "ru": "<w>Мягкая</w> версия учебника намного дешевле, чем версия в твердом переплете."
                            }
                        },
                        {
                            "text": "She has a large collection of <w>paperback</w> novels on her bookshelf.",
                            "target_lang_translations": {
                                "ru": "У нее на книжной полке большая коллекция романов <w>в мягком переплете</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "paperbacked",
                        "paperbound",
                        "softcovered"
                    ],
                    "antonyms": [
                        "hardback",
                        "hardcover"
                    ],
                    "common_phrases": [
                        "paperback book",
                        "paperback copy",
                        "paperback version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает книгу, имеющую гибкий бумажный переплет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в мягкой обложке",
                                "target_lang_sense_clarification": "о типе переплета"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о переплете книги"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "782506de-c055-35b4-8346-c3ab8b78e359",
                    "sense_definition": "To publish or release a book in a flexible paper binding format.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <w>paperback</w> the biography only six months after the initial release.",
                            "target_lang_translations": {
                                "ru": "Издатель решил <w>выпустить в мягкой обложке</w> биографию всего через шесть месяцев после первоначального релиза."
                            }
                        },
                        {
                            "text": "They were <w>paperbacking</w> the series in house to keep more of the royalties.",
                            "target_lang_translations": {
                                "ru": "Они сами <w>издавали серию в мягком переплете</w>, чтобы сохранить больше авторских отчислений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paperback a book"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used primarily in the publishing industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать или выпускать книгу в формате гибкого бумажного переплета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать в мягкой обложке",
                                "target_lang_sense_clarification": "о процессе публикации"
                            },
                            {
                                "target_lang_word": "издавать в бумажном переплете",
                                "target_lang_sense_clarification": "профессиональный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}