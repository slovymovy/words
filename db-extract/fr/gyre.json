            {
                "entry_id": "9c236dc5-7918-36f7-ac37-6b589e1ace87",
                "word": "gyre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba9f82f0-8008-4977-b1ad-0938bbd72752",
                        "entry_id": "9c236dc5-7918-36f7-ac37-6b589e1ace87",
                        "tags": [
                            "plural"
                        ],
                        "form": "gyres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7db42af0-2ed0-30f3-936f-0fbb13ab4365",
                        "entry_id": "9c236dc5-7918-36f7-ac37-6b589e1ace87",
                        "glosses": [
                            "Immense tourbillon que les courants marins forment dans les océans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05518158-57a7-43f2-8beb-e58e5631c906",
                                "sense_id": "7db42af0-2ed0-30f3-936f-0fbb13ab4365",
                                "text": "Le gyre subtropical du Pacifique nord est situé entre l’équateur et la latitude 50° N et occupe une surface approximative de 34 millions de km²."
                            },
                            {
                                "example_id": "68bf3aa3-afcc-4895-8085-b36d8e39f151",
                                "sense_id": "7db42af0-2ed0-30f3-936f-0fbb13ab4365",
                                "text": "La plupart des déchets de plastique jetés à la mer finissent, un jour ou l'autre, par être happés par l'un des cinq tourbillons marins (les gyres) de l'Atlantique et du Pacifique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8cd7da-08c1-427b-bd87-16b61aeffae4",
                        "source_entry_id": "9c236dc5-7918-36f7-ac37-6b589e1ace87",
                        "source_sense_id": "7db42af0-2ed0-30f3-936f-0fbb13ab4365",
                        "target_lang_word": "gyre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "718d3788-e125-3b46-b27c-b1a1e1361931",
                                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                                        "glosses": [
                                            "A swirling vortex."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                                        "glosses": [
                                            "A circular or spiral motion; also, a circle described by a moving body; a revolution, a turn."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67a51b6-ed49-4103-86cd-97247ae1fafd",
                                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                                "text": "Quick, and more quick he ſpins in giddy Gires, / Then falls, and in much Foam his Soul expires."
                                            },
                                            {
                                                "example_id": "03b2c751-9f0f-4cc5-a793-1191c937ac8c",
                                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                                "text": "What is art, / But life upon the larger scale, the higher, / When, graduating up in a spiral line / Of still expanding and ascending gyres, / It pushes toward the intense significance / Of all things, hungry for the Infinite? / Art's life,—and where we live, we suffer and toil."
                                            },
                                            {
                                                "example_id": "ef52bfb3-b668-4bb3-a729-691ac0968dcf",
                                                "sense_id": "33a92c0d-f211-39a7-a7d9-a080390898dd",
                                                "text": "Turning and turning in the widening gyre / The falcon cannot hear the falconer; / Things fall apart; the centre cannot hold; / Mere anarchy is loosed upon the world, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c754d7-24ce-34d9-ad4a-588a61d991a4",
                                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                                        "glosses": [
                                            "Synonym of gyrus (“a fold or ridge on the cerebral cortex of the brain”)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1082d88c-74ea-304d-b91a-0ac00026d407",
                                        "entry_id": "b4f75b19-f130-3f7f-92c2-a5e5bafab267",
                                        "glosses": [
                                            "An ocean current caused by wind which moves in a circular manner, especially one that is large-scale and observed in a major ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1c8866-f703-425e-a0e3-e2f914c8ddcc",
                                                "sense_id": "1082d88c-74ea-304d-b91a-0ac00026d407",
                                                "text": "Most ships that tried to cross the Pacific in the past would get stuck in the gyres and never make it out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gyre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eae14c33-4763-3a0b-8eec-91df7945a15a",
                                        "entry_id": "2a39f8e2-66c9-3a7a-a17d-18fae2b77446",
                                        "glosses": [
                                            "To spin around; to gyrate, to whirl."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f6776b-7509-44fa-a793-d8652036522d",
                                                "sense_id": "eae14c33-4763-3a0b-8eec-91df7945a15a",
                                                "text": "The host of heauenly beautyes moue, / Depainted in their proper stories, / As well the fixd as wandring glories, / Which from their proper orbes not goe, / Whether they gyre swift or slowe: […]"
                                            },
                                            {
                                                "example_id": "dcd2bf14-4491-4750-bd1e-38fd74643c9a",
                                                "sense_id": "eae14c33-4763-3a0b-8eec-91df7945a15a",
                                                "text": "Jabberwocky. / 'Twas brillig, and the slithy toves / Did gyre and gimble in the wa[b]e; / All mimsy were the borogoves, / And the mome raths outgrabe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370314b8-fc1b-388a-9bdd-db583cce40ae",
                                        "entry_id": "2a39f8e2-66c9-3a7a-a17d-18fae2b77446",
                                        "glosses": [
                                            "To make (something) spin or whirl around; to spin, to whirl."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
