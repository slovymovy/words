                        "glosses": [
                            "positive Einstellung/Wertschätzung der Möglichkeit, ohne Zwang von außen denken und handeln zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "176d48bf-d54a-4657-bce3-dc158ba20684",
                                "sense_id": "77d7e12f-30f1-3673-aa9c-e73f995c75bb",
                                "text": "„Die Freiheitsliebe beschränkt sich in Deutschland häufig auf die Klage über zu viel Bürokratie, doch sobald etwas im Fleisch oder Frühstücksei auftaucht, was dort nichthingehört, ergeht der Ruf nach strikteren Kontrollen und Vorschriften.“"
                            },
                            {
                                "example_id": "b9a08f25-74f0-4ceb-90ee-42306c947ae1",
                                "sense_id": "77d7e12f-30f1-3673-aa9c-e73f995c75bb",
                                "text": "„Von dem weiten Gebiete seiner Ahnen war nur wenig auf ihn gekommen, von ihrer Freiheitsliebe, ihrem Stolze alles.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
