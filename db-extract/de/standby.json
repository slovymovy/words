                                        "entry_id": "239619af-0e7f-37da-a32d-cb6206c75fd2",
                                        "glosses": [
                                            "A state of readiness without immediate involvement; remaining in preparation for (a sudden or unforeseen event or situation)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b05a5bd4-5383-41d7-97fd-d788e4341510",
                                                "sense_id": "f116ab19-db90-3d7c-81e7-558cbeeb4c53",
                                                "text": "The troops were on standby in case of an attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d72234-4200-3c53-bc5c-0372d5824727",
                                        "entry_id": "239619af-0e7f-37da-a32d-cb6206c75fd2",
                                        "glosses": [
                                            "A replacement kept on standby."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16302279-39a4-452c-b2f6-95400c501bb6",
                                                "sense_id": "41d72234-4200-3c53-bc5c-0372d5824727",
                                                "text": "During three weeks of the run, I was performing with walking pneumonia, but I had no choice other than to perform because we didn't have the budget for stand-bys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f2f061-0f9f-392f-a8a8-d007430990ff",
                                        "entry_id": "239619af-0e7f-37da-a32d-cb6206c75fd2",
                                        "glosses": [
                                            "Sleep mode."
                                        ],
