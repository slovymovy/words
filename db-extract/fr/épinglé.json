                        "examples": [
                            {
                                "example_id": "acdaa50b-bd65-4ba6-a25b-c533554f0c0f",
                                "sense_id": "b7f5fdba-5389-3d46-8db3-d3b12c5324e5",
                                "text": "Quand le Brésil a été épinglé dans un rapport du Sitex pour l’exploitation illégale de l’ipé, on a fait le choix d’arrêter, insiste Pierre Denavit."
                            },
                            {
                                "example_id": "42f7059a-b497-4a22-bbec-996163d6b808",
                                "sense_id": "b7f5fdba-5389-3d46-8db3-d3b12c5324e5",
                                "text": "Rien ne transpira de son visage impassible, si ce n’était ce très léger rictus, un brin railleur, qu’elle avait épinglé au coin des lèvres l’espace d’une seconde…"
                            }
                        ]
