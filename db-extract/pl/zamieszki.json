                        "sense_id": "056325a5-05da-33d0-825f-0b272181a1a7",
                        "entry_id": "9d489bc6-f65a-32cb-b156-f663076a3fab",
                        "glosses": [
                            "demonstracje, uliczne manifestacje i starcia wyrażające bunt przeciwko władzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6732b02c-f20b-4ecf-9906-73acb0eb3aea",
                                "sense_id": "056325a5-05da-33d0-825f-0b272181a1a7",
                                "text": "Wypadek samochodowy, jakich wiele na polskich ulicach, wywołuje antycygańskie zamieszki w Mławie. Dlaczego? Bo sprawcą nie był Polak, tylko… Rom"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
