                {
                    "sense_id": "af37fc2c-8f65-36d2-a7b8-5f6f5eaf682b",
                    "sense_definition": "A difficult or pressured situation, especially regarding time or financial resources.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pressure_abstract",
                    "name_type": "no",
