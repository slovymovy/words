        "fr-extract.jsonl": [
            {
                "entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                "word": "crèmerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea0d7902-5919-4e2b-a67e-a882f261240e",
                        "entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "tags": [
                            "plural"
                        ],
                        "form": "crèmeries"
                    },
                    {
                        "form_id": "92ca1c7b-536f-4333-bc32-e1d093f77025",
                        "entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "tags": [],
                        "form": "crémerie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "827d8402-fc4b-36ed-9d90-98dc59066d1c",
                        "entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "glosses": [
                            "Établissement où l’on vend de la crème, du laitage, des œufs, du fromage, et où l’on servait aussi des repas à bon marché."
                        ],
                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "86f0f4a4-482c-457d-a1f2-91a3259af89b",
                                "sense_id": "827d8402-fc4b-36ed-9d90-98dc59066d1c",
                                "text": "Il déjeune à la crèmerie."
                            },
                            {
                                "example_id": "e402eab5-fa6d-4eb2-9a00-2e2da210343f",
                                "sense_id": "827d8402-fc4b-36ed-9d90-98dc59066d1c",
                                "text": "Il y avait là, juste en face, une boutique de modeste apparence qui pouvait bien être celle d'une crèmerie. La porte vitrée était ouverte et une femme en tablier blanc se tenait sur le seuil, attendant la pratique."
                            },
                            {
                                "example_id": "1fcf1efd-1aa9-4bc4-a64b-a283422581fb",
                                "sense_id": "827d8402-fc4b-36ed-9d90-98dc59066d1c",
                                "text": "J’étais dans la révolution jusqu’au cou, et j’aimais Paris maintenant. Cette imprimerie !… Puis nous avions été manger des ordinaires dans des crèmeries, où il venait des ouvriers qui avaient appartenu aux Saisons et qui avaient été mêlés à des émeutes.\nLa blouse et la redingote s’asseyaient à la même table et l’on trinquait."
                            }
                        ]
                    },
                    {
                        "sense_id": "17d4708b-2dfd-3fa2-9baf-895ce9676212",
                        "entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "glosses": [
                            "Petit commerce ou comptoir où l’on vend essentiellement des produits glacés (crème glacée, yogourt glacé, lait glacé…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02bec7ba-a56f-469c-b273-41bc7fb3bb62",
                                "sense_id": "17d4708b-2dfd-3fa2-9baf-895ce9676212",
                                "text": "[…] la nouvelle crémerie […] propose le meilleur des deux mondes : des desserts glacés faibles en calories misant sur l’utilisation de fruits et de lait au lieu de la crème. Mangue et framboises, choco-banane ou le décadent skormallow, un gelato à la guimauve et aux morceaux de caramel et chocolat, sont quelques exemples des meilleurs vendeurs. Il y a quelques tables à l’intérieur et des contenants à emporter sont également offerts pour se régaler à la maison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f07ed73b-fa13-4637-8c43-3367f2e32c43",
                        "source_entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "source_sense_id": "827d8402-fc4b-36ed-9d90-98dc59066d1c",
                        "source_sense_description": "Établissement où l’on vend de la crème, du laitage, des œufs, du fromage.",
                        "target_lang_word": "Molkerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molkerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                        "entry_id": "7464f4f7-1907-35fb-afd0-489072fb8a1b",
                                        "glosses": [
                                            "Betrieb zur Verarbeitung von Milch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d1b4b5-d505-482f-950f-7fcbf9377818",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„In den Räumen der ehemaligen Molkerei in der Osterweder Straße haben sich eine Reihe verschiedener Kunsthandwerksbetriebe, Ateliers und Galerien angesiedelt.“"
                                            },
                                            {
                                                "example_id": "87704605-49be-4108-a03c-7a99616b2470",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "40b86b0b-3957-4d62-939b-7768ee2d4159",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Überall gibt es noch Kühe, jedoch keine Lieferungen mehr an die Molkerei von Glowitz.“"
                                            },
                                            {
                                                "example_id": "07536cb5-62a1-40fb-a750-f13e67389521",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Sie arbeiten im Familienbetrieb, der Molkerei, aber die Eltern wollen sie glüklich verheiratet sehen, und Tewje erählt, wie es ihnen dabei ergeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f215704-4ae1-4496-8828-11b4b2ce9f96",
                        "source_entry_id": "577f8f54-5ca4-392c-a41f-89524719ae56",
                        "source_sense_id": "17d4708b-2dfd-3fa2-9baf-895ce9676212",
                        "source_sense_description": "Petit commerce ou comptoir où l’on vend essentiellement des produits glacés (crème glacée...).",
                        "target_lang_word": "Eisdiele",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisdiele",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                        "entry_id": "1ff1ce90-3d8b-34c2-8265-1eccc5765df3",
                                        "glosses": [
                                            "Gaststätte, deren wichtigstes Angebot Speiseeis ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29875949-6a57-49ee-bc4c-14e2049f102b",
                                                "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                                "text": "In unserer kleinen Stadt gibt es mehrere Eisdielen."
                                            },
                                            {
                                                "example_id": "d30ba3c9-1985-46c6-b828-657bc8714ea2",
                                                "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                                "text": "„Nach der Schule lud uns Monika in die Eisdiele ein, und ich spürte endlich so etwas wie Ferienstimmung.“"
                                            },
                                            {
                                                "example_id": "d274e805-5949-437f-bf1e-f7be74f25668",
                                                "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                                "text": "„Mit diesem Großvater ging man nicht in den Zoo oder in Eisdielen,wie es die Kinder in Deutschland taten.“"
                                            },
                                            {
                                                "example_id": "b75aebe8-9075-477f-b631-59e1956b28cc",
                                                "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                                "text": "„Wir spazieren durch die Innenstadt, sehen noch einige Denkmäler zu Ehren Gutenbergs und stellen uns an einer Eisdiele an.“"
                                            },
                                            {
                                                "example_id": "9fc09b16-d82b-4b08-b464-f3fce2c15c36",
                                                "sense_id": "c4841458-7e57-3f01-8f1d-16fe0d1a170d",
                                                "text": "„Das Foyer sah aus wie eine italienische Eisdiele aus den Sechzigerjahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
