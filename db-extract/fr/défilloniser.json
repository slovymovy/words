                ],
                "senses": [
                    {
                        "sense_id": "f0eaaa76-44ad-3809-88d5-c567ed20f700",
                        "entry_id": "efb3ac5a-23b4-3430-a576-b23d43b141d2",
                        "glosses": [
                            "Débarrasser de l’influence de François Fillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe233954-a5de-42b6-bc5b-fe1190b1e737",
                                "sense_id": "f0eaaa76-44ad-3809-88d5-c567ed20f700",
                                "text": "On ne va pas se cacher derrière notre petit doigt, nous venons pour la plupart de la droite, mais une droite dépoussiérée, désembourgeoisée, défillonisée."
                            },
                            {
                                "example_id": "9cae671c-acd2-4565-89ff-4d7c8c508c4c",
                                "sense_id": "f0eaaa76-44ad-3809-88d5-c567ed20f700",
                                "text": "Même s’il ne parvient pas à empêcher Hollande, il aura au moins obtenu de se « défilloniser », selon l’expression de Jean-Christophe Cambadélis."
                            },
                            {
                                "example_id": "d345bd4d-aa66-4b0a-987c-7ba685cfd64f",
                                "sense_id": "f0eaaa76-44ad-3809-88d5-c567ed20f700",
                                "text": "Guerre des chefs à l’UMP: Bertrand confie en privé qu’il s’est \"défillonisé\"."
                            }
                        ]
                    }
                ],
