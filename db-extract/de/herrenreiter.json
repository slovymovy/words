                "senses": [
                    {
                        "sense_id": "5602a3d7-cd68-3d6f-9694-89187afafe54",
                        "entry_id": "b0e74f02-1947-374b-9cc8-6c639ce96d8f",
                        "glosses": [
                            "Person, die sich dem Pferderennen (als Hobby, ursprünglich als „Amüsements“ höherer Herrschaften) widmet"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "abe9f48b-b715-4679-9a22-53f785adf493",
                                "sense_id": "5602a3d7-cd68-3d6f-9694-89187afafe54",
                                "text": "„Er war ein sehr tüchtiger Offizier, Sportsmann, Herrenreiter, Kunstschütze.“"
                            },
                            {
                                "example_id": "99fd13f7-c3b2-4951-9f4a-c0fa153d1b09",
                                "sense_id": "5602a3d7-cd68-3d6f-9694-89187afafe54",
                                "text": "„Franz von Papen, ein Herrenreiter aus altem westfälischem Adel, hatte mit dem neuen Kanzler Schleicher noch eine Rechnung offen.“"
                            },
                            {
                                "example_id": "f2da8b5b-07e1-4ef3-ae57-afb6bd2337b5",
                                "sense_id": "5602a3d7-cd68-3d6f-9694-89187afafe54",
                                "text": "„Als C. sich ihr nähert, legt er die rechte Hand auf die linke Brustseite und verbeugt sich mit der eleganten Geste eines Herrenreiters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
