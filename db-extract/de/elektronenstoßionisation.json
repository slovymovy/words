                "senses": [
                    {
                        "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                        "entry_id": "263053c5-b2ed-3bae-ace3-0e6f7e5c5608",
                        "glosses": [
                            "die Entfernung eines oder mehrerer Elektronen aus einem Atom oder Molekül durch Energiezufuhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4292f1f7-a995-4fc1-911b-13206eb131ef",
                                "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                                "text": "„Die Elektronenstoßionisation ist für flüchtige organische und anorganische Substanzen die wichtigste Ionisationsmethodik.“"
                            },
                            {
                                "example_id": "7344b2fa-52d7-4cf3-93a8-3e5d2e7bb2ec",
                                "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                                "text": "„Die Elektronenstoßionisation (electron ionization, EI) ist die universellste Ionisationsmethode der organischen Massenspektrometrie.“"
                            },
                            {
                                "example_id": "4efd4eba-90e8-41b4-8030-1a65908d56c4",
                                "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                                "text": "„Der Prozeß der Elektronenstoßionisation eines Atoms, der einer der wichtigsten Stoßprozesse der Atomphysik ist, stellt schon im nichtrelativistischen Bereich für die theoretische Behandlung eine große Herausforderung dar, da es sich ja auch im einfachsten Fall des Wasserstoffatoms um ein Dreikörperproblem mit unendlich weit reichenden Coulombkräften handelt (zwei auslaufende Elektronen und das Ion).“"
                            },
                            {
                                "example_id": "15766483-c9f5-4443-9a87-37f931a90dea",
                                "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                                "text": "„Als Vorteile der Elektronenstoßionisation sind zu nennen […]“"
                            },
                            {
                                "example_id": "076ed8be-4a52-4560-ae65-b4dfc39bde96",
                                "sense_id": "721f50fd-2390-3243-baa9-f5fb5bb0bb43",
                                "text": "„In diesem Raum werden die natürlichen freien Ladungsträger im Gas zu ihrer jeweiligen Gegenelektrode hin beschleunigt. Erhöht man die Spannung, finden Elektronenstoßionisationen im Volumen (α-Prozesse) statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
