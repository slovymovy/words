                "senses": [
                    {
                        "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                        "entry_id": "b3c9f6d5-e165-3503-b776-cb6b83fa77d8",
                        "glosses": [
                            "To put forward; to offer for discussion or debate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "31ea60ac-f8ec-4124-8a42-dccafc2b10e9",
                                "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                                "text": "Today I'll expound at length the theory that I propounded last year."
                            },
                            {
                                "example_id": "c81bc7b4-43ae-4509-8da5-6a3d051ed618",
                                "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                                "text": "“Divine receptacle of excellence, let it not be deemed impertinent, or deviating from the rules of propriety, if I propound one queſtion which now labours in my breaſt; aſſuring me firſt, you will not let the ſceptre of true judgment depart from your right hand.”"
                            },
                            {
                                "example_id": "66ffac26-b99c-40a3-8dbf-f4a5e09449f7",
                                "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                                "text": "A Mormon tribunal will try a woman whose national campaign in support of the Equal Rights Amendment is said to be undermining the church. Mormon officials declared that the woman, Sonia Johnson, is propounding \"false doctrine.\""
                            },
                            {
                                "example_id": "f054b6ad-d5fe-4573-ac4e-ce996314ad9d",
                                "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                                "text": "Each school propounds its own theory without having given any thought to whether we are following what they say or getting left behind."
                            },
                            {
                                "example_id": "dc1c36f1-39c6-472f-9be0-63b55f82679b",
                                "sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                                "text": "Summarizing the history of the immigration debates in the U.S., Kaufmann sees in Bourne and his followers many of the same arguments advanced today by proponents of liberal immigration laws, who, he says, encourage racial minorities to celebrate their culture while propounding anti-racist norms that discourage whites from doing the same."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1e0c98f-e2c7-4040-8be2-9622c01f1b05",
                        "source_entry_id": "b3c9f6d5-e165-3503-b776-cb6b83fa77d8",
                        "source_sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                        "source_sense_description": "to put forward; to offer for discussion or debate",
                        "target_lang_word": "proposer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proposer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Mettre en avant, de vive voix ou par écrit, pour qu’on l’examine, pour qu’on en délibère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be457d9b-116a-442e-b01d-3f5ccace2ddb",
                                                "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                                "text": "C'est en 1875 que Copeman a proposé la dilatation du col par l’introduction du doigt contre l’hyperemesis gravidarum ; l'auteur publie deux faits favorables à la méthode."
                                            },
                                            {
                                                "example_id": "dd7d411a-23fa-4bcc-ba80-f7e3c1c39e4b",
                                                "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                                "text": "Roger, le patron, apportait naturellement un soin maniaque à sélectionner les produits qu'il proposait à sa clientèle, qu'il s'agisse de charcutaille, de fromage ou de pichtegorne."
                                            },
                                            {
                                                "example_id": "59f835cf-40fe-41d1-98d3-e8b0c1e43271",
                                                "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                                "text": "Proposer son sentiment, son avis, son opinion. — Proposer un plan."
                                            },
                                            {
                                                "example_id": "7f634ad5-1133-4f83-89f3-c0fced859808",
                                                "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                                "text": "Il se propose à lui-même des difficultés pour avoir le plaisir de les résoudre."
                                            },
                                            {
                                                "example_id": "473d3d9b-d3bd-4b7d-ae7d-d6069a23415a",
                                                "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                                                "text": "On lui a proposé un parti pour sa fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6866fa8b-6c4a-3d8a-b318-69b2de4e9f36",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Mettre au concours, donner une matière à traiter, en parlant d'un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4871b3-df22-4302-80be-09e790f014db",
                                                "sense_id": "6866fa8b-6c4a-3d8a-b318-69b2de4e9f36",
                                                "text": "L’Académie a proposé ce sujet pour le prix d’éloquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Offrir, en parlant des personnes et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21723714-f672-43b5-88ae-edcf979eb212",
                                                "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                                "text": "Sans doute étonné par l'absence de nouvelles de Ned, George Brough, le constructeur de motocyclettes, lui a proposé, il y a quelques semaines, la dernière-née de ses ateliers : une nouvelle version du modèle Brough SS 100."
                                            },
                                            {
                                                "example_id": "7b56b399-d929-4523-985d-83269a0af405",
                                                "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                                "text": "Puis je lui proposai, à l’occasion, de livrer ses chapeaux les jours de pluie pour qu'elle ne crottât pas ses bottines. De politesse en politesse, je gagnais du terrain."
                                            },
                                            {
                                                "example_id": "5f18df2f-6278-42dc-8a0d-4b7e6314cbcc",
                                                "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                                "text": "On lui a proposé cent mille francs de sa maison."
                                            },
                                            {
                                                "example_id": "116a5e48-48fb-4380-bfd3-7514e9b32f3d",
                                                "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                                "text": "Il lui a proposé sa fille en mariage."
                                            },
                                            {
                                                "example_id": "e50515c1-738b-4a0f-a1fe-378228ff877a",
                                                "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                                                "text": "Il m’a proposé de faire ce voyage avec lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b72f5df-2b52-303b-85bd-800bb4015102",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Offrir, promettre, en parlant d'un prix, d'une récompense."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4210364-5e15-44fe-8fb9-b895a7e1514d",
                                                "sense_id": "3b72f5df-2b52-303b-85bd-800bb4015102",
                                                "text": "On a proposé un prix pour celui qui résoudrait tel problème."
                                            },
                                            {
                                                "example_id": "a2b62843-73ed-4fa4-b8b5-e13f003c021d",
                                                "sense_id": "3b72f5df-2b52-303b-85bd-800bb4015102",
                                                "text": "On proposa telle récompense celui qui tenterait cet essai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63c4d4bb-0e89-300a-a362-ef38eee10973",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Indiquer en motivant l'indication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "766cf485-1f1b-4b58-8653-6fa73c0f5529",
                                                "sense_id": "63c4d4bb-0e89-300a-a362-ef38eee10973",
                                                "text": "Proposer une personne pour un emploi, pour une dignité."
                                            },
                                            {
                                                "example_id": "2df12733-ee4e-4644-ae83-faefb0771d75",
                                                "sense_id": "63c4d4bb-0e89-300a-a362-ef38eee10973",
                                                "text": "On proposa plusieurs personnes pour cette charge, cet emploi, cette place."
                                            },
                                            {
                                                "example_id": "64a3a924-e1b0-4ee9-b196-4601930bf95e",
                                                "sense_id": "63c4d4bb-0e89-300a-a362-ef38eee10973",
                                                "text": "On vient de le proposer pour une sous-préfecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ef4a71-3b8c-32d7-9c0e-3174b09bd70b",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Mettre en avant comme règle, comme modèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4d9a2a-d860-4f4d-8da5-7df76f170e3c",
                                                "sense_id": "08ef4a71-3b8c-32d7-9c0e-3174b09bd70b",
                                                "text": "Proposer quelqu’un pour modèle."
                                            },
                                            {
                                                "example_id": "59df01ca-50d9-4291-b835-2bf90f1df633",
                                                "sense_id": "08ef4a71-3b8c-32d7-9c0e-3174b09bd70b",
                                                "text": "On peut proposer ce prince pour exemple à tous les rois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a10720-0349-3c21-adcb-9c36d65560c1",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Se mettre en avant se présenter pour."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8e6ff85-76f0-4577-af08-0f4b83279073",
                                                "sense_id": "e8a10720-0349-3c21-adcb-9c36d65560c1",
                                                "text": "Plusieurs candidats se sont proposés pour cet emploi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2928b6b-d498-3441-9144-6d3cf599dd7a",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "Avoir dessein, former le dessein de faire quelque chose."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82586554-c4eb-4b34-8d1f-867695de2b32",
                                                "sense_id": "b2928b6b-d498-3441-9144-6d3cf599dd7a",
                                                "text": "L’énorme hydravion Do X avec lequel les Allemands se proposent de transporter un nombre important de passagers et du fret d’Allemagne aux États-Unis, apparaîtra comme trop grand pour son utilisation dans un but pratique."
                                            },
                                            {
                                                "example_id": "661693b2-0bfd-4e92-bc30-459ee1dff913",
                                                "sense_id": "b2928b6b-d498-3441-9144-6d3cf599dd7a",
                                                "text": "Il se propose de partir dans peu de jours. — Il se propose de vivre désormais dans la retraite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57efc27-4e02-32ab-942b-74eddbe02e02",
                                        "entry_id": "2ec391e7-38fc-388a-87f1-565b87b869b8",
                                        "glosses": [
                                            "S’assigner à soi-même."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb0e8f8-c744-425b-933a-052075e09aa3",
                                                "sense_id": "f57efc27-4e02-32ab-942b-74eddbe02e02",
                                                "text": "Il se fit admettre à bord d’un brick qui partait de Boston sans son fret habituel de bois, et dont le capitaine se proposait de « rentrer chez lui », à South Shields."
                                            },
                                            {
                                                "example_id": "ca5bc258-6666-47e1-adfa-2fe745fee450",
                                                "sense_id": "f57efc27-4e02-32ab-942b-74eddbe02e02",
                                                "text": "Pour élucider cette idée, je me propose d’embrasser l’Univers dans un seul coup d’œil, de telle sorte que l’esprit puisse en recevoir et en percevoir une impression condensée, comme d’un simple individu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4ea47ab-5360-413b-ac88-e1d4ee97106a",
                        "source_entry_id": "b3c9f6d5-e165-3503-b776-cb6b83fa77d8",
                        "source_sense_id": "95f86df5-7027-3591-a656-5f08f53d58f7",
                        "source_sense_description": "to put forward; to offer for discussion or debate",
                        "target_lang_word": "vorlegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorlegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52454043-fad6-31f4-8245-d4eba3c0ce98",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "etwas herausholen und öffentlich präsentieren"
                                        ],
                                        "tags": [
                                            "räumlich",
                                            "eher selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd03add-f962-440f-8b5d-caccc7ff766a",
                                                "sense_id": "52454043-fad6-31f4-8245-d4eba3c0ce98",
                                                "text": "Wir müssen einen Putzlappen vorlegen, damit man sich die Füße abtreten kann."
                                            },
                                            {
                                                "example_id": "fc6568dd-8dcb-423f-9833-e70e7b0322fb",
                                                "sense_id": "52454043-fad6-31f4-8245-d4eba3c0ce98",
                                                "text": "Magst du die Uhr vorlegen, damit ich sie nachher mit zum Uhrmacher nehmen kann?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e98c69ff-4360-36a7-8308-3ce1999dba8a",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "Geld leihweise zur Verfügung stellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17dd8b5a-1ebc-4828-be86-afa266df4177",
                                                "sense_id": "e98c69ff-4360-36a7-8308-3ce1999dba8a",
                                                "text": "Kannst du mir ein paar Euro vorlegen?"
                                            },
                                            {
                                                "example_id": "5b13a437-9cea-4a9e-a97f-87104eb68f1a",
                                                "sense_id": "e98c69ff-4360-36a7-8308-3ce1999dba8a",
                                                "text": "Klar lege ich ihr das Geld vor, sie wird es mir schon zurückzahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a2fec83-ad4c-3fbb-a5be-6c47bbb18020",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "etwas jemand anderem zur Prüfung geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d8759b-3104-4a76-badd-fdeac051257e",
                                                "sense_id": "3a2fec83-ad4c-3fbb-a5be-6c47bbb18020",
                                                "text": "Bevor du deine Arbeit endgültig abgibst, solltest du sie mir zur Durchsicht vorlegen."
                                            },
                                            {
                                                "example_id": "897db6f5-28d9-4ed8-9542-2ee387af3358",
                                                "sense_id": "3a2fec83-ad4c-3fbb-a5be-6c47bbb18020",
                                                "text": "Legst du mir noch deine Hausaufgaben vor, bevor du gehst?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d4b3225f-d92f-3f30-b142-973fb9ce6a19",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "etwas bekanntmachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ecbb84d-c8b6-4839-b3c1-22ef247a15b0",
                                                "sense_id": "d4b3225f-d92f-3f30-b142-973fb9ce6a19",
                                                "text": "Nach langen Beratungen können wir endlich unsere Ergebnisse vorlegen."
                                            },
                                            {
                                                "example_id": "7e004a92-fa35-4e67-8e4c-8c4497893008",
                                                "sense_id": "d4b3225f-d92f-3f30-b142-973fb9ce6a19",
                                                "text": "Schließlich legte er doch seine Untersuchungsergebnisse der Öffentlichkeit vor."
                                            },
                                            {
                                                "example_id": "27867288-e74c-4a43-b537-328664b7abaa",
                                                "sense_id": "d4b3225f-d92f-3f30-b142-973fb9ce6a19",
                                                "text": "Ehe ich einen Erbschein bekomme, muss ich meinen Pass vorlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c1516168-1baf-3263-86a4-00765fd7fd16",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "jemandem so zuspielen, dass der Pass genau in die richtige Richtung des Empfängers geht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7bb6a33-9bdf-45c9-94b9-ece78dffbd93",
                                                "sense_id": "c1516168-1baf-3263-86a4-00765fd7fd16",
                                                "text": "Es gelang ihm, seinem Mitspieler den Ball genau in den Lauf vorzulegen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a75ddc70-6196-3ee5-a649-7b5a5fcfa5b7",
                                        "entry_id": "5ce093a5-cb01-3e2f-942b-9ba0eafe88a0",
                                        "glosses": [
                                            "vor den Augen des Gastes Speisen auf den Teller legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62195ea-cd2c-4fab-87a2-a540292a0d50",
                                                "sense_id": "a75ddc70-6196-3ee5-a649-7b5a5fcfa5b7",
                                                "text": "Die Kellnerin legte die Speisen elegant und gekonnt vor."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
