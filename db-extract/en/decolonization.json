                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entkolonialisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77c854d7-8671-3f2b-8094-4a303d2ef2fb",
                                        "entry_id": "1ceca3ac-b64e-3f41-886b-2d4f205c5476",
                                        "glosses": [
                                            "Entlassung, Lossagung einer Kolonie aus wirtschaftlicher, politischer, kultureller etc. Abhängigkeit von der Kolonialmacht; Beendigung der Abhängigkeit einer Kolonie von ihrer Kolonialmacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3418a6d2-fa7c-4632-aa67-2bd5d442bf6d",
                                                "sense_id": "77c854d7-8671-3f2b-8094-4a303d2ef2fb",
                                                "text": "„Die Entkolonialisierung war die ungewollte, doch unabwendbare Folge des Zweiten Weltkrieges.“"
                                            },
                                            {
                                                "example_id": "403986c5-aa49-497d-a9df-559c6338a316",
                                                "sense_id": "77c854d7-8671-3f2b-8094-4a303d2ef2fb",
                                                "text": "„Als der britische Premierminister Harold Macmillan 1960 die Föderation besuchte und kurz darauf in Kapstadt vom «Wind des Wandels» auf dem afrikanischen Kontinent sprach, verstanden die Weißen in Südrhodesien dies als versteckte Ankündigung der baldigen Entkolonialisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50b8366c-cd2f-484a-8b5a-4976c7b0f156",
                        "source_entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
