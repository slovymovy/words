                                        "entry_id": "4fd99e13-fcbd-3294-80a8-5f4054be13d9",
                                        "glosses": [
                                            "fantastyczne stworzenie posiadające jeden róg na czole, pojawiające się w mitach i legendach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f1a0e3-fed3-4152-83af-2d62c344c085",
                                                "sense_id": "229adc30-e41c-3b10-9cad-d14b480683e8",
                                                "text": "Jednorożca identyfikowano m.in. z nosorożcem, oryksem, elandem i kudu. Do grona możliwych pierwowzorów często zalicza się także wymarłe elasmoterium"
                                            },
                                            {
                                                "example_id": "ead72791-0462-492a-94b6-fc1f7d82045d",
                                                "sense_id": "229adc30-e41c-3b10-9cad-d14b480683e8",
                                                "text": "Masz już dziesięć lat i nadal wierzysz w świętego mikołaja? Może jeszcze mi powiesz, że wierzysz także w jednorożce i krasnoludki?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
