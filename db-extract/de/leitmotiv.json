                        ],
                        "form": "dem Leitmotiv"
                    },
                    {
                        "form_id": "01763630-c520-48a8-9eb9-7e72d9f313cc",
                        "entry_id": "c9b4e8da-6b81-32d7-bc82-d52d909d7740",
                        "tags": [
                            "dative",
