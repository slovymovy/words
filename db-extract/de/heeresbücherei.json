                ],
                "senses": [
                    {
                        "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                        "entry_id": "43ba41c3-ed8d-3364-8a5a-e649580ac3f8",
                        "glosses": [
                            "Bibliothek des Militärs (von 1919 bis 1945)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42dc87e7-9c19-469a-9b7d-2b9d6a19ed73",
                                "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                                "text": "„Am Tage nach dem Tod ihrer Eltern hat sie lange gebraucht, ehe sie sich entschloß, Lorenz in der Heeresbücherei anzurufen.“"
                            },
                            {
                                "example_id": "110a44ec-1bb3-4832-a1ea-8ea10ba3b9b0",
                                "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                                "text": "„Von 1936 bis zum Ausgang des Zweiten Weltkrieges im Mai 1945 war er Direktor der Heeresbücherei Berlin.“"
                            },
                            {
                                "example_id": "7c212b81-6e31-4b68-a454-28f7d16dd8ea",
                                "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                                "text": "„Mit dem Ende des Ersten Weltkrieges und der Auflösung der Bayerischen Armee (und der damit einhergehenden Eingliederung der Truppenverbände in die Reichswehr) 1919 wurde die Bibliothek als Münchner Zweigstelle der Deutschen Heeresbücherei in Berlin und 1922 als Armeebibliothek München weitergeführt.“"
                            },
                            {
                                "example_id": "a4222a43-5767-4b79-8789-47ad189ebf62",
                                "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                                "text": "„Am 27. Februar 1942 wurde Gerstner nach Serbien befohlen und übernahm als Leiter die Heeresbücherei in Belgrad, wo er bis zum Rückzug der Wehrmacht im Herbst 1944 verblieb.“"
                            },
                            {
                                "example_id": "dbec5457-bda3-4937-8bbb-1987bd5a5227",
                                "sense_id": "db27d872-a7c0-3d33-ac5b-6641a1db6dbc",
                                "text": "„Die Deutsche Heeresbücherei wurde 1919 gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
