                        "source_sense_id": "83cb3e83-818a-3698-ae0e-ee1afc3f9248",
                        "target_lang_word": "addressee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "addressee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bde7662c-ecb6-38d9-b9ef-3f50d4683dfd",
                                        "entry_id": "9eb544c8-d0e7-379a-a30e-4b62354d29c3",
                                        "glosses": [
                                            "The person or organization to which something, such as a letter or message, is addressed or sent, for whom the item is intended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30689cd-ac61-3d7a-846a-576f22fd189f",
                                        "entry_id": "9eb544c8-d0e7-379a-a30e-4b62354d29c3",
                                        "glosses": [
                                            "A person or entity to whom discourse is directed, or the words referring to such an entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1afc6a-14fe-4305-964b-3c0124e2d1c7",
                                                "sense_id": "e30689cd-ac61-3d7a-846a-576f22fd189f",
                                                "text": "Person is a grammatical property which is overtly manifested in so-called Personal Pronouns: forms which include the speaker (I/we) are said to be ‘first personʼ Pronouns; forms which include the addressee (you) and not the speaker are said to be ‘second personʼ Pronouns; while forms which exclude both speaker and addressee (he/she/it/they) are ‘third personʼ Pronouns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6991adc8-5d0b-4b04-b8c8-18b9ecf6b882",
                        "source_entry_id": "1ea24c4a-379a-3431-9d8c-d4a214c45e9c",
                        "source_sense_id": "83cb3e83-818a-3698-ae0e-ee1afc3f9248",
                        "target_lang_word": "recipient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recipient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "One who receives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1776b698-9af9-4d9e-b734-5c48a53f6db2",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "the recipient of money or goods"
                                            },
                                            {
                                                "example_id": "bd7701e3-c4de-4166-a161-5aa8de47d14b",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "My e-mail never reached the intended recipient."
                                            },
                                            {
                                                "example_id": "7a79e1ed-38fa-43cf-a748-008dedc802c0",
                                                "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                                                "text": "And it [bribery and fraud] didn't stop there. Both Sir Winston Churchill and later Labour leader Michael Foot were allegedly regular recipients of private cheques that would have seen them summarily sacked in this present age of transparency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1c3638-e7fe-3dcf-ad4a-02d7497419ef",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "A person receiving donor organs or tissues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4abcdb57-229a-3d88-b4a3-2bc1d8d3e207",
                                        "entry_id": "39edfaf8-766b-384b-a762-e91f28b1ff36",
                                        "glosses": [
                                            "The portion of an alembic or other still in which the distilled liquid is collected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
