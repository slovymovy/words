        "fr-extract.jsonl": [
            {
                "entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                "word": "mutagénicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "def385fc-276f-455a-8f96-e6dd81941ecb",
                        "entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "mutagénicités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
                        "entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                        "glosses": [
                            "Propension d’une substance à provoquer des mutations génétiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c909e1d8-ec8e-4837-830d-4ae0622a5cf8",
                                "sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
                                "text": "Mutagénicité: le labétolol n’a démontré aucun indice concernant des effets mutagènes dans des études in vitro et in vivo."
                            },
                            {
                                "example_id": "bbdc1ddf-8467-469d-a5ef-9c3fe3055e36",
                                "sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
                                "text": "L’amarante a fait l’objet de nombreuses études sur les effets biochimiques cliniques, la toxicité aiguë, la toxicité à court terme, la mutagénicité, la reproduction, la tératogénicité et les effets à long terme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b113a8d-7b6e-42d4-bde3-60f983c20920",
                        "source_entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                        "source_sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
                        "target_lang_word": "Mutagenität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mutagenität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "816c9bdc-deb0-3704-b553-76da85c814db",
                                        "entry_id": "560ba531-dd82-3887-a1d3-0a8111c80371",
                                        "glosses": [
                                            "Eigenschaft eines Stoffes (Mutagen), im Erbmaterial eines Organismus Veränderungen (Mutationen) auslösen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea730ce-640f-4ba6-b183-30c60e1e30eb",
                                                "sense_id": "816c9bdc-deb0-3704-b553-76da85c814db",
                                                "text": "„Es muß aber hinzugefügt werden, daß durchaus nicht alle der im Pflanzenschutz oder in der Medizin verwendeten Substanzen dieser beiden Gruppen auf Mutagenität geprüft wurden.“"
                                            },
                                            {
                                                "example_id": "69606ac0-7e24-440e-97f9-3fba55e25fa3",
                                                "sense_id": "816c9bdc-deb0-3704-b553-76da85c814db",
                                                "text": "„Neben der akuten Toxizität werden in letzter Zeit zunehmend die experimentell viel schwerer prüfbaren Eigenschaften wie Teratogenität, Mutagenität und Cancerogenität von Stoffen bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32035799-342f-4b17-9506-a82324d6c4c9",
                        "source_entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                        "source_sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
                        "target_lang_word": "mutagenicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutagenicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f427ffa0-e478-385c-8f28-4d6f6863cfaa",
                                        "entry_id": "380cb1ba-5fbd-3812-afc8-1219ecb42af8",
                                        "glosses": [
                                            "The condition of being mutagenic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecb063f-eba1-46e0-902f-948bb77f2f15",
                                                "sense_id": "f427ffa0-e478-385c-8f28-4d6f6863cfaa",
                                                "text": "The Ames test proved that mutagenicity was linked to carcinogenicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acae618a-42f8-3c65-9771-54b126579d3d",
                                        "entry_id": "380cb1ba-5fbd-3812-afc8-1219ecb42af8",
                                        "glosses": [
                                            "A measure of the extent to which something is mutagenic."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4c34531-c522-4a73-9870-b2f00a91c7ef",
                        "source_entry_id": "67f81e23-236e-3172-8d2c-4ce9c70a05cb",
                        "source_sense_id": "cbe53030-20ad-3200-bf19-8d03796b35d4",
