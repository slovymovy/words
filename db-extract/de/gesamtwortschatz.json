                "senses": [
                    {
                        "sense_id": "257592b2-c1a6-3258-bb80-f809c1540597",
                        "entry_id": "4a844543-4c3e-3fe0-ae28-a4a91d806955",
                        "glosses": [
                            "Gesamtheit aller in einer Sprache vorhandenen Wörter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dde3ca2-f9bb-4d2d-a4e5-83e45c2287eb",
                                "sense_id": "257592b2-c1a6-3258-bb80-f809c1540597",
                                "text": "„Dass sich dabei eine grundsätzlich andere Sicht auf die Stellung der Anglizismen innerhalb des deutschen Gesamtwortschatzes ergibt, glauben (und hoffen) wir allerdings nicht.“"
                            },
                            {
                                "example_id": "8c034db6-38f9-478e-934e-0d2cb22f9341",
                                "sense_id": "257592b2-c1a6-3258-bb80-f809c1540597",
                                "text": "„Dieser Lusitanismus drang mit den portugiesischsprachigen Einwanderern aus Angola und Mosambik in den „namibischen“ Gesamtwortschatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
