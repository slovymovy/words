{
    "word_family": [
        "saliva",
        "salivary",
        "salivation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b7ec774-0038-391b-9eb0-649801c8835b",
                    "sense_definition": "To produce saliva in the mouth, especially as a reaction to food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of fresh bread baking in the oven made the hungry children <w>salivate</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Запах свежего хлеба, пекущегося в духовке, заставил голодных детей тут же <w>пускать слюнки</w>."
                            }
                        },
                        {
                            "text": "Dogs often <w>salivate</w> excessively when they see their owner preparing their dinner.",
                            "target_lang_translations": {
                                "ru": "У собак часто обильно <w>выделяется слюна</w>, когда они видят, как хозяин готовит им ужин."
                            }
                        }
                    ],
                    "synonyms": [
                        "drool",
                        "slobber",
                        "water"
                    ],
                    "common_phrases": [
                        "begin to salivate",
                        "salivate at the smell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять слюну во рту, особенно как реакцию на пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять слюну",
                                "target_lang_sense_clarification": "физиологический процесс"
                            },
                            {
                                "target_lang_word": "вызывать слюнотечение",
                                "target_lang_sense_clarification": "о процессе"
                            },
                            {
                                "target_lang_word": "пускать слюни",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5dceb50-1b74-3eaa-94fa-459a462f22e8",
                    "sense_definition": "To show eager anticipation or great desire at the expectation of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are <w>salivating</w> at the prospect of the company's upcoming initial public offering.",
                            "target_lang_translations": {
                                "ru": "Инвесторы <w>истекают слюной</w> в предвкушении предстоящего первичного публичного размещения акций компании."
                            }
                        },
                        {
                            "text": "He's been <w>salivating</w> over the latest model sports car for a while now.",
                            "target_lang_translations": {
                                "ru": "Он уже некоторое время <w>облизывается</w> на последнюю модель спортивного автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "crave",
                        "lust",
                        "hunger"
                    ],
                    "common_phrases": [
                        "salivating over the prospect",
                        "salivate at the thought"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять нетерпеливое ожидание или сильное желание в предвкушении чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истекать слюной",
                                "target_lang_sense_clarification": "в предвкушении чего-то желанного"
                            },
                            {
                                "target_lang_word": "облизываться",
                                "target_lang_sense_clarification": "переносное значение, страстно желать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}