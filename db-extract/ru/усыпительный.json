                    {
                        "translation_id": "a05d3eb8-1578-40e6-ba43-658c77871216",
                        "source_entry_id": "269205e7-ee1e-3e76-b5f7-aa2db321a4e8",
                        "source_sense_id": "50b68d45-afb5-30a0-8079-105b348ab94c",
                        "target_lang_word": "somnifère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnifère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                                        "entry_id": "548d3db4-aa58-316a-a3a6-11acf465b4e9",
                                        "glosses": [
                                            "Qui provoque, qui cause le sommeil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33398630-0013-416e-870d-fc7e410b3680",
                                                "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                                                "text": "Le pavot est somnifère."
                                            },
                                            {
                                                "example_id": "d40f90bf-a0cc-4ea5-9c60-b51ff5d74d37",
                                                "sense_id": "871a5de4-e17f-3efe-926f-8148befa6c2c",
                                                "text": "Nous pensions également offrir à Lady Hurf des fleurs somnifères (en prenant garde de ne pas les respirer) pour lui subtiliser ses perles dès qu’elle dormirait !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somnifère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f96f9e7b-d06e-3b35-95e5-49165a036014",
                                        "entry_id": "4963620e-c519-321a-9b36-9a66e13b6482",
                                        "glosses": [
                                            "Substance qui fait dormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ed5a4a-a2db-43bd-b84a-c42b42b6f0d8",
                                                "sense_id": "f96f9e7b-d06e-3b35-95e5-49165a036014",
                                                "text": "Prendre un somnifère pour dormir."
                                            },
                                            {
                                                "example_id": "d2ed15b7-705a-452c-8420-8ea796a82655",
                                                "sense_id": "f96f9e7b-d06e-3b35-95e5-49165a036014",
                                                "text": "L’opium est un somnifère très connu."
                                            },
                                            {
                                                "example_id": "8c1c2966-8886-43d4-8942-f3935f8a6d8a",
                                                "sense_id": "f96f9e7b-d06e-3b35-95e5-49165a036014",
                                                "text": "Un somnifère, destiné à améliorer le sommeil, peut par exemple affaiblir la vigilance et les aptitudes motrices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somnifère",
