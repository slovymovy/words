{
    "word_family": [
        "practice",
        "practitioner",
        "practicable",
        "practical",
        "practised"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3434e57f-89d6-39e9-9fd7-3041f1bb9e49",
                    "sense_definition": "To repeat an activity or exercise regularly in order to improve or maintain one's skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "skill_improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>practise</w> playing piano every day to get better.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>упражняться</w> в игре на пианино каждый день, чтобы играть лучше."
                            }
                        },
                        {
                            "text": "The team needs to <w>practise</w> their shooting before the big game on Friday.",
                            "target_lang_translations": {
                                "ru": "Команде нужно <w>потренировать</w> броски перед большой игрой в пятницу."
                            }
                        }
                    ],
                    "synonyms": [
                        "rehearse",
                        "drill",
                        "train"
                    ],
                    "common_phrases": [
                        "practise the piano",
                        "practise every day",
                        "practise a skill"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярно повторять какое-либо действие или упражнение, чтобы улучшить или поддержать свой навык."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тренироваться",
                                "target_lang_sense_clarification": "систематически упражняться"
                            },
                            {
                                "target_lang_word": "упражняться",
                                "target_lang_sense_clarification": "выполнять упражнения для развития навыка"
                            },
                            {
                                "target_lang_word": "практиковаться",
                                "target_lang_sense_clarification": "приобретать опыт в каком-либо деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df1bb5e-a4dc-32e2-aeef-9e95ed7ddf5b",
                    "sense_definition": "To work in a particular profession, especially law or medicine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>practised</w> law for forty years before retiring to the countryside.",
                            "target_lang_translations": {
                                "ru": "Она <w>занималась</w> юридической <w>практикой</w> сорок лет, прежде чем уйти на покой в сельскую местность."
                            }
                        },
                        {
                            "text": "He is licensed to <w>practise</w> medicine in several different countries.",
                            "target_lang_translations": {
                                "ru": "У него есть лицензия на <w>медицинскую практику</w> в нескольких разных странах."
                            }
                        }
                    ],
                    "synonyms": [
                        "work",
                        "exercise"
                    ],
                    "common_phrases": [
                        "practise law",
                        "practise medicine"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать по определенной профессии, особенно в области права или медицины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практиковать",
                                "target_lang_sense_clarification": "заниматься профессиональной деятельностью"
                            },
                            {
                                "target_lang_word": "заниматься практикой",
                                "target_lang_sense_clarification": "вести дела в качестве юриста или врача"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06a21750-ef64-33bc-93c6-482c6ab65f55",
                    "sense_definition": "To perform or observe a custom, belief, or religion in a habitual way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "observance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They gather to <w>practise</w> religion every Saturday at the local community center.",
                            "target_lang_translations": {
                                "ru": "Они собираются каждую субботу в местном общественном центре, чтобы <w>отправлять религиозные обряды</w>."
                            }
                        },
                        {
                            "text": "Many people in this region still <w>practise</w> ancient traditions today.",
                            "target_lang_translations": {
                                "ru": "Многие люди в этом регионе до сих пор <w>соблюдают</w> древние традиции."
                            }
                        }
                    ],
                    "synonyms": [
                        "observe",
                        "follow"
                    ],
                    "antonyms": [
                        "neglect",
                        "abandon"
                    ],
                    "common_phrases": [
                        "practise a religion",
                        "practise what you preach"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблюдать обычай, веру или религию привычным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исповедовать",
                                "target_lang_sense_clarification": "придерживаться какой-либо религии"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "следовать традициям или обычаям"
                            },
                            {
                                "target_lang_word": "практиковать",
                                "target_lang_sense_clarification": "регулярно совершать обряды или следовать учению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95a76c05-3ca3-3f3d-904f-09873f339938",
                    "sense_definition": "To put an idea, plan, or method into action; to carry out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often much harder to <w>practise</w> these theories than to write them.",
                            "target_lang_translations": {
                                "ru": "Часто гораздо труднее <w>применить</w> эти теории <w>на практике</w>, чем написать их."
                            }
                        },
                        {
                            "text": "The new safety measures were <w>practised</w> throughout the entire factory.",
                            "target_lang_translations": {
                                "ru": "Новые меры безопасности <w>внедрялись</w> на всей территории завода."
                            }
                        }
                    ],
                    "synonyms": [
                        "implement",
                        "execute",
                        "apply"
                    ],
                    "common_phrases": [
                        "put into practise"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Претворять идею, план или метод в жизнь; осуществлять на деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "применять на практике",
                                "target_lang_sense_clarification": "использовать знания или теории в реальности"
                            },
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "приводить в действие"
                            },
                            {
                                "target_lang_word": "претворять в жизнь",
                                "target_lang_sense_clarification": "реализовывать задуманное"
                            }
                        ]
                    }
                }
            ]
        },
