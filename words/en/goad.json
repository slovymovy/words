{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c33d82a5-b7ab-3a01-9221-100fdc523700",
                    "sense_definition": "To prod or poke an animal with a pointed stick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a long stick to <w>goad</w> the stubborn ox into the barn.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал длинную палку, чтобы <w>загнать</w> упрямого вола в хлев."
                            }
                        },
                        {
                            "text": "He had to <w>goad</w> the cattle forward when they refused to move.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>подгонять</w> скот вперёд, когда тот отказывался двигаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "prod"
                    ],
                    "common_phrases": [
                        "goad the animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тыкать или погонять животное заострённой палкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "животное тычком или стрекалом"
                            },
                            {
                                "target_lang_word": "колоть",
                                "target_lang_sense_clarification": "стрекалом, палкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e70d6264-8890-384a-9c8d-808db2346510",
                    "sense_definition": "To encourage or stimulate someone to take action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her teacher tried to <w>goad</w> her into applying for the prestigious scholarship.",
                            "target_lang_translations": {
                                "ru": "Учительница пыталась <w>побудить</w> её подать заявку на престижную стипендию."
                            }
                        },
                        {
                            "text": "The coach tried to <w>goad</w> the team into performing better during the final minutes.",
                            "target_lang_translations": {
                                "ru": "Тренер пытался <w>подстегнуть</w> команду играть лучше на последних минутах."
                            }
                        }
                    ],
                    "synonyms": [
                        "encourage",
                        "spur",
                        "stimulate"
                    ],
                    "common_phrases": [
                        "goad into action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Побуждать или стимулировать кого-либо к действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "торопить, побуждать к действию"
                            },
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "стимулировать, склонять"
                            },
                            {
                                "target_lang_word": "поощрять",
                                "target_lang_sense_clarification": "стимулировать активность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89b0296a-870e-3e9b-9741-c0d934fd0cf5",
                    "sense_definition": "To provoke or annoy someone into a reaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully tried to <w>goad</w> the boy into a fight by insulting his family.",
                            "target_lang_translations": {
                                "ru": "Хулиган пытался <w>спровоцировать</w> мальчика на драку, оскорбляя его семью."
                            }
                        },
                        {
                            "text": "She felt <w>goaded</w> by his constant criticism to finally speak her mind.",
                            "target_lang_translations": {
                                "ru": "Его постоянная критика <w>вынудила</w> её наконец высказать всё, что она думает."
                            }
                        }
                    ],
                    "synonyms": [
                        "provoke",
                        "incite",
                        "urge"
                    ],
                    "common_phrases": [
                        "goad into fighting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Провоцировать или раздражать кого-либо, вынуждая к ответной реакции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстрекать",
                                "target_lang_sense_clarification": "провоцировать на действие"
                            },
                            {
                                "target_lang_word": "подначивать",
                                "target_lang_sense_clarification": "дразнить, подталкивать к чему-либо"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "вызывать бурную реакцию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a1ce43e-2dd5-3ae8-bbb3-31d3539d1f19",
                    "sense_definition": "A long, pointed stick used to prod animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer carried a wooden <w>goad</w> to manage the herd in the field.",
                            "target_lang_translations": {
                                "ru": "Фермер носил деревянное <w>стрекало</w>, чтобы управляться со стадом в поле."
                            }
                        },
                        {
                            "text": "He used the <w>goad</w> to keep the animals moving along the narrow path.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>стрекало</w>, чтобы животные продолжали идти по узкой тропе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная заострённая палка, используемая для подгона скота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрекало",
                                "target_lang_sense_clarification": "острая палка для погона скота"
                            },
                            {
                                "target_lang_word": "прут",
                                "target_lang_sense_clarification": "для погона животных"
                            },
                            {
                                "target_lang_word": "погонялка",
                                "target_lang_sense_clarification": "шест или палка для скота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5c61688-840e-3bd0-b055-bae8613a1ce8",
                    "sense_definition": "Something that acts as a stimulus or incentive to action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stimulus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The threat of failure served as a powerful <w>goad</w> to his ambition.",
                            "target_lang_translations": {
                                "ru": "Угроза неудачи послужила мощным <w>стимулом</w> для его амбиций."
                            }
                        },
                        {
                            "text": "Poverty was the <w>goad</w> that forced him to work two jobs.",
                            "target_lang_translations": {
                                "ru": "Бедность была тем самым <w>бичом</w>, который заставил его работать на двух работах."
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulus",
                        "incentive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, служащее побудительным стимулом к действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимул",
                                "target_lang_sense_clarification": "побуждающий фактор"
                            },
                            {
                                "target_lang_word": "побуждение",
                                "target_lang_sense_clarification": "побудительный мотив"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "37135b6d-a5be-3664-ba14-d84eab02db57",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by a professor named <w>Goad</w>.",
                            "target_lang_translations": {
                                "ru": "Исследовательская работа была написана профессором по фамилии <w>Гоуд</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Goad</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил человека по фамилии мистер <w>Гоуд</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
