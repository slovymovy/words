                                    {
                                        "sense_id": "ea0d19de-2f34-33d5-8f54-995455bb5bc5",
                                        "entry_id": "213ff977-aa53-3b0d-a527-d0dbc1b9655a",
                                        "glosses": [
                                            "Qui passe ou qui coupe en travers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a81ee4d-b72a-4813-b331-97eb0a8283e6",
                                                "sense_id": "ea0d19de-2f34-33d5-8f54-995455bb5bc5",
                                                "text": "De Givonne, un bon chemin transversal mène à l'ouest, par le nord du bois de la Garenne et par le calvaire d’Illy, sur Illy, puis sur Fleigneux et Saint-Menges."
                                            },
                                            {
                                                "example_id": "155d1c77-7968-48a1-9a27-99e2af9d6355",
                                                "sense_id": "ea0d19de-2f34-33d5-8f54-995455bb5bc5",
                                                "text": "L’âne de Somalie serait à l’origine de toutes les formes domestiques ; il est reconnaissable grâce aux rayures transversales sur ses pattes."
                                            },
                                            {
                                                "example_id": "269e1975-9ddf-4cf7-97f9-abfd028b30c3",
                                                "sense_id": "ea0d19de-2f34-33d5-8f54-995455bb5bc5",
                                                "text": "Mon chemin était presque transversal, du nord au sud, et passait par le tertre le plus haut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2efec860-22c5-3517-aee3-c0ef659ab65c",
                                        "entry_id": "213ff977-aa53-3b0d-a527-d0dbc1b9655a",
                                        "glosses": [
                                            "Qualifie certaines parties qui sont situées en travers, qui se dirigent obliquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deecd085-bcb6-4662-9c48-bc183663e6f3",
                                                "sense_id": "2efec860-22c5-3517-aee3-c0ef659ab65c",
                                                "text": "Quant aux anthères réellement unilobées, il est évident qu'elles s'ouvrent par une seule fente, qui, bien que longitudinale, paraît transversale, si cette anthère est, comme cela arrive fréquemment dans ce cas, renversée sur le dos à l'extrémité du filet."
                                            },
                                            {
                                                "example_id": "b5419d35-9d1d-48a1-b820-567b3bdf61fb",
                                                "sense_id": "2efec860-22c5-3517-aee3-c0ef659ab65c",
                                                "text": "Muscle transversal du nez. — Artère transversale de la face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ef6044-b73f-33cb-a0ab-768090688909",
                                        "entry_id": "213ff977-aa53-3b0d-a527-d0dbc1b9655a",
                                        "glosses": [
                                            "Qualifie un sous-graphe pour lequel il n'existe aucune arête de son graphe qui ne lui soit pas reliée."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7e81291-ca5d-3ba3-be6a-7010116e783e",
                                        "entry_id": "213ff977-aa53-3b0d-a527-d0dbc1b9655a",
                                        "glosses": [
                                            "Qui recoupe plusieurs disciplines."
                                        ],
