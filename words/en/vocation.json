{
    "word_family": [
        "vocational",
        "vocationally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c02f7f0f-6443-3880-818d-2994701e6c5e",
                    "sense_definition": "An occupation or profession for which a person is suited, trained, or qualified.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teaching is a <w>vocation</w> that requires a great deal of patience and dedication.",
                            "target_lang_translations": {
                                "zh": "教学是一项需要极大的耐心和奉献精神的<w>职业</w>。"
                            }
                        },
                        {
                            "text": "He finally found his true <w>vocation</w> after working in several different fields.",
                            "target_lang_translations": {
                                "zh": "在从事了几个不同的领域后，他终于找到了自己真正的<w>职业</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "profession",
                        "career",
                        "calling",
                        "occupation"
                    ],
                    "common_phrases": [
                        "true vocation",
                        "find one's vocation"
                    ],
                    "target_lang_definitions": {
                        "zh": "一个人适合、受过训练或有资格从事的职业或行业。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "职业",
                                "target_lang_sense_clarification": "指一个人从事的长期工作或行业。"
                            },
                            {
                                "target_lang_word": "行业",
                                "target_lang_sense_clarification": "指特定的工作领域或职业类别。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45ad47b5-00ee-32b0-85c6-e331483149de",
                    "sense_definition": "A strong feeling of suitability for a particular career or role, often perceived as a divine calling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a religious <w>vocation</w> to serve the poor in remote areas.",
                            "target_lang_translations": {
                                "zh": "她感到有一种去偏远地区服务穷人的宗教<w>天职</w>。"
                            }
                        },
                        {
                            "text": "Many people believe that medicine is a <w>vocation</w> rather than just a job.",
                            "target_lang_translations": {
                                "zh": "许多人认为医学不仅仅是一份工作，更是一种<w>天职</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calling",
                        "mission"
                    ],
                    "common_phrases": [
                        "religious vocation"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某种职业或角色适合感的一种强烈感觉，常被视为一种使命或天职。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天职",
                                "target_lang_sense_clarification": "指被视为神圣的、命中注定的使命或职业。"
                            },
                            {
                                "target_lang_word": "使命",
                                "target_lang_sense_clarification": "指一个人认为自己必须完成的重要任务或人生目标。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}