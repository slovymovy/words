                                "target_senses": [
                                    {
                                        "sense_id": "095bc0f4-9b99-31c3-a912-4b4c04539b7d",
                                        "entry_id": "c2f77146-d5b3-3ca5-94a1-2b93e7a0c133",
                                        "glosses": [
                                            "Pronom à la deuxième personne du singulier, utilisé pour désigner celui à qui l’on parle, en tant que complément d’objet direct ou indirect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dbc0359-6f80-42ed-912a-ee372e0cf778",
                                                "sense_id": "095bc0f4-9b99-31c3-a912-4b4c04539b7d",
                                                "text": "Je te laisse, je n’ai pas le temps. / Je t'envie. (COD)"
                                            },
                                            {
                                                "example_id": "1e949f14-fbdb-4a04-b4ee-9af742734f73",
                                                "sense_id": "095bc0f4-9b99-31c3-a912-4b4c04539b7d",
                                                "text": "Je te donne tout ce que tu veux / Il t'en veut beaucoup. (COI)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d296dac0-c541-35b2-a75b-69ae1a2dba5d",
                                        "entry_id": "c2f77146-d5b3-3ca5-94a1-2b93e7a0c133",
                                        "glosses": [
                                            "Pour intensifier le discours, dans un emploi explétif (datif éthique)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013abb53-061a-4f4a-9064-e33d3d8d02c3",
                                                "sense_id": "d296dac0-c541-35b2-a75b-69ae1a2dba5d",
                                                "text": "Elle te m’a coincé les labiales\nPour me dégivrer les amygdales"
                                            },
                                            {
                                                "example_id": "1b3f50b2-4652-4211-bafd-a7211c30d82d",
                                                "sense_id": "d296dac0-c541-35b2-a75b-69ae1a2dba5d",
                                                "text": "Il te mange un kilo de boudin en moins d’un quart d’heure !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "te",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2421db72-5eb2-3fa9-a49d-7cad6292cd18",
                                        "entry_id": "9cffa72f-ad19-311a-8f22-cd61e4a4bca3",
                                        "glosses": [
                                            "Tu."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb805729-3345-481a-bad2-32adfeec995c",
                                                "sense_id": "2421db72-5eb2-3fa9-a49d-7cad6292cd18",
                                                "text": "Si tu me veux, chantait une de ses maîtresses, si te me veux un peu, viens, oh oui viens !"
                                            },
                                            {
                                                "example_id": "fd54c1b9-794b-4761-b665-3143437a79f9",
                                                "sense_id": "2421db72-5eb2-3fa9-a49d-7cad6292cd18",
                                                "text": "En attendant, te feras comme nous, te viendras te débarbouiller à la cuisine, sur la pierre à eau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "te",
