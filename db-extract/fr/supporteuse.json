                "senses": [
                    {
                        "sense_id": "46a21cea-174c-3c72-a57d-6b75304be30a",
                        "entry_id": "cadb8ab8-10b1-36a3-8f0a-384cd05a149d",
                        "glosses": [
                            "Femme qui soutient un concurrent ou une équipe, en particulier dans le domaine sportif."
                        ],
