                                "target_senses": [
                                    {
                                        "sense_id": "79d5bf9b-c292-3188-9c45-51e2c33a35e3",
                                        "entry_id": "426d3058-5546-334e-99e2-31c46fd7d239",
                                        "glosses": [
                                            "Of or relating to Terry Pratchett (1948–2015), English author of mostly comic fantasy novels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b68ea68-777c-4430-b40a-90d7804641ec",
                                                "sense_id": "79d5bf9b-c292-3188-9c45-51e2c33a35e3",
                                                "text": "Outside this Pratchettian sub-genre it is actually rare to come across novels that treat Arthurian material from a humorous perspective."
                                            },
                                            {
                                                "example_id": "1a818123-71f7-425d-9bc4-6b5b3127395c",
                                                "sense_id": "79d5bf9b-c292-3188-9c45-51e2c33a35e3",
                                                "text": "I plugged Susanna Clarke's debut fantasy Jonathan Strange & Mr Norrell, and read from James Branch Cabell's The Music from Behind the Moon (1926), which weirdly anticipates the Pratchettian common-sense solution to fairytale dilemmas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
