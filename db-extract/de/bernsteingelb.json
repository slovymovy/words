                ],
                "senses": [
                    {
                        "sense_id": "8f3d9620-7ce0-308d-80b9-3eb592b9e2ec",
                        "entry_id": "00e1d459-1092-3120-8a6e-7f3e5026aabe",
                        "glosses": [
                            "gelb wie Bernstein, in einem an Bernstein erinnernden Gelbton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bc7ecc-dcc7-442a-b244-6bb1744b7b1c",
                                "sense_id": "8f3d9620-7ce0-308d-80b9-3eb592b9e2ec",
                                "text": "„Dort drängelte sich bereits eine beachtliche Volksmenge und die helle, bernsteingelbe Sonne strahlte majestätisch nieder auf die Silberinsignien und die roten Ornate der höfischen Würdenträger, auf die groben Wollkleider der Händler und Handwerker und auf die derben Felle, womit die Besucher aus fremden Ländern umhüllt waren.“"
                            },
                            {
                                "example_id": "e4d91ac2-350c-4ed2-9dcf-a28946d1c493",
                                "sense_id": "8f3d9620-7ce0-308d-80b9-3eb592b9e2ec",
                                "text": "„In den Bergbächen gab es einmal Forellen. Man konnte sie in der bernsteingelben Strömung stehen sehen, wo die weißen Ränder ihrer Flossen sanft im Wasser fächelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
