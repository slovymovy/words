            "senses": [
                {
                    "sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
                    "sense_definition": "Een aangename, vaak sterke geur van spijzen, dranken of genotmiddelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik thuis kwam rook ik direct het heerlijke <w>aroma</w> van het eten.",
                            "target_lang_translations": {
                                "en": "When I got home, I immediately smelled the delicious <w>aroma</w> of the food.",
                                "ru": "Когда я пришел домой, я сразу почувствовал восхитительный <w>аромат</w> еды."
                            }
                        },
                        {
                            "text": "Het rijke <w>aroma</w> van versgemalen koffie vulde de hele keuken.",
                            "target_lang_translations": {
                                "en": "The rich <w>aroma</w> of freshly ground coffee filled the entire kitchen.",
                                "ru": "Насыщенный <w>аромат</w> свежемолотого кофе заполнил всю кухню."
                            }
                        }
                    ],
                    "synonyms": [
                        "geur",
                        "parfum"
                    ],
                    "antonyms": [
                        "stank"
                    ],
                    "common_phrases": [
                        "aroma van koffie",
                        "heerlijk aroma"
                    ],
                    "target_lang_definitions": {
                        "en": "A pleasant, often strong smell of food, drinks, or stimulants.",
                        "ru": "Приятный, часто сильный запах пищи, напитков или деликатесов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aroma",
