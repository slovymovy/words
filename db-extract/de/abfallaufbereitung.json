                "senses": [
                    {
                        "sense_id": "15095fe1-0c8c-32cc-9464-99593cc93d36",
                        "entry_id": "20ded2f3-4c5f-3fe4-bba1-b834b59eff41",
                        "glosses": [
                            "Sortierung von Abfall, um diesen zu recyclen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c291383f-892b-41c4-b5d7-f780f99a6ab4",
                                "sense_id": "15095fe1-0c8c-32cc-9464-99593cc93d36",
                                "text": "„Diese an sich sehr aussichtsreiche Methode konnte lange nicht weiterentwickelt werden, weil alle Überlegungen zu einer Abfallaufbereitung unter Einsatz thermischer Verfahren bis vor kurzem sowohl bei den Zulassungsbehörden als auch in weiten Kreisen der Bevölkerung aufgrund zum Teil ideologischer Verklemmungen tabuisiert waren.“"
                            },
                            {
                                "example_id": "d20227d3-d5de-4e8b-ac29-8fd4805d8afc",
                                "sense_id": "15095fe1-0c8c-32cc-9464-99593cc93d36",
                                "text": "„In Zürich wird die bis zum 6. November dauernde 1. Schweizerische Ausstellung für Neustoffe eröffnet, auf der neben neuartigen Werkstoffen Techniken der Abfallaufbereitung und -wiederverwertung vorgeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
