                        "examples": [
                            {
                                "example_id": "ef36e46e-5d8a-4e91-8b29-9f709925f8bb",
                                "sense_id": "b8f1ce47-1cdb-39b3-90d0-a15d35919d6e",
                                "text": "„Doch als Forscher am Sonntag auf der Wissenschaftskonferenz AAAS in Washington neue Erkenntnisse zur Marsmission der Nasa vorstellten, wurde schnell klar, dass diese den Alltag von uns allen verbessern könnten.“"
                            },
                            {
                                "example_id": "c369c2bd-ade7-4f9d-9341-25b7e12caa4d",
                                "sense_id": "b8f1ce47-1cdb-39b3-90d0-a15d35919d6e",
                                "text": "„Es soll leichter sein, für eine bemannte Marsmission ausgewählt zu werden, als die anstehende Aufnahmeprüfung für eine Journalistenschule zu meistern.“"
                            }
                        ],
