        "fr-extract.jsonl": [
            {
                "entry_id": "609bf7f4-06e0-3582-85fc-87a8331d9f0e",
                "word": "béatement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e30fb947-1329-32ec-89db-f8b3a0df5697",
                        "entry_id": "609bf7f4-06e0-3582-85fc-87a8331d9f0e",
                        "glosses": [
                            "D’une manière béate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2157b0dc-f3f8-44a9-867b-f8ee59498574",
                                "sense_id": "e30fb947-1329-32ec-89db-f8b3a0df5697",
                                "text": "[…], Fabre, assis, ou plutôt allongé dans son canot, respirait béatement la brise marine. À sa gauche, le paysage défilait, très lentement, […]."
                            },
                            {
                                "example_id": "540722f9-03ff-4253-b627-7e025d9d90e9",
                                "sense_id": "e30fb947-1329-32ec-89db-f8b3a0df5697",
                                "text": "Mais il se trouva que son sourire intérieur s'affichait béatement sur son visage jusqu’au moment où, en promenant son regard autour de lui, il reçut en retour un sourire plus éclatant que le sien de la part d’une jeune femme d’une trentaine d’années!."
                            },
                            {
                                "example_id": "010fce0b-2b62-4408-be28-bf2101e4029d",
                                "sense_id": "e30fb947-1329-32ec-89db-f8b3a0df5697",
                                "text": "Ces petites femmes à l’air niais, qui avaient de gros ventres, de gros reins et de petits pieds, lui semblaient des Vénus, et il souriait béatement aux voluptés de la nuit prochaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e7717a8-d16d-4823-afd3-7ed513b3c806",
                        "source_entry_id": "609bf7f4-06e0-3582-85fc-87a8331d9f0e",
                        "source_sense_id": "e30fb947-1329-32ec-89db-f8b3a0df5697",
                        "target_lang_word": "blissfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blissfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "713c0b04-2f30-373c-ada6-2c500ec142f7",
                                        "entry_id": "579dd4de-9e75-3049-9e03-6099425df098",
                                        "glosses": [
                                            "In a blissful, happy or joyful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b95f239-973e-4a46-880c-050d3eea393c",
                                                "sense_id": "713c0b04-2f30-373c-ada6-2c500ec142f7",
                                                "text": "What changes will be wrought in the character and condition of mankind, as the millennium advances and rolls blissfully away."
                                            },
                                            {
                                                "example_id": "16a43d74-c7f3-462f-8ed1-bace0b1e7bc7",
                                                "sense_id": "713c0b04-2f30-373c-ada6-2c500ec142f7",
                                                "text": "I walked the blissfully painful path of human love with intoxication and tears, always knowing that love's essence was elsewhere, hidden and yet addictively present."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
