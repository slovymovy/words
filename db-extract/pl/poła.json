                ],
                "translations": [
                    {
                        "translation_id": "04d34a01-5faf-434d-89d1-21713d5305f9",
                        "source_entry_id": "57fe52e4-af78-3876-80ae-ee79fc495c29",
                        "source_sense_id": "bd68a4ce-61da-3d63-8d7b-7b6a30a9465e",
                        "target_lang_word": "Schoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "die beim Sitzen durch Unterleib und Oberschenkel gebildete Körperpartie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd36b57-e776-4068-87a4-2f49d70c0001",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "Die Mutter nahm ihre jüngste Tochter auf den Schoß."
                                            },
                                            {
                                                "example_id": "629526e3-4e97-4c2f-ba65-d885a187019a",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "Komm auf meinen Schoß!"
                                            },
                                            {
                                                "example_id": "c6a5c056-6e81-408d-b5f7-5f223bb8a326",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "„Er saß da, hatte den Kopf auf die Brust gesenkt und die Hände im Schoß gefaltet.“"
                                            },
                                            {
                                                "example_id": "082abc88-cf94-4d4b-a00b-ad805415a95f",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "„Da sie auf meinem Schoß saß, hakte sie das eine aus, während ich das andere löste.“"
                                            },
                                            {
                                                "example_id": "128fad66-f49d-41d3-85a5-5e194768912d",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "„Nur noch dann und wann stahlen sich einzelne große Tränentropfen über ihre Wangen hinab und rollten leise auf die zarten Finger nieder, die sie im Schoße gefaltet hielt; aber tiefer Schmerz sprach aus den sanften Zügen des schönen Mädchens.“"
                                            },
                                            {
                                                "example_id": "dfda1d40-3210-4b19-8e62-555135bf6668",
                                                "sense_id": "ea635d7f-16d9-3ea7-97bb-9a42cb0df89e",
                                                "text": "„Ich schlug ein weiteres von Amalias Notizbüchern zu, das auf meinem Schoß lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ce4ab8b-0e3a-3d2d-91ff-699e80a672dc",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "gehoben für den weiblichen Unterleib"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9c62d8-a7f9-49a6-8003-2a088a76c00e",
                                                "sense_id": "1ce4ab8b-0e3a-3d2d-91ff-699e80a672dc",
                                                "text": "„Der Schoß ist fruchtbar noch, aus dem dies kroch!“"
                                            },
                                            {
                                                "example_id": "677c0cf5-b081-404e-af8a-1862ca774cf0",
                                                "sense_id": "1ce4ab8b-0e3a-3d2d-91ff-699e80a672dc",
                                                "text": "„Dann zündete sie die hohen silbernen Lampen in ihrer Stube an, breitete die seidenen Steppdecken aus, setzte Räucherwerk in Brand, wusch ihren Schoß und legte sich für die Nacht zu Simen Tjing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fcbb80df-027c-31e6-95cd-a78572321fa2",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "gehoben für den weiblichen Unterleib",
                                            "den Mutterleib"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f218279d-2353-4d8b-bb7c-a0e16af764ed",
                                                "sense_id": "fcbb80df-027c-31e6-95cd-a78572321fa2",
                                                "text": "Sie trägt Zwillinge in ihrem Schoß."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "e0fe41e8-d43a-3cbf-bda1-bc7b921e87b7",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "gehoben für den weiblichen Unterleib",
                                            "die Geschlechtsteile"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a73172-7ff0-4532-856f-4defc33c6f9d",
                                                "sense_id": "e0fe41e8-d43a-3cbf-bda1-bc7b921e87b7",
                                                "text": "„Und dann der schönen schoos / des hafens aller freude.“"
                                            },
                                            {
                                                "example_id": "2faf73bf-dc36-4dc7-b212-0e788f84a8ff",
                                                "sense_id": "e0fe41e8-d43a-3cbf-bda1-bc7b921e87b7",
                                                "text": "„Plötzlich umschlang sie mich, rollte mich auf den Rücken, warf sich auf mich hinauf, setzte sich auf mein hartes Glied, ließ es in ihrem Schoß verschwinden, saß wie ein Käfer auf mir, kroch aber wieder runter, riß plötzlich meinen Kopf hoch und preßte ihre Lippen auf die meinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "032b58eb-6779-39d1-b0cf-5bf06801cdfe",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "ein schützender, abgeschlossener Raum"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02ccf85-1a12-4e69-b8b6-d15a25629278",
                                                "sense_id": "032b58eb-6779-39d1-b0cf-5bf06801cdfe",
                                                "text": "Fühlst du dich etwa nicht wohl im Schoß der Familie?"
                                            },
                                            {
                                                "example_id": "1e084b50-fb94-4213-998c-d82ed2543d3e",
                                                "sense_id": "032b58eb-6779-39d1-b0cf-5bf06801cdfe",
                                                "text": "Sie ist in den Schoß der Kirche zurückgekehrt."
                                            },
                                            {
                                                "example_id": "505fea83-a3ba-42cc-9f27-2db3fd290fff",
                                                "sense_id": "032b58eb-6779-39d1-b0cf-5bf06801cdfe",
                                                "text": "„1953 verschwanden mit dem ersten Bundestag 86 unerledigte Gesetzentwürfe im Schoß der Geschichte, 1957 werden es durch den zeitigen Beginn des Wahlkampfs fast doppelt so viele Vorlagen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a4aabba1-a1f9-33c9-9d7f-02495e603388",
                                        "entry_id": "219406e4-a0e6-3ddc-a50d-8e6a5bbedcb9",
                                        "glosses": [
                                            "der die Hüfte bedeckende Teil der Kleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a146d543-d172-41fb-a1f5-5a416f33db6f",
                                                "sense_id": "a4aabba1-a1f9-33c9-9d7f-02495e603388",
                                                "text": "Das ist ein Frack mit langen Schößen."
                                            },
                                            {
                                                "example_id": "96c232fb-9b41-4e2a-a323-16c6f63a271f",
                                                "sense_id": "a4aabba1-a1f9-33c9-9d7f-02495e603388",
                                                "text": "„Er trug nämlich ziemlich defekte Gamaschen und eine Manchesterweste, deren Schöße länger waren als seine Joppe, dazu Strippenhaar, Klapphut und Hornbrille.“"
                                            },
                                            {
                                                "example_id": "0dfcb3d8-c57e-404b-8371-8ddf89ef043a",
                                                "sense_id": "a4aabba1-a1f9-33c9-9d7f-02495e603388",
                                                "text": "„Er wankte über den Fußboden mit kurzen, schleppenden Schritten und so gebeugt, daß die Schöße seines Mantels vor ihm auf den Boden schleiften, und sein Gesicht verzerrte sich, um seine Gichtschmerzen zu unterdrücken nach schlechter Nachtruhe in dieser feuchtkalten Bretterhütte so zeitig im Sommer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e030d79e-d6bb-3a24-99e9-1d3d440a7bf4",
                                        "entry_id": "be6cf31b-fda9-30f6-94d0-6a8979233963",
