                        "glosses": [
                            "een gestandaardiseerd traject (op een rollerbank) dat herhaaldelijk wordt gereden voor een test van o.a. het brandstofgebruik van een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aefab82-1aef-4763-9dc2-1c9f0a5ce6b6",
                                "sense_id": "42535d59-066c-3530-b618-4da79d785c66",
                                "text": "De Europese Commissie werkt aan een grondige aanpassing van de rijtest die gebruikt wordt om het officiële verbruik van auto’s vast te stellen. Dat bevestigde een woordvoerster dinsdag desgevraagd. De nieuwe rijcyclus moet in 2013 in werking treden. Reden voor aanpassing van de zogeheten New European Drive Cycle (NEDC) is de sterk verouderde manier van meten, die al meer dan dertig jaar in gebruik is."
                            },
                            {
                                "example_id": "13fe6f20-5692-48ac-b662-8dac4253be40",
                                "sense_id": "42535d59-066c-3530-b618-4da79d785c66",
                                "text": "Een door de Europese Unie vastgestelde rijcyclus (zie afbeelding) op een rollerbank geeft een bepaalde uitstoot van koolstofoxiden (CO2), waaraan technici het verbruik kunnen aflezen."
                            }
                        ]
                    }
