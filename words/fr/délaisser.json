{
    "word_family": [
        "délaissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71e970c8-0e2c-3afd-96ff-7e152efdd262",
                    "sense_definition": "Abandonner une personne ou cesser de lui manifester de l'attention ou de l'affection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Absorbé par son nouveau travail, il <w>délaisse</w> un peu sa famille depuis quelques mois."
                        },
                        {
                            "text": "L'enfant avait le sentiment douloureux que ses camarades le <w>délaissaient</w> pendant la récréation."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "négliger"
                    ],
                    "antonyms": [
                        "choyer",
                        "entourer"
                    ],
                    "common_phrases": [
                        "délaisser sa famille",
                        "délaisser ses amis"
                    ]
                },
                {
                    "sense_id": "3c6843fb-5067-31c6-a133-484301fd4016",
                    "sense_definition": "Négliger une chose, un lieu ou une activité, ne plus s'en occuper ni s'y intéresser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les propriétaires ont complètement <w>délaissé</w> le jardin qui est désormais envahi par les herbes."
                        },
                        {
                            "text": "Beaucoup de jeunes ont tendance à <w>délaisser</w> la télévision au profit des réseaux sociaux."
                        }
                    ],
                    "synonyms": [
                        "négliger",
                        "laisser à l'abandon"
                    ],
                    "antonyms": [
                        "entretenir",
                        "cultiver"
                    ],
                    "common_phrases": [
                        "délaisser ses études",
                        "délaisser une maison"
                    ]
                },
                {
                    "sense_id": "8db002c1-c01b-3b75-86c7-9b5d450b0efb",
                    "sense_definition": "Renoncer à continuer une action entreprise ou abandonner une pratique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faute de moyens financiers suffisants, l'association a dû <w>délaisser</w> ce grand projet culturel."
                        },
                        {
                            "text": "L'avocat a conseillé à son client de <w>délaisser</w> ces poursuites judiciaires trop coûteuses."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "renoncer à"
                    ],
                    "antonyms": [
                        "poursuivre",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "délaisser des poursuites",
                        "délaisser un projet"
                    ]
                },
                {
                    "sense_id": "b4920b87-5ab7-3b4c-9aff-9637457e58f0",
                    "sense_definition": "Céder ou abandonner la possession d'un bien ou d'un droit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En vertu du jugement rendu, l'héritier a <w>délaissé</w> la terre au créancier."
                        },
                        {
                            "text": "Le tribunal l'a condamné à <w>délaisser</w> la possession de cet immeuble contesté."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "revendiquer",
                        "conserver"
                    ],
                    "common_phrases": [
                        "délaisser un bien",
                        "délaisser un héritage"
                    ]
                }
            ]
        }
    ]
}