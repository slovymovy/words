                            {
                                "target_lang_word": "подаяние",
                                "target_lang_sense_clarification": "устар.: милостыня, пожертвование"
                            },
                            {
                                "target_lang_word": "подношение",
                                "target_lang_sense_clarification": "устар.: переданный дар"
                            }
                        ]
