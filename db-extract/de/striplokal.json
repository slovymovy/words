                "senses": [
                    {
                        "sense_id": "ac809d87-bdf7-387f-bb98-ed49e0576e7f",
                        "entry_id": "82e717bc-830e-3851-93a5-ee6a58f9a2e1",
                        "glosses": [
                            "Lokal, in dem Striptease vorgeführt wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "efd13771-e84b-41f9-bd72-3a611a8d597f",
                                "sense_id": "ac809d87-bdf7-387f-bb98-ed49e0576e7f",
                                "text": "„Sämtliche Orte waren im Grunde genommen identisch, dieselben Gettos, dieselben Striplokale und sogar dieselben Menschen – er traf Schulkameraden, die er vor Jahren kennengelernt hatte, und andere Armeebälger, die zufällig zur selben Zeit im selben Stützpunkt landeten.“"
                            },
                            {
                                "example_id": "d1998bc0-ef7a-4fcd-be58-80e0002bf93a",
                                "sense_id": "ac809d87-bdf7-387f-bb98-ed49e0576e7f",
                                "text": "„Das Hotel, in dem er arbeitete, sponserte die Liga, und sie traten gegen andere Hotels, Bars und Striplokale an, die ihre eigenen Teams hatten.“"
                            },
                            {
                                "example_id": "37f03a04-01bc-4e2e-ae5e-85f6bcf0762f",
                                "sense_id": "ac809d87-bdf7-387f-bb98-ed49e0576e7f",
                                "text": "„Wir waren jung, relativ jung, Ende zwanzig, und eines Abends fragte uns eine Kellnerin: ›Wenn ihr jetzt schon in solche Striplokale geht - was werdet ihr machen, wenn ihr erst richtig alt seid?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
