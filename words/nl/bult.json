    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d823779-daab-335a-83fa-bfc35ad8f7e3",
                    "sense_definition": "een uitstulping op de huid",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uitstulping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nadat hij gevallen was op zijn hoofd, was er een grote <w>bult</w> ontstaan.",
                            "target_lang_translations": {
                                "fr": "Après être tombé sur la tête, une grosse <w>bosse</w> est apparue."
                            }
                        },
                        {
                            "text": "Het kind heeft een pijnlijke <w>bult</w> op zijn voorhoofd door de val.",
                            "target_lang_translations": {
                                "fr": "L'enfant a une <w>bosse</w> douloureuse sur le front à cause de la chute."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstulping"
                    ],
                    "common_phrases": [
                        "pijnlijke bult"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une protubérance ou un gonflement sur la peau, souvent causé par un choc."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bosse",
                                "target_lang_sense_clarification": "gonflement sur le corps suite à un coup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "048fda1b-a161-32db-9ab1-c209c469fe91",
                    "sense_definition": "een uitstulping in het landschap",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitstulping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Nederland wordt iedere <w>bult</w> in het landschap al snel een berg genoemd.",
                            "target_lang_translations": {
                                "fr": "Aux Pays-Bas, la moindre <w>bosse</w> dans le paysage est vite appelée montagne."
                            }
                        },
                        {
                            "text": "De fietsers moesten over een kleine <w>bult</w> in de weg rijden.",
                            "target_lang_translations": {
                                "fr": "Les cyclistes ont dû passer sur une petite <w>bosse</w> sur la route."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstulping"
                    ],
                    "common_phrases": [
                        "bult in landschap"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une élévation ou une irrégularité dans le relief du terrain."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bosse",
                                "target_lang_sense_clarification": "élévation du terrain"
                            },
                            {
                                "target_lang_word": "butte",
                                "target_lang_sense_clarification": "petite colline ou élévation de terre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "701408f9-501d-3fe3-ad70-3108e609f696",
                    "sense_definition": "een verhoging op een verder vlak oppervlak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitstulping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een vreemde <w>bult</w> onder het tapijt.",
                            "target_lang_translations": {
                                "fr": "Il y avait une étrange <w>bosse</w> sous le tapis."
                            }
                        },
                        {
                            "text": "De <w>bult</w> in de muur werd door de schilder gladgestreken.",
                            "target_lang_translations": {
                                "fr": "La <w>bosse</w> dans le mur a été lissée par le peintre."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstulping"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une irrégularité ou une saillie sur une surface plane."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bosse",
                                "target_lang_sense_clarification": "irrégularité sur une surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e97110-4865-3f5c-8e29-e14e851c75ca",
                    "sense_definition": "een bochel op de rug",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uitstulping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het dier had een grote <w>bult</w> op zijn rug.",
                            "target_lang_translations": {
                                "fr": "L'animal avait une grosse <w>bosse</w> sur le dos."
                            }
                        },
                        {
                            "text": "De kameel heeft een <w>bult</w> die vet opslaat.",
                            "target_lang_translations": {
                                "fr": "Le chameau a une <w>bosse</w> qui stocke de la graisse."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une déformation courbée sur le dos ou une réserve de graisse chez certains animaux."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bosse",
                                "target_lang_sense_clarification": "déformation du dos ou réserve de graisse animale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
