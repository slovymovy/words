{
    "word_family": [
        "желание",
        "желанный",
        "пожелание",
        "пожелать",
        "возжелать",
        "нежелательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "724eb4d0-96cd-3c79-854d-40328d5fab9b",
                    "sense_definition": "Испытывать потребность, стремление к осуществлению чего-либо или к обладанию чем-либо; хотеть.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "хотеть",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Официант спросил: «Что вы <w>желаете</w> на десерт?»",
                            "target_lang_translations": {
                                "en": "The waiter asked, “What would you <w>like</w> for dessert?”"
                            }
                        },
                        {
                            "text": "Если <w>желаете</w>, я покажу вам ваш номер.",
                            "target_lang_translations": {
                                "en": "If you <w>wish</w>, I'll show you to your room."
                            }
                        }
                    ],
                    "synonyms": [
                        "хотеть"
                    ],
                    "common_phrases": [
                        "желать успеха",
                        "искренне желать",
                        "если желаете"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience a need or desire to achieve something or to possess something; to want."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wish",
                                "target_lang_sense_clarification": "to desire or want something to happen"
                            },
                            {
                                "target_lang_word": "desire",
                                "target_lang_sense_clarification": "to want or long for something earnestly"
                            },
                            {
                                "target_lang_word": "want",
                                "target_lang_sense_clarification": "to feel a need or desire for something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8be5ca02-1f91-3861-81c0-f0e977220ab0",
                    "sense_definition": "Высказывать кому-либо пожелание (добра, удачи, здоровья и т. п.).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "пожелание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед экзаменом друзья всегда <w>желают</w> удачи друг другу.",
                            "target_lang_translations": {
                                "en": "Before an exam, friends always <w>wish</w> each other good luck."
                            }
                        },
                        {
                            "text": "Мы от всего сердца <w>желаем</w> добра вашей семье.",
                            "target_lang_translations": {
                                "en": "We <w>wish</w> well to your family from the bottom of our hearts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "желать добра",
                        "желать удачи",
                        "желать зла"
                    ],
                    "target_lang_definitions": {
                        "en": "To express a well-wish to someone (such as happiness, good luck, health, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wish",
                                "target_lang_sense_clarification": "to express good or bad intentions toward someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8a6850d-a187-3175-af2e-64b2957634be",
                    "sense_definition": "Страстно хотеть получить что-либо, принадлежащее другому.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "зависть",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит <w>желать</w> чужого имущества или чужой славы.",
                            "target_lang_translations": {
                                "en": "One should not <w>covet</w> another's property or another's fame."
                            }
                        },
                        {
                            "text": "Он давно <w>желал</w> занять кресло своего начальника.",
                            "target_lang_translations": {
                                "en": "He had long <w>coveted</w> his boss's position."
                            }
                        }
                    ],
                    "common_phrases": [
                        "желать чужого"
                    ],
                    "target_lang_definitions": {
                        "en": "To passionately desire to obtain something belonging to another person; to covet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "covet",
                                "target_lang_sense_clarification": "to desire eagerly or wrongfully something belonging to another"
                            },
                            {
                                "target_lang_word": "desire",
                                "target_lang_sense_clarification": "to long for another person's property or status"
                            }
                        ]
                    },
                    "synonyms": [
                        "зариться"
                    ]
                }
            ]
        }
    ]
}