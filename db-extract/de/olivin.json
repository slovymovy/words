                        "glosses": [
                            "meist grünlich gefärbtes, kristallines Mineral"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ce00dc-35e4-4b77-912a-b0a8f98a1f1d",
                                "sense_id": "d1640f6f-b69c-327f-b982-edfcbeecf105",
                                "text": "Dieser Olivin ist schwarzgrün."
                            },
                            {
                                "example_id": "f12fa8c0-c28c-4a1a-9a3f-963c5df27292",
                                "sense_id": "d1640f6f-b69c-327f-b982-edfcbeecf105",
                                "text": "Das Olivin bildet ein kristallinisches Pulver von olivgrüner Farbe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fcafef0-a5f8-4096-b59e-d358cb179ea2",
                        "source_entry_id": "aa97b9a0-53ef-312c-a3c8-701f3f22feb3",
                        "source_sense_id": "d1640f6f-b69c-327f-b982-edfcbeecf105",
                        "source_sense_description": "Chemie, Geologie: meist grünlich gefärbtes, kristallines Mineral",
                        "target_lang_word": "olivine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olivine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                        "entry_id": "707c86d5-5e2f-35b5-980a-380906cf6e2f",
                                        "glosses": [
                                            "Minéral de couleur verdâtre du groupe des silicates, sous-groupe des nésosilicates qui cristallise dans le système orthorhombique; considéré en joaillerie comme une pierre fine (semi-précieuse)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9082a82-5803-4b8c-9ea0-cd5cd3208571",
                                                "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                                "text": "Cet élément-trace est aussi présent dans les émeraudes, le grenat-pyrope et l’olivine."
                                            },
                                            {
                                                "example_id": "dc496e77-7597-4920-95cd-1e803f297a56",
                                                "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                                "text": "La source la plus considérable est le manteau terrestre, où les péridotites sont justement formées de minéraux ferro-magnésiens comme les olivines et les pyroxènes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb15a7af-9342-431d-a00d-a478058c437b",
                        "source_entry_id": "aa97b9a0-53ef-312c-a3c8-701f3f22feb3",
                        "source_sense_id": "d1640f6f-b69c-327f-b982-edfcbeecf105",
