                "senses": [
                    {
                        "sense_id": "1cf597fa-4a90-3394-96d5-288e2aa3dfca",
                        "entry_id": "e83d8a46-e589-313f-b7a5-470c9a81f106",
                        "glosses": [
                            "kleines bis mittleres Unternehmen (KMU)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b35a3e7-ca5c-4b24-8f98-f00239f65264",
                                "sense_id": "1cf597fa-4a90-3394-96d5-288e2aa3dfca",
                                "text": "„Jeder dritte Mittelständler in Deutschland will sich einer Umfrage zufolge zur Stabilisierung der Lieferketten in den nächsten fünf Jahren stärker auf das Geschäft mit Westeuropa fokussieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f920808-2a63-3420-b4f9-cddde0aa72ed",
                        "entry_id": "e83d8a46-e589-313f-b7a5-470c9a81f106",
                        "glosses": [
                            "Angehöriger der Mittelschicht"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b90573d5-afff-4ff0-a022-6f01d51a6948",
                                "sense_id": "7f920808-2a63-3420-b4f9-cddde0aa72ed",
                                "text": "„Denn auch früher kam es vor, daß der akademische »Mittelständler« – wie häßlich und unnatürlich Begriff und Wort – kümmerlicher lebte als ein Taglöhner.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
