                "senses": [
                    {
                        "sense_id": "8be815a1-6367-3c45-b438-5a176daac2ed",
                        "entry_id": "569f07c0-f4da-3dd8-b44e-a36cfeac6f84",
                        "glosses": [
                            "Provisions, food and supplies, particularly for a journey."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcf3832-e485-4af8-b865-3013aa9a7bd4",
                                "sense_id": "8be815a1-6367-3c45-b438-5a176daac2ed",
                                "text": "O nephew! your grief is but folly;\n⁠In town you may find better prog"
                            },
                            {
                                "example_id": "0a3dd25c-72bb-4050-852f-1cd2c3e1f1bd",
                                "sense_id": "8be815a1-6367-3c45-b438-5a176daac2ed",
                                "text": "Let's see what prog we have for supper; the kettle has boiled long enough; my stomach cries cupboard […]"
                            },
                            {
                                "example_id": "2c1c1c33-af74-4653-b02e-6db85bdbd66d",
                                "sense_id": "8be815a1-6367-3c45-b438-5a176daac2ed",
                                "text": "So long as he picked from the filth his prog."
                            },
                            {
                                "example_id": "bfc81928-ede2-4eda-9d36-6ca9840d05ee",
                                "sense_id": "8be815a1-6367-3c45-b438-5a176daac2ed",
                                "text": "The glutton castaway, the drunkard in the desert, the lecher in prison, they are the happy ones. To hunger, thirst, lust, every day afresh and every day in vain, after the old prog, the old booze, the old whores, that's the nearest we'll ever get to felicity, the new porch and the very latest garden."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5ad7478-a951-36df-896a-c5528f5fb1fa",
                        "entry_id": "569f07c0-f4da-3dd8-b44e-a36cfeac6f84",
