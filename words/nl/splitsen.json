                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar besloot de klas in kleine groepen te <w>splitsen</w> voor de opdracht.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>разделить</w> класс на небольшие группы для выполнения задания.",
                                "en": "The teacher decided to <w>split</w> the class into small groups for the assignment.",
                                "pl": "Nauczyciel postanowił <w>podzielić</w> klasę na małe grupy do tego zadania.",
                                "de": "Der Lehrer beschloss, die Klasse für die Aufgabe in kleine Gruppen aufzu<w>teilen</w>.",
                                "fr": "L'enseignant a décidé de <w>diviser</w> la classe en petits groupes pour le devoir.",
                                "it": "L'insegnante ha deciso di <w>dividere</w> la classe in piccoli gruppi per il compito.",
                                "cs": "Učitel se rozhodl <w>rozdělit</w> třídu do malých skupin na tento úkol.",
                                "tr": "Öğretmen, ödev için sınıfı küçük gruplara <w>bölmeye</w> karar verdi.",
                                "es": "El profesor decidió <w>dividir</w> la clase en grupos pequeños para la tarea."
                            }
                        },
                        {
                            "text": "Zullen we de rekening van het avondeten gewoon <w>splitsen</w>?",
                            "target_lang_translations": {
                                "ru": "Может, просто <w>поделим</w> счет за ужин?",
                                "en": "Shall we just <w>split</w> the dinner bill?",
                                "pl": "Czy po prostu <w>podzielimy</w> rachunek za kolację?",
                                "de": "Wollen wir die Rechnung für das Abendessen einfach <w>teilen</w>?",
                                "fr": "Est-ce qu'on va simplement <w>partager</w> l'addition du dîner ?",
                                "it": "Vogliamo semplicemente <w>spartire</w> il conto della cena?",
                                "cs": "Co kdybychom si účet za večeři prostě <w>rozdělili</w>?",
                                "tr": "Akşam yemeği hesabını düz hesap <w>bölüşelim</w> mi?",
                                "es": "¿Y si simplemente <w>repartimos</w> la cuenta de la cena?"
                            }
