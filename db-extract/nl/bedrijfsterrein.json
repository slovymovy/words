                        "sense_id": "529b07d2-e534-305d-b0ab-6921c1d350e5",
                        "entry_id": "861c0d0d-c7e2-3668-b5a1-972d277a310b",
                        "glosses": [
                            "afgegrensd stuk land waarop fabrieken en andere ondernemingen gehuisvest zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5f0ece-d164-43d0-99fd-3c449d729e75",
                                "sense_id": "529b07d2-e534-305d-b0ab-6921c1d350e5",
                                "text": "Tjong Kim Sang is het namelijk niet eens met de redenering van het Openbaar Ministerie dat de brandstichters ervan uit moesten gaan dat in truckcabines wordt geslapen. Ze zei dat camerabeelden van het bedrijfsterrein haar in haar opvatting hebben versterkt. ,,Het is een afgesloten bedrijfsterrein. Ook getuigen in de buurt zeggen dat in de cabine slapen niet meer gebeurde.”"
                            },
                            {
                                "example_id": "48f3b6c5-1043-4e3d-b78e-f6fee8313b9c",
                                "sense_id": "529b07d2-e534-305d-b0ab-6921c1d350e5",
                                "text": "Het is niet duidelijk hoe de pakketten met harddrugs op het bedrijfsterrein in Roosendaal terecht zijn gekomen."
                            },
                            {
                                "example_id": "5becaee9-1cc1-4cdf-b56c-feb6678b86bf",
                                "sense_id": "529b07d2-e534-305d-b0ab-6921c1d350e5",
                                "text": "Onze onstuitbare behoefte pakjes, boodschappen en maaltijden aan de deur te laten bezorgen, leidt tot gouden opbrengsten voor logistieke bedrijfsterreinen in de stad."
                            }
                        ]
                    }
