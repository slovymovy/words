                                        "sense_id": "da8a9b94-70ea-3f39-944f-fb3cf912f21e",
                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "A kind of basket made especially from straw of rushes, especially for holding fish; by extension, the contents of such a basket or similar container, used as a measure of weight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40597a49-356c-4e8c-a80e-f5158df337e5",
                                                "sense_id": "da8a9b94-70ea-3f39-944f-fb3cf912f21e",
                                                "text": "He was pushing a barrow on the fish dock, wheeling aluminium kits which, when full, each contain 10 stone of fish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8a163b-5165-3b26-8748-371281675328",
                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "A collection of items forming the equipment of a soldier, carried in a knapsack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5f1d48-b77d-496e-b4ef-2e1d3778bf0d",
                                                "sense_id": "7e8a163b-5165-3b26-8748-371281675328",
                                                "text": "Dudes! You simply have too much stuff in your kit! But don't sweat it, I can buy some stuff you don't need."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a9083d-16ac-3b03-8653-3e757496648c",
                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "Any collection of items needed for a specific purpose, especially for use by a workman, or personal effects packed for travelling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3443afe0-6276-442a-b9a2-1a2961dfc890",
                                                "sense_id": "96a9083d-16ac-3b03-8653-3e757496648c",
                                                "text": "Always carry a good first-aid kit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e986e741-24a6-38df-b0d6-59c5a4071e3f",
                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "A collection of parts sold for the buyer to assemble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f6298b-c262-4eb6-ab12-b114db04f6c5",
                                                "sense_id": "e986e741-24a6-38df-b0d6-59c5a4071e3f",
                                                "text": "I built the entire car from a kit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd79a76-3704-357a-ae63-a3e6f991c71a",
                                        "entry_id": "ffd2931b-8952-3842-92e6-eb608bcab255",
                                        "glosses": [
                                            "The standard set of clothing, accessories and equipment worn by players."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd7d1c1-4809-4b94-9f49-f36f78f0ce85",
                                                "sense_id": "0fd79a76-3704-357a-ae63-a3e6f991c71a",
                                                "text": "A sell-out crowd of 10,000 then observed perfectly a period of silence before the team revealed their black armbands, complete with stitched-in poppies, for the match. After Fifa’s about-turn, it must have been a frantic few days for the England kit manufacturer. The on-field challenge was altogether more straightforward."
                                            }
                                        ]
                                    },
