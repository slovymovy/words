{
    "word_family": [
        "aversion",
        "aversive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "397baa51-0e72-3735-b593-1f91154c4fe0",
                    "sense_definition": "To turn one's eyes or face away from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "turn_away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>averted</w> her eyes when the scary scene appeared on the screen.",
                            "target_lang_translations": {
                                "ru": "Она <w>отвела</w> глаза, когда на экране появилась страшная сцена."
                            }
                        },
                        {
                            "text": "He <w>averted</w> his gaze to avoid making eye contact with the stranger.",
                            "target_lang_translations": {
                                "ru": "Он <w>отвёл</w> взгляд, чтобы не встречаться глазами с незнакомцем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "avert eyes",
                        "avert gaze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отводить глаза, взгляд или лицо в сторону от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "глаза, взгляд в сторону"
                            },
                            {
                                "target_lang_word": "отвести",
                                "target_lang_sense_clarification": "взгляд или глаза (соверш.)"
                            },
                            {
                                "target_lang_word": "отворачивать",
                                "target_lang_sense_clarification": "лицо или голову"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e661e61b-ea9a-3e40-b197-34cbd9bed2e2",
                    "sense_definition": "To prevent or stop something unpleasant from happening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prevent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quick action helped to <w>avert</w> a major disaster at the factory.",
                            "target_lang_translations": {
                                "ru": "Быстрые действия помогли <w>предотвратить</w> крупную аварию на заводе."
                            }
                        },
                        {
                            "text": "The government took steps to <w>avert</w> an economic crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло меры, чтобы <w>предотвратить</w> экономический кризис."
                            }
                        }
                    ],
                    "synonyms": [
                        "forestall",
                        "hinder"
                    ],
                    "common_phrases": [
                        "avert disaster",
                        "avert crisis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предотвращать наступление чего-либо опасного, нежелательного или неприятного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвращать",
                                "target_lang_sense_clarification": "не давать произойти катастрофе, кризису"
                            },
                            {
                                "target_lang_word": "предотвратить",
                                "target_lang_sense_clarification": "не допустить беды (соверш.)"
                            },
                            {
                                "target_lang_word": "отвращать",
                                "target_lang_sense_clarification": "отводить беду, угрозу (книжн.)"
                            },
                            {
                                "target_lang_word": "отвести",
                                "target_lang_sense_clarification": "устранить опасность, беду (соверш.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}