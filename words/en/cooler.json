{
    "word_family": [
        "cool",
        "coolant",
        "coolness",
        "coolly",
        "uncool"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17493a96-4e4c-3abd-b944-2982b230e267",
                    "sense_definition": "An insulated container used with ice or freezer packs to keep food or beverages cold.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooling_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We packed a large <w>cooler</w> with sandwiches and drinks for our trip to the beach.",
                            "target_lang_translations": {
                                "ru": "Мы собрали большой <w>переносной холодильник</w> с бутербродами и напитками для поездки на пляж."
                            }
                        },
                        {
                            "text": "Please put the milk back in the <w>portable</w> <w>cooler</w> so it stays fresh.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи молоко обратно в <w>сумку-холодильник</w>, чтобы оно оставалось свежим."
                            }
                        }
                    ],
                    "synonyms": [
                        "cool bag",
                        "cool box",
                        "ice chest"
                    ],
                    "common_phrases": [
                        "portable cooler",
                        "picnic cooler",
                        "styrofoam cooler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изолированный контейнер, используемый со льдом или аккумуляторами холода для сохранения продуктов и напитков холодными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумка-холодильник",
                                "target_lang_sense_clarification": "переносная мягкая сумка"
                            },
                            {
                                "target_lang_word": "переносной холодильник",
                                "target_lang_sense_clarification": "портативное устройство"
                            },
                            {
                                "target_lang_word": "термобокс",
                                "target_lang_sense_clarification": "жесткий изотермический контейнер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf54b774-fe54-3104-99c5-634507f7913e",
                    "sense_definition": "A refreshing drink made of alcohol, such as wine, mixed with fruit juice or carbonated water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoyed a refreshing <w>wine</w> <w>cooler</w> while sitting on the patio during the summer evening.",
                            "target_lang_translations": {
                                "ru": "Она наслаждалась освежающим <w>винным кулером</w>, сидя на террасе летним вечером."
                            }
                        },
                        {
                            "text": "The bar offers a variety of fruit-flavored <w>coolers</w> for those who prefer lighter drinks.",
                            "target_lang_translations": {
                                "ru": "Бар предлагает разнообразные фруктовые <w>кулеры</w> для тех, кто предпочитает легкие напитки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine cooler",
                        "fruit cooler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освежающий напиток, приготовленный из алкоголя (например, вина), смешанного с фруктовым соком или газированной водой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулер",
                                "target_lang_sense_clarification": "слабоалкогольный коктейль"
                            },
                            {
                                "target_lang_word": "винный напиток",
                                "target_lang_sense_clarification": "смесь вина с соком"
                            },
                            {
                                "target_lang_word": "прохладительный напиток",
                                "target_lang_sense_clarification": "освежающий коктейль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7604f945-61b6-3481-8da5-e0c43d0d53e8",
                    "sense_definition": "A device used to lower the temperature of the air in a room or building.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooling_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>swamp</w> <w>cooler</w> is a very effective way to stay comfortable in dry climates.",
                            "target_lang_translations": {
                                "ru": "Испарительный <w>охладитель</w> — очень эффективный способ поддерживать комфорт в сухом климате."
                            }
                        },
                        {
                            "text": "It was so hot in the office that we had to turn on the <w>air</w> <w>cooler</w>.",
                            "target_lang_translations": {
                                "ru": "В офисе было так жарко, что нам пришлось включить <w>охладитель воздуха</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "air cooler",
                        "swamp cooler",
                        "evaporative cooler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для снижения температуры воздуха в помещении или здании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охладитель",
                                "target_lang_sense_clarification": "прибор для охлаждения воздуха"
                            },
                            {
                                "target_lang_word": "кондиционер",
                                "target_lang_sense_clarification": "бытовое устройство охлаждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8551191b-cfcb-374a-b3f1-380bc17a6c07",
                    "sense_definition": "A slang term for a prison or a jail cell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheriff decided to throw the troublemaker in the <w>cooler</w> for the night to let him calm down.",
                            "target_lang_translations": {
                                "ru": "Шериф решил бросить смутьяна в <w>кутузку</w> на ночь, чтобы тот успокоился."
                            }
                        },
                        {
                            "text": "He spent two days in the <w>cooler</w> before his lawyer could get him out.",
                            "target_lang_translations": {
                                "ru": "Он провел два дня в <w>обезьяннике</w>, прежде чем адвокат смог его вытащить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the cooler"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for jail"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение тюрьмы или тюремной камеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кутузка",
                                "target_lang_sense_clarification": "разговорное о тюрьме"
                            },
                            {
                                "target_lang_word": "обезьянник",
                                "target_lang_sense_clarification": "камера временного содержания"
                            },
                            {
                                "target_lang_word": "холодная",
                                "target_lang_sense_clarification": "устаревшее сленговое о карцере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0957c00d-28f9-3cfd-a27d-dc5356076f40",
                    "sense_definition": "The comparative form of <w>cool</w>; more cool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather is much <w>cooler</w> today than it was yesterday.",
                            "target_lang_translations": {
                                "ru": "Погода сегодня гораздо <w>прохладнее</w>, чем вчера."
                            }
                        },
                        {
                            "text": "He thinks he looks <w>cooler</w> when he wears his new leather jacket.",
                            "target_lang_translations": {
                                "ru": "Он думает, что выглядит <w>круче</w>, когда надевает свою новую кожаную куртку."
                            }
                        }
                    ],
                    "antonyms": [
                        "warmer",
                        "hotter"
                    ],
                    "common_phrases": [
                        "cooler weather",
                        "look cooler"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного cool; более прохладный или более крутой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прохладнее",
                                "target_lang_sense_clarification": "о температуре"
                            },
                            {
                                "target_lang_word": "круче",
                                "target_lang_sense_clarification": "о стиле или поведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f371468f-1580-3c7a-8e41-56a82de3e469",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Cooler</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Кулер</w>, которая пожертвовала землю."
                            }
                        },
                        {
                            "text": "Mr. <w>Cooler</w> has been working at the university for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кулер</w> работает в университете уже более двадцати лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кулер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}