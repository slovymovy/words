                    },
                    {
                        "sense_id": "50bc8529-6ae0-3dee-b659-8a777a50d878",
                        "entry_id": "c7486eb2-f58c-3132-94a4-ade414da0e9b",
                        "glosses": [
                            "Qui s'étend tout autour sans limite."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c1db1aa4-9574-4df3-b55a-2da46259dea8",
                                "sense_id": "50bc8529-6ae0-3dee-b659-8a777a50d878",
                                "text": "Enserrée dans son ring urbain, Charleroi est aujourd'hui un véritable centre régional, environné d'une vaste nébuleuse de communes aux développements tentaculaires."
                            },
                            {
                                "example_id": "9df1991d-df5d-4692-a5c0-655eb5132617",
                                "sense_id": "50bc8529-6ae0-3dee-b659-8a777a50d878",
                                "text": "Le Québec n'échappe donc pas à cette industrie tentaculaire."
                            }
                        ]
                    }
