        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84df6d86-028d-34e3-98be-9d25081df245",
                "word": "tabarnak",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8aa6c69a-51a8-3bfb-bdce-93a2c261a174",
                        "entry_id": "84df6d86-028d-34e3-98be-9d25081df245",
                        "glosses": [
                            "An expletive and intensifier for all purposes."
                        ],
                        "tags": [
                            "Quebec",
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "17b7abb5-c237-41ad-9cdf-54049c2119d1",
                                "sense_id": "8aa6c69a-51a8-3bfb-bdce-93a2c261a174",
                                "text": "Non, non, c'est juste une joke. Garde-lé, ton vingt piastres. C't'une tabarnak de gang de fous: j'ai les poches pleines. M'a te dire rien qu'une affaire: tu l'as en tabarnak ! Non, non, c'est vrai. T'es correct, toé.",
                                "translation": "No, no, I was just joking. Keep it, your twenty bucks. They're all a fuckin' bunch of idiots: my pockets are full. Lemme tell ya something: you fuckin' have it! No, no, it's true: you're quite good, you.",
                                "english": "No, no, I was just joking. Keep it, your twenty bucks. They're all a fuckin' bunch of idiots: my pockets are full. Lemme tell ya something: you fuckin' have it! No, no, it's true: you're quite good, you."
                            },
                            {
                                "example_id": "cef0fd2d-cbdb-4af7-b690-35e89ad84951",
                                "sense_id": "8aa6c69a-51a8-3bfb-bdce-93a2c261a174",
                                "text": "Roman Reigns, écoute-moi bien: demain soir, t'es chez moi tabarnak!",
                                "translation": "Roman Reigns, listen to me: tomorrow night, you're in my fuckin' house!",
                                "english": "Roman Reigns, listen to me: tomorrow night, you're in my fuckin' house!"
                            }
                        ]
                    }
                ],
