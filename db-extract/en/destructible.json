                    {
                        "translation_id": "4a578ca3-9518-42ba-8906-455e47854031",
                        "source_entry_id": "b952b708-130b-34c6-a9d1-f0a81067203e",
                        "source_sense_id": "b4296119-fd0d-394d-8093-2110a791bb2a",
