                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e2fa8c-7f60-45a3-ab97-51bdca309492",
                                "sense_id": "10e430b4-56b8-3756-94fa-c072d38f1dd5",
                                "text": "„Degenfechterin Imke Duplitzer hat in der Diskussion um ihr umstrittenes Interview Unterstützung von ihrer Teamkollegin, der EM-Dritten Monika Sozanska, bekommen.“"
                            }
                        ],
