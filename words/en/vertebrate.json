                            "target_lang_translations": {
                                "de": "Menschen und Hunde sind beides Beispiele für ein <w>Wirbeltier</w>."
                            }
                        },
                        {
                            "text": "The biology class studied how land <w>vertebrates</w> evolved over millions of years.",
                            "target_lang_translations": {
                                "de": "Der Biologiekurs untersuchte, wie sich Land<w>wirbeltiere</w> über Millionen von Jahren entwickelt haben."
                            }
