                    "frequency": "Middle",
                    "semantic_group_id": "sexual_intercourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was worried that she was just looking for a quick <w>bonk</w> rather than a relationship.",
                            "target_lang_translations": {
                                "ru": "Он переживал, что она ищет просто быстрый <w>перепихон</w>, а не отношения."
                            }
