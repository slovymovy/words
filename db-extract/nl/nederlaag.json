                ],
                "senses": [
                    {
                        "sense_id": "bb1e1f67-9eae-36ef-b9ff-e44d67c66082",
                        "entry_id": "c1e34817-fdc1-3a90-b73f-7d3afb49f523",
                        "glosses": [
                            "het verlies van een strijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7e3bdc-1040-4065-bb3b-902dfbb81090",
                                "sense_id": "bb1e1f67-9eae-36ef-b9ff-e44d67c66082",
                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4865cf16-e1b3-45e6-9af7-c14a4a6647e2",
                        "source_entry_id": "c1e34817-fdc1-3a90-b73f-7d3afb49f523",
                        "source_sense_id": "bb1e1f67-9eae-36ef-b9ff-e44d67c66082",
                        "source_sense_description": "het verlies van een strijd",
                        "target_lang_word": "Niederlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niederlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                        "entry_id": "4e28ac63-dd62-32d3-8f86-4f1786dd80f7",
                                        "glosses": [
                                            "das Unterliegen/Besiegtwerden bei einer Auseinandersetzung im militärischen, persönlichen oder sportlichen Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001d99ee-00cc-4a99-a06b-8854bff8b074",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "Nach der klaren 0:9-Niederlage hat unsere Mannschaft keine Chance mehr auf den Titel."
                                            },
                                            {
                                                "example_id": "11d957b8-c121-4243-9d91-017b1f48bfd7",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "[Fußball-EM 2020, 23.6.2021, Deutschland – Hungarn:] „Insgesamt ist es der 35. Vergleich, wobei die Bilanz fast ausgeglichen ist. Deutschland feierte 13 Siege und musste elf Niederlagen hinnehmen.“"
                                            },
                                            {
                                                "example_id": "70e87957-2c8c-4eb2-ab3a-c1dfc982d293",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "[Fußball-EM 2020:] „Kroatien wendet gegen Tschechien eine Niederlage ab.“"
                                            },
                                            {
                                                "example_id": "c72388f4-10d2-475b-82e2-105a04e5c8ae",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Italien ist nun seit 30 Spielen ungeschlagen (25 Siege, 5 Remis), die letzte Niederlage gab es im September 2018 (0:1 in Portugal).“"
                                            },
                                            {
                                                "example_id": "9fbb5ac1-2039-4c1d-afe3-17b0e041140f",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Die Niederlage der athenischen Flotte im Nildelta gegen persische Schiffe beendet die griechische Intervention im ägyptischen Aufstand.“"
                                            },
                                            {
                                                "example_id": "f4980d8f-860f-4abc-94cd-a387c526beee",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Sie steht bis heute für das ultimative Scheitern: die Schlacht von Waterloo. Denn für Napoleon Bonaparte bedeutete die Niederlage am 18. Juni 1815 das unrühmliche und endgültige Ende seiner Herrschaft.“"
                                            },
                                            {
                                                "example_id": "5e685daa-0fe9-46dc-bb3b-f0ffd2f66a1e",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Die deutsche Niederlage 1918 vollzog sich in drei deutlich voneinander abgesetzten Phasen.“"
                                            },
                                            {
                                                "example_id": "f91f32c0-b358-46fc-bb7c-0036e9d40a51",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Der Westfeldzug, auch Frankreichfeldzug genannt, führt innerhalb weniger Wochen zur Niederlage und Besetzung der bis dahin neutralen Staaten Niederlande, Belgien, Luxemburg und Frankreich.“"
                                            },
                                            {
                                                "example_id": "1a87fae8-aa49-427a-a61c-cf6f50023554",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Spätestens mit der Niederlage in der Schlacht um Stalingrad am 2. Februar 1943 gehen Hitlers Eroberungspläne in die Brüche.“"
                                            },
                                            {
                                                "example_id": "690e5876-1cf9-4a4a-907c-61e3b5594455",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Die Niederlage war dann bitter und deutlich.“"
                                            },
                                            {
                                                "example_id": "7d23da4a-627d-4a36-84d8-2863d625a13b",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Am 8. Mai 1945 endete der Zweite Weltkrieg mit der vollständigen Niederlage Deutschlands.“"
                                            },
                                            {
                                                "example_id": "74e00149-efff-4367-b80b-2294e37d9a9b",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "„Bereits vor der Aufhebung des Verbotes durch das Verwaltungsgericht kündigte Berlins Polizeipräsidentin Barbara Slowik an, im Fall einer juristischen Niederlage das Oberverwaltungsgericht anzurufen.“"
                                            },
                                            {
                                                "example_id": "02a6fc54-a5f9-4363-89af-8692191cbabb",
                                                "sense_id": "34675177-59a7-3812-938d-53978ed40ff9",
                                                "text": "[Amtsinhaber Olaf] „Tauras wirkte enttäuscht: »Es hat nicht geklappt, die Wählerinnen und Wähler aus dem ersten Wahlgang wieder an die Urne zu holen«, nannte er einen Grund für seine Niederlage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e6ec7bc-18ea-4da3-963f-b49e5e48094a",
                        "source_entry_id": "c1e34817-fdc1-3a90-b73f-7d3afb49f523",
                        "source_sense_id": "bb1e1f67-9eae-36ef-b9ff-e44d67c66082",
                        "source_sense_description": "het verlies van een strijd",
                        "target_lang_word": "defeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00d69019-34cb-38f0-93c4-54221a3030ac",
                                        "entry_id": "4ab93c1e-a1a3-3b2f-a166-611bddfaa834",
                                        "glosses": [
                                            "To overcome in battle or contest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f336087-a310-4eca-9535-f74d291759da",
                                                "sense_id": "00d69019-34cb-38f0-93c4-54221a3030ac",
                                                "text": "Wellington defeated Napoleon at Waterloo."
                                            },
                                            {
                                                "example_id": "a70b47dd-fdbb-4718-b645-5b8ae8db2c37",
                                                "sense_id": "00d69019-34cb-38f0-93c4-54221a3030ac",
                                                "text": "The Japanese defeated the Ming general Tsu Chʻeng-hsün 祖承訓 at Pʻing jang 平壤 in 1592, the first year of Bunroku 文祿 of Japan, and the fighting continued for some years; but at Hideyoshi's death the Japanese troops left Korea."
                                            },
                                            {
                                                "example_id": "7affe35b-c1fe-4a52-be78-41b4778621ec",
                                                "sense_id": "00d69019-34cb-38f0-93c4-54221a3030ac",
                                                "text": "My personal success or failure is insignificant; the rise or fall of the nation is my responsibility and must not be shirked. Upon introspection, I feel I am firmer than ever in confidence that the Communists will be defeated. These are feelings which will comfort Father's soul in Heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebaf03a4-c81a-3664-8f6a-44885d0cf3ca",
                                        "entry_id": "4ab93c1e-a1a3-3b2f-a166-611bddfaa834",
                                        "glosses": [
                                            "To reduce, to nothing, the strength of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71934e90-780d-4bd7-a0a4-b60df46c6158",
                                                "sense_id": "ebaf03a4-c81a-3664-8f6a-44885d0cf3ca",
                                                "text": "He finds himself naturally to dread a superior Being that can defeat all his designs, and disappoint all his hopes."
                                            },
                                            {
                                                "example_id": "fc7b79d2-0d62-4c9b-87a4-a6accc04dc15",
                                                "sense_id": "ebaf03a4-c81a-3664-8f6a-44885d0cf3ca",
                                                "text": "In one instance he defeated his own purpose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ef21a3-ab40-30bf-b3d4-5dbea6928cda",
                                        "entry_id": "4ab93c1e-a1a3-3b2f-a166-611bddfaa834",
                                        "glosses": [
                                            "To nullify"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0508c47b-a28b-46c2-aa96-42e019ac4a87",
                                                "sense_id": "99ef21a3-ab40-30bf-b3d4-5dbea6928cda",
                                                "text": "The escheators […] defeated the right heir of his succession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb4b442b-1a01-3e54-9d19-1cf0d9a37e85",
                                        "entry_id": "4ab93c1e-a1a3-3b2f-a166-611bddfaa834",
                                        "glosses": [
                                            "To prevent (something) from being achieved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ed314a-ded0-460f-b595-8687b0f80846",
                                                "sense_id": "cb4b442b-1a01-3e54-9d19-1cf0d9a37e85",
                                                "text": "The last active L.Y.R. 0-6-0ST (apart from works shunters), No. 51408, has been moved from Bolton to Agecroft for use in New Bailey Yard, Salford, where a sharp 1 in 27 curve is said to have defeated all attempts so far to employ diesel shunters; an ex-L.Y.R. 0-4-0ST also works here."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "defeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4804545-9896-3179-a508-246694f531d5",
                                        "entry_id": "ec894b2b-dee9-333d-921f-019a458b0729",
                                        "glosses": [
                                            "The act or instance of being defeated, of being overcome or vanquished; a loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec29fca-237f-431c-9eca-23230363d90b",
                                                "sense_id": "c4804545-9896-3179-a508-246694f531d5",
                                                "text": "Licking their wounds after a temporary defeat, they planned their next move."
                                            },
                                            {
                                                "example_id": "e9cc04c6-5082-4340-a038-f5b9dc734de0",
                                                "sense_id": "c4804545-9896-3179-a508-246694f531d5",
                                                "text": "Two defeats in five games coming into this contest, and a draw with Everton, ultimately cost Sir Alex Ferguson's side in what became the most extraordinary finale to the league championship since Arsenal beat Liverpool at Anfield in 1989."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99c335f1-5ffa-3429-8fc4-b09b25efad7e",
                                        "entry_id": "ec894b2b-dee9-333d-921f-019a458b0729",
                                        "glosses": [
                                            "The act or instance of defeating, of overcoming, vanquishing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32d02e5-1ccc-4507-b132-e8e626a26b12",
                                                "sense_id": "99c335f1-5ffa-3429-8fc4-b09b25efad7e",
                                                "text": "The inscription records her defeat of the country's enemies in a costly war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb673fb-3a43-38d0-808d-a55bad83e1d1",
                                        "entry_id": "ec894b2b-dee9-333d-921f-019a458b0729",
                                        "glosses": [
                                            "Frustration (by prevention of success), stymieing; (law) nullification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a705dd62-d3bf-4ab0-9990-71f93b865bd6",
                                                "sense_id": "ecb673fb-3a43-38d0-808d-a55bad83e1d1",
                                                "text": "... is subsequently issued to him, in accordance with his perfect equity thus acquired, by a legal fiction which the law creates for the protection, but not for the defeat, of his title."
                                            },
                                            {
                                                "example_id": "e1e5acdf-4379-42fc-9ac5-4d0b4dd5f8cf",
                                                "sense_id": "ecb673fb-3a43-38d0-808d-a55bad83e1d1",
                                                "text": "She could see no justice in being forced into a position that promised to end in further humiliation and defeat of her hopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "271f9394-4f48-3bbc-bccc-168e62afda7e",
                                        "entry_id": "ec894b2b-dee9-333d-921f-019a458b0729",
                                        "glosses": [
                                            "Destruction, ruin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea8b67ec-7919-4f8c-a321-5a9db8e18772",
                                                "sense_id": "271f9394-4f48-3bbc-bccc-168e62afda7e",
                                                "text": "and made defeat of her virginity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d553466-8041-4d8f-96ee-21facd00b109",
                        "source_entry_id": "c1e34817-fdc1-3a90-b73f-7d3afb49f523",
                        "source_sense_id": "bb1e1f67-9eae-36ef-b9ff-e44d67c66082",
                        "source_sense_description": "het verlies van een strijd",
                        "target_lang_word": "défaite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défaite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47113a24-f4bc-3872-a9d7-f5bb72683edc",
                                        "entry_id": "b978fa7e-475c-3b60-ab6c-f0dd600690c5",
                                        "glosses": [
                                            "Déroute d’une armée ou de quelques troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2438b82c-34c2-4063-80e3-3a44b82ca37b",
                                                "sense_id": "47113a24-f4bc-3872-a9d7-f5bb72683edc",
                                                "text": "La terrible défaite de Sedan et l'invasion du territoire, en septembre 1870, mirent fin au régime impérial."
                                            },
                                            {
                                                "example_id": "9d9e29c1-1dfb-427a-9f32-520555f9fd3c",
                                                "sense_id": "47113a24-f4bc-3872-a9d7-f5bb72683edc",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir ; […]."
                                            },
                                            {
                                                "example_id": "68bad1a8-a304-4478-867b-0b02cb181b6b",
                                                "sense_id": "47113a24-f4bc-3872-a9d7-f5bb72683edc",
                                                "text": "Le relâchement du lien vassalitique est une des causes de la défaite finale du Midi et de son suzerain, le comte de Toulouse."
                                            },
                                            {
                                                "example_id": "39228ef4-1fba-41c1-88ca-772eeb65db05",
                                                "sense_id": "47113a24-f4bc-3872-a9d7-f5bb72683edc",
                                                "text": "Dans le passé, la longue série de défaites sous le coups de l'Europe chrétienne avait sapé le respect de soi chez le musulman; ce n'était pas seulement une défaite au sens terrestre, mais une défaite qui jetait le doute sur la vérité de la Révélation musulmane même et faisait perdre la confiance en soi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1acc474a-d2be-3822-879a-34910f3f793d",
                                        "entry_id": "b978fa7e-475c-3b60-ab6c-f0dd600690c5",
                                        "glosses": [
                                            "Facilité plus ou moins grande de se défaire de quelque chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
