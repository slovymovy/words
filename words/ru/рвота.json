    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                    "sense_definition": "непроизвольное извержение содержимого желудка через рот",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "физиологический процесс",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У пациента началась сильная <w>рвота</w> после употребления некачественных продуктов.",
                            "target_lang_translations": {
                                "en": "The patient began experiencing severe <w>vomiting</w> after consuming poor-quality food."
                            }
                        },
                        {
                            "text": "Врач спросил, сопровождается ли высокая температура тошнотой и <w>рвотой</w>.",
                            "target_lang_translations": {
                                "en": "The doctor asked if the high fever was accompanied by nausea and <w>vomiting</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "тошнота"
                    ],
                    "common_phrases": [
                        "сильная рвота",
                        "неукротимая рвота"
                    ],
                    "target_lang_definitions": {
                        "en": "The involuntary ejection of stomach contents through the mouth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vomiting",
                                "target_lang_sense_clarification": "The general medical and common term for the act of ejecting stomach contents."
                            },
                            {
                                "target_lang_word": "emesis",
                                "target_lang_sense_clarification": "A formal or clinical medical term for the act of vomiting."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                    "sense_definition": "масса, извергнутая из желудка",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "физиологический процесс",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На полу осталась <w>рвота</w>, которую пришлось срочно убрать.",
                            "target_lang_translations": {
                                "en": "There was <w>vomit</w> left on the floor that had to be cleaned up immediately."
                            }
                        },
                        {
                            "text": "Одежда была испачкана <w>рвотой</w> после приступа болезни.",
                            "target_lang_translations": {
                                "en": "The clothes were stained with <w>vomit</w> after the bout of illness."
                            }
                        }
                    ],
                    "synonyms": [
                        "блевотина"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное обозначение рвотных масс"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Matter that has been ejected from the stomach."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vomit",
                                "target_lang_sense_clarification": "The substance itself that has been vomited."
                            }
                        ]
                    }
                }
            ]
        }
