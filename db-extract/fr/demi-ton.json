                "senses": [
                    {
                        "sense_id": "240cc7a3-937e-3b2e-96f9-5def55994d8b",
                        "entry_id": "776f980f-d0e9-3305-9ace-89a743ea6e49",
                        "glosses": [
                            "Intervalle d'une valeur de la moitié d'un ton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa32d0b-e39e-49b8-bf18-dfa1684814bf",
                                "sense_id": "240cc7a3-937e-3b2e-96f9-5def55994d8b",
                                "text": "Le demi-ton est le plus petit intervalle employé dans la musique occidentale."
                            },
                            {
                                "example_id": "148f6743-649f-4b65-995e-4e1cafa8ce09",
                                "sense_id": "240cc7a3-937e-3b2e-96f9-5def55994d8b",
                                "text": "Max Roach raconte qu’en utilisant cette technique si caractéristique qui consiste à frapper deux notes voisines d’un demi-ton pour en relâcher l’une des deux une fraction de seconde après, Monk avait pour but d’imiter la torsion qu’un cuivre peut infliger à la justesse d’une note (pitch bend). Démarche passionnante, car nécessairement infructueuse : le piano étant un instrument tempéré, il est impossible d’en altérer la justesse sur un clavier."
                            }
                        ]
                    },
                    {
                        "sense_id": "a294ac29-d839-3128-b7fb-5733e8918c61",
                        "entry_id": "776f980f-d0e9-3305-9ace-89a743ea6e49",
                        "glosses": [
                            "Demi-teinte."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
