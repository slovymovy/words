                                        "entry_id": "dd206207-bba5-3298-8e18-2a39ad79fbc6",
                                        "glosses": [
                                            "A load of goods that is transported by any method (not just by ship)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9adff1de-96a1-4304-b436-5809419cc977",
                                                "sense_id": "a512059b-8952-3141-b379-f4bb1be86638",
                                                "text": "We're expecting another shipment of oranges tomorrow."
                                            },
                                            {
                                                "example_id": "4dd96dbf-8f89-4a5a-ae3b-27dfac44a64f",
                                                "sense_id": "a512059b-8952-3141-b379-f4bb1be86638",
                                                "text": "The United States paused a shipment of bombs to Israel amid concerns over their potential use in a Rafah incursion, Defense Secretary Lloyd Austin confirmed on Wednesday."
                                            },
                                            {
                                                "example_id": "e4cfd6a5-ee2c-4fe9-88b1-833616c29d8e",
                                                "sense_id": "a512059b-8952-3141-b379-f4bb1be86638",
                                                "text": "The de minimis exemption, as it’s known, allowed shipments of goods worth $800 or less to come into the United States duty-free, often more or less skipping time-consuming inspections and paperwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99cf0b6a-9e07-3145-8d99-68bf4017a8f1",
                                        "entry_id": "dd206207-bba5-3298-8e18-2a39ad79fbc6",
                                        "glosses": [
                                            "The act of transporting goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
