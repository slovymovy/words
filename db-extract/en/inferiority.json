                    },
                    {
                        "translation_id": "eb4ffd53-c9d5-4835-954b-c894928d6c6d",
                        "source_entry_id": "64b0f613-3f29-32da-82fa-d531f31d647b",
                        "source_sense_description": "quality of being inferior",
                        "target_lang_word": "inferioriteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inferioriteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "13bdc624-8b75-3d95-b903-317aaefc9b0e",
                                        "entry_id": "0d77e476-befb-3dc5-8879-ef03a6afdaa8",
                                        "glosses": [
                                            "van mindere waarde of kwaliteit zijnde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d09401-5db9-4103-a4b3-24a9027b57bf",
                                                "sense_id": "13bdc624-8b75-3d95-b903-317aaefc9b0e",
                                                "text": "Er werden duizenden foto's gemaakt die, voorzien van racistische bijschriften, op grote schaal in drukwerk onder de Duitse bevolking werden verspreid. Zo probeerde de overheid de Duitsers te overtuigen van de inferioriteit van de volken waarmee Duitsland in oorlog was."
                                            },
                                            {
                                                "example_id": "1ddc2eb4-4b8e-4fc1-a6c5-ac28c7368989",
                                                "sense_id": "13bdc624-8b75-3d95-b903-317aaefc9b0e",
                                                "text": "Ze zegt ook zelf dat het zinloos is om dingen te beweren over de superioriteit dan wel de inferioriteit van ‘de’ vrouw ten opzichte van ‘de’ man omdat hun nu eenmaal totaal verschillend zijn: ‘het is duidelijk dat de situatie van de man oneindig veel verkieslijker is, dat wil zeggen dat hij over veel concretere mogelijkheden beschikt om zijn vrijheid in de wereld te projecteren en uit te oefenen.’"
                                            },
                                            {
                                                "example_id": "b35eb782-bc6f-4bce-8712-99f0830bf14e",
                                                "sense_id": "13bdc624-8b75-3d95-b903-317aaefc9b0e",
                                                "text": "Het is veel vrolijker en verstandiger, zegt Rousseau, om een gevoel van eigenwaarde te hebben dat niet volledig afhangt van anderen. Niet wrokkig blijven hangen in de inferioriteit die je weerspiegeld ziet in de ogen van anderen, maar genoegen nemen met je zelf in al zijn beperktheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d627e3b7-7c1a-3c00-b33b-a294f58d12ca",
                                        "entry_id": "0d77e476-befb-3dc5-8879-ef03a6afdaa8",
                                        "glosses": [
                                            "van een lagere rang zijnde"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c623cf6e-e28b-43f0-9dd7-ba4563fbcde3",
