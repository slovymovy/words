                        ]
                    },
                    {
                        "translation_id": "24c1402f-e8e8-4c99-a851-ce4bffe36c78",
                        "source_entry_id": "82a1a01f-b66b-3466-9de9-33b540339f0a",
                        "target_lang_word": "dwang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                        "entry_id": "23fb092a-199d-3215-970a-6a7d57697b7d",
                                        "glosses": [
                                            "het uitoefenen van macht om iemand tegen diens wil iets te laten doen of laten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76297c29-8970-4f82-a658-288f8bac6b7b",
                                                "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                                "text": "De dictator heerste met veel macht en dwang over het geknechte volk, dat na vele jaren onderdrukking eindelijk in opstand kwam."
                                            },
                                            {
                                                "example_id": "9697a8a3-f982-407b-907e-399838318833",
                                                "sense_id": "b1fafec5-2c82-30d6-87a3-03f7807ad5bf",
                                                "text": "Het gerechtshof in Amsterdam heeft Keith Bakker woensdag in hoger beroep veroordeeld tot achttien maanden cel voor het verkrachten van een minderjarig meisje. Het OM eiste eind juni zes jaar cel en tbs met dwangverpleging, maar de straf viel fors lager uit. Volgens het hof is bewijs voor dwang in de relatie niet gevonden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3d90a5-87d1-305f-9283-b797770dc428",
                                        "entry_id": "23fb092a-199d-3215-970a-6a7d57697b7d",
                                        "glosses": [
                                            "ziekelijke neiging om bepaalde dingen te doen, zucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee8bc9e-0eb6-4c9a-889d-d5bbc8bb4b81",
                                                "sense_id": "fe3d90a5-87d1-305f-9283-b797770dc428",
                                                "text": "De vrouw poetste de hele dag haar schone huis, ze had dan ook een ziekelijke dwang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45aff8c6-d59d-49d7-83ef-e1d59c39dd77",
                        "source_entry_id": "82a1a01f-b66b-3466-9de9-33b540339f0a",
                        "target_lang_word": "onderdrukking",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderdrukking",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee401f0-39fe-3d86-afbb-a3cf2215991b",
                                        "entry_id": "251f4ec6-f638-3be0-b1bc-4b7ffcc32c82",
                                        "glosses": [
                                            "het geen rekening houden met iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29401d51-268a-4519-9a8a-dcaa5a6f758d",
                                                "sense_id": "8ee401f0-39fe-3d86-afbb-a3cf2215991b",
                                                "text": "Door onderdrukking van zijn gevoelens wist hij zijn vijand toch een hand te geven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66ab29da-b378-30e8-9002-1304e94c104b",
                                        "entry_id": "251f4ec6-f638-3be0-b1bc-4b7ffcc32c82",
                                        "glosses": [
                                            "repressie, mensen op een onrechtvaardige wijze in een minder machtige positie houden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b359424-b9b1-40d0-8dbd-ed54210fa95b",
                                                "sense_id": "66ab29da-b378-30e8-9002-1304e94c104b",
                                                "text": "‘Ik wou vrij zijn van onderdrukking en depressie [sic!]’, zegt ze aan ABC. ‘Ik wou onafhankelijk zijn. Ik zou nooit hebben kunnen trouwen met de persoon die ik koos. Ik kon geen job vinden zonder toestemming.’"
                                            },
                                            {
                                                "example_id": "34689c61-d78d-4eb0-bc3d-db7a640cf180",
                                                "sense_id": "66ab29da-b378-30e8-9002-1304e94c104b",
                                                "text": "Hij probeerde door wrede onderdrukking de baas te blijven maar uiteindelijk kwam er toch een revolutie."
                                            },
                                            {
                                                "example_id": "b6b44ab8-1dac-43a4-86d0-7bdbe99cbf81",
                                                "sense_id": "66ab29da-b378-30e8-9002-1304e94c104b",
                                                "text": "We kunnen alleen maar hopen dat ze goede aristocraten waren en geen schuld hadden aan de onderdrukking van het Franse volk, die terecht en uit noodzakelijkheid tot de Franse Revolutie leidde."
                                            },
                                            {
                                                "example_id": "2826ddf5-3a31-4ae4-abb3-c1502afb8e17",
                                                "sense_id": "66ab29da-b378-30e8-9002-1304e94c104b",
                                                "text": "Toen Eric jong was, waren alle goede films verboden voor kinderen en zo was het over het geheel genomen nog steeds, een onderdrukking die voor zover hij zich kon herinneren vooral hard aankwam op de leeftijd van twaalf jaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
