                    {
                        "translation_id": "e594a138-c2ae-4d93-9568-4d70401945ed",
                        "source_entry_id": "826da74c-cd94-309d-862b-738551b66a1e",
                        "source_sense_id": "c5be5437-bd3a-3acb-8748-fc16e6fb701a",
