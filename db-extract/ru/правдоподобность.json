                                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                                "text": "Cela choque la vraisemblance."
                                            },
                                            {
                                                "example_id": "58c8611d-fd0e-4df7-abd4-e9a513eb04ab",
                                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                                "text": "Contre toute vraisemblance."
                                            },
                                            {
                                                "example_id": "5e6b6dc3-1591-4d95-85a1-2bfcf51089d8",
                                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                                "text": "Malheureusement nous avons rarement des éléments suffisants pour reconstituer cette histoire avec vraisemblance. Les documents fossiles tertiaires sont assez rares […]."
                                            },
                                            {
                                                "example_id": "7877055d-d37f-4eef-bdaa-4531a9cc2ba8",
                                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                                            },
                                            {
                                                "example_id": "f799ab3c-04a2-4a91-93c6-067c73e2b88a",
                                                "sense_id": "4347dfc5-e813-39c2-8886-bd8d39c52ab8",
                                                "text": "Il n’y a pas de vraisemblance à ce que vous dites."
                                            }
                                        ]
                                    }
                                ]
                            }
