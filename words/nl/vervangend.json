                    "semantic_group_id": "substitutie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De school moest snel op zoek naar een <w>vervangende</w> leraar voor de zieke collega.",
                            "target_lang_translations": {
                                "en": "The school had to quickly look for a <w>substitute</w> teacher for the sick colleague."
                            }
                        },
                        {
                            "text": "Als je geen boter hebt, kun je een <w>vervangend</w> middel zoals olie gebruiken.",
                            "target_lang_translations": {
                                "en": "If you don't have butter, you can use a <w>replacement</w> such as oil."
                            }
