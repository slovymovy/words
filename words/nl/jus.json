{
    "word_family": [
        "juskom",
        "juslepel",
        "vleesjus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83ed7f6a-00e0-3ab8-876a-6f5b9dd4f75d",
                    "sense_definition": "Saus voor gerechten die wordt bereid uit het vocht dat uit vlees komt tijdens het braden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "saus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij goot een flinke lepel warme <w>jus</w> over de aardappelen en het vlees.",
                            "target_lang_translations": {
                                "en": "She poured a large spoonful of warm <w>gravy</w> over the potatoes and the meat.",
                                "ru": "Она налила большую ложку теплой <w>подливки</w> на картофель и мясо."
                            }
                        },
                        {
                            "text": "Deze vette <w>jus</w> smaakt heerlijk bij de stamppot die we vanavond eten.",
                            "target_lang_translations": {
                                "en": "This fatty <w>gravy</w> tastes delicious with the mash we are eating tonight.",
                                "ru": "Эта жирная <w>подливка</w> очень вкусна со стамппотом, который мы едим сегодня вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "vleesnat"
                    ],
                    "common_phrases": [
                        "vette jus",
                        "bruine jus",
                        "jus over de aardappels"
                    ],
                    "target_lang_definitions": {
                        "en": "A sauce for dishes prepared from the juices released by meat during roasting or frying.",
                        "ru": "Соус для блюд, приготовленный из сока, который выделяется из мяса во время жарки."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gravy",
                                "target_lang_sense_clarification": "sauce made from meat juices"
                            },
                            {
                                "target_lang_word": "sauce",
                                "target_lang_sense_clarification": "general term for a liquid accompaniment to food"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подливка",
                                "target_lang_sense_clarification": "соус из мясного сока"
                            },
                            {
                                "target_lang_word": "мясной сок",
                                "target_lang_sense_clarification": "жидкость, выделившаяся при жарке"
                            },
                            {
                                "target_lang_word": "соус",
                                "target_lang_sense_clarification": "общее название для жидкой приправы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3598dc-7d92-3d6b-a538-a1626f891386",
                    "sense_definition": "Een verkorte vorm van jus d'orange; het sap dat uit een sinaasappel is geperst.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het ontbijt drink ik altijd een glas verse <w>jus</w>.",
                            "target_lang_translations": {
                                "en": "At breakfast, I always drink a glass of fresh <w>orange juice</w>.",
                                "ru": "На завтрак я всегда выпиваю стакан свежевыжатого <w>сока</w>."
                            }
                        },
                        {
                            "text": "Wilt u bij de lunch een glas melk of liever een <w>jus</w>?",
                            "target_lang_translations": {
                                "en": "Would you like a glass of milk with lunch, or would you prefer an <w>orange juice</w>?",
                                "ru": "Вы бы хотели стакан молока на обед или скорее <w>апельсиновый сок</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "jus d'orange",
                        "sinaasappelsap",
                        "appelsiensap"
                    ],
                    "common_phrases": [
                        "verse jus",
                        "glas jus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used as a shorthand for orange juice"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A shortened form of 'jus d'orange'; the juice squeezed from an orange.",
                        "ru": "Сокращенная форма от 'jus d'orange'; сок, выжатый из апельсина."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "orange juice",
                                "target_lang_sense_clarification": "juice from oranges"
                            },
                            {
                                "target_lang_word": "OJ",
                                "target_lang_sense_clarification": "informal abbreviation for orange juice"
                            },
                            {
                                "target_lang_word": "juice",
                                "target_lang_sense_clarification": "general term for fruit liquid"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "апельсиновый сок",
                                "target_lang_sense_clarification": "сок из апельсинов"
                            },
                            {
                                "target_lang_word": "сок",
                                "target_lang_sense_clarification": "общий термин для фруктового напитка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab15c36e-3913-301f-a994-9d3d0176fd30",
                    "sense_definition": "Het geheel van rechtsregels of het recht in algemene zin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de rechtsgeleerdheid verwijst de term <w>jus</w> vaak naar het objectieve recht.",
                            "target_lang_translations": {
                                "en": "In jurisprudence, the term <w>jus</w> often refers to objective law.",
                                "ru": "В юриспруденции термин <w>право</w> часто относится к объективному праву."
                            }
                        },
                        {
                            "text": "De studenten bestudeerden de historische ontwikkeling van het <w>jus</w> civile.",
                            "target_lang_translations": {
                                "en": "The students studied the historical development of the <w>jus</w> civile.",
                                "ru": "Студенты изучали историческое развитие гражданского <w>права</w> (jus civile)."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal or academic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The body of legal rules or law in a general sense, often used in academic or Latin contexts.",
                        "ru": "Совокупность правовых норм или право в общем смысле, часто используется в академическом или латинском контексте."
                    },
                    "translations": {
