                "senses": [
                    {
                        "sense_id": "4e42faf9-82a8-3690-8a1b-525e8d50e4b4",
                        "entry_id": "3b015e28-8198-3262-8975-25d9980b9823",
                        "glosses": [
                            "The inhabitants at two points on the globe that share a longitude and for which the sum of their degrees of latitude equals zero."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b670891e-d623-4bc6-992e-ee96ed8e4940",
                                "sense_id": "4e42faf9-82a8-3690-8a1b-525e8d50e4b4",
                                "text": "Antœci are such as dwell under the same Meridian and the same Latitude or Parallel equally distant from the Æquator; the one northward, the other Southward; the days in both places being of a length; but the Summer of the one being the others winter."
                            },
                            {
                                "example_id": "63b708d7-514a-433c-94d7-e658e2512156",
                                "sense_id": "4e42faf9-82a8-3690-8a1b-525e8d50e4b4",
                                "text": "Antichthones…comprehend both the Antipodes and Antœci, or all beyond the Line[.]"
                            },
                            {
                                "example_id": "594325a4-75a0-4bfa-8322-1556c9b52177",
                                "sense_id": "4e42faf9-82a8-3690-8a1b-525e8d50e4b4",
                                "text": "Antœci…have their noon, or midnight, or any other hour at the same time; but their seasons are contrary, being spring to the one, when it is autumn with the other."
                            }
                        ]
                    }
                ],
