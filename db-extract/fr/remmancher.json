                ],
                "senses": [
                    {
                        "sense_id": "085d4e38-bf69-3af9-9479-43fcde3353ea",
                        "entry_id": "7390fbf3-fb5b-3829-8594-83d282b9635d",
                        "glosses": [
                            "Emmancher de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6aae853-1b35-4011-97fd-678fe8784e85",
                                "sense_id": "085d4e38-bf69-3af9-9479-43fcde3353ea",
                                "text": "Mes arrière-grands-pères faisaient et réparaient toute la vannerie et la sacherie de la maison, entretenaient, raccommodaient, remmanchaient les outils, aiguisaient les lames, régnaient sur le bûcher et avec les jeunes garçons, me cousins et moi, approvisionnaient les feux."
                            },
                            {
                                "example_id": "27799586-6717-47d5-a451-34868e648f0c",
                                "sense_id": "085d4e38-bf69-3af9-9479-43fcde3353ea",
                                "text": "Remmancher une cognée."
                            }
                        ]
                    },
                    {
                        "sense_id": "8013aa2e-50cf-3a8a-9f31-19c7c52647f9",
                        "entry_id": "7390fbf3-fb5b-3829-8594-83d282b9635d",
                        "glosses": [
                            "Engager de nouveau, rajuster après une rupture."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ffe5ec26-8e38-4fe2-b8b8-01fb9a013c17",
                                "sense_id": "8013aa2e-50cf-3a8a-9f31-19c7c52647f9",
                                "text": "Elle était bien belle, mais maintenant, mon ange, tu es bien plus belle qu’elle… et le mariage avec Clotilde est si bien rompu, que rien ne pourra le remmancher, dit tout bas la duchesse à Léontine."
                            },
                            {
                                "example_id": "b402feab-0723-40ce-82be-d92cad80dd20",
                                "sense_id": "8013aa2e-50cf-3a8a-9f31-19c7c52647f9",
                                "text": "L’affaire se remmancha."
                            }
                        ]
                    }
