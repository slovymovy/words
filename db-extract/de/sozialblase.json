                "senses": [
                    {
                        "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                        "entry_id": "f9864044-3dce-3ac1-92ba-91763cb61bf7",
                        "glosses": [
                            "kleine Gruppe von Personen, die nur miteinander Kontakt haben"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0dd7d4da-abb5-4863-86fc-2e9b96fe8961",
                                "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                                "text": "„Eine Idee, die in einigen Ländern auch schon verwendet wird, ist die Idee einer \"Social Bubble\", das heißt eine Sozialblase.“"
                            },
                            {
                                "example_id": "c9985172-5d2c-4443-86ce-552be2fbb7e7",
                                "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                                "text": "„Die Reduzierung der Kontaktblase auf 5 Personen pro Haushalt ist nach Meinung des Virologen und interföderalen Sprechers von Covid-19, Steven Van Gucht, der Hauptgrund dafür, dass der Verlauf der Fälle nun kontrollierbar sei. ‚Wir sind mit der 15-Personen-Sozialblase zu weit gegangen.‘“"
                            },
                            {
                                "example_id": "38144409-3008-4743-9dd0-366183edba24",
                                "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                                "text": "„Die belgischen Lungenfachärzte wollen, dass die Sozialblase (die Anzahl Personen, mit der jeder Kontakt haben darf) wieder auf 10 Personen reduziert wird, bis es wieder weniger als 100 Infektionen pro Tag gibt.“"
                            },
                            {
                                "example_id": "6a81106a-222d-48c5-8d90-ca4e7efe5dfe",
                                "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                                "text": "„Halten Sie immer mindestens 1,5 m Abstand zu Personen, die nicht zu Ihrer Sozialblase gehören.“"
                            },
                            {
                                "example_id": "a6a1f1d2-e19b-4eb9-a8a7-cdd57037acaf",
                                "sense_id": "543404bc-202e-322e-a330-e38e39160174",
                                "text": "„Darüber hinaus hat der Nationale Sicherheitsrat festgelegt, dass die wöchentliche Sozialblase von 5 Personen in den nächsten vier Wochen einzuhalten ist. Das heißt: Jeder Haushalt darf fünf weitere Kontakte haben, die innerhalb dieses Zeitraums dieselben bleiben müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
