                    },
                    {
                        "translation_id": "7d1c28e5-1ed1-4b97-be56-71f89caa915a",
                        "source_entry_id": "1942c9e4-7d51-3d91-bf5c-117216efa6d5",
                        "source_sense_id": "cf59cf16-e22a-39a0-8c7a-11a5e23ccd62",
                        "source_sense_description": "A debauched or lecherous person",
                        "target_lang_word": "roué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bba29ab6-8698-3c59-a14b-8609366627e0",
                                        "entry_id": "148d5686-a90f-3817-8992-f1eb8ea36afb",
                                        "glosses": [
                                            "Qualifie le bois du cerf, lorsqu’il est serré et peu ouvert."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cda840a-d491-3330-9791-6f169bf7358b",
                                        "entry_id": "148d5686-a90f-3817-8992-f1eb8ea36afb",
                                        "glosses": [
                                            "Qui est sans principes, sans scrupules, dont la conduite est désordonnée."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35618d03-83fe-46ad-986c-a28ff3834805",
                                                "sense_id": "9cda840a-d491-3330-9791-6f169bf7358b",
                                                "text": "[…] la mère Paul était rouée et profitait des pièces qu’on lui remettait de temps en temps pour jurer qu’on avait dû se tromper en la gratifiant d’un jeton de bar."
                                            },
                                            {
                                                "example_id": "0be17a00-e52f-4ce8-9a66-c7aad7d9210a",
                                                "sense_id": "9cda840a-d491-3330-9791-6f169bf7358b",
                                                "text": "Commençons par les années d’après la joyeuse collaboration de la plupart des éditeurs français avec l’occupant nazi, quand les plus compromis et les plus faibles furent rachetés par plus roué ou plus gros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d03873-6fdf-35e1-afa2-4d72ad1c2d9b",
                                        "entry_id": "148d5686-a90f-3817-8992-f1eb8ea36afb",
                                        "glosses": [
                                            "Qui a subi le supplice de la roue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2c12f8-9b55-3ca7-b024-1b2a3644112c",
                                        "entry_id": "148d5686-a90f-3817-8992-f1eb8ea36afb",
                                        "glosses": [
                                            "Qui est rompu de fatigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c85305-3be3-47ed-aff5-23aebe7fd72d",
                                                "sense_id": "4e2c12f8-9b55-3ca7-b024-1b2a3644112c",
                                                "text": "Et aujourd’hui il était là, roué de fatigue et empli de peine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d6c5b9-8617-302e-882b-ce526a4a7778",
                                        "entry_id": "7349397a-74ac-3601-b093-cdb7f300330e",
                                        "glosses": [
                                            "Condamné au supplice de la roue."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7651a5c6-4fe7-3aeb-9dbd-aec5ec8eb11d",
                                        "entry_id": "7349397a-74ac-3601-b093-cdb7f300330e",
                                        "glosses": [
                                            "Celui qui est sans principes, dont la conduite est désordonnée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e46eda-7765-4388-8a49-127f20455f0f",
                                                "sense_id": "7651a5c6-4fe7-3aeb-9dbd-aec5ec8eb11d",
                                                "text": "N’y avait-il pas pour elle quelque chose d’épouvantable à rencontrer un roué dans l’homme que Moïna écoutait avec plaisir ?"
                                            },
                                            {
                                                "example_id": "e9582ffd-7f24-4ba6-97fd-a7f8f529fa07",
                                                "sense_id": "7651a5c6-4fe7-3aeb-9dbd-aec5ec8eb11d",
                                                "text": "Nous étions une bande d’effrontés, de jeunes roués (entre seize et dix-neuf ans) qui mettions notre honneur à tout oser en fait d’indiscipline et d’insolence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0fd2480-aa2b-3202-b837-866704aba0fd",
                                        "entry_id": "7349397a-74ac-3601-b093-cdb7f300330e",
                                        "glosses": [
                                            "Homme peu scrupuleux sur les moyens en politique, en affaires, etc."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47486258-f80e-3cd7-8a6b-80e19769cac4",
                                        "entry_id": "7349397a-74ac-3601-b093-cdb7f300330e",
                                        "glosses": [
                                            "Nom qui fut donné aux compagnons de plaisir de Philippe d’Orléans, le régent de France."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16710134-1c47-4923-9d6d-e384d585d263",
                                                "sense_id": "47486258-f80e-3cd7-8a6b-80e19769cac4",
                                                "text": "Voltaire était jaloux de l’esprit d’un roué que Paris admira deux jours […]"
                                            },
                                            {
                                                "example_id": "f6fe30e0-efff-4092-b246-7de45d2f45af",
                                                "sense_id": "47486258-f80e-3cd7-8a6b-80e19769cac4",
                                                "text": "Dans un carrosse qui conduisit le prince et ses « roués » pour un souper à Saint-Cloud, l’un d’eux voulut savoir ce qu’il fallait penser du bruit qui courait […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1338f59f-97e1-3f10-afdc-316e7af72790",
                                        "entry_id": "9acf3722-3962-37be-a6ca-0ed38d114988",
                                        "glosses": [
                                            "Participe passé masculin singulier de rouer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
