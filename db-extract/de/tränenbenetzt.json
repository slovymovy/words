                "senses": [
                    {
                        "sense_id": "3e287530-b8ec-3574-8d3e-1200c9e2c1ad",
                        "entry_id": "29be8a2d-32d7-35ec-aa4e-51221c96254e",
                        "glosses": [
                            "von Tränen benetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9978a1a-ba7b-4375-a146-5b624085ed78",
                                "sense_id": "3e287530-b8ec-3574-8d3e-1200c9e2c1ad",
                                "text": "„Während Scham und Wut in seinen tränenbenetzten Wangen brannten, flog seine andere Hand zum Mund, und er fing an, fieberhaft an seinem Daumen zu lutschen.“"
                            },
                            {
                                "example_id": "7c218655-268f-4c3b-823b-79c3f91b52f0",
                                "sense_id": "3e287530-b8ec-3574-8d3e-1200c9e2c1ad",
                                "text": "„Fern von Radio, Auspuff und Motorgeratter hörte er Donner über die tränenbenetzten Hügel rollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
