                                        "sense_id": "9ddf391c-628c-309b-9e10-476e489fcf24",
                                        "entry_id": "df9b12bc-725e-3480-9173-1beafc683358",
                                        "glosses": [
                                            "die kleinasiatische Region Lykien und/oder die Lykier betreffend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99970700-3934-4d9a-bdff-2145211dac2f",
                                                "sense_id": "9ddf391c-628c-309b-9e10-476e489fcf24",
                                                "text": "Er bewundert die lykische Kunst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46e18e5e-c8e4-319e-aeac-f7516b4e3a5d",
                                        "entry_id": "df9b12bc-725e-3480-9173-1beafc683358",
                                        "glosses": [
                                            "zu der Sprache der Lykier (Lykisch) gehörig, in dieser Sprache verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd579afc-d829-485c-9ff9-a5ccf6c3fb6f",
                                                "sense_id": "46e18e5e-c8e4-319e-aeac-f7516b4e3a5d",
                                                "text": "Sie untersucht lykische Inschriften."
                                            },
                                            {
                                                "example_id": "5e42682b-f925-4feb-bb80-44342503b8a5",
                                                "sense_id": "46e18e5e-c8e4-319e-aeac-f7516b4e3a5d",
                                                "text": "Die Bedeutung dieses lykischen Wortes ist umstritten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
