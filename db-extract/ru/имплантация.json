                                                "sense_id": "a69e0684-816a-3e77-8eaf-0d4ca645d327",
                                                "text": "Aucune découverte préhistorique n'a été signalée à Sauvagny, sans doute par absence de prospection de ce terroir, de la vallée de l’Œil et de ses affluents, aux terrains légers qui, pourtant, conviennent à l’implantation d’habitats."
                                            },
                                            {
                                                "example_id": "e766011e-9dfe-422a-8811-0f57fcc48134",
                                                "sense_id": "a69e0684-816a-3e77-8eaf-0d4ca645d327",
                                                "text": "C’est en fait interdire la destruction de l’idéologie bourgeoise et l'implantation de l’idéologie prolétarienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "099ce257-c396-30b0-8365-808e13f900b7",
                                        "entry_id": "1d04db7c-4ccd-37f3-811d-b3c26028bb32",
                                        "glosses": [
                                            "Mise en œuvre, réalisation, implémentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97ae02f-0660-42d3-8e7d-566f11605b2a",
                                                "sense_id": "099ce257-c396-30b0-8365-808e13f900b7",
                                                "text": "Ceci est une implantation simple des arbres binaires de recherche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
