                "senses": [
                    {
                        "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                        "glosses": [
                            "Fil d’or ou d’argent torsadé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eba7282-6a6d-4d31-8c7a-161fb9af171c",
                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                "text": "Il y avait dans sa coiffure, des roses artificielles et des ornements en cannetille dédorée qui lui donnaient l’air d’une poupée."
                            },
                            {
                                "example_id": "e7a6746d-9d03-4adf-8d27-e897cac2bfa1",
                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                "text": "Les feuilles longues et minces, faites de paillettes cousues chacune avec un brin de cannetille, retombaient en une pluie d’étoiles."
                            },
                            {
                                "example_id": "85e607ad-6c3e-4d0e-b1db-ac1f55a2c2a6",
                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                "text": "Dans ses chenaux pleins de cannetille, l’Erdre laissait fluer un sirop pour têtards et se découvrir peu à peu le chevelu des souches ancrées de biais sur ses bords."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a111feb-7bd3-3233-bbbf-890f1f5a5da1",
                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                        "glosses": [
                            "Fil de laiton argenté entouré en spirale sur un boyau pour former les grosses cordes de violons, violoncelles, contrebasses."
                        ],
                        "tags": [
                            "Lutherie"
                        ],
                        "examples": [
                            {
                                "example_id": "a0666a09-6698-41a0-8cd4-899b27d11751",
                                "sense_id": "7a111feb-7bd3-3233-bbbf-890f1f5a5da1",
                                "text": "Cordes à canetille d'argent"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9c655d-2739-311b-a206-9f9ade116871",
                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                        "glosses": [
                            "Tissu de fil de laiton que les chapeliers utilisent pour mettre en forme les chapeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ac69ea-b543-41fa-8617-d44f126d855a",
                                "sense_id": "6c9c655d-2739-311b-a206-9f9ade116871",
                                "text": "Même pour une Aielle, elle était très grande – peut-être plus que lui – et arborait une chevelure évoquant la cannetille et des yeux d’un bleu céruléen."
                            }
                        ]
                    }
