                        "source_sense_id": "d963e51f-56d8-338b-a302-ad1f77c37171",
                        "source_sense_description": "een negatief gevoel veroorzaakt doordat iemand iets heeft of kan krijgen wat je ook wilt hebben of reeds hebt",
                        "target_lang_word": "eifersüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eifersüchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                        "entry_id": "8a2b5d3b-16f1-3a91-97d3-7a4ff50d45b2",
                                        "glosses": [
                                            "Eifersucht verspürend, von Eifersucht bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed4e333-6c37-421e-a86d-0ddf141e330e",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Ich bin nicht eifersüchtig, wie oft soll ich das noch sagen!"
                                            },
                                            {
                                                "example_id": "d7c75c0b-3f81-4c7d-a2ec-15b1579d6d16",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Ihr zweiter Mann ist noch eifersüchtiger als der erste."
                                            },
                                            {
                                                "example_id": "e896fa6a-e128-42c3-8fa9-3c7ee6871d71",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Die eifersüchtige Sekretärin verfolgte die Frau ihres Chefs."
                                            },
                                            {
                                                "example_id": "a6d2df9e-0ac4-449f-991e-6ffbe6aeb9fc",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Du bist doch nicht etwa eifersüchtig auf mich?"
                                            },
                                            {
                                                "example_id": "633fc52b-69c4-49a7-83da-b872a2a23f86",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "Eifersüchtig musterte sie ihre Rivalin."
                                            },
                                            {
                                                "example_id": "15b8d61a-3ed0-4092-9542-770b407cad41",
                                                "sense_id": "5d5f8c2b-fd91-3918-b2a3-4fe70b7895ce",
                                                "text": "„In seiner pompösen Hotelsuite in Los Angeles trank sich Johnny Fontane einen Rausch an, wie jeder andere eifersüchtige Ehemann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "444671ec-a680-4efe-a240-e3322ebdba07",
                        "source_entry_id": "4fda28a6-e44d-335e-94d9-a64b45158ca2",
                        "source_sense_id": "d963e51f-56d8-338b-a302-ad1f77c37171",
                        "source_sense_description": "een negatief gevoel veroorzaakt doordat iemand iets heeft of kan krijgen wat je ook wilt hebben of reeds hebt",
                        "target_lang_word": "jealous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jealous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Suspecting rivalry in love; troubled by worries that one might have been replaced in someone's affections; suspicious of a lover's or spouse's fidelity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17584d40-0e0d-4f96-9f3f-b15a20216bda",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "jealous rage"
                                            },
                                            {
                                                "example_id": "cf218791-c704-407b-b015-0913c4173608",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "jealous lover"
                                            },
                                            {
                                                "example_id": "17db4c8c-0401-47d8-876c-6c2b8af97de8",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "She gave him a jealous look."
                                            },
                                            {
                                                "example_id": "304471a8-b8b1-4621-9175-7da4c4d6133e",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "She stopped, and laid her hand upon his golden head, and then bent down and kissed his brow with a chastened abandonment of tenderness that would have been beautiful to behold had not the sight cut me to the heart - for I was jealous!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Protective; zealously guarding; careful in the protection of something (or someone) one has or appreciates, especially one's spouse or lover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd1bc68-7b31-46b9-bf20-43253584cfd4",
                                                "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                                "text": "Thou ſhalt not bow downe thy ſelfe to them, nor ſerue them: For I the Lord thy God am a iealous God, viſiting the iniquitie of the fathers vpon the children, vnto the thirde and fourth generation of them that hate me:"
                                            },
                                            {
                                                "example_id": "3280419a-78a0-42d8-8966-97bee94b6a40",
                                                "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                                "text": "Soft Simon had reduced himself to the lowest class of Stalkos, or walking gentlemen, as they are termed; men who have nothing to do, and no fortune to support them, but who style themselves esquire; and who […] are jealous of that title, and of their claims to family antiquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Envious; feeling resentful or angered toward someone for a perceived advantage or success, material or otherwise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d13f98e-a051-46e1-b851-d7c3587a7368",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "be jealous of someone/something"
                                            },
                                            {
                                                "example_id": "b3a042e8-1f38-47b3-80c5-fbdf12333a24",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "He was jealous of his friend’s success."
                                            },
                                            {
                                                "example_id": "e4c3a00e-58e7-4b58-9c34-346fab6c9eae",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "I'm jealous because I'm single."
                                            },
                                            {
                                                "example_id": "85c0c2bb-6b35-4ced-9dd8-c1e695ce227c",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "I am jealous of everything whose beauty does not die."
                                            },
                                            {
                                                "example_id": "0570d788-016b-461f-abf8-e327798c18ab",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "The neighbouring towns were jealous of this honourable supremacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Suspicious; apprehensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5d6f9b-8d26-48c5-8f29-a966e7f30b55",
                                                "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                                "text": "I began my fence or wall; which, being still jealous of my being attacked by somebody, I resolved to make very thick and strong."
                                            },
                                            {
                                                "example_id": "ee7cb869-5bdb-4194-8620-a879687fcd86",
                                                "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                                "text": "At length […] the Duke demanded to know of Durward who his guide was, […] and wherefore he had been led to entertain suspicion of him. To the first of these questions Quentin Durward answered by naming Hayraddin Maugrabin, the Bohemian; […] and in reply to the third point he mentioned what had happened in the Franciscan convent near Namur, how the Bohemian had been expelled from the holy house, and how, jealous of his behaviour, he had dogged him to a rendezvous with one of William de la Marck's lanzknechts, where he overheard them arrange a plan for surprising the ladies who were under his protection."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jealous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                        "entry_id": "65ffdda7-dc40-3033-95d4-b40d1f559eff",
                                        "glosses": [
                                            "To harass or attack (somebody) out of jealousy."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ceeda6f-3ed9-4777-b4b9-7bc5670a7dd3",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "If I go back, he starts his jealousing again. Drinking and jealousing."
                                            },
                                            {
                                                "example_id": "3bea9587-58b6-4b62-9230-8bb5d4dac65c",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "Jealousing can take place: You may notice some of your fellow female co-workers that can be jealousing you."
                                            },
                                            {
                                                "example_id": "a4815039-27d1-4011-81d1-a725096ed583",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "But another part of me is jealousing because Xifeng is looking at Ify like she is special, almost like she is wanting to call her daughter, and I am wanting Xifeng all to myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403fab52-26e6-38f1-b9b3-7431525599dd",
                                        "entry_id": "65ffdda7-dc40-3033-95d4-b40d1f559eff",
                                        "glosses": [
                                            "To deliberately make (someone) jealous of another person's (often their partner's) associations with other people."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbba0190-48d3-4291-82cb-b26b3b5cd0c6",
                                                "sense_id": "403fab52-26e6-38f1-b9b3-7431525599dd",
                                                "text": "[…] where the victim of an assault had been 'jealousing' the offender about her sister."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a5e60b4-5879-47d5-ac23-604eb0f74562",
                        "source_entry_id": "4fda28a6-e44d-335e-94d9-a64b45158ca2",
                        "source_sense_id": "d963e51f-56d8-338b-a302-ad1f77c37171",
                        "source_sense_description": "een negatief gevoel veroorzaakt doordat iemand iets heeft of kan krijgen wat je ook wilt hebben of reeds hebt",
                        "target_lang_word": "jaloux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaloux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui éprouve une envie se manifestant par le désir qu'une personne bénéficiant d'une situation perçue comme meilleure à la sienne perde son avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4315cf94-a187-4570-8656-16362d2ac8a1",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "La mort jalouse semblait vouloir que rien ne survécût de la jeune fille, pas même son image."
                                            },
                                            {
                                                "example_id": "7728ff91-b0ab-4a23-a427-0d0aa0fbe59b",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune. La richesse des Roudier et des Granoux exaspérait Aristide au point de lui faire perdre toute prudence. Poussé par ses aigreurs jalouses d’affamé, il s’était fait de la bourgeoisie une ennemie irréconciliable, lorsque l’arrivée d’Eugène et la façon dont il se comporta à Plassans vinrent le consterner."
                                            },
                                            {
                                                "example_id": "7f28db41-2dca-4316-8e96-b4adaaea007e",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "Le neveu du cheikh Gaafar, qui, tout jeune homme avait lorgné avec une admiration jalouse l’épouse de son oncle, s’enhardit jusqu’à demander sa main."
                                            },
                                            {
                                                "example_id": "8307573e-e802-404d-9949-499f1b8bfdf4",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "Il était jaloux. Comment peut-on être jaloux de quelqu'un qui n'a rien à voir avec vous? Parce qu'on est un jaloux . Toute gloire lui était une usurpation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui éprouve un agacement plus ou moins prononcé causé par le sentiment qu'une personne qu'on aime, aime elle-même — ou pourrait aimer — une autre personne, ou seulement en soit approchée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db654c79-0084-441e-9277-e3a0664d8066",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Si Titus est jaloux, Titus est amoureux."
                                            },
                                            {
                                                "example_id": "8a9f32a8-b0c1-4a79-9a3f-bfee8bbce14b",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Jalouse !… Je suis jalouse de tout ce qui t’approche. Pour que tes robes ne t’aient pas seule, je les mets quand tu les as portées."
                                            },
                                            {
                                                "example_id": "7f8f87ed-69c3-4b36-9263-c92ff4fe06ae",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Il fallait me dire : « Tu vois, tous ces hommes ont à toi… », me laisser rêver que le monde entier m’appartenait, mais tu as refermé tes bras jaloux sur tout mon avenir, et je n’ai pas voulu, je n’ai pas pu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui tient beaucoup, qui est fort attaché à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8874782f-ce5e-48b5-b0b6-555bfa3275d5",
                                                "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                                "text": "L’esprit républicain, jaloux à l’excès de sa liberté, prend ombrage de tout ce qui peut lui donner des entraves et se révolte contre la seule idée d’un maître."
                                            },
                                            {
                                                "example_id": "06cd1e39-f9a1-40c2-bfed-22382137e55d",
                                                "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                                "text": "Il est jaloux du bâton de commandement qu’il tient dans sa main tremblante, et il sait bien que votre poing vigoureux est là pour l’étreindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f43aeb9-0102-3921-8273-82529c01b0b5",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui a à cœur, qui est très désireux de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175a87d7-7eaa-4415-a46c-c3b6251cb654",
                                                "sense_id": "3f43aeb9-0102-3921-8273-82529c01b0b5",
                                                "text": "Je suis jaloux d’acquérir, de conserver votre estime. Je suis jaloux de vous prouver le désir que j’ai de vous servir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22790053-7836-3ce2-b969-dd4aac637357",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qualifie un vaisseau qui roule énormément."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3288c0c0-7791-4aec-bb42-8188463c6654",
                                                "sense_id": "22790053-7836-3ce2-b969-dd4aac637357",
                                                "text": "La mauvaise galère qui roulait bord sur bord était jalouse, ne portait pas bien la voile et ne sentait pas la mer, tandis que la galère bien équilibrée était en estive, fine de voiles et s’abrivait à plaisir (elle conservait sa vitesse initiale — Zysberg — ), quand elle avait perdu son erre, elle était morte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
