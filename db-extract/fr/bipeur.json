                                                "sense_id": "dc58971f-bab8-3273-b5f1-8d5cee880180",
                                                "text": "Die Pieper sind schwer zu unterscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f714354-7402-3c43-b78a-12001a79fc02",
                                        "entry_id": "ae63647b-f648-3879-8c06-02cfc8dab804",
