        "nl-extract.jsonl": [
            {
                "entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                "word": "ineens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                        "entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                        "glosses": [
                            "snel en onverwachts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb233b2-4bdc-4f21-a7ca-8b76c9bb5116",
                                "sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                                "text": "Ineens schoot het antwoord op die vraag me te binnen."
                            },
                            {
                                "example_id": "ca203c53-8eb5-4222-889e-d7855b09f750",
                                "sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                                "text": "Tot mijn verbazing wist ik deze zes weken durende tocht zonder noemenswaardige problemen te voltooien, waardoor ik voor het eerst echt begon te geloven dat mijn ‘American Dream’ wel eens in vervulling zou kunnen gaan. En zo was ik ineens klaar voor de moeder aller tochten, de PCT."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77c4f6df-7ff9-4868-96b8-0fa3ce62764d",
                        "source_entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                        "source_sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                        "source_sense_description": "snel en onverwachts",
                        "target_lang_word": "plötzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plötzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                        "entry_id": "c73bb506-ab8d-352d-bea5-febb8093ff05",
                                        "glosses": [
                                            "unerwartet, überraschend, auf einen Schlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe462d18-3e11-4cea-a2fa-3e86ec9a388d",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Plötzlich hörte der Motorflieger auf zu kreisen. In eine ganz andere Richtung ging es auf einmal.“"
                                            },
                                            {
                                                "example_id": "58ce6522-464f-4631-bc76-66fa3aa3b039",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Plötzlich kam ein alter Mann in den Laden."
                                            },
                                            {
                                                "example_id": "77ac4a65-d7bc-4919-9c01-d2f09eb7f8b9",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Was soll denn dieser plötzliche Aufbruch?"
                                            },
                                            {
                                                "example_id": "46522f9e-ef96-4047-a682-d1a8c0fd3d90",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Mein Vater ist ganz plötzlich gestorben."
                                            },
                                            {
                                                "example_id": "91a330df-bb50-473d-a752-beed10e2de7f",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Eine plötzliche Vertragskündigung durch Yahoo beendete laut dem Verein die Geschäftsbeziehung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d8a22c-80db-4ee3-aa3e-15962221b5ee",
                        "source_entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                        "source_sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                        "source_sense_description": "snel en onverwachts",
                        "target_lang_word": "at once",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at once",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "In one group; together."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e22d8c-067f-4baa-bd64-cd32c42387ad",
                                                "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                                "text": "And they all atonce begane to make excuſe. The fyrſt ſayd vnto him: I have bought a ferme / and I muſt nedes goo and ſe it / I praye the have me excuſed."
                                            },
                                            {
                                                "example_id": "1f905b37-eaee-4b65-b469-0917af10af90",
                                                "sense_id": "06ea4d6c-432a-3bc4-a17a-19f4979ce2d4",
                                                "text": "Those two great champions did attonce pursew / The fearefull damzell with incessany payns [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "At the same time; simultaneously; together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4eb593-5673-40e6-bb82-78c8011ec62f",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "Can you pat your head and rub your belly at once?\nHe tried to eat four cookies at once."
                                            },
                                            {
                                                "example_id": "8fd9ad29-e2bf-43ba-bf87-49ac73eaadb4",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            },
                                            {
                                                "example_id": "f0f5dd7c-071c-48a2-9cc6-8e7d41df7f94",
                                                "sense_id": "9a6f195c-6c00-3d23-997e-7afe3d953f1a",
                                                "text": "[T]he book, constructed in short, lucid episodes, can be satisfyingly read as a sequence of provocative talks, at once well informed and vatic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                        "entry_id": "69f8f84f-8edd-3934-948c-f1ef14e5b8df",
                                        "glosses": [
                                            "Immediately; now; right away."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783646a3-8604-494b-a7e7-ec0659660b36",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Tell the doctor to come at once. She is having a baby."
                                            },
                                            {
                                                "example_id": "de052e0a-985f-44f2-a01f-8fe7f0578c51",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "0a639dff-9803-4e48-bdd0-575b4b2b3bd5",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "95014966-2f63-45be-b6a5-3759f5549751",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "Sparks from the derailed bogie of the train were first noticed by the signalman at Slough West box, who immediately sent to Slough Middle box the \"Stop and Examine\" signal, followed at once by \"Obstruction Danger\" when he realised that the coach was derailed."
                                            },
                                            {
                                                "example_id": "12eadae3-3e25-40ba-995b-4cb626a419a5",
                                                "sense_id": "552397ca-7289-363b-a8c1-5cd4213d0ef1",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "934b88a4-6236-4882-9c3f-92a6452e727f",
                        "source_entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                        "source_sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                        "source_sense_description": "snel en onverwachts",
                        "target_lang_word": "suddenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                        "entry_id": "b4602e66-3e9c-3a64-b1ba-c57b0f38c649",
                                        "glosses": [
                                            "Happening quickly and with little or no warning; in a sudden manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6e4ae1-a56b-4ffc-ad0e-daf126075dae",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "Suddenly, the heavens opened and we all got drenched."
                                            },
                                            {
                                                "example_id": "4b0aeef6-4f88-446a-9597-009ef96f1f4e",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "They've suddenly decided to sell the house."
                                            },
                                            {
                                                "example_id": "3063b5d4-74b7-4262-8a9e-66623a1457a3",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "The king before he would take his voyage, sent the Erle of Huntyngdon to ſerche and ſcowre the Seas, leaſt any Frenchmen lyeng in wayte for him might attrap him sodeinly, or he had any knowledge of their ſetting forward."
                                            },
                                            {
                                                "example_id": "f0e96555-43e8-4e9d-bdbf-8a130168d0d6",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29c1f565-ba2b-44f3-a73d-f003d698bab4",
                        "source_entry_id": "1aa94005-a0d6-3712-aeae-bf0dbeb76918",
                        "source_sense_id": "8b25a07f-2890-3f35-92b1-fb54045fa892",
                        "source_sense_description": "snel en onverwachts",
                        "target_lang_word": "tout à coup",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout à coup",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                        "entry_id": "1fb29ead-7e5a-3746-97ac-5feb1362745a",
                                        "glosses": [
                                            "Soudainement ; en un moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863485e7-402c-4a5f-968a-ed6d983c258c",
                                                "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                                "text": "En effet, un type en casquette traversa tout à coup la rue et vint prévenir qu’on pouvait y aller."
                                            },
                                            {
                                                "example_id": "763962d7-2758-4490-b873-0984b08c072f",
                                                "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                                "text": "J’ai rêvé d’un ironiste qui, un beau jour, tout à coup, perdait son ironie."
                                            },
                                            {
                                                "example_id": "3576827e-a103-4dcd-a824-784f5e748c58",
                                                "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                                "text": "Les terribles prêcheurs des Seize, les moines qui portaient le mousquet aux processions de la Ligue, s’humanisent tout à coup ; les voilà devenus bénins. C'est qu’il faut bien essayer d’endormir ceux qu’on n’a pas pu tuer."
                                            },
                                            {
                                                "example_id": "befb721c-7770-44b9-8b7e-ade5645382cc",
                                                "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                                "text": "Tout à coup, dominant les mornes intonations du célébrant, s’éleva la voix de Villegagnon."
                                            },
                                            {
                                                "example_id": "3cd06537-e025-4774-b513-a885507317e1",
                                                "sense_id": "065ac006-91d9-3af2-aedc-f86cd0efafa8",
                                                "text": "Et une vérité beaucoup plus cruelle le frappa tout à coup. Le géant avait épargné Ouma Nandi jusqu’à son entrée en scène calamiteuse. Qu’en aurait-il été s’il n’avait pas tiré en l’air ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
