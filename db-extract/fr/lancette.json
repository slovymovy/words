        "fr-extract.jsonl": [
            {
                "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                "word": "lancette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc10a693-a267-4b5d-b7d8-6d4a00651dc2",
                        "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "tags": [
                            "plural"
                        ],
                        "form": "lancettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0cda338-6681-36a3-a34d-a94133fd5932",
                        "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "glosses": [
                            "Petite lance."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "90489d24-082e-4b39-a02e-a93f08312273",
                                "sense_id": "c0cda338-6681-36a3-a34d-a94133fd5932",
                                "text": "Je doute si les chevaux de bois d'aujourd'hui ont encore ces petits distributeurs qui offraient à notre adresse des petits anneaux de métal qu'il s'agissait, en passant, d'enfiler avec une lancette de bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                        "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "glosses": [
                            "Instrument de chirurgie servant à ouvrir une veine, à percer un abcès, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02de7ca2-f6f2-42e2-b31e-dcbbd415d95e",
                                "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                                "text": "Il avait même sorti de sa poche une lancette et allait le saigner, quand le juif se ranima tout à coup."
                            },
                            {
                                "example_id": "6bda3e16-bcac-4940-b133-e27d730249db",
                                "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                                "text": "Pierre.– Un bon coup de lancette guérit tous les maux.\nPhilippe.– Guérir ! guérir ! Savez-vous que le plus petit coup de lancette doit être donné par le médecin ? Savez-vous qu’il faut une expérience longue comme la vie, et une science grande comme le monde, pour tirer du bras d’un malade une goutte de sang ?"
                            },
                            {
                                "example_id": "8ff4d58a-4229-4e1d-95c2-7618711248b3",
                                "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                                "text": "Bouland prit sa lancette, me la posa sur une veine du cou, la frappa d’un petit coup de marteau, et le sang jaillit aussitôt."
                            },
                            {
                                "example_id": "bf98e21c-6fd8-43dd-975b-2a4f9c242f64",
                                "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                                "text": "Maître Ambroise Paré, qui procéda le premier à la ligature des artères et qui, ayant trouvé la chirurgie exercée par des barbiers empiriques, l’éleva à la hauteur où elle est aujourd’hui, fut attaqué dans sa vieillesse par tous les apprentis porte-lancette."
                            },
                            {
                                "example_id": "b4363dfb-8967-4b93-bfdc-1d2ddaaf5db7",
                                "sense_id": "ec4a7dc8-13c9-3f4e-b795-038d445751b6",
                                "text": "Vous savez ce qu'a dit Byron ? « La lancette a tué plus de gens que la lance... »\n— Ah, il a dit ça, cet amoureux des onze mille vierges ? A-t-il un peu raison ?\n— Un peu. On saignait beaucoup de son temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "997ca2b5-7538-3787-8e2e-dea689bd7e93",
                        "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "glosses": [
                            "Ogive de style gothique de forme très allongée ; arc en tiers-point surhaussé, sa forme ressemble à l’extrémité d’un fer de lance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bb084d-ff85-4fca-a483-8d2840290e4a",
                                "sense_id": "997ca2b5-7538-3787-8e2e-dea689bd7e93",
                                "text": "La construction remonte au commencement du quatorzième siècle ; les ogives en lancette, la pureté des nervures, l'élégance et l'élancement des meneaux le prouvent suffisamment."
                            },
                            {
                                "example_id": "834c05a3-d737-4b7a-82c4-8f49c6a3aa08",
                                "sense_id": "997ca2b5-7538-3787-8e2e-dea689bd7e93",
                                "text": "En levant la tête, on aperçoit une espèce de dôme formé par l’intérieur de la tour dont nous avons déjà parlé ; c’est un gouffre de sculptures, d’arabesques, de statues, de colonnettes, de nervures, de lancettes, de pendentifs à vous donner le vertige."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5165563-f6ef-3a68-b69b-9222373999fe",
                        "entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "glosses": [
                            "Chacune des plumes tombantes de l'arrière-train du coq, situées juste avant la base de la queue et à l'arrière des ailes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae282429-7f84-4653-977b-1155f4124869",
                                "sense_id": "d5165563-f6ef-3a68-b69b-9222373999fe",
                                "text": "Les plumes de la queue du coq sont de deux types : les primaires, les faucilles, sont les deux grandes plumes recourbées ; les secondaires, les lancettes, sont les plumes tombantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d522649-3cc6-45ca-b216-1618f1af69b3",
                        "source_entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "target_lang_word": "Lanzette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lanzette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                        "entry_id": "0e5e7646-ee87-3f61-82b1-aa073ad82a5f",
                                        "glosses": [
                                            "medizinisches Gerät: kleines, zweischneidiges Messer oder Nadel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3e9087-ca2c-463e-817e-40b069baafcd",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Ich weiß nicht, was mich Halbtoten veranlaßte, die Augen zu öffnen; da sah ich den Mann mit der Lanzette, der dabei war, mir die Vene aufzustechen.“"
                                            },
                                            {
                                                "example_id": "e76c384a-28cb-45d0-98e4-7f0cdb7c8b97",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Nun legten sie großen Eifer für die Schutzpockenimpfung an den Tag, lernten an Kohlblättern zur Ader lassen und schafften sich sogar ein paar Lanzetten an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "828a88b2-929d-410d-a0a3-85a1999dded9",
                        "source_entry_id": "fd81c1a4-3df6-3dca-9a7d-78e5a81a9a60",
                        "target_lang_word": "lancet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lancet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b93c81-80d3-393f-8642-25908b2d02ab",
                                        "entry_id": "efbae5b1-b2df-36cb-a06e-a9e32f2ffcea",
                                        "glosses": [
                                            "A sharp, pointed, two-edged surgical instrument used in venesection and for opening abscesses etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0086bda8-0648-4cc1-b871-3989e2f17997",
                                                "sense_id": "f1b93c81-80d3-393f-8642-25908b2d02ab",
                                                "text": "With a lancet, Håkan drained the slow blue blood from his leg, always fearing to find pus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445f46f1-80b7-3c1a-89d0-575036246e05",
                                        "entry_id": "efbae5b1-b2df-36cb-a06e-a9e32f2ffcea",
                                        "glosses": [
                                            "A small, sterile single-use needle used to draw a drop of blood for testing, as with a glucometer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80ebcfc3-9e02-3d4f-9d11-461876bd9d80",
                                        "entry_id": "efbae5b1-b2df-36cb-a06e-a9e32f2ffcea",
                                        "glosses": [
                                            "An iron bar used for tapping a melting furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac77ebd1-feaf-3b20-a73f-664a17fa4be3",
                                        "entry_id": "efbae5b1-b2df-36cb-a06e-a9e32f2ffcea",
                                        "glosses": [
                                            "A high narrow window, terminating in an acutely pointed arch, common in Gothic architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b8a0576-fc97-4a85-9078-8e9e41a9f56a",
                                                "sense_id": "ac77ebd1-feaf-3b20-a73f-664a17fa4be3",
                                                "text": "He looked away, into the cavernous space emptying of people. Up in the galleries and behind the choir, the wide window lancets were sheets of black."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lancet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc672f7-ecfb-3412-835c-4925f63448fb",
