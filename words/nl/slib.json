    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dc3a14c-584c-3963-9d64-8808c7110276",
                    "sense_definition": "Fijne deeltjes van klei, leem of organisch materiaal die door water worden meegevoerd en zich op de bodem afzetten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sediment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de overstroming bleef er een dikke laag vruchtbaar <w>slib</w> achter op de akkers.",
                            "target_lang_translations": {
                                "en": "After the flood, a thick layer of fertile <w>silt</w> remained on the fields."
                            }
                        },
                        {
                            "text": "De haven moet regelmatig worden gebaggerd om het overtollige <w>slib</w> te verwijderen.",
                            "target_lang_translations": {
                                "en": "The harbor must be dredged regularly to remove the excess <w>silt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "modder",
                        "slik",
                        "sediment"
                    ],
                    "common_phrases": [
                        "vruchtbaar slib",
                        "laag slib"
                    ],
                    "target_lang_definitions": {
                        "en": "Fine particles of clay, loam, or organic material carried by water and deposited at the bottom."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silt",
                                "target_lang_sense_clarification": "fine sediment deposited by water"
                            },
                            {
                                "target_lang_word": "sludge",
                                "target_lang_sense_clarification": "thick, wet mud or waste"
                            },
                            {
                                "target_lang_word": "mud",
                                "target_lang_sense_clarification": "wet, soft earth"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e4495fb-abf9-3f31-9c61-819d98c690d4",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>slibben</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik de afvoer niet schoonmaak, <w>slib</w> ik langzaam dicht met vuil.",
                            "target_lang_translations": {
                                "en": "If I don't clean the drain, I slowly <w>clog</w> up with dirt."
                            }
                        },
                        {
                            "text": "Ik <w>slib</w> liever niet dicht door al die ongezonde vetten.",
                            "target_lang_translations": {
                                "en": "I prefer not to <w>clog</w> up from all those unhealthy fats."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'slibben' (to silt up, clog, or get blocked)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silt up",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8736535-de1f-343d-8c87-e77e64957851",
                    "sense_definition": "Gebiedende wijs van <w>slibben</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Slib</w> niet dicht, zorg dat de doorstroming van het water optimaal blijft!",
                            "target_lang_translations": {
                                "en": "Do not <w>silt up</w>, make sure the water flow remains optimal!"
                            }
                        },
                        {
                            "text": "<w>Slib</w> dicht als je wilt, maar ik ga de leidingen nu reinigen.",
                            "target_lang_translations": {
                                "en": "<w>Clog</w> up if you want, but I am going to clean the pipes now."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'slibben' (to silt up, clog, or get blocked)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silt up",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac1df202-0869-373b-9b23-57b1302f2036",
                    "sense_definition": "Inversievorm of tweede persoon enkelvoud tegenwoordige tijd van <w>slibben</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Slib</w> je ook zo snel dicht na het eten van die vette snacks?",
                            "target_lang_translations": {
                                "en": "Do you also <w>clog</w> up so quickly after eating those greasy snacks?"
                            }
                        },
                        {
                            "text": "Waarom <w>slib</w> je dicht als we het over dit onderwerp hebben?",
                            "target_lang_translations": {
                                "en": "Why do you <w>clam</w> up when we talk about this subject?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inversion form or second-person singular present tense of 'slibben' (to silt up, clog, or get blocked)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silt up",
                                "target_lang_sense_clarification": "second-person singular present"
                            },
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "second-person singular present"
                            }
                        ]
                    }
                }
            ]
        }
