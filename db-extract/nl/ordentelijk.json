                    {
                        "translation_id": "f34cb711-3475-460a-9b47-b6f4f963ac3d",
                        "source_entry_id": "4ade21f6-0c4b-352f-8b93-4f2e352c37e3",
                        "source_sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                        "target_lang_word": "civil",
