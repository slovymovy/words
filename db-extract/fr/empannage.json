                                    {
                                        "sense_id": "113e8a6b-8234-3493-86ba-5c5d7314628a",
                                        "entry_id": "513eef3b-03b6-37cc-874f-c58c8f577678",
                                        "glosses": [
                                            "The act of gybing.",
                                            "A manoeuvre in which the stern of a sailing vessel crosses the wind, typically resulting in the forceful and sudden sweep of the boom from one side of the vessel to the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245b8767-e4e6-417f-8fee-68580d70c0ab",
                                                "sense_id": "113e8a6b-8234-3493-86ba-5c5d7314628a",
                                                "text": "The key to a good gybe is to bring the spinnaker round to the old weather side before you begin, and then to steer to keep some wind in the kite."
                                            }
                                        ]
