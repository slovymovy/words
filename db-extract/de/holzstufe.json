                                "example_id": "29115f49-9695-46ef-a7f9-fefd0822c4d9",
                                "sense_id": "4f8ca266-5be1-3ba2-8f7c-b87ee5379570",
                                "text": "„Er stieg die drei Holzstufen zur Veranda hinauf und klopfte mit dem Handrücken leicht gegen die Tür.“"
                            },
                            {
                                "example_id": "407a5585-43da-4e95-a873-7e567e823cb4",
                                "sense_id": "4f8ca266-5be1-3ba2-8f7c-b87ee5379570",
                                "text": "„Es war ein charmantes altes Treppenhaus mit blassblauer Tapete, abgetretenen hellen Holzstufen und einem Handlauf aus etwas dunklerem Holz.“"
                            }
