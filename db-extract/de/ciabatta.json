                ],
                "senses": [
                    {
                        "sense_id": "66e2c658-9e19-3dcc-b243-a9b185aeb30f",
                        "entry_id": "b0875627-4d64-3baf-9d97-efff426971ca",
                        "glosses": [
                            "italienisches Brot aus Weizenmehl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283001c6-ee15-4dff-b2db-ac1ef053d955",
                                "sense_id": "66e2c658-9e19-3dcc-b243-a9b185aeb30f",
                                "text": "„Purismus auch sonst. Ein Schälchen gute, würzige Perlgraupensuppe steht ganz allein gegen die Amuse-Gueule-Gewitter der Konkurrenz, das Brot, zwei Sorten Ciabatta, ist enttäuschend weich und konturlos.“"
                            },
                            {
                                "example_id": "71176c82-f354-4f3f-a812-56acad40328f",
                                "sense_id": "66e2c658-9e19-3dcc-b243-a9b185aeb30f",
                                "text": "„Ob Brötchen, Baguette, Sandwich oder Ciabatta — in jedem Fall kommt es auf den richtigen Belag an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c8eeab8-581b-4145-a0a3-5797555e249b",
                        "source_entry_id": "b0875627-4d64-3baf-9d97-efff426971ca",
                        "source_sense_id": "66e2c658-9e19-3dcc-b243-a9b185aeb30f",
                        "source_sense_description": "Gastronomie: italienisches Brot aus Weizenmehl",
                        "target_lang_word": "ciabatta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciabatta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4238b446-3336-3043-9eaf-ae23e02bcd85",
                                        "entry_id": "36506400-6b8e-339d-8d6d-a2eca49e9682",
                                        "glosses": [
                                            "A broad, flat, white Italian bread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafd26c9-d399-4c48-bd00-41d5618da7b6",
                                                "sense_id": "4238b446-3336-3043-9eaf-ae23e02bcd85",
                                                "text": "Don't waste day-old ciabatta; slice it and bake the slices to make crostini, which will keep for days and can be used for snacks, canapés, or croutons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77899f8f-faae-40d2-99ab-015569537e21",
                        "source_entry_id": "b0875627-4d64-3baf-9d97-efff426971ca",
                        "source_sense_id": "66e2c658-9e19-3dcc-b243-a9b185aeb30f",
                        "source_sense_description": "Gastronomie: italienisches Brot aus Weizenmehl",
                        "target_lang_word": "ciabatta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciabatta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1c03e8-871f-3f9d-9a3a-bc2c7d419203",
                                        "entry_id": "6b4cec4d-8eb4-30a0-8cb1-f6cf2e6fc16e",
                                        "glosses": [
                                            "Pain large contenant de l’huile d’olive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcaf44fb-1067-4cd4-bac3-ac73363a9516",
                                                "sense_id": "ce1c03e8-871f-3f9d-9a3a-bc2c7d419203",
                                                "text": "Lettré, plus que jamais Swann en visite, il convoque les haïkus de Bashô en lisant le menu du Sofitel (\"Pain ciabatta chaud.../ Sur lit de frites au sel de mer...\"), flirte avec Heidegger penseur de la technique (Heathrow est l’endroit idéal pour relire Sein und Zeit), pense à Dieu (à cause de la proximité de l’altitude ?), décolle en compagnie de Sénèque (qui, dans son De la colère, fit de celle-ci une conséquence de l’espoir, ce qui explique la nature spéciale des récriminations locales), avant de méditer sur les taux de change : comment convertir les manats turkmènes en kwachas du Malawi ou en pesos uruguayens ?."
                                            }
                                        ]
                                    }
                                ]
                            }
