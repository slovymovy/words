                        "grande effervescence"
                    ]
                },
                {
                    "sense_id": "6cafdd40-a40d-3c8d-95d2-e459369c9201",
                    "sense_definition": "Bouillonnement provoqué par le dégagement rapide de bulles de gaz dans un liquide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mélange de vinaigre et de bicarbonate produit une nette <w>effervescence</w>."
                        },
                        {
                            "text": "Ce comprimé dissous dans l'eau provoque une vive <w>effervescence</w> avant de disparaître."
                        }
                    ],
                    "synonyms": [
                        "bouillonnement",
                        "pétillement"
                    ],
                    "common_phrases": [
