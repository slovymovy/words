                        "examples": [
                            {
                                "example_id": "51a25503-022c-4eac-845c-69bbafb41985",
                                "sense_id": "d7b0d15b-ca59-374d-865a-d16d48afcd99",
                                "text": "Les Misérables is gebaseerd op het boek van Victor Hugo over de beroerde leefomstandigheden van de Franse bevolking in de eerste helft van de negentiende eeuw. De musical viel bij zowel de jury als het publiek in de smaak. Het won het beeldje voor de beste grote musical en de publieksprijs voor beste musical, waar mensen thuis hun stem voor uit konden brengen. De andere publieksprijs, die voor de beste familiemusical, ging naar Assepoester."
                            },
