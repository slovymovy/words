                    },
                    {
                        "translation_id": "da30870f-913d-422c-8ea5-6ceb23d90e11",
                        "source_entry_id": "265140ee-dc98-3c48-9d2d-39672bc28414",
                        "source_sense_id": "397b303e-902e-3463-a310-4aee14c1f028",
                        "target_lang_word": "Sünder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sünder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4c376fe-ca47-3ff3-99ae-0b2e3a853a21",
                                        "entry_id": "aa25c94e-f2eb-35b3-8671-c9ffee0e0cd0",
                                        "glosses": [
                                            "jemand, der etwas Unerwünschtes/Verbotenes (eine Sünde) begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6993ea-f0f9-4e35-962f-1ea5f1e1e5d5",
                                                "sense_id": "b4c376fe-ca47-3ff3-99ae-0b2e3a853a21",
                                                "text": "„Ohne das Opfer Christi wäre aus christlicher Sicht jede Sünde unwiderruflich und unheilbar und der Sünder bliebe in Zeit und Ewigkeit von Gott und den Menschen getrennt.“"
                                            },
                                            {
                                                "example_id": "e08a9028-fad3-46c7-ad85-c22cb0a0df87",
                                                "sense_id": "b4c376fe-ca47-3ff3-99ae-0b2e3a853a21",
                                                "text": "„Dieser Geruch, der dich daran erinnert, daß du als Sünder geboren wurdest, ein Sünder bleibst, weil du die göttlichen Forderungen nie erfüllen kannst und wohl auch als Sünder in die Verdammnis eingehen wirst.“"
                                            },
                                            {
                                                "example_id": "a019e309-d246-40b4-8511-2758af2025f0",
                                                "sense_id": "b4c376fe-ca47-3ff3-99ae-0b2e3a853a21",
                                                "text": "„Daß der heilige Petrus als Himmelspförtner überrumpelt wird und selbst Sündern und Unwürdigen einen Platz im Himmel einräumen muß, ist ein durchgängiges Thema von Schwank und Witz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fbaa98e-62bd-4aae-9350-f79f12b511a9",
                        "source_entry_id": "265140ee-dc98-3c48-9d2d-39672bc28414",
                        "source_sense_id": "397b303e-902e-3463-a310-4aee14c1f028",
                        "target_lang_word": "pécheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pécheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "529a2a54-4ba2-39c9-9a97-b10765ab83b4",
                                        "entry_id": "84ec2893-24f4-36c3-b468-1e381a850cbd",
                                        "glosses": [
                                            "Qui pèche, commet des péchés, et par exemple transgresse une loi morale ou religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5f188d-a7b5-451a-adc0-1e2c1348c232",
                                                "sense_id": "529a2a54-4ba2-39c9-9a97-b10765ab83b4",
                                                "text": "Une âme pécheresse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pécheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7409f2a-6a37-3a09-8a32-6dd1ed6687a3",
                                        "entry_id": "49025dad-c61f-3d4a-b7f4-c652b1df145a",
                                        "glosses": [
                                            "Personne qui commet des péchés, qui est sujet au péché, qui est enclin au péché, qui est dans l’habitude du péché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16cd2167-be1d-4cd9-9d54-5c8c273fef26",
                                                "sense_id": "c7409f2a-6a37-3a09-8a32-6dd1ed6687a3",
                                                "text": "La mère Malard, branlant son bonnet noir, en a avalé les « Ave Maria » qu’elle bavotte à mi-voix, au long des heures, pour la conversion des pécheurs."
                                            },
                                            {
                                                "example_id": "cbde307a-d3ca-48cf-94b5-245056344ebf",
                                                "sense_id": "c7409f2a-6a37-3a09-8a32-6dd1ed6687a3",
                                                "text": "L’opposition entre le juste et le pécheur, ou le croyant et l’impie, implique qu’aucune entité incroyante ne saurait être tolérée."
                                            },
                                            {
                                                "example_id": "afd5cda7-ee89-481b-9438-e225c7ce152d",
                                                "sense_id": "c7409f2a-6a37-3a09-8a32-6dd1ed6687a3",
                                                "text": "Que je le plains, pécheur, en ton heure dernière !\nLes maux les plus affreux sont amassés sur toi ;\nLe noir enfer, séjour rempli d’effroi,\nT’attend au bout de la carrière."
                                            },
                                            {
                                                "example_id": "d19f1fa9-25c9-4502-aee4-4ceaa02ae72a",
                                                "sense_id": "c7409f2a-6a37-3a09-8a32-6dd1ed6687a3",
                                                "text": "Avouer être pécheur veut dire avouer être limité, dans l’erreur, paralysé, et reconnaître ne pas accomplir les gestes d’amour qu'on pourrait faire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
