                    }
                ],
                "senses": [
                    {
                        "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                        "entry_id": "4fec5abc-49b1-3679-b002-b6971261781f",
                        "glosses": [
                            "Zaun aus Maschendraht zum Abgrenzen eines Grundstücks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74740cc-339d-46da-8dbb-2579689fa738",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "Der Maschendrahtzaun ist wirklich sehr robust."
                            },
                            {
                                "example_id": "bd96d0be-d57c-4bad-a36f-ad99ca814ded",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "Hinter dem Maschendrahtzaun lag das öde Fabrikgelände."
                            },
                            {
                                "example_id": "813b0450-69e6-43c6-bf67-53ab5221a26e",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "Durch den Maschendrahtzaum hindurch sah man auf den Fluss."
                            },
                            {
                                "example_id": "c9a8cfee-f6af-46cf-a2b0-0a1bab259001",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "Die Kinder zwängten sich unter dem Maschendrahtzaun hindurch."
                            },
                            {
                                "example_id": "4492a8c9-eeff-4d4a-b862-811ac05eca2c",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "„Ein Maschendrahtzaun versperrte ihnen den Weg, aber Joe konnte mit seinem Bolzenschneider problemlos ein Loch hineinschneiden.“"
                            },
                            {
                                "example_id": "8582eb1c-12c6-4a3c-b057-23d85806dc8f",
                                "sense_id": "44df3f9c-2d10-3e08-bede-6733d49cf644",
                                "text": "„Er musterte den Maschendrahtzaun, um festzustellen, ob Blut daran war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
