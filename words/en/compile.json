{
    "word_family": [
        "compiler",
        "compilation",
        "recompile",
        "compilable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c28aa838-ee75-3f73-a9c0-f240a116f9fa",
                    "sense_definition": "To produce something by assembling information or materials collected from various sources.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "collecting_information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher had to <w>compile</w> data from several different studies to reach a conclusion.",
                            "target_lang_translations": {
                                "ru": "Исследователю пришлось <w>собрать</w> данные из нескольких различных исследований, чтобы прийти к выводу."
                            }
                        },
                        {
                            "text": "It took several months to <w>compile</w> a list of all the local businesses in the area.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько месяцев, чтобы <w>составить</w> список всех местных предприятий в этом районе."
                            }
                        }
                    ],
                    "synonyms": [
                        "assemble",
                        "collect",
                        "gather",
                        "accumulate"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "compile a list",
                        "compile data",
                        "compile information",
                        "compile a report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать что-либо путем сбора информации или материалов из различных источников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "список, отчет, план"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "данные, информацию"
                            },
                            {
                                "target_lang_word": "соста́вить",
                                "target_lang_sense_clarification": "завершенное действие"
                            },
                            {
                                "target_lang_word": "собра́ть",
                                "target_lang_sense_clarification": "завершенное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14dfb4dc-4f19-3d45-9878-4e000ec8e384",
                    "sense_definition": "To convert source code into a machine-executable program using a compiler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>compile</w> the code before you can run the application on your computer.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>скомпилировать</w> код, прежде чем вы сможете запустить приложение на своем компьютере."
                            }
                        },
                        {
                            "text": "The developer will <w>compile</w> source code once the final bugs are fixed.",
                            "target_lang_translations": {
                                "ru": "Разработчик <w>откомпилирует</w> исходный код, как только будут исправлены последние ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "build"
                    ],
                    "antonyms": [
                        "decompile"
                    ],
                    "common_phrases": [
                        "compile source code",
                        "compile the program",
                        "compile the project"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать исходный код в исполняемую программу с помощью компилятора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компилировать",
                                "target_lang_sense_clarification": "процесс преобразования кода"
                            },
                            {
                                "target_lang_word": "скомпилировать",
                                "target_lang_sense_clarification": "завершить преобразование кода"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            },
                            {
                                "target_lang_word": "откомпилировать",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "096b0a2e-fe31-37d0-ba40-e64010c60cbf",
                    "sense_definition": "To be successfully processed by a compiler into executable code.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The script failed to <w>compile</w> because of a missing semicolon in the third line.",
                            "target_lang_translations": {
                                "ru": "Скрипт не смог <w>скомпилироваться</w> из-за отсутствующей точки с запятой в третьей строке."
                            }
                        },
                        {
                            "text": "After fixing the syntax error, the program should <w>compile</w> without any further issues.",
                            "target_lang_translations": {
                                "ru": "После исправления синтаксической ошибки программа должна <w>компилироваться</w> без каких-либо проблем."
                            }
                        }
                    ],
                    "synonyms": [
                        "build"
                    ],
                    "common_phrases": [
                        "fail to compile",
                        "compile successfully"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно проходить процесс обработки компилятором в исполняемый код."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компилироваться",
                                "target_lang_sense_clarification": "о коде или программе"
                            },
                            {
                                "target_lang_word": "скомпилироваться",
                                "target_lang_sense_clarification": "успешно завершить сборку"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "о проекте в целом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56d8608d-6a20-30db-832f-9166e6d73115",
                    "sense_definition": "To write or compose a literary work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet spent his final years trying to <w>compile</w> the praises of his ancestors.",
                            "target_lang_translations": {
                                "ru": "Поэт провел свои последние годы, пытаясь <w>слагать</w> хвалы своим предкам."
                            }
                        },
                        {
                            "text": "Scholars would often <w>compile</w> long verses to celebrate the king's military victories.",
                            "target_lang_translations": {
                                "ru": "Ученые часто <w>составляли</w> длинные стихи, чтобы отпраздновать военные победы короля."
                            }
                        }
                    ],
                    "synonyms": [
                        "compose",
                        "write"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или сочинять литературное произведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "литературный труд"
                            },
                            {
                                "target_lang_word": "слагать",
                                "target_lang_sense_clarification": "стихи или хвалы, архаично"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c02171e5-d415-3055-88cf-e4850b196bb9",
                    "sense_definition": "In sports like snooker, to achieve a specific score or break by making a sequence of successful shots.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion managed to <w>compile</w> a break of over one hundred points in the final frame.",
                            "target_lang_translations": {
                                "ru": "Чемпиону удалось <w>сделать</w> серию более чем в сто очков в финальном фрейме."
                            }
                        },
                        {
                            "text": "He watched his opponent <w>compile</w> a 147 with absolute precision and skill.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как его противник <w>набирает</w> 147 очков с абсолютной точностью и мастерством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compile a break",
                        "compile a score"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "sports terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В таких видах спорта, как снукер, набрать определенное количество очков за одну серию ударов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "серию или брейк"
                            },
                            {
                                "target_lang_word": "набрать",
                                "target_lang_sense_clarification": "очки"
                            },
                            {
                                "target_lang_word": "оформить",
                                "target_lang_sense_clarification": "серию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be66a422-d115-3636-b091-5f994c9532f8",
                    "sense_definition": "To construct or build a physical structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient legends speak of a wizard who helped <w>compile</w> a massive wall around the city.",
                            "target_lang_translations": {
                                "ru": "Древние легенды говорят о волшебнике, который помог <w>воздвигнуть</w> массивную стену вокруг города."
                            }
                        },
                        {
                            "text": "They sought to <w>compile</w> a monument that would last for thousands of years.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>соорудить</w> памятник, который простоял бы тысячи лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "construct",
                        "build"
                    ],
                    "antonyms": [
                        "demolish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used for physical building today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сооружать или строить физическую конструкцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздвигать",
                                "target_lang_sense_clarification": "монументальное строение"
                            },
                            {
                                "target_lang_word": "сооружать",
                                "target_lang_sense_clarification": "строить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97e1917d-6474-3dbb-9d56-ab1fcb5a58ad",
                    "sense_definition": "The act or process of converting source code into an executable program.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software will remain in this group until the next <w>compile</w> is finished.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение будет оставаться в этой группе до завершения следующей <w>компиляции</w>."
                            }
                        },
                        {
                            "text": "A successful <w>compile</w> is necessary before we can begin the testing phase.",
                            "target_lang_translations": {
                                "ru": "Успешная <w>сборка</w> необходима перед тем, как мы сможем начать этап тестирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "compilation",
                        "build"
                    ],
                    "common_phrases": [
                        "next compile",
                        "successful compile"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс преобразования исходного кода в исполняемую программу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компиляция",
                                "target_lang_sense_clarification": "процесс сборки кода"
                            },
                            {
                                "target_lang_word": "сборка",
                                "target_lang_sense_clarification": "профессиональный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}