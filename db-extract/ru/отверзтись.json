                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f577db-b92a-4dca-80e7-7aae89ea29e7",
                                "sense_id": "a2fe1751-b802-3952-bbf4-2a13dedf6563",
                                "text": "Отверзлись вещие зеницы, // Как у испуганной орлицы."
                            },
                            {
                                "example_id": "7c809d3e-32c5-4726-89a5-fb11188408f1",
                                "sense_id": "a2fe1751-b802-3952-bbf4-2a13dedf6563",
                                "text": "Взятие Смоленска огромило Москву, как будто для врагов отверзся путь в столицу."
                            },
                            {
                                "example_id": "f002d2d5-9b39-4748-87d2-81a4217884d3",
                                "sense_id": "a2fe1751-b802-3952-bbf4-2a13dedf6563",
                                "text": "Скажите им это же самое обиняком, отнеситесь снисходительно к их слабости и беспомощности, и тогда, быть может, и для вас, о пионеры! отверзутся их объятия, и для вас сделаются доступными их жирные блины."
                            }
                        ]
                    }
