                        "ru": [
                            {
                                "target_lang_word": "мерзкий",
                                "target_lang_sense_clarification": "гадкий, отталкивающий"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий сильное неприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶劣",
                                "target_lang_sense_clarification": "指天气或环境极差"
                            },
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "指心情或情况非常不好"
