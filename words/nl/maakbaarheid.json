    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62be6153-ac40-352c-a1da-079cf0236524",
                    "sense_definition": "De mate waarin de samenleving of een situatie door menselijk ingrijpen gevormd en verbeterd kan worden.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "maakbaarheid_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het geloof in de <w>maakbaarheid</w> van de samenleving was erg sterk in de jaren zeventig.",
                            "target_lang_translations": {
                                "en": "The belief in the <w>malleability</w> of society was very strong in the seventies."
                            }
                        },
                        {
                            "text": "Veel sociologen discussiëren over de grenzen van de <w>maakbaarheid</w> van onze maatschappij.",
                            "target_lang_translations": {
                                "en": "Many sociologists debate the limits of the <w>makeability</w> of our society."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maakbaarheid van de samenleving",
                        "geloof in maakbaarheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The degree to which society or a situation can be shaped, controlled, and improved through human intervention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "malleability",
                                "target_lang_sense_clarification": "of society or a situation"
                            },
                            {
                                "target_lang_word": "makeability",
                                "target_lang_sense_clarification": "the belief that society can be engineered or shaped"
                            },
                            {
                                "target_lang_word": "social engineering capability",
                                "target_lang_sense_clarification": "the feasibility of shaping society"
                            },
                            {
                                "target_lang_word": "feasibility of shaping",
                                "target_lang_sense_clarification": "of a society or system"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6050b481-5047-374f-8e9e-d5722d98c771",
                    "sense_definition": "De eigenschap van iets om fysiek of materieel vervaardigd of gevormd te kunnen worden.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "maakbaarheid_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ingenieurs onderzochten de technische <w>maakbaarheid</w> van het nieuwe productontwerp.",
                            "target_lang_translations": {
                                "en": "The engineers investigated the technical <w>manufacturability</w> of the new product design."
                            }
                        },
                        {
                            "text": "Bij dit complexe ontwerp is de fysieke <w>maakbaarheid</w> de grootste uitdaging.",
                            "target_lang_translations": {
                                "en": "With this complex design, physical <w>producibility</w> is the greatest challenge."
                            }
                        }
                    ],
                    "synonyms": [
                        "produceerbaarheid",
                        "vormbaarheid"
                    ],
                    "common_phrases": [
                        "technische maakbaarheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality of being physically or materially manufacturable, feasible to produce, or shapeable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manufacturability",
                                "target_lang_sense_clarification": "the ease or feasibility of manufacturing a product"
                            },
                            {
                                "target_lang_word": "feasibility",
                                "target_lang_sense_clarification": "technical or physical viability of production"
                            },
                            {
                                "target_lang_word": "producibility",
                                "target_lang_sense_clarification": "the ability to be produced or manufactured"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}