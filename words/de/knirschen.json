{
    "word_family": [
        "Knirschen",
        "Geknirsche",
        "zerknirscht",
        "Zerknirschung"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c20ea382-f1dc-3fce-afc5-1c09f1dfb475",
                    "sense_definition": "ein helles, reibendes oder mahlendes Geräusch von sich geben, meist wenn harte Teile oder Partikel aneinanderreiben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unter ihren dicken Winterstiefeln <w>knirschte</w> der frisch gefallene Schnee bei jedem Schritt.",
                            "target_lang_translations": {
                                "en": "The freshly fallen snow <w>crunched</w> under her thick winter boots with every step."
                            }
                        },
                        {
                            "text": "Weil der Salat nicht gut gewaschen wurde, <w>knirscht</w> feiner Sand zwischen den Zähnen.",
                            "target_lang_translations": {
                                "en": "Because the salad wasn't washed well, fine sand <w>crunches</w> between the teeth."
                            }
                        }
                    ],
                    "common_phrases": [
                        "im Schnee knirschen",
                        "unter den Füßen knirschen",
                        "zwischen den Zähnen knirschen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a grinding, scraping, or crushing noise, typically when hard surfaces or particles rub together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crunch",
                                "target_lang_sense_clarification": "snow, gravel, or hard particles"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "abrasive friction"
                            },
                            {
                                "target_lang_word": "scrunch",
                                "target_lang_sense_clarification": "crunching underfoot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f047cfde-6f7a-327a-bdcc-7028909b9598",
                    "sense_definition": "die Zähne fest aufeinanderpressen und aneinander reiben, besonders aus Wut, Frustration oder im Schlaf",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "teeth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>knirschte</w> wütend mit den Zähnen, als er von der ungerechten Entscheidung erfuhr.",
                            "target_lang_translations": {
                                "en": "He angrily <w>ground</w> his teeth when he learned of the unfair decision."
                            }
                        },
                        {
                            "text": "Viele Menschen <w>knirschen</w> nachts unbemerkt mit den Zähnen und wachen mit Schmerzen auf.",
                            "target_lang_translations": {
                                "en": "Many people unknowingly <w>grind</w> their teeth at night and wake up in pain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mit den Zähnen knirschen"
                    ],
                    "target_lang_definitions": {
                        "en": "to grind or grit one's teeth together tightly, especially out of anger, frustration, or during sleep"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "teeth, e.g. in sleep or distress"
                            },
                            {
                                "target_lang_word": "grit",
                                "target_lang_sense_clarification": "teeth, typically in determination or rage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceac09d1-ed22-3844-85e9-6ae52593c965",
                    "sense_definition": "starken Groll oder verborgene Wut empfinden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>knirschte</w> innerlich vor Zorn über die ständige Unterdrückung seines Volkes.",
                            "target_lang_translations": {
                                "en": "He <w>seethed</w> inwardly with anger over the constant oppression of his people."
                            }
                        },
                        {
                            "text": "Trotz der erlittenen Niederlage <w>knirschten</w> die Rebellen weiterhin voller Erbitterung.",
                            "target_lang_translations": {
                                "en": "Despite the defeat they suffered, the rebels continued to <w>fume</w> with bitterness."
                            }
                        }
                    ],
                    "synonyms": [
                        "grollen",
                        "grimmen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "übertragen für Groll hegen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to seethe inwardly with bitter resentment, anger, or rancor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seethe",
                                "target_lang_sense_clarification": "with suppressed anger or bitterness"
                            },
                            {
                                "target_lang_word": "fume",
                                "target_lang_sense_clarification": "with suppressed rage"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ba90749-02b9-3895-a743-18d3e634e53f",
                    "sense_definition": "ein hartes, mahlendes oder reibendes Geräusch",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das einzige Geräusch im stillen Wald war das laute <w>Knirschen</w> des Kieses.",
                            "target_lang_translations": {
                                "en": "The only sound in the quiet forest was the loud <w>crunching</w> of the gravel."
                            }
                        },
                        {
                            "text": "Mit einem unangenehmen <w>Knirschen</w> schrammte das Auto an der Bordsteinkante entlang.",
                            "target_lang_translations": {
                                "en": "With an unpleasant <w>scrape</w>, the car scraped along the curb."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mit einem Knirschen",
                        "hörbares Knirschen"
                    ],
                    "target_lang_definitions": {
                        "en": "a hard, grinding, or crushing sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crunch",
                                "target_lang_sense_clarification": "sound underfoot or from pressure"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "harsh, scraping sound"
                            },
                            {
                                "target_lang_word": "grinding",
                                "target_lang_sense_clarification": "sound of friction or teeth"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}