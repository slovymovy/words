                "senses": [
                    {
                        "sense_id": "f56787e1-ec93-3a91-9a83-0da2fa7c6a3a",
                        "entry_id": "c071113d-238d-3fcc-9ab3-852b4a080588",
                        "glosses": [
                            "Exploitante d’une forêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc5dd4d1-7eb1-4b48-83b6-3627d7e757d0",
                                "sense_id": "f56787e1-ec93-3a91-9a83-0da2fa7c6a3a",
                                "text": "La forestière n’avait pas le choix ; elle fit glisser vivement le gros verrou, puis tirant le lourd battant, elle aperçut dans l’ombre pâle des neiges, six hommes, six soldats prussiens, les mêmes qui étaient venus la veille."
                            },
                            {
                                "example_id": "5fe1c0ba-d7a9-4073-b8ea-bae1769466ab",
                                "sense_id": "f56787e1-ec93-3a91-9a83-0da2fa7c6a3a",
                                "text": "Une forestière accompagnera les visiteurs sur le sentier des Treize-Ponts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75c2946b-544d-499b-a85b-3d67e53a7212",
                        "source_entry_id": "c071113d-238d-3fcc-9ab3-852b4a080588",
                        "source_sense_id": "f56787e1-ec93-3a91-9a83-0da2fa7c6a3a",
                        "target_lang_word": "Försterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Försterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                        "entry_id": "5086a9b5-8e90-38ee-bef6-624ef40391c1",
                                        "glosses": [
                                            "beruflich mit der Verwaltung und Bewirtschaftung eines Walds und des dortigen Wilds betraute weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc83aff-f639-4e15-aac4-b9e604ded0c6",
                                                "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                                "text": "Für die Försterin im Soonwald bei Bad Kreuznach steht das sogenannte „Auszeichnen“ an."
                                            },
                                            {
                                                "example_id": "58a56355-a3a9-4383-a621-8bd43e3ae74e",
                                                "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                                "text": "Försterinnen mit pädagogischer Ader können ein Zusatz-Zertifikat Umweltbildung erwerben."
                                            },
                                            {
                                                "example_id": "76c9d7b7-62c8-4df9-af2e-f058ce606360",
                                                "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                                "text": "„Man muss ein bisschen so tun, als ob einem selber der Wald gehört“, rät Petra Trompeter (39) angehenden Förstern und Försterinnen, die als Revierförsterin bei der Stadt Arnsberg beschäftigt ist."
                                            },
                                            {
                                                "example_id": "abe35ab9-adc8-4ea7-9197-7fcc57e329eb",
                                                "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                                "text": "Nach dem Studium fand ich sofort eine Stelle bei den Niedersächsischen Landesforsten, die genaue Bezeichnung: „Försterin für Waldökologie“."
                                            },
                                            {
                                                "example_id": "c0ccf9d3-82d3-47b0-9fd0-ee6d85ee158a",
                                                "sense_id": "038b4143-5584-3f27-8cd5-6a2e1aef4650",
                                                "text": "Die 5 jährige schulische Ausbildung zur Försterin / zum Förster schließt mit Diplomprüfung ab und wird bundesweit an der Höheren Bundeslehranstalt für Forstwirtschaft in Bruck an der Mur angeboten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
