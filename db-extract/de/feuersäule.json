                ],
                "senses": [
                    {
                        "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                        "entry_id": "46e8e082-ee8f-39f4-a0de-731f946cfe51",
                        "glosses": [
                            "aufsteigendes säulenförmiges Feuer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b22943-3138-4f6d-98d9-2957fe8eef39",
                                "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                                "text": "„Im Moor blitzte ein Funke auf, eine Flamme zuckte empor, und eine menschliche Feuersäule hob die Arme zum Himmel.“"
                            },
                            {
                                "example_id": "558ce5cf-fdce-4632-abe8-1cdafffe9b17",
                                "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                                "text": "„Dalton und Georgina rührten sich nicht von der Stelle und warteten ab, bis die Feuersäule zu schwelender Glut zusammengeschrumpft war.“"
                            },
                            {
                                "example_id": "67051255-458a-4349-9cc8-dbe13a284f91",
                                "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                                "text": "„Es sah aus wie ein Stern mit einem Auge in der Mitte, wobei die Pupille – wellig und gezackt – einer Feuersäule glich.“"
                            },
                            {
                                "example_id": "8f03394b-ea00-44bb-aa22-039e24f9060c",
                                "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                                "text": "„Eine horizontale Feuersäule schoss aus der Spraydose und erhellte die Szenerie, während sie die beiden Soldaten umschlang.“"
                            },
                            {
                                "example_id": "c969fd18-de41-46fd-b0b2-590720cc6e59",
                                "sense_id": "c67d6d29-5a45-3a36-9960-dee374f927bb",
                                "text": "„Auffällig ist, dass diese Geschichten eine deutliche Ähnlichkeit mit Erzählungen in manchen griechischen und lateinischen Texten aufwiesen, die sich in der Bibliothek der Franziskaner befanden. Sie erzählten wortgewaltig von Feuersäulen und einem furchterfüllten König.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
