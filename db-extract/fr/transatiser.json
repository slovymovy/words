                "senses": [
                    {
                        "sense_id": "0a420de2-cf9b-3baa-836a-be7a80401d8a",
                        "entry_id": "4500a38b-047e-3921-864f-c27e2defc908",
                        "glosses": [
                            "Doter de transats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acb81be-3364-4df0-a31f-c730b5843b08",
                                "sense_id": "0a420de2-cf9b-3baa-836a-be7a80401d8a",
                                "text": "Paris ont résolu de parasoliser Paris. Et de le palmiériser. Et de le boulodromiser. Et de le transatiser. Et de le littoraliser. Sur trois kilomètres."
                            },
                            {
                                "example_id": "6c725eaa-6a71-4a28-bba1-2d370f7f3349",
                                "sense_id": "0a420de2-cf9b-3baa-836a-be7a80401d8a",
                                "text": "Je ne vous parle pas des massages, des petits déjeuners copieux et variés (en quatre jours je n'en ai pas eu un identique), des terrasses \"transatisées\", des dîners au ciel étoilé, des lits et des baignoires \"king size\"..."
                            }
                        ]
                    },
                    {
                        "sense_id": "13840897-9c40-34c3-8690-efa63fa76a90",
                        "entry_id": "4500a38b-047e-3921-864f-c27e2defc908",
                        "glosses": [
                            "S’allonger dans un transat."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2b58588a-5248-4d10-ac11-046f7b6514df",
                                "sense_id": "13840897-9c40-34c3-8690-efa63fa76a90",
                                "text": "j'ai envie de me \"transatiser\" (oui, oui, je sais, ce mot n'existe pas, mais pas grâve, hihi)."
                            }
                        ]
                    }
