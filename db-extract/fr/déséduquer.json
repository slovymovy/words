                "senses": [
                    {
                        "sense_id": "58d8f926-c483-3222-be56-b288d78260fc",
                        "entry_id": "2cf08dd3-cb5c-3b37-b67c-be4d7f978183",
                        "glosses": [
                            "Faire perdre les réflexes acquis par l’éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b9ea75-9de4-47d0-b532-9a13ee461a70",
                                "sense_id": "58d8f926-c483-3222-be56-b288d78260fc",
                                "text": "Je dis parfois à mes enfants, qui ne sont pas toujours d’accord avec ma façon d’interagir avec leurs enfants, que mon rôle de grand-papa est de « déséduquer » mes petits-enfants, qui sans ça, deviendront des êtres intellectuellement constipés, guindés et trop « straight »."
                            },
                            {
                                "example_id": "4e743ba8-0732-4ec7-8cb9-4a2062f43149",
                                "sense_id": "58d8f926-c483-3222-be56-b288d78260fc",
                                "text": "S. insistait sur la nécessité de se déséduquer'."
                            },
                            {
                                "example_id": "fc55fb7f-1d86-4bc7-afa6-6a04cc40837f",
                                "sense_id": "58d8f926-c483-3222-be56-b288d78260fc",
                                "text": "J'apprends à me déséduquer!"
                            },
                            {
                                "example_id": "7406a270-ec52-463e-bbc0-18885ad131fc",
                                "sense_id": "58d8f926-c483-3222-be56-b288d78260fc",
                                "text": "Déséduquer (néol.) : vb transitif et intransigeant : apprendre à ne rien perdre de l'enfance"
                            }
                        ]
                    }
                ],
