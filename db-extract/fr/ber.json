                "senses": [
                    {
                        "sense_id": "19726b91-2ac0-3c4d-8889-98090240bb96",
                        "entry_id": "a5798f47-ca81-343b-a263-b395e877b1aa",
                        "glosses": [
                            "Appareil de charpente et de cordage, placé sous un grand bâtiment, pour le supporter pendant la construction ou la réparation, et qui glisse sur la cale lorsqu’on lance ce bâtiment à l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96255831-a269-4a60-a76c-3c6e6520ea0d",
                                "sense_id": "19726b91-2ac0-3c4d-8889-98090240bb96",
                                "text": "Le port à sec est à deux cent mètres, une vaste zone de stockage à terre des bateaux. Ils reposent là, soutenus par des bers en acier galvanisé ou calés sur leurs béquilles, comme de grands cétacés, et des gars prennent soin d’eux, se préoccupent de leur longévité, et souvent tournent autour et les admirent sous toutes les coutures ou les flattent pour apprécier sous la main la qualité du travail, des gars du chantier qui sont payés pour ça, ou d’autres qui viennent en amateurs et louent un emplacement avec la garantie d’avoir du matériel à disposition et toujours quelqu’un dans les parages pour vous donner un coup de main ou y mettre son grain de sel sur la meilleure façon de faire."
                            }
                        ]
                    },
                    {
                        "sense_id": "6010c7c7-cb8d-3a38-80c3-37c23efc4732",
                        "entry_id": "a5798f47-ca81-343b-a263-b395e877b1aa",
                        "glosses": [
                            "Ridelle d’une charrette permettant de poser dessus une bâche."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f303a8c-3264-48f7-a239-4edb31d9f83d",
                        "source_entry_id": "a5798f47-ca81-343b-a263-b395e877b1aa",
                        "source_sense_description": "Support d'un grand bâtiment",
