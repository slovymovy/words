                        "source_sense_id": "cdbe7937-4309-37a4-9d2c-b8a74993b05a",
                        "target_lang_word": "global city",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "global city",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a05b0ec-92dd-3ce6-949a-096e36d09505",
                                        "entry_id": "5e5e7685-bbc1-3af9-ae4f-ad4eb7b6b322",
                                        "glosses": [
                                            "A city that serves as a primary node in the global economic network; a metropolis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b21295-891c-4f4e-afd0-67fa87a11500",
                                                "sense_id": "9a05b0ec-92dd-3ce6-949a-096e36d09505",
                                                "text": "Today's global cities have been empowered and transformed by the construction of a market economy at a global scale. In this sense, I would argue, the global city must be seen as primarily a political phenomenon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf3714a4-8c21-4c8f-938f-3030f6ad3f12",
                        "source_entry_id": "95a2b4ec-61b9-3497-a3ae-8706c1481d99",
