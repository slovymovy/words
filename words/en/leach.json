                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a specific historical food item."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинное желеобразное сладкое блюдо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лич",
                                "target_lang_sense_clarification": "исторический десерт-желе"
                            }
                        ]
                    }
                }
            ]
        },
