                                            {
                                                "example_id": "566772cd-0caf-45c9-80bf-84bffcf0576c",
                                                "sense_id": "eda629db-d3dd-3d1e-b869-12135a8fec9f",
                                                "text": "Finalement, c’est de son chien Milou qu’il [Tintin] est le plus proche, à cela près que Milou ne rêve que de paresseuse sédentarité et peste contre l’humeur aventureuse de son maître."
                                            },
                                            {
                                                "example_id": "dcae9111-5731-4fd6-ac69-d5ff7d54e61d",
                                                "sense_id": "eda629db-d3dd-3d1e-b869-12135a8fec9f",
                                                "text": "Son grand corps est long, encore mince bien que la sédentarité inhérente à son métier l’ait quelque peu empâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c98c15-0a2d-3f0c-91b0-a181b385e9ca",
