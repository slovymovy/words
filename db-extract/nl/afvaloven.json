                        "examples": [
                            {
                                "example_id": "71f51777-f9c5-447c-b95c-8046411107d8",
                                "sense_id": "bfc483fa-6657-3e3a-be64-53d32cf6f3a6",
                                "text": "De afgelopen jaren zorgde de afvaloven in de omgeving voor flink wat overlast en commotie. Met rechtszaken en zelfs door de oprichting van een politieke partij, die deel uitmaakt van de gemeenteraad van Harlingen, proberen tegenstanders de afvaloven weg te krijgen."
                            },
                            {
                                "example_id": "363a30a9-cbcd-430e-83f4-10e2595d2c7f",
                                "sense_id": "bfc483fa-6657-3e3a-be64-53d32cf6f3a6",
                                "text": "Uit onderzoek van het RIVM is nu gebleken dat de dioxine niet afkomstig kan zijn van de nieuwe afvaloven in de Friese havenplaats, zoals eerder werd verondersteld."
                            },
                            {
                                "example_id": "3f55901b-88d0-48a4-a3d7-6c6e57c7f75c",
                                "sense_id": "bfc483fa-6657-3e3a-be64-53d32cf6f3a6",
                                "text": "In totaal ging voor 73 miljoen euro aan kostbare grondstoffen verloren. Ze werden niet hergebruikt, maar verbrand in de afvaloven."
                            }
                        ]
                    }
