                        "cross_references": [
                            {
                                "target_word": "recommendation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9dc049-b548-326e-8b06-f753edfc636b",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "An act of recommending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "That which is recommended."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ee3f8a-f8d7-40f0-b551-58364c00f2f8",
                                                "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                                "text": "Some of the recommendations made by the PTF to prevent the spread of Covid-19 as religious institutions and hotels open up include: managed access to markets and locations of economic activity to limit the risk of transmitting Covid-19, mandatory use of face masks and temperature checks in public places, and information campaigns on the dangers of the virus among others."
                                            },
                                            {
                                                "example_id": "e9c097c5-71fb-4ab1-8908-f0b27bc5cebd",
                                                "sense_id": "93fe2c93-d6f3-3319-8e00-5773fb251e8c",
                                                "text": "The US Centers and Disease Control and Prevention is considering recommending annual Covid-19 shots to those who are older or who have compromised immune function, rather than the current blanket recommendation for everyone 6 months of age and older."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40642cdd-d83b-300a-932b-5d402a740f21",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "A commendation or endorsement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8308f648-16b8-44ed-bf40-8e941be3c492",
                                                "sense_id": "40642cdd-d83b-300a-932b-5d402a740f21",
                                                "text": "Your next employer may require a recommendation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                        "entry_id": "00da929c-76d9-3aee-96d9-ff25a76093c8",
                                        "glosses": [
                                            "A suggestion or proposal about the best course of action (with adpositions including \\\"about\\\" for the context and \\\"to\\\" for the course of action)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d2f901-77a0-47b8-978c-d0aa2cf3b717",
                                                "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                                "text": "He made a recommendation about what food to order."
                                            },
                                            {
                                                "example_id": "31b99e9c-db16-481e-8db8-314e856f4d66",
                                                "sense_id": "1d523aa8-4668-3fd2-9da7-2356b6a0288a",
                                                "text": "We followed the recommendation to order sushi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b5e8b2-c57d-4b7a-a8de-5fd7c469222a",
                        "source_entry_id": "3ece5b08-be39-37ae-a280-62813947fcc5",
                        "source_sense_id": "7ec0bd57-e8a7-3404-83be-c693dc1b168f",
                        "target_lang_word": "recommandation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recommandation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                        "entry_id": "4eec3754-f127-36e1-a453-7b7f52554f70",
                                        "glosses": [
                                            "Exhortation instante, conseil pressant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de31d1a-853a-4894-af93-4f37a585643c",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "Deux minutes après, un foulard de coton au cou et son béret « Le Vengeur » planté sur la tignasse épaisse, il attendait dans une posture recueillie et digne les ultimes recommandations paternelles."
                                            },
                                            {
                                                "example_id": "730711fd-7636-4ad0-ba96-14823c48f8e0",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "La longueur de la barre de 3ᵉ point détermine l’horizontalité de l’appareil. Suivre les recommandations du constructeur pour la régler."
                                            },
                                            {
                                                "example_id": "9c5c8ff5-0c2c-498b-95eb-56f83e61bc55",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "Jérôme Fandor se répétait machinalement les derniers mots des recommandations de son patron : interviewer le baron de Naarboveck, lier connaissance avec une jeune personne du nom de Bobinette, savoir quels étaient les hôtes de l’hôtel."
                                            },
                                            {
                                                "example_id": "72dee295-b6c7-4dd1-9178-986f644fcaf0",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "Il est très important de placer les écouteurs correctement. Les recommandations faites par les organismes de standardisation disent qu'il faut appliquer une force par l'emploi d'un serre-tête ou de tout autre moyen équivalent. Une force au moins égale à 4 newton ^([sic : newtons]) est indispensable, […]"
                                            },
                                            {
                                                "example_id": "ad749392-a244-4432-bf92-124ac796b1af",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "On peut se demander si le vote d'une recommandation relative à l'organisation de l'assurance des marins contre le chômage était bien nécessaire, étant donné que la recommandation de Washington, relative à l'assurance-chômage, s'applique sans réserve à tous les travailleurs."
                                            },
                                            {
                                                "example_id": "2e0b814e-5c18-40fa-bf84-9dacc8d45a34",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "Instruisez le peuple ! fut la dernière recommandation de Washington a la République. Instruisez le peuple ! était l’incessante exhortation de Jefferson, » Mais l’émigration d’Europe apportait sans cesse des éléments nouveaux sur lesquels il fallut agir."
                                            },
                                            {
                                                "example_id": "9d8e0cfc-f555-4392-a00f-8a473ac12629",
                                                "sense_id": "7bb22e25-a33b-3e11-9853-ff29c346afb9",
                                                "text": "On sait qu'aux États-Unis, un usage, qui a force de loi et qui est la dernière recommandation de Washington, ne permet pas à un président de solliciter plus de deux fois les suffrages du pays"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                        "entry_id": "4eec3754-f127-36e1-a453-7b7f52554f70",
                                        "glosses": [
                                            "Action de recommander quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41d9b0b-943e-4f5a-a866-95cb8deafdee",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "C’est une puissante recommandation que la sienne."
                                            },
                                            {
                                                "example_id": "b9a118f1-43c0-4923-983e-4371208ae756",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "Il m’a accordé cette faveur à votre recommandation."
                                            },
                                            {
                                                "example_id": "4fd779e8-f8ca-4fb3-8be8-a33d81b888f9",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "Il a eu égard à ma recommandation."
                                            },
                                            {
                                                "example_id": "c6939af8-1033-4948-8b96-932b5a968eff",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "Il a eu de fortes recommandations auprès de ses examinateurs."
                                            },
                                            {
                                                "example_id": "3218c430-5a37-4cf6-b75b-a61a6bc9dca1",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "Lettres de recommandation."
                                            },
                                            {
                                                "example_id": "5904edf1-8457-49ff-bebc-5171a69ce447",
                                                "sense_id": "0478746e-44b3-353e-8a43-5f82f9193468",
                                                "text": "Une recommandation pressante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687191d3-ef84-3620-888c-edd2798aae26",
                                        "entry_id": "4eec3754-f127-36e1-a453-7b7f52554f70",
                                        "glosses": [
                                            "Estime qu’on a pour la vertu, pour le mérite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee704b31-6a56-47ac-9172-2a2e35b4d6e2",
                                                "sense_id": "687191d3-ef84-3620-888c-edd2798aae26",
                                                "text": "La sainteté de sa vie l’avait mis partout en grande recommandation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49093fa1-763a-3f02-a35c-c7f9c647cfb8",
                                        "entry_id": "4eec3754-f127-36e1-a453-7b7f52554f70",
                                        "glosses": [
                                            "Titre dont on peut se prévaloir, qui vous vaut de l’estime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05335c21-0fd8-42e7-bf2a-b105cd32e05a",
                                                "sense_id": "49093fa1-763a-3f02-a35c-c7f9c647cfb8",
                                                "text": "Avoir servi ainsi n’est pas une recommandation."
                                            },
                                            {
                                                "example_id": "a42356e5-4056-4d00-aa1a-e16eea711a5b",
                                                "sense_id": "49093fa1-763a-3f02-a35c-c7f9c647cfb8",
                                                "text": "C’est déjà une recommandation d’avoir été employé dans cette maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27cb26e8-a51d-340a-937d-5ce201835879",
                                        "entry_id": "4eec3754-f127-36e1-a453-7b7f52554f70",
                                        "glosses": [
                                            "Action de recommander une lettre, un paquet."
                                        ],
                                        "tags": [
                                            "Poste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c0e6bd-5aab-4b1e-acc4-9c276d0b2289",
                                                "sense_id": "27cb26e8-a51d-340a-937d-5ce201835879",
                                                "text": "La recommandation d’une lettre."
                                            },
                                            {
                                                "example_id": "2c8050ef-09d4-4c9f-a137-db6866225022",
                                                "sense_id": "27cb26e8-a51d-340a-937d-5ce201835879",
                                                "text": "Il y a un supplément à payer pour la recommandation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
