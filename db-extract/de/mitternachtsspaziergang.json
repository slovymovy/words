                "senses": [
                    {
                        "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                        "entry_id": "36c08a0b-dd09-3fd9-94b4-e8130a026f39",
                        "glosses": [
                            "Spaziergang um Mitternacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de8c4563-67ee-482b-8d89-7bf80bcda798",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "Hast Du Lust auf einen Mitternachtsspaziergang mit mir?"
                            },
                            {
                                "example_id": "e6ac6085-5a0f-4e3b-984d-c1fe171f56e6",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "„Zum ersten Mal in ihrem Leben hatte Bendany Glen sowohl das Verlangenals auch die Möglichkeit für einen ruhigen, besinnlichen Mitternachtsspaziergang.“"
                            },
                            {
                                "example_id": "de5f1440-238f-4cb0-b5bd-00858ace3314",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "„Ich dachte, du unternimmst vielleicht einen kleinen Mitternachtsspaziergang, um deinen Kopf freizukriegen.“"
                            },
                            {
                                "example_id": "24dcdcb2-627d-47c4-be5a-c68c703d7bd9",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "„Ein Mitternachtsspaziergang über die kleine, wenige hundert Fuss hohelnsel, auf welcher das handelsthätige Städtchen liegt, unter dem Gesange der Drosseln und Sylvien, dem Rufe des Kukuks, dem Balzen der Schneebühner auf üppig blühenden Moorheiden, wo Spanner und Tagfalter zugleich schwärmen, ist wohl ein Genuss, der nirgends in ähnlicher Weise gefunden werden kann.“"
                            },
                            {
                                "example_id": "1de72953-853e-4057-ba00-ed38bd382fea",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "„Während seines Aufenthalts in Walden pflegte er weiterhin seine Mitternachtsspaziergänge und schreibt darüber, dass ihm die Schreieulen mitten in der Nacht ihr Ständchen bringen.“"
                            },
                            {
                                "example_id": "606625f0-ac93-42a8-bc16-cb557e7cf8ec",
                                "sense_id": "0c6dfe98-45f7-3a45-b862-ca49f0b0c7b8",
                                "text": "„Lourié war in Russland Musikkommissar geworden und war Varèses Gefährte bei langen Mitternachtsspaziergängen und Gesprächen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
