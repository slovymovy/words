                                    {
                                        "sense_id": "e6a17a95-f20c-3871-befb-9c40642cd420",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "Any of various tropical trees of the genus Santalum, native or long naturalized in India, Australia, Hawaii, and many south Pacific islands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                        "entry_id": "6e9104fb-5e58-3793-a84a-08916b8ee58d",
                                        "glosses": [
                                            "The aromatic heartwood of these trees used in ornamental carving, in the construction of insect-repellent boxes and chests, and as a source of certain perfumes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d4410f-a978-4737-8dcc-fe7259bb973f",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "You ſhall put in a little bag the Powder of Sandalwood with the aforeſaid well-ſcenting Spices, and heart-ſtrengthening Powders, and lay it warm upon the left breaſt."
                                            },
                                            {
                                                "example_id": "92f03927-39b6-47c7-afd6-2bc5bd58b103",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "The branches of the white cedar will keep off moths when placed amongst clothes or furs. Boxes of red cedar (cedar of Lebanon) will do the same, as also sandalwood."
                                            },
                                            {
                                                "example_id": "909a4f21-8a68-488c-95d4-568ef46c191c",
                                                "sense_id": "f5c5b70f-e2d9-370a-bc25-bdb6c1f7afe3",
                                                "text": "Sandalwood is a favorite cosmetic with Burmese ladies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
