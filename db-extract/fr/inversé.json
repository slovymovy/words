                                "target_senses": [
                                    {
                                        "sense_id": "fa2bd15d-8a68-3f80-b049-21c4711ff183",
                                        "entry_id": "6ba6bac7-1bd9-3b8e-ab79-a27a0df66a2d",
                                        "glosses": [
                                            "Having the order or direction changed; for example, turned upside down, reversed, or in any other way opposite or contrary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "badc586e-81f7-45a9-b4e0-286ab8ecea9d",
                                                "sense_id": "fa2bd15d-8a68-3f80-b049-21c4711ff183",
                                                "text": "Phil was slumped over the edge of the mattress, inverted, watching her dress. He seemed to have a thing for that. She didn't mind; after eight years, she and Harry had long since ceased to ogle each other after bed. He'd taken longer than she had, but then, she knew he had more to look at than she did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59f082ae-92b1-337c-91ab-f6adfa205620",
                                        "entry_id": "6ba6bac7-1bd9-3b8e-ab79-a27a0df66a2d",
                                        "glosses": [
                                            "Having the lowest note transposed an octave higher."
                                        ],
                                        "tags": [
                                            "of a chord"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "808dfb40-8cfc-30e4-be07-df3c6d3c0bd4",
                                        "entry_id": "6ba6bac7-1bd9-3b8e-ab79-a27a0df66a2d",
                                        "glosses": [
                                            "Having its polarization changed by hydrolysis; see invert sugar."
                                        ],
                                        "tags": [
                                            "of sugar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28df79a9-2188-3d5c-8a1e-ab5fd216a478",
                                        "entry_id": "6ba6bac7-1bd9-3b8e-ab79-a27a0df66a2d",
                                        "glosses": [
                                            "Homosexual, in terms of the sexual inversion theory."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b6e42e-d645-476b-9292-a034566993c4",
                                                "sense_id": "28df79a9-2188-3d5c-8a1e-ab5fd216a478",
                                                "text": "Among the Normans, everywhere, homosexuality was markedly prevalent; the spread of sodomy in France about the eleventh century is attributed to the Normans, and their coming seems to have rendered it at times almost fashionable, at all events at court. In England, William Rufus was undoubtedly inverted, as later on were Edward II, James I, and, perhaps, though not in so conspicuous a degree, William III."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5709f00a-16f2-3eda-b2c1-a2b11b193790",
                                        "entry_id": "6ba6bac7-1bd9-3b8e-ab79-a27a0df66a2d",
                                        "glosses": [
                                            "Assumed to be transgender, in the terms of transvestigation."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
