                                                "sense_id": "203c02fa-6f5a-3529-8ea9-6fe0db444c5c",
                                                "text": "Die Weihnachtskrippe in unserer Pfarrkirche ist wunderschön."
                                            },
                                            {
                                                "example_id": "a3633a8d-89ac-4040-b084-7ca5bd4d6382",
                                                "sense_id": "203c02fa-6f5a-3529-8ea9-6fe0db444c5c",
                                                "text": "„Am Heiligen Abend schließen wir den Laden um vierzehn Uhr, bauen die geborgte Weihnachtskrippe ab, geben sie zurück und fahren müde und glücklich in das kleine Haus am Schafberg.“"
                                            },
                                            {
                                                "example_id": "ae99434a-e73f-4af8-943b-d11b7920363e",
                                                "sense_id": "203c02fa-6f5a-3529-8ea9-6fe0db444c5c",
                                                "text": "„Jetzt war er sicher, das Quack kam von der Weihnachtskrippe neben ihm!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
