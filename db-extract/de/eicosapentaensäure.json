                                "target_senses": [
                                    {
                                        "sense_id": "93c46cf4-e477-3b05-ae9e-a9cf0e6b03f9",
                                        "entry_id": "bfd83114-9d7b-37d7-884e-87e5e40d1e52",
                                        "glosses": [
                                            "Acide gras insaturé oméga-3."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82140ae5-a188-459c-a736-d40349f1b2c5",
                                                "sense_id": "93c46cf4-e477-3b05-ae9e-a9cf0e6b03f9",
                                                "text": "L’acide eicosapentaénoïque (EPA) : lui aussi provient de sources animales. Anti-inflammatoire, il protège aussi le cœur et les artères."
                                            },
                                            {
                                                "example_id": "30de7642-f13a-4432-8a78-214e4163dd5d",
                                                "sense_id": "93c46cf4-e477-3b05-ae9e-a9cf0e6b03f9",
                                                "text": "La coquille Saint Jacques présente des taux élevés de deux acides gras polyinsaturés de type oméga-3, l’acide eicosapentaénoïque et l’acide docosahexaénoïque."
                                            },
                                            {
                                                "example_id": "5a867481-def1-405b-b800-e460fbf0049f",
                                                "sense_id": "93c46cf4-e477-3b05-ae9e-a9cf0e6b03f9",
                                                "text": "Au titre des omégas 3 présents en très forte teneur dans l’huile de poisson, il y a l’acide docosahexaénoïque (DHA) et l’acide eicosapentaénoïque (EPA)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
