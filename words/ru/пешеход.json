                            {
                                "target_lang_word": "pedestrian",
                                "target_lang_sense_clarification": "A person who is walking rather than using a vehicle."
                            },
                            {
                                "target_lang_word": "walker",
                                "target_lang_sense_clarification": "A person who walks, often for exercise or leisure."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5fcfaa0-7262-3177-9a55-8ee6d045e04a",
                    "sense_definition": "специально отведенное место для перехода дороги",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель не заметил человека на <w>пешеходе</w> из-за сильного дождя.",
                            "target_lang_translations": {
                                "en": "The driver did not notice the person on the <w>crosswalk</w> due to the heavy rain."
                            }
                        },
                        {
                            "text": "Машина остановилась прямо на <w>пешеходе</w>, перекрыв путь людям.",
                            "target_lang_translations": {
                                "en": "The car stopped right on the <w>pedestrian crossing</w>, blocking the path for people."
                            }
                        }
                    ],
                    "traits": [
