                        "examples": [
                            {
                                "example_id": "9a622d4f-0223-4d39-80ef-c933fb496c15",
                                "sense_id": "1100b9c6-0fb6-3930-96bc-1eb453e5db3d",
                                "text": "Każda rekolektantka znalazła na stoliku nocnym ramowy plan rekolekcji."
                            },
                            {
                                "example_id": "29d53f80-41f9-4394-b49f-68b1b856153b",
                                "sense_id": "1100b9c6-0fb6-3930-96bc-1eb453e5db3d",
                                "text": "Panewnickie kucharki zgotowały rekolektantkom nie lada niespodziankę."
                            },
                            {
                                "example_id": "8ba3e910-b015-420f-a1c5-a3fde29d620e",
                                "sense_id": "1100b9c6-0fb6-3930-96bc-1eb453e5db3d",
                                "text": "Rekolektantkom bardzo podobały się ojca homilie i konferencje ascetyczne."
                            }
                        ],
