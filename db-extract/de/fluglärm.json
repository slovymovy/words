                        "glosses": [
                            "Lärm, der von Flugzeugen und anderen Luftfahrzeugen erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5f09fd-1b67-403d-8acf-cad00390ce68",
                                "sense_id": "96f4d619-97a7-3789-a06e-4dd0348b83b8",
                                "text": "Die Anwohner protestierten gegen den zu erwartenden Fluglärm und forderten ein Nachtflugverbot."
                            },
                            {
                                "example_id": "f6236c95-e039-49f4-ac06-25b5c3e6ade3",
                                "sense_id": "96f4d619-97a7-3789-a06e-4dd0348b83b8",
                                "text": "„Da Motorradlärm aber vor allem in den Sommermonaten und an Wochenenden auftritt, sollten künftig die Spitzenpegel berücksichtigt werden, wie es beispielsweise bei Fluglärm während der Nacht vorgeschrieben ist.“"
                            }
                        ],
