                        ],
                        "form": "опьяня́я"
                    },
                    {
                        "form_id": "6e6c0478-54d5-4927-9463-2342ae060811",
                        "entry_id": "011c3704-bdef-3b79-8015-56df08bb05cb",
                        "tags": [
                            "adverbial",
                            "participle",
