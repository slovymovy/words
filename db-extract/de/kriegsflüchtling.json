                        "sense_id": "b73fe003-a9a7-3209-8faa-528274b39596",
                        "entry_id": "046ef61a-6afa-3662-a48c-113825b4b13f",
                        "glosses": [
                            "Person, die ihre Heimat verlässt, um vor Kriegsfolgen zu fliehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d34ca6-29bf-486f-af8d-da29ff2e5636",
                                "sense_id": "b73fe003-a9a7-3209-8faa-528274b39596",
                                "text": "„Ähnliche Modelle der transgenerationalen Weitergabe erkannten Psychologen später bei den Kindern der Vietnam-Krieg-Veteranen und den Kindern von Kriegsflüchtlingen, zum Beispiel aus dem Kosovo.“"
                            },
                            {
                                "example_id": "cf8be34a-e7e2-4274-907d-828c5a974aa1",
                                "sense_id": "b73fe003-a9a7-3209-8faa-528274b39596",
                                "text": "„Ich fand die Idee ziemlich pervers, dass echte syrische Kriegsflüchtlinge in Deutschland in einer amerikanischen Filmproduktion noch einmal ihre Vertreibung und Flucht, diesmal aber gegen Gage, nachspielten.“"
                            }
                        ],
