                        "sense_id": "b9da60d0-d1bd-3048-acfb-b5937e674e5f",
                        "entry_id": "f972a173-b52a-3e6b-a2f3-2e66b94dacf8",
                        "glosses": [
                            "zu Namibia gehörender, 450 km langer und bis zu 50 km breiter Landzipfel im Nordosten des Landes zwischen Botswana im Süden und Angola und Sambia im Norden"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "04571a1e-4e4d-4bbf-9739-6ee124fcad29",
                                "sense_id": "b9da60d0-d1bd-3048-acfb-b5937e674e5f",
                                "text": "„Wie viele andere Buschstädte, die ich in Namibia sah, schien auch diese Stadt um ihr Überleben zu kämpfen, ein Zwischenstopp für alle Durchreisenden nach Angola und zum Caprivi-Zipfel oder in den Nordosten auf der Schotterstraße nach Tsumkwe.“"
                            },
                            {
                                "example_id": "588f1c85-b11f-4b04-9945-abf050751b25",
                                "sense_id": "b9da60d0-d1bd-3048-acfb-b5937e674e5f",
                                "text": "„Im Gegenzug erhielt es von England die Insel Helgoland vor der norddeutschen KÜste und einen schmalen Landstreifen in Südwestafrika, den sogenannten Caprivi-Zipfel.“"
                            }
                        ],
