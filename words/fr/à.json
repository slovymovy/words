                        "à la soupe"
                    ]
                },
                {
                    "sense_id": "6ff06c01-44b5-3b63-9178-a0eb68236070",
                    "sense_definition": "Suivi d'un infinitif, exprime une action passive qu'il convient ou qu'il reste à réaliser.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "infinitif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il me reste encore beaucoup de devoirs <w>à</w> faire ce soir."
                        },
                        {
                            "text": "Ce vieux meuble est entièrement <w>à</w> repeindre avant de le vendre."
                        }
                    ],
                    "common_phrases": [
                        "reste à faire",
                        "choses à voir"
                    ]
                },
                {
                    "sense_id": "466ad9b1-c688-319b-a1cc-b396d3ed39b9",
                    "sense_definition": "Introduit le complément d'objet indirect ou le destinataire d'une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "syntaxe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique la règle de grammaire <w>à</w> ses nouveaux étudiants."
                        },
                        {
                            "text": "Elle a prêté son livre de contes <w>à</w> une camarade de classe."
                        }
                    ],
                    "common_phrases": [
                        "donner à quelqu'un",
                        "parler à quelqu'un"
                    ]
