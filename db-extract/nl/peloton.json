                        ]
                    },
                    {
                        "translation_id": "bba4e904-6fdf-40c6-aab9-c145298e1a6f",
                        "source_entry_id": "3a473eef-9a7a-35ca-9799-0e8e10df404f",
                        "source_sense_description": "een groep soldaten",
                        "target_lang_word": "peloton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peloton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Petite pelote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0261cd7-1ebe-47f4-9b46-8b03fd1d3956",
                                                "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                                "text": "Ces tribulations l’inquiétaient par le mystère de leur durée indéfinie. Elles se dévidaient comme le peloton de fil rouge enfermé dans une boîte de buis sur le comptoir de madame Magloire, la pâtissière de la place Saint-Exupère."
                                            },
                                            {
                                                "example_id": "c24df719-cd13-4357-a8a1-7fa55b81bd3b",
                                                "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                                "text": "Sous le siège de Tartous Hama, traînait un peloton de la même corde qui avait servi à le ligoter : du septain de fort diamètre."
                                            },
                                            {
                                                "example_id": "7cc70808-3728-43a0-a7e0-1ab0705b5b70",
                                                "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                                "text": "Ce n’est qu’un peloton de graisse, se dit d’un petit oiseau extrêmement gras, comme le sont ordinairement les ortolans et les becfigues, se dit aussi d’un enfant gras."
                                            },
                                            {
                                                "example_id": "dcd03d57-f202-4748-bf6c-40c1ea4a5f99",
                                                "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                                "text": "Se mettre en peloton, ramasser, rassembler ses membres, de manière que le corps forme une sorte de boule."
                                            },
                                            {
                                                "example_id": "36f796c3-ac1a-4214-a80c-5cc4334c3087",
                                                "sense_id": "2e6fd6c8-a20f-363e-98d4-782b712f9d8a",
                                                "text": "Il se met en peloton dans son lit, au lieu de s’étendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7744e0b7-aa89-3d86-bc9c-c9d417a67142",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Balle à jouer à la paume, lorsqu’elle n’est point encore couverte de drap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72e34f31-ab98-3dad-8688-408bb88ba962",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Petit amas de mycélium en forme de pelote."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0bc91bd-d6d3-471d-80d8-73977196f199",
                                                "sense_id": "72e34f31-ab98-3dad-8688-408bb88ba962",
                                                "text": "Chez certaines orchidées, on a pu observer un phénomène particulier de nécrotrophie qui lyse les pelotons, ce qui permet une décharge importante d'éléments nutritifs du champignon à la racine de l'orchidée, les pelotons se reformant au fur et à mesure de la croissance de la racine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c9e1097-8c29-31a8-82c5-7bf16ccfa685",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Petit nombre de personnes réunies en groupe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8cbd310-77c3-46dd-894d-852270c04cd3",
                                                "sense_id": "3c9e1097-8c29-31a8-82c5-7bf16ccfa685",
                                                "text": "Ils étaient sur cette place par pelotons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3105420-9d93-32cc-a7be-7992881f140c",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Petit groupe de soldats, section, subdivision d’une compagnie, d’un escadron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbba2c6-ad3a-445a-944d-5202ed5b330c",
                                                "sense_id": "e3105420-9d93-32cc-a7be-7992881f140c",
                                                "text": "Deux pelotons de laptots renforcèrent la colonne de Pineau, pendant que la réserve composée de l'artillerie et de 4 pelotons de tirailleurs sénégalais, s'organisaient sous la direction du capitaine Vincent."
                                            },
                                            {
                                                "example_id": "5a1e22eb-50e4-4c5e-a40e-13130c04601c",
                                                "sense_id": "e3105420-9d93-32cc-a7be-7992881f140c",
                                                "text": "Moins d’une heure après sa chute, le lieutenant Pelardy, contusionnée, un poignet douloureux, avait repris la tête de son peloton. Elle a chargé comme les autres, le sabre en avant."
                                            },
                                            {
                                                "example_id": "43a4269a-a045-43cf-bdfe-fcc681a1f6ad",
                                                "sense_id": "e3105420-9d93-32cc-a7be-7992881f140c",
                                                "text": "Antoine avait eu de la chance, il avait tiré un bon numéro. Avec le 76, en revanche, Pierrot allait devoir faire son balluchon et rejoindre le plus rapidement possible son régiment, faute de quoi il encourait le peloton pour fait de désertion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d1dd7b-135c-30f0-85b7-a2bc46e48875",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Ellipse de peloton d’exécution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a0c9f9-ffb8-4ddd-bf2f-b54de6c95ba0",
                                                "sense_id": "85d1dd7b-135c-30f0-85b7-a2bc46e48875",
                                                "text": "Et estimez-vous heureux d’être pas considéré comme déserteur ! Là, ça serait le peloton tout de suite. Douze balles dans le buffet ! Ça vous aurait dressé, bon Dieu !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f447a1c-27fb-3872-985f-430db577218c",
                                        "entry_id": "1499fa03-3a93-31ea-853d-e794e61309a1",
                                        "glosses": [
                                            "Le groupe majoritaire des cyclistes qui demeurent ensemble lors d'une course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5fa7cf5-61ea-4dcf-bca1-fb427e561745",
                                                "sense_id": "3f447a1c-27fb-3872-985f-430db577218c",
                                                "text": "Un groupe de baroudeurs, sans tricolore, s’est échappé par l'avant. Mais le peloton des meilleurs a décidé de chasser les courageux. Sans pitié."
                                            },
                                            {
                                                "example_id": "016bd6f1-3d53-4c85-8212-56f9a84aa958",
                                                "sense_id": "3f447a1c-27fb-3872-985f-430db577218c",
                                                "text": "Les premiers coureurs furent enfin en vue. L’avant-garde passa comme un nuage couleur magenta, suivie par le peloton paré de toutes les couleurs de l’arc-en-ciel."
                                            }
                                        ]
                                    },
