                "senses": [
                    {
                        "sense_id": "6f09fee7-e5bc-3b64-8002-67b35fe5e8a9",
                        "entry_id": "0f753d7d-e0b0-3266-831d-ee026aa49783",
                        "glosses": [
                            "Briser et défoncer quelque chose."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bd6ea19e-c16f-3b46-92bd-49011869d3e4",
                        "entry_id": "0f753d7d-e0b0-3266-831d-ee026aa49783",
                        "glosses": [
                            "Quitter, partir, fuir ; dégager."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c3221ae6-3081-4c6c-ba33-3dbfc7c08934",
                                "sense_id": "bd6ea19e-c16f-3b46-92bd-49011869d3e4",
                                "text": "Il s’était levé lentement. Il avait ouvert la porte en ne la quittant pas des yeux, comme un dompteur de fauve.\n— Décâlisse."
                            },
                            {
                                "example_id": "d1289b67-34c4-4db2-bacb-00e2ae0ab7ec",
                                "sense_id": "bd6ea19e-c16f-3b46-92bd-49011869d3e4",
                                "text": "« […]. Parce que, dans la vie, tu ne peux pas te promener, puis aller voir quelqu’un juste à côté et lui dire “décâlisse, le fif”. Ça ne se fait pas. »"
                            },
                            {
                                "example_id": "ab127fac-f480-48a0-935a-f6373ad3a1b4",
                                "sense_id": "bd6ea19e-c16f-3b46-92bd-49011869d3e4",
                                "text": "Vite! On décâlisse!"
                            }
                        ]
                    }
                ],
