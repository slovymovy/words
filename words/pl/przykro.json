    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1e7234a8-0bd1-3019-bfa9-22f611916fd6",
                    "sense_definition": "wyraża smutek, żal, współczucie lub przeprosiny w orzeczeniach bezosobowych (np. w zwrocie „jest mi przykro”)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bardzo mi <w>przykro</w>, że spóźniłem się na nasze spotkanie.",
                            "target_lang_translations": {
                                "ru": "Мне очень <w>жаль</w>, что я опоздал на нашу встречу."
                            }
                        },
                        {
                            "text": "Jest mi niezmiernie <w>przykro</w> z powodu twojej straty.",
                            "target_lang_translations": {
                                "ru": "Мне бесконечно <w>жаль</w> в связи с вашей утратой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jest mi przykro",
                        "bardzo mi przykro"
                    ],
                    "target_lang_definitions": {
                        "ru": "выражает грусть, сожаление, сочувствие или извинение в безличных конструкциях (напр., «мне жаль»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "выражение сожаления или сочувствия (jest mi przykro)"
                            },
                            {
                                "target_lang_word": "жалко",
                                "target_lang_sense_clarification": "разговорный синоним к «жаль»"
                            },
                            {
                                "target_lang_word": "досадно",
                                "target_lang_sense_clarification": "выражение огорчения, досады"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ccf24a9-92b6-3c07-b45e-f70c453c6a6c",
                    "sense_definition": "w sposób przykry, nieprzyjemny, bolesny lub sprawiający dyskomfort",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej słowa zabrzmiały wyjątkowo <w>przykro</w> i zraniły wszystkich obecnych.",
                            "target_lang_translations": {
                                "ru": "Её слова прозвучали исключительно <w>неприятно</w> и ранили всех присутствующих."
                            }
                        },
                        {
                            "text": "W pokoju pachniało dość <w>przykro</w>, więc od razu otworzyłem okno.",
                            "target_lang_translations": {
                                "ru": "В комнате пахло довольно <w>неприятно</w>, поэтому я сразу открыл окно."
                            }
                        }
                    ],
                    "antonyms": [
                        "przyjemnie",
                        "miło"
                    ],
                    "common_phrases": [
                        "przykro pachnieć",
                        "przykro zabrzmieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "неприятным, болезненным, тягостным образом или так, что вызывает дискомфорт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприятно",
                                "target_lang_sense_clarification": "вызывая неприятные ощущения, дискомфорт"
                            },
                            {
                                "target_lang_word": "обидно",
                                "target_lang_sense_clarification": "ранящее, задевающее"
                            },
                            {
                                "target_lang_word": "досадно",
                                "target_lang_sense_clarification": "вызывая раздражение или неудовольствие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
