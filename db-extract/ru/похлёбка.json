                    }
                ],
                "senses": [
                    {
                        "sense_id": "db57fc23-9f8e-3d87-b379-afcc6a5fda64",
                        "entry_id": "653b7256-2c4d-339e-b2a8-15bb74a4f21b",
                        "glosses": [
                            "кулин. разновидность супа, представляющая собой лёгкий овощной, реже — мясной или рыбный, отвар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d007161b-8338-42bc-9ba8-fc8e6807a279",
                                "sense_id": "db57fc23-9f8e-3d87-b379-afcc6a5fda64",
                                "text": "На всё способная Теодора сделала похлёбку и жаркое."
                            },
                            {
                                "example_id": "ffafd50d-d84f-450e-ab26-80e4cb6fde5d",
                                "sense_id": "db57fc23-9f8e-3d87-b379-afcc6a5fda64",
                                "text": "Акулина превосходно готовила кулебяки, всякие похлёбки, холодные и жаркие, квасы, меды, мочила отличным образом яблоки и умела сохранять свежие до новых."
                            },
                            {
                                "example_id": "a7017a77-6de6-46aa-a7a6-c6a5f79aca82",
                                "sense_id": "db57fc23-9f8e-3d87-b379-afcc6a5fda64",
                                "text": "Ужин в этот день был отменный: похлёбка из гуся с диким луком, шашлык из оленины и ломтики медвежатины."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fb9def8-81c9-391d-a53c-1a71847013d5",
                        "entry_id": "653b7256-2c4d-339e-b2a8-15bb74a4f21b",
                        "glosses": [
                            "разг., пренебр. плохой суп"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1751601-5125-4f85-ab9e-263f5d7ad6fd",
                        "source_entry_id": "653b7256-2c4d-339e-b2a8-15bb74a4f21b",
                        "source_sense_description": "вид супа",
                        "target_lang_word": "pottage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pottage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6063b289-b575-39e8-a000-4854b64369ea",
                                        "entry_id": "45dfe985-fac2-3400-a683-5d67806e3cc9",
                                        "glosses": [
                                            "A thick soup or stew, made by boiling vegetables, grains, and sometimes meat or fish, a staple food throughout Europe in the Middle Ages."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79242be1-d65a-47c2-a7a2-92ee6a33063f",
                                                "sense_id": "6063b289-b575-39e8-a000-4854b64369ea",
                                                "text": "And they have not in many places, neither pease ne beans ne none other pottages but the broth of the flesh."
                                            },
                                            {
                                                "example_id": "4be1b3d9-9562-44f8-b87c-133ca85ceefa",
                                                "sense_id": "6063b289-b575-39e8-a000-4854b64369ea",
                                                "text": "He is a portly man, though he lives on pottage and mashes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63dd48f-37d0-3a0a-bf8e-d65d418fcb9c",
                                        "entry_id": "45dfe985-fac2-3400-a683-5d67806e3cc9",
                                        "glosses": [
                                            "An oatmeal porridge."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d67e6a1-e31c-33da-b13a-7c42e4ad6763",
                                        "entry_id": "45dfe985-fac2-3400-a683-5d67806e3cc9",
                                        "glosses": [
                                            "A dish made by stewing plantain, beans, or yam in a tomato- and pepper-based sauce."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8656d960-297b-4874-a870-ef25ccfea2c9",
                        "source_entry_id": "653b7256-2c4d-339e-b2a8-15bb74a4f21b",
                        "source_sense_description": "вид супа",
                        "target_lang_word": "brouet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brouet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a77a292-135e-352e-be3e-c92b8d3f35cf",
                                        "entry_id": "c1995616-2ab6-3bce-84ab-ed871fcc3700",
                                        "glosses": [
                                            "Bouillon, aliment semi-liquide de l'Antiquité et de l'ancienne France."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e18767c-9214-4c49-b869-ac3fffa7f89b",
                                                "sense_id": "3a77a292-135e-352e-be3e-c92b8d3f35cf",
                                                "text": "Brouet noir, mets simple et grossier des anciens Spartiates."
                                            },
                                            {
                                                "example_id": "7b533ce4-2e2c-48c1-ae9e-e06d735065d5",
                                                "sense_id": "3a77a292-135e-352e-be3e-c92b8d3f35cf",
                                                "text": "Le galant pour toute besogne,\nAvait un brouet clair ; il vivait chichement.\nCe brouet fut par lui servi sur une assiette :\nLa Cigogne au long bec n’en put attraper miette."
                                            },
                                            {
                                                "example_id": "d7688524-9c44-4d7a-99b1-9abe25b0c536",
                                                "sense_id": "3a77a292-135e-352e-be3e-c92b8d3f35cf",
                                                "text": "Je me demande ce que nous faisons ici, se lamentait pour la centième fois Tom Wills, en repoussant l'odieux brouet aux féveroles que l'on venait de leur servir sous le nom pompeux d'irish stew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e491f6-6d18-3f55-9ed1-63beb77efd32",
                                        "entry_id": "c1995616-2ab6-3bce-84ab-ed871fcc3700",
                                        "glosses": [
                                            "Sorte de mauvais ragoût, aliment détestable et peu consistant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0923231-70a5-4e6c-8a12-9ab70ddc0796",
                                                "sense_id": "27e491f6-6d18-3f55-9ed1-63beb77efd32",
                                                "text": "S'en aller en brouet d'andouilles, n'aboutir à rien de précis."
                                            },
                                            {
                                                "example_id": "205446f7-706a-46d7-9637-f8972a6429a6",
                                                "sense_id": "27e491f6-6d18-3f55-9ed1-63beb77efd32",
                                                "text": "Tous les officiers de la garnison se trouvaient désormais réunis, à l’exception de leurs camarades mariés, occupés à déguster chez eux les joies du brouet familial."
                                            },
                                            {
                                                "example_id": "6caa62ce-3953-4bd4-bb75-e6ddfdbefd1d",
                                                "sense_id": "27e491f6-6d18-3f55-9ed1-63beb77efd32",
                                                "text": "Ils avaient dîné d’un infâme brouet : quand Mortensen avait vu arriver la bouffe, il avait immédiatement pensé à de la nourriture pour chiens ou pour chats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef42035-c25d-3e81-8ed9-2503d1a53b6a",
                                        "entry_id": "c1995616-2ab6-3bce-84ab-ed871fcc3700",
                                        "glosses": [
                                            "Quelque chose de très mauvaise qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25170f6-322f-4cf2-9d5d-b20f9d0a4e39",
                                                "sense_id": "1ef42035-c25d-3e81-8ed9-2503d1a53b6a",
                                                "text": "Un clip à étage, avec ascenseur-suppositoire de synthèse et, en accompagnement, un infâme brouet sonore musical."
                                            },
                                            {
                                                "example_id": "4deffe39-d6cb-4f84-a3b7-a48d3fd07597",
                                                "sense_id": "1ef42035-c25d-3e81-8ed9-2503d1a53b6a",
                                                "text": "Les composants du précipité de Mai commencent à réagir ; les ingrédients de l'indigeste brouet qui sera bientôt servi au pouvoir mijotent. Tout se met en place sous les yeux des autorités incrédules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
