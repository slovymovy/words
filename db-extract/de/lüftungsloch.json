                "senses": [
                    {
                        "sense_id": "30801e60-a671-30de-aacc-07aa4712fc96",
                        "entry_id": "1917fda9-23de-35f7-86d6-e622b2787fad",
                        "glosses": [
                            "vorgesehene Öffnung zum aus- und eintreten der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c62cef-b6a0-44f9-aeb1-4a8e0e1d8554",
                                "sense_id": "30801e60-a671-30de-aacc-07aa4712fc96",
                                "text": "„Ein Lüftungsloch ist ein Hinweis dafür, dass wir uns über dem weitläufigen Stollensystem eines Bergwerks bewegen.“"
                            },
                            {
                                "example_id": "3fd44269-1e22-4b7f-a22e-952961830c33",
                                "sense_id": "30801e60-a671-30de-aacc-07aa4712fc96",
                                "text": "„Wenn Lüftungslöcher schließbar sind, wird die Fläche bei geöffneten Lüftungslöchern gemessen.“"
                            },
                            {
                                "example_id": "c3be5b8a-4f6d-4cb9-a04b-378551872354",
                                "sense_id": "30801e60-a671-30de-aacc-07aa4712fc96",
                                "text": "„Der Pfropfen sollte in das Lüftungsloch eingeschlagen werden, dass grob die Abflussrichtung des abgehenden Rohres angibt.“"
                            },
                            {
                                "example_id": "8202ebde-7f66-4c9a-bf66-e32899646db2",
                                "sense_id": "30801e60-a671-30de-aacc-07aa4712fc96",
                                "text": "„Hierbei werden die in das Paneel gefrästen Lüftungslöcher von den vorhängenden Lamellen optisch verdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
