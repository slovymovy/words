                "senses": [
                    {
                        "sense_id": "dd660f24-7dfe-33c4-b142-0ec0f932e8f3",
                        "entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "glosses": [
                            "To associate with others in a brotherly or friendly manner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5efdfe81-47ff-3e68-9654-6715c5387429",
                        "entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "glosses": [
                            "To associate as friends with an enemy, in violation of duty."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ab767678-c3a1-4448-8bc0-52612d7c1fb0",
                                "sense_id": "5efdfe81-47ff-3e68-9654-6715c5387429",
                                "text": "Now in this world it is never wise to meddle with such things. It's better to leave them as they are. No one ever had any good come to him from fraternizing with too great familiarity with the unknown; and it's a very good thing that the children from The Other Side are as shy as they are, as Alice found out through Evelyn Dearie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba07d690-f53d-3798-9f6f-dcf5c74f7b05",
                        "entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "glosses": [
                            "To socialize in confidentiality."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "48ed59bd-2af1-3359-a1ab-3a9c1dcf74f4",
                        "entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "glosses": [
                            "To have an intimate or sexual relationship with a forbidden party."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cec4d47-2f76-4afc-9107-cf7e5bf0acf6",
                        "source_entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "source_sense_description": "to associate with others in a brotherly manner",
                        "target_lang_word": "fraterniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraterniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db70c447-e1ad-376d-bea1-e84823ea16c1",
                                        "entry_id": "4dc0a3c8-bf71-3162-81bc-14ba7a6e02fc",
                                        "glosses": [
                                            "Se promettre ou se manifester mutuellement une amitié fraternelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6894a2c-88f8-4887-a721-f5a9af9ea916",
                                                "sense_id": "db70c447-e1ad-376d-bea1-e84823ea16c1",
                                                "text": "À quelques pas de lui, le perfide timonier et le matelot du Saint-Ferdinand qui vantait naguère la puissance du capitaine parisien, fraternisaient avec les corsaires."
                                            },
                                            {
                                                "example_id": "801a1bce-3bf5-4ce4-b42b-5d9d133e954f",
                                                "sense_id": "db70c447-e1ad-376d-bea1-e84823ea16c1",
                                                "text": "Déjà, depuis le début de l'année, des fédérations avaient lieu de village à village, de ville à ville. Les enfants, les jeunes filles, les vieillards couronnés d'épis de blé et de feuilles de chêne venaient fraterniser sous la voûte du ciel."
                                            },
                                            {
                                                "example_id": "8625e530-6c2b-44a3-ab0c-5efc91284cdc",
                                                "sense_id": "db70c447-e1ad-376d-bea1-e84823ea16c1",
                                                "text": "Je suis entré ce soir au café « Sturm ». Les Berlinois de la Société ne fréquentent jamais ce dancing vulgaire où la jeunesse brune et les « sous-offs » de la garnison fraternisent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6230cb2b-ac0a-48f1-b879-cf8a6914f69f",
                        "source_entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "source_sense_description": "to associate with others in a brotherly manner",
                        "target_lang_word": "sich verbrüdern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5063fae-79dc-45db-803f-34f65621ab21",
                        "source_entry_id": "9a05b0aa-52cd-3507-b420-6b979f0b72e2",
                        "source_sense_description": "to associate with others in a brotherly manner",
                        "target_lang_word": "bratać się",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
