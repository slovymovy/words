                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ee2b3ef-ebf8-4a36-9906-75f0b6ec31e0",
                        "source_entry_id": "bb82af77-2af8-31f1-9262-393d2a8de940",
                        "source_sense_id": "b55dc011-cac0-3d09-ab06-477b8b3e0c95",
                        "target_lang_word": "Linguist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linguist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                        "entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                                        "glosses": [
                                            "Person, die sich wissenschaftlich mit Sprache befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21630e5b-c31c-40ea-b0d8-9e0dc142c455",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "Die meisten Beiträge im Wiktionary werden nicht von Linguisten, sondern von Laien verfasst."
                                            },
                                            {
                                                "example_id": "65866a4b-a17e-4c33-8b12-c2de02529076",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Keine andere Sprache, haben Linguisten festgestellt, vermittelt im Schnitt mehr Sinn pro Buchstabe als das Finnische.“"
                                            },
                                            {
                                                "example_id": "39785dd7-556f-4b4a-996c-46e2aacc6293",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Linguisten sind darauf angewiesen, viele Vergleichsmöglichkeiten zu haben.“"
                                            },
                                            {
                                                "example_id": "d275de13-ffe4-4226-92df-15df3d09666f",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Alarmiert von Studien, die einen erschreckenden Verfall der Orthografie bei deutschen Schülern offenbaren, warnen Linguisten und Didaktiker, Pädagogen und Hirnforscher: Vor allem Risikokinder, die in einer spracharmen Umgebung oder mit Deutsch als zweiter Sprache aufwachsen, lernen so möglicherweise niemals richtig schreiben.“"
                                            },
                                            {
                                                "example_id": "041f2e25-61ca-4709-a6a6-50f7f38dad30",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Linguistinnen und Linguisten verfügen idealerweise über vielfältige sprachliche Register und Stile, die es ihnen ermöglichen, fachliche Inhalte adressatengerecht zu kommunizieren, und sie wissen, welche Form welchem Adressatenkreis gegenüber angemessen ist.“"
                                            },
                                            {
                                                "example_id": "f8d86db1-98ce-412b-92be-44e107d214ec",
                                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                                "text": "„Die Linguisten haben herausgefunden, welche Sprachen miteinander verwandt sind und nach welchen Gesetzmäßigkeiten sich Aussprache und Grammatik im Lauf der Zeit verändert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9d5b1fb-5db6-499d-a292-7fedb030a6ac",
                        "source_entry_id": "bb82af77-2af8-31f1-9262-393d2a8de940",
                        "source_sense_id": "b55dc011-cac0-3d09-ab06-477b8b3e0c95",
                        "target_lang_word": "лингви́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лингви́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7bc51e-e442-3285-9e70-99b313ef1770",
                                        "entry_id": "d417d4e0-4b58-3471-999b-ef193413de52",
                                        "glosses": [
                                            "учёный — специалист по лингвистике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8e09a1-c9b1-448e-bb0a-906e12ca318f",
                                                "sense_id": "fc7bc51e-e442-3285-9e70-99b313ef1770",
                                                "text": "Я не лингвист, мне некогда было изучать; полагаюсь на врождённое чувство языка."
                                            },
                                            {
                                                "example_id": "9ae05ec7-0a7e-4534-9520-999e3370f884",
                                                "sense_id": "fc7bc51e-e442-3285-9e70-99b313ef1770",
                                                "text": "Образованный лингвист не знает очень многого и старается никогда об этом своем незнании не забывать."
                                            },
                                            {
                                                "example_id": "eccbc78d-40db-4102-9d2a-d1daf420963c",
                                                "sense_id": "fc7bc51e-e442-3285-9e70-99b313ef1770",
                                                "text": "О типичных ошибках лингвистов-любителей и опасности дилетантского подхода к изучению языка рассказывает известный лингвист Андрей Анатольевич Зализняк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b532ae1-d901-3489-af1d-1c5e5d7a08b2",
                                        "entry_id": "d417d4e0-4b58-3471-999b-ef193413de52",
                                        "glosses": [
                                            "разг. человек, знающий много языков; полиглот"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb0404c-d089-457e-9bcb-b0f8ee0f8a8f",
                                                "sense_id": "9b532ae1-d901-3489-af1d-1c5e5d7a08b2",
                                                "text": "В конце строя двигался как иноходец малахольный Вася Куницын, гениальный лингвист, который знал штук двадцать языков и среди них хинди, литовский и суахили и был абсолютно неприспособлен к жизни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
