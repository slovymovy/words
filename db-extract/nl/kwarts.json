        "nl-extract.jsonl": [
            {
                "entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                "word": "kwarts",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00aba93f-66ec-3284-8b89-ace5af09afc3",
                        "entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                        "glosses": [
                            "een vorm van siliciumdioxide, SiO₂ in kristalvorm met grote kristallen of als microscopisch kleine aggregaten"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1b729b2-9540-4048-a8b3-af79527d665a",
                        "source_entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                        "source_sense_id": "00aba93f-66ec-3284-8b89-ace5af09afc3",
                        "source_sense_description": "een vorm van siliciumdioxide",
                        "target_lang_word": "Quarz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Mineral, das in reinem Zustand farblos und durchscheinend ist und aus Siliziumdioxid besteht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e49f34-d7eb-495f-bb40-c6ef05cfaa49",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "Quarz ist eines der häufigsten Mineralien in der Erdkruste."
                                            },
                                            {
                                                "example_id": "63f3de0b-9f65-45a8-971c-c1cefbe4f66f",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "„Es war keine geringe Arbeit, vor dem Aufkleben der Etiketten die Namen der Gesteine festzustellen; die Verschiedenheit der Farben und des Korns ließ sie Tonerde und Mergel, Granit und Gneis, Quarz und Kalkstein verwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Kristall aus Quarz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2ae25b-562f-4709-ae51-cda1cfd2e5cc",
                                                "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                                "text": "„Reiner Quarz ist vollkommen transparent und farblos und wird, wenn er gut ausgebildete Kristalle entwickelt, als Bergkristall bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Elektronisches Bauelement; ein speziell geschnittener Quarzkristall mit angebrachten Elektroden, dessen piezoelektrische Eigenschaften zur Frequenzstabilisierung elektrischer Schwingungen benutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312e8257-9a47-47bd-8d98-09cc4a81dd1f",
                                                "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                                "text": "„Die piezoelektrischen Eigenschaften des Quarzes werden bei Schwingquarzen ausgenutzt, die ähnlich einer Stimmgabel bei Erregung durch eine elektrische Spannung mit einer festen Frequenz mechanisch schwingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39651235-cd96-492a-a35d-bd6899611a86",
                        "source_entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                        "source_sense_id": "00aba93f-66ec-3284-8b89-ace5af09afc3",
                        "source_sense_description": "een vorm van siliciumdioxide",
                        "target_lang_word": "quartz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quartz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "The most abundant mineral on the earth's surface, of chemical composition silicon dioxide, SiO₂. It occurs in a variety of forms, both crystalline and amorphous. Found in every environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59ddde1-d3f5-4d7a-b092-b2550b761f34",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "The telescope and collimator have each an object-glass consisting of a single lens of quartz 1½ inch diameter and a focal length of 18½ inches for the sodium yellow light, but not more than 16 inches for the highest rays measured."
                                            },
                                            {
                                                "example_id": "d047abc9-5a79-40e7-8546-aea3fb2f54b2",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "Subsequently, the old Malay brought him the present specimen in a state of torpidity, telling him he had found it in a cavity of the quartz reef."
                                            },
                                            {
                                                "example_id": "07799cd9-666e-4635-a24b-bc4340a39776",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "My meat eats me. Who waits at the gate? / Mother of quartz, your words writhe into my ear. / Renew the light, lewd whisper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8cf96da-1039-3a4d-b998-c0ef82e9b45c",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "Crystal meth: methamphetamine hydrochloride."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1f56f8-808a-4e32-8133-83c198fe8bc8",
                        "source_entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                        "source_sense_id": "00aba93f-66ec-3284-8b89-ace5af09afc3",
                        "source_sense_description": "een vorm van siliciumdioxide",
                        "target_lang_word": "rock-crystal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2de0ad94-e32d-4e0a-b734-cac6c3059e4e",
                        "source_entry_id": "d3097c8f-8e6c-353e-8c77-2fd1c125cf14",
                        "source_sense_id": "00aba93f-66ec-3284-8b89-ace5af09afc3",
                        "source_sense_description": "een vorm van siliciumdioxide",
                        "target_lang_word": "quartz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quartz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "308bde15-8157-349b-b9cd-16372e5ea144",
                                        "entry_id": "13e8ea34-ed4c-3962-a2d0-2d1a0fca40f9",
                                        "glosses": [
                                            "Espèce minérale, du groupe des silicates, sous-groupe des tectosilicates composé de dioxyde de silicium de formule SiO₂. Le quartz est le minéral le plus commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc9d246b-e6d5-44da-ae54-60338c41ad75",
                                                "sense_id": "308bde15-8157-349b-b9cd-16372e5ea144",
                                                "text": "Les minéraux qu’elle renferme sont le quartz, l’albite, des pyroxènes sodiques, l’ægyrine, et l’acmite supposées, zirconifères et cérifères."
                                            },
                                            {
                                                "example_id": "077636fd-9d4b-4b75-8931-2df9dc6cef6c",
                                                "sense_id": "308bde15-8157-349b-b9cd-16372e5ea144",
                                                "text": "Les bandes feldspathiques sont composées d’une mosaïque de petits cristaux pseudo-rectangulaires d’orthose (oligoclase rare) avec peu de quartz."
                                            },
                                            {
                                                "example_id": "0f95bacd-d90a-4ac8-925f-3779c9c35f17",
                                                "sense_id": "308bde15-8157-349b-b9cd-16372e5ea144",
                                                "text": "Le quartz terrestre provient surtout des roches granitiques, répandues dans la croûte continentale plus récente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cdf9d23-cdf7-3ba1-9a7f-d2e7e3b1237c",
                                        "entry_id": "13e8ea34-ed4c-3962-a2d0-2d1a0fca40f9",
                                        "glosses": [
                                            "Composant dont la propriété est d’osciller à une fréquence stable lorsqu’il est stimulé. Ses propriétés piézoélectriques permettent de coupler ses oscillations mécaniques, dont la fréquence est très stable, à un circuit électronique, ce qui permet de stabiliser la fréquence d’un oscillateur électronique. On peut également réaliser des filtres à partir de ces composants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e28e830-f34a-4b2c-b7c7-3ec65c3b2e27",
                                                "sense_id": "7cdf9d23-cdf7-3ba1-9a7f-d2e7e3b1237c",
                                                "text": "Les services allemands de l’Abwehr ne peuvent donc pas utiliser un poste anglais pour envoyer de faux messages et tromper l’ennemi, à moins de saisir en même temps de l’opérateur avec son quartz et l’obliger à manipuler des messages truqués sous la menace de la torture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2b1210-7538-33ed-9531-15304be00dfb",
                                        "entry_id": "13e8ea34-ed4c-3962-a2d0-2d1a0fca40f9",
                                        "glosses": [
                                            "Meuble représentant le cristal du même nom dans les armoiries. Il est rarement représenté seul, mais plutôt sous forme d’un ensemble posé en faisceau. À rapprocher de diamant, émeraude et rubis."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218704be-5a6c-4579-a9b5-ee5dc85a58c3",
                                                "sense_id": "ae2b1210-7538-33ed-9531-15304be00dfb",
                                                "text": "Coupé : au premier parti au I d’azur à l’arbre d’argent et au II fascé ondé d’argent et d’azur, au second de sable à l’ensemble de pierres de quartz en faisceau d’argent, qui est de la commune de Chaillac de l’Indre → voir illustration « armoiries avec du quartz »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
