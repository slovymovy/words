                        "entry_id": "05c5d8aa-59be-33ea-b8ad-e2931a7c373e",
                        "glosses": [
                            "na skutek mrozu stwardnieć w dużej ilości lub w wielu miejscach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a648623-f5b7-4d24-9f8a-3ea22a837d43",
                                "sense_id": "d020df00-7f35-3e80-a347-a4bce49fdff5",
                                "text": "W bruzdach woda pozamarzała, ale kiedy się po nich stąpało, nogi grzęzły w lodowatej mazi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
