                                "target_senses": [
                                    {
                                        "sense_id": "7461c271-a9a7-3acc-b70a-3b88ad18078a",
                                        "entry_id": "5d886319-0100-3d26-9445-22eaffbb3564",
                                        "glosses": [
                                            "Any of various deciduous trees of the genus Tilia, having heart-shaped leaves."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4c3012-fa61-4473-a13f-cf877f4cdc16",
                                                "sense_id": "7461c271-a9a7-3acc-b70a-3b88ad18078a",
                                                "text": "The linden or lime tree is the favourite haunt of the Elves and cognate beings; and it is not safe to be near it after sunset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc5abf2e-aa79-3d7e-97a9-67de74227ec3",
                                        "entry_id": "5d886319-0100-3d26-9445-22eaffbb3564",
                                        "glosses": [
                                            "The soft wood of such trees."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
