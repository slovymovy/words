{
    "word_family": [
        "human",
        "humanity",
        "humanize",
        "humanoid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72a257ca-61a1-34b2-a3b5-86361e200ff2",
                    "sense_definition": "The human race in its entirety.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One small step for a man can be a giant leap for <w>mankind</w>.",
                            "target_lang_translations": {
                                "tr": "Bir insan için küçük bir adım, <w>insanlık</w> için dev bir adım olabilir."
                            }
                        },
                        {
                            "text": "Wood was <w>mankind</w>'s first industrial fuel.",
                            "target_lang_translations": {
                                "tr": "Odun, <w>insanoğlunun</w> ilk sanayi yakıtıydı."
                            }
                        }
                    ],
                    "synonyms": [
                        "humankind",
                        "humanity",
                        "the human race"
                    ],
                    "common_phrases": [
                        "benefit of mankind",
                        "history of mankind"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tüm insan türü, insanların tümü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "insanlık",
                                "target_lang_sense_clarification": "tüm insanlar, beşeriyet"
                            },
                            {
                                "target_lang_word": "insanoğlu",
                                "target_lang_sense_clarification": "insan ırkı, beşer"
                            },
                            {
                                "target_lang_word": "âdemoğlu",
                                "target_lang_sense_clarification": "insan soyu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d978f8b5-9c0c-366a-8032-3917f54d65e4",
                    "sense_definition": "Human feelings or the quality of being humane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "humanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Justice is a virtue that appeals to the better side of <w>mankind</w>.",
                            "target_lang_translations": {
                                "tr": "Adalet, <w>insanlığın</w> daha iyi tarafına hitap eden bir erdemdir."
                            }
                        },
                        {
                            "text": "He showed great <w>mankind</w> in his treatment of the prisoners.",
                            "target_lang_translations": {
                                "tr": "Mahkûmlara olan muamelesinde büyük bir <w>insaniyet</w> gösterdi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İnsanca duygular veya merhametli, insancıl olma niteliği."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "insanlık",
                                "target_lang_sense_clarification": "insaniyet, merhamet"
                            },
                            {
                                "target_lang_word": "insaniyet",
                                "target_lang_sense_clarification": "insancıllık, merhamet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b5f99a9-05df-3be8-a826-352a83a5e995",
                    "sense_definition": "Men collectively, as opposed to women.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law was written to govern <w>mankind</w> in ancient times.",
                            "target_lang_translations": {
                                "tr": "Yasa, eski zamanlarda <w>erkekleri</w> yönetmek için yazılmıştı."
                            }
                        },
                        {
                            "text": "He compared the roles of <w>mankind</w> and womankind in society.",
                            "target_lang_translations": {
                                "tr": "Toplumda <w>erkeklerin</w> ve kadınların rollerini karşılaştırdı."
                            }
                        }
                    ],
                    "antonyms": [
                        "womankind",
                        "womenkind"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is considered archaic or dated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kadınların karşıtı olarak toplu halde erkekler."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "erkekler",
                                "target_lang_sense_clarification": "toplu olarak erkek cinsi"
                            },
                            {
                                "target_lang_word": "erkek cinsi",
                                "target_lang_sense_clarification": "kadınlar haricindeki cinsiyet grubu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9975da4a-692e-3f8a-bf45-2971089cea51",
                    "sense_definition": "The 114th sura of the Quran.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_text",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The final chapter of the Quran is known as <w>Mankind</w>.",
                            "target_lang_translations": {
                                "tr": "Kur'an'ın son suresi <w>Nas Suresi</w> olarak bilinir."
                            }
                        },
                        {
                            "text": "Scholars often study the meaning behind the sura <w>Mankind</w>.",
                            "target_lang_translations": {
                                "tr": "Alimler genellikle <w>Nas</w> suresinin ardındaki anlamı inceler."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kur'an-ı Kerim'in 114. suresi (Nas Suresi)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Nas Suresi",
                                "target_lang_sense_clarification": "Kur'an'ın son suresi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}