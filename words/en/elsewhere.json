                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She often dreamed of a beautiful <w>elsewhere</w> far away from the noisy city.",
                            "target_lang_translations": {
                                "ru": "Она часто мечтала о прекрасных <w>иных краях</w> вдалеке от шумного города.",
                                "zh": "她常常梦想着一个远离喧嚣城市的美丽<w>异地</w>。"
                            }
                        },
                        {
                            "text": "The novel describes a mysterious <w>elsewhere</w> that exists only in the imagination.",
                            "target_lang_translations": {
                                "ru": "Роман описывает таинственное <w>иное место</w>, которое существует только в воображении.",
