                        "entry_id": "028b0da4-5c33-3c2b-bb1b-7927bc83da56",
                        "glosses": [
                            "Technicien en identification criminelle, qui intervient sur les scènes de crime pour effectuer les actes de police technique et scientifique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876b86a7-9ebc-4ca7-a972-197fc2b26402",
                                "sense_id": "69271e2d-2e63-339b-acb5-31c5197d34a3",
                                "text": "Si des indices sont relevés, des prélèvements sont réalisés par les techniciens en identification criminelle (TIC)."
                            },
                            {
                                "example_id": "7bed2156-381c-4e67-b75d-0098716abcc0",
                                "sense_id": "69271e2d-2e63-339b-acb5-31c5197d34a3",
                                "text": "Le Technicien en Identification Criminelle (TIC), intervient sur les scènes d’infractions."
                            },
                            {
                                "example_id": "8d1ca6da-33a8-43ce-8ff5-fbe07ed87f22",
                                "sense_id": "69271e2d-2e63-339b-acb5-31c5197d34a3",
                                "text": "Le salaire d’un TIC, comme pour tout fonctionnaire de Police ou officier de Gendarmerie, dépend de son grade et de son ancienneté."
                            }
                        ]
                    }
                ],
