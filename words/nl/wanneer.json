                                "de": "Ich rufe dich an, <w>wenn</w> ich zu Hause bin.",
                                "fr": "Je t'appelle <w>quand</w> je serai à la maison.",
                                "it": "Ti chiamo <w>quando</w> arrivo a casa.",
                                "cs": "Zavolám ti, <w>až</w> budu doma.",
                                "tr": "Eve vardığım <w>zaman</w> seni arayacağım.",
                                "es": "Te llamaré <w>cuando</w> llegue a casa."
