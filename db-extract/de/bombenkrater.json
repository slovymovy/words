                "senses": [
                    {
                        "sense_id": "5039698a-e338-3ecf-a30b-2a17f045bdb9",
                        "entry_id": "73da9dc1-2d63-3159-9e82-0039657d0752",
                        "glosses": [
                            "großes Erdloch, verursacht durch die Explosion einer Bombe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68963a28-7a17-45ba-b693-17e1a40fbf39",
                                "sense_id": "5039698a-e338-3ecf-a30b-2a17f045bdb9",
                                "text": "„Abgesehen von einigen Bombenkratern finden sich auf der Insel kaum historische Spuren.“"
                            },
                            {
                                "example_id": "6f249f51-054c-41b6-bb61-9503098f3583",
                                "sense_id": "5039698a-e338-3ecf-a30b-2a17f045bdb9",
                                "text": "„Unwillkürlich suchten sie nach frischen Bombenkratern.“"
                            },
                            {
                                "example_id": "5f14fd43-5d9c-48e0-99c8-a7687269fc81",
                                "sense_id": "5039698a-e338-3ecf-a30b-2a17f045bdb9",
                                "text": "„Der Bombenkrater war bereits verschwunden, und nur wenige Passanten blieben für einen kurzen Augenblick stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
