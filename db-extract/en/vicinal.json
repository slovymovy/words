                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a30b629-1759-3db1-a5b3-06e19914986c",
                                        "entry_id": "3136a963-89e7-3886-a5f7-6bcdb8650074",
                                        "glosses": [
                                            "Qui concerne le voisinage."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecb910e-3ca9-4631-95df-896e55b2b813",
                                                "sense_id": "8a30b629-1759-3db1-a5b3-06e19914986c",
                                                "text": "Ce chemin, dit vicinal, courant entre les enclos des paysans, joignait, une demi-lieue plus loin, la grande route du Havre à Fécamp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e31e250-f635-3d12-a0f5-afbc9beb99a3",
                                        "entry_id": "3136a963-89e7-3886-a5f7-6bcdb8650074",
                                        "glosses": [
                                            "Se dit des chemins qui servent de moyen de communication entre plusieurs villages."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be05fd37-87c0-4383-823b-621f42b9538d",
                                                "sense_id": "3e31e250-f635-3d12-a0f5-afbc9beb99a3",
                                                "text": "Juste en face de la gare, au milieu de la rue, il y avait un gros tramway vicinal peint en vert et noir."
                                            },
                                            {
                                                "example_id": "779c95f6-5c69-4f5a-8706-ee907890c05f",
                                                "sense_id": "3e31e250-f635-3d12-a0f5-afbc9beb99a3",
                                                "text": "On cueillait depuis une quinzaine de jours, au long des routes vicinales, aux orées des « longs champs », autour des villages, sur des lieues et des lieues de terroir, par toutes les vallées."
                                            },
                                            {
                                                "example_id": "c9bb0631-bf79-459e-b3e4-4cd687754702",
                                                "sense_id": "3e31e250-f635-3d12-a0f5-afbc9beb99a3",
                                                "text": "Toutefois, jusqu’en mai 1904, qui vit la création d’un chemin de fer vicinal vers Chimay et Couvin, le bourg resta privé de moyens de communication autres que des chemins vicinaux impraticables l’hiver et mauvais en toute saison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb168ed-7771-3c07-9426-c036b10354ea",
                                        "entry_id": "3136a963-89e7-3886-a5f7-6bcdb8650074",
                                        "glosses": [
                                            "Qualifie deux groupes fonctionnels attachés à deux atomes de carbone adjacents."
                                        ],
                                        "tags": [
                                            "Stéréochimie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vicinal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b5e825-f828-33c3-8499-432c183b88ed",
                                        "entry_id": "3278b6c1-a0d4-35b1-aceb-53180fe3765d",
                                        "glosses": [
                                            "Chemin vicinal : qui relie deux villages voisins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19736f15-cba3-4f7d-8c92-34a1319a73ec",
                                                "sense_id": "d8b5e825-f828-33c3-8499-432c183b88ed",
                                                "text": "Il se souvenait d’un certain matin, dans le Calvados, où, à un arrêt du vicinal noir et luisant, il avait renoncé à téléphoner à sa femme qui ne savait rien de lui plutôt que de manquer au plaisir de boire du vin blanc dans un caboulot pleins de pêcheurs et de paniers de marée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea0bbbc-3718-3b75-a021-4d32446640b8",
                                        "entry_id": "3278b6c1-a0d4-35b1-aceb-53180fe3765d",
                                        "glosses": [
                                            "Moyen de transport vicinal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0da0ab-e331-40a6-b3e4-70428b0e1434",
                                                "sense_id": "5ea0bbbc-3718-3b75-a021-4d32446640b8",
                                                "text": "C’était un vicinal comme on en trouve presque tout le long de la côte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
