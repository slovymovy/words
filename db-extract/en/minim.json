                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a7cc7005-2720-3dd2-a6aa-d1c7adadd7c2",
                        "entry_id": "2d1e9e77-1f24-3d70-ae8a-61a6e28af9f3",
                        "glosses": [
                            "A little man or being; a dwarf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1123962-c1af-456b-99e2-580672f70d4c",
                                "sense_id": "a7cc7005-2720-3dd2-a6aa-d1c7adadd7c2",
                                "text": "These as a line thir^([sic]) long dimension drew,\nStreaking the ground with sinuous trace;\nnot all Minims of Nature; some of Serpent kinde\nWondrous in length and corpulence […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d449750c-d69f-3ea0-b34b-a62edef3887f",
