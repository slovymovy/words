                    "frequency": "Middle",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag prachtig weer om te wandelen, <w>nietwaar</w>?",
                            "target_lang_translations": {
                                "en": "The weather is beautiful for a walk today, <w>isn't it</w>?"
                            }
                        },
                        {
                            "text": "Je hebt je huiswerk voor morgen al af, <w>nietwaar</w>?",
                            "target_lang_translations": {
                                "en": "You've already finished your homework for tomorrow, <w>right</w>?"
                            }
                        }
                    ],
                    "synonyms": [
