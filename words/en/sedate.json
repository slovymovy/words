{
    "word_family": [
        "sedative",
        "sedation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                    "sense_definition": "Remaining calm, dignified, and avoiding excessive activity or excitement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The usually <w>sedate</w> professor spoke in a quiet and measured tone during the lecture.",
                            "target_lang_translations": {
                                "nl": "De gewoonlijk <w>bedaarde</w> professor sprak op een rustige en afgemeten toon tijdens het college."
                            }
                        },
                        {
                            "text": "She maintained a <w>sedate</w> pace while walking through the park on a Sunday afternoon.",
                            "target_lang_translations": {
                                "nl": "Ze hield een <w>rustig</w> tempo aan terwijl ze op een zondagmiddag door het park liep."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "composed",
                        "staid",
                        "tranquil"
                    ],
                    "common_phrases": [
                        "sedate pace",
                        "sedate manner"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kalm, waardig en niet overdreven actief of opgewonden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kalm",
                                "target_lang_sense_clarification": "rustig en beheerst in gedrag"
                            },
                            {
                                "target_lang_word": "beheerst",
                                "target_lang_sense_clarification": "met zelfbeheersing en waardigheid"
                            },
                            {
                                "target_lang_word": "bedaard",
                                "target_lang_sense_clarification": "rustig en zonder haast"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                    "sense_definition": "Not overly ornate, showy, or flashy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house featured a <w>sedate</w> design that blended perfectly with the surrounding neighborhood.",
                            "target_lang_translations": {
                                "nl": "Het huis had een <w>sober</w> ontwerp dat perfect opging in de omliggende buurt."
                            }
                        },
                        {
                            "text": "He preferred <w>sedate</w> clothing that did not draw unnecessary attention to himself.",
                            "target_lang_translations": {
                                "nl": "Hij gaf de voorkeur aan <w>ingetogen</w> kleding die geen onnodige aandacht op hem vestigde."
                            }
                        }
                    ],
                    "synonyms": [
                        "sober",
                        "unobtrusive"
                    ],
                    "antonyms": [
                        "obtrusive"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet overdreven versierd, opzichtig of flitsend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sober",
                                "target_lang_sense_clarification": "eenvoudig en niet opvallend"
                            },
                            {
                                "target_lang_word": "ingetogen",
                                "target_lang_sense_clarification": "bescheiden en niet opzichtig"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da507b76-42ad-3997-a288-3ad252103092",
                    "sense_definition": "To calm or induce sleep in a person using a medical drug.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors had to <w>sedate</w> the patient before performing the emergency surgery.",
                            "target_lang_translations": {
                                "nl": "De artsen moesten de patiënt <w>verdoven</w> voordat ze de spoedoperatie uitvoerden."
                            }
                        },
                        {
                            "text": "The injured animal was <w>sedated</w> so that the veterinarian could treat its wounds safely.",
                            "target_lang_translations": {
                                "nl": "Het gewonde dier werd <w>verdoofd</w> zodat de dierenarts zijn wonden veilig kon behandelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "tranquilize"
                    ],
                    "common_phrases": [
                        "heavily sedated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand kalmeren of in slaap brengen met behulp van medicijnen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdoven",
                                "target_lang_sense_clarification": "medisch in slaap brengen of ongevoelig maken"
                            },
                            {
                                "target_lang_word": "kalmeringsmiddelen toedienen",
                                "target_lang_sense_clarification": "het proces van iemand rustig maken met medicatie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a080a619-72ef-3782-8583-538e8a9114f7",
                    "sense_definition": "To make someone or something feel tranquil or peaceful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soft music helped to <w>sedate</w> the restless crowd after the long delay.",
                            "target_lang_translations": {
                                "nl": "Zachte muziek hielp om de onrustige menigte na de lange vertraging te <w>kalmeren</w>."
                            }
                        },
                        {
                            "text": "The warm tea seemed to <w>sedate</w> her nerves after the stressful meeting.",
                            "target_lang_translations": {
                                "nl": "De warme thee leek haar zenuwen na de stressvolle vergadering te <w>kalmeren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "soothe"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets een gevoel van rust of vrede geven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kalmeren",
                                "target_lang_sense_clarification": "rustig maken"
                            },
                            {
                                "target_lang_word": "tot rust brengen",
                                "target_lang_sense_clarification": "iemand of iets kalm laten worden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}