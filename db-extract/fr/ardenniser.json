                ],
                "senses": [
                    {
                        "sense_id": "38a011d2-1b84-32f9-8b28-28f142079744",
                        "entry_id": "5089da56-176c-38eb-832f-3831a6d0b85a",
                        "glosses": [
                            "Donner un caractère ardennais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015c50a0-c70d-4748-a766-2e4a9e01ab5b",
                                "sense_id": "38a011d2-1b84-32f9-8b28-28f142079744",
                                "text": "Mais ce manteau neigeux a permis «d'ardenniser» cette Hesbaye braivoise."
                            },
                            {
                                "example_id": "5b057aa4-1db7-4eee-99a7-74f3b69807bb",
                                "sense_id": "38a011d2-1b84-32f9-8b28-28f142079744",
                                "text": "Il n'est nullement question de la...champagniser, de l'ardenniser ou de la lorrainiser."
                            },
                            {
                                "example_id": "2d23ba04-9eba-414b-aebf-585cfc123fc5",
                                "sense_id": "38a011d2-1b84-32f9-8b28-28f142079744",
                                "text": "Dès lors, par la force naturelle des choses, son illustre amoureux sera « ardennisé », donc dans l’obligation de se soumettre à la vivace tradition séculaire qui impose à tout indigène de l’Ardenne profonde de porter un sobriquet, don généreux et attendrissant de la communauté villageoise."
                            }
                        ]
                    }
