                    "frequency": "Middle",
                    "semantic_group_id": "institution_preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>conservatoire</w> du littoral protège ces plages remarquables contre les constructions abusives."
                        },
                        {
                            "text": "Cette structure agit comme un véritable <w>conservatoire</w> des techniques artisanales régionales."
                        }
                    ],
                    "common_phrases": [
                        "conservatoire du littoral",
                        "conservatoire botanique"
                    ]
                },
                {
