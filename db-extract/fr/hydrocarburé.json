                        "tags": [],
                        "examples": [
                            {
                                "example_id": "185a55dd-4f37-46ef-8167-fdf68132ede8",
                                "sense_id": "4ea4b01b-4729-389d-a4b6-09a9e6d606b2",
                                "text": "Les émanations de gaz hydrocarburés qui se produisent à la surface de beaucoup de contrées sont souvent des indices sérieux que l’on se trouve dans une région où le pétrole doit se trouver dans le sous-sol."
                            },
                            {
                                "example_id": "7fe67730-8c4c-40f5-a1c0-2bde3f9a5fea",
                                "sense_id": "4ea4b01b-4729-389d-a4b6-09a9e6d606b2",
                                "text": "Aujourd’hui, sur le plan mondial, la consommation d’énergies secondaires est concentrée surtout sur des énergies hydrocarburées."
                            },
                            {
                                "example_id": "59cb1457-8b8b-49c3-beac-eda4c278a15e",
                                "sense_id": "4ea4b01b-4729-389d-a4b6-09a9e6d606b2",
                                "text": "A M. Martin, pour un appareil combiné à marche automatique et continue, destiné à désessencifier les liquides hydrocarburés, à les transformer et à les gazéifier, afin de les rendre propres à l’éclairage et au chauffage."
                            }
                        ]
