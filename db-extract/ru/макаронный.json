                "senses": [
                    {
                        "sense_id": "9262d0da-5076-3cb3-8d92-de37084df198",
                        "entry_id": "08d14b2d-d9ea-3e49-9619-c817a3632622",
                        "glosses": [
                            "macaroni"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "5c91d799-1db1-41a4-aa0a-ee5daecbe144",
                                "sense_id": "9262d0da-5076-3cb3-8d92-de37084df198",
                                "text": "макаро́нные изде́лия",
                                "translation": "macaroni foods, pasta",
                                "english": "macaroni foods, pasta"
                            },
                            {
                                "example_id": "6bed5c70-d855-4cca-92be-28f21849a7a7",
                                "sense_id": "9262d0da-5076-3cb3-8d92-de37084df198",
                                "text": "Макаро́нные изде́лия выраба́тывают на отли́чно обору́дованных макаро́нных фа́бриках, где де́йствуют соверше́нные маши́ны-автома́ты сове́тской констру́кции."
                            },
                            {
                                "example_id": "e84df75f-5d9d-433a-8f6a-ecd914f154c8",
                                "sense_id": "9262d0da-5076-3cb3-8d92-de37084df198",
                                "text": "Обе́д был дово́льно невку́сный – суп с макаро́нными звёздочками, ку́рица с ри́сом и компо́т.",
                                "translation": "The food was pretty bad—thin soup with macaroni stars, tough chicken with rice, and tasteless stewed fruit.",
                                "english": "The food was pretty bad—thin soup with macaroni stars, tough chicken with rice, and tasteless stewed fruit."
                            }
                        ]
                    }
                ],
