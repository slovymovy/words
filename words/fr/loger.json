    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c05ffa44-35a3-3f66-b9f5-77aa4edcfd4d",
                    "sense_definition": "Avoir son domicile habituel ou temporaire dans un endroit ; y habiter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "habitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant leurs vacances à Rome, ils ont préféré <w>loger</w> à l'hôtel pour plus de confort."
                        },
                        {
                            "text": "Mon frère <w>loge</w> chez un ami en attendant de trouver son propre appartement."
                        }
                    ],
                    "common_phrases": [
                        "loger à l'hôtel",
                        "loger chez l'habitant"
                    ]
                },
                {
                    "sense_id": "0fbe3463-4b3c-3466-8454-73b2e7cb29a7",
                    "sense_definition": "Accorder un abri ou une habitation à quelqu'un ; procurer un logement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association caritative aide à <w>loger</w> les familles en situation de grande précarité."
                        },
                        {
                            "text": "Elle a gentiment accepté de <w>loger</w> son cousin pendant toute la durée de ses études."
                        }
                    ],
                    "synonyms": [
                        "héberger"
                    ],
                    "common_phrases": [
                        "nourri et logé"
                    ]
                },
                {
                    "sense_id": "296eb236-e362-3342-acca-00be6182f5de",
                    "sense_definition": "Trouver place, pouvoir entrer ou être contenu dans un espace déterminé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande armoire ne pourra jamais <w>loger</w> dans une chambre aussi étroite."
                        },
                        {
                            "text": "Nous avons réussi à faire <w>loger</w> toutes nos valises dans le petit coffre."
                        }
                    ]
                },
                {
                    "sense_id": "72f17f87-6317-3e2c-8a54-449e2ff8c5f3",
                    "sense_definition": "Faire pénétrer ou introduire avec force un projectile dans un corps ou un obstacle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tireur a réussi à <w>loger</w> une balle au centre précis de la cible."
                        },
                        {
                            "text": "D'une frappe puissante, l'attaquant a <w>logé</w> le ballon sous la barre transversale."
                        }
                    ],
                    "common_phrases": [
                        "loger une balle"
                    ]
                },
                {
                    "sense_id": "13ab2e54-eb44-35ec-83c4-b1504fd9130f",
                    "sense_definition": "Découvrir ou identifier précisément l'adresse où habite une personne recherchée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de filature, les policiers ont enfin réussi à <w>loger</w> le suspect."
                        },
                        {
                            "text": "L'enquêteur privé a passé la nuit dehors pour <w>loger</w> l'homme en fuite."
                        }
                    ],
                    "common_phrases": [
                        "loger un suspect"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot policier"
                        }
                    ]
                },
                {
                    "sense_id": "d305b0a5-4b6e-321b-9224-f30b6ab88597",
                    "sense_definition": "Mettre du vin ou d'autres boissons dans un récipient, tel qu'un fût ou une barrique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le viticulteur préfère <w>loger</w> sa récolte dans des fûts de chêne traditionnels."
                        },
                        {
                            "text": "Cette cuvée spéciale sera vendue directement au domaine après avoir été <w>logée</w> en bouteilles."
                        }
                    ],
                    "common_phrases": [
                        "loger en barrique"
                    ]
                }
            ]
        }
    ]
