                    "sense_definition": "zjawisko akustyczne towarzyszące wyładowaniu elektrycznemu w atmosferze",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zjawiska_atmosferyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po błyskawicy często następuje <w>grzmot</w>.",
                            "target_lang_translations": {
                                "en": "Lightning is often followed by <w>thunder</w>.",
                                "ru": "За молнией часто следует <w>гром</w>.",
                                "nl": "Na de bliksem volgt vaak de <w>donder</w>.",
                                "de": "Auf einen Blitz folgt oft ein <w>Donner</w>.",
                                "fr": "L'éclair est souvent suivi du <w>tonnerre</w>.",
                                "it": "Al lampo segue spesso il <w>tuono</w>.",
                                "cs": "Po blesku často následuje <w>hrom</w>.",
                                "tr": "Şimşekten sonra genellikle <w>gök gürültüsü</w> duyulur.",
                                "es": "Después del relámpago a menudo sigue el <w>trueno</w>.",
                                "zh": "闪电过后往往紧接着<w>雷声</w>。"
                            }
                        },
                        {
                            "text": "Daleki <w>grzmot</w> zapowiadał zbliżającą się burzę.",
                            "target_lang_translations": {
                                "en": "A distant <w>peal of thunder</w> heralded the approaching storm.",
                                "ru": "Далёкий <w>раскат грома</w> предвещал приближающуюся грозу.",
                                "nl": "Een verre <w>donderslag</w> kondigde het naderende onweer aan.",
                                "de": "Ein ferner <w>Donner</w> kündigte das herannahende Gewitter an.",
                                "fr": "Un <w>tonnerre</w> lointain annonçait l'orage qui approchait.",
                                "it": "Un lontano <w>tuono</w> annunciava il temporale in avvicinamento.",
                                "cs": "Vzdálený <w>hrom</w> ohlašoval blížící se bouřku.",
                                "tr": "Uzaktan gelen <w>gök gürültüsü</w> yaklaşan fırtınanın habercisiydi.",
                                "es": "Un <w>trueno</w> lejano presagiaba la tormenta que se acercaba.",
                                "zh": "远处的<w>雷声</w>预示着暴风雨即将来临。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grom"
                    ],
                    "common_phrases": [
                        "głośny grzmot"
                    ],
                    "target_lang_definitions": {
                        "en": "a loud acoustic sound caused by electrical discharge in the atmosphere",
                        "ru": "звуковое явление в атмосфере, сопровождающее электрический разряд молнии",
                        "nl": "akoestisch verschijnsel dat gepaard gaat met een elektrische ontlading in de atmosfeer (onweer)",
                        "de": "Akustisches Phänomen (Schallereignis), das eine elektrische Entladung in der Atmosphäre begleitet",
                        "fr": "Bruit sourd ou fracassant produit par l'onde de choc de la foudre lors d'un orage.",
                        "it": "Fenomeno acustico che accompagna una scarica elettrica nell'atmosfera",
                        "cs": "akustický jev doprovázející elektrický výboj v atmosféře během bouřky",
                        "tr": "Atmosferdeki elektrik boşalmasına eşlik eden gök gürültüsü sesi",
                        "es": "Sonido producido en las nubes por una descarga eléctrica de una tormenta",
                        "zh": "雷电伴随的巨响，即雷声"
                    },
