                ],
                "senses": [
                    {
                        "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                        "entry_id": "57256aed-f113-3867-b40e-28f8ffebc47e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5ce777-db7c-48c1-b865-9856f61a466a",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Herr Hartmuth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c0fa617-065d-46c4-856b-2e475f3f21c0",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Die Hartmuths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f3db35c0-3cc7-4f93-89c5-611279ae2ee2",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Frau Hartmuth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e399108f-79fa-4fe6-9c44-e83a0945e150",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Der Hartmuth trägt nie die Schals, die die Hartmuth ihm strickt."
                            },
                            {
                                "example_id": "94fa64d7-7ed6-4c01-9d21-ada0bae46a6b",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hartmuth kommt, geht der Herr Hartmuth.“"
                            },
                            {
                                "example_id": "7cbe1b85-0659-44f7-9235-a506d08894a9",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Hartmuth kommt und geht."
                            },
                            {
                                "example_id": "1abaf3c1-dab0-47d5-b2c2-a50fab03790c",
                                "sense_id": "af7f3851-ea84-3f66-a1f1-91e527a63c2d",
                                "text": "Hartmuths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
