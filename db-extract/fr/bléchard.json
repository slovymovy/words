                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a9919542-69b9-4d00-8ea5-c373410f4230",
                                "sense_id": "2000ef4d-ae96-3793-b436-bc2c454b8dea",
                                "text": "Il n’y vaut pas lerch le pinard\nQu’on lessive à l’encaserné,\nPlus d’un’ fois il le trouv’ bléchard,\nMais il s’en fourr’ plein les trous d’ nez."
