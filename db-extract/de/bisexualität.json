                        "glosses": [
                            "sexuelles Interesse sowohl für das männliche als auch das weibliche Geschlecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e292cc-2d1b-4e87-bae4-ccb69bb8b759",
                                "sense_id": "e84963a7-f06e-3501-a40d-4be4aa6d045c",
                                "text": "„Die Datengrundlage ist ernüchternd unschrill, 92 Prozent der Befragten geben an, heterosexuell zu sein; jeweils vier Prozent bekennen sich zu Homo- beziehungsweise Bisexualität.“"
                            },
                            {
                                "example_id": "505d93a4-0426-4839-9399-ca600df07813",
                                "sense_id": "e84963a7-f06e-3501-a40d-4be4aa6d045c",
                                "text": "„Schade, dass mir jede Begabung zur Bisexualität fehlt.“"
                            }
                        ],
