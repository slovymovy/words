                "senses": [
                    {
                        "sense_id": "2d15d92b-a4ee-3bb1-8153-7769ecfb9e1b",
                        "entry_id": "f2e7ca6d-8988-35b1-9c2a-5b27eccefbdf",
                        "glosses": [
                            "roślina o soczystych, zgrubiałych łodygach pokrytych kolcami, rosnąca na pustynnych obszarach Ameryki Środkowej i Południowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f0d8358-3a2c-46ed-8ee0-e0ba78aa75cb",
                                "sense_id": "2d15d92b-a4ee-3bb1-8153-7769ecfb9e1b",
