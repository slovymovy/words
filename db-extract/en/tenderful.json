                    {
                        "sense_id": "bbe61696-20e4-362e-9bf6-4f582192df3e",
                        "entry_id": "3a37d503-9450-384f-9bd4-99a86abbd0f2",
                        "glosses": [
                            "tender; compassionate."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "8f21018c-0924-4b13-9018-b88410dad190",
                                "sense_id": "bbe61696-20e4-362e-9bf6-4f582192df3e",
                                "text": "You needn't have been so tenderful. I'm going to put on wedding-robes myself, you know."
                            },
                            {
                                "example_id": "8a7086a6-b77a-4193-8ff8-0fbcd241f3bb",
                                "sense_id": "bbe61696-20e4-362e-9bf6-4f582192df3e",
                                "text": "Fair eyes, from out whose azure pitiful A pleading glory shines through crystal dew; Sweet quivering lips that breathe a blessing new, In silent woe of love most tenderful."
                            },
                            {
                                "example_id": "19be02e2-9ff4-410a-bd9c-c60545fca857",
                                "sense_id": "bbe61696-20e4-362e-9bf6-4f582192df3e",
                                "text": "It sweetened and strengthened myself to feel The tenderful touch of thy thrillant palm;"
                            },
                            {
                                "example_id": "e60bd1dc-d887-4102-ab13-e99655a710b0",
                                "sense_id": "bbe61696-20e4-362e-9bf6-4f582192df3e",
                                "text": "Oh , I'm seein' him now as I looked on him last, wid his hair all curly and bright, And the wonderful, tenderful heart he had, and his eyes as he wint away,"
                            }
                        ]
                    }
                ],
