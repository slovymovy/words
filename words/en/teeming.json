{
    "word_family": [
        "teem"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d983f162-e11a-3afa-a618-d9b9dddf7656",
                    "sense_definition": "Abundantly filled with living things or people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The market was <w>teeming</w> with shoppers looking for fresh produce.",
                            "target_lang_translations": {
                                "nl": "De markt <w>wimmelde</w> van de kopers die op zoek waren naar verse producten."
                            }
                        },
                        {
                            "text": "The forest floor is <w>teeming</w> with insects and small animals.",
                            "target_lang_translations": {
                                "nl": "De bosbodem <w>wimmelt</w> van de insecten en kleine dieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowded",
                        "swarming",
                        "packed"
                    ],
                    "antonyms": [
                        "empty",
                        "deserted"
                    ],
                    "common_phrases": [
                        "teeming with life"
                    ],
                    "target_lang_definitions": {
                        "nl": "Overvloedig gevuld met levende wezens of mensen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krioelend",
                                "target_lang_sense_clarification": "Gebruikt om aan te geven dat iets vol zit met bewegende wezens of mensen."
                            },
                            {
                                "target_lang_word": "overvol",
                                "target_lang_sense_clarification": "Geeft aan dat een ruimte tot de nok toe gevuld is."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a2845a4-e8ab-39e4-bc70-738c50c7e2e4",
                    "sense_definition": "Describing very heavy or pouring rain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to cancel the picnic because of the <w>teeming</w> rain.",
                            "target_lang_translations": {
                                "nl": "We moesten de picknick afzeggen vanwege de <w>stortregen</w>."
                            }
                        },
                        {
                            "text": "The streets were flooded after hours of <w>teeming</w> downpours.",
                            "target_lang_translations": {
                                "nl": "De straten stonden onder water na uren van <w>stortbuien</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pouring",
                        "torrential"
                    ],
                    "common_phrases": [
                        "teeming rain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beschrijft zeer zware of stromende regen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stortregen",
                                "target_lang_sense_clarification": "Verwijst naar een zeer heftige regenbui."
                            },
                            {
                                "target_lang_word": "stromende",
                                "target_lang_sense_clarification": "Vaak gebruikt in de uitdrukking 'stromende regen' voor zeer zware neerslag."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9349a1ef-87d1-34c4-a320-029fcbadfa0b",
                    "sense_definition": "Present participle and gerund of <w>teem</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is <w>teeming</w> with fish this season.",
                            "target_lang_translations": {
                                "nl": "De rivier <w>wimmelt</w> dit seizoen van de vissen."
                            }
                        },
                        {
                            "text": "The city is <w>teeming</w> with tourists during the summer months.",
                            "target_lang_translations": {
                                "nl": "De stad <w>wimmelt</w> van de toeristen tijdens de zomermaanden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle form of the verb teem."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord van het werkwoord 'teem' (wimmelen van)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wimmelend",
                                "target_lang_sense_clarification": "Geeft aan dat een plek vol zit met een grote hoeveelheid levende wezens."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}