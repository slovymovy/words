                        ],
                        "examples": [
                            {
                                "example_id": "9b956807-881e-4dfe-8b0f-603c6579eea8",
                                "sense_id": "34c253c4-5682-302f-adbb-aa647cb6465b",
                                "text": "Der Jägersmann hockte sich hinter den Busch und drückte ab und das nennt sich Anstand?"
                            }
