                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joshua",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4130f77f-6a37-3689-8ec9-bb020cc573f1",
                                        "entry_id": "3a7e645a-c49f-345b-a599-a800fe4546e4",
                                        "glosses": [
                                            "The sixth book of the Old Testament of the Bible, and a book of the Tanakh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b08f9dba-ff45-35a4-a3d0-3e1a08e0597b",
                                        "entry_id": "3a7e645a-c49f-345b-a599-a800fe4546e4",
                                        "glosses": [
                                            "The son of Nun, Judge of Israel following Moses; author of the Book of Joshua; Quranic figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e058630-41d4-4df7-8818-366106c4557e",
                                                "sense_id": "b08f9dba-ff45-35a4-a3d0-3e1a08e0597b",
                                                "text": "So Joshua took the whole land, according to all that the Lord said unto Moses; and Joshua gave it for an inheritance unto Israel according to their divisions by their tribes. And the land rested from war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2eef298-779a-3395-98bf-9b8eed96529a",
                                        "entry_id": "3a7e645a-c49f-345b-a599-a800fe4546e4",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd54db52-b147-4729-9e6f-bbf8212f4604",
                                                "sense_id": "c2eef298-779a-3395-98bf-9b8eed96529a",
                                                "text": "\"His father had a notion,\" observes Malone, on the authority of Dr. Percy, Bishop of Dromore, \"that it might at some future period of his life be an advantage to a child to bear an uncommon Christian name, - - - Hence our author derived the scriptural name of Joshua, which, though not very uncommon, occurs less frequently than many others.\" But another biographer has suggested, with more appearance of reason, that it was probably given to him because an uncle, who was one of his godfathers, bore the same name,"
                                            },
                                            {
                                                "example_id": "c5fe91bd-192b-45af-967d-a17f8a293ef7",
                                                "sense_id": "c2eef298-779a-3395-98bf-9b8eed96529a",
                                                "text": "The shooter believed to be responsible for the incident was identified as Joshua Jahn, according to three sources familiar with the case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a9a7f2-550d-30f3-aefa-7863139cf333",
                                        "entry_id": "3a7e645a-c49f-345b-a599-a800fe4546e4",
                                        "glosses": [
                                            "A city in Johnson County, Texas, United States, named after the biblical Joshua."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Joshua",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f27977d-6ea3-3813-b001-36db96240ec2",
                                        "entry_id": "41421832-41b1-3c9f-9ed9-d7d7baa865f0",
                                        "glosses": [
                                            "A Joshua tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67668eea-162a-4a6c-a5b3-7ee3adc60cda",
                                                "sense_id": "6f27977d-6ea3-3813-b001-36db96240ec2",
                                                "text": "Isolated Joshua trees appear at 75.1 m. among the mesquite and sage, increasing rapidly in number until they form a forest on both sides. […] The age of the Joshuas is popularly compared to that of the Sequoias."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
