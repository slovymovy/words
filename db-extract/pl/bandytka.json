                                        "examples": [
                                            {
                                                "example_id": "d0af892b-37bc-438d-9ca1-a9727e56bb1d",
                                                "sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                                                "text": "„Dieses Henkerspiel hatte Sesto schon oft ohne ein anderes Gefühl als das des Respekts vor der famosen Banditin beobachtet.“"
                                            },
                                            {
                                                "example_id": "cc4577ef-e814-4568-a27d-fc7c080a262f",
                                                "sense_id": "015849c8-2392-3c76-bf8c-1fbce46d1129",
                                                "text": "„Bob wurde nur von einer einzigen Person betrauert, einer Banditin, die in Custer einen Gasthof unterhielt und deren Liebhaber er war.“"
                                            }
                                        ],
