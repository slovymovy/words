                                "target_senses": [
                                    {
                                        "sense_id": "0b094d9f-c314-3180-9b1f-136284670011",
                                        "entry_id": "f7fa7d50-6cbc-39ff-9a6d-a078dace9810",
                                        "glosses": [
                                            "Ouvrière qui assemble et manœuvre une grue de chantier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3a6bd7-e72d-47da-9c51-630e25893eaf",
                                                "sense_id": "0b094d9f-c314-3180-9b1f-136284670011",
                                                "text": "La ressemblance avec la bataille de Koulikovo s’expliquait par le fait que nul ne voulait, là non plus, relever le défi de la grutière Dankevitch qui continuait à faire tourner son terrifiant crochet au-dessus des têtes de tous ceux qu’elle invitait à se battre."
                                            }
                                        ]
