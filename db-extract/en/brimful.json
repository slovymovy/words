            {
                "entry_id": "8e9fb9a6-b46f-37ec-986b-b6b419385048",
                "word": "brimful",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c568c10e-6cb5-4321-b555-2873f80dbbca",
                        "entry_id": "8e9fb9a6-b46f-37ec-986b-b6b419385048",
                        "tags": [
                            "plural"
                        ],
                        "form": "brimfuls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ce212a9-e718-385b-9545-a9411eab2d3c",
                        "entry_id": "8e9fb9a6-b46f-37ec-986b-b6b419385048",
                        "glosses": [
                            "The maximum amount a container can hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1c3647-3b72-4735-85b9-ee646d56d4a5",
                                "sense_id": "5ce212a9-e718-385b-9545-a9411eab2d3c",
                                "text": "If the glass is cracked, it cannot contain a brimful of water; and if and only if the water is calm enough, it can reflect the moon in the sky without distortion."
                            },
                            {
                                "example_id": "f47ac840-6c21-47e7-abc5-089e7a638b8e",
                                "sense_id": "5ce212a9-e718-385b-9545-a9411eab2d3c",
                                "text": "As I listened to the words as they were coming out of my mouth, I realized that I sounded like Ozzy Osborne after three brimfuls of Merlot and a handful of Vicodin ."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8c54381-3ed3-3210-8211-287c6e95b6d9",
                        "entry_id": "8e9fb9a6-b46f-37ec-986b-b6b419385048",
                        "glosses": [
                            "A large amount."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "53f6d12f-ae10-495c-962c-c427134dd75e",
                                "sense_id": "c8c54381-3ed3-3210-8211-287c6e95b6d9",
                                "text": "Brimful of Asha on the forty-five / Well, it's a brimful of Asha on the forty-five"
                            },
                            {
                                "example_id": "b54a9448-8307-4a8f-a1e2-450e55f6473a",
                                "sense_id": "c8c54381-3ed3-3210-8211-287c6e95b6d9",
                                "text": "Such a suggestion—even a timid one in her own head—would have been met with a brimful of scorn."
                            }
                        ]
                    }
                ],
                "translations": [],
