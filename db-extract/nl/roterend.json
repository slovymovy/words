                "senses": [
                    {
                        "sense_id": "26935023-d026-332a-ad43-2f1f1fb04196",
                        "entry_id": "1b71793e-04ea-3f05-8987-d93a55e8df1f",
                        "glosses": [
                            "met een draaiende beweging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1805de0d-8dd3-4475-87f9-180a7730e295",
                                "sense_id": "26935023-d026-332a-ad43-2f1f1fb04196",
                                "text": "'Woensdag is er kans op supercellen; roterende onweersbuien. Die kunnen windhozen veroorzaken. Dat is het ultieme om vast te leggen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b984c0e-0265-37f8-ae4a-f62c08d96ba6",
                        "entry_id": "1b71793e-04ea-3f05-8987-d93a55e8df1f",
                        "glosses": [
                            "met een volgens een vast patroon wisselende samenstelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68551dc0-758f-491a-a3bd-cfed95b2b392",
                                "sense_id": "9b984c0e-0265-37f8-ae4a-f62c08d96ba6",
                                "text": "Lockhart noch Kocherlakota hebben momenteel stemrecht in de roterende Fed-commissie die beslist over het steunprogramma, maar praten wel met hun collega's mee."
                            },
                            {
                                "example_id": "6752c1f0-496b-4801-b145-c2f9f46f77fa",
                                "sense_id": "9b984c0e-0265-37f8-ae4a-f62c08d96ba6",
                                "text": "Ruimtevaartorganisatie NASA legde voor de eerste keer op een panorama ultraviolet licht vast, dat niet zichtbaar is voor de mens. Het ziet er op de foto uit als een lichtblauw schijnsel dat zich rondom roterende sterrenstelsels begeeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad8d3337-3882-4072-8997-a9bd88f6db73",
                        "source_entry_id": "1b71793e-04ea-3f05-8987-d93a55e8df1f",
