                "entry_id": "fdb870c8-e5b3-397c-8f23-b030c0b5e1e5",
                "word": "mamanais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d4afd40-f37a-3cde-b6a5-eed001bee731",
                        "entry_id": "fdb870c8-e5b3-397c-8f23-b030c0b5e1e5",
                        "glosses": [
                            "Langage non standard produit par les adultes parlant aux petits enfants, caractérisé par un ton plus haut, par une prosodie exagérée et par un vocabulaire enfantin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4748807-c73e-4258-bfb9-1597424b615f",
                                "sense_id": "0d4afd40-f37a-3cde-b6a5-eed001bee731",
                                "text": "Quand les adultes s’adressent aux bébés ou à de jeunes enfants, ils parlent souvent dans un style connu sous le nom de mamanais. Ce style se caractérise par une hauteur élevée et une exagération des intonations."
                            }
                        ]
                    }
                ],
