                        "form": "насто́йках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76e37a8c-1663-366b-ab1b-8c735efbb1e2",
                        "entry_id": "16e7d5fd-28c2-3aca-97ae-2656e60cd244",
                        "glosses": [
                            "спиртной напиток, настоянный на ягодах, плодах, травах"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1da4e467-67b6-3975-b318-781af513f138",
                        "entry_id": "16e7d5fd-28c2-3aca-97ae-2656e60cd244",
                        "glosses": [
                            "мед. прозрачная жидкая спиртовая, спиртоводная или спиртоэфирная вытяжка (без нагревания) из растительного сырья"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8d1845c-3fd0-40f9-8831-5efe054f53be",
                        "source_entry_id": "16e7d5fd-28c2-3aca-97ae-2656e60cd244",
                        "source_sense_description": "спиртной напиток",
                        "target_lang_word": "liqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Substance fluide et liquide."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c88e680-185f-41b9-a32a-9ebf1eb1ae45",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Si, au lieu d'eau, on plonge un bocal d’esprit de vin ou de toute autre liqueur non gelable, à une semblable température, la liqueur prend, sans tarder, celle du bain."
                                            },
                                            {
                                                "example_id": "42adfe58-ce04-4485-8bfa-ffb30caa7661",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "232ab943-e075-47af-ba0f-cb2f2bf495fd",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Quand la cristallisation est achevée on sépare les cristaux de la liqueur mère qui se compose principalement d’acide oléique, on les fait recristalliser dans l’alcool à plusieurs reprises."
                                            },
                                            {
                                                "example_id": "a8fa5f61-8090-4550-b0e3-64ca79a65cee",
                                                "sense_id": "ac4491ea-6096-3c84-be5b-2ea38a1ca117",
                                                "text": "Ce dieu malfaisant, environné d’une foule innombrable de Mensonges ailés qui voltigent autour de lui, vint répandre une liqueur subtile et enchantée sur les yeux du pilote Achamas, qui considérait attentivement à la clarté de la lune le cours des étoiles, et le rivage d’Ithaque, dont il découvrait déjà assez près de lui les roches escarpés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Boisson résultant d’un alcoolat de plantes ou de fruits, généralement douce."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c63456d-c320-40fd-bd9d-629bc60219f0",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "En fait de liqueurs, le lieutenant Hobson emportait plusieurs barils de brandevin et de whisky, bien décidé, d'ailleurs, à économiser autant que possible ces liquides alcooliques, qui sont nuisibles à la santé des hommes sous les froides latitudes."
                                            },
                                            {
                                                "example_id": "2246b2e7-31c0-4031-a63f-2ea9fe0218e8",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "Ô vous qui buvez « sur le zinc », avez-vous jamais songé à toute la science qu'a dû déployer celui qui a fabriqué le verre dans lequel vous buvez le vin carminé ou la douce liqueur ?"
                                            },
                                            {
                                                "example_id": "aaf3cc66-6457-4481-8137-43987bc1f2c0",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "Ils s'attablent dans de bons restaurants, se font déboucher des bouteilles de Châteauneuf-du-Pape, dégustent des liqueurs."
                                            },
                                            {
                                                "example_id": "b08e3e0d-0d96-4a43-9774-74622726f458",
                                                "sense_id": "55c0d110-91be-36e7-9643-6191dc16ed58",
                                                "text": "S'ensuivirent quelques mondanités sur les mérites comparés de liqueurs d'hommes. Accord autour du Rebel Yell, un rince-cochon de première, distillé parcimonieusement par des bootleggers fous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7d79fa-6025-33fa-8adc-2316c9357920",
                                        "entry_id": "be7e7eff-ff7b-338b-bdf6-1243d76d7e03",
                                        "glosses": [
                                            "Boisson gazeuse non alcoolisée."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d360c3-93ec-447f-9891-4a408773c2a8",
                                                "sense_id": "fb7d79fa-6025-33fa-8adc-2316c9357920",
                                                "text": "J’l’ai rencontrée au dépanneur\nA s’achetait une grosse liqueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6712afd-a47d-448d-a95d-d04c533d84fe",
                        "source_entry_id": "16e7d5fd-28c2-3aca-97ae-2656e60cd244",
                        "source_sense_description": "вытяжка",
                        "target_lang_word": "teinture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teinture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c21c75-0de7-3cc6-84a1-b588b0238050",
                                        "entry_id": "7b8c006a-757a-3a00-bfac-164e2e9f46be",
                                        "glosses": [
                                            "Liquide préparé pour teindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66234b8-ced6-4935-9fdf-230e44062e92",
                                                "sense_id": "e4c21c75-0de7-3cc6-84a1-b588b0238050",
                                                "text": "À Arles, l’archevêque, qui avait le monopole de l’exploitation de la graine d’écarlate, avec laquelle on fabriquait la teinture rouge, ne traitait, pour la vente de ses récoltes, qu’avec les juifs."
                                            },
                                            {
                                                "example_id": "538037c6-ce5f-41f7-89f0-fcf8bc7e5158",
                                                "sense_id": "e4c21c75-0de7-3cc6-84a1-b588b0238050",
                                                "text": "\"La magnifique teinte violette, le fait qu'elle ne décolore pas et la difficulté à produire ce colorant, que l'on trouve en minuscules quantités dans le corps de petits mollusques\", ont fait de la pourpre royale une teinture prestigieuse qui \"coûtait souvent plus cher que l'or\", souligne-t-elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c06f646-6bd7-3948-abdc-a0591abe97a9",
                                        "entry_id": "7b8c006a-757a-3a00-bfac-164e2e9f46be",
                                        "glosses": [
                                            "Couleur que ce liquide laisse sur les étoffes et sur les autres choses que l’on teint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363bd00e-100b-4858-880a-7dc747ede77c",
                                                "sense_id": "8c06f646-6bd7-3948-abdc-a0591abe97a9",
                                                "text": "Du drap d’une belle teinture, d’une bonne teinture. - Ce drap a bien pris la teinture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca11f8fc-2068-3f67-8a81-cf578498b810",
                                        "entry_id": "7b8c006a-757a-3a00-bfac-164e2e9f46be",
                                        "glosses": [
                                            "Action, art de teindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da30ce1-abb9-4b6e-ac95-3733d58678ff",
                                                "sense_id": "ca11f8fc-2068-3f67-8a81-cf578498b810",
                                                "text": "Envoyer à la teinture. La teinture est un art fort ancien. - La teinture demande beaucoup de soin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f41c94e0-10cc-3176-9f8c-a0f5021d51cf",
                                        "entry_id": "7b8c006a-757a-3a00-bfac-164e2e9f46be",
                                        "glosses": [
                                            "Forme galénique liquide obtenue par dissolution d’un principe actif, le plus souvent végétal, dans un solvant organique tel que l’alcool ou, plus rarement, l’éther. Les teintures sont utilisées à des fins thérapeutiques ou antiseptiques."
                                        ],
                                        "tags": [
                                            "Pharmacognosie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19c4593-3aa3-4f31-9463-156f4891eeae",
                                                "sense_id": "f41c94e0-10cc-3176-9f8c-a0f5021d51cf",
                                                "text": "On panse ensuite, selon les cas, avec du digestif ordinaire, de l'onguent égyptiac, de la teinture d’aloès, le sulfate de cuivre, la liqueur de Villate, la teinture d’iode, l’acide phénique, la poudre de sublimé, la glycérine iodée au tiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8251aedf-600d-3343-8f50-349393cced5b",
                                        "entry_id": "7b8c006a-757a-3a00-bfac-164e2e9f46be",
                                        "glosses": [
                                            "Connaissance superficielle dans quelque science, dans quelque art."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17f2924-bd4f-4bce-9cf1-5d5c93c8bea7",
                                                "sense_id": "8251aedf-600d-3343-8f50-349393cced5b",
                                                "text": "[…] M. Rémusat avait étudié la médecine, et par là il avait pris quelque teinture de toutes les connaissances qui s’y rattachent."
                                            },
                                            {
                                                "example_id": "b46d20b7-4e7d-4911-88ad-8ec638e84302",
                                                "sense_id": "8251aedf-600d-3343-8f50-349393cced5b",
                                                "text": "Ayant, au contact de la clientèle, pris quelque teinture de la langue voyoute, la toubib a préféré, supposant au mot un pouvoir plus évocateur pour le Gros, un sac à mille francs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1decbf0f-5343-4330-b3f6-125117a25bcb",
                        "source_entry_id": "16e7d5fd-28c2-3aca-97ae-2656e60cd244",
                        "source_sense_description": "вытяжка",
                        "target_lang_word": "alcool",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcool",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74852295-9cff-3030-9fa2-63e8c694d57a",
                                        "entry_id": "e6b1f8f8-147e-3307-bbb7-d80296535b21",
                                        "glosses": [
                                            "Poudre très fine."
                                        ],
                                        "tags": [
                                            "Pharmacie ancienne"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                        "entry_id": "e6b1f8f8-147e-3307-bbb7-d80296535b21",
                                        "glosses": [
                                            "Liquide incolore, très fluide, d’une saveur brûlante, qui s’obtient en distillant le vin, le cidre et toutes les liqueurs fermentées provenant de matières sucrées ou féculentes. Éthanol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236fd338-c949-42eb-9ecc-584dfb5e986c",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "L’alcool donne au vin sa force et sa propriété enivrante ; il dérive du sucre, et n’existe jamais tout formé dans le raisin."
                                            },
                                            {
                                                "example_id": "489e7380-3e9e-42b8-a4b0-eae84efd180a",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "Quand la cristallisation est achevée on sépare les cristaux de la liqueur mère qui se compose principalement d’acide oléique, on les fait recristalliser dans l’alcool à plusieurs reprises."
                                            },
                                            {
                                                "example_id": "534693e1-a7e1-4b3f-9c76-f898cf88cd83",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "Nos adversaires, les betteraviculteurs, simulent, d’un autre côté, de craindre de voir jeter sur le marché, déjà bondé d’alcool d’industrie, 5 à 600.000 hectolitres d’alcool de vin, et parfois même plus, et redoutent, de ce chef, de voir s’ajouter à la crise viticole celle des alcools, par la concurrence à bas prix qu’ils viendraient leur faire; […]."
                                            },
                                            {
                                                "example_id": "b0acbf02-03d2-474b-aefc-3b7e08413011",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "[…] une dose de whisky de 4 centilitres et un ballon de vin de 12 centilitres correspondent à la même quantité d’alcool, soit 12 grammes."
                                            },
                                            {
                                                "example_id": "d970fe29-f6a3-40c9-81cc-4b32f82f86fc",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "À Margaux, les cabernets de la majorité des parcelles se présentent bien. Dégustés moins d’une semaine après les fermentations alcooliques, bien avant les FML (fermentations malo-lactiques), l’équilibre entre l’alcool et les tanins est surprenant."
                                            },
                                            {
                                                "example_id": "7f6e89fa-07f1-433d-8d09-bc5bc1006dde",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "L’extraction des graisses se fait par un dissolvant des matières grasses: benzine, sulfure de carbone, alcool, etc."
                                            },
                                            {
                                                "example_id": "9aad8716-23c4-4857-89de-a97a29f9110c",
                                                "sense_id": "74a05d71-3d52-39d7-ba0f-602b1e57b5b2",
                                                "text": "La teneur en alcool résiduel des vinaigres, autres que le vinaigre de vin, est limitée à 0,5 % en volume. La teneur en alcool résiduel des vinaigres de vin est limitée à 1,5 % en volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                        "entry_id": "e6b1f8f8-147e-3307-bbb7-d80296535b21",
                                        "glosses": [
                                            "Boisson alcoolisée comme le vin, la bière ou les spiritueux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04d0f8d-b902-4a81-b433-870b42c15825",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "Depuis son burn-out, Victoire Tuaillon a arrêté de boire de l’alcool."
                                            },
                                            {
                                                "example_id": "0b2e9a0c-4849-4352-a26c-759e641b5329",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "En effet, le Marquisien se soucie peu de l’argent et, pour obtenir son copra, certains capitaines exploitent son goût pour l’alcool, ce qui est défendu par la loi mais très difficile d’empêcher."
                                            },
                                            {
                                                "example_id": "bfab8b2f-da87-4551-83d2-cf555ddcb23e",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "Marcoul ne peut s’abstenir de trinquer avec son sauveur. Il n’aime pourtant guère cet alcool lourd et râpeux, si dur au palais. Mais les Ardennais ne jurent que par cette eau-de-vie de grains."
                                            },
                                            {
                                                "example_id": "5f4173f3-e8b9-420f-9fef-06202dea4832",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "Elle pense notamment aux conducteurs qui prennent leur voiture même lorsque leurs facultés sont affaiblies par l’alcool et qui récidivent malgré des accidents."
                                            },
                                            {
                                                "example_id": "786632c8-56ae-49d6-8f86-d95852ffcf1a",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "Les alcools dits « forts » sont, à tort, rendus seuls responsables de l’alcoolisme par les viticulteurs. Ils contiennent certes plus d’alcool, mais leur toxicité est comparable à celle du vin puisqu'ils sont servis en doses moindres."
                                            },
                                            {
                                                "example_id": "e81e8842-48ee-4708-8b4e-27fc854b9597",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "D’autant plus que le vin et les alcools durs, ce n’est pas la même chose."
                                            },
                                            {
                                                "example_id": "fa6d668f-3f3c-4e83-8de5-c978dfa74fde",
                                                "sense_id": "c6f6ea7d-0b9e-3164-ae73-e524f2c313f6",
                                                "text": "Le fait est que Marianne dépassait tout de même les recommandations du ministère de la Santé: «L' alcool, c'est maximum deux verres par jour et pas tous les jours.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e870265-88e9-3591-88ce-153c6bd50d95",
                                        "entry_id": "e6b1f8f8-147e-3307-bbb7-d80296535b21",
                                        "glosses": [
                                            "Alcoolisme ; ivrognerie, ivresse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2034ade3-b883-490d-96c7-7b05830d5b99",
                                                "sense_id": "2e870265-88e9-3591-88ce-153c6bd50d95",
                                                "text": "J’ai l’alcool triste, gai, etc."
                                            },
                                            {
                                                "example_id": "8514e14d-902f-4b7f-a61c-019de5b78143",
                                                "sense_id": "2e870265-88e9-3591-88ce-153c6bd50d95",
                                                "text": "[…]: cette folie furieuse et inguérissable de l’alcool qui, parfois, fait ressembler les marins à des brutes déchaînées."
                                            },
                                            {
                                                "example_id": "43a13b35-7c86-422e-9ad0-6dcdad883723",
                                                "sense_id": "2e870265-88e9-3591-88ce-153c6bd50d95",
                                                "text": "En dehors de cela, de la vie réelle, personnelle, on leur avait laissé deux choses : l’abrutissement de l’alcool et la jouissance immédiate, à bon marché, à la maison publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11552cbc-4b7d-3005-9dc4-a372bf6686de",
                                        "entry_id": "e6b1f8f8-147e-3307-bbb7-d80296535b21",
                                        "glosses": [
                                            "Composé organique dont les propriétés rappellent celles de l’éthanol. Ce sont des hydrocarbures dont un ou plusieurs atomes d’hydrogène (H) ont été remplacés par un hydroxyle (OH)."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46a70265-f33d-4197-9a19-10e485812e52",
                                                "sense_id": "11552cbc-4b7d-3005-9dc4-a372bf6686de",
                                                "text": "Les alcools, qui sont très nombreux, sont classés en alcools primaires, secondaires ou tertiaires suivant que la substitution de l’oxhydrile à l’hydrogène se fait dans le groupe CH³, CH² ou CH. Les alcools primaires sont répartis en six familles suivant leur nombre de fonctions alcool."
                                            },
                                            {
                                                "example_id": "c5ba2fb9-71b4-48b0-9194-b8084eefce03",
                                                "sense_id": "11552cbc-4b7d-3005-9dc4-a372bf6686de",
                                                "text": "L'éthanol ou alcool éthylique est un alcool primaire de formule CH₅OH ou CH₃-CH₂-OH"
                                            },
                                            {
                                                "example_id": "133ac443-fdb3-4233-9be5-4a89279fa928",
                                                "sense_id": "11552cbc-4b7d-3005-9dc4-a372bf6686de",
                                                "text": "Il existe des alcools dans la nature, notamment les végétaux contiennent divers alcools «terpéniques » souvent très odoriférants : menthol, terpinéol, linalol, etc. Dans les organismes animaux on en trouve également, par exemple le cholestérol. La vitamine A est aussi un alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
