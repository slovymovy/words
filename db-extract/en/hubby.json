                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e928f841-12d1-40b6-ae20-ff64afbaada8",
                                                "sense_id": "e21de5f6-5e24-3860-b837-3de628eb1b28",
                                                "text": "Barbórka wciąż zerka na swojego mężusia."
                                            },
                                            {
                                                "example_id": "7851d6e5-3367-4048-9a85-7571142c8498",
                                                "sense_id": "e21de5f6-5e24-3860-b837-3de628eb1b28",
                                                "text": "Mężuś myśli, że ja nie wiem, ile on zarabia, a ja co miesiąc odbieram jego wyciągi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "438a6be7-2777-47e6-b42b-c942d3de7122",
                        "source_entry_id": "4ecc19ce-741a-37db-a124-946a517ff875",
                        "source_sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
