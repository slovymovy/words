    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8393468-c81c-3e92-9a97-3fb8a108f110",
                    "sense_definition": "To rub, scrub, clean or wipe with a mop, or as if with a mop.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the party, we had to <w>mop</w> the kitchen floor to get rid of the sticky spills.",
                            "target_lang_translations": {
                                "ru": "После вечеринки нам пришлось <w>вымыть шваброй</w> пол на кухне, чтобы избавиться от липких пятен.",
                                "zh": "聚会结束后，我们只好<w>拖</w>厨房地板，把那些黏糊糊的泼洒物清理掉。"
                            }
                        },
                        {
                            "text": "He used a clean cloth to <w>mop</w> the sweat from his forehead during the intense workout.",
                            "target_lang_translations": {
                                "ru": "Во время интенсивной тренировки он использовал чистую ткань, чтобы <w>вытереть</w> пот со лба.",
                                "zh": "高强度锻炼时，他用一块干净的布<w>擦去</w>额头上的汗水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mop the floor",
                        "mop one's brow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тереть, скрести, чистить или вытирать шваброй или чем-то подобным.",
                        "zh": "用拖把擦洗、清洁或拖；也可指像用拖把那样擦掉、拭去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мыть шваброй",
                                "target_lang_sense_clarification": "пол"
                            },
                            {
                                "target_lang_word": "протирать",
                                "target_lang_sense_clarification": "вытирать влагу"
                            },
                            {
                                "target_lang_word": "вытирать",
                                "target_lang_sense_clarification": "пот или жидкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖",
                                "target_lang_sense_clarification": "用拖把清洁地面等"
                            },
                            {
                                "target_lang_word": "擦去",
                                "target_lang_sense_clarification": "擦掉汗水、液体等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576a8525-b890-3b55-a5fc-b6ae4d07dad4",
                    "sense_definition": "To shoplift.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group was caught trying to <w>mop</w> expensive designer clothes from the boutique.",
                            "target_lang_translations": {
                                "ru": "Группу поймали при попытке <w>стырить</w> дорогую дизайнерскую одежду из бутика.",
                                "zh": "这伙人想从精品店里<w>行窃</w>昂贵的名牌衣服时被抓住了。"
                            }
                        },
                        {
                            "text": "He admitted that he used to <w>mop</w> small items from the grocery store when he was a teenager.",
                            "target_lang_translations": {
                                "ru": "Он признался, что в подростковом возрасте <w>подворовывал</w> мелочи в продуктовом магазине.",
                                "zh": "他承认自己十几岁时曾常从杂货店<w>顺手偷</w>一些小东西。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for stealing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать кражу в магазине.",
                        "zh": "在商店里偷窃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тырить",
                                "target_lang_sense_clarification": "сленг, воровать в магазине"
                            },
                            {
                                "target_lang_word": "подрезать",
                                "target_lang_sense_clarification": "сленг, красть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行窃",
                                "target_lang_sense_clarification": "在商店里偷东西，较正式"
                            },
                            {
                                "target_lang_word": "顺手偷",
                                "target_lang_sense_clarification": "口语，顺手偷拿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c65f4c15-31af-302f-bbe7-aebdf4290cfb",
                    "sense_definition": "To make a wry expression with the mouth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange creature began to <w>mop</w> and mow at the travelers from behind the trees.",
                            "target_lang_translations": {
                                "ru": "Странное существо начало <w>кривляться</w> и строить рожи путешественникам из-за деревьев.",
                                "zh": "那个奇怪的生物躲在树后，开始朝旅行者<w>扮怪相</w>。"
                            }
                        },
                        {
                            "text": "In the old play, the villain would <w>mop</w> at the audience to show his displeasure.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе злодей <w>корчил гримасы</w> зрителям, чтобы показать свое недовольство.",
                                "zh": "在那出老戏里，反派会朝观众<w>做鬼脸</w>来表示不满。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mop and mow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in the phrase 'mop and mow'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корчить гримасы, кривить рот.",
                        "zh": "撇嘴或扭动嘴巴，做出怪异、讥讽的表情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кривляться",
                                "target_lang_sense_clarification": "строить рожи"
                            },
                            {
                                "target_lang_word": "корчить гримасы",
                                "target_lang_sense_clarification": "архаичное выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扮怪相",
                                "target_lang_sense_clarification": "故意摆出夸张表情"
                            },
                            {
                                "target_lang_word": "做鬼脸",
                                "target_lang_sense_clarification": "口语，做出滑稽或不满的脸部表情"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d136af3-e870-3bd7-a336-8e1ba93273e2",
                    "sense_definition": "An implement for washing floors or similar, made of a piece of cloth, or a collection of thrums, or coarse yarn, fastened to a handle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please grab the <w>mop</w> from the closet and clean up that water in the hallway.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, возьми <w>швабру</w> из шкафа и вытри воду в коридоре.",
                                "zh": "请从壁橱里把<w>拖把</w>拿来，把走廊里的水清理一下。"
                            }
                        },
                        {
                            "text": "The janitor used a heavy industrial <w>mop</w> to clean the large school cafeteria.",
                            "target_lang_translations": {
                                "ru": "Уборщик использовал тяжелую промышленную <w>швабру</w>, чтобы вымыть большую школьную столовую.",
                                "zh": "清洁工用一把很重的工业<w>拖把</w>清洗学校的大餐厅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bucket and mop",
                        "sponge mop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент для мытья полов, состоящий из куска ткани или пучка нитей, прикрепленных к рукоятке.",
                        "zh": "一种清洗地板等用的工具，前端为布头、绳束或粗纱，固定在长柄上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швабра",
                                "target_lang_sense_clarification": "инструмент для уборки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖把",
                                "target_lang_sense_clarification": "清洁地板的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fc06c50-0dab-3606-8a9a-5343ee5125d1",
                    "sense_definition": "A wash with a mop; the act of mopping.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the floor a quick <w>mop</w> to soak up the spilt juice.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>протер</w> пол, чтобы собрать разлитый сок.",
                                "zh": "他把地板快速<w>拖了一下</w>，好把洒出的果汁吸干。"
                            }
                        },
                        {
                            "text": "The kitchen needs a thorough <w>mop</w> before the guests arrive for dinner.",
                            "target_lang_translations": {
                                "ru": "Кухне требуется тщательное <w>мытье</w> перед приходом гостей на ужин.",
                                "zh": "客人来吃晚饭前，厨房需要彻底<w>拖洗</w>一次。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick mop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мытье шваброй; сам процесс протирки пола.",
                        "zh": "用拖把清洁；拖地这一动作或一次拖洗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мытье",
                                "target_lang_sense_clarification": "шваброй"
                            },
                            {
                                "target_lang_word": "протирка",
                                "target_lang_sense_clarification": "быстрая уборка пола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖地",
                                "target_lang_sense_clarification": "用拖把清洁地面的动作"
                            },
                            {
                                "target_lang_word": "拖洗",
                                "target_lang_sense_clarification": "较强调彻底清洁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8acf40ba-25a0-3e90-8713-973bc154be5f",
                    "sense_definition": "A dense head of hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ran a comb through his <w>mop</w> and hurried out the door.",
                            "target_lang_translations": {
                                "ru": "Он провел расческой по своей <w>копне</w> волос и поспешил за дверь.",
                                "zh": "他拿梳子梳了梳自己那头<w>乱发</w>，便匆匆出门了。"
                            }
                        },
                        {
                            "text": "The child had a thick <w>mop</w> of curly blonde hair that was always tangled.",
                            "target_lang_translations": {
                                "ru": "У ребенка была густая <w>шевелюра</w> светлых кудрявых волос, которые всегда путались.",
                                "zh": "那孩子长着一头金色卷曲的<w>浓发</w>，总是乱糟糟的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mop of hair"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal description of hair"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Густая копна волос.",
                        "zh": "浓密的一头头发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копна",
                                "target_lang_sense_clarification": "о густых волосах"
                            },
                            {
                                "target_lang_word": "шевелюра",
                                "target_lang_sense_clarification": "разговорное о волосах"
                            },
                            {
                                "target_lang_word": "лохмы",
                                "target_lang_sense_clarification": "небрежная прическа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱发",
                                "target_lang_sense_clarification": "口语，指一头浓密凌乱的头发"
                            },
                            {
                                "target_lang_word": "浓发",
                                "target_lang_sense_clarification": "强调头发浓密"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a89428d-f571-3e1b-83ea-2c9deeba8863",
                    "sense_definition": "Initialism of method of payment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please indicate your preferred <w>MOP</w> on the checkout page to complete the transaction.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, укажите предпочтительный <w>способ оплаты</w> на странице оформления заказа для завершения транзакции.",
                                "zh": "请在结账页面注明你偏好的<w>支付方式</w>，以完成交易。"
                            }
                        },
                        {
                            "text": "The seller listed several options for <w>MOP</w>, including bank transfer and digital wallets.",
                            "target_lang_translations": {
                                "ru": "Продавец указал несколько вариантов <w>оплаты</w>, включая банковский перевод и электронные кошельки.",
                                "zh": "卖家列出了几种<w>支付方式</w>，包括银行转账和电子钱包。"
                            }
