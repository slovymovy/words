                "translations": [
                    {
                        "translation_id": "6b76e778-09b6-40e7-9e39-64a661d2c806",
                        "source_entry_id": "350cbea5-6d54-3ef7-8ec8-9a6522cb05b7",
                        "source_sense_id": "771eca4e-ae1f-3e71-b1d4-1100a97c3116",
                        "source_sense_description": "Besprechung über Angelegenheiten und Fragen, die noch nicht erledigt oder geklärt sind",
                        "target_lang_word": "consultation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consultation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14126e61-b8bc-3247-b4cd-21cb82145e34",
                                        "entry_id": "f728a043-5eb7-3c86-b7bc-ad7871fe0ed7",
                                        "glosses": [
                                            "The act of consulting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27eb4a9-3417-47ad-9110-21992441dbee",
                                                "sense_id": "14126e61-b8bc-3247-b4cd-21cb82145e34",
                                                "text": "Riled by a decision that went against him, Ziv kicked his displaced boot at the assistant referee and, after a short consultation between the officials, he was given his marching orders and the loudest cheer of the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac682189-67bf-37ef-a2b1-0ccb98452f19",
                                        "entry_id": "f728a043-5eb7-3c86-b7bc-ad7871fe0ed7",
                                        "glosses": [
                                            "A conference for the exchange of information and advice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef0b4b1-9778-4937-93a6-479f1d54c005",
                                                "sense_id": "ac682189-67bf-37ef-a2b1-0ccb98452f19",
                                                "text": "Last month I went to a \"consultation\" on racism and sexism sponsored by the U.S. Commission on Civil Rights. It was the first of a series of five conferences designed to bring people together fighting racism and sexiam ^([sic]) to discuss […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b078b078-c5a0-35ca-b696-20c1f1220d21",
                                        "entry_id": "f728a043-5eb7-3c86-b7bc-ad7871fe0ed7",
                                        "glosses": [
                                            "An appointment or meeting with a professional person, such as a doctor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01ffbe7-d576-465b-b304-81c75a1d269a",
                        "source_entry_id": "350cbea5-6d54-3ef7-8ec8-9a6522cb05b7",
                        "source_sense_id": "771eca4e-ae1f-3e71-b1d4-1100a97c3116",
                        "source_sense_description": "Besprechung über Angelegenheiten und Fragen, die noch nicht erledigt oder geklärt sind",
                        "target_lang_word": "consultation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consultation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63a64669-cd77-3db2-82d1-bc4a3f274fec",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Conférence que l’on tient pour consulter sur quelque affaire ou sur une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f3d5535-a23a-4bbd-934d-b534ee5322ab",
                                                "sense_id": "63a64669-cd77-3db2-82d1-bc4a3f274fec",
                                                "text": "Le succès de l’haruspicine ne se limitait pas à la religion officielle. Une foule d’haruspices privés proposait ses consultations au public moyennant finance : dans la Carthage du IVᵉ siècle apr. J.-C., le futur saint Augustin, alors étudiant, y eut encore recours."
                                            },
                                            {
                                                "example_id": "813ce338-a63f-4291-9e9c-d302e5f27a07",
                                                "sense_id": "63a64669-cd77-3db2-82d1-bc4a3f274fec",
                                                "text": "L'éloge des nouvelles liaisons nodales, qu'entonnent imperturbablement Deleuze et Guattari, mettait des mots-clés à disposition de l’innovationnisme d'une industrie de la consultation agissant à l'échelle mondiale, mots qui tournent depuis autour de notions creuses comme « créativité », « invention », « excellence » et « incentive »."
                                            },
                                            {
                                                "example_id": "e52696df-bf81-4303-a259-155b60b0e8fa",
                                                "sense_id": "63a64669-cd77-3db2-82d1-bc4a3f274fec",
                                                "text": "Appeler un médecin en consultation, Le faire venir pour conférer avec le médecin ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1360a53-3eb3-3886-b4ca-e7507a2bb3ff",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Sondage, vote ou référendum."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f3dc187-1027-40ce-bea8-56b5d57d2f38",
                                                "sense_id": "c1360a53-3eb3-3886-b4ca-e7507a2bb3ff",
                                                "text": "La consultation de mercredi s’est tenue dans de bonnes conditions, et le « oui » l’a emporté de peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c514daf-713d-390e-9903-f11f16b266f8",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Avis verbal ou écrit que les avocats ou les médecins donnent touchant l’affaire, touchant la maladie sur laquelle on les consulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77371c9-a7a2-4453-a0be-b3ca3ad95b19",
                                                "sense_id": "9c514daf-713d-390e-9903-f11f16b266f8",
                                                "text": "L'échographie mammaire doit être intégrée dans la consultation sénologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63fc38db-a7d7-30e3-95e3-78c0fc587322",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Lieu et heure auxquels un médecin reçoit les malades."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7a6c4a-182b-4d16-aa89-61870b820498",
                                                "sense_id": "63fc38db-a7d7-30e3-95e3-78c0fc587322",
                                                "text": "Aller à la consultation."
                                            },
                                            {
                                                "example_id": "b8b3343d-b0f9-4781-aa79-7124d46c38d1",
                                                "sense_id": "63fc38db-a7d7-30e3-95e3-78c0fc587322",
                                                "text": "Envoyer quelqu’un à la consultation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf78f52-ed7d-3469-ae65-06fec9dcd6fa",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Procédure engagée par un client visant à recueillir des offres pour un marché ouvert à la concurrence ; appel d’offres."
                                        ],
                                        "tags": [
                                            "Marché public"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b47512f-2ad7-4d2e-bad9-6665e6bdc0f4",
                                                "sense_id": "3bf78f52-ed7d-3469-ae65-06fec9dcd6fa",
                                                "text": "Cette association permet ensuite à l’entreprise de proposer les réponses techniques qui lui paraissent les plus appropriées aux choix du maître d’œuvre et de développer des variantes, ce qui est accepté dans les offres de la consultation."
                                            },
                                            {
                                                "example_id": "71d06c64-bf6c-41c0-b179-7311a91d1bcb",
                                                "sense_id": "3bf78f52-ed7d-3469-ae65-06fec9dcd6fa",
                                                "text": "De par sa position, le chef de projet peut être amené à établir lui-même le chiffrage d'une prestation. En général, cette action fait suite à la remise d'une consultation sous la forme d'un cahier des charges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1158eab-a06a-375b-82ab-be3e74a9e0d9",
                                        "entry_id": "c8fd449e-aea1-3da1-a87b-7ac6726dab00",
                                        "glosses": [
                                            "Le fait de lire un document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
