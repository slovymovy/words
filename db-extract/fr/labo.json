                    },
                    {
                        "translation_id": "bc9429df-c05d-49e5-8d01-8c6815c47ca6",
                        "source_entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                        "source_sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                        "target_lang_word": "лаба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лаба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f40d5d-2c12-336a-8b38-994efee3cc55",
                                        "entry_id": "987b1235-8eec-3474-aea1-3bfb3e1afcc4",
                                        "glosses": [
                                            "жарг. сокр. от лаборатория"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4065954f-f67a-48af-b3fc-b29a9d1543eb",
                                                "sense_id": "c9f40d5d-2c12-336a-8b38-994efee3cc55",
                                                "text": "Баев привел меня в какое-то очень закрытое учреждение, в котором действовал строгий пропускной режим: входили и выходили по часам, расписывались за оборудование, за пожарную безопасность, за неразглашение информации и т. д. Однако попасть в лабу, минуя формальности, было проще простого — надо всего лишь воспользоваться другим входом, где никакой охраны нет, подняться по лестнице на последний этаж, пройти по коридору до другой лестницы и спуститься вниз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8215216f-b071-3d6d-a3ad-838ae2bdadfa",
                                        "entry_id": "987b1235-8eec-3474-aea1-3bfb3e1afcc4",
                                        "glosses": [
                                            "школьн., студ. жарг. лабораторная работа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544f6d39-9452-47a4-990a-8c4ec745899b",
                                                "sense_id": "8215216f-b071-3d6d-a3ad-838ae2bdadfa",
                                                "text": "Это был очередной вторник, в Политехе, и настроение с самого утра у меня, как и у моей Подопечной было не самое лучшее, мягко говоря, от осознания одного печального для нас факта — сегодня лаба по информатике."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
