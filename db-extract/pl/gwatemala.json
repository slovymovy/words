                                    {
                                        "sense_id": "45973938-0acd-37ac-9884-744a261b8c35",
                                        "entry_id": "7eddc5a9-7eea-3423-b803-9004c6d92792",
                                        "glosses": [
                                            "Pays d’Amérique centrale, entouré par le Mexique, le Belize, la mer des Caraïbes, le Honduras, le Salvador et l’océan Pacifique ^([1]). Sa capitale est Guatemala."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218cb444-5e2a-4b6b-aa18-7452a703f12d",
                                                "sense_id": "45973938-0acd-37ac-9884-744a261b8c35",
                                                "text": "S’il y a toujours parmi eux beaucoup de Mexicains, leur proportion est en baisse alors qu'augmente le nombre de migrants originaires du Honduras, du Salvador ou du Guatemala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e220632c-281a-3205-9429-10d0126a5f23",
                                        "entry_id": "7eddc5a9-7eea-3423-b803-9004c6d92792",
                                        "glosses": [
                                            "Chaîne du Guatemala : Partie des Cordillères, entre les deux Amériques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e7865db-baa4-3f2b-a57b-41cad18e2510",
                                        "entry_id": "7eddc5a9-7eea-3423-b803-9004c6d92792",
                                        "glosses": [
                                            "Capitale de ce pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ed681a-9bf7-48b2-87e4-8626779e53e1",
                                                "sense_id": "3e7865db-baa4-3f2b-a57b-41cad18e2510",
                                                "text": "Ayant examiné d’urgence la communication adressée au Président du Conseil de sécurité par le Gouvernement du Guatemala …"
                                            },
                                            {
                                                "example_id": "ef514046-1f8c-4dcd-b0cc-8a3113b5bc78",
                                                "sense_id": "3e7865db-baa4-3f2b-a57b-41cad18e2510",
                                                "text": "Chacun sait que cette révolution, en détachant les colonies espagnoles de leur métropole, avait transformé la vice-royauté de Guatemala en une république fédérative, composée de cinq provinces, dont la ville de Guatemala restait le chef-lieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
