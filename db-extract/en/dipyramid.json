                                        "glosses": [
                                            "Figure géométrique formée par deux pyramides reliées par une même base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd35b6c-af87-4551-bb7c-e4e22bbe4d87",
                                                "sense_id": "10536311-516e-3482-a20d-df2f5e024a88",
                                                "text": "Les formes de l’holoédrie persistent, à l’exception de la dipyramide ditétragonale, qui donne le trapézoèdre tétragonal (gauche et droit)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64d1e2e7-0261-4f17-ab70-cdf670f6b6d0",
                        "source_entry_id": "5d9f40c6-b707-3fb5-8a9b-56f5bbf081d5",
