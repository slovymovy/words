                    {
                        "translation_id": "7ff33de8-ac91-44d5-857b-fd69e8fa11e7",
                        "source_entry_id": "aae08ab9-39de-3539-a227-42f9af29bd04",
                        "source_sense_id": "bb696fb5-5c4a-3b4d-bd9a-8418e752506d",
                        "source_sense_description": "das Aufkommen mit dem Bauch nach einem Sprung ins Wasser",
                        "target_lang_word": "plat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "056eb1bc-9cab-3fa2-9964-1ec94df67323",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Sans relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a168dcbb-e44e-4bbc-8e02-503c3c0e14ae",
                                                "sense_id": "056eb1bc-9cab-3fa2-9964-1ec94df67323",
                                                "text": "Avec le vent du nord écoutez-le craquer / Le plat pays qui est le mien"
                                            },
                                            {
                                                "example_id": "51734ae1-e7b7-4f2b-98d4-21433f95ecb9",
                                                "sense_id": "056eb1bc-9cab-3fa2-9964-1ec94df67323",
                                                "text": "J’ai gravi la colline qui domine la ville aux toits plats, aux murailles dorées comme un gâteau de miel frit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "659ef94c-f29d-3e42-ad29-996c755245e2",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Égal, sans à-coups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611ae330-562f-4733-96c4-f56ca40e953d",
                                                "sense_id": "659ef94c-f29d-3e42-ad29-996c755245e2",
                                                "text": "J’aurais eu tort de me plaindre, j’avais besoin de temps plat, étant donné la tâche ardue que j’avais à accomplir : mémoriser tout un livre de dialogues persans-français écrit par M. Nicolas, le traducteur de Khayyam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fcafd28-485f-3346-8b39-b8447dd6b6a2",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Sans intérêt, quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f408a820-78c5-416c-acc2-27039c325a36",
                                                "sense_id": "4fcafd28-485f-3346-8b39-b8447dd6b6a2",
                                                "text": "Tu ne m’en voudras pas de rappeler que sa conversation était plate, qu’elle habitait un univers si borné et usait d’un vocabulaire si réduit qu’au bout de trois minutes je désespérais de soutenir la conversation."
                                            },
                                            {
                                                "example_id": "57e969e9-00e3-4c98-8397-608e68e060d5",
                                                "sense_id": "4fcafd28-485f-3346-8b39-b8447dd6b6a2",
                                                "text": "Ah oui ! J’y ai vu tes fesses, une fois… Comme quoi y a pas que ton style qui est plat…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d57d7bcd-12ae-39d7-962a-5541fade8e17",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Se dit d'un angle dont la mesure vaut exactement π (pi) radians (180 degrés)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e71c27e7-70d1-3e0c-87f6-a1555906fc5e",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Se dit d'une variété riemannienne dont la courbure est nulle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d6ac26c-75fe-38d6-a80a-bb2b40c5484a",
                                        "entry_id": "a93c8aa2-4d28-374d-95b7-ea74b9eaec81",
                                        "glosses": [
                                            "Se dit d'un pneu qui n'a plus assez d'air pour rester gonflé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fec4217-1689-3efa-bcea-a752c7762454",
                                        "entry_id": "c52fe96e-7ad1-3e68-9e8f-7d89d17575e5",
                                        "glosses": [
                                            "Pièce de vaisselle, à fond plat destinée à contenir les mets qu’on sert sur la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def721a1-0427-4cd0-9889-bb6310a561c4",
                                                "sense_id": "6fec4217-1689-3efa-bcea-a752c7762454",
                                                "text": "À un appel de sonnette on plaçait les plats et tout ce qui était nécessaire sur un monte-charge qui s’élevait jusqu’à la salle à manger et redescendait aussitôt."
                                            },
                                            {
                                                "example_id": "b98de3bb-5aed-48ef-a79c-6378ad337967",
                                                "sense_id": "6fec4217-1689-3efa-bcea-a752c7762454",
                                                "text": "Mettez les filets de haddock dans un plat creux, versez le lait par-dessus et laissez tremper pendant 30 minutes."
                                            },
                                            {
                                                "example_id": "b833f188-8a67-47a9-a248-a12e3cac7673",
                                                "sense_id": "6fec4217-1689-3efa-bcea-a752c7762454",
                                                "text": "Une soupe aux herbes et à l’eau de haricots, un morceau de veau aux pommes de terre, inondé d’eau rousse en guise de jus, un plat de haricots et des cerises d’une qualité inférieure, le tout servi et mangé dans des assiettes et des plats écornés avec l’argenterie peu sonore et triste du maillechort, était-ce un menu digne de cette jolie femme ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "656bdc4a-63a2-303e-82b4-acfb1cf4c38b",
                                        "entry_id": "c52fe96e-7ad1-3e68-9e8f-7d89d17575e5",
                                        "glosses": [
                                            "Ce qui y est contenu, mets."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74fd32d7-f0ec-4a83-994c-c7f8ba9db188",
                                                "sense_id": "656bdc4a-63a2-303e-82b4-acfb1cf4c38b",
                                                "text": "Le fruit de l’épine-vinette est utile pour conserver et confire et pour garnir les plats."
                                            },
                                            {
                                                "example_id": "18ff1d4f-e66a-4f6e-8ddf-e615363f8115",
                                                "sense_id": "656bdc4a-63a2-303e-82b4-acfb1cf4c38b",
                                                "text": "Il continua sa marche, pénétrant dans la vieille ville, et entra dans un petit restaurant qui servait de la socca, un plat traditionnel qu'il appréciait."
                                            },
                                            {
                                                "example_id": "709fe81d-9885-4130-8319-90e55fb4a1e6",
                                                "sense_id": "656bdc4a-63a2-303e-82b4-acfb1cf4c38b",
                                                "text": "Si monotone qu’en soit la rusticité, le plat ne manque pas de saveur, parfumé d’un lard si épais, si tendre qu’il ne laisse guère de cretons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72fecc0-d09e-3a12-a895-7e2afa0f0092",
                                        "entry_id": "c52fe96e-7ad1-3e68-9e8f-7d89d17575e5",
                                        "glosses": [
                                            "Activité ou bien."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ad2543-6a4b-425b-b375-ac9e5ed14199",
                                                "sense_id": "f72fecc0-d09e-3a12-a895-7e2afa0f0092",
                                                "text": "Je ne mange pas de ce plat-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72fc6159-8900-3996-b04a-cfe6015bcb45",
