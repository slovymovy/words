                            {
                                "example_id": "78aad26a-0c9c-408b-a703-39a2943ae12a",
                                "sense_id": "6e03eda2-04cc-3b02-b41c-84bb22f22ac4",
                                "text": "Hij heeft zich ingedekt tegen alle mogelijke schadeclaims die men tegen hem zou kunnen indienen."
                            },
                            {
                                "example_id": "d1e9a6e0-0fd0-40b0-86b8-0947ae69f77f",
                                "sense_id": "6e03eda2-04cc-3b02-b41c-84bb22f22ac4",
                                "text": "Rentederivaten zijn beleggingsproducten waarmee ondernemers zich konden indekken tegen een mogelijke stijging van de rente op hun kredieten. Daarbij bleef vaak onderbelicht dat zij juist risico liepen als de rente zou dalen."
                            }
                        ]
                    }
