                        "glosses": [
                            "Qualifie un taxon qui produit de petites spores."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a724e8c1-205d-4bf0-8417-03b48bffcbe1",
                                "sense_id": "aa3da553-a5a7-34d3-b329-959ca7dfa5d0",
                                "text": "Nous n’avons pu reconnaître d’endospore chez les espèces microspores que sont [Gymnopilus] bellulus et flavus. Chez G. penetrans, (...)"
                            },
                            {
                                "example_id": "6dfb30f0-5569-4d42-b095-dd8fbe604ae3",
                                "sense_id": "aa3da553-a5a7-34d3-b329-959ca7dfa5d0",
                                "text": "L’interprétation de Heim (S.M.F. 46, Atl. : 36) situe définitivement Ph. christinae dans le groupe des espèces microspores à cellules marginales atténuées, il est donc plus sage de nous en tenir là."
                            }
                        ]
                    }
