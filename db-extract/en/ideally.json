                                "target_senses": [
                                    {
                                        "sense_id": "c66f4928-78a7-3bdd-8715-b3edecab2358",
                                        "entry_id": "a3270dfb-7969-3f95-8fb2-15b5968f8407",
                                        "glosses": [
