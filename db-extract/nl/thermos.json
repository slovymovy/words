                        "glosses": [
                            "verkorting van thermosfles of thermoskan, een kan of fles waarin warme vloeistoffen warm kunnen blijven en koude vloeistoffen koud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5408d5c-277a-4cb0-819d-e4d1b6954a31",
                                "sense_id": "11ff654b-cebe-3615-868f-b2de32b7f759",
                                "text": "De directrice van het cultuurcentrum heeft zo’n oude thermos vol koffie gemaakt. Die staat nu tussen ons in, op het houten bankje buiten. Af en toe komt een werknemer er een kopje uit duwen."
                            },
                            {
                                "example_id": "13c5cd42-19ca-4d4d-b53b-445b7e3243f6",
                                "sense_id": "11ff654b-cebe-3615-868f-b2de32b7f759",
                                "text": "De firma Thermos houdt al 110 jaar de thee warm. 470 ml, € 26. thermos.com"
                            }
                        ]
