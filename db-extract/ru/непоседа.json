                        "examples": [
                            {
                                "example_id": "48df08ff-9058-4e11-8890-71b910f1bd2e",
                                "sense_id": "3c6952e2-7d04-3629-b211-3cf231644502",
                                "text": "— Ну что ж ты так вертишься, непоседа мой маленький?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f880a72-309e-4a8e-ad6b-b144e442875b",
                        "source_entry_id": "d21585c8-41bf-3a81-971d-6032ca207404",
                        "source_sense_id": "3c6952e2-7d04-3629-b211-3cf231644502",
                        "target_lang_word": "fidget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fidget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8a6308-d0e8-3fb7-b911-178b42013ef1",
                                        "entry_id": "ae1dd897-1191-3441-a7a6-c0ba899ef997",
                                        "glosses": [
                                            "To wiggle or twitch; to move the body, especially the fingers, around nervously or idly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bb6497-6b0d-42c0-a717-0a315cf90903",
                                                "sense_id": "8c8a6308-d0e8-3fb7-b911-178b42013ef1",
                                                "text": "\"Look, Jim, how my fingers fidget,\" he continued, in the pleading tone. \"I can't keep e'm still, not I.\""
                                            },
                                            {
                                                "example_id": "4a979b40-57cf-449a-b182-933de9c539c4",
                                                "sense_id": "8c8a6308-d0e8-3fb7-b911-178b42013ef1",
                                                "text": "Will you stop fucking about and fidgeting in my peripherals? I'm trying to concentrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd434a84-e494-3262-a1b0-b2b9063ac085",
                                        "entry_id": "ae1dd897-1191-3441-a7a6-c0ba899ef997",
                                        "glosses": [
                                            "To cause to fidget; to make uneasy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79079846-0e0f-4a01-b95d-dd9fc61b9619",
                                                "sense_id": "fd434a84-e494-3262-a1b0-b2b9063ac085",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fidget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c17f80e-6675-3e74-a342-49f87589c301",
                                        "entry_id": "3e5d03b5-c39f-3ee4-9e1c-33aafff8ec32",
                                        "glosses": [
                                            "A nervous wriggling or twitching motion."
