                        "entry_id": "f3dad642-c3c8-3bf5-a2d1-c1e2bcace0ee",
                        "glosses": [
                            "Qu’il est impossible de dessouder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c724ec-bd6f-4160-8b17-fcf5ba21e3ea",
                                "sense_id": "4f76ce38-58c5-3a39-933a-6787676cc49f",
                                "text": "Mᵐᵉ Bérard n’est pas seulement une femme, elle est mère... et les enfants seraient entre vous la chaîne indessoudable..."
                            },
                            {
                                "example_id": "741df197-513a-4e7a-ad3a-b2e5cd0db712",
                                "sense_id": "4f76ce38-58c5-3a39-933a-6787676cc49f",
                                "text": "Pas d’obsolescence programmée, pas de composants indessoudables à la provenance douteuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b19c74c-d8ab-3e98-a2b2-42e62852f9c7",
                        "entry_id": "f3dad642-c3c8-3bf5-a2d1-c1e2bcace0ee",
                        "glosses": [
                            "Qu’il est impossible de désunir, de dissocier."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "69c9726e-5aa2-46e2-9712-f1b0b25be9dd",
                                "sense_id": "8b19c74c-d8ab-3e98-a2b2-42e62852f9c7",
                                "text": "Les musiciens s’arrêtèrent un instant et les deux jeunes gens restèrent enlacés, indessoudables, écoutant le galop effréné de leurs cœurs."
                            },
                            {
                                "example_id": "82e8aa44-ced3-4577-8ddb-501699dbac53",
                                "sense_id": "8b19c74c-d8ab-3e98-a2b2-42e62852f9c7",
                                "text": "Son penchant prononcé pour le lieutenant Lecoanet et leurs goûts communs pour les bonnes choses en ont rapidement fait une équipe, au dire des pires détracteurs, « indessoudable »..."
                            },
                            {
                                "example_id": "fa57447e-536e-4a9b-bd69-cfa41bdc05a6",
                                "sense_id": "8b19c74c-d8ab-3e98-a2b2-42e62852f9c7",
                                "text": "Et même si d’excellents autres joueurs comme l’arrière Jack Cantoni s’y sont ajoutés, c’est d’abord cette ennéade, ce groupe indessoudable - au sens propre du terme - de neuf hommes, qui a fait la supériorité de ce « grand Béziers »."
                            }
                        ]
                    }
