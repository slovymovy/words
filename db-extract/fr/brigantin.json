                ],
                "senses": [
                    {
                        "sense_id": "12e54ff4-4a8c-3318-9750-e8f97bf9f1cd",
                        "entry_id": "43cdf99c-3a20-33c2-8853-5af02956f203",
                        "glosses": [
                            "Petit bâtiment à un ou deux mâts, gréé comme un brick, et qui n’a qu’un pont."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "fb93cdff-a0fa-437f-b67d-0fda9da069c2",
                                "sense_id": "12e54ff4-4a8c-3318-9750-e8f97bf9f1cd",
                                "text": "A 2 milles dans l'est-nord-est se trouverait une roche couverte de 2 mètres d'eau, désignée sous le nom de Helen, porté par un brigantin de Dundee qui s'y perdit le 19 avril 1824."
                            },
                            {
                                "example_id": "1db9af4e-dba9-4b46-b743-c3bca655774d",
                                "sense_id": "12e54ff4-4a8c-3318-9750-e8f97bf9f1cd",
                                "text": "Le 10 février 1606, il fit mouiller un brigantin dans un de ses ports."
                            },
                            {
                                "example_id": "fe278f76-5421-48cb-9599-4498fef1ce21",
                                "sense_id": "12e54ff4-4a8c-3318-9750-e8f97bf9f1cd",
                                "text": "Les navires de l’époque, trois-mâts, brigantins ou goélettes, jaugent entre 150 et 200 tonneaux..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d9a618-4f9a-4bfa-a90d-16e9cc14e3ea",
                        "source_entry_id": "43cdf99c-3a20-33c2-8853-5af02956f203",
                        "source_sense_id": "12e54ff4-4a8c-3318-9750-e8f97bf9f1cd",
                        "target_lang_word": "Brigantine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brigantine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                        "entry_id": "2cd8e40f-adb3-3ce2-8366-7ac9ecb65af2",
                                        "glosses": [
                                            "Segelschiff mit zwei Masten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e76f5fe9-5f7e-4ed2-be84-fcdced974727",
                                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                                "text": "„Hier war es besonders schwierig, weil die Brigantine unaufhörlich in der bewegten See hin und her gierte und das kleine Boot von jeder heranlaufenden Welle hochgehoben wurde, bevor es wieder in ein Wellental sackte.“"
                                            },
                                            {
                                                "example_id": "845c43fb-4f2b-4a58-8ac1-c2a88e5e769a",
                                                "sense_id": "58e5414a-49d2-307a-bf58-0fa7df9e18e0",
                                                "text": "„Eine neue Waffe schwamm jetzt im trüben Wasser des Sees: 13 kleine Kriegsschiffe, Brigantinen, bemannt mit Armbrustschützen und Musketieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d70bc27-b198-3542-8de7-d2b74e1e6a48",
                                        "entry_id": "2cd8e40f-adb3-3ce2-8366-7ac9ecb65af2",
                                        "glosses": [
                                            "Rüstung aus zahlreichen kleinen Metallplättchen, die auf Stoff befestigt sind"
                                        ],
