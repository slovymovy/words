                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b4ac04a-1b83-3743-91af-fd2c4a6b3b5b",
                        "entry_id": "e31a7595-acbd-37bf-be91-785e755b9bf7",
                        "glosses": [
                            "Cordage servant à arrêter un bâtiment à terre ou à l’attacher à un autre bâtiment, et en général tout cordage qu’on emploie à attacher divers objets dans un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7899175b-3b1f-4f23-b60c-b18123ee6e5f",
                                "sense_id": "1b4ac04a-1b83-3743-91af-fd2c4a6b3b5b",
                                "text": "Il flottait tranquillement sur les eaux du lagon, retenu au rivage par une forte amarre."
                            },
                            {
                                "example_id": "c657ac34-52e4-4d6a-996f-ce2565e1a1cd",
                                "sense_id": "1b4ac04a-1b83-3743-91af-fd2c4a6b3b5b",
                                "text": "– Décapités et leurs têtes, percées d’outre en outre, étaient enfilées sur une amarre comme un horrible chapelet."
                            }
                        ]
                    },
                    {
                        "sense_id": "3936c88f-437a-3aaa-a4d1-3b27065f6bc8",
                        "entry_id": "e31a7595-acbd-37bf-be91-785e755b9bf7",
                        "glosses": [
                            "Corde, ficelle, câble servant à attacher ou à lier."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "57ade568-3564-446c-85a8-a5fb9d71e7d9",
                                "sense_id": "3936c88f-437a-3aaa-a4d1-3b27065f6bc8",
                                "text": "Le véhicule roulait au ralenti et il avait piètre allure avec un pneu à plat, le pare-chocs tordu, la bâche protégeant sa cargaison soufflée par la bourrasque et emmêlée dans les amarres."
                            },
                            {
                                "example_id": "35083fb0-7383-4394-aa37-e1805d51359b",
                                "sense_id": "3936c88f-437a-3aaa-a4d1-3b27065f6bc8",
                                "text": "Amarres de souliers. — Attache l'amarre de la tente sur un piquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee96f68f-66a8-3132-8a05-6dc129014875",
                        "entry_id": "e31a7595-acbd-37bf-be91-785e755b9bf7",
                        "glosses": [
                            "Morceau de bois, allant par paire, percé au milieu, dans lequel l’on passait le bout d’un moulinet."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
