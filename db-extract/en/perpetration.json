                        "examples": []
                    },
                    {
                        "sense_id": "cda246ac-a2a6-33ce-bb2d-798acfb4ebda",
                        "entry_id": "bf76bb2a-4c62-3d6c-8c15-36796761e4c8",
                        "glosses": [
                            "Something (such as a crime) that is perpetrated"
                        ],
                        "tags": [
