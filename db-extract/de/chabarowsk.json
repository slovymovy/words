                "senses": [
                    {
                        "sense_id": "502b28e1-9afd-381b-81bb-287dd18074ed",
                        "entry_id": "740043d1-7948-3671-a8ab-b43aa7af1c28",
                        "glosses": [
                            "eine Region und deren Hauptstadt im russischen Föderationskreis Fernost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ada3ce-d72a-41b9-a783-b6705c4e3b39",
                                "sense_id": "502b28e1-9afd-381b-81bb-287dd18074ed",
                                "text": "Ich lebte 40 Jahre in Chabarowsk."
                            },
                            {
                                "example_id": "d1fcd42c-f69f-449e-8e23-b4509d7ba4d3",
                                "sense_id": "502b28e1-9afd-381b-81bb-287dd18074ed",
                                "text": "„Der Lokführer des Neu-Uhr-Zuges nach Chabarowsk hatte beim ersten Halt durchgegeben, dass er nach dem Verlassen des Jaroslawer Bahnhofs einen flüchtigen Blick auf jemanden oder etwas auf den Gleisen erhascht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69166452-7c44-469f-b5c0-a1c40e5da7f3",
                        "source_entry_id": "740043d1-7948-3671-a8ab-b43aa7af1c28",
                        "source_sense_id": "502b28e1-9afd-381b-81bb-287dd18074ed",
                        "source_sense_description": "eine Region und deren Hauptstadt im russischen Föderationskreis Fernost",
                        "target_lang_word": "Khabarovsk",
