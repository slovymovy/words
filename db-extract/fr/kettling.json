                                                "example_id": "137fc214-932c-4770-91ad-2e729773ef5e",
                                                "sense_id": "ada69749-2e5b-35cb-a066-2f4218416a66",
                                                "text": "„›Der Polizeikessel diente eindeutig der Einschüchterung‹, so Hebel.“"
                                            }
