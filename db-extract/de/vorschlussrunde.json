                        "glosses": [
                            "Runde der letzten vier Spieler oder Mannschaften in einem Turnier, bei der sich zwei für das Finale qualifizieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "954a0baf-6d53-4b6b-8815-f6457a414a9f",
                                "sense_id": "beb6d2a0-95dc-309e-a46d-aec604b92c8d",
                                "text": "„Die Frauen aus den USA haben in London das Finale erreicht. Die US-Frauen fertigten am Donnerstag in der Vorschlussrunde Südkorea mit 3:0 (25:20, 25:22, 25:22) ab und erreichten damit wie schon 2008 das Endspiel.“"
                            }
                        ],
