                    {
                        "sense_id": "a55fbd33-91f1-3967-8cc0-b5823e302ef8",
                        "entry_id": "810af2bc-6e5a-3c46-9d81-ac8dc77fe1cc",
                        "glosses": [
                            "Repas complet servi sur un plateau, de manière à pouvoir être consommé loin de son lieu de préparation, et servi notamment en milieu hospitalier, dans les transports, les cantines scolaires, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72a78b6-d402-4a70-a01e-4bebd90a147c",
                                "sense_id": "a55fbd33-91f1-3967-8cc0-b5823e302ef8",
                                "text": "Le TV Dinner est un plateau-repas vendu avec des ingrédients rangés dans de petites cases, le plus souvent congelés. Destiné aux téléspectateurs, il a été inventé en 1953 par Gerry Thomas."
                            },
                            {
                                "example_id": "25053a79-8ef6-4443-bc7d-acfd7facdbb5",
                                "sense_id": "a55fbd33-91f1-3967-8cc0-b5823e302ef8",
                                "text": "Il a testé auprès d'un de ses amis PDG d'une petite société de services informatiques son nouveau concept: le plateau-repas avec plat chaud."
                            },
                            {
                                "example_id": "0e585afe-13c8-446a-bd64-8d8894e8b111",
                                "sense_id": "a55fbd33-91f1-3967-8cc0-b5823e302ef8",
                                "text": "Comment les labos font-ils pour s'immiscer au cœur de la vie hospitalière ? Peut-on vraiment orienter les prescriptions des médecins en leur offrant des plateaux-repas ?"
                            }
                        ]
                    }
                ],
