                "senses": [
                    {
                        "sense_id": "442930bb-9121-363d-895f-d686302e178e",
                        "entry_id": "f8660cfe-a621-3536-8cee-a1d8d0e36414",
                        "glosses": [
                            "langgerekte bank van waarachter men klanten bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64330b09-66fe-40ff-9c29-dad52b0bb47c",
                                "sense_id": "442930bb-9121-363d-895f-d686302e178e",
                                "text": "We kunnen nog wel iemand aan de balie gebruiken."
                            },
                            {
                                "example_id": "c045ee34-6a9a-452a-904c-337f1fa5d8ca",
                                "sense_id": "442930bb-9121-363d-895f-d686302e178e",
                                "text": "Bij de balie van het hotel stond een kleine roze leenfiets waarop ik tevreden richting het winkelcentrum fietste."
                            },
                            {
                                "example_id": "7a8c5699-4657-43eb-9856-1765d922ddfc",
                                "sense_id": "442930bb-9121-363d-895f-d686302e178e",
                                "text": "Zo staat de bibliothecaresse erbij, hoort de verhalen aan, die ze al lijkt te kennen, met de piëteit van een non die, al staat ze nog zo in de ademtocht van de duivel, toch barmhartigheid kan schenken aan deze armzalige, gevallen ziel. Yousef Slaoui beent de balie voorbij. Hij voelt haar blik in zijn rug prikken, en ook de zwerver is lichtelijk afgeleid, neemt hoorbaar een slok van zijn koffie, probeert dan een halfslachtige poging te doen zijn verhaal te hervatten, wat niet lukt."
                            }
                        ]
                    },
                    {
                        "sense_id": "31b7f36d-f6e2-3e9b-833b-59746e0a1c77",
                        "entry_id": "f8660cfe-a621-3536-8cee-a1d8d0e36414",
                        "glosses": [
                            "een beroepsvereniging van advocaten"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "29622691-1f83-32d8-bf58-c64e8089f20c",
                        "entry_id": "f8660cfe-a621-3536-8cee-a1d8d0e36414",
                        "glosses": [
                            "balustrade, hekwerk, leuning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e1135f-f965-4a00-9683-1af2ea0e0fdb",
                                "sense_id": "29622691-1f83-32d8-bf58-c64e8089f20c",
                                "text": "De balies van de brug zijn samengesteld uit giet- en smeedijzer."
                            }
                        ]
                    }
