                        "entry_id": "d1a7788d-1fb4-3c50-b78c-3db141657c5e",
                        "glosses": [
                            "placówka handlowa w odległej prowincji albo kolonii, w krajach kolonialnych umiejscawiana zwykle na wybrzeżu i ufortyfikowana"
                        ],
                        "tags": [],
