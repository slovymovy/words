                        "glosses": [
                            "Gaulis (taillis dont on peut tirer des gaules). (définition à vérifier)"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a450827e-1dfc-44e4-8673-378fdf030915",
                                "sense_id": "ffd94a28-8bea-3548-b2c4-d67da5ed4a32",
                                "text": "Ils entassèrent du bois pour les charrois d’hiver; ils éclaircirent les rangs serrés de la gaulaie."
                            },
                            {
                                "example_id": "e4b3f3e6-67e9-40cb-a31c-a9e82d6e11ca",
                                "sense_id": "ffd94a28-8bea-3548-b2c4-d67da5ed4a32",
                                "text": "Il se leva, rattacha dignement le devant de sa chemise et, sans un mot, disparut à pas souples dans la gaulaie où le commissaire l’avait rencontré le matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7ddc2e9-bd47-3df9-906c-f095bad79f72",
                        "entry_id": "65919639-1295-3a90-8b00-7c3e542d7553",
                        "glosses": [
                            "Gaulage (pour faire tomber les fruits)."
                        ],
                        "tags": [
