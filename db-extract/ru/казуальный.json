                ],
                "senses": [
                    {
                        "sense_id": "307e9d88-9ea0-3362-a089-ec5e4858bb9e",
                        "entry_id": "ee394204-302c-380c-b5fe-9667e7b1e7e0",
                        "glosses": [
                            "книжн. случайный, совершающийся в зависимости от случая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053ec698-48d4-4f74-8032-ee29279008a1",
                                "sense_id": "307e9d88-9ea0-3362-a089-ec5e4858bb9e",
                                "text": "Они платоничны, неоплатоничны, органичны, оргиастичны, в общем — не каузальны, а казуальны."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d04034-e09d-3ed7-aa4d-671bb187b968",
                        "entry_id": "ee394204-302c-380c-b5fe-9667e7b1e7e0",
                        "glosses": [
                            "юр., истор. связанный с применением правовых норм к конкретным случаям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7c528db-7757-456c-a932-dc1d2064b41e",
                                "sense_id": "f1d04034-e09d-3ed7-aa4d-671bb187b968",
                                "text": "Мораль носит казуальный характер."
                            }
                        ]
                    },
                    {
                        "sense_id": "e17754f2-3cfd-364f-83da-eb5b6bc4ccc6",
                        "entry_id": "ee394204-302c-380c-b5fe-9667e7b1e7e0",
                        "glosses": [
                            "игр. об играх: игра, предназначенная для людей, не увлечённых играми, лёгкая в освоении"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab74fb20-c992-4fbc-a051-806245a396af",
                        "source_entry_id": "ee394204-302c-380c-b5fe-9667e7b1e7e0",
                        "target_lang_word": "casual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0db37e53-bf83-3ec5-8f4b-524f26680a81",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Happening by chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97207db-1f54-4e0b-8de6-68be45ea245c",
                                                "sense_id": "0db37e53-bf83-3ec5-8f4b-524f26680a81",
                                                "text": "They only had casual meetings."
                                            },
                                            {
                                                "example_id": "94de39b0-91aa-4764-b839-e7c0d35671c2",
                                                "sense_id": "0db37e53-bf83-3ec5-8f4b-524f26680a81",
                                                "text": "casual breaks, in the general system"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6543b1ee-6d4a-3c08-8e03-1284f919a697",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Coming without regularity; occasional or incidental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2343ee-330d-4e8e-a366-94c4cb5a33fb",
                                                "sense_id": "6543b1ee-6d4a-3c08-8e03-1284f919a697",
                                                "text": "The purchase of donuts was just a casual expense."
                                            },
                                            {
                                                "example_id": "79a0de82-ffe8-447b-b709-c4585bc99d9c",
                                                "sense_id": "6543b1ee-6d4a-3c08-8e03-1284f919a697",
                                                "text": "a constant habit, rather than a casual gesture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe47872-4985-32f9-923e-ec98db9e7670",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Employed irregularly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f9ada8-de17-4d89-803c-599dc9c9e360",
                                                "sense_id": "7fe47872-4985-32f9-923e-ec98db9e7670",
                                                "text": "He was just a casual worker."
                                            },
                                            {
                                                "example_id": "ee058924-f2bd-47db-8f3a-d4de06292183",
                                                "sense_id": "7fe47872-4985-32f9-923e-ec98db9e7670",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b647a81-c5c2-3907-98ab-b630895d7f3a",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Careless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec812c6-cf2d-4c53-85f1-fc4f89c72bab",
                                                "sense_id": "4b647a81-c5c2-3907-98ab-b630895d7f3a",
                                                "text": "I removed my jacket and threw it casually over the back of the settee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3244c1-fa9e-3b0d-8edd-0ea303b3820e",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Happening or coming to pass without design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2bb583-5342-45a8-a619-2a8ffda0c87d",
                                                "sense_id": "8d3244c1-fa9e-3b0d-8edd-0ea303b3820e",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "4de4ab90-e15f-4f4d-97b9-e78abea63391",
                                                "sense_id": "8d3244c1-fa9e-3b0d-8edd-0ea303b3820e",
                                                "text": "Hogan assumed the entire creek bed was to be played as a casual hazard, moved his ball out and assessed himself a one-stroke penalty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b62b0124-1b40-3bf9-a764-afd657e9e9e3",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Informal; relaxed."
                                        ],
                                        "tags": [
                                            "of behavior"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac55d603-3e05-4939-8572-f0fa394e9d48",
                                                "sense_id": "b62b0124-1b40-3bf9-a764-afd657e9e9e3",
                                                "text": "tone in casual interactions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64c5c212-ca21-3e1b-ad64-dc82e9752780",
                                        "entry_id": "66308310-9998-3e54-a49c-16be63425f19",
                                        "glosses": [
                                            "Designed for informal or everyday use."
                                        ],
                                        "tags": [
                                            "of clothing or utensils"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6cf631d-ba44-4a67-9052-04fb2566519c",
                                                "sense_id": "64c5c212-ca21-3e1b-ad64-dc82e9752780",
                                                "text": "pants in the casual wear collection"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "casual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05b435e8-8c79-3560-9e66-636ac0a4fe58",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A worker who is only working for a company occasionally, not as its permanent employee."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "670e2b84-cc74-30f9-bba6-12a5f8b8d60a",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A worker who is doing a particular type of job temporarily, not as a lifetime career."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c7b867-13d0-47c3-9516-1e27776adfbd",
                                                "sense_id": "670e2b84-cc74-30f9-bba6-12a5f8b8d60a",
                                                "text": "Of the scavagers proper there are, as in all classes of unskilled labour, that is to say, of labour which requires no previous apprenticeship, and to which any one can “turn his hand” on an emergency, two distinct orders of workmen, “the regulars and casuals” to adopt the trade terms; that is to say, the labourers consist of those who have been many years at the trade, constantly employed at it, and those who have but recently taken to it as a means of obtaining a subsistence after their ordinary resources have failed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e63910-da3f-31af-9a05-0a4d1fb6ba44",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A soldier temporarily at a place of duty, usually en route to another place of duty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4f375a-25b3-300b-9a56-ccc64d803086",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A member of a group of football hooligans who wear expensive designer clothing to avoid police attention; see casual (subculture)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d70d752c-b30f-4fd6-8f0d-9ff37e70d035",
                                                "sense_id": "ec4f375a-25b3-300b-9a56-ccc64d803086",
                                                "text": "At 15, he became a casual: one of the label-wearing, wedge-flicking, swaggering hooligan peacock boys who dominated the north-west when I was growing up. Casuals were working-class lads (called Perry boys in Manchester) who loved football, fighting and brilliant sportswear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687b172f-3179-340f-9cb5-184a00624e6e",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "One who receives relief for a night in a parish to which he or she does not belong; a vagrant in the casual ward."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d64ffdf5-1317-4993-af0b-2fb90eaac38c",
                                                "sense_id": "687b172f-3179-340f-9cb5-184a00624e6e",
                                                "text": "During the great prevalence of vagrancy, the cost of the sick was far greater than the expense of relief. In the quarter ending June 1848, no less than 322 casuals were under medical treatment, either in the workhouse of the Wandsworth and Clapham union or at the London Fever Hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d6ae66-74f2-390f-9b7e-fbc3b8159674",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A player of casual games."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd17c8a-bb0b-4860-81c8-1a076b54d2cb",
                                                "sense_id": "74d6ae66-74f2-390f-9b7e-fbc3b8159674",
                                                "text": "The devs dumbed the game down so the casuals could enjoy it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f20626-b2ec-39b0-ac99-d6c5a2b91980",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A person whose engagement with media is relaxed or superficial."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d84991d-ef20-4374-95f5-1480cc9709e4",
                                                "sense_id": "87f20626-b2ec-39b0-ac99-d6c5a2b91980",
                                                "text": "Casuals outnumbered regulars in the art-house audience two to one."
                                            },
                                            {
                                                "example_id": "e97454d8-0099-4de6-a6ab-04467b0c83e9",
                                                "sense_id": "87f20626-b2ec-39b0-ac99-d6c5a2b91980",
                                                "text": "Most often, when a series is marketed toward casuals, the loyals feel that their interests and needs are not being met."
                                            },
                                            {
                                                "example_id": "1a7a4458-1720-4339-bc2e-c67ab50be7d8",
                                                "sense_id": "87f20626-b2ec-39b0-ac99-d6c5a2b91980",
                                                "text": "Treating a gay relationship as a puzzle that must be pursued by the clever viewers and hidden from “casuals” until a narrative reveal at the eleventh hour seems antithetical to the idea of normalized representation that TJLCers claim as the main reason they want Johnlock to be canon, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e46dde-be49-32a0-a17d-23a78eaba36e",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "A tramp."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf381463-e4bb-4abf-a73a-e172c5636c2d",
                                                "sense_id": "27e46dde-be49-32a0-a17d-23a78eaba36e",
                                                "text": "I was a boy in 1922 or 1923, when buses first started to run between the village and the town; there were tramps, casuals as they were called; the whole pattern of my boyhood was knit into a very loaded atmosphere of human character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15cddc91-624e-378e-ba84-b0a973c1fcb4",
                                        "entry_id": "47f21fd7-6999-35ce-969a-914748959d89",
                                        "glosses": [
                                            "Shoes suitable for everyday use, as opposed to more formal footwear."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32870585-4203-40c5-a158-fc79a79649a0",
                                                "sense_id": "15cddc91-624e-378e-ba84-b0a973c1fcb4",
                                                "text": "Next spring you’ll see more women than ever wearing “casuals” and “flats,” the shoes with the wedge heels or no heels at all."
                                            },
                                            {
                                                "example_id": "b96eba36-d95b-4b6c-a103-dd9304368995",
                                                "sense_id": "15cddc91-624e-378e-ba84-b0a973c1fcb4",
                                                "text": "In girls wearing casuals, ugly hypertrophied skin over the heels was frequently noted, probably due to the loose shoe moving as they walked."
                                            },
                                            {
                                                "example_id": "e998a7d7-7bb4-4589-8e47-b166e5069b40",
                                                "sense_id": "15cddc91-624e-378e-ba84-b0a973c1fcb4",
                                                "text": "Like his friends, he is wearing casuals, ideal for lounging around crypts."
                                            },
                                            {
                                                "example_id": "9a455ac8-da92-4155-8f2c-238e3898afed",
                                                "sense_id": "15cddc91-624e-378e-ba84-b0a973c1fcb4",
                                                "text": "He and I were wearing casuals[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
