{
    "word_family": [
        "prétendre",
        "prétentieux",
        "prétentieusement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5268ddf-669c-3721-b4c7-f0ab7563de35",
                    "sense_definition": "Fait de prétendre à quelque chose, droit ou ambition que l'on revendique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune chercheur n'a pas la <w>prétention</w> de révolutionner toute la physique contemporaine."
                        },
                        {
                            "text": "Le royaume voisin n'a jamais renoncé à ses <w>prétentions</w> sur cette province frontalière."
                        }
                    ],
                    "synonyms": [
                        "ambition",
                        "revendication"
                    ],
                    "common_phrases": [
                        "avoir la prétention de",
                        "sans prétention"
                    ]
                },
                {
                    "sense_id": "a41251da-b067-3dc8-9117-f7766d196d5b",
                    "sense_definition": "Fait d'avoir une trop haute opinion de soi-même ; vanité, orgueil.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude pleine de <w>prétention</w> agace souvent l'ensemble de ses collègues de bureau."
                        },
                        {
                            "text": "Malgré son immense succès populaire, elle répondait aux journalistes sans la moindre <w>prétention</w>."
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "orgueil",
                        "suffisance",
                        "vanité"
                    ],
                    "antonyms": [
                        "humilité",
                        "modestie",
                        "simplicité"
                    ],
                    "common_phrases": [
                        "plein de prétention"
                    ]
                },
                {
                    "sense_id": "41609bfe-e336-38f3-9a24-d5c9a0865f1f",
                    "sense_definition": "Exigences ou demandes, particulièrement en matière financière ou contractuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat a formulé ses <w>prétentions</w> salariales lors du deuxième entretien d'embauche."
                        },
                        {
                            "text": "L'acheteur a demandé au propriétaire de revoir ses <w>prétentions</w> à la baisse."
                        }
                    ],
                    "synonyms": [
                        "exigence",
                        "revendication"
                    ],
                    "common_phrases": [
                        "prétentions salariales",
                        "revoir ses prétentions"
                    ]
                },
                {
                    "sense_id": "116f6e5d-1640-339c-a164-2d7b9101db23",
                    "sense_definition": "Volonté de plaire ou de séduire encore, en parlant d'une personne qui avance en âge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même à un âge très avancé, cet homme conservait des <w>prétentions</w> de séducteur invétéré."
                        },
                        {
                            "text": "Cette ancienne comédienne refuse d'accepter son âge et affiche encore des <w>prétentions</w> amoureuses ridicules."
                        }
                    ],
                    "common_phrases": [
                        "avoir des prétentions"
                    ]
                }
            ]
        }
    ]
}