                        "examples": [
                            {
                                "example_id": "01cb3787-2cde-4bca-927a-20ad27cd6198",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "De toeschouwers hadden zich goed gekleed op het slechte weer."
                            },
                            {
                                "example_id": "34dc0a78-4a47-40c3-92de-c5dd8f9c3270",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "Veel aanwezigen hadden zich gekleed in het oranje."
                            },
                            {
                                "example_id": "fbd86d62-a6d3-4abc-8208-4b6118332cb2",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "De figuranten worden gekleed en geschminkt voor de generale repetitie."
                            },
                            {
                                "example_id": "d5e522b6-c93a-4b24-8015-b1a829bb0455",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "Iedereen was mooi en passend gekleed."
                            },
                            {
                                "example_id": "e90ca8b9-60b2-423f-90d1-0da54142ebbe",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "Ze was in het wit gekleed."
                            },
                            {
                                "example_id": "8d5e41a0-9a4b-4acf-b9d8-2ef65f04a7e3",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "Ze is alweer helemaal gekleed in haar wandeloutfit."
                            },
                            {
                                "example_id": "71fec5ca-02da-456a-a6a1-1f179c7bcf27",
                                "sense_id": "7028deae-733e-32de-b1c5-b6d8be673672",
                                "text": "Op tv is een Italiaanse show met schaars geklede vrouwen."
                            }
                        ]
                    }
