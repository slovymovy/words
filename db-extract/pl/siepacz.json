                "senses": [
                    {
                        "sense_id": "4a9204db-fe5c-376b-af67-3c377c1feaf5",
                        "entry_id": "2669a72b-3b52-377b-abe5-8e94d3940add",
                        "glosses": [
                            "oprawca, bandyta, pozostający na czyichś usługach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57031da3-5bf1-4802-81ce-191c92474452",
                                "sense_id": "4a9204db-fe5c-376b-af67-3c377c1feaf5",
                                "text": "Trzej jego bracia zginęli w mękach, zgładzeni przez siepaczy Amina"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f995a13-653a-4b3d-9efa-610f1ddb8fc5",
                        "source_entry_id": "2669a72b-3b52-377b-abe5-8e94d3940add",
                        "source_sense_id": "4a9204db-fe5c-376b-af67-3c377c1feaf5",
                        "target_lang_word": "Scherge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                        "entry_id": "32def5fb-6c50-3dcd-b127-759b95d31cda",
                                        "glosses": [
                                            "Person, die Aufträge einer Macht auch gewaltsam ausführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31cfde93-81ac-4078-840b-9c1b96f6158f",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Und oft standen sie Hitlers Schergen an Grausamkeit in Nichts nach.“"
                                            },
                                            {
                                                "example_id": "af5e4958-7f60-45c3-b671-3aa461d7ac5f",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Währenddessen setzt meine Monatsblutung ein, doch ich traue mich nicht, bei einem der Schergen um Binden zu bitten.“"
                                            },
                                            {
                                                "example_id": "24bd829e-26e4-4131-9170-a13fd88b8885",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Die einzelnen Bautrupps taten sich nun zusammen, um nicht kurz vor der Befreiung noch von den SS-Bewachern ins Unglück geführt zu werden, und bald waren auch ihre Schergen vorsichtig geworden.“"
                                            },
                                            {
                                                "example_id": "52830a0f-cbfc-46ea-abdf-298b03cc8e96",
                                                "sense_id": "8b73e5e4-6fcc-354e-b8b9-eccd96f7466a",
                                                "text": "„Damit rief er den rechts und links stehenden Schergen zu, Folter und Prügel zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
