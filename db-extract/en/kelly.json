                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c36a0868-0197-3d50-b54e-cf161162f165",
                        "entry_id": "f1f43774-36d2-3857-96e3-9549250826c2",
                        "glosses": [
                            "A unisex given name transferred from the surname.",
                            "A female given name transferred from the surname, popular from the 1960s to the 1990s."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e3dba33-3b7c-4c05-902b-6d88676c415a",
                                "sense_id": "c36a0868-0197-3d50-b54e-cf161162f165",
                                "text": "On the walls of the salon are blown-up photos of models with dazzling teeth and ingeniously tousled hair - women with names like Kelly and Dawn, who come from tiny towns in Texas and Washington, who are tall and thin, and who don't appear to be burdened by any pasts to speak of."
                            },
                            {
                                "example_id": "18cf7054-226e-4aad-ae80-09ac2f697239",
                                "sense_id": "c36a0868-0197-3d50-b54e-cf161162f165",
                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                            }
                        ]
