                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbd38ca9-0a26-4703-8efd-41d0aa484956",
                        "source_entry_id": "ac524ab3-1fc9-3f30-a3a8-5713afe028f3",
                        "source_sense_id": "961bf2b4-1e87-39ae-b23b-4f2c501850d9",
                        "target_lang_word": "nehostinný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
