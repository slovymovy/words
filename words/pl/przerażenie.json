                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wojna budzi w ludziach ogromne <w>przerażenie</w> o przyszłość swoich dzieci.",
                            "target_lang_translations": {
                                "ru": "Война вызывает у людей огромный <w>ужас</w> за будущее своих детей."
                            }
                        },
                        {
                            "text": "Dźwięk syren wywołał <w>przerażenie</w> wśród mieszkańców całego miasta.",
                            "target_lang_translations": {
                                "ru": "Звук сирен вызвал <w>ужас</w> среди жителей всего города."
