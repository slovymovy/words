                ],
                "senses": [
                    {
                        "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                        "entry_id": "ecd5f338-0475-3546-9580-9965f7b93e61",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4009eca-6672-469c-9baa-c8527222ea96",
                                "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                                "text": "Frau Stolze ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "533e4ccf-92b0-49e7-b10e-969316d10aba",
                                "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                                "text": "Herr Stolze wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "94a3f4b1-1fb3-4567-a550-fccd39a10325",
                                "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                                "text": "Die Stolzes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "695bad31-019e-4641-9850-797a4acb51f9",
                                "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                                "text": "Der Stolze trägt nie die Schals, die die Stolze ihm strickt."
                            },
                            {
                                "example_id": "839375ec-adb9-4ae0-b6a0-b56df9aa0336",
                                "sense_id": "3ea991d8-8823-3ab8-8492-81f4c0ef2dc9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stolze kommt, geht der Herr Stolze.“"
                            },
