                "senses": [
                    {
                        "sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                        "entry_id": "ab6ee94e-bbd9-3208-85f2-90a44a6bee4f",
                        "glosses": [
                            "pracownik kasyna, który odpowiada za grę przy stole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2782e3e1-0054-46fe-986b-6c82e9bbff1e",
                                "sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                                "text": "Denis został krupierem w miejscowym kasynie."
                            },
                            {
                                "example_id": "cc2905ff-a5c7-4b91-a37b-cc4a9105fa0b",
                                "sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                                "text": "Ile zarabiają krupierzy w Las Vegas?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf14f877-ccf9-40d1-8060-75f5c8e68b08",
                        "source_entry_id": "ab6ee94e-bbd9-3208-85f2-90a44a6bee4f",
                        "source_sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                        "target_lang_word": "croupier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croupier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d79668be-8e05-30ff-aca6-1ca5290bbc41",
                                        "entry_id": "12dfed9a-b38c-3d33-8ece-597b6cb926e1",
                                        "glosses": [
                                            "The person who collects bets and pays out winnings at a gambling table, such as in a casino."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059014ca-8af1-43ec-8d34-a32c48146487",
                                                "sense_id": "d79668be-8e05-30ff-aca6-1ca5290bbc41",
                                                "text": "As a matter of fact, the mob was playing in exceedingly foul fashion. Indeed, I have an idea that sheer robbery was going on around that gaming-table. The croupiers who sat at the two ends of it had not only to watch the stakes, but also to calculate the game—an immense amount of work for two men! As for the crowd itself—well, it consisted mostly of Frenchmen."
                                            },
                                            {
                                                "example_id": "637f5875-9bce-45b3-9715-0db4f15e3ff1",
                                                "sense_id": "d79668be-8e05-30ff-aca6-1ca5290bbc41",
                                                "text": "Every time the little gate creaks—I'm in the shed with the tanks at the end of the garden—I wonder from which of my pasts the person is arriving, seeking me out even here: maybe it is only the past of yesterday and of this same suburb, the squat Arab garbage collector who in October begins his rounds for tips, house by house, with a Happy New Year card, because he says that his colleagues keep all the December tips for themselves and he never gets a penny; but it could also be the more distant pasts pursuing old Ruedi, finding the little gate in the Impasse: smugglers from Valais, mercenaries from Katanga, croupiers from the Veradero casino and the days of Fulgencio Batista."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ade155-e588-36ea-9ef1-5270845be1e7",
                                        "entry_id": "12dfed9a-b38c-3d33-8ece-597b6cb926e1",
                                        "glosses": [
                                            "One who, at a public dinner party, sits at the lower end of the table as assistant chairman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e6e8cda-f09f-4c28-87df-40f77b3e1d6a",
                        "source_entry_id": "ab6ee94e-bbd9-3208-85f2-90a44a6bee4f",
                        "source_sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                        "target_lang_word": "croupier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croupier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "992686aa-16b5-347d-a927-bbb0c947200f",
                                        "entry_id": "4e2e6a15-f542-3d35-8bdf-e08a36dbe314",
                                        "glosses": [
                                            "Personne qui tient le jeu, paie et ramasse l’argent, dans un casino, une maison de jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6001e80-8dd2-4719-882c-b0eb8ce3e333",
                                                "sense_id": "992686aa-16b5-347d-a927-bbb0c947200f",
                                                "text": "On ne jouait plus : le croupier attendait qu’un responsable du casino lui donne la permission d’accepter le pari."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04077ce8-9d25-38f6-b47a-21a9710937c5",
                                        "entry_id": "4e2e6a15-f542-3d35-8bdf-e08a36dbe314",
                                        "glosses": [
                                            "Spéculateur qui, sans figurer en nom propre dans une opération commerciale ou de bourse, doit cependant supporter une part des pertes et prendre une part des bénéfices."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15330000-1cc8-4872-9e9a-eaebc40145d6",
                                                "sense_id": "04077ce8-9d25-38f6-b47a-21a9710937c5",
                                                "text": "Dubois avait obtenu du régent de n'en parler à personne [du traité de La Haye] ; mais je n'ai jamais douté que le duc de Noailles et Canillac, alors ses croupiers, n'en fussent exceptés."
                                            },
                                            {
                                                "example_id": "80a536d8-4de5-4ec1-9e09-56b24306ac21",
                                                "sense_id": "04077ce8-9d25-38f6-b47a-21a9710937c5",
                                                "text": "Sur les trente-cinq sous réservés aux fermiers généraux, dix-neuf sont partagés à des croupiers inutiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84895f1b-1094-4963-8706-eef235a9e1ec",
                        "source_entry_id": "ab6ee94e-bbd9-3208-85f2-90a44a6bee4f",
                        "source_sense_id": "8be6e598-08b9-3196-9076-58e6d844545f",
                        "target_lang_word": "Croupier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Croupier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                        "entry_id": "751acf7e-2f38-33eb-8ae6-0639ab0dc41e",
                                        "glosses": [
                                            "Mitarbeiter in einer Spielbank, der den regelgerechten Ablauf des Spiels am Spieltisch sicherstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885e4413-3967-4ee3-88d5-52dca6e2772c",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Die Croupiers dagegen hatten nichts zu lachen…“"
                                            },
                                            {
                                                "example_id": "b49e13cb-d32c-4df6-952e-502f8795eb51",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Der Croupier erwiderte dieses Lächeln, fast unmerklich, kaum daß sich die Lippen unter dem gesträubten Bart verzogen.“"
                                            },
                                            {
                                                "example_id": "7ef09ed2-fcfc-43de-9c63-c6cd7c844eb8",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Gelegentlich bat er den Croupier, für ihn zu spielen.“"
                                            },
                                            {
                                                "example_id": "ffa9d6dc-2889-43cf-95f8-ecefa4162f1a",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Ich war zur Hälfte bei ihm beteiligt und half ihm als Croupier; er leistete mir den gleichen Dienst, wenn ich die Bank hielt, was sehr häufig geschah, denn die Spieler schätzten ihn nicht.“"
                                            },
                                            {
                                                "example_id": "0ec791ed-ca24-4925-b349-76f9402ce111",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Es war immer noch besser, für das Opfer einer Katastrophe gehalten zu werden als für die Witwe eines Mannes, der sich in Paris von Mädchen und in Monte Carlo von Croupiers hat ausnehmen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74c1ba41-6ed4-4a74-8255-8dc2211ba70b",
