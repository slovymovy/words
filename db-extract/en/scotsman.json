                        ]
                    },
                    {
                        "translation_id": "31d860d0-5a45-47bf-a8c5-7a3e01083055",
                        "source_entry_id": "e050ca89-302c-3105-9fc6-f391ace9b4df",
                        "source_sense_id": "a2849e75-8eb2-36b8-aa93-4ae6fe57fed0",
                        "source_sense_description": "a man from Scotland",
                        "target_lang_word": "Écossais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Écossais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e67ad6-00c7-3da2-a45f-b98e8226cbc1",
                                        "entry_id": "91a473c4-4380-3678-aee4-a95cc50a4d64",
                                        "glosses": [
                                            "Quelqu’un originaire d’Écosse ou habitant en Écosse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                        "entry_id": "91a473c4-4380-3678-aee4-a95cc50a4d64",
                                        "glosses": [
                                            "Peuple celte qui vit essentiellement en Écosse."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b49e884-4fa3-4aa9-9c48-b2e6e1ad950e",
                                                "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                                "text": "C'est au moment où les eaux retournent à la mer qu'on fait dans ces graux la singulière pêche du turbot, qui rappelle celle des Écossais, décrite dans le Redgauntlet de Walter-Scott."
                                            },
                                            {
                                                "example_id": "7a1c1677-8e49-4836-96fb-34a4b10feb94",
                                                "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                                "text": "Ce Dick Kennedy était un Écossais dans toute l’acception du mot, ouvert, résolu, entêté."
                                            },
                                            {
                                                "example_id": "b9af6180-6979-4f49-9f7e-29a82bdc8013",
                                                "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                                "text": "Écossais jusqu’à la moelle, grand amateur du pibroch dont il joue avec conviction, serviable, jovial, toujours très actif, il est la providence des rares touristes étrangers qui visitent la résidence chérifienne."
                                            },
                                            {
                                                "example_id": "6fd0deab-038a-46d6-b15b-d690f9e90385",
                                                "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                                "text": "Il était bien vrai que je venais d’imposer ma volonté à l’un des trois compères, en dépit de l’illustration frappante qu’ils avaient faite de cet autre proverbe de leur race : « Écossais, épaule contre épaule »."
                                            },
                                            {
                                                "example_id": "69290104-d620-446e-8bd3-84d900cf8553",
                                                "sense_id": "ee44d43a-0584-3f93-b6fa-68fa5456662f",
                                                "text": "Le dogme calviniste de la prédestination, religion terrifiante et qui avait touché si profondément les Écossais, s’était, en ce pays de compromis, atténué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79baf5c9-4698-45e2-a492-a2b12416605b",
                        "source_entry_id": "e050ca89-302c-3105-9fc6-f391ace9b4df",
                        "source_sense_id": "a2849e75-8eb2-36b8-aa93-4ae6fe57fed0",
