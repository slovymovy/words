            {
                "entry_id": "b8bad961-edf3-3d90-97ab-7728a14207bf",
                "word": "caressive",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7fab66da-e442-4557-8b0a-588699c393b6",
                        "entry_id": "b8bad961-edf3-3d90-97ab-7728a14207bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "caressives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae63f34f-321a-3f1e-9646-f14d4b139157",
                        "entry_id": "b8bad961-edf3-3d90-97ab-7728a14207bf",
                        "glosses": [
                            "A type of diminutive indicating affection or endearment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162af39e-8f1d-43f4-94bc-23461410ca06",
                                "sense_id": "ae63f34f-321a-3f1e-9646-f14d4b139157",
                                "text": "[W]e, like the ancient Mexicans and many another lower race, have terms of praise and endearment,—\"a jewel of a babe,\" and the like,—legions of caressives and diminutives in the use of which some of the Low German dialects are more lavish even than Lowland Scotch."
                            },
                            {
                                "example_id": "25d3bb72-5881-49b0-9be7-0256629fbbfd",
                                "sense_id": "ae63f34f-321a-3f1e-9646-f14d4b139157",
                                "text": "An interesting characteristic of the following extracts is the abundance of diminutives also termed “caressives” in Greek. -άκι, -ίτσα and -ούλα here are derivational suffixes for indexing the diminutive and their use indicates affection, endearment and solidarity serving thus as markers of informal positive politeness[…]."
                            },
                            {
                                "example_id": "eedf1ab1-2273-4893-90bc-fc389c637f23",
                                "sense_id": "ae63f34f-321a-3f1e-9646-f14d4b139157",
                                "text": "One another suffix used as a caressive and appellative is -(l)y. Like -kAy, it is attached to kinship terms, generally to the ones expressing closer relationships."
                            }
                        ]
                    }
                ],
