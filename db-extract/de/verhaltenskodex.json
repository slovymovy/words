                "senses": [
                    {
                        "sense_id": "61a845fa-b720-33b0-925f-9ce19209c295",
                        "entry_id": "9439acf7-74b9-38a6-9776-728a87a950e2",
                        "glosses": [
                            "die Gesamtheit der Regeln/Prinzipien, die das Verhalten einer Person bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617349b9-a37e-4d26-96a8-1d94cae6240f",
                                "sense_id": "61a845fa-b720-33b0-925f-9ce19209c295",
                                "text": "„Von der Einhaltung dieses strikten Verhaltenskodexes hing für Csoma nicht nur seine Selbstachtung, sondern auch seine seelische Unversehrtheit ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fd5c7c9-6a67-45b2-b2fd-4180fb42b981",
                        "source_entry_id": "9439acf7-74b9-38a6-9776-728a87a950e2",
                        "source_sense_id": "61a845fa-b720-33b0-925f-9ce19209c295",
                        "source_sense_description": "die Gesamtheit der Regeln/Prinzipien, die das Verhalten einer Person bestimmen",
                        "target_lang_word": "code of conduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "code of conduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                        "entry_id": "7f9f5388-3609-35e2-af2c-9a95409c9918",
                                        "glosses": [
                                            "A set of rules dictating acceptable behavior and decisions in a specified environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9027104-57fd-487a-a554-582653209086",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "What use have I ever had from this religion that has been dinned into me? It gave me false ideas of the world and nature which I have had to unlearn. It gave me an unworkable code of conduct which I never tried to follow, but I got into trouble for it."
                                            },
                                            {
                                                "example_id": "d4f884f0-2472-4dad-962b-26162ef6ccc2",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "In spite of the maturity of his years and of the savage rigidity of the mould that had formed him, his nature was undergoing an expansion. There was a burgeoning within him of strange feelings and unwonted impulses. His old code of conduct was changing."
                                            },
                                            {
                                                "example_id": "f41262c8-6a67-4fb4-a619-1afb0db11d5a",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "That iron-bound code of conduct which rules the Anglo-Indian, in the first days of the voyage had threatened to ostracize Karamaneh and Aziz, by reason of the Eastern blood to which their brilliant but peculiar type of beauty bore witness."
                                            },
                                            {
                                                "example_id": "c3fc88b7-8ae5-4636-8146-344b0749840e",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "Mr Blunkett quit after breaking the ministerial code of conduct over paid work he took while out of the Cabinet. John Hutton is to replace him."
                                            },
                                            {
                                                "example_id": "9ff208c9-b42b-434d-9946-a27bdb8e7e9e",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "The conversational free-for-all on the Internet known as the blogosphere can be a prickly and unpleasant place. Now, a few prominent figures in high technology are proposing a blogger code of conduct to clean up the quality of online discourse."
                                            },
                                            {
                                                "example_id": "9168207e-e452-47a1-984c-8699eff67ec5",
                                                "sense_id": "528d82d8-4aa8-3356-b099-849c4b6475fd",
                                                "text": "Nodding to critics who contend that the movie industry hasn’t done enough to fight sexual harassment, the Academy of Motion Picture Arts and Sciences announced on Thursday that it would be establishing a “code of conduct” for its members."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
