{
    "word_family": [
        "south",
        "southerly",
        "southward",
        "southerner",
        "southernmost"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f872f03f-beb1-3873-b845-1de3d722b867",
                    "sense_definition": "Of, facing, situated in, or related to the south.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>southern</w> coast of the island attracts many tourists in the summer.",
                            "target_lang_translations": {
                                "ru": "<w>Южное</w> побережье острова привлекает много туристов летом.",
                                "zh": "这座岛屿的<w>南部</w>海岸在夏天吸引了许多游客。"
                            }
                        },
                        {
                            "text": "Penguins are primarily found in the <w>southern</w> hemisphere.",
                            "target_lang_translations": {
                                "ru": "Пингвины обитают преимущественно в <w>Южном</w> полушарии.",
                                "zh": "企鹅主要生活在<w>南半球</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "southerly"
                    ],
                    "antonyms": [
                        "northern"
                    ],
                    "common_phrases": [
                        "southern hemisphere",
                        "southern border",
                        "southern coast",
                        "southern tip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к югу, расположенный на юге или обращенный к югу.",
                        "zh": "指位于南方、朝向南方或与南方有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "южный",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南方的",
                                "target_lang_sense_clarification": "表示方位或地理位置"
                            },
                            {
                                "target_lang_word": "南部的",
                                "target_lang_sense_clarification": "表示区域或部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62bf77c8-55da-3eb4-a78c-aa7f4e72bdd6",
                    "sense_definition": "From or pertaining to the South, especially the south-eastern United States, or its culture.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cultural_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is known for her warm <w>Southern</w> hospitality and excellent cooking.",
                            "target_lang_translations": {
                                "ru": "Она известна своим тёплым <w>южным</w> гостеприимством и превосходной кухней.",
                                "zh": "她以热情的<w>南方</w>好客之道和精湛的厨艺而闻名。"
                            }
                        },
                        {
                            "text": "His strong <w>Southern</w> accent revealed that he grew up in Alabama.",
                            "target_lang_translations": {
                                "ru": "Его сильный <w>южный</w> акцент выдавал, что он вырос в Алабаме.",
                                "zh": "他浓重的<w>南方</w>口音显示他是在阿拉巴马州长大的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Southern hospitality",
                        "Southern accent",
                        "Southern states",
                        "Southern cooking"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к южным штатам США или их культуре.",
                        "zh": "指来自美国南部地区或与该地区文化相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "южный",
                                "target_lang_sense_clarification": "относящийся к югу США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南方的",
                                "target_lang_sense_clarification": "指美国南部文化或风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5332eec-6975-353a-9a16-9f3da9004c31",
                    "sense_definition": "Of a wind: blowing from the south.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A warm <w>southern</w> wind melted the snow earlier than expected.",
                            "target_lang_translations": {
                                "ru": "Тёплый <w>южный</w> ветер растопил снег раньше, чем ожидалось.",
                                "zh": "温暖的<w>南风</w>让积雪比预期融化得更早。"
                            }
                        },
                        {
                            "text": "The sailors adjusted their sails to catch the gentle <w>southern</w> breeze.",
                            "target_lang_translations": {
                                "ru": "Моряки поправили паруса, чтобы поймать лёгкий <w>южный</w> бриз.",
                                "zh": "水手们调整了帆，以捕捉轻柔的<w>南风</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "southerly"
                    ],
                    "antonyms": [
                        "northern"
                    ],
                    "common_phrases": [
                        "southern wind",
                        "southern breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "О ветре: дующий с юга.",
                        "zh": "指风：从南方吹来的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "южный",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南风",
                                "target_lang_sense_clarification": "指从南方吹来的风"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7aa0c18d-72ec-307b-a193-fc5bb5329300",
                    "sense_definition": "A person from the south; a southerner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>southerns</w> struggled to adapt to the harsh winters of the north.",
                            "target_lang_translations": {
                                "ru": "<w>Южане</w> с трудом приспосабливались к суровым зимам севера.",
                                "zh": "<w>南方人</w>很难适应北方严酷的冬天。"
                            }
                        },
                        {
                            "text": "Cultural differences often caused disagreements between the northerns and the <w>southerns</w>.",
                            "target_lang_translations": {
                                "ru": "Культурные различия часто вызывали разногласия между северянами и <w>южанами</w>.",
                                "zh": "文化差异经常导致北方人和<w>南方人</w>之间的分歧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "southerner"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usually replaced by 'Southerner'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с юга; южанин.",
                        "zh": "来自南方的人；南方居民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "южанин",
                                "target_lang_sense_clarification": "житель юга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "南方人",
                                "target_lang_sense_clarification": "指居住在南方的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4d6e24ed-562d-3aed-b06b-1daf398b5b59",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Southern</w> will be leading the meeting this afternoon.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сазерн</w> будет вести собрание сегодня днём.",
                                "zh": "<w>萨瑟恩</w>先生将主持今天下午的会议。"
                            }
                        },
                        {
                            "text": "I was introduced to a colleague named Alice <w>Southern</w>.",
                            "target_lang_translations": {
                                "ru": "Меня представили коллеге по имени Элис <w>Сазерн</w>.",
                                "zh": "我被介绍给了一位名叫爱丽丝·<w>萨瑟恩</w>的同事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сазерн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "萨瑟恩",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2435884e-cbb7-3a3e-8f63-0a6a27d4cef0",
                    "sense_definition": "Short for Southern Comfort, a fruit-flavored liqueur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "He ordered a <w>Southern</w> and lime at the crowded bar.",
                            "target_lang_translations": {
                                "ru": "Он заказал <w>Сазерн</w> с лаймом в переполненном баре.",
                                "zh": "他在拥挤的酒吧里点了一杯<w>萨瑟恩</w>加青柠。"
                            }
                        },
                        {
                            "text": "The bartender asked if we wanted our <w>Southern</w> on the rocks.",
                            "target_lang_translations": {
                                "ru": "Бармен спросил, хотим ли мы <w>Сазерн</w> со льдом.",
                                "zh": "酒保问我们是否要加冰的<w>萨瑟恩</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название ликера Southern Comfort.",
                        "zh": "利口酒品牌 Southern Comfort 的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сазерн",
                                "target_lang_sense_clarification": "ликер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "萨瑟恩",
                                "target_lang_sense_clarification": "酒名简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
