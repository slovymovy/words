                                    {
                                        "sense_id": "334c3af7-97d7-33be-bcbe-512c0187f8d1",
                                        "entry_id": "51bc4f07-66c9-3182-8b4c-87777d9b03fd",
                                        "glosses": [
                                            "Appareil accélérateur de particules élémentaires de telle manière qu’elles entrent en collision avec d’autres particules."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "412dce7a-a0b4-4c9b-9401-a7f949a57920",
                                                "sense_id": "334c3af7-97d7-33be-bcbe-512c0187f8d1",
                                                "text": "Le Grand collisionneur de hadrons ou LHC (Large Hadron Collider) du CERN est en 2014 l’accélérateur de particules le plus grand et le plus puissant du monde."
                                            },
                                            {
                                                "example_id": "989049e9-bd2d-48f1-b394-84fd4fba282e",
                                                "sense_id": "334c3af7-97d7-33be-bcbe-512c0187f8d1",
                                                "text": "Le collisionneur est la première étape pour fournir de l’énergie nécessaire à l’écume de l’espace temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
