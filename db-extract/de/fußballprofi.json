                "senses": [
                    {
                        "sense_id": "591462dd-08e8-38f8-bb80-187affc75e85",
                        "entry_id": "6850c760-3198-3116-92d6-e414fae62613",
                        "glosses": [
                            "Person, die Fußball beruflich/auf hohem Niveau spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a04a511-017a-49af-839e-281a69ea3d05",
                                "sense_id": "591462dd-08e8-38f8-bb80-187affc75e85",
                                "text": "Wenn ich groß bin, will ich gerne Fußballprofi sein."
                            },
                            {
                                "example_id": "d1e93d83-70be-4e19-a96d-ffdcc2c6f8e7",
                                "sense_id": "591462dd-08e8-38f8-bb80-187affc75e85",
                                "text": "„In den letzten Jahren sind die Ablösesummen sowie Gehälter von Fußballprofis in den europäischen Fußballligen extrem gestiegen.“"
                            },
                            {
                                "example_id": "35ac254d-3dd9-4db8-a717-35ff17c38e4b",
                                "sense_id": "591462dd-08e8-38f8-bb80-187affc75e85",
                                "text": "„Wenn wir die außergewöhnliche Körperbeherrschung eines Fußballprofis, eines Profi-Tänzers oder eines erfahrenen Handwerkers sehen, so ist ihr Einssein mit dem eigenen Körper eine zutiefst magische Qualität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
