                    {
                        "sense_id": "d974d473-e1e9-37e5-8d21-fc663f71a5c0",
                        "entry_id": "14694260-a487-3f32-bdb7-3d16255e4ec8",
                        "glosses": [
                            "Krieger im vorindustriellen Japan; Mitglied des Militäradels im vorindustriellen Japan, unabhängig von Geschlecht und Alter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0dff35e5-aa8d-4a01-b4be-45009e31f98e",
                                "sense_id": "d974d473-e1e9-37e5-8d21-fc663f71a5c0",
                                "text": "Heute sind vor allem die Schwerter der Samurai bekannt."
                            },
                            {
                                "example_id": "b508f2c0-ef40-4e40-837d-00e95bf6d15e",
                                "sense_id": "d974d473-e1e9-37e5-8d21-fc663f71a5c0",
                                "text": "„Zu den Zeiten, als die Samurai noch eine wichtige Role spielten, lebte ein mächtiger Herrscher, der ein neues Oberhaupt für seine Samurais suchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
