                            {
                                "example_id": "afae52ff-b467-4b24-8150-cd1edd201db2",
                                "sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                                "text": "Kaboel is de hoofdstad van Afghanistan."
                            },
                            {
                                "example_id": "03d64f65-1e79-4b2b-9437-e74261889c01",
                                "sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                                "text": "Vrouwen in Afghanistan mogen sinds vier jaar niet meer naar school of universiteit. Een aantal volgt stiekem online lessen in het buitenland. Toen eind september het internet werd geblokkeerd, was hun isolement totaal."
                            },
                            {
                                "example_id": "d94bca7a-d505-447e-8884-d7ccc41dbf1f",
                                "sense_id": "d0a1ec41-4edf-3caf-b72f-ff7c854ce117",
                                "text": "Ze vertelde dat de Sovjets in Afghanistan de moedjahedien 'dusjman'noemden, hetgeen Levi om een of andere reden, ondanks het feit dat het simpelweg 'vijand' betekende, hilarisch vond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
