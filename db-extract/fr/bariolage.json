        "fr-extract.jsonl": [
            {
                "entry_id": "d55e23a2-f918-3177-93ef-3c44bf77d76b",
                "word": "bariolage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee0b91a6-0cd2-46fa-9bdf-059bd026428d",
                        "entry_id": "d55e23a2-f918-3177-93ef-3c44bf77d76b",
                        "tags": [
                            "plural"
                        ],
                        "form": "bariolages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cbd1609-1dd4-3ceb-bb8c-e52055d98d44",
                        "entry_id": "d55e23a2-f918-3177-93ef-3c44bf77d76b",
                        "glosses": [
                            "Action de barioler ou résultat de cette action."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3d362fce-446f-4ae3-bb89-5344905fc8da",
                                "sense_id": "1cbd1609-1dd4-3ceb-bb8c-e52055d98d44",
                                "text": "Voilà un étrange bariolage."
                            },
                            {
                                "example_id": "10a91db2-36d0-499a-a5a6-304358f6e761",
                                "sense_id": "1cbd1609-1dd4-3ceb-bb8c-e52055d98d44",
                                "text": "La figure de ce Patagon était superbe et dénotait une réelle intelligence, malgré le bariolage qui la décorait."
                            },
                            {
                                "example_id": "3027e9b5-42ad-40fd-ac67-5f9b64934398",
                                "sense_id": "1cbd1609-1dd4-3ceb-bb8c-e52055d98d44",
                                "text": "Jamais il n’avait remarqué le bariolage des façades, les glaces peintes, les stores, les trophées, les affiches violentes, les magasins magnifiques, d’une indiscrétion de salons et d’alcôves, ouverts à la pleine lumière."
                            },
                            {
                                "example_id": "5a68c881-8a44-4443-90d0-fccc7c37e5b6",
                                "sense_id": "1cbd1609-1dd4-3ceb-bb8c-e52055d98d44",
                                "text": "Le bariolage des ensembles qu’elle portait avec effronterie, son maquillage de cinéma muet et les œillades embrasées dont elle faisait précéder son passage voulaient faire croire aux hommes qu’elle n’était venue sur terre que pour le plaisir."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a447f6a-fb7a-3ab7-b322-4ce62237b9f2",
                        "entry_id": "d55e23a2-f918-3177-93ef-3c44bf77d76b",
                        "glosses": [
                            "Assemblage d’éléments sans unité ni harmonie."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8dec40d8-03df-41ad-901d-47fb555ec544",
                                "sense_id": "8a447f6a-fb7a-3ab7-b322-4ce62237b9f2",
                                "text": "Un notaire de bon sens et d’un peu de lettres devait être choqué par le bariolage verbal de certaines œuvres romantiques, par leurs épanchements souffreteux, leur égocentrisme impudique et leurs attitudes excessives."
                            }
                        ]
                    },
                    {
                        "sense_id": "68575513-44d0-3baa-9d7a-82dbb35a725b",
                        "entry_id": "d55e23a2-f918-3177-93ef-3c44bf77d76b",
                        "glosses": [
                            "Action de jouer des notes successives sur plusieurs cordes adjacentes d’un instrument à cordes frottées, résultant en des accords arpégés."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
