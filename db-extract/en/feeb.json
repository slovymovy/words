    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69ccb536-1d5c-381a-8c7e-8e7926d9c8e1",
                "word": "feeb",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3bd9fa5-484c-36cd-8389-d5af37a33b6e",
                        "entry_id": "69ccb536-1d5c-381a-8c7e-8e7926d9c8e1",
                        "glosses": [
                            "Alternative form of Feeb (“FBI”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "6bea38ff-15b2-4c04-8f93-750b963cc467",
                                "sense_id": "f3bd9fa5-484c-36cd-8389-d5af37a33b6e",
                                "text": "This feeb supervisor here says he's shuttin' this case down at two o'clock, which means putting the dope on the street without the money, even if they can get it together."
                            },
                            {
                                "example_id": "081f23fd-0659-44ba-8345-440cb66800bc",
                                "sense_id": "f3bd9fa5-484c-36cd-8389-d5af37a33b6e",
                                "text": "Your presence is requested in the feeb liaison office by my boss, Agent Jinadu."
                            },
                            {
                                "example_id": "288d7681-24cd-40fb-a262-8d88fd9b4213",
                                "sense_id": "f3bd9fa5-484c-36cd-8389-d5af37a33b6e",
                                "text": "It's rare, but sometimes he encounters skepticism in the cops he works with—cops who had a feeb profiler forced on them by their superiors, and perceive this as a vote of no confidence in their own abilities."
                            },
                            {
                                "example_id": "49fc63f5-cbea-4ed1-9856-33b5be93024a",
                                "sense_id": "f3bd9fa5-484c-36cd-8389-d5af37a33b6e",
                                "text": "This week, Stephen Tobolowsky and Max Perlich join the party: the former as a “feeb” agent warning Raylan away from the latter, who’s playing Detroit crime prince Sammy Tonin."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "da583016-6cac-38f1-abd7-7e65d3081be8",
                "word": "Feeb",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37c07234-4578-3575-898e-2653d96cfd5b",
                        "entry_id": "da583016-6cac-38f1-abd7-7e65d3081be8",
                        "glosses": [
                            "The FBI."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bf1d6bf7-84cb-48b8-a801-52096dd07652",
                                "sense_id": "37c07234-4578-3575-898e-2653d96cfd5b",
                                "text": "Bomb Squad got a tip from the Feeb and rolled in with Metro."
                            },
                            {
                                "example_id": "d5acd8f8-61be-4dbb-80b3-85f8d9f1f330",
                                "sense_id": "37c07234-4578-3575-898e-2653d96cfd5b",
                                "text": "Maybe on some level she was doing the same job as one of the Feeb's Investigative Support Unit shrinks, but she resisted the comparison."
                            },
                            {
                                "example_id": "85e16505-a131-4774-ae6e-d80382a413e0",
                                "sense_id": "37c07234-4578-3575-898e-2653d96cfd5b",
                                "text": "The first thing Joe noticed was the seating arrangements — Katz at the head of the long antique cherry wood table, John Nagoshi to his right, Peter Nagoshi next to his father (and Joe could not help but study the younger Nagoshhi as he entered the room, his smooth expressionless face barely turning to acknowledge their entrance), and across the table FBI Boston Field Office Special Agent in Charge Leo King and Special Agent Ned Jacobs — the Feeb's resident profiler."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "abc4a645-52e3-3655-a87e-026ff68c2267",
                "word": "feeb",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c826142e-767d-464c-971c-8574f699f1a1",
                        "entry_id": "abc4a645-52e3-3655-a87e-026ff68c2267",
                        "tags": [
                            "plural"
                        ],
                        "form": "feebs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e076c979-1663-389b-b2b9-5fb34ee3d8de",
                        "entry_id": "abc4a645-52e3-3655-a87e-026ff68c2267",
                        "glosses": [
                            "Someone who is feeble-minded; an idiot."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9df8e96-dde3-4c20-8f4f-ff36ee76a9bf",
                                "sense_id": "e076c979-1663-389b-b2b9-5fb34ee3d8de",
                                "text": "‘Everybody that knows anything about me knows that I wouldn't hurt a feeb.’"
                            },
                            {
                                "example_id": "ac0108e9-1ecc-4ba7-bb2b-aac1b1474a51",
                                "sense_id": "e076c979-1663-389b-b2b9-5fb34ee3d8de",
                                "text": "“Eeeyynnhh, too many feebs to deal with over the years, I guess—oh I'm sorry, hope I'm not offending—”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f976a5a-11f9-4a0a-91c2-4bf9b94a8bdf",
                        "source_entry_id": "abc4a645-52e3-3655-a87e-026ff68c2267",
                        "source_sense_id": "e076c979-1663-389b-b2b9-5fb34ee3d8de",
                        "source_sense_description": "Someone who is feeble-minded; an idiot",
                        "target_lang_word": "крети́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крети́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17491a3e-df31-35df-a4d6-0a4e5bf4d2c9",
                                        "entry_id": "80697d0d-ed5f-3f49-8293-9f3f8f65d3aa",
                                        "glosses": [
                                            "мед. человек, страдающий кретинизмом"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bcee240-f2e6-3ff8-a186-ba647eac4f22",
                                        "entry_id": "80697d0d-ed5f-3f49-8293-9f3f8f65d3aa",
                                        "glosses": [
                                            "перен., прост., бран. тупица, глупый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e031a4c-6f21-4274-83ea-47125911a88d",
                                                "sense_id": "0bcee240-f2e6-3ff8-a186-ba647eac4f22",
                                                "text": "Только полный кретин может предположить, что царствовать в десятках захваченных стран можно, сокращая военное производство!"
                                            },
                                            {
                                                "example_id": "b243ada3-155f-4b45-8a50-c6e3799abf92",
                                                "sense_id": "0bcee240-f2e6-3ff8-a186-ba647eac4f22",
                                                "text": "— Ты идиот, — донеслось из темноты, — совсем офигевший кретин!"
                                            },
                                            {
                                                "example_id": "92e078ed-57a0-46d0-97e1-77c1a4766242",
                                                "sense_id": "0bcee240-f2e6-3ff8-a186-ba647eac4f22",
                                                "text": "Конечно, и ноги переломаны, и рёбра, и ушибы множественные, и черепно-мозговая травма наверняка — все признаки, только этот кретин мог не заметить с бодуна."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "c2c3d317-2a4e-38d5-a82e-d4fcfb930951",
