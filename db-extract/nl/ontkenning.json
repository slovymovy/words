                                        "glosses": [
                                            "The act of rejecting or renouncing something as invalid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58245944-8cf9-4148-94e9-8955e15be387",
                                                "sense_id": "b79463ba-bd2c-3803-abb7-d4fc2bba2b0c",
                                                "text": "The life of the spirit demands readiness for renunciation when the occasion arises […]."
                                            },
                                            {
                                                "example_id": "5555de93-565c-43e5-b486-82a201f32cb5",
                                                "sense_id": "b79463ba-bd2c-3803-abb7-d4fc2bba2b0c",
