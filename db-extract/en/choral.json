    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "509fdebf-2173-3519-a0ae-648dae245809",
                "word": "choral",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bff3ee01-ee93-37ed-befc-345629695e88",
                        "entry_id": "509fdebf-2173-3519-a0ae-648dae245809",
                        "glosses": [
                            "Of, relating to, written for, or performed by a choir or a chorus."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "41fe3176-9f75-4c93-9488-479f96407a64",
                                "sense_id": "bff3ee01-ee93-37ed-befc-345629695e88",
                                "text": "Palestrina wrote choral music for the Catholic church."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ac1efb-1a78-4f3a-be79-3e19b53c6ba7",
                        "source_entry_id": "509fdebf-2173-3519-a0ae-648dae245809",
                        "source_sense_id": "bff3ee01-ee93-37ed-befc-345629695e88",
                        "source_sense_description": "of or relating to a choir or chorus",
                        "target_lang_word": "choral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5392cfdb-6c2e-3004-987d-62d87642dc62",
                                        "entry_id": "7edab5f2-5344-3873-b8c5-bb676a8b3aa3",
                                        "glosses": [
                                            "Qui a un rapport avec les chœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08047610-0d07-4fae-b27c-d1600c69eb23",
                                                "sense_id": "5392cfdb-6c2e-3004-987d-62d87642dc62",
                                                "text": "Chose remarquable ! jusqu’à la fin du XVIᵉ siècle, l’individualité humaine n’a pas eu son expression dans la musique. La monodie grecque était chorale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44ff8c76-4c58-3a9c-94ce-de3aeab12400",
                                        "entry_id": "7edab5f2-5344-3873-b8c5-bb676a8b3aa3",
                                        "glosses": [
                                            "Comportant plusieurs personnages s’entrecroisant au fil de la narration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a94e98-3e3d-46e3-b182-3af0d10c4187",
                                                "sense_id": "44ff8c76-4c58-3a9c-94ce-de3aeab12400",
                                                "text": "Le film choral se situe toujours dans une zone de tension paradoxale entre le film à sketches et le film de groupe fortement homogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79fc244-3184-3a52-bc88-51989c7ec82e",
                                        "entry_id": "7edab5f2-5344-3873-b8c5-bb676a8b3aa3",
                                        "glosses": [
                                            "Ayant plusieurs narrateurs importants, dont aucun n'est dominant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a796791-9c44-4ced-a9b6-510a16387978",
                                                "sense_id": "f79fc244-3184-3a52-bc88-51989c7ec82e",
                                                "text": "Un roman choral."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "choral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "756d9d70-95cd-3d81-9df3-161dabc23a26",
                                        "entry_id": "1a0be0e1-a2a7-358d-bc42-7deabb4a9099",
                                        "glosses": [
                                            "Chant religieux destiné à être chanté en chœur dans les églises protestantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e3023a-76d1-45f8-9403-5d3b31305d63",
                                                "sense_id": "756d9d70-95cd-3d81-9df3-161dabc23a26",
                                                "text": "Nous croisons une charrette qui porte huit paysans entassés; ils chantent en parties un air noble et grave comme un choral."
                                            },
                                            {
                                                "example_id": "d28cd6c8-4a9c-440e-9dc7-aed1c41cd5e6",
                                                "sense_id": "756d9d70-95cd-3d81-9df3-161dabc23a26",
                                                "text": "Il ne savait aucune des paroles du grand choral de Luther, mais il ouvrait toute grande sa bouche et émettait des sons vastes, graves et partiellement harmonieux…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "choral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e926f1b9-4799-34d9-86c6-fe2db075be7c",
                                        "entry_id": "87a26349-3a4f-3a29-8e6d-9456d95ba5e5",
                                        "glosses": [
                                            "Membre d’un chœur ou d’une chorale religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f49d03a-779d-42c5-9f04-042511ca8e9f",
                                                "sense_id": "e926f1b9-4799-34d9-86c6-fe2db075be7c",
                                                "text": "Suite à la demande du Vén. Henri Biérin, directeur de la maison des choraux, datée du 23 juin 1788 [sic], les Directeurs proposent d’augmenter les subsides pour les frais de table des choraux. Le Chapitre accorde 100 fl. d’augmentation, ce qui porte le total des frais de table des choraux à 2 400 fl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
