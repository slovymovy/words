        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e5adfc8-f3b5-3e88-8e54-7b62fc4e9300",
                    "sense_definition": "A command or feature in a computer program that reverses the last action performed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reverse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally deleted the paragraph, so I clicked <w>undo</w> to get it back.",
                            "target_lang_translations": {
                                "ru": "Я случайно удалил абзац, поэтому нажал «<w>отменить</w>», чтобы вернуть его.",
                                "cs": "Omylem jsem smazal odstavec, tak jsem klikl na <w>zpět</w>, abych ho dostal zpátky.",
                                "de": "Ich habe den Absatz versehentlich gelöscht, also habe ich auf <w>Rückgängig</w> geklickt, um ihn wiederherzustellen.",
                                "nl": "Ik heb per ongeluk de alinea verwijderd, dus ik klikte op <w>ongedaan maken</w> om hem terug te krijgen."
                            }
                        },
                        {
                            "text": "How many <w>undos</w> does this photo editing program support?",
                            "target_lang_translations": {
                                "ru": "Сколько уровней <w>отмены</w> поддерживает эта программа для редактирования фотографий?",
                                "cs": "Kolik kroků <w>zpět</w> tento program na úpravu fotek podporuje?",
                                "de": "Wie viele <w>Rückgängig-Schritte</w> unterstützt dieses Bildbearbeitungsprogramm?",
                                "nl": "Hoeveel stappen <w>ongedaan maken</w> ondersteunt dit fotobewerkingsprogramma?"
                            }
                        }
                    ],
                    "common_phrases": [
