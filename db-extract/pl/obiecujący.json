                                        "examples": [
                                            {
                                                "example_id": "374cd7ba-e503-434e-a6fe-3f87aed4c502",
                                                "sense_id": "fbaa9254-85f8-352b-a8ba-90d627451bf6",
                                                "text": "The obtained low and anisotropic thermal conductivity, and feasibility of synthesis, in addition to other reports on high electron mobility, make arsenene a promising material for a variety of applications, including thermal management and thermoelectric devices.."
                                            },
                                            {
                                                "example_id": "951dc776-dea9-4dc5-bcc8-515cf6e5831f",
