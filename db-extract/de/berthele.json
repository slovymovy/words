                "senses": [
                    {
                        "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                        "entry_id": "352190f3-589f-3919-9368-32263ff4828a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b754f4ac-4fc4-43e4-8224-94e2905f5032",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Frau Berthele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4c83980e-38c2-4051-bb7f-eb75b1c55e47",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Herr Berthele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f9e86bfe-5127-42d6-8a09-5cbb40295e0b",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Die Bertheles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "814b6f0f-a4e6-425e-9557-9c20e28adfa9",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Der Berthele trägt nie die Schals, die die Berthele ihm strickt."
                            },
                            {
                                "example_id": "ca08f643-52f8-4a2d-957c-18fed7cc1783",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berthele kommt, geht der Herr Berthele.“"
                            },
                            {
                                "example_id": "0a2e5087-5a83-415d-beb9-526ca77915eb",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Berthele kommt und geht."
                            },
                            {
                                "example_id": "f82d9028-7adc-4c1b-95b8-25f9553ae511",
                                "sense_id": "c3443a39-dc6e-39a0-b096-dc36dd1c51c7",
                                "text": "Bertheles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
