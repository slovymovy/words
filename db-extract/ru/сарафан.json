                    },
                    {
                        "translation_id": "6154d95b-c406-4b6e-b15e-d6de9a9a0d31",
                        "source_entry_id": "6de3caec-4e05-3229-a0f1-f8054984ce13",
                        "source_sense_description": "русский национальный женский костюм",
                        "target_lang_word": "Sarafan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b9a17e2-6462-4ac4-8ef6-a7b26651ec69",
                        "source_entry_id": "6de3caec-4e05-3229-a0f1-f8054984ce13",
                        "source_sense_description": "русский национальный женский костюм",
                        "target_lang_word": "sarafane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarafane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92ffc18a-c8c0-3e8f-bff0-0c83d0d0d6ca",
                                        "entry_id": "e9ce4c78-586c-3f4f-9e0c-19e58f7b2460",
                                        "glosses": [
                                            "En Russie, robe droite sans manche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4618a54-505f-487b-a499-2103b95cdb38",
                                                "sense_id": "92ffc18a-c8c0-3e8f-bff0-0c83d0d0d6ca",
                                                "text": "– Ah ! mais, pour bien faire, il me faudrait un sarafane. Quel dommage !… Vous voudrez bien excuser cette robe, qui n'a pas de caractère, pas de couleur locale…"
                                            },
                                            {
                                                "example_id": "8a4dde29-ba3f-4839-92d4-bf19eb155d89",
                                                "sense_id": "92ffc18a-c8c0-3e8f-bff0-0c83d0d0d6ca",
                                                "text": "S’étant un jour enivré à la maison, Nikita, probablement pour se venger de sa sujétion, brisa le coffre de sa femme, s’empara de ses plus beaux atours, prit une hache et coupa en petits morceaux sur un billot toutes ses robes et ses sarafanes."
                                            },
                                            {
                                                "example_id": "85df6a00-8108-440f-93c3-5a4879d0a8ed",
                                                "sense_id": "92ffc18a-c8c0-3e8f-bff0-0c83d0d0d6ca",
                                                "text": "Parmi les taillis d’aunes on pouvait apercevoir le sarafane bleu ciel de la Damoiselle changée en paysanne."
                                            },
                                            {
                                                "example_id": "3c65d780-6a38-4cea-95fe-c654cb40e024",
                                                "sense_id": "92ffc18a-c8c0-3e8f-bff0-0c83d0d0d6ca",
                                                "text": "Un des innombrables tontons avait épousé la jeune nounou, séduit par sa rondeur et par son éblouissant uniforme : les femmes exerçant ce métier des plus utiles devaient porter un sarafane, orné de rangs de colliers rouges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "622eb9d8-74b9-4044-ae0a-67f4c704a393",
                        "source_entry_id": "6de3caec-4e05-3229-a0f1-f8054984ce13",
                        "source_sense_description": "лёгкое женское платье",
                        "target_lang_word": "sundress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sundress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a7ddb59-0ab9-3580-835f-38b11dc327d4",
                                        "entry_id": "eef7f741-6935-3b1c-b3c0-791f8aa857c9",
                                        "glosses": [
                                            "A typically sleeveless dress, usually a minidress, made of light, loose-fitting material for spring and summer wear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c82854-0eef-4996-99e1-3de365d62b7b",
                                                "sense_id": "1a7ddb59-0ab9-3580-835f-38b11dc327d4",
                                                "text": "I'm in his favorite sundress, watching me get undressed"
                                            },
                                            {
                                                "example_id": "83aed80e-ed44-4d5d-ae03-300cd4d96b32",
                                                "sense_id": "1a7ddb59-0ab9-3580-835f-38b11dc327d4",
                                                "text": "The brand, in its collaboration with Target, provoked ire—proving that, in the right circumstances, even sundresses can be part of the culture wars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8026063-9c88-4a1d-8de3-fe700a9615dc",
                        "source_entry_id": "6de3caec-4e05-3229-a0f1-f8054984ce13",
                        "source_sense_description": "лёгкое женское платье",
                        "target_lang_word": "pinafore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinafore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                        "entry_id": "f9c343eb-7082-3c06-9b81-541671bb0968",
                                        "glosses": [
                                            "A sleeveless dress, often similar to an apron, generally worn over other clothes, and most often worn by young girls as an overdress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5441e4fc-bf6d-45df-b889-c4c36a67cf0b",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "“He looks just like an angel,” said the Charity Children as they came out of the cathedral in their bright scarlet cloaks, and their clean white pinafores."
                                            },
                                            {
                                                "example_id": "25e867a5-b38a-4a6b-827a-2d5ceedb6c6a",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "She was a strangely thin girl in a dark pinafore, with a pink handkerchief tied over her hair."
                                            },
                                            {
                                                "example_id": "c2e8e16d-170a-4cab-8d54-6862ad886033",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "The starched pinafore with the wide frills on each shoulder, which she always wore over her grey frock, was removed, and the frock itself changed for her best navy blue serge."
                                            },
                                            {
                                                "example_id": "8157718a-9d61-4af1-a8e0-6f278f75ae9b",
                                                "sense_id": "0d91496e-5d84-33e8-8c0f-9489ce104a5e",
                                                "text": "The old man heaved himself from the chair, seized Jessamy by her pinafore frill and marched her to the house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinafore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "867e73d0-3a7a-33ef-96ff-148d7b5a487a",
                                        "entry_id": "9f99b9f2-37ca-3d5d-9053-65ab0e919be1",
                                        "glosses": [
                                            "To dress in a pinafore."
                                        ],
