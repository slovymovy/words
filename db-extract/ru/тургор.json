                ],
                "senses": [
                    {
                        "sense_id": "420353e1-9ada-3d93-af69-e998c007a2be",
                        "entry_id": "2041ac1d-0bca-3db4-9145-06661cabe87f",
                        "glosses": [
                            "ботан. напряжённое состояние клеточной оболочки, создаваемое гидростатическим давлением внутриклеточной жидкости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbdf220-a0c0-44eb-ba6c-2fe80b71bc5e",
                                "sense_id": "420353e1-9ada-3d93-af69-e998c007a2be",
                                "text": "Клетки в состоянии тургора, т. е. в напряжённом состоянии, плотно прижаты друг к другу, что придает упругость органам растений."
                            },
                            {
                                "example_id": "04cd045b-e0c3-47dd-8bb6-6f407097bb94",
                                "sense_id": "420353e1-9ada-3d93-af69-e998c007a2be",
                                "text": "Если растение начинает терять воду (завядать), то тургор теряется и листья начинают висеть, как тряпки."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c940ce3-8a27-3092-8891-d67f49f09312",
                        "entry_id": "2041ac1d-0bca-3db4-9145-06661cabe87f",
                        "glosses": [
                            "космет. упругость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc557ce-3ad9-46d9-883d-494266b06350",
                                "sense_id": "1c940ce3-8a27-3092-8891-d67f49f09312",
                                "text": "Для улучшения тургора ― упругости кожи, для снижения сетки морщин можно протирать лицо, желательно перед нанесением ночного крема, кубиками льда."
                            },
                            {
                                "example_id": "9bd47cf5-9147-47c0-8d8b-24c54f39cba3",
                                "sense_id": "1c940ce3-8a27-3092-8891-d67f49f09312",
                                "text": "Жировая складка дряблая, тургор тканей и тонус мышц снижены."
                            },
                            {
                                "example_id": "5795a566-381d-4543-b672-ba10d68d3890",
                                "sense_id": "1c940ce3-8a27-3092-8891-d67f49f09312",
                                "text": "Глазное яблоко приобрело форму и тургор."
                            }
                        ]
                    }
                ],
