            {
                "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                "word": "baptistère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4cd16f08-8409-445a-a902-65b7879466b0",
                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "baptistères"
                    },
                    {
                        "form_id": "bdc3b698-3f4f-44b9-bc0c-fe508e4fd6e6",
                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "tags": [],
                        "form": "baptistaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "glosses": [
                            "Petit édifice bâti auprès des cathédrales, pour y administrer le baptême, et qui renfermait un ou plusieurs autels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b178469-a72c-41d1-b55f-ea867f2453e1",
                                "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                                "text": "Le baptistère de Constantin est auprès de Saint-Jean de Latran."
                            },
                            {
                                "example_id": "8297838b-ff2e-4a70-aa2c-59b5ce20037a",
                                "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                                "text": "Ces églises ont donc un sens harmonique où, comprise entre le baptistère et le cimetière, s’accomplit la vie de ces hommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f633460-bab1-3ce8-a843-12b80ad1ca06",
                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "glosses": [
                            "Chapelle où sont les fonts baptismaux dans une église."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c0fbe4-5c64-4317-b903-773b6fc1cf23",
                                "sense_id": "5f633460-bab1-3ce8-a843-12b80ad1ca06",
                                "text": "Fin juillet, le diocèse de Paris a désigné celui qui sera chargé de recréer le mobilier liturgique (autel, tabernacle, ambon, baptistère) voulu noble et simple : il s’agit du sculpteur et designer français Guillaume Bardet, 51 ans, diplômé de l’École nationale des arts décoratifs et déjà auteur de grands projets liturgiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d8c3130-6907-3a32-9b0d-eb9777f270a0",
                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "glosses": [
                            "Extrait de baptême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4e66e5-aefb-4f15-9221-b1da4ff0d410",
                                "sense_id": "9d8c3130-6907-3a32-9b0d-eb9777f270a0",
                                "text": "Ce dimanche de février 1951, trois figures d’autorité se penchent sur le baptistère de ces enfants amérindiens : catholique, préfectorale et municipale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f084785b-102e-486e-b9c2-1421ef759286",
                        "source_entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                        "target_lang_word": "Taufkapelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taufkapelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d536a2-5cd7-303a-8497-acdf232f1d3b",
                                        "entry_id": "2d0648f3-0e2a-3cc5-835f-1aaade3244bb",
                                        "glosses": [
                                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in einer Kirche, der für die Taufe genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7cfcf3-300c-42cc-91f9-c23383005d6a",
                                                "sense_id": "b9d536a2-5cd7-303a-8497-acdf232f1d3b",
                                                "text": "In der Taufkapelle fand die Taufe unseres Kindes am Taufstein statt."
                                            },
                                            {
                                                "example_id": "8db2fcb7-4f4c-42ea-8f47-c16196b8122c",
                                                "sense_id": "b9d536a2-5cd7-303a-8497-acdf232f1d3b",
                                                "text": "„Die detailgetreu restaurierte Taufkapelle steht exemplarisch für die einstige komplette farbenfrohe Ausmalung der Leipziger Peterskirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0fccb7b-becb-4ee9-a999-1a39a8676cf7",
