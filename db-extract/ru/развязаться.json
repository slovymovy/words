                    }
                ],
                "senses": [
                    {
                        "sense_id": "12f0b5e6-0d62-3c92-bbcb-d7b31aca4c2d",
                        "entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "glosses": [
                            "распуститься, разъединиться (о концах чего-либо связанного)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ef0106-519e-4047-ba53-0a50c97ca43c",
                                "sense_id": "12f0b5e6-0d62-3c92-bbcb-d7b31aca4c2d",
                                "text": "Мерсье, одной ногой уже в гробу, говорил во время паденья первой империи: «Я живу ещё только для того, чтоб увидеть, чем это кончится!» «Я и этого не могу сказать, — прибавил Марк Дюфресс, — у меня нет особого любопытства узнать, чем развяжется императорская эпопея»."
                            }
                        ]
                    },
                    {
                        "sense_id": "849721af-fc75-308f-a250-96de036a419d",
                        "entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "glosses": [
                            "освободиться от какой-либо зависимости, от того, что стесняет свободу, сковывает"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de4249c-6179-4270-ab79-f945fc007157",
                                "sense_id": "849721af-fc75-308f-a250-96de036a419d",
                                "text": "Отец собирался развязаться с делами, немножко освободиться от приработка и снова, как в юности, заняться живописью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f84e244a-552b-4a39-a9a3-cacc03df6c39",
                        "source_entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "target_lang_word": "come loose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a3e55589-a667-442c-a464-b474cc1a1b9e",
                        "source_entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "target_lang_word": "break away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "break away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6512713a-e347-3b8c-8fb8-15558cf9406f",
                                        "entry_id": "67bdc599-c80c-39dc-9b94-55f7c9b665c5",
                                        "glosses": [
                                            "To leave suddenly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dffa5983-a59c-42c1-bfde-0d9399a8a3e0",
                                                "sense_id": "6512713a-e347-3b8c-8fb8-15558cf9406f",
                                                "text": "She was brought up in a very religious household, but broke away from the church in her teens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00cef4e0-9c76-3c34-b976-b5af8a87f9e3",
                                        "entry_id": "67bdc599-c80c-39dc-9b94-55f7c9b665c5",
                                        "glosses": [
                                            "To become separated, literally or figuratively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ed55555-ed7b-489d-8680-f4ac133e3b4c",
                                                "sense_id": "00cef4e0-9c76-3c34-b976-b5af8a87f9e3",
                                                "text": "A chunk of rock broke away from the cliff edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e56a71f-77c0-4141-90e1-7d13fe8baed8",
                        "source_entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "target_lang_word": "hive off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hive off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3376ba76-13e2-3b85-9a31-916fa838f1a5",
                                        "entry_id": "dfb4d4b2-ffc5-3b40-b712-a4fbafff28dc",
                                        "glosses": [
                                            "To separate from a larger group."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4266205b-7959-3eab-a394-e3b11399ddd1",
                                        "entry_id": "dfb4d4b2-ffc5-3b40-b712-a4fbafff28dc",
                                        "glosses": [
                                            "To segregate; to remove from a parent entity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4292c40-ec82-4252-aff4-84142ea6190b",
                                                "sense_id": "4266205b-7959-3eab-a394-e3b11399ddd1",
                                                "text": "If the Government believes that part of the railways' salvation is to be found in ridding them of extraneous concerns, it should have had the courage either to close the railway works down as quickly as possible, or to hive them off as an entirely separate concern, [...]."
                                            },
                                            {
                                                "example_id": "0c6d6036-e45d-46cb-81d9-60425bb6702c",
                                                "sense_id": "4266205b-7959-3eab-a394-e3b11399ddd1",
                                                "text": "The plan involves banks hiving off bad assets and investors buying them at a discount on hopes of turning a profit over time."
                                            },
                                            {
                                                "example_id": "377ffb58-8b8d-4f94-8b67-1b62edbcb769",
                                                "sense_id": "4266205b-7959-3eab-a394-e3b11399ddd1",
                                                "text": "Completed by the London & Southern [sic: South] Western Railway in 1898, the W&C was part of British Rail until hived off in 1994. It is physically isolated from the rest of the Underground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb83c4da-fc7d-4470-9e31-08b872f32e91",
                        "source_entry_id": "35da47af-dcf0-38d9-8932-7772b40bd7dc",
                        "target_lang_word": "untie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "519159bd-b22b-3b19-91db-d4fcb2ec344b",
                                        "entry_id": "db004e41-7097-3683-8c77-816f87f0425b",
                                        "glosses": [
                                            "To loosen, as something interlaced or knotted; to disengage the parts of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00d59c74-4121-4924-b32b-28d09318f887",
                                                "sense_id": "519159bd-b22b-3b19-91db-d4fcb2ec344b",
                                                "text": "to untie a knot"
                                            },
                                            {
                                                "example_id": "58603f15-6559-4dbe-9e2b-bf724ac6868a",
                                                "sense_id": "519159bd-b22b-3b19-91db-d4fcb2ec344b",
                                                "text": "Haſt thou the pretty vvorme of Nylus [an asp] there, / That killes and paines not? / […] / Come thou mortal vvretch, / VVith thy ſharpe teeth this knot intrinſicate, / Of life at once vntye: Poore venomous Foole, / Be angry, and diſpatch."
                                            },
                                            {
                                                "example_id": "5527a4be-2230-415a-b08b-5b6309eb4d7f",
                                                "sense_id": "519159bd-b22b-3b19-91db-d4fcb2ec344b",
                                                "text": "Sacharissa's captive fain / Would untie his iron chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9378dfe9-dc66-37cc-b82a-af42630b561a",
                                        "entry_id": "db004e41-7097-3683-8c77-816f87f0425b",
                                        "glosses": [
                                            "To free from fastening or from restraint; to let loose; to unbind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3fb46d-3731-46af-872c-a81f171961c9",
                                                "sense_id": "9378dfe9-dc66-37cc-b82a-af42630b561a",
                                                "text": "Though you untie the winds, and let them fight / Against the churches."
                                            },
                                            {
                                                "example_id": "29a520c4-4a54-4488-becc-ee3ed96c72cd",
                                                "sense_id": "9378dfe9-dc66-37cc-b82a-af42630b561a",
                                                "text": "All the evils of an untied tongue we put upon the accounts of drunkenness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd60761a-1119-3382-aa27-78dd2bdedfb9",
                                        "entry_id": "db004e41-7097-3683-8c77-816f87f0425b",
                                        "glosses": [
                                            "To resolve; to unfold; to clear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cdef71-e4a9-4e18-b515-566fd07da899",
                                                "sense_id": "cd60761a-1119-3382-aa27-78dd2bdedfb9",
                                                "text": "They quicken sloth, perplexities untie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833f1719-86dc-3b8b-8db7-ca9a16a933f4",
                                        "entry_id": "db004e41-7097-3683-8c77-816f87f0425b",
                                        "glosses": [
                                            "To become untied or loosed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba124455-12f2-367e-9a5b-fd54bd2bdda4",
                                        "entry_id": "db004e41-7097-3683-8c77-816f87f0425b",
                                        "glosses": [
                                            "In the Perl programming language, to undo the process of tying, so that a variable uses default instead of custom functionality."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1443019b-2380-437a-b24a-34eea3e92561",
                                                "sense_id": "ba124455-12f2-367e-9a5b-fd54bd2bdda4",
                                                "text": "After you finish with the INI file, all you need to do is untie the hash. Then you really are finished!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
