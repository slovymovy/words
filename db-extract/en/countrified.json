                "senses": [
                    {
                        "sense_id": "146532d1-b5cc-388b-9546-314b6bdbde1c",
                        "entry_id": "7f33bb2b-7bcf-3f70-a234-fbde60315a52",
                        "glosses": [
                            "Rural, rustic; unsophisticated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a020375e-8819-4dd7-8e40-b67744ed4b37",
                                "sense_id": "146532d1-b5cc-388b-9546-314b6bdbde1c",
                                "text": "Although houses and factories appeared in great profusion in the 1930s, there still remain odd groups of cottages dating from an earlier and more countrified period."
                            },
                            {
                                "example_id": "d225cd26-b53d-4aaa-872d-2490deb5628f",
                                "sense_id": "146532d1-b5cc-388b-9546-314b6bdbde1c",
                                "text": "There was this hot little countrified sistah who had caught my eye during the beginning of freshman year, but I just hadn't had a chance to work my way around to her yet."
                            },
                            {
                                "example_id": "f7fb915c-d516-43fa-8bce-0ebc5f8c837f",
                                "sense_id": "146532d1-b5cc-388b-9546-314b6bdbde1c",
                                "text": "Westbourne Park [station] is also countrified, with valanced canopies and fancy ironwork (which is painted a dingy yellow)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf28b21d-1a01-3b65-80c6-ef4f490a91dc",
                        "entry_id": "7f33bb2b-7bcf-3f70-a234-fbde60315a52",
                        "glosses": [
                            "Having the characteristics of country music."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e845bc0-6600-47e4-bd4c-1e2d45af95af",
                                "sense_id": "bf28b21d-1a01-3b65-80c6-ef4f490a91dc",
                                "text": "Over the next couple of years, a few more countrified albums appeared, and to more singles—\"Tarkio Road\" (#55, 1971) and \"Shake Off The Demons (#98, 1972)—won positions on the Hot 100."
                            }
                        ]
                    }
