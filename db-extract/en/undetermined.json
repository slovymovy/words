                    },
                    {
                        "translation_id": "d93c850a-195c-4bf6-88ea-217d4022eeb4",
                        "source_entry_id": "d012eb86-3bbc-3595-a2d7-af4d7b5514dd",
                        "source_sense_description": "Not determined; not settled; not decided",
                        "target_lang_word": "unentschieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unentschieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                        "entry_id": "935178b3-5471-3760-a962-41fd999d38b0",
                                        "glosses": [
                                            "einen Gleichstand, also gleiche Anzahl an Punkten, Treffern, Körben etc. (es gibt keinen Sieger und Verlierer), habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0001ad6f-3368-4fb0-a861-0f78a18ea8a9",
                                                "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                                "text": "Die Partie Deutschland gegen Italien endete unentschieden 1:1."
                                            },
                                            {
                                                "example_id": "a1e62a2d-eb84-482a-81e4-1e170dad5922",
                                                "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                                "text": "Ist der Spielstand eines Spiels, welches zwingend einen Sieger benötigt, am Ende der regulären Spielzeit unentschieden und sehen die Wettbewerbsbestimmungen keine abweichende Regelung vor, so wird das Spiel unmittelbar mit der Verlängerung fortgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                        "entry_id": "935178b3-5471-3760-a962-41fd999d38b0",
                                        "glosses": [
                                            "sich nicht entscheiden könnend; in der Schwebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5924698d-e254-46a8-80d7-fd3520a2b978",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Ich bin noch unentschieden, ob ich den Job annehmen soll oder nicht."
                                            },
                                            {
                                                "example_id": "08009d95-0de8-4a01-995a-f49a466453d4",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Am Sonntag wird gewählt, und es gibt viele, die noch unentschieden sind und sich fragen: Soll man das Kreuz auf dem Wahlschein getreu seiner Überzeugung machen – oder strategisch vorgehen?"
                                            },
                                            {
                                                "example_id": "f456aac5-5edc-45e5-a42c-444a2d17f4d5",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Benvolio kommt der Intrige auf die Spur, aber der verwöhnte junge Mann ist derartig unentschieden, dass er sich nicht einmal zu veritablem Liebeskummer durchringen kann."
                                            },
                                            {
                                                "example_id": "5163550a-3ff6-4053-9ac9-e58c781542ea",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "[…] die Frage, ob Autismus eine Krankheit oder ein Charakterzug ist, bleibt vorerst unentschieden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
