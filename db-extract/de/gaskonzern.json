                "senses": [
                    {
                        "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                        "entry_id": "6be4cbb0-bfea-3e63-87c5-b3cc8856e5bc",
                        "glosses": [
                            "Großunternehmen, das Erdgas fördert, verarbeitet oder mit Erdgas handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2470aac-e04e-45cd-8da6-c14f776f19d1",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Droht eine neue Gaskrise zwischen der Ukraine und Gazprom? Der ukrainische Gaskonzern NAK Naftohas Ukrajiny muss seine Gaslieferungen aus Februar 2009 noch bezahlen.“"
                            },
                            {
                                "example_id": "09a9ce21-be51-42be-8f46-037335150417",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Der staatliche Gaskonzern Gazprom soll Vorbereitungen treffen, die Verträge entsprechend zu ändern.“"
                            },
                            {
                                "example_id": "937b37fd-d3cf-4e0f-a2ee-851d7bf78cc6",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Russland hat am Mittwochabend Sanktionen gegen Teile des Gaskonzerns Gazprom Germania angekündigt, der unter der Treuhandschaft der Bundesnetzagentur steht.“"
                            },
                            {
                                "example_id": "06764a20-4eb4-4522-aae4-c47a59faaed7",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Der Öl- und Gaskonzern Wintershall Dea gehört mehrheitlich dem Chemiekonzern BASF und ist an der Gaspipeline Nord Stream 2 beteiligt.“"
                            },
                            {
                                "example_id": "b49d8562-67a5-47a0-bed8-8b0c7b120bc2",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Der Öl- und Gaskonzern Wintershall Dea fordert jetzt Schadenersatz aus Berlin.“"
                            },
                            {
                                "example_id": "b86b1df7-01f0-42b0-bd39-78feb645c7c8",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "[Die Equinor ASA] „ist ein börsennotierter Öl- und Gaskonzern mit Sitz in Stavanger, dessen Mehrheit mit 67 % vom norwegischen Staat gehalten wird.“"
                            },
                            {
                                "example_id": "27696581-b069-43bb-b868-add0e451aec8",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Viele Unternehmen wie z. B. der Öl- und Gaskonzern INA haben ihren Hauptsitz in Zagreb.“"
                            },
                            {
                                "example_id": "0a64fcc1-fce0-40a0-93d9-94696b604bcb",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Der deutsche Energiekonzern RWE hat sich von seiner Beteiligung am Gaspipeline-Projekt Nabucco getrennt. Der österreichische Öl- und Gaskonzern OMV übernimmt den RWE-Anteil.“"
                            },
                            {
                                "example_id": "3efc4278-0bb2-442d-b3cc-db0934681a64",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Ende Januar gab ExxonMobile bekannt, dass es als weltgrößter Öl- und Gaskonzern bei dem von Uniper geplanten LNG-Terminal in Wilhelmshaven einsteigen wird.“"
                            },
                            {
                                "example_id": "bcd1e176-4685-4899-bf3a-f9131ea200a8",
                                "sense_id": "8cf49465-6f6e-3fb8-972a-ff347d7a8ccf",
                                "text": "„Russland stellt finnischen Angaben zufolge am Samstag seine Erdgaslieferungen an das Nachbarland Finnland ein. Ab 06.00 Uhr (MESZ) werde kein Gas mehr fließen, teilt der finnische Gaskonzern Gasum am Freitag mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                        "entry_id": "6be4cbb0-bfea-3e63-87c5-b3cc8856e5bc",
                        "glosses": [
                            "Großunternehmen, das technische Gase/Industriegase produziert oder mit ihnen handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b4ec78-ee79-420b-98af-3916c0db523a",
                                "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                                "text": "„Linde – Die Verkäufe seiner Unternehmensteile nutzt der Gaskonzern zugunsten einer Fusion mit der US-Konkurrenz Praxair.“"
                            },
                            {
                                "example_id": "82c449e3-cf85-4940-8bde-122f8029bbcf",
                                "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                                "text": "„Am 1. Juni 2017 stimmte der Aufsichtsrat der Linde AG dem Zusammenschluss und dem Fusionsvertrag (Business Combination Agreement, BCA) mit dem US-amerikanischen Gaskonzern Praxair zu.“"
                            },
                            {
                                "example_id": "79d37cec-8ab2-48c1-9a55-4def7f2bdb85",
                                "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                                "text": "„Der Gaskonzern Linde ordnet seine Führungsspitze neu: Der gebürtige Inder Sanjiv Lamba wird zum 1. März 2022 den Vorstandsvorsitz von Steve Angel übernehmen, wie das Unternehmen bekannt gab.“"
                            },
                            {
                                "example_id": "7b8d0355-5d58-4990-95f2-d7850ebd0b62",
                                "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                                "text": "„Der Gaskonzern Linde errichtet in Leuna für rund 60 Millionen Euro die weltgrößte Produktionsanlage zur Erzeugung und Verflüssigung von grünem Wasserstoff im Chemiepark Leuna (Saalekreis).“"
                            },
                            {
                                "example_id": "4ecb31e8-47e7-4893-be8d-9609858de4b8",
                                "sense_id": "63285880-416d-3e15-8b71-89f71b338e5b",
                                "text": "„Air Liquide China betreibt sieben ASUs in Tianjin sowie ein Netzwerk von Pipelines mit mehreren Quellen, die Sauerstoff, Stickstoff und Wasserstoff an benachbarte Kunden liefern. Der Gaskonzern liefert seit mehr als 25 Jahren Industriegase in dieses große chinesische Industriebecken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
