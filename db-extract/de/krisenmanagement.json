                ],
                "senses": [
                    {
                        "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                        "entry_id": "cadf14e0-424d-3e64-8fbf-f8346dfdb4b1",
                        "glosses": [
                            "Verfahren zur Lösung von sachlichen Problemen und persönlichen Konflikten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8857fc4-85d7-47d9-99b4-cf5b323e20a8",
                                "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                                "text": "„Der Begriff Krisenmanagement entstand im politischen Bereich, wobei dessen erstmalige Verwendung dort umstritten ist, mehrheitlich aber J.F. Kennedy im Zusammenhang mit der Kuba-Krise 1962 zugeschrieben wird.“"
                            },
                            {
                                "example_id": "688161c9-c426-4410-8b9d-09299a6dabd7",
                                "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                                "text": "„Der Extremkletterer setzt sich nicht ‚todesmutig’ oder gar ‚blind’ einer ‚mörderischen Wand’ aus, sondern sichert sich mit Seil und Haken, vertraut seinen Eisen, seinem Können, seiner Sorgfalt, seiner Konzentrationsfähigkeit, seinem Selbsteinschätzungsvermögen, seinem Krisenmanagement, seiner Erfahrung.“"
                            },
                            {
                                "example_id": "d4d47147-1062-43ab-a383-85b47a4aa9b3",
                                "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                                "text": "„Die CDU-Vorsitzende Angela Merkel, der in der Partei schlechtes Krisenmanagement vorgeworfen wurde, ließ Meyer beschädigt zurück.“"
                            },
                            {
                                "example_id": "23447bde-0ff2-4cb6-9145-09085732d67a",
                                "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                                "text": "„In Finnland etwa greift schon nach drei Monaten ein Krisenmanagement, wenn es mit Lesen und Schreiben nicht voran geht.“"
                            },
                            {
                                "example_id": "42312363-a7ef-4e51-b3e0-ca183d00bd91",
                                "sense_id": "93b26c45-43b9-3159-b595-cc68b5a9d6b2",
                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
