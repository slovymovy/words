                },
                {
                    "sense_id": "d74ad5e6-3fe7-3aa9-87da-9614bb6adf78",
                    "sense_definition": "unwanted echoes on a radar or sonar screen caused by objects like clouds or waves",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operator had difficulty identifying the ship because of the radar <w>clutter</w>.",
                            "target_lang_translations": {
                                "ru": "Оператору было трудно идентифицировать корабль из-за <w>помех</w> на радаре."
                            }
                        },
                        {
                            "text": "Heavy rain can create significant <w>clutter</w> on the screen during a storm.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь может создавать значительные <w>искажения</w> на экране во время шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "interference",
                        "noise"
                    ],
                    "common_phrases": [
                        "radar clutter",
                        "sea clutter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in aviation and maritime contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нежелательные эхо-сигналы на экране радара или сонара, вызванные такими объектами, как облака или волны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помехи",
                                "target_lang_sense_clarification": "искажения на экране радара"
                            },
                            {
                                "target_lang_word": "отражения",
                                "target_lang_sense_clarification": "ложные сигналы от посторонних объектов"
                            }
                        ]
                    }
                },
                {
