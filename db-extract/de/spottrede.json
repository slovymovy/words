                "senses": [
                    {
                        "sense_id": "ec705c80-cc9d-32b2-b44e-21eeb4501586",
                        "entry_id": "043b0047-4126-3f36-95a0-47faa665b9eb",
                        "glosses": [
                            "Rede, in der man über jemanden oder etwas spottet; spöttische Rede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d96988-0943-4c54-86e1-44f72c73c219",
                                "sense_id": "ec705c80-cc9d-32b2-b44e-21eeb4501586",
                                "text": "„Lautes Gejohle, Fluchen, Gelächter und hyänenartiges Geschrei antwortete auf seine Spottrede.“"
                            },
                            {
                                "example_id": "34938796-e0b6-491e-a86e-30a662150940",
                                "sense_id": "ec705c80-cc9d-32b2-b44e-21eeb4501586",
                                "text": "„Die jüngere hielt es für nötig, meine Spottrede über ihr Land übelzunehmen und mir Fehde anzusagen; doch ich besänftigte sie mit den Worten, Kalabrien wäre ein wunderschönes Land, wenn wenigstens ein Viertel der Einwohner ihr ähnlich sähe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
