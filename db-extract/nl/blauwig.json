                            {
                                "example_id": "eeb901c1-f0af-4a7e-b6e4-7df529c2e1d5",
                                "sense_id": "d02b5059-c1f2-3e9a-9b85-49ff90de3601",
                                "text": "Dit groen is bijna blauwig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be2bf0ee-c9c4-49b8-81a4-c4fa1c74cf90",
                        "source_entry_id": "c0aecbd9-4bdd-3b82-9824-e85357714ec5",
                        "source_sense_id": "d02b5059-c1f2-3e9a-9b85-49ff90de3601",
                        "source_sense_description": "op blauw lijkend",
                        "target_lang_word": "bläulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bläulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eab07bb2-b8cf-3d90-8330-4b35d9fbc66a",
                                        "entry_id": "3194f9c4-9753-31af-a200-aaf7dfbae09f",
                                        "glosses": [
                                            "der Farbe blau ähnlich, an blau erinnernd, mit leicht/schwach blauer Färbung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36be433f-0798-4f7e-835e-0935c87e26a3",
                                                "sense_id": "eab07bb2-b8cf-3d90-8330-4b35d9fbc66a",
                                                "text": "Die bläuliche Tapete gefällt mir am besten."
                                            },
                                            {
                                                "example_id": "e9663138-fbf8-4ea9-a3a7-324810c13bf0",
                                                "sense_id": "eab07bb2-b8cf-3d90-8330-4b35d9fbc66a",
                                                "text": "„Nachdem John sein Frühstück wortlos verzehrt hatte, ging er, den Frost und das bläulich flimmernde Mondlicht verfluchend, fort.“"
                                            },
                                            {
                                                "example_id": "7652f938-f19e-4c76-a0d7-8ecc55c01979",
                                                "sense_id": "eab07bb2-b8cf-3d90-8330-4b35d9fbc66a",
                                                "text": "„Es wird viel getrunken, die Zigaretten mit dem bläulichen Rauch sind selbstgedreht, man tanzt und singt bis zum Tagesanbruch, und nicht selten löst ein Klavierspieler den Phonographen ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38d801ed-6c09-4990-8033-7497a6a1899d",
                        "source_entry_id": "c0aecbd9-4bdd-3b82-9824-e85357714ec5",
                        "source_sense_id": "d02b5059-c1f2-3e9a-9b85-49ff90de3601",
                        "source_sense_description": "op blauw lijkend",
                        "target_lang_word": "bluish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bluish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7fc675c-2903-32f8-9ae6-0d82c0b887e3",
                                        "entry_id": "37fb9eeb-0e5f-377e-9503-9819daa8be93",
                                        "glosses": [
                                            "Having a tint or hue similar to the colour blue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b41febb-97ff-4248-87ea-2fc38eefa129",
                                                "sense_id": "d7fc675c-2903-32f8-9ae6-0d82c0b887e3",
                                                "text": "Riding high on love's true bluish light"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61718b3e-20a8-3304-b54d-b21f3e17a38e",
                                        "entry_id": "37fb9eeb-0e5f-377e-9503-9819daa8be93",
                                        "glosses": [
                                            "Somewhat depressed; sad."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08029e1d-3861-4335-abcd-832ba8653452",
                                                "sense_id": "61718b3e-20a8-3304-b54d-b21f3e17a38e",
                                                "text": "To this day, I usually read my Bible a couple of times a day, and I still enjoy attempting to express my feelings through poetry, especially when I'm feeling bluish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8494715a-4ebd-407b-adfa-c2d446db8efd",
                        "source_entry_id": "c0aecbd9-4bdd-3b82-9824-e85357714ec5",
                        "source_sense_id": "d02b5059-c1f2-3e9a-9b85-49ff90de3601",
                        "source_sense_description": "op blauw lijkend",
                        "target_lang_word": "bleuâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleuâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                        "entry_id": "f44ea922-722e-311c-9ae8-e344c975bf75",
                                        "glosses": [
                                            "Qui tire sur le bleu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f397ca2d-eb3b-4021-a4e4-e6f85bb95a7a",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "Puis, dans le lointain, l'élégante lanterne des Invalides flamboie entre les masses bleuâtres du Luxembourg et les tours grises de Saint-Sulpice."
                                            },
                                            {
                                                "example_id": "923d3889-5100-4008-94a2-38473774ac35",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "Mazeppa, qui n’a plus la force de se tordre dans ses nœuds, gît, inerte, bleuâtre et glacé, ne sachant pas que, selon la magnifique expression du poète, il va se relever roi."
                                            },
                                            {
                                                "example_id": "e45f929b-4c45-4f74-b176-a2195988f3c6",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "[…]; de temps en temps seulement un éclair livide illuminait les appartements sombres d’un reflet bleuâtre qui disparaissait aussitôt."
                                            },
                                            {
                                                "example_id": "96ceade5-f0c0-43c8-ba5a-2793d49b1977",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "Une lueur bleuâtre glissait sur les murs et les arbres, jetant des ombres profondes dans tous les renfoncements et les recoins qui semblaient des abîmes."
                                            },
                                            {
                                                "example_id": "2432e1ec-f3e6-4c3c-bd4f-de42bdc730d8",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "Pendant quelques secondes il roula son cigare entre le pouce et l’index, à hauteur de l’œil droit, suivit du regard le mince filet de fumée qui montait en spirale bleuâtre […]"
                                            },
                                            {
                                                "example_id": "71aa9933-9059-4fc3-aba0-cc3c3f4613b0",
                                                "sense_id": "957fd8fa-37b7-306a-9d82-4e2c0d99c250",
                                                "text": "[…], ces infortunés, depuis les temps les plus anciens, se sont évertués à épierrer ces immensités du Causse, ces plateaux calcaires que leur industrie mal rétribuée a compartimenté de murets innombrables d'un gris bleuâtre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleuâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e292fa5a-4702-3930-93b7-94a3d94752a8",
                                        "entry_id": "3aef1434-7c39-3979-a529-c5ff5c43ba6c",
                                        "glosses": [
                                            "Couleur qui tire sur le bleu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba2d5d8-266c-42a5-8f0b-514ed8c5a7c8",
                                                "sense_id": "e292fa5a-4702-3930-93b7-94a3d94752a8",
                                                "text": "Ce calcaire est jaune-grisâtre passant au bleuâtre, à cassure conchoïde, sublithographique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7882d87-bfa4-441e-bc6a-a41beaa95546",
                        "source_entry_id": "c0aecbd9-4bdd-3b82-9824-e85357714ec5",
                        "source_sense_id": "d02b5059-c1f2-3e9a-9b85-49ff90de3601",
                        "source_sense_description": "op blauw lijkend",
                        "target_lang_word": "bleuté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleuté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18dfb698-cafc-3458-b295-43f43b30bd25",
                                        "entry_id": "55d45334-3952-3586-be35-a376843c853d",
                                        "glosses": [
                                            "Légèrement bleu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eab6659-e960-4d41-bed0-6789fd202fee",
                                                "sense_id": "18dfb698-cafc-3458-b295-43f43b30bd25",
                                                "text": "Ce qui me frappa surtout, c’est la transparence bleutée de l’air, l’extrême délicatesse de tons que prenait le ciel au-dessus des eaux du lagon, […]."
                                            },
                                            {
                                                "example_id": "9a2545b3-9f0f-4c46-b48b-882661d53169",
                                                "sense_id": "18dfb698-cafc-3458-b295-43f43b30bd25",
                                                "text": "Denti et pagre : s’il est aussi méfiant que le pagre et lui ressemble comme un frère jumeau, la robe du denti est plus bleutée alors que celle du pagre est rose-orangée."
                                            },
                                            {
                                                "example_id": "36afb441-58f7-4abb-a7ab-20892687e571",
                                                "sense_id": "18dfb698-cafc-3458-b295-43f43b30bd25",
                                                "text": "La teinte de polarisation reste dans les noirs bleutés lorsque les fibres sont entre-croisées, et monte jusqu'à des couleurs chaudron lorsqu'elles sont parallèles."
                                            },
                                            {
                                                "example_id": "456114f9-f45d-42e9-af84-a3a4805feb83",
                                                "sense_id": "18dfb698-cafc-3458-b295-43f43b30bd25",
                                                "text": "La nuit bleutée se trouait lentement d'une lumière mauve encore tamisée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleuté",
                                "target_lang_code": "fr",
