                                "example_id": "5784f549-e540-4a57-a570-f7dc138de9ba",
                                "sense_id": "b56e1b4e-2182-31f1-a1cc-13c685bcd9ca",
                                "text": "On remarque que Finagnon est « africanisé » et « béninisé » par rapport aux autres manuels."
                            }
                        ]
