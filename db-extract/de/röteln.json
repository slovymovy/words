                "senses": [
                    {
                        "sense_id": "2f05c5f5-aa2f-33ca-9bde-586accfed267",
                        "entry_id": "98473731-d049-3f4f-b241-7403f4db6dcd",
                        "glosses": [
                            "durch das Rötelnvirus verursachte Infektionskrankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac05d8b6-e2cd-4bc2-9bd1-1c0feb17563f",
                                "sense_id": "2f05c5f5-aa2f-33ca-9bde-586accfed267",
                                "text": "Ich hatte als Kind die Röteln und bin dadurch immun."
                            },
                            {
                                "example_id": "1af95dab-fa83-4f1b-9e11-17cd66ac13af",
                                "sense_id": "2f05c5f5-aa2f-33ca-9bde-586accfed267",
                                "text": "„Weil ich die Röteln hatte, mußte ich über Ostern wieder im Bett bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae46f1e-bbe9-4837-b19f-a5e1f9b494eb",
                        "source_entry_id": "98473731-d049-3f4f-b241-7403f4db6dcd",
                        "source_sense_id": "2f05c5f5-aa2f-33ca-9bde-586accfed267",
                        "source_sense_description": "durch das Rötelnvirus verursachte Infektionskrankheit",
                        "target_lang_word": "rubella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4efae4-c88d-347d-a0a8-837a0f13cfcd",
                                        "entry_id": "048f2f6b-ef93-383b-89eb-84ccd5626b9e",
                                        "glosses": [
                                            "A mild disease caused by the Rubella virus infecting the respiratory tract, and characterised by a rash of pink dots, fever and swollen lymph nodes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac88d1eb-c8a2-43ab-b961-6a56a828c22a",
                                                "sense_id": "ca4efae4-c88d-347d-a0a8-837a0f13cfcd",
                                                "text": "At issue is the so-called MMR vaccine, which immunizes children against measles, mumps and rubella, three potentially deadly diseases that were once common and have been mostly wiped out."
                                            },
                                            {
                                                "example_id": "57a88f0d-1ac8-4f3c-8d0c-f6eaf9dace04",
                                                "sense_id": "ca4efae4-c88d-347d-a0a8-837a0f13cfcd",
                                                "text": "They have congenital rubella syndrome, which they acquired during an outbreak of the rubella virus, or German measles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "650942b8-e024-44d4-afd9-fb2991991805",
                        "source_entry_id": "98473731-d049-3f4f-b241-7403f4db6dcd",
                        "source_sense_id": "2f05c5f5-aa2f-33ca-9bde-586accfed267",
                        "source_sense_description": "durch das Rötelnvirus verursachte Infektionskrankheit",
                        "target_lang_word": "rubéole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubéole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fa8afb0-a28b-37b6-b92e-d6e915c51da9",
                                        "entry_id": "fc2f40d6-9793-3391-9ab7-b8c81ac4e628",
                                        "glosses": [
                                            "Maladie éruptive très légère."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1218ac97-90d1-4cad-b786-3465644260f3",
                                                "sense_id": "9fa8afb0-a28b-37b6-b92e-d6e915c51da9",
                                                "text": "La rubéole contractée par une femme enceinte au cours des premiers mois de la grossesse peut entraîner de graves malformations chez le fœtus."
                                            },
                                            {
                                                "example_id": "56dc1597-83c9-4a62-82e2-8a329f213fc0",
                                                "sense_id": "9fa8afb0-a28b-37b6-b92e-d6e915c51da9",
                                                "text": "L’idée de combiner les vaccins n’est pas nouvelle. Par exemple, depuis les années 1970, on combine les vaccins contre la rougeole, la rubéole et les oreillons (vaccin RRO) pour immuniser les jeunes enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
