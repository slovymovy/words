                        "sense_id": "58c9a3ca-4c47-3783-9bbb-2d23ce3b128f",
                        "entry_id": "02a683a9-393f-33c1-a734-d20e3464ca09",
                        "glosses": [
                            "vertragliche Regelung über die Bedingungen, die beim Leasen von etwas gültig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4b731f-7387-40fc-824a-8035d44ea19f",
                                "sense_id": "58c9a3ca-4c47-3783-9bbb-2d23ce3b128f",
                                "text": "„Kunden, die mit der zum VW-Konzern gehörenden Porsche Bank einen Leasingvertrag schlossen und nun Ansprüche wegen Irrtums und/oder Gewährleistung erheben, lässt die Porsche Bank im Regen stehen.“"
                            },
                            {
                                "example_id": "ac252b0c-f85f-4796-979f-5dc8c1f0286f",
                                "sense_id": "58c9a3ca-4c47-3783-9bbb-2d23ce3b128f",
                                "text": "„Singapore Airlines hatte den Leasingvertrag mit Dr. Peters in diesem Jahr nach zehn Jahren Laufzeit nicht verlängert.“"
                            },
                            {
                                "example_id": "f830c881-29a2-4990-a57c-43a9d068f553",
                                "sense_id": "58c9a3ca-4c47-3783-9bbb-2d23ce3b128f",
                                "text": "„Je nach Anbieter wird bei Diebstahl das Rad über den Leasingvertrag ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
