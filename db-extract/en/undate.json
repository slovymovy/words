                "senses": [
                    {
                        "sense_id": "6b727092-65a5-37fe-acf4-8e54044d575e",
                        "entry_id": "801bf8ee-047a-33c5-a3cb-36f065af3534",
                        "glosses": [
                            "A casual meeting arranged between two people that may resemble a date (romantic outing) but is not intended as one."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "8d9a2856-4c95-4a50-b287-00e9399755fb",
                                "sense_id": "6b727092-65a5-37fe-acf4-8e54044d575e",
                                "text": "[…] an undate, all you're really doing is hanging out with a new acquaintance for a few hours."
                            },
                            {
                                "example_id": "2bdc3823-59c2-4a27-b757-8b44f0ec9d7a",
                                "sense_id": "6b727092-65a5-37fe-acf4-8e54044d575e",
                                "text": "[…] suggest an undate if he asks you out. Guys will normally welcome the idea […]"
                            },
                            {
                                "example_id": "f028232b-c860-40a4-9f8b-307a9849a5a3",
                                "sense_id": "6b727092-65a5-37fe-acf4-8e54044d575e",
                                "text": "Why does this keep happening to me ? Did I do something to make him think it was a date? I had insisted that this meeting was not a date largely because of the numerous surprise 'undates' I'd found myself on in the past."
                            }
                        ]
                    }
