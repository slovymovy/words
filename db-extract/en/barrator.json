    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                "word": "barrator",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aaa2908a-3f6f-4e7e-85db-fa31db7caed5",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "tags": [
                            "plural"
                        ],
                        "form": "barrators"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ae6c6eb-38aa-3e76-a69b-86ba6849a97c",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "glosses": [
                            "One who is guilty of barratry, vexing others with frequent and often groundless lawsuits; a brangler and pettifogger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fab468-0f17-43c7-a5b4-814a71edf607",
                                "sense_id": "7ae6c6eb-38aa-3e76-a69b-86ba6849a97c",
                                "text": "But by Hawk. P. C. bk. 1, c. 21, if such suits are merely groundless, and brought only with a design to oppress the defendants, such a man may as properly be called a barrator as if he had stirred up others to bring them."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce0796d-038d-38fc-bfdb-5e950282d0ff",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "glosses": [
                            "One who abuses their office by dealing fraudulently.",
                            "One who buys or sells political or ecclesiastic offices."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4428da1b-9a52-3412-a426-6b349d6b1410",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "glosses": [
                            "One who abuses their office by dealing fraudulently.",
                            "A judge who accepts bribes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6285b823-e461-3a72-ac86-cb44cc1c4e26",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "glosses": [
                            "One who abuses their office by dealing fraudulently.",
                            "A ship's master who commits gross fraud or barratry."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "df93e535-1514-3cc6-a727-45f6cded4d50",
                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "glosses": [
                            "A quarrelsome person, one who fights, a bully."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "358519d1-d7f2-49a6-ae60-b92237503351",
                                "sense_id": "df93e535-1514-3cc6-a727-45f6cded4d50",
                                "text": "I care not though men call me impudent, / Smooth-tongu'd, audacious, petulant, abhominable, / Forger of vvords and lie, contentious Barretour, / Old, vvinding, bragging, teſty, crafty fox."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "859951bd-8385-4fae-b389-755459568eb5",
                        "source_entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "source_sense_description": "one who is guilty of barratry",
                        "target_lang_word": "quérulent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quérulent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de355792-2808-3750-878b-97d5620690ac",
                                        "entry_id": "cd1ad12c-c472-3b17-84d4-6429325750df",
                                        "glosses": [
                                            "Qui a une tendance pathologique à chercher querelle et à revendiquer une réparation disproportionnée d’un préjudice réel ou imaginaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be6b84f-53e7-48d5-b503-7022b56e1e31",
                                                "sense_id": "de355792-2808-3750-878b-97d5620690ac",
                                                "text": "Rappelons enfin que rôle judiciaire des aliénés persécuteurs n’est pas limité aux procès criminels et que leurs idées délirantes sont fréquemment la base de procès civils ; Krafft-Ebing les a certainement pris pour modèles quand il a décrit son délire quérulent."
                                            },
                                            {
                                                "example_id": "6019a240-8d2c-48c3-b0b8-c5efbe4661bf",
                                                "sense_id": "de355792-2808-3750-878b-97d5620690ac",
                                                "text": "De même que le déprimé devient un mélancolique avec cet épouvantable sentiment d’incurabilité, de même le poète bascule de l’hédonisme dans la conviction délirante, du choix d’un idéal à la résignation persécutée, puis à la persécution, à la jalousie, à la revendication quérulente."
                                            },
                                            {
                                                "example_id": "d79b1be9-7e76-40b2-b989-9b78def0dc82",
                                                "sense_id": "de355792-2808-3750-878b-97d5620690ac",
                                                "text": "Il y avait toujours, dans la moindre de ses phrases, quelque chose d’offensif, de quérulent, comme s’il ne cessait de demander réparation pour les injustices dont il s’estimait victime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24b21c8-4e2f-3b66-94c6-3eaad91b3d23",
                                        "entry_id": "cd1ad12c-c472-3b17-84d4-6429325750df",
                                        "glosses": [
                                            "Se dit d’un plaideur qui, ayant multiplié indûment les procédures judiciaires, voit son droit d’agir en justice soumis à l’autorisation du tribunal."
                                        ],
                                        "tags": [
                                            "Justice",
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c8eacf-c4f8-4886-a117-aba3c0d4d31b",
                                                "sense_id": "b24b21c8-4e2f-3b66-94c6-3eaad91b3d23",
                                                "text": "Après avoir interjeté appel à la cour supérieure en juin 2009 sur décision rendue par la chambre de la jeunesse, l'avocate du DPJ a introduit une requête incidente selon cette nouvelle loi pour me déclarer quérulente et rejeter l'appel de mon fils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quérulent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1d5121-63d5-3f67-bdc4-28ba2c091cbf",
                                        "entry_id": "8edb671e-4307-3398-a38e-9fb104dd3958",
                                        "glosses": [
                                            "Personne qui a une tendance pathologique à chercher querelle et à revendiquer une réparation disproportionnée d’un préjudice réel ou imaginaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c3c466-5a0f-4ce5-a264-ecb4b5286414",
                                                "sense_id": "6e1d5121-63d5-3f67-bdc4-28ba2c091cbf",
                                                "text": "M. Weber considèrerait comme une faute de condamner un quérulent pour vol. Ces sujets sont pour l’aliéniste des aliénés, et non des individus atteints de troubles partiels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76410ed4-10c1-4339-af20-3490f80e6107",
                        "source_entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "source_sense_description": "one who is guilty of barratry",
                        "target_lang_word": "procédurier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procédurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fec6291d-862b-3909-a41c-ec8255827f4c",
                                        "entry_id": "381e9a01-b38e-37d4-a0d6-0ec21dcdc114",
                                        "glosses": [
                                            "Qui est enclin à recourir à la procédure, à user, ou même à abuser des moyens de la procédure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3db564-00d2-4efc-9dd6-33dea6a6dd48",
                                                "sense_id": "fec6291d-862b-3909-a41c-ec8255827f4c",
                                                "text": "Tempérament procédurier."
                                            },
                                            {
                                                "example_id": "8011a6dc-a540-434f-989a-6ef9745019e0",
                                                "sense_id": "fec6291d-862b-3909-a41c-ec8255827f4c",
                                                "text": "Humeur procédurière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "procédurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2558edfa-364b-3b64-99e9-58d74562d87d",
                                        "entry_id": "4737aa61-a1a5-36c4-9b2d-69fe9ab0678a",
                                        "glosses": [
                                            "Personne qui cherche des histoires."
                                        ],
                                        "tags": [
                                            "Société"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e311723-138d-41dc-a493-4b98c73b32f4",
                                                "sense_id": "2558edfa-364b-3b64-99e9-58d74562d87d",
                                                "text": "Encore six minutes avant de fermer les portes et de se retrouver tranquille, à l’abri des grincheux, des procéduriers, des clients qui ne comprenaient rien à rien, et surtout des petits voyous qui espéraient fracturer les véhicules et en tirer quelques bénéfices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66dee6b-fc5d-373a-9546-0b511a31a9f2",
                                        "entry_id": "4737aa61-a1a5-36c4-9b2d-69fe9ab0678a",
                                        "glosses": [
                                            "Agent chargé de transcrire par écrit toutes les étapes de l’enquête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d6a28e-66d0-42f7-a999-1a69c9808891",
                                                "sense_id": "b66dee6b-fc5d-373a-9546-0b511a31a9f2",
                                                "text": "Le procédurier, je l’ai dit, c’est le maître de ballet, le scénariste de l’enquête, il voit tout, entend tout, écrit tout."
                                            },
                                            {
                                                "example_id": "42f0d77c-0df7-4bbf-bb70-cb6e2c03216e",
                                                "sense_id": "b66dee6b-fc5d-373a-9546-0b511a31a9f2",
                                                "text": "En attendant, vous prenez bien sa déposition, que le procédurier fasse gaffe : ça sent l’embrouille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d6f8e9-6b96-33a1-8437-77d84f04c520",
                                        "entry_id": "4737aa61-a1a5-36c4-9b2d-69fe9ab0678a",
                                        "glosses": [
                                            "Document qui énumère de manière explicite et suivie l'ensemble des procédures, des instructions ou des étapes nécessaires à l'exécution d'une tâche."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5319572-dc35-4197-9432-94d7465201aa",
                                                "sense_id": "84d6f8e9-6b96-33a1-8437-77d84f04c520",
                                                "text": "Vous trouverez dans cette section des liens vers des procéduriers ou tutoriels, des autoformations ou des webinaires qui peuvent vous aider dans votre pratique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a85a1dcb-b106-4339-9055-41e1f6a7b0f9",
                        "source_entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                        "source_sense_description": "one who is guilty of barratry",
                        "target_lang_word": "Querulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Querulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                        "entry_id": "d77c55a9-e440-3f79-95d2-d25afbe21be1",
                                        "glosses": [
                                            "Person, die sich ständig wegen jeder Kleinigkeit beschwert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fdf3201-1c93-48a5-ac7b-743a068b4233",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "Du nervst so! Dir kann man es wirklich nicht recht machen, du Querulant!"
                                            },
                                            {
                                                "example_id": "3b51e4e0-4ea6-4d26-9abe-f37240eb580c",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Man hatte bald genug, übergenug von diesem Querulanten und seiner Prahlerei, er sei schließlich schon ein Wunderkind gewesen.“"
                                            },
                                            {
                                                "example_id": "713349f8-2440-40af-b4de-819584565792",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Er war ein Querulant, der sich ständig über die hohen Kosten seines Familiengeschäftes beklagte.“"
                                            },
                                            {
                                                "example_id": "7f08f158-0c34-47ed-b2bb-8bfd39ec55d2",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Da gab es die Gruppe der Querulanten, deren Eigensucht sich auf unwürdige Weise hintangesetzt fühlte.“"
                                            },
                                            {
                                                "example_id": "7f822aeb-18d8-4fb2-9bcf-eba7fedd5d62",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„In der Presse wurde er meist als Querulant belächelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
