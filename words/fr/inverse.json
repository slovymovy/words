    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8fda82c7-e80f-3460-9520-8a71b9402694",
                    "sense_definition": "Qui est opposé par rapport à l'ordre, au sens ou à la direction des choses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont marché en sens <w>inverse</w> pour retourner vers la gare."
                        },
                        {
                            "text": "Cette mesure maladroite a produit l'effet <w>inverse</w> de ce qui était souhaité."
                        }
                    ],
                    "synonyms": [
                        "contraire",
                        "opposé"
                    ],
                    "common_phrases": [
                        "sens inverse",
                        "ordre inverse",
                        "effet inverse"
                    ]
                },
                {
                    "sense_id": "47854e1e-ca9c-36b0-b1b0-916bf62b3a51",
                    "sense_definition": "Se dit d'un nombre dont le produit avec un autre nombre donné est égal à un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique comment calculer le nombre <w>inverse</w> d'une fraction."
                        },
                        {
                            "text": "La fonction <w>inverse</w> n'est pas définie pour la valeur zéro."
                        }
                    ],
                    "common_phrases": [
                        "nombre inverse",
                        "fonction inverse"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dd97446-501b-3c8a-9ea6-b7e0989b1a89",
                    "sense_definition": "Ce qui est le contraire absolu ou diamétralement opposé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je pensais qu'il refuserait mon aide, mais il a fait exactement l'<w>inverse</w>."
                        },
                        {
                            "text": "Mon collègue affirme le contraire et prétend que l'<w>inverse</w> est vrai."
                        }
                    ],
                    "synonyms": [
                        "contraire",
                        "opposé",
                        "envers"
                    ],
                    "common_phrases": [
                        "faire l'inverse",
                        "tout l'inverse",
                        "prouver l'inverse"
                    ]
                },
                {
                    "sense_id": "01c05a37-aff8-35ce-84df-00af769ae71b",
                    "sense_definition": "Nombre ou élément qui, multiplié par un autre, donne un pour résultat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>inverse</w> de quatre est égal au nombre décimal zéro virgule vingt-cinq."
                        },
                        {
                            "text": "Pour diviser une fraction par une autre, on multiplie par son <w>inverse</w>."
                        }
                    ],
                    "common_phrases": [
                        "calculer l'inverse"
                    ]
                }
            ]
        },
