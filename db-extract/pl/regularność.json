                                    {
                                        "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                        "entry_id": "2fed6c0c-8ac3-311f-b796-f76bd8389e35",
                                        "glosses": [
                                            "The condition or quality of being regular"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e09ed9b-688e-45ad-a664-a9ebfe6801ef",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "I have been watching that show with regularity."
                                            },
                                            {
                                                "example_id": "8ac15d33-546d-421b-8cb1-8f245ad38e2e",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "For Chelsea coach Andre Villas-Boas, this was his most sobering moment in the Premier League and he looked stunned on the sidelines at the regularity with which Chelsea's defence was exposed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a239ea-8aaf-36af-88ba-5687d09f059a",
