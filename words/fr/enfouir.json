{
    "word_family": [
        "enfouissement",
        "enfouisseur",
        "fouir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b383c27-3ef9-3809-96ea-2a22ed415a2c",
                    "sense_definition": "Mettre quelque chose dans la terre et le recouvrir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creuser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien court dans le jardin pour <w>enfouir</w> un os sous le vieux chêne."
                        },
                        {
                            "text": "Les ouvriers doivent <w>enfouir</w> ces câbles électriques sous terre pour sécuriser l'installation."
                        }
                    ],
                    "synonyms": [
                        "enterrer"
                    ],
                    "common_phrases": [
                        "enfouir sous terre",
                        "enfouir des déchets"
                    ]
                },
                {
                    "sense_id": "048623dd-25ed-33df-9e9d-5008b93a7b97",
                    "sense_definition": "Enfoncer ou plonger une partie du corps dans une matière qui l'enveloppe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Submergée par l'émotion, elle <w>enfouit</w> son visage dans ses mains pour pleurer."
                        },
                        {
                            "text": "À cause du vent glacial, il <w>enfouit</w> ses mains au fond de ses poches."
                        }
                    ],
                    "common_phrases": [
                        "enfouir son visage",
                        "enfouir ses mains"
                    ]
                },
                {
                    "sense_id": "4edfcb4d-51f9-3ebc-96f8-7fc21d5c90da",
                    "sense_definition": "Faire disparaître ou cacher sous un amas de choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai enfin retrouvé cette lettre qui était <w>enfouie</w> sous une pile de vieux dossiers."
                        },
                        {
                            "text": "Le petit chalet semblait complètement <w>enfoui</w> sous la neige après la tempête hivernale."
                        }
                    ],
                    "common_phrases": [
                        "enfoui sous la neige",
                        "enfoui sous des papiers"
                    ]
                },
                {
                    "sense_id": "34739f6e-1545-3475-9e3a-0022405c27e5",
                    "sense_definition": "Se retirer dans un lieu isolé pour fuir le monde ou vivre à l'écart.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isoler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'agitation citadine, l'auteur a préféré s'<w>enfouir</w> dans un village reculé."
                        },
                        {
                            "text": "Il refuse les invitations mondaines et choisit de s'<w>enfouir</w> dans sa vaste bibliothèque."
                        }
                    ],
                    "common_phrases": [
                        "s'enfouir dans la campagne"
                    ]
                }
            ]
        }
    ]
}