                        "entry_id": "59b6c0e1-39ee-3983-bda4-c3aa4c73bcf9",
                        "glosses": [
                            "The heating of solid metal or glass to high temperatures and cooling it slowly so that its particles arrange into a defined lattice to remove residual stress."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "980e81d0-a7eb-4af6-aa40-94460bfde1eb",
                                "sense_id": "1788eeeb-c18b-3982-8f0e-c0a892d3cc66",
                                "text": "Without annealing, the quality of our metal products will diminish."
                            }
                        ]
                    }
                ],
