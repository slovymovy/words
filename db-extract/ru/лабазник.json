                        "examples": [
                            {
                                "example_id": "5df72d5c-6ff2-459f-aa91-8d8c80832d98",
                                "sense_id": "38b54cfb-3eab-30d4-9bcc-3e5c8ca90b84",
                                "text": "— Молодо́й — э́то купе́ческий сын Сизобрю́хов, сын изве́стного лаба́зника, получи́л полмиллио́на по́сле отца́ и тепе́рь ку́тит.",
                                "translation": "“The young fellow’s Sizobryuhov, the son of the celebrated corn-dealer; he came in for half a million when his father died, and now he’s having a good time.…”",
                                "english": "“The young fellow’s Sizobryuhov, the son of the celebrated corn-dealer; he came in for half a million when his father died, and now he’s having a good time.…”"
                            }
