                        "entry_id": "8d3a2702-9da0-3030-876d-d2d94817abf3",
                        "glosses": [
                            "Eigenschaft/Tat, die in deutlichem Maße widerwärtige (odiose/odiöse) Merkmale zeigt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "2cedaa03-a00b-455c-ac5f-55ae59ccad18",
                                "sense_id": "56729a95-9901-3a37-ac4f-5bcd2328ef45",
                                "text": "„Zudem lässt er seinen Helden in eine von Odiosität und Destruktion bestimmte Beziehung zur Gefühlsrepräsentantin eintreten.“"
                            },
                            {
                                "example_id": "9f0b3fd4-9f91-49dc-ad26-6020118dfc9f",
                                "sense_id": "56729a95-9901-3a37-ac4f-5bcd2328ef45",
                                "text": "„Ich dachte es nicht im Rathe aufzunehmen, weil es zu Odiositäten Gelegenheit geben könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
