{
    "word_family": [
        "instruction",
        "instructeur",
        "instructrice",
        "instructif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fce62cf2-1b32-3d71-88f9-93658a313149",
                    "sense_definition": "Enseigner à quelqu'un, lui transmettre des connaissances ou former son esprit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enseigner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette professeure passionnée cherche toujours à <w>instruire</w> la jeunesse avec bienveillance et rigueur."
                        },
                        {
                            "text": "Ce livre captivant <w>instruit</w> les lecteurs tout en leur offrant une histoire touchante."
                        }
                    ],
                    "synonyms": [
                        "enseigner",
                        "éduquer",
                        "former"
                    ],
                    "antonyms": [
                        "abêtir"
                    ],
                    "common_phrases": [
                        "instruire la jeunesse",
                        "chercher à s'instruire"
                    ]
                },
                {
                    "sense_id": "3e1d1c70-92ff-3514-9975-53185452e92f",
                    "sense_definition": "Informer ou avertir quelqu'un d'un fait, lui faire part d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur nous a <w>instruits</w> des derniers changements intervenus dans le projet."
                        },
                        {
                            "text": "Dès qu'une décision sera prise, je vous <w>instruirai</w> de la suite des événements."
                        }
                    ],
                    "synonyms": [
                        "informer",
                        "avertir",
                        "aviser",
                        "renseigner"
                    ],
                    "common_phrases": [
                        "instruire des faits"
                    ]
                },
                {
                    "sense_id": "b704c878-5d74-35d9-8307-570d2bf3964a",
                    "sense_definition": "Examiner et rassembler les éléments de preuve d'une affaire judiciaire pour la préparer au jugement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction doit <w>instruire</w> à charge et à décharge en toute impartialité."
                        },
                        {
                            "text": "Ce magistrat expérimenté a <w>instruit</w> une affaire complexe qui a duré plusieurs mois."
                        }
                    ],
                    "synonyms": [
                        "examiner"
                    ],
                    "common_phrases": [
                        "instruire une affaire",
                        "instruire à charge et à décharge"
                    ]
                },
                {
                    "sense_id": "6260201b-61f0-3895-9feb-7f34a663964e",
                    "sense_definition": "Examiner et traiter un dossier ou une démarche administrative avant d'arrêter une décision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agents municipaux prennent plusieurs semaines pour <w>instruire</w> un dossier de subvention."
                        },
                        {
                            "text": "L'administration <w>instruit</w> votre demande avec attention avant de délivrer le permis."
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "traiter"
                    ],
                    "common_phrases": [
                        "instruire un dossier",
                        "instruire une demande"
                    ]
                }
            ]
        }
    ]
}