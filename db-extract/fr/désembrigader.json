                "senses": [
                    {
                        "sense_id": "64a727d8-f712-3997-96db-32b622575f42",
                        "entry_id": "f783cf6c-9455-3419-a964-d2fcfd94a88c",
                        "glosses": [
                            "Cesser de faire travailler par brigades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64853066-c5da-470a-9c74-e5de9528aedb",
                                "sense_id": "64a727d8-f712-3997-96db-32b622575f42",
                                "text": "Le quatrième point du projet est, à terme, de « désembrigader » le personnel, c’est-à-dire de supprimer l’alternance matin/après-midi des équipes pour concentrer les effectifs sur les plages horaires fixes à fort trafic."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f8972a6-97a0-3b7f-a55b-83f3cebd3f2b",
                        "entry_id": "f783cf6c-9455-3419-a964-d2fcfd94a88c",
                        "glosses": [
                            "Délivrer d’un embrigadement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7cdb97-f75f-450f-ace4-aee6466df05a",
                                "sense_id": "3f8972a6-97a0-3b7f-a55b-83f3cebd3f2b",
                                "text": "Mais, ils veulent aussi désembrigader le peuple allemand et lui montrer la défaite à laquelle Hitler l’a amené…"
                            },
                            {
                                "example_id": "4e10d1a9-f5d5-47a4-8e18-c97b11d28c36",
                                "sense_id": "3f8972a6-97a0-3b7f-a55b-83f3cebd3f2b",
                                "text": "Comment se « désembrigader » d’une secte ?"
                            }
                        ]
                    }
