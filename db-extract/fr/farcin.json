                "senses": [
                    {
                        "sense_id": "1adbde09-3999-3e1b-a1f7-846f966d6fa8",
                        "entry_id": "7f128eb4-b116-3150-b703-d627649a734d",
                        "glosses": [
                            "Forme cutanée de la morve, chez les chevaux et mulets, avec adénites et lymphangites."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ce064b1e-6f9e-44e1-a166-581aa9aea880",
                                "sense_id": "1adbde09-3999-3e1b-a1f7-846f966d6fa8",
                                "text": "Un mois plus tard, les moutons, atteints de la clavelée, se trouvaient dans un pitoyable état ; deux chevaux avaient la morve et les trois autres le farcin."
                            },
                            {
                                "example_id": "9fa1990e-70b2-4b67-a243-20eddb6f8e38",
                                "sense_id": "1adbde09-3999-3e1b-a1f7-846f966d6fa8",
                                "text": "On ne cite aucune manœuvre employée par l’acheteur pour simuler le farcin : mais il est facile au marchand qui vous donne une bête avec une tumeur ou un engorgement farcineux sous le ventre, à la face interne des membres, de vous persuader que ce n’est rien."
                            }
                        ]
                    }
                ],
