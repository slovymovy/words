{
    "word_family": [
        "quencher",
        "quenching"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3184f9da-0e57-3274-856a-f74ab6fd740b",
                    "sense_definition": "To satisfy a thirst or a strong desire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She drank a large glass of water to <w>quench</w> her thirst after the long run.",
                            "target_lang_translations": {
                                "ru": "Она выпила большой стакан воды, чтобы <w>утоли́ть</w> жажду после долгого бега."
                            }
                        },
                        {
                            "text": "The new book helped <w>quench</w> his thirst for knowledge about ancient history.",
                            "target_lang_translations": {
                                "ru": "Новая книга помогла <w>утоли́ть</w> его жажду знаний о древней истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "appease",
                        "slake"
                    ],
                    "common_phrases": [
                        "quench thirst"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворять жажду или сильное желание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утоля́ть",
                                "target_lang_sense_clarification": "удовлетворять сильное желание или потребность"
                            },
                            {
                                "target_lang_word": "утоли́ть",
                                "target_lang_sense_clarification": "совершенный вид глагола утолять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb687446-c20a-371e-9896-d64f93dd973a",
                    "sense_definition": "To put out a fire or light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters worked quickly to <w>quench</w> the flames before they spread to nearby houses.",
                            "target_lang_translations": {
                                "ru": "Пожарные быстро работали, чтобы <w>потуши́ть</w> пламя, прежде чем оно перекинулось на соседние дома."
                            }
                        },
                        {
                            "text": "It took several hours to <w>quench</w> the fire completely.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько часов, чтобы полностью <w>потуши́ть</w> пожа́р."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench fire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потушить огонь или свет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туши́ть",
                                "target_lang_sense_clarification": "прекращать горение или выключать свет"
                            },
                            {
                                "target_lang_word": "потуши́ть",
                                "target_lang_sense_clarification": "совершенный вид глагола тушить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9d2f606-955f-3aca-ac0e-79b925744e7c",
                    "sense_definition": "To cool a hot metal object rapidly by dipping it into a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith decided to <w>quench</w> the glowing steel blade in a bucket of oil.",
                            "target_lang_translations": {
                                "ru": "Кузнец решил <w>закали́ть</w> раскаленное стальное лезвие в ведре с маслом."
                            }
                        },
                        {
                            "text": "Properly <w>quench</w> the metal to ensure it becomes hard and durable.",
                            "target_lang_translations": {
                                "ru": "Правильно <w>закали́те</w> металл, чтобы он стал твердым и прочным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench metal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро охладить горячий металлический предмет, погрузив его в жидкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закали́ть",
                                "target_lang_sense_clarification": "подвергнуть металл термической обработке (закалке)"
                            },
                            {
                                "target_lang_word": "охлади́ть",
                                "target_lang_sense_clarification": "сделать холодным, остудить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "053bc1f5-e000-3071-a339-0af7a040950d",
                    "sense_definition": "To suddenly stop the operation of a superconducting magnet by heating it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_stop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staff are trained to <w>quench</w> the MRI machine only in extreme emergency situations.",
                            "target_lang_translations": {
                                "ru": "Персонал обучен <w>сбрасывать</w> поле МРТ-аппарата только в крайних экстренных ситуациях."
                            }
                        },
                        {
                            "text": "An accidental <w>quench</w> of the magnet can be very expensive to repair.",
                            "target_lang_translations": {
                                "ru": "Случайный <w>срыв</w> <w>сверхпроводимости</w> магнита может быть очень дорогим в ремонте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench magnet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно прекратить работу сверхпроводящего магнита путем его нагрева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбросить поле",
                                "target_lang_sense_clarification": "технический термин для внезапного прекращения работы магнита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7f2dd19-beaa-301e-a1d8-d9baba373af6",
                    "sense_definition": "To change the parameters of a physical system very quickly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers <w>quench</w> the system to observe how it reacts to sudden environmental changes.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>резко</w> <w>изменяют</w> параметры системы, чтобы наблюдать, как она реагирует на внезапные изменения окружающей среды."
                            }
                        },
                        {
                            "text": "They will <w>quench</w> the parameters to study the resulting dynamic behavior.",
                            "target_lang_translations": {
                                "ru": "Они <w>резко</w> <w>изменят</w> параметры, чтобы изучить возникающее динамическое поведение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench parameters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень быстро изменить параметры физической системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко изменить",
                                "target_lang_sense_clarification": "быстрое изменение параметров системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0de419a0-616f-3d33-be61-ee1d04e5987a",
                    "sense_definition": "To stop a chemical reaction by destroying the remaining reagents.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_stop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist added a neutralizing agent to <w>quench</w> the reaction before it became unstable.",
                            "target_lang_translations": {
                                "ru": "Химик добавил нейтрализующий агент, чтобы <w>останови́ть</w> реакцию, прежде чем она стала нестабильной."
                            }
                        },
                        {
                            "text": "It is necessary to <w>quench</w> the reaction at the precise moment the product forms.",
                            "target_lang_translations": {
                                "ru": "Необходимо <w>останови́ть</w> реакцию в тот самый момент, когда образуется продукт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench reaction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить химическую реакцию путем уничтожения оставшихся реагентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "прекращение химического процесса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bfb7b46-84d5-3eec-a8bc-b6e22a036fa8",
                    "sense_definition": "The act of quenching something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>quench</w> of the light signaled that the power had failed.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>гаше́ние</w> света сигнализировало о том, что отключилось электричество."
                            }
                        },
                        {
                            "text": "The <w>quench</w> of the hot iron produced a loud hissing sound.",
                            "target_lang_translations": {
                                "ru": "Процесс <w>зака́лки</w> горячего железа сопровождался громким шипением."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс гашения или охлаждения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гашение",
                                "target_lang_sense_clarification": "процесс прекращения горения или действия"
                            },
                            {
                                "target_lang_word": "закалка",
                                "target_lang_sense_clarification": "процесс резкого охлаждения металла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c3be87e-e958-343c-b955-669d0e9da236",
                    "sense_definition": "The sudden failure of a superconducting magnet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>quench</w> in the MRI machine can cause a rapid release of helium gas.",
                            "target_lang_translations": {
                                "ru": "Случай <w>срыва</w> <w>сверхпроводимости</w> в МРТ-аппарате может вызвать быстрый выброс газообразного гелия."
                            }
                        },
                        {
                            "text": "The <w>quench</w> caused the magnet to lose its superconducting state immediately.",
                            "target_lang_translations": {
                                "ru": "Этот <w>срыв</w> привел к тому, что магнит немедленно потерял свое сверхпроводящее состояние."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный отказ сверхпроводящего магнита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срыв сверхпроводимости",
                                "target_lang_sense_clarification": "технический термин для отказа магнита"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}