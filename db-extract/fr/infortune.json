                ],
                "senses": [
                    {
                        "sense_id": "59b40937-3368-36b8-924f-153dafffd26b",
                        "entry_id": "d5836125-bf58-3c59-8ae8-811773b07ae7",
                        "glosses": [
                            "misfortune"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8581c196-ff75-45c8-8ca3-cc103ccdd872",
                                "sense_id": "59b40937-3368-36b8-924f-153dafffd26b",
                                "text": "C'en est peut-être assez pour une âme commune / Qui du moindre péril se fait une infortune",
                                "translation": "That is enough, perhaps, for a soul of common sort / Who considers as misfortune the smallest danger",
                                "english": "That is enough, perhaps, for a soul of common sort / Who considers as misfortune the smallest danger"
                            },
                            {
                                "example_id": "f273d47e-4558-4aaf-8bc4-5a6d22e44324",
                                "sense_id": "59b40937-3368-36b8-924f-153dafffd26b",
                                "text": "Ce fut au fond des leurs [leurs âmes] que ceux qui avaient écouté le récit de ses infortunes ressentirent l’étonnement et la compassion qu’elle inspirait.",
                                "translation": "It happened in the bottom of theirs [their souls] that those that had listened to the narrative of her misfortunes felt the astonishment and compassion that she inspired.",
                                "english": "It happened in the bottom of theirs [their souls] that those that had listened to the narrative of her misfortunes felt the astonishment and compassion that she inspired."
                            }
                        ]
                    }
                ],
