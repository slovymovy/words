                        "examples": [
                            {
                                "example_id": "690bd740-b089-4de5-9d98-e37f44c46634",
                                "sense_id": "5452023a-118d-38a4-8b03-86519e738d12",
                                "text": "Увеличение объёма сформованных кусков теста во время расстойки происходит благодаря тому, что газ, выделяющийся во время брожения, стремится выйти из теста, встречает на своем пути клейковину, приподнимает и раздвигает её."
                            }
                        ]
                    }
